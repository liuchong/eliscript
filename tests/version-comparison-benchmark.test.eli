(module capsules.tests.version-comparison-benchmark.test
  (js* "import { mkdtemp, readFile, rm } from \"node:fs/promises\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { expect, test } from \"bun:test\";\nimport {\n  VERSION_COMPARISON_DIMENSIONS,\n  VERSION_COMPARISON_FORMAT,\n  VERSION_COMPARISON_WORKLOADS,\n  mergeReleaseNotesWithSummary,\n  renderReleaseNotesSummary,\n  renderVersionComparisonMarkdown,\n  resolveVersionComparisonMatrix,\n  runVersionComparisonBenchmark,\n  validateVersionComparisonReport,\n  writeReleaseComparisonBundle,\n} from \"../tools/performance/version-comparison.mjs\";\n\nconst testDir = path.dirname(fileURLToPath(import.meta.url));\nconst projectRoot = path.resolve(testDir, \"..\");\n\ntest(\"version comparison matrix defines the four canonical dimensions in order\", () => {\n  expect(VERSION_COMPARISON_DIMENSIONS).toEqual([\n    \"emacsLisp\",\n    \"previousMajor\",\n    \"previousMinor\",\n    \"latest\",\n  ]);\n  expect(VERSION_COMPARISON_WORKLOADS.length).toBeGreaterThanOrEqual(8);\n});\n\ntest(\"boundary case 1 & 4: 0.x release has absent previousMajor, active previousMinor, and current-latest-only emacsLisp\", () => {\n  const matrix = resolveVersionComparisonMatrix({\n    currentVersion: \"0.0.4\",\n    releasedTags: [\"v0.0.1\", \"v0.0.2\", \"v0.0.3\"],\n    emacsVersion: \"31.1\",\n  });\n\n  expect(matrix.emacsLisp).toEqual({\n    id: \"emacsLisp\",\n    label: \"Emacs Lisp\",\n    status: \"active\",\n    version: \"31.1\",\n    tag: null,\n    mode: \"current-latest-only\",\n    reason: \"current-host-emacs\",\n  });\n  expect(matrix.previousMajor).toEqual({\n    id: \"previousMajor\",\n    label: \"上一个大版本\",\n    status: \"absent\",\n    version: null,\n    tag: null,\n    reason: \"no-prior-major-release\",\n    sameAsPreviousMinor: false,\n  });\n  expect(matrix.previousMinor).toEqual({\n    id: \"previousMinor\",\n    label: \"上一个最近的小版本\",\n    status: \"active\",\n    version: \"0.0.3\",\n    tag: \"v0.0.3\",\n    reason: \"resolved\",\n    sameAsPreviousMajor: false,\n  });\n  expect(matrix.latest).toEqual({\n    id: \"latest\",\n    label: \"最新版\",\n    status: \"active\",\n    version: \"0.0.4\",\n    tag: \"v0.0.4\",\n    reason: \"current-workspace\",\n  });\n});\n\ntest(\"boundary case 2: initial release (0.0.1) has both previousMajor and previousMinor absent\", () => {\n  const matrix = resolveVersionComparisonMatrix({\n    currentVersion: \"0.0.1\",\n    releasedTags: [\"v0.0.1\"],\n    emacsVersion: \"31.1\",\n  });\n\n  expect(matrix.previousMajor.status).toBe(\"absent\");\n  expect(matrix.previousMajor.reason).toBe(\"no-prior-major-release\");\n  expect(matrix.previousMinor).toEqual({\n    id: \"previousMinor\",\n    label: \"上一个最近的小版本\",\n    status: \"absent\",\n    version: null,\n    tag: null,\n    reason: \"initial-release\",\n    sameAsPreviousMajor: false,\n  });\n  expect(matrix.latest.version).toBe(\"0.0.1\");\n});\n\ntest(\"boundary case 3: first release of a new major (1.0.0) resolves previousMajor identical to previousMinor and deduplicates execution\", async () => {\n  const matrix = resolveVersionComparisonMatrix({\n    currentVersion: \"1.0.0\",\n    releasedTags: [\"v0.0.1\", \"v0.0.2\", \"v0.0.3\", \"v0.0.4\"],\n    emacsVersion: \"31.1\",\n  });\n\n  expect(matrix.previousMajor).toEqual({\n    id: \"previousMajor\",\n    label: \"上一个大版本\",\n    status: \"active\",\n    version: \"0.0.4\",\n    tag: \"v0.0.4\",\n    reason: \"same-as-previous-minor\",\n    sameAsPreviousMinor: true,\n  });\n  expect(matrix.previousMinor).toEqual({\n    id: \"previousMinor\",\n    label: \"上一个最近的小版本\",\n    status: \"active\",\n    version: \"0.0.4\",\n    tag: \"v0.0.4\",\n    reason: \"resolved\",\n    sameAsPreviousMajor: true,\n  });\n\n  const measuredCalls = [];\n  const fakeMetrics = Object.fromEntries(\n    VERSION_COMPARISON_WORKLOADS.map((w, idx) => [w.id, (idx + 1) * 1.5]),\n  );\n  const report = await runVersionComparisonBenchmark({\n    currentVersion: \"1.0.0\",\n    releasedTags: [\"v0.0.1\", \"v0.0.2\", \"v0.0.3\", \"v0.0.4\"],\n    emacsVersion: \"31.1\",\n    measureEmacsLisp: async () => fakeMetrics,\n    measureEliscriptTarget: async (target) => {\n      measuredCalls.push(`${target.id}:${target.tag ?? target.version}`);\n      return fakeMetrics;\n    },\n  });\n\n  expect(measuredCalls).toEqual([\"previousMinor:v0.0.4\", \"latest:v1.0.0\"]);\n  expect(report.results.previousMajor.status).toBe(\"active\");\n  expect(report.results.previousMajor.deduplicatedFrom).toBe(\"previousMinor\");\n  expect(report.results.previousMajor.metricsMs).toEqual(fakeMetrics);\n  expect(validateVersionComparisonReport(report)).toBe(report);\n\n  const markdown = renderVersionComparisonMarkdown(report);\n  expect(markdown).toContain(\"同上一小版本\");\n  expect(markdown).toContain(\"v0.0.4\");\n  expect(markdown).toContain(\"v1.0.0\");\n});\n\ntest(\"multi-major progression resolves distinct previousMajor and previousMinor versions\", () => {\n  const matrix = resolveVersionComparisonMatrix({\n    currentVersion: \"1.2.0\",\n    releasedTags: [\"v0.0.3\", \"v0.0.4\", \"v1.0.0\", \"v1.1.0\", \"v1.1.5\"],\n    emacsVersion: \"31.1\",\n  });\n\n  expect(matrix.previousMajor).toEqual({\n    id: \"previousMajor\",\n    label: \"上一个大版本\",\n    status: \"active\",\n    version: \"0.0.4\",\n    tag: \"v0.0.4\",\n    reason: \"resolved\",\n    sameAsPreviousMinor: false,\n  });\n  expect(matrix.previousMinor).toEqual({\n    id: \"previousMinor\",\n    label: \"上一个最近的小版本\",\n    status: \"active\",\n    version: \"1.1.5\",\n    tag: \"v1.1.5\",\n    reason: \"resolved\",\n    sameAsPreviousMajor: false,\n  });\n  expect(matrix.latest.version).toBe(\"1.2.0\");\n});\n\ntest(\"release notes summary and release comparison bundle emit main-page summary, merged release notes, and detailed attachment files\", async () => {\n  const fakeMetrics = Object.fromEntries(\n    VERSION_COMPARISON_WORKLOADS.map((w, idx) => [w.id, (idx + 1) * 0.5]),\n  );\n  const report = await runVersionComparisonBenchmark({\n    currentVersion: \"0.0.4\",\n    releasedTags: [\"v0.0.1\", \"v0.0.2\", \"v0.0.3\"],\n    emacsVersion: \"31.1\",\n    measureEmacsLisp: async () => fakeMetrics,\n    measureEliscriptTarget: async () => fakeMetrics,\n  });\n\n  const summary = renderReleaseNotesSummary(report);\n  expect(summary).toContain(\"## 测试与四维性能基准摘要\");\n  expect(summary).toContain(\"eliscript-0.0.4-benchmark-report.md\");\n  expect(summary).toContain(\"eliscript-0.0.4-benchmark-report.json\");\n\n  expect(mergeReleaseNotesWithSummary(\"\", summary)).toBe(`${summary.trim()}\\n`);\n  const highlights = \"## Highlights in v0.0.4\\n\\n- Fast 12,000-depth Zipper (1.95 ms)\";\n  const mergedOnce = mergeReleaseNotesWithSummary(highlights, summary);\n  expect(mergedOnce).toContain(highlights);\n  expect(mergedOnce).toContain(\"## 测试与四维性能基准摘要\");\n  const mergedTwice = mergeReleaseNotesWithSummary(mergedOnce, summary);\n  expect(mergedTwice).toBe(mergedOnce);\n\n  const tempReleaseDir = await mkdtemp(path.join(os.tmpdir(), \"eliscript-release-bundle-\"));\n  try {\n    const bundle = await writeReleaseComparisonBundle(report, tempReleaseDir, {\n      existingNotes: highlights,\n    });\n    expect(path.basename(bundle.summaryPath)).toBe(\"release-summary.md\");\n    expect(path.basename(bundle.mergedNotesPath)).toBe(\"release-notes-merged.md\");\n    expect(path.basename(bundle.markdownPath)).toBe(\"eliscript-0.0.4-benchmark-report.md\");\n    expect(path.basename(bundle.jsonPath)).toBe(\"eliscript-0.0.4-benchmark-report.json\");\n\n    const writtenSummary = await readFile(bundle.summaryPath, \"utf8\");\n    const writtenMerged = await readFile(bundle.mergedNotesPath, \"utf8\");\n    const writtenMarkdown = await readFile(bundle.markdownPath, \"utf8\");\n    const writtenJson = JSON.parse(await readFile(bundle.jsonPath, \"utf8\"));\n\n    expect(writtenSummary).toBe(summary);\n    expect(writtenMerged).toBe(mergedOnce);\n    expect(writtenMarkdown).toContain(\"# Eliscript 四维版本与原生 Emacs Lisp 性能对比报告\");\n    expect(writtenJson.format).toBe(VERSION_COMPARISON_FORMAT);\n    expect(writtenJson.matrix.latest.version).toBe(\"0.0.4\");\n  } finally {\n    await rm(tempReleaseDir, { recursive: true, force: true });\n  }\n});\n\ntest(\"project-internal release-benchmark skill, AGENTS.md performance rules, and release.yml workflow are normalized\", async () => {\n  const skillPath = path.join(projectRoot, \".agents/skills/release-benchmark/SKILL.md\");\n  const skillText = await readFile(skillPath, \"utf8\");\n  expect(skillText).toContain(\"name: release-benchmark\");\n  expect(skillText).toContain(\"emacsLisp\");\n  expect(skillText).toContain(\"previousMajor\");\n  expect(skillText).toContain(\"previousMinor\");\n  expect(skillText).toContain(\"latest\");\n  expect(skillText).toContain(\"--release-dir\");\n  expect(skillText).toContain(\"release-summary.md\");\n\n  const agentsText = await readFile(path.join(projectRoot, \"AGENTS.md\"), \"utf8\");\n  expect(agentsText).toContain(\"## Performance Optimization\");\n  expect(agentsText).toContain(\"PERF-01\");\n  expect(agentsText).toContain(\"PERF-02\");\n  expect(agentsText).toContain(\"PERF-03\");\n  expect(agentsText).toContain(\"tools/performance/version-comparison.eli\");\n\n  const workflowText = await readFile(path.join(projectRoot, \".github/workflows/release.yml\"), \"utf8\");\n  expect(workflowText).toContain(\"contents: write\");\n  expect(workflowText).toContain(\"id-token: write\");\n  expect(workflowText).toContain(\"tools/performance/version-comparison.mjs\");\n  expect(workflowText).toContain(\"eliscript-$VERSION-benchmark-report.md\");\n  expect(workflowText).toContain(\"eliscript-$VERSION-benchmark-report.json\");\n  expect(workflowText).toContain(\"gh release upload \\\"v$VERSION\\\"\");\n  expect(workflowText).toContain(\"gh release edit \\\"v$VERSION\\\"\");\n});\n"))
