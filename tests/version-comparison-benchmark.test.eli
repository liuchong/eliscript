(module tests.version-comparison-benchmark.test
  (import "node:fs/promises" mkdtemp readFile rm mkdir writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve join basename)
  (import "bun:test" expect test)
  (import "../tools/performance/version-comparison.mjs" VERSION_COMPARISON_DIMENSIONS VERSION_COMPARISON_FORMAT VERSION_COMPARISON_WORKLOADS mergeReleaseNotesWithSummary renderReleaseNotesSummary renderVersionComparisonMarkdown resolveVersionComparisonMatrix runVersionComparisonBenchmark validateVersionComparisonReport validateVersionComparisonAcceptance measureEliscriptDirectory writeReleaseComparisonBundle)
  (defconst projectRoot (resolve (js* "import.meta.dir") ".."))
  (defun metrics (factor) (Object/fromEntries (js-call VERSION_COMPARISON_WORKLOADS :map (lambda (w index) (js-array (get w :id) (* (1+ index) factor))))))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun contains (actual expected) (js-call (expect actual) :toContain expected))
  (defasync acceptance-report ()
    (runVersionComparisonBenchmark (js-object :currentVersion "0.1.3"
      :releasedTags (js-array "v0.1.2") :emacsVersion "test-host"
      :measureEmacsLisp (async () (sampled-metrics 3))
      :measureEliscriptTarget (async (target)
        (sampled-metrics (if (= (get target :id) "latest") 1 2))))))

  (defun sampled-metrics (factor)
    (let ((values (metrics factor)) (samples (js-object)) (calibrations (js-object)))
      (js-call VERSION_COMPARISON_WORKLOADS :forEach (lambda (workload)
        (let* ((id (get workload :id)) (minimum (get workload :minimumIterations)))
          (put samples id (js-array (* (get values id) 0.9) (get values id) (* (get values id) 1.1)))
          (put calibrations id (js-object :minimumIterations minimum
                                          :iterationsPerBatch (* minimum 2)
                                          :batchMs (js-array 1 1.1 1.2))))))
      (js-object :metricsMs values :samplesMs samples :calibration calibrations)))

  (test "sampled comparisons retain raw evidence without waiving overlapping regressions" (async ()
    (let* ((report (await (runVersionComparisonBenchmark (js-object :currentVersion "1.0.0"
              :releasedTags (js-array "v0.1.2") :emacsVersion "test-host"
              :measureEmacsLisp (async () (sampled-metrics 3))
              :measureEliscriptTarget (async (target)
                (sampled-metrics (if (= (get target :id) "latest") 1 2)))))))
           (latest (get (get report :results) :latest))
           (baseline (get (get report :results) :previousMinor))
           (id "sequence.first10k"))
      (same (get (get (get report :results) :previousMajor) :samplesMs) (get baseline :samplesMs))
      (same (get (get (get report :results) :previousMajor) :calibration) (get baseline :calibration))
      (contains (renderVersionComparisonMarkdown report) "Calls per batch")
      (put (get latest :metricsMs) id 2.01)
      (put (get latest :samplesMs) id (js-array 1.5 2.01 2.1))
      (js-call (expect (lambda () (validateVersionComparisonAcceptance report))) :toThrow "regresses against previousMinor")
      (contains (renderVersionComparisonMarkdown report) "1.5, 2.01, 2.1")
      (put (get latest :metricsMs) id 2.3)
      (put (get latest :samplesMs) id (js-array 2.21 2.3 2.4))
      (js-call (expect (lambda () (validateVersionComparisonAcceptance report))) :toThrow "regresses against previousMinor"))))

  (test "calibration evidence rejects missing sparse short and invalid call batches" (async ()
    (let* ((report (await (acceptance-report))) (latest (get (get report :results) :latest))
           (calibrations (get (sampled-metrics 1) :calibration)) (id "sequence.first10k")
           (minimum (get (aref VERSION_COMPARISON_WORKLOADS 0) :minimumIterations)))
      (put latest :calibration calibrations)
      (be (validateVersionComparisonReport report) report)
      (js-call (js-array nil undefined (js-object)
        (js-object :minimumIterations minimum :iterationsPerBatch 0 :batchMs (js-array 1 1 1))
        (js-object :minimumIterations minimum :iterationsPerBatch (1- minimum) :batchMs (js-array 1 1 1))
        (js-object :minimumIterations minimum :iterationsPerBatch (+ minimum 0.5) :batchMs (js-array 1 1 1))
        (js-object :minimumIterations minimum :iterationsPerBatch 16777217 :batchMs (js-array 1 1 1))
        (js-object :minimumIterations minimum :iterationsPerBatch (* minimum 2) :batchMs (new globalThis.Array 3))
        (js-object :minimumIterations minimum :iterationsPerBatch (* minimum 2) :batchMs (js-array 1 1))
        (js-object :minimumIterations minimum :iterationsPerBatch (* minimum 2) :batchMs (js-array 1 0.999 1))
        (js-object :minimumIterations minimum :iterationsPerBatch (* minimum 2) :batchMs (js-array 1 globalThis.Infinity 1)))
        :forEach (lambda (invalid)
          (put calibrations id invalid)
          (js-call (expect (lambda () (validateVersionComparisonReport report))) :toThrow "invalid calibration")))
      (put latest :calibration nil)
      (js-call (expect (lambda () (validateVersionComparisonReport report))) :toThrow "invalid calibration"))))

  (test "sample evidence rejects forged medians sparse arrays and nonfinite values" (async ()
    (let* ((report (await (acceptance-report))) (latest (get (get report :results) :latest))
           (samples (get (sampled-metrics 1) :samplesMs)) (id "sequence.first10k"))
      (put latest :samplesMs samples)
      (be (validateVersionComparisonReport report) report)
      (put samples id (js-array 0.9 1.1 1.2))
      (js-call (expect (lambda () (validateVersionComparisonReport report))) :toThrow "metric differs from sample median")
      (js-call (js-array (new globalThis.Array 3) (js-array 0.9 1)
                  (js-array 0.9 1 globalThis.Infinity) (js-array 0 1 1.1)) :forEach
        (lambda (invalid)
          (put samples id invalid)
          (js-call (expect (lambda () (validateVersionComparisonReport report))) :toThrow "invalid samples"))))))

  (test "release acceptance checks unrounded native improvement and every prior-version regression" (async ()
    (let ((report (await (acceptance-report))))
      (be (validateVersionComparisonAcceptance report) report)
      (put (get (get (get report :results) :latest) :metricsMs) "sequence.first10k" 2.000001)
      (put (get (get (get report :results) :latest) :samplesMs) "sequence.first10k" (js-array 1.9 2.000001 2.1))
      (js-call (expect (lambda () (validateVersionComparisonAcceptance report))) :toThrow "regresses against previousMinor")
      (js-call VERSION_COMPARISON_WORKLOADS :forEach (lambda (workload)
        (put (get (get (get report :results) :latest) :metricsMs) (get workload :id) 1000)
        (put (get (get (get report :results) :latest) :samplesMs) (get workload :id) (js-array 900 1000 1100))))
      (try (progn (validateVersionComparisonAcceptance report) (throw (new globalThis.Error "expected acceptance failure")))
        (catch error
          (js-call VERSION_COMPARISON_WORKLOADS :forEach (lambda (workload)
            (contains (get error :message) (str (get workload :id) ": latest"))))
          (be (get error :results) (get report :results)))))))

  (test "report validation rejects substituted dimension identities and failed results" (async ()
    (let* ((report (await (acceptance-report))) (latest (get (get report :results) :latest)))
      (put latest :id "previousMinor")
      (js-call (expect (lambda () (validateVersionComparisonReport report))) :toThrow "dimension result identity differs")
      (put latest :id "latest") (put latest :status "failed")
      (js-call (expect (lambda () (validateVersionComparisonReport report))) :toThrow "dimension result identity differs"))))

  (test "measurement failures retain successful dimensions and do not stop independent versions" (async ()
    (let ((calls (js-array)) (failure undefined))
      (try
        (await (runVersionComparisonBenchmark (js-object :currentVersion "2.2.0"
          :releasedTags (js-array "v1.9.0" "v2.1.0") :emacsVersion "test-host"
          :measureEmacsLisp (async () (js-call calls :push "emacsLisp") (throw (new globalThis.Error "native failure")))
          :measureEliscriptTarget (async (target)
            (js-call calls :push (get target :id))
            (when (= (get target :id) "previousMinor") (throw (new globalThis.Error "minor failure")))
            (sampled-metrics 1)))))
        (catch error (setq failure error)))
      (same calls (js-array "emacsLisp" "previousMinor" "previousMajor" "latest"))
      (be (get (get failure :errors) :length) 2)
      (be (get (get (get failure :results) :latest) :status) "active")
      (be (get (get (get failure :results) :previousMinor) :status) "failed"))))

  (test "a failed shared previous version is attempted once and never relabeled as passing" (async ()
    (let ((calls (js-array)) (failure undefined))
      (try (await (runVersionComparisonBenchmark (js-object :currentVersion "1.0.0"
        :releasedTags (js-array "v0.1.2") :emacsVersion "test-host"
        :measureEmacsLisp (async () (sampled-metrics 3))
        :measureEliscriptTarget (async (target)
          (js-call calls :push (get target :id))
          (when (= (get target :id) "previousMinor") (throw (new globalThis.Error "prior failure")))
          (sampled-metrics 1)))))
        (catch error (setq failure error)))
      (same calls (js-array "previousMinor" "latest"))
      (be (get (get (get failure :results) :previousMajor) :status) "failed")
      (be (get (get (get failure :results) :previousMajor) :deduplicatedFrom) "previousMinor")
      (be (get (get (get failure :results) :previousMajor) :metricsMs) nil))))

  (test "a historical version missing its compiler builds itself instead of borrowing the current compiler" (async ()
    (let ((directory (await (mkdtemp (join (tmpdir) "eliscript-benchmark-own-compiler-")))))
      (try
        (progn
          (await (mkdir (join directory "runtime")))
          (await (writeFile (join directory "runtime/literals.mjs") "// Intentionally not executable: compiler identity fixture.\n"))
          (await (writeFile (join directory "Makefile") "bootstrap-backends:\n\t@echo own-version-build-required >&2\n\t@exit 19\n"))
          (await (js-call (get (expect (measureEliscriptDirectory directory projectRoot)) :rejects)
            :toThrow "own-version-build-required")))
        (finally (await (rm directory (js-object :recursive t :force t))))))))
  (test "version comparison matrix defines the four canonical dimensions in order" (lambda ()
    (js-call (expect VERSION_COMPARISON_DIMENSIONS) :toEqual (js-array "emacsLisp" "previousMajor" "previousMinor" "latest"))
      (js-call (expect (get VERSION_COMPARISON_WORKLOADS :length)) :toBeGreaterThanOrEqual 8)))
  (test "boundary case 1 & 4: 0.x release has absent previousMajor, active previousMinor, and current-latest-only emacsLisp" (lambda ()
    (let ((matrix (resolveVersionComparisonMatrix (js-object "currentVersion" "0.0.4" "releasedTags" (js-array "v0.0.1" "v0.0.2" "v0.0.3") "emacsVersion" "31.1"))))
(js-call (expect (get matrix :emacsLisp)) :toEqual (js-object "id" "emacsLisp" "label" "Emacs Lisp" "status" "active" "version" "31.1" "tag" nil "mode" "current-latest-only" "reason" "current-host-emacs"))
      (js-call (expect (get matrix :previousMajor)) :toEqual (js-object "id" "previousMajor" "label" "\u4e0a\u4e00\u4e2a\u5927\u7248\u672c" "status" "absent" "version" nil "tag" nil "reason" "no-prior-major-release" "sameAsPreviousMinor" false))
      (js-call (expect (get matrix :previousMinor)) :toEqual (js-object "id" "previousMinor" "label" "\u4e0a\u4e00\u4e2a\u6700\u8fd1\u7684\u5c0f\u7248\u672c" "status" "active" "version" "0.0.3" "tag" "v0.0.3" "reason" "resolved" "sameAsPreviousMajor" false))
      (js-call (expect (get matrix :latest)) :toEqual (js-object "id" "latest" "label" "\u6700\u65b0\u7248" "status" "active" "version" "0.0.4" "tag" "v0.0.4" "reason" "current-workspace")))))
  (test "boundary case 2: initial release (0.0.1) has both previousMajor and previousMinor absent" (lambda ()
    (let ((matrix (resolveVersionComparisonMatrix (js-object "currentVersion" "0.0.1" "releasedTags" (js-array "v0.0.1") "emacsVersion" "31.1"))))
(js-call (expect (get (get matrix :previousMajor) :status)) :toBe "absent")
      (js-call (expect (get (get matrix :previousMajor) :reason)) :toBe "no-prior-major-release")
      (js-call (expect (get matrix :previousMinor)) :toEqual (js-object "id" "previousMinor" "label" "\u4e0a\u4e00\u4e2a\u6700\u8fd1\u7684\u5c0f\u7248\u672c" "status" "absent" "version" nil "tag" nil "reason" "initial-release" "sameAsPreviousMajor" false))
      (js-call (expect (get (get matrix :latest) :version)) :toBe "0.0.1"))))
  (test "boundary case 3: first release of a new major (1.0.0) resolves previousMajor identical to previousMinor and deduplicates execution" (async ()
    (let ((matrix (resolveVersionComparisonMatrix (js-object "currentVersion" "1.0.0" "releasedTags" (js-array "v0.0.1" "v0.0.2" "v0.0.3" "v0.0.4") "emacsVersion" "31.1"))))
      (js-call (expect (get matrix :previousMajor)) :toEqual (js-object "id" "previousMajor" "label" "\u4e0a\u4e00\u4e2a\u5927\u7248\u672c" "status" "active" "version" "0.0.4" "tag" "v0.0.4" "reason" "same-as-previous-minor" "sameAsPreviousMinor" t))
      (js-call (expect (get matrix :previousMinor)) :toEqual (js-object "id" "previousMinor" "label" "\u4e0a\u4e00\u4e2a\u6700\u8fd1\u7684\u5c0f\u7248\u672c" "status" "active" "version" "0.0.4" "tag" "v0.0.4" "reason" "resolved" "sameAsPreviousMajor" t)))
    (let* ((measuredCalls (js-array)) (sampled (sampled-metrics 1.5))
           (report (await (runVersionComparisonBenchmark (js-object :currentVersion "1.0.0" :releasedTags (js-array "v0.0.1" "v0.0.2" "v0.0.3" "v0.0.4") :emacsVersion "31.1"
             :measureEmacsLisp (async () sampled) :measureEliscriptTarget (async (target)
               (let ((tag (get target :tag))) (js-call measuredCalls :push (str (get target :id) ":" (if (nullish? tag) (get target :version) tag)))) sampled))))))
      (same measuredCalls (js-array "previousMinor:v0.0.4" "latest:v1.0.0"))
      (be (get (get (get report :results) :previousMajor) :status) "active") (be (get (get (get report :results) :previousMajor) :deduplicatedFrom) "previousMinor")
      (same (get (get (get report :results) :previousMajor) :metricsMs) (get sampled :metricsMs)) (be (validateVersionComparisonReport report) report)
      (let ((markdown (renderVersionComparisonMarkdown report))) (contains markdown "同上一小版本") (contains markdown "v0.0.4") (contains markdown "v1.0.0")))))
  (test "multi-major progression resolves distinct previousMajor and previousMinor versions" (lambda ()
    (let ((matrix (resolveVersionComparisonMatrix (js-object "currentVersion" "1.2.0" "releasedTags" (js-array "v0.0.3" "v0.0.4" "v1.0.0" "v1.1.0" "v1.1.5") "emacsVersion" "31.1"))))
(js-call (expect (get matrix :previousMajor)) :toEqual (js-object "id" "previousMajor" "label" "\u4e0a\u4e00\u4e2a\u5927\u7248\u672c" "status" "active" "version" "0.0.4" "tag" "v0.0.4" "reason" "resolved" "sameAsPreviousMinor" false))
      (js-call (expect (get matrix :previousMinor)) :toEqual (js-object "id" "previousMinor" "label" "\u4e0a\u4e00\u4e2a\u6700\u8fd1\u7684\u5c0f\u7248\u672c" "status" "active" "version" "1.1.5" "tag" "v1.1.5" "reason" "resolved" "sameAsPreviousMajor" false))
      (js-call (expect (get (get matrix :latest) :version)) :toBe "1.2.0"))))
  (test "release notes summary and release comparison bundle emit main-page summary, merged release notes, and detailed attachment files" (async ()
    (let* ((sampled (sampled-metrics 0.5))
           (report (await (runVersionComparisonBenchmark (js-object :currentVersion "0.0.4" :releasedTags (js-array "v0.0.1" "v0.0.2" "v0.0.3") :emacsVersion "31.1"
             :measureEmacsLisp (async () sampled) :measureEliscriptTarget (async () sampled)))))
           (summary (renderReleaseNotesSummary report)))
      (contains summary "## 测试与四维性能基准摘要") (contains summary "eliscript-0.0.4-benchmark-report.md") (contains summary "eliscript-0.0.4-benchmark-report.json")
      (be (mergeReleaseNotesWithSummary "" summary) (str (js-call summary :trim) "\n"))
      (let* ((highlights "## Highlights in v0.0.4\n\n- Fast 12,000-depth Zipper (1.95 ms)") (mergedOnce (mergeReleaseNotesWithSummary highlights summary)) (mergedTwice (mergeReleaseNotesWithSummary mergedOnce summary)))
        (contains mergedOnce highlights) (contains mergedOnce "## 测试与四维性能基准摘要") (be mergedTwice mergedOnce)
        (let ((tempReleaseDir (await (mkdtemp (join (tmpdir) "eliscript-release-bundle-")))))
          (try (let ((bundle (await (writeReleaseComparisonBundle report tempReleaseDir (js-object :existingNotes highlights)))))
            (be (basename (get bundle :summaryPath)) "release-summary.md") (be (basename (get bundle :mergedNotesPath)) "release-notes-merged.md")
            (be (basename (get bundle :markdownPath)) "eliscript-0.0.4-benchmark-report.md") (be (basename (get bundle :jsonPath)) "eliscript-0.0.4-benchmark-report.json")
            (let ((writtenSummary (await (readFile (get bundle :summaryPath) "utf8"))) (writtenMerged (await (readFile (get bundle :mergedNotesPath) "utf8")))
                  (writtenMarkdown (await (readFile (get bundle :markdownPath) "utf8"))) (writtenJson (JSON/parse (await (readFile (get bundle :jsonPath) "utf8")))))
              (be writtenSummary summary) (be writtenMerged mergedOnce) (contains writtenMarkdown "# Eliscript 四维版本与原生 Emacs Lisp 性能对比报告")
              (be (get writtenJson :format) VERSION_COMPARISON_FORMAT) (be (get (get (get writtenJson :matrix) :latest) :version) "0.0.4")))
            (finally (await (rm tempReleaseDir (js-object :recursive t :force t))))))))))
  (test "project-internal release-benchmark skill, AGENTS.md performance rules, and release.yml workflow are normalized" (async ()
    (let ((skillText (await (readFile (join projectRoot ".agents/skills/release-benchmark/SKILL.md") "utf8")))
          (agentsText (await (readFile (join projectRoot "AGENTS.md") "utf8")))
          (workflowText (await (readFile (join projectRoot ".github/workflows/release.yml") "utf8"))))
      (js-call (expect skillText) :toContain "name: release-benchmark")
      (js-call (expect skillText) :toContain "emacsLisp")
      (js-call (expect skillText) :toContain "previousMajor")
      (js-call (expect skillText) :toContain "previousMinor")
      (js-call (expect skillText) :toContain "latest")
      (js-call (expect skillText) :toContain "--release-dir")
      (js-call (expect skillText) :toContain "release-summary.md")
      (js-call (expect agentsText) :toContain "## Performance Optimization")
      (js-call (expect agentsText) :toContain "PERF-01")
      (js-call (expect agentsText) :toContain "PERF-02")
      (js-call (expect agentsText) :toContain "PERF-03")
      (js-call (expect agentsText) :toContain "tools/performance/version-comparison.eli")
      (js-call (expect workflowText) :toContain "contents: write")
      (js-call (expect workflowText) :toContain "id-token: write")
      (js-call (expect workflowText) :toContain "tools/performance/version-comparison.mjs")
      (js-call (expect workflowText) :toContain "eliscript-$VERSION-benchmark-report.md")
      (js-call (expect workflowText) :toContain "eliscript-$VERSION-benchmark-report.json")
      (js-call (expect workflowText) :toContain "gh release upload \"v$VERSION\"")
      (js-call (expect workflowText) :toContain "gh release edit \"v$VERSION\""))))

  (test "shared minima input binds every workload and rejects divergent calibration minima" (async ()
    (let* ((raw (JSON/parse (await (readFile (join projectRoot "tools/performance/version-comparison-minima.json") "utf8"))))
           (ids (Object/keys raw)))
      (same ids (js-call VERSION_COMPARISON_WORKLOADS :map (lambda (workload) (get workload :id))))
      (js-call VERSION_COMPARISON_WORKLOADS :forEach (lambda (workload)
        (let ((id (get workload :id)))
          (be (get workload :minimumIterations) (get raw id))
          (js-call (expect (Number/isSafeInteger (get workload :minimumIterations))) :toBe t))))
      (let* ((report (await (acceptance-report)))
             (latest (get (get report :results) :latest))
             (workload (aref VERSION_COMPARISON_WORKLOADS 0))
             (id (get workload :id))
             (minimum (get workload :minimumIterations)))
        (put (get latest :calibration) id
          (js-object :minimumIterations (1+ minimum) :iterationsPerBatch (* minimum 2) :batchMs (js-array 1 1 1)))
        (js-call (expect (lambda () (validateVersionComparisonReport report))) :toThrow "invalid calibration")
        (put (get latest :calibration) id
          (js-object :minimumIterations minimum :iterationsPerBatch minimum :batchMs (js-array 1 1 1)))
        (be (validateVersionComparisonReport report) report)))))

  (test "active dimensions require complete evidence and deduplicated priors copy it" (async ()
    (let* ((sampled (sampled-metrics 1.5))
           (report (await (runVersionComparisonBenchmark (js-object :currentVersion "1.0.0"
             :releasedTags (js-array "v0.0.1" "v0.0.2" "v0.0.3" "v0.0.4") :emacsVersion "test-host"
             :measureEmacsLisp (async () sampled)
             :measureEliscriptTarget (async () sampled)))))
           (latest (get (get report :results) :latest))
           (dedup (get (get report :results) :previousMajor))
           (baseline (get (get report :results) :previousMinor)))
      (be (get dedup :deduplicatedFrom) "previousMinor")
      (be (get dedup :status) "active")
      (same (get dedup :samplesMs) (get baseline :samplesMs))
      (same (get dedup :calibration) (get baseline :calibration))
      (be (validateVersionComparisonReport report) report)
      ;; Absent evidence fields must fail exactly like nil fields; a validator
      ;; that only checks presence would otherwise accept a stripped report.
      (put latest :samplesMs nil)
      (js-call (expect (lambda () (validateVersionComparisonReport report))) :toThrow "invalid samples")
      (put latest :samplesMs (get sampled :samplesMs))
      (js-call (expect (Reflect/deleteProperty latest "samplesMs")) :toBe t)
      (js-call (expect (lambda () (validateVersionComparisonReport report))) :toThrow "invalid samples")
      (put latest :samplesMs (get sampled :samplesMs))
      (put latest :calibration nil)
      (js-call (expect (lambda () (validateVersionComparisonReport report))) :toThrow "invalid calibration")
      (put latest :calibration (get sampled :calibration))
      (js-call (expect (Reflect/deleteProperty latest "calibration")) :toBe t)
      (js-call (expect (lambda () (validateVersionComparisonReport report))) :toThrow "invalid calibration")
      (put latest :calibration (get sampled :calibration))
      ;; The deduplicated prior version is active and must carry the copied
      ;; evidence; removing either field is a report failure, not an exemption.
      (js-call (expect (Reflect/deleteProperty dedup "samplesMs")) :toBe t)
      (js-call (expect (lambda () (validateVersionComparisonReport report))) :toThrow "invalid samples")
      (put dedup :samplesMs (get baseline :samplesMs))
      (js-call (expect (Reflect/deleteProperty dedup "calibration")) :toBe t)
      (js-call (expect (lambda () (validateVersionComparisonReport report))) :toThrow "invalid calibration")
      (put dedup :calibration (get baseline :calibration))
      (be (validateVersionComparisonReport report) report))))
)
