(module tests.wasm-managed-catch-destructuring.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:child_process" spawnSync)
  (import "node:fs/promises" mkdir mkdtemp readFile readdir rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" relative resolve)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst js-instanceof (js* "(a, b) => a instanceof b"))
  (defconst uint32 (js* "(v) => v >>> 0"))
  (defconst dynamic-import (js* "(specifier) => import(specifier)"))

  (defvar directory nil)
  (defvar b nil)
  (defvar runtime nil)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-catch-binding-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string
                    (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                    "runtime.eli")))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defasync compiled (source)
    (let* ((p (js-call (get b :compiler) :compile_ir_string (str "(defconst marker 1) " source) "catch-binding.eli"))
           (raw-js (js-call (get b :compiler) :emit_ir_string p))
           (javascript (js-call raw-js :replace
                         (new globalThis.RegExp "from \"eliscript/([^\"]+)\"" "g")
                         (lambda (_match rel-path)
                           (str "from " (JSON/stringify (get (pathToFileURL (resolve rel-path)) :href))))))
           (js (await (funcall dynamic-import
                        (str "data:text/javascript;base64,"
                             (js-call (Buffer/from javascript) :toString "base64")))))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p runtime))))
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (js-object :a a :js js))))

  (defun box (a v)
    (let ((ty (funcall js-typeof v)))
      (cond
        ((= ty "string") (js-call a :string v))
        ((= ty "number") (js-call a :number v))
        ((Array/isArray v) (js-call a :sourceArray (js-call v :map (lambda (x) (box a x)))))
        (t v))))

  (defun read (a value)
    (cond
      ((nullish? value) value)
      ((= (get value :kind) 4) (js-call a :readNumber value))
      ((= (get value :kind) 5) (js-call a :readString value))
      ((= (get value :kind) 14)
       (Array/from (js-object :length (js-call a :length value))
         (lambda (_ i)
           (let ((item (js-call a :get value i)))
             (try (read a item) (finally (js-call a :release item)))))))
      (t value)))

  (defun finish (a &rest __host_default_arguments_1)
    (let* ((values (aref __host_default_arguments_1 0)))
    (let ((items (if (undefined? values) (js-array) values)))
      (js-call items :forEach (lambda (value) (js-call a :release value))))
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))

  (test "catch vector bindings consume holes and rest and nested arrays in the exact JS order" (async ()
    (let* ((c (await (compiled "(defun run (value) (try (throw value) (catch [first nil third &rest tail] (js-array first third tail)))) (defun nested (value) (try (throw value) (catch [[a b] c] (js-array a b c)))) (export run nested)")))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array (js-array) (js-array 1) (js-array 1 2 3 4 5)) :forEach
        (lambda (value)
          (let* ((children (js-call value :map (lambda (x) (js-call a :number x))))
                 (input (js-call a :sourceArray children))
                 (out (js-call a :invoke "run" (js-array input))))
            (js-call assert :deepEqual (read a out) (js-call js :run value))
            (js-call (js-call children :concat (js-array input out)) :forEach (lambda (item) (js-call a :release item))))))
      (let* ((x (js-call a :number 1))
             (y (js-call a :number 2))
             (z (js-call a :number 3))
             (inner (js-call a :sourceArray (js-array x y)))
             (input (js-call a :sourceArray (js-array inner z)))
             (out (js-call a :invoke "nested" (js-array input))))
        (js-call assert :deepEqual (read a out) (js-call js :nested (js-array (js-array 1 2) 3)))
        (finish a (js-array x y z inner input out))))))

  (test "catch vector strings use Unicode iteration and fixed bindings leave shared iterator positions untouched after close" (async ()
    (let* ((c (await (compiled "(defun text (value) (try (throw value) (catch [first second &rest tail] (js-array first second tail)))) (defun iterator () (let ((iterator (js-call (js-array 1 2 3) :values))) (js-array (try (throw iterator) (catch [first] first)) (aref (js-call iterator :next) \"value\")))) (export text iterator)")))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array "" "A😀B" "\ud800\udfffX") :forEach
        (lambda (value)
          (let* ((input (js-call a :string value))
                 (out (js-call a :invoke "text" (js-array input))))
            (js-call assert :deepEqual (read a out) (js-call js :text value))
            (js-call a :release input)
            (js-call a :release out))))
      (let ((out (js-call a :invoke "iterator")))
        (js-call assert :deepEqual (read a out) (js-call js :iterator))
        (finish a (js-array out))))))

  (test "catch map defaults distinguish missing from present undefined, bind as first and normalize keys only for plain objects" (async ()
    (let* ((c (await (compiled "(defun run (value trace) (try (throw value) (catch {:strs [a b] :or {a (progn (js-call trace :push \"a\") 9) b (progn (js-call trace :push \"b\") 8)} :as original} (js-array a b (Object/is value original))))) (defun keys (value) (try (throw value) (catch {:keys [a]} a))) (export run keys)")))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array (js-object) (js-object :a undefined) (js-object :a nil :b false)) :forEach
        (lambda (object)
          (let* ((input (js-call a :sourceObject object))
                 (trace (js-call a :sourceArray (js-array)))
                 (out (js-call a :invoke "run" (js-array input trace)))
                 (expectedTrace (js-array)))
            (js-call assert :deepEqual (read a out) (js-call js :run object expectedTrace))
            (js-call assert :deepEqual (read a trace) expectedTrace)
            (js-call (js-array input trace out) :forEach (lambda (v) (js-call a :release v))))))
      (let* ((n (js-call a :number 7))
             (input (js-call a :sourceObject (js-object :a n)))
             (out (js-call a :invoke "keys" (js-array input))))
        (js-call assert :equal (read a out) (js-call js :keys (js-object :a 7)))
        (finish a (js-array n input out))))))

  (test "catch map targets nest array and map patterns and normal completion keeps finally effects" (async ()
    (let* ((c (await (compiled "(defun run (value trace) (try (throw value) (catch {[a b] \"items\" {:strs [name]} \"record\"} (js-array a b name)) (finally (js-call trace :push \"finally\")))) (export run)")))
           (a (get c :a))
           (js (get c :js))
           (x (js-call a :number 1))
           (y (js-call a :number 2))
           (name (js-call a :string "x"))
           (items (js-call a :sourceArray (js-array x y)))
           (record (js-call a :sourceObject (js-object :name name)))
           (input (js-call a :sourceObject (js-object :items items :record record)))
           (trace (js-call a :sourceArray (js-array)))
           (out (js-call a :invoke "run" (js-array input trace)))
           (expectedTrace (js-array)))
      (js-call assert :deepEqual (read a out) (js-call js :run (js-object :items (js-array 1 2) :record (js-object :name "x")) expectedTrace))
      (js-call assert :deepEqual (read a trace) expectedTrace)
      (finish a (js-array x y name items record input trace out)))))

  (test "catch map default shadowing retains TDZ ReferenceError instead of reading the outer variable or nil" (async ()
    (let* ((c (await (compiled "(defun run (value) (let ((a 99)) (try (throw value) (catch {:strs [a] :or {a a}} a)))) (defun recover (value) (try (run value) (catch error (aref error \"name\")))) (export run recover)")))
           (a (get c :a))
           (js (get c :js))
           (input (js-call a :sourceObject (js-object))))
      (js-call assert :throws (lambda () (js-call js :run (js-object))) globalThis.ReferenceError)
      (js-call assert :throws
        (lambda () (js-call a :invoke "run" (js-array input)))
        (lambda (err)
          (and (funcall js-instanceof err globalThis.ReferenceError)
               (let ((d (get err :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-RT0012"))))))
      (let ((name (js-call a :invoke "recover" (js-array input))))
        (js-call assert :equal (js-call a :readString name) (js-call js :recover (js-object)))
        (finish a (js-array input name))))))

  (test "map binding defaults initialize left to right and predeclared captured cells retain TDZ until their own initialization" (async ()
    (let* ((c (await (compiled "(defun later (value) (let ((f false) (x 99)) (try (throw value) (catch {:strs [f x] :or {f (lambda () x) x 7}} (funcall f))))) (defun early (value) (let ((f false) (x 99)) (try (throw value) (catch {:strs [f x] :or {f (lambda () x) x (funcall f)}} x)))) (defun order (value) (let ((a 99)) (try (throw value) (catch {:strs [a b] :or {a 7 b (+ a 1)}} (js-array a b))))) (export later early order)")))
           (a (get c :a))
           (js (get c :js))
           (input (js-call a :sourceObject (js-object)))
           (later (js-call a :invoke "later" (js-array input)))
           (order (js-call a :invoke "order" (js-array input))))
      (js-call assert :equal (js-call a :readNumber later) (js-call js :later (js-object)))
      (js-call assert :deepEqual (read a order) (js-call js :order (js-object)))
      (js-call assert :throws (lambda () (js-call js :early (js-object))) globalThis.ReferenceError)
      (js-call assert :throws
        (lambda () (js-call a :invoke "early" (js-array input)))
        (lambda (e)
          (and (funcall js-instanceof e globalThis.ReferenceError)
               (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-RT0012"))))))
      (finish a (js-array input later order)))))

  (test "map lookup uses own string keys and exact indexed and Map/Set lookup rules without coercing keys" (async ()
    (let* ((keys (js-array 0 -0.0 1 2 -1 0.5 4294967296 1e300 "0" "length"))
           (definitions (js-call
                          (js-call keys :map
                            (lambda (key i)
                              (str "(defun lookup" i " (value) (try (throw value) (catch {found "
                                   (if (Object/is key -0.0) "-0.0" (JSON/stringify key))
                                   " :or {found \"missing\"}} found)))")))
                          :join " "))
           (exports (js-call (js-call keys :map (lambda (_ i) (str "lookup" i))) :join " "))
           (c (await (compiled
                       (str definitions
                            " (defun lookup-a (value) (try (throw value) (catch {found \"a\" :or {found \"missing\"}} found)))"
                            " (defun symbol-key () (try (throw (js-object :a 7)) (catch {:syms [a]} a)))"
                            " (defun map () (lookup-a (new (js* \"Map\") (js-array (js-array \"a\" undefined)))))"
                            " (defun set () (lookup1 (new (js* \"Set\") (js-array -0.0))))"
                            " (export " exports " symbol-key map set)"))))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array "😀X" (js-array) (js-array undefined) nil undefined) :forEach
        (lambda (value)
          (let* ((owned (js-array))
                 (input (cond
                          ((= (funcall js-typeof value) "string")
                           (let ((s (js-call a :string value))) (js-call owned :push s) s))
                          ((Array/isArray value)
                           (let ((arr (js-call a :sourceArray value))) (js-call owned :push arr) arr))
                          (t value)))
                 (i 0))
            (while (< i (js-length keys))
              (let* ((name (str "lookup" i))
                     (out (js-call a :invoke name (js-array input))))
                (js-call assert :deepEqual (read a out) (js-call js name value))
                (js-call a :release out))
              (setq i (1+ i)))
            (js-call owned :forEach (lambda (v) (js-call a :release v))))))
      (let ((proto (js-call a :invoke "symbol-key"))
            (set-val (js-call a :invoke "set")))
        (js-call assert :equal (js-call a :readNumber proto) (js-call js :symbol_key))
        (funcall assert (Object/is (js-call a :readNumber set-val) (js-call js :set)))
        (js-call assert :equal (js-call a :invoke "map") (js-call js :map))
        (finish a (js-array proto set-val))))))

  (test "native iterator return runs before catch body, skips after natural exhaustion and preserves original nested binding errors" (async ()
    (let* ((c (await (compiled "(defun run (mode trace) (let ((iterator (js-call (js-array 1 2 3) :values))) (put iterator \"return\" (lambda () (js-call trace :push \"return\") (if (= mode 1) (throw \"close\") (js-object)))) (try (try (throw iterator) (catch [first] (js-call trace :push \"body\") first)) (catch error error) (finally (js-call trace :push \"finally\"))))) (defun exhausted (trace) (let ((iterator (js-call (js-array) :values))) (put iterator \"return\" (lambda () (js-call trace :push \"wrong\") (js-object))) (try (throw iterator) (catch [a b] (js-array a b))))) (defun empty (trace) (let ((iterator (js-call (js-array 1) :values))) (put iterator \"return\" (lambda () (js-call trace :push \"return\") (js-object))) (try (throw iterator) (catch [] 7)))) (defun nested-error (trace) (let ((iterator (js-call (js-array nil) :values))) (put iterator \"return\" (lambda () (js-call trace :push \"return\") (throw \"wrong\"))) (try (try (throw iterator) (catch [[first]] first)) (catch error (aref error \"name\"))))) (export run exhausted empty nested-error)")))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array 0 1) :forEach
        (lambda (mode)
          (let* ((m (js-call a :number mode))
                 (trace (js-call a :sourceArray (js-array)))
                 (out (js-call a :invoke "run" (js-array m trace)))
                 (expected (js-array)))
            (js-call assert :deepEqual (read a out) (js-call js :run mode expected))
            (js-call assert :deepEqual (read a trace) expected)
            (js-call (js-array m trace out) :forEach (lambda (v) (js-call a :release v))))))
      (js-call (js-array "exhausted" "empty" "nested-error") :forEach
        (lambda (name)
          (let* ((trace (js-call a :sourceArray (js-array)))
                 (out (js-call a :invoke name (js-array trace)))
                 (expected (js-array)))
            (js-call assert :deepEqual (read a out) (js-call js (js-call name :replaceAll "-" "_") expected))
            (js-call assert :deepEqual (read a trace) expected)
            (js-call a :release trace)
            (js-call a :release out))))
      (finish a))))

  (test "ReferenceError constructors are real source objects with inherited names and nonenumerable messages and their prototype cache is weak" (async ()
    (let* ((c (await (compiled "(defun make (message) (new (js* \"ReferenceError\") message)) (defun describe (error) (js-array (aref error \"name\") (aref error \"message\") (Object/hasOwn error \"name\") (Object/hasOwn error \"message\") (Object/keys error))) (export make describe)")))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array undefined "x") :forEach
        (lambda (message)
          (let* ((input (box a message))
                 (error (js-call a :invoke "make" (js-array input)))
                 (out (js-call a :invoke "describe" (js-array error))))
            (js-call assert :deepEqual (read a out) (js-call js :describe (js-call js :make message)))
            (js-call a :release input)
            (js-call a :release error)
            (js-call a :release out)
            (js-call a :collect))))
      (finish a))))

  (test "random Unicode vector bindings and sparse arrays match independent JS results under per-allocation GC" (async ()
    (let* ((c (await (compiled "(defun run (value) (try (throw value) (catch [a nil b &rest tail] (js-array a b tail)))) (export run)")))
           (a (get c :a))
           (js (get c :js))
           (state 1508323746)
           (next (lambda ()
                   (setq state (funcall uint32 (+ (Math/imul state 1664525) 1013904223)))
                   state))
           (i 0))
      (while (< i 200)
        (let ((text "")
              (j 0)
              (n (% (funcall next) 12)))
          (while (< j n)
            (setq text (str text (String/fromCharCode (unsigned-bit-shift-right (funcall next) 16))))
            (setq j (1+ j)))
          (let* ((input (js-call a :string text))
                 (out (js-call a :invoke "run" (js-array input))))
            (js-call assert :deepEqual (read a out) (js-call js :run text))
            (js-call a :release input)
            (js-call a :release out)))
        (setq i (1+ i)))
      (let ((sp (let ((arr (globalThis.Array 4)))
                  (put arr 0 undefined)
                  (put arr 2 nil)
                  (put arr 3 false)
                  arr)))
        (js-call (js-array (globalThis.Array 4) sp (js-array)) :forEach
          (lambda (src)
            (let* ((input (js-call a :sourceArray src))
                   (out (js-call a :invoke "run" (js-array input))))
              (js-call assert :deepEqual (read a out) (js-call js :run src))
              (js-call a :release input)
              (js-call a :release out)))))
      (funcall assert (> (get (js-call a :stats) :collections) 200))
      (finish a))))

  (test "pattern cell and lookup raw ABIs reject illegal handles transactionally and distinguish an initialized undefined value from TDZ" (lambda ()
    (let* ((p (js-call (get b :compiler) :compile_ir_string "(defun f (x) x) (export f)" "binding-abi.eli"))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p runtime)))
           (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
           (heap (funcall uint32 (js-call e "heap-new" 64 4096 16384)))
           (call (lambda (name &rest args)
                   (let ((value (funcall uint32 (Reflect/apply (get e name) e (js-call (js-array heap) :concat args)))))
                     (js-call assert :equal (js-call e "last-error") 0 name)
                     value)))
           (frame (funcall call "frame-new" 4)))
      (funcall call "heap-auto" 1)
      (let ((cell (funcall call "value-binding-cell-new")))
        (funcall call "frame-set" frame 0 cell)
        (js-call assert :equal (js-call e "value-binding-get" heap cell) 0)
        (js-call assert :equal (js-call e "last-error") 12)
        (js-call assert :equal (js-call e "value-binding-init" heap cell 4294967295) 0)
        (js-call assert :equal (js-call e "last-error") 1)
        (js-call assert :equal (js-call e "value-binding-get" heap cell) 0)
        (js-call assert :equal (js-call e "last-error") 12)
        (funcall call "value-binding-init" cell 3)
        (js-call assert :equal (funcall call "value-binding-get" cell) 3)
        (funcall call "value-binding-set" cell 1)
        (js-call assert :equal (funcall call "value-binding-get" cell) 1)
        (js-call (js-array "value-binding-get" "value-binding-iterator-step" "value-binding-lookup") :forEach
          (lambda (name)
            (let ((args (cond
                          ((= name "value-binding-lookup") (js-array 4294967295 0 0))
                          ((= name "value-binding-iterator-step") (js-array 4294967295 1))
                          (t (js-array 4294967295)))))
              (js-call assert :equal (Reflect/apply (get e name) e (js-call (js-array heap) :concat args)) 0)
              (js-call assert :equal (js-call e "last-error") 1))))
        (funcall call "frame-pop" frame)
        (funcall call "heap-collect")
        (js-call assert :equal (funcall call "heap-live") 0)))))

  (test "pattern allocation failure preserves caller frames and source data then permits later successful calls" (lambda ()
    (let* ((names (js-call (Array/from (js-object :length 40) (lambda (_ i) (str "a" i))) :join " "))
           (p (js-call (get b :compiler) :compile_ir_string
                (str "(defconst marker 1) (defun wide (value) (try (throw value) (catch [" names "] a0))) (defun recover () 7) (export wide recover)")
                "binding-capacity.eli"))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p runtime)))
           (a (instantiateManagedRuntime bytes (js-object :maxSlots 32 :initialBytes 4096 :maxBytes 16384))))
      (js-call a :auto 1)
      (let ((input (js-call a :sourceArray (js-call (globalThis.Array 40) :fill false)))
            (frame (js-call a :frame 1)))
        (js-call a :frameSet frame 0 input)
        (js-call assert :throws
          (lambda () (js-call a :invoke "wide" (js-array input)))
          (lambda (e) (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-RT0002")))))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (js-call assert :equal (js-call a :length input) 40)
        (js-call a :collect)
        (let ((out (js-call a :invoke "recover")))
          (js-call assert :equal (js-call a :readNumber out) 7)
          (js-call a :leaveFrame frame)
          (finish a (js-array input out)))))))

  (test "a real trap during a pattern-bound read keeps its WASM boundary and unwinds private cells while preserving caller roots" (async ()
    (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (start (js-call source :indexOf "  (defun value-binding-get (heap cell)"))
           (end (js-call source :indexOf "  (defun value-binding-init" start)))
      (funcall assert (and (>= start 0) (> end start)))
      (let* ((faulty (str (js-call source :slice 0 start)
                          "  (defun value-binding-get (heap cell) (load-u32 4294967295))\n"
                          (js-call source :slice end)))
             (r (js-call (get b :compiler) :compile_ir_string faulty "binding-trap.eli"))
             (p (js-call (get b :compiler) :compile_ir_string
                  "(defconst marker 1) (defun run (input) (try (throw input) (catch [a] a))) (defun recover () 7) (export run recover)"
                  "binding-trap-program.eli"))
             (a (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p r)))))
        (js-call a :auto 1)
        (let ((input (js-call a :sourceArray (js-array false)))
              (frame (js-call a :frame 1)))
          (js-call a :frameSet frame 0 input)
          (js-call assert :throws
            (lambda () (js-call a :invoke "run" (js-array input)))
            globalThis.WebAssembly.RuntimeError)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (js-call a :collect)
          (let ((out (js-call a :invoke "recover")))
            (js-call assert :equal (js-call a :readNumber out) 7)
            (js-call a :leaveFrame frame)
            (finish a (js-array input out))))))))

  (test "missing ILookup protocol raises the existing ProtocolDispatchError with exact source fields and enumerable descriptors" (async ()
    (let* ((c (await (compiled "(defun run (mode) (try (cond ((= mode 0) (try (throw (js-object :__proto__ nil :a 7)) (catch {:strs [a]} a))) ((= mode 1) (try (throw (js-object :__proto__ (js-object) :a 7)) (catch {:keys [a]} a))) ((= mode 2) (try (throw 7) (catch {:strs [a]} a))) ((= mode 3) (try (throw false) (catch {:strs [a]} a))) ((= mode 4) (try (throw (new (js* \"TypeError\") \"x\")) (catch {:strs [message]} message))) (t (try (throw (js-call (js-array) :values)) (catch {:strs [a]} a)))) (catch error (js-array (aref error \"name\") (aref error \"message\") (aref error \"code\") (aref error \"protocol\") (aref error \"operation\") (aref error \"observedType\") (aref error \"reason\") (Object/hasOwn error \"name\") (Object/keys error))))) (export run)")))
           (a (get c :a))
           (js (get c :js))
           (mode 0))
      (while (< mode 6)
        (let* ((m (js-call a :number mode))
               (out (js-call a :invoke "run" (js-array m))))
          (js-call assert :deepEqual (read a out) (js-call js :run mode))
          (js-call a :release m)
          (js-call a :release out))
        (setq mode (1+ mode)))
      (finish a))))

  (test "keyword and symbol pattern keys never become string keys when querying native Map and Set values" (async ()
    (let* ((c (await (compiled "(defun map () (try (throw (new (js* \"Map\") (js-array (js-array \"a\" 7)))) (catch {:keys [a]} a))) (defun set () (try (throw (new (js* \"Set\") (js-array \"a\"))) (catch {:syms [a]} a))) (export map set)")))
           (a (get c :a))
           (js (get c :js)))
      (js-call assert :equal (js-call a :invoke "map") (js-call js :map))
      (js-call assert :equal (js-call a :invoke "set") (js-call js :set))
      (finish a))))

  (defvar generationEvidence nil)

  (defasync buildGenerations ()
    (let* ((files (js-call (js-call (await (readdir "bootstrap/compiler")) :filter (lambda (file) (js-call file :endsWith ".eli"))) :sort))
           (all (js-array b))
           (previous b)
           (generations-list (js-array 2 3))
           (gi 0))
      (while (< gi (js-length generations-list))
        (let* ((generation (aref generations-list gi))
               (output (resolve directory (str "g" generation)))
               (bootstrap (resolve output "bootstrap"))
               (fi 0))
          (await (mkdir bootstrap (js-object :recursive t)))
          (while (< fi (js-length files))
            (let* ((file (aref files fi))
                   (path (resolve "bootstrap/compiler" file))
                   (name (js-call file :replace (new globalThis.RegExp "\\.eli$") ".mjs"))
                   (emission (js-call (get previous :compiler) :compile_string_with_source_map
                               (await (readFile path "utf8")) path name (relative bootstrap path))))
              (await (writeFile (resolve bootstrap name) (str (get emission :javascript) "//# sourceMappingURL=" name ".map\n")))
              (await (writeFile (resolve bootstrap (str name ".map")) (get emission :sourceMap))))
            (setq fi (1+ fi)))
          (let ((current (await (buildBackends (js-object :outputRoot output :frontend (get previous :compiler))))))
            (put current :compiler (await (funcall dynamic-import (get (pathToFileURL (resolve bootstrap "compiler.mjs")) :href))))
            (js-call all :push current)
            (setq previous current)))
        (setq gi (1+ gi)))
      (let* ((filename (resolve "tests/fixtures/wasm-managed-catch-destructuring.eli"))
             (source (await (readFile filename "utf8")))
             (seedFile (resolve directory "catch-binding-seed.mjs"))
             (seed (spawnSync (resolve "bin/eliscript-seed") (js-array "--output" seedFile filename) (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get seed :status) 0 (get seed :stderr))
        (let ((javascript (await (readFile seedFile "utf8")))
              (outputs (js-array))
              (ai 0))
          (while (< ai (js-length all))
            (let* ((current (aref all ai))
                   (p (js-call (get current :compiler) :compile_ir_string source filename))
                   (r (js-call (get current :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli")))
              (js-call assert :equal (js-call (get current :compiler) :emit_ir_string p) javascript)
              (js-call outputs :push (Uint8Array/from (js-call (get current :managed) :emit_managed_wasm p r))))
            (setq ai (1+ ai)))
          (let ((fi 0))
            (while (< fi (js-length files))
              (let* ((file (aref files fi))
                     (path (resolve "bootstrap/compiler" file))
                     (src (await (readFile path "utf8")))
                     (expected (js-call (get (aref all 0) :compiler) :compile_string src path)))
                (js-call (js-call all :slice 1) :forEach
                  (lambda (current)
                    (js-call assert :equal (js-call (get current :compiler) :compile_string src path) expected))))
              (setq fi (1+ fi))))
          (js-call assert :deepEqual (aref outputs 0) (aref outputs 1))
          (js-call assert :deepEqual (aref outputs 1) (aref outputs 2))
          (let* ((seeded (await (buildBackends (js-object :outputRoot (resolve directory "seed-backends") :seed t))))
                 (p (js-call (get seeded :compiler) :compile_ir_string source filename))
                 (r (js-call (get seeded :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli")))
            (js-call assert :deepEqual (Uint8Array/from (js-call (get seeded :managed) :emit_managed_wasm p r)) (aref outputs 0))
            (js-object :bytes (aref outputs 2) :javascript javascript))))))

  (defun generations ()
    (when (nullish? generationEvidence)
      (setq generationEvidence (buildGenerations)))
    generationEvidence)

  (test "catch destructuring retains independent Seed and complete three-generation frontend and backend byte fixed points" (async ()
    (let* ((evidence (await (generations)))
           (a (instantiateManagedRuntime (get evidence :bytes))))
      (js-call a :auto 1)
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module (get evidence :bytes))) (js-array))
      (let* ((text (js-call a :string "A😀B中X"))
             (out (js-call a :invoke "array" (js-array text))))
        (js-call assert :deepEqual (read a out) (js-array "A" "B" (js-array "中" "X")))
        (let* ((object (js-call a :sourceObject (js-object :left undefined)))
               (mapped (js-call a :invoke "object" (js-array object)))
               (captured (js-call a :invoke "captured" (js-array object)))
               (tdz (js-call a :invoke "tdz" (js-array object))))
          (js-call assert :deepEqual (read a mapped) (js-array undefined 8 t))
          (js-call assert :equal (js-call a :readNumber captured) 7)
          (js-call assert :equal (js-call a :readString tdz) "ReferenceError")
          (let ((protocol (js-call a :invoke "protocol")))
            (js-call assert :deepEqual (read a protocol)
              (js-array "ProtocolDispatchError" "ELI-RUNTIME-PROTOCOL" "object:anonymous"
                (js-array "name" "code" "protocol" "operation" "observedType" "reason")))
            (finish a (js-array text out object mapped captured tdz protocol)))))))
    120000)

  (test "Node runs the exact zero-import catch artifact and preserves sparse vector binding, map defaults and ReferenceError" (async ()
    (let* ((evidence (await (generations)))
           (path (resolve directory "catch.wasm")))
      (await (writeFile path (get evidence :bytes)))
      (let ((result (spawnSync "node"
                      (js-array (resolve "tests/helpers/wasm-managed-catch-destructuring-node.mjs")
                                (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                                path)
                      (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get result :status) 0 (get result :stderr)))))
    120000)

  (defconst customIteratorSource "
 (defun source (limit fail-next trace)
   (let ((state (js-object :index 0)) (iterator (js-object)) (source (js-object)))
     (put iterator \"next\" (lambda ()
       (let ((index (aref state \"index\")))
         (js-call trace :push index) (put state \"index\" (1+ index))
         (if (and fail-next (= index 1)) (throw false)
           (js-object :done (>= index limit) :value index)))))
     (put iterator \"return\" (lambda () (js-call trace :push \"return\") (js-object)))
     (put source (js* \"Symbol.iterator\") (lambda () (js-call trace :push \"iterator\") iterator)) source))
 (defun fixed (limit fail-next trace)
   (try (try (throw (source limit fail-next trace)) (catch [a nil c] (js-call trace :push \"body\") (js-array a c)))
     (catch error error) (finally (js-call trace :push \"finally\"))))
 (defun empty (trace) (try (throw (source 3 false trace)) (catch [] 7)))
 (defun rest (trace) (try (throw (source 3 false trace)) (catch [a &rest tail] (js-array a tail))))
 (export fixed empty rest)")

  (test "custom catch iterators consume holes stepwise, close fixed bindings, skip close on next failure and exhaust only rest" (async ()
    (let* ((c (await (compiled customIteratorSource)))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array (js-array 5 false) (js-array 1 false) (js-array 5 t)) :forEach
        (lambda (pair)
          (let* ((limit (aref pair 0))
                 (failNext (aref pair 1))
                 (n (js-call a :number limit))
                 (trace (js-call a :sourceArray (js-array)))
                 (out (js-call a :invoke "fixed" (js-array n failNext trace)))
                 (expected (js-array)))
            (js-call assert :deepEqual (read a out) (js-call js :fixed limit failNext expected))
            (js-call assert :deepEqual (read a trace) expected)
            (js-call (js-array n trace out) :forEach (lambda (v) (js-call a :release v))))))
      (js-call (js-array "empty" "rest") :forEach
        (lambda (name)
          (let* ((trace (js-call a :sourceArray (js-array)))
                 (out (js-call a :invoke name (js-array trace)))
                 (expected (js-array)))
            (js-call assert :deepEqual (read a out) (js-call js name expected))
            (js-call assert :deepEqual (read a trace) expected)
            (js-call a :release trace)
            (js-call a :release out))))
      (finish a))))

  (test "custom iterator binding closes after a nested failure and retains the original exception over a throwing return callback" (async ()
    (let* ((c (await (compiled "(defun run (trace) (let ((iterator (js-object :next (lambda () (js-call trace :push \"next\") (js-object :done false :value nil)) :return (lambda () (js-call trace :push \"return\") (throw \"wrong\")))) (source (js-object))) (put source (js* \"Symbol.iterator\") (lambda () iterator)) (try (try (throw source) (catch [[first]] first)) (catch error (aref error \"name\"))))) (export run)")))
           (a (get c :a))
           (js (get c :js))
           (trace (js-call a :sourceArray (js-array)))
           (out (js-call a :invoke "run" (js-array trace)))
           (expected (js-array)))
      (js-call assert :deepEqual (read a out) (js-call js :run expected))
      (js-call assert :deepEqual (read a trace) expected)
      (finish a (js-array trace out))))))
