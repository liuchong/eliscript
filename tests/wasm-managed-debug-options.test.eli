(module tests.wasm-managed-debug-options.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/compiler-debug.mjs" createCompilerDebugMap)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defun is-instance (value ctor)
    (funcall (js* "(a, b) => a instanceof b") value ctor))

  (defvar directory undefined)
  (defvar bytes undefined)
  (defvar debug undefined)
  (defvar machineFrames undefined)
  (defconst filename "loader/输入😀.eli")

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-wasm-debug-options-"))))
    (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
           (memory (await (dynamic-import (get (pathToFileURL (resolve (get backend :directory) "memory.mjs")) :href))))
           ;; Only the loader's minimal ABI is needed here. The actual memory32 load
           ;; and trap-site transport are emitted by the production WASM backend; this
           ;; fixture does not build a compiler binary or claim managed-heap coverage.
           (source "(import \"eliscript:memory32\" load-u32)\n    (defun heap-new (slots initial maximum) 256)\n    (defun last-error () 0)\n    (defun frame-current (heap) 0)\n    (defun frame-unwind (heap target) 1)\n    (defun value-standard-prototypes-close (heap) 1)\n    (defun safe (heap) 2)\n    (defun crash (heap) (load-u32 65536) 3)\n    (export heap-new last-error frame-current frame-unwind\n      value-standard-prototypes-close safe crash)")
           (typed (js-call memory :lower_memory_program (js-call (get backend :compiler) :compile_ir_string source filename)))
           (artifact (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact typed (js-object :initialPages 1 :maximumPages 1))))
      (setq debug (get artifact :debug))
      (put debug :sources (js-array (js-object :id filename :filename filename :macroOrigins (js-array))))
      (let ((crashed (js-call (get typed :functions) :find (lambda (fn) (= (get fn :name) "crash")))))
        (assert crashed)
        (let ((sites (js-call (get debug :trapSites) :filter (lambda (site) (= (get site :functionIndex) (get crashed :index))))))
          (js-call assert :equal (js-length sites) 1 "the real out-of-bounds load has one exact guard trap")
          (setq machineFrames
            (js-array (js-object :address (get (aref sites 0) :address)
                                 :offsetBase "module"
                                 :functionIndex (get crashed :index)
                                 :returnAddress false)))
          (let ((descriptor (js-object
                              :format "eliscript-managed-control"
                              :version 1
                              :abi "managed-control-v1"
                              :functions (js-array (js-object :name "safe" :arity 0)
                                                   (js-object :name "crash" :arity 0)))))
            (setq bytes
              (Uint8Array/from
                (js-call (get backend :wasm) :append_metadata_section
                  (get artifact :bytes)
                  "eliscript-managed-control"
                  (JSON/stringify descriptor))))
            (assert (js-call globalThis.WebAssembly :validate bytes))
            (let ((module (new globalThis.WebAssembly.Module bytes)))
              (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports module) (js-array))
              (js-call assert :equal
                (js-length (js-call globalThis.WebAssembly.Module :customSections module "eliscript-trap-sites")) 1)))))))
    120000)

  (afterAll (async ()
    (setq bytes undefined)
    (setq debug undefined)
    (setq machineFrames undefined)
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun trap (runtime)
    (let ((thrown undefined))
      (try
        (js-call runtime :invoke "crash")
        (catch error (setq thrown error)))
      (assert (is-instance thrown globalThis.WebAssembly.RuntimeError) "actual WASM bounds trap must cross the loader")
      (js-call assert :deepEqual (get thrown :eliscriptFrames) machineFrames)
      (assert (Object/isFrozen (get thrown :eliscriptFrames)))
      (assert (js-call (get thrown :eliscriptFrames) :every globalThis.Object.isFrozen))
      thrown))

  (test "omitted, undefined and false input debug options retain exact machine frames without source mapping" (lambda ()
    (let ((original (js-call bytes :slice)))
      (js-call (js-array (js-object) (js-object :debug undefined) (js-object :debug false)) :forEach
        (lambda (options)
          (let ((runtime (instantiateManagedRuntime bytes options)))
            (try
              (js-call assert :equal (js-call runtime :invoke "safe") t)
              (let ((repeat 0))
                (while (< repeat 2)
                  (let ((error (trap runtime)))
                    (js-call assert :equal (Object/hasOwn error "eliscriptSourceFrames") false)
                    (js-call assert :equal (js-call runtime :invoke "safe") t "trap transport restores subsequent calls"))
                  (setq repeat (1+ repeat))))
              (finally (js-call runtime :closeModule))))))
      (js-call assert :deepEqual bytes original "runtime debug options do not alter the input binary"))))

  (test "a valid input debug document maps the same exact traps using an isolated snapshot" (lambda ()
    (let* ((supplied (globalThis.structuredClone debug))
           (saved (globalThis.structuredClone supplied))
           (expected (js-call (createCompilerDebugMap saved) :mapFrames machineFrames)))
      (js-call assert :equal (js-length expected) 1)
      (js-call assert :equal (get (get (aref expected 0) :source) :function) "crash")
      (js-call assert :equal (get (get (get (aref expected 0) :source) :span) :filename) filename)
      (js-call assert :equal (get (get (aref expected 0) :source) :source) filename)
      (let* ((options (js-object :debug supplied))
             (runtime (instantiateManagedRuntime bytes options)))
        (js-call assert :deepEqual supplied saved "loader construction does not consume a public debug document")
        (put (get supplied :functions) :length 0)
        (put (get supplied :ranges) :length 0)
        (put (get supplied :sources) :length 0)
        (put (get supplied :codeSection) :payloadStart (get (get supplied :codeSection) :end))
        (put options :debug false)
        (try
          (js-call assert :equal (js-call runtime :invoke "safe") t)
          (let ((repeat 0))
            (while (< repeat 2)
              (js-call assert :deepEqual (get (trap runtime) :eliscriptSourceFrames) expected)
              (js-call assert :equal (js-call runtime :invoke "safe") t)
              (setq repeat (1+ repeat))))
          (finally (js-call runtime :closeModule)))
        (js-call assert :deepEqual debug saved "another instance retains the complete original debug document")))))

  (test "null, true and other unsupported input debug documents keep their original rejection" (lambda ()
    (js-call (js-array nil t 0 "false" (js-array) (js-object)) :forEach
      (lambda (value)
        (js-call assert :throws
          (lambda () (instantiateManagedRuntime bytes (js-object :debug value)))
          (lambda (error)
            (assert (is-instance error globalThis.TypeError))
            (js-call assert :equal (get error :message) "unsupported compiler instruction map")
            t))))
    (let ((runtime (instantiateManagedRuntime bytes (js-object :debug false))))
      (try
        (js-call assert :equal (js-call runtime :invoke "safe") t)
        (js-call assert :equal (Object/hasOwn (trap runtime) "eliscriptSourceFrames") false)
        (finally (js-call runtime :closeModule)))))))
