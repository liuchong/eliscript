tDiagnostic.location.file==='property-protocol.eli');}});\n\nlet generationEvidence;\nasync function generations(){if(generationEvidence)return generationEvidence;const files=(await readdir('bootstrap/compiler')).filter(f=>f.endsWith('.eli')).sort(),all=[b];let previous=b;for(const generation of[2,3]){const output=resolve(directory,'g'+generation),bootstrap=resolve(output,'bootstrap');await mkdir(bootstrap,{recursive:true});for(const file of files){const path=resolve('bootstrap/compiler',file),name=file.replace(/\\.eli$/,'.mjs'),emission=previous.compiler.compile_string_with_source_map(await readFile(path,'utf8'),path,name,relative(bootstrap,path));await writeFile(resolve(bootstrap,name),emission.javascript+'//# sourceMappingURL='+name+'.map\\n');await writeFile(resolve(bootstrap,name+'.map'),emission.sourceMap);}const current=await buildBackends({outputRoot:output,frontend:previous.compiler});current.compiler=await import(pathToFileURL(resolve(bootstrap,'compiler.mjs')).href);all.push(current);previous=current;}const filename=resolve('tests/fixtures/wasm-managed-object-properties.eli'),seedFile=resolve(directory,'object-properties-seed.mjs'),seed=spawnSync(resolve('bin/eliscript-seed'),['--output',seedFile,filename],{encoding:'utf8',timeout:30000});assert.equal(seed.status,0,seed.stderr);const javascript=await readFile(seedFile,'utf8'),bytes=[];for(const current of all){const p=current.compiler.compile_ir_string(family,filename),rt=current.compiler.compile_ir_string(await readFile('bootstrap/runtime/memory.eli','utf8'),'runtime.eli');assert.equal(current.compiler.emit_ir_string(p),javascript);bytes.push(Uint8Array.from(current.managed.emit_managed_wasm(p,rt)));}assert.deepEqual(bytes[0],bytes[1]);assert.deepEqual(bytes[1],bytes[2]);generationEvidence={all,bytes:bytes[2],javascript,filename};return generationEvidence;}\ntest('public Seed and three full compiler generations produce identical object property JS and WASM bytes',async()=>{const{bytes,javascript}=await generations(),js=await import('data:text/javascript;base64,'+Buffer.from(javascript).toString('base64')),a=instantiateManagedRuntime(bytes);a.auto(1);const out=a.invoke('exercise');assert.deepEqual(read(a,out),js.exercise());finish(a,[out]);},30000);\ntest('browser compiler emits identical property-operation bytes and runs the shared fixture without host imports',async()=>{const evidence=await generations(),entry=resolve(directory,'properties-browser-entry.mjs');await writeFile(entry,`export {compile_ir_string,emit_ir_string} from ${JSON.stringify(resolve(directory,'g3/bootstrap/compiler.mjs'))};export {emit_managed_wasm} from ${JSON.stringify(resolve(directory,'g3/backends/managed.mjs'))};export {instantiateManagedRuntime} from ${JSON.stringify(resolve('tools/backends/managed-runtime.mjs'))};`);const build=await Bun.build({entrypoints:[entry],target:'browser',format:'esm'});assert(build.success);const require=createRequire(import.meta.url),playwright=require(require.resolve('playwright-core',{paths:[process.cwd(),...(process.env.NODE_PATH??'').split(delimiter).filter(Boolean)]})),name=process.env.ELISCRIPT_TEST_BROWSER??'chromium';assert(['chromium','firefox','webkit'].includes(name));const browser=await playwright[name].launch();try{const page=await browser.newPage();const bytes=await page.evaluate(async({bundle,source,runtime,seed,filename})=>{const url=URL.createObjectURL(new Blob([bundle],{type:'text/javascript'})),jsUrl=URL.createObjectURL(new Blob([seed],{type:'text/javascript'}));try{const c=await import(url),js=await import(jsUrl),p=c.compile_ir_string(source,filename),rt=c.compile_ir_string(runtime,'runtime.eli'),bytes=Uint8Array.from(c.emit_managed_wasm(p,rt)),check=(ok,label)=>{if(!ok)throw Error(label)};check(c.emit_ir_string(p)===seed,'public Seed JS');check(WebAssembly.Module.imports(new WebAssembly.Module(bytes)).length===0,'imports');const a=c.instantiateManagedRuntime(bytes);a.auto(1);const read=x=>{if(x?.kind===4)return a.readNumber(x);if(x?.kind===5)return a.readString(x);if(x?.kind===14){const out=[];for(let i=0;i<a.length(x);i++){const item=a.get(x,i);out.push(read(item));a.release(item)}return out}return x};const out=a.invoke('exercise');check(JSON.stringify(read(out))===JSON.stringify(js.exercise()),'property-operation behavior');check(a.invoke('identities')===true,'firstclass');a.release(out);a.closeModule();a.collect();check(a.live()===0&&a.stats().frameDepth===0,'roots');return[...bytes]}finally{URL.revokeObjectURL(url);URL.revokeObjectURL(jsUrl)}},{bundle:await build.outputs[0].text(),source:family,runtime:await readFile('bootstrap/runtime/memory.eli','utf8'),seed:evidence.javascript,filename:evidence.filename});assert.deepEqual(Uint8Array.from(bytes),evidence.bytes);}finally{await browser.close();}},30000);\n\ntest('Object.hasOwn accepts a real well-known Symbol key instead of the former compile refusal',async()=>{const{a}=await compiled('(defun run (x) (Object/hasOwn x (js* \"Symbol.iterator\"))) (export run)'),object=a.sourceObject({});assert.equal(a.invoke('run',[object]),false);finish(a,[object]);});\n"))
