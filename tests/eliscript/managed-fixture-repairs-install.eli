(module tests.managed-fixture-repairs-install
  (import "bun:test" :as framework)
  (import "node:child_process" :default processes)
  (import "node:child_process" :as process-exports)
  (import "node:module" syncBuiltinESMExports)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "../../tools/testing/persistent-literal-fixture.mjs" projectPersistentLiteralSuite)
  (import "../../tools/backends/build.mjs" :as actual-build)
  (import "../../tools/testing/managed-fixture-repairs.mjs" managedFixtureRepairPlans malformedEmptyBindingsTitle malformedVariadicCallsTitle
    nativePrototypeFixtureSource persistentBoundaryFixtureSource managedReferenceChildArguments managedFixtureTestMethod managedFixtureRealmPressureTitle managedFixtureFunctionalArguments
    nativePromiseTitle nativePrototypeNodeTitle assertNativePrototypePromise assertNativePrototypeNode assertMalformedEmptyBindings assertMalformedVariadicCalls
    assertMalformedTypeof assertMalformedIntrinsic assertNamespaceTypeAndPressure assertNamespaceCopyTrap assertMalformedTextMethods assertTextConstructorSupport assertRegexpMalformed assertRegexpExactSupport)
  (import "../../tools/testing/managed-array-repairs.mjs" arrayCallbackCapacityTitle arraySpliceSupportTitle runNormalArrayCallbackCapacity runArraySpliceSupport)
  (import "../../tools/testing/managed-regexp-repairs.mjs" regexpBacktrackingTitle runRegexpBacktrackingSemantics regexpIndicesTitle runRegexpIndicesSemantics regexpPropertySourceTitle runRegexpPropertySourceReads)
  (import "./performance-acceptance.mjs" currentPerformanceTest)
  (defconst build (Object/assign (js-object) actual-build))
  (defconst original (Object/assign (js-object) framework))
  (defconst root (get build :root))
  (defconst selected (js-call managedFixtureRepairPlans :filter (lambda (plan)
    (js-call (get globalThis.process :argv) :some (lambda (argument)
      (or (= (resolve root argument) (resolve root (get plan :suite)))
        (and (= (get plan :kind) "persistent-boundary")
          (= (value-type (get (get globalThis.process :env) :ELISCRIPT_TEST_FIXTURE_DIRECTORY)) "string")
          (= (resolve root argument) (resolve (get (get globalThis.process :env) :ELISCRIPT_TEST_FIXTURE_DIRECTORY)
            "initializer-source/tests/wasm-managed-persistent-literals.test.mjs"))
          (= (readFileSync (resolve root argument) "utf8")
            (projectPersistentLiteralSuite root (readFileSync (resolve root (get plan :suite)) "utf8"))))))))))
  (unless (= (js-length selected) 1)
    (throw (new globalThis.TypeError "managed fixture repairs own exactly one authenticated original suite")))
  (defconst plan (aref selected 0))
  (defconst kind (get plan :kind))
  (defconst compiler-case (not (= kind "file-reference")))
  (defconst pressure-title (cond ((= kind "array-callbacks") arrayCallbackCapacityTitle)
    ((= kind "regexp") regexpBacktrackingTitle) ((= kind "regexp-indices") regexpIndicesTitle)
    (t (managedFixtureRealmPressureTitle plan (get globalThis.process :env)))))
  (unless (= (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root (get plan :suite)))) :digest "hex") (get plan :sha256))
    (throw (new globalThis.TypeError "the complete original managed fixture suite source changed")))
  (defvar backend undefined)
  (defvar runtime undefined)
  (defvar native-program undefined)
  (defconst registrations (new globalThis.Map))
  (defvar capacity-registrations 0)
  (defvar normal-registered false)
  (defun register-normal (target receiver)
    (unless normal-registered
      (setq normal-registered t)
      (cond
        ((= kind "array-callbacks")
          (Reflect/apply target receiver (js-array
            "normal functional callback budget executes all 128 original inputs with exact arguments identity caller frames and cleanup"
            (lambda () (runNormalArrayCallbackCapacity backend runtime)) 120000)))
        ((= kind "regexp")
          (Reflect/apply target receiver (js-array
            "normal regexp matching semantics retain actual trap first error negative zero caller roots and complete cleanup"
            (async () (await (runRegexpBacktrackingSemantics backend runtime))) 120000)))
        ((= kind "regexp-indices")
          (Reflect/apply target receiver (js-array
            "normal regexp indices preserve conversion failure recovery and fresh WASM native caller cleanup"
            (async () (await (runRegexpIndicesSemantics backend runtime))) 120000))))))
  (defconst replacements (Object/create nil))
  (cond
    ((= kind "native-prototype")
      (put replacements nativePromiseTitle (async () (await (assertNativePrototypePromise backend runtime native-program))))
      (put replacements nativePrototypeNodeTitle (async () (await (assertNativePrototypeNode backend native-program)))))
    ((= kind "empty-bindings") (put replacements malformedEmptyBindingsTitle (lambda () (assertMalformedEmptyBindings backend runtime))))
    ((= kind "variadic") (put replacements malformedVariadicCallsTitle (lambda () (assertMalformedVariadicCalls backend runtime))))
    ((= kind "typeof")
      (put replacements "unrepresented globals unsupported expressions and malformed typeof IR remain exact source-bound refusals even in dead code"
        (lambda () (assertMalformedTypeof backend runtime)))
      (put replacements "null predicate arity and malformed operands are diagnosed before lowering children with immutable source locations"
        (lambda () (assertMalformedIntrinsic backend runtime (js-array "nil?" "undefined?" "null" "nullish?") "null-shape.eli"))))
    ((= kind "type-paths")
      (put replacements "malformed value-type operands retain exact source-bound diagnostics and canonical IR"
        (lambda () (assertMalformedIntrinsic backend runtime (js-array "value-type") "value-type-shape.eli")))
      (put replacements "value-type reads live own namespace descriptors and preserves callers roots on allocation failure"
        (async () (await (assertNamespaceTypeAndPressure backend runtime)))))
    ((= kind "array-splice") (put replacements arraySpliceSupportTitle (async () (await (runArraySpliceSupport backend runtime)))))
    ((= kind "namespace-copy") (put replacements "an actual namespace copy trap releases its temporary object and every manually protected value"
      (async () (await (assertNamespaceCopyTrap backend runtime)))))
    ((= kind "strings") (put replacements "text literal emission refuses malformed method IR before lowering absent children and preserves the original source schema"
      (async () (await (assertMalformedTextMethods backend runtime)))))
    ((= kind "text-constructors") (put replacements "shadowed constructors and malformed or dynamic static-method IR never silently invoke globals"
      (async () (await (assertTextConstructorSupport backend runtime)))))
    ((= kind "regexp") (put replacements "invalid raw literal grammar and malformed IR are rejected with the original source identity"
      (async () (await (assertRegexpMalformed backend runtime)))))
    ((= kind "regexp-exact") (put replacements "exact repetition rejects malformed unsupported and over-capacity syntax with stable source diagnostics"
      (async () (await (assertRegexpExactSupport backend runtime)))))
    ((= kind "regexp-property") (put replacements regexpPropertySourceTitle
      (async () (await (runRegexpPropertySourceReads backend))))))
  (defconst original-spawn (get processes :spawnSync))
  (defconst original-process-exports (Object/assign (js-object) process-exports))
  (defasync buildBackends (&rest arguments)
    (let* ((actual (await (Reflect/apply (get build :buildBackends) build arguments)))
           (compiler (get actual :compiler)) (descriptors (Object/getOwnPropertyDescriptors compiler))
           (entry (get descriptors :compile_ir_string)) (compile (get entry :value))
           (facade (Object/create (Object/getPrototypeOf compiler))))
      (put entry :value (lambda (&rest inputs)
        (let ((forwarded (js-call inputs :slice)))
          (when (= kind "native-prototype")
            (put forwarded 0 (nativePrototypeFixtureSource (aref inputs 0) (aref inputs 1))))
          (when (= kind "persistent-boundary")
            (put forwarded 0 (persistentBoundaryFixtureSource (aref inputs 0) (aref inputs 1))))
          (let ((result (Reflect/apply compile compiler forwarded)))
            (when (and (= kind "native-prototype") (= (aref inputs 1) "native-prototype-callables.eli"))
              (setq native-program result))
            (when (= (aref inputs 1) "runtime.eli") (setq runtime result)) result))))
      ;; The JS and managed emitters receive the same maintained fixture source.
      (when (= kind "persistent-boundary")
        (let* ((js-entry (get descriptors :compile_string)) (js-compile (get js-entry :value)))
          (put js-entry :value (lambda (&rest inputs)
            (let ((forwarded (js-call inputs :slice)))
              (put forwarded 0 (persistentBoundaryFixtureSource (aref inputs 0) (aref inputs 1)))
              (Reflect/apply js-compile compiler forwarded))))))
      (Object/defineProperties facade descriptors)
      (setq backend (Object/assign (js-object) actual (js-object :compiler facade))) backend))
  (when compiler-case
    (js-call (get original :mock) :module (resolve root "tools/backends/build.mjs")
      (lambda () (Object/assign (js-object) build (js-object :buildBackends buildBackends)))))
  (when (or (> (js-length (Object/keys replacements)) 0) (not (undefined? pressure-title)))
    (let ((replacement (new globalThis.Proxy (get original :test) (js-object
      :get (lambda (target key receiver) (managedFixtureTestMethod target key))
      :apply (lambda (target receiver arguments)
        (let ((functional (managedFixtureFunctionalArguments plan (get globalThis.process :env) arguments)))
          (unless (eq functional arguments)
            (console/error "original 30000ms total-time acceptance DEFERRED / NOT ACCEPTED; complete original functional inputs retain no total deadline"
              (get plan :suite) (aref arguments 0))
            (setq arguments functional)))
        (register-normal target receiver)
        (let ((title (aref arguments 0)))
          (cond
            ((and (not (undefined? pressure-title)) (= title pressure-title))
              (setq capacity-registrations (1+ capacity-registrations))
              (when (> capacity-registrations 1) (throw (new globalThis.TypeError "duplicate original callback capacity case")))
              (Reflect/apply (currentPerformanceTest target) receiver arguments))
            ((Object/hasOwn replacements title)
              (when (js-call registrations :has title) (throw (new globalThis.TypeError "duplicate original managed fixture case")))
              (js-call registrations :set title 1)
              (let ((forwarded (js-call arguments :slice)))
                (put forwarded 1 (get replacements title)) (Reflect/apply target receiver forwarded)))
            (t (Reflect/apply target receiver arguments)))))))))
      (js-call (get original :mock) :module "bun:test" (lambda () (Object/assign (js-object) original (js-object :test replacement))))))
  (when (js-call (js-array "file-reference" "strings") :includes kind)
    (let ((spawn (lambda (command arguments &rest configuration)
      (Reflect/apply original-spawn processes (js-call (js-array command
        (managedReferenceChildArguments arguments (resolve root "tests/helpers/managed-reference-node.mjs"))) :concat configuration)))))
      (put processes :spawnSync spawn)
      (js-call (get original :mock) :module "node:child_process"
        (lambda () (Object/assign (js-object) original-process-exports (js-object :spawnSync spawn)))))
    (syncBuiltinESMExports))
  (js-call original :beforeAll (lambda ()
    (js-call (Object/keys replacements) :forEach (lambda (title)
      (unless (= (js-call registrations :get title) 1) (throw (new globalThis.TypeError (str "missing complete original managed fixture case: " title))))))
    (when (and (not (undefined? pressure-title)) (/= capacity-registrations 1))
      (throw (new globalThis.TypeError "missing complete original callback capacity case")))
    (when (and (not (undefined? pressure-title)) (not normal-registered))
      (throw (new globalThis.TypeError "the normal managed fixture case must register inside the original suite")))))
  (js-call original :afterAll (lambda ()
    (put processes :spawnSync original-spawn) (syncBuiltinESMExports)
    (when (js-call (js-array "file-reference" "strings") :includes kind)
      (js-call (get original :mock) :module "node:child_process" (lambda () original-process-exports)))
    (js-call (get original :mock) :module "bun:test" (lambda () original))
    (js-call (get original :mock) :module (resolve root "tools/backends/build.mjs") (lambda () build)))))
