(module tests.compiler-runtime-scan
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm mkdir symlink)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawn)
  (import "./helpers/performance-acceptance.mjs" currentPerformanceTest)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/compiler/runtime-scan-cases.mjs" verifyRuntimeScan compilerSources)
  (import "../tools/compiler/runtime-scan-benchmark.mjs" compilerRuntimeScanSourceDigest validateCompilerRuntimeScanReport)

  (defconst report-path (resolve root "benchmarks/compiler-runtime-scan-macos-arm64.json"))
  (defun build (directory)
    (new globalThis.Promise (lambda (accept reject)
      (let* ((child (spawn (resolve root "bin/eliscript-bootstrap") (js-array)
               (js-object :cwd root :env (Object/assign (js-object) (get globalThis.process :env)
                 (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR directory)) :stdio (js-array "ignore" "pipe" "pipe"))))
             (stdout "") (stderr ""))
        (js-call (get child :stdout) :on "data" (lambda (chunk) (setq stdout (+ stdout chunk))))
        (js-call (get child :stderr) :on "data" (lambda (chunk) (setq stderr (+ stderr chunk))))
        (js-call child :once "error" reject)
        (js-call child :once "close" (lambda (status)
          (if (= status 0) (funcall accept undefined)
            (funcall reject (new globalThis.Error
              (or (js-call stderr :trim) (js-call stdout :trim) (str "bootstrap exited with " status)))))))))))
  (test "optimized compiler runtime scan matches its readable reference"
    (js-object :timeout 30000)
    (async ()
      (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-runtime-scan-")))))
        (try
          (await (build directory))
          (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
          (await (symlink root (resolve directory "node_modules/eliscript")))
          (await (verifyRuntimeScan directory root))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
  (test "committed compiler runtime scan report preserves historical measurements and decisions"
    (async ()
      (let ((report (validateCompilerRuntimeScanReport (JSON/parse (await (readFile report-path "utf8"))))))
        (js-call assert :strictEqual (js-length (get (get report :corpus) :files)) (js-length compilerSources))
        (js-call assert :ok (> (get (get report :corpus) :sourceBytes) 200000))
        (js-call assert :ok (> (get (get report :corpus) :irNodes) 10000))
        (js-call assert :ok (>= (get (get report :measurements) :speedup) (get (get report :decision) :minimumSpeedup))))))
  (funcall (currentPerformanceTest test) "committed compiler runtime scan report matches measured sources"
    (async ()
      (let ((report (JSON/parse (await (readFile report-path "utf8")))))
        (js-call assert :deepStrictEqual (get report :sourceDigest) (await (compilerRuntimeScanSourceDigest)))))))
