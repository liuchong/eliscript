(module tests.managed-exceptions-browser-page
  (import "eliscript-test/compiler" compile_ir_string emit_ir_string)
  (import "eliscript-test/managed" emit_managed_wasm)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "/oracle.mjs" :as reference)
  (defun check (value label) (unless value (throw (new globalThis.Error label))))
  (defun read (a value)
    (cond ((and value (= (get value :kind) 4)) (js-call a :readNumber value))
          ((and value (= (get value :kind) 5)) (js-call a :readString value))
          ((and value (= (get value :kind) 14))
            (Array/from (js-object :length (js-call a :length value))
              (lambda (ignored index)
                (let ((item (js-call a :get value index)))
                  (try (read a item) (finally (js-call a :release item)))))))
          (t value)))
  (defun executeExceptionScenario (input)
    (let* ((scenario (get input :scenario)) (id (get scenario :id))
           (source (str "(defconst marker 1)\n" (get scenario :source) "\n(export run)"))
           (filename (str "bdd-" id ".eli"))
           (runtime-ir (compile_ir_string (get input :runtime) "runtime.eli"))
           (program (compile_ir_string source filename)) (saved (JSON/stringify program))
           (bytes (globalThis.Uint8Array.from (emit_managed_wasm program runtime-ir))))
      (check (= (JSON/stringify program) saved) (str id ": IR mutation"))
      (check (= (js-length (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes))) 0) (str id ": imports"))
      (check (= (emit_ir_string program) (get input :javascript)) (str id ": JavaScript compiler bytes"))
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (try
          (let ((out (js-call a :invoke "run")))
            (try
              (check (= (JSON/stringify (js-call reference :run)) (JSON/stringify (get scenario :expected))) (str id ": JS oracle"))
              (check (= (JSON/stringify (read a out)) (JSON/stringify (get scenario :expected))) (str id ": WASM behavior"))
              (finally (js-call a :release out))))
          (finally
            (js-call a :closeModule) (js-call a :collect)
            (check (and (= (js-call a :live) 0) (= (get (js-call a :stats) :frameDepth) 0)) (str id ": roots")))))
      (js-object :id id :bytes (Array/from bytes))))
  (put globalThis.globalThis :__eliscriptExceptionScenario executeExceptionScenario))
