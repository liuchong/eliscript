(module tests.persistent-zipper-path
  (import "node:test" before after test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir mkdtemp readFile writeFile symlink rm)
  (import "node:path" resolve dirname)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" loadManagedHostModules)
  (import "../runtime/core/vector.mjs" persistentVector)
  (import "../runtime/core/list.mjs" persistentList)
  (import "../runtime/core/map.mjs" persistentHashMap)
  (import "../runtime/core/set.mjs" persistentHashSet)
  (import "../runtime/core/queue.mjs" persistentQueue)
  (import "../runtime/core/sorted.mjs" persistentSortedMap persistentSortedSet)
  (import "../runtime/core/sequence.mjs" first last sequenceNth find takeLast dropLast)
  (import "../runtime/core/transducer.mjs" into)
  (import "../runtime/core/order.mjs" compareValues sort sortBy)
  (import "../runtime/core/data.mjs" groupBy countBy frequencies)
  (import "../runtime/core/value.mjs" equalValues)
  (import "../runtime/core/metadata.mjs" IMeta meta withMeta)
  (import "../runtime/core/collection.mjs" :as Collection)

  (defvar directory undefined)
  (defvar zipper undefined)
  (before (async ()
    (let ((parent (resolve root "_worktree/evidence/zipper-path-contract")))
      (await (mkdir parent (js-object :recursive t)))
      (setq directory (await (mkdtemp (resolve parent "run-")))))
    (let* ((backend (await (buildBackends (js-object :outputRoot (resolve directory "compiler")))))
           (source (await (readFile (resolve root "stdlib/core/zipper.eli") "utf8")))
           (destination (resolve directory "program/stdlib/core/zipper.mjs")))
      (await (mkdir (dirname destination) (js-object :recursive t)))
      (await (symlink (resolve root "runtime") (resolve directory "program/runtime") "dir"))
      (await (writeFile destination (js-call (get backend :compiler) :compile_string source "stdlib/core/zipper.eli")))
      (let* ((url (get (pathToFileURL destination) :href))
             (descriptor (js-object :hostModules (js-array (js-object
               :id "zipper-path-contract" :specifier url :referrer "zipper-path-contract.mjs" :namespace t
               :allowedExports (js-array "vector_zipper" "zipper" "children" "end_QMARK_" "branch_QMARK_" "down" "right" "node" "path" "root" "replace" "remove" "up")))))
             (modules (await (loadManagedHostModules descriptor))))
        (setq zipper (js-call modules :get "zipper-path-contract"))))))
  (after (async ()
    (setq zipper undefined)
    (when directory (await (rm directory (js-object :recursive t :force t))))))

  (test "zipper validated navigation preserves public errors branch order nullish leaves and original callback failures"
    (lambda ()
      (js-call (js-array "node" "end_QMARK_" "branch_QMARK_" "down" "children") :forEach (lambda (operation)
        (js-call (js-array nil undefined false (persistentVector 1 2)) :forEach (lambda (invalid)
          (js-call assert :throws (lambda () (Reflect/apply (get zipper operation) undefined (js-array invalid)))
            globalThis.TypeError)))))
      (let* ((calls (js-array))
             (location (js-call zipper :zipper
               (lambda (value) (js-call calls :push "branch") t)
               (lambda (value) (js-call calls :push "children") (persistentVector undefined))
               (lambda (value children) children) nil))
             (child (js-call zipper :down location)))
        (js-call assert :deepStrictEqual calls (js-array "branch" "children"))
        (js-call assert :strictEqual (js-call zipper :node child) undefined)
        (let ((end (withMeta (persistentVector nil "eliscript.zipper/end") (meta location))))
          (js-call assert :strictEqual (js-call zipper :end_QMARK_ end) t)
          (js-call assert :strictEqual (js-call zipper :branch_QMARK_ end) false)
          (js-call assert :strictEqual (js-call zipper :down end) nil))
        (js-call assert :deepStrictEqual calls (js-array "branch" "children")))
      (js-call assert :strictEqual (js-call zipper :down (js-call zipper :vector_zipper undefined)) nil)
      (js-call (js-array false undefined (js-object :original t)) :forEach (lambda (failure)
        (js-call (js-array "branch" "children") :forEach (lambda (phase)
          (let ((caught false) (actual nil)
                (location (js-call zipper :zipper
                  (lambda (value) (if (= phase "branch") (throw failure) t))
                  (lambda (value) (throw failure))
                  (lambda (value children) children) nil)))
            (try (js-call zipper :down location) (catch error (setq caught t actual error)))
            (js-call assert :strictEqual caught t)
            (js-call assert :strictEqual actual failure))))))))

  (test "zipper down revalidates after branch child-reader and reduction callbacks before publishing a child"
    (lambda ()
      (let* ((prototype (Object/getPrototypeOf (persistentVector)))
             (slot (get (get (get IMeta :operations) :meta) :slot))
             (descriptor (Object/getOwnPropertyDescriptor prototype slot)))
        (js-call (js-array "branch" "children" "reduce") :forEach (lambda (phase)
          (let* ((calls (js-array))
                 (invalidate (lambda ()
                   (Object/defineProperty prototype slot
                     (Object/assign (js-object) descriptor (js-object :value (lambda () (persistentHashMap)))))))
                 (location (js-call zipper :zipper
                   (lambda (value)
                     (js-call calls :push "branch")
                     (when (= phase "branch") (funcall invalidate)) t)
                   (lambda (value)
                     (js-call calls :push "children")
                     (if (= phase "reduce")
                       (let ((values (js-object)))
                         (Object/defineProperty values
                           (get (get (get Collection/IReduce :operations) :reduce) :slot)
                           (js-object :value (lambda (reducer initial)
                             (js-call calls :push "reduce")
                             (let ((result (funcall reducer initial 7)))
                               (funcall invalidate) result)))) values)
                       (progn (funcall invalidate) (persistentVector 7))))
                   (lambda (value children) children) nil)))
            (try
              (js-call assert :throws (lambda () (js-call zipper :down location))
                (new globalThis.RegExp "node requires a zipper location"))
              (js-call assert :deepStrictEqual calls
                (cond ((= phase "branch") (js-array "branch"))
                  ((= phase "children") (js-array "branch" "children"))
                  (t (js-array "branch" "children" "reduce"))))
              (finally (Object/defineProperty prototype slot descriptor)))
            (js-call assert :strictEqual (js-call zipper :node location) nil)))))))

  (test "zipper public ancestor paths retain order identity and unchanged roots across siblings and edits"
    (lambda ()
      (let* ((nested (persistentVector nil false undefined)) (source (persistentVector nested 7))
             (base (js-call zipper :vector_zipper source)) (parent (js-call zipper :down base))
             (first (js-call zipper :down parent)) (second (js-call zipper :right first))
             (third (js-call zipper :right second)) (ancestors (js-call zipper :path first)))
        (js-call assert :strictEqual (js-call zipper :path base) nil)
        (js-call assert :strictEqual (Collection/isVector ancestors) t)
        (js-call assert :strictEqual (Collection/count ancestors) 2)
        (js-call assert :strictEqual (Collection/nth ancestors 0) source)
        (js-call assert :strictEqual (Collection/nth ancestors 1) nested)
        (js-call assert :strictEqual (js-call zipper :path first) ancestors)
        (js-call assert :strictEqual (js-call zipper :path second) ancestors)
        (js-call assert :strictEqual (js-call zipper :path third) ancestors)
        (js-call assert :strictEqual (js-call zipper :node first) nil)
        (js-call assert :strictEqual (js-call zipper :node second) false)
        (js-call assert :strictEqual (js-call zipper :node third) undefined)
        (js-call assert :strictEqual (js-call zipper :root third) source)
        (let* ((edited (js-call zipper :replace second 29)) (rebuilt (js-call zipper :root edited)))
          (js-call assert :strictEqual (js-call zipper :path edited) ancestors)
          (js-call assert :strictEqual (Collection/nth (Collection/nth rebuilt 0) 1) 29)
          (js-call assert :strictEqual (Collection/nth nested 1) false))
        (let ((removed (js-call zipper :remove first)))
          (js-call assert :strictEqual (Collection/count (js-call zipper :node removed)) 2)
          (js-call assert :strictEqual (Collection/nth (js-call zipper :node removed) 0) false)))))

  (test "zipper retains original Vector and reducible List paths including mixed descent and malformed diagnostics"
    (lambda ()
      (let* ((ancestor (persistentVector (persistentVector 7)))
             (configuration (meta (js-call zipper :vector_zipper ancestor)))
             (parents (persistentVector ancestor)) (child (Collection/nth ancestor 0)))
        (js-call (js-array
          (persistentVector (persistentVector) (persistentList) nil parents false)
          (persistentList (persistentVector) (persistentList) nil parents false)) :forEach
          (lambda (old-path)
            (let* ((location (withMeta (persistentVector child old-path) configuration))
                   (descended (js-call zipper :down location)) (mixed-path (js-call zipper :path descended)))
              (js-call assert :strictEqual (js-call zipper :path location) parents)
              (js-call assert :strictEqual (js-call zipper :node (js-call zipper :up location)) ancestor)
              (js-call assert :strictEqual (Collection/count mixed-path) 2)
              (js-call assert :strictEqual (Collection/nth mixed-path 0) ancestor)
              (js-call assert :strictEqual (Collection/nth mixed-path 1) child)
              (js-call assert :strictEqual (js-call zipper :path descended) mixed-path)
              (js-call assert :strictEqual (js-call zipper :root descended) ancestor))))
        (js-call (js-array undefined nil false 0) :forEach (lambda (node)
          (let* ((old-path (persistentList (persistentVector) (persistentList) nil parents false))
                 (location (withMeta (persistentVector node old-path) configuration)))
            (js-call assert :strictEqual (js-call zipper :node location) node)
            (js-call assert :strictEqual (js-call zipper :node (js-call zipper :up location)) ancestor))))
        (js-call assert :throws (lambda ()
          (js-call zipper :up (withMeta (persistentVector undefined (persistentVector)) configuration)))
          (new globalThis.RegExp "invalid zipper internal slot")))))

  (test "zipper internal paths stay immutable and copied compact paths preserve public ancestry and edits"
    (lambda ()
      (let* ((nested (persistentVector nil false undefined)) (source (persistentVector nested 7))
             (parent (js-call zipper :down (js-call zipper :vector_zipper source)))
             (first (js-call zipper :down parent))
             (internal (Collection/nth first 1))
             (ancestors (js-call zipper :path first))
             (configuration (meta first)))
        (js-call assert :strictEqual (Collection/isVector first) t)
        (js-call assert :strictEqual (Collection/isVector ancestors) t)
        (js-call assert :strictEqual (Object/isFrozen internal) t)
        (js-call assert :strictEqual (Reflect/set internal "4" t) false)
        (js-call assert :strictEqual (Reflect/deleteProperty internal "2") false)
        (js-call assert :strictEqual (js-call zipper :root first) source)
        ;; A copy belongs to no private registry. It models a value handed
        ;; through another compiled instance while retaining the same actual
        ;; immutable parent holder and public metadata.
        (let* ((copied (Object/freeze (Array/from internal)))
               (as-vector (Reflect/apply persistentVector undefined (Array/from internal))))
          (js-call (js-array copied as-vector) :forEach (lambda (path)
            (let* ((location (withMeta (persistentVector nil path) configuration))
                   (second (js-call zipper :right location))
                   (third (js-call zipper :right second))
                   (changed (js-call zipper :replace second 41))
                   (rebuilt (js-call zipper :root changed))
                   (removed (js-call zipper :remove location)))
              (js-call assert :strictEqual (js-call zipper :path location) ancestors)
              (js-call assert :strictEqual (js-call zipper :path second) ancestors)
              (js-call assert :strictEqual (js-call zipper :path changed) ancestors)
              (js-call assert :strictEqual (js-call zipper :node second) false)
              (js-call assert :strictEqual (js-call zipper :node third) undefined)
              (js-call assert :strictEqual (js-call zipper :root third) source)
              (js-call assert :strictEqual (Collection/nth (Collection/nth rebuilt 0) 1) 41)
              (js-call assert :strictEqual (Collection/nth nested 1) false)
              (js-call assert :strictEqual (Collection/isVector (js-call zipper :node removed)) t)
              (js-call assert :strictEqual (Collection/nth (js-call zipper :node removed) 0) false))))))))

  (test "zipper depth 12000 navigation and edited ascent retain exact public ancestors without repeated prefix storage"
    (lambda ()
      (let ((source undefined) (index 0))
        (while (< index 12000) (setq source (persistentVector source) index (1+ index)))
        (let ((location (js-call zipper :vector_zipper source)))
          (setq index 0)
          (while (< index 12000)
            (setq location (js-call zipper :down location) index (1+ index)))
          (js-call assert :strictEqual (js-call zipper :node location) undefined)
          (js-call assert :strictEqual (js-call zipper :root location) source)
          (let ((ancestors (js-call zipper :path location)) (cursor source))
            (js-call assert :strictEqual (Collection/count ancestors) 12000)
            (js-call assert :strictEqual (js-call zipper :path location) ancestors)
            (setq index 0)
            (while (< index 12000)
              (js-call assert :strictEqual (Collection/nth ancestors index) cursor)
              (setq cursor (Collection/nth cursor 0) index (1+ index))))
          (let ((changed (js-call zipper :root (js-call zipper :replace location false))))
            (setq index 0)
            (while (< index 12000)
              (setq changed (Collection/nth changed 0) index (1+ index)))
            (js-call assert :strictEqual changed false)
            (js-call assert :strictEqual (js-call zipper :node location) undefined))))))

  (test "zero tracked mjs files and clojurescript-style collection sequence order and data fast-paths"
    (lambda ()
      (let ((git (spawnSync "git" (js-array "ls-files" "--" "*.mjs" "tools/capsules/*")
                   (js-object :cwd root :encoding "utf8")))
            (in-place (spawnSync "git" (js-array "ls-files" "--" "platform/browser.eli" "runtime/core/vector.eli" "browser/host.eli")
                        (js-object :cwd root :encoding "utf8"))))
        (js-call assert :strictEqual (get git :status) 0)
        (js-call assert :strictEqual (js-call (get git :stdout) :trim) "")
        (js-call assert :strictEqual (get in-place :status) 0)
        (js-call assert :deepStrictEqual
          (js-call (js-call (get in-place :stdout) :trim) :split "\n")
          (js-array "browser/host.eli" "platform/browser.eli" "runtime/core/vector.eli")))
      (let ((vec (persistentVector 10 20 30 40))
            (lst (persistentList 10 20 30 40))
            (arr (js-array 10 20 30 40)))
        (js-call assert :strictEqual (first vec) 10)
        (js-call assert :strictEqual (first lst) 10)
        (js-call assert :strictEqual (first arr) 10)
        (js-call assert :strictEqual (last vec) 40)
        (js-call assert :strictEqual (last lst) 40)
        (js-call assert :strictEqual (last arr) 40)
        (js-call assert :strictEqual (sequenceNth 2 lst) 30)
        (js-call assert :strictEqual (find (lambda (x) (> x 25)) vec) 30)
        (js-call assert :strictEqual (equalValues (takeLast 2 vec) (persistentVector 30 40)) t)
        (js-call assert :strictEqual (equalValues (dropLast 2 vec) (persistentVector 10 20)) t)
        (js-call assert :strictEqual (compareValues vec vec) 0)
        (js-call assert :strictEqual (equalValues (sort (persistentVector 4 1 3 2)) (persistentVector 1 2 3 4)) t)
        (js-call assert :strictEqual (equalValues (sortBy (lambda (x) (- 0 x)) (persistentVector 1 4 2 3)) (persistentVector 4 3 2 1)) t)
        (let ((grouped (groupBy (lambda (x) (% x 2)) (persistentVector 1 2 3 4))))
          (js-call assert :strictEqual (equalValues (Collection/get grouped 1) (persistentVector 1 3)) t)
          (js-call assert :strictEqual (equalValues (Collection/get grouped 0) (persistentVector 2 4)) t))
        (let ((counted (countBy (lambda (x) (% x 2)) (persistentVector 1 2 3 4 5)))
              (freqs (frequencies (persistentVector "a" "b" "a"))))
          (js-call assert :strictEqual (Collection/get counted 1) 3)
          (js-call assert :strictEqual (Collection/get counted 0) 2)
          (js-call assert :strictEqual (Collection/get freqs "a") 2)
          (js-call assert :strictEqual (Collection/get freqs "b") 1))
        (let ((mapped (into (persistentHashMap) (js-array (js-array "k1" 1) (js-array "k2" 2)))))
          (js-call assert :strictEqual (Collection/get mapped "k1") 1)
          (js-call assert :strictEqual (Collection/get mapped "k2") 2))
        (let ((shared-vec (persistentVector 1 2 3))
              (shared-map (persistentHashMap (js-array "a" 1) (js-array "b" 2)))
              (shared-set (persistentHashSet 1 2 3))
              (shared-list (persistentList 1 2 3))
              (shared-queue (Collection/conj (persistentQueue) 1 2))
              (shared-smap (persistentSortedMap "a" 1 "b" 2))
              (shared-sset (persistentSortedSet 1 2 3)))
          (js-call assert :strictEqual (equalValues shared-vec shared-vec) t)
          (js-call assert :strictEqual (equalValues shared-map shared-map) t)
          (js-call assert :strictEqual (equalValues shared-set shared-set) t)
          (js-call assert :strictEqual (equalValues shared-list shared-list) t)
          (js-call assert :strictEqual (equalValues shared-queue shared-queue) t)
          (js-call assert :strictEqual (equalValues shared-smap shared-smap) t)
          (js-call assert :strictEqual (equalValues shared-sset shared-sset) t))))))
