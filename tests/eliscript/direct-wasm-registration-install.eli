(module tests.direct-wasm-registration-install
  (import "bun:test" :as framework)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "../../tools/backends/build.mjs" root)
  (import "./direct-wasm-registration.mjs" createDirectWasmRegistration registerDirectWasmCompletion)
  (import "./direct-wasm-affected.mjs" runDirectReflectionCase runDirectValueJsonCase closeDirectAffected)
  (defconst original (Object/assign (js-object) framework))
  (defconst archive (resolve root "tests/direct-wasm-backend-test-ground.mjs"))
  (defconst source (readFileSync archive))
  (js-call assert :strictEqual (js-call (js-call (createHash "sha256") :update source) :digest "hex")
    "b3e2af96d7da3d92ad4613fcb341656fd7625fb7fd1ca8bae421f171e8c73ea9"
    "the full original direct WASM suite must retain its exact bytes")
  (defconst registration (createDirectWasmRegistration original
    (js-object
      "browser function properties preserve ordinary absence builtin refusal identities and calls" runDirectReflectionCase
      "browser complete Value and JSON graph executes original persistent and JSON semantics" runDirectValueJsonCase)))
  (defvar restored false)
  (defun restoreDirectWasmRegistration ()
    (unless restored
      ;; Explicitly restore the actual module; mock.restore does not do this.
      (js-call (get original :mock) :module "bun:test" (lambda () original))
      (setq restored t)))
  (defun completeDirectWasmRegistration ()
    (try (js-call registration :complete)
      (finally (restoreDirectWasmRegistration))))
  (registerDirectWasmCompletion original registration restoreDirectWasmRegistration)
  (js-call original :afterAll (async ()
    (restoreDirectWasmRegistration)
    (await (closeDirectAffected))))
  (js-call (get original :mock) :module "bun:test" (lambda () (get registration :exports)))
  (export completeDirectWasmRegistration restoreDirectWasmRegistration))
