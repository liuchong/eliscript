(module tests.managed-array-construction-page
  (import "eliscript-test/compiler" compile_ir_string emit_ir_string)
  (import "eliscript-test/managed" emit_managed_wasm)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "/oracle.mjs" :as reference)
  (defun check (ok label) (unless ok (throw (new globalThis.Error label))))
  (defun read (a value)
    (cond ((and value (= (get value :kind) 4)) (js-call a :readNumber value))
          ((and value (= (get value :kind) 5)) (js-call a :readString value))
          ((and value (= (get value :kind) 14))
            (let ((out (js-array)) (index 0))
              (while (< index (js-call a :length value))
                (let ((item (js-call a :get value index)))
                  (js-call out :push (read a item)) (js-call a :release item))
                (setq index (1+ index))) out)) (t value)))
  (defun evaluateConstruction (input)
    (let* ((program (compile_ir_string (get input :source) (get input :filename)))
           (runtime (compile_ir_string (get input :runtime) "runtime.eli"))
           (bytes (globalThis.Uint8Array.from (emit_managed_wasm program runtime))))
      (check (= (emit_ir_string program) (get input :seed)) "public Seed JS")
      (check (= (js-length (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes))) 0) "imports")
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let ((out (js-call a :invoke "exercise")))
          (check (= (JSON/stringify (read a out)) (JSON/stringify (js-call reference :exercise))) "construction behavior")
          (check (eq (js-call a :invoke "identities") t) "firstclass")
          (js-call a :release out))
        (js-call a :closeModule) (js-call a :collect)
        (check (and (= (js-call a :live) 0) (= (get (js-call a :stats) :frameDepth) 0)) "roots"))
      (Array/from bytes)))
  (put globalThis.globalThis :__eliscriptConstructionCase evaluateConstruction))
