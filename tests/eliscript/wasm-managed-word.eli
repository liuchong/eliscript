(module managed.word.tests
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile)
  (import "node:child_process" spawnSync)
  (import "node:path" resolve)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/managed-numeric-selfhosted.mjs" makeFixture closeFixture check)
  (defvar fixture nil)
  (beforeAll (async () (setq fixture (await (makeFixture "word")))) 120000)
  (afterAll (async () (when fixture (await (closeFixture fixture)))))
  (defconst numbers (js-array 0 -0 1 -1 0.1 -0.1 3.5 -3.5 globalThis.NaN globalThis.Infinity
    (- globalThis.Infinity) globalThis.Number.MIN_VALUE (- globalThis.Number.MIN_VALUE)
    globalThis.Number.MAX_VALUE (- globalThis.Number.MAX_VALUE) 2147483647 2147483648
    4294967295 4294967297 -4294967297 4503599627370497 9007199254740991
    9007199254740994 (globalThis.Math.pow 2 83) (globalThis.Math.pow 2 84)))
  (defun verify (a name inputs) (check fixture a name inputs))
  (test "ordinary Number word conversions and operators preserve all IEEE boundaries under GC"
    (lambda () (let ((a (instantiateManagedRuntime (get fixture :bytes))))
      (js-call a :auto 1)
      (js-call numbers :forEach (lambda (x)
        (js-call (js-array "signed" "unsigned" "invert") :forEach (lambda (name) (verify a name (js-array x))))
        (js-call numbers :forEach (lambda (y)
          (js-call (js-array "remainder" "modulo" "mask" "union" "exclusive" "shift-left"
            "shift-right" "logical-right" "multiply" "snapshot" "remainder-snapshot") :forEach
            (lambda (name) (verify a name (js-array x y)))))))))))
  (test "remainder retains exact subnormal results and dividend zero sign without rounded quotient multiplication"
    (lambda () (let ((a (instantiateManagedRuntime (get fixture :bytes))))
      (js-call a :auto 1)
      (js-call (js-array (js-array 1 0.1) (js-array 1e16 3) (js-array globalThis.Number.MAX_VALUE 3)
        (js-array globalThis.Number.MAX_VALUE globalThis.Number.MIN_VALUE)
        (js-array (* globalThis.Number.MIN_VALUE 3) (* globalThis.Number.MIN_VALUE 2))
        (js-array 1 (* globalThis.Number.MIN_VALUE 3)) (js-array -4 2) (js-array -0 3)
        (js-array 3 -0) (js-array 1 globalThis.Infinity) (js-array globalThis.Infinity 1)) :forEach
        (lambda (pair) (verify a "remainder" pair)))
      (js-call (js-array (js-array 17 5 2) (js-array -17 5 2)
        (js-array globalThis.Number.MAX_VALUE 3 0.1) (js-array globalThis.NaN 1 2) (js-array 17 0 2)) :forEach
        (lambda (triple) (verify a "remainder-many" triple))))))
  (test "conversion handles every exponent boundary and fractional truncation before modulo 2^32"
    (lambda () (let ((a (instantiateManagedRuntime (get fixture :bytes))) (e -1074))
      (js-call a :auto 1)
      (while (<= e 1023)
        (js-call (js-array (globalThis.Math.pow 2 e) (- (globalThis.Math.pow 2 e))) :forEach (lambda (x)
          (js-call (js-array "signed" "unsigned" "invert") :forEach (lambda (name) (verify a name (js-array x))))))
        (setq e (1+ e)))
      (setq e 0)
      (while (< e 85)
        (js-call (js-array (+ (globalThis.Math.pow 2 e) 1) (+ (globalThis.Math.pow 2 e) 0.5) (- (+ (globalThis.Math.pow 2 e) 1)) (- (+ (globalThis.Math.pow 2 e) 0.5))) :forEach (lambda (x)
          (js-call (js-array "signed" "unsigned") :forEach (lambda (name) (verify a name (js-array x))))))
        (setq e (1+ e))))))
  (test "shift counts are converted and masked, signed and logical right shift remain distinct, imul wraps exactly"
    (lambda () (let ((a (instantiateManagedRuntime (get fixture :bytes))))
      (js-call a :auto 1)
      (js-call (js-array -1 -2 2147483648 4294967295 2147483647 2147483649 4294967293) :forEach (lambda (x)
        (js-call (js-array -65 -33 -32 -31 -1 0 1 20 31 32 33 63 64 65 4294967297 globalThis.NaN globalThis.Infinity) :forEach (lambda (count)
          (js-call (js-array "shift-left" "shift-right" "logical-right") :forEach (lambda (name) (verify a name (js-array x count))))))))
      (js-call (js-array (js-array 4294967295 4294967295) (js-array 4294967295 4294967293)
        (js-array 2147483649 2147483649) (js-array 2147483647 2147483647)) :forEach (lambda (pair) (verify a "multiply" pair))))))
  (test "random float64 pairs and integer words agree with independent JS arithmetic without approximation"
    (lambda () (let ((state 82220343) (v (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
      (a (instantiateManagedRuntime (get fixture :bytes))) (i 0))
      (letfn ((next () (setq state (bit-xor state (bit-shift-left state 13)))
                       (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                       (setq state (bit-xor state (bit-shift-left state 5))) (uint32 state))
              (random () (js-call v :setUint32 0 (next) t) (js-call v :setUint32 4 (next) t) (js-call v :getFloat64 0 t)))
        (js-call a :auto 1)
        (while (< i 2048)
          (let ((x (random)) (y (random)))
            (js-call (js-array "remainder" "signed" "unsigned" "mask" "exclusive" "multiply" "logical-right") :forEach (lambda (name)
              (verify a name (if (or (= name "signed") (= name "unsigned")) (js-array x) (js-array x y)))))
            (verify a "multiply" (js-array (next) (next))))
          (setq i (1+ i)))))))
  (test "ordinary word loops preserve evaluation order and automatically reclaim boxed results"
    (lambda () (let ((a (instantiateManagedRuntime (get fixture :bytes)
      (js-object :maxSlots 128 :initialBytes 8192 :maxBytes 1048576))))
      (js-call a :auto 1)
      (js-call (js-array 0 -0 globalThis.NaN globalThis.Infinity globalThis.Number.MAX_VALUE 2147483649) :forEach
        (lambda (seed) (verify a "loop-mix" (js-array 128 seed))))
      (assert (> (get (js-call a :stats) :collections) 1000)))))
  (test "exact subnormal remainder is exhaustive across small integer significands and signs"
    (lambda () (let ((a (instantiateManagedRuntime (get fixture :bytes))) (x 0))
      (js-call a :auto 1)
      (while (< x 64)
        (let ((y 1)) (while (< y 32)
          (js-call (js-array 1 -1) :forEach (lambda (sign) (verify a "remainder"
            (js-array (* sign x globalThis.Number.MIN_VALUE) (* y globalThis.Number.MIN_VALUE)))))
          (setq y (1+ y)))) (setq x (1+ x))))))
  (test "a word-operation error suppresses a later genuine trap and unwinds only its own frames"
    (async ()
      (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
        (start (js-call source :indexOf "  (defun value-truth (heap value)"))
        (end (js-call source :indexOf "  (defun " (+ start 3)))
        (compiler (get (get fixture :backend) :compiler))
        (managed (get (get fixture :backend) :managed)))
        (assert (and (>= start 0) (> end start)))
        (let* ((injected (js-call compiler :compile_ir_string
          (str (js-call source :slice 0 start) "  (defun value-truth (heap value) (load-u32 4294967295))\n" (js-call source :slice end)) "trap-runtime.eli"))
          (ir (js-call compiler :compile_ir_string "(defun crash (x y) (progn (bit-xor x y) (if x 1 2))) (export crash)" "word-error.eli"))
          (a (instantiateManagedRuntime (globalThis.Uint8Array.from (js-call managed :emit_managed_wasm ir injected))))
          (text (js-call a :sourceObject (js-object :toString false :valueOf false)))
          (n (js-call a :number -0)) (caller (js-call a :frame 1)))
          (js-call a :frameSet caller 0 n)
          (js-call assert :throws (lambda () (js-call a :invoke "crash" (js-array text n)))
            (lambda (e) (= (get (get e :eliscriptDiagnostic nil) :code nil) "ELI-RT0003")))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (js-call assert :throws (lambda () (js-call a :invoke "crash" (js-array n n))) globalThis.WebAssembly.RuntimeError)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (let ((retained (js-call a :frameGet caller 0)))
            (assert (Object/is (js-call a :readNumber retained) -0)) (js-call a :release retained))
          (js-call a :leaveFrame caller) (js-call a :release text) (js-call a :release n)
          (js-call a :collect) (js-call assert :equal (js-call a :live) 0)))))
  (test "unsupported coercion and invalid word IR are explicit, source-bound and do not mutate input IR"
    (lambda () (let* ((program (get fixture :program)) (backend (get fixture :backend))
      (compiler (get backend :compiler)) (managed (get backend :managed)) (runtime (get fixture :runtimeProgram))
      (saved (JSON/stringify program)))
      (js-call managed :emit_managed_wasm program runtime) (js-call assert :equal (JSON/stringify program) saved)
      (js-call (js-array "(string-to-number x)" "(string-to-bigint x)") :forEach (lambda (expression)
        (let* ((ir (js-call compiler :compile_ir_string (str "(defun f (x) (if false " expression " x)) (export f)") "supported-word.eli"))
          (original (JSON/stringify ir)))
          (assert (globalThis.WebAssembly.validate (globalThis.Uint8Array.from (js-call managed :emit_managed_wasm ir runtime))))
          (js-call assert :equal (JSON/stringify ir) original))))
      (js-call (js-array
        (js-array "(imul32 x)" "imul32 expects 2 arguments, got 1")
        (js-array "(bit-or x 1 2)" "bit-or expects 2 arguments, got 3")
        (js-array "(int32 x x)" "int32 expects 1 argument, got 2")) :forEach (lambda (entry)
        (let ((ir (js-call compiler :compile_ir_string (str "(defun f (x) (if false " (aref entry 0) " x)) (export f)") "unsupported-word.eli")))
          (js-call assert :throws (lambda () (js-call managed :emit_managed_wasm ir runtime))
            (lambda (e)
              (let ((diagnostic (get e :eliscriptDiagnostic)))
                (js-call assert :ok diagnostic e)
                (js-call assert :strictEqual (get diagnostic :code) "ELI-B0001" e)
                (js-call assert :strictEqual (get diagnostic :message) (aref entry 1) e)
                (let* ((location (get diagnostic :location)) (start (get location :start)) (end (get location :end)))
                  (js-call assert :strictEqual (get location :file) "unsupported-word.eli" e)
                  (js-call assert :ok (>= (get start :offset) 0) e)
                  (js-call assert :ok (> (get end :offset) (get start :offset)) e)) t))))))
      (let* ((a (instantiateManagedRuntime (get fixture :bytes))) (n (js-call a :number 1))
        (text (js-call a :string "1")) (plain (js-call a :sourceObject (js-object)))
        (opaque (js-call a :sourceObject (js-object :toString false :valueOf false))) (js (get fixture :js)))
        (js-call (js-array "remainder" "multiply" "exclusive") :forEach (lambda (name)
          (let ((out (js-call a :invoke name (js-array text n))))
            (assert (Object/is (js-call a :readNumber out) (funcall (get js name) 1 1))) (js-call a :release out))
          (let ((out (js-call a :invoke name (js-array plain n))))
            (assert (Object/is (js-call a :readNumber out) (funcall (get js name) (js-object) 1))) (js-call a :release out))
          (js-call assert :throws (lambda () (funcall (get js name) (js-object :toString false :valueOf false) 1)) globalThis.TypeError)
          (js-call assert :throws (lambda () (js-call a :invoke name (js-array opaque n)))
            (lambda (e) (= (get (get e :eliscriptDiagnostic nil) :code nil) "ELI-RT0003")))))
        (js-call (js-array n text plain opaque) :forEach (lambda (value) (js-call a :release value)))
        (js-call a :collect) (js-call assert :equal (js-call a :live) 0)))))
  (test "Node independently executes the identical ordinary word artifact and collects every result"
    (async () (let ((path (resolve (get fixture :directory) "word.wasm")))
      (await (writeFile path (get fixture :bytes)))
      (let ((result (spawnSync "node" (js-array (resolve "tests/helpers/managed-numeric-node.mjs") "word" path)
        (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get result :status) 0 (get result :stderr)))))))
