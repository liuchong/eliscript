(module tests.reader-program-fuzz-acceptance
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/backends/compiler-corpus-fuzz.mjs" transportOriginalFuzzCorpus)
  (import "../tools/fuzz/reader-program-acceptance.mjs" runReaderProgramFuzzAcceptance)
  (import "../tools/fuzz/program-emission-proof.mjs" historicalUnicodeOutput)

  (test "historical fuzz compatibility removes exactly the declared Unicode import and preserves every other byte"
    (lambda ()
      (let ((line "import \"eliscript/runtime/unicode-case.mjs\";\n"))
        (js-call assert :strictEqual (historicalUnicodeOutput (+ "// original\n" line "export const x = 1;\n"))
          "// original\nexport const x = 1;\n")
        (js-call (js-array "export const x = 1;\n" (+ line line)
          "import 'eliscript/runtime/unicode-case.mjs';\n") :forEach
          (lambda (source) (js-call assert :throws (lambda () (historicalUnicodeOutput source))))))))
  (test "maintained fuzz transport authenticates the unchanged original assertions and preserves every corpus field"
    (async ()
      (let* ((source (await (readFile (resolve root "tests/reader-program-fuzz.test.mjs") "utf8")))
             (sha (js-call (js-call (createHash "sha256") :update source) :digest "hex"))
             (modules (js-array (js-object :id "compiler.mjs" :source "original compiler source")))
             (coverage (js-array "original-full-fuzz"))
             (regions (js-array (js-object :start 0 :end (js-length source) :byteStart 0
               :byteEnd (js-call Buffer :byteLength source) :sha256 sha)))
             (other (js-object :id "unrelated" :expected (js-object :value 42)))
             (record (js-object :id "original-program:compiler-module-reader-program-fuzz" :modules modules :coverage coverage
               :expected (js-object :stdout "") :original (js-object :suite "tests/reader-program-fuzz.test.mjs" :sourceSha256 sha :regions regions)
               :execution (js-object :kind "original-program" :timeoutMs 320000 :requiresBun t :hostSource "historical original host")))
             (gate (js-object :verification "not-executed"))
             (document (js-object :records (js-array other record) :evidence (js-array) :originalGateEvidence gate)))
        (js-call assert :strictEqual sha "d53a6fab62d6ca7f9a58ae56265149d1a8b51ce4b53080da018724a29ce52b6d")
        (js-call assert :strictEqual (await (transportOriginalFuzzCorpus document (js-object :sourceRoot root))) document)
        (js-call assert :strictEqual (aref (get document :records) 0) other)
        (js-call assert :strictEqual (get document :originalGateEvidence) gate)
        (js-call assert :strictEqual (get record :modules) modules)
        (js-call assert :strictEqual (get record :coverage) coverage)
        (js-call assert :strictEqual (get (get record :original) :regions) regions)
        (js-call assert :strictEqual (get (get record :execution) :timeoutMs) 320000)
        (js-call assert :strictEqual (get (get record :expected) :stdout) "")
        (js-call assert :strictEqual (get (get record :execution) :host) "tools/fuzz/reader-program-corpus-host.mjs")
        (js-call assert :strictEqual (Object/hasOwn (get record :execution) "hostSource") false)
        (let ((host (await (readFile (resolve root "tools/fuzz/reader-program-corpus-host.eli") "utf8"))))
          (js-call assert :ok (js-call host :includes "(import \"./reader-program-acceptance.mjs\" runReaderProgramFuzzAcceptance)"))
          (js-call assert :strictEqual (js-call host :includes "createRequire") false))
        (js-call assert :ok (> (js-length (get (get record :original) :sourceAssets)) 15))
        (put (get record :original) :sourceSha256 (js-call "0" :repeat 64))
        (await (js-call assert :rejects (transportOriginalFuzzCorpus document (js-object :sourceRoot root))
          (lambda (error) (js-call (get error :message) :includes "source identity")))))))
  (test "100000 deterministic reader and program mutations preserve every invariant"
    (async () (await (runReaderProgramFuzzAcceptance))) 320000))
