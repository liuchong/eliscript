(module tests.math-oracle-fixture
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:path" resolve)
  (import "node:fs/promises" readFile writeFile mkdir mkdtemp symlink rm)
  (import "node:child_process" spawnSync)
  (import "../dist/bootstrap/compiler.mjs" :as runtime-compiler)
  (import "../tools/backends/build.mjs" root buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/testing/math-oracle-fixture.mjs" capsuleMathOracleSource prepareMathOracleCompiler readOriginalMathSqrtSource readOriginalMathThisForm projectMathSqrtSource)
  (defun raw-value (runtime value)
    (cond ((or (nullish? value) (= (value-type value) "boolean")) value)
      ((= (get value :kind) 4) (js-call runtime :readNumber value))
      ((= (get value :kind) 5) (js-call runtime :readString value))
      ((= (get value :kind) 14)
        (let ((result (js-array)) (index 0))
          (while (< index (js-call runtime :length value))
            (let ((child (js-call runtime :get value index)))
              (try (js-call result :push (raw-value runtime child))
                (finally (js-call runtime :release child))))
            (setq index (1+ index))) result))
      (t (throw (new globalThis.TypeError "unexpected original sqrt observation")))))
  (defun conversion-observations (runtime)
    (js-call runtime :auto 1)
    (let ((result (js-array)))
      (js-call (js-array 4 5 6) :forEach (lambda (mode)
        (let ((argument (js-call runtime :number mode)) (value undefined))
          (try
            (setq value (js-call runtime :invoke "sqrt-convert" (js-array argument)))
            (js-call result :push (raw-value runtime value))
            (finally
              (unless (undefined? value) (js-call runtime :release value))
              (js-call runtime :release argument))))))
      (js-call (js-array 0 1 2) :forEach (lambda (mode)
        (let ((argument (js-call runtime :number mode)) (value undefined))
          (try
            (setq value (js-call runtime :invoke "sqrt-construct" (js-array argument)))
            (js-call result :push (raw-value runtime value))
            (finally
              (unless (undefined? value) (js-call runtime :release value))
              (js-call runtime :release argument)))))) result))
  (test "authenticated Math fixture repair retains the complete original lambda program and changes only the intended ordinary conversion hook"
    (async ()
      (let* ((suite (await (readFile (resolve root "tests/wasm-managed-math.test.mjs") "utf8")))
             (original (readOriginalMathSqrtSource suite))
             (receiver-form (readOriginalMathThisForm suite))
             (projected (projectMathSqrtSource suite original "sqrt-math.eli")))
        (js-call assert :ok (js-call original :includes
          (str "(lambda (hint) (js-call trace :push hint (eq " receiver-form " input))")))
        (js-call assert :ok (js-call projected :includes (str "(receiver " receiver-form ")")))
        (js-call assert :throws (lambda () (readOriginalMathThisForm (str suite "\n"))) globalThis.TypeError)
        (js-call assert :ok (js-call projected :includes "(defun original-sqrt-primitive-hook (hint)"))
        (js-call assert :ok (js-call projected :includes "(eq receiver (get state :input))"))
        (js-call assert :ok (js-call projected :endsWith (js-call original :slice (js-call original :indexOf "(defun sqrt-throw"))))
        (js-call assert :strictEqual (projectMathSqrtSource suite "unchanged other source" "other.eli") "unchanged other source")
        (js-call assert :throws (lambda () (readOriginalMathSqrtSource (str suite "\n"))) globalThis.TypeError)
        (js-call assert :throws (lambda () (projectMathSqrtSource suite (str original "\n") "sqrt-math.eli")) globalThis.TypeError)
        (js-call assert :strictEqual (await (readFile (resolve root "tests/wasm-managed-math.test.mjs") "utf8")) suite))))
  (test "the complete original sqrt lambda and maintained ordinary hook each match independent Emacs JavaScript on WASM and native without changing their receiver goldens"
    (js-object :timeout 120000)
    (async ()
      (let ((parent (resolve root "_worktree/evidence/math-oracle-source-contract")))
        (await (mkdir parent (js-object :recursive t)))
        (let ((directory (await (mkdtemp (resolve parent "case-")))))
          (try
            (let* ((suite (await (readFile (resolve root "tests/wasm-managed-math.test.mjs") "utf8")))
                   (original (readOriginalMathSqrtSource suite))
                   (sources (js-array original (projectMathSqrtSource suite original "sqrt-math.eli")))
                   (backend (await (buildBackends (js-object :outputRoot (resolve directory "backend")))))
                   (compiler (get backend :compiler))
                   (memory (js-call compiler :compile_ir_string
                     (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
                   (native-target (when (= (get globalThis.process :arch) "arm64")
                     (cond ((= (get globalThis.process :platform) "darwin") "arm64-macos")
                       ((= (get globalThis.process :platform) "linux") "arm64-linux"))))
                   (index 0))
              (js-call assert :strictEqual (value-type native-target) "string")
              (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
              (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
              (while (< index (js-length sources))
                (let* ((source (aref sources index)) (id (if (= index 0) "original-lambda" "ordinary-hook"))
                       (input (resolve directory (str id ".eli"))) (output (resolve directory (str id ".mjs")))
                       (driver (resolve directory (str id "-driver.eli"))) (driver-output (resolve directory (str id "-driver.mjs"))))
                  (await (writeFile input source))
                  (await (writeFile driver (str "(import " (JSON/stringify (str "./" id ".mjs")) " :as reference)"
                    "(console/log (JSON/stringify (js-array (js-call reference :sqrt_convert 4)"
                    " (js-call reference :sqrt_convert 5) (js-call reference :sqrt_convert 6)"
                    " (js-call reference :sqrt_construct 0) (js-call reference :sqrt_construct 1)"
                    " (js-call reference :sqrt_construct 2))))")))
                  (js-call (js-array (js-array input output) (js-array driver driver-output)) :forEach (lambda (pair)
                    (let ((seed (spawnSync (resolve root "bin/eliscript-seed")
                           (js-array "--output" (aref pair 1) (aref pair 0))
                           (js-object :cwd root :encoding "utf8"))))
                      (js-call assert :strictEqual (get seed :status) 0 (get seed :stderr)))))
                  (let* ((node (spawnSync (or (get (get globalThis.process :env) :NODE) "node") (js-array driver-output)
                                (js-object :cwd root :encoding "utf8")))
                         (receiver (= index 1))
                         (expected (js-array (js-array 9 (js-array "primitive.get" "number" receiver))
                           (js-array "marker" (js-array "primitive.get" "number" receiver))
                           (js-array "TypeError" (js-array "primitive.get" "number" receiver))
                           (js-array "TypeError" (js-array "argument"))
                           (js-array "TypeError" (js-array)) (js-array "TypeError" (js-array))))
                         (program (js-call compiler :compile_ir_string source (str id ".eli")))
                         (lowered (js-call (get backend :managed) :lower_managed_program program memory))
                         (bytes (Uint8Array/from (js-call (get backend :wasm) :append_metadata_section
                           (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed))
                           "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
                         (native-path (resolve directory (str id (if (= native-target "arm64-macos") ".dylib" ".so")))))
                    (js-call assert :strictEqual (get node :status) 0 (get node :stderr))
                    (js-call assert :deepStrictEqual (JSON/parse (get node :stdout)) expected)
                    (js-call assert :deepStrictEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
                    (await (writeFile native-path (Uint8Array/from
                      (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target))))
                    (let ((target 0))
                      (while (< target 2)
                        (let ((runtime (if (= target 0) (instantiateManagedRuntime bytes)
                              (await (instantiateNativeManagedRuntime native-path lowered (js-object :nativeTarget native-target))))))
                          (try (js-call assert :deepStrictEqual (conversion-observations runtime) expected)
                            (finally
                              (try
                                (js-call runtime :closeModule) (js-call runtime :collect)
                                (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                                (js-call assert :strictEqual (js-call runtime :live) 0)
                                (finally (when (get runtime :close) (js-call runtime :close)))))))
                        (setq target (1+ target))))))
                (setq index (1+ index))))
            (finally (await (rm directory (js-object :recursive t :force t)))))))))
  (test "Math oracle authenticates each complete runtime source module and map using the real CLI coordinates"
    (js-object :timeout 180000)
    (async ()
      (let ((parent (resolve root "_worktree/evidence/math-oracle-source-contract")))
        (await (mkdir parent (js-object :recursive t)))
        (let ((directory (await (mkdtemp (resolve parent "runtime-identity-")))))
          (try
            (await (mkdir (resolve directory "runtime")))
            (await (mkdir (resolve directory "tests")))
            (await (writeFile (resolve directory "tests/wasm-managed-math.test.mjs")
              (await (readFile (resolve root "tests/wasm-managed-math.test.mjs")))))
            (let ((names (js-array "unicode-case-data" "unicode-case" "math")) (index 0)
                  ;; Isolate provenance here; the complete static capsule
                  ;; transport is retained below and in the original suite.
                  (scan (lambda (source) (js-array))))
              (while (< index (js-length names))
                (let ((name (aref names index)) (suffixes (js-array ".eli" ".mjs" ".mjs.map")) (position 0))
                  (while (< position (js-length suffixes))
                    (let ((file (str "runtime/" name (aref suffixes position))))
                      (await (writeFile (resolve directory file) (await (readFile (resolve root file))))))
                    (setq position (1+ position))))
                (setq index (1+ index)))
              (let ((prepared (await (prepareMathOracleCompiler runtime-compiler directory scan))))
                (js-call assert :strictEqual (value-type (get prepared :compile_ir_string)) "function"))
              (setq index 0)
              (while (< index (js-length names))
                (let* ((name (aref names index)) (module (resolve directory (str "runtime/" name ".mjs")))
                       (map-path (str module ".map")) (source-path (resolve directory (str "runtime/" name ".eli")))
                       (javascript (await (readFile module "utf8"))) (mapping (await (readFile map-path "utf8")))
                       (source (await (readFile source-path "utf8"))))
                  (await (writeFile module (str javascript "\n")))
                  (await (js-call assert :rejects (prepareMathOracleCompiler runtime-compiler directory scan) globalThis.TypeError))
                  (await (writeFile module javascript))
                  (await (writeFile source-path (str source "\n")))
                  (await (js-call assert :rejects (prepareMathOracleCompiler runtime-compiler directory scan) globalThis.TypeError))
                  (await (writeFile source-path source))
                  (await (rm map-path))
                  (await (js-call assert :rejects (prepareMathOracleCompiler runtime-compiler directory scan) (js-object :code "ENOENT")))
                  (await (writeFile map-path mapping))
                  (let ((changes (js-array (js-object :file "other.mjs")
                    (js-object :sources (js-array "other.eli"))
                    (js-object :sourcesContent (js-array (str source "\n")))
                    (js-object :mappings ""))) (position 0))
                    (while (< position (js-length changes))
                      (await (writeFile map-path (str (JSON/stringify (Object/assign (js-object)
                        (JSON/parse mapping) (aref changes position))) "\n")))
                      (await (js-call assert :rejects (prepareMathOracleCompiler runtime-compiler directory scan) globalThis.TypeError))
                      (setq position (1+ position))))
                  (await (writeFile map-path mapping)))
                (setq index (1+ index))))
            (finally (await (rm directory (js-object :recursive t :force t)))))))))
  (test "Math oracle rejects runtime bytes that do not match the maintained source compiler emission"
    (async ()
      (await (js-call assert :rejects
        (prepareMathOracleCompiler (js-object :compile_string_with_source_map (lambda (&rest arguments)
          (js-object :javascript "different emission" :sourceMap "different map")))
          (resolve ".") (lambda (source) (js-array)))
        globalThis.TypeError))))
  (test "Math oracle transport admits only authenticated static runtime capsules and retains the complete emitted body"
    (lambda ()
      (let* ((path "eliscript/runtime/math.mjs")
             (url "data:text/javascript;base64,ZXhwb3J0IHt9Ow==")
             (source (str "import " (JSON/stringify path) ";\noriginal-body"))
             (capsules (new globalThis.Map (js-array (js-array path url))))
             (scan (lambda (input)
               (if (= input source) (js-array (js-object :kind "import-statement" :path path)) (js-array)))))
        (js-call assert :strictEqual (capsuleMathOracleSource source capsules scan)
          (str "import " (JSON/stringify url) ";\noriginal-body"))
        (js-call (js-array "unknown-package" "./unlisted.mjs" "https://example.invalid/runtime.mjs") :forEach
          (lambda (unknown)
            (js-call assert :throws (lambda ()
              (capsuleMathOracleSource source capsules
                (lambda (input) (js-array (js-object :kind "import-statement" :path unknown))))) globalThis.TypeError)))
        (js-call assert :throws (lambda ()
          (capsuleMathOracleSource source capsules
            (lambda (input) (js-array (js-object :kind "dynamic-import" :path path))))) globalThis.TypeError)
        (js-call assert :throws (lambda ()
          (capsuleMathOracleSource source capsules
            (lambda (input) (js-array (js-object :kind "import-statement"
              :path (if (= input source) path "./hidden-relative.mjs")))))) globalThis.TypeError)
        (js-call assert :throws (lambda ()
          (capsuleMathOracleSource source (new globalThis.Map) scan)) globalThis.TypeError)))))
