(module tests.native-prototype-node
  (import "node:assert/strict" :default assert)
  (import "../../bootstrap/host/bun.mjs" loadCompiler)
  (defasync main ()
    (let* ((m (await (loadCompiler (aref (get globalThis.process :argv) 2))))
           (bigint (globalThis.BigInt "12345678901234567890")) (hex (js-call bigint :toString 16))
           (method (get (get globalThis.BigInt :prototype) :toString))
           (expected (js-array
             (js-array t t (js-call bigint :toString) (js-call bigint :toString)
               (js-call bigint :toString 2) (js-call bigint :toString 36) "toString" (get method :length))
             (js-array (js-call bigint :toString) hex) (js-array "TypeError" (js-array))
             (js-array hex (js-array "radix")) (js-array t (js-array "throw"))
             (js-array hex (js-array "receiver" "argument" "extra" "radix"))
             (js-array hex "replacement") (js-array "TypeError" (js-array))
             (js-array "RangeError" "RangeError" "RangeError" "RangeError" "TypeError"))))
      (js-call assert :strictEqual (get method :length) 0 "the current standard BigInt toString has no required parameter")
      (js-call assert :deepStrictEqual (js-call (JSON/parse (js-call m :collections)) :slice 0 4)
        (js-array t 2 2 (js-array (js-array 1 "a" t) (js-array 2 "b" t))))
      (js-call assert :deepStrictEqual (js-call (JSON/parse (js-call m :iterators)) :slice 0 4)
        (js-array (js-object :value (js-array "a" 1) :done false)
          (js-object :value (js-array "b" 2) :done false) (js-object :done t) (js-object :done t)))
      (js-call assert :strictEqual (await (js-call m :promise_suite 0)) "[1,2,3]")
      (js-call assert :strictEqual (await (js-call m :promise_suite 2)) "[\"AggregateError\",[]]")
      (js-call assert :strictEqual (await (js-call m :promise_suite 4)) "[true,7]")
      (js-call assert :strictEqual (await (js-call m :foreign_then (globalThis.Promise.resolve 8))) 11)
      (let ((mode 0)) (while (< mode (js-length expected))
        (js-call assert :deepStrictEqual (JSON/parse (js-call m :bigint_call_path mode)) (aref expected mode)
          (str "independent BigInt borrowed call mode " mode)) (setq mode (1+ mode))))))
  (js-call (main) :catch (lambda (error) (console/error error) (put globalThis.process :exitCode 1))))
