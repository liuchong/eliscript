(module tests.managed-browser-transport
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir readFile realpath symlink writeFile)
  (import "node:path" resolve)
  (import "node:module" createRequire)
  (import "node:child_process" spawnSync)
  (import "../../tools/backends/build.mjs" root)
  (defvar reference-id 0)
  (defasync writeManagedReference (directory javascript label)
    (let ((modules (resolve directory "node_modules")) (package (resolve directory "node_modules/eliscript")))
      (await (mkdir modules (js-object :recursive t)))
      (try (await (symlink root package "dir")) (catch error
        (unless (= (get error :code) "EEXIST") (throw error))
        (js-call assert :strictEqual (await (realpath package)) (await (realpath root))))))
    (setq reference-id (1+ reference-id))
    (let ((path (resolve directory (str label "-" reference-id ".mjs")))) (await (writeFile path javascript)) path))
  (defasync loadManagedReference (directory javascript label)
    (let ((path (await (writeManagedReference directory javascript label)))) (funcall (createRequire path) path)))
  (defun runManagedNode (helper arguments options)
    (spawnSync "node" (js-call (js-array helper) :concat arguments) options))
  (defasync bundleManagedBrowserPage (path aliases)
    (let* ((mapping (if (nullish? aliases) (js-object) aliases))
           (result (await (js-call globalThis.Bun :build (js-object :entrypoints (js-array path) :target "browser" :format "esm"
             :plugins (js-array (js-object :name "eliscript-managed-acceptance-routes" :setup (lambda (builder)
               (js-call builder :onResolve (js-object :filter (new globalThis.RegExp "^(eliscript-test/|/oracle\\.mjs$|eliscript/runtime/unicode-case\\.mjs$)"))
                 (lambda (request) (let ((id (get request :path)))
                   (cond ((Object/hasOwn mapping id) (js-object :path (get mapping id)))
                     ((= id "/oracle.mjs") (js-object :path id :external t))
                     ((= id "eliscript/runtime/unicode-case.mjs") (js-object :path "/runtime/unicode-case.mjs" :external t))
                     (t (throw (new globalThis.Error (str "undeclared acceptance route " id))))))))))))))))
      (js-call assert :strictEqual (get result :success) t (funcall globalThis.String (get result :logs)))
      (await (js-call (aref (get result :outputs) 0) :text))))
  (defun serveManagedBrowserPage (bundle oracle-source)
    (js-call globalThis.Bun :serve (js-object :port 0 :fetch (async (request)
      (let* ((url (new globalThis.URL (get request :url))) (path (get url :pathname))
             (headers (js-object :headers (js-object "content-type" "text/javascript"))))
        (cond
          ((= path "/") (new globalThis.Response "<!doctype html><title>Managed language acceptance</title><script type=\"importmap\">{\"imports\":{\"eliscript/runtime/\":\"/runtime/\"}}</script><script type=\"module\" src=\"/page.mjs\"></script>" (js-object :headers (js-object "content-type" "text/html"))))
          ((= path "/page.mjs") (new globalThis.Response bundle headers))
          ((= path "/oracle.mjs") (new globalThis.Response oracle-source headers))
          ((js-call (js-array "/runtime/unicode-case.mjs" "/runtime/unicode-case-data.mjs") :includes path)
            (new globalThis.Response (await (readFile (resolve root (js-call path :slice 1)))) headers))
          (t (new globalThis.Response "Not found" (js-object :status 404)))))))))
  (export writeManagedReference loadManagedReference runManagedNode bundleManagedBrowserPage serveManagedBrowserPage)
)
