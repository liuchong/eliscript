(module tests.managed-array-construction-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (let ((a (instantiateManagedRuntime (readFileSync 0))))
    (js-call a :auto 1)
    (js-call assert :strictEqual (js-call a :invoke "identities") t)
    (let* ((text (js-call a :string "A😀\ud800")) (chars (js-call a :invoke "from" (js-array text)))
           (values (js-array t undefined undefined)) (_hole (Reflect/deleteProperty values "1"))
           (input (js-call a :sourceArray values)) (copy (js-call a :invoke "direct" (js-array input)))
           (empty (js-call a :invoke "empty-of")) (index 0))
      (js-call assert :strictEqual (js-call a :length chars) 3)
      (while (< index 3)
        (let ((item (js-call a :get chars index)))
          (js-call assert :strictEqual (js-call a :readString item) (aref (Array/from "A😀\ud800") index))
          (js-call a :release item)) (setq index (1+ index)))
      (js-call assert :strictEqual (js-call a :length copy) 3)
      (setq index 0)
      (while (< index 3)
        (let ((key (js-call a :number index)))
          (js-call assert :strictEqual (js-call a :invoke "own" (js-array copy key)) t)
          (js-call a :release key)) (setq index (1+ index)))
      (js-call (js-array text chars input copy empty) :forEach (lambda (value) (js-call a :release value))))
    (js-call a :closeModule) (js-call a :collect)
    (js-call assert :strictEqual (js-call a :live) 0)
    (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0)))
