(module tests.release-readiness
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/ci/check-release-ready.mjs" requiredReleaseChecks validateReleaseReadiness)
  (defconst revision (js-call "a" :repeat 40))
  (defun green ()
    (js-call requiredReleaseChecks :map (lambda (name index)
      (js-object :name name :headSha revision :databaseId (1+ index) :status "completed" :conclusion "success"))))
  (test "publication accepts all four successful checks on exactly the release commit"
    (lambda ()
      (let* ((runs (green)) (before (JSON/stringify runs)) (result (validateReleaseReadiness revision runs)))
        (js-call assert :strictEqual (get result :revision) revision)
        (js-call assert :deepStrictEqual (js-call (get result :checks) :map (lambda (check) (get check :name))) requiredReleaseChecks)
        (js-call assert :strictEqual (JSON/stringify runs) before))))
  (test "missing cancelled failed and unfinished checks block publication for every required workflow"
    (lambda ()
      (js-call requiredReleaseChecks :forEach (lambda (name index)
        (js-call assert :throws (lambda () (validateReleaseReadiness revision
          (js-call (green) :filter (lambda (run) (/= (get run :name) name))))) (new globalThis.RegExp "missing"))
        (js-call (js-array "cancelled" "failure" "timed_out" "skipped" "action_required" "neutral") :forEach
          (lambda (conclusion)
            (let ((runs (green))) (put (aref runs index) :conclusion conclusion)
              (js-call assert :throws (lambda () (validateReleaseReadiness revision runs))
                (new globalThis.RegExp "publication blocked")))))
        (js-call (js-array "queued" "in_progress") :forEach (lambda (status)
          (let ((runs (green))) (put (aref runs index) :status status)
            (js-call assert :throws (lambda () (validateReleaseReadiness revision runs))
              (new globalThis.RegExp "publication blocked")))))))))
  (test "another commit and an older successful run cannot conceal a newer cancelled run"
    (lambda ()
      (let ((runs (green)))
        (js-call assert :throws (lambda () (validateReleaseReadiness (js-call "b" :repeat 40) runs))
          (new globalThis.RegExp "missing"))
        (js-call runs :push (Object/assign (js-object) (aref runs 0)
          (js-object :databaseId 100 :conclusion "cancelled")))
        (js-call assert :throws (lambda () (validateReleaseReadiness revision runs))
          (new globalThis.RegExp "completed/cancelled"))
        (put (aref runs 4) :conclusion "success")
        (js-call assert :strictEqual (get (aref (get (validateReleaseReadiness revision runs) :checks) 0) :runId) 100))))
  (test "release inputs require the complete commit identity"
    (lambda ()
      (js-call (js-array "main" "a342aea" "" nil) :forEach (lambda (value)
        (js-call assert :throws (lambda () (validateReleaseReadiness value (green))) globalThis.TypeError)))
      (js-call assert :throws (lambda () (validateReleaseReadiness revision nil)) globalThis.TypeError)))
  (test "the release workflow verifies required CI before every irreversible npm publishing command"
    (lambda ()
      (let* ((workflow (readFileSync (resolve root ".github/workflows/release.yml") "utf8"))
             (guard (js-call workflow :indexOf "bun tools/ci/check-release-ready.mjs"))
             (commands (Array/from (js-call workflow :matchAll (new globalThis.RegExp "^ *npm (?:stage )?publish\\b" "gm")))))
        (js-call assert :ok (> guard (js-call workflow :indexOf "make bootstrap-backends")))
        (js-call assert :ok (> (js-length commands) 0))
        (js-call commands :forEach (lambda (command) (js-call assert :ok (> (get command :index) guard)))))))
)
