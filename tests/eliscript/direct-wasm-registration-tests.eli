(module tests.direct-wasm-registration-tests
  (import "node:test" test)
  (import "bun:test" :as bun-framework)
  (import "node:assert/strict" :default assert)
  (import "./helpers/direct-wasm-registration.mjs" createDirectWasmRegistration registerDirectWasmCompletion)
  (import "./helpers/direct-wasm-affected.mjs" createDirectInvocationWatchdog)
  (test "functional timeout overrides retain default bounds and reject unknown or unbounded replacements"
    (lambda ()
      (let* ((calls (js-array)) (callback (lambda () nil))
             (framework (js-object :test (lambda (&rest arguments) (js-call calls :push arguments))))
             (replacements (js-object "stress" callback "ordinary" callback))
             (registration (createDirectWasmRegistration framework replacements
               (js-object :timeouts (js-object "stress" 600000)))))
        (js-call (get registration :exports) :test "stress" callback 120000)
        (js-call (get registration :exports) :test "ordinary" callback 120000)
        (js-call assert :strictEqual (aref (aref calls 0) 2) 600000)
        (js-call assert :strictEqual (aref (aref calls 1) 2) 300000)
        (js-call registration :complete)
        (js-call (js-array 0 -1 600001 1.5 globalThis.Infinity globalThis.NaN) :forEach (lambda (timeout)
          (js-call assert :throws (lambda () (createDirectWasmRegistration framework replacements
            (js-object :timeouts (js-object "stress" timeout)))) globalThis.TypeError)))
        (js-call assert :throws (lambda () (createDirectWasmRegistration framework replacements
          (js-object :timeouts (js-object "unknown" 1000)))) globalThis.TypeError))))
  (test "an actual stalled invocation timer reports its input and calls only its cleanup callback"
    (async ()
      (let ((settle undefined) (deadline undefined) (observed undefined) (calls 0))
        (let* ((done (new globalThis.Promise (lambda (resolve reject)
                 (setq settle resolve deadline (globalThis.setTimeout (lambda ()
                   (funcall reject (new globalThis.Error "watchdog did not expire"))) 1000)))))
               (watchdog (createDirectInvocationWatchdog (lambda (error)
                 (setq observed error calls (1+ calls)) (funcall settle)) 5)))
          (try
            (js-call watchdog :observe (js-object :phase "invoke-start" :name "json_case" :index 12 :threshold 1))
            (await done)
            (js-call assert :strictEqual calls 1)
            (js-call assert :strictEqual (js-call watchdog :failure) observed)
            (js-call assert :match (get observed :message) (new globalThis.RegExp "json_case\\[12\\] GC=1"))
            (finally (globalThis.clearTimeout deadline) (js-call watchdog :close)))))))
  (test "completed and closed invocation timers are cancelled without suppressing failure evidence"
    (async ()
      (let* ((calls 0) (watchdog (createDirectInvocationWatchdog (lambda (error) (setq calls (1+ calls))) 5)))
        (try
          (js-call watchdog :observe (js-object :phase "invoke-start"))
          (js-call watchdog :observe (js-object :phase "invoke-complete"))
          (await (new globalThis.Promise (lambda (resolve reject) (globalThis.setTimeout resolve 20))))
          (js-call watchdog :observe (js-object :phase "invoke-start"))
          (js-call watchdog :close)
          (await (new globalThis.Promise (lambda (resolve reject) (globalThis.setTimeout resolve 20))))
          (js-call assert :strictEqual calls 0)
          (js-call assert :strictEqual (js-call watchdog :failure) undefined)
          (js-call (js-array 0 -1 30001 1.5 globalThis.Infinity) :forEach (lambda (timeout)
            (js-call assert :throws (lambda () (createDirectInvocationWatchdog (lambda () nil) timeout)) globalThis.TypeError)))
          (finally (js-call watchdog :close))))))
  (test "direct WASM registration forwards every unrelated callback and requires each exact replacement once"
    (lambda ()
      (let* ((calls (js-array)) (ordinary (lambda () "ordinary")) (replacement (lambda () "replacement"))
             (real-test (lambda (&rest arguments) (js-call calls :push arguments) "actual registration"))
             (hook (lambda () "hook"))
             (framework (js-object :test real-test :beforeAll hook :afterAll hook :describe hook))
             (registration (createDirectWasmRegistration framework (js-object "exact title" replacement)))
             (actual (get registration :exports)))
        (js-call assert :strictEqual (get actual :beforeAll) hook)
        (js-call assert :strictEqual (get actual :afterAll) hook)
        (js-call assert :strictEqual (get actual :describe) hook)
        (js-call assert :throws (lambda () (js-call registration :complete)) (new globalThis.RegExp "missing"))
        (js-call assert :strictEqual (js-call actual :test "exact title extra" ordinary 123) "actual registration")
        (js-call assert :deepStrictEqual (aref calls 0) (js-array "exact title extra" ordinary 123))
        (js-call assert :strictEqual (js-call actual :test "exact title" ordinary 120000) "actual registration")
        (js-call assert :deepStrictEqual (aref calls 1) (js-array "exact title" replacement 300000))
        (js-call assert :strictEqual (js-call registration :complete) t)
        (js-call assert :throws (lambda () (js-call actual :test "exact title" ordinary))
          (new globalThis.RegExp "duplicate"))
        (js-call assert :strictEqual (get framework :test) real-test))))
  (test "direct WASM registration preserves non-enumerable real framework modifiers and their descriptors"
    (lambda ()
      (let* ((real-test (lambda (&rest arguments) "registered"))
             (skip (lambda (&rest arguments) "real deferred registration"))
             (_property (Object/defineProperty real-test "skip"
               (js-object :value skip :enumerable false :writable false :configurable t)))
             (registration (createDirectWasmRegistration (js-object :test real-test) (js-object)))
             (forward (get (get registration :exports) :test)))
        (js-call assert :strictEqual (get forward :skip) skip)
        (js-call assert :strictEqual (js-call forward :skip "deferred") "real deferred registration")
        (js-call assert :deepStrictEqual (Object/getOwnPropertyDescriptor forward "skip")
          (Object/getOwnPropertyDescriptor real-test "skip"))
        (js-call assert :strictEqual (js-call registration :complete) t))))
  (test "direct WASM completion waits for deferred describe registration and restores on both success and missing callbacks"
    (lambda ()
      (let ((hook undefined) (restored 0) (calls (js-array)) (replacement (lambda () "replacement")))
        (let* ((framework (js-object :beforeAll (lambda (callback) (setq hook callback))
                  :test (lambda (&rest arguments) (js-call calls :push arguments))))
               (registration (createDirectWasmRegistration framework (js-object "deferred title" replacement))))
          (registerDirectWasmCompletion framework registration (lambda () (setq restored (1+ restored))))
          (js-call assert :strictEqual restored 0)
          (js-call assert :strictEqual (js-length calls) 0)
          ;; This represents the real framework's later describe collection.
          (js-call (get registration :exports) :test "deferred title" (lambda () "old") 120000)
          (js-call assert :strictEqual restored 0)
          (funcall hook)
          (js-call assert :strictEqual restored 1)
          (js-call assert :deepStrictEqual (aref calls 0) (js-array "deferred title" replacement 300000))
          (let ((missing (createDirectWasmRegistration framework (js-object "missing title" replacement))))
            (registerDirectWasmCompletion framework missing (lambda () (setq restored (1+ restored))))
            (js-call assert :strictEqual restored 1)
            (js-call assert :throws (lambda () (funcall hook)) (new globalThis.RegExp "missing"))
            (js-call assert :strictEqual restored 2))))))
  (defconst actual-registration (createDirectWasmRegistration bun-framework (js-object)))
  (defconst actual-forward (get (get actual-registration :exports) :test))
  (test "direct WASM registration preserves the actual Bun host skip method and its real identity"
    (lambda ()
      (js-call assert :strictEqual (value-type (get actual-forward :skip)) "function")
      (js-call assert :strictEqual (get actual-forward :skip) (get (get bun-framework :test) :skip))
      (js-call assert :strictEqual (js-call actual-registration :complete) t)))
  ;; This is an intentional framework-capability fixture, not an omitted
  ;; language case. Its body must never run when the real Bun skip is called.
  (js-call actual-forward :skip "direct WASM registration real Bun skip capability fixture"
    (lambda () (throw (new globalThis.Error "the actual Bun skip method executed its body"))))
)
