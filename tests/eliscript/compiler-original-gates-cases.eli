(module tests.compiler-original-gates-cases
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp mkdir writeFile readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:crypto" createHash)
  (import "../../dist/bootstrap/compiler.mjs" compile-string)
  (import "../../tools/backends/build.mjs" root loadLiteralSources)
  (import "../../tools/backends/compiler-build.mjs" loadCompilerSources)
  (import "../../tools/backends/compiler-matrix.mjs" runOriginalCompilerGates)
  (import "../../tools/backends/compiler-bootstrap.mjs" compilerSourceIdentity compilerDigest)
  (import "../../tools/backends/compiler-corpus-managed-adapters.mjs" addOriginalManagedLibraryAdapters originalManagedProgramCompletionSource)
  (import "../../tools/backends/compiler-corpus-managed-fixtures.mjs" addOriginalManagedFixtureAdapters readOriginalFinalFixtureMigrations)
  (import "../../tools/backends/compiler-corpus-tools-artifact-adapters.mjs" addOriginalToolsArtifactPrograms)
  (import "../../tools/backends/compiler-corpus-managed-cases.mjs" originalManagedSuites originalManagedCaseLocators)
  (defun eqv (a b &optional message) (js-call assert :strictEqual a b message))
  (defun deep (a b &optional message) (js-call assert :deepStrictEqual a b message))
  (defun ok (a &optional message) (js-call assert :ok a message))
  (defun each (items callback) (js-call items :forEach callback))
  (defasync each-await (items callback)
    (let ((index 0)) (while (< index (js-length items)) (await (funcall callback (aref items index))) (setq index (1+ index)))))
  (defun select (items predicate) (js-call items :filter predicate))
  (defun find (items predicate) (js-call items :find predicate))
  (defun some (items predicate) (js-call items :some predicate))
  (defun includes (text part) (js-call text :includes part))
  (defasync fixture (recipe run)
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-original-gates-")))))
      (try
        (progn
          (await (each-await (js-array "bootstrap/compiler" "bootstrap/backends" "bootstrap/host" "bootstrap/runtime" "runtime" "evidence")
            (async (path) (await (mkdir (resolve directory path) (js-object :recursive t))))))
          (await (each-await (await (loadLiteralSources)) (async (record)
            (let ((output (resolve directory (get record :filename))))
              (await (mkdir (resolve output "..") (js-object :recursive t))) (await (writeFile output (get record :source)))))))
          (await (writeFile (resolve directory "bootstrap/host/compiler-session.eli") "(export)"))
          (await (writeFile (resolve directory "bootstrap/runtime/memory.eli") "; unit fixture runtime\n"))
          (await (each-await (js-array "runtime/math.eli" "runtime/unicode-case.eli" "runtime/unicode-case-data.eli") (async (path)
            (let ((bytes (await (readFile (resolve root path)))))
              (await (writeFile (resolve directory path) bytes)) (deep (await (readFile (resolve directory path))) bytes)))))
          (await (writeFile (resolve directory "Makefile") (+ "test-core:\n" (js-call (js-call recipe :map (lambda (line) (+ "\t@" line "\n"))) :join ""))))
          (let* ((file "original-corpus.json") (bytes (globalThis.Buffer.from "{\"original\":\"unit fixture\"}\n")))
            (await (writeFile (resolve directory file) bytes))
            (let* ((corpus (js-object :document (js-object :originalGateEvidence (js-object :required t
                              :execution (js-object :provider "local" :command "make test-core" :applicationEvidence false)
                              :coverageIds (js-array "original-unit-locator")))
                            :originals (js-object :manifests (js-array (js-object :file file :sha256 (compilerDigest bytes))))))
                   (options (js-object :sourceRoot directory :corpus corpus
                     :sourceIdentity (compilerSourceIdentity (await (loadCompilerSources (js-object :sourceRoot directory))))
                     :directory (resolve directory "evidence"))))
              (await (funcall run options)))))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defasync successful-gate ()
    (await (fixture (js-array "echo original-command-ran" "echo original-stderr >&2") (async (options)
      (let ((result (await (runOriginalCompilerGates options))))
        (eqv (get result :status) "passed") (eqv (get result :exitCode) 0) (eqv (get result :signal) nil)
        (deep (get result :command) (js-array "make" "test-core")) (deep (get result :coverageIds) (js-array "original-unit-locator"))
        (await (each-await (get result :files) (async (record)
          (let ((data (await (readFile (resolve (get options :directory) (get record :path))))))
            (eqv (compilerDigest data) (get record :sha256)) (eqv (js-length data) (get record :bytes))))))
        (eqv (await (readFile (resolve (get options :directory) "original-gates.stdout.log") "utf8")) "original-command-ran\n")
        (eqv (await (readFile (resolve (get options :directory) "original-gates.stderr.log") "utf8")) "original-stderr\n"))))))
  (defasync failed-gate ()
    (await (fixture (js-array "echo failed-original-assertion >&2" "exit 7") (async (options)
      (let ((result (await (runOriginalCompilerGates options))))
        (eqv (get result :status) "failed") (js-call assert :notStrictEqual (get result :exitCode) 0)
        (js-call assert :match (await (readFile (resolve (get options :directory) "original-gates.stderr.log") "utf8"))
          (new globalThis.RegExp "failed-original-assertion")))))))
  (defasync changed-gate ()
    (await (each-await (js-array "bootstrap/runtime/memory.eli" "original-corpus.json") (async (path)
      (await (fixture (js-array (+ "echo changed >> " path)) (async (options)
        (let ((result (await (runOriginalCompilerGates options))))
          (eqv (get result :status) "failed")
          (eqv (get result (if (js-call path :endsWith ".eli") "sourceUnchanged" "manifestsUnchanged")) false)))))))))
  (defasync wrong-gate ()
    (await (fixture (js-array "echo should-not-run") (async (options)
      (put (get (get (get options :corpus) :document) :originalGateEvidence) :execution
        (js-object :provider "local" :command "make test-applications" :applicationEvidence false))
      (await (js-call assert :rejects (runOriginalCompilerGates options) (new globalThis.RegExp "stable core contract")))))))
  (defun services (records locators stable-files)
    (let ((evidence (new globalThis.Map)))
      (letfn ((file (filename)
        (if (js-call evidence :has filename) (Promise/resolve (js-call evidence :get filename))
          (js-call (readFile (resolve root filename)) :then (lambda (bytes)
            (let ((record (js-object :file filename :sha256 (compilerDigest bytes) :bytes (js-length bytes)
                            :encoding "base64" :content (js-call bytes :toString "base64"))))
              (js-call evidence :set filename record) record)))))
        (text (filename) (js-call (file filename) :then (lambda (record)
          (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode
            (globalThis.Buffer.from (get record :content) "base64"))))))
        (js-object :add (lambda (record) (js-call records :push record)) :locators locators :file file :text text
          :stableFiles stable-files :sourceRoot root))))
  (defasync library-case ()
    (let* ((records (js-array)) (names (js-array "core-modules" "transient-state" "sorted" "sequence-data" "wire"))
           (stable (new globalThis.Set (js-call names :map (lambda (name) (+ "tests/fixtures/wasm-managed-" name ".eli")))))
           (suites (js-array "core-modules" "transient-state" "sorted-core" "sequence-data" "wire"))
           (titles (js-array "Given original standard module imports" "Given the complete transient state dependency graph"
             "Given complete original sorted and ordering source modules" "internal infinite, cache, close, metadata, paths, metrics and IEEE observations"
             "Given the identical complete wire graph"))
           (locators (js-call suites :map (lambda (name index) (js-object :id (+ "original-library-" index)
             :file (+ "tests/wasm-managed-" name ".test.mjs") :contains (aref titles index)))))
           (options (services records locators stable)))
      (js-call locators :push (js-object :id "original-public-tools" :file "tests/compiler-session-tools.test.mjs" :contains "Unicode scalar queries preserve exact source spans"))
      (await (addOriginalManagedLibraryAdapters options))
      ;; Semantic tools records are owned by the artifact/tools adapter, not
      ;; the standard-library adapter. Exercise both actual registration paths
      ;; before requiring the original Node and Bun tools observers below.
      (await (addOriginalToolsArtifactPrograms options))
      (await (each-await (Array/from stable) (async (fixture-name)
        (let ((cases (select records (lambda (record) (includes (get record :coverage) (+ "stable-compatibility:" fixture-name))))))
          (ok (> (js-length cases) 0) (+ fixture-name " requires actual selected-artifact execution records"))
          (deep (js-call (Array/from (new globalThis.Set (js-call cases :map (lambda (record) (get (get record :execution) :hostRuntime))))) :sort) (js-array "bun" "node"))
          (await (each-await cases (async (record)
            (let ((execution (get record :execution)) (sequence (js-call fixture-name :endsWith "sequence-data.eli")))
              (eqv (get execution :kind) "original-program") (eqv (get execution :referenceArtifact) t)
              (eqv (get execution :childProcesses) "inherit-selected-artifact")
              ;; Sequence now deliberately retains the real public export cells.
              (eqv (get execution :zeroImports) (not (or sequence (js-call fixture-name :endsWith "wire.eli"))))
              (when sequence (ok (> (js-length (get execution :requiredManagedImports)) 0)))
              (eqv (get (get record :expected) :oracleRequired) t)
              (let ((expected-file (if sequence (+ (js-call (get record :entry) :slice 0 -4) ".eli") fixture-name)))
                (ok (some (get record :modules) (lambda (module)
                  (and (= (get module :filename) expected-file)
                       (or (not sequence) (= (get module :id) (get record :entry))))))
                  (+ "the original fixture must occupy its actual source graph coordinate: " fixture-name)))
              (when sequence
                ;; Sequence uses virtual source stems to resolve its original
                ;; relative graph. Bind that coordinate to the complete actual
                ;; fixture text as well as its unchanged physical source name.
                (eqv (get (get record :original) :fixture) fixture-name)
                (let ((entry (find (get record :modules) (lambda (module) (= (get module :id) (get record :entry))))))
                  (eqv (get entry :source) (await (js-call options :text fixture-name)))))
              (eqv (get (get record :original) :sourceSha256) (get (await (js-call options :file (get (get record :original) :suite))) :sha256))
              (if sequence
                (progn (deep (get execution :runtimeOptions) (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216))
                  (deep (get record :memory) (js-object :initialPages 128 :maximumPages 4096))
                  (eqv (get record :auto) 65536) (eqv (get execution :timeoutMs) 60000))
                (progn (deep (get execution :runtimeOptions) (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216))
                  (deep (get record :memory) (js-object :initialPages 4 :maximumPages 1024)) (ok (includes (js-array 1 65536) (get record :auto)))))))))))))
      (let ((transient (find records (lambda (record) (= (get record :id) "original-managed:transient-state:node:auto-1"))))
            (wire (find records (lambda (record) (= (get record :id) "original-managed:wire:node:auto-1"))))
            (sequence (find records (lambda (record) (= (get record :id) "original-managed:sequence-data:node:auto-65536")))))
        (ok (includes (get (get transient :execution) :hostSource) "[0, 1, 31, 32, 33, 63, 64, 1023, 1024, 1055, 1056, 1057]"))
        (each (js-array "index<128" "await checkNetwork(runtime)" "await checkJavaScriptNetwork()" "assert.equal(item.module,'eliscript.host')")
          (lambda (part) (ok (includes (get (get wire :execution) :hostSource) part))))
        (each (js-array "runtime/core/transducer.mjs" "runtime/core/sequence.mjs" "runtime/core/data.mjs" "runtime/core/value-internals.mjs" "runtime/testing/value.mjs")
          (lambda (name) (ok (some (get sequence :modules) (lambda (module) (= (get module :id) (+ "public/" name)))) (+ name " requires its actual target export cell")))))
      (each (js-array "sequence" "text" "object") (lambda (family)
        (ok (some records (lambda (record) (= (get record :id) (+ "original-managed:sequence-data-portable-" family ":node:auto-65536")))))))
      (ok (some records (lambda (record) (= (get record :id) "original-managed:sequence-data-relational-set:node:auto-65536"))))
      (let ((tools (select records (lambda (record) (= (get (get record :execution) :kind) "compiler-session-program"))))
            (sources (await (loadCompilerSources (js-object :sourceRoot root)))))
        (deep (js-call (js-call tools :map (lambda (record) (get (get record :execution) :hostRuntime))) :sort) (js-array "bun" "node"))
        (await (each-await tools (async (record)
          (eqv (get (get record :request) :phased) false) (eqv (get (get record :execution) :runtimeProfile) "compiler")
          (deep (get record :modules) (get sources :modules)) (eqv (get record :entry) (get sources :entry))
          (eqv (js-length (select (get record :modules) (lambda (module) (js-call (get module :filename) :startsWith "bootstrap/compiler/")))) 13)
          (let* ((execution (get record :execution)) (host (get execution :hostSource))
                 (original (get record :original)) (replacement (get execution :setupReplacement))
                 (identity (compilerSourceIdentity sources))
                 (source (await (js-call options :text (get original :suite)))))
            (eqv (get replacement :kind) "selected-complete-compiler-semantic-tools")
            (eqv (get replacement :producer) "selected-session")
            (deep (get replacement :sourceIdentity) identity)
            (deep (get original :completeSourceIdentity) identity)
            (eqv (get original :sourceSha256) (compilerDigest (globalThis.Buffer.from source)))
            (each (get original :regions) (lambda (region)
              (let ((text (js-call source :slice (get region :start) (get region :end))))
                (eqv (get region :sha256) (compilerDigest (globalThis.Buffer.from text)))
                (eqv (get region :byteStart) (globalThis.Buffer.byteLength (js-call source :slice 0 (get region :start))))
                (eqv (get region :byteEnd) (globalThis.Buffer.byteLength (js-call source :slice 0 (get region :end)))))))
            ;; Check actual selected-session operations and finally cleanup,
            ;; rather than an obsolete local function name or JS whitespace.
            (js-call assert :match host (new globalThis.RegExp "createCompilerSession\\s*\\(\\s*\\{\\s*host\\s*:\\s*configuration\\s*\\.\\s*target"))
            (js-call assert :match host (new globalThis.RegExp "await\\s+openSelected\\s*\\(\\s*\\)"))
            (js-call assert :match host (new globalThis.RegExp
              "try\\s*\\{\\s*await\\s+run\\s*\\(\\s*session\\s*\\)\\s*;?\\s*\\}\\s*finally\\s*\\{\\s*session\\s*\\.\\s*close\\s*\\(\\s*\\)"))
            (let* ((changes (get replacement :changes))
                   (session-region (get (get replacement :dependencies) :session))
                   (session-source (js-call source :slice (get session-region :start) (get session-region :end)))
                   (before (js-call (new globalThis.RegExp "const\\s+session\\s*=\\s*await\\s+createCompilerSession[\\s\\S]*?;") :exec session-source)))
              (eqv (js-length changes) 1) (ok before)
              (eqv (get (aref changes 0) :beforeSha256) (compilerDigest (globalThis.Buffer.from (aref before 0))))
              (ok (some (Array/from (js-call host :matchAll
                    (new globalThis.RegExp "const\\s+session\\s*=\\s*await\\s+openSelected\\s*\\(\\s*\\)\\s*;" "g")))
                (lambda (match) (= (compilerDigest (globalThis.Buffer.from (aref match 0)))
                                  (get (aref changes 0) :afterSha256)))))))))))))
  (defasync coverage-case ()
    (let* ((records (js-array)) (locators (js-array))
           (stable (new globalThis.Set (js-call (js-array "core-modules" "transient-state" "sorted" "sequence-data" "wire")
             :map (lambda (name) (+ "tests/fixtures/wasm-managed-" name ".eli")))))
           (options (services records locators stable)))
      (await (each-await originalManagedSuites (async (suite)
        ;; The source locator must read the exact historical assertion input,
        ;; not a migrated generated registration entry with additional B cases.
        (let* ((source-file (if (= suite "tests/wasm-managed-sequence-data.test.mjs")
                              "tests/wasm-managed-sequence-data-test-legacy.mjs" suite))
               (source (await (js-call options :text source-file))))
          (Reflect/apply (get locators :push) locators (originalManagedCaseLocators suite source))))))
      (deep (await (addOriginalManagedLibraryAdapters options)) (js-array) "per-case mapping does not declare its original suite exhausted")
      (await (addOriginalToolsArtifactPrograms options))
      (each locators (lambda (locator)
        (let ((plans (select records (lambda (record) (includes (get record :coverage) (get locator :id))))))
          (ok (> (js-length plans) 0) (+ "actual original case requires selected execution: " (get locator :contains)))
          (each plans (lambda (record)
            (js-call assert :notStrictEqual (get record :kind) "original-suite")
            (eqv (get (get record :expected) :oracleRequired) (if (= (get record :kind) "sequence") undefined t))
            (let* ((original (get record :original)) (assertion (get original :assertionSource)))
              (eqv (if assertion (get assertion :sourceSha256) (get original :sourceSha256)) (get (get locator :originalCase) :sourceSha256)))
            (let* ((bound (get locator :originalCase)) (parameters (get bound :parameters)))
              (when (get parameters :engine) (eqv (get (get record :execution) :hostRuntime) (get parameters :engine)))
              (unless (undefined? (get parameters :auto)) (eqv (get record :auto) (get parameters :auto)))
              (unless (undefined? (get bound :auto)) (eqv (get record :auto) (get bound :auto)))
              (when (get parameters :name) (ok (includes (get record :id) (+ "sequence-data-host-" (get parameters :name) ":"))))
              (when (get parameters :family) (ok (includes (get record :id) (+ "sequence-data-portable-" (get parameters :family) ":"))))))))))
      (each (select locators (lambda (locator) (= (get locator :file) "tests/compiler-session-tools.test.mjs")))
        (lambda (locator) (each (js-array "node" "bun") (lambda (host)
          (ok (some records (lambda (record) (and (includes (get record :coverage) (get locator :id))
                (= (get (get record :execution) :hostRuntime) host)))) (+ (get locator :contains) " requires its actual " host " host"))))))
      (let ((wire (select records (lambda (record) (js-call (get record :id) :startsWith "original-managed:wire-original-host:")))))
        (ok (> (js-length wire) 0)) (each wire (lambda (record) (ok (includes (get (get record :execution) :hostSource) "wire.codec_report().validation.valid")))))))
  (defun fixture-source-hash (source) (js-call (js-call (createHash "sha256") :update source) :digest "hex"))
  (defasync assert-fixture-observer (record family options)
    (let* ((execution (get record :execution)) (original (get record :original))
           (transport (get original :observationTransport))
           (retained (if transport (get transport :originalHostSource) (get execution :hostSource))))
      ;; The complete original assertions remain authenticated source data.
      (each (js-array "const expected=observe(oracle),actual=observe(m)" "runtime.stats().frameDepth" "runtime.live(),0")
        (lambda (part) (ok (includes retained part))))
      (when transport
        (eqv (get transport :version) 1) (eqv (get transport :family) family)
        (eqv (fixture-source-hash retained) (get transport :originalHostSha256))
        (let* ((properties (= family "function-properties"))
               (kind (cond ((= family "math") "math-fixture")
                 ((includes (js-array "arrays" "objects" "array-callbacks" "array-search" "array-construction" "variadic-calls" "source-collections") family) "fixture-observer")
                 ((includes (js-array "symbols" "regexp" "module-bindings" "persistent-vector-auto-1" "persistent-vector-auto-65536" "object-properties") family) "special-fixtures")
                 (t "language-fixtures")))
               (raw-export (cond ((= kind "math-fixture") "runOriginalRawMathFixtureHost")
                 ((= kind "fixture-observer") "runOriginalRawFixtureHost")
                 ((= kind "special-fixtures") "runOriginalRawSpecialFixtureHost") (t "runOriginalRawLanguageFixtureHost")))
               (raw-config (js-object :family family :helper (str "tools/backends/compiler-corpus-raw-" kind ".mjs")
                 :export raw-export :auto (get record :auto 1) :suite (get original :suite)
                 :sourceSha256 (get original :sourceSha256) :originalHostSha256 (fixture-source-hash retained)))
               (argument raw-config) (entry (if properties "runOriginalFunctionPropertiesHost" "runOriginalRawFixtureMain")))
          (when properties
            (let* ((suite (await (js-call options :text (get original :suite))))
                   (declaration (js-call (new globalThis.RegExp "const wellKnownSymbolNames=\\[([^\\]]*)\\];") :exec suite))
                   (symbols (JSON/parse (str "[" (js-call (aref declaration 1) :replaceAll "'" "\"") "]"))))
              (deep symbols (js-array "iterator" "toPrimitive" "match" "replace" "search" "split" "species" "isConcatSpreadable"
                "toStringTag" "hasInstance" "asyncIterator" "unscopables" "matchAll" "dispose" "asyncDispose"))
              (setq argument (js-call (js-array "isFinite" "missing" "name" "length" "prototype" "caller" "arguments"
                "call" "apply" "bind" "constructor" "toString" "__proto__" "parseInt" "parseFloat" "fromCharCode" "fromCodePoint" "raw") :concat symbols))))
          (let* ((helper (get (pathToFileURL (resolve root "tools/backends/compiler-corpus-project-entry-host.mjs")) :href))
                 (forms (str "(import " (JSON/stringify helper) " " entry ")\n"
                   (originalManagedProgramCompletionSource (str "(await (" entry " (JSON/parse "
                     (JSON/stringify (JSON/stringify argument)) ")))")))))
            (eqv (get execution :hostSource) (compile-string forms "original-fixture-observer.eli")
              "the complete original observer arguments reach the maintained host unchanged"))
          (await (each-await (get original :sourceAssets) (async (proof)
            (let ((asset (await (js-call options :file (get proof :file)))))
              (eqv (get proof :sourceSha256) (get asset :sha256))
              (when (Object/hasOwn proof "bytes") (eqv (get proof :bytes) (get asset :bytes)))))))
          (ok (some (get original :sourceAssets) (lambda (proof)
            (= (get proof :file) "tools/backends/eliscript/compiler-corpus-project-entry-host.eli"))))))))
  (defasync fixture-replay-case ()
    (let* ((records (js-array)) (contract (JSON/parse (await (readFile (resolve root "contracts/stable-compatibility-corpus.json") "utf8"))))
           (locators (js-array
             (js-object :id "original-math-deadline" :file "tests/wasm-managed-math.test.mjs" :contains "Given precise finite cancellation and observable iterators")
             (js-object :id "original-arithmetic-raw" :file "tests/wasm-managed-arithmetic.test.mjs" :contains "increment and decrement retain mixed primitive conversion")
             (js-object :id "original-function-reflection" :file "tests/wasm-managed-function-properties.test.mjs" :contains "reflection-snapshot")
             (js-object :id "original-runtime-function-reflection" :file "tests/wasm-managed-function-properties-runtime.test.mjs" :contains "function")))
           (options (services records locators (new globalThis.Set (get contract :fixtureFiles)))))
      (let ((execution-locators (js-call locators :slice)))
        (await (each-await (await (readOriginalFinalFixtureMigrations options)) (async (migration)
          (when (get migration :existingReplaySuite)
            (let* ((identity (await (js-call options :file (get migration :suite))))
                   (selection (js-object :file (get identity :file) :sourceSha256 (get identity :sha256)
                     :kind "maintained-fixture-execution-selection")))
              (js-call execution-locators :push selection))))))
        (put options :locators execution-locators))
      (deep (await (addOriginalManagedFixtureAdapters options)) (js-array))
      (await (each-await (js-array "arithmetic" "word" "array-callbacks" "arrays" "array-construction" "array-search" "array-text"
          "builtins" "callables" "catch-destructuring" "control" "empty-bindings" "exceptions" "function-properties"
          "json" "math" "module-bindings" "number-conversion" "object-properties" "objects" "primitive-operators"
          "regexp" "replacement" "source-collections" "strings" "symbols" "typeof" "variadic-calls" "js-cons")
        (async (family)
          (let ((fixture-name (+ "tests/fixtures/wasm-managed-" family ".eli")))
            (when (includes (get contract :fixtureFiles) fixture-name)
              (await (each-await (js-array "node" "bun") (async (host)
                (let ((record (find records (lambda (record) (= (get record :id) (+ "original-managed-fixture:" family ":" host))))))
                  (ok record (+ fixture-name " has a real " host " selected-product observer"))
                  (eqv (get (get record :execution) :hostRuntime) host)
                  (ok (includes (get record :coverage) (+ "stable-compatibility:" fixture-name)))
                  (eqv (get (get record :execution) :kind) "original-program") (eqv (get (get record :execution) :referenceArtifact) t)
                  (await (assert-fixture-observer record family options))
                  (ok (some (get record :modules) (lambda (module) (= (get module :filename) fixture-name))))
                  (eqv (get (get record :original) :sourceSha256) (get (await (js-call options :file (get (get record :original) :suite))) :sha256)))))))))))
      (let ((sources (await (loadCompilerSources (js-object :sourceRoot root))))
            (replay (find records (lambda (record) (= (get record :id) "original-managed-suite:complete-fixture-suites")))))
        (ok replay)
        (await (each-await locators (async (locator)
          (ok (includes (get replay :coverage) (get locator :id)))
          (deep (get replay :modules) (get sources :modules))
          (deep (get (get replay :request) :literalSources) (get sources :literalSources))
          (deep (get (get replay :request) :entries) (js-call (get sources :modules) :map (lambda (module) (get module :id))))
          (eqv (get (get replay :request) :phased) t) (eqv (get replay :entry) (get sources :entry))
          (eqv (get (get replay :execution) :hostRuntime) "bun") (eqv (get (get replay :original) :testSource) "unmodified")
          (eqv (get (find (get (get replay :original) :suites) (lambda (item) (= (get item :file) (get locator :file)))) :sourceSha256)
            (get (await (js-call options :file (get locator :file))) :sha256)))))
        ;; Preserve the original transport source assertions against the real
        ;; original runner implementation; these do not execute a fake runner.
        (let ((transport (get (get replay :execution) :hostSource)))
          (js-call assert :match transport (new globalThis.RegExp "args\\s*[.]\\s*push\\s*\\(\\s*['\"]--preload['\"]\\s*,\\s*plugin\\s*,\\s*['\"]test['\"]\\s*,\\s*suite\\s*,?\\s*\\)") "the actual Bun runner must receive its selected namespace preload and the original suite")
          (js-call assert :match transport (new globalThis.RegExp "spawn\\s*\\(\\s*process[.]env[.]BUN\\s*\\?\\?\\s*['\"]bun['\"]\\s*,\\s*args\\s*,") "the original suite must execute in a real isolated Bun process")
          (js-call assert :match transport (new globalThis.RegExp "suite\\s*=\\s*resolve\\s*\\(\\s*sourceRoot\\s*,\\s*relativeSuite\\s*,?\\s*\\)") "the runner must load the original suite path")
          (js-call assert :match transport (new globalThis.RegExp "assert[.]equal\\s*\\(\\s*result[.]code\\s*,\\s*0\\s*,\\s*['\"]the complete original suite must pass with the actual selected compiler product['\"]\\s*,?\\s*\\)") "a failed original suite must fail its matrix record")
          (js-call assert :match transport (new globalThis.RegExp "originalSelectedFrontendBuild\\s*\\(\\s*\\{\\s*[.]{3}options\\s*,\\s*frontend\\s*:\\s*options[.]frontend\\s*\\?\\?\\s*actual[.]compiler\\s*,?\\s*\\}\\s*\\)") "explicit frontend and Seed rebuilds must retain the actual selected frontend")
          (js-call assert :match transport (new globalThis.RegExp "assert[.]deepEqual\\s*\\(\\s*interception[.]modules\\s*,\\s*moduleIds\\s*,") "the child must verify every selected compiler module identity")
          (js-call assert :match transport (new globalThis.RegExp "process[.]removeListener\\s*\\(\\s*['\"]SIGTERM['\"]\\s*,\\s*terminate\\s*,?\\s*\\)") "the completed child must remove its cancellation listener")
        )
        (await (each-await (js-array "wasm-managed-builtins" "wasm-managed-typeof" "wasm-managed-project-linking" "direct-wasm-backend" "wasm-managed-function-properties-runtime"
            "wasm-managed-js-cons-fast" "wasm-managed-vector-copy" "wasm-managed-type-construction")
          (async (name)
            (let* ((filename (+ "tests/" name ".test.mjs"))
                   (suite (find (get (get replay :original) :suites) (lambda (item) (= (get item :file) filename)))))
              (ok suite (+ filename " must enter unchanged original-suite replay"))
              (eqv (get suite :sourceSha256) (get (await (js-call options :file filename)) :sha256))))))
        (let ((project (find records (lambda (record) (= (get record :id) "original-managed-fixture:project-entry:node")))))
          (each (js-array "entry" "state") (lambda (name)
            (let ((filename (+ "tests/fixtures/wasm-managed-project-" name ".eli")))
              (ok (some (get project :modules) (lambda (module) (= (get module :filename) filename))))
              (ok (includes (get project :coverage) (+ "stable-compatibility:" filename)))))))
        (let ((vector (find records (lambda (record) (= (get record :id) "original-managed-fixture:persistent-vector-auto-65536:node")))))
          (ok (some (get vector :modules) (lambda (module) (= (get module :filename) "stdlib/persistent-vector.eli"))))
          (deep (get (get vector :execution) :runtimeOptions) (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216))
          (deep (get vector :memory) (js-object :initialPages 4 :maximumPages 1024))
          (await (assert-fixture-observer vector "persistent-vector-auto-65536" options))
          (let* ((transport (get (get vector :original) :observationTransport))
                 (host (get transport :originalHostSource))
                 (boundary (js-call (new globalThis.RegExp "for\\s*\\(\\s*const\\s+count\\s+of\\s*(\\[[^\\]]*\\])\\s*\\)") :exec host)))
            (ok boundary "the complete original host retains its actual persistent Vector boundary loop")
            (deep (JSON/parse (aref boundary 1)) (js-array 0 1 31 32 33 63 64 65 1023 1024 1025 1056 1057))
            (eqv (get transport :originalHostSha256) (fixture-source-hash host)))))))
  (defconst originalGateCases (js-object
    "matrix original gate records the actual core command exit status and exact log bytes" successful-gate
    "matrix original gate preserves command failure instead of producing acceptance" failed-gate
    "matrix original gate rejects changed compiler sources or original manifest bytes" changed-gate
    "matrix original gate refuses a different command before executing it" wrong-gate
    "new managed library corpus transports complete original fixtures and original budgets into every selected target" library-case
    "all six registered original suites enter selected-session records by individual case identity without whole-suite exemptions" coverage-case
    "original managed fixture recipes execute selected products and retain complete raw suites through the actual original Bun runner" fixture-replay-case))
  (export originalGateCases))
