(module tests.unicode-case
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm realpath)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:module" createRequire)
  (import "node:vm" createContext constants)
  (import "node:crypto" createHash)
  (import "../tools/backends/build.mjs" root)
  (import "../dist/bootstrap/compiler.mjs" compile-ir-string emit-ir-string)
  (import "../tools/backends/compiler-corpus-execution.mjs" executeCompilerCorpusRecord)

  (defun compile (source filename) (emit-ir-string (compile-ir-string source filename)))
  (defasync load-module (path)
    (let* ((canonical (await (realpath path))) (require-module (createRequire canonical)))
      (funcall require-module canonical)))
  (defasync runtime () (await (load-module (resolve root "runtime/unicode-case.mjs"))))
  (defun realm ()
    ;; A real fresh realm, without treating a formal ESM product as a script.
    (createContext (get constants :DONT_CONTEXTIFY)))
  (defasync profiles ()
    (get (JSON/parse (await (readFile (resolve root "tests/fixtures/unicode-case-profiles.json") "utf8"))) :versions))
  (defun type-error-p (error) (= (get error :name) "TypeError"))

  (test "Unicode default installs once and derives all explicit profiles from the one maintained data region"
    (async ()
      (let* ((upper (get (get globalThis.String :prototype) :toUpperCase))
             (lower (get (get globalThis.String :prototype) :toLowerCase)) (module (await (runtime)))
             (memory (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
             (begin "  ;; BEGIN GENERATED UNICODE CASE DATA") (end "  ;; END GENERATED UNICODE CASE DATA")
             (region (js-call memory :slice (js-call memory :indexOf begin) (+ (js-call memory :indexOf end) (js-length end))))
             (data (await (load-module (resolve root "runtime/unicode-case-data.mjs")))))
        (js-call assert :strictEqual (value-type (get module :installUnicodeCaseProfile)) "function")
        (js-call assert :strictEqual (get (get module :installUnicodeCaseProfile) :length) 1)
        (js-call assert :strictEqual (get (get globalThis.String :prototype) :toUpperCase) upper)
        (js-call assert :strictEqual (get (funcall (get module :installUnicodeCaseProfile) 17) :version) 17)
        (js-call assert :strictEqual (get (get globalThis.String :prototype) :toLowerCase) lower)
        (js-call assert :strictEqual (get data :unicodeCaseDataSourceSha256)
          (js-call (js-call (createHash "sha256") :update region "utf8") :digest "hex"))
        (js-call assert :strictEqual (js-length (js-call (Object/keys data) :filter
          (lambda (name) (js-call name :startsWith "unicode_case_data_")))) 24))))

  (test "explicit profiles retain the real String object standard callable descriptors generic receivers and strict UTF16 casing"
    (async ()
      (let* ((module (await (runtime))) (install (get module :installUnicodeCaseProfile)) (host (realm))
             (constructor (get host :String)) (prototype (get constructor :prototype))
             (state (funcall install 15.1 host)) (upper (get prototype :toUpperCase)) (lower (get prototype :toLowerCase)))
        (js-call assert :strictEqual (get host :String) constructor)
        (js-call assert :strictEqual (get constructor :prototype) prototype)
        (js-call (js-array (js-array "toUpperCase" upper) (js-array "toLowerCase" lower)) :forEach
          (lambda (pair)
            (let* ((name (aref pair 0)) (method (aref pair 1))
                   (descriptor (Object/getOwnPropertyDescriptor prototype name)))
              (js-call assert :strictEqual (get method :name) name)
              (js-call assert :strictEqual (get method :length) 0)
              (js-call assert :strictEqual (Object/getPrototypeOf method) (get (get host :Function) :prototype))
              (js-call assert :strictEqual (Object/hasOwn method "prototype") false)
              (js-call assert :deepStrictEqual (js-array (get descriptor :writable) (get descriptor :enumerable) (get descriptor :configurable))
                (js-array t false t))
              (js-call assert :throws (lambda () (Reflect/construct method (js-array))) type-error-p)
              (js-call (js-array nil undefined (funcall globalThis.Symbol "invalid") (funcall globalThis.Object (funcall globalThis.Symbol "boxed"))) :forEach
                (lambda (receiver) (js-call assert :throws (lambda () (Reflect/apply method receiver (js-array)))
                  (lambda (error) (and (type-error-p error)
                    (eq (Object/getPrototypeOf error) (get (get host :TypeError) :prototype))))))))))
        (js-call assert :strictEqual (Reflect/apply upper "ßﬃ\ud800\udc00\ud800" (js-array)) "SSFFI\ud800\udc00\ud800")
        (js-call assert :strictEqual (Reflect/apply lower "İAΣ\udc00" (js-array)) "i̇aς\udc00")
        (js-call assert :strictEqual (js-call upper :call -0) "0")
        (js-call assert :strictEqual (js-call lower :apply "AΣ" (js-array)) "aς")
        (let ((trace (js-array)) (receiver (js-object)) (marker (js-object :original t)))
          (Object/defineProperty receiver (get globalThis.Symbol :toPrimitive)
            (js-object :value (lambda (hint) (js-call trace :push hint) "AΣ")))
          (js-call assert :strictEqual (Reflect/apply lower receiver (js-array marker)) "aς")
          (js-call assert :deepStrictEqual trace (js-array "string"))
          (Object/defineProperty receiver "toString" (js-object :value (lambda () (throw marker))))
          (js-call assert :strictEqual (Reflect/apply lower receiver (js-array)) "aς")
          (let ((thrower (js-object :toString (lambda () (throw false)))))
            (js-call assert :throws (lambda () (Reflect/apply lower thrower (js-array))) (lambda (error) (eq error false)))))
        ;; Repeated explicit selection never silently restores a user's edits.
        (let ((replacement (lambda () "changed")))
          (put prototype :toUpperCase replacement)
          (Reflect/deleteProperty prototype "toLowerCase")
          (js-call assert :strictEqual (funcall install 15.1 host) state)
          (js-call assert :strictEqual (get prototype :toUpperCase) replacement)
          (js-call assert :strictEqual (Object/hasOwn prototype "toLowerCase") false)))))

  (test "invalid Unicode profiles reject before touching a realm and all versioned sigma contexts use their own cased and ignorable data"
    (async ()
      (let* ((module (await (runtime))) (install (get module :installUnicodeCaseProfile))
             (host (realm)) (prototype (get (get host :String) :prototype))
             (before (Object/getOwnPropertyDescriptors prototype)))
        (js-call (js-array 0 15 15.2 18 "16" nil undefined) :forEach (lambda (version)
          (js-call assert :throws (lambda () (funcall install version host)) type-error-p)))
        (js-call (js-array nil false 0) :forEach (lambda (invalid-realm)
          (js-call assert :throws (lambda () (funcall install 15.1 invalid-realm)) type-error-p)))
        (js-call assert :deepStrictEqual (Object/getOwnPropertyDescriptors prototype) before)
        (let ((versions (await (profiles))) (index 0))
          (while (< index (js-length versions))
            (let* ((profile (aref versions index)) (isolated (realm))
                   (unused (funcall install (get profile :version) isolated))
                   (lower (get (get (get isolated :String) :prototype) :toLowerCase)))
              (js-call (get profile :sigma) :forEach (lambda (pair)
                (js-call assert :strictEqual (Reflect/apply lower (aref pair 0) (js-array)) (aref pair 1)))))
            (setq index (1+ index)))))))

  (test "the selected compiled String program executes all scalar and sigma golden hashes in isolated explicit-profile JS processes"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-unicode-selected-"))))
             (path (resolve directory "selected.mjs"))
             (source "(module unicode.selected (defun upper (text) (js-call text :toUpperCase)) (defun lower (text) (js-call text :toLowerCase)) (export upper lower))")
             (original-upper (get (get globalThis.String :prototype) :toUpperCase))
             (original-lower (get (get globalThis.String :prototype) :toLowerCase))
             (versions (await (profiles))) (index 0))
        (try
          (progn
            (await (writeFile path (compile source "unicode-selected.eli")))
            (while (< index (js-length versions))
              (let* ((profile (aref versions index))
                     (record (js-object :execution (js-object :kind "unicode-profile" :profile profile)))
                     (context (js-object :record record :artifact (js-object :target "javascript" :path path :entry "selected.mjs" :directory directory)
                       :target "javascript" :sourceRoot root :directory (resolve directory (funcall globalThis.String index)) :options (js-object)))
                     (before (funcall globalThis.structuredClone record))
                     (actual (await (executeCompilerCorpusRecord context))))
                (js-call assert :deepStrictEqual actual (js-object :kind "unicode-profile" :expectedSatisfied t
                  :version (get profile :version) :checked 1112064 :sigmaCases (js-length (get profile :sigma))
                  :hashes (js-object :upper (get profile :upper) :lower (get profile :lower))))
                (js-call assert :deepStrictEqual record before))
              (setq index (1+ index)))
            ;; A wrong selected program must still fail its unmodified golden.
            (await (writeFile path (compile
              "(module unicode.wrong (defun upper (text) text) (defun lower (text) text) (export upper lower))"
              "unicode-wrong.eli")))
            (await (js-call assert :rejects (executeCompilerCorpusRecord
              (js-object :record (js-object :execution (js-object :kind "unicode-profile" :profile (aref versions 0)))
                :artifact (js-object :target "javascript" :path path :directory directory) :target "javascript"
                :sourceRoot root :directory (resolve directory "wrong") :options (js-object)))))
            (js-call assert :strictEqual (get (get globalThis.String :prototype) :toUpperCase) original-upper)
            (js-call assert :strictEqual (get (get globalThis.String :prototype) :toLowerCase) original-lower))
          (finally (await (rm directory (js-object :recursive t :force t)))))))))
