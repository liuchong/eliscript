(module tests.dogfood-action-source
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile readdir mkdir mkdtemp rm)
  (import "node:path" resolve join dirname)
  (import "node:crypto" createHash)
  (import "../../tools/backends/build.mjs" root)
  (defconst project "examples/dogfood")
  (defconst products (js-array "action/artifact.json" "action/index.eli.map" "action/index.js"
    "action/index.js.map" "action/workflow.yml" "site/browser.js"))
  (defun digest (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defasync run (command directory)
    (let* ((child (js-call globalThis.Bun :spawn command
                    (js-object :cwd directory :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text)
             (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref result 0) :stdout (aref result 1) :stderr (aref result 2))))
  (defasync require-run (command directory)
    (let ((result (await (run command directory))))
      (js-call assert :strictEqual (get result :exitCode) 0 (get result :stderr)) result))
  (defasync product-tree (directory prefix)
    (let ((files (js-array)) (entries (await (readdir (join directory prefix) (js-object :withFileTypes t)))) (index 0))
      (while (< index (js-length entries))
        (let* ((entry (aref entries index)) (file (if (= prefix "") (get entry :name) (str prefix "/" (get entry :name)))))
          (if (js-call entry :isDirectory)
            (js-call (await (product-tree directory file)) :forEach (lambda (child) (js-call files :push child)))
            (js-call files :push file)))
        (setq index (1+ index))) (js-call files :sort)))
  (defasync snapshot (directory names)
    (let ((result (js-object)) (index 0))
      (while (< index (js-length names))
        (put result (aref names index) (await (readFile (join directory (aref names index)))))
        (setq index (1+ index))) result))
  (defasync verifySourcePackage (repository directory sources expected)
    (let* ((names (js-call (Object/keys expected) :sort)) (actual (js-array))
           (roots (Array/from (new globalThis.Set (js-call names :map
             (lambda (name) (aref (js-call name :split "/") 0))))))
           (tracked (await (require-run (js-array "git" "ls-files" "-z" "--" directory) repository))))
      (let ((index 0))
        (while (< index (js-length roots))
          (js-call (await (product-tree (resolve repository directory) (aref roots index))) :forEach
            (lambda (file) (js-call actual :push file)))
          (setq index (1+ index))))
      (js-call actual :sort)
      (unless (and (> (js-length names) 0) (= (JSON/stringify actual) (JSON/stringify names)))
        (throw (new globalThis.Error "reproduced package inventory has missing or untracked artifacts")))
      (unless (= (get tracked :stdout) "")
        (throw (new globalThis.Error "generated package artifacts must not be tracked")))
      (unless (> (js-length sources) 0) (throw (new globalThis.Error "indexed source inventory is empty")))
      (let ((index 0))
        (while (< index (js-length sources))
          (let* ((source (aref sources index)) (file (get source :file))
                 (indexed (await (run (js-array "git" "show" (str ":" file)) repository)))
                 (bytes (await (readFile (resolve repository file)))))
            (unless (= (get indexed :exitCode) 0) (throw (new globalThis.Error "indexed source inventory is incomplete")))
            (unless (and (= (get indexed :stdout) (js-call bytes :toString "utf8"))
                         (= (digest bytes) (get source :sha256)))
              (throw (new globalThis.Error "reproduced package source differs from its indexed manifest"))))
          (setq index (1+ index))))
      (let ((index 0))
        (while (< index (js-length names))
          (let* ((name (aref names index)) (file (str directory "/" name))
                 (ignored (await (run (js-array "git" "check-ignore" "--" file) repository)))
                 (bytes (await (readFile (resolve repository file)))))
            (unless (= (get ignored :exitCode) 0) (throw (new globalThis.Error "reproduced package artifact is not ignored")))
            (unless (js-call bytes :equals (get expected name))
              (throw (new globalThis.Error "reproduced package differs from the complete source-built artifacts"))))
          (setq index (1+ index)))) t))
  (defasync runSourcePackageCase ()
    (let* ((directory (str project "/dist")) (absolute (resolve root directory))
           (artifact (JSON/parse (await (readFile (join absolute "action/artifact.json") "utf8"))))
           (sources (js-call (get artifact :sources) :map (lambda (source)
             (js-object :file (str project "/" (get source :path)) :sha256 (get source :sha256)))))
           (before (await (snapshot absolute products))))
      (let ((files (js-array "tools/package.eli" "eliscript.json" "action.yml" "templates/workflows/dogfood.yml")) (index 0))
        (while (< index (js-length files))
          (let ((file (str project "/" (aref files index))))
            (js-call sources :push (js-object :file file :sha256 (digest (await (readFile (resolve root file)))))))
          (setq index (1+ index))))
      (await (verifySourcePackage root directory sources before))
      (let* ((staging (await (mkdtemp (resolve root ".eliscript-dogfood-source-"))))
             (tool (resolve staging "package.mjs")))
        (try
          (await (require-run (js-array (resolve root "bin/eliscript") "--output" tool (resolve root project "tools/package.eli")) root))
          (await (require-run (js-array (get (get globalThis.process :env) :NODE "node") tool "--root" root) root))
          (await (verifySourcePackage root directory sources before))
          (finally (await (rm staging (js-object :recursive t :force t))))))
      (let* ((workflow (await (readFile (join absolute "action/workflow.yml") "utf8")))
             (match (js-call (new globalThis.RegExp "ref: ([0-9a-f]{40})" "u") :exec workflow)))
        (js-call assert :ok match)
        (await (require-run (js-array "git" "cat-file" "-e" (str (aref match 1) ":examples/dogfood/tools/package.eli")) root)))))
  (defasync runPackageNegatives ()
    (let* ((directory (await (mkdtemp (resolve root ".eliscript-dogfood-source-negative-"))))
           (file "source.eli") (product "package/action/product.bin")
           (source "(module package.source (defconst value 1) (export value))\n")
           (sources (js-array (js-object :file file :sha256 (digest source))))
           (expected (js-object "action/product.bin" (js-call globalThis.Buffer :from "original product bytes\n"))))
      (try
        (await (mkdir (resolve directory "package/action") (js-object :recursive t)))
        (await (writeFile (resolve directory ".gitignore") "/package/\n"))
        (await (writeFile (resolve directory file) source))
        (await (writeFile (resolve directory product) (get expected "action/product.bin")))
        (await (require-run (js-array "git" "init" "--quiet") directory))
        (await (require-run (js-array "git" "add" file ".gitignore") directory))
        (await (verifySourcePackage directory "package" sources expected))
        (await (writeFile (resolve directory product) "changed product bytes\n"))
        (await (js-call assert :rejects (verifySourcePackage directory "package" sources expected) (new globalThis.RegExp "reproduced package differs")))
        (await (writeFile (resolve directory product) (get expected "action/product.bin")))
        (await (writeFile (resolve directory file) (str source ";; unstaged change\n")))
        (await (js-call assert :rejects (verifySourcePackage directory "package" sources expected) (new globalThis.RegExp "indexed manifest")))
        (await (require-run (js-array "git" "add" file) directory))
        (await (js-call assert :rejects (verifySourcePackage directory "package" sources expected) (new globalThis.RegExp "indexed manifest")))
        (await (writeFile (resolve directory file) source))
        (await (require-run (js-array "git" "add" file) directory))
        (await (rm (resolve directory product)))
        (await (js-call assert :rejects (verifySourcePackage directory "package" sources expected) (new globalThis.RegExp "inventory")))
        (await (writeFile (resolve directory product) (get expected "action/product.bin")))
        (await (writeFile (resolve directory "package/action/extra.bin") "extra bytes\n"))
        (await (js-call assert :rejects (verifySourcePackage directory "package" sources expected) (new globalThis.RegExp "untracked artifacts")))
        (await (rm (resolve directory "package/action/extra.bin")))
        (await (require-run (js-array "git" "add" "-f" product) directory))
        (await (js-call assert :rejects (verifySourcePackage directory "package" sources expected) (new globalThis.RegExp "must not be tracked")))
        (await (require-run (js-array "git" "rm" "--cached" product) directory))
        (await (require-run (js-array "git" "rm" "--cached" file) directory))
        (await (js-call assert :rejects (verifySourcePackage directory "package" sources expected) (new globalThis.RegExp "indexed source inventory")))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defasync runSourceWorkflowCase ()
    (let* ((text (await (readFile (resolve root project "dist/action/workflow.yml") "utf8")))
           (workflow (js-call (get globalThis.Bun :YAML) :parse text))
           (steps (get (get (get workflow :jobs) :build) :steps))
           (checkout (js-call steps :find (lambda (step) (= (get step :id) "action-source"))))
           (build (js-call steps :find (lambda (step) (= (get step :id) "action-package"))))
           (invoke (js-call steps :find (lambda (step) (= (get step :id) "build")))))
      (js-call assert :ok checkout) (js-call assert :ok build) (js-call assert :ok invoke)
      (js-call assert :match (get checkout :uses) (new globalThis.RegExp "^actions/checkout@[0-9a-f]{40}$"))
      (js-call assert :strictEqual (get (get checkout :with) :repository) "liuchong/eliscript")
      (js-call assert :match (get (get checkout :with) :ref) (new globalThis.RegExp "^[0-9a-f]{40}$"))
      (js-call assert :strictEqual (get (get checkout :with) :path) ".eliscript-action")
      (js-call assert :strictEqual (get (get checkout :with) :persist-credentials) false)
      (js-call assert :strictEqual (get invoke :uses) "./.eliscript-action/examples/dogfood")
      (js-call assert :strictEqual (get build :working-directory) ".eliscript-action")
      (js-call (js-array "make bootstrap-backends" "bun run build:dogfood-browser" "bun run package:dogfood") :forEach
        (lambda (command) (js-call assert :ok (js-call (get build :run) :includes command))))
      (js-call assert :ok (< (js-call steps :indexOf checkout) (js-call steps :indexOf build)))
      (js-call assert :ok (< (js-call steps :indexOf build) (js-call steps :indexOf invoke)))
      (js-call assert :ok (js-call steps :some (lambda (step) (and (get step :run) (js-call (get step :run) :includes "emacs-nox")))))
      (js-call assert :ok (js-call steps :some (lambda (step)
        (and (get step :uses) (js-call (get step :uses) :startsWith "oven-sh/setup-bun@")))))
      (js-call assert :ok (js-call steps :some (lambda (step)
        (and (get step :uses) (js-call (get step :uses) :startsWith "actions/setup-node@")
             (= (get (get step :with) :node-version) "24")))))))
  (export verifySourcePackage runSourcePackageCase runPackageNegatives runSourceWorkflowCase))
