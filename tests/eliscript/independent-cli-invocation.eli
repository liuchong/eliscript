(module tests.independent-cli-invocation
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/testing/independent-cli-fixture.mjs" rewriteIndependentCLIInvocation)
  (defconst bin (resolve root "bin/eliscript-compiler"))
  (defconst parser (resolve root "tools/backends/compiler-cli-legacy.mjs"))
  (test "independent CLI bin invocation preserves the exact selected engine argv options and metadata without relaxing final stage authentication"
    (lambda ()
      (let* ((arguments (js-array "compile" "--compiler-artifact" "own😀.json" "--input" "-" "--json-errors"))
             (before (js-call arguments :slice))
             (options (js-object :cwd "source" :timeout 120000 :input "原😀" :env (js-object :BUN "selected-engine")))
             (result (rewriteIndependentCLIInvocation bin arguments options)))
        (js-call assert :strictEqual (get result :command) "selected-engine")
        (js-call assert :strictEqual (get result :options) options)
        (js-call assert :strictEqual (get result :substitutions) 1)
        (js-call assert :deepStrictEqual (get result :arguments) (js-call (js-array parser) :concat before))
        (js-call assert :deepStrictEqual arguments before))
      (let ((result (rewriteIndependentCLIInvocation "node24" (js-array "--smol" bin "--help") undefined)))
        (js-call assert :strictEqual (get result :command) "node24")
        (js-call assert :strictEqual (get result :options) undefined)
        (js-call assert :deepStrictEqual (get result :arguments) (js-array "--smol" parser "--help")))
      (let* ((arguments (js-array "--compiler-artifact" "stage2.json"))
             (result (rewriteIndependentCLIInvocation (str bin "-copy") arguments nil)))
        (js-call assert :strictEqual (get result :command) (str bin "-copy"))
        (js-call assert :strictEqual (get result :substitutions) 0)
        (js-call assert :strictEqual (get result :options) nil)
        (js-call assert :deepStrictEqual (get result :arguments) arguments))
      (js-call assert :throws (lambda () (rewriteIndependentCLIInvocation bin (js-array bin) undefined)) globalThis.TypeError))))
