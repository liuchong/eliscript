(module tests.compiler-corpus-matchers
  (import "bun:test" :as original)
  (import "bun:jsc" jscDescribeArray jscDescribe)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp mkdir readFile writeFile rm)
  (import "node:path" resolve dirname)
  (import "node:url" pathToFileURL)
  (import "node:os" tmpdir)
  (import "../tools/backends/compiler-corpus-matchers.mjs" expect test)
  (import "../tools/backends/managed-source-view.mjs"
    createManagedSourceView isManagedSourceView snapshotManagedSourceView
    projectManagedSourceViewForMatcher isManagedSourceViewForRuntime)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntimeWithHostModules)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/backends/managed-module-graph.mjs" createManagedModuleGraph createManagedProjectFacades)

  (defasync matcher-project-options (directory descriptor)
    (let ((facades (createManagedProjectFacades descriptor (js-object :entry "main.mjs"))))
      ;; Each actual runtime gets its own real registry and entry URLs. Reusing
      ;; a URL would reuse an installed ESM registry across heaps or targets.
      (await (mkdir directory (js-object :recursive t)))
      (let ((files (get facades :files)) (index 0))
        (while (< index (js-length files))
          (let* ((file (aref files index)) (path (resolve directory (get file :id))))
            (await (mkdir (dirname path) (js-object :recursive t)))
            (await (writeFile path (get file :source))))
          (setq index (1+ index))))
      (js-object :maxSlots 4096 :initialBytes 1048576 :maxBytes 16777216
        :moduleGraph (createManagedModuleGraph descriptor)
        :projectModuleBaseURL (get (pathToFileURL (+ directory "/")) :href))))

  (defun view-of (source &optional replacements)
    (let ((operations (Object/assign (js-object
      :keys (lambda () (Reflect/ownKeys source))
      :descriptor (lambda (key) (Reflect/getOwnPropertyDescriptor source key))
      :get (lambda (key receiver) (Reflect/get source key source))
      :set (lambda (key value receiver) (Reflect/set source key value source))
      :has (lambda (key) (Reflect/has source key))
      :delete (lambda (key) (Reflect/deleteProperty source key))
      :define (lambda (key descriptor) (Reflect/defineProperty source key descriptor))
      :prototype (lambda () (Reflect/getPrototypeOf source))
      :setPrototype (lambda (prototype) (Reflect/setPrototypeOf source prototype))
      :extensible (lambda () (Reflect/isExtensible source))
      :preventExtensions (lambda () (Reflect/preventExtensions source))) replacements)))
      (get (createManagedSourceView
        (js-object :target (if (Array/isArray source) (js-array) (js-object)) :operations operations)) :value)))

  (defun captured (operation)
    (let ((failed false) (error undefined))
      (try (funcall operation) (catch value (setq failed t error value)))
      (js-object :failed failed :error error)))

  ;; Official JSC storage inspection is diagnostic only. Bound each native
  ;; description and never replace the original whole-matcher failure if
  ;; inspection itself cannot describe an object.
  (defun native-array-storage (value)
    (try
      (js-object :description (js-call (jscDescribeArray value) :slice 0 2048)
        :structure (js-call (jscDescribe value) :slice 0 2048))
      (catch ignored (js-object :unavailable t))))

  (defun native-prototype-enumeration (value)
    (try
      (let ((owner (Reflect/getPrototypeOf value)) (levels (js-array)) (depth 0))
        ;; Both real graphs have two prototype levels. Retain the same bound
        ;; on either side and mark truncation rather than walking indefinitely.
        (while (and (not (eq owner nil)) (< depth 8))
          (let* ((keys (Reflect/ownKeys owner))
                 (enumerable (js-call keys :filter (lambda (key)
                   (get (Reflect/getOwnPropertyDescriptor owner key) :enumerable)))))
            (js-call levels :push (js-object :depth depth
              :native (native-array-storage owner)
              :keys (js-call keys :map (lambda (key) (funcall globalThis.String key)))
              :enumerableKeys (js-call enumerable :map (lambda (key) (funcall globalThis.String key))))))
          (setq owner (Reflect/getPrototypeOf owner) depth (1+ depth)))
        (js-object :levels levels :truncated (not (eq owner nil))))
      (catch ignored (js-object :unavailable t))))

  (test "Bun's foreign Proxy array limitation remains visible and unknown inputs keep the original matcher"
    (lambda ()
      (let* ((trace (js-array))
             (foreign (new globalThis.Proxy (js-array 1 2 3)
               (js-object :get (lambda (target key receiver)
                 (js-call trace :push key) (Reflect/get target key receiver)))))
             (golden (js-array 1 2 3)))
        (js-call assert :strictEqual (isManagedSourceView foreign) false)
        (js-call assert :strictEqual (snapshotManagedSourceView foreign) foreign)
        (js-call assert :deepStrictEqual trace (js-array))
        (let ((baseline (captured (lambda () (js-call (js-call original :expect foreign) :toMatchObject golden))))
              (before (js-call trace :slice)))
          (put trace :length 0)
          (let ((transported (captured (lambda () (js-call (expect foreign) :toMatchObject golden)))))
            ;; Bun 34cbb9a40 sees IsArray(proxy), but reads its zero-length
            ;; internal indexing storage. No foreign value is repaired here.
            (js-call assert :strictEqual (get baseline :failed) t)
            (js-call assert :strictEqual (get transported :failed) (get baseline :failed))
            (js-call assert :deepStrictEqual trace before)))
        (js-call assert :strictEqual test (get original :test))
        (let* ((prototype-reads 0)
               (foreign-prototype (new globalThis.Proxy (js-object)
                 (js-object :getPrototypeOf (lambda (target)
                   (setq prototype-reads (1+ prototype-reads)) (throw false)))))
               (source (Object/create foreign-prototype))
               (copy (snapshotManagedSourceView (view-of source))))
          (js-call assert :strictEqual (Reflect/getPrototypeOf copy) foreign-prototype)
          (js-call assert :strictEqual prototype-reads 0))
        (let ((value (js-object :identity t)))
          (js-call (expect value) :toBe value)
          (js-call (get (expect value) :not) :toBe (js-object))))))

  (test "authenticated snapshots preserve sparse storage every descriptor symbols negative zero alias and cycles"
    (lambda ()
      (let* ((symbol (funcall globalThis.Symbol "snapshot"))
             (array (js-array undefined -0.0 3))
             (array-view (view-of array))
             (source (js-object :observed array-view :alias array-view :absent undefined :zero -0.0))
             (view (view-of source)))
        (Reflect/deleteProperty array "2")
        (Object/defineProperty array symbol (js-object :value "symbol" :enumerable false :writable false :configurable t))
        (put source :self view)
        (let* ((copy (snapshotManagedSourceView view)) (child (get copy :observed)))
          (js-call assert :strictEqual (isManagedSourceView view) t)
          (js-call assert :notStrictEqual copy view)
          (js-call assert :strictEqual (get copy :self) copy)
          (js-call assert :strictEqual child (get copy :alias))
          (js-call assert :strictEqual (Array/isArray child) t)
          (js-call assert :strictEqual (get child :length) 3)
          (js-call assert :strictEqual (Object/hasOwn child "2") false)
          (js-call assert :strictEqual (Object/is (get copy :zero) -0.0) t)
          (js-call assert :strictEqual (Object/hasOwn copy "absent") t)
          (js-call assert :strictEqual (get copy :absent) undefined)
          (js-call assert :deepStrictEqual (Reflect/ownKeys child) (Reflect/ownKeys array-view))
          (js-call (Reflect/ownKeys array-view) :forEach (lambda (key)
            (js-call assert :deepStrictEqual (Reflect/getOwnPropertyDescriptor child key)
              (Reflect/getOwnPropertyDescriptor array-view key))))
          (js-call (expect view) :toMatchObject (js-object :observed array))
          (js-call (expect view) :toBe view)))))

  (test "the original matcher still rejects wrong array lengths values negative zero and holes"
    (lambda ()
      (let ((view (view-of (js-array 1 -0.0 3))))
        (js-call (expect view) :toMatchObject (js-array 1 -0.0 3))
        (js-call (get (expect view) :not) :toMatchObject (js-array 1 0 3))
        (js-call (js-array (js-array 1 -0.0) (js-array 1 -0.0 4) (js-array 1 0 3))
          :forEach (lambda (bad)
            (js-call assert :strictEqual
              (get (captured (lambda () (js-call (expect view) :toMatchObject bad))) :failed) t))))
      (let* ((sparse (new globalThis.Array 2)) (view (view-of sparse)))
        (put sparse 0 1)
        (js-call assert :strictEqual
          (get (captured (lambda () (js-call (expect view) :toMatchObject (js-array 1 undefined)))) :failed) t))))

  (test "snapshot array storage is defined before its custom prototype while final reflection retains the exact source graph"
    (lambda ()
      (let* ((prototype-data (Object/create (get globalThis.Array :prototype)))
             (prototype-view (view-of prototype-data))
             (symbol (funcall globalThis.Symbol "own metadata"))
             (array (js-array undefined -0.0 3))
             (_prototype (Object/setPrototypeOf array prototype-view))
             (_symbol (Object/defineProperty array symbol
               (js-object :value "retained" :writable false :enumerable false :configurable false)))
             (_length (Object/defineProperty array "length" (js-object :writable false)))
             (view (view-of array))
             (copy (snapshotManagedSourceView view))
             (copy-prototype (Reflect/getPrototypeOf copy)))
        (js-call assert :strictEqual (Array/isArray copy) t)
        (js-call assert :strictEqual (get copy :length) 3)
        (js-call assert :notStrictEqual copy-prototype prototype-view)
        (js-call assert :strictEqual (Reflect/getPrototypeOf copy-prototype) (get globalThis.Array :prototype))
        (js-call assert :strictEqual (Reflect/getPrototypeOf view) prototype-view)
        (js-call assert :deepStrictEqual (Reflect/ownKeys copy) (Reflect/ownKeys view))
        (js-call (Reflect/ownKeys view) :forEach (lambda (key)
          (js-call assert :deepStrictEqual (Reflect/getOwnPropertyDescriptor copy key)
            (Reflect/getOwnPropertyDescriptor view key))))
        (js-call (js-call original :expect copy) :toMatchObject (js-array undefined -0.0 3))
        (js-call (expect view) :toMatchObject (js-array undefined -0.0 3)))))

  (test "native array matcher controls distinguish indexing transitions from nonenumerable inherited unscopables"
    (lambda ()
      (let* ((standard (get globalThis.Array :prototype))
             (symbol (get globalThis.Symbol :unscopables))
             (descriptors (Object/getOwnPropertyDescriptors standard))
             (with-symbol (Object/create (Reflect/getPrototypeOf standard) descriptors))
             (without-symbol (Object/create (Reflect/getPrototypeOf standard) descriptors))
             (golden (js-array 1 2 3))
             (prototypes (js-array
               (js-object :name "standard" :value standard)
               (js-object :name "null" :value nil)
               (js-object :name "cloned-with-unscopables" :value with-symbol)
               (js-object :name "cloned-without-unscopables" :value without-symbol)))
             (outcomes (js-array)))
        (js-call assert :strictEqual (get (Reflect/getOwnPropertyDescriptor standard symbol) :enumerable) false)
        (js-call assert :strictEqual (Reflect/deleteProperty without-symbol symbol) t)
        (js-call (Reflect/ownKeys with-symbol) :forEach (lambda (key)
          (unless (eq key symbol)
            (js-call assert :deepStrictEqual (Reflect/getOwnPropertyDescriptor with-symbol key)
              (Reflect/getOwnPropertyDescriptor without-symbol key)))))
        (js-call (js-array "literal" "descriptor-transition") :forEach (lambda (construction)
          (js-call prototypes :forEach (lambda (prototype)
            (let* ((array (js-array 1 2 3))
                   (entry (Reflect/getOwnPropertyDescriptor array "0")))
              ;; Change indexed storage through a reversible descriptor path;
              ;; the final public descriptor is exactly the original one.
              ;; Record JSC's actual resulting class instead of asserting an
              ;; engine-internal transition that this fixture cannot promise.
              (when (= construction "descriptor-transition")
                (Object/defineProperty array "0" (js-object :writable false))
                (Object/defineProperty array "0" entry))
              (Object/setPrototypeOf array (get prototype :value))
              (js-call assert :strictEqual (Array/isArray array) t)
              (js-call assert :deepStrictEqual (Reflect/ownKeys array) (Reflect/ownKeys golden))
              (js-call (Reflect/ownKeys golden) :forEach (lambda (key)
                (js-call assert :deepStrictEqual (Reflect/getOwnPropertyDescriptor array key)
                  (Reflect/getOwnPropertyDescriptor golden key))))
              (let ((result (captured (lambda ()
                (js-call (js-call original :expect array) :toMatchObject golden)))))
                (js-call outcomes :push (js-object :construction construction
                  :prototype (get prototype :name) :matched (not (get result :failed))
                  :native (native-array-storage array)
                  :enumeration (native-prototype-enumeration array)))))))))
        (when (= (get (get globalThis.process :env) :ELISCRIPT_PROJECT_ALLOCATOR_DIAGNOSTIC) "1")
          (try
            (console/error "[managed-matcher-native-controls]" (JSON/stringify
              (js-object :golden (native-array-storage golden)
                :goldenEnumeration (native-prototype-enumeration golden) :outcomes outcomes)))
            (catch ignored nil)))
        ;; This new diagnostic records Bun's actual native contract: its
        ;; standard Array realm passes and the three unrelated chains do not.
        ;; The original real managed reports below still must match true.
        (js-call assert :strictEqual (js-length outcomes) 8)
        (js-call outcomes :forEach (lambda (row)
          (js-call assert :strictEqual (get row :matched) (= (get row :prototype) "standard")
            (+ (get row :construction) "/" (get row :prototype))))))))

  (defun host-array-instance-p (value)
    (Reflect/apply (get (get globalThis.Function :prototype) (get globalThis.Symbol :hasInstance))
      globalThis.Array (js-array value)))

  (defun check-matcher-realm (adapter actual)
    (let* ((array (get actual :observed))
           (array-prototype (Reflect/getPrototypeOf array))
           (object-prototype (Reflect/getPrototypeOf array-prototype))
           (before (js-call adapter :stats))
           (ordinary (snapshotManagedSourceView actual))
           (projection (projectManagedSourceViewForMatcher actual)))
      (js-call assert :strictEqual (isManagedSourceViewForRuntime array adapter) t)
      (js-call assert :strictEqual (isManagedSourceViewForRuntime array (js-object)) false)
      (js-call assert :strictEqual (isManagedSourceViewForRuntime (view-of (js-array)) adapter) false)
      (js-call assert :strictEqual (host-array-instance-p (get ordinary :observed)) false)
      (js-call assert :strictEqual (host-array-instance-p (get projection :observed)) t)
      (js-call assert :strictEqual (host-array-instance-p projection) false)
      (js-call assert :strictEqual (get projection :self) projection)
      (js-call assert :strictEqual (get projection :alias) (get projection :observed))
      (js-call assert :notStrictEqual (Reflect/getPrototypeOf
        (Reflect/getPrototypeOf (get projection :observed))) (Reflect/getPrototypeOf projection))
      (js-call assert :strictEqual (Reflect/getPrototypeOf array) array-prototype)
      (js-call assert :strictEqual (Reflect/getPrototypeOf array-prototype) object-prototype)
      (js-call assert :strictEqual (Reflect/getPrototypeOf object-prototype) nil)
      (let ((symbol (funcall globalThis.Symbol "matcher own"))
            (saved (Object/getOwnPropertyDescriptors array)))
        (try
          (progn
            (Object/defineProperty array "1" (js-object :value -0.0))
            (Reflect/deleteProperty array "2")
            (Object/defineProperty array symbol (js-object :value undefined :writable false :enumerable false :configurable t))
            (Object/defineProperty array "length" (js-object :writable t))
            (let* ((copy (projectManagedSourceViewForMatcher actual)) (child (get copy :observed)))
              (js-call assert :strictEqual (get child :length) 3)
              (js-call assert :strictEqual (Object/hasOwn child "2") false)
              (js-call assert :strictEqual (Object/is (get child "1") -0.0) t)
              (js-call assert :strictEqual (Object/hasOwn child symbol) t)
              (js-call assert :strictEqual (get child symbol) undefined)
              (js-call assert :strictEqual child (get copy :alias))
              (js-call assert :strictEqual (get copy :self) copy)
              (js-call (Reflect/ownKeys array) :forEach (lambda (key)
                (js-call assert :deepStrictEqual (Reflect/getOwnPropertyDescriptor child key)
                  (Reflect/getOwnPropertyDescriptor array key))))))
          (finally
            (Reflect/deleteProperty array symbol)
            (Object/defineProperties array saved))))
      (let ((key "__matcher_inherited__"))
        (try
          (progn
            (Object/defineProperty object-prototype key
              (js-object :value 17 :writable t :enumerable t :configurable t))
            (let* ((copy (projectManagedSourceViewForMatcher actual))
                   (child (get copy :observed)))
              (js-call assert :strictEqual (get copy key) 17)
              (js-call assert :strictEqual (get child key) 17)
              (js-call assert :strictEqual (Object/hasOwn copy key) false)
              (js-call assert :strictEqual (Object/hasOwn child key) false)
              (js-call assert :strictEqual (host-array-instance-p copy) false)
              (js-call assert :deepStrictEqual
                (Reflect/getOwnPropertyDescriptor (Reflect/getPrototypeOf copy) key)
                (Reflect/getOwnPropertyDescriptor object-prototype key))))
          (finally (Reflect/deleteProperty object-prototype key))))
      (let ((key "__matcher_host_pollution__"))
        (try
          (progn
            (Object/defineProperty (get globalThis.Array :prototype) key
              (js-object :value 71 :enumerable t :configurable t))
            (let* ((copy (projectManagedSourceViewForMatcher actual)) (child (get copy :observed)))
              (js-call assert :strictEqual (host-array-instance-p child) false)
              (js-call assert :strictEqual (Reflect/has child key) false)))
          (finally (Reflect/deleteProperty (get globalThis.Array :prototype) key))))
      (let* ((custom-token (js-call adapter :sourceObject (js-object)))
             (custom (js-call adapter :toHostValue custom-token)))
        (try
          (progn
            (Object/setPrototypeOf array custom)
            (js-call assert :strictEqual (Reflect/getPrototypeOf array) custom)
            (js-call assert :strictEqual (host-array-instance-p
              (get (projectManagedSourceViewForMatcher actual) :observed)) false)
            (Object/setPrototypeOf array nil)
            ;; Check the public runtime view before either transport. Explicit
            ;; null must not be mistaken for an untouched default Array edge.
            (js-call assert :strictEqual (Reflect/getPrototypeOf array) nil)
            (js-call assert :strictEqual (Reflect/has array "toString") false)
            (js-call assert :strictEqual (get array :toString) undefined)
            (js-call assert :strictEqual (Reflect/getPrototypeOf
              (get (snapshotManagedSourceView actual) :observed)) nil)
            (js-call assert :strictEqual (Reflect/getPrototypeOf
              (get (projectManagedSourceViewForMatcher actual) :observed)) nil)
            (js-call adapter :collect)
            (js-call assert :strictEqual (Reflect/getPrototypeOf array) nil)
            (js-call assert :strictEqual (Reflect/getPrototypeOf array-prototype) object-prototype)
            (js-call assert :strictEqual (Reflect/getPrototypeOf
              (get (snapshotManagedSourceView actual) :observed)) nil)
            (let ((copy (projectManagedSourceViewForMatcher actual)))
              (js-call assert :strictEqual (Reflect/getPrototypeOf (get copy :observed)) nil)
              (js-call assert :strictEqual (get copy :alias) (get copy :observed))
              (js-call assert :strictEqual (get copy :self) copy)
              (js-call assert :deepStrictEqual (Reflect/ownKeys (get copy :observed)) (Reflect/ownKeys array))
              (js-call (Reflect/ownKeys array) :forEach (lambda (key)
                (js-call assert :deepStrictEqual (Reflect/getOwnPropertyDescriptor (get copy :observed) key)
                  (Reflect/getOwnPropertyDescriptor array key))))))
          (finally
            (Object/setPrototypeOf array array-prototype)
            (js-call adapter :release custom-token))))
      (js-call assert :strictEqual (Reflect/getPrototypeOf array) array-prototype)
      (let ((zero (js-call adapter :number -0.0)) (token undefined))
        (try
          (progn
            (setq token (js-call adapter :sourceArray (js-array undefined zero undefined)))
            (let ((view (js-call adapter :toHostValue token)))
              (Reflect/deleteProperty view "2")
              (Object/defineProperty view "length" (js-object :writable false))
              (let ((copy (projectManagedSourceViewForMatcher view)))
                (js-call assert :strictEqual (get copy :length) 3)
                (js-call assert :strictEqual (Object/is (get copy "1") -0.0) t)
                (js-call assert :strictEqual (Object/hasOwn copy "0") t)
                (js-call assert :strictEqual (Object/hasOwn copy "2") false)
                (js-call assert :deepStrictEqual (Reflect/getOwnPropertyDescriptor copy "length")
                  (Reflect/getOwnPropertyDescriptor view "length")))))
          (finally
            (unless (undefined? token) (js-call adapter :release token))
            (js-call adapter :release zero))))
      (let* ((spoof (js-array 1 2 3))
             (prototype (Object/create nil (js-object :constructor
               (js-object :value globalThis.Array :enumerable false :configurable t)))))
        (Object/setPrototypeOf spoof prototype)
        (js-call assert :strictEqual (projectManagedSourceViewForMatcher spoof) spoof)
        (js-call assert :strictEqual (isManagedSourceViewForRuntime spoof adapter) false)
        (let* ((view (view-of spoof)) (copy (projectManagedSourceViewForMatcher view)))
          (js-call assert :strictEqual (Reflect/getPrototypeOf copy) prototype)
          (js-call assert :strictEqual (host-array-instance-p copy) false))
        (Object/setPrototypeOf spoof nil)
        (js-call assert :strictEqual (Reflect/getPrototypeOf
          (projectManagedSourceViewForMatcher (view-of spoof))) nil))
      (let ((functions (js-array "getterFalse" "getterUndefined"))
            (failures (js-array false undefined)) (index 0))
        (while (< index (js-length functions))
          (let ((token (js-call adapter :getExport (aref functions index))))
            (try
              (progn
                (Object/defineProperty array-prototype "__matcher_getter__"
                  (js-object :get (js-call adapter :toHostValue token) :enumerable t :configurable t))
                (let* ((copy (projectManagedSourceViewForMatcher actual))
                       (outcome (captured (lambda () (get (get copy :observed) "__matcher_getter__")))))
                  (js-call assert :strictEqual (get outcome :failed) t)
                  (js-call assert :strictEqual (get outcome :error) (aref failures index))))
              (finally
                (Reflect/deleteProperty array-prototype "__matcher_getter__")
                (js-call adapter :release token))))
          (setq index (1+ index))))
      (js-call adapter :collect)
      (let ((live (js-call adapter :live)) (iteration 0))
        (while (< iteration 3)
          (projectManagedSourceViewForMatcher actual)
          (js-call adapter :collect)
          (js-call assert :strictEqual (js-call adapter :live) live)
          (setq iteration (1+ iteration))))
      (js-call assert :strictEqual (get (js-call adapter :stats) :frameDepth) (get before :frameDepth))
      (js-call assert :strictEqual (host-array-instance-p
        (get (projectManagedSourceViewForMatcher actual) :observed)) t)))

  (test "accessor snapshots are lazy preserve the original receiver and propagate false and undefined without mutation"
    (lambda ()
      (let ((failures (js-array false undefined)) (index 0))
        (while (< index (js-length failures))
          (let* ((failure (aref failures index)) (reads 0) (calls 0)
                 (source (js-object)) (view undefined))
            (Object/defineProperty source "value" (js-object :enumerable t :configurable t
              :get (lambda () (setq reads (1+ reads)) (throw failure))))
            (setq view (view-of source (js-object :get (lambda (key receiver)
              (js-call assert :strictEqual receiver view)
              (setq calls (1+ calls)) (Reflect/get source key source)))))
            (let ((descriptor (Reflect/getOwnPropertyDescriptor view "value"))
                  (copy (snapshotManagedSourceView view)))
              (js-call assert :strictEqual reads 0)
              (js-call assert :strictEqual calls 0)
              (js-call assert :strictEqual (get (Reflect/getOwnPropertyDescriptor copy "value") :enumerable) t)
              (js-call assert :strictEqual (get (Reflect/getOwnPropertyDescriptor copy "value") :configurable) t)
              (let ((result (captured (lambda () (get copy :value)))))
                (js-call assert :strictEqual (get result :failed) t)
                (js-call assert :strictEqual (get result :error) failure))
              (js-call assert :strictEqual reads 1)
              (js-call assert :strictEqual calls 1)
              (js-call assert :strictEqual (get (Reflect/getOwnPropertyDescriptor view "value") :get) (get descriptor :get)))
            (let ((result (captured (lambda () (js-call (expect view) :toMatchObject (js-object :value 1))))))
              (js-call assert :strictEqual (get result :failed) t)
              (js-call assert :strictEqual (get result :error) failure)))
          (setq index (1+ index))))))

  (test "real WASM and native owned report views retain exact fields and descriptors before the unchanged Bun matcher"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-matchers-"))))
             (backend undefined) (runtime-ir undefined) (adapter undefined) (handle undefined)
             (graph undefined) (failed false))
        (try
          (progn
            (setq backend (await (buildBackends (js-object :outputRoot (resolve directory "backend")))))
            (setq runtime-ir (js-call (get backend :compiler) :compile_ir_string
              (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
            (let* ((program (js-call (get backend :compiler) :compile_ir_string
                     "(defconst observed (js-array 1 2 3)) (defconst report (js-object :answer 42 :observed observed :alias observed :missing undefined :zero -0.0)) (put report :self report) (defun getterFalse () (throw false)) (defun getterUndefined () (throw undefined)) (defun makeReport () (js-object :observed (js-array 1 2 3))) (export report getterFalse getterUndefined makeReport)"
                     "matcher-owned.eli"))
                   (before (JSON/stringify program))
                   ;; Keep the original owned program's zero-import contract
                   ;; separately. The new reflection mutations pass genuine
                   ;; host descriptor objects through this same program's
                   ;; public source views, which requires foreign entry.
                   (owned-lowered (js-call (get backend :managed) :lower_managed_project
                     (js-array (js-object :id "main.mjs" :program program)) "main.mjs" runtime-ir (js-object :phased t)))
                   (owned-image (globalThis.Uint8Array.from
