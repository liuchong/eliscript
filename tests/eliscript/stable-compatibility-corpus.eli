(module tests.stable-compatibility-corpus
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve dirname)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/compatibility/corpus.mjs" checkStableCompatibilityCorpus StableCompatibilityCorpusError validateStableCompatibilityCorpus)
  (defasync contract ()
    (JSON/parse (await (readFile (resolve root "contracts/stable-compatibility-corpus.json") "utf8"))))
  (defasync validation-errors (value)
    (try
      (await (validateStableCompatibilityCorpus value (js-object :root root)))
      (throw (new globalThis.Error "expected stable compatibility corpus validation to fail"))
      (catch error
        (js-call (expect error) :toBeInstanceOf StableCompatibilityCorpusError)
        (get error :errors))))
  (test "stable compatibility corpus covers every frozen core behavior"
    (async ()
      (let* ((value (await (contract)))
             (git (spawnSync "git" (js-array "ls-files" "-z" "--" "tests/fixtures")
                    (js-object :cwd root :encoding "utf8")))
             (manifest (JSON/parse (await (readFile (resolve root "tests/conformance/manifest.json") "utf8"))))
             (index (JSON/parse (await (readFile (resolve root "specs/index.json") "utf8"))))
             (rehearsal (JSON/parse (await (readFile (resolve root "contracts/compatibility-rehearsal.json") "utf8"))))
             (source-files (new globalThis.Set (js-array
               "Makefile" "contracts/compatibility-baseline.json" "contracts/compatibility-rehearsal.json"
               "contracts/maturity-progress.json" "specs/0147-complete-stable-compatibility-corpus.md"
               "specs/index.json" "tests/conformance/manifest.json" "tests/stable-compatibility-corpus.test.mjs"
               "tools/compatibility/corpus.mjs")))
             (features (new globalThis.Set (get value :stableCoreFeatureIds)))
             (evidence-files (new globalThis.Set)))
        (js-call (expect (get git :error)) :toBe undefined)
        (js-call (expect (get git :status)) :toBe 0)
        ;; Compare every maintained fixture identity, independently of the
        ;; corpus generator. Staged migrations change paths, never coverage.
        (js-call (expect (get value :deferredFixtures)) :toEqual (js-array))
        (js-call (expect (get value :fixtureFiles)) :toEqual
          (js-call (js-call (js-call (get git :stdout) :split "\u0000") :filter globalThis.Boolean) :sort))
        (js-call (get value :fixtureFiles) :forEach (lambda (file) (js-call source-files :add file)))
        (js-call (get rehearsal :sourceFiles) :forEach (lambda (file) (js-call source-files :add file)))
        (js-call (get index :specifications) :forEach (lambda (specification)
          (when (js-call (get value :stableCoreSpecificationIds) :includes (get specification :id))
            (js-call source-files :add (get specification :file)))))
        (js-call (get manifest :features) :forEach (lambda (feature)
          (when (js-call features :has (get feature :id))
            (js-call (get feature :evidence) :forEach (lambda (locator)
              (js-call source-files :add (get locator :file)) (js-call evidence-files :add (get locator :file)))))))
        ;; A migrated emitted test still binds its real Eli source through the
        ;; compiler's source map, rather than treating generated bytes as the
        ;; maintained source or silently dropping that evidence coordinate.
        (let* ((bootstrap (await (readFile (resolve root "tools/backends/bootstrap.el") "utf8")))
               (pairs (new globalThis.RegExp "\\(\"([^\"]+\\.eli)\" \\. \"([^\"]+\\.mjs)\"\\)" "g"))
               (match (js-call pairs :exec bootstrap)) (mapped (new globalThis.Set)))
          (while match
            (let ((source (aref match 1)) (output (aref match 2)))
              (when (js-call source-files :has output)
                (let* ((map (JSON/parse (await (readFile (resolve root (str output ".map")) "utf8"))))
                       (position (js-call (get map :sources) :findIndex (lambda (mapped-source)
                         (= (resolve root (dirname output) (get map :sourceRoot "") mapped-source)
                            (resolve root source))))))
                  (js-call (expect position) :toBeGreaterThanOrEqual 0)
                  (js-call (expect (aref (get map :sourcesContent) position)) :toBe
                    (await (readFile (resolve root source) "utf8")))
                  (js-call mapped :add source))))
            (setq match (js-call pairs :exec bootstrap)))
          (js-call (expect (js-call mapped :has "tests/eliscript/stable-compatibility-corpus.eli")) :toBe t))
        (js-call (expect (await (checkStableCompatibilityCorpus (js-object :root root)))) :toEqual
          (js-object :schemaVersion 1 :stableSpecifications 173 :stableFeatures 173
            :provisionalFeatures 1 :excludedApplicationFeatures 2 :migrations 3
            :fixtures (js-length (get value :fixtureFiles)) :evidenceLocators 682 :evidenceFiles 136
            :sourceFiles (get source-files :size) :readyForAc02 false
            :identity (js-call expect :stringMatching (new globalThis.RegExp "^[0-9a-f]{64}$" "u"))))
        (js-call (expect (get evidence-files :size)) :toBe 136))
      (let ((fixtures (get (await (contract)) :fixtureFiles)))
        (js-call (js-array "compiler-internal-order-oracle.el"
          "wasm-managed-catch-destructuring.eli" "wasm-managed-exceptions.eli"
          "wasm-managed-symbols.eli" "wasm-managed-text.eli" "wasm-managed-tables.eli"
          "wasm-managed-control.eli" "wasm-managed-empty-bindings.eli"
          "wasm-managed-callables.eli" "wasm-managed-variadic-calls.eli"
          "wasm-managed-array-callbacks.eli" "wasm-managed-array-text.eli"
          "wasm-managed-typeof.eli" "wasm-managed-behavior.json"
          "wasm-managed-module-bindings.eli" "wasm-managed-project-state.eli"
          "wasm-managed-project-entry.eli" "wasm-managed-arithmetic.eli"
          "wasm-managed-word.eli" "wasm-managed-arrays.eli" "wasm-managed-objects.eli"
          "wasm-managed-strings.eli" "wasm-managed-replacement.eli" "wasm-managed-regexp.eli"
          "wasm-managed-builtins.eli" "wasm-managed-json.eli" "wasm-managed-js-cons.eli"
          "wasm-managed-persistent-vector.eli" "wasm-managed-number-conversion.eli"
          "wasm-managed-primitive-operators.eli" "wasm-managed-source-collections.eli"
          "regexp-property-original-trie.eli" "wasm-managed-json-callbacks.eli"
          "wasm-managed-math-transcendental.eli" "wasm-managed-regexp-indices.eli"
          "wasm-managed-regexp-property-data.eli" "wasm-managed-regexp-unicode-sets.eli"
          "wasm-managed-core-modules.eli" "wasm-managed-sequence-data.eli"
          "wasm-managed-sorted.eli" "wasm-managed-transient-state.eli" "wasm-managed-wire.eli")
          :forEach (lambda (fixture)
            (js-call (expect fixtures) :toContain (str "tests/fixtures/" fixture)))))))
  (test "stable compatibility corpus rejects omitted behavior and migrations"
    (async ()
      (let ((value (await (contract))))
        (js-call (get value :stableCoreFeatureIds) :pop)
        (js-call (get value :migrationIds) :pop)
        (let ((errors (await (validation-errors value))))
          (js-call (expect errors) :toContain "stableCoreFeatureIds must match the complete derived stable core inventory")
          (js-call (expect errors) :toContain "migrationIds must match the complete derived stable core inventory")))))
  (test "stable compatibility corpus rejects false AC-02 readiness and fixture drift"
    (async ()
      (let ((value (await (contract))))
        (put value :readyForAc02 t)
        (js-call (get value :fixtureFiles) :pop)
        (put value :identity (js-call "0" :repeat 64))
        (let ((errors (await (validation-errors value))))
          (js-call (expect errors) :toContain "readyForAc02 must match the complete derived stable core inventory")
          (js-call (expect errors) :toContain "fixtureFiles must match the complete derived stable core inventory")
          (js-call (expect errors) :toContain "identity must bind the complete stable compatibility corpus")))))
)
