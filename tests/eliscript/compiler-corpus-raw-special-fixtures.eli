(module tests.compiler-corpus-raw-special-fixtures
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir mkdtemp readFile writeFile rm)
  (import "node:path" resolve)
  (import "node:module" createRequire)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/compiler-corpus-raw-special-fixtures.mjs" runOriginalRawSpecialFixtureHost)
  (import "../tools/backends/compiler-corpus-raw-fixture-observer.mjs" raw-scope)
  (defun vector-runtime (wrong)
    (let ((calls (js-array)) (released (js-array)) (collections 0))
      (js-object :calls calls :released released
        :number (lambda (value) (js-object :kind 4 :value value))
        :readNumber (lambda (value) (get value :value))
        :invoke (lambda (name args)
          (js-call assert :strictEqual name "vector-case")
          (let ((count (get (aref args 0) :value)))
            (js-call calls :push count)
            (js-object :kind 14 :values (js-array (js-object :kind 4 :value (+ count (if wrong 1 0)))))))
        :length (lambda (value) (js-length (get value :values)))
        :get (lambda (value index) (aref (get value :values) index))
        :release (lambda (value) (js-call released :push value))
        :collect (lambda () (setq collections (1+ collections)))
        :stats (lambda () (js-object :frameDepth 0))
        :collectionCount (lambda () collections))))
  (test "raw persistent-vector observations retain every original boundary and collection mode"
    (lambda ()
      (js-call (js-array "persistent-vector-auto-1" "persistent-vector-auto-65536") :forEach
        (lambda (family)
          (let* ((runtime (vector-runtime false))
                 (counts (if (= family "persistent-vector-auto-1") (js-array 33)
                   (js-array 0 1 31 32 33 63 64 65 1023 1024 1025 1056 1057)))
                 (result (runOriginalRawSpecialFixtureHost (js-object :family family :runtime runtime
                   :oracle (js-object :vector_case (lambda (count) (js-array count)))))))
            (js-call assert :deepStrictEqual (get runtime :calls) counts)
            (js-call assert :strictEqual (get result :observations) (js-length counts))
            (js-call assert :strictEqual (js-length (Object/keys (get result :groups))) (js-length counts))
            (js-call counts :forEach (lambda (count)
              (js-call assert :strictEqual (get (get result :groups)
                (if (= family "persistent-vector-auto-1") "collecting persistent Vector callbacks"
                  (str "full persistent Vector boundaries " count))) 1)))
            (js-call assert :strictEqual (js-call runtime :collectionCount) (js-length counts))
            (js-call assert :strictEqual (js-length (get runtime :released)) (* 3 (js-length counts))))))))
  (test "raw fixture mismatches fail without abandoning caller-owned roots"
    (lambda ()
      (let ((runtime (vector-runtime t)))
        (js-call assert :throws (lambda ()
          (runOriginalRawSpecialFixtureHost (js-object :family "persistent-vector-auto-1" :runtime runtime
            :oracle (js-object :vector_case (lambda (count) (js-array count))))))
          (lambda (error)
            (js-call assert :deepStrictEqual (get error :originalRawFixture)
              (js-object :family "persistent-vector-auto-1" :label "collecting persistent Vector callbacks" :completedObservations 0))
            (js-call assert :strictEqual (get error :name) "AssertionError") t))
        (js-call assert :strictEqual (js-call runtime :collectionCount) 1)
        (js-call assert :strictEqual (js-length (get runtime :released)) 3))))
  (test "raw special observation failure retains the original identity when owned cleanup also fails"
    (lambda ()
      (let* ((runtime (vector-runtime false)) (marker (new globalThis.Error "original special observation"))
             (cleanup (new globalThis.Error "owned special cleanup")))
        (put runtime :collect (lambda () (throw cleanup)))
        (js-call assert :throws (lambda ()
          (runOriginalRawSpecialFixtureHost (js-object :family "persistent-vector-auto-1" :runtime runtime
            :oracle (js-object :vector_case (lambda (count) (throw marker))))))
          (lambda (error) (js-call assert :strictEqual error marker)
            (js-call assert :deepStrictEqual (get error :originalRawFixture)
              (js-object :family "persistent-vector-auto-1" :label "collecting persistent Vector callbacks" :completedObservations 0)) t))
        (js-call assert :strictEqual (js-length (get runtime :released)) 3))))
  (test "unknown raw special families fail instead of reporting empty coverage"
    (lambda ()
      (js-call assert :throws (lambda ()
        (runOriginalRawSpecialFixtureHost (js-object :family "unknown" :runtime (vector-runtime false) :oracle (js-object))))
        globalThis.TypeError)))
  (test "object properties use the complete portable recipe and retain zero imports and final ownership"
    (async ()
      (let ((parent (resolve root "_worktree/evidence/raw-properties-tests")))
        (await (mkdir parent (js-object :recursive t)))
        (let ((directory (await (mkdtemp (resolve parent "case-")))))
          (try
            (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
                   (compiler (get backend :compiler))
                   (filename "tests/fixtures/wasm-managed-object-properties.eli")
                   (program (js-call compiler :compile_ir_string (await (readFile (resolve root filename) "utf8")) filename))
                   (memory (js-call compiler :compile_ir_string
                     (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
                   (bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program memory)))
                   (reference (resolve directory "reference.mjs")))
              (await (writeFile reference (js-call compiler :emit_ir_string program)))
              (js-call assert :deepStrictEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
              (let ((oracle (funcall (createRequire reference) reference)))
                (js-call (js-array 1 65536) :forEach (lambda (auto)
                  (let ((runtime (instantiateManagedRuntime bytes)))
                    (js-call runtime :auto auto)
                    (try
                      ;; The original pure product has no foreign-object bridge.
                      ;; Freezing a source view must encode its descriptor as
                      ;; source data, retaining exact fields and no new imports.
                      (let* ((scope (raw-scope runtime "object-properties"))
                             (value (js-call scope :object (js-object :x 7)))
                             (view (js-call runtime :toHostValue value))
                             (getter (js-call runtime :toHostValue (js-call scope :export "map"))))
                        (try
                          (Object/defineProperty view "accessor"
                            (js-object :get getter :enumerable false :configurable t))
                          (Object/freeze view)
                          (js-call assert :strictEqual (Object/isFrozen view) t)
                          (js-call assert :deepStrictEqual (Object/getOwnPropertyDescriptor view "x")
                            (js-object :value 7 :writable false :enumerable t :configurable false))
                          (js-call assert :deepStrictEqual (Object/getOwnPropertyDescriptor view "accessor")
                            (js-object :get getter :set undefined :enumerable false :configurable false))
                          (js-call assert :strictEqual (js-call scope :value "member" value (js-call scope :box "x")) 7)
                          (finally (js-call scope :close))))
                      (let ((result (runOriginalRawSpecialFixtureHost
                        (js-object :family "object-properties"
                          :runtime (Object/defineProperties (Object/create runtime)
                            (Object/fromEntries (js-call (js-array "objectSet" "tableSet" "tableAdd") :map
                              (lambda (name) (js-array name
                                (js-object :value (lambda (&rest ignored)
                                  (throw (new globalThis.Error "source collections require the original fixture operations")))
                                  :enumerable t :configurable t :writable t))))))
                          :oracle oracle))))
                        (js-call assert :strictEqual (get result :observations) 16)
                        (js-call assert :deepStrictEqual (Object/entries (get result :groups))
                          (js-array (js-array "identities and integer order" 1) (js-array "keys/hasOwn" 8)
                            (js-array "assign own properties" 5) (js-array "frozen target" 1) (js-array "own proto assignment" 1))))
                      (finally (js-call runtime :closeModule) (js-call runtime :collect)))
                    (js-call assert :strictEqual (js-call runtime :live) 0)
                    (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))))))
            (finally (await (rm directory (js-object :recursive t :force t)))))))))
)
