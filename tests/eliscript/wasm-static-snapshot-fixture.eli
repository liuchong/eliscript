(module tests.wasm-static-snapshot-fixture
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/compiler/controlled-baseline.mjs" definition)
  (import "../tools/testing/wasm-static-snapshot.mjs" staticSnapshotSource adaptStaticSnapshotCompiler)
  (test "the static-data private fixture retains every original definition and includes both actual unary dependencies"
    (lambda ()
      (let* ((source (readFileSync (resolve root "bootstrap/backends/wasm.eli") "utf8"))
             (url (get (pathToFileURL (resolve root "dist/fixture/backends/numeric.mjs")) :href))
             (before (staticSnapshotSource source url false)) (after (staticSnapshotSource source url t)))
        (js-call assert :ok (js-call before :startsWith (str "(module wasm.snapshot\n(import " (JSON/stringify url) " backend-fail)\n")))
        (js-call (js-array "require-memory-data-copy" "require-wasm-expression-node" "copy-wasm-expression-node"
          "same-wasm-expression-snapshot" "intern-wasm-expression" "copy-wasm-expression"
          "make-wasm-validation-workspace" "validate-fresh-wasm-expression" "validate-fresh-typed-wasm-program") :forEach
          (lambda (name)
            (let ((original (definition source (str name " "))))
              (js-call assert :ok (js-call before :includes original))
              (js-call assert :ok (js-call after :includes original)))))
        (js-call (js-array "memory-f64-unary-opcode" "require-memory-f64-unary") :forEach
          (lambda (name)
            (js-call assert :strictEqual (js-call before :includes (str "(defun " name " ")) false)
            (js-call assert :ok (js-call after :includes (definition source (str name " ")))))))))
  (test "only the exact original static fixture input is adapted while all ordinary compiler methods arguments and failures retain their identity"
    (lambda ()
      (let* ((source (readFileSync (resolve root "bootstrap/backends/wasm.eli") "utf8"))
             (directory (resolve root "dist/fixture"))
             (url (get (pathToFileURL (resolve directory "backends/numeric.mjs")) :href))
             (calls (js-array)) (marker (js-object :sentinel t))
             (compile (lambda (&rest arguments) (js-call calls :push arguments) marker))
             (compiler (js-object :compile_string compile :compile_ir_string marker))
             (facade (adaptStaticSnapshotCompiler compiler directory)))
        (js-call assert :strictEqual (get facade :compile_ir_string) marker)
        (js-call assert :strictEqual (js-call facade :compile_string "ordinary" "user.eli" false undefined) marker)
        (js-call assert :deepStrictEqual (aref calls 0) (js-array "ordinary" "user.eli" false undefined))
        (js-call assert :strictEqual (js-call facade :compile_string (staticSnapshotSource source url false) "wasm-snapshot.eli" marker) marker)
        (js-call assert :deepStrictEqual (aref calls 1) (js-array (staticSnapshotSource source url t) "wasm-snapshot.eli" marker))
        (js-call assert :throws (lambda () (js-call facade :compile_string "tampered" "wasm-snapshot.eli"))
          (lambda (error) (= (get error :code) "ERR_ASSERTION")))
        (js-call assert :strictEqual (js-length calls) 2)
        (js-call assert :strictEqual (get compiler :compile_string) compile)
        (let* ((failure (js-object :firstError t))
               (broken (adaptStaticSnapshotCompiler (js-object :compile_string (lambda (&rest arguments) (throw failure))) directory)))
          (js-call assert :throws (lambda () (js-call broken :compile_string "ordinary" "user.eli"))
            (lambda (error) (eq error failure))))))))
