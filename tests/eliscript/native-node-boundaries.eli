(module tests.native-node-boundaries
  (import "node:assert/strict" :default assert)
  (import "../../tools/backends/native-memory.mjs" openNativeMemory)
  (defasync main ()
    (let* ((arguments (get globalThis.process :argv)) (library (aref arguments 2))
           (signatures (JSON/parse (aref arguments 3))) (configuration (JSON/parse (aref arguments 4)))
           (a (await (openNativeMemory library signatures (Object/assign (js-object) configuration (js-object :hostCall (lambda () 0)))))))
      (js-call assert :strictEqual (get (get globalThis.process :versions) :bun) undefined)
      (try
        (js-call (js-array undefined nil false (js-object) "1" (globalThis.BigInt 1) globalThis.NaN globalThis.Infinity -1 0.5 4294967296) :forEach
          (lambda (bad) (js-call assert :throws (lambda () (js-call a :invoke "read32" bad)) globalThis.RangeError)))
        (js-call assert :throws (lambda () (js-call a :invoke (globalThis.Symbol "missing"))) globalThis.TypeError)
        (js-call assert :throws (lambda () (js-call a :invoke "missing")) globalThis.TypeError)
        (js-call assert :throws (lambda () (js-call a :invoke "read32")) globalThis.TypeError)
        (js-call assert :throws (lambda () (js-call a :invoke "read32" 0 1)) globalThis.TypeError)
        (js-call (js-array undefined nil "0" globalThis.NaN globalThis.Infinity -1 0.5 (globalThis.BigInt 1)) :forEach (lambda (bad)
          (js-call assert :throws (lambda () (js-call a :read bad 1)) globalThis.RangeError)
          (unless (undefined? bad) (js-call assert :throws (lambda () (js-call a :write (globalThis.Uint8Array.of 1) bad)) globalThis.RangeError))))
        (js-call assert :strictEqual (js-call a :write (globalThis.Uint8Array.of 1)) undefined)
        (js-call assert :deepStrictEqual (js-call a :read 0 1) (globalThis.Uint8Array.of 1))
        (js-call assert :strictEqual (js-call a :write (globalThis.Uint8Array.of 2) undefined) undefined)
        (js-call assert :deepStrictEqual (js-call a :read 0 1) (globalThis.Uint8Array.of 2))
        (js-call assert :strictEqual (js-call a :write (globalThis.Uint8Array.of 3) 0) undefined)
        (js-call assert :deepStrictEqual (js-call a :read 0 1) (globalThis.Uint8Array.of 3))
        (js-call assert :throws (lambda () (js-call a :write (js-array))) globalThis.TypeError)
        (js-call assert :throws (lambda () (js-call a :read 65535 2)) globalThis.RangeError)
        (js-call assert :throws (lambda () (js-call a :invoke "read32" 65535)) globalThis.WebAssembly.RuntimeError)
        (js-call assert :strictEqual (js-call a :invoke "write32" 0 42) 0)
        (js-call assert :strictEqual (js-call a :invoke "read32" 0) 42)
        (finally (js-call a :close)))
      (await (js-call assert :rejects (openNativeMemory library signatures (Object/assign (js-object) configuration
        (js-object :hostCall (lambda () 0) :bunExecutable (str library ".missing-runtime"))))
        (lambda (error) (= (get error :code) "ENOENT"))))
      (js-call (get globalThis.process :stdout) :write "native-node-verified\n")))
  (js-call (main) :catch (lambda (error) (console/error error) (put globalThis.process :exitCode 1))))
