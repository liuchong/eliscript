(module tests.direct-wasm-affected
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile readdir mkdir writeFile)
  (import "node:path" resolve relative dirname posix)
  (import "node:module" createRequire)
  (import "node:child_process" execFile)
  (import "node:util" promisify)
  (import "../../tools/backends/build.mjs" buildBackends root)
  (import "../../tools/testing/fixture-environment.mjs" prepareFixtureEnvironment)
  (import "./managed-browser-transport.mjs" writeManagedReference bundleManagedBrowserPage serveManagedBrowserPage)
  (import "./managed-stdlib-corpus.mjs" inputs parseCases encodeInputs)
  (import "playwright-core" chromium firefox webkit)
  (defconst require-module (createRequire (resolve root "tests/direct-wasm-backend.test.mjs")))
  (defconst execute (promisify execFile))
  (defvar preparing undefined)
  (defasync seed (input output environment)
    (await (funcall execute (resolve root "bin/eliscript-seed") (js-array "--output" output input)
      (js-object :encoding "utf8" :timeout 30000 :env environment)))
    (await (readFile output "utf8")))
  (defasync bundle-reference (file)
    (let ((result (await (js-call globalThis.Bun :build
            (js-object :entrypoints (js-array file) :target "browser" :format "esm"
              :plugins (js-array (js-object :name "direct-public-seed-module-bytes" :setup (lambda (builder)
                ;; Original module IDs retain .eli; the files contain the
                ;; independently emitted public Seed JavaScript, not sources.
                (js-call builder :onLoad (js-object :filter (new globalThis.RegExp "[.]eli$"))
                  (async (request)
                    (let ((path (get request :path)))
                      (js-call assert :ok (not (js-call (relative (dirname file) path) :startsWith "..")))
                      (js-object :contents (await (readFile path "utf8")) :loader "js" :resolveDir (dirname path)))))))))))))
      (js-call assert :strictEqual (get result :success) t (funcall globalThis.String (get result :logs)))
      (await (js-call (aref (get result :outputs) 0) :text))))
  (defasync load-stdlib (state fixture loaded id input)
    (unless (js-call loaded :has id)
      (js-call loaded :add id)
      (let* ((source (await (readFile input "utf8")))
             (compiler (get (aref (get state :generations) 2) :compiler))
             (program (js-call compiler :compile_ir_string source id))
             (javascript (await (seed input (resolve (get state :directory)
               (str "stdlib-" (js-call id :replaceAll "/" "-") ".mjs")) (get state :environment)))))
        (js-call (get fixture :modules) :push (js-object :id id :filename id :source source :javascript javascript))
        (let ((pending (js-array)))
          (letfn ((imports (nodes)
                    (js-call nodes :forEach (lambda (node)
                      (when (= (get node :kind) "import-declaration")
                        (let ((target (js-call posix :normalize (js-call posix :join (js-call posix :dirname id) (get node :value)))))
                          (js-call assert :ok (js-call target :startsWith "stdlib/"))
                          (js-call pending :push target)))
                      (imports (get node :children (js-array)))))))
            (imports (get program :body)))
          (let ((index 0))
            (while (< index (js-length pending))
              (let ((target (aref pending index)))
                (await (load-stdlib state fixture loaded target (resolve root target))))
              (setq index (1+ index))))))))
  (defasync prepare-direct ()
    (let* ((scratch (prepareFixtureEnvironment root (get globalThis.process :env)))
           (directory (get scratch :directory)) (environment (get scratch :environment))
           (generations (js-array))
           (state (js-object :scratch scratch :directory directory :environment environment
             :generations generations :inputs inputs :parseCases parseCases :encodeInputs encodeInputs)))
      (try
        (js-call generations :push (await (buildBackends (js-object :outputRoot (resolve directory "g1") :seed t))))
        (let ((core (js-call (js-call (await (readdir (resolve root "bootstrap/compiler"))) :filter
                      (lambda (name) (js-call name :endsWith ".eli"))) :sort)) (index 2))
          (while (<= index 3)
            (let* ((output-root (resolve directory (str "g" index))) (output (resolve output-root "bootstrap"))
                   (previous (get (js-call generations :at -1) :compiler)))
              (await (mkdir output (js-object :recursive t)))
              (let ((file-index 0))
                (while (< file-index (js-length core))
                  (let* ((file (aref core file-index)) (path (resolve root "bootstrap/compiler" file))
                         (generated (js-call file :replace ".eli" ".mjs"))
                         (emission (js-call previous :compile_string_with_source_map
                           (await (readFile path "utf8")) path generated (relative output path))))
                    (await (writeFile (resolve output generated)
                      (str (get emission :javascript) "//# sourceMappingURL=" generated ".map\n")))
                    (await (writeFile (resolve output (str generated ".map")) (get emission :sourceMap))))
                  (setq file-index (1+ file-index))))
              (let ((backend (await (buildBackends (js-object :outputRoot output-root :frontend previous)))))
                (put backend :compiler (funcall require-module (resolve output "compiler.mjs")))
                (js-call generations :push backend)))
            (setq index (1+ index))))
        (put state :runtime (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
        (let* ((path (resolve root "tests/fixtures/wasm-managed-function-properties.eli"))
               (javascript (await (seed path (resolve directory "function-properties-seed.mjs") environment))))
          (put state :functionFixture (js-object :source (await (readFile path "utf8"))
            :filename "function-builtin.eli" :javascript javascript))
          (put state :reflectionOracle (await (bundle-reference
            (await (writeManagedReference directory javascript "function-properties-oracle"))))))
        (let* ((fixture (js-object :key "stdlib" :entry "entry.mjs" :prefix "eliscript-stdlib/" :modules (js-array)))
               (loaded (new globalThis.Set)) (compiler (get (aref generations 2) :compiler))
               (oracle-directory (resolve directory "stdlib-oracle")))
          (await (load-stdlib state fixture loaded "entry.mjs" (resolve root "tests/fixtures/managed-stdlib-value-json.eli")))
          (let ((index 0))
            (while (< index (js-length (get fixture :modules)))
              (let* ((module (aref (get fixture :modules) index))
                     (program (js-call compiler :compile_ir_string (get module :source) (get module :filename)))
                     (id (get module :id)) (path (resolve oracle-directory id)))
                (js-call assert :strictEqual (js-call compiler :emit_ir_string program) (get module :javascript) (str "public Seed " id))
                (letfn ((rewrite (nodes)
                          (js-call nodes :forEach (lambda (node)
                            (when (= (get node :kind) "import-declaration")
                              (let ((target (js-call posix :normalize
                                      (js-call posix :join (js-call posix :dirname id) (get node :value)))))
                                (js-call assert :ok (js-call loaded :has target))
                                (put node :value (str (get fixture :prefix) target))))
                            (rewrite (get node :children (js-array)))))))
                  (rewrite (get program :body)))
                (put module :oracleJavascript (js-call compiler :emit_ir_string program))
                (await (mkdir (dirname path) (js-object :recursive t)))
                ;; Relative imports retain every original public Seed byte.
                (await (writeFile path (get module :javascript))))
              (setq index (1+ index))))
          (put state :fixture fixture)
          (put state :valueOracle (await (bundle-reference (resolve oracle-directory "entry.mjs")))))
        state
        (catch error (js-call scratch :close) (throw error)))))
  (defasync prepareDirectAffected ()
    (unless preparing (setq preparing (prepare-direct))) (await preparing))
  (defasync closeDirectAffected ()
    (when preparing
      (try (js-call (get (await preparing) :scratch) :close)
        (finally (setq preparing undefined)))))
  (defasync runDirectAffectedBrowser (state page-file global-name input oracle)
    (let* ((directory (get state :directory))
           (bundle (await (bundleManagedBrowserPage (resolve root "tests/helpers" page-file)
             (js-object "eliscript-test/compiler" (resolve directory "g3/bootstrap/compiler.mjs")
                        "eliscript-test/managed" (resolve directory "g3/backends/managed.mjs")))))
           (server (serveManagedBrowserPage bundle oracle))
           (name (get (get globalThis.process :env) :ELISCRIPT_TEST_BROWSER "chromium"))
           (engines (js-object :chromium chromium :firefox firefox :webkit webkit)) (browser undefined))
      (js-call assert :ok (Object/hasOwn engines name))
      (try
        (setq browser (await (js-call (get engines name) :launch)))
        (let ((context (await (js-call browser :newContext))))
          (try
            (let ((page (await (js-call context :newPage))))
              (js-call page :on "console" (lambda (message)
                (when (or (js-call (js-call message :text) :startsWith "eliscript browser phase:")
                          (js-call (js-call message :text) :startsWith "[direct-value-json]"))
                  (console/log (js-call message :text)))))
              (await (js-call page :goto (get (get server :url) :href)))
              (await (js-call page :waitForFunction (lambda (name) (get globalThis.globalThis name)) global-name))
              (await (js-call page :evaluate
                (async (request) (await (funcall (get globalThis.globalThis (get request :name)) (get request :input))))
                (js-object :name global-name :input input))))
            (finally (await (js-call context :close)))))
        (finally (when browser (await (js-call browser :close))) (js-call server :stop t)))))
  (defasync runDirectReflectionCase ()
    (let* ((state (await (prepareDirectAffected))) (fixture (get state :functionFixture))
           (runtime (get state :runtime)) (generations (get state :generations)))
      (js-call generations :forEach (lambda (generation)
        (js-call assert :strictEqual (js-call (get generation :compiler) :compile_string
          (get fixture :source) (get fixture :filename)) (get fixture :javascript))))
      (let* ((result (await (runDirectAffectedBrowser state "direct-wasm-reflection-page.mjs"
                 "__eliscriptDirectReflectionCase" (js-object :fixture fixture :runtime runtime) (get state :reflectionOracle))))
             (last (aref generations 2)) (compiler (get last :compiler)))
        (js-call assert :deepStrictEqual result (js-call (get last :managed) :emit_managed_wasm
          (js-call compiler :compile_ir_string (get fixture :source) (get fixture :filename))
          (js-call compiler :compile_ir_string runtime "runtime.eli"))))))
  (defasync runDirectValueJsonCase ()
    (let* ((state (await (prepareDirectAffected))) (fixture (get state :fixture))
           (runtime (get state :runtime)) (generations (get state :generations)))
      (js-call generations :forEach (lambda (generation)
        (js-call (get fixture :modules) :forEach (lambda (module)
          (js-call assert :strictEqual (js-call (get generation :compiler) :compile_string
            (get module :source) (get module :filename)) (get module :javascript))))))
      (let* ((result (await (runDirectAffectedBrowser state "direct-wasm-value-json-page.mjs"
                 "__eliscriptDirectValueJsonCase" (js-object :fixture fixture :runtime runtime
                   :inputs inputs :parseCases parseCases :encodeInputs encodeInputs) (get state :valueOracle))))
             (last (aref generations 2)) (compiler (get last :compiler)))
        (js-call assert :deepStrictEqual result (js-call (get last :managed) :emit_managed_project_wasm
          (js-call (get fixture :modules) :map (lambda (module) (js-object :id (get module :id)
            :program (js-call compiler :compile_ir_string (get module :source) (get module :filename)))))
          (get fixture :entry) (js-call compiler :compile_ir_string runtime "runtime.eli")
          (js-object :initialPages 4 :maximumPages 1024))))))
  (export prepareDirectAffected closeDirectAffected runDirectAffectedBrowser runDirectReflectionCase runDirectValueJsonCase))
