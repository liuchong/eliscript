(module tests.acceptance-generated-evidence
  (import "node:test" :as framework)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" cp mkdir mkdtemp readFile writeFile rm)
  (import "node:path" dirname resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/acceptance/check.mjs" AcceptanceCorpusError checkAcceptanceCorpus
    validateAcceptanceCorpus verifyAcceptanceRun runAcceptanceCorpus humanCorpusReport)

  (defconst canonical "tests/bootstrap-compiler.test.mjs")
  (defconst maintained "tests/eliscript/bootstrap-compiler.eli")
  (defconst integrity-canonical "tools/integrity/check.mjs")
  (defconst integrity-maintained "tools/integrity/eliscript/check.eli")
  (defconst finalizer-canonical "tools/acceptance/finalize.mjs")
  (defconst finalizer-maintained "tools/acceptance/finalize.eli")
  (defconst conformance-canonical "tests/conformance.test.mjs")
  (defconst conformance-maintained "tests/eliscript/conformance.eli")
  (defconst ci-canonical "tests/ci-contract.test.mjs")
  (defconst ci-maintained "tests/eliscript/ci-contract.eli")
  (defconst parity-canonical "tests/compiler-parity-corpus.test.mjs")
  (defconst parity-maintained "tests/eliscript/compiler-parity-corpus.eli")
  (defconst compatibility-canonical "tests/stable-compatibility-corpus.test.mjs")
  (defconst compatibility-maintained "tests/eliscript/stable-compatibility-corpus.eli")
  (defun test (title run) (js-call framework :test title (js-object :timeout 300000) run))
  (defasync contract ()
    (JSON/parse (await (readFile (resolve root "contracts/core-acceptance-corpus.json") "utf8"))))
  (defasync errors-for (value options)
    (try (await (validateAcceptanceCorpus value options))
      (throw (new globalThis.Error "expected acceptance corpus validation to fail"))
      (catch error
        (js-call assert :ok (js-call (get AcceptanceCorpusError :prototype) :isPrototypeOf error))
        (get error :errors))))
  (defun git (directory &rest arguments)
    (let ((result (spawnSync "git" arguments (js-object :cwd directory :encoding "utf8"))))
      (js-call assert :strictEqual (get result :status) 0 (get result :stderr))
      (get result :stdout)))
  (defasync copy-file (directory path)
    (await (mkdir (dirname (resolve directory path)) (js-object :recursive t)))
    (await (cp (resolve root path) (resolve directory path))))
  (defasync fixture (run)
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-acceptance-evidence-"))))
           (value (await (contract))) (files (new globalThis.Set)))
      (try
        (js-call files :add "contracts/core-acceptance-corpus.json")
        (js-call files :add "acceptance/runs/m13-01.json")
        (js-call files :add "acceptance/runs/m13-01.md")
        (js-call (Object/values (get value :sources)) :forEach (lambda (path) (js-call files :add path)))
        (js-call (get value :criteria) :forEach (lambda (criterion)
          (js-call (get criterion :evidence) :forEach (lambda (path) (js-call files :add path)))))
        (js-call files :add maintained)
        (js-call files :add integrity-maintained)
        (js-call files :add finalizer-maintained)
        (js-call files :add conformance-maintained)
        (js-call files :add ci-maintained)
        (js-call files :add parity-maintained)
        (js-call files :add compatibility-maintained)
        (js-call files :add (str canonical ".map"))
        (js-call files :add (str integrity-canonical ".map"))
        (js-call files :add (str finalizer-canonical ".map"))
        (js-call files :add (str conformance-canonical ".map"))
        (js-call files :add (str ci-canonical ".map"))
        (js-call files :add (str parity-canonical ".map"))
        (js-call files :add (str compatibility-canonical ".map"))
        (js-call files :add "tools/acceptance/compile-evidence.el")
        (let ((paths (Array/from files)) (index 0))
          (while (< index (js-length paths))
            (await (copy-file directory (aref paths index)))
            (setq index (1+ index))))
        (await (cp (resolve root "compiler") (resolve directory "compiler") (js-object :recursive t)))
        (await (writeFile (resolve directory ".gitignore")
          (str "/" canonical "\n/" canonical ".map\n/" integrity-canonical "\n/" integrity-canonical ".map\n/"
            finalizer-canonical "\n/" finalizer-canonical ".map\n/"
            conformance-canonical "\n/" conformance-canonical ".map\n/"
            ci-canonical "\n/" ci-canonical ".map\n/"
            parity-canonical "\n/" parity-canonical ".map\n/"
            compatibility-canonical "\n/" compatibility-canonical ".map\n")))
        (git directory "init" "--quiet")
        (git directory "add" ".")
        (await (funcall run directory value))
        (finally (await (rm directory (js-object :recursive t :force t)))))))

  (test "maintained acceptance checker preserves the complete original normative contract and retained audit"
    (async ()
      (let ((checked (await (checkAcceptanceCorpus (js-object :root root)))))
        (js-call assert :strictEqual (js-length (get checked :criteria)) 35)
        (js-call assert :deepStrictEqual (aref (get checked :criteria) 0)
          (js-object :id "AC-01" :title "Stable specification coverage"))
        (js-call assert :deepStrictEqual (js-call (get checked :criteria) :at -1)
          (js-object :id "PD-11" :title "State Discipline"))
        (js-call assert :deepStrictEqual (get (aref (get (get checked :contract) :commands) 0) :argv)
          (js-array "make" "test-core"))
        (js-call assert :deepStrictEqual (js-call (get checked :applications) :map (lambda (entry) (get entry :id)))
          (js-array "AV-01" "AV-02"))
        (js-call assert :ok (js-call (humanCorpusReport checked) :includes "35 mandatory criteria")))
      (let* ((report (await (verifyAcceptanceRun "acceptance/runs/m13-01.json"
                       (js-object :root root :markdownFile "acceptance/runs/m13-01.md"))))
             (counts (js-object :pass 0 :incomplete 0 :fail 0 :total (js-length (get report :criteria)))))
        (js-call (get report :criteria) :forEach (lambda (criterion)
          (let ((key (get criterion :result))) (put counts key (1+ (get counts key))))))
        (js-call assert :deepStrictEqual (get (get report :summary) :criteria) counts)
        (js-call assert :strictEqual (get (get report :summary) :acceptancePass)
          (and (= (get counts :incomplete) 0) (= (get counts :fail) 0)))
        (js-call assert :strictEqual (get (get report :summary) :corpusComplete) t)
        (js-call assert :strictEqual (get (get report :summary) :operationalSuccess) t)
        (js-call assert :strictEqual (get (get report :source) :cleanBefore) t)
        (js-call assert :strictEqual (get (get report :source) :cleanAfter) t)
        (js-call assert :ok (js-call (get report :applications) :every (lambda (entry)
          (and (= (get entry :result) "not-run") (eq (get entry :contributesToCore) false))))))))

  (test "acceptance preserves missing criteria, title drift, probes, application and forged summary negatives"
    (async ()
      (let ((value (await (contract))))
        (js-call (get value :criteria) :pop)
        (let ((errors (await (errors-for value (js-object :root root)))))
          (js-call assert :ok (js-call errors :includes "criteria must exactly match the ordered AC and PD headings in the normative specifications"))
          (js-call assert :ok (js-call errors :includes "corpus and maturity progress criteria must have identical ids and order"))))
      (let ((value (await (contract))))
        (put (aref (get value :criteria) 0) :title "Almost stable specification coverage")
        (js-call assert :ok (js-call (await (errors-for value (js-object :root root))) :includes
          "criteria must exactly match the ordered AC and PD headings in the normative specifications")))
      (let ((value (await (contract))))
        (put (aref (get value :criteria) 0) :probes (js-array "missing-probe"))
        (put (aref (get value :criteria) 0) :evidence (js-array "tests/fixtures/not-acceptance-evidence.txt"))
        (let ((errors (await (errors-for value (js-object :root root)))))
          (js-call assert :ok (js-call errors :includes "AC-01 references unknown command missing-probe"))
          (js-call assert :ok (js-call errors :includes "AC-01 evidence is not tracked: tests/fixtures/not-acceptance-evidence.txt"))))
      (let ((value (await (contract))))
        (put (aref (get value :applications) 0) :contributesToCore t)
        (js-call assert :ok (js-call (await (errors-for value (js-object :root root))) :includes
          "applications must match AV headings and contribute no core evidence")))
      (let ((report (JSON/parse (await (readFile (resolve root "acceptance/runs/m13-01.json") "utf8")))))
        (put (get report :summary) :acceptancePass (not (get (get report :summary) :acceptancePass)))
        (await (js-call assert :rejects (verifyAcceptanceRun "unused.json" (js-object :root root :report report))
          (lambda (error) (= (JSON/stringify (get error :errors))
            (JSON/stringify (js-array "run summary is not derived from recorded results")))))))))

  (test "only the seven exact untracked migrated entries are admitted after independent full module and map recompilation"
    (async () (await (fixture (async (directory value)
      (js-call assert :strictEqual (js-call (git directory "ls-files" "--" canonical) :trim) "")
      (js-call assert :strictEqual (js-call (git directory "ls-files" "--" maintained) :trim) maintained)
      (js-call assert :strictEqual (js-call (git directory "ls-files" "--" integrity-canonical) :trim) "")
      (js-call assert :strictEqual (js-call (git directory "ls-files" "--" integrity-maintained) :trim) integrity-maintained)
      (js-call assert :strictEqual (js-call (git directory "ls-files" "--" finalizer-canonical) :trim) "")
      (js-call assert :strictEqual (js-call (git directory "ls-files" "--" finalizer-maintained) :trim) finalizer-maintained)
      (js-call assert :strictEqual (js-call (git directory "ls-files" "--" conformance-canonical) :trim) "")
      (js-call assert :strictEqual (js-call (git directory "ls-files" "--" conformance-maintained) :trim) conformance-maintained)
      (js-call assert :strictEqual (js-call (git directory "ls-files" "--" ci-canonical) :trim) "")
      (js-call assert :strictEqual (js-call (git directory "ls-files" "--" ci-maintained) :trim) ci-maintained)
      (js-call assert :strictEqual (js-call (git directory "ls-files" "--" parity-canonical) :trim) "")
      (js-call assert :strictEqual (js-call (git directory "ls-files" "--" parity-maintained) :trim) parity-maintained)
      (js-call assert :strictEqual (js-call (git directory "ls-files" "--" compatibility-canonical) :trim) "")
      (js-call assert :strictEqual (js-call (git directory "ls-files" "--" compatibility-maintained) :trim) compatibility-maintained)
      (js-call assert :strictEqual (get (await (validateAcceptanceCorpus value (js-object :root directory))) :contract) value)
      (let ((unknown "tests/not-a-migration.test.mjs"))
        (await (writeFile (resolve directory unknown) "untracked original bytes\n"))
        (put (aref (get value :criteria) 0) :evidence (js-array unknown))
        (js-call assert :ok (js-call (await (errors-for value (js-object :root directory))) :includes
          (str "AC-01 evidence is not tracked: " unknown)))))))))

  (test "generated acceptance evidence rejects changed source, module, map, missing tracked source and compiler failure"
    (async () (await (fixture (async (directory value)
      (await (validateAcceptanceCorpus value (js-object :root directory)))
      (let ((paths (js-array maintained canonical (str canonical ".map")
                     integrity-maintained integrity-canonical (str integrity-canonical ".map")
                     finalizer-maintained finalizer-canonical (str finalizer-canonical ".map")
                     conformance-maintained conformance-canonical (str conformance-canonical ".map")
                     ci-maintained ci-canonical (str ci-canonical ".map")
                     parity-maintained parity-canonical (str parity-canonical ".map")
                     compatibility-maintained compatibility-canonical (str compatibility-canonical ".map"))) (index 0))
        (while (< index (js-length paths))
          (let* ((path (resolve directory (aref paths index))) (before (await (readFile path))))
            (try
              (await (writeFile path (str (js-call before :toString "utf8") "\n")))
              (js-call assert :ok (js-call (await (errors-for value (js-object :root directory))) :some
                (lambda (message) (js-call message :includes "generated acceptance evidence authentication failed"))))
              (finally (await (writeFile path before)))))
          (setq index (1+ index))))
      (git directory "rm" "--cached" "--quiet" "--" maintained)
      (js-call assert :ok (js-call (await (errors-for value (js-object :root directory))) :some
        (lambda (message) (js-call message :includes "maintained source is not tracked"))))
      (git directory "add" "--" maintained)
      (git directory "rm" "--cached" "--quiet" "--" integrity-maintained)
      (js-call assert :ok (js-call (await (errors-for value (js-object :root directory))) :some
        (lambda (message) (and (js-call message :includes integrity-canonical)
                              (js-call message :includes "maintained source is not tracked")))))
      (git directory "add" "--" integrity-maintained)
      (git directory "rm" "--cached" "--quiet" "--" finalizer-maintained)
      (js-call assert :ok (js-call (await (errors-for value (js-object :root directory))) :some
        (lambda (message) (and (js-call message :includes finalizer-canonical)
                              (js-call message :includes "maintained source is not tracked")))))
      (git directory "add" "--" finalizer-maintained)
      (let ((sources (js-array conformance-maintained ci-maintained parity-maintained compatibility-maintained)) (index 0))
        (while (< index (js-length sources))
          (let ((source (aref sources index)))
            (git directory "rm" "--cached" "--quiet" "--" source)
            (js-call assert :ok (js-call (await (errors-for value (js-object :root directory))) :some
              (lambda (message) (js-call message :includes "maintained source is not tracked"))))
            (git directory "add" "--" source))
          (setq index (1+ index))))
      (git directory "rm" "--cached" "--quiet" "--" "tools/acceptance/compile-evidence.el")
      (js-call assert :ok (js-call (await (errors-for value (js-object :root directory))) :some
        (lambda (message) (js-call message :includes "maintained evidence compiler is not tracked"))))
      (git directory "add" "--" "tools/acceptance/compile-evidence.el")
      (let ((entries (js-array canonical integrity-canonical finalizer-canonical conformance-canonical ci-canonical parity-canonical compatibility-canonical)) (index 0))
        (while (< index (js-length entries))
          (let* ((entry (aref entries index)) (map-path (resolve directory (str entry ".map")))
                 (mapping (await (readFile map-path))))
            (try
              (await (rm map-path))
              (js-call assert :ok (js-call (await (errors-for value (js-object :root directory))) :some
                (lambda (message) (and (js-call message :includes entry)
                                      (js-call message :includes "generated acceptance evidence authentication failed")))))
              (finally (await (writeFile map-path mapping)))))
          (setq index (1+ index))))
      (let ((paths (js-array "tools/acceptance/compile-evidence.el" "compiler/eliscript-reader.el")) (index 0))
        (while (< index (js-length paths))
          (let* ((path (resolve directory (aref paths index))) (before (await (readFile path))))
            (try
              (await (writeFile path (str (js-call before :toString "utf8") "\n(error \"changed independent evidence compiler\")\n")))
              (js-call assert :ok (js-call (await (errors-for value (js-object :root directory))) :some
                (lambda (message) (js-call message :includes "generated acceptance evidence authentication failed"))))
              (finally (await (writeFile path before)))))
          (setq index (1+ index))))
      (await (rm (resolve directory "compiler/eliscript.el")))
      (js-call assert :ok (js-call (await (errors-for value (js-object :root directory))) :some
        (lambda (message) (js-call message :includes "generated acceptance evidence authentication failed")))))))))

  (test "historical manifest, report shape and Markdown remain exact and a dirty run still refuses execution"
    (async ()
      (let ((report (JSON/parse (await (readFile (resolve root "acceptance/runs/m13-01.json") "utf8")))))
        (put (get report :corpus) :contractSha256 (js-call "0" :repeat 64))
        (await (js-call assert :rejects (verifyAcceptanceRun "unused.json" (js-object :root root :report report))
          (lambda (error) (js-call (get error :errors) :includes "run was produced from a different acceptance corpus contract")))))
      (let ((report (JSON/parse (await (readFile (resolve root "acceptance/runs/m13-01.json") "utf8")))))
        (js-call (get report :artifacts) :pop)
        (await (js-call assert :rejects (verifyAcceptanceRun "unused.json" (js-object :root root :report report))
          (lambda (error) (js-call (get error :errors) :includes "run artifact digest inventory is incomplete or invalid")))))
      (await (fixture (async (directory value)
        (let* ((manifest-path (resolve directory "contracts/core-acceptance-corpus.json"))
               (before (await (readFile manifest-path))))
          (try
            (await (writeFile manifest-path (str (js-call before :toString "utf8") "\n")))
            (await (js-call assert :rejects (verifyAcceptanceRun "acceptance/runs/m13-01.json"
              (js-object :root directory :contract value)) (lambda (error)
                (js-call (get error :errors) :includes "run was produced from a different acceptance corpus contract"))))
            (finally (await (writeFile manifest-path before)))))
        (await (writeFile (resolve directory "acceptance/runs/m13-01.md") "forged Markdown\n"))
        (await (js-call assert :rejects (verifyAcceptanceRun "acceptance/runs/m13-01.json"
          (js-object :root directory :contract value :markdownFile "acceptance/runs/m13-01.md"))
          (lambda (error) (js-call (get error :errors) :includes "human report does not match its machine-readable run"))))
        (await (js-call assert :rejects (runAcceptanceCorpus (js-object :root directory :contract value))
          (lambda (error) (js-call (get error :errors) :includes "acceptance runs require a clean tracked and untracked worktree")))))))))
)
