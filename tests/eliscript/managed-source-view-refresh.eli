(module tests.managed-source-view-refresh
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "../tools/backends/managed-source-view.mjs" createManagedSourceView)

  ;; Model the real decoder: publish identity before refreshing, and refresh
  ;; cached children too. Descriptor reads materialize each next source view.
  (defun graph (count cycle failure &optional fail-enabled)
    (let ((views (new globalThis.Map)) (targets (new globalThis.Map))
          (enabled (js-object :failure (if (undefined? fail-enabled) (not (undefined? failure)) fail-enabled)))
          (lookup undefined))
      (setq lookup (lambda (index)
        (let ((view (js-call views :get index)))
          (unless view
            (let* ((target (js-object))
                   (next-value (lambda ()
                     (when (and (get enabled :failure) (= index 500)) (throw failure))
                     (cond ((< (1+ index) count) (funcall lookup (1+ index)))
                           (cycle (funcall lookup 0)) (t undefined))))
                   (operations (js-object
                     :descriptor (lambda (key)
                       (when (= key "next")
                         (js-object :value (funcall next-value) :writable t :enumerable t :configurable t)))
                     :keys (lambda () (js-array "next"))
                     :get (lambda (key receiver) (if (= key "next") (funcall next-value) undefined))
                     :set (lambda (&rest ignored) false) :has (lambda (key) (= key "next"))
                     :define (lambda (&rest ignored) false) :delete (lambda (&rest ignored) false)
                     :prototype (lambda () (get globalThis.Object :prototype))
                     :setPrototype (lambda (&rest ignored) false)
                     :extensible (lambda () t) :preventExtensions (lambda () false))))
              (setq view (createManagedSourceView (js-object :target target :operations operations)))
              (js-call views :set index view)
              (js-call targets :set index target)))
          (js-call view :refresh)
          (get view :value))))
      (js-object :lookup lookup :views views :targets targets :enabled enabled)))

  (defun assert-mirrors (state count cycle)
    (js-call assert :strictEqual (get (get state :views) :size) count)
    (let ((index 0))
      (while (< index count)
        (let* ((entry (Reflect/getOwnPropertyDescriptor (js-call (get state :targets) :get index) "next"))
               (next (cond ((< (1+ index) count) (1+ index)) (cycle 0) (t undefined)))
               (expected (if (undefined? next) undefined (get (js-call (get state :views) :get next) :value))))
          (js-call assert :deepStrictEqual (Object/keys entry)
            (js-array "value" "writable" "enumerable" "configurable"))
          (js-call assert :strictEqual (get entry :value) expected)
          (js-call assert :strictEqual (get entry :writable) t)
          (js-call assert :strictEqual (get entry :enumerable) t)
          (js-call assert :strictEqual (get entry :configurable) t))
        (setq index (1+ index)))))

  (test "source refresh fully mirrors a 20000-node chain without recursive host stack growth" (lambda ()
    (let* ((state (graph 20000 false undefined)) (root (funcall (get state :lookup) 0)))
      (assert-mirrors state 20000 false)
      (js-call assert :strictEqual root (get (js-call (get state :views) :get 0) :value)))))
  (test "source refresh preserves cyclic identities and completes every mirror once per drain" (lambda ()
    (let ((state (graph 3 t undefined)))
      (funcall (get state :lookup) 0)
      (assert-mirrors state 3 t))))
  (test "source refresh retains false throws and releases its pending queue for retry" (lambda ()
    (let ((state (graph 1000 false false t)) (caught false))
      (try (funcall (get state :lookup) 0)
        (catch error (setq caught t) (js-call assert :strictEqual error false)))
      (js-call assert :strictEqual caught t)
      (put (get state :enabled) :failure false)
      (funcall (get state :lookup) 0)
      (assert-mirrors state 1000 false))))
  (test "source refresh preserves an undefined first throw and retries after correction" (lambda ()
    (let ((state (graph 1000 false undefined t)) (caught false))
      (try (funcall (get state :lookup) 0)
        (catch error (setq caught t) (js-call assert :strictEqual error undefined)))
      (js-call assert :strictEqual caught t)
      (put (get state :enabled) :failure false)
      (funcall (get state :lookup) 0)
      (assert-mirrors state 1000 false)))))
