(module tests.compiler-corpus-raw-fixture-observer
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm mkdir symlink)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:module" createRequire)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime readManagedModuleMetadata)
  (import "../tools/backends/compiler-corpus-raw-fixture-observer.mjs" runOriginalRawFixtureHost)
  (import "../tools/backends/compiler-corpus-raw-language-fixtures.mjs" runOriginalRawLanguageFixtureHost originalRawLanguageFixturePlans)
  (test "original zero-import observations retain raw ownership holes aliases and all family operation groups"
    (async ()
      (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-raw-fixture-observer-")))))
        (try
          (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
          (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
          (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
                 (compiler (get backend :compiler))
                 (memory (js-call compiler :compile_ir_string
                   (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
                 (families (js-array "arrays" "objects" "array-callbacks" "array-search" "array-construction" "variadic-calls" "source-collections")) (position 0))
            (while (< position (js-length families))
              (let* ((family (aref families position))
                     (filename (str "tests/fixtures/wasm-managed-" family ".eli"))
                     (program (js-call compiler :compile_ir_string (await (readFile (resolve root filename) "utf8")) filename))
                     (bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program memory)))
                     (reference (resolve directory (str family ".mjs"))))
                (await (writeFile reference (js-call compiler :emit_ir_string program)))
                (let ((oracle (funcall (createRequire reference) reference)))
                  (js-call assert :deepStrictEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
                  (js-call (js-array 1 65536) :forEach (lambda (threshold)
                    (let ((runtime (instantiateManagedRuntime bytes)))
                      (js-call runtime :auto threshold)
                      (try
                        (let ((result (runOriginalRawFixtureHost (js-object :family family :runtime runtime :oracle oracle))))
                          (js-call assert :strictEqual (get result :observations)
                            (get (js-object :arrays 26 :objects 12 :array-callbacks 121 :array-search 5121
                              :array-construction 18 :variadic-calls 42 :source-collections 36) family))
                          (js-call assert :strictEqual
                            (js-call (Object/values (get result :groups)) :reduce (lambda (total count) (+ total count)) 0)
                            (get result :observations))
                          (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                          (js-call runtime :closeModule)
                          (js-call runtime :collect)
                          (js-call assert :strictEqual (js-call runtime :live) 0))
                        (finally (js-call runtime :closeModule) (js-call runtime :collect))))))))
              (setq position (1+ position))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
  (test "the complete callable fixture requires its declared module ABI for exact named exports and preserves control and unknown-name refusals"
    (async ()
      (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-raw-callable-exports-")))))
        (try
          (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
          (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
          (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
                 (compiler (get backend :compiler))
                 (memory (js-call compiler :compile_ir_string
                   (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
                 (filename "tests/fixtures/wasm-managed-callables.eli")
                 (program (js-call compiler :compile_ir_string (await (readFile (resolve root filename) "utf8")) filename))
                 (plans (originalRawLanguageFixturePlans))
                 (matches (js-call plans :filter (lambda (plan) (= (get plan :family) "callables"))))
                 (plan (aref matches 0)) (reference (resolve directory "callables.mjs")))
            (js-call assert :strictEqual (js-length matches) 1)
            (js-call assert :strictEqual (get plan :requiredABI) "managed-module-v1")
            (js-call assert :strictEqual
              (js-length (js-call plans :filter (lambda (item) (not (undefined? (get item :requiredABI)))))) 1)
            (await (writeFile reference (js-call compiler :emit_ir_string program)))
            (let ((oracle (funcall (createRequire reference) reference)))
              (js-call (js-array false t) :forEach (lambda (module)
                (let* ((options (if module (js-object :abi (get plan :requiredABI)) undefined))
                       (bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program memory options)))
                       (image (new globalThis.WebAssembly.Module bytes))
                       (descriptor (readManagedModuleMetadata image "eliscript-managed-control"))
                       (runtime (instantiateManagedRuntime bytes)) (roots (js-array)))
                  (js-call assert :deepStrictEqual (js-call globalThis.WebAssembly.Module :imports image) (js-array))
                  (js-call runtime :auto 1)
                  (try
                    (if module
                      (progn
                        (js-call assert :strictEqual (get descriptor :abi) (get plan :requiredABI))
                        (let ((binding (js-call (get (get descriptor :module) :exports) :find
                                (lambda (item) (= (get item :name) "ordered-values")))))
                          (js-call assert :strictEqual (get binding :kind) 1))
                        (let ((function (js-call runtime :getExport "ordered-values"))
                              (marker (js-call runtime :sourceArray (js-array false)))
                              (ref (js-array false)) (repeat 0))
                          (js-call roots :push function marker)
                          (while (< repeat 2)
                            (let ((again (js-call runtime :getExport "ordered-values")) (result undefined) (value undefined))
                              (try
                                (js-call assert :strictEqual (js-call runtime :keyEqual function again) t)
                                (setq result (js-call runtime :invoke "funcall-order" (js-array again marker)))
                                (js-call assert :strictEqual (js-call runtime :readNumber result)
                                  (js-call oracle :funcall_order (get oracle :ordered_values) ref))
                                (js-call assert :strictEqual (js-call runtime :readNumber result) 12)
                                (setq value (js-call runtime :get marker 0))
                                (js-call assert :strictEqual (js-call runtime :readNumber value) 2)
                                (js-call assert :strictEqual (aref ref 0) 2)
                                (finally
                                  (unless (undefined? value) (js-call runtime :release value))
                                  (unless (undefined? result) (js-call runtime :release result))
                                  (js-call runtime :release again))))
                            (js-call runtime :collect) (setq repeat (1+ repeat)))))
                      (progn
                        (js-call assert :strictEqual (get descriptor :abi) "managed-control-v1")
                        (js-call assert :strictEqual (get descriptor :module) undefined)
                        (js-call assert :throws (lambda () (js-call runtime :getExport "ordered-values"))
                          (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0003")))))
                    (js-call (js-array "ordered_values" "unknown") :forEach (lambda (name)
                      (js-call assert :throws (lambda () (js-call runtime :getExport name))
                        (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0003")))))
                    (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                    (finally
                      (js-call roots :forEach (lambda (value) (js-call runtime :release value)))
                      (js-call runtime :closeModule) (js-call runtime :collect)
                      (js-call assert :strictEqual (js-call runtime :live) 0))))))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "the complete original string observer passes exactly two ignored arguments and retains both trace effects and first failure ownership"
    (async ()
      (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-raw-string-observer-")))))
        (try
          (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
          (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
          (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
                 (compiler (get backend :compiler))
                 (memory (js-call compiler :compile_ir_string
                   (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
                 (filename "tests/fixtures/wasm-managed-strings.eli")
                 (program (js-call compiler :compile_ir_string (await (readFile (resolve root filename) "utf8")) filename))
                 (bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program memory)))
                 (reference (resolve directory "strings.mjs"))
                 (texts (js-array "" "x" "a\u0000b" "中😀\ud800x\udfff" "ababa" "\ud83d\ude00" "\ud83dx\ude00")))
            (await (writeFile reference (js-call compiler :emit_ir_string program)))
            (let ((oracle (funcall (createRequire reference) reference)))
              (js-call assert :deepStrictEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
              (let* ((runtime (instantiateManagedRuntime bytes)) (actual-texts (js-array)) (oracle-texts (js-array))
                     (observed (Object/assign (js-object) runtime (js-object :invoke (lambda (name arguments)
                       (when (= name "ignored")
                         (js-call assert :strictEqual (js-length arguments) 2)
                         (js-call actual-texts :push (js-call runtime :readString (aref arguments 0))))
                       (let ((result (js-call runtime :invoke name arguments)))
                         (when (= name "ignored")
                           (js-call (js-array (js-array "first" 1) (js-array "second" 2)) :forEach (lambda (entry)
                             (let ((key (js-call runtime :string (aref entry 0))) (value undefined))
                               (try
                                 (setq value (js-call runtime :objectGet (aref arguments 1) key))
                                 (js-call assert :strictEqual (js-call runtime :readNumber value) (aref entry 1))
                                 (finally
                                   (unless (undefined? value) (js-call runtime :release value))
                                   (js-call runtime :release key))))))) result)))))
                     (reference-observer (Object/assign (js-object) oracle (js-object :ignored (lambda (&rest arguments)
                       (js-call assert :strictEqual (js-length arguments) 2)
                       (js-call oracle-texts :push (aref arguments 0))
                       (let ((result (Reflect/apply (get oracle :ignored) oracle arguments)))
                         (js-call assert :deepStrictEqual (aref arguments 1) (js-object :first 1 :second 2)) result))))))
                (js-call runtime :auto 1)
                (try
                  (let ((report (runOriginalRawLanguageFixtureHost (js-object :family "strings" :runtime observed :oracle reference-observer))))
                    (js-call assert :strictEqual (get (get report :groups) "ignored string arguments") 7)
                    (js-call assert :deepStrictEqual actual-texts texts)
                    (js-call assert :deepStrictEqual oracle-texts texts)
                    (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
                  (finally
                    (js-call runtime :closeModule) (js-call runtime :collect)
                    (js-call assert :strictEqual (js-call runtime :live) 0))))
              (js-call (js-array (js-object :primary t :value (new globalThis.Error "original ignored failure"))
                (js-object :primary t :value false) (js-object :primary t :value undefined)
                (js-object :primary false)) :forEach (lambda (scenario)
                (let* ((runtime (instantiateManagedRuntime bytes)) (interrupted false) (released 0)
                       (secondary (new globalThis.Error "actual collection completed before cleanup failure"))
                       (seen false) (caught undefined)
                       (observed (Object/assign (js-object) runtime (js-object
                         :invoke (lambda (name arguments)
                           (when (and (get scenario :primary) (= name "ignored"))
                             (js-call assert :strictEqual (js-length arguments) 2)
                             (setq interrupted t) (throw (get scenario :value)))
                           (let ((result (js-call runtime :invoke name arguments)))
                             (when (and (not (get scenario :primary)) (= name "size")) (setq interrupted t)) result))
                         :release (lambda (value)
                           (js-call runtime :release value) (when interrupted (setq released (1+ released))))
                         :collect (lambda ()
                           (js-call runtime :collect) (when interrupted (throw secondary)))))))
                  (js-call runtime :auto 1)
                  (try
                    (try (runOriginalRawLanguageFixtureHost (js-object :family "strings" :runtime observed :oracle oracle))
                      (catch error (setq seen t caught error)))
                    (js-call assert :strictEqual seen t)
                    (js-call assert :strictEqual caught (if (get scenario :primary) (get scenario :value) secondary))
                    ;; The interrupted observation owns precisely its input
                    ;; text and trace, or its input text and successful size.
                    (js-call assert :strictEqual released 2)
                    (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                    (finally
                      (js-call runtime :closeModule) (js-call runtime :collect)
                      (js-call assert :strictEqual (js-call runtime :live) 0))))))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
)
