(module tests.compiler-matrix
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp mkdir readFile writeFile rm readdir)
  (import "node:os" tmpdir)
  (import "node:path" resolve join)
  (import "node:buffer" Buffer)
  (import "node:child_process" :default child-process)
  (import "node:module" syncBuiltinESMExports)
  (import "node:events" EventEmitter)
  (import "../tools/backends/build.mjs" root loadLiteralSources)
  (import "../tools/backends/compiler-build.mjs" loadCompilerSources)
  (import "../tools/backends/compiler-bootstrap.mjs" compilerDigest compilerSourceIdentity)
  (import "../tools/backends/compiler-metadata.mjs" readCompilerMetadata)
  (import "../dist/bootstrap/compiler.mjs" compile-ir-string emit-ir-string)
  (import "../tools/backends/compiler-session.mjs" createCompilerSession encodeCompilerIR)
  (import "../tools/backends/compiler-matrix.mjs"
    loadOriginalCompilerManifests loadCompilerMatrixCorpus verifyOriginalCompilerCorpusFiles
    archiveProduct runOriginalCompilerGates buildCompilerMatrix runCompilerMatrixCell
    matrix-case-execution matrix-response-mode)

  ;; This calls the real private record executor and public session decoder.
  ;; Its tiny protocol driver is transport data, never a compiler or corpus
  ;; acceptance substitute.
  (defasync sequence-transport-case (directory session mode execution-options)
    (let* ((cell (js-object :records (js-array)))
           (metadata (js-object :cells (js-array cell)))
           (record (js-object :id "sequence-event-transport" :kind "sequence"
             :steps (js-array (js-object :id "actual" :request (js-object :operation "capabilities")))
             :expected (js-object :kind "sequence")
             :original (js-object :suite "tests/compiler-matrix-selfhosted.test.mjs")))
           (corpus (js-object :document (js-object :evidence (js-array)))))
      (await (matrix-case-execution record 0 "javascript" "native" session mode directory metadata
        (join directory "matrix.json") corpus execution-options execution-options cell nil nil))
      (js-object :cell cell :directory (get (aref (get cell :records) 0) :directory))))

  (test "private matrix sequences inherit negotiated graph events and preserve actual decoded IR bytes shared nodes and archived evidence"
    (async ()
      (await (workspace (async (directory)
        (let* ((wire-requests (js-array)) (received (js-array))
               (ir "{\"value\":-0,\"text\":\"中😀\"}")
               (driver (js-object
                 :compiler_session_new (lambda () (js-object :token 0))
                 :compiler_session_close (lambda (state) (put state :closed t))
                 :compiler_session_request (lambda (state text)
                   (let ((request (JSON/parse text)))
                     (js-call wire-requests :push request)
                     (js-call assert :strictEqual (get request :responseMode) "graph-events-v1")
                     (put state :token (1+ (get state :token)))
                     (encodeCompilerIR (js-object :format "eliscript-compiler-response-events" :version 2
                       :token (get state :token) :done t :events (js-array
                         (js-array "object" 1) (js-array "key" "ir") (js-array "value" ir)
                         (js-array "key" "bytes") (js-array "array" 2)
                         (js-array "array-values" (js-array 0 255 17)) (js-array "end")
                         (js-array "key" "left") (js-array "object" 3)
                         (js-array "key" "zero") (js-array "value" -0.0)
                         (js-array "key" "text") (js-array "value" "中😀\ud800") (js-array "end")
                         (js-array "key" "right") (js-array "reference" 3) (js-array "end"))))))))
               (actual (await (createCompilerSession (js-object :host "javascript" :compiler driver))))
               (session (js-object :host "javascript" :request (async (request options)
                 (let ((value (await (js-call actual :request request options))))
                   (js-call received :push value) value)))))
          (try
            (let* ((result (await (sequence-transport-case directory session "graph-events-v1" (js-object))))
                   (outcome (aref (get (get result :cell) :records) 0))
                   (value (aref received 0))
                   (evidence (await (readCompilerMetadata (join (get result :directory) "execution.json"))))
                   (trace (await (readCompilerMetadata (join (get result :directory) "suite-request-trace.json")))))
              (js-call assert :strictEqual (js-length wire-requests) 1)
              (js-call assert :strictEqual (get value :ir) ir)
              (js-call assert :deepStrictEqual (get value :bytes) (js-array 0 255 17))
              (js-call assert :strictEqual (get value :left) (get value :right))
              (js-call assert :ok (Object/is (get (get value :left) :zero) -0.0))
              (js-call assert :strictEqual (get (get value :left) :text) "中😀\ud800")
              (js-call assert :strictEqual (get outcome :verification) "equivalent")
              (js-call assert :strictEqual (get evidence :expectedSatisfied) t)
              (js-call assert :strictEqual (get (get (aref (get evidence :identity) 0) :result) :ir) ir)
              (js-call assert :deepStrictEqual trace
                (js-array (js-object :position 0 :operation "capabilities" :status "returned"))))
            (finally (await (js-call actual :close))))))))))

  (test "private sequence forwarding honors explicit modes and original getter receivers order cancellation and first thrown values"
    (async ()
      (await (workspace (async (directory)
        (let* ((events (js-array)) (calls (js-array)) (controller (new globalThis.AbortController))
               ;; AbortController's native signal getter rejects a different
               ;; receiver; it must be read on the original options object.
               (request-options controller) (failure false)
               (session (js-object :host "javascript" :request (async (request options)
                 (let* ((signal (get options :signal)) (mode (get options :responseMode))
                        (chunks (get options :responseStringChunks)))
                   (js-call calls :push (js-object :signal signal :mode mode :chunks chunks))
                   (when (get signal :aborted) (throw (get signal :reason)))
                 (when (get request :fail) (throw failure))
                 (js-object :ok t)))))
               (execution-options (js-object :execute (async (context)
                 (let ((traced (get context :session)))
                   (await (js-call traced :request (js-object :operation "capabilities") request-options))
                   (await (js-call traced :request (js-object :operation "capabilities")
                     (js-object :signal (get controller :signal) :responseMode undefined)))
                   (await (js-call traced :request (js-object :operation "capabilities")
                     (js-object :signal (get controller :signal) :responseMode "graph-events-v1")))
                   (await (js-call traced :request
                     (js-object :operation "capabilities" :responseMode "events-v1")
                     (js-object :signal (get controller :signal))))
                   (await (js-call traced :request
                     (js-object :operation "response-next" :token 1)
                     (js-object :signal (get controller :signal))))
                   (let ((index 0) (failures (js-array false undefined)))
                     (while (< index 2)
                       (setq failure (aref failures index))
                       (let ((caught false) (value t))
                         (try (await (js-call traced :request (js-object :operation "capabilities" :fail t)
                                (js-object :signal (get controller :signal))))
                           (catch error (setq caught t value error)))
                         (js-call assert :strictEqual caught t) (js-call assert :strictEqual value failure))
                       (setq index (1+ index))))
                   (js-call controller :abort false)
                   (let ((caught false) (value t))
                     (try (await (js-call traced :request (js-object :operation "capabilities")
                            (js-object :signal (get controller :signal))))
                       (catch error (setq caught t value error)))
                     (js-call assert :strictEqual caught t) (js-call assert :strictEqual value false))
                   (js-object :kind "sequence" :expectedSatisfied t :identity (js-array)))))))
          (js-call (js-array "responseMode" "responseStringChunks") :forEach (lambda (key)
            (Object/defineProperty request-options key (js-object :enumerable t :get (lambda ()
              (js-call events :push key)
              (if (= key "responseMode") "events-v1" false))))))
          (Object/defineProperty request-options "unused" (js-object :enumerable t :get (lambda () (throw "unrelated getter"))))
          (let* ((result (await (sequence-transport-case directory session "graph-events-v1" execution-options)))
                 (trace (await (readCompilerMetadata (join (get result :directory) "suite-request-trace.json")))))
            (js-call assert :strictEqual (get (aref (get (get result :cell) :records) 0) :verification) "equivalent")
            (js-call assert :deepStrictEqual events (js-array "responseMode" "responseStringChunks"))
            (js-call assert :strictEqual (get (aref calls 0) :chunks) false)
            (js-call assert :deepStrictEqual (js-call calls :map (lambda (call) (get call :mode)))
              (js-array "events-v1" undefined "graph-events-v1" undefined undefined "graph-events-v1" "graph-events-v1" "graph-events-v1"))
            (js-call calls :forEach (lambda (call) (js-call assert :strictEqual (get call :signal) (get controller :signal))))
            (js-call assert :deepStrictEqual (js-call trace :map (lambda (entry) (get entry :status)))
              (js-array "returned" "returned" "returned" "returned" "returned" "failed" "failed" "failed")))))))))

  (test "binary matrix negotiation prefers advertised graph events with tree and legacy fallbacks"
    (lambda ()
      (js-call assert :strictEqual (matrix-response-mode (js-array "events-v1" "graph-events-v1")) "graph-events-v1")
      (js-call assert :strictEqual (matrix-response-mode (js-array "graph-events-v1" "events-v1")) "graph-events-v1")
      (js-call assert :strictEqual (matrix-response-mode (js-array "events-v1")) "events-v1")
      (js-call assert :strictEqual (matrix-response-mode (js-array)) undefined)
      (js-call assert :strictEqual (matrix-response-mode undefined) undefined)))

  (defasync workspace (run)
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-selfhosted-matrix-")))))
      (try (await (funcall run directory))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defun fixture-records (originals)
    ;; This is only the loader's adversarial data fixture. It never certifies
    ;; the original corpus or supplies a replacement execution oracle.
    (js-object :format "eliscript-compiler-matrix-corpus" :version 1
      :manifests (Object/fromEntries (js-call (get originals :manifests) :map
        (lambda (item) (js-array (get item :id) (js-object :sha256 (get item :sha256) :identity (get item :identity))))))
      :coverageIds (Array/from (get originals :requiredCoverage)) :expectedIds (js-array "snapshot-case")
      :records (js-array (js-object :id "snapshot-case" :kind "project"
        :coverage (Array/from (get originals :requiredCoverage)) :entry "entry.mjs"
        :modules (js-array (js-object :id "entry.mjs" :filename "源😀.eli" :source "; 中😀\ud800\n(defconst value -0)"))
        :expected (js-object :value -0)))
      :originalGateEvidence (js-object :coverageIds (js-array) :details (js-object :value -0))
      :missingCaseAdapters (js-array)))

  (test "Eliscript matrix captures caller corpus before IO and preserves separate source snapshots IEEE values and aliases"
    (async ()
      (let* ((originals (await (loadOriginalCompilerManifests))) (input (fixture-records originals))
             (record (aref (get input :records) 0)) (shared (js-object :value -0))
             (source (get (aref (get record :modules) 0) :source)))
        (put record :request (js-object :operation "project" :shared shared))
        (put (get record :expected) :shared shared)
        (js-call (get input :missingCaseAdapters) :push
          (js-object :coverageId (aref (get input :coverageIds) 0) :reason "retained snapshot"))
        (let ((pending (loadCompilerMatrixCorpus (js-object :records input))))
          (put (aref (get record :modules) 0) :source "changed after dispatch")
          (put shared :value 1) (put (get (get input :originalGateEvidence) :details) :value 1)
          (put (aref (get input :missingCaseAdapters) 0) :reason "changed")
          (let* ((result (await pending)) (actual (aref (get result :records) 0))
                 (document (get result :document)) (saved (aref (get document :records) 0))
                 (identity (get result :identity))
                 (retained (JSON/parse (js-call (js-call Buffer :from (get result :recordsBytes)) :toString "utf8"))))
            (js-call assert :strictEqual (get (aref (get actual :modules) 0) :source) source)
            (js-call assert :strictEqual (get (aref (get saved :modules) 0) :source) source)
            (js-call assert :ok (Object/is (get (get actual :expected) :value) -0))
            (js-call assert :ok (Object/is (get (get (get actual :expected) :shared) :value) -0))
            (js-call assert :strictEqual (get (get actual :request) :shared) (get (get actual :expected) :shared))
            (js-call assert :strictEqual (get (get saved :request) :shared) (get (get saved :expected) :shared))
            (js-call assert :notStrictEqual (get (get actual :request) :shared) (get (get saved :request) :shared))
            (js-call assert :notStrictEqual document input) (js-call assert :notStrictEqual actual saved)
            (js-call assert :notStrictEqual (get identity :originalGateEvidence) (get document :originalGateEvidence))
            (js-call assert :notStrictEqual (get identity :missingCaseAdapters) (get document :missingCaseAdapters))
            (js-call assert :ok (Object/is (get (get (get identity :originalGateEvidence) :details) :value) -0))
            (js-call assert :strictEqual (get (aref (get identity :missingCaseAdapters) 0) :reason) "retained snapshot")
            (js-call assert :strictEqual (get (aref (get (aref (get retained :records) 0) :modules) 0) :source) source)
            (js-call assert :ok (Object/is (get (get (aref (get retained :records) 0) :expected) :value) -0))
            (put (aref (get actual :modules) 0) :source "case edited")
            (put (get (get identity :originalGateEvidence) :details) :value 2)
            (put (aref (get document :missingCaseAdapters) 0) :reason "document edited")
            (js-call assert :strictEqual (get (aref (get saved :modules) 0) :source) source)
            (js-call assert :ok (Object/is (get (get (get document :originalGateEvidence) :details) :value) -0))
            (js-call assert :strictEqual (get (aref (get identity :missingCaseAdapters) 0) :reason) "retained snapshot"))))))

  (test "Eliscript matrix rejects omitted original coverage duplicate identities stale bindings and invalid complete graphs"
    (async ()
      (let ((originals (await (loadOriginalCompilerManifests))))
        (await (js-call assert :rejects
          (loadCompilerMatrixCorpus (js-object :records (fixture-records originals) :recordsPath "must-not-read"))
          (lambda (error) (= (get error :message) "provide corpus records or their JSON path"))))
        (let ((mutations (js-array
          (lambda (input) (js-call (get input :coverageIds) :pop))
          (lambda (input) (js-call (get input :expectedIds) :push "snapshot-case"))
          (lambda (input) (put (get (get input :manifests) :compiler-parity) :sha256 "stale"))
          (lambda (input) (put (aref (get input :records) 0) :coverage (js-array)))
          (lambda (input) (put (aref (get input :records) 0) :entry "outside.mjs"))
          (lambda (input) (put (aref (get (aref (get input :records) 0) :modules) 0) :id "../escape.mjs"))
          (lambda (input) (put (aref (get input :records) 0) :kind "unimplemented-kind")))) (index 0))
          (while (< index (js-length mutations))
            (let ((input (fixture-records originals)))
              (funcall (aref mutations index) input)
              (await (js-call assert :rejects (loadCompilerMatrixCorpus (js-object :records input)))))
            (setq index (1+ index))))
        ;; A retained missing adapter stays explicitly missing. Neither loader
        ;; success nor apparent complete coverage upgrades it to acceptance.
        (let ((input (fixture-records originals)))
          (put input :missingCaseAdapters (js-array (js-object :coverageId (aref (get input :coverageIds) 0) :reason "required adapter")))
          (let ((result (await (loadCompilerMatrixCorpus (js-object :records input)))))
            (js-call assert :deepStrictEqual (get (get result :identity) :missingCaseAdapters) (get input :missingCaseAdapters)))))))

  (test "Eliscript matrix verifies all declared original bytes and reports tamper removal and restored source identities"
    (async ()
      (await (workspace (async (directory)
        (let* ((file "source.txt") (text "中😀\ud800\n")
               (bytes (js-call Buffer :from text "utf16le"))
               (declaration (js-object :file file :sha256 (compilerDigest bytes) :bytes (js-length bytes)))
               (corpus (js-object :originals (js-object :manifests (js-array declaration) :evidence (js-array))
                         :document (js-object :evidence (js-array declaration))))
               (options (js-object :sourceRoot directory :corpus corpus)))
          (await (writeFile (resolve directory file) bytes))
          (js-call assert :strictEqual (get (await (verifyOriginalCompilerCorpusFiles options)) :status) "unchanged")
          (await (writeFile (resolve directory file) (js-call Buffer :from "different" "utf16le")))
          (let ((changed (await (verifyOriginalCompilerCorpusFiles options))))
            (js-call assert :strictEqual (get changed :status) "changed")
            (js-call assert :deepStrictEqual (get changed :changedFiles) (js-array file)))
          (await (rm (resolve directory file)))
          (let ((removed (await (verifyOriginalCompilerCorpusFiles options))))
            (js-call assert :strictEqual (get (get (aref (get removed :files) 0) :error) :code) "ENOENT"))
          (await (writeFile (resolve directory file) bytes))
          (js-call assert :strictEqual (get (await (verifyOriginalCompilerCorpusFiles options)) :status) "unchanged")
          (put (get corpus :document) :evidence (js-array (js-object :file file :sha256 "stale" :bytes (js-length bytes))))
          (await (js-call assert :rejects (verifyOriginalCompilerCorpusFiles options)
            (lambda (error) (= (get error :message) (+ "original corpus file has conflicting source revisions: " file)))))))))))

  (test "Eliscript matrix product archival retains exact bytes metadata source maps and refuses fabricated outputs"
    (async ()
      (await (workspace (async (directory)
        (let* ((javascript (emit-ir-string (compile-ir-string "(module archival (defconst text \"中😀\\ud800\") (export text))" "源.eli")))
               (map (JSON/stringify (js-object :version 3 :sources (js-array "源.eli") :mappings "")))
               (input (js-object :target "javascript" :entry "entry.mjs"
                 :modules (js-array (js-object :id "entry.mjs" :javascript javascript :sourceMap map))))
               (snapshot (funcall globalThis.structuredClone input))
               (product (await (archiveProduct input "javascript" (join directory "javascript")))))
          (js-call assert :deepStrictEqual input snapshot)
          (js-call assert :deepStrictEqual (await (readFile (get product :path))) (js-call Buffer :from javascript))
          (js-call assert :strictEqual (get (aref (get product :modules) 0) :sha256) (compilerDigest javascript))
          (js-call assert :strictEqual (await (readFile (get (aref (get product :modules) 0) :sourceMapPath) "utf8")) map)
          (js-call assert :strictEqual (get (await (readCompilerMetadata (join directory "javascript" "product.json"))) :identitySha256)
            (get product :identitySha256)))
        (let* ((typed (js-object :abi "memory-u32" :value -0))
               (debug (js-object :source "中\ud800" :zero -0))
               (input (js-object :target "wasm" :entry "entry.mjs" :abi "memory-u32" :typed typed :debug debug
                 :bytes (js-array 0 97 115 109 1 0 0 0)))
               (product (await (archiveProduct input "wasm" (join directory "wasm")))))
          (js-call assert :deepStrictEqual (Array/from (await (readFile (get product :path)))) (get input :bytes))
          (js-call assert :deepStrictEqual (await (readCompilerMetadata (get product :debugPath))) debug)
          (js-call assert :deepStrictEqual (get product :typed) typed)
          (js-call assert :notStrictEqual (get product :typed) typed))
        (let ((invalid (js-array
          (js-object :target "native" :bytes (js-array))
          (js-object :target "wasm" :bytes (js-array 256))
          (js-object :target "wasm" :bytes (js-array) :abi "memory-u32" :typed (js-object))
          (js-object :target "wasm" :bytes (js-array))
          (js-object :target "javascript" :entry "missing.mjs" :modules (js-array (js-object :id "entry.mjs" :javascript "")))
          (js-object :target "javascript" :entry "entry.mjs" :modules (js-array (js-object :id "../escape" :javascript ""))))) (index 0))
          (while (< index (js-length invalid))
            (let ((input (aref invalid index)))
              (await (js-call assert :rejects (archiveProduct input (get input :target) (join directory (+ "invalid-" index))))))
            (setq index (1+ index)))))))))

  (test "binary archival owns its pre-IO snapshot and preserves exact metadata after caller mutation"
    (async ()
      (await (workspace (async (directory)
        (let* ((typed (js-object :abi "memory-u32" :body (js-array (js-object :value -0 :text "中😀\ud800"))))
               (descriptor (js-object :functions (js-array) :source "原始描述"))
               (debug (js-object :source "原始源码\udc00" :positions (js-array 1 2 3)))
               (input (js-object :target "native" :entry "entry.mjs" :typed typed :descriptor descriptor :debug debug
                 :bytes (js-array 0 255 17) :nativeTarget "arm64-macos" :nativeFormat "library"))
               (before (globalThis.structuredClone input))
               (pending (archiveProduct input "native" (join directory "snapshot"))))
          ;; archiveProduct must capture the full input before its first await.
          (put (aref (get typed :body) 0) :text "caller edit")
          (put (aref (get typed :body) 0) :value 42)
          (put descriptor :source "caller descriptor edit")
          (put debug :source "caller debug edit")
          (put (get input :bytes) 0 99)
          (let ((product (await pending)))
            (js-call assert :deepStrictEqual (get product :typed) (get before :typed))
            (js-call assert :deepStrictEqual (get product :descriptor) (get before :descriptor))
            (js-call assert :deepStrictEqual (get product :debug) (get before :debug))
            (js-call assert :deepStrictEqual (Array/from (await (readFile (get product :path)))) (get before :bytes))
            (js-call assert :deepStrictEqual (await (readCompilerMetadata (join directory "snapshot" "typed.json"))) (get before :typed))
            (js-call assert :deepStrictEqual (await (readCompilerMetadata (join directory "snapshot" "descriptor.json"))) (get before :descriptor))
            (js-call assert :deepStrictEqual (await (readCompilerMetadata (get product :debugPath))) (get before :debug))
            ;; Returned metadata owns the detached snapshot; editing either
            ;; side later cannot change the caller or already saved bytes.
            (put (aref (get (get product :typed) :body) 0) :text "returned edit")
            (put (get product :descriptor) :source "returned descriptor edit")
            (put (get product :debug) :source "returned debug edit")
            (js-call assert :strictEqual (get (aref (get typed :body) 0) :text) "caller edit")
            (js-call assert :strictEqual (get descriptor :source) "caller descriptor edit")
            (js-call assert :strictEqual (get debug :source) "caller debug edit")
            (js-call assert :deepStrictEqual (await (readCompilerMetadata (join directory "snapshot" "typed.json"))) (get before :typed))
            (js-call assert :deepStrictEqual (await (readCompilerMetadata (join directory "snapshot" "descriptor.json"))) (get before :descriptor))
            (js-call assert :deepStrictEqual (await (readCompilerMetadata (get product :debugPath))) (get before :debug)))))))))

  (defasync original-gate-fixture (plan run)
    (await (workspace (async (directory)
      (let ((paths (js-array "bootstrap/compiler" "bootstrap/backends" "bootstrap/host" "bootstrap/runtime" "evidence")) (index 0))
        (while (< index (js-length paths)) (await (mkdir (resolve directory (aref paths index)) (js-object :recursive t))) (setq index (1+ index))))
      (let ((literals (await (loadLiteralSources))) (index 0))
        (while (< index (js-length literals))
          (let* ((record (aref literals index)) (output (resolve directory (get record :filename))))
            (await (mkdir (resolve output "..") (js-object :recursive t))) (await (writeFile output (get record :source))))
          (setq index (1+ index))))
      (await (writeFile (resolve directory "bootstrap/host/compiler-session.eli") "(export)"))
      (await (writeFile (resolve directory "bootstrap/runtime/memory.eli") "; unit fixture runtime\n"))
      ;; The formal source graph includes the maintained Math support module.
      ;; Supply its real source in this isolated gate fixture as well.
      (await (mkdir (resolve directory "runtime") (js-object :recursive t)))
      (let ((math (await (readFile (resolve root "runtime/math.eli")))))
        (await (writeFile (resolve directory "runtime/math.eli") math))
        (js-call assert :deepStrictEqual (await (readFile (resolve directory "runtime/math.eli"))) math))
      (let* ((file "original-corpus.json") (bytes (js-call Buffer :from "{\"original\":\"unit fixture\"}\n")))
        (await (writeFile (resolve directory file) bytes))
        (let* ((corpus (js-object :document (js-object :originalGateEvidence (js-object :required t
                         :execution (js-object :provider "local" :command "make test-core" :applicationEvidence false)
                         :coverageIds (js-array "original-unit-locator")))
                       :originals (js-object :manifests (js-array (js-object :file file :sha256 (compilerDigest bytes))))))
               (options (js-object :sourceRoot directory :corpus corpus :directory (resolve directory "evidence")
                          :sourceIdentity (compilerSourceIdentity (await (loadCompilerSources (js-object :sourceRoot directory))))))
               (original-spawn (get child-process :spawn)) (calls 0))
          ;; Only the process transport is substituted in this tool unit test.
          ;; --full-grid below uses the unchanged real make test-core process.
          (try
            (progn
              (put child-process :spawn (lambda (command arguments settings)
                (setq calls (1+ calls))
                (js-call assert :strictEqual command "make")
                (js-call assert :deepStrictEqual arguments (js-array "test-core"))
                (js-call assert :strictEqual (get settings :cwd) directory)
                (js-call assert :deepStrictEqual (get settings :stdio) (js-array "ignore" "pipe" "pipe"))
                (js-call assert :strictEqual (get (get settings :env) :ELISCRIPT_SKIP_RETAINED_ACCEPTANCE) "0")
                (js-call (js-array "MAKEFLAGS" "GNUMAKEFLAGS" "MFLAGS" "BUN_TEST_RUNNER") :forEach
                  (lambda (name) (js-call assert :strictEqual (Object/hasOwn (get settings :env) name) false)))
                (let ((child (new EventEmitter)))
                  (put child :stdout (new EventEmitter)) (put child :stderr (new EventEmitter))
                  (funcall globalThis.queueMicrotask (async ()
                    (try
                      (progn
                        (when (get plan :beforeClose) (await (funcall (get plan :beforeClose) directory)))
                        (js-call (get child :stdout) :emit "data" (js-call Buffer :from (get plan :stdout "")))
                        (js-call (get child :stderr) :emit "data" (js-call Buffer :from (get plan :stderr "")))
                        (js-call child :emit "close" (get plan :exitCode 0) nil))
                      (catch error (js-call child :emit "error" error)))))
                  child)))
              (syncBuiltinESMExports)
              (await (funcall run options))
              (js-call assert :strictEqual calls (get plan :calls 1)))
            (finally (put child-process :spawn original-spawn) (syncBuiltinESMExports)))))))))

  (test "Eliscript matrix transports the original make core gate command with exact logs source binding and failure refusal"
    (async ()
      (await (original-gate-fixture (js-object :stdout "original-command-ran\n" :stderr "original-stderr\n")
        (async (options)
          (let ((result (await (runOriginalCompilerGates options))))
            (js-call assert :strictEqual (get result :status) "passed") (js-call assert :strictEqual (get result :exitCode) 0)
            (js-call assert :strictEqual (get result :signal) nil)
            (js-call assert :deepStrictEqual (get result :command) (js-array "make" "test-core"))
            (js-call assert :deepStrictEqual (get result :coverageIds) (js-array "original-unit-locator"))
            (let ((files (get result :files)) (index 0))
              (while (< index (js-length files))
                (let* ((record (aref files index)) (bytes (await (readFile (resolve (get options :directory) (get record :path))))))
                  (js-call assert :strictEqual (compilerDigest bytes) (get record :sha256))
                  (js-call assert :strictEqual (js-length bytes) (get record :bytes))) (setq index (1+ index))))
            (js-call assert :strictEqual (await (readFile (resolve (get options :directory) "original-gates.stdout.log") "utf8")) "original-command-ran\n")
            (js-call assert :strictEqual (await (readFile (resolve (get options :directory) "original-gates.stderr.log") "utf8")) "original-stderr\n")))))
      (await (original-gate-fixture (js-object :stderr "failed-original-assertion\n" :exitCode 7)
        (async (options) (let ((result (await (runOriginalCompilerGates options))))
          (js-call assert :strictEqual (get result :status) "failed") (js-call assert :notStrictEqual (get result :exitCode) 0)))))
      (let ((paths (js-array "bootstrap/runtime/memory.eli" "original-corpus.json")) (index 0))
        (while (< index (js-length paths))
          (let ((path (aref paths index)))
            (await (original-gate-fixture (js-object :beforeClose (async (directory)
                      (let ((file (resolve directory path)))
                        (await (writeFile file (+ (await (readFile file "utf8")) "\n; changed\n"))))))
              (async (options)
                (let ((result (await (runOriginalCompilerGates options))))
                  (js-call assert :strictEqual (get result :status) "failed")
                  (js-call assert :strictEqual (aref result (if (js-call path :endsWith ".eli") "sourceUnchanged" "manifestsUnchanged")) false))))))
          (setq index (1+ index))))
      (await (original-gate-fixture (js-object :calls 0)
        (async (options)
          (put (get (get (get options :corpus) :document) :originalGateEvidence) :execution
            (js-object :provider "local" :command "make test-applications" :applicationEvidence false))
          (await (js-call assert :rejects (runOriginalCompilerGates options)
            (lambda (error) (= (get error :message) "original compiler gate command differs from the stable core contract")))))))))

  (test "Eliscript matrix preserves a failed nine-cell manifest and cannot certify a declared grid without real generations or products"
    (async ()
      (await (workspace (async (directory)
        (let* ((sources (await (loadCompilerSources))) (identity (compilerSourceIdentity sources))
               (originals (await (loadOriginalCompilerManifests))) (grid-directory (join directory "grid"))
               (cells (js-array)) (comparisons (js-array)))
          (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (host)
            (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (target)
              (js-call cells :push (js-object :host host :target target :status "constructed" :execution "initialized"
                :artifact (js-object :productIdentity (js-object :sha256 (+ "claimed-" target)))))))))
          (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (target)
            (js-call comparisons :push (js-object :target target :status "identical"
              :identities (js-array (+ "claimed-" target) (+ "claimed-" target) (+ "claimed-" target))))))
          (await (mkdir grid-directory (js-object :recursive t)))
          (await (writeFile (join grid-directory "grid.json") (JSON/stringify
            (js-object :format "eliscript-independent-compiler-grid" :version 1 :sourceIdentity identity
              :cells cells :comparisons comparisons :identityVerification "identical"))))
          (let ((result (await (buildCompilerMatrix (js-object :outputRoot directory :corpusRecords (fixture-records originals)
                        :compilerGrid (js-object :directory grid-directory :canonicalArtifacts (js-array)))))))
            (js-call assert :strictEqual (get (get result :metadata) :status) "incomplete")
            (js-call assert :strictEqual (get (get result :metadata) :verification) "unverified")
            (js-call assert :strictEqual (js-length (get (get result :metadata) :cells)) 9)
            (js-call assert :ok (js-call (get (get result :metadata) :cells) :every (lambda (cell) (= (get cell :status) "failed"))))
            (js-call assert :strictEqual (get (get (get result :metadata) :compilerGrid) :generationsVerification) "unverified")
            (let* ((metadata (get result :metadata))
                   (saved (await (readCompilerMetadata (join (get result :directory) "matrix.json"))))
                   (expected (Object/create (Object/getPrototypeOf metadata) (Object/getOwnPropertyDescriptors metadata))))
              ;; The original JSON manifest omits this undefined own field;
              ;; every other field retains the same strict deep-value check.
              (js-call assert :strictEqual (Object/hasOwn metadata "bootstrapDirectory") t)
              (js-call assert :strictEqual (get metadata :bootstrapDirectory) undefined)
              (js-call assert :strictEqual (Object/hasOwn saved "bootstrapDirectory") false)
              (js-call assert :strictEqual (Reflect/deleteProperty expected "bootstrapDirectory") t)
              (js-call assert :deepStrictEqual saved expected))
            (js-call assert :strictEqual (get (get result :metadata) :originalGates) undefined))))))))

  (test "Eliscript matrix requests one real manifest per cell and preserves reader failures without certifying claimed evidence"
    (async ()
      (await (workspace (async (directory)
        (let* ((sources (await (loadCompilerSources))) (identity (compilerSourceIdentity sources))
               (originals (await (loadOriginalCompilerManifests))) (grid-directory (join directory "grid"))
               (hosts (js-array "javascript" "wasm" "native"))
               (cells (js-array)) (comparisons (js-array)) (records (js-array)))
          (js-call hosts :forEach (lambda (host)
            (js-call records :push (js-object :host host :metadataPath (join directory (+ host ".json"))
              :productIdentity (js-object :sha256 (+ "claimed-" host))))
            (js-call hosts :forEach (lambda (target)
              (js-call cells :push (js-object :host host :target target :status "constructed" :execution "initialized"
                :artifact (js-object :productIdentity (js-object :sha256 (+ "claimed-" target)))))))))
          (js-call hosts :forEach (lambda (target)
            (js-call comparisons :push (js-object :target target :status "identical"
              :identities (js-array (+ "claimed-" target) (+ "claimed-" target) (+ "claimed-" target))))))
          (await (mkdir grid-directory (js-object :recursive t)))
          (await (writeFile (join grid-directory "grid.json") (JSON/stringify
            (js-object :format "eliscript-independent-compiler-grid" :version 1 :sourceIdentity identity
              :cells cells :comparisons comparisons :identityVerification "identical"))))
          (let ((modes (js-array "throw" "wrong-host")) (mode-index 0))
            (while (< mode-index (js-length modes))
              (let* ((mode (aref modes mode-index)) (calls (js-array)) (active 0)
                     (reader (async (host)
                         (js-call assert :strictEqual active 0)
                         (setq active (1+ active)) (js-call calls :push host)
                         (try
                           (progn
                             (await (Promise/resolve))
                             (if (= mode "throw") (throw (new globalThis.Error (+ "manifest-reader-" host)))
                               (js-object :host (if (= host "native") "wasm" "native"))))
                           (finally (setq active (1- active))))))
                     (result (await (buildCompilerMatrix (js-object :outputRoot directory
                       :corpusRecords (fixture-records originals) :compilerGrid (js-object :directory grid-directory)
                       :compilerArtifactRecords records :readCompilerArtifact reader))))
                     (metadata (get result :metadata)))
                (js-call assert :deepStrictEqual calls
                  (js-array "javascript" "javascript" "javascript" "wasm" "wasm" "wasm" "native" "native" "native"))
                (js-call assert :strictEqual active 0)
                (js-call assert :strictEqual (get metadata :status) "incomplete")
                (js-call assert :strictEqual (get metadata :verification) "unverified")
                (js-call assert :strictEqual (get metadata :originalGates) undefined)
                (js-call assert :strictEqual (get (get metadata :compilerGrid) :generationsVerification) "unverified")
                (js-call assert :strictEqual (js-length (get metadata :cells)) 9)
                (js-call (get metadata :cells) :forEach (lambda (cell)
                  (js-call assert :strictEqual (get cell :status) "failed")
                  (js-call assert :strictEqual (get (get cell :failure) :message)
                    (if (= mode "throw") (+ "manifest-reader-" (get cell :host))
                      "loaded independent compiler has a different host")))))
              (setq mode-index (1+ mode-index))))))))))

  (test "an independent original corpus cell rejects invalid hosts targets and ambiguous producer inputs before loading a compiler"
    (async ()
      (await (workspace (async (directory)
        (let ((options (js-object :outputRoot directory :host "unknown" :target "javascript"
                         :metadataPath (join directory "must-not-read.json"))))
          (await (js-call assert :rejects (runCompilerMatrixCell options)
            (lambda (error) (= (get error :message) "compiler host must be javascript, wasm or native"))))
          (put options :host "javascript") (put options :target "unknown")
          (await (js-call assert :rejects (runCompilerMatrixCell options)
            (lambda (error) (= (get error :message) "compiler host must be javascript, wasm or native"))))
          (put options :target "native")
          (put options :compilerArtifact (js-object :host "javascript"))
          (await (js-call assert :rejects (runCompilerMatrixCell options)
            (lambda (error) (= (get error :name) "TypeError"))))
          (js-call assert :deepStrictEqual (await (readdir directory)) (js-array))))))))

  (test "one failed cell retains the complete default original corpus and current sources without certifying the other eight cells or generations"
    (async ()
      (await (workspace (async (directory)
        (let* ((corpus (await (loadCompilerMatrixCorpus)))
               (identity (compilerSourceIdentity (await (loadCompilerSources))))
               (missing (join directory "missing-wasm-producer.json"))
               (phases (js-array))
               (result (await (runCompilerMatrixCell (js-object :outputRoot directory :sourceRoot root
                         :host "wasm" :target "native" :metadataPath missing
                         :onStage (async (event) (js-call phases :push (get event :phase)))))))
               (metadata (get result :metadata)) (cell (get result :cell))
               (saved (await (readCompilerMetadata (join (get result :directory) "matrix.json")))))
          ;; Only the producer is absent; the source/corpus hashes come from
          ;; the actual retained repository inputs, with no reduced recipe.
          (js-call assert :strictEqual (get metadata :format) "eliscript-independent-compiler-matrix-cell")
          (js-call assert :strictEqual (get metadata :version) 1)
          (js-call assert :strictEqual (get metadata :scope) "single-cell")
          (js-call assert :deepStrictEqual (get metadata :sourceIdentity) identity)
          (js-call assert :deepStrictEqual (get metadata :corpusIdentity)
            (Object/assign (js-object) (get corpus :identity)
              (js-object :recordsSha256 (get corpus :recordsSha256))))
          (js-call assert :deepStrictEqual (get (get metadata :corpusIdentity) :coverageIds)
            (get (get corpus :identity) :coverageIds))
          (js-call assert :deepStrictEqual (get (get metadata :corpusIdentity) :expectedIds)
            (get (get corpus :identity) :expectedIds))
          (js-call assert :deepStrictEqual (get (get metadata :corpusIdentity) :manifests)
            (get (get corpus :identity) :manifests))
          (js-call assert :deepStrictEqual (get (get metadata :corpusIdentity) :adapterEvidence)
            (get (get corpus :identity) :adapterEvidence))
          (js-call assert :deepStrictEqual (get (get metadata :corpusIdentity) :missingCaseAdapters)
            (get (get corpus :identity) :missingCaseAdapters))
          (js-call assert :strictEqual (get (get metadata :corpusIdentity) :recordsSha256)
            (get corpus :recordsSha256))
          (js-call assert :strictEqual (js-length (get metadata :cells)) 1)
          (js-call assert :strictEqual cell (aref (get metadata :cells) 0))
          (js-call assert :strictEqual (get cell :host) "wasm")
          (js-call assert :strictEqual (get cell :target) "native")
          (js-call assert :strictEqual (get cell :status) "failed")
          ;; A failed load never implies a completed close. Final source and
          ;; corpus checks remain observable even when no session was opened.
          (js-call assert :strictEqual (get cell :cleanupStatus) "not-opened")
          (js-call assert :deepStrictEqual phases
            (js-array "source-verify-start" "source-verify-complete"
                      "corpus-verify-start" "corpus-verify-complete" "cell-complete"))
          (js-call assert :deepStrictEqual
            (await (readCompilerMetadata (join (get result :directory) "progress.json")))
            (js-object :host "wasm" :target "native" :phase "corpus-verify-complete"))
          (js-call assert :strictEqual (get (get cell :failure) :code) "ENOENT")
          (js-call assert :ok (js-call (get (get cell :failure) :message) :includes "missing-wasm-producer.json"))
          (js-call assert :strictEqual (get metadata :verification) "unverified")
          (js-call assert :strictEqual (Object/hasOwn metadata "originalGates") false)
          (js-call (js-array "finalGridVerification" "crossCellVerification" "generationsVerification") :forEach
            (lambda (field)
              (js-call assert :strictEqual (get metadata field) "unverified")
              (js-call assert :strictEqual (get saved field) "unverified")))
          (js-call assert :deepStrictEqual (get saved :sourceIdentity) identity)
          (js-call assert :deepStrictEqual (get saved :corpusIdentity) (get metadata :corpusIdentity))
          (js-call assert :deepStrictEqual (get saved :cells) (get metadata :cells))))))))

  ;; This is the full integration gate: it constructs the real three
  ;; self-host chains and nine compilers, executes every retained record and
  ;; invokes the unchanged original make gate. It has no substitute corpus,
  ;; mocked session or reduced source graph. Register it only at the explicit
  ;; final integration entry: node tests/compiler-matrix-selfhosted.test.mjs --full-grid.
  ;; Ordinary tool regressions do not claim that the complete grid has run.
  (when (js-call (get globalThis.process :argv) :includes "--full-grid")
    (test "Eliscript matrix executes all original programs through three real generations and nine source-bound compiler cells"
    (async ()
      (await (workspace (async (directory)
        (let* ((result (await (buildCompilerMatrix (js-object :outputRoot directory :sourceRoot root :generations 3))))
               (metadata (get result :metadata)) (cells (get metadata :cells)) (grid (get metadata :compilerGrid)))
          (js-call assert :strictEqual (get metadata :status) "consistent")
          (js-call assert :strictEqual (get metadata :verification) "equivalent")
          (js-call assert :strictEqual (get grid :generationsVerification) "identical")
          (js-call assert :strictEqual (get grid :identityVerification) "identical")
          (js-call assert :strictEqual (js-length cells) 9)
          (js-call assert :strictEqual (get (new globalThis.Set (js-call cells :map
            (lambda (cell) (+ (get cell :host) "-to-" (get cell :target))))) :size) 9)
          (js-call assert :ok (js-call cells :every (lambda (cell)
            (and (= (get cell :status) "constructed") (> (js-length (get cell :records)) 0)
              (= (get cell :cleanupStatus) "closed")
              (js-call (get cell :records) :every (lambda (record) (= (get record :verification) "equivalent")))))))
          (let ((index 0))
            (while (< index (js-length cells))
              (let* ((cell (aref cells index))
                     (progress (await (readCompilerMetadata
                       (join (get result :directory) (+ (get cell :host) "-to-" (get cell :target)) "progress.json")))))
                (js-call assert :strictEqual (get progress :phase) "session-close-complete")
                (js-call assert :strictEqual (get progress :count) (js-length (get cell :records)))
                (let ((records (get cell :records)) (position 0))
                  (while (< position (js-length records))
                    (let* ((record (aref records position))
                           (progress (await (readCompilerMetadata (join (get record :directory) "progress.json")))))
                      ;; Completion follows execution, comparison and the
                      ;; original saved outcome, never just product emission.
                      (js-call assert :strictEqual (get progress :phase) "record-complete")
                      (js-call assert :strictEqual (get progress :id) (get record :id)))
                    (setq position (1+ position)))))
              (setq index (1+ index))))
          (js-call assert :ok (js-call (get metadata :comparisons) :every (lambda (comparison) (= (get comparison :status) "identical"))))
          (js-call assert :deepStrictEqual (get (get metadata :corpusIdentity) :missingCaseAdapters) (js-array))
          (js-call assert :strictEqual (get metadata :originalGateVerification) "passed")
          (js-call assert :deepStrictEqual (get (get metadata :originalGates) :command) (js-array "make" "test-core"))
          (js-call assert :strictEqual (get metadata :sourceUnchanged) t)
          (js-call assert :strictEqual (get metadata :originalCorpusUnchanged) t)
          (js-call assert :deepStrictEqual (await (readCompilerMetadata (join (get result :directory) "matrix.json"))) metadata))))))))
)
