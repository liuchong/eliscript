(module tests.managed-array-construction
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm readdir mkdir writeFile)
  (import "node:path" resolve relative)
  (import "node:module" createRequire)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/managed-browser-transport.mjs" loadManagedReference runManagedNode bundleManagedBrowserPage serveManagedBrowserPage)
  (import "playwright-core" chromium firefox webkit)
  (defvar directory undefined) (defvar b undefined) (defvar runtime undefined) (defvar family undefined)
  (defvar generation-evidence undefined)
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve root ".eliscript-array-construction-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (setq family (await (readFile "tests/fixtures/wasm-managed-array-construction.eli" "utf8")))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defasync compiled (&rest supplied)
    (let* ((source (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) family (aref supplied 0)))
           (options (if (> (js-length supplied) 1) (aref supplied 1) undefined))
           (rt (if (or (< (js-length supplied) 3) (undefined? (aref supplied 2))) runtime (aref supplied 2)))
           (p (js-call (get b :compiler) :compile_ir_string (str "(defconst construction-marker 1)\n" source) "construction.eli"))
           (before (JSON/stringify p))
           (bytes (globalThis.Uint8Array.from (js-call (get b :managed) :emit_managed_wasm p rt))))
      (js-call assert :strictEqual (JSON/stringify p) before)
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let ((a (instantiateManagedRuntime bytes options)))
        (js-call a :auto 1)
        (js-object :a a :js (await (loadManagedReference directory (js-call (get b :compiler) :emit_ir_string p) "construction")) :bytes bytes))))
  (defun read (a value)
    (cond ((and value (= (get value :kind) 4)) (js-call a :readNumber value))
          ((and value (= (get value :kind) 5)) (js-call a :readString value))
          ((and value (= (get value :kind) 14))
            (let ((out (js-array)) (index 0))
              (while (< index (js-call a :length value))
                (let ((item (js-call a :get value index)))
                  (js-call out :push (read a item)) (js-call a :release item))
                (setq index (1+ index))) out)) (t value)))
  (defun finish (a &rest supplied)
    (let ((values (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-array) (aref supplied 0))))
      (js-call values :forEach (lambda (value) (js-call a :release value))))
    (js-call a :closeModule) (js-call a :collect)
    (js-call assert :strictEqual (js-call a :live) 0)
    (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))
  (defun diagnostic (code)
    (lambda (error) (and (get error :eliscriptDiagnostic)
      (= (get (get error :eliscriptDiagnostic) :code) code))))
  (defun box (a value)
    (cond ((= (value-type value) "number") (js-call a :number value))
          ((= (value-type value) "string") (js-call a :string value)) (t value)))

  (test "Array.of and Array.from are first-class pure WASM builtins with dense independent output"
    (async ()
      (let* ((c (await (compiled))) (a (get c :a))
             (empty (js-call a :invoke "empty-of")) (number (js-call a :number -0.0))
             (text (js-call a :string "中😀")) (object (js-call a :sourceObject (js-object)))
             (values (js-array undefined nil false t number text object))
             (out (js-call a :invoke "of" values)))
        (js-call assert :strictEqual (js-call a :invoke "identities") t)
        (js-call assert :strictEqual (js-call a :length empty) 0)
        (js-call assert :strictEqual (js-call a :length out) (js-length values))
        (let ((index 0))
          (while (< index (js-length values))
            (let ((key (js-call a :number index)))
              (js-call assert :strictEqual (js-call a :invoke "own" (js-array out key)) t)
              (js-call a :release key))
            (let ((value (js-call a :get out index)))
              (js-call assert :strictEqual (js-call a :keyEqual value (aref values index)) t)
              (js-call a :release value))
            (setq index (1+ index))))
        (let ((copy (js-call a :invoke "direct" (js-array out))))
          (js-call assert :strictEqual (js-call a :keyEqual out copy) false)
          (finish a (js-array empty number text object out copy))))))

  (test "Array.from densifies holes, preserves references, and iterates Unicode code points including lone surrogates"
    (async ()
      (let* ((c (await (compiled))) (a (get c :a)) (object (js-call a :sourceObject (js-object)))
             (values (js-array object undefined undefined))
             (_hole (Reflect/deleteProperty values "1")) (items (js-call a :sourceArray values)))
        (js-call (js-array "from" "direct" "member") :forEach (lambda (name)
          (let ((out (js-call a :invoke name (js-array items))) (index 0))
            (js-call assert :strictEqual (js-call a :length out) 3)
            (while (< index 3)
              (let ((key (js-call a :number index)))
                (js-call assert :strictEqual (js-call a :invoke "own" (js-array out key)) t)
                (js-call a :release key)) (setq index (1+ index)))
            (let ((first (js-call a :get out 0)))
              (js-call assert :strictEqual (js-call a :keyEqual first object) t)
              (js-call a :release first))
            (js-call assert :strictEqual (js-call a :get out 1) undefined)
            (js-call a :release out))))
        (js-call (js-array "" "A😀中" "\ud800x\udfff" "😀\ud800😀") :forEach (lambda (text)
          (let* ((input (js-call a :string text)) (out (js-call a :invoke "from" (js-array input))))
            (js-call assert :deepStrictEqual (read a out) (Array/from text))
            (js-call a :release input) (js-call a :release out))))
        (finish a (js-array object items)))))

  (test "Array.from supports array-like objects with inherited indices and exact ToLength coercion"
    (async ()
      (let* ((source "(module arraylike (defun run (length) (let* ((parent (js-object :0 \"inherited\")) (x (js-object :__proto__ parent))) (put x :length length) (put x 1 \"own\") (Array/from x))) (defun coerce () (let ((trace (js-object :n 0))) (js-array (Array/from (js-object :length (js-object :valueOf (lambda () (put trace :n (1+ (get trace :n))) 2.9)) :0 \"a\")) (get trace :n)))) (export run coerce))")
             (c (await (compiled source))) (a (get c :a)) (js (get c :js)))
        (js-call (js-array undefined nil false t globalThis.NaN -0.0 -1 (- globalThis.Infinity) 0.9 1 2.9 "2.8" "no") :forEach
          (lambda (length)
            (let* ((n (box a length)) (out (js-call a :invoke "run" (js-array n))))
              (js-call assert :deepStrictEqual (read a out) (js-call js :run length))
              (js-call a :release n) (js-call a :release out))))
        (let ((out (js-call a :invoke "coerce")))
          (js-call assert :deepStrictEqual (read a out) (js-call js :coerce))
          (finish a (js-array out))))))

  (test "Array.from maps values and indices, validates empty-input mappers, and evaluates ignored extra arguments"
    (async ()
      (let* ((source "(module effects (defun run () (let ((trace (js-object :n 0))) (js-array (Array/from (js-array 4 5) (lambda (x i) (put trace :n (+ (* (get trace :n) 10) x)) (+ x i)) (put trace :n 1) (put trace :n 2)) (get trace :n)))) (defun bad (x) (Array/from x false)) (defun no-input () (Array/from)) (export run bad no-input))")
             (c (await (compiled source))) (a (get c :a)) (js (get c :js)) (out (js-call a :invoke "run")))
        (js-call assert :deepStrictEqual (read a out) (js-call js :run))
        (js-call (js-array (js-call a :sourceArray (js-array)) (js-call a :sourceObject (js-object)) nil undefined) :forEach
          (lambda (value)
            (js-call assert :throws (lambda () (js-call a :invoke "bad" (js-array value))) (diagnostic "ELI-RT0003"))
            (js-call a :release value)))
        (js-call assert :throws (lambda () (js-call a :invoke "no-input")) (diagnostic "ELI-RT0003"))
        (finish a (js-array out)))))

  (test "Array.from consumes live Map, Set and iterator sources with exactly two mapper arguments"
    (async ()
      (let* ((source "(module live (defun run (map-p) (let* ((items (if map-p (new globalThis.Map (js-array (js-array \"a\" 1) (js-array \"b\" 2))) (new globalThis.Set (js-array \"a\" \"b\")))) (result (Array/from items (lambda (value index &rest rest) (when (= index 0) (js-call items :delete \"b\") (if map-p (js-call items :set \"c\" 3) (js-call items :add \"c\"))) (js-array value index (js-length rest)))))) result)) (defun grow () (let ((items (js-array 1))) (Array/from items (lambda (x i) (when (= i 0) (js-call items :push 2)) x)))) (export run grow))")
             (c (await (compiled source))) (a (get c :a)) (js (get c :js)))
        (js-call (js-array t false) :forEach (lambda (map)
          (let ((out (js-call a :invoke "run" (js-array map))))
            (js-call assert :deepStrictEqual (read a out) (js-call js :run map)) (js-call a :release out))))
        (let ((out (js-call a :invoke "grow")))
          (js-call assert :deepStrictEqual (read a out) (js-call js :grow)) (finish a (js-array out))))))

  (test "Array.from caches an own next method once and closes the iterator on mapper failure"
    (async ()
      (let* ((source "(module protocol (defun run () (let* ((iterator (js-call (js-array 1 2) :values)) (n 0)) (put iterator :next (lambda () (setq n (1+ n)) (put iterator :next false) (js-object :done (> n 2) :value n))) (Array/from iterator))) (defun fail (trace) (let ((iterator (js-call (js-array 1 2) :values))) (put iterator :return (lambda () (put trace :closed 1) (js-object))) (Array/from iterator (lambda (x i) (js-call nil :charAt))))) (export run fail))")
             (c (await (compiled source))) (a (get c :a)) (js (get c :js)) (out (js-call a :invoke "run"))
             (trace (js-call a :sourceObject (js-object))))
        (js-call assert :deepStrictEqual (read a out) (js-call js :run))
        (js-call assert :throws (lambda () (js-call a :invoke "fail" (js-array trace))) (diagnostic "ELI-RT0003"))
        (let* ((key (js-call a :string "closed")) (closed (js-call a :objectGet trace key)))
          (js-call assert :strictEqual (js-call a :readNumber closed) 1)
          (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0)
          (finish a (js-array out trace key closed))))))

  (test "array-like length is captured once, indexed values stay live, and nested construction preserves roots"
    (async ()
      (let* ((source "(module snapshots (defun run () (let ((x (js-object :length 3 :0 1 :1 2 :2 3))) (Array/from x (lambda (value index) (when (= index 0) (put x :length 1) (put x 1 9)) (js-array value index (Array/of value)))))) (export run))")
             (c (await (compiled source))) (a (get c :a)) (js (get c :js)) (out (js-call a :invoke "run")))
        (js-call assert :deepStrictEqual (read a out) (js-call js :run)) (finish a (js-array out)))))

  (test "bad mapper validation precedes length conversion, ignored arguments run, and ordinary Array methods capture the original callee"
    (async ()
      (let* ((source (str "(module ordering\n"
               " (defun bad (trace) (Array/from (js-object :length (js-object :valueOf (lambda () (put trace :converted 1) 0))) false (put trace :extra 1)))\n"
               " (defun shadow (Array trace) (Array/from (progn (put Array :from false) (put trace :visited 1)) (put trace :visited 2) (put trace :visited 3)))\n"
               " (defun factory () (lambda (&rest values) values)) (export bad shadow factory))"))
             (c (await (compiled source))) (a (get c :a)) (trace (js-call a :sourceObject (js-object))))
        (js-call assert :throws (lambda () (js-call a :invoke "bad" (js-array trace))) (diagnostic "ELI-RT0003"))
        (let* ((converted (js-call a :string "converted")) (extra (js-call a :string "extra"))
               (effect (js-call a :objectGet trace extra)) (function (js-call a :invoke "factory"))
               (host (js-call a :sourceObject (js-object :from function)))
               (out (js-call a :invoke "shadow" (js-array host trace))))
          (js-call assert :strictEqual (js-call a :objectGet trace converted) undefined)
          (js-call assert :strictEqual (js-call a :readNumber effect) 1)
          (js-call assert :deepStrictEqual (read a out) (js-array 1 2 3))
          (js-call (js-array nil undefined) :forEach (lambda (receiver)
            (let ((clean (js-call a :sourceObject (js-object))) (key (js-call a :string "visited")))
              (let ((caller (js-call a :frame 1)))
                (js-call a :frameSet caller 0 clean)
                (try
                  (js-call assert :throws (lambda () (js-call a :invoke "shadow" (js-array receiver clean)))
                    (lambda (error) (and (js-call globalThis.TypeError globalThis.Symbol.hasInstance error) (funcall (diagnostic "ELI-RT0001") error))))
                  (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
                  (finally (js-call a :leaveFrame caller))))
              (js-call assert :strictEqual (js-call a :objectGet clean key) undefined)
              (js-call a :release key) (js-call a :release clean))))
          (finish a (js-array trace converted extra effect function host out))))))

  (test "iterator next failures do not close, mapper failures close once, and return errors never mask the original diagnostic"
    (async ()
      (let* ((source (str "(module closing\n"
               " (defun next-error (trace) (let ((i (js-call (js-array 1) :values))) (put i :return (lambda () (put trace :closed 1) (js-object))) (put i :next (lambda () (js-call nil :charAt))) (Array/from i)))\n"
               " (defun mapper-error (trace mode) (let ((i (js-call (js-array 1 2) :values))) (put i :return (lambda () (put trace :closed (1+ (get trace :closed 0))) (if mode (js-call nil :charAt) false))) (Array/from i (lambda (x index) (put i :next false) (js-call 1 :toString 1)))))\n"
               " (defun bad-next (next) (let ((i (js-call (js-array) :values))) (put i :next next) (Array/from i)))\n"
               " (defun primitive-step () (let ((i (js-call (js-array) :values))) (put i :next (lambda () false)) (Array/from i))) (export next-error mapper-error bad-next primitive-step))"))
             (c (await (compiled source))) (a (get c :a)) (key (js-call a :string "closed")))
        (js-call (js-array "next-error" "mapper-error") :forEach (lambda (name)
          (js-call (js-array t false) :forEach (lambda (mode)
            (let ((trace (js-call a :sourceObject (js-object))))
              (js-call assert :throws (lambda () (js-call a :invoke name (js-array trace mode)))
                (diagnostic (if (= name "next-error") "ELI-RT0003" "ELI-RT0010")))
              (let ((count (js-call a :objectGet trace key)))
                (js-call assert :strictEqual (read a count) (if (= name "next-error") undefined 1))
                (js-call a :release count))
              (js-call a :release trace)
              (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))))))
        (js-call (js-array undefined nil t false) :forEach (lambda (value)
          (js-call assert :throws (lambda () (js-call a :invoke "bad-next" (js-array value))) (diagnostic "ELI-RT0003"))))
        (js-call assert :throws (lambda () (js-call a :invoke "primitive-step")) (diagnostic "ELI-RT0003"))
        (finish a (js-array key)))))

  (test "native iterator clear and reinsertion remain live and a partially consumed iterator starts at its current cursor"
    (async ()
      (let* ((source (str "(module cursor\n"
               " (defun run () (let* ((s (new globalThis.Set (js-array \"a\" \"b\"))) (i (js-call s :values))) (js-call i :next) (Array/from i (lambda (value index) (when (= index 0) (js-call s :clear) (js-call s :add \"b\") (js-call s :add \"c\")) value))))\n"
               " (defun shrink () (let ((x (js-array 1 2 3))) (Array/from x (lambda (value index) (put x :length 1) value)))) (export run shrink))"))
             (c (await (compiled source))) (a (get c :a)) (js (get c :js)))
        (js-call (js-array "run" "shrink") :forEach (lambda (name)
          (let ((out (js-call a :invoke name)))
            (js-call assert :deepStrictEqual (read a out) (js-call js name)) (js-call a :release out))))
        (finish a))))

  (test "raw construction rejects invalid handles, private frames, malformed argv, unsupported raw inputs and unsealed strings without losing caller roots"
    (async ()
      (let* ((c (await (compiled))) (a (get c :a)) (bytes (get c :bytes)))
        (finish a)
        (let* ((exports (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
               (heap (js-call exports "heap-new" 64 8192 65536))
               (call (lambda (name &rest arguments)
                 (let ((value (uint32 (Reflect/apply (get exports name) exports (js-call (js-array heap) :concat arguments)))))
                   (js-call assert :strictEqual (js-call exports "last-error") 0 name) value)))
               (arguments (funcall call "value-refs" 7 1)) (caller (funcall call "frame-new" 3))
               (raw (funcall call "value-refs" 7 0)) (text (funcall call "value-string" 1)))
          (funcall call "frame-set" caller 0 arguments) (funcall call "frame-set" caller 1 raw)
          (funcall call "frame-set" caller 2 text) (funcall call "heap-auto" 1)
          (js-call (js-array (js-array 4294967295 1 0 1) (js-array caller 3 0 1)
                            (js-array arguments 0 0 3) (js-array arguments 1 2 3)) :forEach
            (lambda (row)
              (js-call assert :strictEqual (js-call exports "value-array-construction" heap (aref row 0) (aref row 1) (aref row 2)) 0)
              (js-call assert :strictEqual (js-call exports "last-error") (aref row 3))
              (js-call assert :strictEqual (funcall call "frame-depth") 1)))
          (js-call (js-array (js-array 4294967295 1) (js-array caller 3) (js-array raw 3) (js-array text 6)) :forEach
            (lambda (row)
              (js-call (new globalThis.DataView (get (get exports :memory) :buffer))
                :setUint32 (funcall call "value-data" arguments 7) (aref row 0) t)
              (js-call assert :strictEqual (js-call exports "value-array-construction" heap arguments 1 0) 0)
              (js-call assert :strictEqual (js-call exports "last-error") (aref row 1))
              (js-call assert :strictEqual (funcall call "frame-depth") 1)))
          (funcall call "frame-pop" caller) (funcall call "heap-collect")
          (js-call assert :strictEqual (funcall call "heap-live") 0)))))

  (test "capacity limits and ToLength infinity report allocation failure and recover without leaked private frames"
    (async ()
      (let* ((c (await (compiled undefined (js-object :maxSlots 128 :initialBytes 8192 :maxBytes 65536))))
             (a (get c :a)) (values (js-array)))
        (js-call (js-array globalThis.Infinity 9007199254740991 67108855 1000000) :forEach
          (lambda (length)
            (let* ((size (js-call a :number length)) (input (js-call a :sourceObject (js-object :length size))))
              (js-call assert :throws (lambda () (js-call a :invoke "from" (js-array input))) (diagnostic "ELI-RT0002"))
              (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0)
              (js-call a :release input) (js-call a :release size))))
        (try (while (< (js-length values) 128) (js-call values :push (js-call a :number (js-length values))))
          (catch error (js-call assert :strictEqual (get (get error :eliscriptDiagnostic) :code) "ELI-RT0002")))
        (js-call assert :throws (lambda () (js-call a :invoke "of" values)) (diagnostic "ELI-RT0002"))
        (js-call values :forEach (lambda (value) (js-call a :release value)))
        (let ((out (js-call a :invoke "empty-of")))
          (js-call assert :strictEqual (js-call a :length out) 0) (finish a (js-array out))))))

  (test "real construction traps unwind to the caller and a prior mapper error prevents the later trap"
    (async ()
      (let* ((source "(defun run (x) (Array/from x)) (defun bad (x) (Array/from x false)) (export run bad)")
             (c (await (compiled source))))
        (finish (get c :a))
        (let* ((text (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
               (start (js-call text :indexOf "  (defun heap-source-array-prototype-static-new "))
               (end (js-call text :indexOf "  (defun heap-source-array-prototype-static-map " start)))
          (js-call assert :ok (and (>= start 0) (> end start)))
          (let* ((rt (js-call (get b :compiler) :compile_ir_string
                   (str (js-call text :slice 0 start)
                     "  (defun heap-source-array-prototype-static-new (heap constructor length iterator) (load-u32 4294967295))\n"
                     (js-call text :slice end)) "construction-trap.eli"))
                 (broken (get (await (compiled source undefined rt)) :a))
                 (input (js-call broken :sourceArray (js-array t false))) (caller (js-call broken :frame 1)))
            (js-call broken :frameSet caller 0 input)
            (js-call assert :throws (lambda () (js-call broken :invoke "run" (js-array input))) globalThis.WebAssembly.RuntimeError)
            (js-call assert :strictEqual (get (js-call broken :stats) :frameDepth) 1)
            (js-call assert :deepStrictEqual (read broken input) (js-array t false))
            (js-call assert :throws (lambda () (js-call broken :invoke "bad" (js-array input))) (diagnostic "ELI-RT0003"))
            (js-call assert :strictEqual (get (js-call broken :stats) :frameDepth) 1)
            (js-call broken :leaveFrame caller) (finish broken (js-array input)))))))

  (test "fixed-seed sparse arrays and UTF16 strings differentially match the original JS builtins under collecting WASM"
    (async ()
      (let* ((c (await (compiled))) (a (get c :a)) (seed 448035891))
        (letfn ((next () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223)))))
          (let ((iteration 0))
            (while (< iteration 256)
              (let ((values (new globalThis.Array (% (next) 24))) (index 0))
                (while (< index (js-length values))
                  (when (/= (% (next) 3) 0)
                    (put values index (if (/= (% (next) 2) 0) undefined (/= (% (next) 2) 0))))
                  (setq index (1+ index)))
                (let* ((input (js-call a :sourceArray values)) (out (js-call a :invoke "from" (js-array input))))
                  (js-call assert :deepStrictEqual (read a out) (Array/from values))
                  (setq index 0)
                  (while (< index (js-length values))
                    (let ((key (js-call a :number index)))
                      (js-call assert :strictEqual (js-call a :invoke "own" (js-array out key)) t)
                      (js-call a :release key)) (setq index (1+ index)))
                  (js-call a :release out) (js-call a :release input)))
              (let ((text "") (index 0) (length (% (next) 20)))
                (while (< index length)
                  (setq text (str text (String/fromCharCode (bit-and (next) 65535))))
                  (setq index (1+ index)))
                (let* ((string (js-call a :string text)) (split (js-call a :invoke "from" (js-array string))))
                  (js-call assert :deepStrictEqual (read a split) (Array/from text))
                  (js-call a :release string) (js-call a :release split)))
              (setq iteration (1+ iteration)))))
        (finish a))))

  (test "Node consumes identical zero-import construction bytes with Unicode, sparse arrays, first-class aliases and root cleanup"
    (async ()
      (let* ((c (await (compiled))) (bytes (get c :bytes)))
        (finish (get c :a))
        (let ((result (runManagedNode (resolve root "tests/helpers/managed-array-construction-node.mjs") (js-array)
                        (js-object :input (globalThis.Buffer.from bytes) :encoding "utf8" :timeout 30000))))
          (js-call assert :strictEqual (get result :status) 0 (get result :stderr))))))

  (defun construction-target () nil)
  (test "the migrated project sorting helper preserves generic JS iterable and array-like behavior and compiles independently to WASM"
    (async ()
      (let* ((compiler (get b :compiler))
             (program (js-call compiler :compile_ir_string (await (readFile "bootstrap/compiler/project.eli" "utf8")) "project.eli")))
        (letfn ((flatten (nodes)
                  (js-call nodes :flatMap (lambda (node)
                    (if (= (get node :kind) "module-declaration") (flatten (get node :children)) (js-array node))))))
          (let* ((node (js-call (flatten (get program :body)) :find (lambda (item) (= (get item :value) "sorted-set-values"))))
                 (span (get node :span))
                 (unit (Object/assign (js-object) program (js-object :body (js-array node
                   (js-object :kind "export-declaration" :value nil :span span :children
                     (js-array (js-object :kind "reference" :value "sorted-set-values" :span span :children (js-array))))))))
                 (reference (await (loadManagedReference directory (js-call compiler :emit_ir_string unit) "project-sort")))
                 (function (get reference :sorted_set_values))
                 (iterable (js-object)))
            (js-call assert :strictEqual (get node :kind) "variable-declaration")
            (js-call assert :strictEqual (get (aref (get node :children) 0) :kind) "function-expression")
            (js-call assert :strictEqual (get function :length) 1)
            (js-call assert :strictEqual (Object/hasOwn function "prototype") false)
            (js-call assert :throws (lambda () (Reflect/construct construction-target (js-array) function)) globalThis.TypeError)
            (put iterable globalThis.Symbol.iterator (lambda ()
              (let ((index 0) (values (js-array "z" "a")))
                (js-object :next (lambda ()
                  (let ((position index)) (setq index (1+ index))
                    (js-object :done (>= position 2) :value (aref values position))))))))
            (js-call (js-array (new globalThis.Set (js-array "z" "a" "b"))
                              (new globalThis.Map (js-array (js-array "z" 2) (js-array "a" 1)))
                              "😀az" (js-object :length 3 :0 "z" :2 "a") (lambda (a b) nil) iterable)
              :forEach (lambda (input)
                (js-call assert :deepStrictEqual (funcall function input) (js-call (Array/from input) :sort))))
            (js-call (js-array (js-array) (js-array undefined) (js-array nil)) :forEach (lambda (arguments)
              (js-call assert :throws (lambda () (Reflect/apply function undefined arguments)) globalThis.TypeError)))
            (let* ((bytes (globalThis.Uint8Array.from (js-call (get b :managed) :emit_managed_wasm unit runtime)))
                   (a (instantiateManagedRuntime bytes)))
              (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
              (js-call a :auto 1)
              (let* ((z (js-call a :string "z")) (x (js-call a :string "a")) (size (js-call a :number 3))
                     (input (js-call a :sourceObject (js-object :length size :0 z :2 x)))
                     (out (js-call a :invoke "sorted-set-values" (js-array input))))
                (js-call assert :deepStrictEqual (read a out) (js-array "a" "z" undefined))
                (finish a (js-array z x size input out)))))))))

  (test "unsupported constructor rebinding models are rejected with their original source locations"
    (async ()
      ;; The original rebinding input is now supported. Keep executing it and
      ;; require its actual JS result instead of restoring an obsolete refusal.
      (let* ((source (str
               "(defun run (x constructor) (js-call (get globalThis.Array :from) :call constructor x))\n"
               "(defun Constructor (length) (js-object :requested length))\n"
               "(defun observed (constructible) (let* ((input (js-object :length 2 :0 \"x\" :1 \"y\")) (constructor (if constructible Constructor (lambda () nil))) (out (run input constructor))) (js-array (Array/isArray out) (get out :requested) (get out :length) (get out 0) (get out 1) (eq (Object/getPrototypeOf out) (if constructible globalThis.Object.prototype globalThis.Array.prototype)))))\n"
               "(defun function-input () (Array/from (lambda (a b) nil)))\n"
               "(export run observed function-input)"))
             (c (await (compiled source))) (a (get c :a)) (js (get c :js)))
        (js-call (js-array t false) :forEach (lambda (constructible)
          (let ((out (js-call a :invoke "observed" (js-array constructible))))
            (js-call assert :deepStrictEqual (read a out) (js-call js :observed constructible))
            (js-call a :release out))))
        (js-call (js-array undefined nil false) :forEach (lambda (constructor)
          (let* ((input (js-call a :sourceArray (js-array t false)))
                 (out (js-call a :invoke "run" (js-array input constructor))))
            (js-call assert :deepStrictEqual (read a out) (js-call js :run (js-array t false) constructor))
            (js-call a :release input) (js-call a :release out))))
        (let ((out (js-call a :invoke "function-input")))
          (js-call assert :deepStrictEqual (read a out) (js-call js :function_input))
          (js-call assert :deepStrictEqual (read a out) (js-array undefined undefined))
          (finish a (js-array out))))
      (let* ((program (js-call (get b :compiler) :compile_ir_string
               "(defun run () (new globalThis.WeakRef (js-object))) (export run)" "construction-protocol.eli")))
        (js-call assert :throws (lambda () (js-call (get b :managed) :emit_managed_wasm program runtime))
          (lambda (error) (and (get error :eliscriptDiagnostic)
            (= (get (get error :eliscriptDiagnostic) :code) "ELI-B0001")
            (= (get (get (get error :eliscriptDiagnostic) :location) :file) "construction-protocol.eli")))))))

  (defasync generations ()
    (if generation-evidence generation-evidence
      (let* ((files (js-call (js-call (await (readdir "bootstrap/compiler")) :filter
                       (lambda (file) (js-call file :endsWith ".eli"))) :sort))
             (all (js-array b)) (previous b) (index 0) (numbers (js-array 2 3)))
        (while (< index 2)
          (let* ((output (resolve directory (str "g" (aref numbers index)))) (bootstrap (resolve output "bootstrap"))
                 (file-index 0) (previous-compiler (get previous :compiler)))
            (await (mkdir bootstrap (js-object :recursive t)))
            (while (< file-index (js-length files))
              (let* ((file (aref files file-index)) (path (resolve "bootstrap/compiler" file))
                     (name (js-call file :replace (new globalThis.RegExp "\\.eli$") ".mjs"))
                     (emission (js-call previous-compiler :compile_string_with_source_map
                       (await (readFile path "utf8")) path name (relative bootstrap path))))
                (await (writeFile (resolve bootstrap name) (str (get emission :javascript) "//# sourceMappingURL=" name ".map\n")))
                (await (writeFile (resolve bootstrap (str name ".map")) (get emission :sourceMap))))
              (setq file-index (1+ file-index)))
            (let* ((current (await (buildBackends (js-object :outputRoot output :frontend previous-compiler))))
                   (path (resolve bootstrap "compiler.mjs")))
              (put current :compiler (funcall (createRequire path) path))
              (js-call all :push current) (setq previous current)))
          (setq index (1+ index)))
        (let* ((filename (resolve "tests/fixtures/wasm-managed-array-construction.eli"))
               (seed-file (resolve directory "array-construction-seed.mjs"))
               (seed (spawnSync (resolve "bin/eliscript-seed") (js-array "--output" seed-file filename)
                       (js-object :encoding "utf8" :timeout 30000)))
               (javascript (await (readFile seed-file "utf8"))) (bytes (js-array)))
          (js-call assert :strictEqual (get seed :status) 0 (get seed :stderr))
          (let ((position 0))
            (while (< position (js-length all))
              (let* ((current (aref all position)) (compiler (get current :compiler))
                     (program (js-call compiler :compile_ir_string family filename))
                     (rt (js-call compiler :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli")))
                (js-call assert :strictEqual (js-call compiler :emit_ir_string program) javascript)
                (js-call bytes :push (globalThis.Uint8Array.from (js-call (get current :managed) :emit_managed_wasm program rt))))
              (setq position (1+ position))))
          (js-call assert :deepStrictEqual (aref bytes 0) (aref bytes 1))
          (js-call assert :deepStrictEqual (aref bytes 1) (aref bytes 2))
          (setq generation-evidence (js-object :all all :bytes (aref bytes 2) :javascript javascript :filename filename))))))

  (test "public Seed and three full compiler generations produce identical array construction JS and WASM bytes"
    (async ()
      (let* ((evidence (await (generations)))
             (js (await (loadManagedReference directory (get evidence :javascript) "construction-generation")))
             (a (instantiateManagedRuntime (get evidence :bytes))))
        (js-call a :auto 1)
        (let ((out (js-call a :invoke "exercise")))
          (js-call assert :deepStrictEqual (read a out) (js-call js :exercise)) (finish a (js-array out))))) 30000)

  (test "browser compiler emits identical construction bytes and runs the shared fixture without host imports"
    (async ()
      (let* ((evidence (await (generations)))
             (bundle (await (bundleManagedBrowserPage (resolve root "tests/helpers/managed-array-construction-page.mjs")
               (js-object "eliscript-test/compiler" (resolve directory "g3/bootstrap/compiler.mjs")
                          "eliscript-test/managed" (resolve directory "g3/backends/managed.mjs")))))
             (server (serveManagedBrowserPage bundle (get evidence :javascript)))
             (name (get (get globalThis.process :env) :ELISCRIPT_TEST_BROWSER "chromium"))
             (engines (js-object :chromium chromium :firefox firefox :webkit webkit)) (browser undefined))
        (js-call assert :ok (Object/hasOwn engines name))
        (try
          (setq browser (await (js-call (get engines name) :launch)))
          (let ((page (await (js-call browser :newPage))))
            (await (js-call page :goto (get (get server :url) :href)))
            (await (js-call page :waitForFunction (lambda () (get globalThis.globalThis :__eliscriptConstructionCase))))
            (let ((bytes (await (js-call page :evaluate
                          (async (input) (await (funcall (get globalThis.globalThis :__eliscriptConstructionCase) input)))
                          (js-object :source family :runtime (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                            :seed (get evidence :javascript) :filename (get evidence :filename))))))
              (js-call assert :deepStrictEqual (globalThis.Uint8Array.from bytes) (get evidence :bytes))))
          (finally (try (when browser (await (js-call browser :close)))
            (finally (js-call server :stop t))))))) 30000)

  (test "the represented well-known Symbol key is accepted at the original iterator protocol boundary"
    (async ()
      (let* ((c (await (compiled "(defun run (x) (get x globalThis.Symbol.iterator)) (export run)")))
             (a (get c :a)) (object (js-call a :sourceObject (js-object))))
        (js-call assert :strictEqual (js-call a :invoke "run" (js-array object)) undefined)
        (finish a (js-array object)))))
)
