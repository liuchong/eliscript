(module tests.final-functional-scope
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp writeFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "node:stream" PassThrough)
  (import "../dist/bootstrap/compiler.mjs" :as compiler)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/testing/final-functional-scope.mjs" cancelledCompilerHostCases
    functionalScopePattern runFinalFunctionalScope runFunctionalChild)
  (import "../tools/testing/fixture-environment.mjs" fixtureChildArguments prepareFixtureEnvironment)

  (defconst package-file "tests/compiler-package-session.test.mjs")
  (defconst tools-file "tests/compiler-session-tools.test.mjs")
  (defconst sequence-file "tests/wasm-managed-sequence-data.test.mjs")
  (defconst ingress-file "tests/compiler-ir-session-ingress.test.mjs")
  (defconst record-grid-file "tests/record-grid-selfhosted.test.mjs")
  (defconst artifact-archive-file "tests/compiler-artifact-archive-selfhosted.test.mjs")
  (defconst persistent-literals-file "tests/wasm-managed-persistent-literals.test.mjs")
  (defun sha (source) (js-call (js-call (createHash "sha256") :update source) :digest "hex"))
  (defasync cases (file) (cancelledCompilerHostCases file (await (readFile (resolve root file) "utf8"))))

  (test "the measured complete artifact archive and persistent literal files run serially under the outer guard while neighboring files retain their original supervisor"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-artifact-archive-scope-"))))
             (file (str "./" artifact-archive-file))
             (literals (str "./" persistent-literals-file))
             (before "./tests/plain-before.test.mjs")
             (after (js-array "./tests/compiler-artifact-archive-copy-selfhosted.test.mjs"
               "./tests/compiler-source-archive-streaming.test.mjs"
               "./tests/wasm-managed-persistent-literals-copy.test.mjs"))
             (inventory (js-call (js-array before file literals) :concat after))
             (trace (js-array)) (active false)
             (failure (js-object :file file :exitCode 7))
             (literal-failure (js-object :file literals :exitCode 9))
             (environment (Object/assign (js-object) (get globalThis.process :env)
               (js-object :ORIGINAL_ARCHIVE_SCOPE_MARKER "complete😀")))
             (executors (js-object
               :ordinary (async (files env)
                 (js-call assert :strictEqual active false)
                 (setq active t)
                 (js-call trace :push (js-array "ordinary-start" files))
                 (await (Promise/resolve undefined))
                 (js-call trace :push (js-array "ordinary-end" files))
                 (setq active false)
                 (js-object :results (js-call files :map (lambda (name) (js-object :file name :exitCode 0))) :exitCode 0))
               :mixed (async () (js-call assert :fail "artifact archive and persistent literals have no cancelled compiler hosts"))
               :sequence (async (plan env)
                 (js-call assert :strictEqual active false)
                 (setq active t)
                 (js-call assert :strictEqual (js-call (js-array file literals) :includes (get plan :file)) t)
                 (js-call assert :strictEqual (get plan :pattern) undefined)
                 (js-call assert :deepStrictEqual (get plan :cancelled) (js-array))
                 (js-call assert :strictEqual (get env :ORIGINAL_ARCHIVE_SCOPE_MARKER) "complete😀")
                 (js-call assert :strictEqual (get env :ELISCRIPT_TEST_FIXTURE_PRELOAD) "1")
                 (js-call trace :push (js-array "sequence-start" (get plan :file)))
                 (await (Promise/resolve undefined))
                 (js-call trace :push (js-array "sequence-end" (get plan :file)))
                 (setq active false) (if (= (get plan :file) file) failure literal-failure)))))
        (try
          (let* ((result (await (runFinalFunctionalScope inventory (js-object :sourceRoot root
                   :outputDirectory directory :environment environment :executors executors))))
                 (saved (JSON/parse (await (readFile (get result :archive) "utf8")))))
            (js-call assert :deepStrictEqual trace (js-array
              (js-array "ordinary-start" (js-array before)) (js-array "ordinary-end" (js-array before))
              (js-array "sequence-start" file) (js-array "sequence-end" file)
              (js-array "sequence-start" literals) (js-array "sequence-end" literals)
              (js-array "ordinary-start" after) (js-array "ordinary-end" after)))
            (js-call assert :deepStrictEqual (get result :inventory) inventory)
            (js-call assert :strictEqual (aref (get result :results) 1) failure)
            (js-call assert :strictEqual (aref (get result :results) 2) literal-failure)
            (js-call assert :strictEqual (get result :exitCode) 9)
            (js-call assert :deepStrictEqual (get result :cancelled) (js-array))
            (js-call assert :deepStrictEqual (get result :unstarted) (js-array))
            (js-call assert :deepStrictEqual (get saved :results) (get result :results)))
          (let ((count (js-length trace))
                (cancelled (await (runFinalFunctionalScope (js-array file literals) (js-object :sourceRoot root
                  :outputDirectory directory :environment environment :executors executors :cancellation (js-object :code 143))))))
            (js-call assert :strictEqual (js-length trace) count)
            (js-call assert :strictEqual (get cancelled :exitCode) 143)
            (js-call assert :deepStrictEqual (get cancelled :results) (js-array))
            (js-call assert :deepStrictEqual (get cancelled :unstarted) (js-array file literals)))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "complete package sessions retain every active case and exact cancellation pattern under the existing outer guard"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-package-scope-"))))
             (cancelled (await (cases package-file))) (calls 0))
        (try
          (let ((result (await (runFinalFunctionalScope (js-array package-file)
            (js-object :sourceRoot root :outputDirectory directory :executors (js-object
              :ordinary (async () (js-call assert :fail "package session must remain isolated"))
              :mixed (async () (js-call assert :fail "package session must retain its measured outer allowance"))
              :sequence (async (plan environment)
                (setq calls (1+ calls))
                (js-call assert :strictEqual (get plan :file) package-file)
                (js-call assert :strictEqual (get plan :pattern) (functionalScopePattern cancelled))
                (js-call assert :deepStrictEqual (get plan :cancelled) cancelled)
                (js-object :file package-file :exitCode 7))))))))
            (js-call assert :strictEqual calls 1)
            (js-call assert :strictEqual (get result :exitCode) 7)
            (js-call assert :deepStrictEqual (get result :cancelled) cancelled)
            (js-call assert :deepStrictEqual (get result :unstarted) (js-array)))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "measured large literal and wire files keep every case under the existing outer build guard"
    (async ()
      (let* ((files (js-array "./tests/literal-runtime.test.mjs" "./tests/wasm-managed-wire-selfhosted.test.mjs"))
             (directory (await (mkdtemp (resolve (tmpdir) "eliscript-large-runtime-scope-"))))
             (seen (js-array)))
        (try
          (let ((result (await (runFinalFunctionalScope files
            (js-object :sourceRoot root :outputDirectory directory :executors (js-object
              :ordinary (async () (js-call assert :fail "these measured files exceed the inner eight GiB ceiling"))
              :mixed (async () (js-call assert :fail "runtime files have no cancelled compiler hosts"))
              :sequence (async (plan environment)
                (js-call seen :push (get plan :file))
                (js-call assert :strictEqual (get plan :pattern) undefined)
                (js-call assert :deepStrictEqual (get plan :cancelled) (js-array))
                (js-call assert :strictEqual (get environment :ELISCRIPT_TEST_FIXTURE_PRELOAD) "1")
                (js-object :file (get plan :file) :exitCode (if (= (js-length seen) 1) 9 0)))))))))
            (js-call assert :deepStrictEqual seen files)
            (js-call assert :deepStrictEqual (get result :unstarted) (js-array))
            (js-call assert :deepStrictEqual (get result :cancelled) (js-array))
            (js-call assert :strictEqual (get result :exitCode) 9)
            (js-call assert :deepStrictEqual (js-call (get result :results) :map (lambda (row) (get row :exitCode))) (js-array 9 0)))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "complete response negotiation retains every original mode under the outer controlled build guard"
    (async ()
      (let* ((file "tests/compiler-response-events.test.mjs")
             (directory (await (mkdtemp (resolve (tmpdir) "eliscript-response-scope-"))))
             (calls 0)
             (executors (js-object
               :ordinary (async () (js-call assert :fail "complete negotiation must retain the outer build allowance"))
               :mixed (async () (js-call assert :fail "response negotiation has no cancelled hosts"))
               :sequence (async (plan environment)
                 (setq calls (1+ calls))
                 (js-call assert :strictEqual (get plan :file) file)
                 (js-call assert :strictEqual (get plan :pattern) undefined)
                 (js-call assert :deepStrictEqual (get plan :cancelled) (js-array))
                 (js-object :file file :exitCode 11)))))
        (try
          (let ((result (await (runFinalFunctionalScope (js-array file)
            (js-object :sourceRoot root :outputDirectory directory :executors executors)))))
            (js-call assert :strictEqual calls 1)
            (js-call assert :strictEqual (get result :exitCode) 11)
            (js-call assert :deepStrictEqual (get result :unstarted) (js-array)))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "complete record grid uses the existing outer guard without cancelling any case or hiding a child failure"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-record-grid-scope-"))))
             (calls (js-array)) (first (js-object :file record-grid-file :exitCode 7
               :failure "child-start-failed" :message "original child startup failure"))
             (environment (Object/assign (js-object) (get globalThis.process :env) (js-object :ORIGINAL_SCOPE_MARKER "真实😀")))
             (executors (js-object
               :ordinary (async () (js-call assert :fail "record grid must not use the inner eight GiB supervisor"))
               :mixed (async () (js-call assert :fail "record grid has no cancelled compiler hosts"))
               :sequence (async (plan env)
                 (js-call calls :push (js-array plan env)) first))))
        (try
          (let ((result (await (runFinalFunctionalScope (js-array record-grid-file)
                          (js-object :sourceRoot root :outputDirectory directory :environment environment :executors executors)))))
            (js-call assert :strictEqual (js-length calls) 1)
            (js-call assert :strictEqual (get (aref (aref calls 0) 0) :file) record-grid-file)
            (js-call assert :strictEqual (get (aref (aref calls 0) 0) :pattern) undefined)
            (js-call assert :strictEqual (get (aref (aref calls 0) 1) :ORIGINAL_SCOPE_MARKER) "真实😀")
            (js-call assert :deepStrictEqual (get result :cancelled) (js-array))
            (js-call assert :strictEqual (aref (get result :results) 0) first)
            (js-call assert :strictEqual (get result :exitCode) 7))
          (let ((cancelled (await (runFinalFunctionalScope (js-array record-grid-file)
                            (js-object :sourceRoot root :outputDirectory directory :environment environment :executors executors
                              :cancellation (js-object :code 143))))))
            (js-call assert :strictEqual (js-length calls) 1)
            (js-call assert :strictEqual (get cancelled :exitCode) 143)
            (js-call assert :deepStrictEqual (get cancelled :results) (js-array))
            (js-call assert :deepStrictEqual (get cancelled :unstarted) (js-array record-grid-file))
            (js-call assert :deepStrictEqual (get cancelled :cancelled) (js-array)))
          (let* ((failure (new globalThis.Error "original monitor unavailable"))
                 (unmonitored (await (runFinalFunctionalScope (js-array tools-file)
                   (js-object :sourceRoot root :outputDirectory directory :environment environment :executors
                     (js-object :startSupervisor (async () (throw failure))))))))
            (js-call assert :strictEqual (get unmonitored :exitCode) 1)
            (js-call assert :strictEqual (get (aref (get unmonitored :results) 0) :failure) "resource-supervisor-unavailable")
            (js-call assert :strictEqual (get (aref (get unmonitored :results) 0) :message) (get failure :message)))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "IR ingress scope preserves all JavaScript compiler outputs and Worker identity while cancelling only the eight binary compiler hosts"
    (async ()
      (let* ((source (await (readFile (resolve root "tests/compiler-ir-session-ingress-test-legacy.mjs") "utf8")))
             (cancelled (cancelledCompilerHostCases ingress-file source))
             (pattern (new globalThis.RegExp (functionalScopePattern cancelled))))
        (js-call assert :strictEqual (js-length cancelled) 8)
        (js-call cancelled :forEach (lambda (item)
          (js-call assert :strictEqual (get item :sourceSha256) (sha source))
          (js-call assert :strictEqual (get item :status) "cancelled")
          (js-call assert :strictEqual (Object/hasOwn item "passed") false)
          (js-call assert :strictEqual (js-call pattern :test (get item :title)) false)
          (js-call assert :strictEqual (js-call pattern :test
            (js-call (get item :title) :replace (+ "complete " (get item :host) " compiler") "complete javascript compiler")) t)))
        (js-call assert :strictEqual (js-call pattern :test
          "Given two IR edits When Worker identities are calculated Then exact IR source units participate independently of the output target") t)
        (js-call assert :throws (lambda () (cancelledCompilerHostCases ingress-file (+ source "\n")))
          (new globalThis.RegExp "source identity changed")))))

  (test "final functional scope cancels exactly the authenticated binary compiler cases and retains all small user runtimes"
    (async ()
      (let* ((package-source (await (readFile (resolve root package-file) "utf8")))
             (cancelled (cancelledCompilerHostCases package-file package-source))
             (tools (await (cases tools-file)))
             (pattern (new globalThis.RegExp (functionalScopePattern cancelled))))
        (js-call assert :strictEqual (js-length cancelled) 27)
        (js-call assert :strictEqual (js-length tools) 1)
        (js-call assert :strictEqual (get (aref tools 0) :title)
          "a complete real managed compiler driver transports AggregateError graphs with shared errors and cause identity")
        (js-call assert :strictEqual (js-length (js-call cancelled :filter (lambda (item) (= (get item :host) "wasm")))) 16)
        (js-call assert :strictEqual (js-length (js-call cancelled :filter (lambda (item) (= (get item :host) "native")))) 11)
        (js-call cancelled :forEach (lambda (item)
          (js-call assert :strictEqual (get item :sourceSha256) (sha package-source))
          (js-call assert :strictEqual (get item :status) "cancelled")
          (js-call assert :strictEqual (Object/hasOwn item "passed") false)
          (js-call assert :strictEqual (js-call pattern :test (get item :title)) false)
          (js-call assert :strictEqual (js-call pattern :test (+ (get item :title) " unrelated")) t)))
        (js-call (js-array
          "small actual WASM source streams preserve identity-before-decode UTF8-before-JSON and invalid-encoding precedence without refetching decoded failures"
          "small source downloads retry original read failures share concurrent readers support legacy fallback and reject use after close"
          "small actual WASM HTTP package streams source chunks once per URL with strict UTF16 dual decoding and reader cleanup"
          "small real package loaders retain decoded sources and executable state without retaining their consumed whole-byte buffers in a bounded Node process"
          "complete javascript compiler JSON-UTF16 sources survive original and relocated package sessions in Node and Bun"
          "the public node CLI consumes original and relocated javascript compilers with exact input bytes and default assets"
          "Given the original and relocated javascript compiler When bun CLI request submits emit-memory-ir Then real products sidecars and recovery preserve their ABI")
          :forEach (lambda (title) (js-call assert :strictEqual (js-call pattern :test title) t)))
        (js-call assert :deepStrictEqual (cancelledCompilerHostCases "tests/unrelated-package.test.mjs" package-source) (js-array)))))

  (test "scope bindings reject a forged or modified same-name suite before dispatch without evaluating any test source"
    (async ()
      (let ((source (await (readFile (resolve root package-file) "utf8"))))
        (js-call assert :throws (lambda () (cancelledCompilerHostCases package-file (+ source "\n")))
          (new globalThis.RegExp "source identity changed"))
        (js-call assert :throws (lambda () (cancelledCompilerHostCases package-file
          (js-call source :replace "small actual WASM source streams" "forged actual WASM source streams")))
          (new globalThis.RegExp "source identity changed"))
        (js-call assert :strictEqual (functionalScopePattern (js-array)) undefined))))

  (test "scope dispatch preserves file sharding original monitor and environment and records cancellation separately from actual failures"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-functional-scope-"))))
             (inventory (js-array "./tests/plain-one.test.mjs" (+ "./" package-file)
                         (+ "./" sequence-file) "./tests/plain-two.test.mjs" (+ "./" tools-file)))
             (calls (js-array))
             (environment (Object/assign (js-object) (get globalThis.process :env)
               (js-object :ELISCRIPT_TEST_COMPILER_PACKAGE_DIRECTORY (resolve directory "stage3-package")
                 :ELISCRIPT_TEST_COMPILER_PACKAGE_SOURCE_ARTIFACT (resolve directory "stage3" "compiler-artifact.json"))))
             (executors (js-object
               :ordinary (async (files env)
                 (js-call calls :push (js-array "ordinary" files env))
                 (js-object :results (js-call files :map (lambda (file) (js-object :file file :exitCode 0))) :exitCode 0))
               :mixed (async (plan env)
                 (js-call calls :push (js-array "mixed" (get plan :file) (get plan :pattern) env))
                 (js-object :file (get plan :file) :exitCode 1))
               :sequence (async (plan env)
                 (js-call calls :push (js-array "sequence" (get plan :file) env))
                 (js-object :file (get plan :file) :exitCode 0)))))
        (try
          (let* ((options (js-object :sourceRoot root :outputDirectory directory :environment environment :executors executors))
                 (result (await (runFinalFunctionalScope inventory options)))
                 (saved (JSON/parse (await (readFile (get result :archive) "utf8")))))
            (js-call assert :strictEqual (get result :exitCode) 1)
            (js-call assert :strictEqual (js-length (get result :results)) 5)
            (js-call assert :strictEqual (js-length (get result :cancelled)) 28)
            (js-call assert :deepStrictEqual (get saved :cancelled) (get result :cancelled))
            (js-call assert :deepStrictEqual (get saved :unstarted) (js-array))
            (js-call assert :deepStrictEqual (js-call calls :map (lambda (item) (aref item 0)))
              (js-array "ordinary" "sequence" "sequence" "ordinary" "mixed"))
            (let ((child-environment (aref (aref calls 1) 2)))
              (js-call assert :notStrictEqual child-environment environment)
              (js-call assert :strictEqual (aref (aref calls 0) 2) child-environment)
              (js-call assert :strictEqual (aref (aref calls 2) 2) child-environment)
              (js-call assert :strictEqual (get child-environment :ELISCRIPT_TEST_COMPILER_PACKAGE_DIRECTORY)
                (get environment :ELISCRIPT_TEST_COMPILER_PACKAGE_DIRECTORY))
              (js-call assert :strictEqual (get child-environment :ELISCRIPT_TEST_COMPILER_PACKAGE_SOURCE_ARTIFACT)
                (get environment :ELISCRIPT_TEST_COMPILER_PACKAGE_SOURCE_ARTIFACT))
              (js-call assert :strictEqual (get child-environment :ELISCRIPT_TEST_FIXTURE_PRELOAD) "1"))
            (setq calls (js-array))
            (let ((shard (await (runFinalFunctionalScope
                    (js-call inventory :concat (js-array "--shard-index" "2" "--shard-count" "2")) options))))
              (js-call assert :deepStrictEqual (get shard :inventory)
                (js-array (+ "./" package-file) "./tests/plain-two.test.mjs"))
              (js-call assert :strictEqual (js-length (get shard :cancelled)) 27)
              (js-call assert :strictEqual (js-call calls :some (lambda (item) (= (aref item 0) "sequence"))) t)))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "default mixed functional dispatch retains its original scope under the authorized per-test deadline"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-functional-deadline-"))))
             (request undefined) (closed 0)
             (supervisor (js-object
               :run (async (value) (setq request value) (js-object :exitCode 0))
               :close (async () (setq closed (1+ closed)))
               :cancel (lambda (signal) (js-call assert :fail "unexpected cancellation")))))
        (try
          (let ((result (await (runFinalFunctionalScope (js-array tools-file)
                  (js-object :sourceRoot root :outputDirectory directory :executors
                    (js-object :startSupervisor (async () supervisor)))))))
            (js-call assert :strictEqual (get result :exitCode) 0)
            (js-call assert :strictEqual closed 1)
            (js-call assert :deepStrictEqual (get request :args)
              (fixtureChildArguments (js-array "--smol" "test" "--timeout" "300000" tools-file
                "--test-name-pattern" (functionalScopePattern (await (cases tools-file)))) (get request :env))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "cancellation while a mixed supervisor starts closes its own guard without starting the suite and retains the original signal code"
    (async ()
      (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-functional-cancel-")))) (index 0))
        (try
          (while (< index 2)
            (let* ((code (if (= index 0) 130 143)) (cancellation (js-object :code 0))
                   (mark-ready undefined) (release undefined)
                   (ready (new globalThis.Promise (lambda (complete) (setq mark-ready complete))))
                   (waiting (new globalThis.Promise (lambda (complete) (setq release complete))))
                   (runs 0) (closes 0)
                   (supervisor (js-object
                     :run (async (request) (setq runs (1+ runs)) (throw (new globalThis.Error "cancelled suite must not start")))
                     :close (async () (setq closes (1+ closes)))
                     :cancel (lambda (signal) (throw (new globalThis.Error "no workload exists before readiness")))))
                   (executors (js-object :startSupervisor (async () (funcall mark-ready) (await waiting))))
                   (pending (runFinalFunctionalScope (js-array (+ "./" tools-file))
                     (js-object :sourceRoot root :outputDirectory directory :executors executors :cancellation cancellation))))
              (await ready)
              (put cancellation :code code)
              (funcall release supervisor)
              (let* ((result (await pending)) (saved (JSON/parse (await (readFile (get result :archive) "utf8")))))
                (js-call assert :strictEqual runs 0)
                (js-call assert :strictEqual closes 1)
                (js-call assert :strictEqual (get result :exitCode) code)
                (js-call assert :strictEqual (get (aref (get result :results) 0) :exitCode) code)
                (js-call assert :strictEqual (get (aref (get result :results) 0) :started) false)
                (js-call assert :deepStrictEqual (get result :unstarted) (js-array (+ "./" tools-file)))
                (js-call assert :strictEqual (get saved :exitCode) code)
                (js-call assert :strictEqual (get (aref (get saved :cancelled) 0) :status) "cancelled")))
            (setq index (1+ index)))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "argument rejection and a real child preserve original stdout stderr and exit status without a synthetic pass"
    (async ()
      (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
             (directory (get fixture :directory))
             (environment (get fixture :environment)))
        (try
          (await (js-call assert :rejects (runFinalFunctionalScope (js-array "--unknown")) globalThis.TypeError))
          (let ((index 0))
            (while (< index 2)
              (let* ((file (resolve directory (+ "original-" index ".test.mjs")))
                     (source (str "(import \"bun:test\" test)\n"
                       "(test \"original child case\" (lambda () "
                       "(js-call globalThis.console :log \"original-output\") "
                       "(js-call globalThis.console :error \"original-error-output\") "
                       (if (= index 0) "nil" "(throw (new globalThis.Error \"original child failure\"))") "))"))
                     (stdout (new PassThrough)) (stderr (new PassThrough))
                     (out "") (err ""))
                (js-call stdout :on "data" (lambda (chunk) (setq out (+ out (js-call chunk :toString)))))
                (js-call stderr :on "data" (lambda (chunk) (setq err (+ err (js-call chunk :toString)))))
                (await (writeFile file (js-call compiler :compile_string source "functional-child.eli")))
                (let ((result (await (runFunctionalChild file (js-array "--smol" "test" "--timeout" "300000" file)
                                (js-object :sourceRoot root :environment environment :stdout stdout :stderr stderr)))))
                  (js-call assert :strictEqual (get result :exitCode) index
                    (str "original child " index " stdout:\n" out "\nstderr:\n" err))
                  (js-call assert :ok (js-call out :includes "original-output"))
                  (js-call assert :ok (js-call err :includes "original-error-output"))
                  (when (= index 1) (js-call assert :ok (js-call err :includes "original child failure")))))
              (setq index (1+ index))))
          (finally (js-call fixture :close))))))
)
