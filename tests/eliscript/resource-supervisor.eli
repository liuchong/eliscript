(module tests.resource-supervisor
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "../tools/testing/resource-supervisor.mjs" readProcessSnapshot startResourceSupervisor)
  (defconst birth "Fri Oct 16 08:00:00 2026")
  (defun valid-snapshot () (str "100 1 100 7 " birth " node private-token"))
  (defun timeout-error () (Object/assign (new globalThis.Error "snapshot deadline")
    (js-object :code "ETIMEDOUT" :signal "SIGTERM" :killed t)))
  (test "the generated supervisor completes real IPC handshakes for successive owned jobs and closes cleanly"
    (async ()
      (let* ((started (js-array))
             (supervisor (await (startResourceSupervisor
               (js-object :onStart (lambda (message) (js-call started :push (get message :id))))))))
        (try
          (let ((ids (js-array "first-handshake" "second-handshake")) (index 0))
            (while (< index (js-length ids))
              (let* ((id (aref ids index))
                     (result (await (js-call supervisor :run
                       (js-object :id id :file "supervisor-handshake"
                         :command "node" :args (js-array "--version")
                         :cwd (js-call globalThis.process :cwd) :env (get globalThis.process :env))))))
                (js-call assert :strictEqual (get result :id) id)
                (js-call assert :strictEqual (get result :exitCode) 0)
                (js-call assert :strictEqual (get supervisor :failure) nil))
              (setq index (1+ index)))
            (js-call assert :deepStrictEqual started ids))
          (finally (await (js-call supervisor :close)))))))
  (test "a transient bounded ps timeout retries once and returns only a fresh authenticated snapshot"
    (async ()
      (let ((calls 0) (rows undefined))
        (let ((execute (lambda (command arguments options callback)
            (setq calls (1+ calls))
            (js-call assert :strictEqual command "ps")
            (js-call assert :deepStrictEqual arguments (js-array "-axo" "pid=,ppid=,pgid=,rss=,lstart=,args="))
            (js-call assert :strictEqual (get options :timeout) 3000)
            (js-call assert :strictEqual (get options :maxBuffer) (* 16 1024 1024))
            (if (= calls 1) (funcall callback (timeout-error) "")
              (funcall callback nil (valid-snapshot))))))
          (setq rows (await (readProcessSnapshot (js-object :pid 100 :execute execute)))))
        (js-call assert :strictEqual calls 2)
        (js-call assert :strictEqual (get (js-call rows :get 100) :rssBytes) 7168))))
  (test "persistent snapshot timeout is finite and retains command code signal killed and attempts"
    (async ()
      (let ((calls 0) (last nil))
        (await (js-call assert :rejects
          (readProcessSnapshot (js-object :pid 100 :execute (lambda (command arguments options callback)
            (setq calls (1+ calls)) (setq last (timeout-error)) (funcall callback last ""))))
          (lambda (error)
            (js-call assert :strictEqual calls 3)
            (js-call assert :strictEqual (get error :code) "ETIMEDOUT")
            (js-call assert :strictEqual (get error :signal) "SIGTERM")
            (js-call assert :strictEqual (get error :killed) t)
            (js-call assert :strictEqual (get error :attempts) 3)
            (js-call assert :strictEqual (get error :cause) last)
            (js-call assert :match (get error :message) (new globalThis.RegExp "resource monitor unavailable")) t))))))
  (test "invalid snapshots and nontransient execution errors fail immediately without stale data fallback"
    (async ()
      (let ((modes (js-array "invalid" "empty" "missing-self" "execution")) (index 0))
        (while (< index (js-length modes))
        (let ((mode (aref modes index)) (calls 0))
          (await (js-call assert :rejects
            (readProcessSnapshot (js-object :pid 100 :execute (lambda (command arguments options callback)
              (setq calls (1+ calls))
              (if (= mode "execution")
                (funcall callback (Object/assign (new globalThis.Error "ps denied")
                  (js-object :code "EACCES" :signal nil :killed false)) "")
                (funcall callback nil (cond ((= mode "invalid") "malformed") ((= mode "empty") "")
                  (t (str "101 1 101 1 " birth " another process"))))))))
            (lambda (error)
              (js-call assert :strictEqual calls 1)
              (js-call assert :strictEqual (get error :attempts) 1)
              (when (= mode "execution")
                (js-call assert :strictEqual (get error :code) "EACCES")
                (js-call assert :strictEqual (get error :killed) false)) t))))
        (setq index (1+ index))))))
)
