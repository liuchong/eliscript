(module tests.backend-cli-isolation
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" copyFile mkdir mkdtemp readFile readdir realpath rm symlink writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawn)
  (import "node:module" createRequire)
  (import "../tools/integrity/check.mjs" checkRepositoryIntegrity)
  (defvar directory undefined)
  (defvar root undefined)
  (defvar scratch undefined)
  (defvar input undefined)
  (defvar outcomes undefined)
  (defvar integrityFailure undefined)
  (defun cli (target output &rest supplied)
    (let ((source (if (undefined? (aref supplied 0)) input (aref supplied 0)))
          (environment (if (undefined? (aref supplied 1)) (js-object) (aref supplied 1))))
      (new globalThis.Promise (lambda (accept reject)
        (let* ((child (spawn "bun" (js-array (resolve root "tools/backends/compile.mjs") "--abi" "numeric-f64" "--target" target "-o" output source)
                       (js-object :cwd root :env (Object/assign (js-object) (get globalThis.process :env) (js-object :TMPDIR scratch) environment)
                         :stdio (js-array "ignore" "pipe" "pipe") :timeout 30000)))
               (stderr ""))
          (js-call (get child :stdout) :resume)
          (js-call (get child :stderr) :on "data" (lambda (chunk) (setq stderr (+ stderr chunk))))
          (js-call child :on "error" reject)
          (js-call child :on "close" (lambda (code signal) (funcall accept (js-object :code code :signal signal :stderr stderr)))))))))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-cli-isolation-")))
      root (resolve directory "checkout") scratch (resolve directory "scratch"))
    (await (mkdir (resolve root "tools/backends") (js-object :recursive t)))
    (await (mkdir (resolve root "dist/bootstrap") (js-object :recursive t)))
    (await (mkdir scratch))
    (await (mkdir (resolve root "bin")))
    (await (copyFile (resolve "bin/eliscript-bootstrap") (resolve root "bin/eliscript-bootstrap")))
    (let ((names (js-array "compile.mjs" "build.mjs")) (index 0))
      (while (< index (js-length names))
        (await (copyFile (resolve "tools/backends" (aref names index)) (resolve root "tools/backends" (aref names index))))
        (setq index (1+ index))))
    (let ((names (js-array "compiler" "bootstrap" "runtime")) (index 0))
      (while (< index (js-length names))
        (await (symlink (resolve (aref names index)) (resolve root (aref names index)) "dir")) (setq index (1+ index))))
    ;; The public launcher loads this maintained Emacs helper before the seed.
    ;; Link its actual source so the intended later package failure is reached.
    (let ((names (js-array "bootstrap-seed.el" "bootstrap-runtime.el")) (index 0))
      (while (< index (js-length names))
        (let ((source (resolve "tools" (aref names index))) (target (resolve root "tools" (aref names index))))
          (await (symlink source target))
          (js-call assert :strictEqual (await (realpath target)) (await (realpath source)))
          (js-call assert :strictEqual (await (readFile target "utf8")) (await (readFile source "utf8"))))
        (setq index (1+ index))))
    (await (writeFile (resolve root "dist/bootstrap/compiler.mjs") "// unrelated existing build cache\n"))
    (setq input (resolve directory "input.eli"))
    (await (writeFile input "(defun f (value) (+ value 1)) (export f)"))
    (setq outcomes (await (Promise/all (js-array (cli "js" (resolve directory "out.mjs")) (cli "wasm" (resolve directory "out.wasm"))))))
    (let ((contract (JSON/parse (await (readFile (resolve "contracts/repository-integrity.json") "utf8")))))
      (try (await (checkRepositoryIntegrity (js-object :root root :contract contract :trackedFiles (js-array) :dependenciesOnly t)))
        (catch error (setq integrityFailure error))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (test "Given concurrent independent CLI requests, when JS and WASM compile, then both exact outputs execute"
    (async ()
      (js-call outcomes :forEach (lambda (result)
        (js-call assert :strictEqual (get result :code) 0 (get result :stderr)) (js-call assert :strictEqual (get result :signal) nil)))
      (let* ((filename (resolve directory "out.mjs")) (js (funcall (createRequire filename) filename))
             (wasm (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module (await (readFile (resolve directory "out.wasm")))))))
        (js-call (js-array -0 0 7 globalThis.NaN globalThis.Infinity globalThis.Number.MIN_VALUE) :forEach
          (lambda (value) (js-call assert :ok (Object/is (js-call (get wasm :exports) :f value) (js-call js :f value))))))))
  (test "Given an existing checkout cache, when the standalone CLI finishes, then unrelated cached contents remain unchanged"
    (async ()
      (js-call assert :strictEqual (await (readFile (resolve root "dist/bootstrap/compiler.mjs") "utf8")) "// unrelated existing build cache\n")
      (js-call assert :deepStrictEqual (await (readdir scratch)) (js-array))))
  (test "Given rejected source, when the standalone CLI fails, then no output or private build directory remains"
    (async ()
      (let ((source (resolve directory "invalid.eli")) (output (resolve directory "invalid.wasm")))
        (await (writeFile source "(defun f (value) \"unsupported\") (export f)"))
        (let ((result (await (cli "wasm" output source))))
          (js-call assert :notStrictEqual (get result :code) 0) (js-call assert :strictEqual (get result :signal) nil)
          (js-call assert :match (get result :stderr) (new globalThis.RegExp "ELI-B0001"))
          (js-call assert :strictEqual (await (js-call (js-call globalThis.Bun :file output) :exists)) false)
          (js-call assert :deepStrictEqual (await (readdir scratch)) (js-array))))) 30000)
  (test "Given an unavailable Seed executable, when preparation fails, then private build storage is still released"
    (async ()
      (let* ((output (resolve directory "missing-seed.wasm"))
             (result (await (cli "wasm" output input (js-object :EMACS "eliscript-intentionally-missing-emacs")))))
        (js-call assert :notStrictEqual (get result :code) 0) (js-call assert :strictEqual (get result :signal) nil)
        (js-call assert :match (get result :stderr) (new globalThis.RegExp "ENOENT|Executable not found"))
        (js-call assert :match (get result :stderr) (new globalThis.RegExp "eliscript-intentionally-missing-emacs"))
        (js-call assert :strictEqual (await (js-call (js-call globalThis.Bun :file output) :exists)) false)
        (js-call assert :deepStrictEqual (await (readdir scratch)) (js-array)))))
  (test "Given an existing checkout cache, when integrity inspection fails after loading its compiler, then the cache remains unchanged"
    (async ()
      (js-call assert :strictEqual (unless (nullish? integrityFailure) (get integrityFailure :code)) "ENOENT")
      (let ((path (unless (nullish? integrityFailure) (get integrityFailure :path))))
        (js-call assert :ok (and (not (nullish? path)) (js-call path :endsWith "package.json"))))
      (js-call assert :strictEqual (await (readFile (resolve root "dist/bootstrap/compiler.mjs") "utf8"))
        "// unrelated existing build cache\n" "read-only integrity inspection must preserve unrelated build cache"))))
