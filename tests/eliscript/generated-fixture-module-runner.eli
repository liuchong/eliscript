(module tests.generated-fixture-module-runner
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "../../dist/bootstrap/compiler.mjs" compile-string)
  (import "../../tools/testing/generated-fixture-module.mjs" loadGeneratedFixture)
  (defasync main ()
    (let* ((directory (aref (get globalThis.process :argv) 2))
           (source "(defvar calls 0) (defun add (a b) (setq calls (1+ calls)) (+ a b)) (defun count-calls () calls) (export add count-calls)")
           (javascript (compile-string source "physical-fixture.eli"))
           (first (await (loadGeneratedFixture directory javascript "sum")))
           (second (await (loadGeneratedFixture directory javascript "single-ir"))))
      (js-call assert :equal (js-call first :add 19 23) 42)
      (js-call assert :equal (js-call first :count_calls) 1)
      (js-call assert :equal (js-call second :count_calls) 0)
      (js-call assert :equal (get first globalThis.Symbol.toStringTag) "Module")
      (js-call assert :equal (await (readFile (resolve directory "sum-1.mjs") "utf8")) javascript)
      (js-call assert :equal (await (readFile (resolve directory "single-ir-2.mjs") "utf8")) javascript)
      (js-call (get globalThis.process :stdout) :write "{\"executed\":42,\"independent\":true}\n")))
  (js-call (main) :catch (lambda (error) (console/error error) (put globalThis.process :exitCode 1))))
