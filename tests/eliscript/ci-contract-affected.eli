(module tests.ci-contract-affected
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve isAbsolute)
  (import "../../tools/backends/build.mjs" root)
  (import "../../tools/ci/render-browser-workflow.mjs" checkBrowserCompatibilityWorkflow renderBrowserWorkflow)
  (import "../../tools/ci/render-workflow.mjs" checkCompatibilityWorkflow renderWorkflow validateCompatibilityMatrix)
  (import "../../tools/testing/file-workers.mjs" partitionTestFiles)
  (defun originalWorkerArguments (arguments)
    (let* ((file (aref arguments (1- (js-length arguments))))
           (expected (js-array (get globalThis.process :execPath) "--smol" "test"))
           (environment (get globalThis.process :env)))
      (js-call assert :strictEqual (= (value-type file) "string") t)
      (js-call assert :ok (js-call file :endsWith ".test.mjs"))
      (js-call assert :ok (or (isAbsolute file) (js-call file :startsWith "./") (js-call file :startsWith "../")))
      (when (= (get environment :ELISCRIPT_TEST_FIXTURE_PRELOAD) "1")
        (js-call assert :strictEqual (get environment :ELISCRIPT_TEST_FIXTURE_PRELOAD_PATH)
          (resolve root "tools/testing/fixture-environment.mjs"))
        (js-call expected :push "--preload" (get environment :ELISCRIPT_TEST_FIXTURE_PRELOAD_PATH)))
      (when (or (= (resolve root file) (resolve root "tests/wasm-managed-str.test.mjs"))
                (= (resolve root file) (resolve root "tests/wasm-managed-array-sort.test.mjs")))
        (js-call expected :push "--preload"
          (resolve root "tests/helpers/managed-fixture-repairs-install.mjs")))
      (js-call expected :push "--timeout" "300000" file)
      ;; Assert the complete real argv before supplying the unchanged fake's
      ;; four-field fixture interface. No current option is discarded untested.
      (js-call assert :deepStrictEqual arguments expected)
      ;; The archived scheduler fake indexes logical input names. Check the
      ;; complete real argv above, then remove only the equivalent leading ./
      ;; for that fake; production dispatch keeps its explicit path unchanged.
      (js-array (aref arguments 0) "--smol" "test"
        (if (js-call file :startsWith "./") (js-call file :slice 2) file))))
  (defun adaptedSpyOn (framework target property)
    (let ((spy (js-call framework :spyOn target property)))
      (if (and (eq target globalThis.Bun) (= property "spawn"))
        (let ((set-implementation (get spy :mockImplementation)))
          ;; Native Bun spies expose readonly methods. Adapt the setup call
          ;; through a separate facade and return the original spy unchanged.
          (new globalThis.Proxy (lambda (&rest arguments) (Reflect/apply spy undefined arguments))
            (js-object :get (lambda (target key receiver)
              (if (= key "mockImplementation")
                (lambda (callback)
                  (Reflect/apply set-implementation spy (js-array
                    (lambda (arguments &rest options)
                      (Reflect/apply callback undefined
                        (js-call (js-array (originalWorkerArguments arguments)) :concat options))))))
                (Reflect/get spy key spy))))))
        spy)))
  (defasync runBrowserWorkflowCase ()
    (let* ((report (await (checkBrowserCompatibilityWorkflow (js-object :root root))))
           (baseline (JSON/parse (await (readFile (resolve root "contracts/compatibility-matrix.json") "utf8"))))
           (contract (JSON/parse (await (readFile (resolve root "contracts/browser-compatibility.json") "utf8"))))
           (workflow (renderBrowserWorkflow contract baseline)))
      (js-call assert :strictEqual (get report :jobs) 1)
      (js-call assert :deepStrictEqual (get report :browserEngines) (js-array "chromium" "firefox" "webkit"))
      (js-call assert :ok (js-call workflow :includes "name: linux-browsers"))
      (js-call (get report :browserEngines) :forEach (lambda (browser)
        (js-call assert :ok (js-call workflow :includes (str "Run complete backend differential suite (" browser ")")))
        (js-call assert :ok (js-call workflow :includes (str "ELISCRIPT_TEST_BROWSER: " browser)))
        (js-call assert :ok (js-call workflow :includes (str "tee \"$RUNNER_TEMP/eliscript-browser-ci/" browser "/tests.log\"")))))
      (js-call (js-array
        "on:\n  workflow_dispatch:\n\n"
        "install --with-deps chromium firefox webkit"
        "bun tools/testing/file-workers.mjs tests/direct-wasm-backend.test.mjs tests/wasm-managed-array-search.test.mjs tests/wasm-managed-array-construction.test.mjs tests/wasm-managed-object-properties.test.mjs tests/wasm-managed-exceptions-browser.test.mjs tests/wasm-managed-symbols.test.mjs 2>&1 | tee"
        "set -o pipefail" "timeout-minutes: 90"
        "emacsCommit: \"fd7afced4036fc1a221567d70705d20a2bd64713\""
        "EMACS_COMMIT: ${{ matrix.emacsCommit }}"
        "id: chromium"
        "if: \"!cancelled() && steps.chromium.outcome != 'skipped'\""
        "test \"$(bun -p 'process.arch')\" = \"${{ matrix.architecture }}\""
        "test \"$(node -p 'process.arch')\" = \"${{ matrix.architecture }}\""
        "if: always()" (str "actions/upload-artifact@" (get (get contract :artifactAction) :revision))) :forEach
        (lambda (text) (js-call assert :ok (js-call workflow :includes text))))))
  (defasync runCompatibilityWorkflowCase ()
    (let ((report (await (checkCompatibilityWorkflow (js-object :root root)))))
      (js-call assert :strictEqual (get report :jobs) 3)
      (js-call assert :strictEqual (get report :acceptanceJobs) 1)
      (js-call assert :strictEqual (get report :testFileShards) 1)
      (js-call assert :deepStrictEqual (js-call (get report :systems) :map (lambda (system) (get system :id)))
        (js-array "linux" "linux-arm64" "macos"))
      (js-call assert :deepStrictEqual (js-call (get report :systems) :find (lambda (system) (= (get system :id) "linux-arm64")))
        (js-object :id "linux-arm64" :operatingSystem "linux" :runner "ubuntu-24.04-arm" :architecture "arm64"))
      (js-call assert :deepStrictEqual (js-call (get report :acceptanceSystems) :map (lambda (system) (get system :id))) (js-array "macos"))
      (js-call assert :deepStrictEqual (get report :emacsVersions) (js-array "32.0.50"))
      (js-call assert :deepStrictEqual (get report :emacsInstall)
        (js-object "32.0.50" (js-object :source "https://github.com/emacs-mirror/emacs"
          :commit "fd7afced4036fc1a221567d70705d20a2bd64713")))
      (js-call assert :deepStrictEqual (get report :javascriptHost) (js-object :name "bun" :version "1.4.0"))
      (js-call assert :deepStrictEqual (get report :nodeHost) (js-object :name "node" :version "24.20.0"))
      (js-call assert :strictEqual (get report :localEvidenceDirectory) "acceptance/matrix")))
  (defasync runEightShardInventoryCase ()
    (let* ((baseline (JSON/parse (await (readFile (resolve root "contracts/compatibility-matrix.json") "utf8"))))
           (makefile (await (readFile (resolve root "Makefile") "utf8")))
           (workflow (renderWorkflow baseline)) (validated (validateCompatibilityMatrix baseline))
           (rows (Array/from (js-call workflow :matchAll (new globalThis.RegExp
             "          - name: ([^\\n]+)\\n            os: ([^\\n]+)\\n            architecture: ([^\\n]+)\\n            emacs: \"([^\"\\n]+)\"\\n            emacsCommit: \"([^\"\\n]+)\"$" "gm"))))
           (inventories (js-call (js-array "test-core" "test-applications") :map (lambda (target)
             (let* ((start (js-call makefile :indexOf (str target ":")))
                    (end (js-call makefile :indexOf "\n\n" start)))
               (Array/from (js-call (js-call makefile :slice start end) :matchAll
                 (new globalThis.RegExp "[.]/tests/[a-z0-9-]+[.]test[.]mjs" "g"))
                 (lambda (match) (aref match 0))))))))
      (js-call assert :strictEqual (get validated :jobs) 3)
      (js-call assert :strictEqual (get validated :acceptanceJobs) 1)
      (js-call assert :strictEqual (get validated :testFileShards) 1)
      (js-call assert :strictEqual (js-length rows) (get validated :jobs))
      (js-call assert :strictEqual (js-length inventories) 2)
      (js-call inventories :forEach (lambda (files)
        (js-call assert :ok (> (js-length files) 20))
        (js-call assert :strictEqual (get (new globalThis.Set files) :size) (js-length files))
        (js-call assert :deepStrictEqual (partitionTestFiles files 1 1) files)))
      (js-call assert :deepStrictEqual
        (js-call rows :map (lambda (row) (js-object :name (aref row 1) :os (aref row 2) :arch (aref row 3) :emacs (aref row 4) :emacsCommit (aref row 5))))
        (js-array
          (js-object :name "linux-emacs-32.0.50" :os "ubuntu-24.04" :arch "x64" :emacs "32.0.50" :emacsCommit "fd7afced4036fc1a221567d70705d20a2bd64713")
          (js-object :name "linux-arm64-emacs-32.0.50" :os "ubuntu-24.04-arm" :arch "arm64" :emacs "32.0.50" :emacsCommit "fd7afced4036fc1a221567d70705d20a2bd64713")
          (js-object :name "macos-emacs-32.0.50" :os "macos-15" :arch "arm64" :emacs "32.0.50" :emacsCommit "fd7afced4036fc1a221567d70705d20a2bd64713")))
      (js-call (js-array
        "on:\n  workflow_dispatch:\n\n"
        "EMACS_COMMIT: ${{ matrix.emacsCommit }}"
        "git -C \"$RUNNER_TEMP/emacs-src\" fetch --depth 1 origin \"$EMACS_COMMIT\""
        "test \"$(git -C \"$RUNNER_TEMP/emacs-src\" rev-parse HEAD)\" = \"$EMACS_COMMIT\""
        "test \"$(emacs --version | head -n 1)\" = \"GNU Emacs ${{ matrix.emacs }}\""
        "BUN_TEST_RUNNER: tools/testing/file-workers.mjs"
        "Run test file shard 1/1"
        "id: test-suite"
        "if: \"!cancelled() && steps.test-suite.outcome != 'skipped'\""
        "Preserve compatibility test evidence"
        ".eliscript-cache/test-results/"
        "timeout-minutes: 240" "fail-fast: false") :forEach
        (lambda (text) (js-call assert :ok (js-call workflow :includes text))))
      (js-call (get baseline :commands) :forEach (lambda (command) (js-call assert :ok (js-call workflow :includes (str "run: " command)))))
      (js-call assert :ok (js-call workflow :includes "ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE: \"small\""))
      (let* ((strict (Object/assign (js-object) baseline)))
        (Reflect/deleteProperty strict "performanceAcceptance")
        (let ((strict-workflow (renderWorkflow strict)))
          (js-call assert :strictEqual (js-call strict-workflow :includes "ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE") false)
          (js-call assert :ok (js-call strict-workflow :includes "timeout-minutes: 30"))
          (js-call assert :strictEqual (js-call strict-workflow :includes "timeout-minutes: 240") false)
          (js-call assert :strictEqual (js-call strict-workflow :includes "ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE") false)))
      (js-call (get baseline :actions) :forEach (lambda (action)
        (js-call assert :ok (js-call workflow :includes (str (get action :repository) "@" (get action :revision))))))
      (js-call (js-array "cli-test.sh" "project-cli-test.sh" "check-cli-test.sh" "format-cli-test.sh" "application-cli-test.sh")
        :forEach (lambda (script) (js-call assert :ok (js-call makefile :includes (str "./tests/" script)))))
      (js-call assert :strictEqual (js-length (Array/from (js-call makefile :matchAll
        (new globalThis.RegExp "ert-run-tests-batch-and-exit" "g")))) 2)
      (js-call assert :strictEqual (js-call (new globalThis.RegExp "[|][|] true|--test-name-pattern|continue-on-error|if:.*matrix") :test workflow) false)))
  (defasync runWorkflowCommandsCase ()
    (let* ((baseline (JSON/parse (await (readFile (resolve root "contracts/compatibility-matrix.json") "utf8"))))
           (workflow (renderWorkflow baseline))
           (makefile (await (readFile (resolve root "Makefile") "utf8")))
           (package (JSON/parse (await (readFile (resolve root "package.json") "utf8"))))
           (strict (Object/assign (js-object) baseline)))
      (js-call assert :ok (js-call workflow :includes
        "timeout-minutes: 240"))
      (Reflect/deleteProperty strict "performanceAcceptance")
      (js-call assert :ok (js-call (renderWorkflow strict) :includes "timeout-minutes: 30"))
      (js-call (js-array "BUN_TEST_RUNNER: tools/testing/file-workers.mjs"
        "run: bun run test" "run: make byte-compile") :forEach
        (lambda (text) (js-call assert :ok (js-call workflow :includes text))))
      (js-call assert :strictEqual (get (get package :scripts) :test) "make test")
      (js-call assert :strictEqual (js-length (Array/from (js-call makefile :matchAll
        (new globalThis.RegExp "\\$\\(BUN\\) \\$\\(BUN_TEST_RUNNER\\)" "g")))) 2)))
  (defasync runWorkflowDriftCase ()
    (let* ((baseline (JSON/parse (await (readFile (resolve root "contracts/compatibility-matrix.json") "utf8"))))
           (strict (Object/assign (js-object) baseline)))
      (Reflect/deleteProperty strict "performanceAcceptance")
      (let ((index 0) (matrices (js-array baseline strict))
            (expected (js-array "timeout-minutes: 240"
                                "timeout-minutes: 30")))
        (while (< index (js-length matrices))
          (let* ((matrix (aref matrices index)) (original (renderWorkflow matrix))
                 (altered (js-call original :replace (aref expected index) "timeout-minutes: 1")))
            (js-call assert :notStrictEqual altered original)
            (await (js-call assert :rejects
              (checkCompatibilityWorkflow (js-object :root root :matrix matrix :workflowText altered))
              (new globalThis.RegExp "differs from the compatibility matrix"))))
          (setq index (1+ index))))))
  (export originalWorkerArguments adaptedSpyOn runBrowserWorkflowCase runCompatibilityWorkflowCase runEightShardInventoryCase
    runWorkflowCommandsCase runWorkflowDriftCase))
