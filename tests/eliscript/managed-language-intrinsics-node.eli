(module tests.managed-language-intrinsics-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:module" createRequire)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (defconst argv (get globalThis.process :argv))
  (defconst bytes (readFileSync (aref argv 2)))
  (defconst reference (funcall (createRequire (aref argv 3)) (aref argv 3)))
  (defconst runtime (instantiateManagedRuntime bytes))
  (js-call runtime :auto 1)
  (defconst inputs (js-array "0" "-0" " 42 " "0xFF" "0o17" "0b101" "9007199254740993123456789"
    "" "bad" "1.2" "1e3" "1N" "0x" nil undefined false t 42 -42 -0 1.5 globalThis.NaN globalThis.Infinity))
  (defvar index 0)
  (while (< index (js-length inputs))
    (let* ((input (aref inputs index))
           (handle (cond ((= (value-type input) "string") (js-call runtime :string input))
                         ((= (value-type input) "number") (js-call runtime :number input)) (t input)))
           (actual undefined))
      (try
        (setq actual (js-call runtime :invoke "parse-bigint" (js-array handle)))
        (js-call assert :strictEqual (if (eq actual nil) nil (js-call runtime :readBigInt actual))
          (js-call reference :parse_bigint input))
        (finally (js-call runtime :release actual) (js-call runtime :release handle)))
      (js-call runtime :collect))
    (setq index (1+ index)))
  (defun primitive-result (value)
    (cond ((or (eq value nil) (eq value false) (eq value t) (undefined? value)) value)
      ((= (get value :kind) 4) (js-call runtime :readNumber value))
      ((= (get value :kind) 14)
        (let ((out (js-array)) (position 0))
          (while (< position (js-call runtime :length value))
            (let ((child (js-call runtime :get value position)))
              (try (js-call out :push (primitive-result child))
                (finally (js-call runtime :release child))))
            (setq position (1+ position))) out))
      (t (js-call assert :fail "unexpected qualified primitive result"))))
  (js-call (js-array "qualified-undefined" "qualified-numbers" "qualified-getters" "qualified-number-shadow")
    :forEach (lambda (name)
      (let ((value (js-call runtime :invoke name)))
        (try (js-call assert :deepStrictEqual (primitive-result value)
               (funcall (get reference (js-call name :replaceAll "-" "_"))))
          (finally (js-call runtime :release value))))))
  (js-call (js-array nil undefined false t -0 globalThis.NaN globalThis.Infinity) :forEach (lambda (input)
    (let ((value (if (= (value-type input) "number") (js-call runtime :number input) input)) (out undefined))
      (try (setq out (js-call runtime :invoke "qualified-nullish" (js-array value)))
        (js-call assert :strictEqual out (js-call reference :qualified_nullish input))
        (finally (js-call runtime :release out) (js-call runtime :release value))))))
  (js-call assert :throws (lambda () (js-call reference :qualified_null_root)) globalThis.TypeError)
  (js-call assert :throws (lambda () (js-call runtime :invoke "qualified-null-root")) globalThis.TypeError)
  (let* ((zero (js-call runtime :number -0)) (owner undefined) (trace undefined) (captured undefined))
    (try
      (setq owner (js-call runtime :sourceObject (js-object :undefined zero)))
      (setq captured (js-call runtime :invoke "qualified-capture" (js-array owner)))
      (js-call assert :ok (Object/is (js-call runtime :readNumber captured) -0))
      (setq trace (js-call runtime :sourceArray (js-array zero)))
      (let ((expected (js-array -0)))
        (js-call assert :throws (lambda () (js-call reference :qualified_callee expected)) globalThis.TypeError)
        (js-call assert :throws (lambda () (js-call runtime :invoke "qualified-callee" (js-array trace))) globalThis.TypeError)
        (js-call assert :deepStrictEqual (primitive-result trace) expected))
      (let ((out (js-call runtime :invoke "qualified-undefined")))
        (try (js-call assert :deepStrictEqual (primitive-result out) (js-array undefined undefined))
          (finally (js-call runtime :release out))))
      (finally (js-call runtime :release captured) (js-call runtime :release trace)
        (js-call runtime :release owner) (js-call runtime :release zero))))
  (js-call runtime :closeModule) (js-call runtime :collect)
  (js-call assert :strictEqual (js-call runtime :live) 0)
  (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
