(module tests.array-text-parity-install
  (import "bun:test" :as framework)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:fs/promises" readFile writeFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "../../tools/backends/build.mjs" :as build)
  (import "../../tools/compiler/array-text-capsule.mjs" renderArrayTextImport)
  (import "../../tools/testing/compiler-fixture-process.mjs" runCompilerFixture)
  (import "./direct-wasm-registration.mjs" createDirectWasmRegistration)
  (defconst original (Object/assign (js-object) framework))
  (defconst actual-build (Object/assign (js-object) build))
  (defconst root (get build :root))
  (defconst suite "tests/wasm-managed-array-text.test.mjs")
  (js-call assert :ok (js-call (get globalThis.process :argv) :some (lambda (argument) (= (resolve root argument) (resolve root suite)))))
  (js-call assert :strictEqual (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root suite))) :digest "hex")
    "cf58851b4cfdfb32d01f8ab12426b93377b4c120d5f193feb6928a793595e42e")
  (defvar backend undefined)
  (defasync buildBackends (&rest arguments)
    (setq backend (await (Reflect/apply (get actual-build :buildBackends) actual-build arguments))) backend)
  (defasync verifyArrayTextParity ()
    (let* ((compiler (get backend :compiler))
           (program (js-call compiler :compile_ir_string (await (readFile (resolve root "tests/fixtures/wasm-managed-array-text.eli") "utf8")) "array-text.eli"))
           (javascript (js-call compiler :emit_ir_string program))
           (capsule (await (renderArrayTextImport)))
           (prelude (await (readFile (resolve root "runtime/prelude.mjs") "utf8")))
           (directory (await (mkdtemp (resolve (get backend :directory) "array-text-parity-"))))
           (source "(defun f (object key) (js-call object :join) (js-call object \"toString\") (js-call object false) (js-call object t) (js-call object nil) (js-call object undefined) (js-call object 7) (js-call object key)) (export f)")
           (input (resolve directory "literal-keys.eli")) (output (resolve directory "literal-keys.mjs")))
      (try
        ;; The compiler now imports the shared public prelude. Check its exact
        ;; maintained capsule bytes and the actual generated dependency edge.
        (js-call assert :ok (js-call prelude :includes (str "export" (js-call capsule :slice 6))))
        (js-call assert :ok (js-call javascript :includes "from \"eliscript/runtime/prelude.mjs\";"))
        (js-call assert :ok (js-call javascript :includes "__eliscript_at"))
        (await (writeFile input source))
        (await (runCompilerFixture (js-array (resolve root "bin/eliscript-seed") "--output" output input) (js-object :cwd root) 20000))
        (js-call assert :strictEqual (await (readFile output "utf8")) (js-call compiler :compile_string source input))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defconst registration (createDirectWasmRegistration original (js-object
    "the emitted shared capsule matches its maintained source and literal method keys retain public Seed parity" verifyArrayTextParity)))
  (js-call (get original :mock) :module (resolve root "tools/backends/build.mjs")
    (lambda () (Object/assign (js-object) actual-build (js-object :buildBackends buildBackends))))
  (js-call (get original :mock) :module "bun:test" (lambda () (get registration :exports)))
  (js-call original :beforeAll (lambda () (js-call registration :complete)))
  (js-call original :afterAll (lambda ()
    (js-call (get original :mock) :module "bun:test" (lambda () original))
    (js-call (get original :mock) :module (resolve root "tools/backends/build.mjs") (lambda () actual-build)))))
