(module tests.record-grid
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp mkdir readFile writeFile rm readdir)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/dist/record-grid.mjs"
    recordCompilerGrid executeCompilerMatrixFromArtifacts runCompilerMatrixChain executeCompilerMatrixCellFromArtifacts
    executeCompilerMatrixCellFromArtifact)
  (import "../tools/backends/compiler-metadata.mjs" readCompilerMetadata)
  (import "../tools/backends/compiler-build.mjs" loadCompilerSources writeCompilerMetadata buildIndependentCompiler)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/backends/compiler-bootstrap.mjs" compilerSourceIdentity openCompilerArtifact archiveCompilerArtifact)

  (test "existing cell artifact execution accepts only a metadata path and preserves ordinary cell validation"
    (async ()
      (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifact nil "javascript" "javascript" "existing.json")
        (lambda (error) (= (get error :message) "compiler matrix execution options are required"))))
      (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifact (js-object) "javascript" "javascript" (lambda () nil))
        (lambda (error) (= (get error :message) "existing cell build metadataPath is required"))))
      (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifact (js-object) "unknown" "javascript" "existing.json")
        (lambda (error) (= (get error :message) "compiler host must be javascript, wasm or native"))))))

  (test "a real complete session build is reused only after source producer files IR debug and original build evidence agree"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-reuse-cell-"))))
             (sources (await (loadCompilerSources))) (producer nil) (instance nil))
        (try
          (let* ((seed (await (buildIndependentCompiler (js-object :host "javascript" :sources sources
                               :outputRoot (resolve directory "producer") :profile "full-compiler" :retainIR t :debug t))))
                 (cell-directory (resolve directory "original-cell"))
                 (input (recorded-grid-input)) (stages (js-array)) (artifact undefined))
            (put input :generations 3) (put input :outputRoot (resolve directory "attempts"))
            (put input :corpusRecordsPath (resolve directory "missing-original-corpus.json"))
            (put input :onStage (async (event) (js-call stages :push (get event :phase))))
            (put (aref (get input :producers) 0) :metadataPath (get seed :metadataPath))
            (setq producer (await (openCompilerArtifact seed)))
            (try (setq artifact (await (buildIndependentCompiler
                   (js-object :host "javascript" :sources sources :session producer
                     :outputRoot (resolve cell-directory "artifact") :profile "full-compiler" :retainIR t :debug t))))
              (finally (await (js-call producer :close)) (setq producer nil)))
            (setq instance (await (openCompilerArtifact artifact)))
            (try
              (js-call assert :strictEqual (get (await (js-call instance :request (js-object :operation "capabilities"))) :format)
                "eliscript-compiler-capabilities")
              (finally (await (js-call instance :close)) (setq instance nil)))
            (let* ((archived (await (archiveCompilerArtifact artifact (resolve cell-directory "metadata"))))
                   (receipt-path (resolve cell-directory "execution.json"))
                   (receipt (js-object :format "eliscript-compiler-matrix-cell-execution" :version 1
                     :host "javascript" :target "javascript" :profile "full-compiler" :status "corpus-running"
                     :verification "unverified" :sourceIdentity (compilerSourceIdentity sources)
                     :producerMetadataPath (get seed :metadataPath)
                     :build (js-object :host "javascript" :target "javascript" :status "constructed" :execution "initialized"
                       :metadataPath (get artifact :metadataPath) :producerIdentity (get seed :productIdentity) :artifact archived)))
                   (path (get artifact :metadataPath))
                   (original (await (readCompilerMetadata path)))
                   (mutations (js-array
                     (lambda (value) (put value :host "wasm"))
                     (lambda (value) (put (get value :provenance) :producerHost "wasm"))
                     (lambda (value) (put (get value :provenance) :mode "seed"))
                     (lambda (value) (js-call (get (get value :provenance) :compiledModuleIds) :pop))
                     (lambda (value) (put (aref (get (get value :sourceIdentity) :modules) 0)
                                       :sha256 (js-call "0" :repeat 64)))
                     (lambda (value) (js-call (get value :frontendIR) :pop))
                     (lambda (value) (put value :debugEnabled false))
                     (lambda (value) (put (get value :productIdentity) :sha256 (js-call "0" :repeat 64)))))
                   (index 0))
              (await (writeCompilerMetadata receipt-path receipt))
              (while (< index (js-length mutations))
                (let ((changed (funcall globalThis.structuredClone original)))
                  (funcall (aref mutations index) changed)
                  (await (writeCompilerMetadata path changed))
                  (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifact input "javascript" "javascript" path))))
                (setq index (1+ index)))
              (await (writeCompilerMetadata path original))
              (let ((changed (funcall globalThis.structuredClone receipt)))
                (put (get (get changed :build) :producerIdentity) :sha256 (js-call "0" :repeat 64))
                (await (writeCompilerMetadata receipt-path changed))
                (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifact input "javascript" "javascript" path)
                  (lambda (error) (= (get error :message) "existing cell build has a different original producer"))))
                (await (writeCompilerMetadata receipt-path receipt)))
              (let* ((file (get artifact :path)) (bytes (await (readFile file))))
                (await (rm file))
                (try (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifact input "javascript" "javascript" path)
                       (lambda (error) (= (get error :code) "ENOENT"))))
                  (finally (await (writeFile file bytes)))))
              (await (rm receipt-path))
              (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifact input "javascript" "javascript" path)
                (lambda (error) (= (get error :code) "ENOENT"))))
              (await (writeCompilerMetadata receipt-path receipt))
              (put stages :length 0)
              ;; The actual reused compiler initializes and closes. Only then
              ;; does the unchanged corpus loader reject the missing input;
              ;; this is reuse evidence, never a counterfeit corpus success.
              (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifact input "javascript" "javascript" path)
                (lambda (error) (and (= (get error :code) "ENOENT")
                                    (js-call (get error :message) :includes "missing-original-corpus.json")))))
              (js-call assert :ok (js-call stages :includes "compiler-reuse"))
              (js-call assert :ok (js-call stages :includes "compiler-initialize"))
              (js-call assert :strictEqual (js-call stages :includes "compiler-build") false)
              (js-call assert :deepStrictEqual (await (readCompilerMetadata path)) original)
              (js-call assert :deepStrictEqual (await (readCompilerMetadata receipt-path)) receipt)))
          (finally
            (when producer (await (js-call producer :close)))
            (when instance (await (js-call instance :close)))
            (await (rm directory (js-object :recursive t :force t))))))))

  (defun recorded-grid-input ()
    (let ((hosts (js-array "javascript" "wasm" "native")) (producers (js-array)) (cells (js-array)) (index 0))
      (while (< index (js-length hosts))
        (let ((host (aref hosts index)) (target-index 0))
          (js-call producers :push (js-object :host host :metadataPath (+ "missing-producer-" host ".json")))
          (while (< target-index (js-length hosts))
            (let ((target (aref hosts target-index)))
              (js-call cells :push (js-object :host host :target target
                :metadataPath (+ "missing-" host "-to-" target ".json"))))
            (setq target-index (1+ target-index))))
        (setq index (1+ index)))
      (js-object :outputRoot "missing-output" :producers producers :cells cells
        :generations (js-object :directory "missing-generations"))))

  (defasync rejected-grid (input expected)
    (await (js-call assert :rejects (recordCompilerGrid input)
      (lambda (error) (= (get error :message) expected)))))

  (defasync rejected-execution (input expected)
    (await (js-call assert :rejects (executeCompilerMatrixFromArtifacts input)
      (lambda (error) (= (get error :message) expected)))))

  (test "existing compiler execution requires three real producer paths and at least three same-host generations"
    (async ()
      (await (rejected-execution nil "compiler matrix execution options are required"))
      (await (rejected-execution (js-object) "compiler grid outputRoot is required"))
      (let ((invalid (js-array 0 1 2 -1 3.5 nil false "3")) (index 0))
        (while (< index (js-length invalid))
          (let ((input (recorded-grid-input)))
            (put input :generations (aref invalid index))
            (await (rejected-execution input "compiler matrix execution requires at least three generations per host")))
          (setq index (1+ index))))
      (let ((input (recorded-grid-input)))
        (put input :generations 3) (put input :producers (js-array))
        (await (rejected-execution input "recorded compiler grid requires three producer artifacts")))
      (let ((input (recorded-grid-input)))
        (put input :generations 3) (put (aref (get input :producers) 1) :host "javascript")
        (await (rejected-execution input "compiler grid repeats a producer host")))
      (let ((input (recorded-grid-input)))
        (put input :generations 3) (put (aref (get input :producers) 0) :metadataPath "")
        (await (rejected-execution input "producer metadataPath is required")))))

  (test "one selected compiler chain validates all declarations but never loads an unrelated host manifest"
    (async ()
      (let ((input (recorded-grid-input)))
        (put input :generations 3)
        (await (js-call assert :rejects (runCompilerMatrixChain input "unknown")
          (lambda (error) (= (get error :message) "compiler host must be javascript, wasm or native"))))
        (put (aref (get input :producers) 1) :host "javascript")
        (await (js-call assert :rejects (runCompilerMatrixChain input "native")
          (lambda (error) (= (get error :message) "compiler grid repeats a producer host")))))
      (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-selected-chain-")))))
        (try
          (let ((input (recorded-grid-input)) (selected (resolve directory "selected-wasm.json")))
            (put input :generations 3) (put input :outputRoot (resolve directory "output"))
            (put (aref (get input :producers) 0) :metadataPath (resolve directory "absent-javascript.json"))
            (put (aref (get input :producers) 1) :metadataPath selected)
            (put (aref (get input :producers) 2) :metadataPath (resolve directory "absent-native.json"))
            (await (writeFile selected "{invalid selected metadata"))
            ;; SyntaxError proves the selected file was decoded; ENOENT from
            ;; either unrelated path would expose eager cross-host loading.
            (await (js-call assert :rejects (runCompilerMatrixChain input "wasm")
              (lambda (error) (= (get error :name) "SyntaxError")))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "independent compiler cells retain complete producer declarations and reject invalid host target and generation inputs"
    (async ()
      (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifacts nil "javascript" "wasm")
        (lambda (error) (= (get error :message) "compiler matrix execution options are required"))))
      (let ((input (recorded-grid-input)))
        (put input :generations 3)
        (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifacts input "unknown" "wasm")
          (lambda (error) (= (get error :message) "compiler host must be javascript, wasm or native"))))
        (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifacts input "javascript" "unknown")
          (lambda (error) (= (get error :message) "compiler host must be javascript, wasm or native"))))
        (put input :generations 2)
        (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifacts input "wasm" "native")
          (lambda (error) (= (get error :message) "compiler matrix execution requires at least three generations per host"))))
        (put input :generations 3)
        (put (aref (get input :producers) 2) :host "wasm")
        (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifacts input "wasm" "native")
          (lambda (error) (= (get error :message) "compiler grid repeats a producer host")))))))

  (test "an independent cell loads only its selected producer and records source-bound failure without reading any chain"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-selected-cell-"))))
             (input (recorded-grid-input)) (selected (resolve directory "selected-wasm.json"))
             (output (resolve directory "output"))
             (identity (compilerSourceIdentity (await (loadCompilerSources)))))
        (try
          (progn
            (put input :generations 3) (put input :outputRoot output)
            (put (aref (get input :producers) 0) :metadataPath (resolve directory "absent-javascript.json"))
            (put (aref (get input :producers) 1) :metadataPath selected)
            (put (aref (get input :producers) 2) :metadataPath (resolve directory "absent-native.json"))
            ;; Neither an existing chain nor the two unrelated host files
            ;; exist. The selected metadata's own syntax failure must win.
            (await (writeFile selected "{invalid selected cell metadata"))
            (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifacts input "wasm" "native")
              (lambda (error) (= (get error :name) "SyntaxError"))))
            (let ((entries (await (readdir output))))
              (js-call assert :strictEqual (js-length entries) 1)
              (let ((saved (await (readCompilerMetadata (resolve output (aref entries 0) "execution.json")))))
                (js-call assert :strictEqual (get saved :format) "eliscript-compiler-matrix-cell-execution")
                (js-call assert :strictEqual (get saved :host) "wasm")
                (js-call assert :strictEqual (get saved :target) "native")
                (js-call assert :strictEqual (get saved :profile) "full-compiler")
                (js-call assert :deepStrictEqual (get saved :sourceIdentity) identity)
                (js-call assert :strictEqual (get saved :status) "failed")
                (js-call assert :strictEqual (get saved :verification) "unverified")
                (js-call assert :strictEqual (get (get saved :failure) :name) "SyntaxError")
                (js-call (js-array "finalGridVerification" "crossCellVerification" "generationsVerification") :forEach
                  (lambda (field) (js-call assert :strictEqual (get saved field) "unverified")))))
            ;; This is real metadata validation, never an executable stand-in.
            (await (writeCompilerMetadata selected (js-object :host "native")))
            (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifacts input "wasm" "native")
              (lambda (error) (= (get error :message) "recorded compiler artifact has a different host"))))
            (await (writeCompilerMetadata selected (js-object :host "wasm" :sourceIdentity (js-object :sha256 "stale"))))
            (await (js-call assert :rejects (executeCompilerMatrixCellFromArtifacts input "wasm" "native")
              (lambda (error) (= (get error :message) "compiler artifact has no complete UTF-16 source identity")))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (defun claimed-chain (identity directory)
    ;; Deliberately uninstantiated evidence: used only for rejection tests.
    ;; None of these files may become an accepted or executable compiler.
    (let ((records (js-array)) (comparisons (js-array)) (index 0))
      (while (< index 3)
        (js-call records :push (js-object :generation (1+ index) :producerHost "javascript"
          :target "javascript" :sourceSha256 (get identity :sha256) :status "instantiated"
          :artifact (js-object :productIdentity (js-object :sha256 "claimed-product"))))
        (when (> index 0)
          (js-call comparisons :push (js-object :target "javascript" :from index :to (1+ index)
            :status "identical" :identities (js-array "claimed-product" "claimed-product"))))
        (setq index (1+ index)))
      (js-object :format "eliscript-compiler-bootstrap" :version 1 :directory directory
        :sourceIdentity identity :hosts (js-array "javascript" "javascript" "javascript")
        :status "constructed" :verification "unverified" :generations records
        :fixedPoint (js-object :status "identical" :comparisons comparisons))))

  (defun rejected-producer-source-identity (identity)
    (let ((result (js-object :algorithm "sha256" :encoding "utf16le"
                    :runtime (js-object :filename (get (get identity :runtime) :filename)
                                        :sha256 (get (get identity :runtime) :sha256))))
          (fields (js-array "modules" "literalSources" "hostSources")) (index 0))
      (while (< index (js-length fields))
        (let ((field (aref fields index)))
          (when (Object/hasOwn identity field)
            (put result field (js-call (aref identity field) :map (lambda (record)
              (js-object :id (get record :id) :filename (get record :filename) :sha256 (get record :sha256)))))))
        (setq index (1+ index)))
      result))

  (test "retained chain files cannot bypass source host generation fixed-point original-manifest or producer validation"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-retained-chain-"))))
             (sources (await (loadCompilerSources))) (identity (compilerSourceIdentity sources))
             (input (recorded-grid-input)) (producer-path (resolve directory "javascript.json"))
             (chain-root (resolve directory "output" "generations" "chain-javascript"))
             (actual-directory (resolve chain-root "original-chain"))
             (chain-path (resolve chain-root "bootstrap.json")))
        (try
          (progn
            (put input :outputRoot (resolve directory "output")) (put input :generations 3)
            (put (aref (get input :producers) 0) :metadataPath producer-path)
            (await (mkdir actual-directory (js-object :recursive t)))
            ;; This declaration reaches only rejection checks. Missing emitted
            ;; files prevent it from ever authenticating as a seed or product.
            (await (writeCompilerMetadata producer-path (js-object :host "javascript" :entry (get sources :entry)
              :path "never-executed.mjs" :sourceIdentity (rejected-producer-source-identity identity)
              :productIdentity (js-object :sha256 "initial-product")
              :provenance (js-object :mode "seed" :runtimeCompiled t
                :compiledModuleIds (js-call (get sources :modules) :map (lambda (item) (get item :id)))))))
            (let ((mutations (js-array
                    (lambda (metadata) (put metadata :sourceIdentity (js-object :sha256 "stale")))
                    (lambda (metadata) (put metadata :hosts (js-array "wasm" "wasm" "wasm")))
                    (lambda (metadata) (put metadata :hosts (js-array "javascript" "javascript")))
                    (lambda (metadata) (put metadata :cleanupFailure (js-object :name "Error")))
                    (lambda (metadata) (put (aref (get metadata :generations) 1) :status "built"))
                    (lambda (metadata) (put (aref (get metadata :generations) 0) :producerHost "wasm"))
                    (lambda (metadata) (put (get metadata :fixedPoint) :status "different"))
                    (lambda (metadata) (put (aref (get (get metadata :fixedPoint) :comparisons) 0) :identities
                                        (js-array "forged-product" "claimed-product")))))
                  (index 0))
              (while (< index (js-length mutations))
                (let ((metadata (claimed-chain identity actual-directory)))
                  (funcall (aref mutations index) metadata)
                  (await (writeCompilerMetadata chain-path metadata))
                  (await (js-call assert :rejects (runCompilerMatrixChain input "javascript")
                    (lambda (error) (= (get error :message)
                      "retained compiler chain does not satisfy the requested complete same-host fixed point")))))
                (setq index (1+ index))))
            (let ((metadata (claimed-chain identity actual-directory)))
              (await (writeCompilerMetadata chain-path metadata))
              (await (writeCompilerMetadata (resolve actual-directory "bootstrap.json")
                (Object/assign (js-object) metadata (js-object :status "failed"))))
              (await (js-call assert :rejects (runCompilerMatrixChain input "javascript")
                (lambda (error) (= (get error :message)
                  "retained compiler chain differs from its original bootstrap manifest")))))
            (let ((metadata (claimed-chain identity actual-directory)))
              (put metadata :seed (js-object :host "javascript" :productIdentity (js-object :sha256 "different-initial-product")))
              (await (writeCompilerMetadata chain-path metadata))
              (await (writeCompilerMetadata (resolve actual-directory "bootstrap.json") metadata))
              (await (js-call assert :rejects (runCompilerMatrixChain input "javascript")
                (lambda (error) (= (get error :message) "retained compiler chain has a different initial producer"))))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "complete execution validates the current host chain before decoding another host typed manifest"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-grid-host-lifetime-"))))
             (sources (await (loadCompilerSources))) (identity (compilerSourceIdentity sources))
             (input (recorded-grid-input)) (producer-path (resolve directory "javascript.json"))
             (chain-root (resolve directory "output/generations/chain-javascript")))
        (try
          (progn
            (put input :generations 3) (put input :outputRoot (resolve directory "output"))
            (put (aref (get input :producers) 0) :metadataPath producer-path)
            (put (aref (get input :producers) 1) :metadataPath (resolve directory "wasm.json"))
            (put (aref (get input :producers) 2) :metadataPath (resolve directory "native.json"))
            (await (writeCompilerMetadata producer-path (js-object :host "javascript" :entry (get sources :entry)
              :path "never-executed.mjs" :sourceIdentity (rejected-producer-source-identity identity)
              :productIdentity (js-object :sha256 "initial-product")
              :provenance (js-object :mode "seed" :runtimeCompiled t
                :compiledModuleIds (js-call (get sources :modules) :map (lambda (item) (get item :id)))))))
            ;; These later-host documents must not be decoded while the
            ;; JavaScript chain is being verified. Their syntax errors would
            ;; otherwise replace its original fixed-point rejection.
            (await (writeFile (resolve directory "wasm.json") "{invalid wasm"))
            (await (writeFile (resolve directory "native.json") "{invalid native"))
            (await (mkdir chain-root (js-object :recursive t)))
            (let ((chain (claimed-chain identity (resolve chain-root "original"))))
              (put chain :status "failed")
              (await (writeCompilerMetadata (resolve chain-root "bootstrap.json") chain)))
            (await (rejected-execution input
              "retained compiler chain does not satisfy the requested complete same-host fixed point")))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "record-grid CLI reports bounded scalar stages on stderr without replacing the original failure or stdout result channel"
    (async ()
      (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-grid-cli-stage-")))))
        (try
          (let* ((input (recorded-grid-input)) (path (resolve directory "input.json"))
                 (arguments (if (get (get globalThis.process :versions) :bun) (js-array "--smol") (js-array))))
            (put input :generations 3) (put input :outputRoot (resolve directory "output"))
            (js-call (get input :producers) :forEach (lambda (record)
              (put record :metadataPath (resolve directory (+ "missing-" (get record :host) ".json")))))
            (await (writeCompilerMetadata path input))
            (js-call arguments :push (resolve root "tools/backends/dist/record-grid.mjs") "--chain" path "javascript")
            (let* ((child (spawnSync (get globalThis.process :execPath) arguments
                            (js-object :encoding "utf8" :timeout 5000 :maxBuffer 65536)))
                   (lines (js-call (js-call (get child :stderr) :trim) :split "\n")))
              (js-call assert :strictEqual (get child :error) undefined)
              (js-call assert :strictEqual (get child :signal) nil)
              (js-call assert :strictEqual (get child :status) 1)
              (js-call assert :strictEqual (get child :stdout) "")
              (js-call assert :strictEqual (aref lines 0)
                "record-grid stage {\"phase\":\"chain-start\",\"host\":\"javascript\"}")
              (js-call assert :ok (<= (js-length (aref lines 0)) 1024))
              (let ((failure (JSON/parse (aref lines 1))))
                (js-call assert :strictEqual (get failure :code) "ENOENT")
                (js-call assert :ok (js-call (get failure :message) :includes "missing-javascript.json")))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "recorded grid rejects missing artifacts and self-host evidence without rebuilding or loading producers"
    (async ()
      (await (rejected-grid nil "recorded compiler grid options are required"))
      (await (rejected-grid (js-object) "compiler grid outputRoot is required"))
      (let ((input (recorded-grid-input)))
        (put input :generations nil)
        (await (rejected-grid input "recorded compiler grid requires existing self-host generation evidence")))
      (let ((input (recorded-grid-input)))
        (put input :producers (js-array))
        (await (rejected-grid input "recorded compiler grid requires three producer artifacts")))
      (let ((input (recorded-grid-input)))
        (put input :cells (js-call (get input :cells) :slice 0 8))
        (await (rejected-grid input "recorded compiler grid requires nine existing cells")))
      (let ((input (recorded-grid-input)))
        (put input :cells (js-call (get input :cells) :concat (js-array (aref (get input :cells) 0))))
        (await (rejected-grid input "recorded compiler grid requires nine existing cells")))))

  (test "recorded grid rejects repeated or invalid producer and target declarations before IO"
    (async ()
      (let ((input (recorded-grid-input)))
        (put (aref (get input :producers) 1) :host "javascript")
        (await (rejected-grid input "compiler grid repeats a producer host")))
      (let ((input (recorded-grid-input)))
        (put (aref (get input :cells) 1) :target "javascript")
        (await (rejected-grid input "compiler grid repeats a producer/target cell")))
      (let ((input (recorded-grid-input)))
        (put (aref (get input :producers) 0) :host "unknown")
        (await (rejected-grid input "compiler host must be javascript, wasm or native")))
      (let ((input (recorded-grid-input)))
        (put (aref (get input :cells) 0) :target "unknown")
        (await (rejected-grid input "compiler host must be javascript, wasm or native")))
      (let ((input (recorded-grid-input)))
        (put (aref (get input :producers) 0) :metadataPath "")
        (await (rejected-grid input "producer metadataPath is required")))
      (let ((input (recorded-grid-input)))
        (put (aref (get input :cells) 0) :metadataPath undefined)
        (await (rejected-grid input "cell metadataPath is required")))))

  (test "nine artifact declarations cannot stand in for complete source-bound fixed-point generations"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-record-grid-generations-"))))
             (sources (await (loadCompilerSources)))
             (identity (compilerSourceIdentity sources))
             (input (recorded-grid-input))
             (generation-directory (resolve directory "generations"))
             (metadata (js-object :format "eliscript-independent-compiler-bootstrap" :version 1
               :status "constructed" :sourceIdentity identity :fixedPoint (js-object :status "identical") :chains (js-array))))
        (put input :outputRoot (resolve directory "grid"))
        (put input :generations (js-object :directory generation-directory))
        (try
          (progn
            ;; Existing generation evidence is data, never construction work.
            ;; All producer paths remain absent: generation rejection must win.
            (await (js-call assert :rejects (recordCompilerGrid input)
              (lambda (error) (= (get error :code) "ENOENT"))))
            (let ((path (resolve directory "bootstrap.json")))
              (put input :generations (js-object :directory directory))
              (await (writeCompilerMetadata path metadata))
              (await (rejected-grid input "compiler grid requires three complete fixed-point self-host chains"))
              (put metadata :sourceIdentity (js-object :sha256 "stale"))
              (await (writeCompilerMetadata path metadata))
              (await (rejected-grid input "compiler grid requires three complete fixed-point self-host chains"))
              (put metadata :sourceIdentity identity)
              (put metadata :chains (js-array
                (js-object :hosts (js-array "javascript" "javascript" "javascript") :status "constructed" :directory directory)
                (js-object :hosts (js-array "javascript" "javascript" "javascript") :status "constructed" :directory directory)
                (js-object :hosts (js-array "native" "native" "native") :status "constructed" :directory directory)))
              ;; A group wrapper cannot masquerade as an instantiated chain.
              (await (writeCompilerMetadata path metadata))
              (await (rejected-grid input "compiler generation records do not satisfy the retained matrix gate"))))
          (finally (await (rm directory (js-object :recursive t :force t)))))))))
