(module tests.direct-wasm-value-json-page
  (import "eliscript-test/compiler" :as compiler)
  (import "eliscript-test/managed" emit_managed_project_wasm)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "/oracle.mjs" :as oracle)

  (defvar sequence 0)
  (defun phase (name &rest fields)
    (setq sequence (1+ sequence))
    (console/info "[direct-value-json]" (JSON/stringify
      (Object/assign (js-object :sequence sequence :phase name :at (js-call globalThis.performance :now))
        (if (= (js-length fields) 0) (js-object) (aref fields 0))))))
  (defun check (value label) (unless value (throw (new globalThis.Error label))))
  (defun read (runtime value)
    (cond
      ((and value (= (get value :kind) 4)) (js-call runtime :readNumber value))
      ((and value (= (get value :kind) 5)) (js-call runtime :readString value))
      ((and value (= (get value :kind) 14))
        (let ((out (js-array)) (index 0))
          (while (< index (js-call runtime :length value))
            (let ((item (js-call runtime :get value index)))
              (try (js-call out :push (read runtime item))
                (finally (js-call runtime :release item))))
            (setq index (1+ index))) out))
      (t value)))
  (defun box (runtime value)
    (cond
      ((= (value-type value) "string") (js-call runtime :string value))
      ((= (value-type value) "number") (js-call runtime :number value))
      ((and value (= (value-type value) "object"))
        (if (Array/isArray value) (js-call runtime :sourceArray (js-array))
          (let ((entries (Object/fromEntries (js-call (Object/entries value) :map
            (lambda (entry) (js-array (aref entry 0) (box runtime (aref entry 1))))))))
            (try (js-call runtime :sourceObject entries)
              (finally (js-call (Object/values entries) :forEach (lambda (item) (js-call runtime :release item))))))))
      (t value)))
  (defun same (actual expected label)
    (check (= (JSON/stringify actual) (JSON/stringify expected)) label))
  (defun invoke (runtime name arguments threshold index)
    (phase "invoke-start" (js-object :threshold threshold :name name :index index))
    (let ((value (js-call runtime :invoke name arguments)))
      (try
        (let ((result (read runtime value)))
          (phase "invoke-complete" (js-object :threshold threshold :name name :index index)) result)
        (finally (js-call runtime :release value)))))
  (defun reference (name arguments threshold index)
    (phase "oracle-start" (js-object :threshold threshold :name name :index index))
    (let ((result (Reflect/apply (get oracle name) oracle arguments)))
      (phase "oracle-complete" (js-object :threshold threshold :name name :index index)) result))
  (defun runDirectValueJsonBrowser (input)
    (setq sequence 0)
    (let* ((fixture (get input :fixture)) (runtime-source (get input :runtime))
           (inputs (get input :inputs)) (parse-cases (get input :parseCases)) (encode-inputs (get input :encodeInputs))
           (modules (js-array)) (runtime undefined) (bytes undefined))
      (phase "runtime-compile-start")
      (setq runtime (js-call compiler :compile_ir_string runtime-source "runtime.eli"))
      (phase "runtime-compile-complete")
      (js-call (get fixture :modules) :forEach (lambda (module index)
        (phase "module-compile-start" (js-object :index index :id (get module :id)))
        (let ((program (js-call compiler :compile_ir_string (get module :source) (get module :filename))))
          (js-call modules :push (js-object :id (get module :id) :program program))
          (check (= (js-call compiler :emit_ir_string program) (get module :javascript)) "Seed JS parity"))
        (phase "module-compile-complete" (js-object :index index :id (get module :id)))))
      (let ((frozen (JSON/stringify modules)))
        (phase "project-emit-start")
        (setq bytes (globalThis.Uint8Array.from
          (emit_managed_project_wasm modules (get fixture :entry) runtime (js-object :initialPages 4 :maximumPages 1024))))
        (check (= (JSON/stringify modules) frozen) "immutable IR")
        (check (= (js-length (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes))) 0) "zero imports")
        (phase "project-emit-complete" (js-object :bytes (js-length bytes))))
      (check (and (Object/is (aref encode-inputs 4) -0.0) (Number/isNaN (aref encode-inputs 5))) "lossless scalar test transport")
      (js-call (js-array 65536 1) :forEach (lambda (threshold)
        (phase "instantiate-start" (js-object :threshold threshold))
        (let ((runtime (instantiateManagedRuntime bytes (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216))))
          (js-call runtime :auto threshold)
          (phase "instantiate-complete" (js-object :threshold threshold))
          (try
            (js-call (js-array
              (js-array "values" "persistent equality and hashes")
              (js-array "identities" "opaque object keys")
              (js-array "json_boundaries" "Unicode signed zero shared and cyclic values")
              (js-array "order_and_identity" "unordered maps fixed collisions functions and Symbols")) :forEach
              (lambda (row index)
                (same (invoke runtime (aref row 0) (js-array) threshold index)
                  (reference (aref row 0) (js-array) threshold index) (aref row 1))))
            (js-call inputs :forEach (lambda (text index)
              (let ((value (js-call runtime :string text)))
                (try
                  (same (invoke runtime "json_case" (js-array value) threshold index)
                    (reference "json_case" (js-array text) threshold index) (str "JSON " text))
                  (finally (js-call runtime :release value))))))
            (js-call parse-cases :forEach (lambda (pair index)
              (let ((arguments (js-call pair :map (lambda (value) (box runtime value)))))
                (try
                  (same (invoke runtime "parse_report" arguments threshold index)
                    (reference "parse_report" pair threshold index) "precise JSON error and options")
                  (finally (js-call arguments :forEach (lambda (value) (js-call runtime :release value))))))))
            (js-call encode-inputs :forEach (lambda (value index)
              (let ((argument (box runtime value)))
                (try
                  (same (invoke runtime "encode_report" (js-array argument) threshold index)
                    (reference "encode_report" (js-array value) threshold index) "JSON encoder boundaries")
                  (finally (js-call runtime :release argument))))))
            (finally
              (phase "cleanup-start" (js-object :threshold threshold))
              (js-call runtime :closeModule) (js-call runtime :collect)
              (check (and (= (js-call runtime :live) 0) (= (get (js-call runtime :stats) :frameDepth) 0)) "root cleanup")
              (phase "cleanup-complete" (js-object :threshold threshold)))))))
      (phase "complete") (Array/from bytes)))
  (export runDirectValueJsonBrowser)
  (put globalThis.globalThis :__eliscriptDirectValueJsonCase runDirectValueJsonBrowser))
