(module tests.wire-project-fixture
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "../bootstrap/host/bun.mjs" loadCompiler)
  (import "node:child_process" spawnSync)
  (import "../dist/bootstrap/reader.mjs" read-string)
  (import "../dist/bootstrap/compiler.mjs" compile-string)
  (import "../tools/backends/build.mjs" root buildBackends)
  (import "../tools/testing/fixture-environment.mjs" prepareFixtureEnvironment)
  (import "../tools/backends/managed-runtime.mjs" readManagedModuleMetadata instantiateManagedRuntimeWithHostModules)
  (import "../tools/backends/native-managed-runtime.mjs" snapshotNativeManagedRuntimeABI)
  (import "./helpers/standard-library-fixture.mjs" standardLibraryRuntimeFacade)
  (import "../platform/http.mjs" :as httpPlatform)
  (import "../tools/testing/wire-project-fixture.mjs" createWireProjectFixture readWireProjectDescriptor observeWireRuntimeFailures wireFixtureRuntimeOptions wireRuntimeResourceSnapshot wireFixtureTestRegistration wireFunctionalTitles observeWireCorpusProgress observeWireHTTPPromise verifyOriginalWireHTTPContracts wireHTTPRuntimeFacade)
  (test "wire HTTP fixture calls authenticate kind13 and kind35 owners before decoding and releasing their original host identity"
    (lambda ()
      (js-call (js-array 13 35) :forEach (lambda (kind)
        (let* ((raw (Object/freeze (js-object :kind kind)))
               (decoded (Object/freeze (new globalThis.TypeError "canonical path")))
               (trace (js-array)) (tokens (js-array (js-object :kind 13))) (roots 1)
               (runtime (js-object :invoke (lambda (name arguments)
                 (js-call assert :strictEqual arguments tokens) (js-call trace :push (js-array "invoke" name)) (throw raw))
                 :pin (lambda (value) (js-call assert :strictEqual value raw)
                   (setq roots (1+ roots)) (js-call trace :push "pin"))
                 :toHostValue (lambda (value) (js-call assert :strictEqual value raw)
                   (js-call assert :strictEqual roots 1) (js-call trace :push "decode") decoded)
                 :release (lambda (value) (js-call assert :strictEqual value raw)
                   (setq roots (1- roots)) (js-call trace :push "release"))))
               (invoke (get runtime :invoke)) (facade (wireHTTPRuntimeFacade runtime)))
          (js-call assert :throws (lambda () (js-call facade :invoke "http-service" tokens)) (lambda (error) (eq error decoded)))
          (js-call assert :deepStrictEqual trace (js-array (js-array "invoke" "http-service") "pin" "release" "decode" "release"))
          (js-call assert :strictEqual roots 0)
          (setq trace (js-array))
          (js-call assert :throws (lambda () (js-call facade :invoke "original-codec-report" tokens)) (lambda (error) (eq error raw)))
          (js-call assert :deepStrictEqual trace (js-array (js-array "invoke" "original-codec-report")))
          (js-call assert :strictEqual (get runtime :invoke) invoke))))))
  (test "wire fixture authentication, decode and cleanup failures cannot replace the first Error or release ordinary thrown values"
    (lambda ()
      (let* ((raw (Object/freeze (js-object :kind 13))) (secondary (new globalThis.Error "secondary decode"))
             (released 0) (runtime (js-object :invoke (lambda () (throw raw))
               :pin (lambda (value) (js-call assert :strictEqual value raw))
               :toHostValue (lambda () (throw secondary))
               :release (lambda (value) (js-call assert :strictEqual value raw)
                 (setq released (1+ released)) (when (= released 2) (throw false))))))
        (js-call assert :throws (lambda () (js-call (wireHTTPRuntimeFacade runtime) :invoke "http-client" (js-array)))
          (lambda (error) (eq error raw)))
        (js-call assert :strictEqual released 2))
      (js-call (js-array (Object/freeze (new globalThis.TypeError "ordinary")) false undefined
        (Object/freeze (js-object :first t)) (Object/freeze (js-object :kind 13)) (Object/freeze (js-object :kind 35)))
        :forEach (lambda (marker)
          (let* ((seen false) (actual undefined) (authentications 0) (decodes 0) (releases 0)
                 (runtime (js-object :invoke (lambda () (throw marker))
                   :pin (lambda (value) (js-call assert :strictEqual value marker)
                     (setq authentications (1+ authentications)) (throw (new globalThis.TypeError "not a runtime handle")))
                   :toHostValue (lambda () (setq decodes (1+ decodes)))
                   :release (lambda () (setq releases (1+ releases))))))
            (try (js-call (wireHTTPRuntimeFacade runtime) :invoke "http-service" (js-array))
              (catch error (setq seen t actual error)))
            (js-call assert :strictEqual seen t) (js-call assert :strictEqual actual marker)
            (js-call assert :strictEqual decodes 0) (js-call assert :strictEqual releases 0)
            (js-call assert :strictEqual authentications (if (and marker (Object/hasOwn marker "kind")) 1 0)))))))
  (defun assert-wire-source-error-class (runtime value index)
    (let ((tag (js-call runtime :number index)) (classification undefined))
      (try
        (setq classification (js-call runtime :invoke "classify" (js-array value tag)))
        (js-call assert :strictEqual (js-call runtime :get classification 0) t)
        (js-call assert :strictEqual (js-call runtime :get classification 1) t)
        (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
        (js-call assert :ok (> (get (js-call runtime :stats) :collections) 0))
        (finally
          (unless (undefined? classification) (js-call runtime :release classification))
          (js-call runtime :release tag)))))
  (test "real source TypeError retains the public raw invoke contract while the wire HTTP boundary releases its transferred error root"
    (async ()
      (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
             (directory (get fixture :directory)) (runtime undefined))
        (try
          (let* ((backend (await (buildBackends (js-object :outputRoot (resolve directory "backend")))))
                 (memory (js-call (get backend :compiler) :compile_ir_string
                   (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
                 (program (js-call (get backend :compiler) :compile_ir_string
                   (str "(defun http-service (settings) (throw (new globalThis.TypeError \"canonical path\" (js-object :cause (js-object :marker \"source cause\"))))) "
                     "(defun http-client (tag) (cond ((= tag 0) (throw (new globalThis.Error \"source error\"))) "
                     "((= tag 1) (throw (new globalThis.RangeError \"source error\"))) "
                     "((= tag 2) (throw (new globalThis.SyntaxError \"source error\"))) "
                     "(t (throw (new globalThis.ReferenceError \"source error\"))))) "
                     "(defun classify (value index) (let ((constructor (cond ((= index 0) globalThis.Error) ((= index 1) globalThis.RangeError) ((= index 2) globalThis.SyntaxError) ((= index 3) globalThis.ReferenceError) ((= index 4) globalThis.TypeError) (t undefined)))) "
                     "(js-array (js-call constructor (get globalThis.Symbol :hasInstance) value) (eq (Object/getPrototypeOf value) (get constructor :prototype))))) "
                     "(export http-service http-client classify)") "wire-error-owner.eli"))
                 (bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program memory))))
            (setq runtime (await (instantiateManagedRuntimeWithHostModules bytes)))
            ;; This is an ownership/codec fixture, with the unchanged default
            ;; heap capacity. Auto-zero intentionally retains discarded source
            ;; allocations until an explicit collect; exercise these allocating
            ;; classification calls under collecting GC instead.
            (js-call runtime :auto 1)
            (let ((input (js-call runtime :fromHostValue (js-object :operations (js-array)))) (raw undefined))
              (try
                (try (js-call runtime :invoke "http-service" (js-array input)) (catch error (setq raw error)))
                (js-call assert :strictEqual (get raw :kind) 13)
                (let ((decoded (js-call runtime :toHostValue raw)))
                  (assert-wire-source-error-class runtime raw 4)
                  (js-call runtime :collect)
                  (assert-wire-source-error-class runtime raw 4)
                  (js-call assert :strictEqual (get decoded :name) "TypeError")
                  (js-call assert :strictEqual (get decoded :message) "canonical path")
                  (js-call assert :strictEqual (get (get decoded :cause) :marker) "source cause")
                  (js-call assert :strictEqual (js-call runtime :toHostValue raw) decoded)
                  (js-call assert :strictEqual (get (js-call runtime :toHostValue raw) :cause) (get decoded :cause)))
                (js-call runtime :release raw)
                (let* ((forged (Object/freeze (js-object :kind 13))) (decodes 0) (releases 0)
                       (unowned (Object/assign (js-object) runtime (js-object
                         :invoke (lambda () (throw forged))
                         :toHostValue (lambda () (setq decodes (1+ decodes)))
                         :release (lambda () (setq releases (1+ releases)))))))
                  (js-call assert :throws (lambda () (js-call (wireHTTPRuntimeFacade unowned) :invoke "http-service" (js-array input)))
                    (lambda (error) (eq error forged)))
                  (js-call assert :strictEqual decodes 0) (js-call assert :strictEqual releases 0))
                (js-call assert :throws (lambda () (js-call (wireHTTPRuntimeFacade runtime) :invoke "http-service" (js-array input)))
                  (lambda (error) (and (= (get error :name) "TypeError")
                    (= (get error :message) "canonical path") (= (get (get error :cause) :marker) "source cause"))))
                (js-call (js-array globalThis.Error globalThis.RangeError globalThis.SyntaxError globalThis.ReferenceError)
                  :forEach (lambda (constructor index)
                    (let ((tag (js-call runtime :number index)))
                      (try
                        (js-call assert :throws (lambda () (js-call (wireHTTPRuntimeFacade runtime) :invoke "http-client" (js-array tag)))
                          (lambda (error)
                            (let ((value (js-call runtime :fromHostValue error)))
                              (try (assert-wire-source-error-class runtime value index)
                                (finally (js-call runtime :release value))))
                            (and (= (get error :name) (get constructor :name)) (= (get error :message) "source error"))))
                        (finally (js-call runtime :release tag))))))
                (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                (finally (js-call runtime :release input))))
            (js-call runtime :closeModule) (js-call runtime :collect)
            (js-call assert :strictEqual (js-call runtime :live) 0))
          (finally (when runtime (js-call runtime :closeModule)) (js-call fixture :close))))))
  (test "actual maintained HTTP cleanup cannot hold the original deadline or replace the first business failure"
    (js-object :timeout 5000)
    (async ()
      (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
             (filename "stdlib/managed-wire-http-rpc.eli")
             (source (await (readFile (resolve root filename) "utf8")))
             (literal-source (await (readFile (resolve root "stdlib/managed-literals.eli") "utf8")))
             (points (Array/from literal-source))
             (pending (read-string literal-source "stdlib/managed-literals.eli")) (helper undefined))
        (try
          (progn
            (while (> (js-length pending) 0)
              (let* ((node (js-call pending :shift)) (items (get node :items)))
                (when (Array/isArray items)
                  (when (and (= (get (aref items 0) :name) "defun") (= (get (aref items 1) :name) "literal-each"))
                    (let ((span (get node :span)))
                      (setq helper (js-call (js-call points :slice (get span :start) (get span :end)) :join ""))))
                  (Reflect/apply (get pending :push) pending items))))
            (js-call assert :strictEqual (value-type helper) "string")
            ;; Compile the actual complete HTTP implementation. Only import
            ;; coordinates change; literal-each is copied from its real span.
            (setq source (js-call source :replace
              "(import \"../../platform/http.mjs\" :as Host)"
              (str "(import " (JSON/stringify (get (pathToFileURL (resolve root "platform/http.mjs")) :href)) " :as Host)")))
            (setq source (js-call source :replace
              "(import \"../../stdlib/managed-literals.eli\" literal-each)" helper))
            (await (writeFile (resolve (get fixture :directory) "compiler.mjs") (compile-string source filename)))
            (let ((api (await (loadCompiler (get fixture :directory)))) (index 0)
                  (scenarios (js-array "timeout" "limit" "redirect"))
                  (modes (js-array "pending" "reject" "throw")))
              (while (< index 9)
                (let* ((scenario (aref scenarios (Math/floor (/ index 3)))) (mode (aref modes (% index 3)))
                       (cancelled 0) (cleanup-marker (Object/freeze (new globalThis.Error "cleanup must not win")))
                       (stream (new globalThis.ReadableStream (js-object
                         :start (lambda (controller)
                           (when (= scenario "limit") (js-call controller :enqueue (new globalThis.Uint8Array 5))))
                         :cancel (lambda ()
                           (setq cancelled (1+ cancelled))
                           (cond ((= mode "pending") (new globalThis.Promise (lambda () undefined)))
                             ((= mode "reject") (Promise/reject cleanup-marker))
                             (t (throw cleanup-marker)))))))
                       (client (js-call api :createClient (js-object :timeoutMs 10 :maxBytes 4
                         :fetch (async () (new globalThis.Response stream
                           (js-object :status (if (= scenario "redirect") 302 200))))))))
                  (await (js-call assert :rejects (js-call client :usage "https://example.test/original")
                    (lambda (error)
                      (js-call assert :notStrictEqual error cleanup-marker)
                      (js-call assert :match (get error :message) (new globalThis.RegExp
                        (cond ((= scenario "timeout") "HTTP timeout")
                          ((= scenario "limit") "HTTP response byte limit") (t "Redirect requires")))) t)))
                  (js-call assert :strictEqual cancelled 1)
                  (js-call assert :strictEqual (get stream :locked) false))
                (setq index (1+ index)))))
          (finally (js-call fixture :close))))))
  (test "HTTP phase observation returns the real promise and preserves both rejected values and observer failures"
    (async ()
      (let* ((events (js-array)) (pending (Promise/resolve 7))
             (observed (observeWireHTTPPromise "actual" (lambda () pending) (lambda (event) (js-call events :push event)))))
        (js-call assert :strictEqual observed pending)
        (js-call assert :strictEqual (await observed) 7)
        (js-call assert :deepStrictEqual (js-call events :map (lambda (event) (get event :phase))) (js-array "start" "resolve")))
      (let ((rejected (Promise/reject false)))
        (js-call assert :strictEqual (observeWireHTTPPromise "rejected" (lambda () rejected) (lambda () (throw (new globalThis.Error "observer")))) rejected)
        (await (js-call assert :rejects rejected (lambda (error) (js-call assert :strictEqual error false) t))))
      (js-call assert :throws (lambda () (observeWireHTTPPromise "throw" (lambda () (throw undefined)) (lambda () (throw false))))
        (lambda (error) (js-call assert :strictEqual error undefined) t))))

  (test "diagnostic only: original HTTP contracts on the actual persisted wire artifact without the portable corpus"
    (js-object :skip (/= (get (get globalThis.process :env) :ELISCRIPT_WIRE_HTTP_DIAGNOSTIC) "1"))
    (async ()
      (let* ((directory (await (mkdtemp (resolve root "_worktree/evidence/goal-0.0.2/c67-wire-http-attempt-"))))
             (backend (await (buildBackends (js-object :outputRoot directory))))
             (compiler (get backend :compiler))
             (runtimeIR (js-call compiler :compile_ir_string (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
             (literalModules (get (await (js-call backend :loadLiteralModules)) :literalModules))
             (modules (js-array))
             (sources (js-array (js-array "stdlib/mdp.eli" "stdlib/mdp.eli") (js-array "stdlib/mds.eli" "stdlib/mds.eli")
               (js-array "stdlib/gepo.eli" "stdlib/gepo.eli") (js-array "tests/fixtures/wire.mjs" "tests/fixtures/wire.eli")
               (js-array "tests/fixtures/wasm-managed-wire.mjs" "tests/fixtures/wasm-managed-wire.eli")))
             (cursor 0) (memory (js-object :initialPages 4 :maximumPages 1024)))
        (while (< cursor (js-length sources))
          (let ((pair (aref sources cursor)))
            (js-call modules :push (js-object :id (aref pair 0) :program
              (js-call compiler :compile_ir_string (await (readFile (resolve root (aref pair 1)) "utf8")) (aref pair 1)))))
          (setq cursor (1+ cursor)))
        (let* ((before (JSON/stringify modules)) (literal-before (JSON/stringify literalModules))
               (lowered (js-call (get backend :managed) :lower_managed_project modules "tests/fixtures/wasm-managed-wire.mjs" runtimeIR
                 (Object/assign (js-object) memory (js-object :literalModules literalModules))))
               (bytes (globalThis.Uint8Array.from (js-call (get backend :wasm) :append_metadata_section
                 (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) memory)
                 "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
               (fixture (createWireProjectFixture)) (runtime undefined) (failed false)
               (settings (js-object :maxSlots 131072 :initialBytes 8388608 :maxBytes 67108864
                 :hostModules (new globalThis.Map (js-array (js-array "eliscript/platform/http.mjs" httpPlatform)))
                 :importModule (lambda (specifier) (js-call assert :equal specifier "eliscript/platform/http.mjs") httpPlatform))))
          (js-call assert :strictEqual (JSON/stringify modules) before)
          (js-call assert :strictEqual (JSON/stringify literalModules) literal-before)
          (await (writeFile (resolve directory "wire.wasm") bytes))
          (await (writeFile (resolve directory "wire-abi.json") (JSON/stringify (snapshotNativeManagedRuntimeABI lowered))))
          (when (= (get globalThis.process :arch) "arm64")
            (let ((native-target (if (= (get globalThis.process :platform) "darwin") "arm64-macos" "arm64-linux")))
              (await (writeFile (resolve directory "wire.dylib") (globalThis.Uint8Array.from
                (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target))))))
          (console/error "wire HTTP diagnostic artifact and actual ABI" directory)
          (try
            (progn
              (setq runtime (await (instantiateManagedRuntimeWithHostModules bytes
                (await (js-call fixture :options (get lowered :descriptor) settings)))))
              (js-call runtime :auto 65536)
              (let ((actual (standardLibraryRuntimeFacade runtime (get lowered :descriptor))))
                (letfn ((call (name values)
                  (let ((tokens (js-call values :map (lambda (value)
                          (if (= (value-type value) "string") (js-call actual :string value) (js-call actual :fromHostValue value)))))
                        (result undefined))
                    (try
                      (setq result (js-call actual :invoke name tokens)) (js-call actual :toHostValue result)
                      (finally
                        (unless (undefined? result) (js-call actual :release result))
                        (js-call tokens :forEach (lambda (token) (js-call actual :release token))))))))
                  (let ((result (await (verifyOriginalWireHTTPContracts (js-object
                           :createService (lambda (settings) (call "http-service" (js-array settings)))
                           :createClient (lambda (settings) (call "http-client" (js-array settings)))
                           :discoveryCandidates (lambda (url) (call "http-candidates" (js-array url)))
                           :pathIndexMarkdown (lambda (title operations location) (call "http-index" (js-array title operations location))))
                         (lambda (event) (console/error "wire HTTP boundary" event))))))
                    (await (writeFile (resolve directory "http-result.json") (JSON/stringify result)))
                    (console/error "wire HTTP diagnostic completed; not the original five-test acceptance" result)))))
            (catch error (setq failed t) (throw error))
            (finally
              (when runtime
                (try
                  (js-call runtime :closeModule) (js-call runtime :collect)
                  (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 0)
                  (js-call assert :equal (js-call runtime :live) 0)
                  (catch cleanup (unless failed (throw cleanup)))))
              (await (js-call fixture :close))))))))
  (test "diagnostic only: resume original HTTP contracts from the actual persisted wire artifact and ABI"
    (js-object :skip (or (/= (get (get globalThis.process :env) :ELISCRIPT_WIRE_HTTP_DIAGNOSTIC) "1")
      (undefined? (get (get globalThis.process :env) :ELISCRIPT_WIRE_HTTP_ARTIFACT_DIRECTORY))))
    (async ()
      (let* ((directory (get (get globalThis.process :env) :ELISCRIPT_WIRE_HTTP_ARTIFACT_DIRECTORY))
             (bytes (new globalThis.Uint8Array (await (readFile (resolve directory "wire.wasm")))))
             (abi (JSON/parse (await (readFile (resolve directory "wire-abi.json") "utf8"))))
             (descriptor (readWireProjectDescriptor bytes)) (fixture (createWireProjectFixture))
             (runtime undefined) (failed false)
             (settings (js-object :maxSlots 131072 :initialBytes 8388608 :maxBytes 67108864
               :hostModules (new globalThis.Map (js-array (js-array "eliscript/platform/http.mjs" httpPlatform)))
               :importModule (lambda (specifier) (js-call assert :equal specifier "eliscript/platform/http.mjs") httpPlatform))))
        (js-call assert :deepStrictEqual descriptor (get abi :descriptor))
        (console/error "wire HTTP resume actual persisted artifact and descriptor" directory)
        (try
          (progn
            (setq runtime (await (instantiateManagedRuntimeWithHostModules bytes (await (js-call fixture :options descriptor settings)))))
            (js-call runtime :auto 65536)
            (let ((actual (standardLibraryRuntimeFacade runtime descriptor)))
              (letfn ((call (name values)
                (let ((tokens (js-call values :map (lambda (value)
                        (if (= (value-type value) "string") (js-call actual :string value) (js-call actual :fromHostValue value)))))
                      (result undefined))
                  (try (setq result (js-call actual :invoke name tokens)) (js-call actual :toHostValue result)
                    (finally
                      (unless (undefined? result) (js-call actual :release result))
                      (js-call tokens :forEach (lambda (token) (js-call actual :release token))))))))
                (let ((result (await (verifyOriginalWireHTTPContracts (js-object
                         :createService (lambda (settings) (call "http-service" (js-array settings)))
                         :createClient (lambda (settings) (call "http-client" (js-array settings)))
                         :discoveryCandidates (lambda (url) (call "http-candidates" (js-array url)))
                         :pathIndexMarkdown (lambda (title operations location) (call "http-index" (js-array title operations location))))
                       (lambda (event) (console/error "wire HTTP boundary" (get event :name) (get event :phase)))))))
                  (await (writeFile (resolve directory "http-result.json") (JSON/stringify result)))
                  (console/error "wire HTTP diagnostic completed; not original five-test acceptance" result)))))
          (catch error (setq failed t) (throw error))
          (finally
            (when runtime
              (try (js-call runtime :closeModule) (js-call runtime :collect)
                (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 0)
                (js-call assert :equal (js-call runtime :live) 0)
                (catch cleanup (unless failed (throw cleanup)))))
            (await (js-call fixture :close)))))))
  (test "wire functional registration disables only the three original total deadlines while preserving callbacks native modifiers and strict defaults"
    (lambda ()
      (let* ((sha "05835e2d5f6fd6e973a052df3389cafb3e131fbcfce305272070b13d20453df0")
             (environment (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1" :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small"))
             (calls (js-array)) (callback (lambda () "actual original callback"))
             (original (lambda (&rest arguments) (js-call calls :push arguments) "registered")))
        (put original :skipIf (lambda (condition)
          (js-call assert :strictEqual condition false) original))
        (let ((registered (wireFixtureTestRegistration original sha environment)))
          (js-call wireFunctionalTitles :forEach (lambda (title)
            (js-call assert :strictEqual (funcall registered title callback 120000) "registered")))
          (funcall (js-call registered :skipIf false) (aref wireFunctionalTitles 2) callback 120000)
          (js-call calls :forEach (lambda (arguments)
            (js-call assert :strictEqual (aref arguments 1) callback)
            (js-call assert :strictEqual (aref arguments 2) 0)))
          (funcall registered "other original wire case" callback 120000)
          (js-call assert :strictEqual (aref (js-call calls :at -1) 2) 120000)
          (funcall registered (aref wireFunctionalTitles 0) callback 300000)
          (js-call assert :strictEqual (aref (js-call calls :at -1) 2) 300000))
        (js-call assert :strictEqual (wireFixtureTestRegistration original sha (js-object)) original)
        (js-call assert :strictEqual (wireFixtureTestRegistration original "changed-source" environment) original)
        (js-call assert :strictEqual (wireFixtureTestRegistration original sha
          (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1")) original))))
  (test "wire progress records only successful original corpus collection boundaries without changing return throws roots or unrelated calls"
    (lambda ()
      (let* ((reports (js-array)) (failure (new globalThis.Error "actual invoke failure"))
             (collect-result (js-object :actual "collection"))
             (runtime (Object/freeze (js-object
               :invoke (lambda (name) (if (= name "parse-report") (throw failure) name))
               :collect (lambda () collect-result) :live (lambda () 7))))
             (observed (observeWireCorpusProgress runtime (lambda (event) (js-call reports :push event)))))
        (js-call assert :strictEqual (js-call observed :collect) collect-result)
        (js-call assert :strictEqual (js-call observed :invoke "original-codec-report") "original-codec-report")
        (js-call assert :strictEqual (js-length reports) 0)
        (js-call assert :strictEqual (js-call observed :collect) collect-result)
        (js-call observed :collect)
        (js-call observed :invoke "http-service") (js-call observed :collect)
        (js-call assert :throws (lambda () (js-call observed :invoke "parse-report")) (lambda (error) (eq error failure)))
        (js-call observed :collect)
        (js-call observed :invoke "roundtrip-report") (js-call observed :collect)
        (js-call assert :deepStrictEqual reports (js-array
          (js-object :index 0 :function "original-codec-report") (js-object :index 1 :function "roundtrip-report")))
        (js-call assert :strictEqual (js-call observed :live) 7)
        (js-call assert :strictEqual (get observed :live) (get runtime :live))
        (js-call assert :strictEqual (Object/isFrozen observed) t))))
  (test "wire functional resources require the exact original source options and both explicit deferrals without accepting original capacity"
    (lambda ()
      (let* ((sha "05835e2d5f6fd6e973a052df3389cafb3e131fbcfce305272070b13d20453df0")
             (environment (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1" :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small"))
             (importer (lambda () "original")) (modules (new globalThis.Map))
             (original (Object/freeze (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216
               :initialPages 4 :maximumPages 1024 :nativeTarget "original-target" :hostModules modules :importModule importer)))
             (selected (wireFixtureRuntimeOptions sha environment original)) (effective (get selected :options)))
        (js-call assert :strictEqual (get selected :originalCapacityAcceptance) "DEFERRED / NOT ACCEPTED")
        (js-call assert :strictEqual (get selected :originalRuntimeOptions) original)
        (js-call assert :notStrictEqual effective original)
        (js-call assert :deepStrictEqual (js-array (get effective :maxSlots) (get effective :initialBytes) (get effective :maxBytes))
          (js-array 131072 8388608 67108864))
        (js-call assert :strictEqual (get effective :initialPages) 4)
        (js-call assert :strictEqual (get effective :maximumPages) 1024)
        (js-call assert :strictEqual (get effective :nativeTarget) "original-target")
        (js-call assert :strictEqual (get effective :hostModules) modules)
        (js-call assert :strictEqual (get effective :importModule) importer)
        (js-call assert :strictEqual (get original :maxSlots) 8192)
        (js-call (js-array (js-object) (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1")
          (js-object :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small")
          (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "0" :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small")
          (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1" :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "full-runtime")) :forEach
          (lambda (env)
            (let ((result (wireFixtureRuntimeOptions sha env original)))
              (js-call assert :strictEqual (get result :options) original)
              (js-call assert :strictEqual (get result :originalCapacityAcceptance) "required-by-original-gate"))))
        (js-call assert :strictEqual (get (wireFixtureRuntimeOptions "unknown-source" environment original) :options) original)
        (js-call (js-array "maxSlots" "initialBytes" "maxBytes") :forEach (lambda (key)
          (let ((changed (Object/assign (js-object) original)))
            (Reflect/set changed key (1+ (get changed key)))
            (js-call assert :strictEqual (get (wireFixtureRuntimeOptions sha environment changed) :options) changed)))))))
  (test "wire resource diagnostics copy actual heap observations without collecting changing roots or inventing peak measurements"
    (lambda ()
      (let* ((actual (Object/freeze (js-object :usedBytes 123456 :capacityBytes 262144 :liveValues 8191 :frameDepth 2 :collections 17)))
             (calls 0) (runtime (js-object :stats (lambda () (setq calls (1+ calls)) actual)))
             (options (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216))
             (snapshot (wireRuntimeResourceSnapshot runtime options)))
        (js-call assert :strictEqual calls 1)
        (js-call assert :deepStrictEqual snapshot (js-object :maxSlots 8192 :maxBytes 16777216
          :usedBytes 123456 :capacityBytes 262144 :liveValues 8191 :frameDepth 2 :collections 17))
        (js-call assert :strictEqual (Object/hasOwn snapshot "peakBytes") false)
        (js-call assert :strictEqual (get actual :frameDepth) 2))))
  (test "the actual internal wire key collector preserves native single-level key order duplicates mixed items and holes"
    (async ()
      (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
             (filename "stdlib/managed-wire-markdown.eli") (source (await (readFile (resolve root filename) "utf8")))
             (points (Array/from source)) (pending (read-string source filename)) (forms (js-array))
             (cases (js-array
               (js-array (js-object :a 1 :b "x") (js-object :b false))
               (js-array (js-object :one 1) (js-array 2) "x")
               (js-array 1 nil "a|b" false)
               (js-array (js-object :z 1 :a 2) (js-object :a 3 :z 4)))))
        (try
          (progn
            (while (> (js-length pending) 0)
              (let* ((node (js-call pending :shift)) (items (get node :items)))
                (when (Array/isArray items)
                  (when (and (= (get (aref items 0) :name) "defun")
                    (js-call (js-array "object?" "flat-object-keys") :includes (get (aref items 1) :name)))
                    (let ((span (get node :span)))
                      (js-call forms :push (js-call (js-call points :slice (get span :start) (get span :end)) :join ""))))
                  (Reflect/apply (get pending :push) pending items))))
            (js-call assert :strictEqual (js-length forms) 2)
            (await (writeFile (resolve (get fixture :directory) "compiler.mjs")
              (compile-string (str (js-call forms :join "\n") "\n(export flat-object-keys)") "wire-key-collector.eli")))
            (let ((result (spawnSync (get (get globalThis.process :env) :NODE "node")
                    (js-array (resolve root "tests/helpers/wire-default-node.mjs") (get fixture :directory)
                      (JSON/stringify (js-array (js-object :kind "key-collection" :cases cases))))
                    (js-object :cwd root :encoding "utf8" :env (get globalThis.process :env) :timeout 30000))))
              (js-call assert :strictEqual (get result :error) undefined (get result :stderr))
              (js-call assert :strictEqual (get result :status) 0 (str (get result :stdout) (get result :stderr)))
              (js-call assert :deepStrictEqual (JSON/parse (get result :stdout))
                (js-array (js-array "a" "b" "b") (js-array "one") (js-array)
                  (js-array "z" "a" "a" "z") (js-array "a" "b")))))
          (finally (js-call fixture :close))))))
  (test "all ten actual wire default binding boundaries preserve missing and undefined defaults while retaining explicit nil and false"
    (async ()
      (let ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
            (declarations (js-array)) (requests (js-array)) (expected (js-array)))
        (try
          (progn
            (let ((files (js-array "stdlib/managed-wire-http-rpc.eli" "stdlib/managed-wire-schema.eli")) (file-index 0))
              (while (< file-index (js-length files))
                (let* ((filename (aref files file-index)) (source (await (readFile (resolve root filename) "utf8")))
                       (points (Array/from source)) (pending (read-string source filename)))
                  (while (> (js-length pending) 0)
                    (let* ((node (js-call pending :shift)) (items (get node :items))
                           (head (and items (get (aref items 0) :name))))
                      (when (Array/isArray items)
                        (let* ((function? (js-call (js-array "defun" "lambda" "async") :includes head))
                               (offset (if (= head "defun") 2 1))
                               (parameters (and function? (aref items offset)))
                               (arguments (and parameters (get parameters :items)))
                               (rest-index (if (Array/isArray arguments)
                                 (js-call arguments :findIndex (lambda (item) (= (get item :name) "&rest"))) -1)))
                          (when (and (>= rest-index 0) (= (get (aref arguments (1+ rest-index)) :name) "optional-arguments"))
                            (let* ((binding (aref items (1+ offset))) (let-items (get binding :items))
                                   (bindings (aref let-items 1)) (names (js-call (get bindings :items) :map
                                     (lambda (entry) (get (aref (get entry :items) 0) :name))))
                                   (slice (lambda (form)
                                     (let ((span (get form :span)))
                                       (js-call (js-call points :slice (get span :start) (get span :end)) :join ""))))
                                   (defaults (js-array)) (index 2) (id (js-length requests))
                                   (name (str "default-probe-" id)))
                              (js-call assert :strictEqual (get (aref let-items 0) :name) "let")
                              (while (and (< index (js-length let-items))
                                (= (get (aref (get (aref let-items index) :items) 0) :name) "when"))
                                (js-call defaults :push (funcall slice (aref let-items index))) (setq index (1+ index)))
                              (js-call assert :strictEqual (js-length defaults) (js-length names))
                              (js-call declarations :push (str "(defun " name " " (funcall slice parameters)
                                " (let " (funcall slice bindings) " " (js-call defaults :join " ")
                                " (js-array " (js-call names :join " ") ")))\n(export " name ")"))
                              (js-call requests :push (js-object :name (js-call name :replaceAll "-" "_") :required rest-index :optional (js-length names)))
                              (let ((values (js-call names :map (lambda (key)
                                (cond ((= key "location") "/") ((= key "status") 200) ((= key "additional") t) (t (js-object)))))))
                                (js-call expected :push values (globalThis.structuredClone values)
                                  (js-call names :map (lambda (ignored) nil)) (js-call names :map (lambda (ignored) false)))))))
                        (Reflect/apply (get pending :push) pending items)))))
                (setq file-index (1+ file-index))))
            (js-call assert :strictEqual (js-length requests) 10 "all nine HTTP and the direct schema boundary must be included")
            (await (writeFile (resolve (get fixture :directory) "compiler.mjs")
              (compile-string (js-call declarations :join "\n") "wire-default-bindings.eli")))
            (let ((result (spawnSync (get (get globalThis.process :env) :NODE "node")
                    (js-array (resolve root "tests/helpers/wire-default-node.mjs") (get fixture :directory) (JSON/stringify requests))
                    (js-object :cwd root :encoding "utf8" :env (get globalThis.process :env) :timeout 30000))))
              (js-call assert :strictEqual (get result :error) undefined (get result :stderr))
              (js-call assert :strictEqual (get result :status) 0 (str (get result :stdout) (get result :stderr)))
              (js-call assert :deepStrictEqual (JSON/parse (get result :stdout)) expected)))
          (finally (js-call fixture :close))))))
  (test "wire failure observation preserves the first original error return values promises and frozen descriptors before cleanup"
    (async ()
      (let* ((failure (new globalThis.Error "original wire failure")) (reports (js-array))
             (pending (js-call globalThis.Promise :reject failure))
             (runtime (Object/freeze (js-object
               :invoke (lambda (&rest arguments) (js-call assert :strictEqual (aref arguments 0) "original") 17)
               :invokeAsync (lambda () pending)
               :readString (lambda () (throw failure)) :closeModule (lambda () "closed"))))
             (observed (observeWireRuntimeFailures runtime (lambda (method arguments error)
               (js-call reports :push (js-array method arguments error))))))
        (js-call assert :strictEqual (js-call observed :invoke "original") 17)
        (js-call assert :strictEqual (js-call observed :invokeAsync) pending)
        (await (js-call assert :rejects pending (lambda (error) (eq error failure))))
        (js-call assert :throws (lambda () (js-call observed :readString)) (lambda (error) (eq error failure)))
        (js-call assert :strictEqual (js-length reports) 1)
        (js-call assert :strictEqual (aref (aref reports 0) 2) failure)
        (js-call assert :strictEqual (get observed :closeModule) (get runtime :closeModule))
        (js-call assert :strictEqual (Object/isFrozen observed) t)
        (let ((broken-reporter (observeWireRuntimeFailures runtime (lambda (&rest ignored) (throw "reporter")))))
          (js-call assert :throws (lambda () (js-call broken-reporter :readString)) (lambda (error) (eq error failure))))
        (js-call (js-array "invoke" "invokeAsync" "readString") :forEach (lambda (method)
          (js-call assert :strictEqual (get (get observed method) :name) (get (get runtime method) :name))
          (js-call assert :strictEqual (get (get observed method) :length) (get (get runtime method) :length)))))))
  (test "wire fixture preserves explicit deployment and pure runtime options without creating another graph"
    (async ()
      (let* ((fixture (createWireProjectFixture))
             (host-modules (new globalThis.Map))
             (importer (lambda () (js-call assert :fail "fixture setup must not import host modules")))
             (settings (js-object :projectModuleBaseURL "file:///already-deployed/"
               :hostModules host-modules :importModule importer :maxSlots 8192)))
        (try
          (js-call assert :strictEqual (await (js-call fixture :options (js-object :project (js-object)) settings)) settings)
          (js-call assert :strictEqual (await (js-call fixture :options (js-object) settings)) settings)
          (js-call assert :strictEqual (get settings :hostModules) host-modules)
          (js-call assert :strictEqual (get settings :importModule) importer)
          (finally (await (js-call fixture :close)))))))
  (test "wire fixture requires exactly one actual managed control section before deploying a project"
    (lambda ()
      (let* ((header (js-array 0 97 115 109 1 0 0 0))
             (name (Array/from (js-call (new globalThis.TextEncoder) :encode "eliscript-managed-control")))
             (body (js-call (js-array (js-length name)) :concat name (js-array 2 123 125)))
             (section (js-call (js-array 0 (js-length body)) :concat body))
             (module (lambda (bytes) (new globalThis.WebAssembly.Module (globalThis.Uint8Array.from bytes)))))
        (js-call assert :throws (lambda () (readWireProjectDescriptor (funcall module header))) globalThis.TypeError)
        (js-call assert :deepStrictEqual (readWireProjectDescriptor
          (funcall module (js-call header :concat section))) (js-object))
        (js-call assert :throws (lambda () (readWireProjectDescriptor
          (funcall module (js-call header :concat section section)))) globalThis.TypeError))))

  (test "wire descriptor uses the exact production envelope decoder and rejects every malformed length UTF8 JSON and null payload"
    (lambda ()
      (let* ((header (js-array 0 97 115 109 1 0 0 0))
             (name (Array/from (js-call (new globalThis.TextEncoder) :encode "eliscript-managed-control")))
             (module (lambda (payload)
               (let* ((body (js-call (js-array (js-length name)) :concat name payload))
                      (section (js-call (js-array 0 (js-length body)) :concat body)))
                 (new globalThis.WebAssembly.Module (globalThis.Uint8Array.from (js-call header :concat section)))))))
        (js-call (js-array
          (js-array) (js-array 128) (js-array 128 128 128 128 16)
          (js-array 2 123) (js-array 2 123 125 0) (js-array 1 255)
          (js-array 1 123) (js-array 4 110 117 108 108)) :forEach
          (lambda (payload)
            (let* ((compiled (funcall module payload))
                   (original (try (readManagedModuleMetadata compiled "eliscript-managed-control")
                               (js-call assert :fail "invalid production envelope must refuse")
                               (catch error error))))
              (js-call assert :throws (lambda () (readWireProjectDescriptor compiled))
                (lambda (error)
                  (js-call assert :strictEqual (get error :constructor) (get original :constructor))
                  (js-call assert :strictEqual (get error :name) (get original :name))
                  (js-call assert :strictEqual (get error :code) (get original :code))
                  (js-call assert :strictEqual (get error :message) (get original :message)) t)))))
        (let ((compiled (funcall module (js-array 2 123 125))))
          (js-call assert :deepStrictEqual (readWireProjectDescriptor compiled)
            (readManagedModuleMetadata compiled "eliscript-managed-control")))))))
