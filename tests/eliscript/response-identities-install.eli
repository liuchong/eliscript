(module tests.response-identities-install
  (import "bun:test" :as framework)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "../../tools/backends/build.mjs" root)
  (import "./response-identities.mjs" runResponseIdentities closeResponseIdentities)
  (defconst title "graph identity segments preserve cross-segment aliases exact IDs cycles and cleanup with small private limits")
  (defconst original (Object/assign (js-object) framework))
  (defconst source (readFileSync (resolve root "tests/compiler-response-events-test-ground.mjs")))
  (unless (= (js-call (js-call (createHash "sha256") :update source) :digest "hex")
             "21e44029c4a5b89e6f18beab273be4812f28126e206af963728c92e69f2c85fa")
    (throw (new globalThis.TypeError "the complete original compiler response suite source identity changed")))
  (defvar count 0)
  (defvar restored false)
  (defun restore ()
    (unless restored
      (js-call (get original :mock) :module "bun:test" (lambda () original))
      (setq restored t)))
  (defconst replacement-test (new globalThis.Proxy (get original :test) (js-object
    :apply (lambda (target receiver arguments)
      (let ((forwarded (js-call arguments :slice)))
        (when (= (aref forwarded 2) 120000) (put forwarded 2 240000))
        (if (= (aref arguments 0) title)
          (progn
            (when (/= count 0) (throw (new globalThis.Error "duplicate original response identities case")))
            (setq count (1+ count)) (put forwarded 1 runResponseIdentities)
            (Reflect/apply target receiver forwarded))
          (Reflect/apply target receiver forwarded))))
    :get (lambda (target key receiver) (Reflect/get target key target)))))
  (defconst exports (Object/assign (js-object) original (js-object :test replacement-test)))
  (js-call original :beforeAll (lambda ()
    (try
      (unless (= count 1) (throw (new globalThis.Error "missing original response identities case")))
      (finally (restore)))))
  (js-call original :afterAll (lambda () (restore) (closeResponseIdentities)))
  (js-call (get original :mock) :module "bun:test" (lambda () exports)))
