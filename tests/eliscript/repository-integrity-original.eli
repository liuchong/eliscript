(module tests.repository-integrity-original
  (import "bun:test" test beforeAll afterAll expect)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:fs" readFileSync)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:module" createRequire)
  (import "node:crypto" createHash)
  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/integrity/check.mjs" checkGeneratedMarkerCoverage checkRepositoryIntegrity
    RepositoryIntegrityError repositoryTrackedFiles validateBenchmarkInventory validateBenchmarkSource validateImportRecords)
  (defvar compiler undefined) (defvar directory undefined)
  ;; Build a real fresh Emacs seed. Preparation has its own bounded budget;
  ;; both complete repository scans retain their original 15000ms deadlines.
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-integrity-tests-"))))
    (await (seedCompilerFixture directory))
    (setq compiler (funcall (createRequire (resolve directory "package.json")) (resolve directory "compiler.mjs")))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defasync json (file) (JSON/parse (await (readFile (resolve root file) "utf8"))))
  (defun clone (value) (globalThis.structuredClone value))
  (defconst archive (readFileSync (resolve root "tests/repository-integrity-test-ground.mjs") "utf8"))
  (defconst titles (js-array
    "repository dependencies and generated artifacts satisfy declared boundaries"
    "performance deferral is explicit and does not suppress dependency or artifact checks"
    "repository integrity rejects undeclared and boundary-crossing imports"
    "repository integrity isolates declared dependencies at the nearest package boundary"
    "repository integrity rejects stale benchmark source evidence"
    "repository integrity rejects incomplete artifact registries"
    "native FFI builtin is confined to its explicit measurement and test adapters"
    "TDZ capsule imports require the exact canonical generated bytes and declared output boundary"
))
  (js-call (expect (js-call (js-call (createHash "sha256") :update archive) :digest "hex")) :toBe
    "72d5fa7b1f5dff8502adcb798fd94080c1610c078b3cd999d1f25b96004f3e5b")
  (js-call (expect (js-call (Array/from (js-call archive :matchAll
    (new globalThis.RegExp "^test\\(\"([^\"]+)\"" "gm"))) :map (lambda (match) (aref match 1)))) :toEqual titles)
  (defun original-test (index body &rest deadline)
    (Reflect/apply test undefined (js-call (js-array (aref titles index) body) :concat deadline)))
  (original-test 0 (async ()
    (let* ((deferred (= (get (get globalThis.process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1"))
           (report (await (checkRepositoryIntegrity (js-object :root root :compiler compiler :deferPerformanceAcceptance deferred))))
           (contract (await (json "contracts/repository-integrity.json"))))
      (js-call (expect report) :toMatchObject (js-object :schemaVersion 1 :format "eliscript-repository-integrity-report" :version 1
        :dependency (js-object :packages (js-length (get contract :packages)) :localPackages 2 :lockfile "frozen" :coreExternalImports 0)
        :artifacts (js-object :deterministicArtifacts 6 :deterministicOutputs 11 :derivedArtifacts 4 :benchmarkArtifacts 14
          :benchmarkSources (if deferred 0 291))))
      (js-call (expect (get (get contract :artifacts) :deterministic)) :toContainEqual
        (js-object :source "runtime/core/protocol.eli" :output "runtime/core/protocol.mjs" :sourceMap "runtime/core/protocol.mjs.map"))
      (js-call (expect (get (get contract :artifacts) :deterministic)) :toContainEqual
        (js-object :source "runtime/core/collection.eli" :output "runtime/core/collection.mjs" :sourceMap "runtime/core/collection.mjs.map"))
      (js-call (expect (get (get report :dependency) :scannedJavaScript)) :toBeGreaterThan 0)
      (js-call (expect (get (get report :dependency) :scannedEliscript)) :toBeGreaterThan 0)
      (js-call (expect (get (get report :dependency) :totalImports)) :toBeGreaterThan 0)
      (when deferred (js-call (expect (get (get report :artifacts) :deferredBenchmarkSources)) :toEqual
        (get (get contract :artifacts) :benchmarkReports))))) 15000)
  (original-test 1 (async ()
    (let* ((contract (await (json "contracts/repository-integrity.json"))) (tracked (await (repositoryTrackedFiles root)))
           (broken (clone contract)) (workflow (clone contract)))
      (put (get broken :artifacts) :benchmarkReports (js-array))
      (await (js-call (get (expect (checkRepositoryIntegrity (js-object :root root :compiler compiler :contract broken
        :trackedFiles tracked :deferPerformanceAcceptance t))) :rejects) :toThrow "benchmark"))
      (put (js-call (get (get workflow :artifacts) :derived) :find
        (lambda (entry) (= (get entry :id) "browser-compatibility-workflow"))) :outputs (js-array "wrong.yml"))
      (await (js-call (get (expect (checkRepositoryIntegrity (js-object :root root :compiler compiler :contract workflow
        :trackedFiles tracked :deferPerformanceAcceptance t))) :rejects) :toThrow "browser workflow")))) 15000)
  (original-test 2 (async ()
    (let* ((contract (await (json "contracts/repository-integrity.json")))
           (boundary (js-object :file "runtime/core/value.mjs" :specifier "react" :kind "import-statement" :language "javascript"))
           (unknown (js-object :file "tools/example.mjs" :specifier "unlisted-package" :kind "import-statement" :language "javascript")))
      (js-call (expect (lambda () (validateImportRecords (js-array boundary unknown) contract))) :toThrow RepositoryIntegrityError)
      (js-call (expect (lambda () (validateImportRecords (js-array boundary) contract))) :toThrow "outside its allowed boundary")
      (js-call (expect (lambda () (validateImportRecords (js-array unknown) contract))) :toThrow "imports undeclared package"))))
  (original-test 3 (async ()
    (let* ((contract (await (json "contracts/repository-integrity.json")))
           (scopes (js-array (js-object :directory "tests/fixtures/packages/interop-consumer"
             :manifest "tests/fixtures/packages/interop-consumer/package.json" :name "@eliscript-fixtures/interop-consumer"
             :packages (js-array "@eliscript-fixtures/interop-consumer" "@eliscript-fixtures/native-container-consumer" "eliscript"))))
           (record (js-object :file "tests/fixtures/packages/interop-consumer/index.mjs"
             :specifier "@eliscript-fixtures/native-container-consumer" :kind "import-statement" :language "javascript")))
      (js-call (expect (validateImportRecords (js-array record) contract scopes)) :toMatchObject (js-object :externalImports 1))
      (js-call (expect (lambda () (validateImportRecords (js-array (Object/assign (js-object) record
        (js-object :specifier "undeclared-package"))) contract scopes))) :toThrow "in tests/fixtures/packages/interop-consumer/package.json")
      (js-call (expect (lambda () (validateImportRecords (js-array (Object/assign (js-object) record
        (js-object :file "tests/outside-package.mjs"))) contract scopes))) :toThrow "imports undeclared package"))))
  (original-test 4 (async ()
    (let* ((tracked (await (repositoryTrackedFiles root))) (file "benchmarks/compiler-runtime-scan-macos-arm64.json")
           (report (await (json file))))
      (put (get report :sourceDigest) :value (js-call "0" :repeat 64))
      (await (js-call (get (expect (validateBenchmarkSource root tracked file report)) :rejects) :toThrow "sourceDigest is stale")))))
  (original-test 5 (async ()
    (let* ((tracked (await (repositoryTrackedFiles root))) (contract (await (json "contracts/repository-integrity.json")))
           (generated (clone contract)) (benchmarks (clone contract)))
      (js-call (get (get generated :artifacts) :deterministic) :shift)
      (js-call (get (get benchmarks :artifacts) :benchmarkReports) :shift)
      (await (js-call (get (expect (checkGeneratedMarkerCoverage root tracked generated)) :rejects) :toThrow "markers differ from the artifact registry"))
      (js-call (expect (lambda () (validateBenchmarkInventory tracked benchmarks))) :toThrow "benchmark reports differ from the artifact registry"))))
  (original-test 6 (async ()
    (let* ((contract (await (json "contracts/repository-integrity.json")))
           (record (js-object :file "tests/native-backend.test.mjs" :specifier "bun:ffi" :kind "import-statement" :language "javascript")))
      (js-call (js-array "tests/native-backend.test.mjs" "tests/native-memory-long-branches.test.mjs"
        "tests/compiler-producer-rig.mjs" "tools/backends/native-benchmark.mjs") :forEach (lambda (file)
          (js-call (get (expect (lambda () (validateImportRecords (js-array (Object/assign (js-object) record
            (js-object :file file))) contract))) :not) :toThrow)))
      (js-call (js-array "bootstrap/backends/native.mjs" "runtime/core/value.mjs" "tools/unrelated.mjs" "tests/unrelated.test.mjs")
        :forEach (lambda (file) (js-call (expect (lambda () (validateImportRecords (js-array (Object/assign (js-object) record
          (js-object :file file))) contract))) :toThrow "outside its allowed boundary")))
      (js-call (expect (lambda () (validateImportRecords (js-array (Object/assign (js-object) record
        (js-object :specifier "bun:unlisted"))) contract))) :toThrow "imports undeclared package"))))
  (original-test 7 (async ()
    ;; Exercise an actual read before initialization, rather than replacing
    ;; Transpiler.scanImports input to manufacture the expected TDZ capsule.
    (let* ((contract (await (json "contracts/repository-integrity.json")))
           (javascript (js-call compiler :compile_string
             "(defun read () value) (read) (defconst value 1) (export read)" "tdz-integrity.eli"))
           (imports (js-call (new (get globalThis.Bun :Transpiler) (js-object :loader "js")) :scanImports javascript))
           (capsules (js-call imports :filter (lambda (record) (js-call (get record :path) :startsWith "data:")))))
      (js-call (expect capsules) :toHaveLength 1)
      (let* ((capsule (get (aref capsules 0) :path))
             (source (globalThis.Buffer.from (js-call capsule :slice (js-length "data:text/javascript;base64,")) "base64"))
             (record (js-object :file "runtime/core/protocol-impl.mjs" :specifier capsule :kind "import-statement" :language "javascript")))
        (js-call (expect (js-call source :toString "utf8")) :toBe
          "const E = ReferenceError; const T = TypeError; export function tdz(name) { throw new E(\"Cannot access '\" + name + \"' before initialization\"); } export function immutable() { throw new T(\"Assignment to constant variable.\"); }\n")
        (js-call (js-array "runtime/core/protocol-impl.mjs" "tests/snapshots/core.mjs") :forEach (lambda (file)
          (js-call (expect (validateImportRecords (js-array (Object/assign (js-object) record (js-object :file file))) contract))
            :toMatchObject (js-object :externalImports 0 :coreExternalImports 0))))
        (let ((changed (globalThis.Buffer.from source)))
          (put changed 0 (bit-xor (aref changed 0) 1))
          (js-call (js-array (+ "data:text/javascript;base64," (js-call changed :toString "base64"))
            (+ "data:text/javascript;base64," (js-call (globalThis.Buffer.from "export const tdz = () => {};") :toString "base64"))
            (+ capsule "#changed") (+ "data:text/javascript," (globalThis.encodeURIComponent (js-call source :toString "utf8"))))
            :forEach (lambda (specifier) (js-call (expect (lambda () (validateImportRecords
              (js-array (Object/assign (js-object) record (js-object :specifier specifier))) contract))) :toThrow "imports undeclared package"))))
        (js-call (js-array "runtime/core/unlisted.mjs" "tools/unrelated.mjs" "stdlib/core/protocol.eli") :forEach (lambda (file)
          (js-call (expect (lambda () (validateImportRecords (js-array (Object/assign (js-object) record (js-object :file file))) contract)))
            :toThrow "outside its allowed boundary"))))))
)
)
