(module tests.standard-library-fixture
  (import "../../dist/bootstrap/symbol.mjs" binding-name)
  (import "../../tools/backends/compiler-build.mjs" independentCompilerResources)
  (import "../../tools/backends/managed-runtime.mjs" readManagedModuleMetadata)
  (defconst standardLibraryFixturePlans (js-array

    (js-object :suite "tests/wasm-managed-transient-state.test.mjs" :resources false
      :sha256 "986cb2e42d9ac5e564dbbcb35711c85aa882ccdbbc121252374ea928fbd65e10")
    (js-object :suite "tests/wasm-managed-core-modules.test.mjs" :resources t
      :deadlineTitle "Given collection at every allocation when standard modules capture constructors callbacks aliases and metadata then original identities and error order survive GC"
      :functionalDeadline 240000
      :nativeDeadlineTitle "Given native code from the same complete typed standard-module graph when the original semantic cases run then Node and Bun results and root cleanup agree"
      :nativeFunctionalDeadline 480000
      :sha256 "7e25a6bee3debc3ac06f67bc4ac108d538e7dc4a3c2cf8ddb14cb2758f5a94fe")
    (js-object :suite "tests/wasm-managed-sorted-core.test.mjs" :resources t
      :deadlineTitle "Given actual provider sorted classes when bulk values cross the real phased WASM boundary then brands comparator metadata identity and pure target AVL updates survive GC"
      :functionalDeadline 360000
      :nativeDeadlineTitle "Given actual provider values when the same phased graph executes native machine code then provider identities and comparator effects are preserved without host sorting"
      :nativeFunctionalDeadline 600000
      :sha256 "426849575a415f0a8afbf82d10500a5b3a66cce0abf3d77893a3cd592ac4f779")
    (js-object :suite "tests/managed-stdlib-value-json.test.mjs" :resources false
      :sha256 "569a2bb8cd08c05b161c3f21b42480d8292066637d286639442ff993bd64fb12"
      :deadlineTitle "Given collection at every allocation when complete original stdlib modules execute then persistent callbacks identities and error recovery retain their roots"
      :functionalDeadline 240000
      :nativeDeadlineTitle "Given a true native library of the same original stdlib graph when the fixed and seeded semantic corpus runs then every result matches original Node JavaScript"
      :nativeFunctionalDeadline 480000)
    (js-object :suite "tests/wasm-managed-math-transcendental.test.mjs" :resources false
      :sha256 "0c658a980edd4c6b178d0131538094f530d96df1ab1a2ab513243c08771d0566"
      :deadlineTitle "Given cold held borrowed bound callback and Reflect Math routes When coerced overridden reflected or constructed Then every original call boundary is preserved"
      :functionalDeadline 120000)))
  (defun standardLibraryFixtureOptions (suite environment input)
    (let* ((plan (js-call standardLibraryFixturePlans :find (lambda (item) (= (get item :suite) suite))))
           (enabled (and plan (get plan :resources)
             (= (get environment :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE) "small")
             (= (get environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1")
             input (= (get input :maxSlots) 8192) (= (get input :initialBytes) 262144)
             (= (get input :maxBytes) 16777216)))
           (resources (when enabled (independentCompilerResources (js-object :profile "small"))))
           (effective (if enabled (Object/assign (js-object) input (get resources :budget)) input)))
      (js-object :options effective :resourceAcceptance (if enabled "deferred" "baseline")
        :originalCapacityAcceptance (if enabled "DEFERRED / NOT ACCEPTED" "required-by-original-gate")
        :originalRuntimeOptions input :effectiveRuntimeOptions effective)))
  (defun standardLibraryFixtureTestRegistration (original plan environment cases)
    (let* ((expected (and plan (js-call standardLibraryFixturePlans :find
                      (lambda (item) (= (get item :suite) (get plan :suite))))))
           (enabled (and expected (> (get expected :functionalDeadline 0) 0)
             (= (get expected :sha256) (get plan :sha256)) (Array/isArray cases)
             (= (get environment :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE) "small")
             (= (get environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1"))))
      (if (not enabled) original
        (letfn ((wrap (target)
          (new globalThis.Proxy target (js-object
            :apply (lambda (actual receiver arguments)
              (let ((forwarded arguments))
                (cond
                  ((and (= (js-length arguments) 3) (= (value-type (aref arguments 1)) "function")
                        (js-call (js-array 30000 120000) :includes (aref arguments 2))
                        (or (not (get expected :deadlineTitle)) (= (aref arguments 0) (get expected :deadlineTitle))
                            (= (aref arguments 0) (get expected :nativeDeadlineTitle)))
                        (js-call cases :some (lambda (record)
                          (let ((item (get record :originalCase)))
                            (and (= (get item :title) (aref arguments 0)) (= (get item :timeoutMs) (aref arguments 2)))))))
                   (setq forwarded (js-call arguments :slice))
                   (put forwarded 2 (if (= (aref arguments 0) (get expected :nativeDeadlineTitle))
                     (get expected :nativeFunctionalDeadline) (get expected :functionalDeadline))))
                  ((and (= (get expected :suite) "tests/wasm-managed-sorted-core.test.mjs")
                        (= (js-length arguments) 3) (= (value-type (aref arguments 1)) "function")
                        (= (value-type (aref arguments 0)) "string")
                        (js-call (js-array 600000 1800000) :includes (aref arguments 2)))
                   (setq forwarded (js-call arguments :slice))
                   (put forwarded 2 (if (= (aref arguments 2) 600000) 1800000 2700000))))
                (Reflect/apply actual receiver forwarded)))
            :get (lambda (actual key receiver)
              (let ((value (Reflect/get actual key actual)))
                (cond ((and (= key "skipIf") (= (value-type value) "function"))
                       (lambda (&rest arguments) (wrap (Reflect/apply value actual arguments))))
                      ((= (value-type value) "function") (js-call value :bind actual)) (t value))))))))
          (wrap original)))))
  (defun readStandardLibraryDescriptor (bytes)
    (let* ((module (if (js-call globalThis.WebAssembly.Module (get globalThis.Symbol :hasInstance) bytes)
                     bytes (new globalThis.WebAssembly.Module bytes)))
           (sections (globalThis.WebAssembly.Module.customSections module "eliscript-managed-control")))
      (unless (= (js-length sections) 1)
        (throw (new globalThis.TypeError "standard library fixture requires its actual managed descriptor")))
      (readManagedModuleMetadata module "eliscript-managed-control")))
  (defun sortedFixtureSourceError (runtime error)
    ;; The original low-level invoke API transfers an owned source throw.
    ;; Read its actual fields without creating a cached, live source view.
    (let ((name-key (js-call runtime :string "name")) (message-key undefined)
          (name undefined) (message undefined) (decoded undefined))
      (try
        (progn
          (setq name (js-call runtime :objectGet error name-key))
          (unless (= (js-call runtime :readString name) "TypeError") (throw error))
          (setq message-key (js-call runtime :string "message")
                message (js-call runtime :objectGet error message-key))
          (setq decoded (new globalThis.TypeError (js-call runtime :readString message))))
        (finally
          (js-call (js-array name-key message-key name message) :forEach
            (lambda (token) (unless (undefined? token) (js-call runtime :release token))))))
      (js-call runtime :release error) decoded))
  (defun standardLibraryRuntimeFacade (runtime descriptor &rest proofs)
    (unless (and descriptor (= (get descriptor :format) "eliscript-managed-control")
                 (= (get descriptor :version) 1) (Array/isArray (get descriptor :functions)))
      (throw (new globalThis.TypeError "standard library fixture requires actual export metadata")))
    (let* ((proof (aref proofs 0))
           (sorted-plan (js-call standardLibraryFixturePlans :find (lambda (item)
             (= (get item :suite) "tests/wasm-managed-sorted-core.test.mjs"))))
           (sorted-source (and proof (= (get proof :suite) "tests/wasm-managed-sorted-core.test.mjs")
             (= (get proof :sha256) (get sorted-plan :sha256))))
           (names (new globalThis.Set (js-call (get descriptor :functions) :map (lambda (item) (get item :name)))))
           (descriptors (Object/getOwnPropertyDescriptors runtime))
           (facade (Object/create (Object/getPrototypeOf runtime))))
      (unless (and (get descriptors :invoke) (Object/hasOwn (get descriptors :invoke) "value")
                   (= (value-type (get (get descriptors :invoke) :value)) "function"))
        (throw (new globalThis.TypeError "standard library fixture requires the actual invoke API")))
      (js-call (js-array "invoke" "invokeAsync") :forEach (lambda (method)
        (let ((entry (get descriptors method)))
          (when entry
            (unless (and (Object/hasOwn entry "value") (= (value-type (get entry :value)) "function"))
              (throw (new globalThis.TypeError "standard library fixture requires actual source invocation methods")))
            (let* ((original (get entry :value))
                   (invoke (lambda (name &rest arguments)
                     (let ((selected name)
                           (trace (= (get (get globalThis.process :env) :ELISCRIPT_TRACE_TEST_CHILDREN) "1"))
                           (started (performance/now)))
                       (when (and (= (value-type name) "string") (not (js-call names :has name)) (js-call name :includes "-"))
                         (let ((public (try (binding-name name) (catch ignored name))))
                           (when (js-call names :has public) (setq selected public))))
                       (when trace (try
                         (console/error "standard-library-invoke-start" (js-object :method method :name selected))
                         (catch ignored nil)))
                       (try
                         (Reflect/apply original runtime (js-call (js-array selected) :concat arguments))
                         (catch error
                           (when (and sorted-source (= method "invoke")
                                      (js-call (js-array "throw_comparison" "throw-comparison") :includes selected)
                                      (not (nullish? error)) (= (value-type error) "object")
                                      (= (get error :kind) 13))
                             (throw (sortedFixtureSourceError runtime error)))
                           ;; Report only the selected entry; never inspect a
                           ;; thrown user value or replace the original error.
                           (try (js-call globalThis.console :error "standard library invocation failed"
                             (js-object :method method :sourceName name :selectedName selected))
                             (catch ignored nil))
                           (throw error))
                         (finally (when trace (try
                           (console/error "standard-library-invoke-end" (js-object :method method :name selected
                             :elapsedMs (Math/round (- (performance/now) started))))
                           (catch ignored nil)))))))))
              (Object/defineProperties invoke (js-object
                :name (Object/getOwnPropertyDescriptor original "name")
                :length (Object/getOwnPropertyDescriptor original "length")))
              (put entry :value invoke))))))
      (when (= (get (get globalThis.process :env) :ELISCRIPT_TRACE_TEST_CHILDREN) "1")
        ;; Initialization and phased exports bypass the low-level invoke API.
        ;; Forward the original argument list and receiver without replay.
        (letfn ((trace-call (method original receiver)
          (lambda (&rest arguments)
            (let ((started (performance/now)))
              (console/error "standard-library-phase-start" method)
              (try (Reflect/apply original receiver arguments)
                (finally
                  (try
                    (console/error "standard-library-phase-end" (JSON/stringify
                      (js-object :method method :elapsedMs (Math/round (- (performance/now) started))
                        :stats (js-call runtime :stats))))
                    (catch ignored nil))))))))
          (let ((entry (get descriptors :initializeModule)))
            (when (and entry (Object/hasOwn entry "value") (= (value-type (get entry :value)) "function"))
              (put entry :value (trace-call "initializeModule" (get entry :value) runtime))))
          (let* ((entry (get descriptors :project)) (project (and entry (get entry :value))))
            (when (and project (= (value-type (get project :invoke)) "function"))
              (let* ((properties (Object/getOwnPropertyDescriptors project))
                     (invoke (get properties :invoke)) (view (Object/create (Object/getPrototypeOf project))))
                (when (and invoke (Object/hasOwn invoke "value"))
                  (put invoke :value (trace-call "project.invoke" (get invoke :value) project))
                  (Object/defineProperties view properties)
                  (put entry :value view)))))))
      (Object/defineProperties facade descriptors)
      (unless (Reflect/isExtensible runtime) (Object/preventExtensions facade)) facade))
  (export standardLibraryFixturePlans standardLibraryFixtureOptions readStandardLibraryDescriptor standardLibraryRuntimeFacade standardLibraryFixtureTestRegistration))
