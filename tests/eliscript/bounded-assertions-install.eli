(module tests.bounded-assertions-install
  (import "bun:test" mock afterAll)
  (import "node:assert/strict" :default original)
  (import "node:assert/strict" :as exports)
  (import "node:fs" readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "../../tools/backends/build.mjs" root)
  (import "../../tools/testing/bounded-assertions.mjs" boundedStrictAssertions)
  (defconst suite "tests/compiler-package-session.test.mjs")
  (unless (js-call (get globalThis.process :argv) :some
            (lambda (argument) (= (resolve root argument) (resolve root suite))))
    (throw (new globalThis.TypeError "bounded compiler assertions require their exact original suite")))
  (unless (= (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root suite))) :digest "hex")
             "6f0000e0b65e429a4d270a05f6c866acb4f465189755f3823f3ecf0249252a1b")
    (throw (new globalThis.TypeError "bounded compiler assertions refuse changed original suite bytes")))
  (defconst saved (Object/assign (js-object) exports))
  (defconst facade (boundedStrictAssertions original))
  (js-call mock :module "node:assert/strict" (lambda ()
    (Object/assign (js-object) saved (js-object :default facade
      :equal (get facade :equal) :strictEqual (get facade :strictEqual)
      :deepEqual (get facade :deepEqual) :deepStrictEqual (get facade :deepStrictEqual)))))
  (afterAll (lambda () (js-call mock :module "node:assert/strict" (lambda () saved)))))
