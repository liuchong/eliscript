(module tests.compiler-literal-corpus
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdir mkdtemp rm symlink)
  (import "node:path" resolve posix dirname basename relative)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawn)
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "node:util" isDeepStrictEqual)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/backends/compiler-corpus-project-adapters.mjs" addOriginalProjectPrograms)
  (import "../tools/backends/compiler-matrix.mjs" loadOriginalCompilerManifests)
  (import "../tools/backends/compiler-build.mjs" independentCompilerResources loadCompilerSources)
  (import "../tools/backends/compiler-bootstrap.mjs" compilerSourceIdentity)
  (import "../tools/backends/compiler-corpus.mjs"
    loadOriginalCompilerCorpus readOriginalLiteralRuntimeAudit compilerCorpusRequest createOriginalCorpusSourceReader)
  (import "../tools/backends/compiler-corpus-legacy.mjs" :as legacy-corpus)
  (import "../tools/backends/compiler-corpus-execution.mjs" createOriginalSeedOracle)
  (import "../tools/backends/compiler-corpus-runtime-adapters.mjs"
    originalRuntimeCaseLocators addOriginalStdlibRuntimeAdapters)
  (import "../tools/backends/compiler-corpus-managed-cases.mjs" originalSourceCaseLocators)
  (import "../dist/bootstrap/reader.mjs" read-string)
  (import "../dist/bootstrap/compiler.mjs" compile-ir-string emit-ir-string emit-ir-string-with-source-map)

  (defconst literal-suite "tests/literal-runtime.test.mjs")
  (defconst literal-source "tests/eliscript/literal-runtime.eli")
  (defconst literal-titles (js-array
    "persistent literals and quoted data preserve language value categories"
    "hash-map rejects incomplete pairs in both compilers"
    "explicit host-only modules do not link the persistent runtime"
    "maintained Eliscript sources use explicit host constructors"
    "portable closures produce persistent values for the versioned worker codec"))
  (defconst literal-timeouts (js-array 60000 60000 60000 5000 60000))
  (defun literal-hash (bytes)
    (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))

  (defasync literal-host-records ()
    (let* ((services (await (literal-services))) (options (get services :options))
           (text (get options :text)) (source (await (funcall text literal-suite)))
           (entry "tests/fixtures/literal-runtime.mjs")
           (records (js-array (js-object :id "stable-compatibility:program:tests/fixtures/literal-runtime.eli"
             :entry entry :modules (js-array (js-object :id entry :filename "tests/fixtures/literal-runtime.eli"
               :source (await (funcall text "tests/fixtures/literal-runtime.eli"))))
             :request (js-object :operation "project" :resolveImports t)
             :execution (js-object :host "tests/fixtures/literal-runtime-host.mjs"
               :hostSource (await (funcall text "tests/fixtures/literal-runtime-host.mjs")))))))
      (await (addOriginalStdlibRuntimeAdapters (Object/assign (js-object) options
        (js-object :records records :locators (js-call (originalSourceCaseLocators literal-suite source)
          :concat (originalRuntimeCaseLocators literal-suite source) (get options :locators))
          :add (lambda (record) (js-call records :push record))))))
      records))

  (defun literal-run-host (host arguments environment)
    (new globalThis.Promise (lambda (accept reject)
      (let* ((command (if (get (get globalThis.process :versions) :bun)
                        (get globalThis.process :execPath) "bun"))
             (child (spawn command (js-call (js-array host) :concat arguments)
               (js-object :cwd root :env environment :stdio (js-array "ignore" "pipe" "pipe"))))
             (stdout "") (stderr ""))
        (js-call (get child :stdout) :setEncoding "utf8")
        (js-call (get child :stderr) :setEncoding "utf8")
        (js-call (get child :stdout) :on "data" (lambda (text) (setq stdout (+ stdout text))))
        (js-call (get child :stderr) :on "data" (lambda (text) (setq stderr (+ stderr text))))
        (js-call child :once "error" reject)
        (js-call child :once "close" (lambda (code signal)
          (funcall accept (js-object :code code :signal signal :stdout stdout :stderr stderr))))))))

  (test "the actual host-only CLI replay retains the source-map API final newline and executes every original shape assertion"
    (async ()
      (let* ((records (await (literal-host-records)))
             (record (js-call records :find (lambda (item) (= (get item :id) "original-program:literal-runtime-host-only"))))
             (module (aref (get record :modules) 0)) (source (get module :source))
             (entry (get record :entry)) (program (compile-ir-string source (get module :filename)))
             (project (emit-ir-string-with-source-map program source entry (get module :filename)))
             (cli (emit-ir-string-with-source-map program source (basename entry)
               (relative (dirname (resolve "/seed-output" entry)) (resolve "/sources" "host-only.eli"))))
             (directory (await (mkdtemp (resolve (tmpdir) "eliscript-literal-cli-map-"))))
             (selected (resolve directory "selected")) (reference (resolve directory "reference"))
             (host (resolve directory "tests/host.mjs")) (input (resolve selected entry))
             (seed (resolve reference entry)) (before (get project :sourceMap)))
        (try
          (progn
            (await (mkdir (dirname input) (js-object :recursive t)))
            (await (mkdir (dirname seed) (js-object :recursive t)))
            (await (mkdir (dirname host) (js-object :recursive t)))
            (await (symlink (resolve root "runtime") (resolve directory "runtime") "dir"))
            (await (writeFile host (get (get record :execution) :hostSource)))
            (await (writeFile input (get project :javascript)))
            (await (writeFile (+ input ".map") before))
            (await (writeFile seed (+ (get cli :javascript) "//# sourceMappingURL=" (basename (+ entry ".map")) "\n")))
            (await (writeFile (+ seed ".map") (get cli :sourceMap)))
            (let* ((environment (Object/assign (js-object) (get globalThis.process :env)
                       (js-object :ELISCRIPT_ORIGINAL_SOURCE_ROOT root
                         :ELISCRIPT_ORIGINAL_REFERENCE_PRODUCT_ROOT reference
                         :ELISCRIPT_ORIGINAL_JAVASCRIPT_PRODUCT_ROOT selected)))
                   (actual (await (literal-run-host host (js-array selected) environment)))
                   (output (resolve selected "original-cli-view" entry)))
              (js-call assert :strictEqual (get actual :code) 0 (get actual :stderr))
              (js-call assert :strictEqual (get actual :signal) nil)
              (js-call assert :strictEqual (get actual :stdout) "")
              (js-call assert :strictEqual (js-call (get cli :sourceMap) :endsWith "}\n") t)
              (js-call assert :strictEqual (await (readFile (+ output ".map") "utf8")) (get cli :sourceMap))
              (js-call assert :strictEqual (await (readFile output "utf8")) (await (readFile seed "utf8")))
              (js-call assert :strictEqual (await (readFile (+ input ".map") "utf8")) before)))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (defasync literal-services (&optional change-source fail-asset)
    (let* ((parity (JSON/parse (await (readFile (resolve root "contracts/compiler-parity-corpus.json") "utf8"))))
           (stable (JSON/parse (await (readFile (resolve root "contracts/stable-compatibility-corpus.json") "utf8"))))
           (records (js-array)) (locators (js-array)) (index 0))
      (while (< index (js-length literal-titles))
        (js-call locators :push (js-object :file literal-suite
          :id (+ "literal-original:" index) :contains (aref literal-titles index)))
        (setq index (1+ index)))
      (js-object :records records :options (js-object
        :sourceRoot root :bootstrapSources (get parity :bootstrapSources)
        :stableFiles (new globalThis.Set (get stable :fixtureFiles)) :locators locators
        :text (async (filename)
          (let ((source (await (readFile (resolve root filename) "utf8"))))
            (if (and (= filename literal-suite) (= (value-type change-source) "function"))
              (funcall change-source source) source)))
        :file (async (filename)
          (when (and (not (nullish? fail-asset)) (= filename (get fail-asset :filename)))
            (throw (get fail-asset :error)))
          (let ((bytes (await (readFile (resolve root filename)))))
            (js-object :file filename :sha256 (literal-hash bytes) :bytes (js-length bytes))))
        :add (lambda (record) (js-call records :push record))))))

  (test "literal replay binds the complete generated Eli suite all original cases real source assets and the independent oracle"
    (async ()
      (let* ((services (await (literal-services))) (options (get services :options))
             (mapped (await (addOriginalProjectPrograms options)))
             (records (get services :records)) (record (aref records 0))
             (source (await (readFile (resolve root literal-suite) "utf8")))
             (bytes (await (readFile (resolve root literal-suite))))
             (execution (get record :execution)) (original (get record :original))
             (setup (get execution :setupReplacement)))
        (js-call assert :deepStrictEqual mapped (js-array literal-suite))
        (js-call assert :strictEqual (js-length records) 1)
        (js-call assert :strictEqual (get record :id) "original-program:compiler-literal-runtime-complete")
        (js-call assert :strictEqual (get record :kind) "project")
        (js-call assert :strictEqual (js-length (get record :modules)) 13)
        (js-call assert :strictEqual (get record :entry) "bootstrap/compiler/compiler.mjs")
        (js-call assert :deepStrictEqual (get (get record :request) :entries)
          (js-call (get options :bootstrapSources) :map (lambda (filename)
            (+ (js-call filename :slice 0 -4) ".mjs"))))
        (js-call assert :strictEqual (get (get record :request) :sourceMap) t)
        (let ((index 0))
          (while (< index 13)
            (let* ((filename (aref (get options :bootstrapSources) index))
                   (module (aref (get record :modules) index)))
              (js-call assert :strictEqual (get module :filename) filename)
              (js-call assert :strictEqual (get module :source) (await (readFile (resolve root filename) "utf8"))))
            (setq index (1+ index))))
        ;; No registration prefix, string rewrite or forwarding JS is added:
        ;; the maintained generated suite owns its selected/reference setup.
        (js-call assert :strictEqual (get execution :hostSource) source)
        (js-call assert :strictEqual (get original :sourceSha256) (literal-hash bytes))
        (js-call assert :strictEqual (get setup :sourceSha256) (literal-hash bytes))
        (js-call assert :deepStrictEqual (get setup :changes) (js-array))
        (js-call assert :deepStrictEqual (get setup :originalCaseTimeouts) literal-timeouts)
        (js-call assert :deepStrictEqual (get original :originalAssertions) literal-titles)
        (js-call assert :strictEqual (get execution :timeoutMs) 245000)
        (js-call assert :strictEqual (get execution :referenceArtifact) t)
        (js-call assert :strictEqual (get execution :runtimeLaunchers) t)
        (js-call assert :strictEqual (get execution :compilerSourceMaps) t)
        (js-call assert :deepStrictEqual (get execution :arguments) (js-array (js-object :directory t)))
        (js-call assert :strictEqual (get (get record :expected) :kind) "seed-program")
        (js-call assert :strictEqual (get (get record :expected) :oracleRequired) t)
        (js-call assert :strictEqual (get (get record :expected) :stdout) "")
        (js-call assert :deepStrictEqual (get original :regions)
          (js-array (js-object :start 0 :end (js-length source) :byteStart 0
            :byteEnd (js-length bytes) :sha256 (literal-hash bytes))))
        (js-call literal-titles :forEach (lambda (title index)
          (js-call assert :ok (js-call source :includes title))
          ;; The original source-only audit still executes in the full host
          ;; suite, but cannot masquerade as selected-language semantics.
          (js-call assert :strictEqual
            (js-call (get record :coverage) :includes (+ "literal-original:" index)) (/= index 3))))
        (let ((files (js-array literal-suite literal-source
                       "tests/fixtures/literal-runtime.eli" "tests/fixtures/literal-runtime-host.mjs"
                       "bin/eliscript" "bin/eliscript-portable" "bin/eliscript-bootstrap" "bootstrap/host/bun.mjs"))
              (assets (get original :sourceAssets)) (index 0))
          (while (< index (js-length files))
            (let* ((filename (aref files index))
                   (asset (js-call assets :find (lambda (value) (= (get value :file) filename)))))
              (js-call assert :ok asset (+ "missing authentic literal source asset: " filename))
              (js-call assert :strictEqual (get asset :sourceSha256)
                (literal-hash (await (readFile (resolve root filename))))))
            (setq index (1+ index)))))))

  (test "literal replay refuses omission of any original assertion including the source audit or an undeclared locator"
    (async ()
      (let ((index 0))
        (while (< index (js-length literal-titles))
          (let* ((title (aref literal-titles index))
                 (services (await (literal-services
                   (lambda (source) (js-call source :replace title "omitted original assertion"))))))
            (await (js-call assert :rejects (addOriginalProjectPrograms (get services :options))
              (lambda (error) (= (get error :name) "TypeError"))))
            (js-call assert :deepStrictEqual (get services :records) (js-array)))
          (setq index (1+ index))))
      (let* ((services (await (literal-services))) (options (get services :options)))
        (js-call (get options :locators) :push
          (js-object :id "literal-forged" :file literal-suite :contains "not in the complete original suite"))
        (await (js-call assert :rejects (addOriginalProjectPrograms options)
          (lambda (error) (= (get error :name) "TypeError"))))
        (js-call assert :deepStrictEqual (get services :records) (js-array)))))

  (test "literal replay requires all thirteen compiler modules and authentic Eli source evidence before publishing a record"
    (async ()
      (let* ((services (await (literal-services))) (options (get services :options)))
        (put options :bootstrapSources (js-call (get options :bootstrapSources) :slice 0 12))
        (await (js-call assert :rejects (addOriginalProjectPrograms options)
          (lambda (error) (= (get error :name) "TypeError"))))
        (js-call assert :deepStrictEqual (get services :records) (js-array)))
      (let* ((marker (js-object :original "Eli source evidence failure"))
             (services (await (literal-services undefined (js-object :filename literal-source :error marker)))))
        (await (js-call assert :rejects (addOriginalProjectPrograms (get services :options))
          (lambda (error) (eq error marker))))
        (js-call assert :deepStrictEqual (get services :records) (js-array)))))

  (test "literal source audit binds one authentic complete Eli form and rejects missing assertions duplicate forms or mismatched source bytes"
    (async ()
      (let* ((source (await (readFile (resolve root literal-source) "utf8")))
             (hash (literal-hash (js-call Buffer :from source)))
             (binding (readOriginalLiteralRuntimeAudit source literal-source hash))
             (region (get binding :region))
             (form (js-call source :slice (get region :start) (get region :end)))
             (signature "(defasync literal-runtime-source-audit ()")
             (assertion "(js-call (expect violations) :toEqual (js-array))"))
        (js-call assert :strictEqual (get binding :file) literal-source)
        (js-call assert :strictEqual (get binding :sourceSha256) hash)
        (js-call assert :strictEqual (get region :start) (js-call source :indexOf signature))
        (js-call assert :ok (js-call form :startsWith signature))
        (js-call assert :ok (js-call form :includes assertion))
        (js-call assert :strictEqual (get region :sha256) (literal-hash (js-call Buffer :from form)))
        (js-call assert :strictEqual (get region :byteStart)
          (js-call Buffer :byteLength (js-call source :slice 0 (get region :start))))
        (js-call assert :strictEqual (get region :byteEnd)
          (js-call Buffer :byteLength (js-call source :slice 0 (get region :end))))
        ;; Reader offsets count code points. An astral prefix must shift the
        ;; archived UTF16 and UTF8 boundaries by their actual different widths.
        (let* ((prefix ";😀孤立\ud800\n") (shifted (+ prefix source))
               (next (readOriginalLiteralRuntimeAudit shifted literal-source
                       (literal-hash (js-call Buffer :from shifted)))))
          (js-call assert :strictEqual (get (get next :region) :start) (+ (js-length prefix) (get region :start)))
          (js-call assert :strictEqual (get (get next :region) :end) (+ (js-length prefix) (get region :end)))
          (js-call assert :strictEqual (get (get next :region) :byteStart)
            (+ (js-call Buffer :byteLength prefix) (get region :byteStart)))
          (js-call assert :strictEqual (get (get next :region) :sha256) (get region :sha256)))
        (let ((invalid (js-array
                (js-call source :replace signature "(defasync missing-source-audit ()")
                (js-call source :replace signature "(defun literal-runtime-source-audit ()")
                (js-call source :replace signature "(defasync literal-runtime-source-audit (argument)")
                (js-call source :replace assertion "(js-array)")
                (js-call source :replace assertion (+ ";" assertion "\n(js-array)"))
                (+ source "\n" form "\n"))) (index 0))
          (while (< index (js-length invalid))
            (let ((changed (aref invalid index)))
              (js-call assert :throws
                (lambda () (readOriginalLiteralRuntimeAudit changed literal-source
                             (literal-hash (js-call Buffer :from changed))))
                (lambda (error) (= (get error :name) "TypeError"))))
            (setq index (1+ index))))
        (js-call assert :throws
          (lambda () (readOriginalLiteralRuntimeAudit source literal-source (js-call "0" :repeat 64)))
          (lambda (error) (= (get error :name) "TypeError"))))))

  (test "the literal source-only replacement preserves every other original recipe locator and gate while restoring full ordered coverage"
    (async ()
      (let* ((originals (await (loadOriginalCompilerManifests (js-object :sourceRoot root))))
             (stable (get (js-call (get originals :manifests) :find
                       (lambda (item) (= (get item :id) "stable-compatibility"))) :document))
             (conformance (JSON/parse (await (readFile (resolve root "tests/conformance/manifest.json") "utf8"))))
             (ids (js-array)))
        (js-call (get stable :stableCoreFeatureIds) :forEach (lambda (feature-id)
          (let ((feature (js-call (get conformance :features) :find (lambda (item) (= (get item :id) feature-id)))))
            (js-call (get feature :evidence) :forEach (lambda (locator index)
              (when (and (= (get locator :file) literal-suite) (= (get locator :contains) (aref literal-titles 3)))
                (js-call ids :push (+ "stable-compatibility:evidence:" feature-id ":" index))))))))
        (js-call assert :strictEqual (js-length ids) 1)
        (let* ((id (aref ids 0))
               (private-originals (Object/assign (js-object) originals
                 (js-object :requiredCoverage (js-call (get originals :requiredCoverage) :filter (lambda (value) (/= value id))))))
               (before (Array/from (get originals :requiredCoverage)))
               (legacy (await (js-call legacy-corpus :loadOriginalCompilerCorpus
                                (js-object :sourceRoot root :originals private-originals))))
               (actual (await (loadOriginalCompilerCorpus (js-object :sourceRoot root :originals originals))))
               (gate (get actual :originalGateEvidence)) (legacy-gate (get legacy :originalGateEvidence))
               (dependencies (get gate :hostOnlyDependencies))
               (audit (js-call dependencies :filter (lambda (item) (= (get item :coverageId) id))))
               (expected-gate-ids (new globalThis.Set (get legacy-gate :coverageIds))))
          (js-call assert :deepStrictEqual (get originals :requiredCoverage) before)
          (js-call assert :deepStrictEqual (get actual :coverageIds) before)
          (js-call expected-gate-ids :add id)
          (js-call assert :deepStrictEqual (get gate :coverageIds)
            (js-call before :filter (lambda (value) (js-call expected-gate-ids :has value))))
          (js-call assert :strictEqual (js-length audit) 1)
          (js-call assert :strictEqual (get (aref audit 0) :kind) "source-only-case")
          (js-call assert :strictEqual (get (aref audit 0) :file) literal-source)
          (js-call assert :strictEqual (get (aref audit 0) :sourceSha256)
            (literal-hash (await (readFile (resolve root literal-source)))))
          (js-call assert :strictEqual (js-call (get actual :records) :some
            (lambda (record) (js-call (get record :coverage) :includes id))) false)
          (let ((ids (js-array "original-program:formatter-node"
                              "original-program:macro-generated-names-bun"
                              "original-program:macro-generated-names-node")) (index 0))
            (while (< index (js-length ids))
              (let* ((record (js-call (get actual :records) :find (lambda (item) (= (get item :id) (aref ids index)))))
                     (before-record (funcall globalThis.structuredClone record))
                     (wasm (compilerCorpusRequest record "wasm"))
                     (native (compilerCorpusRequest record "native")))
                (js-call assert :strictEqual (get wasm :phased) t)
                (js-call assert :strictEqual (get native :phased) t)
                (js-call assert :strictEqual (get wasm :memory) undefined)
                (js-call assert :strictEqual (get native :memory) undefined)
                (js-call assert :deepStrictEqual (get wasm :modules) (get record :modules))
                (js-call assert :deepStrictEqual (get native :modules) (get record :modules))
                (js-call assert :strictEqual (get wasm :entry) (get record :entry))
                (js-call assert :strictEqual (get native :entry) (get record :entry))
                (js-call assert :deepStrictEqual (compilerCorpusRequest record "javascript")
                  (js-call legacy-corpus :compilerCorpusRequest record "javascript"))
                (js-call assert :strictEqual (isDeepStrictEqual record before-record) t
                  "request transport must not change the complete retained source record")
                (let* ((explicit (Object/assign (js-object) record (js-object
                                   :request (Object/assign (js-object) (get record :request) (js-object :phased false)))))
                       (request (compilerCorpusRequest explicit "wasm")))
                  (js-call assert :strictEqual (get request :phased) false)))
              (setq index (1+ index))))
          (let* ((record (js-call (get actual :records) :find
                           (lambda (item) (= (get item :id) "original-program:compiler-module-bootstrap-reader"))))
                 (before-record (funcall globalThis.structuredClone record))
                 (options (js-object :profile "full-compiler"))
                 (resources (independentCompilerResources options))
                 (targets (js-array "wasm" "native")) (index 0))
            (js-call assert :strictEqual (get (get record :execution) :runtimeProfile) "compiler")
            (while (< index (js-length targets))
              (let* ((target (aref targets index)) (request (compilerCorpusRequest record target options))
                     (explicit (Object/assign (js-object) record
                       (js-object :memory (js-object :initialPages 4 :maximumPages 256))))
                     (overrides (js-object :profile "full-compiler" :memory (js-object :initialPages 8192))))
                (js-call assert :deepStrictEqual (get request :memory) (get resources :memory))
                (js-call assert :deepStrictEqual (get (compilerCorpusRequest explicit target options) :memory) (get explicit :memory))
                (js-call assert :deepStrictEqual (get (compilerCorpusRequest record target overrides) :memory)
                  (get (independentCompilerResources overrides) :memory))
                (js-call assert :deepStrictEqual (get (compilerCorpusRequest record target) :memory)
                  (get (independentCompilerResources) :memory))
                (js-call assert :deepStrictEqual (get request :modules) (get record :modules)))
              (setq index (1+ index)))
            (js-call assert :strictEqual (isDeepStrictEqual record before-record) t)
            (js-call assert :deepStrictEqual (compilerCorpusRequest record "javascript" options)
              (js-call legacy-corpus :compilerCorpusRequest record "javascript" options)))
          (let* ((provider-bytes (await (readFile (resolve root "platform/http.mjs"))))
                 (reader (createOriginalCorpusSourceReader (js-object :sourceRoot root)))
                 (provider (await (js-call reader :file "platform/http.mjs")))
                 (expected (Object/assign (js-object) legacy
                             (js-object :evidence (Array/from (get legacy :evidence))
                               :records (Array/from (get legacy :records))
                               :expectedIds (Array/from (get legacy :expectedIds)))))
                 (expected-evidence (get expected :evidence))
                 (retained (js-call expected-evidence :filter (lambda (asset) (= (get asset :file) "platform/http.mjs"))))
                 (actual-providers (js-call (get actual :evidence) :filter
                                     (lambda (asset) (= (get asset :file) "platform/http.mjs"))))
                 (without-audit (Object/assign (js-object) actual (js-object
                   :coverageIds (get legacy :coverageIds)
                   :originalGateEvidence (Object/assign (js-object) gate (js-object
                     :coverageIds (get legacy-gate :coverageIds)
                     :hostOnlyDependencies (js-call dependencies :filter (lambda (item) (/= (get item :coverageId) id)))))))))
            ;; The request-source transport independently adds one real HTTP
            ;; provider asset. Authenticate that precise addition; never drop
            ;; or normalize the remaining source/recipe document for parity.
            (js-call assert :strictEqual (get provider :file) "platform/http.mjs")
            (js-call assert :strictEqual (get provider :encoding) "base64")
            (js-call assert :strictEqual (get provider :bytes) (js-length provider-bytes))
            (js-call assert :strictEqual (get provider :content) (js-call provider-bytes :toString "base64"))
            (js-call assert :strictEqual (get provider :sha256) (literal-hash provider-bytes))
            (js-call assert :strictEqual (js-length actual-providers) 1)
            (js-call assert :deepStrictEqual (aref actual-providers 0) provider)
            (js-call assert :ok (<= (js-length retained) 1))
            (if (= (js-length retained) 0) (js-call expected-evidence :push provider)
              (js-call assert :deepStrictEqual (aref retained 0) provider))
            ;; The maintained runtime-scan recipe authenticates three actual
            ;; assets and executes its selected-compiler Eli implementation.
            ;; Compare this exact replacement, retaining every other record.
            (let* ((files (js-array "tools/compiler/eliscript/runtime-scan-cases.eli"
                            "tools/compiler/runtime-scan-cases.mjs" "tests/eliscript/compiler-runtime-scan.eli"))
                   (proofs (js-array)) (index 0)
                   (records (get expected :records))
                   (at (js-call records :findIndex (lambda (item)
                         (= (get item :id) "original-program:compiler-module-runtime-scan"))))
                   (record (funcall globalThis.structuredClone (if (< at 0)
                     (js-call (get actual :records) :find (lambda (item)
                       (= (get item :id) "original-program:compiler-module-runtime-scan"))) (aref records at)))))
              ;; The generated suite has its own locator identity. The retained
              ;; recipe still binds the exact original source regions; this
              ;; one explicit restored record is checked independently below.
              (when (< at 0)
                (js-call assert :ok record)
                (setq at (js-call (get actual :records) :findIndex (lambda (item)
                  (= (get item :id) "original-program:compiler-module-runtime-scan"))))
                (js-call records :splice at 0 record)
                (js-call (get expected :expectedIds) :splice at 0 (get record :id))
                (put expected :missingCaseAdapters (js-call (get expected :missingCaseAdapters) :filter
                  (lambda (item) (not (js-call (get record :coverage) :includes (get item :coverageId))))))
                (let* ((filename "tests/compiler-runtime-scan.test.mjs")
                       (asset (await (js-call reader :file filename)))
                       (prior (js-call expected-evidence :find (lambda (item) (= (get item :file) filename)))))
                  (if prior (js-call assert :deepStrictEqual prior asset) (js-call expected-evidence :push asset))))
              (js-call assert :ok (>= at 0))
              (while (< index (js-length files))
                (let* ((filename (aref files index)) (bytes (await (readFile (resolve root filename))))
                       (asset (await (js-call reader :file filename)))
                       (prior (js-call expected-evidence :find (lambda (item) (= (get item :file) filename))))
                       (actual-assets (js-call (get actual :evidence) :filter (lambda (item) (= (get item :file) filename)))))
                  (js-call assert :strictEqual (get asset :sha256) (literal-hash bytes))
                  (js-call assert :strictEqual (get asset :bytes) (js-length bytes))
                  (js-call assert :strictEqual (get asset :encoding) "base64")
                  (js-call assert :strictEqual (get asset :content) (js-call bytes :toString "base64"))
                  (js-call assert :deepStrictEqual actual-assets (js-array asset))
                  (if prior (js-call assert :deepStrictEqual prior asset) (js-call expected-evidence :push asset))
                  (js-call proofs :push (js-object :file filename :sourceSha256 (literal-hash bytes))))
                (setq index (1+ index)))
              (let* ((source (str "(import " (JSON/stringify (resolve root "tools/compiler/runtime-scan-cases.mjs"))
                              " verifyRuntimeScan)\n(import \"node:path\" resolve)\n"
                              "(defasync run () (await (verifyRuntimeScan (resolve (aref (get globalThis.process :argv) 2) \"bootstrap/compiler\") "
                              "(get (get globalThis.process :env) :ELISCRIPT_ORIGINAL_SOURCE_ROOT))))\n"
                              "(js-call (run) :catch (lambda (error) (js-call (get globalThis.process :stderr) :write (str (get error :stack error) \"\\n\")) (put globalThis.process :exitCode 1)))\n"))
                     (original (get record :original)))
                (put (get record :execution) :hostSource (emit-ir-string (compile-ir-string source "runtime-scan-replay.eli")))
                (unless (get original :locatorSource)
                  (put original :sourceAssets (js-call (get original :sourceAssets (js-array)) :concat proofs)))
                (put original :setupReplacement (js-object :kind "maintained-eli-runtime-scan-case" :sourceAssets proofs
                  :originalSourceSha256 (get original :sourceSha256)
                  :changes (js-array "declare the actual math requirement in both exact schema models")
                  :compilerDirectory "selected-artifact/bootstrap/compiler" :fallback false)))
              (put records at record))
            ;; Two original report hosts retain every assertion byte and
            ;; change only the authenticated first import specifier. Bind the
            ;; exact new sources; the rest of the complete corpus still has to
            ;; equal the unchanged legacy model below.
            (let ((files (js-array "tools/backends/eliscript/compiler-corpus-matchers.eli"
                     "tools/backends/compiler-corpus-matchers.mjs"
                     "tools/backends/eliscript/managed-source-view.eli" "tools/backends/managed-source-view.mjs"
                     "tools/backends/eliscript/managed-host-proxy.eli" "tools/backends/managed-host-proxy.mjs"))
                  (proofs (js-array)) (index 0))
              (while (< index (js-length files))
                (let* ((name (aref files index)) (asset (await (js-call reader :file name)))
                       (bytes (await (readFile (resolve root name))))
                       (previous (js-call expected-evidence :find (lambda (item) (= (get item :file) name)))))
                  (js-call assert :strictEqual (get asset :sha256) (literal-hash bytes))
                  (js-call assert :strictEqual (get asset :content) (js-call bytes :toString "base64"))
                  (js-call assert :deepStrictEqual
                    (js-call (get actual :evidence) :filter (lambda (item) (= (get item :file) name))) (js-array asset))
                  (if previous (js-call assert :deepStrictEqual previous asset) (js-call expected-evidence :push asset))
                  (js-call proofs :push (js-object :file name :sourceSha256 (get asset :sha256))))
                (setq index (1+ index)))
              (js-call (js-array "stable-compatibility:program:tests/fixtures/core-stdlib-usage.eli"
                         "original-program:core-stdlib-complete-protocols") :forEach (lambda (record-id)
                (let* ((records (get expected :records))
                       (at (js-call records :findIndex (lambda (item) (= (get item :id) record-id))))
                       (record (funcall globalThis.structuredClone (aref records at)))
                       (source (get (get record :execution) :hostSource))
                       (literal (JSON/stringify "bun:test"))
                       (where (js-call source :indexOf literal))
                       (specifier (JSON/stringify (get (pathToFileURL
                         (resolve root "tools/backends/compiler-corpus-matchers.mjs")) :href)))
                       (output (str (js-call source :slice 0 where) specifier
                                   (js-call source :slice (+ where (js-length literal)))))
                       (original (get record :original))
                       (assets (get original :sourceAssets (js-array))))
                  (js-call assert :ok (>= at 0))
                  (js-call assert :ok (< where (js-call source :indexOf "\n")))
                  (put (get record :execution) :hostSource output)
                  (js-call proofs :forEach (lambda (proof)
                    (unless (js-call assets :some (lambda (item) (= (get item :file) (get proof :file))))
                      (js-call assets :push proof))))
                  (put original :sourceAssets assets)
                  (put original :matcherTransport (js-object :kind "managed-source-view-reflection-snapshot"
                    :originalHostSha256 (literal-hash source) :transportedHostSha256 (literal-hash output)
                    :originalSpecifier "bun:test" :sourceAssets proofs :assertionsUnchanged t))
                  (put records at record)))))
            ;; Compare complete values; failures cannot format the entire
            ;; multi-megabyte source/recipe inventory into a diagnostic diff.
            (js-call assert :strictEqual (isDeepStrictEqual without-audit expected) t
              "only the authenticated literal gate HTTP runtime-scan and exact matcher dependency transports may differ from the unchanged legacy corpus")
            (let ((variants (js-array "missing" "duplicate" "hash" "bytes")) (index 0))
              (while (< index (js-length variants))
                (let* ((changed (Object/assign (js-object) without-audit
                                  (js-object :evidence (Array/from (get without-audit :evidence)))))
                       (evidence (get changed :evidence))
                       (at (js-call evidence :findIndex (lambda (asset) (= (get asset :file) "platform/http.mjs"))))
                       (kind (aref variants index)))
                  (put evidence at (Object/assign (js-object) (aref evidence at)))
                  (cond ((= kind "missing") (js-call evidence :splice at 1))
                    ((= kind "duplicate") (js-call evidence :push (Object/assign (js-object) provider)))
                    ((= kind "hash") (put (aref evidence at) :sha256 (js-call "0" :repeat 64)))
                    (t (put (aref evidence at) :content (+ (get provider :content) "AA=="))))
                  (js-call assert :strictEqual (isDeepStrictEqual changed expected) false
                    "missing altered or duplicate provider evidence cannot pass complete corpus equality"))
                (setq index (1+ index)))))))))
  (test "literal runtime regions bind the actual generated registrations with their original deadlines and exact source hashes"
    (async ()
      (let* ((source (await (readFile (resolve root literal-suite) "utf8")))
             (locators (originalRuntimeCaseLocators literal-suite source))
             (names (js-array "host-only-shape" "portable-codec" "incomplete-map-input" "unbound-portable-input"))
             (records (js-array "original-program:literal-runtime-host-only" "original-program:literal-runtime-portable-codec"
               "original-sequence:literal-runtime-invalid-inputs" "original-sequence:literal-runtime-invalid-inputs"))
             (index 0))
        (js-call assert :strictEqual (js-length locators) 4)
        (while (< index 4)
          (let* ((locator (aref locators index)) (bound (get locator :originalCase))
                 (execution (get locator :originalExecution)) (span (get execution :span))
                 (text (js-call source :slice (get span :start) (get span :end))))
            (js-call assert :strictEqual (get locator :id)
              (+ "stable-compatibility:source-region:" literal-suite ":" (aref names index) ":0"))
            (js-call assert :strictEqual (get locator :contains) text)
            (js-call assert :strictEqual (get bound :sourceSha256) (literal-hash source))
            (js-call assert :strictEqual (get bound :timeoutMs) 60000)
            (js-call assert :strictEqual (get execution :record) (aref records index))
            (js-call assert :strictEqual (get execution :sha256) (literal-hash text))
            (js-call assert :deepStrictEqual span (get bound :span))
            (js-call assert :strictEqual (get execution :byteStart)
              (js-call Buffer :byteLength (js-call source :slice 0 (get span :start))))
            (js-call assert :strictEqual (get execution :byteEnd)
              (js-call Buffer :byteLength (js-call source :slice 0 (get span :end)))))
          (setq index (1+ index)))
        (js-call assert :throws (lambda () (originalRuntimeCaseLocators literal-suite
          (js-call source :replace (aref literal-titles 2) "missing original host case")))
          (lambda (error) (= (get error :name) "TypeError"))))))

  (test "literal runtime adapters retain all four selected records exact negative inputs real Eli assertions and independent oracle without old JS boundaries"
    (async ()
      (let* ((services (await (literal-services))) (options (get services :options))
             (text (get options :text)) (source (await (funcall text literal-suite)))
             (eli (await (funcall text literal-source)))
             (adapter-source (await (funcall text "tools/backends/eliscript/compiler-corpus-runtime-adapters.eli")))
             (locators (js-call (originalSourceCaseLocators literal-suite source) :concat
                         (originalRuntimeCaseLocators literal-suite source)
                         (get options :locators)))
             (entry "tests/fixtures/literal-runtime.mjs")
             (modules (js-array (js-object :id entry :filename "tests/fixtures/literal-runtime.eli"
               :source (await (funcall text "tests/fixtures/literal-runtime.eli")))))
             (base (js-object :id "stable-compatibility:program:tests/fixtures/literal-runtime.eli"
               :modules modules :entry entry :request (js-object :operation "project" :resolveImports t)
               :execution (js-object :host "tests/fixtures/literal-runtime-host.mjs"
                 :hostSource (await (funcall text "tests/fixtures/literal-runtime-host.mjs")))))
             (records (js-array base))
             (adapted (Object/assign (js-object) options (js-object :locators locators :records records
               :add (lambda (record) (js-call records :push record)))))
             (mapped (await (addOriginalStdlibRuntimeAdapters adapted))))
        (js-call assert :deepStrictEqual mapped (js-array literal-suite))
        (js-call assert :deepStrictEqual (js-call (js-call records :slice 1) :map (lambda (record) (get record :id)))
          (js-array "original-program:literal-runtime-complete-hosts" "original-program:literal-runtime-host-only"
            "original-program:literal-runtime-portable-codec" "original-sequence:literal-runtime-invalid-inputs"))
        (js-call assert :deepStrictEqual (get (aref records 1) :modules) modules)
        (let ((index 1))
          (while (< index 4)
            (let* ((record (aref records index)) (execution (get record :execution))
                   (bound (get record :original)))
              (js-call assert :strictEqual (get execution :timeoutMs) 60000)
              (js-call assert :strictEqual (get execution :referenceArtifact) t)
              (js-call assert :strictEqual (get execution :compilerSourceMaps) t)
              (js-call assert :strictEqual (get (get record :expected) :oracleRequired) t)
              (js-call assert :strictEqual (get bound :sourceSha256) (literal-hash source))
              (js-call assert :deepStrictEqual (get bound :sourceAssets)
                (js-array (js-object :file literal-source :sourceSha256 (literal-hash eli))
                  (js-object :file "tools/backends/eliscript/compiler-corpus-runtime-adapters.eli"
                    :sourceSha256 (literal-hash adapter-source))))
              (js-call assert :strictEqual (= (value-type (get execution :hostSource)) "string") t)
              (js-call assert :strictEqual (> (js-length (get execution :hostSource)) 0) t)
              ;; Building every actual transport above must pass the real
              ;; reader/analyzer. Each asynchronous assertion body has its own
              ;; entry, rather than relying on unsupported module-level await.
              (js-call assert :strictEqual (js-call (get execution :hostSource) :includes
                "async function run_original_literal_host") t))
            (setq index (1+ index))))
        (let ((negative (aref records 4)))
          (js-call assert :strictEqual (get (get (aref (get negative :steps) 0) :request) :source) "(hash-map \"key\")\n")
          (js-call assert :strictEqual (get (get (aref (get negative :steps) 1) :request) :source)
            "(defportable build () [missing])\n(export build)\n")
          (js-call assert :deepStrictEqual (get (get (aref (get negative :steps) 1) :request) :portableEntries) (js-array "build")))
        (let ((error (get (aref (get (aref records 4) :steps) 1) :error)))
          (js-call assert :strictEqual (get error :contains) "unbound")
          (js-call assert :deepStrictEqual (get error :expectFields)
            (js-array (js-object :path (js-array "message") :value "unbound symbol: missing"))))
        (js-call assert :strictEqual (js-call (get (get (aref records 2) :execution) :hostSource)
          :includes "original_cli_output") t)
        (let ((extra (originalRuntimeCaseLocators literal-suite source)) (index 0))
          (while (< index (js-length extra))
            (let ((locator (aref extra index)))
              (js-call assert :deepStrictEqual
                (js-call (js-call records :filter (lambda (record)
                  (and (get record :coverage) (js-call (get record :coverage) :includes (get locator :id)))))
                  :map (lambda (record) (get record :id)))
                (js-array (get (get locator :originalExecution) :record))))
            (setq index (1+ index))))
        ;; The frozen feature manifest supplies title-only locators. Their
        ;; coverage is retained and their complete span/hash comes from the
        ;; actual generated test registration, never from a synthetic range.
        (let ((feature-locators (get options :locators))
              (cases (originalSourceCaseLocators literal-suite source))
              (expected (js-array
                (js-array "original-program:literal-runtime-complete-hosts")
                (js-array "original-sequence:literal-runtime-invalid-inputs")
                (js-array "original-program:literal-runtime-host-only")
                (js-array)
                (js-array "original-program:literal-runtime-portable-codec" "original-sequence:literal-runtime-invalid-inputs")))
              (index 0))
          (while (< index (js-length feature-locators))
            (let* ((locator (aref feature-locators index))
                   (actual-case (get (js-call cases :find (lambda (item)
                     (= (get (get item :originalCase) :title) (get locator :contains)))) :originalCase))
                   (span (get actual-case :span))
                   (region (js-object :start (get span :start) :end (get span :end)
                     :byteStart (get actual-case :byteStart) :byteEnd (get actual-case :byteEnd)
                     :sha256 (get actual-case :sha256)))
                   (claimed (js-call records :filter (lambda (record)
                     (and (get record :coverage) (js-call (get record :coverage) :includes (get locator :id)))))))
              (js-call assert :strictEqual (Object/hasOwn locator "originalCase") false)
              (js-call assert :strictEqual (Object/hasOwn locator "originalExecution") false)
              (js-call assert :deepStrictEqual (js-call claimed :map (lambda (record) (get record :id))) (aref expected index))
              (js-call claimed :forEach (lambda (record)
                (js-call assert :strictEqual (js-call (get (get record :original) :regions) :some
                  (lambda (actual) (isDeepStrictEqual actual region))) t))))
            (setq index (1+ index))))
        ;; Explicit stale provenance must still fail; resolving title-only
        ;; evidence is not permission to overwrite a caller's forged binding.
        (let ((index 0))
          (while (< index 2)
            (let* ((changed (funcall globalThis.structuredClone locators))
                   (published (js-array)))
              (if (= index 0)
                (put (get (aref changed 0) :originalCase) :sourceSha256 (js-call "0" :repeat 64))
                (let* ((locator (js-call changed :find (lambda (candidate)
                                 (let ((execution (get candidate :originalExecution)))
                                   (and (not (nullish? execution))
                                     (= (get execution :record) "original-program:literal-runtime-host-only"))))))
                       (execution (get locator :originalExecution))
                       (span (get execution :span)))
                  ;; The registration inventory may contain additional real
                  ;; cases. Corrupt the authentic host-only execution span,
                  ;; rather than assuming its position among those cases.
                  (js-call assert :ok locator)
                  (js-call assert :ok span)
                  (put span :start (1+ (get span :start)))))
              (await (js-call assert :rejects (lambda () (addOriginalStdlibRuntimeAdapters
                (Object/assign (js-object) adapted (js-object :locators changed
                  :add (lambda (record) (js-call published :push record))))))
                (lambda (error) (= (get error :name) "TypeError"))))
              (js-call assert :deepStrictEqual published (js-array)))
            (setq index (1+ index))))
        ;; Literal expressions are parsed as restricted source data, never run.
        ;; A changed write boundary must fail before any replacement is exposed.
        (let* ((published (js-array))
              (bad (Object/assign (js-object) adapted (js-object
                :text (async (filename)
                  (if (= filename literal-source)
                    (js-call (await (funcall text filename)) :replace ":write source" ":write unknown-source")
                    (await (funcall text filename))))
                :add (lambda (record) (js-call published :push record))))))
          (await (js-call assert :rejects (lambda () (addOriginalStdlibRuntimeAdapters bad))
            (lambda (error) (= (get error :name) "TypeError"))))
          (js-call assert :deepStrictEqual published (js-array))))))
  (test "original core recipes resolve their emitted virtual layout without changing archived sources or unrelated requests"
    (async ()
      (let* ((originals (await (loadOriginalCompilerManifests)))
             (document (await (loadOriginalCompilerCorpus (js-object :sourceRoot root :originals originals))))
             (names (js-array "core-set-usage" "core-stdlib-usage" "core-language-api-usage"))
             (plans (js-call (js-call names :map (lambda (name)
                       (js-array (+ "stable-compatibility:program:tests/fixtures/" name ".eli") name)))
                      :concat (js-array
                        (js-array "original-program:core-set-source-map" "core-set-usage")
                        (js-array "original-program:core-stdlib-complete-protocols" "core-stdlib-usage"))))
             (targets (js-array "javascript" "wasm" "native")) (index 0))
        (while (< index (js-length plans))
          (let* ((plan (aref plans index)) (name (aref plan 1)) (id (aref plan 0))
                 (record (js-call (get document :records) :find (lambda (item) (= (get item :id) id))))
                 (snapshot (funcall globalThis.structuredClone record)) (target-index 0))
            (js-call assert :ok record)
            (when (>= index 3)
              (let ((base (js-call (get document :records) :find (lambda (item)
                            (= (get item :id) (+ "stable-compatibility:program:tests/fixtures/" name ".eli"))))))
                (js-call assert :deepStrictEqual (get record :modules) (get base :modules))
                (js-call assert :deepStrictEqual (get record :request) (get base :request))
                (js-call assert :strictEqual (get record :entry) (get base :entry))
                (js-call assert :ok (js-call (get (get record :execution) :hostSource) :includes (+ name ".mjs")))))
            (while (< target-index (js-length targets))
              (let* ((target (aref targets target-index))
                     (request (compilerCorpusRequest record target))
                     (legacy (js-call legacy-corpus :compilerCorpusRequest record target))
                     (aliases (new globalThis.Set)) (modules (get request :modules)) (position 0))
                (js-call assert :strictEqual (get request :entry) (+ name ".mjs"))
                (js-call assert :strictEqual (get request :resolveImports) t)
                (js-call assert :deepStrictEqual (get request :hostSources) (get legacy :hostSources))
                (if (= name "core-language-api-usage")
                  (progn
                    ;; Its unchanged original Node host imports seq directly,
                    ;; even though the API entry does not import that module.
                    (js-call assert :deepStrictEqual (get request :entries)
                      (js-call (get record :modules) :map (lambda (module) (get module :id))))
                    (js-call assert :ok (js-call (get request :entries) :includes "stdlib/core/seq.mjs"))
                    (js-call assert :deepStrictEqual (get legacy :entries) (js-array (get record :entry))))
                  (js-call assert :deepStrictEqual (get request :entries) (get legacy :entries)))
                (js-call assert :strictEqual (js-length modules) (js-length (get record :modules)))
                (js-call (js-call modules :concat (get request :hostSources)) :forEach
                  (lambda (module)
                    (js-call aliases :add (js-call posix :normalize (get module :id)))
                    (js-call aliases :add (js-call posix :normalize (get module :filename)))))
                (while (< position (js-length modules))
                  (let* ((module (aref modules position)) (original (aref (get record :modules) position))
                         (virtual (js-call names :find (lambda (candidate)
                           (and (= (get module :id) (+ candidate ".mjs"))
                                (= (get original :filename) (+ "tests/fixtures/" candidate ".eli"))))))
                         (expected (funcall globalThis.structuredClone original))
                         (forms (read-string (get module :source) (get module :filename)))
                         (members (get (aref forms 0) :items)) (member-index 2))
                    (when virtual (put expected :filename (+ virtual ".eli")))
                    (js-call assert :deepStrictEqual module expected)
                    (js-call assert :notStrictEqual module original)
                    ;; Resolve the real source declarations, including both
                    ;; usage modules and every complete stdlib dependency.
                    (while (< member-index (js-length members))
                      (let* ((items (get (aref members member-index) :items))
                             (head (and items (aref items 0))))
                        (when (and head (= (get head :kind) "symbol") (= (get head :name) "import"))
                          (let ((specifier (get (aref items 1) :value)))
                            (when (js-call specifier :startsWith ".")
                              (js-call assert :ok (js-call aliases :has (js-call posix :normalize
                                (js-call posix :join (js-call posix :dirname (get module :filename)) specifier)))
                                (+ (get module :filename) " -> " specifier))))))
                      (setq member-index (1+ member-index))))
                  (setq position (1+ position))))
              (setq target-index (1+ target-index)))
            (js-call assert :deepStrictEqual record snapshot)
            ;; The correction is not a global filename normalization rule.
            (let ((unrelated (funcall globalThis.structuredClone record))
                  (wrong-entry (funcall globalThis.structuredClone record)))
              (put unrelated :id "unrelated-core-recipe")
              (put wrong-entry :entry "different.mjs")
              (js-call assert :deepStrictEqual (compilerCorpusRequest unrelated "javascript")
                (js-call legacy-corpus :compilerCorpusRequest unrelated "javascript"))
              (js-call assert :deepStrictEqual (compilerCorpusRequest wrong-entry "javascript")
                (js-call legacy-corpus :compilerCorpusRequest wrong-entry "javascript"))))
          (setq index (1+ index))))))
  (test "the original multimethod recipe resolves its declarative input beside the complete unmodified stdlib family"
    (async ()
      (let* ((originals (await (loadOriginalCompilerManifests)))
             (document (await (loadOriginalCompilerCorpus (js-object :sourceRoot root :originals originals))))
             (record (js-call (get document :records) :find (lambda (item)
                       (= (get item :id) "stable-compatibility:program:stdlib/multimethod.eli"))))
             (snapshot (funcall globalThis.structuredClone record))
             (targets (js-array "javascript" "wasm" "native")) (index 0))
        (js-call assert :ok record)
        (while (< index (js-length targets))
          (let* ((target (aref targets index)) (request (compilerCorpusRequest record target))
                 (legacy (js-call legacy-corpus :compilerCorpusRequest record target))
                 (modules (get request :modules)) (aliases (new globalThis.Map))
                 (pending (js-array)) (visited (new globalThis.Set)) (position 0) (changed 0))
            (js-call assert :strictEqual (get request :entry) "multimethod.mjs")
            (js-call assert :deepStrictEqual (get request :entries) (get legacy :entries))
            (js-call assert :deepStrictEqual (get request :hostSources) (get legacy :hostSources))
            (js-call assert :strictEqual (js-length modules) (js-length (get record :modules)))
            (while (< position (js-length modules))
              (let* ((module (aref modules position)) (original (aref (get record :modules) position))
                     (expected (funcall globalThis.structuredClone original)))
                (when (= (get module :id) "declarative-multimethod.mjs")
                  (js-call assert :strictEqual (get original :filename) "tests/fixtures/declarative-multimethod.eli")
                  (put expected :filename "stdlib/declarative-multimethod.eli")
                  (setq changed (1+ changed)))
                (js-call assert :deepStrictEqual module expected)
                (js-call aliases :set (js-call posix :normalize (get module :id)) module)
                (js-call aliases :set (js-call posix :normalize (get module :filename)) module))
              (setq position (1+ position)))
            (js-call assert :strictEqual changed 1)
            (js-call (get request :entries) :forEach (lambda (id)
              (let ((module (js-call aliases :get id)))
                (js-call assert :ok module) (js-call pending :push module))))
            (while (> (js-length pending) 0)
              (let* ((module (js-call pending :pop)) (id (get module :id)))
                (unless (js-call visited :has id)
                  (js-call visited :add id)
                  (let ((forms (read-string (get module :source) (get module :filename))) (nodes (js-array)))
                    (js-call forms :forEach (lambda (form)
                      (let ((items (get form :items)))
                        (if (and items (= (get (aref items 0) :name) "module"))
                          (Reflect/apply (get nodes :push) nodes (js-call items :slice 2))
                          (js-call nodes :push form)))))
                    (js-call nodes :forEach (lambda (node)
                      (let* ((items (get node :items)) (head (and items (get (aref items 0) :name))))
                        (when (or (= head "import") (= head "import-portable"))
                          (let* ((specifier (get (aref items 1) :value))
                                 (path (js-call posix :normalize (js-call posix :join
                                         (js-call posix :dirname (get module :filename)) specifier)))
                                 (dependency (js-call aliases :get path)))
                            (js-call assert :ok dependency (+ (get module :filename) " -> " specifier))
                            (js-call pending :push dependency))))))))))
            (js-call assert :ok (js-call visited :has "declarative-multimethod.mjs"))
            (js-call assert :ok (js-call visited :has "multimethod.mjs"))
            (js-call assert :ok (js-call visited :has "hierarchy.mjs")))
          (setq index (1+ index)))
        (js-call assert :deepStrictEqual record snapshot)
        (let ((unrelated (funcall globalThis.structuredClone record))
              (wrong-entry (funcall globalThis.structuredClone record)))
          (put unrelated :id "unrelated-multimethod-recipe")
          (put wrong-entry :entry "other.mjs")
          (js-call assert :deepStrictEqual (compilerCorpusRequest unrelated "javascript")
            (js-call legacy-corpus :compilerCorpusRequest unrelated "javascript"))
          (js-call assert :deepStrictEqual (compilerCorpusRequest wrong-entry "javascript")
            (js-call legacy-corpus :compilerCorpusRequest wrong-entry "javascript"))))))
  (test "all retained missing-source recipe families carry their complete real virtual dependency graph"
    (async ()
      (let* ((originals (await (loadOriginalCompilerManifests)))
             (document (await (loadOriginalCompilerCorpus (js-object :sourceRoot root :originals originals))))
             (assets (get document :evidence))
             (sources (await (loadCompilerSources)))
             (libraries (get sources :literalSources))
             (library-identity (get (compilerSourceIdentity sources) :literalSources))
             (asset-identities (js-call assets :map (lambda (asset)
                                 (js-array (get asset :file) (get asset :sha256) (get asset :content)))))
             (ids (js-array "original-program:multimethod-complete-hosts"
                            "original-managed-suite:complete-fixture-suites"
                            "original-tools-artifact:worker-source-mapping:bun"))
             (families (js-array "core-modules" "transient-state" "sorted-core" "wire" "wire-original-host"))
             (portable (js-array "persistent-list" "persistent-vector" "persistent-map" "persistent-set"
                                "numeric" "json" "result" "metadata" "data-text" "value-semantics"))
             (engines (js-array "node" "bun")) (autos (js-array 65536 1)) (index 0))
        (let* ((provider (js-call assets :find (lambda (asset) (= (get asset :file) "platform/http.mjs"))))
               (actual (await (readFile (resolve root "platform/http.mjs")))))
          (js-call assert :ok provider)
          (js-call assert :strictEqual (get provider :content) (js-call actual :toString "base64"))
          (js-call assert :strictEqual (get provider :sha256)
            (js-call (js-call (createHash "sha256") :update actual) :digest "hex")))
        (js-call portable :forEach (lambda (name)
          (js-call ids :push (+ "original-program:portable-" name "-complete-hosts"))))
        (js-call engines :forEach (lambda (engine)
          (js-call ids :push (+ "original-tools-artifact:compiler-session-tools:" engine)
                             (+ "original-managed:compiler-session-tools:" engine))
          (js-call autos :forEach (lambda (auto)
            (js-call families :forEach (lambda (family)
              (js-call ids :push (+ "original-managed:" family ":" engine ":auto-" auto))))
            (js-call ids :push (+ "original-managed-fixture:persistent-vector-auto-" auto ":" engine)
                               (+ "original-identity-value:stdlib-value-json:" engine ":auto-" auto))))))
        (while (< index (js-length ids))
          (let* ((id (aref ids index))
                 (record (js-call (get document :records) :find (lambda (item) (= (get item :id) id))))
                 (before (funcall globalThis.structuredClone record))
                 (targets (js-array "javascript" "wasm" "native")) (target-index 0))
            (js-call assert :ok record id)
            (while (< target-index (js-length targets))
              (let* ((target (aref targets target-index))
                     (request (compilerCorpusRequest record target (js-object :sourceAssets assets
                                :literalSources libraries :literalSourceIdentity library-identity)))
                     (aliases (new globalThis.Set)) (modules (get request :modules)))
                (js-call assert :strictEqual (get request :entry) (get record :entry))
                (js-call assert :deepStrictEqual (get request :entries) (get (get record :request) :entries))
                (js-call assert :strictEqual (get request :resolveImports) t)
                (let ((canonical (js-call modules :find (lambda (module) (= (get module :id) "managed-runtime-list.mjs")))))
                  (when canonical (js-call assert :strictEqual (get canonical :filename) "runtime/core/list.eli")))
                (let* ((providers (get request :hostSources (js-array)))
                       (provider (js-call providers :find (lambda (module) (= (get module :id) "platform/http.mjs")))))
                  (when provider
                    (js-call assert :strictEqual (get provider :filename) "platform/http.mjs")
                    (js-call assert :strictEqual (get provider :source)
                      (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode
                        (js-call Buffer :from (get (js-call assets :find (lambda (asset)
                          (= (get asset :file) "platform/http.mjs"))) :content) "base64")))
                    (js-call assert :strictEqual (js-call modules :some (lambda (module)
                      (or (= (get module :id) "platform/http.mjs") (= (get module :filename) "platform/http.eli")))) false)))
                (js-call (js-call modules :concat (get request :hostSources (js-array))) :forEach (lambda (module)
                  (js-call aliases :add (js-call posix :normalize (get module :id)))
                  (js-call aliases :add (js-call posix :normalize (get module :filename)))))
                (js-call modules :forEach (lambda (module)
                  (let ((forms (read-string (get module :source) (get module :filename))) (pending (js-array)))
                    (Reflect/apply (get pending :push) pending forms)
                    (while (> (js-length pending) 0)
                      (let* ((node (js-call pending :pop)) (items (get node :items))
                             (head (and items (get (aref items 0) :name))))
                        (cond
                          ((= head "module") (Reflect/apply (get pending :push) pending (js-call items :slice 2)))
                          ((or (= head "import") (= head "import-portable"))
                           (let ((specifier (get (aref items 1) :value)))
                             (when (js-call specifier :startsWith ".")
                               (js-call assert :ok (js-call aliases :has (js-call posix :normalize
                                 (js-call posix :join (js-call posix :dirname (get module :filename)) specifier)))
                                 (+ id " " (get module :filename) " -> " specifier)))))))))))
                ;; Original inputs remain the unchanged prefix, with only
                ;; request-local virtual filenames differing where necessary.
                (let ((position 0))
                  (while (< position (js-length (get record :modules)))
                    (let ((actual (aref modules position)) (original (aref (get record :modules) position)))
                      (js-call assert :strictEqual (get actual :id) (get original :id))
                      (js-call assert :strictEqual (get actual :source) (get original :source)))
                    (setq position (1+ position)))))
              (setq target-index (1+ target-index)))
            (js-call assert :deepStrictEqual record before))
          (setq index (1+ index)))
        (js-call assert :deepStrictEqual (js-call assets :map (lambda (asset)
          (js-array (get asset :file) (get asset :sha256) (get asset :content)))) asset-identities)
        (let* ((record (js-call (get document :records) :find (lambda (item)
                         (= (get item :id) "original-program:portable-persistent-list-complete-hosts"))))
               (missing (js-call assets :filter (lambda (asset) (/= (get asset :file) "runtime/wire/http-rpc.mjs"))))
               (changed (js-call assets :map (lambda (asset)
                 (if (= (get asset :file) "runtime/wire/http-rpc.mjs")
                   (Object/assign (js-object) asset (js-object :content "Y2hhbmdlZA==")) asset)))))
          (let ((missing-host (js-call assets :filter (lambda (asset) (/= (get asset :file) "platform/http.mjs"))))
                (changed-host (js-call assets :map (lambda (asset)
                  (if (= (get asset :file) "platform/http.mjs")
                    (Object/assign (js-object) asset (js-object :content "Y2hhbmdlZA==")) asset)))))
            (js-call assert :throws (lambda () (compilerCorpusRequest record "javascript"
              (js-object :sourceAssets missing-host :literalSources libraries :literalSourceIdentity library-identity)))
              (lambda (error) (js-call (get error :message) :includes "platform/http.mjs")))
            (js-call assert :throws (lambda () (compilerCorpusRequest record "javascript"
              (js-object :sourceAssets changed-host :literalSources libraries :literalSourceIdentity library-identity)))
              (lambda (error) (js-call (get error :message) :includes "platform/http.mjs"))))
          (js-call assert :throws (lambda () (compilerCorpusRequest record "javascript" (js-object :sourceAssets missing)))
            (lambda (error) (js-call (get error :message) :includes "literal source declarations")))
          (js-call assert :throws (lambda () (compilerCorpusRequest record "javascript" (js-object :sourceAssets missing
                              :literalSources libraries :literalSourceIdentity library-identity)))
            (lambda (error) (js-call (get error :message) :includes "runtime/wire/http-rpc.mjs")))
          (js-call assert :throws (lambda () (compilerCorpusRequest record "javascript" (js-object :sourceAssets changed
                              :literalSources libraries :literalSourceIdentity library-identity)))
            (lambda (error) (js-call (get error :message) :includes "runtime/wire/http-rpc.mjs")))
          (js-call assert :throws (lambda () (compilerCorpusRequest record "javascript" (js-object :sourceAssets assets
                              :literalSources (js-call libraries :slice 1) :literalSourceIdentity library-identity)))
            (lambda (error) (js-call (get error :message) :includes "literal source declarations")))
          (let ((bad (funcall globalThis.structuredClone libraries))
                (correct (funcall globalThis.structuredClone record)))
            (put (aref bad 0) :id "runtime/forged.mjs")
            (js-call assert :throws (lambda () (compilerCorpusRequest record "javascript" (js-object :sourceAssets assets
                                :literalSources bad :literalSourceIdentity library-identity)))
              (lambda (error) (js-call (get error :message) :includes "literal source declarations")))
            (let ((module (js-call (get correct :modules) :find (lambda (item) (= (get item :id) "managed-runtime-list.mjs")))))
              (put module :filename "runtime/core/list.eli")
              (let* ((before (funcall globalThis.structuredClone correct))
                     (request (compilerCorpusRequest correct "javascript" (js-object :sourceAssets assets
                                :literalSources libraries :literalSourceIdentity library-identity))))
                (js-call assert :strictEqual (get (js-call (get request :modules) :find (lambda (item)
                  (= (get item :id) "managed-runtime-list.mjs"))) :filename) "runtime/core/list.eli")
                (js-call assert :deepStrictEqual correct before))))))))
  (defun seed-source-case ()
    (let* ((source "(module seed.entry (import \"../runtime/helper.eli\" answer) (js-call (get globalThis.process :stdout) :write (funcall globalThis.String (answer))))")
           (helper "(module seed.helper (import \"../stdlib/core/shared.eli\" value) (defun answer () (+ value 2)) (export answer))")
           (shared "(module seed.shared (defconst value 40) (export value))")
           (libraries (js-array (js-object :id "runtime/helper.mjs" :filename "stdlib/managed-helper.eli" :source helper)))
           (files (js-array (js-array "stdlib/managed-helper.eli" helper) (js-array "stdlib/core/shared.eli" shared)))
           (assets (js-call files :map (lambda (pair)
             (let ((bytes (js-call Buffer :from (aref pair 1) "utf8")))
               (js-object :file (aref pair 0) :encoding "base64" :content (js-call bytes :toString "base64")
                 :bytes (js-length bytes) :sha256 (literal-hash bytes)))))))
      (js-object :record (js-object :id "original-program:multimethod-complete-hosts" :kind "project"
          :entry "multimethod.mjs" :modules (js-array
            (js-object :id "multimethod.mjs" :filename "stdlib/multimethod.eli" :source source)
            (js-object :id "managed-helper.mjs" :filename "stdlib/managed-helper.eli" :source helper))
          :request (js-object :resolveImports t) :execution (js-object :kind "original-program" :hostRuntime "node" :aliases t)
          :expected (js-object :kind "seed-program" :oracleRequired t :stdout "42"))
        :proofs (js-object :sourceAssets assets :literalSources libraries
          :literalSourceIdentity (js-call libraries :map (lambda (library)
            (js-object :id (get library :id) :filename (get library :filename)
              :sha256 (js-call (js-call (createHash "sha256") :update (get library :source) "utf16le") :digest "hex"))))))))

  (test "only authenticated original ESM host entry boundaries opt in to foreign arguments without weakening owned import contracts"
    (async ()
      (let* ((filename "tests/fixtures/local-recursive-functions.eli")
             (host "tests/fixtures/local-recursive-functions-host.mjs")
             (source (await (readFile (resolve root filename) "utf8")))
             (host-source (await (readFile (resolve root host) "utf8")))
             (assets (js-array))
             (record (js-object :id "retained-foreign-entry-contract" :kind "project"
               :entry "main.mjs" :modules (js-array (js-object :id "main.mjs" :filename filename :source source))
               :request (js-object :operation "project")
               :execution (js-object :kind "original-program" :aliases t :host host :hostSource host-source)
               :original (js-object :fixture filename :host host)
               :expected (js-object :kind "seed-program" :oracleRequired t))))
        (js-call (js-array (js-array filename source) (js-array host host-source)) :forEach (lambda (entry)
          (let ((bytes (js-call Buffer :from (aref entry 1) "utf8")))
            (js-call assets :push (js-object :file (aref entry 0) :encoding "base64"
              :bytes (js-length bytes) :content (js-call bytes :toString "base64") :sha256 (literal-hash bytes))))))
        (let ((before (JSON/stringify record)) (options (js-object :sourceAssets assets)))
          (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (target)
            (let ((request (compilerCorpusRequest record target options)))
              (if (= target "javascript")
                (js-call assert :strictEqual (Object/hasOwn request "foreignEntry") false)
                (js-call assert :strictEqual (get request :foreignEntry) t)))))
          (js-call assert :strictEqual (JSON/stringify record) before)
          (js-call assert :strictEqual (Object/hasOwn (compilerCorpusRequest record "wasm") "foreignEntry") false)
          (let ((owned (funcall globalThis.structuredClone record)))
            (put (get owned :execution) :zeroImports t)
            (js-call assert :strictEqual (Object/hasOwn (compilerCorpusRequest owned "wasm" options) "foreignEntry") false))
          (let ((explicit (funcall globalThis.structuredClone record)))
            (put (get explicit :request) :foreignEntry false)
            (js-call assert :strictEqual (get (compilerCorpusRequest explicit "wasm" options) :foreignEntry) false))
          (js-call (js-array "aliases" "hostSource") :forEach (lambda (key)
            (let ((other (funcall globalThis.structuredClone record)))
              (put (get other :execution) key false)
              (js-call assert :strictEqual (Object/hasOwn (compilerCorpusRequest other "wasm" options) "foreignEntry") false))))
          (let ((negative (funcall globalThis.structuredClone record)))
            (put (get negative :expected) :kind "diagnostic")
            (js-call assert :strictEqual (Object/hasOwn (compilerCorpusRequest negative "wasm" options) "foreignEntry") false))
          (js-call assert :throws (lambda () (compilerCorpusRequest record "wasm"
            (js-object :sourceAssets (js-array (aref assets 0)))))
            (lambda (error) (= (get error :message) "original foreign entry has no authenticated host source")))
          (let ((changed (funcall globalThis.structuredClone assets)))
            (put (aref changed 1) :sha256 (js-call "0" :repeat 64))
            (js-call assert :throws (lambda () (compilerCorpusRequest record "wasm" (js-object :sourceAssets changed)))
              (lambda (error) (= (get error :message)
                (str "original recipe source asset identity differs: " host)))))))))
  (test "runtime scan replay binds the maintained complete strict schema without changing original coverage or compiler graph"
    (async ()
      (let* ((originals (await (loadOriginalCompilerManifests)))
             (document (await (loadOriginalCompilerCorpus (js-object :sourceRoot root :originals originals))))
             (record (js-call (get document :records) :find (lambda (item)
                       (= (get item :id) "original-program:compiler-module-runtime-scan"))))
             (original (get record :original)) (execution (get record :execution)))
        (js-call assert :ok record)
        (js-call assert :strictEqual (js-length (get record :modules)) 13)
        ;; Several stable features bind this one complete original semantic
        ;; case. Every distinct coverage ID must survive the restored recipe;
        ;; sharing a file/title does not make those declarations duplicates.
        (let* ((gate (get document :originalGateEvidence))
               (locators (js-call (get gate :locators) :filter (lambda (locator)
                 (and (= (get locator :file) "tests/compiler-runtime-scan-selfhosted.test.mjs")
                   (= (get locator :contains) "optimized compiler runtime scan matches its readable reference")))))
               (coverage (js-call locators :map (lambda (locator) (get locator :id)))))
          (js-call assert :ok (> (js-length coverage) 1))
          (js-call assert :strictEqual (get (new globalThis.Set coverage) :size) (js-length coverage))
          (js-call assert :deepStrictEqual (get record :coverage) coverage)
          (js-call coverage :forEach (lambda (id)
            (js-call assert :strictEqual (js-length (js-call (get document :records) :filter
              (lambda (candidate) (js-call (get candidate :coverage) :includes id)))) 1)
            (js-call assert :strictEqual (js-call (get document :missingCaseAdapters) :some
              (lambda (item) (= (get item :coverageId) id))) false)
            (js-call assert :strictEqual (js-call (get gate :coverageIds) :includes id) false)
            (js-call assert :strictEqual (js-call (get gate :hostOnlyDependencies) :some
              (lambda (item) (= (get item :coverageId) id))) false))))
        (js-call assert :strictEqual (get original :suite) "tests/compiler-runtime-scan.test.mjs")
        (js-call assert :strictEqual (get original :sourceSha256)
          (literal-hash (await (readFile (resolve root "tests/compiler-runtime-scan.test.mjs")))))
        (let* ((locator (get original :locatorSource))
               (filename "tests/compiler-runtime-scan-selfhosted.test.mjs")
               (source (await (readFile (resolve root "tests/compiler-runtime-scan.test.mjs") "utf8")))
               (boundaries (js-array
                 (js-array "async function run(" "\ntest(")
                 (js-array "    const module = (name) => import(" "\n  } finally {")
                 (js-array "const compilerSources = [" "\n];"))))
          (js-call assert :strictEqual (get locator :file) filename)
          (js-call assert :strictEqual (get locator :sourceSha256)
            (literal-hash (await (readFile (resolve root filename)))))
          (js-call assert :strictEqual (js-length (get original :regions)) 3)
          (js-call boundaries :forEach (lambda (pair index)
            (let* ((start (js-call source :indexOf (aref pair 0)))
                   (end (js-call source :indexOf (aref pair 1) start))
                   (region (aref (get original :regions) index)))
              (js-call assert :ok (>= start 0)) (js-call assert :ok (> end start))
              (js-call assert :strictEqual (get region :start) start)
              (js-call assert :strictEqual (get region :end) end)
              (js-call assert :strictEqual (get region :sha256)
                (literal-hash (js-call Buffer :from (js-call source :slice start end)))))))
          (let ((index 0))
            (while (< index (js-length (get record :modules)))
              (let ((module (aref (get record :modules) index)))
                (js-call assert :strictEqual (get module :source)
                  (await (readFile (resolve root (get module :filename)) "utf8"))))
              (setq index (1+ index)))))
        (js-call assert :strictEqual (get (get record :expected) :oracleRequired) t)
        (js-call assert :strictEqual (get execution :runtimeProfile) "compiler")
        (js-call assert :ok (js-call (get execution :hostSource) :includes "verifyRuntimeScan"))
        (js-call (js-array "tools/compiler/eliscript/runtime-scan-cases.eli"
                          "tools/compiler/runtime-scan-cases.mjs" "tests/eliscript/compiler-runtime-scan.eli") :forEach
          (lambda (filename)
            (let* ((asset (js-call (get document :evidence) :find (lambda (item) (= (get item :file) filename))))
                   (proof (js-call (get original :sourceAssets) :find (lambda (item) (= (get item :file) filename)))))
              (js-call assert :ok asset) (js-call assert :ok proof)
              (js-call assert :strictEqual (get proof :sourceSha256) (get asset :sha256)))))
        (js-call assert :ok (> (js-length (get record :coverage)) 0))
        (js-call assert :ok (> (js-length (get original :regions)) 0)))))

  (test "independent Seed stages the authenticated recursive source graph at its canonical runtime layout without changing original records"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-seed-source-graph-"))))
             (fixture (seed-source-case)) (record (get fixture :record))
             (before (funcall globalThis.structuredClone fixture)) (cache (new globalThis.Map))
             (options (Object/assign (js-object :sourceRoot root :directory directory :programCache cache) (get fixture :proofs)))
             (oracle (createOriginalSeedOracle options)))
        (try
          (let* ((first (await (funcall oracle (js-object :record record :target "javascript"))))
                 (second (await (funcall (createOriginalSeedOracle options) (js-object :record record :target "wasm"))))
                 (third (await (funcall (createOriginalSeedOracle options) (js-object :record record :target "native")))))
            (js-call assert :strictEqual (get first :stdout) "42")
            (js-call assert :strictEqual second first)
            (js-call assert :strictEqual third first)
            (js-call assert :strictEqual (js-length (js-call (Array/from (js-call cache :keys)) :filter
              (lambda (key) (js-call key :startsWith "program:")))) 1)
            (let* ((changed (funcall globalThis.structuredClone record))
                   (entry (aref (get changed :modules) 0)))
              (put entry :source (js-call (get entry :source) :replace "(answer)" "(+ (answer) 1)"))
              (let ((actual (await (funcall (createOriginalSeedOracle options) (js-object :record changed :target "native")))))
                (js-call assert :strictEqual (get actual :stdout) "43")
                (js-call assert :strictEqual (js-length (js-call (Array/from (js-call cache :keys)) :filter
                  (lambda (key) (js-call key :startsWith "program:")))) 2)))
            (let* ((changed-proofs (funcall globalThis.structuredClone (get fixture :proofs)))
                   (asset (js-call (get changed-proofs :sourceAssets) :find
                     (lambda (value) (= (get value :file) "stdlib/core/shared.eli"))))
                   (bytes (js-call Buffer :from "(module seed.shared (defconst value 41) (export value))" "utf8")))
              (put asset :content (js-call bytes :toString "base64"))
              (put asset :bytes (js-length bytes)) (put asset :sha256 (literal-hash bytes))
              (let* ((changed-options (Object/assign (js-object) options changed-proofs))
                     (changed (await (funcall (createOriginalSeedOracle changed-options)
                       (js-object :record record :target "javascript")))))
                (js-call assert :strictEqual (get changed :stdout) "43")
                (js-call assert :notStrictEqual changed first)))
            (js-call assert :deepStrictEqual fixture before))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "independent Seed rejects missing changed and conflicting source proofs and preserves its first cached failure"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-seed-source-refusals-"))))
             (fixture (seed-source-case)) (record (get fixture :record)) (proofs (get fixture :proofs))
             (assets (get proofs :sourceAssets))
             (variants (js-array
               (js-call assets :filter (lambda (asset) (/= (get asset :file) "stdlib/core/shared.eli")))
               (js-call assets :map (lambda (asset) (Object/assign (js-object) asset (js-object :sha256 "changed"))))
               (js-call assets :concat (js-array (Object/assign (js-object) (aref assets 0) (js-object :content "YQ=="))))))
             (index 0))
        (try
          (while (< index (js-length variants))
            (let* ((cache (new globalThis.Map))
                   (options (Object/assign (js-object :sourceRoot root :directory directory :programCache cache) proofs
                     (js-object :sourceAssets (aref variants index))))
                   (oracle (createOriginalSeedOracle options)) (first undefined))
              (try (await (funcall oracle (js-object :record record :target "javascript")))
                (catch error (setq first error)))
              (js-call assert :ok (js-call (get globalThis.TypeError :prototype) :isPrototypeOf first))
              (await (js-call assert :rejects (funcall oracle (js-object :record record :target "wasm"))
                (lambda (error) (eq error first)))))
            (setq index (1+ index)))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "independent Seed emits every reachable declared mjs edge and relocated dependency without compiling unrelated inputs"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-seed-mjs-edges-"))))
             (fixture (seed-source-case)) (record (get fixture :record))
             (entry "(module seed.main (import \"./dep.mjs\" answer) (js-call (get globalThis.process :stdout) :write (str (answer))))")
             (dependency "(module seed.dep (import \"./leaf.mjs\" value) (defun answer () (+ value 2)) (export answer))")
             (leaf "(module seed.leaf (defconst value 40) (export value))")
             (modules (js-array
               (js-object :id "tests/main.mjs" :filename "tests/main.eli" :source entry)
               (js-object :id "tests/dep.mjs" :filename "stdlib/dep.eli" :source dependency)
               (js-object :id "stdlib/leaf.mjs" :filename "stdlib/leaf.eli" :source leaf)
               (js-object :id "unrelated.mjs" :filename "unrelated.eli" :source "(unbound-unused-fixture)")))
             (proofs (get fixture :proofs)) (cache (new globalThis.Map)))
        (put record :id "original-program:declared-seed-mjs-edges")
        (put record :entry "tests/main.mjs") (put record :modules modules)
        (put record :request (js-object :operation "project" :resolveImports t :entries (js-array "tests/main.mjs")))
        (js-call modules :forEach (lambda (module)
          (let ((bytes (js-call Buffer :from (get module :source) "utf8")))
            (js-call (get proofs :sourceAssets) :push
              (js-object :file (get module :filename) :encoding "base64" :content (js-call bytes :toString "base64")
                :bytes (js-length bytes) :sha256 (literal-hash bytes))))))
        (let* ((before (funcall globalThis.structuredClone record))
               (oracle (createOriginalSeedOracle (Object/assign
                 (js-object :sourceRoot root :directory directory :programCache cache) proofs))))
          (try
            (let* ((actual (await (funcall oracle (js-object :record record :target "javascript"))))
                   (compiled (await (js-call cache :get
                     (js-call (Array/from (js-call cache :keys)) :find (lambda (key) (js-call key :startsWith "compiled:"))))))
                   (files (js-call (get compiled :files) :map (lambda (file) (get file :path)))))
              (js-call assert :strictEqual (get actual :stdout) "42")
              (js-call assert :ok (js-call files :includes "tests/main.mjs"))
              (js-call assert :ok (js-call files :includes "stdlib/dep.mjs"))
              (js-call assert :ok (js-call files :includes "stdlib/leaf.mjs"))
              (js-call assert :strictEqual (js-call files :includes "unrelated.mjs") false)
              (js-call assert :deepStrictEqual record before))
            (finally (await (rm directory (js-object :recursive t :force t)))))))))

  (test "independent Seed follows actual host imports outside the program entry while retaining unused input pruning"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-seed-host-roots-"))))
             (fixture (seed-source-case)) (record (get fixture :record))
             (proofs (get fixture :proofs)) (cache (new globalThis.Map))
             (observer "(module seed.observer (import \"./data.mjs\" value) (defun answer () (+ value 2)) (export answer))")
             (data "(module seed.data (defconst value 40) (export value))")
             (unused "(unbound-unused-host-input)")
             (host-source (emit-ir-string (compile-ir-string
               "(module seed.host (import \"../multimethod.mjs\" :as selected) (import \"../stdlib/observer.mjs\" answer) (js-call (get globalThis.process :stdout) :write (str (answer))))"
               "seed-host.eli"))))
        (put record :id "original-program:seed-host-declared-dependencies")
        (put (get record :execution) :host "tests/observer.mjs")
        (put (get record :execution) :hostSource host-source)
        (put (get record :expected) :stdout "4242")
        (js-call (js-array
            (js-object :id "stdlib/observer.mjs" :filename "stdlib/observer.eli" :source observer)
            (js-object :id "stdlib/data.mjs" :filename "stdlib/data.eli" :source data)
            (js-object :id "unused.mjs" :filename "unused.eli" :source unused)) :forEach
          (lambda (module)
            (js-call (get record :modules) :push module)
            (let ((bytes (js-call Buffer :from (get module :source) "utf8")))
              (js-call (get proofs :sourceAssets) :push (js-object :file (get module :filename)
                :encoding "base64" :content (js-call bytes :toString "base64")
                :bytes (js-length bytes) :sha256 (literal-hash bytes))))))
        (let* ((before (funcall globalThis.structuredClone record))
               (entry-only (funcall globalThis.structuredClone record))
               (oracle (createOriginalSeedOracle (Object/assign
                 (js-object :sourceRoot root :directory directory :programCache cache) proofs))))
          (put entry-only :id "original-program:seed-entry-only-observer")
          (put (get entry-only :execution) :hostSource (emit-ir-string (compile-ir-string
            "(module seed.entryhost (import \"../multimethod.mjs\" :as selected))" "seed-entryhost.eli")))
          (try
            (let* ((initial (await (funcall oracle (js-object :record entry-only :target "javascript"))))
                   (actual (await (funcall oracle (js-object :record record :target "javascript"))))
                   (keys (js-call (Array/from (js-call cache :keys)) :filter
                     (lambda (key) (js-call key :startsWith "compiled:"))))
                   (compiled (await (js-call cache :get (js-call keys :at -1))))
                   (files (js-call (get compiled :files) :map (lambda (file) (get file :path)))))
              (js-call assert :strictEqual (get initial :stdout) "42")
              (js-call assert :strictEqual (js-length keys) 2)
              (js-call assert :strictEqual (get actual :stdout) "4242")
              (js-call assert :ok (js-call files :includes "stdlib/observer.mjs"))
              (js-call assert :ok (js-call files :includes "stdlib/data.mjs"))
              (js-call assert :strictEqual (js-call files :includes "unused.mjs") false)
              (js-call assert :deepStrictEqual record before))
            (finally (await (rm directory (js-object :recursive t :force t)))))))))

  (test "the independent Seed executes the authentic host-only and portable literal records with their original output layouts"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-seed-literal-layouts-"))))
             (records (await (literal-host-records)))
             (ids (js-array "original-program:literal-runtime-host-only" "original-program:literal-runtime-portable-codec"))
             (oracle (createOriginalSeedOracle (js-object :sourceRoot root :directory directory))) (index 0))
        (try
          (while (< index (js-length ids))
            (let* ((id (aref ids index)) (record (js-call records :find (lambda (item) (= (get item :id) id))))
                   (before (funcall globalThis.structuredClone record))
                   (actual (await (funcall oracle (js-object :record record :target "javascript")))))
              (js-call assert :strictEqual (get actual :kind) "original-program")
              (js-call assert :strictEqual (get actual :stdout) "")
              (js-call assert :deepStrictEqual record before))
            (setq index (1+ index)))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "same-source Seed compilation is reused while distinct original hosts execute in isolated mutable product directories"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-seed-compile-reuse-"))))
             (fixture (seed-source-case)) (cache (new globalThis.Map))
             (options (Object/assign (js-object :sourceRoot root :directory directory :programCache cache) (get fixture :proofs)))
             (first (funcall globalThis.structuredClone (get fixture :record)))
             (second (funcall globalThis.structuredClone first)))
        (put (get first :execution) :host "tests/first.mjs")
        (put (get first :execution) :arguments (js-array (js-object :directory t)))
        (put (get first :execution) :hostSource (emit-ir-string (compile-ir-string
          "(module seed.first (import \"../multimethod.mjs\" :as selected) (import \"node:fs\" writeFileSync) (import \"node:path\" resolve) (js-call (get globalThis.process :stdout) :write \"A\") (writeFileSync (resolve (aref (get globalThis.process :argv) 2) \"multimethod.mjs\") \"corrupt\"))"
          "seed-first.eli")))
        (put second :id "another-original-observer")
        (put (get second :execution) :host "tests/second.mjs")
        (put (get second :execution) :hostSource (emit-ir-string (compile-ir-string
          "(module seed.second (import \"../multimethod.mjs\" :as selected) (js-call (get globalThis.process :stdout) :write \"B\"))"
          "seed-second.eli")))
        (try
          (let* ((oracle (createOriginalSeedOracle options))
                 (a (await (funcall oracle (js-object :record first :target "javascript"))))
                 (b (await (funcall oracle (js-object :record second :target "javascript")))))
            (js-call assert :strictEqual (get a :stdout) "42A")
            (js-call assert :strictEqual (get b :stdout) "42B")
            (js-call assert :strictEqual (js-length (js-call (Array/from (js-call cache :keys)) :filter
              (lambda (key) (js-call key :startsWith "compiled:")))) 1))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
)
