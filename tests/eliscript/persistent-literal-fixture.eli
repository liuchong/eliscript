(module tests.persistent-literal-fixture
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync writeFileSync mkdtempSync rmSync realpathSync)
  (import "node:module" createRequire)
  (import "node:url" fileURLToPath)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" root)
  (import "../dist/bootstrap/compiler.mjs" compile-string)
  (import "../tools/testing/fixture-environment.mjs" prepareFixtureEnvironment)
  (import "../tools/testing/persistent-literal-fixture.mjs" projectPersistentLiteralSuite persistentLiteralHostArtifactSource
    persistentLiteralPrivateRegexURL persistentLiteralPrivateRegexExpression persistentLiteralHostOptions persistentLiteralFunctionalHostScript)
  (import "../tools/testing/persistent-literal-oracle.mjs" expectedPersistentLiteralReport assertOriginalReport)
  (defun restored-original-tail (source output functional)
    (let* ((old-coordinate "pathToFileURL(resolve(root, 'runtime/core/regex.mjs')).href")
           (expression (persistentLiteralPrivateRegexExpression))
           (restored (js-call (js-call output :split expression) :join old-coordinate)))
      (when functional
        (let* ((begin (js-call source :indexOf "function hostScript("))
               (end (js-call source :indexOf "\n\nfor (const host of" begin))
               (host-script (js-call source :slice begin end))
               (loop "\n\nfor (const host of"))
          (setq restored (js-call (js-call restored :split loop) :join (str host-script loop)))
          (setq restored (js-call (js-call restored :split "    }, 0);") :join "    }, 60000);"))))
      restored))
  (test "persistent functional host removes only both authenticated deadlines and preserves the complete original host body and four host combinations"
    (lambda ()
      (let* ((source (readFileSync (resolve root "tests/wasm-managed-persistent-literals.test.mjs") "utf8"))
             (strict (projectPersistentLiteralSuite root source (js-object)))
             (environment (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1" :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small"))
             (functional (projectPersistentLiteralSuite root source environment))
             (tail (js-call source :slice (js-call source :indexOf "  const oracleDirectory ="))))
        (js-call assert :ok (js-call strict :includes "function hostScript(engine, script, args, timeout = 60000)"))
        (js-call assert :ok (js-call strict :includes "cwd: root, encoding: 'utf8', timeout, env:"))
        (js-call assert :ok (js-call strict :includes "    }, 60000);"))
        (js-call assert :strictEqual (js-call functional :includes "timeout = 60000") false)
        (js-call assert :strictEqual (js-call functional :includes "encoding: 'utf8', timeout") false)
        (js-call assert :strictEqual (js-call functional :includes "    }, 60000);") false)
        (js-call assert :ok (js-call functional :includes "    }, 0);"))
        (js-call assert :strictEqual (js-length (js-call functional :split "hostTest(")) (js-length (js-call source :split "hostTest(")))
        (js-call assert :ok (js-call (restored-original-tail source strict false) :endsWith tail))
        (js-call assert :ok (js-call (restored-original-tail source functional t) :endsWith tail))
        (js-call assert :deepStrictEqual (persistentLiteralHostOptions root (js-object :MARKER "retained") "/actual/bun")
          (js-object :cwd root :encoding "utf8" :env (js-object :MARKER "retained" :BUN "/actual/bun")))
        (let* ((directory (mkdtempSync (resolve root ".eliscript-cache/persistent-host-proof-")))
               (file (resolve directory "host.mjs")))
          (try
            (writeFileSync file (compile-string "(console/log (JSON/stringify (js-object :argv (js-call globalThis.process.argv :slice 2) :cwd (js-call globalThis.process :cwd) :bun (get globalThis.process.env :BUN))))" "persistent-host-proof.eli"))
            (let ((report (persistentLiteralFunctionalHostScript root "node" file (js-array "中😀" "retained"))))
              (js-call assert :deepStrictEqual report (js-object :argv (js-array "中😀" "retained") :cwd root :bun (get globalThis.process :execPath))))
            (writeFileSync file (compile-string "(js-call globalThis.process :exit 7)" "persistent-host-refusal.eli"))
            (js-call assert :throws (lambda () (persistentLiteralFunctionalHostScript root "node" file (js-array)))
              (lambda (error) (and (= (get error :code) "ERR_ASSERTION") (= (get error :actual) 7) (= (get error :expected) 0))))
            (finally (rmSync directory (js-object :recursive t :force t))))))))
  (test "persistent alternate regex provider copies the complete authenticated source to distinct owned files while sharing canonical dependencies"
    (lambda ()
      (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
             (directory (get fixture :directory)))
        (try
          (let* ((first (fileURLToPath (persistentLiteralPrivateRegexURL root directory)))
                 (second (fileURLToPath (persistentLiteralPrivateRegexURL root directory)))
                 (bytes (readFileSync (resolve root "runtime/core/regex.mjs")))
                 (canonical (funcall (createRequire (resolve root "runtime/core/regex.mjs")) (resolve root "runtime/core/regex.mjs")))
                 (left (funcall (createRequire first) first))
                 (right (funcall (createRequire second) second))
                 (pattern (js-call left :compileRegex "a+" "iu")))
            (js-call assert :notStrictEqual first second)
            (js-call assert :deepStrictEqual (readFileSync first) bytes)
            (js-call assert :deepStrictEqual (readFileSync second) bytes)
            (js-call assert :strictEqual (js-call (js-call (createHash "sha256") :update bytes) :digest "hex")
              "9594a0cdad60ca84aa1e1a3786d676eba67239162bfae7f0a151f6ff2a7308b9")
            (js-call (js-array "collection.mjs" "vector.mjs") :forEach (lambda (name)
              (js-call assert :strictEqual (realpathSync (resolve first ".." name)) (realpathSync (resolve root "runtime/core" name)))))
            (js-call assert :strictEqual (js-call left :isRegexPattern pattern) t)
            (js-call assert :strictEqual (js-call canonical :isRegexPattern pattern) false)
            (js-call assert :strictEqual (js-call right :isRegexPattern pattern) false)
            (js-call assert :strictEqual (js-call left :regexSource pattern) "a+")
            (js-call assert :strictEqual (js-call left :regexFlags pattern) "iu"))
          (js-call assert :throws (lambda () (persistentLiteralPrivateRegexURL root root)) globalThis.TypeError)
          (finally (js-call fixture :close))))))
  (test "persistent positive resources retain strict defaults and defer only the original authenticated capacity under both functional flags"
    (lambda ()
      (let* ((source (readFileSync (resolve root "tests/wasm-managed-persistent-literals.test.mjs") "utf8"))
             (strict (projectPersistentLiteralSuite root source (js-object)))
             (environment (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1"
               :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small"))
             (functional undefined) (events (js-array))
             (original-budget "const budget = Object.freeze({maxSlots: 1024, initialBytes: 65536, maxBytes: 16777216});"))
        (let ((original-error (get globalThis.console :error)))
          (try
            (put globalThis.console :error (lambda (&rest arguments) (js-call events :push arguments)))
            (setq functional (projectPersistentLiteralSuite root source environment))
            (finally (put globalThis.console :error original-error))))
        (js-call assert :ok (js-call strict :includes original-budget))
        (js-call (js-array (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1")
          (js-object :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small")) :forEach (lambda (env)
          (js-call assert :strictEqual (projectPersistentLiteralSuite root source env) strict)))
        (js-call assert :strictEqual (js-call functional :includes original-budget) false)
        (js-call assert :ok (js-call functional :includes "131072"))
        (js-call assert :ok (js-call functional :includes "8388608"))
        (js-call assert :ok (js-call functional :includes "67108864"))
        (js-call assert :deepStrictEqual events (js-array (js-array
          "persistent literal original 1024-slot capacity DEFERRED / NOT ACCEPTED"
          (js-object :original (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216)
            :effective (js-object :maxSlots 131072 :initialBytes 8388608 :maxBytes 67108864)))
          (js-array "persistent literal original 60000ms host and case deadlines DEFERRED / NOT ACCEPTED"
            (js-object :originalHostDeadlineMs 60000 :originalCaseDeadlineMs 60000 :functionalDeadlineMs 0))))
        (js-call assert :strictEqual (js-length (js-call functional :split "hostTest("))
          (js-length (js-call source :split "hostTest(")))
        (js-call assert :throws (lambda () (projectPersistentLiteralSuite root (str source "\n") environment)) globalThis.TypeError))))
  (test "persistent activation analyzes every real host local and emits no analysis wrapper or replacement bindings"
    (lambda ()
      (let ((activation (persistentLiteralHostArtifactSource)))
        (js-call assert :strictEqual (value-type activation) "string")
        (js-call assert :ok (> (js-length activation) 0))
        (js-call (js-array "lowered" "wasmBytes" "backend" "modules" "runtime" "literalModules"
                          "memory" "originalModules" "originalLibrary" "assert") :forEach
          (lambda (name) (js-call assert :ok (js-call activation :includes name) name)))
        (js-call assert :strictEqual (js-call activation :includes "persistent_literal_host_boundary_context") false)
        (js-call assert :strictEqual (js-call activation :includes "__eliscript_tdz_") false)
        (js-call assert :strictEqual (persistentLiteralHostArtifactSource) activation))))
  (test "persistent host artifacts explicitly request the existing foreign boundary after retaining the complete original pure proofs"
    (lambda ()
      (let* ((source (readFileSync (resolve root "tests/wasm-managed-persistent-literals.test.mjs") "utf8"))
             (activation (persistentLiteralHostArtifactSource))
             (witness "  assert.deepEqual(WebAssembly.Module.imports(new WebAssembly.Module(wasmBytes)), []);\n")
             (at (+ (js-call source :indexOf witness) (js-length witness)))
             (pure-start (js-call source :indexOf "  const originalModules ="))
             (oracle (js-call source :indexOf "  const originalTest ="))
             (environments (js-array (js-object) (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1"
               :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small"))))
        (js-call assert :ok (> pure-start 0))
        (js-call assert :ok (> at pure-start))
        (js-call assert :ok (> oracle at))
        (js-call environments :forEach (lambda (environment)
          (let* ((output (projectPersistentLiteralSuite root source environment))
                 (inserted (js-call output :indexOf activation)))
            (js-call assert :ok (>= inserted 0))
            (js-call assert :strictEqual (js-call output :indexOf activation (1+ inserted)) -1)
            (js-call assert :ok (js-call output :includes (js-call source :slice pure-start at)))
            (js-call assert :ok (js-call (js-call output :slice 0 inserted) :endsWith witness))
            (js-call assert :ok (js-call (js-call output :slice (+ inserted (js-length activation))) :startsWith
              (js-call source :slice at oracle)))
            (js-call assert :strictEqual (js-length (js-call output :split "hostTest("))
              (js-length (js-call source :split "hostTest("))))))
        (js-call assert :strictEqual (get (get (expectedPersistentLiteralReport) :host) :object) t)
        (js-call assert :throws (lambda () (projectPersistentLiteralSuite root (str source "\n"))) globalThis.TypeError))))
  (test "both complete authenticated persistent projections form one legal lexical module without duplicate compiler preludes"
    (lambda ()
      (let* ((source (readFileSync (resolve root "tests/wasm-managed-persistent-literals.test.mjs") "utf8"))
             (strict (js-object))
             (functional (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1"
               :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small")))
        (js-call (js-array strict functional) :forEach (lambda (environment)
          (let* ((output (projectPersistentLiteralSuite root source environment))
                 (parsed (spawnSync "node" (js-array "--check" "--input-type=module")
                   (js-object :cwd root :encoding "utf8" :input output))))
            (js-call assert :strictEqual (get parsed :error) undefined)
            (js-call assert :strictEqual (get parsed :signal) nil)
            (js-call assert :strictEqual (get parsed :status) 0 (get parsed :stderr))
            (js-call assert :strictEqual (get parsed :stdout) "")
            (js-call assert :ok (js-call (restored-original-tail source output (eq environment functional)) :endsWith (js-call source :slice
              (js-call source :indexOf "  const oracleDirectory ="))))
            (js-call assert :strictEqual (js-length (js-call output :split "hostTest("))
              (js-length (js-call source :split "hostTest(")))))))))
  (test "persistent suite migration replaces only the obsolete generated-code oracle loader and preserves every original registration"
    (lambda ()
      (let* ((source (readFileSync (resolve root "tests/wasm-managed-persistent-literals.test.mjs") "utf8"))
             (output (projectPersistentLiteralSuite root source (js-object)))
             (start (js-call source :indexOf "  const originalTest ="))
             (end (js-call source :indexOf "  const oracleDirectory =" start)))
        (js-call assert :ok (> start 0)) (js-call assert :ok (> end start))
        (js-call assert :ok (js-call (restored-original-tail source output false) :endsWith (js-call source :slice end)))
        (js-call assert :strictEqual (js-call output :includes "new Function(") false)
        (js-call assert :strictEqual (js-length (js-call output :split "hostTest("))
          (js-length (js-call source :split "hostTest(")))
        (let* ((oracle (readFileSync (resolve root "tools/testing/persistent-literal-oracle.eli") "utf8"))
               (prefix "  (defun expectedPersistentLiteralReport ()\n    ")
               (begin (+ (js-call oracle :indexOf prefix) (js-length prefix)))
               (end (js-call oracle :indexOf ")\n  (defun assertOriginalReport" begin))
               (literal (readFileSync (resolve root "tests/eliscript/literal-runtime.eli") "utf8")))
          (js-call assert :ok (> end begin))
          (js-call assert :ok (js-call literal :includes (js-call oracle :slice begin end))
            "the full independent expectation must remain byte-identical to the maintained literal host oracle"))
        (js-call assert :throws (lambda () (projectPersistentLiteralSuite root (str source "\n"))) globalThis.TypeError)
        (let ((called 0) (report (expectedPersistentLiteralReport)))
          (assertOriginalReport (lambda (actual) (js-object :toEqual (lambda (expected)
            (setq called (1+ called)) (js-call assert :deepStrictEqual actual expected)))) report)
          (js-call assert :strictEqual called 1)
          (js-call assert :strictEqual (js-length (Object/keys report)) 9)
          (put (get report :quoted) :symbolName "changed")
          (js-call assert :throws (lambda ()
            (assertOriginalReport (lambda (actual) (js-object :toEqual (lambda (expected)
              (js-call assert :deepStrictEqual actual expected)))) report))))))))
