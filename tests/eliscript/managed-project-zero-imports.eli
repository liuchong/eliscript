  (test "real sorted APIs preserve missing undefined false and null optional boundaries"
    (async ()
      (let* ((compiler (get backend :compiler))
             (source (js-call (js-array
               "(import \"eliscript/runtime/core/sorted.mjs\" :as Sorted)"
               "(defun sequence-result (callback) (try (let ((value (funcall callback)))"
               " (if (nil? value) nil (Array/from value))) (catch error (get error :name))))"
               "(defun empty-result (constructor arguments) (try"
               " (get (Reflect/apply (get constructor :empty) constructor arguments) :count)"
               " (catch error (get error :name))))"
               "(defun report () (let* ((map (Sorted/persistentSortedMap 2 \"b\" 1 \"a\"))"
               " (set (Sorted/persistentSortedSet 2 1)) (out (js-array)))"
               " (let ((owners (js-array map set)) (index 0)) (while (< index 2)"
               "  (let ((owner (aref owners index)) (names (js-array \"entries\" \"keys\" \"values\")) (method-index 0))"
               "   (while (< method-index 3) (let* ((name (aref names method-index)) (method (get owner name)))"
               "    (js-call out :push (js-array"
               "     (Array/from (Reflect/apply method owner (js-array)))"
               "     (Array/from (Reflect/apply method owner (js-array undefined)))"
               "     (Array/from (Reflect/apply method owner (js-array false)))"
               "     (Array/from (Reflect/apply method owner (js-array nil))))))"
               "    (setq method-index (1+ method-index)))) (setq index (1+ index))))"
               " (let ((constructors (js-array (get Sorted :PersistentSortedMap) (get Sorted :PersistentSortedSet))) (index 0))"
               "  (while (< index 2) (let ((constructor (aref constructors index)))"
               "   (js-call out :push (js-array (empty-result constructor (js-array))"
               "    (empty-result constructor (js-array undefined)) (empty-result constructor (js-array nil))"
               "    (empty-result constructor (js-array false))))) (setq index (1+ index))))"
               " (js-call out :push (js-array"
               "  (sequence-result (lambda () (Sorted/sortedSequence map)))"
               "  (sequence-result (lambda () (Sorted/sortedSequence map undefined)))"
               "  (sequence-result (lambda () (Sorted/sortedSequence map false)))"
               "  (sequence-result (lambda () (Sorted/sortedSequence map nil)))"
               "  (sequence-result (lambda () (Sorted/sortedSequence (get Sorted :EMPTY_SORTED_MAP))))))"
               " (js-call out :push (js-array"
               "  (sequence-result (lambda () (Sorted/sortedSequenceFrom map 1)))"
               "  (sequence-result (lambda () (Sorted/sortedSequenceFrom map 1 undefined undefined)))"
               "  (sequence-result (lambda () (Sorted/sortedSequenceFrom map 2 false false)))"
               "  (sequence-result (lambda () (Sorted/sortedSequenceFrom map 1 nil)))"
               "  (sequence-result (lambda () (Sorted/sortedSequenceFrom map 1 t nil)))))"
               " (JSON/stringify out))) (export report)") :join "\n"))
             (program (js-call compiler :compile_ir_string source "sorted-defaults.eli"))
             (libraries (get (await (js-call backend :loadLiteralModules)) :literalModules))
             (before (JSON/stringify program)))
        (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
        (try (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
          (catch error
            (unless (= (get error :code) "EEXIST") (throw error))
            (js-call assert :strictEqual
              (await (realpath (resolve directory "node_modules/eliscript"))) (await (realpath root))
              "sorted reference package must resolve to the actual source runtime")))
        (let* ((reference (await (loadReference (resolve directory "sorted-defaults-reference.mjs")
                            (js-call compiler :emit_ir_string program))))
               (expected (js-call reference :report)) (observed (JSON/parse expected))
               (lowered (js-call (get backend :managed) :lower_managed_project
                 (js-array (js-object :id "main.mjs" :program program)) "main.mjs" runtime
                 (js-object :literalModules libraries)))
               (resources (independentCompilerResources (js-object :profile "small")))
               (image (globalThis.Uint8Array.from
                 (js-call (get backend :wasm) :append_metadata_section
                   (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed)
                     (get resources :memory))
                   "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
               (targets (if native-target (js-array "wasm" "native") (js-array "wasm"))) (index 0))
          (js-call assert :strictEqual (js-length observed) 10)
          (js-call assert :deepStrictEqual (aref observed 1)
            (js-array (js-array 1 2) (js-array 1 2) (js-array 2 1) (js-array 2 1)))
          (js-call assert :deepStrictEqual (aref observed 6) (js-array 0 0 "TypeError" "TypeError"))
          (js-call assert :deepStrictEqual (aref observed 7) (js-array 0 0 "TypeError" "TypeError"))
          (js-call assert :strictEqual (aref (aref observed 8) 3) "TypeError")
          (js-call assert :strictEqual (aref (aref observed 8) 4) nil)
          (js-call assert :strictEqual (aref (aref observed 9) 3) "TypeError")
          (js-call assert :strictEqual (aref (aref observed 9) 4) "TypeError")
          (js-call assert :deepStrictEqual
            (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module image)) (js-array))
          (while (< index (js-length targets))
            (let* ((target (aref targets index))
                   ;; This new optional-argument test loads the complete
                   ;; literal library. Use the existing functional profile;
                   ;; the unrelated original capacity refusal tests stay exact.
                   (options (Object/assign (js-object) (get resources :budget)
                              (js-object :initializeModule false :auto 1)))
                   (adapter undefined) (result undefined))
              (try
                (progn
                  (if (= target "wasm")
                    (setq adapter (await (instantiateManagedRuntimeWithHostModules image options)))
                    (let ((path (resolve directory (if (= native-target "arm64-macos") "sorted-defaults.dylib" "sorted-defaults.so"))))
                      (await (writeFile path (globalThis.Uint8Array.from
                        (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target))))
                      (setq adapter (await (instantiateNativeManagedRuntime path lowered
                        (Object/assign (js-object) options (js-object :nativeTarget native-target)))))))
                  ;; Both actual factories otherwise initialize before they
                  ;; return. Keep the original heap and collection threshold,
                  ;; and enable that threshold before running any initializer.
                  (js-call assert :strictEqual (get (js-call adapter :stats) :collections) 0)
                  (js-call assert :strictEqual (js-call adapter :live) 0)
                  (js-call adapter :auto (get options :auto))
                  (js-call assert :strictEqual (js-call adapter :initializeModule) t)
                  (js-call assert :ok (> (get (js-call adapter :stats) :collections) 0))
                  (setq result (js-call adapter :invoke "report" (js-array)))
                  (js-call assert :strictEqual (js-call adapter :readString result) expected))
                (finally
                  (when adapter
                    (when result (js-call adapter :release result))
                    (js-call adapter :closeModule) (js-call adapter :collect)
                    (js-call assert :strictEqual (js-call adapter :live) 0)
                    (js-call assert :strictEqual (get (js-call adapter :stats) :frameDepth) 0)
                    (when (get adapter :close) (js-call adapter :close))))))
            (setq index (1+ index))))
        (js-call assert :strictEqual (JSON/stringify program) before))) 120000)
