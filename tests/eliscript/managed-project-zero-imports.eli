(module tests.managed-project-zero-imports
  (import "bun:test" beforeAll afterAll test)
  (import "../tools/backends/compiler-corpus-matchers.mjs" expect)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile mkdir realpath symlink rm)
  (import "node:path" resolve dirname)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:module" createRequire)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/compiler-build.mjs" independentCompilerResources)
  (import "../tools/backends/managed-module-graph.mjs"
    createManagedModuleGraph createManagedProjectFacades loadManagedProjectGraph)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntimeWithHostModules)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "./helpers/managed-numeric-selfhosted.mjs" loadReference)
  (import "../tools/backends/managed-source-view.mjs"
    createManagedSourceView bindManagedSourceBoundary withManagedSourceBoundary withManagedSourceBindingPoll)
  (defvar directory undefined)
  (defvar backend undefined)
  (defvar runtime undefined)
  (defconst native-target (when (= (get globalThis.process :arch) "arm64")
    (cond ((= (get globalThis.process :platform) "darwin") "arm64-macos")
          ((= (get globalThis.process :platform) "linux") "arm64-linux"))))
  (defconst sources (js-array
    (js-object :id "dep.mjs" :source (js-call (js-array
      "(defvar count 1)"
      "(defun bump (delta) (setq count (+ count delta)) count)"
      "(defun abrupt () (setq count (+ count 1)) (throw false))"
      "(defun later () (lambda (delta) (setq count (+ count delta)) count))"
      "(defun holder () (js-object :next (lambda (delta) (setq count (+ count delta)) count)))"
      "(defvar pending nil)"
      "(defasync fulfilled () (setq count (+ count 1)) (await (Promise/resolve 0)) (setq count (+ count 1)) count)"
      "(defun begin () (setq pending (fulfilled)) pending)"
      "(defun same-pending () pending)"
      "(defasync rejected () (await (Promise/resolve 0)) (setq count (+ count 1)) (throw false))"
      "(export count bump abrupt later holder begin same-pending rejected)") :join "\n"))
    (js-object :id "main.mjs" :source (js-call (js-array
      ;; Both direct IR linking and the independent emitted ESM oracle use
      ;; these same actual output module IDs without a source resolver pass.
      "(import \"./dep.mjs\" count bump abrupt later holder begin same-pending rejected)"
      "(defun read-count () count)"
      "(export count bump abrupt later holder read-count begin same-pending rejected)"
      "(export-default bump)") :join "\n"))))
  (beforeAll (async ()
    (setq directory (await (realpath (await (mkdtemp (resolve (tmpdir) "eliscript-project-zero-imports-"))))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get backend :compiler) :compile_ir_string
      (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))) 120000)
  (afterAll (async ()
    (setq backend undefined runtime undefined)
    (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defun project ()
    (js-call (get backend :managed) :lower_managed_project
      (js-call sources :map (lambda (item) (js-object :id (get item :id)
        :program (js-call (get backend :compiler) :compile_ir_string (get item :source) (get item :id)))))
      "main.mjs" runtime (js-object :phased t)))
  (defun exercise (namespace)
    (js-call assert :strictEqual (get namespace "default") (get namespace :bump))
    (js-call assert :strictEqual (get namespace :count) 1)
    (js-call assert :strictEqual (js-call namespace :bump 1) 2)
    (js-call assert :strictEqual (get namespace :count) 2)
    (js-call assert :throws (lambda () (js-call namespace :abrupt)) (lambda (error) (eq error false)))
    (js-call assert :strictEqual (get namespace :count) 3)
    (let ((closure (js-call namespace :later)) (object (js-call namespace :holder)))
      (js-call assert :strictEqual (funcall closure 2) 5)
      (js-call assert :strictEqual (get namespace :count) 5)
      (js-call assert :strictEqual (js-call object :next 1) 6)
      (js-call assert :strictEqual (get namespace :count) 6))
    (js-call assert :strictEqual (js-call namespace :read_count) 6))
  (defasync exercise-async (namespace before)
    (let ((promise (js-call namespace :begin)) (constructor-reads 0))
      (js-call assert :strictEqual (js-call namespace :same_pending) promise)
      ;; The source pump must not obtain constructor/species or replace this
      ;; Promise. Let its first real job turn run while this getter is armed.
      (Object/defineProperty promise "constructor" (js-object :configurable t
        :get (lambda () (setq constructor-reads (1+ constructor-reads)) globalThis.Promise)))
      (await (Promise/resolve undefined))
      (js-call assert :strictEqual constructor-reads 0)
      (Reflect/deleteProperty promise "constructor")
      (js-call assert :strictEqual (await promise) (+ before 2))
      (js-call assert :strictEqual (get namespace :count) (+ before 2))
      (await (js-call assert :rejects (js-call namespace :rejected) (lambda (error) (eq error false))))
      (js-call assert :strictEqual (get namespace :count) (+ before 3))))
  (defun check-foreign-initializer-bindings (namespace dependency)
    (js-call assert :strictEqual (get namespace :set_order) "12")
    (js-call assert :strictEqual (get namespace :queue_order) "12")
    (js-call assert :strictEqual (get dependency :set_order) "12")
    (js-call assert :strictEqual (get dependency :queue_order) "12")
    (js-call assert :strictEqual (get dependency :record_set) (get namespace :record_set))
    (js-call assert :strictEqual (js-call namespace :record_set "3" 42) 42)
    (js-call assert :strictEqual (get namespace :set_order) "123")
    (js-call assert :strictEqual (get dependency :set_order) "123")
    (js-call assert :throws (lambda () (js-call namespace :abrupt)) (lambda (error) (eq error false)))
    (js-call assert :strictEqual (get namespace :queue_order) "123")
    (js-call assert :strictEqual (get dependency :queue_order) "123"))

  (test "explicit foreign entry retains live ESM initializer writes without unrelated host modules or async capabilities"
    (async ()
      (let* ((compiler (get backend :compiler))
             (records (js-array
               (js-object :id "dep.mjs" :source (js-call (js-array
                 "(defvar set-order \"\")"
                 "(defun record-set (label value) (setq set-order (str set-order label)) value)"
                 "(defconst set-values (js-array (record-set \"1\" 1) (record-set \"2\" 2)))"
                 "(defvar queue-order \"\")"
                 "(defun record-queue (label value) (setq queue-order (str queue-order label)) value)"
                 "(defconst queue-values (js-array (record-queue \"1\" 1) (record-queue \"2\" 2)))"
                 "(defun abrupt () (record-queue \"3\" 3) (throw false))"
                 "(export set-order queue-order record-set abrupt)") :join "\n"))
               (js-object :id "main.mjs" :source
                 "(import \"./dep.mjs\" set-order queue-order record-set abrupt) (export set-order queue-order record-set abrupt)")))
             (reference (resolve directory "foreign-initializers-reference"))
             (before (JSON/stringify records)))
        (await (mkdir reference (js-object :recursive t)))
        (let ((index 0))
          (while (< index (js-length records))
            (let ((item (aref records index)))
              (await (writeFile (resolve reference (get item :id))
                (js-call compiler :compile_string (get item :source) (get item :id)))))
            (setq index (1+ index))))
        (let ((load (createRequire (resolve reference "main.mjs"))))
          (check-foreign-initializer-bindings (funcall load (resolve reference "main.mjs"))
            (funcall load (resolve reference "dep.mjs"))))
        (let* ((lowered (js-call (get backend :managed) :lower_managed_project
                         (js-call records :map (lambda (item) (js-object :id (get item :id)
                           :program (js-call compiler :compile_ir_string (get item :source) (get item :id)))))
                         "main.mjs" runtime (js-object :phased t :foreignEntry t)))
               (descriptor (get lowered :descriptor))
               (bytes (globalThis.Uint8Array.from (js-call (get backend :wasm) :append_metadata_section
                        (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed))
                        "eliscript-managed-control" (JSON/stringify descriptor))))
               (targets (if native-target (js-array "wasm" "native") (js-array "wasm"))) (index 0))
          (js-call assert :deepStrictEqual (get descriptor :hostCapabilities)
            (js-array (js-object :name "source-operation" :module "eliscript.host" :arity 2 :abi "managed-host-call-v1")))
          (check-owned-source-operation-import bytes)
          (while (< index (js-length targets))
            (let* ((target (aref targets index)) (deployment (resolve directory "foreign-initializers" target))
                   (graph (createManagedModuleGraph descriptor))
                   (options (js-object :initializeModule false :moduleGraph graph :maxSlots 4096
                     :initialBytes 1048576 :maxBytes 16777216 :auto 1 :nativeTarget native-target))
                   (adapter undefined))
              (try
                (progn
                  (let* ((facades (createManagedProjectFacades descriptor (js-object :entry "main.mjs")))
                         (files (get facades :files)) (position 0))
                    (while (< position (js-length files))
                      (let* ((file (aref files position)) (path (resolve deployment (get file :id))))
                        (await (mkdir (dirname path) (js-object :recursive t)))
                        (await (writeFile path (get file :source))))
                      (setq position (1+ position))))
                  (if (= target "wasm")
                    (setq adapter (await (instantiateManagedRuntimeWithHostModules bytes options)))
                    (let ((path (resolve deployment (if (= native-target "arm64-macos") "project.dylib" "project.so"))))
                      (await (writeFile path (globalThis.Uint8Array.from
                        (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target))))
                      (setq adapter (await (instantiateNativeManagedRuntime path lowered options)))))
                  (js-call adapter :auto 1)
                  (let* ((loaded (await (loadManagedProjectGraph adapter descriptor
                                   (js-object :moduleGraph graph :projectEntry "main.mjs"
                                     :projectModuleBaseURL (get (pathToFileURL (str deployment "/")) :href)))))
                         (dependency (funcall (createRequire (resolve deployment "main.mjs")) (resolve deployment "dep.mjs"))))
                    (check-foreign-initializer-bindings (get loaded :namespace) dependency)))
                (finally
                  (when adapter
                    (js-call adapter :closeModule) (js-call adapter :collect)
                    (js-call assert :strictEqual (js-call adapter :live) 0)
                    (js-call assert :strictEqual (get (js-call adapter :stats) :frameDepth) 0)
                    (when (get adapter :close) (js-call adapter :close)))
                  (js-call graph :close))))
            (setq index (1+ index))))
        (js-call assert :strictEqual (JSON/stringify records) before))) 120000)

  (test "pure phased projects retain actual zero imports and canonical ESM bindings through calls throws and returned closures"
    (async ()
      ;; The same source is also executed as ordinary emitted JavaScript.
      (let ((reference (resolve directory "reference")))
        (await (mkdir reference (js-object :recursive t)))
        (let ((index 0))
          (while (< index (js-length sources))
            (let ((item (aref sources index)))
              (await (writeFile (resolve reference (get item :id))
                (js-call (get backend :compiler) :compile_string (get item :source) (get item :id)))))
            (setq index (1+ index))))
        (let ((namespace (funcall (createRequire (resolve reference "main.mjs")) (resolve reference "main.mjs"))))
          (exercise namespace) (await (exercise-async namespace 6))))
      (let* ((lowered (project)) (descriptor (get lowered :descriptor))
             (bytes (js-call globalThis.Uint8Array :from
               (js-call (get backend :wasm) :append_metadata_section
                 (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed)
                   (js-object :initialPages 1 :maximumPages 256))
                 "eliscript-managed-control" (JSON/stringify descriptor))))
             (targets (if native-target (js-array "wasm" "native") (js-array "wasm"))) (index 0))
        (js-call assert :deepStrictEqual
          (js-call (get globalThis.WebAssembly :Module) :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
        (js-call assert :deepStrictEqual
          (if (undefined? (get descriptor :hostCapabilities)) (js-array) (get descriptor :hostCapabilities)) (js-array))
        (while (< index (js-length targets))
          (let* ((target (aref targets index)) (deployment (resolve directory target))
                 (graph (createManagedModuleGraph descriptor))
                 (options (js-object :initializeModule false :moduleGraph graph :maxSlots 4096
                   :initialBytes 1048576 :maxBytes 16777216 :auto 1
                   :initialPages 1 :maximumPages 256 :nativeTarget native-target))
                 (adapter undefined))
            (try
              (progn
                (let* ((facades (createManagedProjectFacades descriptor (js-object :entry "main.mjs")))
                       (files (get facades :files)) (position 0))
                  (while (< position (js-length files))
                    (let* ((file (aref files position)) (path (resolve deployment (get file :id))))
                      (await (mkdir (dirname path) (js-object :recursive t)))
                      (await (writeFile path (get file :source))))
                    (setq position (1+ position))))
                (if (= target "wasm")
                  (setq adapter (await (instantiateManagedRuntimeWithHostModules bytes options)))
                  (let ((path (resolve deployment (if (= native-target "arm64-macos") "project.dylib" "project.so"))))
                    (await (writeFile path (js-call globalThis.Uint8Array :from
                      (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target))))
                    (setq adapter (await (instantiateNativeManagedRuntime path lowered options)))))
                (let* ((loaded (await (loadManagedProjectGraph adapter descriptor
                         (js-object :moduleGraph graph :projectEntry "main.mjs"
                           :projectModuleBaseURL (get (pathToFileURL (+ deployment "/")) :href)))))
                       (namespace (get loaded :namespace)))
                  (exercise namespace)
                  ;; This graph is independently proven import-free above.
                  ;; Its ordinary objects retain one real managed Object root,
                  ;; even while another capability owner uses the host root.
                  (let ((object (js-call namespace :holder)))
                    (js-call assert :notStrictEqual (Object/getPrototypeOf object) (get globalThis.Object :prototype))
                    (js-call assert :strictEqual (Object/getPrototypeOf object)
                      (Object/getPrototypeOf (get (get namespace :holder) :prototype))))
                  ;; A watcher re-enters the same canonical callable. Its write
                  ;; must reach every ESM alias before the outer call returns.
                  (let* ((module (js-call (get (get descriptor :project) :modules) :find
                                   (lambda (item) (= (get item :id) "dep.mjs"))))
                         (cell (js-call (get module :exports) :find (lambda (item) (= (get item :name) "count"))))
                         (stop (js-call graph :watch (get cell :kind) (get cell :index)
                           (lambda (value) (when (= value 7) (js-call namespace :bump 1))))))
                    (try
                      (progn (js-call assert :strictEqual (js-call namespace :bump 1) 7)
                        (js-call assert :strictEqual (get namespace :count) 8)
                        (js-call assert :strictEqual (js-call namespace :read_count) 8))
                      (finally (funcall stop))))
                  ;; Raw managed invoke and decoded canonical functions share
                  ;; this exact same source-view identity and binding boundary.
                  (js-call assert :strictEqual (get (get adapter :invoke) :length) 1)
                  (let ((reference (js-call adapter :getExport "bump")))
                    (try (js-call assert :strictEqual (js-call adapter :toHostValue reference) (get namespace :bump))
                      (finally (js-call adapter :release reference))))
                  (let ((argument (js-call adapter :number 2)) (result undefined))
                    (try
                      (progn
                        (setq result (js-call adapter :invoke "bump" (js-array argument)))
                        (js-call assert :strictEqual (js-call adapter :readNumber result) 10)
                        (js-call assert :strictEqual (get namespace :count) 10))
                      (finally
                        (when result (js-call adapter :release result))
                        (js-call adapter :release argument))))
                  (await (exercise-async namespace 10))
                  (let ((pending (js-call namespace :begin)))
                    ;; Teardown rejects the original outstanding Promise and
                    ;; queued polling must not read cells after module close.
                    (js-call adapter :closeModule)
                    (await (js-call assert :rejects pending (lambda (error)
                      (= (get error :message) "managed host promise is closed")))))))
              (finally
                (when adapter
                  (js-call adapter :closeModule) (js-call adapter :collect)
                  (js-call assert :strictEqual (js-call adapter :live) 0)
                  (js-call assert :strictEqual (get (js-call adapter :stats) :frameDepth) 0)
                  (when (get adapter :close) (js-call adapter :close)))
                (js-call graph :close))))
          (setq index (1+ index))))) 120000)

  (test "source boundary ownership never probes descriptors or replaces the original Proxy owner"
    (lambda ()
      (let* ((reads (js-array)) (first 0) (second 0)
             (owner (lambda () (setq first (1+ first))))
             (other (lambda () (setq second (1+ second))))
             (view (createManagedSourceView (js-object :target (js-object)
               :operations (js-object :descriptor (lambda (key) (js-call reads :push key) undefined)))))
             (proxy (get view :value))
             (opaque (new globalThis.Proxy (js-object) (js-object
               :getOwnPropertyDescriptor (lambda (target key) (js-call reads :push key) (throw false))))))
        (js-call assert :strictEqual (bindManagedSourceBoundary proxy owner) proxy)
        (js-call assert :strictEqual (bindManagedSourceBoundary proxy other) proxy)
        (js-call assert :strictEqual (bindManagedSourceBoundary opaque owner) opaque)
        (js-call (js-array nil false t undefined 1 "text") :forEach (lambda (value)
          (js-call assert :strictEqual (bindManagedSourceBoundary value owner) value)))
        (js-call assert :strictEqual (withManagedSourceBoundary owner (lambda () proxy)) proxy)
        (js-call assert :deepStrictEqual reads (js-array))
        (js-call assert :strictEqual first 1)
        (js-call assert :strictEqual second 0)
        ;; Explicit reflection still observes the original descriptor operation
        ;; and its owner once. Only the private WeakMap lookup is non-observing.
        (js-call assert :strictEqual (Reflect/getOwnPropertyDescriptor proxy "visible") undefined)
        (js-call assert :deepStrictEqual reads (js-array "visible"))
        (js-call assert :strictEqual first 2)
        (js-call assert :strictEqual second 0))))
  (test "only a private same-owner binding poll reuses a completed refresh while all public Proxy operations stay live"
    (lambda ()
      (let* ((owner (lambda () undefined)) (other (lambda () undefined))
             (source (js-object :x 42)) (descriptors 0) (gets 0) (fail false)
             (view (createManagedSourceView (js-object :target (js-object) :operations (js-object
               :keys (lambda () (Reflect/ownKeys source))
               :extensible (lambda () (Reflect/isExtensible source))
               :descriptor (lambda (key)
                 (setq descriptors (1+ descriptors))
                 (when fail (throw false))
                 (Reflect/getOwnPropertyDescriptor source key))
               :get (lambda (key receiver) (setq gets (1+ gets)) (Reflect/get source key receiver))))))
             (proxy (bindManagedSourceBoundary (get view :value) owner)))
        (js-call assert :ok (Object/isFrozen view))
        (js-call assert :strictEqual (get (get view :refresh) :name) "refresh")
        (js-call assert :strictEqual (get (get view :refresh) :length) 0)
        ;; A first decode inside a poll must still mirror actual descriptors.
        (js-call assert :strictEqual
          (withManagedSourceBindingPoll owner (lambda () (js-call view :refresh))) proxy)
        (js-call assert :strictEqual descriptors 1)
        (withManagedSourceBindingPoll owner (lambda () (js-call view :refresh) (js-call view :refresh)))
        (js-call assert :strictEqual descriptors 1)
        (withManagedSourceBindingPoll other (lambda () (js-call view :refresh)))
        (js-call assert :strictEqual descriptors 2)
        (js-call view :refresh)
        (js-call assert :strictEqual descriptors 3)
        ;; Internal legacy Proxy trap synchronization never uses the gate.
        (withManagedSourceBindingPoll owner (lambda ()
          (js-call assert :deepStrictEqual (Reflect/getOwnPropertyDescriptor proxy "x")
            (Reflect/getOwnPropertyDescriptor source "x"))
          (js-call assert :deepStrictEqual (Reflect/ownKeys proxy) (js-array "x"))
          (js-call assert :strictEqual (Reflect/get proxy "x") 42)))
        (js-call assert :strictEqual descriptors 6)
        (js-call assert :strictEqual gets 1)
        ;; An incomplete/failed refresh cannot become a reusable snapshot.
        (setq fail t)
        (js-call assert :throws
          (lambda () (withManagedSourceBindingPoll other (lambda () (js-call view :refresh))))
          (lambda (error) (eq error false)))
        (js-call assert :strictEqual descriptors 7)
        (setq fail false)
        (withManagedSourceBindingPoll owner (lambda () (js-call view :refresh) (js-call view :refresh)))
        (js-call assert :strictEqual descriptors 8)
        (js-call view :refresh)
        (js-call assert :strictEqual descriptors 9)
        (js-call assert :throws
          (lambda () (withManagedSourceBindingPoll owner (lambda () (throw false))))
          (lambda (error) (eq error false)))
        (js-call view :refresh)
        (js-call assert :strictEqual descriptors 10))))
  (test "pure graph synchronization never reads an unwatched TDZ and preserves an abrupt first value over cleanup"
    (lambda ()
      (let* ((reads (js-array)) (value 1) (ready false) (fail-sync false)
             (descriptor (js-object :hostCapabilities (js-array) :hostModules (js-array)
               :project (js-object :prepare "prepare" :entry "main.mjs" :modules (js-array
                 (js-object :id "main.mjs" :dependencies (js-array) :steps (js-array
                   (js-object :run "initialize" :initializes (js-array (js-object :kind 0 :index 0))))
                   :exports (js-array (js-object :name "value" :kind 0 :index 0 :mutable t)))))))
             (graph (createManagedModuleGraph descriptor))
             (runtime (js-object :project (js-object
               :prepare (lambda () t) :run (lambda (name) (setq ready t))
               :get (lambda (kind index) (js-call reads :push index)
                 (when fail-sync (throw "sync-error"))
                 (unless ready (throw (new globalThis.ReferenceError "TDZ"))) value)
               :bindHoisted (lambda (kind index fn) fn)
               :invoke (lambda (&rest arguments) (setq value 2) (throw false)))))
             (observed undefined))
        (try
          (progn
            (js-call graph :attachRuntime runtime) (js-call graph :prepare)
            (js-call assert :deepStrictEqual reads (js-array))
            (js-call assert :throws (lambda () (js-call graph :read 0 0)) globalThis.ReferenceError)
            (js-call graph :step "initialize")
            (setq observed (js-call graph :read 0 0))
            (js-call graph :watch 0 0 (lambda (next) (setq observed next)))
            (js-call assert :throws (lambda () (js-call graph :invoke 0 0 undefined (js-array)))
              (lambda (error) (eq error false)))
            (js-call assert :strictEqual observed 2)
            (setq fail-sync t)
            (js-call assert :throws (lambda () (js-call graph :invoke 0 0 undefined (js-array)))
              (lambda (error) (eq error false))))
          (finally (js-call graph :close))))))
  (test "binding listeners and explicit project reads run outside the private cached refresh scope"
    (lambda ()
      (let* ((counts (js-array 0 0))
             (make-view (lambda (index)
               (let ((source (js-object :value index)))
                 (createManagedSourceView (js-object :target (js-object) :operations (js-object
                   :keys (lambda () (Reflect/ownKeys source))
                   :extensible (lambda () (Reflect/isExtensible source))
                   :descriptor (lambda (key)
                     (put counts index (1+ (aref counts index)))
                     (Reflect/getOwnPropertyDescriptor source key))))))))
             (first (funcall make-view 0)) (second (funcall make-view 1)) (selected first)
             (descriptor (js-object :hostCapabilities (js-array) :hostModules (js-array)
               :project (js-object :prepare "prepare" :entry "main.mjs" :modules (js-array
                 (js-object :id "main.mjs" :dependencies (js-array) :steps (js-array)
                   :exports (js-array (js-object :name "value" :kind 0 :index 0 :mutable t)))))))
             (graph (createManagedModuleGraph descriptor))
             (runtime (js-object :project (js-object
               :prepare (lambda () t)
               :run (lambda (name) t)
               :bindHoisted (lambda (kind index fn) fn)
               :get (lambda (kind index) (js-call selected :refresh))
               :invoke (lambda (&rest arguments) (setq selected second) 42))))
             (notifications 0) (stop undefined))
        (try
          (progn
            (js-call graph :attachRuntime runtime) (js-call graph :prepare)
            (js-call assert :strictEqual (js-call graph :read 0 0) (get first :value))
            (setq stop (js-call graph :watch 0 0 (lambda (value)
              (setq notifications (1+ notifications))
              (js-call assert :strictEqual value (get second :value))
              ;; This full public refresh occurs during listener delivery.
              ;; The earlier base.read poll must already have exited its gate.
              (js-call assert :strictEqual (js-call second :refresh) value))))
            (js-call assert :strictEqual (aref counts 0) 2)
            (js-call assert :strictEqual (js-call graph :invoke 0 0 undefined (js-array)) 42)
            (js-call assert :strictEqual notifications 1)
            (js-call assert :strictEqual (aref counts 1) 2)
            ;; An explicit read remains a normal full decode even after polls.
            (js-call assert :strictEqual (js-call graph :read 0 0) (get second :value))
            (js-call assert :strictEqual (aref counts 1) 3))
          (finally (when stop (funcall stop)) (js-call graph :close))))))
  (test "module-wrapped canonical library imports retain the same private zero-import graph as unwrapped imports"
    (async ()
      (let* ((libraries (get (await (js-call backend :loadLiteralModules)) :literalModules))
             (body "(import \"eliscript/runtime/core/vector.mjs\" :as Vector) (defun same (value) (Object/is value (get Vector :PersistentVector))) (export same)")
             (declaration (js-object :id "runtime/core/vector.mjs"
               :specifier "eliscript/runtime/core/vector.mjs" :referrer "main.mjs"
               :namespace t :allowedExports (js-array)))
             (options (js-object :phased t :entries (js-array "main.mjs")
