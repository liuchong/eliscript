               "   (js-call observed :push (try (Reflect/apply has second (js-array instance)) (catch error error))))"
               " (Reflect/deleteProperty Constructor Symbol.hasInstance)"
               " (put Constructor :prototype 3)"
               " (js-call observed :push (Reflect/apply has Constructor (js-array 1))"
               "   (try (Reflect/apply has Constructor (js-array instance)) (catch error (get error :name))))"
               " (put Constructor :prototype (Object/getPrototypeOf instance))"
               " (js-call observed :push (Reflect/apply has Constructor (js-array instance)))"
               " (JSON/stringify observed))) (export report)") :join "\n"))
