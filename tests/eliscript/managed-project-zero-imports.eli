                        (lambda () (js-call events :push "descriptor:value") 17)))
                      (js-call assert :strictEqual (js-call namespace :object_native_call "define" proxy key definition) proxy)
                      (js-call assert :strictEqual (js-call namespace :object_native_call "hasOwn" proxy key undefined) t)
                      (js-call assert :deepStrictEqual events
                        (js-array "key:string" "descriptor:value" "define:value" "key:string" "own:value"))
                      (js-call assert :strictEqual (get target :value) 17)
                      (let ((bad-key (js-object)) (threw false))
                        (put bad-key (get globalThis.Symbol :toPrimitive) (lambda (hint) (throw undefined)))
                        (try (js-call namespace :object_native_call "hasOwn" proxy bad-key undefined)
                          (catch error (setq threw t) (js-call assert :strictEqual error undefined)))
                        (js-call assert :strictEqual threw t)))
