               " (instance (new Constructor)) (bound (js-call Constructor :bind nil))"
               " (trace (js-array)) (custom (js-object)) (observed (js-array)))"
               " (js-call observed :push cold (get has :name) (get has :length)"
               "   (get description :writable) (get description :enumerable) (get description :configurable)"
               "   (Reflect/apply has Constructor (js-array instance))"
               "   (Reflect/apply has bound (js-array instance))"
               "   (Reflect/apply has nil (js-array instance))"
               "   (Reflect/apply has (js-object) (js-array instance))"
