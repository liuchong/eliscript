                    (let* ((frozen (js-object :value 7))
                           (result (js-call namespace :object_native_call "freeze" frozen undefined undefined)))
                      (js-call assert :strictEqual result frozen)
                      (js-call assert :strictEqual (Object/isFrozen frozen) t))))
                  (when (get variant :async)
                    (setq phase "original-async-report")
                    (setq async-handle (js-call adapter :getExport "async_report"))
                    (let ((callback (js-call adapter :toHostValue async-handle)))
                      (js-call assert :strictEqual (await (funcall callback)) expected-async))
                    (js-call adapter :release async-handle) (setq async-handle undefined)))
                (catch error
                  (setq failed t)
                  ;; Preserve the original object/value and first diagnostic.
                  ;; Bounded context locates any remaining real fixture failure.
                  (when (and error (= (value-type error) "object") (get error :eliscriptDiagnostic))
                    (try (Object/defineProperty error "eliscriptManagedProjectTest"
                      (js-object :value (js-object :variant (get variant :name) :target target :phase phase)
                        :enumerable t :configurable t)) (catch ignored nil)))
                  (throw error))
                (finally
                  (let ((cleanup undefined) (cleanup-failed false))
                    (js-call (js-array
                      (lambda () (when (and adapter out) (js-call adapter :release out)))
                      (lambda () (when (and adapter async-handle) (js-call adapter :release async-handle)))
                      (lambda () (when adapter (js-call adapter :closeModule)))
                      (lambda () (js-call graph :close))
                      (lambda () (when adapter (js-call adapter :collect)))
                      (lambda () (when adapter (js-call assert :strictEqual (js-call adapter :live) 0)))
                      (lambda () (when adapter (js-call assert :strictEqual (get (js-call adapter :stats) :frameDepth) 0)))
                      (lambda () (when (and adapter (get adapter :close)) (js-call adapter :close))))
                      :forEach (lambda (action)
                        (try (funcall action)
                          (catch error (unless cleanup-failed (setq cleanup-failed t cleanup error))))))
                    (when (and cleanup-failed (not failed)) (throw cleanup)))))
                (setq position (1+ position))))
            (setq variant-index (1+ variant-index))))
          (js-call assert :strictEqual (JSON/stringify records) saved)
          ;; All original pure/complete WASM/native calls and goldens finish
          ;; before this additional raw pre-initialization regression runs.
          (js-call assert :strictEqual (value-type raw-admission) "function")
          (funcall raw-admission)))) 120000)
)
