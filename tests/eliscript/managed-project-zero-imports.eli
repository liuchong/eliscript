                    ;; its owned receiver. It must never be treated as native.
                    (when (get variant :async)
                      (let ((before (Object/getOwnPropertyDescriptor globalThis.Object "hasOwn")) (escaped undefined))
                        (try
                          (progn
                            (Object/defineProperty globalThis.Object "hasOwn" (Object/assign (js-object) before
                              (js-object :value (lambda (object key)
                                (when (= key "value")
                                  (let ((own (Object/getOwnPropertyDescriptor object key)))
                                    (when (and own (= (get own :value) 42)) (setq escaped object))))
                                (Reflect/apply (get before :value) globalThis.Object (js-array object key))))))
                            (js-call assert :strictEqual (js-call namespace :owned_native_has_own) t)
                            (js-call assert :strictEqual (get escaped :value) 42))
