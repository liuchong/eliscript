  (test "the unchanged local recursive source completes its ten thousand mutual tail calls on both real targets"
    (async ()
      (let* ((source (await (readFile (resolve root "tests/fixtures/local-recursive-functions.eli") "utf8")))
             (compiler (get backend :compiler))
             (program (js-call compiler :compile_ir_string source "tests/fixtures/local-recursive-functions.eli"))
             (before (JSON/stringify program))
             (reference (await (loadReference (resolve directory "local-recursive-reference.mjs")
               (js-call compiler :emit_ir_string program))))
             (expected (js-call reference :report))
             (expected-async (await (js-call reference :async_report)))
             (lowered (js-call (get backend :managed) :lower_managed_project
               (js-array (js-object :id "main.mjs" :program program)) "main.mjs" runtime))
             (descriptor (get lowered :descriptor))
             (image (globalThis.Uint8Array.from
               (js-call (get backend :wasm) :append_metadata_section
                 (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed))
                 "eliscript-managed-control" (JSON/stringify descriptor))))
             (targets (if native-target (js-array "wasm" "native") (js-array "wasm"))) (position 0))
        ;; The unchanged full fixture genuinely awaits an unknown source call.
        ;; It therefore owns this exact capability, unlike the pure graph
        ;; above; canonical host identity here is intentional, not cache bleed.
        (js-call assert :deepStrictEqual (get descriptor :hostCapabilities)
          (js-array (js-object :name "source-operation" :module "eliscript.host" :arity 2 :abi "managed-host-call-v1")))
        (check-owned-source-operation-import image)
        (js-call assert :deepStrictEqual expected
          (js-object :even t :odd t :none "none" :captured 42 :stackSafe "done" :escapedEven t :portableEven t))
        (js-call assert :strictEqual expected-async "async-done")
        (while (< position (js-length targets))
          (let* ((target (aref targets position))
                 (options (js-object :maxSlots 131072 :initialBytes 8388608 :maxBytes 67108864 :auto 65536))
                 (adapter undefined) (handles (js-array)) (failed false))
            (try
              (progn
                (if (= target "wasm")
                  (setq adapter (await (instantiateManagedRuntimeWithHostModules image options)))
                  (let ((path (resolve directory (if (= native-target "arm64-macos") "local-recursive.dylib" "local-recursive.so"))))
                    (await (writeFile path (globalThis.Uint8Array.from
                      (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target))))
                    (setq adapter (await (instantiateNativeManagedRuntime path lowered
                      (Object/assign (js-object) options (js-object :nativeTarget native-target)))))))
                (js-call adapter :auto (get options :auto))
                (let ((sync (js-call adapter :getExport "report"))
                      (async (js-call adapter :getExport "async_report")))
                  (js-call handles :push sync async)
                  (let* ((callee (js-call adapter :toHostValue sync)) (actual (funcall callee))
                         (keys (Reflect/ownKeys expected)))
                    ;; Compare every original observation and the canonical
                    ;; Object identity of this actual source-operation graph.
                    (js-call assert :deepStrictEqual (Reflect/ownKeys actual) keys)
                    (js-call keys :forEach (lambda (key)
                      (let ((left (Object/getOwnPropertyDescriptor actual key))
                            (right (Object/getOwnPropertyDescriptor expected key)))
                        (js-call assert :deepStrictEqual (Reflect/ownKeys left) (Reflect/ownKeys right))
                        (js-call assert :strictEqual (Object/is (get left :value) (get right :value)) t)
                        (js-call assert :strictEqual (get left :writable) (get right :writable))
                        (js-call assert :strictEqual (get left :enumerable) (get right :enumerable))
                        (js-call assert :strictEqual (get left :configurable) (get right :configurable)))))
                    (js-call assert :strictEqual (Object/getPrototypeOf actual) (get globalThis.Object :prototype))
                    (js-call assert :strictEqual (Object/getPrototypeOf actual)
                      (Object/getPrototypeOf (get callee :prototype))))
                  (js-call assert :strictEqual (await (funcall (js-call adapter :toHostValue async))) expected-async)))
              (catch error (setq failed t) (throw error))
              (finally
                (when adapter
                  (let ((cleanup undefined) (cleanup-failed false))
                    (js-call handles :forEach (lambda (handle)
                      (try (js-call adapter :release handle)
                        (catch error (unless cleanup-failed (setq cleanup error cleanup-failed t))))))
                    (js-call (js-array
                      (lambda () (js-call adapter :closeModule))
                      (lambda () (js-call adapter :collect))
                      (lambda () (js-call assert :strictEqual (js-call adapter :live) 0))
                      (lambda () (js-call assert :strictEqual (get (js-call adapter :stats) :frameDepth) 0))
                      (lambda () (when (get adapter :close) (js-call adapter :close)))) :forEach
                      (lambda (action) (try (funcall action)
                        (catch error (unless cleanup-failed (setq cleanup error cleanup-failed t))))))
                    (when (and cleanup-failed (not failed)) (throw cleanup)))))))
          (setq position (1+ position)))
        (js-call assert :strictEqual (JSON/stringify program) before))) 120000)
