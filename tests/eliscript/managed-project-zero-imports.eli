                  (setq phase "native-object-boundary")
                  (let* ((loaded (await (loadManagedProjectGraph adapter descriptor
                            (js-object :moduleGraph graph :projectEntry entry :projectModuleBaseURL base))))
                         (namespace (get loaded :namespace)))
                    (js-call assert :strictEqual (js-call namespace :owned_native_object_report) native-object-expected)
                    (when (get variant :async)
                    ;; Foreign values/Proxy traps and an object-valued key keep
                    ;; the genuine native operation and its exact call order.
                    (let* ((events (js-array)) (target (js-object))
                           (proxy (new globalThis.Proxy target (js-object
                             :getOwnPropertyDescriptor (lambda (owner key)
                               (js-call events :push (+ "own:" (funcall globalThis.String key)))
