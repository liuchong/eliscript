  ;; Read the actual import's type index instead of inferring its signature
  ;; from descriptor metadata or requiring optional engine type reflection.
  (defun owned-binding-wasm-word (bytes cursor)
    (let ((value 0) (factor 1) (count 0) (done false))
      (while (not done)
        (js-call assert :ok (and (< (get cursor :at) (js-length bytes)) (< count 5)))
        (let ((byte (aref bytes (get cursor :at))))
          (put cursor :at (1+ (get cursor :at)))
          (setq value (+ value (* (% byte 128) factor)) count (1+ count))
          (if (< byte 128) (setq done t) (setq factor (* factor 128)))))
      (js-call assert :ok (<= value 4294967295)) value))
  (defun owned-binding-wasm-text (bytes cursor)
    (let* ((count (owned-binding-wasm-word bytes cursor)) (start (get cursor :at)) (end (+ start count)))
      (js-call assert :ok (<= end (js-length bytes))) (put cursor :at end)
      (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t)) :decode (js-call bytes :subarray start end))))
  (defun owned-binding-wasm-types (bytes cursor)
    (let ((count (owned-binding-wasm-word bytes cursor)) (out (js-array)) (index 0))
      (while (< index count)
        (js-call assert :ok (< (get cursor :at) (js-length bytes)))
        (js-call out :push (aref bytes (get cursor :at)))
        (put cursor :at (1+ (get cursor :at))) (setq index (1+ index))) out))
  (defun owned-binding-wasm-imports (bytes)
    (let ((cursor (js-object :at 8)) (types (js-array)) (imports (js-array)))
      (while (< (get cursor :at) (js-length bytes))
        (let ((section (aref bytes (get cursor :at))))
          (put cursor :at (1+ (get cursor :at)))
          (let* ((count (owned-binding-wasm-word bytes cursor)) (end (+ (get cursor :at) count)))
            (js-call assert :ok (<= end (js-length bytes)))
            (cond
              ((= section 1)
                (let ((length (owned-binding-wasm-word bytes cursor)) (index 0))
                  (while (< index length)
                    (js-call assert :strictEqual (aref bytes (get cursor :at)) 96)
                    (put cursor :at (1+ (get cursor :at)))
                    (let* ((parameters (owned-binding-wasm-types bytes cursor))
                           (results (owned-binding-wasm-types bytes cursor)))
                      (js-call types :push (js-object :parameters parameters :results results)))
                    (setq index (1+ index)))))
              ((= section 2)
                (let ((length (owned-binding-wasm-word bytes cursor)) (index 0))
                  (while (< index length)
                    (let* ((module (owned-binding-wasm-text bytes cursor)) (name (owned-binding-wasm-text bytes cursor))
                           (kind (aref bytes (get cursor :at))))
                      (js-call assert :strictEqual kind 0)
                      (put cursor :at (1+ (get cursor :at)))
                      (let ((type (owned-binding-wasm-word bytes cursor)))
                        (js-call assert :ok (< type (js-length types)))
                        (js-call imports :push (js-object :module module :name name :kind "function" :type (aref types type)))))
                    (setq index (1+ index))))))
            (js-call assert :ok (<= (get cursor :at) end))
            (put cursor :at end)))) imports))
  (defun check-owned-source-operation-import (bytes)
    (let ((imports (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes))))
      (js-call assert :deepStrictEqual
        (js-call imports :map (lambda (item)
          (js-object :module (get item :module) :name (get item :name) :kind (get item :kind))))
        (js-array (js-object :module "eliscript.host" :name "source-operation" :kind "function")))
      ;; Some engines expose the real function type. An exposed wrong type
      ;; must fail; an absent optional reflection field is not fabricated.
      (js-call imports :forEach (lambda (item)
        (when (Object/hasOwn item "type")
          (js-call assert :deepStrictEqual (get item :type)
            (js-object :parameters (js-array "i32" "i32") :results (js-array "i32"))))))
      ;; Independently authenticate the actual binary type index on every
      ;; engine, including Node releases without type reflection.
      (js-call assert :deepStrictEqual (owned-binding-wasm-imports bytes)
        (js-array (js-object :module "eliscript.host" :name "source-operation" :kind "function"
          :type (js-object :parameters (js-array 127 127) :results (js-array 127)))))))
  (defun check-literal-brand-admission (bytes descriptor budget)
    ;; Reuse the same true zero-import image and its actual public project
    ;; prepare/get/close exports. Runtime-private module helpers are not part
    ;; of a user product's exports. Only this fresh instance's registry cells
    ;; are staged through the real slab's undeclared/uninitialized states.
    (let* ((exports (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
           (raw (lambda (name &rest arguments)
             (let ((function (get exports name)))
               (js-call assert :strictEqual (value-type function) "function" name)
               (uint32 (Reflect/apply function exports arguments)))))
           (checked (lambda (name &rest arguments)
             (let ((result (Reflect/apply raw undefined (js-call (js-array name) :concat arguments))))
               (js-call assert :strictEqual (funcall raw "last-error") 0 name) result)))
           (heap (funcall checked "heap-new" (get budget :maxSlots) (get budget :initialBytes) (get budget :maxBytes)))
           (literal (get descriptor :literalRuntime)) (probe (get literal :brandProbe))
           (binding (get (get literal :bindings) "literal-kind")) (original (get probe :original))
           (role-probe (get literal :roleProbe))
           (role-binding (get (get literal :bindings) "literal-protocol-for-role"))
           (role-original (get role-probe :original))
           (registries (js-call (get probe :registries) :concat
             (js-call (get role-probe :registries) :filter (lambda (entry)
               (not (js-call (get probe :registries) :some
                 (lambda (other) (= (get entry :index) (get other :index)))))))))
           (getter (get (get descriptor :module) :get))
           (prepare (get (get descriptor :project) :prepare))
           (view (lambda () (new globalThis.DataView (get (get exports :memory) :buffer))))
           (roots (js-array)) (saved-cells (js-array)) (slab undefined)
           (role-callee undefined) (role-arguments undefined) (failed false))
      (try
        (progn
          (js-call assert :strictEqual (get probe :version) 1)
          (js-call assert :strictEqual (js-length (get probe :registries)) 3)
          (js-call assert :strictEqual (get role-probe :version) 1)
          (js-call assert :strictEqual (js-length (get role-probe :registries)) 4)
          (js-call assert :deepStrictEqual (js-call (get role-probe :registries) :slice 0 3) (get probe :registries))
          (js-call assert :strictEqual (js-length registries) 4)
          (js-call assert :strictEqual (get binding :kind) 1)
          (js-call assert :notDeepStrictEqual binding original)
          (js-call assert :strictEqual (get role-binding :kind) 1)
          (js-call assert :notDeepStrictEqual role-binding role-original)
          ;; This is the same exported prepare used by the actual project
          ;; loader. Preserve whatever initialization it actually performs;
          ;; the raw scenarios below deliberately stage their own cell flags.
          (funcall checked prepare heap)
          (setq role-callee (funcall checked getter heap (get role-binding :kind) (get role-binding :index)))
          (funcall checked "heap-pin" heap role-callee) (js-call roots :push role-callee)
          (let* ((role "data-text.IPrint") (text (funcall checked "value-string" heap (js-length role))) (index 0))
            (funcall checked "heap-pin" heap text) (js-call roots :push text)
            (while (< index (js-length role))
              (funcall checked "value-unit-set" heap text index (js-call role :charCodeAt index))
              (setq index (1+ index)))
            (funcall checked "value-seal" heap text)
            (setq role-arguments (funcall checked "value-refs" heap 7 1))
            (funcall checked "heap-pin" heap role-arguments) (js-call roots :push role-arguments)
            (funcall checked "value-set" heap role-arguments 0 text))
          (let ((callee (funcall checked getter heap (get binding :kind) (get binding :index))))
            (funcall checked "heap-pin" heap callee) (js-call roots :push callee)
            (let ((value (funcall checked "value-object-new" heap 0)))
              (funcall checked "heap-pin" heap value) (js-call roots :push value)
              (let ((arguments (funcall checked "value-refs" heap 7 1)))
                (funcall checked "heap-pin" heap arguments) (js-call roots :push arguments)
                (funcall checked "value-set" heap arguments 0 value)
                ;; heap.data -> control.pool -> pool.data is the actual raw
                ;; layout. The slot-zero metadata owns the kind-8 seven-ref
                ;; binding slab. Validate it before touching its three cells.
                (let* ((control (js-call (funcall view) :getUint32 (+ heap 16) t))
                       (pool (js-call (funcall view) :getUint32 (+ control 4) t))
                       (base (js-call (funcall view) :getUint32 (+ pool 16) t))
                       (binding-slab (js-call (funcall view) :getUint32 (+ base 16) t))
                       (count (get (get descriptor :module) :bindingCount))
                       (cells (funcall checked "value-data" heap binding-slab 8)))
                  (setq slab binding-slab)
                  (js-call assert :strictEqual (funcall checked "value-kind" heap slab) 8)
                  (js-call assert :strictEqual (funcall checked "value-length" heap slab) (* count 7))
                  (js-call assert :ok (<= (+ cells (* count 28)) (get (funcall view) :byteLength)))
                  (js-call registries :forEach (lambda (entry)
                    (js-call assert :strictEqual (get entry :kind) 0)
                    (js-call assert :ok (< (get entry :index) count))
                    (let ((cell (+ cells (* (get entry :index) 28))))
                      (js-call assert :strictEqual (js-call (funcall view) :getUint32 cell t) 2)
                      (js-call saved-cells :push (js-object :index (get entry :index)
                        :bytes (globalThis.Uint8Array.from
                          (new globalThis.Uint8Array (get (get exports :memory) :buffer) cell 28))))
                      ;; The saved bytes are host data, not managed GC roots.
                      ;; Pin every real reference before removing it from its
                      ;; cell, preserving duplicate roots with balanced pins.
                      (let ((word 0))
                        (while (< word 7)
                          (let ((value (js-call (funcall view) :getUint32 (+ cell (* word 4)) t)))
                            (when (> value 3)
                              (funcall checked "heap-pin" heap value) (js-call roots :push value)))
                          (setq word (1+ word)))))))
                  (js-call saved-cells :forEach (lambda (entry)
                    (js-call (new globalThis.Uint8Array (get (get exports :memory) :buffer)
                              (+ cells (* (get entry :index) 28)) 28) :fill 0)))
                  ;; Undeclared is a real TDZ state; automatic admission must
                  ;; return no brand without a Get or a changed last-error.
                  (js-call assert :strictEqual (funcall checked "value-source-invoke-with-this" heap callee 3 arguments 1) 0)
                  (js-call assert :strictEqual (funcall checked "value-source-invoke-with-this" heap role-callee 3 role-arguments 1) 3)
                  (funcall raw getter heap 0 (get (aref registries 0) :index))
                  (js-call assert :strictEqual (funcall raw "last-error") 8)
                  (funcall raw "value-error-restore" 0)
                  ;; Construct value-module-declare's exact seven-reference
                  ;; state: declared=true, actual mutability, initialized=false,
                  ;; external=false, undefined value/export and nil module.
                  (js-call saved-cells :forEach (lambda (entry)
                    (let ((cell (+ cells (* (get entry :index) 28))))
                      (let ((saved (new globalThis.DataView (get (get entry :bytes) :buffer))))
                        (js-call (funcall view) :setUint32 cell 2 t)
                        (js-call (funcall view) :setUint32 (+ cell 4) (js-call saved :getUint32 4 t) t)
                        (js-call (funcall view) :setUint32 (+ cell 8) 1 t)
                        (js-call (funcall view) :setUint32 (+ cell 12) 1 t)
                        (js-call (funcall view) :setUint32 (+ cell 16) 3 t)
                        (js-call (funcall view) :setUint32 (+ cell 20) 0 t)
                        (js-call (funcall view) :setUint32 (+ cell 24) 3 t))))))
                ;; Declaration is still not initialization, so public Get keeps
                ;; the original exact TDZ and the safe probe still reports none.
                (funcall raw getter heap 0 (get (aref registries 0) :index))
                (js-call assert :strictEqual (funcall raw "last-error") 8)
                (funcall raw "value-error-restore" 0)
                (js-call assert :strictEqual (funcall checked "value-source-invoke-with-this" heap callee 3 arguments 1) 0)
                (js-call assert :strictEqual (funcall checked "value-source-invoke-with-this" heap role-callee 3 role-arguments 1) 3)
                (let ((source-helper (funcall raw getter heap (get original :kind) (get original :index))))
                  (when (= (funcall raw "last-error") 0)
                    (funcall checked "heap-pin" heap source-helper) (js-call roots :push source-helper)
                    (funcall raw "value-source-invoke-with-this" heap source-helper 3 arguments 1))
                  (js-call assert :strictEqual (funcall raw "last-error") 8))
                (funcall raw "value-error-restore" 0)
                (let ((source-role (funcall raw getter heap (get role-original :kind) (get role-original :index))))
                  (when (= (funcall raw "last-error") 0)
                    (funcall checked "heap-pin" heap source-role) (js-call roots :push source-role)
                    (funcall raw "value-source-invoke-with-this" heap source-role 3 role-arguments 1))
                  (js-call assert :strictEqual (funcall raw "last-error") 8))
                (funcall raw "value-error-restore" 0)
                (js-call assert :strictEqual (funcall checked "value-source-invoke-with-this" heap callee 3 arguments 1) 0)
                (js-call assert :strictEqual (funcall checked "value-source-invoke-with-this" heap role-callee 3 role-arguments 1) 3)))))
        (catch error (setq failed t) (throw error))
        (finally
          (let ((cleanup undefined) (cleanup-failed false))
            (js-call (js-array
              (lambda ()
                (when slab
                  (let ((cells (funcall checked "value-data" heap slab 8)))
                    (js-call saved-cells :forEach (lambda (entry)
                      (js-call (new globalThis.Uint8Array (get (get exports :memory) :buffer)
                                (+ cells (* (get entry :index) 28)) 28) :set (get entry :bytes)))))))
              (lambda ()
                (when slab
                  (let ((cells (funcall checked "value-data" heap slab 8)))
                    (js-call saved-cells :forEach (lambda (entry)
                      (js-call assert :deepStrictEqual
                        (globalThis.Uint8Array.from (new globalThis.Uint8Array (get (get exports :memory) :buffer)
                          (+ cells (* (get entry :index) 28)) 28)) (get entry :bytes)))))))
              (lambda () (js-call roots :forEach (lambda (value) (funcall raw "heap-release" heap value))))
              (lambda () (funcall raw (get (get descriptor :module) :close) heap))
              (lambda () (funcall raw "heap-collect" heap))
              (lambda ()
                (unless failed
                  (js-call assert :strictEqual (funcall raw "last-error") 0)
                  (js-call assert :strictEqual (funcall raw "heap-live" heap) 0)
                  (js-call assert :strictEqual (funcall raw "frame-depth" heap) 0))))
              :forEach (lambda (action)
                (try (funcall action) (catch error (unless cleanup-failed (setq cleanup-failed t cleanup error))))))
            (when (and cleanup-failed (not failed)) (throw cleanup)))))))
  (test "owned map and ordinary methods stay import free while the complete original async fixture retains its exact host ABI"
    (async ()
