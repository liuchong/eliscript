(module tests.wasm-managed-control
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile)
  (import "node:path" resolve)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/managed-host.mjs" createManagedHostRuntime)
  (import "./helpers/managed-numeric-selfhosted.mjs" makeFixture closeFixture box read loadReference)
  (defvar fixture undefined) (defvar backend undefined) (defvar runtimeProgram undefined)
  (defvar program undefined) (defvar bytes undefined) (defvar js undefined) (defvar directory undefined)
  (defvar reference-index 0)
  (beforeAll (async ()
    (setq fixture (await (makeFixture "control" (js-object :maximumPages 128))))
    (setq backend (get fixture :backend) runtimeProgram (get fixture :runtimeProgram)
      program (get fixture :program) bytes (get fixture :bytes) js (get fixture :js)
      directory (get fixture :directory))) 120000)
  (afterAll (async () (await (closeFixture fixture))))

  (defasync reference-module (ir)
    (setq reference-index (1+ reference-index))
    (let ((path (resolve directory (+ "control-reference-" reference-index ".mjs"))))
      (await (loadReference path (js-call (get backend :compiler) :emit_ir_string ir)))))
  (defun compile-control (text filename)
    (js-call (get backend :compiler) :compile_ir_string text filename))
  (defun emit-control (ir runtime &optional options)
    (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm ir runtime options)))
  (defun invoke-reference (reference name values)
    (Reflect/apply (get reference (js-call name :replaceAll "-" "_")) undefined values))
  (defun error-code (error code)
    (and (not (nullish? error)) (not (nullish? (get error :eliscriptDiagnostic)))
         (= (get (get error :eliscriptDiagnostic) :code) code)))

  ;; These mocks isolate bulk ABI cleanup. Real WASM GC, capacity and trap
  ;; acceptance remains below and never substitutes a host-thrown exception.
  (defun cleanup-fault-runtime (options)
    (let* ((uniform (get options :uniform false)) (primary (get options :primary))
           (throws (get options :throws t)) (release-failure (get options :releaseFailure t))
           (pin-failure (get options :pinFailure false)) (result (get options :result 2))
           (released (js-array)) (unwound (js-array)) (cleared (js-array))
           (secondary (new globalThis.Error "cleanup fault")) (next 4)
           (exports (js-object
             :heap-new (lambda () 1) :last-error (lambda () 0) :value-kind (lambda () 4)
             :value-number (lambda () (setq next (1+ next)) next)
             :frame-current (lambda () 7)
             :heap-pin (lambda (heap value) (when (and pin-failure (= value 8)) (throw secondary)) value)
             :heap-release (lambda (heap value) (js-call released :push value) (when release-failure (throw secondary)) 1)
             :frame-unwind (lambda (heap target) (js-call unwound :push target) (throw secondary))
             :value-exception-clear (lambda () (js-call cleared :push t) (throw secondary))
             :value-call-reset (lambda () (throw secondary))
             :value-refs (lambda () 8) :value-data (lambda () 0)
             :entry (if uniform
               (lambda (heap callee argv count) (when throws (throw primary)) result)
               (lambda (heap left right) (when throws (throw primary)) result))))
           (descriptor (js-object :format "eliscript-managed-control" :version 1 :abi "managed-control-v1"
             :functions (js-array (if uniform
               (js-object :name "entry" :arity nil :callingConvention "argument-list" :parameterKinds (js-array "required" "optional"))
               (js-object :name "entry" :arity 2)))))
           (buffer (new globalThis.ArrayBuffer 16))
           (api (createManagedHostRuntime exports descriptor (js-object :view (lambda () (new globalThis.DataView buffer))))))
      (js-object :api api :released released :unwound unwound :cleared cleared :secondary secondary)))

  (test "bulk entry cleanup preserves every original thrown value and attempts all owned root releases"
    (lambda ()
      (let* ((uniforms (js-array false t)) (uniform-index 0))
        (while (< uniform-index (js-length uniforms))
          (let ((uniform (aref uniforms uniform-index)))
            (setq uniform-index (1+ uniform-index))
        (let* ((primaries (js-array undefined nil false -0 globalThis.NaN (globalThis.Symbol "source")
                          (Object/freeze (new globalThis.Error "source")))) (primary-index 0))
          (while (< primary-index (js-length primaries))
            (let ((primary (aref primaries primary-index)))
              (setq primary-index (1+ primary-index))
          (let* ((fault (cleanup-fault-runtime (js-object :uniform uniform :primary primary))) (api (get fault :api))
                 (args (js-array (js-call api :number 1) (js-call api :number 2))) (caught false))
            (try (js-call api :invoke "entry" args)
              (catch error (setq caught t) (assert (Object/is error primary))))
            (assert caught)
            (js-call assert :deepStrictEqual (get fault :released) (if uniform (js-array 8 5 6) (js-array 5 6)))
            (assert (>= (js-length (get fault :unwound)) 1))
            (assert (js-call (get fault :unwound) :every (lambda (target) (= target 7))))
            (js-call assert :strictEqual (js-length (get fault :cleared)) 1))))))))))

  (test "bulk entry cleanup failures remain visible after success and unowned allocations are never released"
    (lambda ()
      (let* ((uniforms (js-array false t)) (uniform-index 0))
        (while (< uniform-index (js-length uniforms))
          (let ((uniform (aref uniforms uniform-index)))
            (setq uniform-index (1+ uniform-index))
        (let* ((fault (cleanup-fault-runtime (js-object :uniform uniform :throws false))) (api (get fault :api)))
          (js-call assert :throws (lambda () (js-call api :invoke "entry"
            (js-array (js-call api :number 1) (js-call api :number 2))))
            (lambda (error) (eq error (get fault :secondary))))
          (js-call assert :deepStrictEqual (get fault :released) (if uniform (js-array 8 5 6) (js-array 5 6)))))))
      (let* ((fault (cleanup-fault-runtime (js-object :uniform t :pinFailure t :releaseFailure false))) (api (get fault :api)))
        (js-call assert :throws (lambda () (js-call api :invoke "entry"
          (js-array (js-call api :number 1) (js-call api :number 2)))) (lambda (error) (eq error (get fault :secondary))))
        (js-call assert :deepStrictEqual (get fault :released) (js-array 5 6)))
      (let* ((uniforms (js-array false t)) (uniform-index 0))
        (while (< uniform-index (js-length uniforms))
          (let ((uniform (aref uniforms uniform-index)))
            (setq uniform-index (1+ uniform-index))
        (let* ((fault (cleanup-fault-runtime (js-object :uniform uniform :throws false :result 5))) (api (get fault :api)))
          (js-call assert :throws (lambda () (js-call api :invoke "entry"
            (js-array (js-call api :number 1) (js-call api :number 2)))) (lambda (error) (eq error (get fault :secondary))))
          (js-call assert :deepStrictEqual (get fault :released)
            (if uniform (js-array 8 5 6 5) (js-array 5 6 5)) "a result rejected by cleanup never transfers its extra root")))))))

  (test "ordinary control source executes in managed WASM with Lisp truth and exact primitive results"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes))
            (values (js-array nil false t undefined 0 -0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                      globalThis.Number.MIN_VALUE "" "中😀\ud800")))
        (let* ((value-items values) (value-index 0))
          (while (< value-index (js-length value-items))
            (let ((value (aref value-items value-index)))
              (setq value-index (1+ value-index))
          (let ((handle (box a value)))
            (let* ((names (js-array "truth" "invert" "once" "optional-result" "unless-result" "recurse")) (name-index 0))
              (while (< name-index (js-length names))
                (let ((name (aref names name-index)))
                  (setq name-index (1+ name-index))
              (let ((result (js-call a :invoke name (js-array handle))))
                (js-call assert :deepStrictEqual (read a result) (invoke-reference js name (js-array value)) name)
                (js-call a :release result)))))
            (let ((result (js-call a :invoke "identity" (js-array handle))))
              (assert (js-call a :keyEqual result handle)) (js-call a :release result))
            (js-call a :release handle) (js-call a :collect)
            (js-call assert :strictEqual (js-call a :live) 0)
            (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0)))))
        (let* ((names (js-array "unicode" "negative-zero" "finite-number" "undefined-result" "empty-and" "empty-or")) (name-index 0))
          (while (< name-index (js-length names))
            (let ((name (aref names name-index)))
              (setq name-index (1+ name-index))
          (let ((result (js-call a :invoke name (js-array))))
            (assert (Object/is (read a result) (invoke-reference js name (js-array))))
            (js-call a :release result) (js-call a :collect) (js-call assert :strictEqual (js-call a :live) 0))))))))

  (test "managed lowering preserves short-circuit values, shadowing, assignment effects and direct call order"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)) (values (js-array nil false t undefined 0 -0 globalThis.NaN "" "x")))
        (let* ((left-items values) (left-index 0))
          (while (< left-index (js-length left-items))
            (let ((left (aref left-items left-index)))
              (setq left-index (1+ left-index))
          (let* ((right-items values) (right-index 0))
            (while (< right-index (js-length right-items))
              (let ((right (aref right-items right-index)))
                (setq right-index (1+ right-index))
          (let ((x (box a left)) (y (box a right)))
            (let* ((names (js-array "both" "either" "parallel" "sequential" "effects" "clauses" "call-choose")) (name-index 0))
              (while (< name-index (js-length names))
                (let ((name (aref names name-index)))
                  (setq name-index (1+ name-index))
              (let ((result (js-call a :invoke name (js-array x y))))
                (js-call assert :deepStrictEqual (read a result) (invoke-reference js name (js-array left right)) name)
                (js-call a :release result)))))
            (js-call a :release x) (js-call a :release y) (js-call a :collect)
            (js-call assert :strictEqual (js-call a :live) 0)
            (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0)))))))))))

  (test "managed calls snapshot earlier argument values before later assignment and allocation effects"
    (async ()
      (let* ((text "(defun first (a b) a) (defun order (x y) (first x (setq x y))) (defun assignment-order (x y) (first (setq x y) (setq x nil))) (defun throw-input (x) (throw x)) (defun catch-input (x) (try (throw-input x) (catch error error))) (defun call-this () (js* \"this\")) (defun direct-this () (call-this)) (export order assignment-order catch-input direct-this)")
             (ir (compile-control text "order.eli")) (artifact (emit-control ir runtimeProgram))
             (reference (await (reference-module ir))) (a (instantiateManagedRuntime artifact)))
        (js-call a :auto 1)
        (let ((x (js-call a :number -0)) (y (js-call a :string "new")))
          (let* ((names (js-array "order" "assignment-order")) (name-index 0))
            (while (< name-index (js-length names))
              (let ((name (aref names name-index)))
                (setq name-index (1+ name-index))
            (let ((result (js-call a :invoke name (js-array x y))))
              (js-call assert :deepStrictEqual (read a result) (invoke-reference reference name (js-array -0 "new")))
              (js-call a :release result)))))
          (let ((caught (js-call a :invoke "catch-input" (js-array y))))
            (assert (js-call a :keyEqual caught y)) (js-call a :release caught))
          (js-call assert :strictEqual (js-call a :invoke "direct-this" (js-array)) (js-call reference :direct_this))
          (js-call a :release x) (js-call a :release y) (js-call a :collect)
          (js-call assert :strictEqual (js-call a :live) 0)))))

  (test "two-arm if preserves omitted nil branches evaluation order identity throws and caller roots under GC"
    (async ()
      (let* ((text "(defun omitted (condition value) (if condition value))\n (defun explicit (condition value) (if condition value nil))\n (defun nested (outer inner value) (if outer (if inner value)))\n (defun once-if (condition) (let ((hits 0)) (js-array (if (progn (setq hits (1+ hits)) condition) (progn (setq hits (+ hits 10)) hits)) hits)))\n (defun assign-if (condition value) (let ((current value)) (if condition (setq current -0.0)) current))\n (defun throw-if (condition value) (if condition (throw value)))\n (export omitted explicit nested once-if assign-if throw-if)")
             (ir (compile-control text "two-arm-if.eli")) (before (JSON/stringify ir))
             (pending (js-call (get ir :body) :slice)) (two-arm 0))
        (while (> (js-length pending) 0)
          (let ((node (js-call pending :pop)))
            (when (and (= (get node :kind) "conditional") (= (js-length (get node :children)) 2)) (setq two-arm (1+ two-arm)))
            (Reflect/apply (get pending :push) pending (get node :children))))
        (assert (>= two-arm 6) "the original IR must contain omitted children rather than a fixture-synthesized else")
        (let* ((artifact (emit-control ir runtimeProgram)) (reference (await (reference-module ir)))
               (a (instantiateManagedRuntime artifact (js-object :maxSlots 256 :initialBytes 16384 :maxBytes 1048576))))
          (js-call assert :strictEqual (JSON/stringify ir) before)
          (assert (globalThis.WebAssembly.validate artifact))
          (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module artifact)) (js-array))
          (js-call a :auto 1)
          (let* ((value (js-call a :string "same\ud800😀")) (caller (js-call a :frame 1)))
            (js-call a :frameSet caller 0 value)
            (try
              (let* ((conditions (js-array nil false undefined t 0 -0 globalThis.NaN "")) (condition-index 0))
                (while (< condition-index (js-length conditions))
                  (let ((condition (aref conditions condition-index)))
                    (setq condition-index (1+ condition-index))
                (let ((input (box a condition)) (depth (get (js-call a :stats) :frameDepth)))
                  (try
                    (progn
                      (let* ((names (js-array "omitted" "explicit")) (name-index 0))
                        (while (< name-index (js-length names))
                          (let ((name (aref names name-index)))
                            (setq name-index (1+ name-index))
                        (let ((result (js-call a :invoke name (js-array input value))))
                          (try
                            (progn
                              (js-call assert :deepStrictEqual (read a result) (invoke-reference reference name (js-array condition "same\ud800😀")) name)
                              (unless (eq result nil) (assert (js-call a :keyEqual result value))))
                            (finally (js-call a :release result)))))))
                      (let ((once (js-call a :invoke "once-if" (js-array input))))
                        (try
                          (let ((actual (js-array)) (index 0))
                            (while (< index (js-call a :length once))
                              (let ((item (js-call a :get once index)))
                                (try (js-call actual :push (read a item)) (finally (js-call a :release item))))
                              (setq index (1+ index)))
                            (js-call assert :deepStrictEqual actual (js-call reference :once_if condition)))
                          (finally (js-call a :release once))))
                      (let ((assigned (js-call a :invoke "assign-if" (js-array input value))))
                        (try (assert (Object/is (read a assigned) (js-call reference :assign_if condition "same\ud800😀")))
                          (finally (js-call a :release assigned))))
                      (let* ((inners (js-array false t)) (inner-index 0))
                        (while (< inner-index (js-length inners))
                          (let ((inner (aref inners inner-index)))
                            (setq inner-index (1+ inner-index))
                        (let ((result (js-call a :invoke "nested" (js-array input inner value))))
                          (try (js-call assert :deepStrictEqual (read a result) (js-call reference :nested condition inner "same\ud800😀"))
                            (finally (js-call a :release result)))))))
                      (let ((threw false) (expected undefined))
                        (try (js-call reference :throw_if condition "same\ud800😀")
                          (catch error (setq threw t expected error)))
                        (if threw
                          (js-call assert :throws (lambda () (js-call a :invoke "throw-if" (js-array input value)))
                            (lambda (error) (js-call assert :strictEqual (js-call a :readString error) expected)
                              (assert (js-call a :keyEqual error value)) (js-call a :release error) t))
                          (js-call assert :strictEqual (js-call a :invoke "throw-if" (js-array input value)) nil)))
                      (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) depth) (js-call a :collect)
                      (let ((kept (js-call a :frameGet caller 0)))
                        (try (assert (js-call a :keyEqual kept value)) (finally (js-call a :release kept)))))
                    (finally (js-call a :release input)))))))
              (finally
                (js-call a :leaveFrame caller) (js-call a :release value) (js-call a :closeModule) (js-call a :collect)
                (js-call assert :strictEqual (js-call a :live) 0)
                (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))))))) 30000)

  (test "managed root names remain hygienic and randomized control programs match independent JS under GC"
    (async ()
      (let ((state 6125473))
        ;; Keep the original xorshift seed and all 32 depth-three programs.
        (letfn ((next ()
                  (setq state (bit-xor state (bit-shift-left state 13)))
                  (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                  (setq state (bit-xor state (bit-shift-left state 5))) (uint32 state))
                (expression (depth)
                  (if (= depth 0) (aref (js-array "a" "b" "nil" "false" "t" "0" "-0.0" "\"中😀\\ud800\"") (% (next) 8))
                    (let ((choice (% (next) 7)))
                      (cond
                        ((= choice 0) (+ "(if " (expression (1- depth)) " " (expression (1- depth)) " " (expression (1- depth)) ")"))
                        ((= choice 1) (+ "(and " (expression (1- depth)) " " (expression (1- depth)) ")"))
                        ((= choice 2) (+ "(or " (expression (1- depth)) " " (expression (1- depth)) ")"))
                        ((= choice 3) (+ "(let ((a b) (b a)) " (expression (1- depth)) ")"))
                        ((= choice 4) (+ "(let* ((a b) (b a)) " (expression (1- depth)) ")"))
                        ((= choice 5) (+ "(first " (expression (1- depth)) " (setq a " (expression (1- depth)) "))"))
                        (t (+ "(progn (setq b " (expression (1- depth)) ") " (expression (1- depth)) ")")))))))
          (let ((names (js-array)) (definitions (js-array)) (index 0))
            (while (< index 32)
              (let ((name (+ "random-" index)))
                (js-call names :push name) (js-call definitions :push (+ "(defun " name " (a b) " (expression 3) ")")))
              (setq index (1+ index)))
            (let* ((text (+ "(defun first (a b) a) (defun internals (heap error frame temporary result) (let ((result error)) frame)) "
                     (js-call definitions :join "\n") " (export internals " (js-call names :join " ") ")"))
                   (ir (compile-control text "random-control.eli")) (artifact (emit-control ir runtimeProgram))
                   (reference (await (reference-module ir)))
                   (a (instantiateManagedRuntime artifact (js-object :maxSlots 256 :initialBytes 16384 :maxBytes 1048576)))
                   (values (js-array nil false t undefined 0 -0 globalThis.NaN "" "中😀\ud800")))
              (js-call a :auto 1)
              (let ((handles (js-call values :map (lambda (value) (box a value)))))
                (let ((hygienic (js-call a :invoke "internals" (js-call handles :slice 0 5))))
                  (js-call assert :strictEqual hygienic t) (js-call a :release hygienic))
                (let* ((name-items names) (name-index 0))
                  (while (< name-index (js-length name-items))
                    (let ((name (aref name-items name-index)))
                      (setq name-index (1+ name-index))
                  (let ((left 0))
                    (while (< left (js-length values))
                      (let ((right 0))
                        (while (< right (js-length values))
                          (let ((result (js-call a :invoke name (js-array (aref handles left) (aref handles right)))))
                            (js-call assert :deepStrictEqual (read a result)
                              (invoke-reference reference name (js-array (aref values left) (aref values right)))
                              (+ name "/" left "/" right))
                            (js-call a :release result) (js-call a :collect)
                            (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))
                          (setq right (1+ right))))
                      (setq left (1+ left)))))))
                (let* ((value-items handles) (value-index 0))
                  (while (< value-index (js-length value-items))
                    (let ((value (aref value-items value-index)))
                      (setq value-index (1+ value-index))
                      (js-call a :release value))))
                (js-call a :collect)
                (js-call assert :strictEqual (js-call a :live) 0))))))))

  (test "automatically rooted arguments and temporaries survive first-frame allocation, repeated GC and opaque identity"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 65536))))
        (js-call a :auto 1)
        (let ((object (js-call a :map)) (set (js-call a :setTable)) (text (js-call a :string "😀\ud800")) (index 0))
          (js-call a :tableSet object text set) (js-call a :tableAdd set object)
          (while (< index 1000)
            (let ((result (js-call a :invoke "call-choose" (js-array object text))))
              (assert (js-call a :keyEqual result text)) (js-call a :release result)
              (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))
            (setq index (1+ index)))
          (assert (> (get (js-call a :stats) :collections) 1000))
          (let* ((value-items (js-array object set text)) (value-index 0))
            (while (< value-index (js-length value-items))
              (let ((value (aref value-items value-index)))
                (setq value-index (1+ value-index))
                (js-call a :release value))))
          (js-call a :collect) (js-call assert :strictEqual (js-call a :live) 0)))))

  (test "managed entry failure restores caller frames, argument roots and the original capacity error"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes (js-object :maxSlots 8 :initialBytes 512 :maxBytes 512))))
        (js-call a :auto 1)
        (let* ((input (js-call a :number -0)) (frame (js-call a :frame 1)))
          (js-call a :frameSet frame 0 input)
          (let ((padding (js-array (js-call a :array) (js-call a :array))) (before (get (js-call a :stats) :frameDepth)))
            (js-call assert :throws (lambda () (js-call a :invoke "call-choose" (js-array input input)))
              (lambda (error) (error-code error "ELI-RT0002")))
            (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) before)
            (let ((alias (js-call a :frameGet frame 0)))
              (assert (Object/is (js-call a :readNumber alias) -0)) (js-call a :release alias))
            (js-call a :leaveFrame frame)
            (let* ((value-items padding) (value-index 0))
              (while (< value-index (js-length value-items))
                (let ((value (aref value-items value-index)))
                  (setq value-index (1+ value-index))
                  (js-call a :release value))))
            (js-call a :release input) (js-call a :collect) (js-call assert :strictEqual (js-call a :live) 0))))))

  (test "managed descriptor limits entry access and rejects wrong arity, foreign handles and numeric coercion"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes)) (b (instantiateManagedRuntime bytes)) (value (js-call b :string "x")))
        (js-call assert :throws (lambda () (js-call a :invoke "heap-new" (js-array))) (lambda (error) (error-code error "ELI-RT0003")))
        (js-call assert :throws (lambda () (js-call a :invoke "identity" (js-array))) (lambda (error) (error-code error "ELI-RT0003")))
        (js-call assert :throws (lambda () (js-call a :invoke "identity" (js-array 0))) (lambda (error) (error-code error "ELI-RT0003")))
        (js-call assert :throws (lambda () (js-call a :invoke "identity" (js-array value))) (lambda (error) (error-code error "ELI-RT0001")))
        (js-call b :release value) (js-call b :collect) (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))))

  (test "the checked entry roots earlier arguments across later getters and restores those roots if a getter throws"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let* ((input (js-call a :string "borrowed😀")) (args (js-array input)))
          (Object/defineProperty args 1 (js-object :get (lambda () (js-call a :release input) (js-call a :collect) false)))
          (let ((result (js-call a :invoke "either" args)))
            (js-call assert :strictEqual (js-call a :readString result) "borrowed😀")
            (js-call a :release result) (js-call a :collect) (js-call assert :strictEqual (js-call a :live) 0)))
        (let* ((next (js-call a :string "failure")) (bad (js-array next)))
          (Object/defineProperty bad 1 (js-object :get (lambda () (throw (new globalThis.Error "getter failed")))))
          (js-call assert :throws (lambda () (js-call a :invoke "either" bad))
            (lambda (error) (= (get error :message) "getter failed")))
          (js-call a :release next) (js-call a :collect) (js-call assert :strictEqual (js-call a :live) 0)
          (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0)))))

  (test "a true WASM runtime trap restores the caller frame and does not leak transient argument roots"
    (async ()
      (let* ((original (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
             (start (js-call original :indexOf "  (defun value-truth (heap value)"))
             (end (js-call original :indexOf "  (defun " (+ start 3))))
        (assert (and (>= start 0) (> end start)))
        (let* ((runtime-source (+ (js-call original :slice 0 start)
                   "  (defun value-truth (heap value) (load-u32 4294967295))\n" (js-call original :slice end)))
               (injected (compile-control runtime-source "trap-runtime.eli"))
               (ir (compile-control "(defun crash (x) (if x x nil)) (export crash)" "trap.eli"))
               (artifact (emit-control ir injected (js-object :maximumPages 128)))
               (a (instantiateManagedRuntime artifact)) (input (js-call a :number -0)) (frame (js-call a :frame 1)))
          (js-call a :frameSet frame 0 input)
          (js-call assert :throws (lambda () (js-call a :invoke "crash" (js-array input)))
            (lambda (error) (Reflect/apply
              (get (get globalThis.Function :prototype) (get globalThis.Symbol :hasInstance))
              globalThis.WebAssembly.RuntimeError (js-array error))))
          (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
          (let ((alias (js-call a :frameGet frame 0)))
            (assert (Object/is (js-call a :readNumber alias) -0)) (js-call a :release alias))
          (js-call a :leaveFrame frame) (js-call a :release input) (js-call a :collect)
          (js-call assert :strictEqual (js-call a :live) 0)))))

  (test "managed async functions suspend once, preserve thrown values and recover after rejection"
    (async ()
      (let* ((text "(defasync settle (x) (+ (await x) 1)) (defasync reject-value (x) (throw (await x))) (defasync recover (x) (try (throw (await x)) (catch error error))) (defun choose (x) (if false (async () x) x)) (defasync hygiene (eliscript-async-0) (await eliscript-async-0)) (export settle reject-value recover choose hygiene)")
             (ir (compile-control text "async-control.eli")) (before (JSON/stringify ir))
             (artifact (emit-control ir runtimeProgram)) (reference (await (reference-module ir)))
             (a (instantiateManagedRuntime artifact)))
        (js-call assert :strictEqual (JSON/stringify ir) before)
        (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module artifact)) (js-array))
        (js-call a :auto 1)
        (let ((input (js-call a :number 4)) (message (js-call a :string "rejected")))
          (try
            (progn
              (let ((result (await (js-call a :invokeAsync "settle" (js-array input)))))
                (js-call assert :strictEqual (read a result) (await (js-call reference :settle 4))) (js-call a :release result))
              (await (js-call assert :rejects (lambda () (js-call a :invokeAsync "reject-value" (js-array message)))
                (lambda (error) (assert (js-call a :keyEqual error message)) (js-call a :release error) t)))
              (let ((recovered (await (js-call a :invokeAsync "recover" (js-array message)))))
                (js-call assert :strictEqual (read a recovered) (await (js-call reference :recover "rejected"))) (js-call a :release recovered))
              (let ((hygienic (await (js-call a :invokeAsync "hygiene" (js-array input)))))
                (js-call assert :strictEqual (read a hygienic) (await (js-call reference :hygiene 4))) (js-call a :release hygienic))
              (let ((chosen (js-call a :invoke "choose" (js-array input))))
                (js-call assert :strictEqual (read a chosen) (js-call reference :choose 4)) (js-call a :release chosen)))
            (finally
              (js-call a :release input) (js-call a :release message) (js-call a :closeModule) (js-call a :collect)
              (js-call assert :strictEqual (js-call a :live) 0)
              (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0)))))))

  (test "managed lowering refuses every unsupported node including unreachable code and preserves source locations and IR"
    (async ()
      (let ((before (JSON/stringify program)) (runtime-before (JSON/stringify runtimeProgram)))
        (emit-control program runtimeProgram)
        (js-call assert :strictEqual (JSON/stringify program) before)
        (js-call assert :strictEqual (JSON/stringify runtimeProgram) runtime-before))
      ;; Preserve the former string-to-bigint input as a positive execution,
      ;; rather than dropping it from this original unsupported-node case.
      (let* ((text "(defun f (x) (string-to-bigint x)) (export f)")
             (ir (compile-control text "unsupported.eli")) (before (JSON/stringify ir))
             (reference (await (reference-module ir))) (a (instantiateManagedRuntime (emit-control ir runtimeProgram))))
        (js-call a :auto 1)
        (let* ((texts (js-array "42" "9007199254740993123456789" "invalid")) (text-index 0))
          (while (< text-index (js-length texts))
            (let ((text (aref texts text-index)))
              (setq text-index (1+ text-index))
          (let* ((input (js-call a :string text)) (result (js-call a :invoke "f" (js-array input))))
            (try (js-call assert :strictEqual (if (eq result nil) nil (js-call a :readBigInt result)) (js-call reference :f text))
              (finally (js-call a :release result) (js-call a :release input))))
          (js-call a :collect))))
        (js-call a :closeModule) (js-call a :collect)
        (js-call assert :strictEqual (js-call a :live) 0)
        (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0)
        (js-call assert :strictEqual (JSON/stringify ir) before))
      (let* ((texts (js-array "(defun f () [1 2]) (export f)" "(import \"host\" f) (export f)"
                   "(defun f () (js* \"1\")) (export f)" "(defun memory () 1) (export memory)"
                   "(defun heap-new () 1) (export heap-new)")) (text-index 0))
        (while (< text-index (js-length texts))
          (let ((text (aref texts text-index)))
            (setq text-index (1+ text-index))
        (let ((ir (compile-control text "unsupported.eli")))
          (js-call assert :throws (lambda () (emit-control ir runtimeProgram))
            (lambda (error) (and (error-code error "ELI-B0001")
              (= (get (get error :eliscriptDiagnostic) :phase) "managed-backend")
              (= (get (get (get error :eliscriptDiagnostic) :location) :file) "unsupported.eli"))) text)))))))

  (test "implemented required and optional parameter patterns execute the former rejection inputs and preserve captured values under GC"
    (async ()
      (let* ((pairs (js-array
          (js-array "(defun f ([x]) x) (export f)" "(defun run () (f (js-array -0))) (export run)")
          (js-array "(defun f (g) (lambda (&optional [x]) (g))) (export f)"
                    "(defun run () (let ((value -0)) (funcall (f (lambda () value)) (js-array 17)))) (export run)"))) (pair-index 0))
        (while (< pair-index (js-length pairs))
          (let ((pair (aref pairs pair-index)))
            (setq pair-index (1+ pair-index))
        (let* ((ir (compile-control (+ (aref pair 0) "\n" (aref pair 1)) "parameter-patterns.eli"))
               (before (JSON/stringify ir)) (reference (await (reference-module ir)))
               (artifact (emit-control ir runtimeProgram)) (runtime (instantiateManagedRuntime artifact)))
          (js-call assert :strictEqual (JSON/stringify ir) before) (js-call runtime :auto 1)
          (try
            (let ((index 0))
              (while (< index 16)
                (let ((value (js-call runtime :invoke "run")))
                  (try
                    (progn (assert (Object/is (js-call runtime :readNumber value) (js-call reference :run)))
                           (assert (Object/is (js-call runtime :readNumber value) -0)))
                    (finally (js-call runtime :release value))))
                (js-call runtime :collect) (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                (setq index (1+ index))))
            (finally (js-call runtime :closeModule) (js-call runtime :collect)
              (js-call assert :strictEqual (js-call runtime :live) 0)
              (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)))))))))

  (test "Node and Bun load the same ordinary managed artifact and release returned roots"
    (async ()
      (let ((path (resolve directory "control.wasm")))
        (await (writeFile path bytes))
        (let ((result (spawnSync "node" (js-array (resolve root "tests/helpers/managed-control-node-selfhosted.mjs") path)
                        (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :strictEqual (get result :status) 0 (get result :stderr))))))

  (test "the explicit managed control CLI emits executable WASM and refuses other targets without publishing output"
    (async ()
      (let* ((output (resolve directory "cli-control.wasm"))
             (input (resolve root "tests/fixtures/wasm-managed-control.eli"))
             (cli (resolve root "tools/backends/compile.mjs"))
             (result (spawnSync (get globalThis.process :execPath)
               (js-array cli "--abi" "managed-control-v1" "--target" "wasm" "-o" output input)
               (js-object :encoding "utf8" :timeout 120000))))
        (js-call assert :strictEqual (get result :status) 0 (get result :stderr))
        (let* ((a (instantiateManagedRuntime (await (readFile output)))) (value (js-call a :invoke "unicode" (js-array))))
          (js-call assert :strictEqual (js-call a :readString value) (js-call js :unicode))
          (js-call a :release value) (js-call a :collect) (js-call assert :strictEqual (js-call a :live) 0))
        (let* ((targets (js-array "js" "native")) (target-index 0))
          (while (< target-index (js-length targets))
            (let ((target (aref targets target-index)))
              (setq target-index (1+ target-index))
          (let* ((path (resolve directory (+ "bad-" target)))
                 (bad (spawnSync (get globalThis.process :execPath)
                   (js-array cli "--abi" "managed-control-v1" "--target" target "-o" path input)
                   (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :notStrictEqual (get bad :status) 0)
            (assert (not (await (js-call (globalThis.Bun.file path) :exists)))))))))) 120000)
)
