(module tests.final-acceptance-history
  (import "bun:test" :as framework)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/acceptance/finalize.mjs" FinalAcceptanceError
    verifyHistoricalFuzzArtifact verifyHistoricalScaleArtifact validateFinalAcceptanceContract buildFinalAcceptance
    verifyFinalAcceptance generateFinalAcceptance validateFinalManifest humanFinalAcceptanceReport)

  (defconst fuzz-file "tests/reader-program-fuzz.test.mjs")
  (defconst scale-file "tests/project-scale.test.mjs")
  (defun test (title run) (js-call framework :test title run 300000))
  (defasync data (file) (JSON/parse (await (readFile (resolve root file) "utf8"))))
  (defasync retained-run () (await (data "acceptance/runs/m13-01.json")))
  (defasync contract () (await (data "contracts/final-acceptance.json")))
  (defun typed-error (error)
    (js-call (get FinalAcceptanceError :prototype) :isPrototypeOf error))
  (defun rejection (fragment)
    (lambda (error) (and (typed-error error) (js-call (get error :message) :includes fragment))))
  (defun functional-options () (js-object :root root :deferPerformanceAcceptance t))

  (test "historical fuzz evidence reads exact accepted Git bytes and does not claim current-source acceptance"
    (async ()
      (let* ((run (await (retained-run)))
             (before (JSON/stringify run))
             (proof (await (verifyHistoricalFuzzArtifact root fuzz-file run))))
        (js-call assert :strictEqual (get proof :artifact) fuzz-file)
        (js-call assert :strictEqual (get proof :artifactSha256)
          "f6446a6621dacd88a3e4a0fa3f8f13915652ad9a8fb3aa3d29b0469bba9b8b6e")
        (js-call assert :strictEqual (get proof :sourceCommit) (get (get run :source) :commit))
        (js-call assert :strictEqual (get proof :sourceTree) (get (get run :source) :tree))
        (js-call assert :strictEqual (get proof :historicalSourcesVerified) t)
        (js-call assert :strictEqual (get proof :currentSourceClaim) false)
        (js-call assert :strictEqual (get proof :currentSourceAcceptance) "not-asserted")
        (js-call assert :strictEqual (JSON/stringify run) before))))

  (test "historical fuzz authentication rejects wrong path, duplicate or absent binding and forged Git identities"
    (async ()
      (let ((run (await (retained-run))))
        (await (js-call assert :rejects (verifyHistoricalFuzzArtifact root "tests/project-scale.test.mjs" run)
          (rejection "only the retained reader/program fuzz")))
        (let ((mutations (js-array
          (lambda (value) (put (get value :source) :commit (js-call "0" :repeat 40)))
          (lambda (value) (put (get value :source) :tree (js-call "0" :repeat 40)))
          (lambda (value) (put (get value :source) :commit "HEAD"))
          (lambda (value) (put (js-call (get value :artifacts) :find (lambda (item) (= (get item :file) fuzz-file)))
            :sha256 (js-call "0" :repeat 64)))
          (lambda (value) (js-call (get value :artifacts) :push
            (globalThis.structuredClone (js-call (get value :artifacts) :find (lambda (item) (= (get item :file) fuzz-file))))))
          (lambda (value) (put value :artifacts (js-call (get value :artifacts) :filter
            (lambda (item) (/= (get item :file) fuzz-file))))))))
          (let ((index 0))
            (while (< index (js-length mutations))
              (let ((changed (globalThis.structuredClone run)))
                (funcall (aref mutations index) changed)
                (await (js-call assert :rejects (verifyHistoricalFuzzArtifact root fuzz-file changed) typed-error)))
              (setq index (1+ index))))))))

  (test "historical scale evidence authenticates accepted Git bytes without current scale acceptance"
    (async ()
      (let* ((run (await (retained-run))) (before (JSON/stringify run))
             (proof (await (verifyHistoricalScaleArtifact root scale-file run))))
        (js-call assert :strictEqual (get proof :artifact) scale-file)
        (js-call assert :strictEqual (get proof :artifactSha256)
          "99a42aedd7c492c2d4879be162b971975cb82a4c4fd98b5a7a7a6aae773101fb")
        (js-call assert :strictEqual (get proof :sourceCommit) (get (get run :source) :commit))
        (js-call assert :strictEqual (get proof :sourceTree) (get (get run :source) :tree))
        (js-call assert :strictEqual (get proof :historicalSourcesVerified) t)
        (js-call assert :strictEqual (get proof :currentSourceClaim) false)
        (js-call assert :strictEqual (get proof :currentSourceAcceptance) "not-asserted")
        (js-call assert :strictEqual (JSON/stringify run) before))))

  (test "historical scale authentication rejects other paths, missing bindings, forged identities and unavailable Git bytes"
    (async ()
      (let ((run (await (retained-run))))
        (await (js-call assert :rejects (verifyHistoricalScaleArtifact root fuzz-file run)
          (rejection "only the retained project scale")))
        (let ((mutations (js-array
          (lambda (value) (put (get value :source) :commit (js-call "0" :repeat 40)))
          (lambda (value) (put (get value :source) :tree (js-call "0" :repeat 40)))
          (lambda (value) (put (get value :source) :commit "HEAD"))
          (lambda (value) (put value :source nil))
          (lambda (value) (put value :artifacts nil))
          (lambda (value) (put (js-call (get value :artifacts) :find (lambda (item) (= (get item :file) scale-file)))
            :sha256 (js-call "0" :repeat 64)))
          (lambda (value) (put (js-call (get value :artifacts) :find (lambda (item) (= (get item :file) scale-file)))
            :sha256 "invalid"))
          (lambda (value) (js-call (get value :artifacts) :push
            (globalThis.structuredClone (js-call (get value :artifacts) :find (lambda (item) (= (get item :file) scale-file))))))
          (lambda (value) (put value :artifacts (js-call (get value :artifacts) :filter
            (lambda (item) (/= (get item :file) scale-file))))))))
          (let ((index 0))
            (while (< index (js-length mutations))
              (let ((changed (globalThis.structuredClone run)))
                (funcall (aref mutations index) changed)
                (await (js-call assert :rejects (verifyHistoricalScaleArtifact root scale-file changed) typed-error)))
              (setq index (1+ index)))))
        (let ((directory (await (mkdtemp (resolve root "_worktree/ci-closure/scale-history-")))))
          (try
            (let ((initialized (spawnSync "git" (js-array "init" "--bare" directory)
                                 (js-object :encoding "utf8" :timeout 10000))))
              (js-call assert :strictEqual (get initialized :status) 0 (get initialized :stderr))
              (await (js-call assert :rejects (verifyHistoricalScaleArtifact directory scale-file run)
                (rejection "historical scale Git source authentication failed"))))
            (finally (await (rm directory (js-object :recursive t :force t)))))))))

  (defun rejects-current-source-drift (error)
    (and (typed-error error)
      (js-call (get error :message) :includes (str "fuzz artifact changed after the source run: " fuzz-file))
      (js-call (get error :message) :includes (str "scale artifact changed after the source run: " scale-file))))

  (test "default and explicit false reject current fuzz and scale drift even with an outer deferral environment"
    (async ()
      (let* ((run (await (retained-run))) (value (await (contract)))
             (environment (get globalThis.process :env)) (before (get environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE)))
        (try
          (put environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1")
          (await (js-call assert :rejects (validateFinalAcceptanceContract value run (js-object :root root))
            rejects-current-source-drift))
          (await (js-call assert :rejects (validateFinalAcceptanceContract value run
            (js-object :root root :deferPerformanceAcceptance false))
            rejects-current-source-drift))
          (finally (if (undefined? before) (js-call globalThis.Reflect :deleteProperty environment "ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE")
            (put environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE before)))))))

  (test "explicit functional verification records historical provenance separately and preserves canonical manifest bytes"
    (async ()
      (let* ((run (await (retained-run))) (value (await (contract))) (historical (js-array))
             (options (Object/assign (functional-options) (js-object :historicalSourceEvidence historical)))
             (files (js-array "acceptance/manifest.json" "acceptance/report.md" "acceptance/runs/m13-01.json" "acceptance/runs/m13-01.md"))
             (before (await (Promise/all (js-call files :map (lambda (file) (readFile (resolve root file))))))))
        (js-call assert :strictEqual (await (validateFinalAcceptanceContract value run options)) value)
        (await (validateFinalAcceptanceContract value run options))
        (js-call assert :deepStrictEqual (js-call historical :map (lambda (item) (get item :artifact)))
          (js-array fuzz-file scale-file))
        (js-call historical :forEach (lambda (item)
          (js-call assert :strictEqual (get item :historicalSourcesVerified) t)
          (js-call assert :strictEqual (get item :currentSourceClaim) false)
          (js-call assert :strictEqual (get item :currentSourceAcceptance) "not-asserted")))
        (let* ((manifest (await (verifyFinalAcceptance options))) (expected (await (buildFinalAcceptance options))))
          (js-call assert :deepStrictEqual manifest expected)
          (js-call assert :deepStrictEqual manifest (await (data "acceptance/manifest.json")))
          (js-call assert :strictEqual (humanFinalAcceptanceReport manifest)
            (await (readFile (resolve root "acceptance/report.md") "utf8"))))
        (let ((index 0))
          (while (< index (js-length files))
            (js-call assert :deepStrictEqual (await (readFile (resolve root (aref files index)))) (aref before index))
            (setq index (1+ index)))))))

  (test "functional historical handling does not admit an unbound artifact or forged current acceptance"
    (async ()
      (let ((value (await (contract))))
        (put (aref (get value :evidenceGroups) 1) :artifacts (js-array "README.md"))
        (await (js-call assert :rejects (validateFinalAcceptanceContract value (await (retained-run)) (functional-options))
          (rejection "fuzz artifact is not bound by the source run: README.md"))))
      (let* ((expected (await (buildFinalAcceptance (functional-options))))
             (forged (globalThis.structuredClone expected)))
        (put (get forged :summary) :acceptancePass (not (get (get expected :summary) :acceptancePass)))
        (js-call assert :throws (lambda () (validateFinalManifest forged expected)) typed-error))
      (await (js-call assert :rejects (generateFinalAcceptance (functional-options))
        (rejection "cannot generate acceptance artifacts while current performance acceptance is deferred")))
      (await (js-call assert :rejects (verifyFinalAcceptance
        (Object/assign (functional-options) (js-object :requirePass t)))
        (rejection "current performance acceptance is deferred and has not passed")))))

  (test "functional CLI labels historical fuzz and scale separately without running or promoting current acceptance"
    (async ()
      (let* ((files (js-array "acceptance/manifest.json" "acceptance/report.md"))
             (before (await (Promise/all (js-call files :map (lambda (file) (readFile (resolve root file)))))))
             (child (spawnSync (get globalThis.process :execPath)
               (js-array (resolve root "tools/acceptance/finalize.mjs") "--verify")
               (js-object :cwd root :encoding "utf8" :timeout 30000
                 :env (Object/assign (js-object) (get globalThis.process :env)
                   (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1"))))))
        (js-call assert :strictEqual (get child :status) 0 (get child :stderr))
        (js-call assert :ok (js-call (get child :stdout) :includes "Historical fuzz source:"))
        (js-call assert :ok (js-call (get child :stdout) :includes "current fuzz acceptance requires an independent complete functional run (not asserted here)"))
        (js-call assert :ok (js-call (get child :stdout) :includes "Historical scale source:"))
        (js-call assert :ok (js-call (get child :stdout) :includes
          "current scale acceptance: DEFERRED / NOT ACCEPTED; current-source acceptance not asserted"))
        (js-call assert :ok (js-call (get child :stdout) :includes "DEFERRED / NOT ACCEPTED"))
        (let ((index 0))
          (while (< index (js-length files))
            (js-call assert :deepStrictEqual (await (readFile (resolve root (aref files index)))) (aref before index))
            (setq index (1+ index)))))) 30000))
