(module tests.final-acceptance-history
  (import "bun:test" :as framework)
  (import "node:assert/strict" :default assert)
  (import "node:crypto" createHash)
  (import "node:fs/promises" cp mkdir mkdtemp readFile rm symlink writeFile)
  (import "node:path" dirname resolve)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/acceptance/retained-performance-snapshot.mjs"
    retainedGitSnapshotBytes retainedPerformanceSnapshot)
  (import "../tools/acceptance/finalize.mjs" FinalAcceptanceError
    verifyHistoricalFuzzArtifact verifyHistoricalScaleArtifact verifyHistoricalBenchmarkReport verifyHistoricalSoakReport
    validateFinalAcceptanceContract buildFinalAcceptance
    validateExtendedWorkerSoakSource
    verifyFinalAcceptance generateFinalAcceptance validateFinalManifest humanFinalAcceptanceReport)

  (defconst fuzz-file "tests/reader-program-fuzz.test.mjs")
  (defconst scale-file "tests/project-scale.test.mjs")
  (defconst benchmark-report-file "benchmarks/emacs-analysis-macos-arm64.json")
  (defconst soak-report-file "benchmarks/worker-value-stream-macos-arm64.json")
  (defconst skip-retained (= (get (get globalThis.process :env) :ELISCRIPT_SKIP_RETAINED_ACCEPTANCE) "1"))
  (defun test (title run) (js-call framework :test title run 300000))
  (defun retained-test (title run &rest timeout)
    (if skip-retained
      (js-call (get framework :test) :skip title run)
      (js-call framework :test title run (if (= (js-length timeout) 0) 300000 (aref timeout 0)))))
  (defasync data (file) (JSON/parse (await (readFile (resolve root file) "utf8"))))
  (defasync retained-run () (await (data "acceptance/runs/m13-01.json")))
  (defasync contract () (await (data "contracts/final-acceptance.json")))
  (defun typed-error (error)
    (js-call (get FinalAcceptanceError :prototype) :isPrototypeOf error))
  (defun rejection (fragment)
    (lambda (error) (and (typed-error error) (js-call (get error :message) :includes fragment))))
  (defun functional-options () (js-object :root root :deferPerformanceAcceptance t))
  (defun sha256 (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defasync soak-sources-match-root? (report)
    (let ((files (get (get report "source") "files")) (index 0) (matches t))
      (while (and matches (< index (js-length files)))
        (let* ((entry (aref files index)) (file (get entry "file")))
          (try
            (unless (= (sha256 (await (readFile (resolve root file)))) (get entry "sha256"))
              (setq matches false))
            (catch _error (setq matches false))))
        (setq index (1+ index)))
      matches))
  (defasync with-measured-soak-workspace (current accepted callback)
    (if (await (soak-sources-match-root? current))
      (await (funcall callback root))
      (progn
        (await (js-call assert :rejects (validateExtendedWorkerSoakSource root current accepted)
          (rejection "fresh worker soak source entry is stale:")))
        (let* ((report-file "benchmarks/worker-lifecycle-soak-macos-arm64.json")
               (report-bytes (await (readFile (resolve root report-file))))
               (snapshot (retainedPerformanceSnapshot root report-file report-bytes)))
          (await (mkdir (resolve root ".eliscript-cache/final-acceptance-history") (js-object :recursive t)))
          (let ((directory (await (mkdtemp (resolve root ".eliscript-cache/final-acceptance-history/soak-source-")))))
            (try
              (let ((files (get (get current "source") "files")) (index 0))
                (while (< index (js-length files))
                  (let* ((file (get (aref files index) "file"))
                         (target (resolve directory file))
                         (bytes (retainedGitSnapshotBytes root
                                  (js-array "show" (str (get snapshot :commit) ":" file)))))
                    (await (mkdir (dirname target) (js-object :recursive t)))
                    (await (writeFile target bytes)))
                  (setq index (1+ index)))
                (await (funcall callback directory)))
              (finally (await (rm directory (js-object :recursive t :force t))))))))))
  (defun projected-corpus-matches? (run corpus-file corpus-bytes)
    (let* ((commit (get (get run :source) :commit))
           (accepted-bytes (retainedGitSnapshotBytes root (js-array "show" (str commit ":" corpus-file))))
           (text (js-call (new globalThis.TextDecoder) :decode accepted-bytes))
           (prefix "{\n  \"schemaVersion\": 1,\n  \"format\": \"eliscript-core-acceptance-corpus\",\n  \"version\": 1,\n")
           (replacement "{\n  \"format\": \"eliscript-core-acceptance-corpus\",\n")
           (projected (if (js-call text :startsWith prefix)
                        (globalThis.Buffer.from (str replacement (js-call text :slice (js-length prefix))) "utf8")
                        accepted-bytes)))
      (= (sha256 projected) (sha256 corpus-bytes))))
  (defasync with-functional-history-workspace (run contract-value callback)
    (let* ((corpus-file "contracts/core-acceptance-corpus.json")
           (corpus-bytes (await (readFile (resolve root corpus-file))))
           (bound-corpus (js-call (get run :artifacts) :find (lambda (item) (= (get item :file) corpus-file)))))
      (if (or (= (sha256 corpus-bytes) (get bound-corpus :sha256))
              (projected-corpus-matches? run corpus-file corpus-bytes))
        (await (funcall callback root))
        (progn
          (await (js-call assert :rejects (validateFinalAcceptanceContract contract-value run (functional-options))
            (rejection "test artifact changed after the source run: contracts/core-acceptance-corpus.json")))
          (await (mkdir (resolve root ".eliscript-cache/final-acceptance-history") (js-object :recursive t)))
          (let ((directory (await (mkdtemp (resolve root ".eliscript-cache/final-acceptance-history/functional-history-")))))
            (try
              (let ((links (js-array ".git" "acceptance" "benchmarks" "specs" "tests")) (index 0))
                (while (< index (js-length links))
                  (let ((entry (aref links index)))
                    (await (symlink (resolve root entry) (resolve directory entry))))
                  (setq index (1+ index)))
                (await (mkdir (resolve directory "contracts") (js-object :recursive t)))
                (await (cp (resolve root "contracts/final-acceptance.json")
                           (resolve directory "contracts/final-acceptance.json")))
                (await (writeFile (resolve directory corpus-file)
                  (retainedGitSnapshotBytes root
                    (js-array "show" (str (get (get run :source) :commit) ":" corpus-file)))))
                (await (funcall callback directory)))
              (finally (await (rm directory (js-object :recursive t :force t))))))))))

  (test "historical fuzz evidence reads exact accepted Git bytes and does not claim current-source acceptance"
    (async ()
      (let* ((run (await (retained-run)))
             (before (JSON/stringify run))
             (proof (await (verifyHistoricalFuzzArtifact root fuzz-file run))))
        (js-call assert :strictEqual (get proof :artifact) fuzz-file)
        (js-call assert :strictEqual (get proof :artifactSha256)
          "f6446a6621dacd88a3e4a0fa3f8f13915652ad9a8fb3aa3d29b0469bba9b8b6e")
        (js-call assert :strictEqual (get proof :sourceCommit) (get (get run :source) :commit))
        (js-call assert :strictEqual (get proof :sourceTree) (get (get run :source) :tree))
        (js-call assert :strictEqual (get proof :historicalSourcesVerified) t)
        (js-call assert :strictEqual (get proof :currentSourceClaim) false)
        (js-call assert :strictEqual (get proof :currentSourceAcceptance) "not-asserted")
        (js-call assert :strictEqual (JSON/stringify run) before))))

  (test "historical fuzz authentication rejects wrong path, duplicate or absent binding and forged Git identities"
    (async ()
      (let ((run (await (retained-run))))
        (await (js-call assert :rejects (verifyHistoricalFuzzArtifact root "tests/project-scale.test.mjs" run)
          (rejection "only the retained reader/program fuzz")))
        (let ((mutations (js-array
          (lambda (value) (put (get value :source) :commit (js-call "0" :repeat 40)))
          (lambda (value) (put (get value :source) :tree (js-call "0" :repeat 40)))
          (lambda (value) (put (get value :source) :commit "HEAD"))
          (lambda (value) (put (js-call (get value :artifacts) :find (lambda (item) (= (get item :file) fuzz-file)))
            :sha256 (js-call "0" :repeat 64)))
          (lambda (value) (js-call (get value :artifacts) :push
            (globalThis.structuredClone (js-call (get value :artifacts) :find (lambda (item) (= (get item :file) fuzz-file))))))
          (lambda (value) (put value :artifacts (js-call (get value :artifacts) :filter
            (lambda (item) (/= (get item :file) fuzz-file))))))))
          (let ((index 0))
            (while (< index (js-length mutations))
              (let ((changed (globalThis.structuredClone run)))
                (funcall (aref mutations index) changed)
                (await (js-call assert :rejects (verifyHistoricalFuzzArtifact root fuzz-file changed) typed-error)))
              (setq index (1+ index))))))))

  (test "historical scale evidence authenticates accepted Git bytes without current scale acceptance"
    (async ()
      (let* ((run (await (retained-run))) (before (JSON/stringify run))
             (proof (await (verifyHistoricalScaleArtifact root scale-file run))))
        (js-call assert :strictEqual (get proof :artifact) scale-file)
        (js-call assert :strictEqual (get proof :artifactSha256)
          "99a42aedd7c492c2d4879be162b971975cb82a4c4fd98b5a7a7a6aae773101fb")
        (js-call assert :strictEqual (get proof :sourceCommit) (get (get run :source) :commit))
        (js-call assert :strictEqual (get proof :sourceTree) (get (get run :source) :tree))
        (js-call assert :strictEqual (get proof :historicalSourcesVerified) t)
        (js-call assert :strictEqual (get proof :currentSourceClaim) false)
        (js-call assert :strictEqual (get proof :currentSourceAcceptance) "not-asserted")
        (js-call assert :strictEqual (JSON/stringify run) before))))

  (test "historical scale authentication rejects other paths, missing bindings, forged identities and unavailable Git bytes"
    (async ()
      (let ((run (await (retained-run))))
        (await (js-call assert :rejects (verifyHistoricalScaleArtifact root fuzz-file run)
          (rejection "only the retained project scale")))
        (let ((mutations (js-array
          (lambda (value) (put (get value :source) :commit (js-call "0" :repeat 40)))
          (lambda (value) (put (get value :source) :tree (js-call "0" :repeat 40)))
          (lambda (value) (put (get value :source) :commit "HEAD"))
          (lambda (value) (put value :source nil))
          (lambda (value) (put value :artifacts nil))
          (lambda (value) (put (js-call (get value :artifacts) :find (lambda (item) (= (get item :file) scale-file)))
            :sha256 (js-call "0" :repeat 64)))
          (lambda (value) (put (js-call (get value :artifacts) :find (lambda (item) (= (get item :file) scale-file)))
            :sha256 "invalid"))
          (lambda (value) (js-call (get value :artifacts) :push
            (globalThis.structuredClone (js-call (get value :artifacts) :find (lambda (item) (= (get item :file) scale-file))))))
          (lambda (value) (put value :artifacts (js-call (get value :artifacts) :filter
            (lambda (item) (/= (get item :file) scale-file))))))))
          (let ((index 0))
            (while (< index (js-length mutations))
              (let ((changed (globalThis.structuredClone run)))
                (funcall (aref mutations index) changed)
                (await (js-call assert :rejects (verifyHistoricalScaleArtifact root scale-file changed) typed-error)))
              (setq index (1+ index)))))
        (await (mkdir (resolve root ".eliscript-cache/final-acceptance-history") (js-object :recursive t)))
        (let ((directory (await (mkdtemp (resolve root ".eliscript-cache/final-acceptance-history/scale-history-")))))
          (try
            (let ((initialized (spawnSync "git" (js-array "init" "--bare" directory)
                                 (js-object :encoding "utf8" :timeout 10000))))
              (js-call assert :strictEqual (get initialized :status) 0 (get initialized :stderr))
              (await (js-call assert :rejects (verifyHistoricalScaleArtifact directory scale-file run)
                (rejection "historical scale Git source authentication failed"))))
            (finally (await (rm directory (js-object :recursive t :force t)))))))))

  (test "fresh retained worker soak accepts only the exact prepared-runtime inventory extension"
    (async ()
      (let* ((run (await (retained-run)))
             (revision (get (get run "source") "commit"))
             (accepted-result (spawnSync "git"
                                (js-array "show" (str revision ":benchmarks/worker-lifecycle-soak-macos-arm64.json"))
                                (js-object :cwd root :encoding "utf8" :timeout 10000)))
             (current (await (data "benchmarks/worker-lifecycle-soak-macos-arm64.json"))))
        (js-call assert :strictEqual (get accepted-result "status") 0 (get accepted-result "stderr"))
        (let ((accepted (JSON/parse (get accepted-result "stdout"))))
          (await (with-measured-soak-workspace current accepted
            (async (workspace)
              (await (validateExtendedWorkerSoakSource workspace current accepted))
              (let ((mutations
                     (js-array
                       (lambda (value) (js-call (get (get value "source") "files") :pop))
                       (lambda (value) (js-call (get (get value "source") "files") :push
                                         (js-object "file" "README.md" "sha256" (js-call "0" :repeat 64))))
                       (lambda (value) (put (aref (get (get value "source") "files") 26) "sha256"
                                            (js-call "0" :repeat 64)))
                       (lambda (value) (put (aref (get (get value "source") "files") 0) "file"
                                            "bootstrap/compiler/not-the-accepted-source.eli"))
                       (lambda (value) (put (get value "source") "digest" (js-call "0" :repeat 64)))
                       (lambda (value) (js-call (get (get value "source") "files") :shift))))
                    (index 0))
                (while (< index (js-length mutations))
                  (let ((changed (globalThis.structuredClone current)))
                    (funcall (aref mutations index) changed)
                    (await (js-call assert :rejects
                      (validateExtendedWorkerSoakSource workspace changed accepted) typed-error)))
                  (setq index (1+ index))))
              (let ((changed-accepted (globalThis.structuredClone accepted)))
                (js-call (get (get changed-accepted "source") "files") :shift)
                (await (js-call assert :rejects
                  (validateExtendedWorkerSoakSource workspace current changed-accepted) typed-error))))))))))

  (defun rejects-current-source-drift (error)
    (and (typed-error error)
      (js-call (get error :message) :includes (str "fuzz artifact changed after the source run: " fuzz-file))
      (js-call (get error :message) :includes (str "scale artifact changed after the source run: " scale-file))
      (js-call (get error :message) :includes (str "benchmark artifact changed after the source run: " benchmark-report-file))
      (js-call (get error :message) :includes (str "soak artifact changed after the source run: " soak-report-file))))

  (test "default and explicit false reject current fuzz and scale drift even with an outer deferral environment"
    (async ()
      (let* ((run (await (retained-run))) (value (await (contract)))
             (environment (get globalThis.process :env)) (before (get environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE)))
        (try
          (put environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1")
          (await (js-call assert :rejects (validateFinalAcceptanceContract value run (js-object :root root))
            rejects-current-source-drift))
          (await (js-call assert :rejects (validateFinalAcceptanceContract value run
            (js-object :root root :deferPerformanceAcceptance false))
            rejects-current-source-drift))
          (finally (if (undefined? before) (js-call globalThis.Reflect :deleteProperty environment "ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE")
            (put environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE before)))))))

  (test "explicit functional verification records historical provenance separately and preserves canonical manifest bytes"
    (async ()
      (let* ((run (await (retained-run))) (value (await (contract)))
             (files (js-array "acceptance/manifest.json" "acceptance/report.md" "acceptance/runs/m13-01.json" "acceptance/runs/m13-01.md"))
             (before (await (Promise/all (js-call files :map (lambda (file) (readFile (resolve root file))))))))
        (await (with-functional-history-workspace run value
          (async (workspace)
            (let* ((historical (js-array))
                   (options (js-object :root workspace :deferPerformanceAcceptance t :historicalSourceEvidence historical)))
              (js-call assert :strictEqual (await (validateFinalAcceptanceContract value run options)) value)
              (await (validateFinalAcceptanceContract value run options))
              (js-call assert :deepStrictEqual (js-call historical :map (lambda (item) (get item :artifact)))
                (js-array benchmark-report-file fuzz-file scale-file soak-report-file))
              (js-call historical :forEach (lambda (item)
                (js-call assert :strictEqual (get item :historicalSourcesVerified) t)
                (js-call assert :strictEqual (get item :currentSourceClaim) false)
                (js-call assert :strictEqual (get item :currentSourceAcceptance) "not-asserted")))))))
        (let ((index 0))
          (while (< index (js-length files))
            (js-call assert :deepStrictEqual (await (readFile (resolve root (aref files index)))) (aref before index))
            (setq index (1+ index)))))))

  (retained-test "explicit functional verification matches retained canonical manifest and human report"
    (async ()
      (let* ((options (functional-options))
             (files (js-array "acceptance/manifest.json" "acceptance/report.md" "acceptance/runs/m13-01.json" "acceptance/runs/m13-01.md"))
             (before (await (Promise/all (js-call files :map (lambda (file) (readFile (resolve root file)))))))
             (manifest (await (verifyFinalAcceptance options)))
             (expected (await (buildFinalAcceptance options))))
        (js-call assert :deepStrictEqual manifest expected)
        (js-call assert :deepStrictEqual manifest (await (data "acceptance/manifest.json")))
        (js-call assert :strictEqual (humanFinalAcceptanceReport manifest)
          (await (readFile (resolve root "acceptance/report.md") "utf8")))
        (let ((index 0))
          (while (< index (js-length files))
            (js-call assert :deepStrictEqual (await (readFile (resolve root (aref files index)))) (aref before index))
            (setq index (1+ index)))))))

  (test "functional historical handling does not admit an unbound artifact or forged current acceptance"
    (async ()
      (let ((run (await (retained-run))) (base-contract (await (contract))))
        (await (with-functional-history-workspace run base-contract
          (async (workspace)
            (let ((options (js-object :root workspace :deferPerformanceAcceptance t))
                  (value (globalThis.structuredClone base-contract)))
              (put (aref (get value :evidenceGroups) 1) :artifacts (js-array "README.md"))
              (await (js-call assert :rejects (validateFinalAcceptanceContract value run options)
                (rejection "fuzz artifact is not bound by the source run: README.md")))
              (let* ((expected (await (buildFinalAcceptance (Object/assign (js-object) options (js-object :run run)))))
                     (forged (globalThis.structuredClone expected)))
                (put (get forged :summary) :acceptancePass (not (get (get expected :summary) :acceptancePass)))
                (js-call assert :throws (lambda () (validateFinalManifest forged expected)) typed-error))
              (await (js-call assert :rejects (generateFinalAcceptance options)
                (rejection "cannot generate acceptance artifacts while current performance acceptance is deferred"))))))))))

  (retained-test "retained final acceptance verification rejects requirePass while performance acceptance is deferred"
    (async ()
      (await (js-call assert :rejects (verifyFinalAcceptance
        (Object/assign (functional-options) (js-object :requirePass t)))
        (rejection "current performance acceptance is deferred and has not passed")))))

  (retained-test "functional CLI labels historical fuzz and scale separately without running or promoting current acceptance"
    (async ()
      (let* ((files (js-array "acceptance/manifest.json" "acceptance/report.md"))
             (before (await (Promise/all (js-call files :map (lambda (file) (readFile (resolve root file)))))))
             (child (spawnSync (get globalThis.process :execPath)
               (js-array (resolve root "tools/acceptance/finalize.mjs") "--verify")
               (js-object :cwd root :encoding "utf8" :timeout 180000
                 :env (Object/assign (js-object) (get globalThis.process :env)
                   (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1"))))))
        (js-call assert :strictEqual (get child :status) 0 (get child :stderr))
        (js-call assert :ok (js-call (get child :stdout) :includes "Historical fuzz source:"))
        (js-call assert :ok (js-call (get child :stdout) :includes "current fuzz acceptance requires an independent complete functional run (not asserted here)"))
        (js-call assert :ok (js-call (get child :stdout) :includes "Historical scale source:"))
        (js-call assert :ok (js-call (get child :stdout) :includes
          "current scale acceptance: DEFERRED / NOT ACCEPTED; current-source acceptance not asserted"))
        (js-call assert :ok (js-call (get child :stdout) :includes "Historical benchmark source:"))
        (js-call assert :ok (js-call (get child :stdout) :includes
          "current benchmark acceptance: DEFERRED / NOT ACCEPTED; current-source acceptance not asserted"))
        (js-call assert :ok (js-call (get child :stdout) :includes "Historical soak source:"))
        (js-call assert :ok (js-call (get child :stdout) :includes
          "current soak acceptance: DEFERRED / NOT ACCEPTED; current-source acceptance not asserted"))
        (js-call assert :ok (js-call (get child :stdout) :includes "DEFERRED / NOT ACCEPTED"))
        (let ((index 0))
          (while (< index (js-length files))
            (js-call assert :deepStrictEqual (await (readFile (resolve root (aref files index)))) (aref before index))
            (setq index (1+ index)))))) 300000)

  (test "historical benchmark and soak reports authenticate accepted Git bytes without current-source acceptance"
    (async ()
      (let* ((run (await (retained-run))) (before (JSON/stringify run))
             (benchmark (await (verifyHistoricalBenchmarkReport root benchmark-report-file run)))
             (soak (await (verifyHistoricalSoakReport root soak-report-file run))))
        (js-call assert :strictEqual (get benchmark :artifact) benchmark-report-file)
        (js-call assert :strictEqual (get benchmark :artifactSha256)
          "a5eeb3adc2bd5ae44a64833683c77a837ee0798cf3018b6cbfecebdc6e1029dc")
        (js-call assert :strictEqual (get soak :artifact) soak-report-file)
        (js-call assert :strictEqual (get soak :artifactSha256)
          "7fdf64d25067722b265d4a4b377e62b87e8b8c678fe15c045c9a5a8876578dd3")
        (js-call (js-array benchmark soak) :forEach (lambda (proof)
          (js-call assert :strictEqual (get proof :sourceCommit) (get (get run :source) :commit))
          (js-call assert :strictEqual (get proof :sourceTree) (get (get run :source) :tree))
          (js-call assert :strictEqual (get proof :historicalSourcesVerified) t)
          (js-call assert :strictEqual (get proof :currentSourceClaim) false)
          (js-call assert :strictEqual (get proof :currentSourceAcceptance) "not-asserted")))
        (js-call assert :strictEqual (JSON/stringify run) before))))

  (test "historical benchmark and soak authentication rejects other paths, missing or duplicated bindings, tampered digests and forged Git identities"
    (async ()
      (let* ((run (await (retained-run)))
             (cases (js-array
               (js-object :file benchmark-report-file :verify verifyHistoricalBenchmarkReport
                 :other "only the retained Emacs analysis benchmark report")
               (js-object :file soak-report-file :verify verifyHistoricalSoakReport
                 :other "only the retained worker value-stream soak report")))
             (index 0))
        (while (< index (js-length cases))
          (let* ((entry (aref cases index)) (file (get entry :file)) (verify (get entry :verify)))
            (await (js-call assert :rejects (funcall verify root fuzz-file run)
              (rejection (get entry :other))))
            (let ((mutations (js-array
              (lambda (value) (put (get value :source) :commit (js-call "0" :repeat 40)))
              (lambda (value) (put (get value :source) :tree (js-call "0" :repeat 40)))
              (lambda (value) (put (get value :source) :commit "HEAD"))
              (lambda (value) (put value :source nil))
              (lambda (value) (put value :artifacts nil))
              (lambda (value) (put (js-call (get value :artifacts) :find
                                       (lambda (item) (= (get item :file) file)))
                               :sha256 (js-call "0" :repeat 64)))
              (lambda (value) (js-call (get value :artifacts) :push
                               (globalThis.structuredClone
                                 (js-call (get value :artifacts) :find
                                   (lambda (item) (= (get item :file) file))))))
              (lambda (value) (put value :artifacts (js-call (get value :artifacts) :filter
                                       (lambda (item) (/= (get item :file) file)))))))
                  (mutation-index 0))
              (while (< mutation-index (js-length mutations))
                (let ((changed (globalThis.structuredClone run)))
                  (funcall (aref mutations mutation-index) changed)
                  (await (js-call assert :rejects (funcall verify root file changed) typed-error)))
                (setq mutation-index (1+ mutation-index)))))
          (setq index (1+ index))))
      (await (mkdir (resolve root ".eliscript-cache/final-acceptance-history") (js-object :recursive t)))
      (let ((directory (await (mkdtemp (resolve root ".eliscript-cache/final-acceptance-history/report-history-")))))
        (try
          (let ((initialized (spawnSync "git" (js-array "init" "--bare" directory)
                               (js-object :encoding "utf8" :timeout 10000))))
            (js-call assert :strictEqual (get initialized :status) 0 (get initialized :stderr))
            (await (js-call assert :rejects
              (verifyHistoricalBenchmarkReport directory benchmark-report-file (await (retained-run)))
              (rejection "historical benchmark Git source authentication failed"))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
)
