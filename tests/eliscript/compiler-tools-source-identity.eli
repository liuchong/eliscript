(module tests.compiler-tools-source-identity
  (import "node:test" before after test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp mkdir readFile writeFile rm)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" root buildBackends)
  (import "../tools/backends/managed-runtime.mjs" loadManagedHostModules)
  (defvar directory undefined)
  (defvar implementations (js-array))
  (defconst lexical "(defun outer (x) (let ((x (+ x 1))) (setq x (+ x 2)) x)) (export outer)")
  (before (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-tools-source-identity-"))))
    (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
           (input (resolve root "bootstrap/host/compiler-tools.eli"))
           (source (await (readFile input "utf8"))) (host (resolve directory "host"))
           (self (resolve host "compiler-tools-self.mjs")) (seed (resolve host "compiler-tools-seed.mjs")))
      (await (mkdir host (js-object :recursive t)))
      (await (writeFile self (js-call (get backend :compiler) :compile_string source "compiler-tools.eli")))
      (let ((child (spawnSync (resolve root "bin/eliscript-seed") (js-array "--output" seed input)
                     (js-object :cwd root :encoding "utf8" :timeout 120000))))
        (js-call assert :strictEqual (get child :error) undefined)
        (js-call assert :strictEqual (get child :signal) nil (get child :stderr))
        (js-call assert :strictEqual (get child :status) 0 (get child :stderr)))
      (let ((modules (await (loadManagedHostModules (js-object :hostModules
        (js-array
          (js-object :id "self" :specifier (get (pathToFileURL self) :href) :referrer "identity.mjs"
            :allowedExports (js-array "tools_request") :namespace t)
          (js-object :id "seed" :specifier (get (pathToFileURL seed) :href) :referrer "identity.mjs"
            :allowedExports (js-array "tools_request") :namespace t)))))))
        (setq implementations (js-array (js-call modules :get "seed") (js-call modules :get "self"))))
      (js-call assert :strictEqual (await (readFile input "utf8")) source))) (js-object :timeout 120000))
  (after (async ()
    (setq implementations (js-array))
    (when directory (await (rm directory (js-object :recursive t :force t))))))

  (defun request (operation source &rest expected)
    (let ((value (js-object :operation operation :source source :filename "tools.eli"
                   :offset 0 :offsetUnit "unicode-scalar" :query "symbol" :edits (js-array))))
      (when (> (js-length expected) 0) (put value :expectedSourceIdentity (aref expected 0))) value))
  (defun rejected (report code)
    (js-call assert :strictEqual (get report :ok) false)
    (js-call assert :strictEqual (get report :readOnly) t)
    (js-call assert :strictEqual (js-length (get report :diagnostics)) 1)
    (let ((diagnostic (aref (get report :diagnostics) 0)))
      (js-call assert :strictEqual (get diagnostic :code) code)
      (js-call assert :strictEqual (get diagnostic :phase) "compiler-tools")
      (js-call assert :strictEqual (get (get diagnostic :location) :file) "tools.eli"))
    (js-call assert :deepStrictEqual (get report :definitions) (js-array))
    (js-call assert :deepStrictEqual (get report :references) (js-array)))

  (test "Seed and self-hosted semantic tools distinguish omitted undefined and explicit null source identities"
    (lambda ()
      (js-call implementations :forEach (lambda (implementation)
        (let* ((baseline (js-call implementation :tools_request (request "analyze" lexical)))
               (identity (get baseline :sourceIdentity)))
          (js-call assert :strictEqual (get baseline :ok) t)
          (js-call (js-array "analyze" "query") :forEach (lambda (operation)
            (js-call assert :strictEqual (get (js-call implementation :tools_request (request operation lexical)) :ok) t)
            (js-call assert :strictEqual (get (js-call implementation :tools_request (request operation lexical undefined)) :ok) t)
            (rejected (js-call implementation :tools_request (request operation lexical nil)) "ELI-T0002")))
          (rejected (js-call implementation :tools_request (request "edit-preview" lexical)) "ELI-T0001")
          (rejected (js-call implementation :tools_request (request "edit-preview" lexical undefined)) "ELI-T0001")
          (rejected (js-call implementation :tools_request (request "edit-preview" lexical nil)) "ELI-T0002")
          (js-call assert :strictEqual
            (get (js-call implementation :tools_request (request "edit-preview" lexical identity)) :ok) t))))))

  (test "all retained invalid identity variants reject before Reader errors and valid requests still recover"
    (lambda ()
      (js-call implementations :forEach (lambda (implementation)
        (let* ((identity (get (js-call implementation :tools_request (request "analyze" lexical)) :sourceIdentity))
               (variants (js-array nil (js-array) (js-object) "old" false 0 ""
                 (Object/assign (js-object) identity (js-object :sha256 (js-call "0" :repeat 64)))
                 (Object/assign (js-object) identity (js-object :units (1+ (get identity :units)))))))
          (js-call variants :forEach (lambda (expected)
            (js-call (js-array "analyze" "query" "edit-preview") :forEach (lambda (operation)
              (rejected (js-call implementation :tools_request (request operation "(" expected)) "ELI-T0002")
              (rejected (js-call implementation :tools_request (request operation lexical expected)) "ELI-T0002")))))
          (let ((reader (js-call implementation :tools_request (request "analyze" "(" undefined))))
            (js-call assert :strictEqual (get reader :ok) false)
            (js-call assert :ok (js-call (get (aref (get reader :diagnostics) 0) :code) :startsWith "ELI-R")))
          (js-call assert :strictEqual (get (js-call implementation :tools_request (request "analyze" lexical identity)) :ok) t)
          (js-call assert :deepStrictEqual
            (get (js-call implementation :tools_request (request "analyze" lexical)) :sourceIdentity) identity))))))

  (test "source identity access preserves inherited null one getter evaluation and the original thrown value"
    (lambda ()
      (js-call implementations :forEach (lambda (implementation)
        (let* ((prototype (js-object :expectedSourceIdentity nil))
               (inherited (Object/assign (Object/create prototype) (request "analyze" lexical)))
               (input (request "analyze" lexical)) (reads 0))
          (rejected (js-call implementation :tools_request inherited) "ELI-T0002")
          (Object/defineProperty input "expectedSourceIdentity" (js-object :enumerable t :configurable t
            :get (lambda () (setq reads (1+ reads)) nil)))
          (rejected (js-call implementation :tools_request input) "ELI-T0002")
          (js-call assert :strictEqual reads 1)
          (let ((failure (js-object :marker "source identity getter")))
            (Object/defineProperty input "expectedSourceIdentity" (js-object :enumerable t :configurable t
              :get (lambda () (setq reads (1+ reads)) (throw failure))))
            (js-call assert :throws (lambda () (js-call implementation :tools_request input))
              (lambda (error) (Object/is error failure)))
            (js-call assert :strictEqual reads 2))
          (js-call assert :strictEqual (get (js-call implementation :tools_request (request "analyze" lexical)) :ok) t))))))
)
