                   (host-key (if (= (get key :kind) 22) (aref host index) (js-call a :readString key))) (value (not (= (% (funcall next) 2) 0))))
              (js-call a :invoke "write" (js-array object key value)) (put expected host-key value)
              (unless (= (get key :kind) 22) (js-call a :release key)))))
          (let* ((keys (js-call a :invoke "keys" (js-array object))) (own (js-call a :invoke "symbols" (js-array object)))
                 (expected-symbols (Object/getOwnPropertySymbols expected)) (copy (js-call a :sourceObject (js-object)))
                 (assigned (js-call a :invoke "assign" (js-array copy object))))
            (deep (read a keys) (Object/keys expected)) (same (js-call a :length own) (js-length expected-symbols))
