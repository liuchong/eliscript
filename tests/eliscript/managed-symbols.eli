          (js-call assert :throws (lambda () (js-call js :run mode expected)) globalThis.TypeError)
          (rt-throws a "run" (js-array n trace) "ELI-RT0003") (deep (read a trace) expected) (release-all a (js-array trace n))))) (finish a))))
  (test "close preserves an existing error even when its own private frame cannot be allocated" (async ()
    (let* ((product (await (compiled))) (_ (finish (get product :a))) (e (exports-of (get product :bytes)))
           (heap (js-call e "heap-new" 16 8192 65536)) (roots (js-array)) (call (raw-call e heap))
           (array (funcall call "value-array-new" 0)))
      (funcall call "heap-pin" array) (js-call roots :push array)
      (let ((iterator (funcall call "value-source-iterator-new" array 2)) (full false))
        (funcall call "heap-pin" iterator) (js-call roots :push iterator) (funcall call "heap-auto" 1)
        (while (not full) (let ((number (uint32 (js-call e "value-number" heap 0 0))))
          (if (not (= (js-call e "last-error") 0)) (progn (same (js-call e "last-error") 2) (setq full t))
            (progn (funcall call "heap-pin" number) (js-call roots :push number)))))
        (same (js-call e "value-source-iterator-close" heap iterator 10) 0) (same (js-call e "last-error") 10)
        (each roots (lambda (item) (funcall call "heap-release" item))) (funcall call "heap-collect") (same (funcall call "heap-live") 0)))))
  (test "lexically shadowed Symbol methods capture the ordinary callee before argument mutation and well-known names read the shadow" (async ()
    (let* ((source (fixture 31)) (a (get (await (compiled source)) :a)) (fn (js-call a :invoke "factory"))
