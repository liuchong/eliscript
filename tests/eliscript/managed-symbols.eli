(module tests.managed-symbols
  (import "bun:test" beforeAll afterAll afterEach test)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:fs/promises" readFile mkdtemp rm mkdir readdir writeFile)
  (import "node:path" resolve relative delimiter)
  (import "node:url" pathToFileURL)
  (import "node:module" createRequire)
  (import "node:crypto" createHash)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/managed-browser-transport.mjs" loadManagedReference writeManagedReference runManagedNode bundleManagedBrowserPage serveManagedBrowserPage)

  (defvar directory undefined) (defvar b undefined) (defvar runtime undefined) (defvar family undefined)
  (defvar generationEvidence undefined)
  (defconst archive (readFileSync (resolve root "tests/wasm-managed-symbols-test-legacy.mjs") "utf8"))
  (defconst archive-sha "fe0fd09cd43e80b01617570dc7913d3a0bd006f8c0a7f0a945de3072a3efdbc6")
  (defconst cases (Array/from (js-call archive :matchAll (new globalThis.RegExp "^test\\('([^']+)'" "gm"))))
  (defconst wellKnownSymbolNames (js-array "iterator" "toPrimitive" "match" "replace" "search" "split" "species" "isConcatSpreadable" "toStringTag" "hasInstance" "asyncIterator" "unscopables" "matchAll" "dispose" "asyncDispose"))
  (defun same (&rest arguments) (Reflect/apply (get assert :strictEqual) assert arguments))
  (defun deep (&rest arguments) (Reflect/apply (get assert :deepStrictEqual) assert arguments))
  (defun each (items body) (js-call items :forEach body))
  (defun times (count body) (let ((index 0)) (while (< index count) (funcall body index) (setq index (1+ index)))))
  (defun instance-p (value type) (Reflect/apply (get type globalThis.Symbol.hasInstance) type (js-array value)))
  (defun code-error (code) (lambda (error) (and error (not (nullish? (get error :eliscriptDiagnostic))) (= (get (get error :eliscriptDiagnostic) :code) code))))
  (defun rt-throws (a name arguments code) (js-call assert :throws (lambda () (js-call a :invoke name arguments)) (code-error code)))
  (defun fixture (index)
    ;; Only the original Eliscript fixture string is data. Never execute the
    ;; archived test, helper JavaScript or a generated JavaScript template.
    (let* ((start (get (aref cases index) :index))
           (end (if (< (1+ index) (js-length cases)) (get (aref cases (1+ index)) :index) (js-length archive)))
           (region (js-call archive :slice start end)) (open (js-call region :indexOf "`"))
           (close (js-call region :indexOf "`" (1+ open))))
      (assert (and (>= open 0) (> close open)))
      (js-call (js-call region :slice (1+ open) close) :replace
        (new globalThis.RegExp "\\\\(u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|[nrtbfv0'\"`\\\\])" "g")
        (lambda (match escape)
          (cond ((js-call escape :startsWith "u") (globalThis.String.fromCharCode (globalThis.parseInt (js-call escape :slice 1) 16)))
            ((js-call escape :startsWith "x") (globalThis.String.fromCharCode (globalThis.parseInt (js-call escape :slice 1) 16)))
            ((= escape "n") "\n") ((= escape "r") "\r") ((= escape "t") "\t")
            ((= escape "b") (globalThis.String.fromCharCode 8)) ((= escape "f") (globalThis.String.fromCharCode 12))
            ((= escape "v") (globalThis.String.fromCharCode 11)) ((= escape "0") (globalThis.String.fromCharCode 0)) (t escape))))))
  (defasync compiled (&rest arguments)
    (let* ((source (if (or (= (js-length arguments) 0) (undefined? (aref arguments 0))) family (aref arguments 0)))
           (options (if (> (js-length arguments) 1) (aref arguments 1) undefined))
           (rt (if (> (js-length arguments) 2) (aref arguments 2) runtime))
           (p (js-call (get b :compiler) :compile_ir_string (str "(defconst symbol-marker 1)\n" source) "symbols.eli"))
           (before (JSON/stringify p))
           (bytes (globalThis.Uint8Array.from (js-call (get b :managed) :emit_managed_wasm p rt))))
      (same (JSON/stringify p) before)
      (deep (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let ((a (instantiateManagedRuntime bytes options))) (js-call a :auto 1) (js-object :a a :bytes bytes))))
  (defasync oracle (program) (await (loadManagedReference directory (js-call (get b :compiler) :emit_ir_string program) "symbol-oracle")))
  (defun box (a value) (cond ((= (value-type value) "string") (js-call a :string value)) ((= (value-type value) "number") (js-call a :number value)) (t value)))
  (defun text (a value) (let ((result (if (and value (= (get value :kind) 5)) (js-call a :readString value) value))) (js-call a :release value) result))
  (defun read (a value)
    (cond ((and value (= (get value :kind) 4)) (js-call a :readNumber value))
      ((and value (= (get value :kind) 5)) (js-call a :readString value))
      ((and value (= (get value :kind) 14)) (Array/from (js-object :length (js-call a :length value)) (lambda (unused index)
        (let ((item (js-call a :get value index))) (try (read a item) (finally (js-call a :release item))))))) (t value)))
  (defun release-all (a values) (each values (lambda (value) (js-call a :release value))))
  (defun finish (a &rest arguments)
    (release-all a (if (> (js-length arguments) 0) (aref arguments 0) (js-array)))
    (js-call a :closeModule) (js-call a :collect) (same (js-call a :live) 0) (same (get (js-call a :stats) :frameDepth) 0))
  (defun cold-runtime (bytes) (let ((a (instantiateManagedRuntime bytes (js-object :initializeModule false)))) (js-call a :auto 1) (js-call a :initializeModule) a))
  (defun inSymbolCase (a name operation)
    (try (funcall operation) (catch error
      (try (let ((stats (js-call a :stats))) (Object/defineProperty error "symbolCase" (js-object :value (js-object :name name :stats stats :statsJSON (JSON/stringify stats)) :enumerable t :configurable t))) (catch ignored nil)) (throw error))))
  (defun exports-of (bytes) (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
  (defun raw-call (e heap) (lambda (name &rest arguments)
    (let ((value (uint32 (Reflect/apply (get e name) e (js-call (js-array heap) :concat arguments))))) (same (js-call e "last-error") 0 name) value)))
  (defun node-case (mode arguments options)
    (runManagedNode (resolve root "tests/helpers/managed-symbols-node.mjs") (js-call (js-array mode) :concat arguments) options))
  (defasync simple-reference-case (index filename name &rest labels)
    (let* ((source (fixture index)) (a (get (await (compiled source)) :a))
           (js (await (oracle (js-call (get b :compiler) :compile_ir_string source filename))))
           (out (if (> (js-length labels) 0) (inSymbolCase a (aref labels 0) (lambda () (js-call a :invoke name))) (js-call a :invoke name))))
      (deep (read a out) (funcall (get js name))) (finish a (js-array out))))
  (defun rawSymbolHeapSummary (e heap)
    (let* ((view (new globalThis.DataView (get (get e :memory) :buffer)))
           (control (js-call view :getUint32 (+ heap 16) t)) (pool (js-call view :getUint32 (+ control 4) t))
           (base (js-call view :getUint32 (+ pool 16) t)) (slots (js-call view :getUint32 (+ control 12) t))
           (kinds (Object/create nil)) (builtins (Object/create nil)) (slot 1))
      (while (<= slot slots)
        (let ((entry (+ base (* slot 24))))
          (unless (= (bit-and (js-call view :getUint32 (+ entry 4) t) 1) 0)
            (let* ((block (+ base (js-call view :getUint32 (+ entry 8) t))) (kind (js-call view :getUint32 block t)))
              (put kinds kind (1+ (if (nullish? (get kinds kind)) 0 (get kinds kind))))
              (when (= kind 18)
                (let ((info (js-call view :getUint32 (+ block 24) t)))
                  (when (> info 3)
                    (let* ((record (+ base (* (bit-and info 1048575) 24))) (p (+ base (js-call view :getUint32 (+ record 8) t)))
                           (builtin (js-call view :getUint32 (+ p 20) t)))
                      (put builtins builtin (1+ (if (nullish? (get builtins builtin)) 0 (get builtins builtin)))))))))))
        (setq slot (1+ slot)))
      (js-object :live (js-call view :getUint32 (+ control 28) t) :used (js-call view :getUint32 (+ control 20) t) :kinds kinds :builtins builtins)))
  (defasync generations ()
    (if generationEvidence generationEvidence
      (let* ((files (js-call (js-call (await (readdir (resolve root "bootstrap/compiler"))) :filter (lambda (name) (js-call name :endsWith ".eli"))) :sort))
             (all (js-array b)) (previous b))
        (let ((generation 2))
          (while (<= generation 3)
            (let* ((output (resolve directory (str "g" generation))) (bootstrap (resolve output "bootstrap")))
              (await (mkdir bootstrap (js-object :recursive t)))
              (let ((index 0))
                (while (< index (js-length files))
                  (let* ((file (aref files index)) (path (resolve root "bootstrap/compiler" file))
                         (name (js-call file :replace (new globalThis.RegExp "\\.eli$") ".mjs"))
                         (emission (js-call (get previous :compiler) :compile_string_with_source_map (await (readFile path "utf8")) path name (relative bootstrap path))))
                    (await (writeFile (resolve bootstrap name) (str (get emission :javascript) "//# sourceMappingURL=" name ".map\n")))
                    (await (writeFile (resolve bootstrap (str name ".map")) (get emission :sourceMap))))
                  (setq index (1+ index))))
              (let* ((current (await (buildBackends (js-object :outputRoot output :frontend (get previous :compiler)))))
                     (compiler-path (resolve bootstrap "compiler.mjs")))
                (put current :compiler (funcall (createRequire compiler-path) compiler-path))
                (js-call all :push current) (setq previous current)))
            (setq generation (1+ generation))))
        (let* ((filename (resolve root "tests/fixtures/wasm-managed-symbols.eli")) (seed-file (resolve directory "symbols-seed.mjs"))
               (seed (spawnSync (resolve root "bin/eliscript-seed") (js-array "--output" seed-file filename) (js-object :encoding "utf8" :timeout 30000)))
               (_ (same (get seed :status) 0 (get seed :stderr))) (javascript (await (readFile seed-file "utf8")))
               (bytes (js-array)) (runtime-source (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8"))))
          (each all (lambda (current)
            (let* ((p (js-call (get current :compiler) :compile_ir_string family filename))
                   (rt (js-call (get current :compiler) :compile_ir_string runtime-source "runtime.eli")))
              (same (js-call (get current :compiler) :emit_ir_string p) javascript)
              (js-call bytes :push (globalThis.Uint8Array.from (js-call (get current :managed) :emit_managed_wasm p rt))))))
          (deep (aref bytes 0) (aref bytes 1)) (deep (aref bytes 1) (aref bytes 2))
          (setq generationEvidence (js-object :all all :bytes (aref bytes 2) :javascript javascript :filename filename))))))
  (defasync weak-case ()
    (let* ((unsupported "(defun run () (new (js* \"WeakRef\") (funcall (js* \"Symbol.for\") \"x\"))) (export run)")
           (p (js-call (get b :compiler) :compile_ir_string unsupported "symbol-unrepresented.eli")) (before (JSON/stringify p))
           (source (fixture 24)))
      (js-call assert :throws (lambda () (js-call (get b :managed) :emit_managed_wasm p runtime))
        (lambda (error) (and (funcall (code-error "ELI-B0001") error) (= (get (get (get error :eliscriptDiagnostic) :location) :file) "symbol-unrepresented.eli"))))
      (same (JSON/stringify p) before)
      (let* ((setup-start (js-call source :indexOf "(let* ((symbol "))
             (setup-end (js-call source :indexOf "\n     (js-call map :set symbol box)" setup-start))
             (setup (js-call source :slice setup-start setup-end))
             (phases (js-array
               (js-array "symbols" "\n          (box " "(Object/is registered (funcall (js* \"Symbol.for\") \"shared-weak-test\"))")
               (js-array "boxed" "\n          (prototype " "(Object/is (funcall (js* \"Object\") box) box)")
               (js-array "prototype" "\n          (map " "(js-array (Object/is valueOf (get box :valueOf)) (Object/is (js-call valueOf :call box) symbol) (js-call toString :call box) (js-call description :call box) (Object/is (js-call primitive :call box \"ignored\") symbol))")
               (js-array "weak" "\n          (array " "(js-array (js-call map :has symbol) (js-call set :has object) (js-call map :has fn))")
               (js-array "array-method" "\n          (iterator " "(js* \"typeof method\")")
               (js-array "iterator" nil "(js-array (Object/is method (get array :values)) (get (js-call iterator :next) :value) (get (js-call iterator :next) :value) (get (js-call iterator :next) :done))")))
             (names (js-call phases :map (lambda (entry) (str "supported-stage-" (aref entry 0)))))
             (definitions (js-call (js-call phases :map (lambda (entry)
               (let* ((name (aref entry 0)) (marker (aref entry 1)) (expression (aref entry 2))
                      (end (if (nil? marker) (js-length setup) (js-call setup :indexOf marker))))
                 (assert (> end 0) name)
                 (str "(defun supported-stage-" name " () " (js-call setup :slice 0 end) (if (nil? marker) "" ")") " " expression "))")))) :join "\n")))
        (assert (and (> setup-start 0) (> setup-end setup-start)))
        (setq source (js-call source :replace " (export supported " (str definitions "\n (export " (js-call names :join " ") " supported ")))
        (let* ((product (await (compiled source))) (a (get product :a)) (bytes (get product :bytes))
               (js (await (oracle (js-call (get b :compiler) :compile_ir_string source "symbol-supported-oracle.eli")))) (roots (js-array)))
          (try
            (let ((errors (js-array)))
              (each names (lambda (name)
                (let ((stage (cold-runtime bytes)))
                  (try
                    (let ((out (inSymbolCase stage name (lambda () (js-call stage :invoke name)))))
                      (try (deep (read stage out) (funcall (get js (js-call name :replaceAll "-" "_"))) name) (finally (js-call stage :release out))))
                    (catch error (js-call errors :push error)) (finally (finish stage))))))
              (when (> (js-length errors) 0) (throw (new globalThis.AggregateError errors "weak collection and boxed Symbol setup stages"))))
            (let ((out (inSymbolCase a "weak collections and boxed Symbol prototype methods" (lambda () (js-call a :invoke "supported")))))
              (js-call roots :push out) (deep (read a out) (js-call js :supported)) (js-call a :collect) (same (get (js-call a :stats) :frameDepth) 0))
            (let ((registered (js-call a :invoke "registered-key")) (number (js-call a :number 1)))
              (js-call roots :push registered number)
              (each (js-array "invalid-weak-key" "invalid-weak-set") (lambda (name)
                (each (js-array (js-array registered (js-call js :registered_key)) (js-array nil nil) (js-array false false) (js-array number 1)) (lambda (entry)
                  (let ((trace (js-call a :sourceArray (js-array))) (expected (js-array)))
                    (try
                      (let* ((reference (funcall (get js (js-call name :replaceAll "-" "_")) (aref entry 1) expected))
                             (result (js-call a :invoke name (js-array (aref entry 0) trace))))
                        (try (same (aref reference 0) "TypeError") (deep (read a result) reference) (finally (js-call a :release result))))
                      (deep (read a trace) expected) (same (get (js-call a :stats) :frameDepth) 0)
                      (finally (js-call a :release trace))))))))
              (let ((object (js-call a :sourceObject (js-object))))
                (js-call roots :push object)
                (each (js-array (js-array nil nil) (js-array number 1) (js-array object (js-object))) (lambda (entry)
                  (let ((trace (js-call a :sourceArray (js-array))) (expected (js-array)))
                    (try (js-call assert :throws (lambda () (js-call js :invalid_symbol_receiver (aref entry 1) expected)) globalThis.TypeError)
                      (rt-throws a "invalid-symbol-receiver" (js-array (aref entry 0) trace) "ELI-RT0003")
                      (deep (read a trace) expected) (same (get (js-call a :stats) :frameDepth) 0)
                      (finally (js-call a :release trace))))))))
            (finally (finish a roots)))))))
  (beforeAll (async ()
    (same (js-call (js-call (createHash "sha256") :update archive) :digest "hex") archive-sha)
    (same (js-length cases) 35)
    (await (mkdir (resolve root "_worktree") (js-object :recursive t)))
    (setq directory (await (mkdtemp (resolve root "_worktree/managed-symbols-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
    (setq family (await (readFile (resolve root "tests/fixtures/wasm-managed-symbols.eli") "utf8")))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (afterEach (lambda () (js-call globalThis.Bun :gc t)))

  (test "BigInt parsing handles ordinary decimal and empty strings independently of radix prefixes and preserves roots across invalid input and GC" (async ()
    (let* ((valid (js-array (js-array "" "0") (js-array " " "0") (js-array "0" "0") (js-array "1" "1") (js-array "-1" "-1") (js-array "+1" "1") (js-array "-0" "0") (js-array "00" "0") (js-array "001" "1") (js-array "  -42  " "-42") (js-array "0x2a" "42") (js-array "0XFF" "255") (js-array "0o77" "63") (js-array "0b101" "5") (js-array "9007199254740993" "9007199254740993")))
           (invalid (js-array "+" "-" "1n" "1.0" "Infinity" "0x" "-0x1" "+0b1" "0b2" "12z"))
           (oracle (node-case "bigint" (js-array) (js-object :input (JSON/stringify (js-object :valid (js-call valid :map (lambda (entry) (aref entry 0))) :invalid invalid)) :encoding "utf8" :timeout 10000)))
           (host-differences (js-array)))
      (same (get oracle :status) 0 (get oracle :stderr)) (js-call assert :ifError (get oracle :error))
      (deep (JSON/parse (get oracle :stdout)) (js-object :valid (js-call valid :map (lambda (entry) (js-object :value (aref entry 1)))) :invalid (js-call invalid :map (lambda () (js-object :error "SyntaxError")))))
      (each invalid (lambda (value)
        (try (js-call host-differences :push (js-object :text value :value (js-call (funcall globalThis.BigInt value) :toString)))
          (catch error (unless (instance-p error globalThis.SyntaxError) (js-call host-differences :push (js-object :text value :error (get error :name))))))))
      (when (> (js-length host-differences) 0) (console/info "[BigInt host parser differences]" (JSON/stringify host-differences)))
      (let* ((product (await (compiled "(defun identity (value) value) (export identity)")))
             (_ (finish (get product :a))) (e (exports-of (get product :bytes)))
             (heap (js-call e "heap-new" 128 16384 1048576)) (call (raw-call e heap))
             (frame (funcall call "frame-new" 4)) (zero (funcall call "value-number" 0 2147483648)))
        (funcall call "frame-set" frame 0 zero) (funcall call "heap-auto" 1)
        (let ((input (lambda (value)
                (let ((out (funcall call "value-string" (js-length value))))
                  (funcall call "frame-set" frame 1 out)
                  (times (js-length value) (lambda (index) (funcall call "value-unit-set" out index (js-call value :charCodeAt index))))
                  (funcall call "value-seal" out) out)))
              (roots (lambda ()
                (funcall call "heap-collect") (same (funcall call "frame-depth") 1)
                (let* ((saved (funcall call "frame-get" frame 0)) (address (funcall call "value-data" saved 4)))
                  (assert (Object/is (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getFloat64 address t) -0.0))))))
          (try
            (each valid (lambda (entry)
              (let* ((value (funcall call "value-bigint-parse" (funcall input (aref entry 0)))) (expected (aref entry 1)))
                (assert (> value 3) (aref entry 0)) (same (funcall call "value-kind" value) 34 (aref entry 0))
                (funcall call "frame-set" frame 2 value)
                (let ((rendered (funcall call "value-bigint-to-string" value 10)))
                  (funcall call "frame-set" frame 3 rendered) (same (funcall call "value-length" rendered) (js-length expected) (aref entry 0))
                  (times (js-length expected) (lambda (index) (same (funcall call "value-unit-get" rendered index) (js-call expected :charCodeAt index) (aref entry 0)))))
                (funcall roots) (each (js-array 1 2 3) (lambda (slot) (funcall call "frame-set" frame slot 0))))))
            (each invalid (lambda (value)
              (same (js-call e "value-bigint-parse" heap (funcall input value)) 0 value)
              (same (js-call e "last-error") 3 value) (funcall roots) (funcall call "frame-set" frame 1 0)))
            (let ((recovered (funcall call "value-bigint-parse" (funcall input "1"))))
              (same (funcall call "value-kind" recovered) 34) (funcall call "frame-set" frame 2 recovered) (funcall roots))
            (finally (funcall call "frame-pop" frame) (funcall call "heap-collect") (same (funcall call "heap-live") 0) (same (funcall call "frame-depth") 0))))))) 120000)

  (test "existing own data writes preserve attributes and refusal semantics while accessors receivers holes lengths and key effects use ordinary Set" (async ()
    (let* ((source (fixture 1)) (program (js-call (get b :compiler) :compile_ir_string source "own-data-write.eli"))
           (reference (await (oracle program))) (a (get (await (compiled source)) :a))
           (zero (js-call a :number -0.0)) (frame (js-call a :frame 1)))
      (js-call a :frameSet frame 0 zero)
      (let ((check (lambda (name &rest arguments)
        (let* ((args (if (> (js-length arguments) 0) (aref arguments 0) (js-array)))
               (owned (js-call (js-call args :filter (lambda (value) (= (value-type value) "number"))) :map (lambda (value) (js-call a :number value))))
               (index 0) (input (js-call args :map (lambda (value) (if (= (value-type value) "number") (let ((saved (aref owned index))) (setq index (1+ index)) saved) value)))) (result undefined))
          (try (setq result (js-call a :invoke name input))
            (deep (read a result) (Reflect/apply (get reference (js-call name :replaceAll "-" "_")) undefined args))
            (js-call a :collect) (same (get (js-call a :stats) :frameDepth) 1) (assert (Object/is (js-call a :readNumber zero) -0.0))
            (finally (unless (undefined? result) (js-call a :release result)) (each owned (lambda (value) (js-call a :release value)))))))))
        (try
          (each (js-array false t) (lambda (array)
            (each (js-array 0 1 2) (lambda (locked) (funcall check "data-slot" (js-array array locked))))
            (funcall check "accessor-slot" (js-array array))))
          (each (js-array "receiver-slot" "hole-slot" "length-slot" "key-effects") (lambda (name) (funcall check name)))
          (finally (js-call a :leaveFrame frame) (finish a (js-array zero))))))) 120000)

  (test "cold Symbol creation defers unobserved members while every first reflection materializes the same complete realm and retries after capacity refusal" (async ()
    (let* ((source (fixture 2)) (product (await (compiled source))) (bytes (get product :bytes))
           (_ (finish (get product :a)))
           (stages (js-array "first-names" "prototype-links" "description-shape" "description-call" "string-call" "primitive-call" "registry-dynamic" "registry-static" "registry-call"))
           (program (js-call (get b :compiler) :compile_ir_string source "cold-symbol-observation.eli"))
           (javascript (js-call (get b :compiler) :emit_ir_string program))
           (path (await (writeManagedReference directory javascript "cold-symbol")))
           (reference (node-case "cold" (js-array path (JSON/stringify stages)) (js-object :encoding "utf8" :timeout 30000)))
           (_status (same (get reference :status) 0 (get reference :stderr))) (expected (JSON/parse (get reference :stdout))))
      (let* ((a (cold-runtime bytes)) (held (js-call a :number -0.0)) (frame (js-call a :frame 1)))
        (js-call a :frameSet frame 0 held)
        (try
          (let ((errors (js-array)))
            (each stages (lambda (name)
              (try (let ((out (inSymbolCase a (str "cold Symbol stage " name) (lambda () (js-call a :invoke name)))))
                (try (deep (read a out) (get (get expected :stages) name) name) (finally (js-call a :release out))))
                (catch error (js-call errors :push error)))
              (js-call a :collect) (same (get (js-call a :stats) :frameDepth) 1) (assert (Object/is (js-call a :readNumber held) -0.0))))
            (when (> (js-length errors) 0) (throw (new globalThis.AggregateError errors "cold Symbol independent observation stages"))))
          (finally (js-call a :leaveFrame frame) (finish a (js-array held)))))
      (each (js-array 0 1 2 3 4) (lambda (mode)
        (let* ((a (cold-runtime bytes)) (input (js-call a :number mode)) (held (js-call a :number -0.0)) (frame (js-call a :frame 1)))
          (js-call a :frameSet frame 0 held)
          (try (times 2 (lambda (repeat)
