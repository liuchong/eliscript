              (same (js-call a :invoke "member" (js-array copy (aref symbols index))) (get expected (aref host index)))))
            (release-all a (js-call (js-array object keys own copy assigned) :concat symbols)))))) (finish a))))
  (test "nullish primitive hooks fall back, non-callable hooks fail and object hook results are rejected without calling fallback methods" (async ()
    (let ((a (get (await (compiled (fixture 27))) :a)))
      (each (js-array nil undefined) (lambda (hook) (let* ((trace (js-call a :sourceArray (js-array))) (out (js-call a :invoke "run" (js-array hook trace))))
        (same (text a out) "text") (deep (read a trace) (js-array "fallback")) (js-call a :release trace))))
      (each (js-array false t (js-call a :number 0)) (lambda (hook) (let ((trace (js-call a :sourceArray (js-array))))
        (rt-throws a "run" (js-array hook trace) "ELI-RT0003") (same (js-call a :length trace) 0) (release-all a (js-array trace hook)))))
      (let ((trace (js-call a :sourceArray (js-array)))) (rt-throws a "bad" (js-array trace) "ELI-RT0003") (same (js-call a :length trace) 0) (finish a (js-array trace))))))
