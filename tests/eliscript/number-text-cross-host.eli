(module tests.number-text-cross-host
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "../../bootstrap/host/bun.mjs" loadCompiler)
  (defasync main ()
    (let* ((input (JSON/parse (readFileSync 0 "utf8")))
           (module (await (loadCompiler (get input :directory))))
           (samples (get input :samples)) (view (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
      (js-call samples :forEach (lambda (sample)
        (let ((words (get sample :words)) (texts (get sample :texts)))
          (js-call view :setUint32 0 (aref words 0)) (js-call view :setUint32 4 (aref words 1))
          (let ((number (js-call view :getFloat64 0)) (radix 2))
            (while (<= radix 36)
              (js-call assert :strictEqual (js-call module :f number radix) (aref texts (- radix 2)))
              (js-call assert :strictEqual (js-call module :dynamic number "toString" radix) (aref texts (- radix 2)))
              (setq radix (1+ radix)))))))
      (console/log (JSON/stringify (js-object :samples (js-length samples) :radices 35)))))
  (js-call (main) :catch (lambda (error) (console/error error) (put globalThis.process :exitCode 1))))
