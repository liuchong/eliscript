(module tests.dogfood-browser
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm stat)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "./helpers/performance-acceptance.mjs" currentPerformanceTest)
  (defconst project (resolve root "examples/dogfood"))
  (defvar staging undefined) (defvar bundle undefined) (defvar size undefined)
  (defasync run (command)
    (let* ((child (js-call globalThis.Bun :spawn command (js-object :cwd root :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text)
             (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref result 0) :stdout (aref result 1) :stderr (aref result 2))))
  (beforeAll (async ()
    (setq staging (await (mkdtemp (resolve root ".eliscript-dogfood-browser-"))))
    (let ((compiled (await (run (js-array (resolve root "bin/eliscript-build") "--no-cache"
             "--root" "examples/dogfood" "--out-dir" staging "examples/dogfood/src/renderer/browser.eli")))))
      (unless (= (get compiled :exitCode) 0)
        (throw (new globalThis.Error (if (= (js-length (js-call (get compiled :stderr) :trim)) 0)
          (js-call (get compiled :stdout) :trim) (js-call (get compiled :stderr) :trim))))))
    (setq bundle (resolve staging "browser.js"))
    (let ((built (await (run (js-array "bun" "build" (resolve staging "src/renderer/browser.mjs")
             "--target=browser" "--format=iife" "--outfile" bundle)))))
      (unless (= (get built :exitCode) 0) (throw (new globalThis.Error (str (get built :stderr) (get built :stdout))))))
    (setq size (get (await (stat bundle)) :size))))
  (afterAll (async () (when staging (await (rm staging (js-object :recursive t :force t))))))
  (test "the browser entry bundles to one classic script"
    (async ()
      (let* ((source (await (readFile bundle "utf8"))) (scanner (new globalThis.Bun.Transpiler (js-object :loader "js"))))
        ;; Literal namespace names and bundler comments are data. The parser's
        ;; actual imports, rather than a substring, define unresolved edges.
        (js-call assert :deepStrictEqual (get (js-call scanner :scan source) :imports) (js-array))
        (js-call assert :doesNotMatch source (new globalThis.RegExp "^\\s*import\\s" "mu"))
        (js-call assert :ok (js-call source :includes "data-theme"))
        (js-call assert :ok (js-call source :includes "dogfood-search-index"))
        (js-call assert :ok (js-call source :startsWith "(")))))
  (test "the browser bundle retains native array boundaries without the portable collection runtime"
    (async ()
      (let ((source (await (readFile bundle "utf8"))))
        (js-call assert :ok (not (js-call source :includes "literals.mjs")))
        (js-call assert :ok (not (js-call source :includes "HAMT"))))))
  (funcall (currentPerformanceTest test) "the bundle stays free of the portable collection runtime"
    (async ()
      (let ((source (await (readFile bundle "utf8"))))
        (js-call assert :ok (not (js-call source :includes "literals.mjs")))
        (js-call assert :ok (not (js-call source :includes "HAMT")))
        (js-call assert :ok (< size (* 64 1024))))))
  (test "the shell emits the search configuration and the theme control"
    (async ()
      (let ((source (await (readFile (resolve project "src/renderer/theme.eli") "utf8"))))
        (js-call assert :ok (js-call source :includes "name=\\\"dogfood-search-index\\\""))
        (js-call assert :ok (js-call source :includes "name=\\\"dogfood-root\\\""))
        (js-call assert :ok (js-call source :includes "id=\\\"theme-toggle\\\""))
        (js-call assert :ok (js-call source :includes "<script src=\\\"\" root \"assets/browser.js\\\">"))
        (js-call assert :ok (js-call source :includes ":root:not([data-theme=light])"))
        (js-call assert :ok (js-call source :includes ":root[data-theme=dark]"))
      )))
  (test "the search page declares its island and a no-script fallback"
    (async ()
      (let ((source (await (readFile (resolve project "src/renderer/server.eli") "utf8"))))
        (js-call assert :ok (js-call source :includes "id=\\\"search-input\\\""))
        (js-call assert :ok (js-call source :includes "id=\\\"search-results\\\""))
        (js-call assert :ok (js-call source :includes "<noscript>"))
        (js-call assert :ok (js-call source :includes "render-search-page"))
      )))
  (test "the site build requires the browser asset instead of shipping a broken page"
    (async ()
      (let ((source (await (readFile (resolve project "src/builder/main.eli") "utf8"))))
        (js-call assert :ok (js-call source :includes "DOGFOOD-BUILD-003"))
        (js-call assert :ok (js-call source :includes "browser-bundle"))
        (js-call assert :ok (js-call source :includes ":path \"assets/browser.js\""))
      )))
  (test "the browser module reaches the host through explicit boundaries"
    (async ()
      (let ((source (await (readFile (resolve project "src/renderer/browser.eli") "utf8"))))
        (js-call assert :ok (js-call source :includes "browserCapabilities (js* \"globalThis\")"))
        (js-call assert :ok (js-call source :includes "(js-array \"document\" \"network\" \"timers\")"))
        (js-call assert :ok (js-call source :includes "localStorage"))
      )))
)
