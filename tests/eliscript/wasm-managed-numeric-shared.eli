(module tests.managed-numeric-shared
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm realpath)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:module" createRequire)
  (import "../../tools/backends/build.mjs" buildBackends root)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime loadManagedHostModules)
  (defasync loadReference (path source)
    ;; The actual emitted file provides the package-resolution base. Supply
    ;; its real ESM namespace to the loader, including on Bun; a data URL has
    ;; no base for the production runtime's bare package imports.
    (await (writeFile path source))
    (let* ((canonical (await (realpath path)))
           (namespace (funcall (createRequire canonical) canonical))
           (loaded (await (loadManagedHostModules (js-object :hostModules
             (js-array (js-object :id "reference" :specifier (get (pathToFileURL canonical) :href)
               :referrer "reference.mjs" :allowedExports (js-array) :namespace t)))
             (js-object :hostModules (new globalThis.Map (js-array (js-array "reference" namespace))))))))
      (js-call assert :strictEqual (js-call loaded :get "reference") namespace)
      (js-call loaded :get "reference")))
  (defasync makeFixture (name &rest arguments)
    (let* ((options (if (> (js-length arguments) 0) (aref arguments 0) undefined))
           (directory (await (mkdtemp (resolve (tmpdir) (+ "eliscript-managed-" name "-")))))
           (backend (await (buildBackends (js-object :outputRoot directory))))
           (runtimeProgram (js-call (get backend :compiler) :compile_ir_string
             (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
           (source (await (readFile (resolve root (+ "tests/fixtures/wasm-managed-" name ".eli")) "utf8")))
           (program (js-call (get backend :compiler) :compile_ir_string source (+ name ".eli")))
           (bytes (globalThis.Uint8Array.from
             (js-call (get backend :managed) :emit_managed_wasm program runtimeProgram options)))
           (path (resolve directory (+ name "-reference.mjs"))))
      (assert (globalThis.WebAssembly.validate bytes))
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (js-object :directory directory :backend backend :runtimeProgram runtimeProgram :source source
        :program program :bytes bytes :js (await (loadReference path (js-call (get backend :compiler) :emit_ir_string program))))))
  (defasync closeFixture (fixture)
    (when fixture (await (rm (get fixture :directory) (js-object :recursive t :force t)))))
  (defun box (runtime value)
    (cond ((= (value-type value) "number") (js-call runtime :number value))
          ((= (value-type value) "string") (js-call runtime :string value)) (t value)))
  (defun read (runtime value)
    (if (and value (= (value-type value) "object"))
      (cond ((= (get value :kind) 4) (js-call runtime :readNumber value))
            ((= (get value :kind) 5) (js-call runtime :readString value)) (t value)) value))
  (defun check (fixture runtime name inputs)
    (let ((handles (js-call inputs :map (lambda (value) (box runtime value)))) (result undefined))
      (try
        (setq result (js-call runtime :invoke name handles))
        (assert (Object/is (read runtime result)
          (Reflect/apply (get (get fixture :js) (js-call name :replaceAll "-" "_")) undefined inputs)) name)
        (finally
          (js-call runtime :release result)
          (js-call handles :forEach (lambda (handle) (js-call runtime :release handle)))))
      (js-call runtime :collect)
      (js-call assert :strictEqual (js-call runtime :live) 0)
      (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)))
  (defun rawNumber (exports heap value)
    (let ((view (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
      (js-call view :setFloat64 0 value t)
      (funcall (get exports "value-number") heap (js-call view :getUint32 0 t) (js-call view :getUint32 4 t))))
  (defun rawRead (exports heap value)
    (js-call (new globalThis.DataView (get (get exports :memory) :buffer)) :getFloat64
      (funcall (get exports "value-data") heap value 4) t))
  (export makeFixture closeFixture box read check rawNumber rawRead loadReference))
