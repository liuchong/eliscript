(module tests.dogfood-workflow-install
  (import "bun:test" :as framework)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "../../tools/backends/build.mjs" root)
  (import "./direct-wasm-registration.mjs" createDirectWasmRegistration)
  (import "./dogfood-action-source.mjs" runSourceWorkflowCase ensureDogfoodBrowser)
  (defconst original (Object/assign (js-object) framework))
  (js-call assert :strictEqual
    (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root "tests/dogfood-workflow-test-ground.mjs"))) :digest "hex")
    "2d120a43ab6ce10c594a2dc3cc5d4d7e0d7c83d68d13397b4a6cce82eef37a74")
  (defconst registration (createDirectWasmRegistration original (js-object
    "the template checks out the consumer repository and invokes the action" runSourceWorkflowCase)))
  (defvar restored false)
  (defun restore ()
    (unless restored (js-call (get original :mock) :module "bun:test" (lambda () original)) (setq restored t)))
  (defasync completeWorkflowRegistration () (try (js-call registration :complete) (await (ensureDogfoodBrowser)) (finally (restore))))
  (js-call original :beforeAll completeWorkflowRegistration)
  (js-call original :afterAll restore)
  (js-call (get original :mock) :module "bun:test" (lambda () (get registration :exports)))
  (export completeWorkflowRegistration))
