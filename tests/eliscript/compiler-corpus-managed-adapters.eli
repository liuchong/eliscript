            (put record :id (+ "stable-compatibility:program:persistent-core-exit-" collection))
            (put record :entry "value.mjs")
            (put record :modules (js-array (js-object :id "value.mjs" :filename "stdlib/value.eli" :source "(defconst value 1)")))
            (put original :fixture "stdlib/value.eli")
            (put original :host "tests/fixtures/persistent-core-exit-host.mjs")
            (put execution :host "tests/fixtures/persistent-core-exit-host.mjs")
            (put execution :arguments (js-array (js-object :directory t) (js-object :literal collection)))
            (let* ((before (globalThis.structuredClone record))
                   (acceptance (compilerCorpusRuntimeAcceptance record options)))
              (js-call assert :deepStrictEqual (get acceptance :originalRuntimeOptions)
                (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216 :auto 0))
              (js-call assert :deepStrictEqual (get acceptance :effectiveRuntimeOptions)
                (Object/assign (js-object) (get resources :budget) (js-object :auto (get resources :auto))))
              (js-call assert :strictEqual (get acceptance :effectiveRuntimeProfile) "full-compiler")
              (js-call assert :strictEqual (get acceptance :resourceAcceptance) "deferred")
              (js-call (js-array "wasm" "native") :forEach (lambda (target)
                (js-call assert :deepStrictEqual (get (compilerCorpusRequest record target options) :memory) (get resources :memory))))
              (js-call assert :deepStrictEqual record before)
              (put execution :runtimeOptions (js-object :maxSlots 64))
              (js-call assert :strictEqual (compilerCorpusRuntimeAcceptance record options) undefined)
              (Reflect/deleteProperty execution "runtimeOptions")
              (put original :host "tests/fixtures/another-host.mjs")
              ;; The original core-exit admission is bound to its real host.
              ;; An unrelated host is refused rather than gaining resources.
              (js-call assert :strictEqual (compilerCorpusRuntimeAcceptance record options) undefined)
              (put original :host "tests/fixtures/persistent-core-exit-host.mjs")
              (put (aref (get execution :arguments) 1) :literal "another")
              (js-call assert :strictEqual (get (compilerCorpusRuntimeAcceptance record options) :effectiveRuntimeProfile) "small"))))))))

  (test "functional small never overrides explicitly bounded or negative normal-program contracts"
    (lambda ()
      (let ((changes (js-array
        (lambda (record) (put (get record :execution) :runtimeOptions (js-object :maxSlots 64)))
        (lambda (record) (put record :error (js-object :code "ELI-RT0002")))
        (lambda (record) (put record :id "original-program:stdlib-capacity-recovery"))
        (lambda (record) (put record :kind "sequence"))
        (lambda (record) (put (get record :expected) :oracleRequired false))
        (lambda (record) (put (get record :execution) :runtimeProfile "compiler"))
        (lambda (record) (put record :id "original-managed-fixture:persistent-vector-auto-1:node")))))
        (js-call changes :forEach (lambda (change)
          (let* ((record (normal-resource-record)) (options (js-object :functionalRuntimeProfile "small")))
            (funcall change record)
            (js-call assert :strictEqual (compilerCorpusRuntimeAcceptance record options) undefined)))))))

  (test "source map companions use the selected actual dependency plan and retain all raw source assets and first failures"
    (async ()
      (let* ((entry (js-object :id "main.mjs" :filename "main.eli" :source "(import \"./dep.mjs\" value) (export value)"))
             (dependency (js-object :id "dep.mjs" :filename "dep.eli" :source "(defconst value -0) (export value)"))
             (unused (js-object :id "unused.mjs" :filename "unused.eli" :source "(defconst unused 3) (export unused)"))
             (record (js-object :id "original-program:source-map-contract" :kind "project" :entry "main.mjs"
               :modules (js-array entry dependency unused) :request (js-object :operation "project" :entries (js-array "main.mjs"))
               :execution (js-object :kind "original-program" :compilerSourceMaps t)))
             (before (globalThis.structuredClone record)) (calls (js-array))
             (context (js-object :record record :target "wasm" :options (js-object) :session (js-object
               :request (async (request configuration)
                 (js-call calls :push request)
                 (js-call assert :strictEqual (get request :operation) "project-plan")
                 (js-call assert :deepStrictEqual (get request :entries) (js-array "main.mjs"))
                 (js-call assert :deepStrictEqual (get request :modules) (get record :modules))
                 (js-object :format "eliscript-project-plan" :version 1 :mode "standard"
                   :entries (js-array "main.mjs") :modules
                     (js-array (js-object :id "dep.mjs" :dependencies (js-array))
                               (js-object :id "main.mjs" :dependencies (js-array "dep.mjs"))))))))
             (configured (await (prepareCompilerCorpusSourceMapContext context))))
        (js-call assert :strictEqual (js-length calls) 1)
        (js-call assert :strictEqual (get configured :session) (get context :session))
        (js-call assert :deepStrictEqual (get (get configured :record) :modules) (js-array entry dependency))
        (js-call assert :deepStrictEqual (get (get (get configured :record) :request) :entries) (js-array "main.mjs"))
        (js-call assert :strictEqual (get (get (get configured :record) :execution) :compilerSourceMaps) t)
        (js-call assert :deepStrictEqual record before)
        (let ((failure false))
          (put (get context :session) :request (async (request configuration) (throw failure)))
          (await (js-call assert :rejects (lambda () (prepareCompilerCorpusSourceMapContext context))
            (lambda (error) (eq error failure))))))
      (let ((context (js-object :record (normal-resource-record) :target "wasm")))
        (js-call assert :strictEqual (await (prepareCompilerCorpusSourceMapContext context)) context))))

  (test "the unrelated canonical-looking import reaches the original managed linker refusal without a host dependency preflight"
    (async ()
      (let* ((reader (createOriginalCorpusSourceReader (js-object :sourceRoot root)))
             (filename "tests/wasm-managed-core-modules.test.mjs")
             (source (await (js-call reader :text filename)))
             (baseline (js-array)) (actual (js-array))
             (options (js-object :sourceRoot root :text (get reader :text) :file (get reader :file)
               :stableFiles (new globalThis.Set (js-array "tests/fixtures/wasm-managed-core-modules.eli"))
               :locators (js-array (js-object :file filename :id "original-core-unrelated-refusal"
                 :contains "no actual source library"))
               :add (lambda (record) (js-call baseline :push record)))))
        (await (js-call legacy :addOriginalManagedLibraryAdapters options))
        (let ((before (globalThis.structuredClone baseline)))
          (await (addOriginalManagedLibraryAdapters (Object/assign (js-object) options
            (js-object :add (lambda (record) (js-call actual :push record))))))
          (let* ((original (js-call baseline :find (lambda (record)
                             (= (get record :id) "original-managed:core-modules:missing-private-graph"))))
                 (changed (js-call actual :find (lambda (record) (= (get record :id) (get original :id)))))
                 (expected (globalThis.structuredClone baseline))
                 (expected-record (js-call expected :find (lambda (record) (= (get record :id) (get original :id)))))
                 (step (js-call (get expected-record :steps) :find (lambda (step) (= (get step :id) "unrelated-path-refusal")))))
            (js-call assert :ok (js-call source :includes "backend.managed.lower_managed_project(unrelated,entry,runtimeIR,{literalModules})"))
            (js-call assert :strictEqual (get (get step :request) :resolveImports) t)
            (put (get step :request) :resolveImports false)
            (js-call assert :deepStrictEqual (get step :error) (js-object :code "ELI-B0001" :phase "managed-link"))
            (js-call assert :strictEqual (js-length (get changed :steps)) 8)
            (js-call actual :forEach (lambda (record)
              (let ((prior (js-call expected :find (lambda (item) (= (get item :id) (get record :id))))))
                (js-call assert :deepStrictEqual
                  (retained-observation-execution record prior) (get prior :execution))
                (js-call (Object/keys prior) :forEach (lambda (key)
                  (unless (or (= key "execution") (= key "original"))
                    (js-call assert :deepStrictEqual (get record key) (get prior key)))))
                (let ((metadata (Object/assign (js-object) (get record :original))))
                  (Reflect/deleteProperty metadata "sourceAssets")
                  (Reflect/deleteProperty metadata "observationTransport")
                  (js-call assert :deepStrictEqual metadata (get prior :original))))))
            (js-call assert :deepStrictEqual changed expected-record)
            (js-call assert :deepStrictEqual baseline before))))))

  (defasync authenticated-process-request (record old)
    (let* ((files (js-array "tools/backends/eliscript/compiler-corpus-process.eli"
                    "tools/backends/compiler-corpus-process.mjs"))
           (proofs (js-array)) (index 0)
           (id (js-call posix :join (js-call posix :dirname (get (get record :execution) :host))
                 "compiler-corpus-process.mjs"))
           (sources (js-call (or (get (get old :request) :hostSources) (js-array)) :slice)))
      (js-call assert :strictEqual (js-length (js-call sources :filter
        (lambda (source) (= (get source :id) id)))) 0)
      (while (< index (js-length files))
        (let* ((file (aref files index)) (bytes (await (readFile (resolve root file))))
               (proof (js-object :file file :bytes (js-length bytes) :sourceSha256 (hash bytes))))
          (js-call proofs :push proof)
          (js-call assert :deepStrictEqual
            (js-call (get (get record :original) :sourceAssets) :filter
              (lambda (asset) (= (get asset :file) file))) (js-array proof))
          (when (= index 1)
            (let ((source (js-call bytes :toString "utf8")))
              (js-call assert :ok (js-call bytes :equals (Buffer/from source "utf8")))
              (js-call sources :push (js-object :id id :filename file :source source)))))
        (setq index (1+ index)))
      (js-call assert :deepStrictEqual (get (get record :original) :processHostDependency)
        (js-object :version 1 :id id :sourceAssets proofs))
      (Object/assign (js-object) (get old :request) (js-object :hostSources sources))))

  (test "sequence adapters retain original assertion bytes and all current source algorithms after Eli suite migration"
    (async ()
      (let* ((state (await (services))) (options (get state :options))
             (source (get state :source)) (baseline (js-array))
             (old-options (Object/assign (js-object) options
               (js-object :text (async (filename)
                  (if (= filename suite) source (await (funcall (get options :text) filename))))
                 :add (lambda (record) (js-call baseline :push record))))))
        (await (js-call legacy :addOriginalManagedLibraryAdapters old-options))
        (await (addOriginalManagedLibraryAdapters options))
        (let ((records (get state :records)) (index 0) (process-hosts 0))
          (js-call assert :ok (> (js-length records) 0))
          (js-call assert :strictEqual (js-length records) (js-length baseline))
          (while (< index (js-length records))
            (let* ((record (aref records index)) (old (aref baseline index))
                   (original (get record :original)) (proof (get original :assertionSource)))
              (js-call assert :strictEqual (get record :id) (get old :id))
              (js-call assert :deepStrictEqual (get record :coverage) (get old :coverage))
              (js-call (js-array "entry" "memory" "auto" "expected") :forEach
                (lambda (key) (js-call assert :deepStrictEqual (get record key) (get old key))))
              (if (js-call (js-array "original-managed:sequence-data-standard-identities:node:auto-65536"
                      "original-managed:sequence-data-standard-identities:bun:auto-65536") :includes (get record :id))
                (progn
                  (setq process-hosts (1+ process-hosts))
                  (js-call assert :deepStrictEqual (get record :request)
                    (await (authenticated-process-request record old))))
                (progn
                  (js-call assert :deepStrictEqual (get record :request) (get old :request))
                  (js-call assert :strictEqual (Object/hasOwn original "processHostDependency") false)))
              ;; The original test emits each real source at its output ID.
              ;; Physical source identity remains in the archived assets, and
              ;; every original algorithm is retained byte for byte.
              (js-call (get old :modules) :forEach (lambda (module)
                (let ((actual (js-call (get record :modules) :find
                                (lambda (item) (= (get item :id) (get module :id))))))
                  (js-call assert :ok actual)
                  (js-call assert :strictEqual (get actual :source) (get module :source))
                  (js-call assert :strictEqual (get actual :filename)
                    (+ (js-call (get module :id) :slice 0 -4) ".eli")))))
              (let ((expected (Object/assign (js-object) (get old :execution)
                               (js-object :zeroImports false :requiredManagedImports (capabilities)))))
                (when (js-call (get record :id) :startsWith "original-managed:sequence-data-standard-identities:")
                  (put expected :hostSource (compile-string
                    (await (readFile (resolve root "tools/backends/eliscript/compiler-corpus-project-entry-host.eli") "utf8"))
                    "tools/backends/eliscript/compiler-corpus-project-entry-host.eli")))
                (js-call assert :deepStrictEqual (retained-observation-execution record old) expected))
              (js-call assert :strictEqual (get original :suite) suite)
              (js-call assert :strictEqual (get original :sourceSha256)
                (hash (await (readFile (resolve root suite)))))
              (js-call assert :strictEqual (get proof :file) retained)
              (js-call assert :strictEqual (get proof :sourceSha256) (hash source))
              (js-call (get original :cases) :forEach (lambda (case)
                (let ((span (get case :span)))
                  (js-call assert :strictEqual (get case :sourceFile) retained)
                  (js-call assert :strictEqual (get case :sourceSha256) (hash source))
                  (js-call assert :strictEqual (get case :sha256)
                    (hash (js-call source :slice (get span :start) (get span :end)))))))
              (let ((assets (get original :sourceAssets)))
                (js-call (js-array suite retained eli) :forEach (lambda (filename)
                  (js-call assert :ok (js-call assets :some (lambda (asset) (= (get asset :file) filename))))))
                (let ((files (js-array "tools/backends/eliscript/managed-host.eli"
                               "tools/backends/managed-host.mjs" "tools/backends/managed-host-legacy.mjs"
                               "tools/backends/eliscript/managed-host-lifecycle.eli" "tools/backends/managed-host-lifecycle.mjs"
                               "tools/backends/eliscript/managed-host-object-provider.eli" "tools/backends/managed-host-object-provider.mjs"
                               "tools/backends/eliscript/managed-host-object-realm.eli" "tools/backends/managed-host-object-realm.mjs"))
                      (asset-index 0))
                  (while (< asset-index (js-length files))
                    (let* ((filename (aref files asset-index))
                           (bound (js-call assets :filter (lambda (asset) (= (get asset :file) filename)))))
                      (js-call assert :strictEqual (js-length bound) 1)
                      (js-call assert :strictEqual (get (aref bound 0) :sourceSha256)
                        (hash (await (readFile (resolve root filename))))))
                    (setq asset-index (1+ asset-index)))))
              (js-call assert :strictEqual
                (get (js-call (get record :modules) :find (lambda (item) (= (get item :id) (get record :entry)))) :source)
                (get (js-call (get old :modules) :find (lambda (item) (= (get item :filename) fixture))) :source))
              (js-call assert :strictEqual (get (get record :execution) :referenceArtifact) t))
            (setq index (1+ index)))
          (js-call assert :strictEqual process-hosts 2))
        (let* ((libraries (await (loadLiteralSources (js-object :sourceRoot root))))
               (evidence (js-call (get state :reader) :evidence)))
          (js-call assert :strictEqual (js-length libraries) 53)
          (js-call libraries :forEach (lambda (library)
            (js-call assert :ok (js-call evidence :some (lambda (asset)
              (= (get asset :file) (get library :filename)))))))))))

  (defun relative-dependencies (module)
    (let ((pending (read-string (get module :source) (get module :filename))) (targets (js-array)))
      (while (> (js-length pending) 0)
        (let* ((node (js-call pending :shift)) (items (get node :items))
               (head (and items (> (js-length items) 0) (get (aref items 0) :name))))
          (cond
            ((= head "module") (Reflect/apply (get pending :push) pending (js-call items :slice 2)))
            ((or (= head "import") (= head "import-portable"))
             (let ((specifier (get (aref items 1) :value)))
               (when (and (= (value-type specifier) "string") (js-call specifier :startsWith "."))
                 (let ((target (js-call posix :normalize
                                 (js-call posix :join (js-call posix :dirname (get module :id)) specifier))))
                   (js-call targets :push (if (js-call target :endsWith ".eli")
                     (+ (js-call target :slice 0 -4) ".mjs") target)))))))))
      targets))

  (test "all sequence recipes preserve the real source graph and complete relative canonical library dependencies"
    (async ()
      (let* ((state (await (services))) (options (get state :options))
             (libraries (await (loadLiteralSources (js-object :sourceRoot root))))
             (by-id (new globalThis.Map)))
        (js-call libraries :forEach (lambda (library) (js-call by-id :set (get library :id) library)))
        (await (addOriginalManagedLibraryAdapters options))
        (let ((records (get state :records)))
          ;; All twelve original families keep their separate Node/Bun record;
          ;; the observed twenty-two failures must not hide the other two.
          (js-call assert :strictEqual (js-length records) 24)
          (js-call records :forEach (lambda (record)
            (let* ((modules (get record :modules)) (ids (new globalThis.Set
                     (js-call modules :map (lambda (module) (get module :id)))))
                   (assets (get (get record :original) :sourceAssets)))
              (js-call assert :strictEqual (get ids :size) (js-length modules))
              (js-call assert :ok (js-call ids :has "runtime/core/collection.mjs"))
              (js-call assert :ok (js-call ids :has "stdlib/core/protocol.mjs"))
              (js-call modules :forEach (lambda (module)
                (js-call assert :strictEqual (get module :filename)
                  (+ (js-call (get module :id) :slice 0 -4) ".eli"))
                (js-call (relative-dependencies module) :forEach (lambda (target)
                  (js-call assert :ok (js-call ids :has target)
                    (+ (get module :id) " must resolve its actual source dependency " target))))
                (let ((library (js-call by-id :get (get module :id))))
                  (when library
                    (js-call assert :strictEqual (get module :source) (get library :source))))))
              (js-call libraries :forEach (lambda (library)
                (let ((proof (js-call assets :find
                               (lambda (asset) (= (get asset :file) (get library :filename))))))
                  (js-call assert :ok proof)
                  (js-call assert :strictEqual (get proof :sourceSha256) (hash (get library :source))))))
              (js-call assert :strictEqual (get (get record :execution) :referenceArtifact) t)
              (js-call assert :strictEqual (get (get record :expected) :oracleRequired) t))))))))

  (test "native interop sequence requests relocate only authentic runtime imports and retain raw source identity"
    (async ()
      (let* ((state (await (services))) (libraries (await (loadLiteralSources (js-object :sourceRoot root)))))
        (await (addOriginalManagedLibraryAdapters (get state :options)))
        (let ((records (get state :records)) (index 0) (count 0))
          (while (< index (js-length records))
            (let* ((record (aref records index)) (before (globalThis.structuredClone record))
                   (transport (transportOriginalSequenceRuntime record libraries)))
              (if (eq transport record) nil
                (progn
                  (setq count (1+ count))
                  (js-call assert :deepStrictEqual record before)
                  (js-call assert :strictEqual (get transport :expected) (get record :expected))
                  (js-call assert :strictEqual (get transport :original) (get record :original))
                  (js-call assert :strictEqual (js-call (get transport :modules) :some
                    (lambda (item) (js-call (get item :id) :startsWith "runtime/"))) false)
                  (let* ((usage (js-call (get transport :modules) :find
                                  (lambda (item) (= (get item :id) "core-set-usage.mjs"))))
                         (proof (get transport :runtimeImportTransport)))
                    (js-call assert :ok (js-call (get usage :source) :includes "\"eliscript/runtime/core/collection.mjs\""))
                    (js-call assert :strictEqual (get proof :kind) "original-sequence-native-provider-imports")
                    (js-call (get proof :modules) :forEach (lambda (item)
                      (let* ((original (js-call (get record :modules) :find
                                         (lambda (module) (= (get module :id) (get item :id)))))
                             (routed (js-call (get transport :modules) :find
                                       (lambda (module) (= (get module :id) (get item :id))))))
                        (js-call assert :strictEqual (get item :sourceSha256) (hash (get original :source)))
                        (js-call assert :strictEqual (get item :transportSourceSha256) (hash (get routed :source))))))))))
            (setq index (1+ index)))
          (js-call assert :strictEqual count 4)
          (let* ((original (js-call records :find (lambda (record)
                              (js-call (get record :id) :startsWith "original-managed:sequence-data-relational-set:"))))
                 (source (str "; 😀\ud800\n(module fixture.unicode-route\n"
                   " (defconst untouched \"./runtime/core/collection.mjs\")\n"
                   " (import \"./runtime/core/collection.mjs\" :as Collection)\n"
                   " (import \"./runtime/core/unknown-original-provider.mjs\" :as Missing))\n"))
                 (extra (js-object :id "unicode-route.mjs" :filename "unicode-route.eli" :source source))
                 (record (Object/assign (js-object) original (js-object :modules
                   (js-call (get original :modules) :concat (js-array extra)))))
                 (before (globalThis.structuredClone record))
                 (transport (transportOriginalSequenceRuntime record libraries))
                 (routed (js-call (get transport :modules) :find (lambda (item) (= (get item :id) (get extra :id)))))
                 (proof (js-call (get (get transport :runtimeImportTransport) :modules) :find
                          (lambda (item) (= (get item :id) (get extra :id)))))
                 (change (aref (get proof :imports) 0)) (points (Array/from source)))
            (js-call assert :strictEqual (js-length (get proof :imports)) 1)
            (js-call assert :ok (Number/isSafeInteger (get change :start)))
            (js-call assert :ok (Number/isSafeInteger (get change :end)))
            (js-call assert :strictEqual (JSON/parse (js-call
              (js-call points :slice (get change :start) (get change :end)) :join ""))
              "./runtime/core/collection.mjs")
            (js-call assert :strictEqual (get routed :source)
              (js-call source :replace "(import \"./runtime/core/collection.mjs\""
                "(import \"eliscript/runtime/core/collection.mjs\""))
            (js-call assert :strictEqual (get proof :sourceSha256) (hash source))
            (js-call assert :strictEqual (get proof :transportSourceSha256) (hash (get routed :source)))
            (js-call assert :deepStrictEqual record before))))))

