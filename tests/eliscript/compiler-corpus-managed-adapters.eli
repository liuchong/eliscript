  (test "original context cleanup waits for actual process exit and preserves its first false or undefined failure"
    (lambda ()
      (js-call (js-array false undefined) :forEach (lambda (first)
        (let* ((events (new EventEmitter)) (trace (js-array)) (errors (js-array))
               (runtime (js-object
