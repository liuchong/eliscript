               (str "(import " (JSON/stringify context-module) " createOriginalProgramDriverClose installOriginalProgramExitCleanup)")
               (str "(import " (JSON/stringify runtime-module) " loadManagedHostModules)")
               "(import \"node:fs\" writeFileSync)"
               "(defconst state (js-object :closed false :asserted false :trace (js-array)))"
               "(put globalThis.globalThis \"__eliscript_macro_process_lifetime__\" state)"
               "(defun close-now () (put state :closed t) (js-call (get state :trace) :push \"close\")"
               (str " (writeFileSync " (JSON/stringify result-path) " (JSON/stringify state)))")
               "(defconst close (createOriginalProgramDriverClose (js-object :target \"wasm\" :host \"/actual/tests/__eliscript_original_generated_names_node.mjs\" :runtimeOptions (js-object :originalHostLifetime \"process\")) close-now))"
               "(installOriginalProgramExitCleanup close-now)"
               "(defasync import-original ()"
               (str " (await (loadManagedHostModules (js-object :hostModules (js-array (js-object :id \"actual\" :specifier "
                 (JSON/stringify provider-url) " :referrer \"entry.mjs\" :allowedExports (js-array) :namespace t))))))")
               "(defasync main () (import-original) (funcall close) (js-call (get state :trace) :push \"driver-complete\"))"
               "(main)") :join "\n")))
