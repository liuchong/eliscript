              (js-call (get error :message) :includes "original sequence assertion")))))))))

  ;; A real minimal WASM import section is data, not a substitute implementation
  ;; of the compiler or any source algorithm. No function is executed here.
  (defun section-size (length)
    (let ((bytes (js-array)))
      (while (>= length 128)
        (js-call bytes :push (+ (% length 128) 128))
        (setq length (Math/floor (/ length 128))))
      (js-call bytes :push length) bytes))
  (defun import-image (labels arity)
    (let* ((encoder (new globalThis.TextEncoder)) (imports (js-array (js-length labels)))
           (signature (js-array 1 96 arity)) (index 0))
      (while (< index arity) (js-call signature :push 127) (setq index (1+ index)))
      (js-call signature :push 1 127)
      (js-call labels :forEach (lambda (name)
        (let ((module (Array/from (js-call encoder :encode "eliscript.host")))
              (field (Array/from (js-call encoder :encode name))))
          (js-call imports :push (js-length module))
          (Reflect/apply (get imports :push) imports module)
          (js-call imports :push (js-length field))
          (Reflect/apply (get imports :push) imports field)
          (js-call imports :push 0 0))))
      (globalThis.Uint8Array.from (js-call (js-array 0 97 115 109 1 0 0 0 1)
        :concat (section-size (js-length signature)) signature (js-array 2)
          (section-size (js-length imports)) imports))))
  (defun execution-context (path target declared contract)
    (let ((context (js-object :target target
             :artifact (js-object :path path :descriptor (js-object :hostCapabilities declared))
             :record (js-object :kind "project" :execution
               (js-object :kind "original-program" :requiredManagedImports contract)))))
      ;; Entry resolution belongs to the admitted original program. This sentinel
      ;; proves admission proceeds without relying on an unrelated response getter.
      (Object/defineProperty (get context :artifact) "entry" (js-object :get (lambda () (throw false)))) context))
  (test "sequence host capability admission rejects missing extra reordered and invalid signatures before the original executor"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-sequence-imports-"))))
             (path (resolve directory "imports.wasm")) (expected (capabilities)))
        (try
          (await (writeFile path (import-image names 2)))
          (js-call assert :strictEqual (globalThis.WebAssembly.validate (import-image names 2)) t)
          (let ((targets (js-array "wasm" "native" "javascript")) (index 0))
            (while (< index (js-length targets))
              (await (js-call assert :rejects
                (lambda () (executeCompilerCorpusRecord (execution-context path (aref targets index) expected expected)))
                (lambda (error) (eq error false))))
              (setq index (1+ index))))
          (let ((unmarked (execution-context "missing-unopened-file" "wasm" (js-array) expected)))
            (Reflect/deleteProperty (get (get unmarked :record) :execution) "requiredManagedImports")
            (await (js-call assert :rejects (lambda () (executeCompilerCorpusRecord unmarked))
              (lambda (error) (eq error false)))))
          (let ((variants (js-array (js-call expected :slice 1)
                    (js-call expected :concat (js-array (aref expected 0)))
                    (js-call (js-call expected :slice) :reverse)
                    (js-call expected :map (lambda (item)
                      (Object/assign (js-object) item (js-object :arity 1))))
                    (js-call expected :map (lambda (item)
                      (Object/assign (js-object) item (js-object :abi "wrong")))))) (index 0))
            (while (< index (js-length variants))
              (await (js-call assert :rejects (lambda () (executeCompilerCorpusRecord
                (execution-context path "wasm" (aref variants index) expected)))
                (lambda (error) (and (not (eq error false)) (= (get error :code) "ERR_ASSERTION")))))
              (setq index (1+ index))))
          (let ((variants (js-array (js-call names :slice 1) (js-call names :concat (js-array "unexpected"))
                          (js-call (js-call names :slice) :reverse))) (index 0))
            (while (< index (js-length variants))
              (await (writeFile path (import-image (aref variants index) 2)))
              (await (js-call assert :rejects (lambda () (executeCompilerCorpusRecord
                (execution-context path "wasm" expected expected)))
                (lambda (error) (and (not (eq error false)) (= (get error :code) "ERR_ASSERTION")))))
              (setq index (1+ index))))
          (await (writeFile path (import-image names 1)))
          (let ((imports (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module (import-image names 1)))))
            (when (Object/hasOwn (aref imports 0) "type")
              (await (js-call assert :rejects (lambda () (executeCompilerCorpusRecord
                (execution-context path "wasm" expected expected)))
                (lambda (error) (= (get error :code) "ERR_ASSERTION"))))))
          (await (js-call assert :rejects (lambda () (executeCompilerCorpusRecord
            (execution-context path "wasm" expected (js-call expected :slice 1))))
            (lambda (error) (= (get error :code) "ERR_ASSERTION"))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
  (test "original report matcher transport changes only its authenticated dependency and retains all original assertion bytes"
    (async ()
      (let* ((source (await (readFile (resolve root "tests/core-stdlib.test.mjs") "utf8")))
             (tail (js-call source :slice (js-call source :indexOf "\n")))
             (files (js-array "tools/backends/eliscript/compiler-corpus-matchers.eli"
               "tools/backends/compiler-corpus-matchers.mjs"
               "tools/backends/eliscript/managed-source-view.eli" "tools/backends/managed-source-view.mjs"
               "tools/backends/eliscript/managed-host-proxy.eli" "tools/backends/managed-host-proxy.mjs"))
             (reader (createOriginalCorpusSourceReader (js-object :sourceRoot root)))
             (assets (js-array)) (index 0))
        (while (< index (js-length files))
          (let* ((name (aref files index)) (asset (await (js-call reader :file name))))
            (js-call assets :push (js-object :file name :sourceSha256 (get asset :sha256))))
          (setq index (1+ index)))
        (js-call (js-array "stable-compatibility:program:tests/fixtures/core-stdlib-usage.eli"
          "original-program:core-stdlib-complete-protocols") :forEach (lambda (id)
            (let* ((record (js-object :id id :execution (js-object :kind "original-program" :hostSource source)
                             :original (js-object :regions (js-array (js-object :sha256 (hash tail))))))
                   (before (JSON/stringify record))
                   (changed (transportOriginalMatcherRecord record root assets))
                   (output (get (get changed :execution) :hostSource))
                   (transport (get (get changed :original) :matcherTransport)))
              (js-call assert :strictEqual (JSON/stringify record) before)
              (js-call assert :strictEqual (js-call output :slice (js-call output :indexOf "\n")) tail)
              (js-call assert :ok (js-call (js-call output :split "\n") :at 0))
              (js-call assert :strictEqual (get transport :originalHostSha256) (hash source))
              (js-call assert :strictEqual (get transport :transportedHostSha256) (hash output))
              (js-call assert :deepStrictEqual (get (get changed :original) :sourceAssets) assets)
              (js-call assert :strictEqual (get (get changed :original) :regions) (get (get record :original) :regions))
              (js-call assert :ok (js-call output :includes
                (get (pathToFileURL (resolve root "tools/backends/compiler-corpus-matchers.mjs")) :href)))
              (js-call assert :throws (lambda () (transportOriginalMatcherRecord record root (js-call assets :slice 1))))
              (js-call assert :throws (lambda () (transportOriginalMatcherRecord record root
                (js-call assets :concat (js-array (aref assets 0))))))
              (let ((invalid (Object/assign (js-object) record (js-object :execution
                    (js-object :kind "original-program" :hostSource tail)))))
                (js-call assert :throws (lambda () (transportOriginalMatcherRecord invalid root assets)))))))
        (let ((unrelated (js-object :id "unrelated")) (reads 0))
          (Object/defineProperty unrelated "execution" (js-object :get
            (lambda () (setq reads (1+ reads)) (throw false))))
          (js-call assert :strictEqual (transportOriginalMatcherRecord unrelated root nil) unrelated)
          (js-call assert :strictEqual reads 0)))))


  (test "FIX39 all original wire coordinates bind synchronous and asynchronous source names from the actual descriptor"
    (async ()
      (let ((targets (js-array "wasm" "native")) (engines (js-array "node" "bun"))
            (autos (js-array 65536 1)) (ti 0))
        (while (< ti (js-length targets))
          (let ((ei 0))
            (while (< ei (js-length engines))
              (let ((ai 0))
                (while (< ai (js-length autos))
                  (let* ((calls (js-array)) (sentinel (js-object :unknown t))
                         (value (js-object :identity t))
                         (functions (js-array "original_codec_report" "original_echo" "original_http_contracts"))
                         (runtime (js-object
                           :invoke (lambda (name &rest args)
                             (unless (js-call functions :includes name) (throw sentinel))
                             (js-call calls :push name) (aref args 0))
                           :invokeAsync (async (name &rest args)
                             (unless (js-call functions :includes name) (throw sentinel))
                             (js-call calls :push name) (aref args 0))))
                         (context (Object/freeze (js-object :runtime (Object/freeze runtime) :graph value)))
                         (input (js-object :target (aref targets ti)
                           :host (str "/product/tests/__eliscript_managed_wire_" (aref engines ei) "_" (aref autos ai) ".mjs")
                           :descriptor (js-object :functions (js-call functions :map (lambda (name) (js-object :name name))))))
                         (before (globalThis.structuredClone input))
                         (bound (bindOriginalManagedProgramContext input context)))
                    (js-call assert :strictEqual (bindOriginalManagedProgramContext input context) bound)
                    (js-call assert :strictEqual (get bound :graph) value)
                    (js-call assert :strictEqual (js-call (get bound :runtime) :invoke "original-codec-report" value) value)
                    (js-call assert :strictEqual (await (js-call (get bound :runtime) :invokeAsync "original-echo" value)) value)
                    (js-call assert :strictEqual (await (js-call (get bound :runtime) :invokeAsync "original_http_contracts" value)) value)
                    (js-call assert :deepStrictEqual calls functions)
                    (await (js-call assert :rejects
                      (lambda () (js-call (get bound :runtime) :invokeAsync "missing-wire-function" value))
                      (lambda (error) (eq error sentinel))))
                    (js-call assert :throws (lambda () (js-call runtime :invoke "original-codec-report" value))
                      (lambda (error) (eq error sentinel)))
                    (js-call assert :deepStrictEqual input before)
                    (js-call (js-array
                      (js-array (js-object :name "original_echo") (js-object :name "original_echo"))
                      (js-array (js-object :name "original_echo") (js-object :name "original-echo")))
                      :forEach (lambda (ambiguous)
                        (js-call assert :throws (lambda ()
                          (bindOriginalManagedProgramContext
                            (Object/assign (js-object) input (js-object :descriptor (js-object :functions ambiguous)))
                            (js-object :runtime runtime))) globalThis.TypeError))))
                  (setq ai (1+ ai))))
              (setq ei (1+ ei))))
          (setq ti (1+ ti))))))


  (test "FIX38 six original host families await installation before evaluating the separate unchanged static-import body on Node and Bun"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-original-install-order-"))))
             (tools (resolve directory "tools/backends"))
             (context-path (resolve tools "compiler-corpus-host-context.mjs"))
             (dependency (resolve directory "dependency.mjs"))
             (families (js-array "transducer" "core-stdlib" "data-text" "value-hash" "lazy-sequence" "core-text-object"))
             (engines (js-array "node" "bun")))
        (try
          (await (mkdir tools (js-object :recursive t)))
          (await (symlink (resolve root "tests") (resolve directory "tests") "dir"))
          (await (mount-lifecycle-runtime-package directory))
          (await (writeFile context-path (compile-string
            (str "(import \"node:timers/promises\" setTimeout)" (originalManagedProgramCompletionSource "(await (setTimeout 20)) (put (js* \"globalThis\") \"originalInstalled\" t)"))
            "installation.eli")))
          (await (writeFile dependency (compile-string
            "(import \"node:assert/strict\" :default assert) (js-call assert :strictEqual (get (js* \"globalThis\") \"originalInstalled\") t) (defconst installed t) (export installed)"
            "static-dependency.eli")))
          (let* ((source (compile-string
                   (str "(import " (JSON/stringify (get (pathToFileURL dependency) :href)) " installed)"
                     " (js-call (get globalThis.process :stdout) :write (JSON/stringify (js-object :installed installed)))")
                   "unchanged-body.eli"))
                 (fi 0))
            (while (< fi (js-length families))
              (let ((ei 0))
                (while (< ei (js-length engines))
                  (let* ((engine (aref engines ei))
                         (input (js-object :source source :sourceRoot directory :directory directory :engine engine :args (js-array)
                           :recordId (str "original-managed:sequence-data-host-" (aref families fi) ":" engine ":auto-65536")
                           :selected t :environment (Object/assign (js-object) (get globalThis.process :env)
                             (js-object :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT "selected-context"))))
                         (before (globalThis.structuredClone input))
                         (launch (await (originalManagedObservationLaunch input)))
                         (body-path (resolve (get launch :directory) "body.mjs"))
                         (unused-bytes (js-call assert :strictEqual (await (readFile body-path "utf8")) source))
                         (result (spawnSync (get launch :executable) (get launch :args)
                           (js-object :env (get launch :env) :cwd directory :encoding "utf8"))))
                    (when (get result :error) (throw (get result :error)))
                    (js-call assert :strictEqual (get result :status) 0 (get result :stderr))
                    (js-call assert :deepStrictEqual (JSON/parse (get result :stdout)) (js-object :installed t))
                    (js-call assert :deepStrictEqual input before)
                    ;; The independent oracle cannot inherit selected graph installation.
                    (let ((reference (await (originalManagedObservationLaunch
                            (Object/assign (js-object) input (js-object :selected false))))))
                      (js-call assert :strictEqual (get (get reference :env) :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT) undefined)
                      (js-call assert :strictEqual (get (get reference :env) :ELISCRIPT_ORIGINAL_TARGET) undefined)))
                  (setq ei (1+ ei))))
              (setq fi (1+ fi))))
          ;; A rejected installation must prevent evaluation, including a body
          ;; with a static import; an import-first launcher prints BODY before failing.
          (await (writeFile context-path (compile-string (originalManagedProgramCompletionSource "(await (globalThis.Promise.reject false))") "rejected-installation.eli")))
          (let ((ei 0))
            (while (< ei (js-length engines))
              (let* ((launch (await (originalManagedObservationLaunch (js-object
                       :source (compile-string "(js-call (get globalThis.process :stdout) :write \"BODY\")" "body.eli")
                       :sourceRoot directory :directory directory :engine (aref engines ei) :args (js-array) :selected t
                       :recordId (str "original-managed:sequence-data-host-transducer:" (aref engines ei) ":auto-65536")
                       :environment (Object/assign (js-object) (get globalThis.process :env)
                         (js-object :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT "selected-context"))))))
                     (result (spawnSync (get launch :executable) (get launch :args)
                       (js-object :cwd directory :env (get launch :env) :encoding "utf8"))))
                (when (get result :error) (throw (get result :error)))
                (js-call assert :notStrictEqual (get result :status) 0)
                (js-call assert :strictEqual (get result :stdout) ""))
              (setq ei (1+ ei))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))


  (test "FIX38 original observation consumes the shared functional process policy instead of retaining an inner spawnSync deadline"
    (async ()
      (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-observation-process-")))))
        (try
          (let ((engines (js-array "node" "bun")) (index 0))
            (while (< index (js-length engines))
              (let* ((engine (aref engines index))
                     (case-directory (resolve directory engine))
                     (id (str "original-managed:sequence-data-host-data-text:" engine ":auto-65536"))
                     (source (compile-string
                       (str "(import \"node:timers/promises\" setTimeout)" (originalManagedProgramCompletionSource "(await (setTimeout 20)) (js-call (get globalThis.process :stdout) :write (JSON/stringify (js-array 1 2 3)))"))
                       "original-observation.eli"))
                     (input (js-object :source source :sourceRoot root :engine engine :args (js-array)
                       :recordId id :selected false :timeoutMs 1 :environment (get globalThis.process :env)))
                     (context (js-object :directory case-directory :caseId id :target "wasm"
                       :sourceIdentity (hash source) :record (js-object :id id :execution (js-object :timeoutMs 1))
                       :options (js-object :functionalRuntimeProfile "small"))))
                (await (mkdir case-directory (js-object :recursive t)))
                (js-call assert :deepStrictEqual (await (runOriginalManagedObservation input context)) (js-array 1 2 3))
                (let ((receipt (JSON/parse (await (readFile (resolve case-directory "process-outcome.json") "utf8")))))
                  (js-call assert :strictEqual (get receipt :status) "passed")
                  (js-call assert :strictEqual (get (get receipt :policy) :effectiveDeadlineMs) nil)
                  (js-call assert :strictEqual (get (get receipt :policy) :performanceAcceptance) "deferred"))
                (js-call assert :strictEqual (get input :timeoutMs) 1))
              (setq index (1+ index))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))


  (test "all retained nested observation callers migrate together while preserving the complete former host and every original fixture and oracle"
    (async ()
      (let* ((state (await (services))) (baseline (js-array))
             (identity-host (compile-string
               (await (readFile (resolve root "tools/backends/eliscript/compiler-corpus-project-entry-host.eli") "utf8"))
               "tools/backends/eliscript/compiler-corpus-project-entry-host.eli"))
             (options (get state :options)))
        (await (js-call legacy :addOriginalManagedLibraryAdapters
          (Object/assign (js-object) options (js-object
            :text (async (filename) (if (= filename suite) (get state :source)
              (await (js-call (get state :reader) :text filename))))
            :add (lambda (record) (js-call baseline :push record))))))
        (await (addOriginalManagedLibraryAdapters options))
        (let ((count 0))
          (js-call baseline :forEach (lambda (before)
            (let ((source (get (get before :execution) :hostSource)))
              (when (and (= (value-type source) "string") (js-call source :includes "function originalObservation("))
                (let* ((after (js-call (get state :records) :find (lambda (record) (= (get record :id) (get before :id)))))
                       (transport (get (get after :original) :observationTransport)))
                  (setq count (1+ count))
                  (js-call assert :strictEqual (get transport :originalHostSource) source)
                  (js-call assert :strictEqual (get transport :originalHostSha256) (hash source))
                  (let ((expected (Object/assign (js-object) (get before :execution))))
                    (when (= (get (get before :original) :suite) suite)
                      (put expected :zeroImports false)
                      (put expected :requiredManagedImports (capabilities)))
                    (when (= (get transport :kind) "original-managed-standard-identities-host")
                      (put expected :hostSource identity-host))
                    (js-call assert :deepStrictEqual (retained-observation-execution after before) expected))
                  (js-call assert :deepStrictEqual (get after :expected) (get before :expected))
                  (js-call assert :strictEqual (get (get after :execution) :timeoutMs) (get (get before :execution) :timeoutMs))
                  (js-call assert :strictEqual
                    (js-call (get (get after :execution) :hostSource) :includes "spawnSync(executable") false))))))
          (js-call assert :ok (> count 12))))))

  (test "identity and raw original fixture source names use the actual descriptor with unknown and ambiguous rejection"
    (lambda ()
      (js-call (js-array "__eliscript_identity_value_host-token-single_node_1.mjs"
        "__eliscript_identity_value_host-token-single_bun_65536.mjs"
        "__eliscript_managed_fixture_objects_node.mjs" "__eliscript_managed_fixture_arrays_bun.mjs"
        "__eliscript_managed_fixture_array-callbacks_node.mjs") :forEach (lambda (host)
        (let* ((sentinel (js-object)) (runtime (js-object :invoke (lambda (name)
                  (if (= name "no_conversion") name (throw sentinel)))))
               (input (js-object :target "wasm" :host (str "tests/" host)
                 :descriptor (js-object :functions (js-array (js-object :name "no_conversion")))))
               (bound (bindOriginalManagedProgramContext input (js-object :runtime runtime))))
          (js-call assert :strictEqual (js-call (get bound :runtime) :invoke "no-conversion") "no_conversion")
          (js-call assert :throws (lambda () (js-call (get bound :runtime) :invoke "unknown")) (lambda (error) (eq error sentinel)))
          (js-call assert :throws (lambda () (bindOriginalManagedProgramContext
            (Object/assign (js-object) input (js-object :descriptor (js-object :functions
              (js-array (js-object :name "no_conversion") (js-object :name "no-conversion")))))
            (js-object :runtime runtime))) globalThis.TypeError))))))
)
