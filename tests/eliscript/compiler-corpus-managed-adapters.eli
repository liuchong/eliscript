(module tests.compiler-corpus-managed-adapters
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm mkdir symlink realpath)
  (import "node:events" EventEmitter)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "node:path" resolve posix dirname)
  (import "node:buffer" Buffer)
  (import "node:os" tmpdir)
  (import "node:crypto" createHash)
  (import "../tools/backends/build.mjs" root loadLiteralSources buildBackends)
  (import "node:module" createRequire)
  (import "../runtime/core/vector.mjs" persistentVector)
  (import "../runtime/core/map.mjs" persistentHashMap)
  (import "../runtime/core/type.mjs" isType isTypeValue typeFieldNames)
  (import "../runtime/core/record.mjs" isRecordType isRecord recordFieldNames)
  (import "../runtime/core/sorted.mjs" PersistentSortedMap PersistentSortedSet defaultSortedComparator)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/backends/managed-module-graph.mjs" createManagedModuleGraph createManagedProjectFacades loadManagedProjectGraph)
  (import "../tools/backends/compiler-corpus.mjs" createOriginalCorpusSourceReader transportOriginalSequenceRuntime compilerCorpusFunctionalResources)
  (import "../tools/backends/compiler-corpus-managed-cases.mjs" originalSourceCaseLocators)
  (import "../tools/backends/compiler-corpus-managed-adapters.mjs" addOriginalManagedLibraryAdapters originalManagedObservationLaunch runOriginalManagedObservation originalManagedProgramCompletionSource)
  (import "../tools/backends/compiler-corpus-managed-adapters-legacy.mjs" :as legacy)
  (import "../tools/backends/compiler-corpus-execution.mjs" executeCompilerCorpusRecord
    compilerCorpusRuntimeAcceptance prepareCompilerCorpusSourceMapContext prepareOriginalProgramProcessLifetime)
  (import "../tools/backends/compiler-corpus.mjs" compilerCorpusRequest transportOriginalMatcherRecord)
  (import "../tools/backends/compiler-build.mjs" independentCompilerResources)
  (import "../tools/backends/compiler-corpus-host-context.mjs"
    bindOriginalManagedProgramContext inheritOriginalProgramContext originalProgramBunLauncher
    closeOriginalProgramResources installOriginalProgramExitCleanup createOriginalProgramDriverClose
    originalInteropFullRuntimeRecipe selectOriginalInteropRuntimeOptions)
  (import "../dist/bootstrap/reader.mjs" read-string)
  (import "../dist/bootstrap/compiler.mjs" compile-string)

  (defconst mixed-literal-source (str
    "(module mixed.literal.boundary\n"
    " (defconst seed [nil false undefined t 0 -0.0 7 \"\" \"text\"])\n"
    " (defun callable (value) value) (defun source-callable () callable)\n"
    " (defun vector-report (value) (js-array (eq (nth 0 value) nil) (eq (nth 1 value) false)"
    "  (undefined? (nth 2 value)) (eq (nth 3 value) t) (Object/is (nth 4 value) 0)"
    "  (Object/is (nth 5 value) -0.0) (= (nth 6 value) 7) (= (nth 7 value) \"\")"
    "  (= (nth 8 value) \"text\") (value-type (nth 9 value)) (funcall (nth 9 value) 42)))\n"
    " (defun map-report (value) (vector-report [(js-call value :get \"nil\") (js-call value :get \"false\") (js-call value :get \"undefined\")"
    "  (js-call value :get \"true\") (js-call value :get \"zero\") (js-call value :get \"negativeZero\") (js-call value :get \"number\")"
    "  (js-call value :get \"empty\") (js-call value :get \"text\") (js-call value :get \"callable\")] ))\n"
    " (defun deep-report (value depth) (let ((current value) (remaining depth))"
    "  (while (> remaining 0) (setq current (if (= (% remaining 2) 0) (nth 0 current) (js-call current :get \"next\"))"
    "    remaining (1- remaining))) (vector-report current)))\n"
    " (defun echo (value) value) (export source-callable vector-report map-report deep-report echo))"))
  (defconst mixed-literal-keys (js-array "nil" "false" "undefined" "true" "zero" "negativeZero" "number" "empty" "text" "callable"))
  (defun mixed-literal-input (callable)
    (let* ((values (js-array nil false undefined t 0 -0.0 7 "" "text" callable))
           (vector (Reflect/apply persistentVector undefined values))
           (map (Reflect/apply persistentHashMap undefined (js-call values :map
             (lambda (value index) (js-array (aref mixed-literal-keys index) value)))))
           (deep vector) (level 0))
      (while (< level 64)
        (setq deep (if (= (% level 2) 0) (persistentHashMap (js-array "next" deep)) (persistentVector deep))
              level (1+ level)))
      (js-object :vector vector :map map :deep deep)))
  (defun mixed-literal-report (api input)
    (js-array (js-call api :vector_report (get input :vector))
      (js-call api :map_report (get input :map)) (js-call api :deep_report (get input :deep) 64)))
  (defun mixed-literal-snapshot (value)
    (if (not (Array/isArray value)) value
      (let ((result (js-array)) (index 0))
        (while (< index (get value :length))
          (js-call result :push (mixed-literal-snapshot (get value index))) (setq index (1+ index))) result)))
  (defasync verify-mixed-literal-dependencies (directory facades sources)
    (let ((proofs (js-array)) (files (get facades :files)) (index 0))
      (while (< index (js-length files))
        (let* ((file (aref files index)) (bytes (await (readFile (resolve directory (get file :id)))))
               (expected (Buffer/from (get file :source) "utf8")))
          (unless (js-call bytes :equals expected)
            (throw (new globalThis.TypeError "mixed literal deployed facade differs from its generated source")))
          (js-call proofs :push (js-object :role "managed-project-facade" :file (get file :id)
            :bytes (get bytes :length) :sha256 (hash bytes))))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index (js-length sources))
        (let* ((source (aref sources index)) (bytes (await (readFile (resolve root (get source :filename)))))
               (expected (Buffer/from (get source :source) "utf8")))
          (unless (js-call bytes :equals expected)
            (throw (new globalThis.TypeError "mixed literal dependency differs from its complete maintained source")))
          (js-call proofs :push (js-object :role "literal-source" :id (get source :id) :file (get source :filename)
            :bytes (get bytes :length) :sha256 (hash bytes))))
        (setq index (1+ index)))
      proofs))
  (defasync install-mixed-literal-dependencies (directory descriptor sources)
    (let* ((facades (createManagedProjectFacades descriptor (js-object :entry "main.mjs")))
           (files (get facades :files)) (index 0))
      (while (< index (js-length files))
        (let* ((file (aref files index)) (path (resolve directory (get file :id))))
          (await (mkdir (dirname path) (js-object :recursive t)))
          (await (writeFile path (get file :source) (js-object :flag "wx"))))
        (setq index (1+ index)))
      (let ((proofs (await (verify-mixed-literal-dependencies directory facades sources))))
        (await (writeFile (resolve directory "complete-dependencies.json")
          (JSON/stringify (js-object :sourceSha256 (hash mixed-literal-source) :files proofs)) (js-object :flag "wx")))
        facades)))
  (defasync assert-mixed-literal-dependency-refusals (directory facades sources)
    (let* ((registry (get facades :registry)) (path (resolve directory registry))
           (source (get (js-call (get facades :files) :find (lambda (file) (= (get file :id) registry))) :source))
           (proofs (await (verify-mixed-literal-dependencies directory facades sources)))
           (proof (js-call proofs :find (lambda (item) (= (get item :file) registry)))))
      (js-call assert :ok proof "the real installed registry is included in complete source identity")
      (js-call assert :strictEqual (get proof :sha256) (hash source))
      (await (rm path))
      (await (js-call assert :rejects (verify-mixed-literal-dependencies directory facades sources) (js-object :code "ENOENT")))
      (await (writeFile path (str source "\n")))
      (await (js-call assert :rejects (verify-mixed-literal-dependencies directory facades sources) globalThis.TypeError))
      (await (writeFile path source))
      (let ((changed (js-call sources :slice)))
        (put changed 0 (Object/assign (js-object) (aref sources 0)
          (js-object :source (str (get (aref sources 0) :source) "\n"))))
        (await (js-call assert :rejects (verify-mixed-literal-dependencies directory facades changed) globalThis.TypeError))
        (put changed 0 (Object/assign (js-object) (aref sources 0)
          (js-object :filename "stdlib/__missing-mixed-literal-dependency.eli")))
        (await (js-call assert :rejects (verify-mixed-literal-dependencies directory facades changed) (js-object :code "ENOENT"))))
      (js-call assert :deepStrictEqual (await (verify-mixed-literal-dependencies directory facades sources)) proofs)))
  (test "mixed persistent vectors maps and deep paths retain every primitive and source callable against the complete same-source JS oracle"
    (async ()
      (let ((parent (resolve root "_worktree/evidence/mixed-literal-boundary")))
        (await (mkdir parent (js-object :recursive t)))
        (let ((directory (await (mkdtemp (resolve parent "case-")))))
          (try
            (let* ((backend (await (buildBackends (js-object :outputRoot (resolve directory "backend")))))
                   (compiler (get backend :compiler))
                   (literals (await (js-call backend :loadLiteralModules)))
                   (program (js-call compiler :compile_ir_string mixed-literal-source "mixed-literal-boundary.eli"))
                   (runtime-ir (js-call compiler :compile_ir_string
                     (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
                   (lowered (js-call (get backend :managed) :lower_managed_project
                     (js-array (js-object :id "main.mjs" :program program)) "main.mjs" runtime-ir
                     (js-object :literalModules (get literals :literalModules) :phased t)))
                   (memory (js-object :initialPages 128 :maximumPages 4096))
                   (image (Uint8Array/from (js-call (get backend :wasm) :append_metadata_section
                     (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) memory)
                     "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
                   (native-target (cond ((and (= (get globalThis.process :arch) "arm64") (= (get globalThis.process :platform) "darwin")) "arm64-macos")
                     ((and (= (get globalThis.process :arch) "arm64") (= (get globalThis.process :platform) "linux")) "arm64-linux")))
                   (library (resolve directory (if (= native-target "arm64-macos") "mixed.dylib" "mixed.so")))
                   (reference-path (resolve directory "reference.mjs")))
              (js-call assert :ok native-target "the complete mixed boundary regression requires its supported native target")
              (js-call assert :deepStrictEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module image)) (js-array))
              (await (writeFile library (Uint8Array/from (js-call (get backend :native) :emit_typed_native_memory_library
                (get lowered :typed) native-target))))
              (await (mkdir (resolve directory "node_modules")))
              (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
              (await (writeFile reference-path (js-call compiler :compile_string mixed-literal-source "mixed-literal-boundary.eli")))
              (let* ((reference (funcall (createRequire reference-path) reference-path))
                     (expected (mixed-literal-report reference (mixed-literal-input (js-call reference :source_callable))))
                     (golden (js-array t t t t t t t t t "function" 42))
                     (targets (js-array "wasm" "native")) (target-index 0))
                (js-call assert :deepStrictEqual expected (js-array golden golden golden))
                (while (< target-index (js-length targets))
                  (let* ((target (aref targets target-index))
                         ;; Every graph owns a separate real registry; installing
                         ;; native must not reuse the previous WASM singleton.
                         (deployment (resolve directory (str "selected-" target)))
                         (facades (await (install-mixed-literal-dependencies deployment (get lowered :descriptor)
                           (get literals :literalSources))))
                         (graph (createManagedModuleGraph (get lowered :descriptor)))
                         (configuration (Object/assign (js-object) memory (js-object :maxSlots 131072 :initialBytes 8388608
                           :maxBytes 67108864 :initializeModule false :moduleGraph graph :nativeTarget native-target)))
                         (runtime undefined))
                    (await (assert-mixed-literal-dependency-refusals deployment facades (get literals :literalSources)))
                    (try
                      (progn
                        (setq runtime (if (= target "wasm") (instantiateManagedRuntime image configuration)
                          (await (instantiateNativeManagedRuntime library lowered configuration))))
                        (js-call runtime :auto 1)
                        (let* ((project (await (loadManagedProjectGraph runtime (get lowered :descriptor)
                                 (js-object :moduleGraph graph :projectEntry "main.mjs"
                                   :projectModuleBaseURL (get (pathToFileURL (str deployment "/")) :href)))))
                               (api (get project :namespace))
                               (input (mixed-literal-input (js-call api :source_callable))))
                          (js-call assert :deepStrictEqual (mixed-literal-snapshot (mixed-literal-report api input)) expected)
                          ;; Echo each complete collection, then traverse it again
                          ;; through the same source API to retain all mixed leaves.
                          (let ((echoed (js-object :vector (js-call api :echo (get input :vector))
                                  :map (js-call api :echo (get input :map)) :deep (js-call api :echo (get input :deep)))))
                            (js-call assert :deepStrictEqual (mixed-literal-snapshot (mixed-literal-report api echoed)) expected)))
                        (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
                      (finally
                        (when runtime
                          (js-call runtime :closeModule) (js-call runtime :collect)
                          (js-call assert :strictEqual (js-call runtime :live) 0)
                          (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                          (when (get runtime :close) (js-call runtime :close)))
                        (js-call graph :close))))
                  (setq target-index (1+ target-index)))))
            (finally (await (rm directory (js-object :recursive t :force t)))))))))

  (defun retained-observation-execution (record before)
    (let* ((transport (get (get record :original) :observationTransport))
           (execution (get record :execution)) (old (get before :execution)))
      (if (not transport) execution
        (progn
          (js-call assert :strictEqual (get transport :originalHostSource) (get old :hostSource))
          (js-call assert :strictEqual (get transport :originalHostSha256) (hash (get old :hostSource)))
          (js-call assert :strictEqual (js-call (get execution :hostSource) :includes "[object Object]") false)
          (cond
            ((= (get transport :kind) "original-managed-observation")
              (js-call assert :ok (> (get transport :calls) 0))
              (js-call assert :ok (js-call (get execution :hostSource) :includes "await (originalObservation(")))
            ((= (get transport :kind) "original-managed-standard-identities-host")
              (js-call assert :strictEqual (get transport :calls) 0))
            ((= (get transport :kind) "original-managed-sequence-host")
              (js-call assert :strictEqual (value-type (get transport :sourceFile)) "string")
              (js-call assert :strictEqual (value-type (get transport :sourceSha256)) "string")
              (js-call assert :ok (js-call (get execution :hostSource) :includes "runOriginalManagedSequenceHost")))
            (t (throw (new globalThis.Error "unknown original managed observation transport"))))
          (if (= (get transport :kind) "original-managed-standard-identities-host") execution
            (Object/assign (js-object) execution (js-object :hostSource (get old :hostSource))))))))

  (defconst literal-array-source (str
    "(module literal.array.boundary\n"
    " (import \"eliscript/runtime/core/type.mjs\" materializeTypeDefinition materializeTypeValue)\n"
    " (import \"eliscript/runtime/core/record.mjs\" materializeRecordType)\n"
    " (import \"eliscript/runtime/core/sorted.mjs\" materializeSortedMap materializeSortedSet defaultSortedComparator)\n"
    " (defun types (fields values) (let ((Type (materializeTypeDefinition \"ForeignType\" fields)))"
    "   (js-array Type (get Type :typeFields) (materializeTypeValue Type values))))\n"
    " (defun records (fields value) (let ((Record (materializeRecordType \"ForeignRecord\" fields)))"
    "   (js-array Record (get Record :recordFields) (js-call Record :create value))))\n"
    " (defun sorted (entries values) (let ((comparison (defaultSortedComparator)))"
    "   (js-array (materializeSortedMap entries comparison) (materializeSortedSet values comparison) comparison)))\n"
    " (defun rejection-type () globalThis.TypeError)"
    " (defun echo (value) value) (export types records sorted echo rejection-type))"))
  (defun literal-array-phase (phase)
    (when (= (get (get globalThis.process :env) :ELISCRIPT_LITERAL_ARRAY_DIAGNOSTIC) "1")
      (js-call globalThis.console :error "[literal-array-boundary]" phase)))
  (defun literal-array-observations (api)
    (let* ((fields (Object/freeze (js-array "value"))) (values (Object/freeze (js-array -0.0)))
           (types (js-call api :types fields values)) (Type (get types 0)) (value (get types 2))
           (records (js-call api :records fields -0.0)) (Record (get records 0)) (record (get records 2))
           (sorted (js-call api :sorted (Object/freeze (js-array (Object/freeze (js-array 1 "a"))
                      (Object/freeze (js-array 2 "b")))) (Object/freeze (js-array 1 3))))
           (map (get sorted 0)) (set (get sorted 1)) (comparison (get sorted 2))
           (rejection-type (js-call api :rejection_type)))
      ;; Each generated program retains its own Error realm. Match the actual
      ;; TypeError constructor rather than a different host realm's prototype.
      (js-call assert :strictEqual (get rejection-type :name) "TypeError")
      (js-call assert :strictEqual (get types 1) fields)
      (js-call assert :strictEqual (get Type :typeFields) fields)
      (js-call assert :strictEqual (typeFieldNames Type) fields)
      (js-call assert :strictEqual (get records 1) fields)
      (js-call assert :strictEqual (get Record :recordFields) fields)
      (js-call assert :strictEqual (recordFieldNames Record) fields)
      (js-call assert :strictEqual (get map :comparator) comparison)
      (js-call assert :strictEqual (get set :comparator) comparison)
      (js-call assert :strictEqual comparison (defaultSortedComparator))
      (literal-array-phase "constructed; iterating sorted map and set")
      (js-call assert :deepStrictEqual (Array/from map) (js-array (js-array 1 "a") (js-array 2 "b")))
      (js-call assert :deepStrictEqual (Array/from set) (js-array 1 3))
      (literal-array-phase "iteration passed; checking identity and rejected fields")
      (js-call (js-array Type value Record record map set fields) :forEach (lambda (item)
        (js-call assert :strictEqual (Object/isFrozen item) t)
        (js-call assert :strictEqual (js-call api :echo item) item)))
      (js-call (js-array (Object/freeze (js-object :length 1 :0 "value"))
                 (Object/freeze (js-array "value" "value")) (js-array "value")) :forEach
        (lambda (invalid)
          (js-call assert :throws (lambda () (js-call api :types invalid values)) rejection-type)
          (js-call assert :throws (lambda () (js-call api :records invalid 1)) rejection-type)))
      (js-array (isType Type) (isTypeValue value) (eq (get value :constructor) Type) (Object/is (get value :value) -0.0)
        (isRecordType Record) (isRecord record) (eq (get record :constructor) Record) (Object/is (get record :value) -0.0)
        (js-call PersistentSortedMap globalThis.Symbol.hasInstance map)
        (js-call PersistentSortedSet globalThis.Symbol.hasInstance set))))
  (test "real foreign arrays retain type record and sorted transport identity and all original materializer validation on WASM and native"
    (async ()
      (let ((parent (resolve root "_worktree/evidence/literal-array-boundary"))
            (selected-target (get (get globalThis.process :env) :ELISCRIPT_LITERAL_ARRAY_TARGET)))
        (js-call assert :ok (or (undefined? selected-target) (= selected-target "wasm") (= selected-target "native"))
          "ELISCRIPT_LITERAL_ARRAY_TARGET must be wasm or native when set")
        (await (mkdir parent (js-object :recursive t)))
        (let ((directory (await (mkdtemp (resolve parent "case-")))))
          (try
            (let* ((backend (await (buildBackends (js-object :outputRoot (resolve directory "backend")))))
                   (compiler (get backend :compiler)) (literals (await (js-call backend :loadLiteralModules)))
                   (program (js-call compiler :compile_ir_string literal-array-source "literal-array-boundary.eli"))
                   (runtime-ir (js-call compiler :compile_ir_string
                     (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
                   (before (JSON/stringify (js-array program runtime-ir (get literals :literalModules))))
                   (lowered (js-call (get backend :managed) :lower_managed_project
                     (js-array (js-object :id "main.mjs" :program program)) "main.mjs" runtime-ir
                     (js-object :literalModules (get literals :literalModules) :phased t :foreignEntry t)))
                   (memory (js-object :initialPages 128 :maximumPages 4096))
                   (image (Uint8Array/from (js-call (get backend :wasm) :append_metadata_section
                     (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) memory)
                     "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
                   (native-target (if (= (get globalThis.process :platform) "darwin") "arm64-macos" "arm64-linux"))
                   (library (resolve directory (if (= native-target "arm64-macos") "arrays.dylib" "arrays.so")))
                   (reference-path (resolve directory "reference.mjs")))
              (js-call assert :strictEqual (JSON/stringify (js-array program runtime-ir (get literals :literalModules))) before)
              (await (mkdir (resolve directory "node_modules")))
              (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
              (await (writeFile reference-path (js-call compiler :compile_string literal-array-source "literal-array-boundary.eli")))
              (let* ((reference (funcall (createRequire reference-path) reference-path))
                     (expected (literal-array-observations reference)))
                (js-call assert :deepStrictEqual expected (js-call (new globalThis.Array 10) :fill t))
                (await (writeFile library (Uint8Array/from (js-call (get backend :native) :emit_typed_native_memory_library
                  (get lowered :typed) native-target))))
                (let ((targets (if (undefined? selected-target) (js-array "wasm" "native") (js-array selected-target))) (position 0))
                  (while (< position (js-length targets))
                    (let* ((target (aref targets position)) (deployment (resolve directory target))
                           (facades (createManagedProjectFacades (get lowered :descriptor) (js-object :entry "main.mjs")))
                           (files (get facades :files)) (index 0) (graph (createManagedModuleGraph (get lowered :descriptor)))
                           (configuration (Object/assign (js-object) memory (js-object :maxSlots 131072 :initialBytes 8388608
                             :maxBytes 67108864 :initializeModule false :moduleGraph graph :nativeTarget native-target)))
                           (runtime undefined))
                      (while (< index (js-length files))
                        (let* ((file (aref files index)) (path (resolve deployment (get file :id))))
                          (await (mkdir (dirname path) (js-object :recursive t)))
                          (await (writeFile path (get file :source))))
                        (setq index (1+ index)))
                      (await (verify-mixed-literal-dependencies deployment facades (get literals :literalSources)))
                      (try
                        (literal-array-phase (str target ": instantiate"))
                        (setq runtime (if (= target "wasm") (instantiateManagedRuntime image configuration)
                          (await (instantiateNativeManagedRuntime library lowered configuration))))
                        (literal-array-phase (str target ": load complete project"))
                        (let ((project (await (loadManagedProjectGraph runtime (get lowered :descriptor)
                          (js-object :moduleGraph graph :projectEntry "main.mjs"
                            :projectModuleBaseURL (get (pathToFileURL (str deployment "/")) :href))))))
                          (js-call runtime :auto 1)
                          (literal-array-phase (str target ": observe with auto1"))
                          (js-call assert :deepStrictEqual (literal-array-observations (get project :namespace)) expected)
                          (literal-array-phase (str target ": observations passed")))
                        (finally
                          (when runtime
                            (js-call runtime :closeModule) (js-call runtime :collect)
                            (js-call assert :strictEqual (js-call runtime :live) 0)
                            (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                            (when (get runtime :close) (js-call runtime :close))))))
                    (setq position (1+ position))))))
            (finally (await (rm directory (js-object :recursive t :force t)))))))))

  (defconst suite "tests/wasm-managed-sequence-data.test.mjs")
  (test "only the authenticated complete interop record selects a bounded functional heap with both flags and unchanged auto"
    (async ()
      (let* ((main (await (readFile (resolve root "stdlib/interop/js.eli") "utf8")))
             (host-source (await (readFile (resolve root "tests/fixtures/interop-js-host.mjs") "utf8")))
             (record (js-object :id "stable-compatibility:program:stdlib/interop/js.eli" :kind "project"
               :entry "stdlib/interop/js.mjs"
               :original (js-object :manifest "stable-compatibility" :fixture "stdlib/interop/js.eli" :host "tests/fixtures/interop-js-host.mjs")
               :modules (js-array (js-object :id "stdlib/interop/js.mjs" :filename "stdlib/interop/js.eli" :source main))
               :expected (js-object :kind "seed-program" :oracleRequired t)
               :execution (js-object :kind "original-program" :host "tests/fixtures/interop-js-host.mjs" :hostSource host-source)))
             (environment (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1" :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small"))
             (directory (await (mkdtemp (resolve (tmpdir) "eliscript-interop-resource-"))))
             (base (get (pathToFileURL (+ (resolve directory "product") "/")) :href))
             (host-path (resolve directory "product/tests/fixtures/interop-js-host.mjs"))
             (budget (js-object :maxSlots 131072 :initialBytes 8388608 :maxBytes 67108864 :auto 65536))
