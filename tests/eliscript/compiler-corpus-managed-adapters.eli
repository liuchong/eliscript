              (js-call assert :strictEqual (await (selectOriginalInteropRuntimeOptions changed environment)) (get changed :runtimeOptions)))
            (await (writeFile host-path (str host-source "\n")))
            (await (js-call assert :rejects (lambda () (selectOriginalInteropRuntimeOptions input environment)) globalThis.TypeError)))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
