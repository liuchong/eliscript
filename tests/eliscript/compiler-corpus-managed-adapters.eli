            (js-call assert :strictEqual (js-call (get adapted :runtime) :invoke "vector-case" value) value)
            (js-call assert :strictEqual (js-call (get adapted :runtime) :invoke "vector_case" value) value)
            (js-call assert :deepStrictEqual calls (js-array
