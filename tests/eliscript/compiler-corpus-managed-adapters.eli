(module tests.compiler-corpus-managed-adapters
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm mkdir symlink realpath)
  (import "node:events" EventEmitter)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "node:path" resolve posix)
  (import "node:os" tmpdir)
  (import "node:crypto" createHash)
  (import "../tools/backends/build.mjs" root loadLiteralSources)
  (import "../tools/backends/compiler-corpus.mjs" createOriginalCorpusSourceReader transportOriginalSequenceRuntime)
  (import "../tools/backends/compiler-corpus-managed-cases.mjs" originalSourceCaseLocators)
  (import "../tools/backends/compiler-corpus-managed-adapters.mjs" addOriginalManagedLibraryAdapters)
  (import "../tools/backends/compiler-corpus-managed-adapters-legacy.mjs" :as legacy)
  (import "../tools/backends/compiler-corpus-execution.mjs" executeCompilerCorpusRecord
    compilerCorpusRuntimeAcceptance prepareCompilerCorpusSourceMapContext prepareOriginalProgramProcessLifetime)
  (import "../tools/backends/compiler-corpus.mjs" compilerCorpusRequest transportOriginalMatcherRecord)
  (import "../tools/backends/compiler-build.mjs" independentCompilerResources)
  (import "../tools/backends/compiler-corpus-host-context.mjs"
    bindOriginalManagedProgramContext inheritOriginalProgramContext originalProgramBunLauncher
    closeOriginalProgramResources installOriginalProgramExitCleanup createOriginalProgramDriverClose)
  (import "../dist/bootstrap/reader.mjs" read-string)
  (import "../dist/bootstrap/compiler.mjs" compile-string)

  (defconst suite "tests/wasm-managed-sequence-data.test.mjs")
  (defconst retained "tests/wasm-managed-sequence-data-test-legacy.mjs")
  (defconst eli "tests/eliscript/wasm-managed-sequence-data.eli")
  (defconst fixture "tests/fixtures/wasm-managed-sequence-data.eli")
  (defconst names (js-array "source-operation" "console-log-capture" "console-log"))
  (defun hash (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))
  (defasync mount-lifecycle-runtime-package (directory)
    (let ((modules (resolve directory "node_modules"))
          (package-path (resolve directory "node_modules/eliscript")))
      (await (mkdir modules (js-object :recursive t)))
      (try (await (symlink root package-path "dir"))
        (catch error (unless (= (get error :code) "EEXIST") (throw error))))
      (js-call assert :strictEqual (await (realpath package-path)) (await (realpath root)))))
  (defun capabilities () (js-call names :map (lambda (name)
    (js-object :name name :module "eliscript.host" :arity 2 :abi "managed-host-call-v1"))))
  (defasync services ()
    (let* ((reader (createOriginalCorpusSourceReader (js-object :sourceRoot root)))
           (source (await (js-call reader :text retained)))
           (records (js-array)))
      (js-object :reader reader :source source :records records :options
        (js-object :sourceRoot root :text (get reader :text) :file (get reader :file)
          :stableFiles (new globalThis.Set (js-array fixture))
          :locators (originalSourceCaseLocators suite source)
          :add (lambda (record) (js-call records :push record))))))

  (test "only the four original transient hosts adapt source invocation names from their real canonical descriptor"
    (lambda ()
      (js-call assert :strictEqual (value-type inheritOriginalProgramContext) "function")
      (js-call assert :strictEqual (value-type originalProgramBunLauncher) "function")
      (js-call (js-array "node" "bun") :forEach (lambda (engine)
        (js-call (js-array 65536 1) :forEach (lambda (auto)
          (let* ((calls (js-array)) (first (js-object :first t)) (closed 0)
                 (runtime (js-object :invoke (lambda (name &rest arguments)
                   (unless (js-call (js-array "vector_case" "held_state") :includes name) (throw first))
                   (js-call calls :push (js-array name arguments)) (aref arguments 0))
                   :closeModule (lambda () (setq closed (1+ closed)))))
                 (context (Object/freeze (js-object :runtime (Object/freeze runtime) :graph (js-object :actual t)
                   :close (lambda () (js-call runtime :closeModule)))))
                 (input (js-object :target "wasm" :host
                   (+ "/product/tests/__eliscript_managed_transient-state_" engine "_" auto ".mjs")
                   :descriptor (js-object :functions (js-array (js-object :name "vector_case") (js-object :name "held_state")))))
                 (before (globalThis.structuredClone input))
                 (adapted (bindOriginalManagedProgramContext input context))
                 (value (js-array -0 undefined (js-object :identity t))))
            (js-call assert :strictEqual (bindOriginalManagedProgramContext input context) adapted)
            (js-call assert :strictEqual (get adapted :graph) (get context :graph))
            (js-call assert :strictEqual (get adapted :close) (get context :close))
            (js-call assert :strictEqual (get (get adapted :runtime) :closeModule) (get runtime :closeModule))
            (js-call assert :strictEqual (js-call (get adapted :runtime) :invoke "vector-case" value) value)
            (js-call assert :strictEqual (js-call (get adapted :runtime) :invoke "vector_case" value) value)
            (js-call assert :deepStrictEqual calls (js-array
              (js-array "vector_case" (js-array value)) (js-array "vector_case" (js-array value))))
            (let ((caught false) (failure undefined))
              (try (js-call (get adapted :runtime) :invoke "missing-source-name")
                (catch error (setq caught t failure error)))
              (js-call assert :strictEqual caught t) (js-call assert :strictEqual failure first))
            (js-call assert :strictEqual closed 0)
            (js-call adapted :close) (js-call assert :strictEqual closed 1)
            (js-call assert :deepStrictEqual input before))))))))

  (test "original context cleanup waits for actual process exit and preserves its first false or undefined failure"
    (lambda ()
      (js-call (js-array false undefined) :forEach (lambda (first)
        (let* ((events (new EventEmitter)) (trace (js-array)) (errors (js-array))
               (runtime (js-object
                 :closeModule (lambda () (js-call trace :push "module") (throw first))
                 :collect (lambda () (js-call trace :push "collect") (throw "later"))
                 :live (lambda () (js-call trace :push "live") 0)
                 :stats (lambda () (js-call trace :push "frames") (js-object :frameDepth 0))
                 :close (lambda () (js-call trace :push "runtime"))))
               (graph (js-object :close (lambda () (js-call trace :push "graph"))))
               (caught false) (failure nil))
          (try (closeOriginalProgramResources runtime graph)
            (catch error (setq caught t failure error)))
          (js-call assert :strictEqual caught t)
          (js-call assert :strictEqual failure first)
          (js-call assert :deepStrictEqual trace (js-array "module" "collect" "live" "frames" "runtime" "graph"))
          (put events :stderr (js-object :write (lambda (text) (js-call errors :push text))))
          (put events :exitCode 0)
          (installOriginalProgramExitCleanup (lambda () (throw first)) events)
          (js-call assert :strictEqual (js-call events :listenerCount "beforeExit") 0)
          (js-call events :emit "beforeExit" 0)
          (js-call assert :deepStrictEqual errors (js-array))
          (js-call events :emit "exit" 0)
          (js-call assert :strictEqual (js-length errors) 1)
          (js-call assert :strictEqual (get events :exitCode) 1)
          (js-call events :emit "exit" 0)
          (js-call assert :strictEqual (js-length errors) 1))))))
  (test "actual Node preload exit cleanup leaves asynchronous module IO alive through beforeExit"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-original-exit-"))))
             (entry (resolve directory "original-exit.mjs"))
             (result-path (resolve directory "trace.json"))
             (helper (get (pathToFileURL (resolve root "tools/backends/compiler-corpus-host-context.mjs")) :href))
             (source (js-call (js-array
               (str "(import " (JSON/stringify helper) " installOriginalProgramExitCleanup)")
               "(import \"node:fs/promises\" readFile) (import \"node:fs\" writeFileSync)"
               "(defconst trace (js-array))"
               (str "(defconst destination " (JSON/stringify result-path) ")")
               "(installOriginalProgramExitCleanup (lambda () (js-call trace :push \"close\")"
               " (writeFileSync destination (JSON/stringify trace))))"
               "(js-call globalThis.process :emit \"beforeExit\" 0)"
               "(defasync main ()"
               (str " (await (readFile " (JSON/stringify (resolve root "stdlib/managed-runtime-collection.eli")) " \"utf8\"))")
               " (js-call trace :push \"loaded\")) (main)") :join "\n")))
        (try
          (await (mount-lifecycle-runtime-package directory))
          (await (writeFile entry (compile-string source "original-exit.eli")))
          (let* ((node (or (get (get globalThis.process :env) :NODE_BINARY) "node"))
                 (result (spawnSync node (js-array entry) (js-object :encoding "utf8"))))
            (when (get result :error) (throw (get result :error)))
            (js-call assert :strictEqual (get result :status) 0 (get result :stderr))
            (js-call assert :deepStrictEqual (JSON/parse (await (readFile result-path "utf8")))
              (js-array "loaded" "close")))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
  (test "only the exact original macro Node host receives private process lifetime without rewriting its source or resource contract"
    (async ()
      (let* ((source (await (readFile (resolve root "tests/macro-generated-names.test.mjs") "utf8")))
             (record (js-object :id "original-program:macro-generated-names-node"
               :execution (js-object :kind "original-program" :hostRuntime "node"
                 :host "tests/__eliscript_original_generated_names_node.mjs" :hostSource source
                 :runtimeOptions (js-object :auto 0 :maxSlots 1024))
               :original (js-object :suite "tests/macro-generated-names.test.mjs" :sourceSha256 (hash source))))
             (context (js-object :target "wasm" :record record)) (before (JSON/stringify context)))
        (let* ((configured (prepareOriginalProgramProcessLifetime context))
               (execution (get (get configured :record) :execution)))
          (js-call assert :strictEqual (get (get execution :runtimeOptions) :originalHostLifetime) "process")
          (js-call assert :strictEqual (get (get execution :runtimeOptions) :auto) 0)
          (js-call assert :strictEqual (get (get execution :runtimeOptions) :maxSlots) 1024)
          (js-call assert :strictEqual (get execution :hostSource) source)
          (js-call assert :strictEqual (get (get configured :record) :original) (get record :original))
          (js-call assert :strictEqual (JSON/stringify context) before))
        (let ((javascript (Object/assign (js-object) context (js-object :target "javascript"))))
          (js-call assert :strictEqual (prepareOriginalProgramProcessLifetime javascript) javascript))
        (let ((unrelated (js-object :target "wasm" :record (js-object :id "unrelated"))))
          (Object/defineProperty (get unrelated :record) "execution" (js-object :get (lambda () (throw false))))
          (js-call assert :strictEqual (prepareOriginalProgramProcessLifetime unrelated) unrelated))
        (js-call (js-array "host" "hostRuntime") :forEach (lambda (field)
          (let* ((changed (globalThis.structuredClone context))
                 (execution (get (get changed :record) :execution)))
            (put execution field "unrelated")
            (js-call assert :throws (lambda () (prepareOriginalProgramProcessLifetime changed)) globalThis.TypeError)))))))

  (test "process lifetime defers only driver close and preserves ordinary close and original false or undefined cleanup failures"
    (async ()
      (let* ((input (js-object :target "wasm" :host "/actual/tests/__eliscript_original_generated_names_node.mjs"
                 :runtimeOptions (js-object :originalHostLifetime "process")))
             (events (new EventEmitter)) (closed 0)
             (close-now (lambda () (setq closed (1+ closed))))
             (driver-close (createOriginalProgramDriverClose input close-now)))
        (put events :stderr (js-object :write (lambda (text) (js-call assert :fail text))))
        (installOriginalProgramExitCleanup close-now events)
        (await (funcall driver-close))
        (js-call events :emit "beforeExit" 0)
        (js-call assert :strictEqual closed 0)
        (js-call events :emit "exit" 0)
        (js-call assert :strictEqual closed 1)
        (js-call events :emit "exit" 0)
        (js-call assert :strictEqual closed 1)
        (await (funcall (createOriginalProgramDriverClose (js-object :target "wasm") close-now)))
        (js-call assert :strictEqual closed 2)
        (js-call (js-array "unrelated.mjs" "/actual/tests/__eliscript_original_generated_names_bun.mjs")
          :forEach (lambda (host)
            (js-call assert :throws (lambda () (createOriginalProgramDriverClose
              (Object/assign (js-object) input (js-object :host host)) close-now)) globalThis.TypeError)))
        (js-call (js-array false undefined) :forEach (lambda (first)
          (let ((caught false) (actual nil))
            ;; A default host's synchronous close preserves its actual throw.
            (try (funcall (createOriginalProgramDriverClose (js-object)
                    (lambda () (throw first))))
              (catch error (setq caught t actual error)))
            (js-call assert :strictEqual caught t)
            (js-call assert :strictEqual actual first)))))))

  (test "actual fire-and-forget Node module imports finish original assertions before the process lifetime context closes"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-macro-process-lifetime-"))))
             (entry (resolve directory "entry.mjs")) (provider (resolve directory "provider.mjs"))
             (result-path (resolve directory "result.json"))
             (context-module (get (pathToFileURL (resolve root "tools/backends/compiler-corpus-host-context.mjs")) :href))
             (runtime-module (get (pathToFileURL (resolve root "tools/backends/managed-runtime.mjs")) :href))
             (provider-url (get (pathToFileURL provider) :href))
             (provider-source (js-call (js-array
               "(import \"node:assert/strict\" :default assert)"
               "(defconst state (get globalThis.globalThis \"__eliscript_macro_process_lifetime__\"))"
               "(js-call assert :strictEqual (get state :closed) false)"
               "(js-call (get state :trace) :push \"original-assertions\")"
               "(put state :asserted t)") :join "\n"))
             (entry-source (js-call (js-array
               (str "(import " (JSON/stringify context-module) " createOriginalProgramDriverClose installOriginalProgramExitCleanup)")
               (str "(import " (JSON/stringify runtime-module) " loadManagedHostModules)")
               "(import \"node:fs\" writeFileSync)"
               "(defconst state (js-object :closed false :asserted false :trace (js-array)))"
               "(put globalThis.globalThis \"__eliscript_macro_process_lifetime__\" state)"
               "(defun close-now () (put state :closed t) (js-call (get state :trace) :push \"close\")"
               (str " (writeFileSync " (JSON/stringify result-path) " (JSON/stringify state)))")
               "(defconst close (createOriginalProgramDriverClose (js-object :target \"wasm\" :host \"/actual/tests/__eliscript_original_generated_names_node.mjs\" :runtimeOptions (js-object :originalHostLifetime \"process\")) close-now))"
               "(installOriginalProgramExitCleanup close-now)"
               "(defasync import-original ()"
               (str " (await (loadManagedHostModules (js-object :hostModules (js-array (js-object :id \"actual\" :specifier "
                 (JSON/stringify provider-url) " :referrer \"entry.mjs\" :allowedExports (js-array) :namespace t))))))")
               "(defasync main () (import-original) (funcall close) (js-call (get state :trace) :push \"driver-complete\"))"
               "(main)") :join "\n")))
        (try
          (await (mount-lifecycle-runtime-package directory))
          (await (writeFile provider (compile-string provider-source "process-provider.eli")))
          (await (writeFile entry (compile-string entry-source "process-entry.eli")))
          (let* ((node (or (get (get globalThis.process :env) :NODE_BINARY) "node"))
                 (result (spawnSync node (js-array entry) (js-object :encoding "utf8"))))
            (when (get result :error) (throw (get result :error)))
            (js-call assert :strictEqual (get result :status) 0 (get result :stderr))
            (let ((observed (JSON/parse (await (readFile result-path "utf8")))))
              (js-call assert :strictEqual (get observed :closed) t)
              (js-call assert :strictEqual (get observed :asserted) t)
              (js-call assert :deepStrictEqual (get observed :trace)
                (js-array "driver-complete" "original-assertions" "close"))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "original child inheritance and Bun launcher retain actual arguments and preload only the maintained context"
    (async ()
      (let* ((environment (get globalThis.process :env))
             (keys (js-array "NODE_OPTIONS" "ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT" "ELISCRIPT_ORIGINAL_SOURCE_ROOT"))
             (saved (js-call keys :map (lambda (key) (js-array key (Object/hasOwn environment key) (get environment key)))))
             (directory (await (mkdtemp (resolve (tmpdir) "eliscript-original-launcher-"))))
             (configuration (resolve directory "actual config.json"))
             (preload (resolve root "tools/backends/compiler-corpus-host-context.mjs")))
        (try
          (put environment :NODE_OPTIONS "--max-old-space-size=8192")
          (inheritOriginalProgramContext (js-object :configuration configuration :sourceRoot root))
          (let ((first (get environment :NODE_OPTIONS)))
            (inheritOriginalProgramContext (js-object :configuration configuration :sourceRoot root))
            (js-call assert :strictEqual (get environment :NODE_OPTIONS) first)
            (js-call assert :ok (js-call first :includes (str "--import=" (get (pathToFileURL preload) :href))))
            (js-call assert :strictEqual (get environment :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT) configuration)
            (let* ((launcher (await (originalProgramBunLauncher
                     (js-object :directory directory :bun "/actual runtime/bun" :configuration configuration :sourceRoot root))))
                   (config (JSON/parse (await (readFile (str launcher ".json") "utf8")))))
              (js-call assert :strictEqual (await (readFile launcher "utf8"))
                (await (readFile (resolve root "tools/backends/original-program-bun-launcher.el") "utf8")))
              (js-call assert :deepStrictEqual config (js-object :bun "/actual runtime/bun"
                :preload preload :configuration configuration :sourceRoot root :nodeOptions "--max-old-space-size=8192"))
              (await (js-call assert :rejects (originalProgramBunLauncher
                (js-object :directory directory :bun "/actual runtime/bun" :configuration configuration :sourceRoot root))))))
          (finally
            (js-call saved :forEach (lambda (item)
              (if (aref item 1) (put environment (aref item 0) (aref item 2))
                (Reflect/deleteProperty environment (aref item 0)))))
            (await (rm directory (js-object :recursive t :force t))))))))
  (test "transient context adaptation refuses ambiguous descriptor aliases and leaves unrelated hosts and runtime identity untouched"
    (lambda ()
      (let* ((runtime (Object/freeze (js-object :invoke (lambda (name) name))))
             (context (Object/freeze (js-object :runtime runtime)))
             (input (js-object :target "wasm" :host "/product/tests/__eliscript_managed_transient-state_node_1.mjs"
               :descriptor (js-object :functions (js-array (js-object :name "held_state") (js-object :name "held-state"))))))
        (js-call assert :throws (lambda () (bindOriginalManagedProgramContext input context))
          (new globalThis.RegExp "ambiguous source aliases"))
        (put input :host "/product/tests/__eliscript_managed_transient-state_node_2.mjs")
        (js-call assert :strictEqual (bindOriginalManagedProgramContext input context) context)
        (put input :host "/product/tests/__eliscript_managed_core-modules_node_1.mjs")
        (js-call assert :strictEqual (bindOriginalManagedProgramContext input context) context)
        (js-call assert :strictEqual (get context :runtime) runtime))))

  (test "all four transient replays preserve original assertion bytes and bind the private context transport by actual SHA"
    (async ()
      (let* ((reader (createOriginalCorpusSourceReader (js-object :sourceRoot root)))
             (actual (js-array)) (baseline (js-array))
             (options (js-object :sourceRoot root :text (get reader :text) :file (get reader :file)
               :stableFiles (new globalThis.Set (js-array "tests/fixtures/wasm-managed-transient-state.eli"))
               :locators (js-array) :add (lambda (record) (js-call baseline :push record)))))
        (await (js-call legacy :addOriginalManagedLibraryAdapters options))
        (await (addOriginalManagedLibraryAdapters (Object/assign (js-object) options
          (js-object :add (lambda (record) (js-call actual :push record))))))
        (js-call assert :strictEqual (js-length actual) 4)
        (js-call assert :strictEqual (js-length actual) (js-length baseline))
        (let ((index 0))
          (while (< index (js-length actual))
            (let* ((record (aref actual index)) (before (aref baseline index))
                   (metadata (Object/assign (js-object) (get record :original)))
                   (assets (get metadata :sourceAssets))
                   (files (js-array "tools/backends/eliscript/compiler-corpus-host-context.eli"
                     "tools/backends/compiler-corpus-host-context.mjs" "tools/backends/compiler-corpus-host-context-legacy.mjs"
                     "tools/backends/original-program-bun-launcher.el"))
                   (position 0))
              (Reflect/deleteProperty metadata "sourceAssets")
              (js-call assert :deepStrictEqual metadata (get before :original))
              (js-call (js-array "id" "kind" "entry" "modules" "request" "memory" "auto" "execution" "expected" "coverage") :forEach
                (lambda (key) (js-call assert :deepStrictEqual (get record key) (get before key))))
              (while (< position (js-length files))
                (let* ((filename (aref files position))
                       (bound (js-call assets :filter (lambda (asset) (= (get asset :file) filename)))))
                  (js-call assert :strictEqual (js-length bound) 1)
                  (js-call assert :strictEqual (get (aref bound 0) :sourceSha256)
                    (hash (await (readFile (resolve root filename))))))
                (setq position (1+ position))))
            (setq index (1+ index)))))))

  (defun normal-resource-record ()
    (js-object :id "stable-compatibility:program:tests/fixtures/sequence-usage.eli" :kind "project"
      :entry "sequence-usage.mjs" :modules (js-array (js-object :id "sequence-usage.mjs"
        :filename "tests/fixtures/sequence-usage.eli" :source "(export)"))
      :request (js-object :operation "project")
      :execution (js-object :kind "original-program")
      :expected (js-object :kind "seed-program" :oracleRequired t)
      :original (js-object :manifest "stable-compatibility" :fixture "tests/fixtures/sequence-usage.eli")))

  (test "normal complete-program functional resources expose original implicit defaults and keep raw identities untouched"
    (lambda ()
      (let* ((record (normal-resource-record)) (before (globalThis.structuredClone record))
             (options (js-object :functionalRuntimeProfile "small"))
             (resources (independentCompilerResources (js-object :profile "small")))
             (acceptance (compilerCorpusRuntimeAcceptance record options)))
        (js-call assert :strictEqual (compilerCorpusRuntimeAcceptance record (js-object)) undefined)
        (js-call assert :deepStrictEqual (get acceptance :originalRuntimeOptions)
          (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216 :auto 0))
        (js-call assert :deepStrictEqual (get acceptance :effectiveRuntimeOptions)
          (Object/assign (js-object) (get resources :budget) (js-object :auto (get resources :auto))))
        (js-call assert :strictEqual (get acceptance :resourceAcceptance) "deferred")
        (js-call assert :strictEqual (Object/hasOwn acceptance "verification") false)
        (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (target)
          (let ((request (compilerCorpusRequest record target options)))
            (unless (= target "javascript")
              (js-call assert :deepStrictEqual (get request :memory) (get resources :memory))))))
        (put record :auto 0)
        (js-call assert :strictEqual (get (get (compilerCorpusRuntimeAcceptance record options) :effectiveRuntimeOptions) :auto) 0)
        (Reflect/deleteProperty record "auto")
        (js-call assert :deepStrictEqual record before))))

  (test "the original million-value core-exit recipes retain inputs and explicitly use the existing large functional heap without accepting capacity"
    (lambda ()
      (let ((options (js-object :functionalRuntimeProfile "small"))
            (resources (independentCompilerResources (js-object :profile "full-compiler"))))
        (js-call (js-array "vector" "map" "set") :forEach (lambda (collection)
          (let* ((record (normal-resource-record))
                 (original (get record :original)) (execution (get record :execution)))
            (put record :id (+ "stable-compatibility:program:persistent-core-exit-" collection))
            (put record :entry "value.mjs")
            (put record :modules (js-array (js-object :id "value.mjs" :filename "stdlib/value.eli" :source "(defconst value 1)")))
            (put original :fixture "stdlib/value.eli")
            (put original :host "tests/fixtures/persistent-core-exit-host.mjs")
            (put execution :host "tests/fixtures/persistent-core-exit-host.mjs")
            (put execution :arguments (js-array (js-object :directory t) (js-object :literal collection)))
            (let* ((before (globalThis.structuredClone record))
                   (acceptance (compilerCorpusRuntimeAcceptance record options)))
              (js-call assert :deepStrictEqual (get acceptance :originalRuntimeOptions)
                (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216 :auto 0))
              (js-call assert :deepStrictEqual (get acceptance :effectiveRuntimeOptions)
                (Object/assign (js-object) (get resources :budget) (js-object :auto (get resources :auto))))
              (js-call assert :strictEqual (get acceptance :effectiveRuntimeProfile) "full-compiler")
              (js-call assert :strictEqual (get acceptance :resourceAcceptance) "deferred")
              (js-call (js-array "wasm" "native") :forEach (lambda (target)
                (js-call assert :deepStrictEqual (get (compilerCorpusRequest record target options) :memory) (get resources :memory))))
              (js-call assert :deepStrictEqual record before)
              (put execution :runtimeOptions (js-object :maxSlots 64))
              (js-call assert :strictEqual (compilerCorpusRuntimeAcceptance record options) undefined)
              (Reflect/deleteProperty execution "runtimeOptions")
              (put original :host "tests/fixtures/another-host.mjs")
              ;; The original core-exit admission is bound to its real host.
              ;; An unrelated host is refused rather than gaining resources.
              (js-call assert :strictEqual (compilerCorpusRuntimeAcceptance record options) undefined)
              (put original :host "tests/fixtures/persistent-core-exit-host.mjs")
              (put (aref (get execution :arguments) 1) :literal "another")
              (js-call assert :strictEqual (get (compilerCorpusRuntimeAcceptance record options) :effectiveRuntimeProfile) "small"))))))))

  (test "functional small never overrides explicitly bounded or negative normal-program contracts"
    (lambda ()
      (let ((changes (js-array
        (lambda (record) (put (get record :execution) :runtimeOptions (js-object :maxSlots 64)))
        (lambda (record) (put record :error (js-object :code "ELI-RT0002")))
        (lambda (record) (put record :id "original-program:stdlib-capacity-recovery"))
        (lambda (record) (put record :kind "sequence"))
        (lambda (record) (put (get record :expected) :oracleRequired false))
        (lambda (record) (put (get record :execution) :runtimeProfile "compiler"))
        (lambda (record) (put record :id "original-managed-fixture:persistent-vector-auto-1:node")))))
        (js-call changes :forEach (lambda (change)
          (let* ((record (normal-resource-record)) (options (js-object :functionalRuntimeProfile "small")))
            (funcall change record)
            (js-call assert :strictEqual (compilerCorpusRuntimeAcceptance record options) undefined)))))))

  (test "source map companions use the selected actual dependency plan and retain all raw source assets and first failures"
    (async ()
      (let* ((entry (js-object :id "main.mjs" :filename "main.eli" :source "(import \"./dep.mjs\" value) (export value)"))
             (dependency (js-object :id "dep.mjs" :filename "dep.eli" :source "(defconst value -0) (export value)"))
             (unused (js-object :id "unused.mjs" :filename "unused.eli" :source "(defconst unused 3) (export unused)"))
             (record (js-object :id "original-program:source-map-contract" :kind "project" :entry "main.mjs"
               :modules (js-array entry dependency unused) :request (js-object :operation "project" :entries (js-array "main.mjs"))
               :execution (js-object :kind "original-program" :compilerSourceMaps t)))
             (before (globalThis.structuredClone record)) (calls (js-array))
             (context (js-object :record record :target "wasm" :options (js-object) :session (js-object
               :request (async (request configuration)
                 (js-call calls :push request)
                 (js-call assert :strictEqual (get request :operation) "project-plan")
                 (js-call assert :deepStrictEqual (get request :entries) (js-array "main.mjs"))
                 (js-call assert :deepStrictEqual (get request :modules) (get record :modules))
                 (js-object :format "eliscript-project-plan" :version 1 :mode "standard"
                   :entries (js-array "main.mjs") :modules
                     (js-array (js-object :id "dep.mjs" :dependencies (js-array))
                               (js-object :id "main.mjs" :dependencies (js-array "dep.mjs"))))))))
             (configured (await (prepareCompilerCorpusSourceMapContext context))))
        (js-call assert :strictEqual (js-length calls) 1)
        (js-call assert :strictEqual (get configured :session) (get context :session))
        (js-call assert :deepStrictEqual (get (get configured :record) :modules) (js-array entry dependency))
        (js-call assert :deepStrictEqual (get (get (get configured :record) :request) :entries) (js-array "main.mjs"))
        (js-call assert :strictEqual (get (get (get configured :record) :execution) :compilerSourceMaps) t)
        (js-call assert :deepStrictEqual record before)
        (let ((failure false))
          (put (get context :session) :request (async (request configuration) (throw failure)))
          (await (js-call assert :rejects (lambda () (prepareCompilerCorpusSourceMapContext context))
            (lambda (error) (eq error failure))))))
      (let ((context (js-object :record (normal-resource-record) :target "wasm")))
        (js-call assert :strictEqual (await (prepareCompilerCorpusSourceMapContext context)) context))))

  (test "the unrelated canonical-looking import reaches the original managed linker refusal without a host dependency preflight"
    (async ()
      (let* ((reader (createOriginalCorpusSourceReader (js-object :sourceRoot root)))
             (filename "tests/wasm-managed-core-modules.test.mjs")
             (source (await (js-call reader :text filename)))
             (baseline (js-array)) (actual (js-array))
             (options (js-object :sourceRoot root :text (get reader :text) :file (get reader :file)
               :stableFiles (new globalThis.Set (js-array "tests/fixtures/wasm-managed-core-modules.eli"))
               :locators (js-array (js-object :file filename :id "original-core-unrelated-refusal"
                 :contains "no actual source library"))
               :add (lambda (record) (js-call baseline :push record)))))
        (await (js-call legacy :addOriginalManagedLibraryAdapters options))
        (let ((before (globalThis.structuredClone baseline)))
          (await (addOriginalManagedLibraryAdapters (Object/assign (js-object) options
            (js-object :add (lambda (record) (js-call actual :push record))))))
          (let* ((original (js-call baseline :find (lambda (record)
                             (= (get record :id) "original-managed:core-modules:missing-private-graph"))))
                 (changed (js-call actual :find (lambda (record) (= (get record :id) (get original :id)))))
                 (expected (globalThis.structuredClone baseline))
                 (expected-record (js-call expected :find (lambda (record) (= (get record :id) (get original :id)))))
                 (step (js-call (get expected-record :steps) :find (lambda (step) (= (get step :id) "unrelated-path-refusal")))))
            (js-call assert :ok (js-call source :includes "backend.managed.lower_managed_project(unrelated,entry,runtimeIR,{literalModules})"))
