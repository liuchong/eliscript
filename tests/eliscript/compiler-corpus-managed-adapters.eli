              (await (writeFile (resolve directory "sources/record.json") (JSON/stringify changed)))
              (js-call assert :strictEqual (await (selectOriginalInteropRuntimeOptions input environment)) budget)
              (await (writeFile (resolve directory "sources/record.json") (JSON/stringify record))))
