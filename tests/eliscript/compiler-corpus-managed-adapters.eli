          (js-call assert :strictEqual (js-call events :listenerCount "beforeExit") 0)
          (js-call events :emit "beforeExit" 0)
          (js-call assert :deepStrictEqual errors (js-array))
          (js-call events :emit "exit" 0)
          (js-call assert :strictEqual (js-length errors) 1)
          (js-call assert :strictEqual (get events :exitCode) 1)
          (js-call events :emit "exit" 0)
          (js-call assert :strictEqual (js-length errors) 1))))))
  (test "actual Node preload exit cleanup leaves asynchronous module IO alive through beforeExit"
    (async ()
