(module tests.response-identities
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdir lstat realpath)
  (import "node:path" resolve)
  (import "node:module" createRequire)
  (import "../../tools/backends/build.mjs" root buildBackends backendModules)
  (import "../../tools/testing/fixture-environment.mjs" prepareFixtureEnvironment)
  (import "../../dist/bootstrap/compiler.mjs" compile-string)
  (import "../../dist/bootstrap/compiler.mjs" :as frontend)
  (import "../../tools/backends/compiler-session.mjs" createCompilerSession encodeCompilerIR)
  (defconst graph-mode "graph-events-v1")
  (defvar fixture undefined)
  (defvar pending undefined)
  (defasync check-unit-dependencies (directory)
    ;; The complete production source keeps its original relative imports.
    ;; Its fixture must own real generated siblings, including compiler-tools'
    ;; SHA dependency, instead of accepting dangling checkout output links.
    (let ((directories (js-array "bootstrap" "backends")) (index 0))
      (while (< index (js-length directories))
        (let* ((path (resolve directory (aref directories index))) (status (await (lstat path))))
          (js-call assert :strictEqual (js-call status :isDirectory) t)
          (js-call assert :strictEqual (js-call status :isSymbolicLink) false)
          (js-call assert :strictEqual (await (realpath path)) path))
        (setq index (1+ index))))
    (let* ((files (js-call
             (js-array "bootstrap/compiler.mjs" "bootstrap/reader.mjs" "bootstrap/expander.mjs"
               "bootstrap/analyzer.mjs" "bootstrap/lower.mjs" "bootstrap/ir.mjs" "bootstrap/symbol.mjs")
             :concat (js-call backendModules :map (lambda (name) (str "backends/" name ".mjs")))))
           (index 0))
      (while (< index (js-length files))
        (let ((status (await (lstat (resolve directory (aref files index))))))
          (js-call assert :strictEqual (js-call status :isFile) t)
          (js-call assert :strictEqual (js-call status :isSymbolicLink) false))
        (setq index (1+ index)))))
  (defasync production-unit ()
    (unless pending
      (setq pending (funcall (async ()
        (setq fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
        (let* ((directory (get fixture :directory)) (host (resolve directory "host"))
               (source (await (readFile (resolve root "bootstrap/host/compiler-session.eli") "utf8")))
               (end (js-call source :lastIndexOf ")"))
               (exported (+ (js-call source :slice 0 end)
                 "\n(export session-response-start session-response-control session-response-clear session-response-identities session-ir-wire))"))
               (output (resolve host "response-identities-unit.mjs")))
          (await (mkdir host (js-object :recursive t)))
          ;; Build the complete real dependency graph with the already loaded
          ;; frontend. Supplying it explicitly never selects a bootstrap seed
          ;; or assumes that dist/backends was generated by another test.
          (let ((built (await (buildBackends (js-object :outputRoot directory :frontend frontend)))))
            (js-call assert :strictEqual (get built :compiler) frontend)
            (js-call assert :strictEqual (get built :directory) (resolve directory "backends")))
          (await (check-unit-dependencies directory))
          ;; This serializer unit owns its host directory. Keep the complete
          ;; maintained sibling and its unchanged relative backend imports.
          (await (writeFile (resolve host "compiler-tools.mjs")
            (compile-string (await (readFile (resolve root "bootstrap/host/compiler-tools.eli") "utf8"))
              "compiler-tools.eli")))
          (js-call assert :strictEqual (js-call exported :slice 0 end) (js-call source :slice 0 end))
          (await (writeFile output (compile-string exported "response-identities-unit.eli")))
          (funcall (createRequire output) output))))))
    (await pending))
  (defun closeResponseIdentities ()
    (when fixture (js-call fixture :close) (setq fixture undefined pending undefined)))
  (defasync reconstruct (batches)
    (let* ((index 0)
           (driver (js-object :compiler_session_new (lambda () (js-object))
             :compiler_session_close (lambda (state) t)
             :compiler_session_request (lambda (state text)
               (let ((request (JSON/parse text)))
                 (encodeCompilerIR (if (= (get request :operation) "capabilities")
                   (js-object :responseStringChunks t)
                   (let ((batch (aref batches index))) (setq index (1+ index)) batch)))))))
           (session (await (createCompilerSession (js-object :host "javascript" :compiler driver)))))
      (try
        (let ((result (js-call session :request (js-object :operation "serializer-fixture")
                       (js-object :responseMode graph-mode))))
          (js-call assert :strictEqual index (js-length batches)) result)
        (finally (js-call session :close)))))
  (defun original-input ()
    (Array/from (js-object :length 300) (lambda (unused index) (js-object :index index))))
  (defun ids (count) (Array/from (js-object :length count) (lambda (unused index) (1+ index))))
  (defun wire (unit value)
    (JSON/parse (js-call unit :session_ir_wire value (new globalThis.Set))))
  (defasync runResponseIdentities ()
    (let ((unit (await (production-unit))))
      (js-call assert :strictEqual (get (js-call unit :session_response_identities 1048576) :limit) 1048576)
      (let ((state (js-call unit :compiler_session_new)))
        (try
          (let ((first (js-call unit :session_response_start state (original-input) graph-mode)))
            (js-call assert :strictEqual (get first :done) false)
            (js-call assert :strictEqual (get (get (get state :responseCursor) :identities) :limit) 1048576))
          (finally (js-call unit :compiler_session_close state))))
      (let ((limits (js-array 2 3)) (position 0))
        (while (< position (js-length limits))
          (let* ((limit (aref limits position)) (reads 0) (shared (js-object))
                 (_getter (Object/defineProperty shared "zero" (js-object :enumerable t :configurable t
                   :get (lambda () (setq reads (1+ reads)) -0.0))))
                 (state (js-call unit :compiler_session_new))
                 (source (js-call (js-array shared) :concat (original-input) (js-array shared (js-object :zero -0.0))))
                 (part (js-call unit :session_response_start state source graph-mode limit))
                 (cursor (get state :responseCursor)) (identities (get cursor :identities))
                 (parts (js-array)) (done false))
            (try
              (progn
                (while (not done)
                  (let ((segments (get identities :segments)))
                    (js-call assert :ok (> (js-length segments) 1))
                    (js-call assert :ok (js-call segments :every
                      (lambda (segment) (and (> (get segment :size) 0) (<= (get segment :size) limit)))))
                    (js-call assert :deepStrictEqual
                      (js-call segments :flatMap (lambda (segment) (Array/from (js-call segment :values))))
                      (ids (1- (get cursor :nextIdentity)))))
                  (js-call parts :push (wire unit part))
                  (if (get part :done) (setq done t)
                    (progn
                      (setq part (js-call unit :session_response_control state
                                   (js-object :token (get part :token)) "response-next"))
                      (when (get part :done) (js-call parts :push (wire unit part)) (setq done t)))))
                (js-call assert :strictEqual reads 1)
                (js-call assert :strictEqual (get state :responseCursor) nil)
                (js-call assert :strictEqual (get identities :segments) nil)
                (js-call assert :strictEqual (get cursor :identities) nil)
                (js-call assert :strictEqual (get cursor :nextIdentity) 0)
                (let* ((bun (get globalThis.globalThis :Bun)) (gc (when bun (get bun :gc))))
                  (when (= (value-type gc) "function") (Reflect/apply gc bun (js-array t))))
                (let ((result (await (reconstruct parts))))
                  (js-call assert :strictEqual (aref result 0) (aref result 301))
                  (js-call assert :notStrictEqual (aref result 0) (aref result 302))
                  (js-call assert :ok (Object/is (get (aref result 301) :zero) -0.0)))
                (let ((constructors (js-call (js-call parts :flatMap (lambda (batch) (get batch :events))) :filter
                                      (lambda (event) (or (= (aref event 0) "array") (= (aref event 0) "object"))))))
                  (js-call assert :deepStrictEqual (js-call constructors :map (lambda (event) (aref event 1))) (ids 303))))
              (finally (js-call unit :compiler_session_close state)))
            (js-call (js-array "cycle" "getter" "cancel") :forEach (lambda (failure)
              (let* ((state (js-call unit :compiler_session_new)) (input (original-input))
                     (reason (js-object :first failure)) (hits 0))
                (when (= failure "cycle") (put input 299 input))
                (when (= failure "getter")
                  (Object/defineProperty input 299 (js-object :get (lambda () (setq hits (1+ hits)) (throw reason)))))
                (let* ((first (js-call unit :session_response_start state input graph-mode limit))
                       (cursor (get state :responseCursor)) (index (get cursor :identities)))
                  (js-call assert :ok (> (js-length (get index :segments)) 1))
                  (try
                    (progn
                      (if (= failure "cancel")
                        (let ((result (JSON/parse (js-call unit :compiler_session_request state
                                         (JSON/stringify (js-object :operation "response-close" :token (get first :token)))))))
                          (js-call assert :strictEqual (get result :done) t)
                          (js-call assert :strictEqual (get result :version) 2))
                        (let ((threw false) (finished false))
                          (try
                            (while (not finished)
                              (setq finished (get (JSON/parse (js-call unit :compiler_session_request state
                                (JSON/stringify (js-object :operation "response-next" :token (get first :token))))) :done)))
                            (catch error
                              (setq threw t)
                              (if (= failure "getter") (js-call assert :strictEqual error reason)
                                (js-call assert :ok (js-call globalThis.TypeError (get globalThis.Symbol :hasInstance) error)))))
                          (js-call assert :ok threw)
                          (when (= failure "getter") (js-call assert :strictEqual hits 1))))
                      (js-call assert :strictEqual (get state :responseCursor) nil)
                      (js-call assert :strictEqual (get index :segments) nil)
                      (js-call assert :strictEqual (get cursor :identities) nil))
                    (finally (js-call unit :compiler_session_close state))))))))
          (setq position (1+ position))))
      (js-call (js-array undefined 0 -1 1.5 nil globalThis.NaN globalThis.Infinity 1048577 8388608 8388609) :forEach
        (lambda (size) (js-call assert :throws (lambda () (js-call unit :session_response_identities size)))))))
  (export runResponseIdentities closeResponseIdentities))
