(module tests.project-cli-stdin
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile)
  (import "node:path" resolve)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/testing/fixture-environment.mjs" prepareFixtureEnvironment)
  (import "../bootstrap/host/project-cli.mjs" parseArguments parseConfigurationJson readProjectConfiguration)
  (import "../bootstrap/host/project-cli-legacy.mjs" :as original)
  (test "project CLI retains original parser and configuration identities after maintained stdin transport"
    (lambda ()
      (js-call assert :strictEqual parseArguments (get original :parseArguments))
      (js-call assert :strictEqual parseConfigurationJson (get original :parseConfigurationJson))
      (js-call assert :strictEqual readProjectConfiguration (get original :readProjectConfiguration))))
  (test "actual Node project stdin preserves UTF8 and explicit sources including empty text while ordinary files never read fd zero"
    (js-object :timeout 120000)
    (async ()
      (let* ((scratch (prepareFixtureEnvironment root (get globalThis.process :env)))
             (directory (get scratch :directory)) (environment (get scratch :environment))
             (entry (resolve directory "entry.eli"))
             (node (get environment :NODE "node"))
             (module-directory (get environment :ELISCRIPT_BOOTSTRAP_MODULE_DIR (resolve root "dist/bootstrap"))))
        (try
          (await (writeFile entry "(defun answer () 7)\n(export answer)\n"))
          (js-call (js-array (js-array "stdin" 1 42 t) (js-array "null" 1 42 t)
                            (js-array "provided" 0 41 t) (js-array "empty" 0 nil false)
                            (js-array "file" 0 7 t)) :forEach (lambda (row)
            (let* ((mode (aref row 0))
                   (child (spawnSync node (js-array (resolve root "tests/helpers/project-cli-stdin-node.mjs")
                     mode entry (resolve directory mode) module-directory)
                     (js-object :cwd root :env environment :encoding "utf8"
                       :input "(defun answer () 42)\n(defun label () \"中😀\")\n(export answer label)\n"))))
              (js-call assert :strictEqual (get child :status) 0 (str mode ": " (get child :stderr)))
              (js-call assert :strictEqual (get child :signal) nil mode)
              (let ((report (JSON/parse (get child :stdout))))
                (js-call assert :strictEqual (get report :stdinReads) (aref row 1) mode)
                (js-call assert :strictEqual (get report :answer) (aref row 2) mode)
                (js-call assert :strictEqual (get report :hasAnswer) (aref row 3) mode)
                (when (= mode "stdin") (js-call assert :ok (js-call (get report :emitted) :includes "中😀")))))))
          (js-call assert :strictEqual (await (readFile entry "utf8")) "(defun answer () 7)\n(export answer)\n")
          (finally (js-call scratch :close))))))
)
