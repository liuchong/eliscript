(module tests.direct-wasm-error-profile
  (defconst standard-names (Object/freeze (js-array "length" "name" "prototype")))
  (defun same-names (actual expected label)
    (unless (and (Array/isArray actual) (Array/isArray expected)
                 (= (js-length actual) (js-length expected))
                 (js-call expected :every (lambda (name index) (= (aref actual index) name))))
      (throw (new globalThis.Error (str label " actual=" (JSON/stringify actual)
        " expected=" (JSON/stringify expected))))))
  (defun assertDirectReflectionProfile (mode actual-keys actual-names host-keys host-names)
    (same-names actual-keys (if (= mode 3) (js-array) host-keys) (str "builtin keys mode=" mode))
    (same-names actual-names (if (= mode 3) standard-names host-names) (str "builtin names mode=" mode))
    (js-object :mode mode :keys (js-call actual-keys :slice) :names (js-call actual-names :slice)
      :hostKeys (js-call host-keys :slice) :hostNames (js-call host-names :slice)
      :hostExtensions (if (= mode 3)
        (js-call host-names :filter (lambda (name) (not (js-call standard-names :includes name)))) (js-array))))
  (export assertDirectReflectionProfile))
