(module tests.managed-fixture-repairs
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/testing/managed-fixture-repairs.mjs" managedFixtureRepairPlans nativePrototypeFixtureSource managedReferenceChildArguments
    managedFixtureTestMethod managedFixtureRealmPressureTitle persistentBoundaryFixtureSource managedFixtureFunctionalArguments)
  (test "only the complete authenticated project graph case defers its original total deadline under both functional flags"
    (lambda ()
      (let* ((plan (js-call managedFixtureRepairPlans :find (lambda (item)
               (= (get item :suite) "tests/wasm-managed-project-linking.test.mjs"))))
             (callback (lambda () "complete original 32 graph inputs"))
             (arguments (js-array "fixed random module graphs agree with independent binding models and fresh JS projects" callback 30000))
             (environment (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1"
               :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small"))
             (actual (managedFixtureFunctionalArguments plan environment arguments)))
        (js-call assert :deepStrictEqual actual (js-array (aref arguments 0) callback 0))
        (js-call assert :strictEqual (aref arguments 2) 30000)
        (js-call (js-array (js-object) (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1")
          (js-object :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small")) :forEach
          (lambda (env) (js-call assert :strictEqual (managedFixtureFunctionalArguments plan env arguments) arguments)))
        (js-call assert :strictEqual (managedFixtureFunctionalArguments
          (Object/assign (js-object) plan (js-object :sha256 "changed")) environment arguments) arguments)
        (let ((unrelated (js-array (str (aref arguments 0) " other") callback 30000)))
          (js-call assert :strictEqual (managedFixtureFunctionalArguments plan environment unrelated) unrelated))
        (let* ((regexp-plan (js-call managedFixtureRepairPlans :find (lambda (item)
                 (= (get item :suite) "tests/wasm-managed-regexp.test.mjs"))))
               (model (js-array "deterministic pattern/text models preserve captures and priorities including nullable repeated groups" callback 30000)))
          (js-call assert :deepStrictEqual (managedFixtureFunctionalArguments regexp-plan environment model)
            (js-array (aref model 0) callback 0))
          (js-call assert :strictEqual (managedFixtureFunctionalArguments regexp-plan (js-object) model) model)))))
  (test "fixture framework native methods keep their real receiver and preserve noncallable properties"
    (lambda ()
      (let* ((marker (js-object)) (target (lambda () nil))
             (method (new globalThis.Proxy (lambda () nil) (js-object :apply
               (lambda (callee receiver arguments)
                 (js-call assert :strictEqual receiver target)
                 (js-call assert :deepStrictEqual arguments (js-array false)) marker)))))
        (put target :skipIf method) (put target :marker marker)
        (js-call assert :strictEqual (funcall (managedFixtureTestMethod target "skipIf") false) marker)
        (js-call assert :strictEqual (managedFixtureTestMethod target "marker") marker)
        (js-call assert :strictEqual (managedFixtureTestMethod target "unknown") undefined))))
  (test "only the exact original realm capacity case can be deferred with both explicit functional options"
    (lambda ()
      (let* ((plan (js-call managedFixtureRepairPlans :find (lambda (item)
               (= (get item :suite) "tests/wasm-managed-realm-lifetime.test.mjs"))))
             (environment (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1"
               :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small")))
        (js-call assert :strictEqual (managedFixtureRealmPressureTitle plan environment)
          "reading default null and custom Array prototype identity does not observe its methods in the original 64 slots")
        (js-call (js-array (js-object) (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1")
          (js-object :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small")) :forEach (lambda (env)
          (js-call assert :strictEqual (managedFixtureRealmPressureTitle plan env) undefined)))
        (js-call (js-array (Object/assign (js-object) plan (js-object :sha256 "changed"))
          (Object/assign (js-object) plan (js-object :suite "tests/unrelated.test.mjs"))) :forEach (lambda (other)
          (js-call assert :strictEqual (managedFixtureRealmPressureTitle other environment) undefined))))))
  (test "managed fixture repair plans preserve all nineteen complete original source identities"
    (lambda ()
      (js-call assert :strictEqual (js-length managedFixtureRepairPlans) 19)
      (js-call managedFixtureRepairPlans :forEach (lambda (plan)
        (js-call assert :strictEqual
          (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root (get plan :suite)))) :digest "hex")
          (get plan :sha256))))))
  (test "only the authenticated persistent boundary normalizes its eight supplied module coordinates without granting host capabilities"
    (lambda ()
      (let* ((suite (readFileSync (resolve root "tests/wasm-managed-persistent-literals.test.mjs") "utf8"))
             (start (+ (js-call suite :indexOf "const boundarySource = `") (js-length "const boundarySource = `")))
             (end (js-call suite :indexOf "`;" start))
             (source (js-call suite :slice start end))
             (actual (persistentBoundaryFixtureSource source "persistent-boundary.eli")))
        (js-call assert :ok (> start (js-length "const boundarySource = `")))
        (js-call assert :ok (> end start))
        (js-call (js-array "regex" "sorted" "metadata" "value" "value-internals" "protocol" "type" "record") :forEach
          (lambda (name)
            (js-call assert :strictEqual (js-length (js-call actual :split (str "(import \"eliscript/runtime/core/" name ".mjs\" "))) 2)))
        (js-call assert :strictEqual (persistentBoundaryFixtureSource source "ordinary-user.eli") source)
        (js-call assert :throws (lambda () (persistentBoundaryFixtureSource "" "persistent-boundary.eli")) globalThis.TypeError)
        (js-call assert :throws (lambda () (persistentBoundaryFixtureSource (str source source) "persistent-boundary.eli")) globalThis.TypeError)
        (let* ((extra "\n(import \"eliscript/runtime/core/unknown\" missing)")
               (with-unknown (persistentBoundaryFixtureSource (str source extra) "persistent-boundary.eli")))
          (js-call assert :ok (js-call with-unknown :endsWith extra))))))
  (test "only the original prototype NaN expression becomes its current equivalent Eli spelling"
    (lambda ()
      (let* ((source "(defun value () (js* \"NaN\")) (export value)")
             (expected "(defun value () (get globalThis/Number :NaN)) (export value)"))
        (js-call assert :strictEqual (nativePrototypeFixtureSource source "native-prototype-callables.eli") expected)
        (js-call assert :strictEqual (nativePrototypeFixtureSource source "ordinary-user.eli") source)
        (js-call (js-array "" expected (str source source)) :forEach (lambda (changed)
          (js-call assert :throws (lambda () (nativePrototypeFixtureSource changed "native-prototype-callables.eli")) globalThis.TypeError))))))
  (test "file reference preload preserves every original child script byte option deadline and nonmatching argument identity"
    (lambda ()
      (let* ((script (readFileSync (resolve root "tests/wasm-managed-realm-lifetime.test.mjs") "utf8"))
             (preload (resolve root "tests/helpers/managed-reference-node.mjs"))
             (arguments (js-array "--input-type=module" "--eval" script))
             (before (js-call arguments :slice))
             (actual (managedReferenceChildArguments arguments preload)))
        (js-call assert :deepStrictEqual actual (js-call (js-array "--import" preload) :concat before))
        (js-call assert :strictEqual (aref actual 4) script)
        (js-call assert :deepStrictEqual arguments before)
        (let ((ordinary (js-array "--test" "tests/ordinary.test.mjs")))
          (js-call assert :strictEqual (managedReferenceChildArguments ordinary preload) ordinary))
        (js-call assert :throws (lambda () (managedReferenceChildArguments nil preload)) globalThis.TypeError)))))
