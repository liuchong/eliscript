(module tests.compiler-metadata-private-cases
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" join)
  (import "node:crypto" createHash)
  (import "../../tools/backends/compiler-session.mjs" encodeCompilerMetadata)
  (import "../../tools/backends/compiler-build.mjs" compilerMetadataDigest writeCompilerMetadata)
  (import "../../tools/backends/compiler-metadata.mjs" readCompilerMetadata)
  (import "./compiler-build-private.mjs" loadCompilerBuildPrivateUnit)
  (defun eqv (a b &optional message) (js-call assert :strictEqual a b message))
  (defun deep (a b &optional message) (js-call assert :deepStrictEqual a b message))
  (defun ok (a &optional message) (js-call assert :ok a message))
  (defun each (items callback) (js-call items :forEach callback))
  (defasync each-await (items callback)
    (let ((index 0)) (while (< index (js-length items))
      (await (funcall callback (aref items index))) (setq index (1+ index)))))
  (defun digest (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defasync rejects-original (run reason)
    (let ((threw false)) (try (await (funcall run)) (catch error (setq threw t) (eqv error reason)))
      (eqv threw t "saving must propagate the original thrown value")))
  (defasync utf8-case ()
    (let* ((unit (await (loadCompilerBuildPrivateUnit))) (real (get unit :real))
           (raw (js-array "" "\ud800" "\udc00" "\u0000" "😀中" (+ (js-call "a" :repeat 65535) "😀")
             (+ (js-call "中" :repeat 21845) "😀") (+ (js-call "😀" :repeat 32769) "\ud800Z\udc00")))
           (encoder (new globalThis.TextEncoder)) (buffer (new globalThis.Uint8Array 65536)) (encoded (js-array)))
      (each raw (lambda (chunk)
        (deep (js-call real :compilerMetadataUtf8Block encoder buffer "" 0) (js-object :read 0 :written 0))
        (let ((start 0)) (while (< start (js-length chunk))
          (let* ((result (js-call real :compilerMetadataUtf8Block encoder buffer chunk start))
                 (read (get result :read)) (written (get result :written)))
            (ok (and (> read 0) (> written 0) (<= written 65536)))
            (js-call encoded :push (globalThis.Buffer.from (js-call buffer :subarray 0 written)))
            (setq start (+ start read)))))))
      (deep (globalThis.Buffer.concat encoded)
        (globalThis.Buffer.concat (js-call raw :map (lambda (chunk) (globalThis.Buffer.from chunk "utf8"))))
        "separate high/low surrogate chunks must not be silently joined into an astral scalar")
      (each (js-array 4 7) (lambda (size)
        (let ((bytes (new globalThis.Uint8Array size)) (text (js-call "A😀中\ud800Z\udc00\u0000" :repeat 19))
              (chunks (js-array)) (start 0))
          (while (< start (js-length text))
            (let ((result (js-call real :compilerMetadataUtf8Block encoder bytes text start)))
              (js-call chunks :push (globalThis.Buffer.from (js-call bytes :subarray 0 (get result :written))))
              (setq start (+ start (get result :read)))))
          (deep (globalThis.Buffer.concat chunks) (globalThis.Buffer.from text "utf8")))))
      (let ((directory (await (mkdtemp (join (tmpdir) "eliscript-metadata-private-")))))
        (try
          (progn
            (await (each-await (js-array -3 -2 -1 0 1 2 3) (async (offset)
              (let* ((text (+ (js-call "a" :repeat (+ 65536 offset)) "😀" (js-call "中" :repeat 22000) "\ud800\u0000\udc00😀"))
                     (value (js-object :empty "" :text text :zero -0 :values (js-array text undefined (funcall globalThis.BigInt "7") globalThis.NaN)))
                     (wire (encodeCompilerMetadata value)) (expected (globalThis.Buffer.from (+ wire "\n") "utf8"))
                     (public (join directory (+ "public-" offset ".json"))) (owned (join directory (+ "owned-" offset ".json"))))
                (eqv (compilerMetadataDigest value) (digest (globalThis.Buffer.from wire "utf8")))
                (await (Promise/all (js-array (writeCompilerMetadata public value) (js-call real :writeOwnedCompilerMetadata owned value))))
                (deep (await (readFile public)) expected) (deep (await (readFile owned)) expected)
                (deep (await (js-call real :compilerFileIdentity public (new globalThis.Uint8Array 65536)))
                  (js-object :bytes (js-length expected) :sha256 (digest expected)))))))
            (let* ((trace (js-array)) (shared (js-object :text (js-call raw :join "|") :zero -0))
                   (value (js-object)) (expected undefined) (path (join directory "concurrent-snapshot.json"))
                   (other (join directory "independent.json")))
              (Object/defineProperty value "first" (js-object :enumerable t :get (lambda () (js-call trace :push "first") shared)))
              (Object/defineProperty value "second" (js-object :enumerable t :get (lambda ()
                (js-call trace :push "second")
                (eqv (compilerMetadataDigest (js-object :nested (get shared :text)))
                  (digest (globalThis.Buffer.from (encodeCompilerMetadata (js-object :nested (get shared :text)))))) shared)))
              (setq expected (globalThis.Buffer.from (+ (encodeCompilerMetadata (js-object
                :first (Object/assign (js-object) shared) :second (Object/assign (js-object) shared))) "\n")))
              (let ((pending (writeCompilerMetadata path value)))
                (deep trace (js-array "first" "second")) (put shared :text "changed") (put shared :zero 0)
                (await (Promise/all (js-array pending (writeCompilerMetadata other (js-object :text (js-call "different😀" :repeat 20000))))))
                (deep (await (readFile path)) expected) (deep trace (js-array "first" "second"))
                (eqv (get (await (readCompilerMetadata other)) :text) (js-call "different😀" :repeat 20000)))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
  (defasync write-case ()
    (let* ((make-unit (get (await (loadCompilerBuildPrivateUnit)) :makeUnit))
           (value (js-object :text (+ (js-call "中😀" :repeat 22000) "\ud800\u0000") :zero -0))
           (expected (globalThis.Buffer.from (+ (encodeCompilerMetadata value) "\n"))))
      (await (each-await (js-array false t) (async (owned)
        (let ((output (js-array)) (stores (new globalThis.Set)) (calls 0) (closes 0))
          (letfn ((write (bytes offset length)
            (ok (<= (get bytes :byteLength) 65536)) (js-call stores :add (get bytes :buffer))
            (let ((count (Math/min length (aref (js-array 1 7 65536) (% calls 3)))))
              (setq calls (1+ calls)) (js-call output :push (globalThis.Buffer.from (js-call bytes :subarray offset (+ offset count)))) count)))
            (let* ((file (js-object :fd 7 :write (async (bytes offset length)
                           (await (Promise/resolve)) (js-object :bytesWritten (write bytes offset length)))
                         :close (async () (setq closes (1+ closes)))))
                   (unit (funcall make-unit (async () file) (lambda (fd bytes offset length) (eqv fd 7) (write bytes offset length))))
                   (name (if owned "writeOwnedCompilerMetadata" "writeCompilerMetadata")))
              (await (funcall (get unit name) "unused" value))
              (ok (> calls 3)) (eqv (get stores :size) 1 "one backing allocation serves every block and partial write")
              (eqv closes 1) (deep (globalThis.Buffer.concat output) expected)
              (let* ((first (js-object :write "original")) (secondary (js-object :close "secondary"))
                     (failing (funcall make-unit (async () (js-object :fd 9 :write (async () (throw first)) :close (async () (throw secondary))))
                       (lambda () (throw first))))
                     (closing (funcall make-unit (async () (js-object :fd 9 :write (async (bytes offset length) (js-object :bytesWritten length))
                       :close (async () (throw secondary)))) (lambda (fd bytes offset length) length))))
                (await (rejects-original (lambda () (funcall (get failing name) "unused" value)) first))
                (await (rejects-original (lambda () (funcall (get closing name) "unused" value)) secondary)))
              (await (each-await (js-array 0 -1 0.5 65537) (async (count)
                (let ((invalid (funcall make-unit (async () (js-object :fd 9 :write (async () (js-object :bytesWritten count)) :close (async () nil)))
                                 (lambda () count))))
                  (await (js-call assert :rejects (funcall (get invalid name) "unused" (js-object :value 1))
                    (new globalThis.RegExp "compiler metadata write did not advance")))))))))))))
      (let* ((opened 0) (original (js-object :getter "before open"))
             (unit (funcall make-unit (async () (setq opened (1+ opened)) (throw (new globalThis.Error "must not replace getter failure")))))
             (input (js-object)))
        (Object/defineProperty input "first" (js-object :enumerable t :get (lambda () (throw original))))
        (await (rejects-original (lambda () (js-call unit :writeCompilerMetadata "unused" input)) original))
        (eqv opened 0))))
  (defasync read-case ()
    (let* ((make-unit (get (await (loadCompilerBuildPrivateUnit)) :makeUnit))
           (input (globalThis.Buffer.from (js-call "中😀\u0000\ud800" :repeat 30000))) (stores (new globalThis.Set))
           (position 0) (calls 0) (closes 0)
           (unit (funcall make-unit (async () (js-object :read (async (buffer offset length at)
             (eqv offset 0) (eqv at nil) (eqv length 65536) (js-call stores :add (get buffer :buffer))
             (let ((count (Math/min length (aref (js-array 1 7 65536) (% calls 3)) (- (js-length input) position))))
               (setq calls (1+ calls)) (js-call buffer :set (js-call input :subarray position (+ position count)) offset)
               (setq position (+ position count)) (js-object :bytesRead count)))
             :close (async () (setq closes (1+ closes))))))))
      (deep (await (js-call unit :compilerFileIdentity "unused" (new globalThis.Uint8Array 65536)))
        (js-object :bytes (js-length input) :sha256 (digest input)))
      (ok (> calls 3)) (eqv (get stores :size) 1) (eqv closes 1)
      (let* ((first (js-object :read "original")) (secondary (js-object :close "secondary"))
             (failing (funcall make-unit (async () (js-object :read (async () (throw first)) :close (async () (throw secondary))))))
             (closing (funcall make-unit (async () (js-object :read (async () (js-object :bytesRead 0)) :close (async () (throw secondary)))))))
        (await (rejects-original (lambda () (js-call failing :compilerFileIdentity "unused" (new globalThis.Uint8Array 65536))) first))
        (await (rejects-original (lambda () (js-call closing :compilerFileIdentity "unused" (new globalThis.Uint8Array 65536))) secondary)))
      (await (each-await (js-array -1 0.5 65537 undefined) (async (count)
        (let ((invalid (funcall make-unit (async () (js-object :read (async () (js-object :bytesRead count)) :close (async () nil))))))
          (await (js-call assert :rejects (js-call invalid :compilerFileIdentity "unused" (new globalThis.Uint8Array 65536))
            (new globalThis.RegExp "invalid byte count")))))))))
  (defconst metadataPrivateCases (js-object
    "fixed UTF8 buffers preserve per-chunk surrogate rules and real public owned files digests and concurrent snapshots" utf8-case
    "fixed metadata write buffers await partial writes before reuse and preserve original write close and snapshot errors" write-case
    "fixed file identity buffers preserve short reads exact bytes and first read versus close errors" read-case))
  (export metadataPrivateCases))
