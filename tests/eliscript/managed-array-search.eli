(module tests.managed-array-search
	(import "bun:test" beforeAll afterAll describe test)
	(import "node:assert/strict" :default assert)
	(import "node:fs/promises" readFile mkdtemp rm writeFile mkdir readdir)
	(import "node:path" resolve relative)
	(import "node:module" createRequire)
	(import "node:url" pathToFileURL)
	(import "node:child_process" spawnSync)
	(import "../tools/backends/build.mjs" buildBackends root)
	(import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
	(import "./helpers/managed-browser-transport.mjs" loadManagedReference runManagedNode bundleManagedBrowserPage serveManagedBrowserPage)
	(import "./helpers/managed-array-search-abi.mjs" registerOriginalArraySearchAbi)
	(import "playwright-core" chromium firefox webkit)
	(defvar directory undefined) (defvar b undefined) (defvar runtime undefined) (defvar source undefined)
	(beforeAll (async ()
			  (setq directory (await (mkdtemp (resolve root ".eliscript-array-search-"))))
			  (setq b (await (buildBackends (js-object :outputRoot directory))))
			  (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
			  (setq source (await (readFile "tests/fixtures/wasm-managed-array-search.eli" "utf8")))) 120000)
	(afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
	(defasync fixture (name) (await (readFile (str "tests/fixtures/managed-array-search-" name ".eli") "utf8")))
	(defasync compiled (&rest supplied)
 (let* ((text (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) source (aref supplied 0)))
        (options (if (> (js-length supplied) 1) (aref supplied 1) undefined))
        (p (js-call (get b :compiler) :compile_ir_string text "array-search.eli"))
        (saved (JSON/stringify p))
        (bytes (js-call globalThis.Uint8Array :from (js-call (get b :managed) :emit_managed_wasm p runtime))))
  (js-call assert :strictEqual (JSON/stringify p) saved)
  (js-call assert :ok (js-call globalThis.WebAssembly :validate bytes))
  (js-call assert :deepStrictEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
  (let ((a (instantiateManagedRuntime bytes options)))
   (js-call a :auto 1)
   (js-object :a a :js (await (loadManagedReference directory (js-call (get b :compiler) :emit_ir_string p) "array-search")) :bytes bytes))))
	(defun box (a v) (cond ((= (value-type v) "number") (js-call a :number v))
			       ((= (value-type v) "string") (js-call a :string v)) (t v)))
	(defun array (a values)
	  (let* ((entries (js-call values :map (lambda (v) (box a v)))) (out (js-call a :sourceArray entries)))
	    (js-call entries :forEach (lambda (v) (js-call a :release v))) out))
	(defun read (a v)
	  (cond ((or (not v) (/= (value-type v) "object")) v)
		((= (get v :kind) 4) (js-call a :readNumber v)) ((= (get v :kind) 5) (js-call a :readString v))
		(t (Array/from (js-object :length (js-call a :length v)) (lambda (ignored i)
									   (let ((x (js-call a :get v i))) (try (read a x) (finally (js-call a :release x)))))))))
	(defun run (a name &rest supplied)
 (let* ((args (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-array) (aref supplied 0)))
        (out (js-call a :invoke name args)))
  (try (read a out) (finally (js-call a :release out)))))
	(defun finish (a &rest supplied)
 (let ((values (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-array) (aref supplied 0))))
  (js-call values :forEach (lambda (v) (js-call a :release v))))
 (js-call a :closeModule) (js-call a :collect)
 (js-call assert :strictEqual (js-call a :live) 0)
 (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))
	(defun names () (js-array "includes" "index" "last"))

	(test "Array includes uses SameValueZero while indexOf and lastIndexOf retain strict equality, sparse holes and exact fromIndex semantics"
	      (async ()
		     (let* ((c (await (compiled))) (a (get c :a)) (js (get c :js)) (sparse (new globalThis.Array 5))
			    (starts (js-array undefined nil false t globalThis.NaN globalThis.Infinity (- globalThis.Infinity) -0.0 0 0.9 -0.9 1.9 -1.9 4 5 9 -9
					      2147483648 -2147483648 4294967296 -4294967296 9007199254740992 -9007199254740992 globalThis.Number.MIN_VALUE (- globalThis.Number.MIN_VALUE) "2" "-2" "x")))
		       (put sparse 1 undefined) (put sparse 3 globalThis.NaN)
		       (js-call (js-array (js-array) (js-array 0 -0.0 globalThis.NaN "中😀" false nil undefined 0) sparse) :forEach (lambda (values)
																      (let ((items (array a values)))
																	(js-call (js-array undefined nil false globalThis.NaN 0 -0.0 "中😀" "missing") :forEach (lambda (value)
																												  (let ((needle (box a value)))
																												    (js-call starts :forEach (lambda (start)
																															       (let ((from (box a start)))
																																 (js-call (names) :forEach (lambda (name)
																																			     (js-call assert :ok (Object/is (run a name (js-array items needle from)) (js-call js name values value start)) (str name ":" (funcall globalThis.String start)))))
																																 (js-call a :release from))))
																												    (js-call assert :strictEqual (run a "default-last" (js-array items needle)) (js-call js :default_last values value))
																												    (js-call a :release needle))))
																	(js-call (js-array "missing-includes" "missing-index" "missing-last") :forEach (lambda (name)
																											 (js-call assert :strictEqual (run a name (js-array items)) (js-call js (js-call name :replaceAll "-" "_") values))))
																	(js-call a :release items)))) (finish a))))

	(registerOriginalArraySearchAbi (lambda ()
					  (js-object :compiled compiled :array array :run run :finish finish :fixture fixture :b b)))
	(test "public Seed and three compiler generations retain identical search IR descriptors and executable zero-import bytes"
	      (async ()
		     (let* ((output (resolve directory "search-seed.mjs"))
			    (seed (spawnSync (resolve root "bin/eliscript-seed")
					     (js-array "--output" output (resolve root "tests/fixtures/wasm-managed-array-search.eli"))
					     (js-object :encoding "utf8" :timeout 30000)))
			    (all (js-array b)) (seed-js (await (readFile output "utf8")))
			    (runtime-source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
			    (files (js-call (js-call (await (readdir "bootstrap/compiler")) :filter (lambda (f) (js-call f :endsWith ".eli"))) :sort)))
		       (js-call assert :strictEqual (get seed :status) 0 (get seed :stderr))
		       (let ((index 0) (generation-names (js-array "g2" "g3")))
			 (while (< index 2)
			   (let* ((previous (get (js-call all :at -1) :compiler)) (out (resolve directory (aref generation-names index)))
				  (bootstrap (resolve out "bootstrap")) (file-index 0))
			     (await (mkdir bootstrap (js-object :recursive t)))
			     (while (< file-index (js-length files))
			       (let* ((file (aref files file-index)) (input (resolve root "bootstrap/compiler" file))
				      (target (js-call file :replace (new globalThis.RegExp "\\.eli$") ".mjs"))
				      (emission (js-call previous :compile_string_with_source_map
							 (await (readFile input "utf8")) input target (relative bootstrap input))))
				 (await (writeFile (resolve bootstrap target) (get emission :javascript))))
			       (setq file-index (1+ file-index)))
			     (let* ((next (await (buildBackends (js-object :outputRoot out :frontend previous))))
				    (path (resolve bootstrap "compiler.mjs")))
			       (put next :compiler (funcall (createRequire path) path)) (js-call all :push next)))
			   (setq index (1+ index))))
		       (let ((canonical undefined) (lowered undefined) (bytes undefined) (index 0))
			 (while (< index (js-length all))
			   (let* ((g (aref all index)) (compiler (get g :compiler)) (managed (get g :managed))
				  (p (js-call compiler :compile_ir_string source "array-search.eli"))
				  (rt (js-call compiler :compile_ir_string runtime-source "runtime.eli"))
				  (lower (js-call managed :lower_managed_program p rt)) (binary (js-call managed :emit_managed_wasm p rt)))
			     (js-call assert :strictEqual (js-call compiler :emit_ir_string p) seed-js)
			     (if canonical (progn (js-call assert :deepStrictEqual p canonical) (js-call assert :deepStrictEqual lower lowered) (js-call assert :deepStrictEqual binary bytes))
			       (setq canonical p lowered lower bytes binary))
			     (let* ((a (instantiateManagedRuntime (js-call globalThis.Uint8Array :from binary)))
				    (items undefined) (nan undefined) (zero undefined))
			       (js-call a :auto 1)
			       (setq items (array a (js-array globalThis.NaN -0.0 undefined)) nan (js-call a :number globalThis.NaN))
			       (js-call assert :strictEqual (run a "includes" (js-array items nan undefined)) t)
			       (js-call a :release nan) (setq zero (js-call a :number 0))
			       (js-call assert :strictEqual (run a "default-last" (js-array items zero)) 1)
			       (js-call a :release zero) (finish a (js-array items))))
			   (setq index (1+ index)))))) 120000)
	(test "Node independently executes identical search bytes and original sparse-array semantics"
	      (async () (let* ((c (await (compiled))) (file (resolve directory "search.wasm")))
			  (finish (get c :a)) (await (writeFile file (get c :bytes)))
			  (let ((result (runManagedNode (resolve root "tests/helpers/managed-array-search-node.mjs") (js-array file)
							(js-object :encoding "utf8" :timeout 30000))))
			    (js-call assert :strictEqual (get result :status) 0 (get result :stderr))))))
	(describe "actual browser array search" (lambda ()
						  (let* ((browser undefined) (server undefined) (runtime-source undefined) (javascript undefined)
							 (browser-name (or (get (get globalThis.process :env) :ELISCRIPT_TEST_BROWSER) "chromium"))
							 (engines (js-object :chromium chromium :firefox firefox :webkit webkit)))
						    (js-call assert :ok (Object/hasOwn engines browser-name))
						    (beforeAll (async ()
								      (setq runtime-source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
								      (setq javascript (js-call (get b :compiler) :emit_ir_string (js-call (get b :compiler) :compile_ir_string source "array-search.eli")))
								      (let ((bundle (await (bundleManagedBrowserPage (resolve root "tests/helpers/managed-array-search-page.mjs")
														     (js-object "eliscript-test/compiler" (resolve directory "bootstrap/compiler.mjs")
																"eliscript-test/managed" (resolve (get b :directory) "managed.mjs"))))))
									(setq server (serveManagedBrowserPage bundle javascript)))
								      (setq browser (await (js-call (get engines browser-name) :launch)))
								      (let ((page (await (js-call browser :newPage))))
									(await (js-call page :goto (get (get server :url) :href))) (await (js-call page :close)))) 120000)
						    (afterAll (async () (try (when browser (await (js-call browser :close)))
									     (finally (when server (js-call server :stop t))))))
						    (test "browser compiler emits identical search bytes and executes exact equality holes and fromIndex results against its own JS"
							  (async () (let ((context (await (js-call browser :newContext))))
								      (try
								       (let ((page (await (js-call context :newPage))))
									 (await (js-call page :goto (get (get server :url) :href)))
									 (await (js-call page :waitForFunction (lambda () (get globalThis.globalThis :__eliscriptArraySearchCase))))
									 (let ((binary (await (js-call page :evaluate (async (input)
															     (await (funcall (get globalThis.globalThis :__eliscriptArraySearchCase) input)))
												       (js-object :source source :runtimeSource runtime-source :javascript javascript)))))
									   (js-call assert :deepStrictEqual binary (js-call (get b :managed) :emit_managed_wasm
															    (js-call (get b :compiler) :compile_ir_string source "array-search.eli")
															    (js-call (get b :compiler) :compile_ir_string runtime-source "runtime.eli")))))
								       (finally (await (js-call context :close))))))))))
	(test "fromIndex uses valueOf then toString after extra arguments and snapshots every converted operand through GC"
	      (async () (let* ((c (await (compiled (await (fixture "conversion"))))) (a (get c :a)) (js (get c :js)))
			  (js-call (js-array 0 1 2) :forEach (lambda (method)
							       (let ((m (js-call a :number method)))
								 (js-call assert :strictEqual (run a "f" (js-array m)) (js-call js :f method)) (js-call a :release m)))) (finish a))))

  (test "search snapshots length before fromIndex conversion and reads mutations live while ignoring growth past the snapshot"
    (async ()
      (let* ((c (await (compiled (await (fixture "mutations")))))
             (a (get c :a)) (js (get c :js)))
        (js-call (js-array 0 1 2) :forEach
          (lambda (method)
            (js-call (js-array 0 1 2) :forEach
              (lambda (mode)
                (js-call (js-array undefined 9) :forEach
                  (lambda (needle)
                    (let ((m (js-call a :number method))
                          (mood (js-call a :number mode))
                          (n (box a needle)))
                      (js-call assert :deepStrictEqual
                        (run a "f" (js-array m mood n))
                        (js-call js :f method mode needle))
                      (js-call (js-array m mood n) :forEach
                        (lambda (value) (js-call a :release value))))))))))
        (finish a))))

  (test "empty searches skip fromIndex coercion after evaluating every argument and own methods are captured before those argument effects"
    (async ()
      (let* ((c (await (compiled (await (fixture "empty")))))
             (a (get c :a)) (js (get c :js)))
        (js-call (js-array "empty" "captured") :forEach
          (lambda (name)
            (js-call assert :deepStrictEqual (run a name) (js-call js name))))
        (finish a))))

  (test "opaque values compare by identity without coercion and identical String search methods retain their original results"
    (async ()
      (let* ((c (await (compiled (await (fixture "identity")))))
             (a (get c :a)) (js (get c :js)))
        (js-call (js-array "identities" "ordinary") :forEach
          (lambda (name)
            (js-call assert :deepStrictEqual (run a name) (js-call js name))))
        (finish a))
      (let* ((family (await (compiled))) (a (get family :a)) (js (get family :js)))
        (js-call (js-array "" "a😀a" "中\ud800x") :forEach
          (lambda (text)
            (js-call (js-array "" "a" "😀" "中" undefined) :forEach
              (lambda (needle)
                (js-call (js-array undefined globalThis.NaN globalThis.Infinity
                                  (- globalThis.Infinity) -1 0 1.5 9) :forEach
                  (lambda (start)
                    (let ((input (js-call a :string text)) (n (box a needle))
                          (from (box a start)))
                      (js-call (names) :forEach
                        (lambda (name)
                          (js-call assert :ok
                            (Object/is (run a name (js-array input n from))
                                       (js-call js name text needle start)))))
                      (js-call (js-array input n from) :forEach
                        (lambda (value) (js-call a :release value))))))))))
        (finish a))))

  (test "random sparse numeric and Unicode searches agree exactly with JS under per-allocation collection"
    (async ()
      (let* ((c (await (compiled))) (a (get c :a)) (js (get c :js))
             (seed 2199569689)
             (pool (js-array undefined nil false t globalThis.NaN -0.0 0
                             globalThis.Number.MIN_VALUE "" "中😀" "\ud800" -3 2)))
        (letfn ((next () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223)))))
          (let ((index 0))
            (while (< index 128)
              (let* ((values (Array/from (js-object :length (% (next) 32))
                               (lambda () (aref pool (% (next) (js-length pool))))))
                     (items undefined))
                (let ((position 0))
                  (while (< position (js-length values))
                    (when (= (% (next) 4) 0)
                      (Reflect/deleteProperty values (funcall globalThis.String position)))
                    (setq position (1+ position))))
                (setq items (array a values))
                (let ((trial 0))
                  (while (< trial 8)
                    (let* ((needle (aref pool (% (next) (js-length pool))))
                           (start (/ (- (% (next) 100) 50) 3))
                           (n (box a needle)) (from (js-call a :number start)))
                      (js-call (names) :forEach
                        (lambda (name)
                          (js-call assert :ok
                            (Object/is (run a name (js-array items n from))
                                       (js-call js name values needle start)))))
                      (js-call a :release n)
                      (js-call a :release from))
                    (setq trial (1+ trial))))
                (js-call a :release items))
              (setq index (1+ index)))))
        (finish a))))
)
