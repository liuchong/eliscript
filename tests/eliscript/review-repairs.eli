(module tests.review-repairs
  (import "bun:test" test expect afterAll)
  (import "node:child_process" spawnSync)
  (import "node:fs" mkdirSync writeFileSync rmSync)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:module" createRequire)
  (import "../dist/bootstrap/compiler.mjs" compile-string)
  (import "../dist/runtime/lisp.mjs" compileModule createSession evalProgram runAbiNative runAbiWasm)

  (import "../dist/runtime/lisp/async-runtime.mjs" el-async-track-binding el-async-capture el-async-resume)
  (import "../dist/runtime/lisp/evaluator.mjs" el-restore-dynamic)
  (import "../dist/runtime/lisp/core.mjs" el-intern)
  (import "../dist/runtime/lisp/keymap.mjs" el-make-keymap el-define-key el-lookup-key)

  (defconst root (js-call globalThis.process :cwd))
  (defconst directory (resolve root "_worktree/review-repairs"))
  (defconst runtime-url (get (pathToFileURL (resolve root "dist/runtime/lisp.mjs")) :href))
  (defconst require-module (createRequire (str (get (pathToFileURL (resolve directory "entry.mjs")) :href))))

  (afterAll (lambda () (rmSync directory (js-object :recursive t :force t))))

  (defun parity (id program expression expected &optional dynamic)
    (mkdirSync directory (js-object :recursive t))
    (let* ((source (str (if dynamic "" ";;; -*- lexical-binding: t -*-\n") program
                        "\n(setq repair-result (prin1-to-string " expression "))\n"))
           (file (resolve directory (str id ".el")))
           (output (resolve directory (str id ".mjs"))))
      (try
        (progn
          (writeFileSync file source "utf8")
          (let ((oracle (spawnSync (or (get (get globalThis.process :env) :EMACS) "emacs")
                         (js-array "--batch" "-Q" "-L" "editor" "-L" "compiler" "-l" file
                                   "--eval" "(princ repair-result)")
                         (js-object :encoding "utf8" :timeout 10000 :maxBuffer 1048576))))
            (unless (= (get oracle :status) 0) (throw (new globalThis.Error (get oracle :stderr))))
            (js-call (expect (get oracle :stdout)) :toBe expected))
          (let ((session (createSession)))
            (evalProgram source (js-object :session session :filename file))
            (js-call (expect (evalProgram "repair-result" (js-object :session session))) :toBe expected))
          (writeFileSync output (compile-string (compileModule source
            (js-object :sourceFile file :moduleName (str "tests.repairs." id) :runtime runtime-url)) (str id ".eli")) "utf8")
          (let ((module (funcall require-module output)))
            (funcall (get module :getLoaded))
            ;; The result was calculated by AOT code above, not by evalElisp.
            (js-call (expect (JSON/parse (funcall (get module :evalElisp) "repair-result"))) :toBe expected)))
        (finally
          (rmSync file (js-object :force t))
          (rmSync output (js-object :force t))))))

  (test "R655-01: file scope survives assignment to lexical-binding"
    (lambda ()
      (parity "lexical" "(setq lexical-binding nil) (defun read-x () x) (defun pass-x (x) (read-x))"
        "(condition-case nil (pass-x 19) (void-variable 'unbound))" "unbound")))

  (test "R655-12A: suspension preserves locals, ordering, and multiple awaits"
    (lambda ()
      (parity "suspend"
        "(require 'eliscript-async) (setq hits 0) (defun-async consumer (c) (setq hits (1+ hits)) (let ((a (option-value (await (channel-take! c))))) (+ a (option-value (await (channel-take! c))))))"
        "(let* ((c (make-async-channel 1)) (f (consumer c)) (before (future-state f))) (channel-put! c 20) (let ((middle (future-state f))) (channel-put! c 22) (list before middle (future-state f) (eliscript-async-wait f) hits)))"
        "(pending pending fulfilled 42 1)")
      (parity "dynamic-suspend" "(require 'eliscript-async) (defun-async consumer (c) (+ 1 (option-value (await (channel-take! c)))))"
        "(let* ((c (make-async-channel 1)) (f (consumer c))) (channel-put! c 41) (eliscript-async-wait f))" "42" t)
      (parity "dynamic-no-args"
        "(require 'eliscript-async) (setq c (make-async-channel 1)) (defun-async consume () (let ((x 41)) (await (channel-take! c)) (+ x 1)))"
        "(let ((f (consume))) (channel-put! c 0) (eliscript-async-wait f))" "42" t)
      (parity "dynamic-read-suspend"
        "(require 'eliscript-async) (defun read-x () x) (defun-async consume (c x) (let ((x (+ x 1))) (await (channel-take! c)) (read-x)))"
        "(let* ((c (make-async-channel 1)) (f (consume c 41))) (channel-put! c 0) (eliscript-async-wait f))" "42" t)
      (parity "async-cleanup" "(require 'eliscript-async) (setq cleaned 0) (defun-async consumer (c) (condition-case caught (unwind-protect (progn (await (channel-take! c)) (error \"after\")) (setq cleaned (1+ cleaned))) (error (car caught))))"
        "(let* ((c (make-async-channel 1)) (f (consumer c))) (channel-put! c 1) (list (eliscript-async-wait f) cleaned))" "(error 1)")))

  (test "R655-12B: cancelled channel waiters cannot consume or insert values"
    (lambda ()
      (parity "cancel-taker" "(require 'eliscript-async)"
        "(let* ((c (make-async-channel 1)) (f (channel-take! c))) (future-cancel f) (channel-put! c 'kept) (let ((next (channel-take! c))) (list (future-state f) (future-state next) (option-value (eliscript-async-wait next)))))"
        "(cancelled fulfilled kept)")
      (parity "cancel-putter" "(require 'eliscript-async)"
        "(let ((c (make-async-channel 1))) (channel-put! c 'first) (let ((f (channel-put! c 'ghost))) (future-cancel f) (list (option-value (eliscript-async-wait (channel-take! c))) (future-state (channel-take! c)))))"
        "(first pending)")))

  (test "R655-14: prefix maps share canonical string/vector events"
    (lambda ()
      (parity "prefix" ""
        "(let ((k (make-sparse-keymap))) (define-key k \"ab\" 'ignore) (list (keymapp (lookup-key k \"a\")) (lookup-key k [97 98]) (lookup-key k \"abc\")))" "(t ignore 2)")
      (parity "control" ""
        "(let ((k (make-sparse-keymap))) (keymap-set k \"C-x C-f\" 'find-file) (list (keymapp (lookup-key k [24])) (lookup-key k [24 6]) (keymap-lookup k \"C-x C-f\")))" "(t find-file find-file)")
      (parity "copy-prefix" ""
        "(let ((k (make-sparse-keymap))) (define-key k \"ab\" 'ignore) (let ((copy (copy-keymap k))) (define-key copy \"ab\" 'forward-char) (list (lookup-key k \"ab\") (lookup-key copy \"ab\"))))" "(ignore forward-char)")))

  (defasync abi-parity (id body args expected)
    (let* ((source (str "(defun kernel (x y z) (declare (eliscript :abi :numeric-f64 :params ((x :f64) (y :f64) (z :f64)) :returns :f64)) " body ")"))
           (call (str "(kernel " (js-call (js-call args :map (lambda (x) (str x ".0"))) :join " ") ")")))
      (parity id source call (str expected ".0"))
      (js-call (expect (await (runAbiWasm source "kernel" args))) :toBe expected)
      (js-call (expect (await (runAbiNative source "kernel" args))) :toBe expected)))

  (test "R748-01: numeric zero stays true, comparison false stays false"
    (async ()
      (await (abi-parity "zero-truth" "(if x 1.0 2.0)" (js-array 0 3 2) 1))
      (await (abi-parity "bool-local" "(let ((flag (< y z))) (if flag 1.0 2.0))" (js-array 0 3 2) 2))))

  (test "R748-02: comparisons use all operands and preserve operand effects"
    (async ()
      (await (abi-parity "chain" "(if (< x y z) 1.0 2.0)" (js-array 1 3 2) 2))
      (await (abi-parity "chain-effects" "(let ((count 0.0)) (if (< 3.0 2.0 (setq count (+ count 1.0))) 0.0 count))" (js-array 1 3 2) 1))))
  (test "async protection: loop back-edges, cancellation, and Future adoption"
    (lambda ()
      (parity "async-loop"
        "(require 'eliscript-async) (defun-async consume (c) (let ((sum 0) (n 0)) (while (< n 3) (setq sum (+ sum (option-value (await (channel-take! c)))) n (1+ n))) sum))"
        "(let* ((c (make-async-channel 1)) (f (consume c))) (channel-put! c 10) (channel-put! c 20) (channel-put! c 12) (list (future-state f) (eliscript-async-wait f)))"
        "(fulfilled 42)")
      (parity "cancel-consumer"
        "(require 'eliscript-async) (setq hit 0) (defun-async consume (c) (await (channel-take! c)) (setq hit 1))"
        "(let* ((c (make-async-channel 1)) (f (consume c))) (future-cancel f) (channel-put! c 7) (list (future-state f) hit (option-value (eliscript-async-wait (channel-take! c)))))"
        "(cancelled 0 7)")
      (parity "cancel-second-await"
        "(require 'eliscript-async) (defun-async consume (c) (await (channel-take! c)) (await (channel-take! c)))"
        "(let* ((c (make-async-channel 1)) (f (consume c))) (channel-put! c 1) (future-cancel f) (channel-put! c 42) (list (future-state f) (option-value (eliscript-async-wait (channel-take! c)))))"
        "(cancelled 42)")
      (parity "cancel-finalizer"
        "(require 'eliscript-async) (setq cleaned 0) (defun-async consume (c) (unwind-protect (await (channel-take! c)) (setq cleaned (1+ cleaned))))"
        "(let* ((c (make-async-channel 1)) (f (consume c))) (future-cancel f) (list (future-state f) cleaned))"
        "(cancelled 1)")
      (parity "adopt-pending" "(require 'eliscript-async)"
        "(let* ((a (make-async-channel 1)) (b (make-async-channel 1)) (f (future-then (channel-take! a) (lambda (_) (channel-take! b))))) (channel-put! a 1) (let ((middle (future-state f))) (channel-put! b 42) (list middle (future-state f) (option-value (eliscript-async-wait f)))))"
        "(pending fulfilled 42)")))

  (test "keymap protection: inheritance and non-prefix rejection"
    (lambda ()
      (parity "prefix-parent" ""
        "(let ((parent (make-sparse-keymap)) (child (make-sparse-keymap))) (define-key parent \"ab\" 'ignore) (set-keymap-parent child parent) (define-key child \"ac\" 'forward-char) (list (lookup-key child \"ab\") (lookup-key child \"ac\") (lookup-key parent \"ac\")))"
        "(ignore forward-char nil)")
      (parity "non-prefix" ""
        "(let ((k (make-sparse-keymap))) (define-key k \"a\" 'ignore) (condition-case nil (define-key k \"ab\" 'forward-char) (error 'rejected)))" "rejected")))

  (test "ABI protection: mixed scalar assignment is explicitly rejected"
    (async ()
      (let ((source "(defun kernel (x) (declare (eliscript :abi :numeric-f64 :params ((x :f64)) :returns :f64)) (let ((v 1.0)) (setq v (< x 0.0)) (if v 1.0 2.0)))")
            (wasm-failed false) (native-failed false))
        (try (await (runAbiWasm source "kernel" (js-array 0)))
          (catch error (setq wasm-failed (js-call (str (get error :message)) :includes "changes between boolean and number"))))
        (try (await (runAbiNative source "kernel" (js-array 0)))
          (catch error (setq native-failed (js-call (str (get error :message)) :includes "changes between boolean and number"))))
        (js-call (expect wasm-failed) :toBe t)
        (js-call (expect native-failed) :toBe t))))

  (defun async-driver (ready &optional suffix)
    (str "(let ((c (make-async-channel 1))) "
      (if ready "(channel-put! c 0) " "")
      "(let ((f (consume c))) "
      (if ready "" "(channel-put! c 0) ")
      (or suffix "(eliscript-async-wait f)") "))"))

  (test "R95e-01a: dynamic loop iterations share current binding state"
    (lambda ()
      (js-call (js-array false t) :forEach (lambda (dynamic)
        (parity (str "live-loop-" dynamic)
          "(require 'eliscript-async) (defun-async consume (c) (let ((sum 0) (n 0)) (while (< n 3) (setq sum (+ sum (option-value (await (channel-take! c)))) n (1+ n))) sum))"
          "(let* ((c (make-async-channel 1)) (f (consume c))) (channel-put! c 10) (channel-put! c 20) (channel-put! c 12) (eliscript-async-wait f))" "42" dynamic)))))

  (test "R95e-01b: pending cleanup and handlers see mutations after await"
    (lambda ()
      (js-call (js-array false t) :forEach (lambda (dynamic)
        (js-call (js-array false t) :forEach (lambda (ready)
          (parity (str "live-cleanup-" dynamic "-" ready)
            "(require 'eliscript-async) (setq seen nil) (defun-async consume (c) (let ((x 1)) (unwind-protect (progn (await (channel-take! c)) (setq x 99)) (setq seen x)) (list seen x)))"
            (async-driver ready) "(99 99)" dynamic)
          (parity (str "live-handler-" dynamic "-" ready)
            "(require 'eliscript-async) (setq seen nil) (defun-async consume (c) (let ((x 1)) (condition-case caught (progn (await (channel-take! c)) (setq x 99) (error \"after\")) (error (setq seen (list x (car caught))))) (list x seen)))"
            (async-driver ready) "(99 (99 error))" dynamic)))))))

  (test "R95e-01c: special bindings survive pending await without leaking between tasks"
    (lambda ()
      (js-call (js-array false t) :forEach (lambda (dynamic)
        (js-call (js-array false t) :forEach (lambda (ready)
          (parity (str "live-special-" dynamic "-" ready)
            "(require 'eliscript-async) (defvar dyn-x 10) (defun read-x () dyn-x) (defun-async consume (c) (let ((dyn-x 42)) (await (channel-take! c)) (read-x)))"
            (async-driver ready "(list (eliscript-async-wait f) dyn-x)") "(42 10)" dynamic)))
        (parity (str "live-interleaving-" dynamic)
          "(require 'eliscript-async) (defvar dyn-x 10) (defun read-x () dyn-x) (defun-async consume-value (c x) (let ((dyn-x x)) (await (channel-take! c)) (read-x)))"
          "(let* ((a (make-async-channel 1)) (b (make-async-channel 1)) (fa (consume-value a 42)) (fb (consume-value b 87))) (channel-put! b 0) (channel-put! a 0) (list (eliscript-async-wait fa) (eliscript-async-wait fb) dyn-x))" "(42 87 10)" dynamic)))))

  (test "R95e-01 scope boundaries: continuations exit let and preserve Future values"
    (lambda ()
      (js-call (js-array false t) :forEach (lambda (dynamic)
        (parity (str "scope-exit-" dynamic)
          "(require 'eliscript-async) (defvar dyn-x 10) (defun-async consume (c) (let ((dyn-x 42)) (await (channel-take! c))) dyn-x)"
          (async-driver false) "10" dynamic)
        (parity (str "future-as-data-" dynamic)
          "(require 'eliscript-async) (defun-async consume (c) (future-state (let ((x (await (channel-take! c)))) (channel-take! c))))"
          (async-driver false) "pending" dynamic)))))

  (test "R95e-02: parent prefix inheritance is independent of mutation order"
    (lambda ()
      (parity "late-prefix-parent" ""
        "(list (let ((p (make-sparse-keymap)) (c (make-sparse-keymap))) (define-key p \"ab\" 'ignore) (define-key c \"ac\" 'forward-char) (set-keymap-parent c p) (list (lookup-key c \"ab\") (lookup-key c \"ac\"))) (let ((p (make-sparse-keymap)) (c (make-sparse-keymap))) (set-keymap-parent c p) (define-key c \"ac\" 'forward-char) (define-key p \"ab\" 'ignore) (list (lookup-key c \"ab\") (lookup-key c \"ac\"))))"
        "((ignore forward-char) (ignore forward-char))")
      (parity "replace-prefix-parent" ""
        "(let ((p (make-sparse-keymap)) (q (make-sparse-keymap)) (c (make-sparse-keymap))) (define-key p \"ab\" 'ignore) (define-key q \"ab\" 'backward-char) (define-key c \"ac\" 'forward-char) (set-keymap-parent c p) (let ((first (lookup-key c \"ab\"))) (set-keymap-parent c q) (list first (lookup-key c \"ab\") (lookup-key c \"ac\"))))"
        "(ignore backward-char forward-char)")))

  (defasync memory-parity (id body x expected)
    (let ((source (str "(require 'eliscript-abi) (defun kernel (off x) (declare (eliscript :abi :memory-u32 :params ((off :u32) (x :u32)) :returns :u32)) " body ")")))
      (parity id source (str "(with-abi-memory (:initial-pages 1) (kernel 0 " x "))") (str expected))
      (js-call (expect (await (runAbiWasm source "kernel" (js-array 0 x)))) :toBe expected)
      (js-call (expect (await (runAbiNative source "kernel" (js-array 0 x)))) :toBe expected)))

  (test "R95e-03: void branches and discarded mixed branches preserve stack and types"
    (async ()
      (await (memory-parity "store-both" "(if (= x 0) (mem-store-u32 off 42) (mem-store-u32 off 99)) (mem-load-u32 off)" 0 42))
      (await (memory-parity "store-both-else" "(if (= x 0) (mem-store-u32 off 42) (mem-store-u32 off 99)) (mem-load-u32 off)" 1 99))
      (await (memory-parity "store-one" "(if (= x 0) (mem-store-u32 off 42)) (mem-load-u32 off)" 0 42))
      (await (memory-parity "store-as-test" "(if (if (= x 0) (mem-store-u32 off 42) (mem-store-u32 off 99)) 77 (mem-load-u32 off))" 0 42))
      (await (memory-parity "store-in-loop" "(let ((i 0)) (while (< i 3) (if (< i 2) (mem-store-u32 off (+ (mem-load-u32 off) 14))) (setq i (1+ i))) (mem-load-u32 off))" 0 28))
      (await (abi-parity "discard-one-arm" "(let ((v 0.0)) (if (< x 0.0) (setq v 1.0)) v)" (js-array -1 0 0) 1))
      (await (abi-parity "discard-let-arm" "(let ((v 0.0)) (let* ((w 1.0)) (if (< x 0.0) (setq v w))) v)" (js-array -1 0 0) 1)))
    15000)

  (test "R701-01: nested while loops and cond clauses suspend and resume across runtimes"
    (lambda ()
      (js-call (js-array false t) :forEach (lambda (dynamic)
        (parity (str "nested-while-" dynamic)
          "(require 'eliscript-async) (defun-async nested-loops (c) (let ((i 0) (j 0) (acc 0)) (while (< i 2) (setq j 0) (while (< j 2) (setq acc (+ acc (* (1+ i) (option-value (await (channel-take! c)))))) (setq j (1+ j))) (setq i (1+ i)) (when (> i 10) (error \"inner-loop-hijacked-outer-next\"))) (list i j acc)))"
          "(let* ((c (make-async-channel 4)) (f (nested-loops c))) (channel-put! c 1) (channel-put! c 2) (channel-put! c 3) (channel-put! c 4) (eliscript-async-wait f))"
          "(2 2 17)" dynamic)
        (parity (str "cond-async-" dynamic)
          "(require 'eliscript-async) (defun-async cond-consumer (c) (let ((v (option-value (await (channel-take! c))))) (cond ((= v 1) (+ 100 (option-value (await (channel-take! c))))) ((= (option-value (await (channel-take! c))) 20) 220) (t 999))))"
          "(let* ((c (make-async-channel 4)) (f (cond-consumer c))) (channel-put! c 2) (channel-put! c 20) (eliscript-async-wait f))"
          "220" dynamic)))))

  (test "R701-02: prefix sub-keymap returned by lookup-key preserves inherited parent prefix bindings"
    (lambda ()
      (parity "sub-keymap-lookup" ""
        "(let ((p (make-sparse-keymap)) (c (make-sparse-keymap))) (set-keymap-parent c p) (define-key p \"ab\" 'ignore) (define-key c \"ac\" 'forward-char) (let ((sub (lookup-key c \"a\"))) (list (keymapp sub) (lookup-key sub \"b\") (lookup-key sub \"c\"))))"
        "(t ignore forward-char)")))

  (test "binding cell protection: shadowed bindings retain distinct mutable identities"
    (lambda ()
      (let* ((session (createSession)) (values (get session :values)) (symbol (el-intern "repair-cell"))
             (outer (js-array symbol t 10 nil nil)) (inner (js-array symbol t 1 nil nil)))
        (js-call values :set symbol 10)
        (put session :inAsyncContext t)
        (el-async-track-binding session outer 1)
        (js-call values :set symbol 1)
        (let ((outer-context (el-async-capture session)))
          (el-async-track-binding session inner 2)
          (js-call values :set symbol 2)
          (let ((inner-context (el-async-capture session)))
            (js-call values :set symbol 99)
            (el-restore-dynamic session (js-array inner))
            (el-restore-dynamic session (js-array outer))
            (js-call (expect (get (aref outer-context 0) :value)) :toBe 1)
            (js-call (expect (get (aref inner-context 1) :value)) :toBe 99)
            (js-call (expect (js-call values :get symbol)) :toBe 10)
            (el-async-resume session inner-context (lambda ()
              (js-call (expect (js-call values :get symbol)) :toBe 99)
              (js-call values :set symbol 100)))
            (js-call (expect (get (aref inner-context 1) :value)) :toBe 100)
            (js-call (expect (get (aref outer-context 0) :value)) :toBe 1)
            (js-call (expect (js-call values :get symbol)) :toBe 10))))))

  (test "binding cell protection: reentrant resumption restores the updated live caller"
    (lambda ()
      (let* ((session (createSession)) (values (get session :values)) (symbol (el-intern "repair-reentrant-cell"))
             (binding (js-array symbol t 10 nil nil)))
        (js-call values :set symbol 10)
        (put session :inAsyncContext t)
        (el-async-track-binding session binding 1)
        (js-call values :set symbol 1)
        (let ((context (el-async-capture session)))
          (js-call values :set symbol 2)
          (el-async-resume session context (lambda () (js-call values :set symbol 3)))
          (js-call (expect (js-call values :get symbol)) :toBe 3)
          (js-call (expect (get (aref context 0) :value)) :toBe 3)
          (el-restore-dynamic session (js-array binding))
          (js-call (expect (js-call values :get symbol)) :toBe 10)))))

  (test "keymap protection: late parent changes and removal affect existing child prefixes"
    (lambda ()
      (let ((parent (el-make-keymap)) (child (el-make-keymap))
            (first (el-intern "ignore")) (second (el-intern "backward-char")))
        (el-define-key child "ac" first)
        (put child :_parent parent)
        (el-define-key parent "ab" first)
        (js-call (expect (el-lookup-key child "ab")) :toBe first)
        (el-define-key parent "ab" second)
        (js-call (expect (el-lookup-key child "ab")) :toBe second)
        (el-define-key parent "ab" nil t)
        (js-call (expect (el-lookup-key child "ab")) :toBe nil)
        (js-call (expect (el-lookup-key child "ac")) :toBe first))))

)
