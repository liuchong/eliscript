(module tests.managed-primitive-properties-cases
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../../tools/backends/build.mjs" buildBackends root)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./managed-numeric-selfhosted.mjs" loadReference)
  (defvar directory undefined)
  (defvar backend undefined)
  (defvar runtime undefined)
  (defvar source undefined)
  (defun original-template (text marker)
    (let ((start (js-call text :indexOf marker)))
      (js-call assert :ok (>= start 0))
      (setq start (+ start (js-length marker)))
      (let ((end (js-call text :indexOf "`;" start)))
        (js-call assert :ok (> end start)) (js-call text :slice start end))))
  (defasync prepareManagedPrimitiveProperties ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-primitive-maintained-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get backend :compiler) :compile_ir_string
      (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
    (setq source (await (readFile (resolve root "tests/wasm-managed-primitive-properties-test-legacy.mjs") "utf8"))))
  (defasync closeManagedPrimitiveProperties ()
    (when directory (await (rm directory (js-object :recursive t :force t))) (setq directory undefined)))
  (defun artifact (program)
    (let ((bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime))))
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array)) bytes))
  (defun read (adapter value)
    (cond
      ((and value (= (get value :kind) 4)) (js-call adapter :readNumber value))
      ((and value (= (get value :kind) 5)) (js-call adapter :readString value))
      ((and value (= (get value :kind) 14))
        (let ((output (js-array)) (index 0) (length (js-call adapter :length value)))
          (while (< index length)
            (let ((child (js-call adapter :get value index)))
              (try (js-call output :push (read adapter child)) (finally (js-call adapter :release child))))
            (setq index (1+ index))) output))
      (t value)))
  (defun finish (adapter)
    (js-call adapter :closeModule) (js-call adapter :collect)
    (js-call assert :strictEqual (js-call adapter :live) 0)
    (js-call assert :strictEqual (get (js-call adapter :stats) :frameDepth) 0))
  (defun represented-prototype-case ()
    (let* ((program (js-call (get backend :compiler) :compile_ir_string
                     (original-template source "const source=`") "primitive-properties.eli"))
           (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module (artifact program))) :exports))
           (heap (funcall (get e "heap-new") 128 16384 131072)))
      (letfn ((call (name &rest arguments)
                (let ((result (uint32 (Reflect/apply (get e name) e (js-call (js-array heap) :concat arguments)))))
                  (js-call assert :strictEqual (funcall (get e "last-error")) 0 name) result))
              (text (value)
                (let ((result (call "value-string" (js-length value))) (index 0))
                  (call "heap-pin" result)
                  (while (< index (js-length value)) (call "value-unit-set" result index (js-call value :charCodeAt index)) (setq index (1+ index)))
                  (call "value-seal" result) result)))
        (call "heap-auto" 1)
        (let ((key (text "visible")) (missing (text "missing")) (standard (text "hasOwnProperty"))
              (number (call "value-number" 0 0)))
          (call "heap-pin" number)
          (js-call assert :strictEqual (call "value-standard-prototype-existing" 0) 0)
          (let ((prototype (call "value-standard-prototype" 0)))
            ;; Raw ABI return values are borrowed until explicitly rooted.
            ;; Keep the actual weak prototype alive during object allocation.
            (call "heap-pin" prototype)
            (let ((object (call "value-object-new" prototype)))
              (call "heap-pin" object) (call "heap-release" prototype)
              (call "value-object-put" prototype key 2 2)
              (js-call assert :strictEqual (call "value-property-get" 1 key 0) 2)
              (js-call assert :strictEqual (call "value-property-get" number key 0) 2)
              (js-call assert :strictEqual (call "value-property-get" 2 missing 0) 3)
              (call "value-object-put" prototype standard 1 2)
              (js-call assert :strictEqual (call "value-property-get" 2 standard 0) 1)
              (call "heap-collect")
              (js-call assert :strictEqual (call "value-property-get" 1 key 0) 2)
              (call "value-standard-prototypes-close") (call "heap-collect")
              (js-call assert :strictEqual (call "value-standard-prototype-existing" 0) prototype)
              (js-call assert :strictEqual (call "value-property-get" number key 0) 2)
              (call "heap-release" object) (call "heap-collect")
              (js-call assert :strictEqual (call "value-standard-prototype-existing" 0) 0)
              (js-call assert :strictEqual (call "value-property-get" 1 key 0) 3)))
          (js-call (js-array key missing standard number) :forEach (lambda (value) (call "heap-release" value)))
          (call "heap-collect")
          (js-call assert :strictEqual (call "heap-live") 0)
          (js-call assert :strictEqual (call "frame-depth") 0)))))
  (defun restore-prototype (key descriptor)
    (if descriptor (Object/defineProperty globalThis.Object.prototype key descriptor)
      (Reflect/deleteProperty globalThis.Object.prototype key)))
  (defun primitive-input (adapter value)
    (cond
      ((Array/isArray value)
        (let ((items (js-call value :map (lambda (item) (primitive-input adapter item)))))
          (try (js-call adapter :sourceArray items)
            (finally (js-call items :forEach (lambda (item) (js-call adapter :release item)))))))
      ((= (value-type value) "number") (js-call adapter :number value))
      ((= (value-type value) "string") (js-call adapter :string value)) (t value)))
  (defun primitive-native-properties-case ()
    (let* ((text (+ (original-template source "const source=`")
                    "\n(defun call-member (receiver key) (js-call receiver key)) (export call-member)"))
           (program (js-call (get backend :compiler) :compile_ir_string text "primitive-properties.eli"))
           (adapter (instantiateManagedRuntime (artifact program)))
           (key (js-call adapter :string "absent")) (trace (js-call adapter :sourceArray (js-array)))
           (number (js-call adapter :number 1)))
      (js-call adapter :auto 1)
      (try
        (progn
          (js-call (js-array nil undefined) :forEach (lambda (value)
            (js-call (js-array "member" "converted") :forEach (lambda (name)
              (js-call assert :throws (lambda () (js-call adapter :invoke name
                (js-array value (if (= name "member") key trace))))
                (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0001")))))
            (js-call assert :deepStrictEqual (read adapter trace) (js-array))))
          ;; Exercise represented members and preserve the original explicit
          ;; refusal for the unrepresented locale method.
          (js-call (js-array false t number) :forEach (lambda (value)
            (let ((raw (if (eq value number) 1 value)))
              (js-call (js-array "constructor" "toString" "valueOf" "toLocaleString" "__proto__") :forEach
                (lambda (name)
                  (let* ((property (js-call adapter :string name))
                         (out undefined) (actual undefined)
                         (expected (Reflect/get (funcall globalThis.Object raw) name)))
                    (try
                      (progn
                        (if (= name "toLocaleString")
                          (js-call assert :throws
                            (lambda () (js-call adapter :invoke "member" (js-array value property)))
                            (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0003")))
                          (progn
                        (setq out (js-call adapter :invoke "member" (js-array value property)))
                        (setq actual (js-call adapter :toHostValue out))
                        (if (= name "__proto__")
                        (js-call assert :strictEqual (get (get actual :constructor) :name) (get (get expected :constructor) :name))
                        (progn
                          (js-call assert :strictEqual (value-type actual) "function")
                          (js-call assert :strictEqual (get actual :name) (get expected :name))
                          (unless (= name "constructor")
                            (let ((called (js-call adapter :invoke "call-member" (js-array value property))))
                              (try (js-call assert :strictEqual (read adapter called) (Reflect/apply expected raw (js-array)))
                                (finally (js-call adapter :release called))))))))))
                      (catch error
                        (js-call globalThis.console :error "primitive property case failed" (js-object :receiver raw :member name))
                        (throw error))
                      (finally (unless (undefined? out) (js-call adapter :release out))
                        (js-call adapter :release property))))))))))
        (finally (js-call adapter :release key) (js-call adapter :release trace)
          (js-call adapter :release number) (finish adapter)))))
  (defasync inherited-iterator-case ()
    (let* ((program (js-call (get backend :compiler) :compile_ir_string
                     (original-template source "const inheritedIteratorSource=`") "primitive-inherited-iterator.eli"))
           (reference (await (loadReference (resolve directory "primitive-iterator-reference.mjs")
             (js-call (get backend :compiler) :emit_ir_string program))))
           (adapter (instantiateManagedRuntime (artifact program)))
           (old (Object/getOwnPropertyDescriptor globalThis.Object.prototype globalThis.Symbol.iterator))
           (oldPrimitive (Object/getOwnPropertyDescriptor globalThis.Object.prototype globalThis.Symbol.toPrimitive)))
      (js-call adapter :auto 1)
      (letfn ((native (method work)
                (try (progn (js-call reference :install method) (funcall work))
                  (finally (restore-prototype globalThis.Symbol.iterator old)))))
        (try
          (progn
            (js-call (js-array false nil undefined) :forEach (lambda (method)
              (js-call adapter :release (js-call adapter :invoke "install" (js-array method)))
              (js-call (js-array false 3 nil undefined) :forEach (lambda (value)
                (let ((input (primitive-input adapter value)) (trace (js-call adapter :sourceArray (js-array))))
                  (try
                    (js-call (js-array "run" "spread" "from") :forEach (lambda (name)
                      (if (and (= name "from") (not (nullish? value)) (not (eq method false)))
                        (let ((wanted (native method (lambda () (js-call reference :from value))))
                              (output (js-call adapter :invoke name (js-array input))))
                          (try (js-call assert :deepStrictEqual (read adapter output) wanted)
                            (finally (js-call adapter :release output))))
                        (progn
                          (js-call assert :throws (lambda ()
                            (native method (lambda () (Reflect/apply (get reference name) reference (js-array value (js-array))))))
                            globalThis.TypeError)
                          (js-call assert :throws (lambda () (js-call adapter :invoke name
                            (if (= name "run") (js-array input trace) (js-array input))))
                            (lambda (error) (and (js-call globalThis.TypeError.prototype :isPrototypeOf error)
                              (= (get (get error :eliscriptDiagnostic) :code)
                                (if (and (nullish? value) (not (eq method false)) (/= name "from"))
                                  "ELI-RT0001" "ELI-RT0003"))))
                            (str name " input=" value " iterator=" method))))))
                    (finally (js-call adapter :release input) (js-call adapter :release trace))))))))
            (let ((trace (js-call adapter :sourceArray (js-array))) (expected (js-array)))
              (js-call adapter :release (js-call adapter :invoke "install-good" (js-array trace)))
              (try
                (progn
                  (js-call (js-array "A😀" (js-array 1 2)) :forEach (lambda (value)
                    (let ((input (primitive-input adapter value)))
                      (try
                        (progn
                          (let ((result (try (progn (js-call reference :install_good expected) (js-call reference :run value expected))
                                          (finally (restore-prototype globalThis.Symbol.iterator old)))))
                            (js-call assert :strictEqual (js-call adapter :invoke "run" (js-array input trace)) result))
                          (js-call (js-array "spread" "from") :forEach (lambda (name)
                            (let ((wanted (try (progn (js-call reference :install_good expected)
                                            (Reflect/apply (get reference name) reference (js-array value)))
                                            (finally (restore-prototype globalThis.Symbol.iterator old))))
                                  (output (js-call adapter :invoke name (js-array input))))
                              (try (progn (js-call assert :deepStrictEqual (read adapter output) wanted)
                                      (js-call assert :deepStrictEqual (read adapter trace) expected))
                                (finally (js-call adapter :release output)))))))
                        (finally (js-call adapter :release input))))))
                  (js-call assert :deepStrictEqual (read adapter trace) expected)
                  (js-call assert :deepStrictEqual expected (js-array "A" "😀" 1 2))
                  (let ((number (js-call adapter :number 3)))
                    (try
                      (progn
                        (js-call assert :strictEqual (js-call adapter :invoke "primitive-key" (js-array number)) undefined)
                        (let ((result (try (js-call reference :primitive_key 3)
                                        (finally (restore-prototype globalThis.Symbol.toPrimitive oldPrimitive)))))
                          (js-call assert :strictEqual result undefined)))
                      (finally (js-call adapter :release number)))))
                (finally (js-call adapter :release trace)))))
          (finally (restore-prototype globalThis.Symbol.iterator old)
            (restore-prototype globalThis.Symbol.toPrimitive oldPrimitive) (finish adapter))))))
  (defconst managedPrimitivePropertiesCases (js-object
    "nullish reads retain their source errors and unrepresented primitive prototype methods are explicitly rejected" primitive-native-properties-case
    "primitive reads observe represented Object prototype data across collection and realm close without inventing native methods" represented-prototype-case
    "primitive inherited iteration keeps native String Array precedence nullish and noncallable errors and primitive conversion boundaries" inherited-iterator-case))
  (export managedPrimitivePropertiesCases prepareManagedPrimitiveProperties closeManagedPrimitiveProperties))
