(module tests.dogfood-action-install
  (import "bun:test" :as framework)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "../../tools/backends/build.mjs" root)
  (import "./direct-wasm-registration.mjs" createDirectWasmRegistration)
  (import "./dogfood-action-source.mjs" runSourcePackageCase runPackageNegatives)
  (defconst original (Object/assign (js-object) framework))
  (js-call assert :strictEqual
    (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root "tests/dogfood-action-test-legacy.mjs"))) :digest "hex")
    "fa0ff637a0fb6544c9cdc8d8209f8f92c61b1086a9f1da04cd687b2836af597b")
  (defconst registration (createDirectWasmRegistration original (js-object
    "the committed package reproduces from source" runSourcePackageCase
    "package reproduction verifies staged bytes and rejects unstaged, missing and untracked artifacts" runPackageNegatives)))
  (defvar restored false)
  (defun restore ()
    (unless restored (js-call (get original :mock) :module "bun:test" (lambda () original)) (setq restored t)))
  (defun completeActionRegistration () (try (js-call registration :complete) (finally (restore))))
  (js-call original :beforeAll completeActionRegistration)
  (js-call original :afterAll restore)
  (js-call (get original :mock) :module "bun:test" (lambda () (get registration :exports)))
  (export completeActionRegistration))
