(module tests.wasm-managed-array-construction-regressions
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir mkdtemp readFile rm)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/managed-browser-transport.mjs" loadManagedReference)
  (defvar directory undefined) (defvar backend undefined) (defvar runtime-ir undefined)
  (defconst source (str
    "(defun from (text) (Array/from text))\n"
    "(defun shadow-array (Array trace) (Array/from (progn (put Array :from false) (put trace :visited 1)) (put trace :visited 2) (put trace :visited 3)))\n"
    "(defun shadow-object (Object trace) (Object/keys (progn (put Object :keys false) (put trace :visited 1)) (put trace :visited 2)))\n"
    "(defun factory () (lambda (&rest values) values))\n"
    "(export from shadow-array shadow-object factory)\n"))
  (defconst overridden-source (str
    "(defun from-overridden (text mode)\n"
    " (let* ((prototype (get (js* \"String\") :prototype)) (key (js* \"Symbol.iterator\")) (old (get prototype key)))\n"
    "  (try (put prototype key (if (= mode 0) nil (lambda () (js-call (js-array \"overridden\") :values))))\n"
    "   (Array/from text) (finally (put prototype key old)))))\n"
    "(export from-overridden)\n"))
  (defconst strings (js-array "" "A😀中" "\ud800x\udfff" "😀\ud800😀" "A😀\ud800"))
  (defun read (a value)
    (cond ((and value (= (get value :kind) 4)) (js-call a :readNumber value))
      ((and value (= (get value :kind) 5)) (js-call a :readString value))
      ((and value (= (get value :kind) 14)) (Array/from (js-object :length (js-call a :length value)) (lambda (unused index)
        (let ((item (js-call a :get value index))) (try (read a item) (finally (js-call a :release item))))))) (t value)))
  (defun code (expected) (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) expected)))
  (defasync product (text)
    (let* ((program (js-call (get backend :compiler) :compile_ir_string text "construction-regression.eli"))
           (bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime-ir))))
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (js-object :bytes bytes :program program :reference (await (loadManagedReference directory (js-call (get backend :compiler) :emit_ir_string program) "construction-reference")))))
  (defun finish (a)
    (js-call a :closeModule) (js-call a :collect) (js-call assert :strictEqual (js-call a :live) 0)
    (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))
  (beforeAll (async ()
    (await (mkdir (resolve root "_worktree") (js-object :recursive t)))
    (setq directory (await (mkdtemp (resolve root "_worktree/array-construction-regression-"))))
    (setq backend (await (buildBackends (js-object :outputRoot (resolve directory "backend")))))
    (setq runtime-ir (js-call (get backend :compiler) :compile_ir_string (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (test "Array.from retains its default codepoint iterator before String reflection including empty and lone surrogate inputs under GC"
    (async ()
      (let* ((compiled (await (product source))) (a (instantiateManagedRuntime (get compiled :bytes)))
             (reference (get compiled :reference)) (_ (js-call a :auto 1))
             (held (js-call a :number -0.0)) (caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 held)
        (try (js-call strings :forEach (lambda (text)
          (let ((input (js-call a :string text)) (out undefined))
            (try
              (setq out (js-call a :invoke "from" (js-array input)))
              (js-call assert :deepStrictEqual (read a out) (Array/from text))
              (js-call assert :deepStrictEqual (read a out) (js-call reference :from text))
              (js-call a :collect) (js-call assert :deepStrictEqual (read a out) (Array/from text))
              (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
              (assert (Object/is (js-call a :readNumber held) -0.0))
              (finally (js-call a :release out) (js-call a :release input))))))
          (finally (js-call a :leaveFrame caller) (js-call a :release held) (finish a))))) 30000)
  (test "Array.from observes actual String iterator overrides and nullish overrides select UTF16 array-like values"
    (async ()
      (let* ((compiled (await (product overridden-source))) (a (instantiateManagedRuntime (get compiled :bytes)))
             (reference (get compiled :reference)) (_ (js-call a :auto 1)) (input (js-call a :string "A😀\ud800")))
        (try (js-call (js-array 0 1) :forEach (lambda (mode)
          (let ((argument (js-call a :number mode)) (out undefined))
            (try
              (setq out (js-call a :invoke "from-overridden" (js-array input argument)))
              (js-call assert :deepStrictEqual (read a out) (if (= mode 0) (js-array "A" "\ud83d" "\ude00" "\ud800") (js-array "overridden")))
              (js-call assert :deepStrictEqual (read a out) (js-call reference :from_overridden "A😀\ud800" mode))
              (finally (js-call a :release out) (js-call a :release argument))))))
          (finally (js-call a :release input) (finish a))))) 30000)
  (test "source nullish method receivers fail before arguments while ordinary captured Array and Object callees retain effects"
    (async ()
      (let* ((compiled (await (product source))) (a (instantiateManagedRuntime (get compiled :bytes))) (_ (js-call a :auto 1))
             (fn (js-call a :invoke "factory")) (key (js-call a :string "visited")))
        (try
          (js-call (js-array (js-array "shadow-array" "from" (js-array 1 2 3)) (js-array "shadow-object" "keys" (js-array 1 2))) :forEach (lambda (entry)
            (let* ((object (js-call a :sourceObject (Object/fromEntries (js-array (js-array (aref entry 1) fn)))))
                   (trace (js-call a :sourceObject (js-object))) (out undefined))
              (try
                (setq out (js-call a :invoke (aref entry 0) (js-array object trace)))
                (js-call assert :deepStrictEqual (read a out) (aref entry 2))
                (js-call (js-array nil undefined) :forEach (lambda (receiver)
                  (let ((clean (js-call a :sourceObject (js-object))) (caller (js-call a :frame 1)))
                    (js-call a :frameSet caller 0 clean)
                    (try
                      (js-call assert :throws (lambda () (js-call a :invoke (aref entry 0) (js-array receiver clean)))
                        (lambda (error) (and (js-call globalThis.TypeError globalThis.Symbol.hasInstance error) (funcall (code "ELI-RT0001") error))))
                      (js-call assert :strictEqual (js-call a :objectGet clean key) undefined)
                      (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
                      (finally (js-call a :leaveFrame caller) (js-call a :release clean))))))
                (finally (js-call a :release out) (js-call a :release object) (js-call a :release trace))))))
          (finally (js-call a :release fn) (js-call a :release key) (finish a))))) 30000)
  (test "source Get reports nullish receiver language errors after raw handle checks and preserves the real caller frame"
    (async ()
      (let* ((compiled (await (product source)))
             (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module (get compiled :bytes))) :exports))
             (heap (js-call e "heap-new" 32 8192 65536))
             (raw (lambda (name &rest arguments)
               (let ((out (uint32 (Reflect/apply (get e name) e (js-call (js-array heap) :concat arguments)))))
                 (js-call assert :strictEqual (js-call e "last-error") 0 name) out)))
             (key (funcall raw "value-string" 1)) (caller (funcall raw "frame-new" 1)))
        (funcall raw "frame-set" caller 0 key) (funcall raw "value-unit-set" key 0 120) (funcall raw "value-seal" key)
        (js-call (js-array (js-array 0 key 0 1 2) (js-array 3 key 3 1 2)
                          (js-array 4294967295 key 0 1 0) (js-array 0 4294967295 0 1 0)) :forEach
          (lambda (row)
            (funcall raw "value-exception-class-set" 0)
            (js-call assert :strictEqual (js-call e "value-source-get-with-receiver" heap (aref row 0) (aref row 1) (aref row 2)) 0)
            (js-call assert :strictEqual (js-call e "last-error") (aref row 3))
            (js-call assert :strictEqual (funcall raw "value-exception-class") (aref row 4))
            (js-call assert :strictEqual (funcall raw "frame-depth") 1)
            (js-call assert :strictEqual (funcall raw "frame-get" caller 0) key)))
        (funcall raw "frame-pop" caller) (funcall raw "heap-collect") (js-call assert :strictEqual (funcall raw "heap-live") 0))))
  (test "ordinary sealed string and symbol data Get borrows own inherited and absent results without allocation under automatic GC"
    (async ()
      (let* ((compiled (await (product (str
               "(defun symbol-key () (funcall globalThis.Symbol \"borrowed\"))\n"
               "(defun parent (value symbol) (js-object :x value (progn symbol) t))\n"
               "(defun child (parent) (js-object :__proto__ parent :own false))\n"
               "(defun read-data (object key) (get object key))\n"
               "(export symbol-key parent child read-data)\n"))))
             (a (instantiateManagedRuntime (get compiled :bytes))) (_ (js-call a :auto 1))
             (zero (js-call a :number -0.0)) (symbol (js-call a :invoke "symbol-key"))
             (parent (js-call a :invoke "parent" (js-array zero symbol)))
             (child (js-call a :invoke "child" (js-array parent)))
             (inherited (js-call a :string "x")) (own (js-call a :string "own"))
             (missing (js-call a :string "absent")) (caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 zero)
        (try
          (let ((before (js-call a :stats)) (index 0))
            (while (< index 1024)
              (js-call (js-array (js-array inherited -0.0) (js-array own false)
                                (js-array missing undefined) (js-array symbol t)) :forEach
                (lambda (row)
                  (let ((value (js-call a :objectGet child (aref row 0))))
                    (try (assert (Object/is (read a value) (aref row 1)))
                      (finally (js-call a :release value))))))
              (setq index (1+ index)))
            (let ((after (js-call a :stats)))
              (js-call assert :strictEqual (get after :collections) (get before :collections))
              (js-call assert :strictEqual (get after :usedBytes) (get before :usedBytes))
              (js-call assert :strictEqual (get after :frameDepth) 1)))
          (js-call a :collect) (assert (Object/is (js-call a :readNumber zero) -0.0))
          (finally
            (js-call a :leaveFrame caller)
            (js-call (js-array zero symbol parent child inherited own missing) :forEach
              (lambda (value) (js-call a :release value)))
            (finish a))))) 30000)
  (test "module initialization reclaims discarded frames under slot pressure while preserving roots and completed auto zero heaps retain strict capacity"
    (async ()
      (let* ((compiled (await (product source)))
             ;; Module setup is private in production images. Publish the same
             ;; existing functions only in this raw pressure-test image; keep
             ;; every implementation byte and the production export list intact.
             (runtime-source (js-call (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) :trimEnd))
             (_module-close (assert (js-call runtime-source :endsWith ")")))
             (pressure-source (str (js-call runtime-source :slice 0 -1)
               "\n(export value-module-begin value-module-declare value-module-init value-module-get value-module-complete value-module-close)\n)\n"))
             (pressure-ir (js-call (get backend :compiler) :compile_ir_string pressure-source "pressure-runtime.eli"))
             (pressure-bytes (globalThis.Uint8Array.from
               (js-call (get backend :managed) :emit_managed_wasm (get compiled :program) pressure-ir)))
             (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module pressure-bytes)) :exports))
             (heap (js-call e "heap-new" 32 8192 65536))
             (raw (lambda (name &rest arguments)
               (js-call assert :strictEqual (value-type (get e name)) "function" name)
               (let ((out (uint32 (Reflect/apply (get e name) e (js-call (js-array heap) :concat arguments)))))
                 (js-call assert :strictEqual (js-call e "last-error") 0 name) out)))
             (caller (funcall raw "frame-new" 1)) (kept (funcall raw "value-string" 1)))
        (funcall raw "frame-set" caller 0 kept) (funcall raw "value-unit-set" kept 0 120) (funcall raw "value-seal" kept)
        (funcall raw "value-module-begin" 1) (funcall raw "value-module-declare" 0 0) (funcall raw "value-module-init" 0 kept)
        (let ((index 0))
          (while (< index 96)
            (let ((temporary (funcall raw "frame-new" 0))) (funcall raw "frame-pop" temporary))
            (setq index (1+ index))))
        (assert (> (funcall raw "heap-collections") 0))
        (js-call assert :strictEqual (funcall raw "value-module-get" 0) kept)
        (js-call assert :strictEqual (funcall raw "frame-get" caller 0) kept)
        (js-call assert :strictEqual (funcall raw "value-unit-get" kept 0) 120)
        (funcall raw "heap-collect")
        (funcall raw "value-bytes" 40000)
        (let ((resized (funcall raw "value-bytes" 128)))
          (funcall raw "heap-pin" resized) (funcall raw "value-byte-set" resized 0 231)
          (let ((before (funcall raw "heap-collections")))
            (funcall raw "value-bytes-resize" resized 40000)
            (assert (> (funcall raw "heap-collections") before)))
          (js-call assert :strictEqual (funcall raw "value-length" resized) 40000)
          (js-call assert :strictEqual (funcall raw "value-byte-get" resized 0) 231)
          (funcall raw "heap-release" resized))
        (funcall raw "heap-collect")
        (funcall raw "value-module-complete")
        (let ((before (funcall raw "heap-collections")) (index 0) (exhausted false))
          (while (and (< index 32) (not exhausted))
            (let ((temporary (js-call e "frame-new" heap 0)))
              (if (= temporary 0)
                (progn (js-call assert :strictEqual (js-call e "last-error") 2) (setq exhausted t))
                (funcall raw "frame-pop" temporary)))
            (setq index (1+ index)))
          (js-call assert :strictEqual exhausted t)
          (js-call assert :strictEqual (funcall raw "heap-collections") before))
        (js-call assert :strictEqual (funcall raw "frame-get" caller 0) kept)
        (funcall raw "value-module-close") (funcall raw "frame-pop" caller) (funcall raw "heap-collect")
        (js-call assert :strictEqual (funcall raw "heap-live") 0))))
  (test "js-nth nullish receivers preserve length zero missing nil and object key rejection without changing strict source Get"
    (async ()
      (let* ((compiled (await (product "(defun nth-value (key value) (js-nth key value))\n(defun strict-value (value key) (get value key))\n(export nth-value strict-value)\n")))
             (a (instantiateManagedRuntime (get compiled :bytes))) (_ (js-call a :auto 1))
             (length-key (js-call a :string "length")) (missing-key (js-call a :string "absent"))
             (object-key (js-call a :sourceArray (js-array length-key))) (caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 length-key)
        (try
          (js-call (js-array nil undefined) :forEach (lambda (receiver)
            (js-call (js-array (js-array length-key 0) (js-array missing-key nil)) :forEach (lambda (row)
              (let ((result (js-call a :invoke "nth-value" (js-array (aref row 0) receiver))))
                (try (js-call assert :strictEqual (read a result) (aref row 1)) (finally (js-call a :release result))))))
            (js-call assert :throws (lambda () (js-call a :invoke "nth-value" (js-array object-key receiver))) (code "ELI-RT0001"))
            (js-call assert :throws (lambda () (js-call a :invoke "strict-value" (js-array receiver length-key)))
              (lambda (error) (and (js-call globalThis.TypeError globalThis.Symbol.hasInstance error) (funcall (code "ELI-RT0001") error))))
            (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)))
          (js-call a :collect) (js-call assert :strictEqual (js-call a :readString length-key) "length")
          (finally (js-call a :leaveFrame caller) (js-call a :release object-key)
            (js-call a :release length-key) (js-call a :release missing-key) (finish a))))) 30000)
  (test "ordinary receiver data writes root descriptor labels before allocating the next label under automatic GC"
    (async ()
      (let* ((compiled (await (product (str
               "(defun set-receiver (value) (let ((target (js-object :x 1)) (receiver (js-object :x 0))) (Reflect/set target \"x\" value receiver) (get receiver :x)))\n"
               "(defun array-length (value) (let ((array (js-array))) (Object/defineProperty array \"length\" (js-object :writable t)) (js-call array :push value) (js-array (js-call array :pop) (js-length array))))\n"
               "(export set-receiver array-length)\n"))))
             (a (instantiateManagedRuntime (get compiled :bytes))) (_ (js-call a :auto 1))
             (zero (js-call a :number -0.0)) (caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 zero)
        (try
          (let ((index 0))
            (while (< index 16)
              (let ((value (js-call a :invoke "set-receiver" (js-array zero))))
                (try (assert (Object/is (read a value) -0.0)) (finally (js-call a :release value))))
              (let ((value (js-call a :invoke "array-length" (js-array zero))))
                (try (js-call assert :deepStrictEqual (read a value) (js-array -0.0 0))
                  (finally (js-call a :release value))))
              (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
              (js-call a :collect) (assert (Object/is (js-call a :readNumber zero) -0.0))
              (setq index (1+ index))))
          (finally (js-call a :leaveFrame caller) (js-call a :release zero) (finish a))))) 30000)
)
