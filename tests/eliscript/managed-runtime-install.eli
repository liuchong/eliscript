(module tests.managed-runtime-install
  (import "bun:test" :as framework)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "../../tools/backends/build.mjs" root)
  (import "./managed-runtime-cases.mjs" managedRuntimeCases prepareManagedRuntimeCases closeManagedRuntimeCases)
  (defconst original (Object/assign (js-object) framework))
  (defconst source (readFileSync (resolve root "tests/wasm-managed-runtime-test-legacy.mjs")))
  (unless (= (js-call (js-call (createHash "sha256") :update source) :digest "hex")
             "0b240d3dff9164f23edf534b5a79598948b80f001e9316fa0f37e55a40f0fed2")
    (throw (new globalThis.TypeError "the complete original managed runtime suite source identity changed")))
  (defconst counts (new globalThis.Map))
  (defvar restored false)
  (defun restore ()
    (unless restored
      (js-call (get original :mock) :module "bun:test" (lambda () original))
      (setq restored t)))
  (defconst replacement-test (new globalThis.Proxy (get original :test) (js-object
    :apply (lambda (target receiver arguments)
      (let ((title (aref arguments 0)))
        (if (Object/hasOwn managedRuntimeCases title)
          (let ((forwarded (js-call arguments :slice)))
            (when (js-call counts :has title)
              (throw (new globalThis.Error (+ "duplicate managed runtime original case: " title))))
            (js-call counts :set title 1)
            (put forwarded 1 (get managedRuntimeCases title))
            (Reflect/apply target receiver forwarded))
          (Reflect/apply target receiver arguments))))
    :get (lambda (target key receiver) (Reflect/get target key target)))))
  (defconst exports (Object/assign (js-object) original (js-object :test replacement-test)))
  (js-call original :beforeAll (async ()
    (try
      (progn
        (js-call (Object/keys managedRuntimeCases) :forEach (lambda (title)
          (unless (= (js-call counts :get title) 1)
            (throw (new globalThis.Error (+ "missing managed runtime original case: " title))))))
        (await (prepareManagedRuntimeCases)))
      (finally (restore)))) 120000)
  (js-call original :afterAll (async () (restore) (await (closeManagedRuntimeCases))))
  (js-call (get original :mock) :module "bun:test" (lambda () exports)))
