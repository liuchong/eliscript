(module tests.compiler-portable-guards
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/build.mjs" root buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/testing/fixture-environment.mjs" prepareFixtureEnvironment)
  (import "../tools/testing/compiler-portable-fixtures.mjs" flattenPortableNodes)
  (import "../tools/testing/generated-fixture-module.mjs" loadGeneratedFixture)
  (defvar fixture undefined) (defvar backend undefined) (defvar runtime undefined)
  (defvar program undefined) (defvar reference undefined) (defvar analyzer undefined) (defvar symbols undefined)
  (defasync load (javascript label)
    (await (loadGeneratedFixture (get fixture :directory) javascript label)))
  (beforeAll (async ()
    (setq fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
    (setq backend (await (buildBackends (js-object :outputRoot (get fixture :directory)))))
    (setq runtime (js-call (get backend :compiler) :compile_ir_string (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
    (let* ((source (js-call (get backend :compiler) :compile_ir_string (await (readFile (resolve root "bootstrap/compiler/expander.eli") "utf8")) "expander.eli"))
           (helper (js-call (flattenPortableNodes (get source :body)) :find (lambda (node) (and (= (get node :kind) "variable-declaration") (= (get node :value) "guard")))))
           (support (flattenPortableNodes (get (js-call (get backend :compiler) :compile_ir_string
             "(defconst guard nil) (defun guard-value (value) (lambda () value)) (defun guard-throw (value) (lambda () (throw value))) (defun guard-handler (trace answer throws) (lambda (message) (js-call trace :push message) (if throws (throw answer) answer))) (export guard guard-value guard-throw guard-handler)" "guard-adapter.eli") :body))))
      (js-call assert :ok helper)
      (setq program (Object/assign (js-object) source (js-object :body (js-call (js-array (globalThis.structuredClone helper)) :concat
        (js-call support :filter (lambda (node) (/= (get node :value) "guard")))))))
      (setq reference (await (load (js-call (get backend :compiler) :emit_ir_string program) "expander-guard"))))
    ;; Analyzer no longer has a generic guard. Extract its current real name
    ;; guards and their original diagnostic dependencies, never a fake guard.
    (let* ((source (js-call (get backend :compiler) :compile_ir_string (await (readFile (resolve root "bootstrap/compiler/analyzer.eli") "utf8")) "analyzer.eli"))
           (nodes (flattenPortableNodes (get source :body)))
           (names (js-array "fail" "compiler-fail" "analyzer-fail" "guarded-binding-name" "guarded-reference-name"))
           (selected (js-call nodes :filter (lambda (node) (js-call names :includes (get node :value)))))
           (support (flattenPortableNodes (get (js-call (get backend :compiler) :compile_ir_string
             "(defun guarded-binding-name (name context span) nil) (defun guarded-reference-name (name context span) nil) (export guarded-binding-name guarded-reference-name)" "analyzer-guard-exports.eli") :body)))
           (imports (js-call (js-call nodes :filter (lambda (node) (= (get node :kind) "import-declaration"))) :map (lambda (node)
             (let ((copy (globalThis.structuredClone node)))
               (put copy :value (get (pathToFileURL (resolve (get fixture :directory) "bootstrap" (get node :value))) :href)) copy))))
           (unit (Object/assign (js-object) source (js-object :body (js-call imports :concat
             (globalThis.structuredClone selected) (js-call support :filter (lambda (node) (= (get node :kind) "export-declaration"))))))))
      (js-call assert :strictEqual (js-length selected) 5)
      (js-call assert :strictEqual (js-call nodes :some (lambda (node) (= (get node :value) "guard"))) false)
      (setq analyzer (await (load (js-call (get backend :compiler) :emit_ir_string unit) "analyzer-name-guards")))
      (setq symbols (await (load (await (readFile (resolve (get fixture :directory) "bootstrap/symbol.mjs") "utf8")) "symbols"))))) 120000)
  (afterAll (lambda () (when fixture (js-call fixture :close))))
  (defun observed (operation)
    (let ((failed false) (failure undefined) (result undefined))
      (try (setq result (funcall operation)) (catch error (setq failed t failure error)))
      (js-object :failed failed :failure failure :result result)))
  (defun strictCall (body)
    (new globalThis.Proxy body (js-object :apply (lambda (target receiver arguments)
      (js-call assert :strictEqual receiver undefined) (Reflect/apply target receiver arguments)))))
  (test "compiler guards retain arrow identity, call this, exact values and synchronous return behavior"
    (async ()
      (let ((guard (get reference :guard)))
        (js-call assert :strictEqual (get guard :length) 2)
        (js-call assert :strictEqual (Object/hasOwn guard "prototype") false)
        (js-call assert :throws (lambda () (Reflect/construct globalThis.String (js-array) guard)) globalThis.TypeError)
        (js-call (js-array undefined nil false t -0 globalThis.NaN "" (js-object) (js-array) (globalThis.Symbol "value")) :forEach (lambda (value)
          (let ((calls 0))
            (js-call assert :ok (Object/is (funcall guard (strictCall (lambda () (setq calls (1+ calls)) value))
              (lambda (&rest ignored) (js-call assert :fail "handler must not run"))) value))
            (js-call assert :strictEqual calls 1))))
        (let ((promise (globalThis.Promise.resolve "value")))
          (js-call assert :strictEqual (funcall guard (lambda () promise) (lambda () (js-call assert :fail))) promise))
        (let* ((rejection (js-object)) (pending (globalThis.Promise.reject rejection)))
          (js-call assert :strictEqual (funcall guard (lambda () pending) (lambda () (js-call assert :fail "async rejection stays asynchronous"))) pending)
          (await (js-call assert :rejects pending (lambda (error) (eq error rejection))))))))
  (defun observeGuard (guard mode)
    (let* ((trace (js-array)) (sentinel (js-object)) (answer (js-object))
           (error (Object/defineProperty (js-object) "message" (js-object :get (lambda ()
             (js-call trace :push "message") (when (= mode "getter") (throw sentinel)) answer))))
           (result undefined) (thrown undefined))
      (try
        (setq result (funcall guard (strictCall (lambda () (js-call trace :push "operation") (throw error)))
          (strictCall (lambda (message) (js-call trace :push "handler") (js-call assert :strictEqual message answer)
            (when (= mode "handler") (throw sentinel)) answer))))
        (catch value (setq thrown (if (eq value sentinel) "sentinel" "unexpected"))))
      (js-object :trace trace :returnedAnswer (eq result answer) :thrown thrown)))
  (defun originalGuard (operation handler)
    (try (funcall operation) (catch error (funcall handler (get error :message)))))
  (test "compiler guards preserve one message read and do not recatch handler or getter failures"
    (lambda ()
      (let ((guard (get reference :guard)))
        (js-call (js-array "normal" "getter" "handler") :forEach (lambda (mode)
          (js-call assert :deepStrictEqual (observeGuard guard mode) (observeGuard originalGuard mode))))
        (js-call (js-array nil undefined) :forEach (lambda (value)
          (js-call assert :throws (lambda () (funcall guard (lambda () (throw value)) (lambda () (js-call assert :fail)))) globalThis.TypeError)))
        (js-call (js-array false t 3 "" (globalThis.Symbol "x")) :forEach (lambda (value)
          (js-call assert :strictEqual (funcall guard (lambda () (throw value)) (lambda (message) message)) undefined))))))
  (test "compiler guards catch source exceptions inside zero-import WASM while preserving returned and thrown identity"
    (lambda ()
      (let* ((saved (JSON/stringify program)) (bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime)))
             (a (instantiateManagedRuntime bytes)) (ignored (js-call a :auto 1))
             (trace (js-call a :sourceArray (js-array))) (answer (js-call a :sourceObject (js-object)))
             (message (js-call a :string "text")) (error (js-call a :sourceObject (js-object :message message)))
             (returns (js-call a :invoke "guard-value" (js-array answer))) (throws (js-call a :invoke "guard-throw" (js-array error)))
             (handles (js-array trace answer message error returns throws)))
        (js-call assert :strictEqual (JSON/stringify program) saved)
        (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
        (try
          (js-call (js-array false t) :forEach (lambda (throwsAgain)
            (let* ((handler (js-call a :invoke "guard-handler" (js-array trace answer throwsAgain)))
                   (normal (js-call a :invoke "guard" (js-array returns handler))))
              (js-call handles :push handler normal)
              (js-call assert :ok (js-call a :keyEqual normal answer))
              (js-call assert :strictEqual (js-call a :length trace) (if throwsAgain 1 0))
              (let ((result undefined))
                (try (setq result (js-call a :invoke "guard" (js-array throws handler)))
                  (js-call assert :strictEqual throwsAgain false)
                  (catch value (js-call assert :strictEqual throwsAgain t) (setq result value)))
                (js-call handles :push result) (js-call assert :ok (js-call a :keyEqual result answer)))
              (let ((recorded (js-call a :get trace (if throwsAgain 1 0))))
                (js-call handles :push recorded) (js-call assert :ok (js-call a :keyEqual recorded message)))
              (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))))
          (finally (js-call handles :forEach (lambda (value) (js-call a :release value)))
            (js-call a :closeModule) (js-call a :collect) (js-call assert :strictEqual (js-call a :live) 0))))))
  (defun nameGuard (index)
    (get analyzer (if (= index 0) "guarded_binding_name" "guarded_reference_name")))
  (defun nameOracle (index) (get symbols (if (= index 0) "binding_name" "reference_name")))
  (defun cacheName (index) (if (= index 0) "bindingNames" "referenceNames"))
  (test "actual analyzer name guards preserve original symbol decisions and reuse only their own successful cache"
    (lambda ()
      (js-call (js-array 0 1) :forEach (lambda (index)
        (let ((context (js-object :filename "guarded-names.eli")) (guard (nameGuard index)) (oracle (nameOracle index)))
          (js-call (js-array "value" "x-y" "arguments" "中😀" "$" "a?") :forEach (lambda (name)
            (let ((expected (funcall oracle name)))
              (js-call assert :strictEqual (funcall guard name context nil) expected)
              (let ((cache (get context (cacheName index))))
                (js-call assert :ok (js-call globalThis.Map globalThis.Symbol.hasInstance cache))
                (js-call assert :strictEqual (js-call cache :get name) expected)
                (js-call assert :strictEqual (funcall guard name context nil) expected)))))
          (let* ((marker (js-object :cachedIdentity t)) (cache (get context (cacheName index)))
                 (other (if (= index 0) "referenceNames" "bindingNames")))
            (js-call cache :set "cached-only" marker)
            (js-call assert :strictEqual (funcall guard "cached-only" context nil) marker)
            (js-call assert :strictEqual (Object/hasOwn context other) false)))))))
  (test "actual analyzer name guards retain precise original diagnostics failed-cache absence and one message read"
    (lambda ()
      (js-call (js-array 0 1) :forEach (lambda (index)
        (let* ((guard (nameGuard index)) (oracle (nameOracle index))
               (span (js-object :filename "source-original.eli" :start 12 :end 15 :line 2 :column 3 :endLine 2 :endColumn 6))
               (context (js-object :filename "guarded-names.eli"))
               (invalid (if (= index 0) (js-array "nil" "&rest" "a/b" "__eliscript_private") (js-array "__eliscript_private"))))
          (js-call invalid :forEach (lambda (name)
            (let* ((original (observed (lambda () (funcall oracle name)))) (failure (observed (lambda () (funcall guard name context span))))
                   (message (get (get original :failure) :message)) (error (get failure :failure)))
              (js-call assert :strictEqual (get original :failed) t) (js-call assert :strictEqual (get failure :failed) t)
              (js-call assert :strictEqual (get error :message) (+ "guarded-names.eli:2:3: " message))
              (js-call assert :deepStrictEqual (get error :eliscriptDiagnostic) (js-object :format "eliscript-diagnostic" :version 1
                :code "ELI-A0001" :severity "error" :phase "analysis" :message message
                :location (js-object :file "guarded-names.eli" :start (js-object :offset 12 :line 2 :column 3) :end (js-object :offset 15 :line 2 :column 6))))
              (js-call assert :strictEqual (Object/hasOwn context (cacheName index)) false))))
          (let* ((reads 0) (error (Object/defineProperty (js-object) "message" (js-object :get (lambda () (setq reads (1+ reads)) "original symbol failure"))))
                 (name (if (= index 0) (js-object :startsWith (lambda (&rest ignored) (throw error)))
                   (js-object :replaceAll (lambda (&rest ignored) (throw error)))))
                 (failure (observed (lambda () (funcall guard name context span)))))
            (js-call assert :strictEqual (get failure :failed) t) (js-call assert :strictEqual reads 1)
            (js-call assert :strictEqual (get (get (get failure :failure) :eliscriptDiagnostic) :message) "original symbol failure")))))))
)
