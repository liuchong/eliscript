(module tests.compiler-package-runtime-install
  (import "bun:test" mock afterAll)
  (import "bun:test" :as framework)
  (import "node:fs" readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "../../tools/backends/build.mjs" root)
  (import "../../tools/backends/managed-runtime.mjs" :as wasm)
  (import "../../tools/testing/compiler-package-execution.mjs" compilerPackageRuntimeFacade)
  (import "../../tools/testing/compiler-request-cases.mjs" isCompilerRequestFixture compilerRequestTestRegistration)
  (defconst suite "tests/compiler-package-session.test.mjs")
  (unless (js-call (get globalThis.process :argv) :some
            (lambda (argument) (or (= (resolve root argument) (resolve root suite))
              (isCompilerRequestFixture root argument (get globalThis.process :env)))))
    (throw (new globalThis.TypeError "package cleanup adapter requires its exact original suite")))
  (unless (= (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root suite))) :digest "hex")
             "1560a8e4862a96cb959b494382be66ce4b738e39e96532fe7211a9417ee1cd28")
    (throw (new globalThis.TypeError "package cleanup adapter refuses changed original suite bytes")))
  (defconst original (Object/assign (js-object) wasm))
  (defconst original-framework (Object/assign (js-object) framework))
  (when (js-call (get globalThis.process :argv) :some
          (lambda (argument) (isCompilerRequestFixture root argument (get globalThis.process :env))))
    (console/error "[compiler-request-partitions] four aggregate cases become 20 separately timed original/package output pairs; every original assertion remains; original 120s aggregate performance NOT ACCEPTED")
    (js-call mock :module "bun:test" (lambda () (Object/assign (js-object) original-framework
      (js-object :test (compilerRequestTestRegistration (get original-framework :test)))))))
  (defun instantiateManagedRuntime (&rest arguments)
    (compilerPackageRuntimeFacade (Reflect/apply (get original :instantiateManagedRuntime) original arguments)))
  (js-call mock :module (resolve root "tools/backends/managed-runtime.mjs")
    (lambda () (Object/assign (js-object) original (js-object :instantiateManagedRuntime instantiateManagedRuntime))))
  (afterAll (lambda ()
    (js-call mock :module (resolve root "tools/backends/managed-runtime.mjs") (lambda () original))
    (js-call mock :module "bun:test" (lambda () original-framework)))))
