(module tests.number-text-node-install
  (import "node:module" registerHooks syncBuiltinESMExports)
  (import "node:path" resolve basename)
  (import "node:url" pathToFileURL)
  (import "node:assert/strict" :default assert)
  (import "node:child_process" :default processes)
  (import "../../tools/backends/build.mjs" root)
  (import "../../tools/testing/number-text-node.mjs" numberTextSuite numberTextSuiteURL verifyNumberTextSource numberTextImportRoute)
  (import "../../tools/testing/managed-fixture-repairs.mjs" managedReferenceChildArguments)
  (import "./managed-reference-node.mjs")
  (verifyNumberTextSource)
  (js-call assert :ok (js-call (get globalThis.process :argv) :some (lambda (argument) (= (resolve root argument) (resolve root numberTextSuite)))))
  (defconst bridge (get (pathToFileURL (resolve root "tests/helpers/number-text-node-test.mjs")) :href))
  (defconst buildBridge (get (pathToFileURL (resolve root "tests/helpers/portable-node-build.mjs")) :href))
  (registerHooks (js-object :resolve (lambda (specifier context nextResolve)
    (let ((route (numberTextImportRoute specifier (get context :parentURL) bridge)))
      (cond
        ((and (= (get context :parentURL) numberTextSuiteURL) (= specifier "../tools/backends/build.mjs"))
          (js-object :url buildBridge :shortCircuit t))
        ((undefined? route) (funcall nextResolve specifier context))
        (t route))))))
  (defconst original-spawn (get processes :spawnSync))
  (put processes :spawnSync (lambda (command arguments &rest options)
    (let ((forwarded (if (= (basename command) "node")
      (managedReferenceChildArguments arguments (resolve root "tests/helpers/managed-reference-node.mjs")) arguments)))
      (Reflect/apply original-spawn processes (js-call (js-array command forwarded) :concat options)))))
  (syncBuiltinESMExports)
  (js-call globalThis.process :once "exit" (lambda () (put processes :spawnSync original-spawn) (syncBuiltinESMExports))))
