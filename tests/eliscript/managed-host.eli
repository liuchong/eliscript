                        (js-call assert :strictEqual (js-call runtime :toHostValue token) (js-call api :objectRoot))
                        ;; The separate raw Object ABI remains object-only.
                        (js-call assert :throws (lambda () (js-call runtime :objectGet token key))
                          (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0001")))
                        (js-call runtime :collect)
