                    (setq index (1+ index)))
                  (setq index 0)
                  (while (< index 8)
                    (js-call host-collection :set index (+ index 200))
                    (let* ((expected (js-call (get fixture :reference) :boundaryForeignRead host-collection))
                           (raw (js-call runtime :invoke "boundaryForeignRead" (js-array collection))))
                      (try
                        (let ((actual (js-call runtime :toHostValue raw)))
                          (js-call assert :strictEqual (aref actual 0) (aref expected 0))
                          (js-call assert :strictEqual (aref actual 1) (aref expected 1))
                          (js-call assert :strictEqual (aref actual 2) (aref expected 2))
