                     (js-call assert :strictEqual observed receiver)
                     (js-call (js-array false undefined) :forEach (lambda (failure)
                       (Object/defineProperty prototype key (js-object :configurable t :get
                         (lambda () (throw failure))))
                       (let ((threw false) (caught nil))
