  (defun integrity-node-binary (environment)
    (let ((configured (get environment :NODE_BINARY)))
      (if (nullish? configured)
        (let ((node (get environment :NODE))) (if (nullish? node) "node" node))
        configured)))
  (defun integrity-functional-resources (environment)
    (let* ((enabled (and (= (get environment :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE) "small")
                         (= (get environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1")))
           (resources (when enabled (independentCompilerResources (js-object :profile "small"))))
           (original (Object/assign (options) (js-object :auto 0))))
      (js-object :resourceAcceptance (if enabled "deferred" "baseline")
        :smallCapacityAcceptance (if enabled "DEFERRED / NOT ACCEPTED" "required-by-original-gate")
        :effectiveRuntimeProfile (if enabled "small" "original")
        :originalRuntimeOptions original
        :effectiveRuntimeOptions (if enabled
          (Object/assign (js-object) (get resources :budget) (js-object :auto (get resources :auto))) original)
        :memory (if enabled (get resources :memory) (js-object :initialPages 16 :maximumPages 1024)))))
  (defconst integrity-title "canonical host Object integrity mutations use the actual isolated host intrinsic")
  (test integrity-title
    (js-object :skip (/= (get (get globalThis.process :env) "ELISCRIPT_HOST_OBJECT_INTEGRITY_CHILD") "1") :timeout 120000)
    (async ()
      (js-call assert :strictEqual (get (get globalThis.process :versions) :bun) undefined
        "the isolated integrity regression must execute in real Node")
      (let* ((acceptance (integrity-functional-resources (get globalThis.process :env)))
             (fixture (await (canonical-fixture (get acceptance :memory))))
             (native (= (get (get globalThis.process :env) "ELISCRIPT_HOST_OBJECT_INTEGRITY_TARGET") "native"))
             (runtime undefined)
             (configuration (Object/assign (js-object) (get acceptance :effectiveRuntimeOptions)
                              (js-object :nativeTarget native-target)))
             (library (resolve directory (if (= native-target "arm64-macos") "integrity.dylib" "integrity.so"))))
        (when (= (get acceptance :resourceAcceptance) "deferred")
          (console/error "[canonical-integrity-resource-acceptance]" (JSON/stringify acceptance)))
        (if native
          (progn
            (js-call assert :ok native-target)
            (await (writeFile library (globalThis.Uint8Array.from (js-call (get shared-backend :native)
              :emit_typed_native_memory_library (get (get fixture :actual) :typed) native-target))))
            (setq runtime (await (instantiateNativeManagedRuntime library (get fixture :actual) configuration))))
          (setq runtime (await (instantiateManagedRuntimeWithHostModules (get fixture :bytes) configuration))))
      (let* (
             (roots (js-array)) (api (canonical-api runtime roots)))
        (try
          (js-call assert :strictEqual (js-call api :extensibleRoot) (Reflect/isExtensible (get globalThis.Object :prototype)))
          (js-call assert :strictEqual (js-call api :preventRoot) t)
          (js-call assert :strictEqual (Reflect/isExtensible (get globalThis.Object :prototype)) false)
          (js-call assert :strictEqual (js-call api :freezeRoot) (get globalThis.Object :prototype))
          (js-call assert :strictEqual (Object/isFrozen (get globalThis.Object :prototype)) t)
          (js-call assert :strictEqual (js-call api :frozenRoot) t)
          (js-call assert :strictEqual (js-call api :preventConstructor) t)
          (js-call assert :strictEqual (Reflect/isExtensible globalThis.Object) false)
          (js-call assert :strictEqual (js-call api :freezeConstructor) globalThis.Object)
          (js-call assert :strictEqual (Object/isFrozen globalThis.Object) t)
          (js-call assert :strictEqual (js-call api :frozenConstructor) t)
          (finally (canonical-close runtime roots)))))))
  (test "irreversible canonical host integrity is verified in an isolated real Node process without mutating the parent intrinsic"
    (lambda ()
      (let ((before (Reflect/isExtensible (get globalThis.Object :prototype))))
        (let* ((baseline (integrity-functional-resources (js-object)))
               (functional (integrity-functional-resources (js-object
                 :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small" :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1")))
               (small (independentCompilerResources (js-object :profile "small"))))
          (js-call assert :deepStrictEqual (get baseline :effectiveRuntimeOptions)
            (Object/assign (options) (js-object :auto 0)))
          (js-call assert :strictEqual (get baseline :resourceAcceptance) "baseline")
          (js-call (js-array (js-object :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small")
                            (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1")) :forEach
            (lambda (environment)
              (js-call assert :deepStrictEqual (integrity-functional-resources environment) baseline)))
          (js-call assert :strictEqual (get functional :resourceAcceptance) "deferred")
          (js-call assert :strictEqual (get functional :smallCapacityAcceptance) "DEFERRED / NOT ACCEPTED")
          (js-call assert :deepStrictEqual (get functional :originalRuntimeOptions) (get baseline :originalRuntimeOptions))
          (js-call assert :deepStrictEqual (get functional :effectiveRuntimeOptions)
            (Object/assign (js-object) (get small :budget) (js-object :auto (get small :auto))))
          (js-call assert :deepStrictEqual (get functional :memory) (get small :memory)))
        (js-call assert :strictEqual (integrity-node-binary (js-object)) "node")
        (js-call assert :strictEqual (integrity-node-binary (js-object :NODE "actual-node")) "actual-node")
        (js-call assert :strictEqual (integrity-node-binary (js-object :NODE "other-node" :NODE_BINARY "configured-node")) "configured-node")
        (js-call (if native-target (js-array "wasm" "native") (js-array "wasm")) :forEach (lambda (target)
          (let* ((environment (Object/assign (js-object) (get globalThis.process :env)
                    (js-object :ELISCRIPT_HOST_OBJECT_INTEGRITY_CHILD "1"
                      :ELISCRIPT_HOST_OBJECT_INTEGRITY_TARGET target)))
                 ;; This is a new runner, not a worker of the parent runner.
                 ;; Inheriting the private worker marker can exit successfully
                 ;; without executing the selected child test at all.
                 (unused (Reflect/deleteProperty environment "NODE_TEST_CONTEXT"))
                 (result (spawnSync (integrity-node-binary environment)
            (js-array "--test" "--test-reporter=tap" "--test-name-pattern" (str "^" integrity-title "$")
              (resolve root "tests/managed-host-selfhosted.test.mjs"))
            (js-object :encoding "utf8" :env environment))))
            (js-call assert :strictEqual (get result :error) undefined)
            (js-call assert :strictEqual (get result :status) 0 (str (get result :stdout) (get result :stderr)))
            (js-call assert :match (get result :stdout) (new globalThis.RegExp "^# tests 1$" "m"))
            (js-call assert :match (get result :stdout) (new globalThis.RegExp "^# pass 1$" "m"))
            (js-call assert :match (get result :stdout) (new globalThis.RegExp "^# fail 0$" "m"))
            (js-call assert :strictEqual (Reflect/isExtensible (get globalThis.Object :prototype)) before)))))))
  ;; FIX-33: observe the real host factory's memory adapter, not a substitute
  ;; implementation of the snapshot algorithm. No public debug API is needed.
  (defun counted-collection-runtime (fixture)
    (let* ((descriptor (get (get fixture :actual) :descriptor))
           (configuration (js-object :maxSlots 32768 :initialBytes 4194304 :maxBytes 33554432))
           (bridge (js-call host :createManagedHostCapabilityBridge descriptor configuration))
           (imports (js-object)) (reads (js-array)) (recording false))
      (js-call (get descriptor :hostCapabilities) :forEach (lambda (capability)
        (unless (get imports (get capability :module)) (put imports (get capability :module) (js-object)))
        (put (get imports (get capability :module)) (get capability :name)
          (lambda (heap arguments) (js-call bridge :dispatch (get capability :name) heap arguments)))))
      (let* ((exports (get (new globalThis.WebAssembly.Instance
                             (new globalThis.WebAssembly.Module (get fixture :bytes)) imports) :exports))
             (memory (js-object
               :view (lambda () (new globalThis.DataView (get (get exports :memory) :buffer)))
               :readBytes (lambda (offset length)
                 (when recording (js-call reads :push (js-array offset length)))
                 (js-call (new globalThis.Uint8Array (get (get exports :memory) :buffer) offset length) :slice))
               :writeBytes (lambda (offset values)
                 (js-call (new globalThis.Uint8Array (get (get exports :memory) :buffer) offset (js-length values)) :set values))))
             (runtime (js-call host :createManagedHostRuntime exports descriptor memory configuration
                        (js-object :capabilityBridge bridge))))
        (js-object :runtime runtime :reads reads
          :start (lambda () (put reads :length 0) (setq recording t))
          :stop (lambda () (setq recording false))
          :grow (lambda () (js-call (get exports :memory) :grow 1))))))

  (test "FIX33 collection snapshots bound reads by used cells across the native block boundary and reacquire grown memory"
    (js-object :timeout 300000)
    (async ()
      (let ((fixture (await (canonical-fixture))))
        (js-call (js-array 416 2730 2731) :forEach (lambda (count)
          (let* ((observed (counted-collection-runtime fixture)) (runtime (get observed :runtime))
                 (token (js-call runtime :invoke "boundaryCollection"))
                 (map (js-call runtime :toHostValue token)))
            (try
              (js-call runtime :auto 1)
              (let ((index 0))
                (while (< index count) (js-call map :set index index) (setq index (1+ index))))
              ;; Import the host mutation before measuring unchanged snapshots.
              (js-call runtime :toHostValue token)
              (js-call observed :grow)
              (js-call observed :start)
              (js-call assert :strictEqual (js-call runtime :toHostValue token) map)
              (js-call observed :stop)
              (let* ((lengths (js-call (get observed :reads) :map (lambda (entry) (aref entry 1))))
                     (pattern (if (> count 2730) (js-array 4 8 65520 24) (js-array 4 8 (* count 24)))))
                (js-call assert :ok (> (js-length lengths) 0) "snapshots must use the bounded readBytes seam")
                (js-call assert :strictEqual (% (js-length lengths) (js-length pattern)) 0)
                (js-call lengths :forEach (lambda (length index)
                  (js-call assert :strictEqual length (aref pattern (% index (js-length pattern)))))))
              ;; Same-size overwrites and a deleted/reinserted key remain live
              ;; even when the owning linear memory has changed its buffer.
              (js-call map :set 0 "replacement")
              (js-call map :delete 1) (js-call map :set 1 "last")
              (js-call runtime :toHostValue token)
              (js-call runtime :collect)
              (js-call assert :strictEqual (js-call map :get 0) "replacement")
              (js-call assert :strictEqual (aref (Array/from (js-call map :keys)) (1- count)) 1)
              (finally (js-call observed :stop) (canonical-close runtime (js-array token))))))))))

  ;; FIX-35 exercises the same value-object-copy entry called by object-assoc.
  ;; The original complete stdlib object and formatter programs remain intact.
  (defun foreign-copy-subject (shared symbol collect &optional failure failure-stage)
    (let* ((trace (js-array)) (target (Object/create (js-object :inherited 9)))
           (proxy undefined)
           (data (lambda (key value enumerable)
             (Object/defineProperty target key (js-object :value value :enumerable enumerable
               :writable t :configurable t)))))
      (Object/defineProperty target "first" (js-object :enumerable t :configurable t
        :get (funcall (js* "(observe, value) => function () { observe(this); return value; }")
          (lambda (receiver) (js-call assert :strictEqual receiver proxy)
            (js-call trace :push (js-array "getter" "first"))) shared)))
      (funcall data "removed" 2 t)
      (funcall data "hidden" 3 false) (funcall data "__proto__" shared t)
      (funcall data symbol shared t)
      (setq proxy (new globalThis.Proxy target (js-object
        :ownKeys (lambda (value) (js-call trace :push (js-array "keys"))
          (js-array "first" "removed" "hidden" "__proto__" symbol))
        :getOwnPropertyDescriptor (lambda (value key)
          (js-call trace :push (js-array "descriptor" key))
          (when (and (= key "first") (= failure-stage "descriptor")) (throw failure))
          (Reflect/getOwnPropertyDescriptor value key))
        :get (lambda (value key receiver)
          (js-call trace :push (js-array "get" key))
          (js-call assert :strictEqual receiver proxy)
          (when (= key "first")
            (funcall collect)
            (when (= failure-stage "get") (throw failure))
            (Reflect/deleteProperty target "removed")
            (funcall data "added" 4 t))
          (Reflect/get value key receiver)))))
      (js-object :source proxy :target target :trace trace)))

