             (reference (await (loadReference (resolve directory "source-error-matcher-reference.mjs")
               (js-call (get shared-backend :compiler) :emit_ir_string program))))
             (actual (js-call (get shared-backend :managed) :lower_managed_program program shared-runtime t nil nil nil nil nil nil nil t))
             (bytes (globalThis.Uint8Array.from (js-call (get shared-backend :wasm) :append_metadata_section
               (js-call (get shared-backend :wasm) :emit_typed_memory_wasm (get actual :typed))
               "eliscript-managed-control" (JSON/stringify (get actual :descriptor)))))
             (runtimes (js-array (await (instantiateManagedRuntimeWithHostModules bytes (options)))))
             (exercise (lambda (api)
               (let ((value (js-call api :errorValue)) (constructor (js-call api :errorClass)))
                 (js-call assert :strictEqual (get constructor :name) "TypeError")
                 (js-call assert :strictEqual (Object/getPrototypeOf value) (js-call api :errorPrototype))
                 (js-call assert :strictEqual (get value :name) "TypeError")
                 (js-call assert :strictEqual (get value :message) "materializer invalid fields")
                 (js-call assert :strictEqual (get value :cause) "original cause")
                 (js-call assert :strictEqual (js-call api :classify value) t)
                 (js-call assert :strictEqual (js-call api :classify (js-call api :lookalike)) false)
                 ;; Keep a strict constructor matcher; a same-name ordinary
                 ;; object must never satisfy the source TypeError class.
                 (js-call assert :throws (lambda () (js-call api :fail)) constructor)
                 (js-call assert :throws (lambda () (js-call api :fail)) (lambda (error) (eq error value)))))))
        (funcall exercise reference)
        (when native-target
          (let ((path (resolve directory (if (= native-target "arm64-macos") "source-error-matcher.dylib" "source-error-matcher.so"))))
            (await (writeFile path (globalThis.Uint8Array.from (js-call (get shared-backend :native)
              :emit_typed_native_memory_library (get actual :typed) native-target))))
            (js-call runtimes :push (await (instantiateNativeManagedRuntime path actual
              (Object/assign (options) (js-object :nativeTarget native-target)))))))
        (js-call runtimes :forEach (lambda (runtime)
          (let ((roots (js-array)) (api (js-object)))
            (try
              (js-call runtime :auto 1)
              (js-call (js-array "errorValue" "errorClass" "errorPrototype" "fail" "classify" "lookalike")
                :forEach (lambda (name) (let ((raw (js-call runtime :getExport name)))
                  (js-call roots :push raw) (put api name (js-call runtime :toHostValue raw)))))
              (funcall exercise api)
              (finally (canonical-close runtime roots)))))))))

  (test "source Error reflection preserves represented descriptors and identical synchronous and asynchronous rejection values"
    (js-object :timeout 300000)
    (async ()
      (let* ((text (str
                "(defconst constructors (js-array globalThis.Error globalThis.TypeError globalThis.RangeError globalThis.SyntaxError globalThis.ReferenceError))\n"
                "(defconst errors (js-call constructors :map (lambda (constructor index) (let ((error (new constructor (+ \"HTTP limit \" index) (js-object :cause \"original cause\")))) (Object/defineProperty error \"note\" (js-object :value index :writable t :enumerable t :configurable t)) (when (= index 4) (put error \"stack\" \"explicit original stack\") (Object/defineProperty error \"stack\" (js-object :value \"explicit original stack\" :writable t :configurable t))) error))))\n"
                "(defun original (index) (aref errors index))\n"
                "(defun original-prototype (index) (get (aref constructors index) :prototype))\n"
                "(defun classification (index) (let ((value (original index)) (constructor (aref constructors index))) (js-array (js-call constructor (get globalThis/Symbol :hasInstance) value) (eq (Object/getPrototypeOf value) (get constructor :prototype)))))\n"
                "(defun ordinary-error-lookalike () (js-object :name \"TypeError\" :message \"ordinary\"))\n"
                "(defun custom-error-prototype (prototype) (let ((value (new globalThis.TypeError \"custom\"))) (Reflect/setPrototypeOf value prototype) value))\n"
                "(defun custom-prototype-classification (value prototype) (js-array (eq (Object/getPrototypeOf value) prototype) (js-call globalThis/TypeError (get globalThis/Symbol :hasInstance) value)))\n"
                "(defun ordinary-error-lookalike-classification () (js-call globalThis/Error (get globalThis/Symbol :hasInstance) (ordinary-error-lookalike)))\n"
                "(defun stack-descriptor (index) (Object/getOwnPropertyDescriptor (original index) \"stack\"))\n"
                "(defun throwing (index) (lambda () (throw (original index))))\n"
                "(defasync rejecting (index) (throw (original index)))\n"
                "(export original original-prototype classification ordinary-error-lookalike ordinary-error-lookalike-classification custom-error-prototype custom-prototype-classification stack-descriptor throwing rejecting)\n"))
             (program (js-call (get shared-backend :compiler) :compile_ir_string text "error-reflection.eli"))
             (oracle (await (loadReference (resolve directory "error-reflection-reference.mjs")
               (js-call (get shared-backend :compiler) :emit_ir_string program))))
             (actual (js-call (get shared-backend :managed) :lower_managed_program program shared-runtime t))
             (wasm (globalThis.Uint8Array.from (js-call (get shared-backend :wasm) :append_metadata_section
               (js-call (get shared-backend :wasm) :emit_typed_memory_wasm (get actual :typed))
               "eliscript-managed-control" (JSON/stringify (get actual :descriptor)))))
             (runtimes (js-array (instantiateManagedRuntime wasm (options)))))
        (when native-target
          (let ((path (resolve directory (if (= native-target "arm64-macos") "error-reflection.dylib" "error-reflection.so"))))
            (await (writeFile path (globalThis.Uint8Array.from
              (js-call (get shared-backend :native) :emit_typed_native_memory_library (get actual :typed) native-target))))
            (js-call runtimes :push (await (instantiateNativeManagedRuntime path actual
              (Object/assign (options) (js-object :nativeTarget native-target)))))))
        (let ((position 0))
          (while (< position (js-length runtimes))
            (let ((runtime (aref runtimes position)) (roots (js-array)) (failed false))
              (letfn ((read (name &rest arguments)
                (let ((token (js-call runtime :invoke name arguments)))
                  (js-call roots :push token) (js-call runtime :toHostValue token))))
                (try
                  (js-call runtime :auto 1)
                  (let ((index 0))
                    (while (< index 5)
                      (let* ((input (js-call runtime :number index)) (_input (js-call roots :push input))
                             (expected (js-call oracle :original index)) (value (read "original" input))
                             (keys (Object/getOwnPropertyNames value))
                             (standard (js-call (Object/getOwnPropertyNames expected) :filter (lambda (key) (/= key "stack")))))
                        ;; An explicit stack is represented; a generated engine
                        ;; stack remains unavailable under the existing contract.
                        (when (= index 4) (js-call standard :push "stack"))
                        (js-call assert :deepStrictEqual keys standard)
                        (js-call assert :deepStrictEqual (Object/keys value) (Object/keys expected))
                        (js-call assert :deepStrictEqual (Object/getOwnPropertySymbols value) (js-array))
                        (js-call keys :forEach (lambda (key)
                          (js-call assert :deepStrictEqual (Object/getOwnPropertyDescriptor value key)
                            (Object/getOwnPropertyDescriptor expected key))))
                        ;; Source Errors retain their own live realm. Classify
                        ;; with that source's constructor and preserve the exact
                        ;; decoded source prototype instead of substituting a
                        ;; different host realm's Error.prototype.
                        (js-call assert :deepStrictEqual (Array/from (read "classification" input)) (js-array t t))
                        (js-call assert :strictEqual (Object/getPrototypeOf value) (read "original-prototype" input))
                        (js-call assert :strictEqual (get value :name) (get expected :name))
                        (js-call assert :strictEqual (get value :message) (get expected :message))
                        (js-call assert :strictEqual (get value :cause) "original cause")
                        (js-call assert :strictEqual (funcall globalThis.String value) (funcall globalThis.String expected))
                        (when (< index 4)
                          (js-call assert :throws (lambda () (read "stack-descriptor" input))
                            (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0003")))
                          (js-call assert :strictEqual (Object/getOwnPropertyDescriptor value "stack") undefined)
                          (js-call assert :strictEqual (Object/hasOwn value "stack") false)
                          (js-call assert :throws (lambda () (get value :stack))
                            (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0003"))))
                        (let ((operation (read "throwing" input)))
                          (js-call assert :throws (lambda () (funcall operation)) (lambda (error) (eq error value))))
                        (await (js-call assert :rejects (read "rejecting" input) (lambda (error) (eq error value))))
                        (await (js-call assert :rejects (read "rejecting" input) (new globalThis.RegExp "limit" "u")))
                        (js-call runtime :collect)
                        (js-call assert :strictEqual (read "original" input) value)
                        (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
                      (setq index (1+ index))))
                  (let ((value (read "ordinary-error-lookalike")))
                    (js-call assert :strictEqual (get value :name) "TypeError")
                    (js-call assert :strictEqual (read "ordinary-error-lookalike-classification") false))
                  (let* ((input (js-call runtime :sourceObject (js-object :custom t)))
                         (prototype (js-call runtime :toHostValue input))
                         (token (js-call runtime :invoke "custom-error-prototype" (js-array input))))
                    (js-call roots :push input token)
                    (let ((value (js-call runtime :toHostValue token))
                          (classification (js-call runtime :invoke "custom-prototype-classification" (js-array token input))))
                      (js-call roots :push classification)
                      (js-call assert :strictEqual (Object/getPrototypeOf value) prototype)
                      (js-call assert :strictEqual (get value :message) "custom")
                      (js-call assert :deepStrictEqual (Array/from (js-call runtime :toHostValue classification)) (js-array t false))))
                  (catch error (setq failed t) (throw error))
                  (finally
                    (try
                      (js-call roots :forEach (lambda (token) (js-call runtime :release token)))
                      (js-call runtime :closeModule) (js-call runtime :collect)
                      (js-call assert :strictEqual (js-call runtime :live) 0)
                      (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                      (when (get runtime :close) (js-call runtime :close))
                      (catch cleanup (unless failed (throw cleanup))))))))
            (setq position (1+ position)))))))

  (test "function-only and global-owning modules release Math and Unicode workspace roots while preserving caller values on close"
    (js-object :timeout 300000)
    (async ()
      (let ((variant 0))
        (while (< variant 2)
          (let* ((text (str (if (= variant 0) "" "(defconst module-marker 1)\n")
                    "(defun scalar-workspace () (Math/acos 1))\n"
                    "(defun random-state () (Math/random))\n"
                    "(defun emoji-table () (js-call (new globalThis/RegExp \"\\\\p{RGI_Emoji}\" \"v\") :test \"😀\"))\n"
                    "(export scalar-workspace random-state emoji-table)\n"))
                 (program (js-call (get shared-backend :compiler) :compile_ir_string text "workspace-close.eli"))
                 (actual (js-call (get shared-backend :managed) :lower_managed_program program shared-runtime t))
                 (image (globalThis.Uint8Array.from (js-call (get shared-backend :wasm) :append_metadata_section
                   (js-call (get shared-backend :wasm) :emit_typed_memory_wasm (get actual :typed))
                   "eliscript-managed-control" (JSON/stringify (get actual :descriptor)))))
                 (native-path undefined))
            (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module image)) (js-array))
            (when native-target
              (setq native-path (resolve directory (str "workspace-close-" variant (if (= native-target "arm64-macos") ".dylib" ".so"))))
              (await (writeFile native-path (globalThis.Uint8Array.from
                (js-call (get shared-backend :native) :emit_typed_native_memory_library (get actual :typed) native-target)))))
            (let ((target 0))
              (while (< target (if native-target 2 1))
                (let ((mode 0))
                  (while (< mode 4)
                    (let* ((runtime (if (= target 0) (instantiateManagedRuntime image (options))
                                     (await (instantiateNativeManagedRuntime native-path actual
                                       (Object/assign (options) (js-object :nativeTarget native-target))))))
                           (held (js-call runtime :number -0.0)) (frame (js-call runtime :frame 1)))
                      (js-call runtime :frameSet frame 0 held) (js-call runtime :auto 1)
                      (letfn ((run (name)
                        (let ((value (js-call runtime :invoke name)))
                          (try
                            (cond ((= name "scalar-workspace") (js-call assert :strictEqual (js-call runtime :readNumber value) 0))
                              ((= name "random-state") (let ((number (js-call runtime :readNumber value)))
                                (js-call assert :ok (and (>= number 0) (< number 1)))))
                              (t (js-call assert :strictEqual value t)))
                            (finally (js-call runtime :release value))))))
                        (try
                          (progn
                            (when (or (= mode 0) (= mode 2)) (run "scalar-workspace"))
                            (when (or (= mode 1) (= mode 2)) (run "random-state"))
                            (when (= mode 3) (run "emoji-table"))
                            (js-call runtime :closeModule) (js-call runtime :collect)
                            (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 1)
                            (js-call assert :strictEqual (Object/is (js-call runtime :readNumber held) -0.0) t)
                            ;; The caller owns one Number and one managed
                            ;; frame record; both count as live heap values.
                            (js-call assert :strictEqual (js-call runtime :live) 2))
                          (finally
                            (js-call runtime :leaveFrame frame) (js-call runtime :release held)
                            (js-call runtime :closeModule) (js-call runtime :collect)
                            (js-call assert :strictEqual (js-call runtime :live) 0)
                            (when (get runtime :close) (js-call runtime :close))))))
                    (setq mode (1+ mode))))
                (setq target (1+ target)))))
          (setq variant (1+ variant))))))

  (test "log10 preserves the original StrictMath binary64 witnesses and exact decimal powers on WASM and native routes"
    (js-object :timeout 300000)
    (async ()
      (let* ((text (str "(defconst held Math/log10)"
                    " (defun route (mode value) (cond ((= mode 0) (Math/log10 value))"
                    " ((= mode 1) (funcall held value)) (t (js-call globalThis/Math :log10 value)))) (export route)"))
             (program (js-call (get shared-backend :compiler) :compile_ir_string text "log10-rounding.eli"))
             (actual (js-call (get shared-backend :managed) :lower_managed_program program shared-runtime t))
             (image (globalThis.Uint8Array.from (js-call (get shared-backend :wasm) :append_metadata_section
               (js-call (get shared-backend :wasm) :emit_typed_memory_wasm (get actual :typed))
               "eliscript-managed-control" (JSON/stringify (get actual :descriptor)))))
             (runtimes (js-array (instantiateManagedRuntime image (options))))
             (view (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
        (letfn ((from-words (high low)
                  (js-call view :setUint32 0 (globalThis.Number.parseInt high 16))
                  (js-call view :setUint32 4 (globalThis.Number.parseInt low 16)) (js-call view :getFloat64 0))
                (words (value)
                  (if (Number/isNaN value) "NaN"
                    (progn (js-call view :setFloat64 0 value)
                      (js-array (js-call view :getUint32 0) (js-call view :getUint32 4))))))
          ;; These are the two unchanged OpenJDK StrictMath Log10Tests pairs
          ;; retained by the complete original transcendental suite.
          (let ((cases (js-array
                  (js-array (from-words "2d63ffff" "fffffec1") (from-words "c05653c6" "a27ae2f8"))
                  (js-array (from-words "2d640000" "00000000") (from-words "c05653c6" "a27ae2f7"))
                  (js-array 1 0) (js-array 0 (- globalThis.Infinity)) (js-array -0.0 (- globalThis.Infinity))
                  (js-array -1 globalThis.NaN) (js-array globalThis.Infinity globalThis.Infinity)
                  (js-array globalThis.NaN globalThis.NaN))))
            (let ((power 0))
              (while (<= power 22)
                (js-call cases :push (js-array (Math/pow 10 power) power)) (setq power (1+ power))))
            (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module image)) (js-array))
            (when native-target
              (let ((path (resolve directory (if (= native-target "arm64-macos") "log10-rounding.dylib" "log10-rounding.so"))))
                (await (writeFile path (globalThis.Uint8Array.from
                  (js-call (get shared-backend :native) :emit_typed_native_memory_library (get actual :typed) native-target))))
                (js-call runtimes :push (await (instantiateNativeManagedRuntime path actual
                  (Object/assign (options) (js-object :nativeTarget native-target)))))))
            (js-call runtimes :forEach (lambda (runtime)
              (let ((held (js-call runtime :number -0.0)) (frame (js-call runtime :frame 1)))
                (js-call runtime :frameSet frame 0 held) (js-call runtime :auto 1)
                (try
                  (js-call cases :forEach (lambda (entry)
                    (let ((input (js-call runtime :number (aref entry 0))))
                      (try
                        (js-call (js-array 0 1 2) :forEach (lambda (mode)
                          (let ((route (js-call runtime :number mode)) (value undefined))
                            (try
                              (setq value (js-call runtime :invoke "route" (js-array route input)))
                              (js-call assert :deepStrictEqual (words (js-call runtime :readNumber value)) (words (aref entry 1)))
                              (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 1)
                              (js-call assert :strictEqual (Object/is (js-call runtime :readNumber held) -0.0) t)
                              (finally
                                (unless (undefined? value) (js-call runtime :release value))
                                (js-call runtime :release route))))))
                        (finally (js-call runtime :release input))))))
                  (finally
                    (js-call runtime :leaveFrame frame) (js-call runtime :release held)
                    (js-call runtime :closeModule) (js-call runtime :collect)
                    (js-call assert :strictEqual (js-call runtime :live) 0)
                    (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                    (when (get runtime :close) (js-call runtime :close))))))))))))

  (test "constructor expressions construct the complete callee once after factory and bind evaluation across independent emitters and binary targets"
    (async ()
      (let* ((text (str
                    "(defun made (value) (js-object :value value))\n"
                    "(defun pick (trace target marker fail) (js-call trace :push \"factory\") (when fail (throw marker)) target)\n"
                    "(defun argument (trace marker fail) (js-call trace :push \"argument\") (when fail (throw marker)) 7)\n"
                    "(defun observe (mode tag)"
                    " (let* ((trace (js-array)) (receiver nil)"
                    " (marker (cond ((= tag 0) false) ((= tag 1) undefined) (t (js-object :reason \"marker\"))))"
                    " (target (cond ((= mode 1) Math/sqrt) ((= mode 6) (lambda (value) (js-object :value value))) (t made))))"
                    " (js-array (try (get (cond"
                    " ((= mode 2) (new (js-call made :bind nil) 7))"
                    " ((= mode 3) (new (js-call made :bind receiver) 8))"
                    " ((= mode 4) (new (js-call Math/sqrt :bind nil) 81))"
                    " ((= mode 5) (new (js-call Math/sqrt :bind receiver) 81))"
                    " ((= mode 9) (new (pick trace (js-call made :bind nil) marker false) (argument trace marker false)))"
                    " (t (new (pick trace target marker (= mode 7)) (argument trace marker (= mode 8))))) :value)"
                    " (catch error (if (eq error marker) \"marker\" (get error :name)))) trace)))\n"
                    "(defun report () (let ((out (js-array)) (mode 0))"
                    " (while (< mode 10) (js-call out :push (observe mode 2)) (setq mode (1+ mode)))"
                    " (js-call (js-array 0 1) :forEach (lambda (tag) (js-call out :push (observe 7 tag) (observe 8 tag)))) out))"
                    " (export report)\n"))
             (filename (resolve directory "constructor-callee.eli"))
             (compiler (get shared-backend :compiler))
             (program (js-call compiler :compile_ir_string text filename))
             (snapshot (js-call compiler :serialize_ir_program program))
             (expected (js-array
               (js-array 7 (js-array "factory" "argument"))
               (js-array "TypeError" (js-array "factory" "argument"))
               (js-array 7 (js-array)) (js-array 8 (js-array))
               (js-array "TypeError" (js-array)) (js-array "TypeError" (js-array))
               (js-array "TypeError" (js-array "factory" "argument"))
               (js-array "marker" (js-array "factory"))
               (js-array "marker" (js-array "factory" "argument"))
               (js-array 7 (js-array "factory" "argument"))
               (js-array "marker" (js-array "factory")) (js-array "marker" (js-array "factory" "argument"))
               (js-array "marker" (js-array "factory")) (js-array "marker" (js-array "factory" "argument"))))
             ;; Both maintained Emacs representations emit this same source.
             ;; JSON transports their complete products; no JS fixture is handwritten.
             (seed-script (str
               "(progn (require 'json) (require 'eliscript)"
               " (let* ((file (getenv \"ELISCRIPT_CONSTRUCTOR_SOURCE\"))"
               " (source (with-temp-buffer (insert-file-contents file) (buffer-string)))"
               " (forms (eliscript-analyze-module (eliscript-expand-module (eliscript-read-located-string source file) file) file)))"
               " (princ (decode-coding-string (json-serialize"
               " `((ast . ,(decode-coding-string (substring-no-properties (eliscript-emit-module (mapcar #'eliscript-form-strip forms))) 'utf-8-unix))"
               " (ir . ,(decode-coding-string (substring-no-properties (eliscript-compile-string source file)) 'utf-8-unix)))) 'utf-8-unix))))")))
        (await (writeFile filename text))
        (let ((seed (spawnSync (or (get (get globalThis.process :env) :EMACS) "emacs")
                      (js-array "--batch" "-Q" "-L" "compiler" "--eval" seed-script)
                      (js-object :cwd root :encoding "utf8" :maxBuffer 4194304
                        :env (Object/assign (js-object) (get globalThis.process :env)
                               (js-object :ELISCRIPT_CONSTRUCTOR_SOURCE filename))))))
          (js-call assert :strictEqual (get seed :error) undefined)
          (js-call assert :strictEqual (get seed :signal) nil)
          (js-call assert :strictEqual (get seed :status) 0 (get seed :stderr))
          (let* ((products (JSON/parse (get seed :stdout)))
                 (emissions (js-array (get products :ast) (get products :ir) (js-call compiler :emit_ir_string program)))
                 (position 0))
            (while (< position (js-length emissions))
              (let ((oracle (await (loadReference (resolve directory (str "constructor-callee-" position ".mjs")) (aref emissions position)))))
                (js-call assert :deepStrictEqual (js-call oracle :report) expected))
              (setq position (1+ position)))))
        (let* ((actual (js-call (get shared-backend :managed) :lower_managed_program program shared-runtime t))
               (image (globalThis.Uint8Array.from (js-call (get shared-backend :wasm) :append_metadata_section
                 (js-call (get shared-backend :wasm) :emit_typed_memory_wasm (get actual :typed))
                 "eliscript-managed-control" (JSON/stringify (get actual :descriptor)))))
               (path (resolve directory (if (= native-target "arm64-macos") "constructor-callee.dylib" "constructor-callee.so")))
               (targets (if native-target (js-array "wasm" "native") (js-array "wasm"))) (position 0))
          (js-call assert :strictEqual (js-call compiler :serialize_ir_program program) snapshot)
          (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module image)) (js-array))
          (when native-target
            (await (writeFile path (globalThis.Uint8Array.from
              (js-call (get shared-backend :native) :emit_typed_native_memory_library (get actual :typed) native-target)))))
          (letfn ((read-value (runtime value)
                    (cond ((or (nullish? value) (= (value-type value) "boolean")) value)
                      ((= (get value :kind) 4) (js-call runtime :readNumber value))
                      ((= (get value :kind) 5) (js-call runtime :readString value))
                      ((= (get value :kind) 14)
                        (let ((out (js-array)) (index 0))
                          (while (< index (js-call runtime :length value))
                            (let ((child (js-call runtime :get value index)))
                              (try (js-call out :push (read-value runtime child))
                                (finally (js-call runtime :release child))))
                            (setq index (1+ index))) out))
                      (t (throw (new globalThis.TypeError "unexpected constructor observation"))))))
            (while (< position (js-length targets))
              (let* ((runtime (if (= (aref targets position) "wasm") (instantiateManagedRuntime image (options))
                                (await (instantiateNativeManagedRuntime path actual (Object/assign (options) (js-object :nativeTarget native-target))))))
                     (held (js-call runtime :number -0.0)) (frame (js-call runtime :frame 1)) (result undefined))
                (js-call runtime :frameSet frame 0 held) (js-call runtime :auto 1)
                (try
                  (setq result (js-call runtime :invoke "report" (js-array)))
                  (js-call assert :deepStrictEqual (read-value runtime result) expected)
                  (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 1)
                  (js-call assert :strictEqual (Object/is (js-call runtime :readNumber held) -0.0) t)
                  (finally
                    (unless (undefined? result) (js-call runtime :release result))
                    (js-call runtime :leaveFrame frame) (js-call runtime :release held)
                    (js-call runtime :closeModule) (js-call runtime :collect)
                    (js-call assert :strictEqual (js-call runtime :live) 0)
                    (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                    (when (get runtime :close) (js-call runtime :close)))))
              (setq position (1+ position))))))))

  (test "cosh keeps its StrictMath exp composition while every public exp route retains its original unit value"
    (js-object :timeout 300000)
    (async ()
      (let* ((filename "tests/fixtures/wasm-managed-math-transcendental.eli")
             (text (await (readFile (resolve root filename) "utf8")))
             (compiler (get shared-backend :compiler))
             (program (js-call compiler :compile_ir_string text filename))
             (oracle (await (loadReference (resolve directory "cosh-exp-reference.mjs") (js-call compiler :emit_ir_string program))))
             (actual (js-call (get shared-backend :managed) :lower_managed_program program shared-runtime t))
             (image (globalThis.Uint8Array.from (js-call (get shared-backend :wasm) :append_metadata_section
               (js-call (get shared-backend :wasm) :emit_typed_memory_wasm (get actual :typed))
               "eliscript-managed-control" (JSON/stringify (get actual :descriptor)))))
             (view (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
             (targets (if native-target (js-array "wasm" "native") (js-array "wasm")))
             (path (resolve directory (if (= native-target "arm64-macos") "cosh-exp.dylib" "cosh-exp.so"))))
        (letfn ((hex (text)
                  (let* ((match (js-call (new globalThis.RegExp "^(-?)0x([0-9a-f]+)(?:[.]([0-9a-f]+))?p([+-]?[0-9]+)$") :exec text))
                         (fraction (if (undefined? (aref match 3)) "" (aref match 3)))
                         (significand (globalThis.BigInt (str "0x" (aref match 2) fraction))))
                    (* (* (if (= (aref match 1) "-") -1 1) (globalThis.Number significand))
                      (Math/pow 2 (- (globalThis.Number (aref match 4)) (* 4 (js-length fraction)))))))
                (bits (value)
                  (if (Number/isNaN value) "NaN"
                    (progn (js-call view :setFloat64 0 value)
                      (js-array (js-call view :getUint32 0) (js-call view :getUint32 4))))))
          ;; Keep all six original exp/sinh/cosh StrictMath vectors. Their
          ;; expected tails are independent of the host's approximated Math.
          (let* ((golden (js-array
                   (js-array "exp" "0x1.2e8f20cf3cbe7p8" "0x1.6a2a59cc78bf8p436")
                   (js-array "exp" "-0x1.49f33ad2c1c58p9" "0x1.f3ccc815431b6p-953")
                   (js-array "sinh" "0x1.9fcba01feb507p-2" "0x1.ab50d8e4d8c56p-2")
                   (js-array "sinh" "-0x1.633c654fee2bap9" "-0x1.fdf25fc26e7cp1023")
                   (js-array "cosh" "0x1.0p0" "0x1.8b07551d9f551p0")
                   (js-array "cosh" "-0x1.633c654fee2bap9" "0x1.fdf25fc26e7cp1023")))
                 (cases (js-array)) (target-index 0))
            (js-call golden :forEach (lambda (record)
              (let ((name (aref record 0)) (input (hex (aref record 1))) (expected (hex (aref record 2))))
                (js-call cases :push (js-array name input expected))
                (unless (= name "exp")
                  (js-call cases :push (js-array name (- input) (if (= name "sinh") (- expected) expected)))))))
            ;; Public exp(1) already deliberately uses the nearest unit value.
            ;; Moving that policy out of the compositional kernel must retain
            ;; this value and every unchanged ±1 public result in emitted JS.
            (js-call assert :deepStrictEqual (bits (js-call oracle :direct "exp" 1 0 0))
              (js-array 1074118410 2333366121))
            (js-call (js-array "exp" "sinh") :forEach (lambda (name)
              (js-call (js-array 1 -1) :forEach (lambda (input)
                (js-call cases :push (js-array name input (js-call oracle :direct name input 0 0)))))))
            (js-call (js-array "exp" "sinh" "cosh") :forEach (lambda (name)
              (js-call (js-array 0 -0.0 globalThis.Infinity (- globalThis.Infinity) globalThis.NaN) :forEach (lambda (input)
                (js-call cases :push (js-array name input (js-call oracle :direct name input 0 0)))))))
            (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module image)) (js-array))
            (when native-target
              (await (writeFile path (globalThis.Uint8Array.from
                (js-call (get shared-backend :native) :emit_typed_native_memory_library (get actual :typed) native-target)))))
            (while (< target-index (js-length targets))
              (let* ((runtime (if (= (aref targets target-index) "wasm") (instantiateManagedRuntime image (options))
                                (await (instantiateNativeManagedRuntime path actual (Object/assign (options) (js-object :nativeTarget native-target))))))
                     (held (js-call runtime :number -0.0)) (frame (js-call runtime :frame 1)))
                (js-call runtime :frameSet frame 0 held) (js-call runtime :auto 1)
                (try
                  (js-call cases :forEach (lambda (record)
                    (let* ((key (js-call runtime :string (aref record 0)))
                           (input (js-call runtime :number (aref record 1)))
                           (values (js-call runtime :sourceArray (js-array input))) (mode 0))
                      (try
                        (while (< mode 10)
                          (let ((route (js-call runtime :number mode)) (result undefined))
                            (try
                              (setq result (js-call runtime :invoke "route" (js-array key route values)))
                              (js-call assert :deepStrictEqual (bits (js-call runtime :readNumber result)) (bits (aref record 2)))
                              (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 1)
                              (js-call assert :strictEqual (Object/is (js-call runtime :readNumber held) -0.0) t)
                              (finally
                                (unless (undefined? result) (js-call runtime :release result))
                                (js-call runtime :release route))))
                          (setq mode (1+ mode)))
                        (finally
                          (js-call runtime :release values) (js-call runtime :release input) (js-call runtime :release key))))
                    (js-call runtime :collect)))
                  (finally
                    (js-call runtime :leaveFrame frame) (js-call runtime :release held)
                    (js-call runtime :closeModule) (js-call runtime :collect)
                    (js-call assert :strictEqual (js-call runtime :live) 0)
                    (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                    (when (get runtime :close) (js-call runtime :close)))))
              (setq target-index (1+ target-index))))))))

  (test "source lambdas retain lexical this through nesting call apply bind throws and collecting GC while named functions remain dynamic"
    (js-object :timeout 300000)
    (async ()
      (let* ((suite (await (readFile (resolve root "tests/wasm-managed-math.test.mjs") "utf8")))
             (receiver-form (readOriginalMathThisForm suite))
             (text (str
                  "(defconst module-this (lambda () " receiver-form "))\n"
                  "(defun lexical-self () (lambda () " receiver-form "))\n"
                  "(defun nested-self () (lambda () (lambda () " receiver-form ")))\n"
                  "(defun throwing-self () (lambda () (throw " receiver-form ")))\n"
                  "(defun dynamic-self () " receiver-form ")\n"
                  "(defun report () (let* ((receiver (js-object)) (other (js-object))"
                  " (function (Reflect/apply lexical-self receiver (js-array)))"
                  " (nested (Reflect/apply nested-self receiver (js-array)))"
                  " (leaf (Reflect/apply nested other (js-array)))"
                  " (throwing (Reflect/apply throwing-self receiver (js-array))) (out (js-array)))"
                  " (js-call out :push (eq (Reflect/apply function other (js-array)) receiver)"
                  "   (eq (js-call function :call other) receiver) (eq (js-call function :apply other (js-array)) receiver)"
                  "   (eq (funcall (js-call function :bind other)) receiver) (eq (Reflect/apply leaf other (js-array)) receiver)"
                  "   (eq (Reflect/apply dynamic-self other (js-array)) other)"
                  "   (try (Reflect/apply throwing other (js-array)) (catch error (eq error receiver)))"
                  "   (undefined? (funcall module-this)))"
                  " (js-call (js-array undefined nil false -0.0) :forEach (lambda (primitive)"
                  "   (let ((closure (Reflect/apply lexical-self primitive (js-array))))"
                  "     (js-call out :push (Object/is (Reflect/apply closure other (js-array)) primitive))))) out)) (export report)\n"))
             (program (js-call (get shared-backend :compiler) :compile_ir_string text "lambda-this.eli"))
             (oracle (await (loadReference (resolve directory "lambda-this-reference.mjs")
               (js-call (get shared-backend :compiler) :emit_ir_string program))))
             (actual (js-call (get shared-backend :managed) :lower_managed_program program shared-runtime t))
             (image (globalThis.Uint8Array.from (js-call (get shared-backend :wasm) :append_metadata_section
               (js-call (get shared-backend :wasm) :emit_typed_memory_wasm (get actual :typed))
               "eliscript-managed-control" (JSON/stringify (get actual :descriptor)))))
             (runtimes (js-array (instantiateManagedRuntime image (options)))))
        (js-call assert :deepStrictEqual (js-call oracle :report) (js-array t t t t t t t t t t t t))
        (when native-target
          (let ((path (resolve directory (if (= native-target "arm64-macos") "lambda-this.dylib" "lambda-this.so"))))
            (await (writeFile path (globalThis.Uint8Array.from
              (js-call (get shared-backend :native) :emit_typed_native_memory_library (get actual :typed) native-target))))
            (js-call runtimes :push (await (instantiateNativeManagedRuntime path actual
              (Object/assign (options) (js-object :nativeTarget native-target)))))))
        (js-call runtimes :forEach (lambda (runtime)
          (js-call runtime :auto 1)
          (try
            (let ((value (js-call runtime :invoke "report")))
              (try (js-call assert :deepStrictEqual (Array/from (js-call runtime :toHostValue value)) (js-call oracle :report))
                (finally (js-call runtime :release value))))
            (finally
              (js-call runtime :closeModule) (js-call runtime :collect)
              (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
              (js-call assert :strictEqual (js-call runtime :live) 0)
              (when (get runtime :close) (js-call runtime :close)))))))))

  (test "raw module initialization retains the same owned source throw across retries and rejects initialization after close"
    (lambda ()
      (let* ((compiler (get shared-backend :compiler))
             (program (js-call compiler :compile_ir_string
               "(defconst failure (throw (new globalThis.TypeError \"original initializer\"))) (export failure)"
               "raw-initializer-throw.eli"))
             (lowered (js-call (get shared-backend :managed) :lower_managed_program program shared-runtime t))
             (image (globalThis.Uint8Array.from (js-call (get shared-backend :wasm) :append_metadata_section
               (js-call (get shared-backend :wasm) :emit_typed_memory_wasm (get lowered :typed))
               "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
             (runtime (instantiateManagedRuntime image (Object/assign (options) (js-object :initializeModule false))))
             (seen (js-array)) (closed false))
        (try
          (progn
            (js-call runtime :auto 1)
            (let ((index 0))
              (while (< index 2)
                (js-call assert :throws (lambda () (js-call runtime :initializeModule))
                  (lambda (error) (js-call seen :push error) (= (get error :kind) 13)))
                (js-call runtime :collect)
                (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                (setq index (1+ index))))
            (js-call assert :strictEqual (js-call runtime :keyEqual (aref seen 0) (aref seen 1)) t)
            (let* ((key (js-call runtime :string "message")) (message (js-call runtime :objectGet (aref seen 0) key)))
              (try (js-call assert :strictEqual (js-call runtime :readString message) "original initializer")
                (finally (js-call runtime :release message) (js-call runtime :release key))))
            (js-call runtime :closeModule) (setq closed t)
            (js-call assert :throws (lambda () (js-call runtime :initializeModule))
              (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0003"))))
          (finally
            (js-call seen :forEach (lambda (value) (js-call runtime :release value)))
            (unless closed (js-call runtime :closeModule))
            (js-call runtime :collect)
            (js-call assert :strictEqual (js-call runtime :live) 0))))))

  (test "actual registered Symbols decode through the native registry and retain ordinary identity across collecting WASM and native calls"
    (js-object :timeout 120000)
    (async ()
      (let* ((text (str "(defun registered (key) (js-call globalThis.Symbol :for key))\n"
                       "(defun ordinary (key) (funcall globalThis.Symbol key))\n"
                       "(export registered ordinary)\n"))
             (program (js-call (get shared-backend :compiler) :compile_ir_string text "registered-symbol.eli"))
             (reference (await (loadReference (resolve directory "registered-reference.mjs")
               (js-call (get shared-backend :compiler) :emit_ir_string program))))
             (actual (js-call (get shared-backend :managed) :lower_managed_program program shared-runtime t))
             (wasm (globalThis.Uint8Array.from (js-call (get shared-backend :wasm) :append_metadata_section
               (js-call (get shared-backend :wasm) :emit_typed_memory_wasm (get actual :typed))
               "eliscript-managed-control" (JSON/stringify (get actual :descriptor)))))
             (runtimes (js-array (instantiateManagedRuntime wasm (options)))))
        (when native-target
          (let ((path (resolve directory (if (= native-target "arm64-macos") "registered.dylib" "registered.so"))))
            (await (writeFile path (globalThis.Uint8Array.from
              (js-call (get shared-backend :native) :emit_typed_native_memory_library (get actual :typed) native-target))))
            (js-call runtimes :push (await (instantiateNativeManagedRuntime path actual
              (Object/assign (options) (js-object :nativeTarget native-target)))))))
        (js-call runtimes :forEach (lambda (runtime)
          (let* ((key "eliscript.real.registry.中😀") (roots (js-array))
                 (expected (js-call globalThis.Symbol :for key))
                 (input (js-call runtime :string key))
                 (read (lambda (name)
                   (let ((raw (js-call runtime :invoke name (js-array input))))
                     (js-call roots :push raw) (js-call runtime :toHostValue raw)))))
            (try
              (js-call runtime :auto 1)
              (js-call assert :strictEqual (js-call reference :registered key) expected)
              (let ((first (funcall read "registered"))
                    (ordinary (funcall read "ordinary")))
                (js-call assert :strictEqual first expected)
                (js-call assert :strictEqual (js-call globalThis.Symbol :keyFor first) key)
                (js-call assert :notStrictEqual ordinary expected)
                (js-call assert :strictEqual (get ordinary :description) key)
                (js-call runtime :collect)
                (js-call assert :strictEqual (funcall read "registered") first)
                (js-call assert :notStrictEqual (funcall read "ordinary") ordinary)
                (js-call assert :strictEqual (js-call globalThis.Symbol :keyFor ordinary) undefined))
              (finally
                (js-call roots :forEach (lambda (value) (js-call runtime :release value)))
                (js-call runtime :release input)
                (js-call runtime :closeModule) (js-call runtime :collect)
                (js-call assert :strictEqual (js-call runtime :live) 0)
                (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                (when (get runtime :close) (js-call runtime :close))))))))))

