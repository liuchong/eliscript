  (test "foreign entry TypeError matching uses the real source constructor and preserves the live source prototype and thrown identity"
    (async ()
      (let* ((source (str
               "(defconst original (new globalThis/TypeError \"materializer invalid fields\" (js-object :cause \"original cause\")))\n"
               "(defun errorValue () original)\n(defun errorClass () globalThis/TypeError)\n"
               "(defun errorPrototype () (get globalThis/TypeError :prototype))\n"
               "(defun fail () (throw original))\n"
               "(defun classify (value) (js-call globalThis/TypeError (get globalThis/Symbol :hasInstance) value))\n"
               "(defun lookalike () (js-object :name \"TypeError\" :message \"materializer invalid fields\"))\n"
               "(export errorValue errorClass errorPrototype fail classify lookalike)\n"))
