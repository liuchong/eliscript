                     (js-call assert :strictEqual (js-call api :inherit key receiver) 19)
                     (js-call assert :strictEqual (js-call api :read key receiver) shared)
                     (Reflect/deleteProperty array-prototype key)
                     (Reflect/set prototype key -0.0)
                     (js-call assert :ok (Object/is (js-call api :read key receiver) -0.0))
                     (Object/defineProperty prototype key (js-object :get undefined :configurable t))
