  (defun exercise (runtime)
    ;; Keep the actual independent generated JS oracle and its Symbol identity.
    (let ((actual (js-call reference :make_function_slot)))
      (js-call assert :strictEqual (get actual :slot) (js-call reference :read_through_source))
      (js-call assert :strictEqual (value-type (get actual :slot)) "symbol"))
    (let* ((left (funcall globalThis.Symbol "same ordinary Symbol description"))
           (right (funcall globalThis.Symbol "same ordinary Symbol description"))
           (a (js-call runtime :fromHostValue left)) (b undefined))
      (try
        (progn
          (setq b (js-call runtime :fromHostValue right))
          (js-call assert :notStrictEqual left right)
          (js-call assert :strictEqual (js-call runtime :keyEqual a b) false)
          (let ((index 0))
            (while (< index 3)
              (js-call runtime :collect)
              (js-call assert :strictEqual (js-call runtime :toHostValue a) left)
              (js-call assert :strictEqual (js-call runtime :toHostValue b) right)
              (js-call assert :notStrictEqual (js-call runtime :toHostValue a) (js-call runtime :toHostValue b))
              (setq index (1+ index)))))
        (finally (unless (undefined? b) (js-call runtime :release b)) (js-call runtime :release a))))
    (let ((roots (js-array)) (frame undefined) (primary false))
      (try
        (progn
          (js-call runtime :auto 1)
          ;; This is the same source Proxy apply/throw transport used by an
          ;; imported original-program ESM facade. Keep the observed Error
          ;; reachable through module close; its decoder-owned source root
          ;; must be disposed, and its original throw root must already have
          ;; been returned when sourceThrown delivered that Proxy.
          (let* ((function (js-call runtime :invoke "make-source-error"))
                 (callable undefined)
                 (caught false) (failure undefined) (expected undefined))
            (try
              (setq callable (js-call runtime :toHostValue function))
              (try (Reflect/apply (js-call reference :make_source_error) undefined (js-array))
                (catch error (setq expected error)))
              (try (Reflect/apply callable undefined (js-array))
                (catch error (setq caught t failure error)))
              (js-call assert :strictEqual caught t)
              (js-call assert :strictEqual (get failure :name) (get expected :name))
              (js-call assert :strictEqual (get failure :message) (get expected :message))
              (js-call runtime :collect)
              (js-call assert :strictEqual (get failure :message) "source throw must release its original root")
              (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
              (finally (js-call runtime :release function))))
          (let* ((function (js-call runtime :invoke "make-function-slot"))
                 (key (js-call runtime :string "slot")))
            (js-call roots :push function key)
            (setq frame (js-call runtime :frame 1)) (js-call runtime :frameSet frame 0 function)
            (let* ((first (js-call runtime :objectGet function key))
                   (expected (js-call runtime :invoke "read-through-source")))
              (js-call roots :push first expected)
              (js-call assert :strictEqual (get function :kind) 18)
              (js-call assert :strictEqual (get first :kind) 22)
              (js-call assert :strictEqual (js-call runtime :keyEqual first expected) t)
              (let ((symbol (js-call runtime :toHostValue first)) (index 0))
                (js-call assert :strictEqual (value-type symbol) "symbol")
                (while (< index 4)
                  (js-call runtime :collect)
                  (let ((again (js-call runtime :objectGet function key)))
                    (try
                      (js-call assert :strictEqual (js-call runtime :keyEqual first again) t)
                      (js-call assert :strictEqual (js-call runtime :toHostValue again) symbol)
                      (finally (js-call runtime :release again))))
                  (setq index (1+ index)))))
            (let* ((object (js-call runtime :invoke "make-object-slot"))
                   (ordinary (js-call runtime :objectGet object key)))
              (js-call roots :push object ordinary)
              (js-call assert :strictEqual (js-call runtime :keyEqual ordinary (aref roots 2)) t)
              ;; No supplied literal brand: both the first ordinary decode and
              ;; its later cached view must retain the source Symbol identity.
              (let ((view (js-call runtime :toHostValue object))
                    (symbol (js-call runtime :toHostValue ordinary)))
                (js-call assert :strictEqual (get view :slot) symbol)
                (js-call runtime :collect)
                (js-call assert :strictEqual (js-call runtime :toHostValue object) view)
                (js-call assert :strictEqual (get view :slot) symbol)))
            (let ((bad (js-call runtime :invoke "make-bad-getter")) (thrown false) (failure undefined))
              (js-call roots :push bad)
              (try (js-call runtime :objectGet bad key) (catch error (setq thrown t failure error)))
              (js-call assert :strictEqual thrown t)
              (js-call assert :strictEqual failure false)
              (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 1)
              (let ((recovered (js-call runtime :objectGet function key)))
                (try (js-call assert :strictEqual (js-call runtime :keyEqual recovered (aref roots 2)) t)
                  (finally (js-call runtime :release recovered)))))))
        (catch error (setq primary t) (throw error))
        (finally
          (let ((failure undefined) (failed false))
            (js-call (js-array
              (lambda () (unless (undefined? frame) (js-call runtime :leaveFrame frame)))
              (lambda () (js-call roots :forEach (lambda (value) (js-call runtime :release value))))
              (lambda () (js-call runtime :closeModule)) (lambda () (js-call runtime :collect))
              (lambda () (js-call assert :strictEqual (js-call runtime :live) 0))
              (lambda () (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
              (lambda () (when (get runtime :close) (js-call runtime :close))))
              :forEach (lambda (action) (try (funcall action)
                (catch error (unless failed (setq failed t failure error))))))
            (when (and failed (not primary)) (throw failure)))))))

  (test "lazy namespace callables have no own Symbol descriptors while described callables preserve exact data and accessor identities"
    (js-object :timeout 300000)
    (async ()
      (let* ((compiler (get shared-backend :compiler))
             (library-text "(module bare.callable.library (defun target (value) value) (export target))")
             (entry-text (str
               "(module bare.callable.entry (import \"./bare-callable-lib.mjs\" :as Library) "
               "(defun absent (key) (let ((target (get Library :target))) (js-array (Object/getOwnPropertyDescriptor target key) (eq target (get Library :target))))) "
               "(defun missing-name () (Object/getOwnPropertyDescriptor (get Library :target) \"name\")) "
               "(defun owned (key accessor) (let* ((value (js-object :marker t)) (target (lambda () value)) (getter (lambda () value)) "
               "(descriptor (if accessor (js-object :get getter :enumerable t :configurable t) (js-object :value value :writable false :enumerable t :configurable t)))) "
               "(Object/defineProperty target key descriptor) (js-array target descriptor getter value))) (export absent missing-name owned))"))
             (library-program (js-call compiler :compile_ir_string library-text "bare-callable-lib.eli"))
             (entry-program (js-call compiler :compile_ir_string entry-text "bare-callable-entry.eli"))
             (modules (js-array (js-object :id "bare-callable-lib.mjs" :program library-program)
               (js-object :id "bare-callable-entry.mjs" :program entry-program)))
             (_library (await (writeFile (resolve directory "bare-callable-lib.mjs") (js-call compiler :emit_ir_string library-program))))
             (oracle (await (loadReference (resolve directory "bare-callable-entry.mjs") (js-call compiler :emit_ir_string entry-program))))
             (actual (js-call (get shared-backend :managed) :lower_managed_project modules "bare-callable-entry.mjs" shared-runtime))
             (image (globalThis.Uint8Array.from (js-call (get shared-backend :wasm) :append_metadata_section
               (js-call (get shared-backend :wasm) :emit_typed_memory_wasm (get actual :typed))
               "eliscript-managed-control" (JSON/stringify (get actual :descriptor)))))
             (runtimes (js-array (instantiateManagedRuntime image (options)))))
        (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module image)) (js-array))
        (when native-target
          (let ((path (resolve directory (if (= native-target "arm64-macos") "bare-callable-symbols.dylib" "bare-callable-symbols.so"))))
            (await (writeFile path (globalThis.Uint8Array.from
              (js-call (get shared-backend :native) :emit_typed_native_memory_library (get actual :typed) native-target))))
            (js-call runtimes :push (await (instantiateNativeManagedRuntime path actual
              (Object/assign (options) (js-object :nativeTarget native-target)))))))
        (js-call runtimes :forEach (lambda (runtime)
          (let* ((held (js-call runtime :number -0.0)) (frame (js-call runtime :frame 1)) (failed false))
            (js-call runtime :frameSet frame 0 held) (js-call runtime :auto 1)
            (try
              (js-call (js-array (js-call globalThis.Symbol :for "eliscript.value.type")
                (funcall globalThis.Symbol "absent own key") globalThis.Symbol.iterator globalThis.Symbol.hasInstance)
                :forEach (lambda (key)
                  (let ((token (js-call runtime :fromHostValue key)))
                    (try
                      (let ((repeat 0))
                        (while (< repeat 2)
                          (let ((report (js-call runtime :invoke "absent" (js-array token))))
                            (try
                              (js-call assert :deepStrictEqual (Array/from (js-call runtime :toHostValue report))
                                (js-call oracle :absent key))
                              (finally (js-call runtime :release report))))
                          (js-call runtime :collect) (setq repeat (1+ repeat))))
                      ;; A Symbol lookup must not install or fabricate string
                      ;; metadata on the namespace's bare named function.
                      (js-call assert :throws (lambda () (js-call runtime :invoke "missing-name"))
                        (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0003")))
                      (js-call (js-array false t) :forEach (lambda (accessor)
                        (let* ((report (js-call runtime :invoke "owned" (js-array token accessor)))
                               (expected (js-call oracle :owned key accessor)))
                          (try
                            (let* ((values (Array/from (js-call runtime :toHostValue report)))
                                   (target (aref values 0)) (getter (aref values 2)) (marker (aref values 3))
                                   (descriptor (Object/getOwnPropertyDescriptor target key))
                                   (reference (Object/getOwnPropertyDescriptor (aref expected 0) key)))
                              (js-call assert :deepStrictEqual (Reflect/ownKeys descriptor) (Reflect/ownKeys reference))
                              (js-call assert :strictEqual (get descriptor :enumerable) (get reference :enumerable))
                              (js-call assert :strictEqual (get descriptor :configurable) (get reference :configurable))
                              (if accessor
                                (progn (js-call assert :strictEqual (get descriptor :get) getter)
                                  (js-call assert :strictEqual (get descriptor :set) undefined))
                                (progn (js-call assert :strictEqual (get descriptor :value) marker)
                                  (js-call assert :strictEqual (get descriptor :writable) false)))
                              (js-call assert :strictEqual (Reflect/get target key) marker)
                              (js-call runtime :collect)
                              (js-call assert :strictEqual (Reflect/get target key) marker))
                            (finally (js-call runtime :release report))))))
                      (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 1)
                      (js-call assert :strictEqual (Object/is (js-call runtime :readNumber held) -0.0) t)
                      (finally (js-call runtime :release token))))))
              (catch error (setq failed t) (throw error))
              (finally
                (try (js-call runtime :leaveFrame frame) (canonical-close runtime (js-array held))
                  (catch error (unless failed (throw error))))))))))))

