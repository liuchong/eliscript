                  (let ((path (resolve directory "foreign-boundary-collection.dylib")))
                    (await (writeFile path (globalThis.Uint8Array.from
                      (js-call (get shared-backend :native) :emit_typed_native_memory_library
                        (get (get fixture :actual) :typed) native-target))))
                    (setq runtime (await (instantiateNativeManagedRuntime path (get fixture :actual) configuration)))))
                (js-call runtime :auto 1)
