                (js-call assert :strictEqual (Object/hasOwn (get subject :target) "hidden") t))
              (js-call (js-array "descriptor" "get") :forEach (lambda (stage)
                (js-call (js-array false (Object/freeze (js-object :original "failure"))) :forEach (lambda (failure)
                  (let* ((bad (foreign-copy-subject shared symbol (lambda () (js-call runtime :collect)) failure stage))
                         (token (js-call runtime :fromHostValue (get bad :source)))
