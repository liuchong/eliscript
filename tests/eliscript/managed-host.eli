                          (js-array (js-array "keys") (js-array "descriptor" "first") (js-array "get" "first"))))
                      (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                      (finally (js-call runtime :release token))))))))
              (let* ((plain (js-call runtime :fromHostValue (js-object :after 7)))
                     (recovered undefined))
                (try
                  (setq recovered (js-call runtime :objectCopy plain))
                  (js-call assert :strictEqual (get (js-call runtime :toHostValue recovered) :after) 7)
                  (finally (when recovered (js-call runtime :release recovered)) (js-call runtime :release plain))))
