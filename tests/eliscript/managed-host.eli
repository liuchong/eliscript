             (runtime (get observed :runtime)) (shared (js-object :child t))
             (parent (js-object :inherited 1)) (source (Object/create parent))
             (symbol (funcall globalThis.Symbol "own symbol"))
             (input undefined) (result undefined))
        (Object/defineProperty source "hidden" (js-object :value 2))
        (Object/defineProperty source "own" (js-object :value shared :enumerable t))
        (Object/defineProperty source symbol (js-object :value shared :enumerable t))
        (let ((before (Object/getOwnPropertyDescriptors source)))
          (try
            (js-call runtime :auto 1)
            (setq input (js-call runtime :fromHostValue source))
            (setq result (js-call runtime :objectCopy input))
            (let ((actual (js-call runtime :toHostValue result))
                  (expected (funcall (js* "source => ({...source})") source)))
              (js-call assert :deepStrictEqual (Reflect/ownKeys actual) (Reflect/ownKeys expected))
              (js-call assert :strictEqual (get actual :own) shared)
              (js-call assert :strictEqual (get actual symbol) shared)
              (js-call assert :strictEqual (Object/hasOwn actual "inherited") false)
              (js-call assert :strictEqual (Object/hasOwn actual "hidden") false))
            (js-call assert :deepStrictEqual (Object/getOwnPropertyDescriptors source) before)
            (js-call assert :strictEqual (Object/getPrototypeOf source) parent)
            (finally (when result (js-call runtime :release result))
              (canonical-close runtime (if input (js-array input) (js-array)))))))))

  (test "foreign keys entries and values preserve original own-key descriptor and Get order for inherited inputs"
    (js-object :timeout 300000)
    (async ()
      (let ((fixture (await (canonical-fixture))))
        (js-call (js-array 1 65536) :forEach (lambda (threshold)
          (js-call (js-array (js-array "snapshotKeys" (get globalThis.Object :keys))
                            (js-array "snapshotEntries" (get globalThis.Object :entries))
                            (js-array "snapshotValues" (get globalThis.Object :values))) :forEach
            (lambda (operation)
              (let* ((observed (counted-collection-runtime fixture)) (runtime (get observed :runtime))
                     (shared (js-object :stable t)) (symbol (funcall globalThis.Symbol "enumeration"))
                     (subject (foreign-copy-subject shared symbol (lambda () (js-call runtime :collect))))
                     (oracle (foreign-copy-subject shared symbol (lambda () undefined)))
                     (input (js-call runtime :fromHostValue (get subject :source))) (result undefined))
                (try
                  (js-call runtime :auto threshold)
                  (put (get subject :trace) :length 0)
                  (let ((expected (Reflect/apply (aref operation 1) globalThis.Object (js-array (get oracle :source)))))
                    (setq result (js-call runtime :invoke (aref operation 0) (js-array input)))
                    (js-call assert :deepStrictEqual (get subject :trace) (get oracle :trace))
                    (let ((actual (Array/from (js-call runtime :toHostValue result))))
                      (when (= (aref operation 0) "snapshotEntries")
                        (setq actual (js-call actual :map (lambda (pair) (Array/from pair)))))
                      (js-call assert :deepStrictEqual actual expected)
                      (when (= (aref operation 0) "snapshotValues")
                        (js-call assert :strictEqual (aref actual 0) shared))
                      (when (= (aref operation 0) "snapshotEntries")
                        (js-call assert :strictEqual (aref (aref actual 0) 1) shared))))
                  (let* ((plain (Object/create (js-object :inherited 1)))
                         (_own (put plain :own 2))
                         (plain-input (js-call runtime :fromHostValue plain)) (plain-result undefined))
                    (try
                      (setq plain-result (js-call runtime :invoke (aref operation 0) (js-array plain-input)))
                      (let ((actual (Array/from (js-call runtime :toHostValue plain-result))))
                        (when (= (aref operation 0) "snapshotEntries")
                          (setq actual (js-call actual :map (lambda (pair) (Array/from pair)))))
                        (js-call assert :deepStrictEqual actual
                          (Reflect/apply (aref operation 1) globalThis.Object (js-array plain))))
                      (js-call assert :deepStrictEqual (Object/keys plain) (js-array "own"))
                      (js-call assert :strictEqual (get plain :own) 2)
                      (finally (when plain-result (js-call runtime :release plain-result))
                        (js-call runtime :release plain-input))))
                  (let ((failures (js-array false (Object/freeze (js-object :enumerationFailure t))))
                        (failure-index 0))
                    (while (< failure-index (js-length failures))
                      (let* ((failure (aref failures failure-index)) (reads 0)
                             (subject (new globalThis.Proxy (js-object :own 2)
                               (js-object :ownKeys (lambda ()
                                 (if (= failure-index 0) (throw failure) (js-array "own")))
                                 :getOwnPropertyDescriptor (lambda (target key)
                                   (js-call runtime :collect) (throw failure))
                                 :get (lambda (&rest ignored) (setq reads (1+ reads)) (throw failure)))))
                             (argument (js-call runtime :fromHostValue subject))
                             (caught false) (actual undefined))
                        (try
                          (try (js-call runtime :invoke (aref operation 0) (js-array argument))
                            (catch error (setq caught t actual error)))
                          (js-call assert :strictEqual caught t)
                          (js-call assert :strictEqual actual failure)
                          (js-call assert :strictEqual reads 0)
                          (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                          (finally (js-call runtime :release argument))))
                      (setq failure-index (1+ failure-index))))
                  (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                  (finally (when result (js-call runtime :release result))
                    (canonical-close runtime (js-array input))))))))))))

  (test "export diagnostics retain the first primitive failure and never inspect a thrown object"
    (lambda ()
      (let* ((env (get globalThis.process :env)) (key "ELISCRIPT_PROJECT_ALLOCATOR_DIAGNOSTIC")
             (present (Object/hasOwn env key)) (previous (get env key))
             (sink (get globalThis.console :error)) (records (js-array))
             (status 0) (source-class 0) (getter-reads 0) (original (js-object))
             (exports (js-object
               "value-source-invoke-with-this" (lambda (&rest args) 0)
               "last-error" (lambda () status)
               "value-exception-class" (lambda (heap) source-class)
               "value-exception-class-set" (lambda (heap value) (setq source-class value))
               "value-error-restore" (lambda (value) (setq status value))
               "value-kind" (lambda (heap value) (setq status 0 source-class 0) (if (= value 40) 35 3))
               "value-length" (lambda (&rest args) 0)
               "value-source-own-descriptor" (lambda (heap value key)
                 (setq status 3 source-class 2) (throw original))
               "value-source-object-keys" (lambda (heap value) (setq status 1 source-class 0) 0))))
        (Object/defineProperty original "message" (js-object :get
          (lambda () (setq getter-reads (1+ getter-reads)) (throw false))))
        (Object/defineProperty exports "value-object-copy" (js-object :get
          (lambda () (setq getter-reads (1+ getter-reads)) (throw false))))
        (try
          (put env key "1")
          (put globalThis.console :error (lambda (tag text)
            (js-call assert :strictEqual tag "[managed-export-failure]")
            (js-call records :push (JSON/parse text))))
          (let ((actual (js-call host :managedHostInvokeDiagnosticExports exports)))
            (let ((caught false))
              (try (js-call actual "value-source-own-descriptor" 1 40 41)
                (catch error (setq caught t) (js-call assert :strictEqual error original)))
              (js-call assert :strictEqual caught t))
            (js-call assert :strictEqual status 3)
            (js-call assert :strictEqual source-class 2)
            (js-call assert :deepStrictEqual (aref records 0)
              (js-object :phase "value-source-own-descriptor" :heap 1 :receiver 40 :receiverKind 35
                :key 41 :keyKind 3 :lastError 3 :sourceClass 2 :threw t))
            (js-call assert :strictEqual (js-call actual "value-source-object-keys" 1 40) 0)
            (js-call assert :strictEqual status 1)
            (js-call assert :strictEqual (js-length records) 1)
            (js-call assert :strictEqual getter-reads 0))
          ;; A failing sink cannot replace even an undefined thrown value.
          (put exports "value-source-own-descriptor" (lambda (&rest args)
            (setq status 3 source-class 2) (throw undefined)))
          (put globalThis.console :error (lambda (&rest args) (throw false)))
          (let ((actual (js-call host :managedHostInvokeDiagnosticExports exports)) (caught false))
            (try (js-call actual "value-source-own-descriptor" 1 40 41)
              (catch error (setq caught t) (js-call assert :strictEqual error undefined)))
            (js-call assert :strictEqual caught t)
            (js-call assert :strictEqual status 3)
            (js-call assert :strictEqual source-class 2))
          (finally (put globalThis.console :error sink)
            (if present (put env key previous) (Reflect/deleteProperty env key)))))))

  (test "FIX43 native prototype reflection retains owned identity and dynamic foreign effects"
    (js-object :timeout 300000)
    (async ()
      (let* ((fixture (await (canonical-fixture)))
             (runtime (await (instantiateManagedRuntimeWithHostModules (get fixture :bytes) (options))))
             (roots (js-array)) (api (canonical-api runtime roots))
             (original (Object/getOwnPropertyDescriptor globalThis.Object "getPrototypeOf"))
             (native (get original :value)) (marker (js-object :marker t)) (reads 0) (calls 0))
        (try
          (let ((value (js-call api :ordinary)))
            (js-call assert :strictEqual (js-call api :prototypeOf value) (get globalThis.Object :prototype))
            (Object/defineProperty globalThis.Object "getPrototypeOf"
              (js-object :configurable t :get (lambda ()
                (setq reads (1+ reads))
                (lambda (receiver) (setq calls (1+ calls)) marker))))
            (js-call assert :strictEqual (js-call api :prototypeOf value) marker)
            (js-call assert :strictEqual reads 1)
            (js-call assert :strictEqual calls 1)
            (Object/defineProperty globalThis.Object "getPrototypeOf" original)
            (let* ((failure (Object/freeze (js-object :first t))) (traps 0)
                   (proxy (new globalThis.Proxy (js-object)
                     (js-object :getPrototypeOf (lambda (target) (setq traps (1+ traps)) (throw failure))))))
              (js-call assert :throws (lambda () (js-call api :prototypeOf proxy)) (lambda (error) (eq error failure)))
              (js-call assert :strictEqual traps 1))
            (let ((foreign (Object/create marker)))
              (js-call assert :strictEqual (js-call api :prototypeOf foreign) (Reflect/apply native undefined (js-array foreign)))))
          (finally
            (Object/defineProperty globalThis.Object "getPrototypeOf" original)
            (canonical-close runtime roots))))))

  (test "source capability diagnostics retain late raw context and preserve the original throw and error registers"
    (lambda ()
      (let* ((env (get globalThis.process :env)) (key "ELISCRIPT_PROJECT_ALLOCATOR_DIAGNOSTIC")
             (prior (get env key)) (present (Object/hasOwn env key))
             (memory (js-object)) (status 0) (class 0) (gets 0) (failure (js-object))
             (exports (js-object
               "last-error" (lambda () status)
               "value-exception-class" (lambda (heap) class)
               "value-error-restore" (lambda (value) (setq status value))
               "value-exception-class-set" (lambda (heap value) (setq class value))
               "value-get" (lambda (heap args index) (setq status 0 class 0) (+ args index))
               "value-kind" (lambda (heap value) (setq status 0 class 0) (if (= value 90) 14 35))
               "value-length" (lambda (heap value) (setq status 0 class 0) 2))))
        (Object/defineProperty failure "message" (js-object :get (lambda () (setq gets (1+ gets)) "unread")))
        (try
          (put env key "1")
          (let ((observe (createManagedSourceOperationObserver exports 1 memory)) (index 0))
            (while (< index 40)
              (funcall observe 4 (+ 100 index) (lambda () 90))
              (setq index (1+ index)))
            (let ((window (readManagedSourceOperationDiagnostics memory)))
              (js-call assert :strictEqual (js-length window) 32)
              (js-call assert :strictEqual (get (aref window 31) :ordinal) 40)
              (js-call assert :strictEqual (get (aref window 31) :outputLength) 2))
            (try
              (funcall observe 5 200 (lambda () (setq status 11 class 4) (throw failure)))
              (catch error (js-call assert :strictEqual error failure)))
            (js-call assert :strictEqual status 11)
            (js-call assert :strictEqual class 4)
            (js-call assert :strictEqual gets 0)
            (let* ((window (readManagedSourceOperationDiagnostics memory)) (last (aref window 31)))
              (js-call assert :strictEqual (get last :ordinal) 41)
              (js-call assert :strictEqual (get last :receiver) 201)
              (js-call assert :strictEqual (get last :key) 202)
              (js-call assert :strictEqual (get last :threw) t)
              (js-call assert :strictEqual (get last :lastError) 11)))
          (finally (if present (put env key prior) (Reflect/deleteProperty env key)))))))

)
