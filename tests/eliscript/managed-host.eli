  (test "actual native Object inspection retains cold source descriptors and foreign effects without growing the original canonical graph"
    (async ()
      (let* ((compiler (get shared-backend :compiler))
             (program (js-call compiler :compile_ir_string native-inspection-source "native-inspection.eli"))
             (before (globalThis.structuredClone program))
             (reference (await (loadReference (resolve directory "native-inspection-reference.mjs")
               (js-call compiler :emit_ir_string program))))
             (actual (js-call (get shared-backend :managed) :lower_managed_program program shared-runtime t nil nil nil nil nil nil nil t))
             (bytes (globalThis.Uint8Array.from (js-call (get shared-backend :wasm) :append_metadata_section
               (js-call (get shared-backend :wasm) :emit_typed_memory_wasm (get actual :typed))
               "eliscript-managed-control" (JSON/stringify (get actual :descriptor)))))
             (runtimes (js-array (await (instantiateManagedRuntimeWithHostModules bytes (options))))))
        (js-call assert :deepStrictEqual program before)
        (exercise-native-inspection reference)
        (when native-target
          (let ((path (resolve directory (if (= native-target "arm64-macos") "native-inspection.dylib" "native-inspection.so"))))
            (await (writeFile path (globalThis.Uint8Array.from (js-call (get shared-backend :native)
              :emit_typed_native_memory_library (get actual :typed) native-target))))
            (js-call runtimes :push (await (instantiateNativeManagedRuntime path actual
              (Object/assign (options) (js-object :nativeTarget native-target)))))))
        (js-call runtimes :forEach (lambda (runtime)
          (let ((roots (js-array)) (api (js-object)))
            (try
              (js-call runtime :auto 1)
              (js-call (Object/keys reference)
                :forEach (lambda (name) (let ((raw (js-call runtime :getExport name)))
                  (js-call roots :push raw) (put api name (js-call runtime :toHostValue raw)))))
              (exercise-native-inspection api)
              ;; Returning a host array here would re-publish every nested
              ;; source value during internal species copies.
              (let ((constructor (js-call runtime :fromHostValue globalThis.Array)) (created undefined))
                (try
                  (js-call (js-array "constructorResult" "constructorReflectResult") :forEach (lambda (name)
                    (setq created (js-call runtime :invoke name (js-array constructor)))
                    (js-call assert :strictEqual (get created :kind) 14 name)
                    (js-call runtime :release created) (setq created undefined)))
                  (finally
                    (unless (undefined? created) (js-call runtime :release created))
                    (js-call runtime :release constructor))))
              (finally (canonical-close runtime roots)))))))))

