               "   (when (undefined? (read key receiver)) (setq count (1+ count)))"
               "   (when (undefined? (get receiver key)) (setq count (1+ count))))"
               "   (setq index (1+ index))) count))"
               "(export make read inherit through scan)") :join "\n"))
             (program (js-call (get shared-backend :compiler) :compile_ir_string source "canonical-get-receiver.eli"))
