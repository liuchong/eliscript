(module tests.persistent-vector-copy
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:module" createRequire)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" root buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (defvar directory undefined) (defvar bytes undefined)
  (defvar native-path undefined) (defvar lowered undefined) (defvar reference undefined)
  (defconst native-available (and (= (get globalThis.process :arch) "arm64")
    (or (= (get globalThis.process :platform) "darwin") (= (get globalThis.process :platform) "linux"))))
  (defconst options (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve root "_worktree/vector-copy-"))))
    (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
           (source (await (readFile (resolve root "stdlib/persistent-vector.eli") "utf8")))
           (end (js-call source :lastIndexOf ")"))
           (fixture (await (readFile (resolve root "tests/fixtures/persistent-vector-copy.eli") "utf8")))
           (combined (str (js-call source :slice 0 end) "\n" fixture "\n)"))
           (program (js-call (get backend :compiler) :compile_ir_string
             combined "persistent-vector-copy.eli"))
           (saved (JSON/stringify program))
           (runtime (js-call (get backend :compiler) :compile_ir_string
             (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli")))
      (setq lowered (js-call (get backend :managed) :lower_managed_program program runtime))
      (setq bytes (globalThis.Uint8Array.from
        (js-call (get backend :wasm) :append_metadata_section
          (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed))
          "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
      (when native-available
        (let ((target (if (= (get globalThis.process :platform) "darwin") "arm64-macos" "arm64-linux")))
          (setq native-path (resolve directory (if (= target "arm64-macos") "copy.dylib" "copy.so")))
          (await (writeFile native-path (globalThis.Uint8Array.from
            (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) target))))))
      (let ((source-path (resolve directory "copy-source.eli")) (js-path (resolve directory "copy-reference.mjs")))
        (await (writeFile source-path combined))
        (let ((result (spawnSync (resolve root "bin/eliscript-seed")
                (js-array "--output" js-path source-path) (js-object :cwd root :encoding "utf8"))))
          (js-call assert :strictEqual (get result :status) 0 (get result :stderr)))
        (setq reference (funcall (createRequire js-path) js-path)))
      (js-call assert :strictEqual (JSON/stringify program) saved)
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array)))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defun read (a value)
    (cond ((and value (= (get value :kind) 4)) (js-call a :readNumber value))
      ((and value (= (get value :kind) 5)) (js-call a :readString value))
      ((and value (= (get value :kind) 14)) (Array/from (js-object :length (js-call a :length value)) (lambda (ignored index)
        (let ((item (js-call a :get value index))) (try (read a item) (finally (js-call a :release item))))))) (t value)))
  (defun finish (a) (js-call a :closeModule) (js-call a :collect)
    (js-call assert :strictEqual (js-call a :live) 0) (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))
  (defconst small-cases (js-array
    (js-array 0 0 0 -1 (js-array) (js-array))
    (js-array 1 0 0 -1 (js-array 1) (js-array 0))
    (js-array 2 0 0 -1 (js-array 2 1) (js-array 0 1))
    (js-array 3 0 0 -1 (js-array 3 2 1) (js-array 0 1 2))
    (js-array 0 1 0 -1 (js-array 99) (js-array))
    (js-array 0 1 2 -1 (js-array undefined undefined 99) (js-array))
    (js-array 1 1 0 -1 (js-array 99) (js-array))
    (js-array 1 1 1 -1 (js-array 1 99) (js-array 0))
    (js-array 1 1 3 -1 (js-array 1 undefined undefined 99) (js-array 0))
    (js-array 2 1 0 -1 (js-array 99 2) (js-array 1))
    (js-array 2 1 1 -1 (js-array 1 99) (js-array 0))
    (js-array 2 1 2 -1 (js-array 1 2 99) (js-array 0 1))
    (js-array 2 1 4 -1 (js-array 1 2 undefined undefined 99) (js-array 0 1))
    (js-array 3 1 1 -1 (js-array 1 99 3) (js-array 0 2))
    (js-array 0 2 0 -1 (js-array) (js-array))
    (js-array 1 2 0 -1 (js-array) (js-array))
    (js-array 2 2 0 -1 (js-array 1) (js-array 0))
    (js-array 3 2 0 -1 (js-array 1 2) (js-array 0 1))
    (js-array 4 2 0 -1 (js-array 1 2 3) (js-array 0 1 2))
    (js-array 1 0 0 0 "marker" (js-array 0))
    (js-array 2 0 0 0 "marker" (js-array 0))
    (js-array 2 0 0 1 "marker" (js-array 0 1))
    (js-array 2 1 0 1 "marker" (js-array 1))
    (js-array 2 1 1 0 "marker" (js-array 0))
    (js-array 3 2 0 1 "marker" (js-array 0 1))
    (js-array 2 1 0 0 (js-array 99 2) (js-array 1))
    (js-array 2 2 0 1 (js-array 1) (js-array 0))
    (js-array 3 2 0 2 (js-array 1 2) (js-array 0 1))
    (js-array 1 1 0 0 (js-array 99) (js-array))))
  (defun check-small-copy (a item)
    (let* ((arguments (js-call item :slice 0 4))
           (expected (js-array (aref item 4) (aref item 5) t t)))
      (if (not a)
        (js-call assert :deepStrictEqual (Reflect/apply (get reference :vector_small_copy) reference arguments) expected)
        (let ((inputs (js-call arguments :map (lambda (value) (js-call a :number value)))) (out undefined))
          (try
            (setq out (js-call a :invoke "vector-small-copy" inputs))
            (js-call assert :deepStrictEqual (read a out) expected (JSON/stringify arguments))
            (finally
              (when out (js-call a :release out))
              (js-call inputs :forEach (lambda (value) (js-call a :release value)))))))))
  (defasync small-copy-target (target)
    (let ((a (if (= target "javascript") nil
               (if (= target "wasm") (instantiateManagedRuntime bytes options)
                 (await (instantiateNativeManagedRuntime native-path lowered options))))))
      (try
        (when a (js-call a :auto 1))
        (js-call small-cases :forEach (lambda (item) (check-small-copy a item)))
        (let ((expected (js-array t t t t t t t t t t t)))
          (if (not a)
            (js-call assert :deepStrictEqual (js-call reference :vector_small_copy_values) expected)
            (let ((out (js-call a :invoke "vector-small-copy-values")))
              (try (js-call assert :deepStrictEqual (read a out) expected)
                (finally (js-call a :release out))))))
        (finally
          (when a (try (finish a) (finally (when (get a :close) (js-call a :close)))))))))
  (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (target)
    (let ((register (if (and (= target "native") (not native-available)) (get test :skip) test)))
      (funcall register (str "small Vector copies preserve all 29 original getter error and data-slot cases on " target)
        (async () (await (small-copy-target target)))))))
  (test "vector conversion retains trie boundaries metadata fresh dense data arrays and the original source under collecting GC"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes options)))
        (js-call a :auto 1)
        (try
          (js-call (js-array 0 1 31 32 33 1057) :forEach (lambda (count)
            (let* ((input (js-call a :number count)) (out (js-call a :invoke "vector-copy-summary" (js-array input)))
                   (original (Array/from (js-object :length count) (lambda (ignored index) index))) (changed (js-call original :slice)))
              (when (> count 0) (put changed 0 -99))
              (try (js-call assert :deepStrictEqual (read a out)
                (js-array changed original t count (if (> count 0) 0 nil) false (if (> count 0) (js-array t t t t false) (js-array))))
                (finally (js-call a :release out) (js-call a :release input)))
              (js-call a :collect) (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))))
          (finally (finish a))))))
  (test "vector copy helpers read original indices once in order skip the replacement slot and preserve the first thrown identity"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes options)))
        (js-call a :auto 1)
        (try
          (js-call (js-array (js-array 0 -1 (js-array (js-array 3 2 1) (js-array 0 1 2)))
                            (js-array 1 -1 (js-array (js-array 1 99 3) (js-array 0 2)))
                            (js-array 2 -1 (js-array (js-array 1 2) (js-array 0 1)))
                            (js-array 0 1 (js-array "marker" (js-array 0 1)))
                            (js-array 1 2 (js-array "marker" (js-array 0 2)))
                            (js-array 2 0 (js-array "marker" (js-array 0)))) :forEach (lambda (item)
            (let* ((operation (js-call a :number (aref item 0))) (failing (js-call a :number (aref item 1)))
                   (out (js-call a :invoke "vector-copy-read-order" (js-array operation failing))))
              (try (js-call assert :deepStrictEqual (read a out) (aref item 2))
                (finally (js-call a :release out) (js-call a :release operation) (js-call a :release failing))))))
          (finally (finish a))))))
  (test "vector copying creates own data slots even when an inherited numeric setter would throw"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes options)))
        (js-call a :auto 1)
        (try
          (let ((out (js-call a :invoke "vector-copy-inherited-setter")))
            (try (js-call assert :deepStrictEqual (read a out) (js-array (js-array 1 99) t t))
              (finally (js-call a :release out))))
          (finally (finish a)))))))
