(module tests.direct-wasm-reflection-page
  (import "eliscript-test/compiler" compile_ir_string emit_ir_string)
  (import "eliscript-test/managed" emit_managed_wasm)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./direct-wasm-error-profile.mjs" assertDirectReflectionProfile)
  (import "/oracle.mjs" :as reference)
  (defun check (value label) (unless value (throw (new globalThis.Error label))))
  (defun read (a value)
    (cond ((and value (= (get value :kind) 4)) (js-call a :readNumber value))
          ((and value (= (get value :kind) 5)) (js-call a :readString value))
          ((and value (= (get value :kind) 14))
            (let ((out (js-array)) (index 0))
              (while (< index (js-call a :length value))
                (let ((item (js-call a :get value index)))
                  (try (js-call out :push (read a item)) (finally (js-call a :release item))))
                (setq index (1+ index))) out)) (t value)))
  (defun same (actual expected label)
    (if (Array/isArray expected)
      (progn
        (check (and (Array/isArray actual) (= (js-length actual) (js-length expected))) (str label " length"))
        (let ((index 0))
          (while (< index (js-length expected))
            (same (aref actual index) (aref expected index) (str label " " index))
            (setq index (1+ index)))))
      (check (Object/is actual expected) label)))
  (defun observe-host-error (profile)
    (let ((keys (get profile :hostKeys)) (names (get profile :hostNames)) (fields (js-array)))
      ;; Keep the independent host's complete shape, including fields outside
      ;; the declared Eliscript Error profile. No host key is filtered away.
      (same keys (Object/keys globalThis.Error) "complete host Error keys")
      (same names (Object/getOwnPropertyNames globalThis.Error) "complete host Error names")
      (js-call names :forEach (lambda (name)
        (let* ((descriptor (Object/getOwnPropertyDescriptor globalThis.Error name))
               (value (get globalThis.Error name nil))
               (reading (js-call reference :read_report 3 name))
               (description (js-call reference :descriptor_report 3 name)))
          (check descriptor (str "host Error descriptor " name))
          (same reading (js-array (value-type value) t
            (if (= (value-type value) "function") (js-array (get value :name) (get value :length))
              (if (and value (= (value-type value) "object"))
                (js-array (Object/is value (get globalThis.Error :prototype))) value)))
            (str "host Error read " name))
          (same description (js-array (get descriptor :enumerable) (get descriptor :configurable)
            (Object/hasOwn descriptor "writable") (get descriptor :writable)
            (Object/hasOwn descriptor "get") (Object/hasOwn descriptor "set")
            (Object/hasOwn descriptor "value") (value-type (get descriptor :value))
            (Object/is (get descriptor :value) value)) (str "host Error descriptor " name))
          (js-call fields :push (js-object :name name :read reading :descriptor description)))))
      (console/log (str "eliscript browser phase: Error host interoperability "
        (JSON/stringify (js-object :completeOwnKeys keys :completeOwnNames names
          :outsideDeclaredProfile (get profile :hostExtensions) :fields fields))))))
  (defun runDirectReflectionBrowser (input)
    (let* ((fixture (get input :fixture))
           (program (compile_ir_string (get fixture :source) (get fixture :filename)))
           (runtime (compile_ir_string (get input :runtime) "runtime.eli"))
           (frozen (JSON/stringify program))
           (bytes (globalThis.Uint8Array.from (emit_managed_wasm program runtime))))
      (check (= (emit_ir_string program) (get fixture :javascript)) "Seed JS parity")
      (check (= (JSON/stringify program) frozen) "immutable IR")
      (check (= (js-length (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes))) 0) "zero imports")
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (letfn ((call (name &rest supplied)
                  (let* ((arguments (if (> (js-length supplied) 0) (aref supplied 0) (js-array)))
                         (out (js-call a :invoke name arguments)))
                    (try (read a out) (finally (js-call a :release out))))))
          (try
            (let ((mode 0))
              (while (< mode 5)
                (let ((n (js-call a :number mode)))
                  (try
                    (js-call (js-array "isFinite" "missing" "name" "length" "prototype") :forEach
                      (lambda (name)
                        (let ((key (js-call a :string name)))
                          (try
                            (same (call "read-report" (js-array n key)) (js-call reference :read_report mode name) "builtin read")
                            (same (call "has" (js-array n key)) (js-call reference :has mode name) "builtin has")
                            (same (call "descriptor-report" (js-array n key)) (js-call reference :descriptor_report mode name) "builtin descriptor")
                            (finally (js-call a :release key))))))
                    (let ((profile (assertDirectReflectionProfile mode
                            (call "keys" (js-array n)) (call "names" (js-array n))
                            (js-call reference :keys mode) (js-call reference :names mode))))
                      (when (= mode 3) (observe-host-error profile)))
                    (same (call "symbols-report" (js-array n)) (js-call reference :symbols_report mode) "builtin symbols")
                    (same (call "prototype-report" (js-array n)) (js-call reference :prototype_report mode) "builtin prototype")
                    (finally (js-call a :release n))))
                (js-call a :collect)
                (setq mode (1+ mode))))
            (let ((mode (js-call a :number 5)))
              (try
                (js-call (js-array "kind" "isFinite") :forEach (lambda (name)
                  (let ((key (js-call a :string name)))
                    (try
                      (same (call "read" (js-array mode key)) (js-call reference :read 5 name) "ordinary missing read")
                      (same (call "has" (js-array mode key)) (js-call reference :has 5 name) "ordinary missing own")
                      (same (call "descriptor" (js-array mode key)) (js-call reference :descriptor 5 name) "ordinary missing descriptor")
                      (finally (js-call a :release key))))))
                (finally (js-call a :release mode))))
            (let ((text (js-call a :string "12")) (number (js-call a :number 2))
                  (builtin (js-call a :number 0)) (key (js-call a :string "isFinite")) (index 0))
              (try
                (while (< index 4)
                  (same (call "has" (js-array builtin key)) (js-call reference :has 0 "isFinite") "builtin supported own")
                  (same (call "cached") (js-call reference :cached) "cached identity")
                  (same (call "call-number" (js-array text)) (js-call reference :call_number "12") "Number call")
                  (same (call "call-string" (js-array number)) (js-call reference :call_string 2) "String call")
                  (same (call "call-finite" (js-array number)) (js-call reference :call_finite 2) "first-class finite")
                  (same (call "static-finite" (js-array number)) (js-call reference :static_finite 2) "static finite")
                  (same (call "call-symbol") (js-call reference :call_symbol) "Symbol call")
                  (same (call "call-error") (js-call reference :call_error) "Error call")
                  (same (call "effects") (js-call reference :effects) "argument effects")
                  (js-call a :collect) (setq index (1+ index)))
                (finally (js-call (js-array text number builtin key) :forEach (lambda (value) (js-call a :release value))))))
            ;; This public global remains outside the supported source builtin
            ;; surface; retain a real refusal after the reflection positives.
            (let ((refused false))
              (try
                (emit_managed_wasm (compile_ir_string
                  "(defun unsupported () globalThis.WeakRef) (export unsupported)" "unsupported-weakref.eli") runtime)
                (catch error
                  (setq refused (and (get error :eliscriptDiagnostic)
                    (= (get (get error :eliscriptDiagnostic) :phase) "managed-backend")
                    (js-call (get error :message) :includes "unknown managed local: globalThis.WeakRef")))))
              (check refused "unsupported WeakRef is rejected"))
            (finally
              (js-call a :closeModule) (js-call a :collect)
              (check (and (= (js-call a :live) 0) (= (get (js-call a :stats) :frameDepth) 0)) "root cleanup")))))
      (Array/from bytes)))
  (put globalThis.globalThis :__eliscriptDirectReflectionCase runDirectReflectionBrowser)
  (export runDirectReflectionBrowser))
