(module tests.managed-reference-node
  (import "node:module" registerHooks)
  (import "node:fs" mkdirSync mkdtempSync writeFileSync rmSync readFileSync)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "../../tools/backends/build.mjs" root)
  (defvar directory undefined)
  (defconst prefix "data:text/javascript;base64,")
  (defconst files (new globalThis.Map))
  (defun referenceFileURL (specifier)
    (if (or (/= (value-type specifier) "string") (not (js-call specifier :startsWith prefix))) specifier
      (let* ((encoded (js-call specifier :slice (js-length prefix)))
             (bytes (js-call Buffer :from encoded "base64")))
        (unless (= (js-call bytes :toString "base64") encoded)
          (throw (new globalThis.TypeError "managed reference requires the exact canonical generated module bytes")))
        (let ((digest (js-call (js-call (createHash "sha256") :update bytes) :digest "hex")))
          (unless (js-call files :has digest)
            (unless directory
              (let ((base (resolve root ".eliscript-cache/test-fixtures")))
                (mkdirSync base (js-object :recursive t))
                (setq directory (mkdtempSync (resolve base "reference-node-")))))
            (let ((filename (resolve directory (str digest ".mjs"))))
              (writeFileSync filename bytes (js-object :flag "wx"))
              (unless (= (js-call (js-call (createHash "sha256") :update (readFileSync filename)) :digest "hex") digest)
                (throw (new globalThis.TypeError "managed reference file bytes differ from the original generated module")))
              (js-call files :set digest (get (pathToFileURL filename) :href))))
          (js-call files :get digest)))))
  (registerHooks (js-object :resolve (lambda (specifier context nextResolve)
    (funcall nextResolve (referenceFileURL specifier) context))))
  (js-call globalThis.process :once "exit" (lambda () (when directory (rmSync directory (js-object :recursive t :force t))))))
