(module tests.bootstrap-compiler-fixture
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync writeFileSync mkdirSync)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/testing/fixture-environment.mjs" prepareFixtureEnvironment)
  (import "../tools/testing/bootstrap-compiler-fixture.mjs" bootstrapCompilerFunctionalArguments)
  (defconst title "portable compiler driver reaches a reproducible fixed point")
  (test "only the exact authenticated full portable compiler case separates its original deadline under both explicit functional flags"
    (lambda ()
      (let* ((body (async () 42)) (arguments (js-array title body 30000))
             (environment (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1" :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small")))
        (js-call (js-array (js-object) (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1")
          (js-object :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small")) :forEach (lambda (env)
            (js-call assert :strictEqual (bootstrapCompilerFunctionalArguments root env arguments) arguments)))
        (let ((selected (bootstrapCompilerFunctionalArguments root environment arguments)))
          (js-call assert :notStrictEqual selected arguments)
          (js-call assert :deepStrictEqual arguments (js-array title body 30000))
          (js-call assert :deepStrictEqual selected (js-array title body 0))
          (js-call assert :strictEqual (aref selected 1) body))
        (js-call (js-array (js-array "another compiler case" body 30000) (js-array title body 29999)
          (js-array title body 30000 "extra") (js-array title nil 30000)) :forEach (lambda (original)
            (js-call assert :strictEqual (bootstrapCompilerFunctionalArguments root environment original) original)))
        (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
               (directory (get fixture :directory)) (archive (resolve directory "tests/bootstrap-compiler-test-legacy.mjs")))
          (try
            (mkdirSync (resolve directory "tests"))
            (writeFileSync archive (readFileSync (resolve root "tests/bootstrap-compiler-test-legacy.mjs")))
            (js-call assert :deepStrictEqual (bootstrapCompilerFunctionalArguments directory environment arguments) (js-array title body 0))
            (writeFileSync archive "changed original full bootstrap suite")
            (js-call assert :throws (lambda () (bootstrapCompilerFunctionalArguments directory environment arguments)) globalThis.TypeError)
            (finally (js-call fixture :close))))))))
