(module tests.direct-wasm-backend
  ;; Normal runners preload the installer before entry dependency linking.
  ;; This import reuses that installed module; the full archive is unchanged.
  (import "./helpers/direct-wasm-registration-install.mjs")
  (import "./direct-wasm-backend-test-ground.mjs")
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "./helpers/direct-wasm-affected.mjs" prepareDirectAffected)
  (test "builtin reflection profiles enforce raw bounds reuse buffers and allocate no managed roots"
    (async ()
      (let* ((state (await (prepareDirectAffected))) (backend (aref (get state :generations) 2))
             (program (js-call (get backend :compiler) :compile_ir_string (get state :runtime) "reflection-runtime.eli"))
             (bytes (globalThis.Uint8Array.from (js-call (get backend :wasm) :emit_memory_wasm program)))
             (module (new globalThis.WebAssembly.Module bytes))
             (e (get (new globalThis.WebAssembly.Instance module) :exports))
             (heap (js-call e "heap-new" 1024 32768 16777216))
             (view (new globalThis.DataView (get (get e :memory) :buffer))))
        (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports module) (js-array))
        (js-call assert :ok (> heap 0))
        (let ((before (js-call view :getUint32 0 t)))
          (js-call (js-array (js-array 77 2 10) (js-array 1 0 0) (js-array 1 129 129)
                            (js-array 1 2 1) (js-array 1 2 8193)) :forEach (lambda (arguments)
            (js-call assert :strictEqual (Reflect/apply (get e "runtime-builtin-property-order") e arguments) 0)
            (js-call assert :strictEqual (js-call e "last-error") 3)
            (js-call assert :strictEqual (js-call view :getUint32 0 t) before))))
        (js-call (js-array (js-array 1 56) (js-array 7 60) (js-array 25 64) (js-array 2 68)) :forEach (lambda (profile)
          (let ((pointer (js-call e "runtime-builtin-property-order" (aref profile 0) 2 10)))
            (setq view (new globalThis.DataView (get (get e :memory) :buffer)))
            (js-call assert :ok (> pointer 0))
            (js-call assert :strictEqual (js-call e "last-error") 0)
            (js-call assert :strictEqual (js-call view :getUint32 (aref profile 1) t) (- pointer 8))
            (js-call assert :strictEqual (js-call view :getUint32 (- pointer 8) t) 28)
            (js-call assert :strictEqual (js-call view :getUint32 (- pointer 4) t) 2)
            (let ((cursor (js-call view :getUint32 0 t)))
              (js-call assert :strictEqual (js-call e "runtime-builtin-property-order" (aref profile 0) 2 9) pointer)
              (js-call assert :strictEqual (js-call view :getUint32 0 t) cursor)))))
        (js-call assert :strictEqual (js-call e "heap-live" heap) 0))) 120000))
