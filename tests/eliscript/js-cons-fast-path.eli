(module tests.js-cons-fast-path
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (defvar directory undefined) (defvar bytes undefined)
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve root "_worktree/js-cons-fast-"))))
    (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
           (program (js-call (get backend :compiler) :compile_ir_string
             (await (readFile (resolve root "tests/fixtures/wasm-managed-js-cons-fast.eli") "utf8")) "js-cons-fast.eli"))
           (saved (JSON/stringify program))
           (runtime (js-call (get backend :compiler) :compile_ir_string
             (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli")))
      (setq bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime)))
      (js-call assert :strictEqual (JSON/stringify program) saved)
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array)))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defun read (a value)
    (cond ((and value (= (get value :kind) 4)) (js-call a :readNumber value))
      ((and value (= (get value :kind) 5)) (js-call a :readString value))
      ((and value (= (get value :kind) 14))
        (Array/from (js-object :length (js-call a :length value)) (lambda (ignored index)
          (let ((item (js-call a :get value index))) (try (read a item) (finally (js-call a :release item)))))))
      (t value)))
  (defun finish (a)
    (js-call a :closeModule) (js-call a :collect)
    (js-call assert :strictEqual (js-call a :live) 0)
    (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))
  (test "dense js-cons keeps exact shared identities and caller roots with bounded collections independent of tail length"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes)) (_ (js-call a :auto 1))
             (head (js-call a :number -0.0)) (caller (js-call a :frame 1)) (costs (js-array)))
        (js-call a :frameSet caller 0 head)
        (try
          (js-call (js-array 8 1024 8 1024) :forEach (lambda (length index)
            (when (= index 2)
              (let ((ignored (js-call a :invoke "dirty-unrelated"))) (js-call a :release ignored)))
            (let* ((values (Array/from (js-object :length length) (lambda (ignored index) (= (% index 2) 0))))
                   (tail (js-call a :sourceArray values)) (before (get (js-call a :stats) :collections))
                   (out (js-call a :invoke "prepend" (js-array head tail))))
              (js-call costs :push (- (get (js-call a :stats) :collections) before))
              (try
                (js-call assert :deepStrictEqual (read a out) (js-call (js-array -0.0) :concat values))
                (js-call assert :deepStrictEqual (read a tail) values)
                (js-call a :collect)
                (let ((first (js-call a :get out 0)) (held (js-call a :frameGet caller 0)))
                  (try
                    (js-call assert :ok (js-call a :keyEqual first head))
                    (js-call assert :ok (Object/is (js-call a :readNumber first) -0.0))
                    (js-call assert :ok (js-call a :keyEqual held head))
                    (finally (js-call a :release first) (js-call a :release held))))
                (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
                (finally (js-call a :release out) (js-call a :release tail))))))
          (js-call assert :ok (<= (aref costs 1) (+ (aref costs 0) 2)) "copying a longer dense tail must not collect per element")
          (js-call assert :ok (<= (aref costs 3) (+ (aref costs 2) 2)) "unrelated prototype mutations must retain the certified standard iterator copy")
          (finally (js-call a :leaveFrame caller) (js-call a :release head) (finish a))))))
  (test "js-cons preserves own properties holes custom prototypes getters real iterator overrides and first throws"
    (lambda ()
      (let ((expected (js-array (js-array false 1 2) (js-array false 1 2 undefined) (js-array false 1 2)
                       (js-array false 7) "marker" "TypeError" (js-array false 1 2) (js-array false) (js-array false 1 2 8)))
            (traces (js-array (js-array) (js-array) (js-array) (js-array "get-iterator" "iterator" "next" "next")
                      (js-array "get-iterator") (js-array) (js-array) (js-array "next-override") (js-array "get-index"))))
        (js-call expected :forEach (lambda (wanted mode)
          (let* ((a (instantiateManagedRuntime bytes)) (_ (js-call a :auto 1))
                 (trace (js-call a :sourceArray (js-array))) (index (js-call a :number mode))
                 (held (js-call a :number -0.0)) (caller (js-call a :frame 1)) (out undefined))
            (js-call a :frameSet caller 0 held)
            (try
              (setq out (js-call a :invoke "fallback" (js-array index trace)))
              (js-call assert :deepStrictEqual (read a out) wanted)
              (js-call assert :deepStrictEqual (read a trace) (aref traces mode))
              (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
              (let ((value (js-call a :frameGet caller 0)))
                (try (js-call assert :ok (Object/is (js-call a :readNumber value) -0.0))
                  (finally (js-call a :release value))))
              (finally (unless (undefined? out) (js-call a :release out))
                (js-call a :leaveFrame caller) (js-call a :release held) (js-call a :release index)
                (js-call a :release trace) (finish a)))))))))
  (test "js-cons refuses foreign and retired tails before changing caller roots and recovers with a fresh dense tail"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes)) (b (instantiateManagedRuntime bytes))
             (_ (js-call a :auto 1)) (head (js-call a :number -0.0))
             (foreign (js-call b :sourceArray (js-array t))) (retired (js-call a :sourceArray (js-array false)))
             (caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 head) (js-call a :release retired) (js-call a :collect)
        (try
          (js-call (js-array foreign retired) :forEach (lambda (tail)
            (js-call assert :throws (lambda () (js-call a :invoke "prepend" (js-array head tail)))
              (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0001")))
            (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)))
          (let* ((tail (js-call a :sourceArray (js-array t false)))
                 (out (js-call a :invoke "prepend" (js-array head tail))))
            (try (js-call assert :deepStrictEqual (read a out) (js-array -0.0 t false))
              (finally (js-call a :release out) (js-call a :release tail))))
          (finally (js-call a :leaveFrame caller) (js-call a :release head)
            (js-call b :release foreign) (finish a) (finish b)))))))
