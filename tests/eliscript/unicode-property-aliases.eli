(module tests.unicode-property-aliases
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/runtime/unicode-property-aliases.mjs" generatePropertyAliasSources packPropertyAliases compileGroundPropertyAliasDecisions)
  (test "maintained alias generation preserves the authenticated full ground data and emits only the portable value-type guard"
    (lambda ()
      (let* ((archive (readFileSync (resolve root "tools/runtime/unicode-property-aliases-ground.mjs")))
             (declaration (readFileSync (resolve root "tools/runtime/unicode-property-aliases.json") "utf8"))
             (data (JSON/parse declaration)) (snapshot (JSON/stringify data))
             (generated (generatePropertyAliasSources data))
             (packed (packPropertyAliases data))
             (original (readFileSync (resolve root "tests/fixtures/regexp-property-original-trie.eli") "utf8")))
        (js-call assert :strictEqual (js-call (js-call (createHash "sha256") :update archive) :digest "hex")
          "df86f646af51c434b0498dfd1d8a95294c036555d6b9750c2244e44e15e4eec3")
        (js-call assert :strictEqual (js-length (get data :records)) 1715)
        (js-call assert :deepStrictEqual (compileGroundPropertyAliasDecisions original) (get data :groundDecisions))
        (js-call assert :deepStrictEqual (generatePropertyAliasSources (globalThis.structuredClone data)) generated)
        (js-call assert :strictEqual (JSON/stringify data) snapshot)
        (js-call assert :strictEqual (readFileSync (resolve root "tools/runtime/unicode-property-aliases.json") "utf8") declaration)
        (js-call assert :ok (js-call (get generated :staticSource) :includes "(/= (value-type source) \"string\")"))
        (js-call assert :doesNotMatch (get generated :staticSource) (new globalThis.RegExp "\\(js\\*|typeof source"))
        (js-call (js-array (get generated :staticSource) (get generated :runtimeSource)) :forEach (lambda (source)
          (js-call assert :ok (js-call source :includes (get packed :literal)))
          (js-call assert :ok (js-call source :includes (get data :sourceSHA256)))
          (js-call assert :ok (js-call source :includes (get data :runtimeSourceSHA256)))
          (js-call assert :ok (js-call source :includes "Unicode-3.0"))))))))
