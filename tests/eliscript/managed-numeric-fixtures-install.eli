(module tests.managed-numeric-fixtures-install
  (import "bun:test" :as framework)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve basename)
  (import "node:child_process" :as processNamespace)
  (import "node:child_process" :default processes)
  (import "node:module" syncBuiltinESMExports)
  (import "../../tools/backends/build.mjs" :as build)
  (import "../../tools/testing/managed-fixture-repairs.mjs" managedReferenceChildArguments)
  (import "../../tools/testing/managed-numeric-fixtures.mjs" typedNumericOutputTitle assertTypedNumericOutput)
  (defconst original (Object/assign (js-object) framework))
  (defconst actual-build (Object/assign (js-object) build))
  (defconst actual-processes (Object/assign (js-object) processNamespace))
  (defconst root (get build :root))
  (defconst plans (js-array
    (js-object :suite "tests/wasm-managed-number-text.test.mjs" :kind "number-text" :sha256 "efb82a6a9f2457924f661ceaf8780412e4d2c80a983a535b7c066817a9f9e913")
    (js-object :suite "tests/wasm-managed-primitive-operators.test.mjs" :kind "primitive" :sha256 "35a423057162377838fdcd3a8a5ceec4634293fa5fe33450b39d4fafcfc48f22")))
  (defconst selected (js-call plans :filter (lambda (plan)
    (js-call (get globalThis.process :argv) :some (lambda (argument) (= (resolve root argument) (resolve root (get plan :suite))))))))
  (js-call assert :strictEqual (js-length selected) 1)
  (defconst plan (aref selected 0))
  (js-call assert :strictEqual (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root (get plan :suite)))) :digest "hex") (get plan :sha256))
  (defvar backend undefined) (defvar registrations 0)
  (defasync buildBackends (&rest arguments)
    (setq backend (await (Reflect/apply (get actual-build :buildBackends) actual-build arguments))) backend)
  (when (= (get plan :kind) "primitive")
    (js-call (get original :mock) :module (resolve root "tools/backends/build.mjs")
      (lambda () (Object/assign (js-object) actual-build (js-object :buildBackends buildBackends))))
    (let ((replacement (new globalThis.Proxy (get original :test) (js-object
      :get (lambda (target key receiver) (let ((value (Reflect/get target key target)))
        (if (= (value-type value) "function") (js-call value :bind target) value)))
      :apply (lambda (target receiver arguments)
        (let ((forwarded (js-call arguments :slice)))
          (when (= (aref arguments 0) typedNumericOutputTitle)
            (setq registrations (1+ registrations)) (js-call assert :strictEqual registrations 1)
            (put forwarded 1 (async () (await (assertTypedNumericOutput backend)))))
          (Reflect/apply target receiver forwarded)))))))
      (js-call (get original :mock) :module "bun:test" (lambda () (Object/assign (js-object) original (js-object :test replacement)))))
    (js-call original :beforeAll (lambda () (js-call assert :strictEqual registrations 1))))
  (defconst original-spawn (get processes :spawnSync))
  (defun spawnSync (command arguments &rest configuration)
    (let ((forwarded (if (= (basename command) "node")
      (managedReferenceChildArguments arguments (resolve root "tests/helpers/managed-reference-node.mjs")) arguments)))
      (Reflect/apply original-spawn processes (js-call (js-array command forwarded) :concat configuration))))
  (when (= (get plan :kind) "number-text")
    (put processes :spawnSync spawnSync) (syncBuiltinESMExports)
    (js-call (get original :mock) :module "node:child_process"
      (lambda () (Object/assign (js-object) actual-processes (js-object :default processes :spawnSync spawnSync)))))
  (js-call original :afterAll (lambda ()
    (put processes :spawnSync original-spawn) (syncBuiltinESMExports)
    (js-call (get original :mock) :module "node:child_process" (lambda () actual-processes))
    (js-call (get original :mock) :module "bun:test" (lambda () original))
    (js-call (get original :mock) :module (resolve root "tools/backends/build.mjs") (lambda () actual-build)))))
