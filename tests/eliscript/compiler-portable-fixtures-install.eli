(module tests.compiler-portable-fixtures-install
  (import "bun:test" :as tests)
  (import "./performance-acceptance.mjs" currentPerformanceTest)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "../../tools/backends/build.mjs" :as build)
  (import "../../tools/testing/compiler-portable-fixtures.mjs" adaptPortableManagedFixtures adaptNativeNodeMemoryCompiler portableReaderPressureTitle runPortableReaderRecovery)
  (import "../../tools/testing/native-node-fixtures.mjs" nativeBoundaryTitle nativePacketsTitle runNativeBoundary runNativePackets)
  (defconst original (Object/assign (js-object) build))
  (defconst original-tests (Object/assign (js-object) tests))
  (defconst mock (get original-tests :mock))
  (defvar normal-registered false)
  (defvar pressure-registrations 0)
  (defvar native-directory undefined)
  (defvar native-boundaries 0)
  (defvar native-packets 0)
  (defvar native-replacement undefined)
  (defconst native-skip-if (get (get original-tests :test) :skipIf))
  (defconst root (get original :root))
  (defconst plans (js-array
    (js-object :suite "tests/compiler-portable-predicates.test.mjs" :sha256 "4bbc319b83880938df01f3f952250b3a844f36975e4ad41edf7137122de6a894")
    (js-object :suite "tests/compiler-portable-reader.test.mjs" :sha256 "127bcc36ec328f1c6435904bc396347b32f744b943da4255af42e8ae7423198a")
    (js-object :suite "tests/native-node-memory.test.mjs" :sha256 "4949de1619237a588945486e5f40958a9e248582db8f438e8a08d9da590e041c")))
  (defconst selected (js-call plans :filter (lambda (plan)
    (js-call (get globalThis.process :argv) :some (lambda (argument) (= (resolve root argument) (resolve root (get plan :suite))))))))
  (js-call assert :strictEqual (js-length selected) 1)
  (defconst plan (aref selected 0))
  (js-call assert :strictEqual (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root (get plan :suite)))) :digest "hex") (get plan :sha256))
  (defasync buildBackends (&rest arguments)
    (let ((backend (await (Reflect/apply (get original :buildBackends) original arguments))))
      (when (= (get plan :suite) "tests/native-node-memory.test.mjs")
        (setq native-directory (get (aref arguments 0) :outputRoot)))
      (if (= (get plan :suite) "tests/native-node-memory.test.mjs") (adaptNativeNodeMemoryCompiler backend) (adaptPortableManagedFixtures backend))))
  (js-call mock :module (resolve root "tools/backends/build.mjs")
    (lambda () (Object/assign (js-object) original (js-object :buildBackends buildBackends))))
  (when (= (get plan :suite) "tests/native-node-memory.test.mjs")
    (let ((replacement (new globalThis.Proxy (get original-tests :test) (js-object
      :get (lambda (target key receiver)
        (if (= key "skipIf")
          (lambda (condition) (if condition (Reflect/apply native-skip-if target (js-array condition)) native-replacement))
          (let ((value (Reflect/get target key target))) (if (= (value-type value) "function") (js-call value :bind target) value))))
      :apply (lambda (target receiver arguments)
        (let ((forwarded (js-call arguments :slice)))
          (cond
            ((= (aref arguments 0) nativeBoundaryTitle)
              (setq native-boundaries (1+ native-boundaries))
              (put forwarded 1 (lambda () (runNativeBoundary native-directory))))
            ((= (aref arguments 0) nativePacketsTitle)
              (setq native-packets (1+ native-packets))
              (put forwarded 1 (lambda () (runNativePackets native-directory)))))
          (Reflect/apply target receiver forwarded)))))))
      (setq native-replacement replacement)
      (js-call mock :module "bun:test" (lambda () (Object/assign (js-object) original-tests (js-object :test replacement)))))
    (js-call original-tests :beforeAll (lambda ()
      (when (and (= (get globalThis.process :arch) "arm64")
                 (js-call (js-array "darwin" "linux") :includes (get globalThis.process :platform)))
        (js-call assert :strictEqual native-boundaries 1) (js-call assert :strictEqual native-packets 1)))))
  (when (= (get plan :suite) "tests/compiler-portable-reader.test.mjs")
    (let ((replacement (new globalThis.Proxy (get original-tests :test) (js-object
      :get (lambda (target key receiver)
        (let ((value (Reflect/get target key target))) (if (= (value-type value) "function") (js-call value :bind target) value)))
      :apply (lambda (target receiver arguments)
        (if (= (aref arguments 0) portableReaderPressureTitle)
          (progn
            (setq pressure-registrations (1+ pressure-registrations))
            (js-call assert :strictEqual pressure-registrations 1)
            (unless normal-registered
              (setq normal-registered t)
              (js-call original-tests :test "normal reader failure preserves caller roots stops state writeback and permits later scanning"
                (async () (await (runPortableReaderRecovery))) 300000))
            (Reflect/apply (currentPerformanceTest target) receiver arguments))
          (Reflect/apply target receiver arguments)))))))
      (js-call mock :module "bun:test" (lambda () (Object/assign (js-object) original-tests (js-object :test replacement)))))
    (js-call original-tests :beforeAll (lambda ()
      (js-call assert :strictEqual normal-registered t) (js-call assert :strictEqual pressure-registrations 1))))
  (js-call original-tests :afterAll (lambda ()
    (js-call mock :module (resolve root "tools/backends/build.mjs") (lambda () original))
    (js-call mock :module "bun:test" (lambda () original-tests)))))
