(module tests.eliscript-protocol
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir mkdtemp readFile rm symlink)
  (import "node:path" dirname resolve)
  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (defconst root (js-call globalThis.process :cwd))
  (defconst source (resolve root "stdlib/core/protocol.eli"))
  (defasync run (command environment)
    (let* ((child (globalThis.Bun.spawn command (js-object :cwd root
                    :env (Object/assign (js-object) (get globalThis.process :env)
                      (js-object :BUN (get globalThis.process :execPath)
                        :EMACS (get (get globalThis.process :env) :EMACS "emacs")) environment)
                    :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited)
                     (js-call (new globalThis.Response (get child :stdout)) :text)
                     (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (unless (= (aref result 0) 0)
        (throw (new globalThis.Error (or (js-call (aref result 2) :trim)
          (js-call (aref result 1) :trim) (+ (aref command 0) " exited with " (aref result 0))))))
      (aref result 1)))
  (defasync compile (compiler output environment)
    (await (mkdir (dirname output) (js-object :recursive t)))
    (await (run (js-array compiler "--source-map" "--output" output source) environment)))
  (defun canonical-map (text)
    (Object/assign (js-object) (JSON/parse text) (js-object :sources (js-array "<protocol-source>"))))
  (defconst expected
    (js-object
      :frozen (js-array t t t) :metadata (js-array t "read" t)
      :definition (js-object
        :value (js-object :format "eliscript-protocol-definition" :version 1 :name "Measured" :operations (js-array "read" "size"))
        :frozen (js-array t t)
        :restored (js-object :format "eliscript-protocol-definition" :version 1 :name "Measured" :operations (js-array "read" "size"))
        :isolated t :missingReason "missing")
      :dispatch (js-object :direct (js-array "direct:alpha" 5 t) :exact (js-array "exact:beta" 4 t)
        :category (js-array "category:remote" 0) :fallback (js-array "default:7" -1)
        :undefined (js-array "default:undefined" -1))
      :categories (js-array "null" "undefined" "number" "symbol" "function" "object")
      :invalidReason "invalid-direct-slot"
      :childError (js-object :code "ELI-RUNTIME-PROTOCOL" :protocol "Inheritance" :operation "read"
        :observedType "object:Child" :reason "missing")
      :atomic (js-object :message "protocol Atomic/right implementation must be a function"
        :leftInstalled false :accessorRead false :accessorMessage "protocol Atomic/left implementation must be a function")
      :arrays (js-object :values (js-array 1 3) :prototypePreserved t) :million 1000000))
  (test "Eliscript-authored protocol policy preserves open dispatch semantics"
    (async ()
      (let* ((base (resolve root ".eliscript-cache/test-fixtures"))
             (ignored (await (mkdir base (js-object :recursive t))))
             (directory (await (mkdtemp (resolve base "eliscript-protocol-"))))
             (bootstrap (resolve directory "bootstrap"))
             (seed-root (resolve directory "seed")) (self-root (resolve directory "self-hosted"))
             (seed (resolve seed-root "stdlib/core/protocol-impl.mjs"))
             (self (resolve self-root "stdlib/core/protocol-impl.mjs"))
             (committed-path (resolve root "runtime/core/protocol-impl.mjs")))
        (try
          (await (Promise/all (js-array
            (mkdir seed-root (js-object :recursive t)) (mkdir self-root (js-object :recursive t)))))
          (await (Promise/all (js-array
            (symlink (resolve root "runtime") (resolve seed-root "runtime") "dir")
            (symlink (resolve root "runtime") (resolve self-root "runtime") "dir"))))
          (await (compile (resolve root "bin/eliscript") seed (js-object)))
          (await (seedCompilerFixture bootstrap))
          (await (compile (resolve root "bin/eliscript-portable") self
            (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrap)))
          (let* ((generated (await (readFile seed "utf8")))
                 (committed (await (readFile committed-path "utf8"))))
            (js-call assert :strictEqual (await (readFile self "utf8")) generated)
            (js-call assert :strictEqual (await (readFile (+ self ".map") "utf8"))
              (await (readFile (+ seed ".map") "utf8")))
            (js-call assert :strictEqual generated committed)
            (js-call assert :deepStrictEqual (canonical-map (await (readFile (+ seed ".map") "utf8")))
              (canonical-map (await (readFile (+ committed-path ".map") "utf8"))))
            (js-call (js-array "function define_protocol(name, operations)"
              "function define_protocol_from_definition(definition)" "function protocol_definition(protocol)")
              :forEach (lambda (text) (js-call assert :ok (js-call generated :includes text))))
            ;; The immutable module binding now has a TDZ guard. Its actual
            ;; WeakMap allocation remains required; storage spelling is private.
            (js-call assert :match generated (new globalThis.RegExp "(?:const|var) protocol_states = new (?:globalThis\\.)?WeakMap\\(\\)"))
            (js-call (js-array "Runtime.defineProtocol" "Runtime.extendProtocol" "vite" "react")
              :forEach (lambda (text) (js-call assert :strictEqual (js-call generated :includes text) false))))
          (let ((facade (await (readFile (resolve root "runtime/core/protocol.mjs") "utf8"))))
            (js-call assert :ok (js-call facade :includes "from \"./protocol-impl.mjs\""))
            (js-call assert :ok (js-call facade :includes "from \"./protocol-error.mjs\""))
            (js-call assert :strictEqual (js-call facade :includes "new WeakMap") false)
            (js-call assert :strictEqual (js-call facade :includes "function dispatch") false))
          (let ((reports (js-array)) (paths (js-array seed self committed-path)) (index 0))
            (while (< index (js-length paths))
              (let ((hosts (js-array (get globalThis.process :execPath)
                            (get (get globalThis.process :env) :NODE_BINARY "node"))) (host-index 0))
                (while (< host-index (js-length hosts))
                  (js-call reports :push (JSON/parse (await (run (js-array (aref hosts host-index)
                    (resolve root "tests/fixtures/eliscript-protocol-host.mjs") (aref paths index)) (js-object)))))
                  (setq host-index (1+ host-index))))
              (setq index (1+ index)))
            (js-call reports :forEach (lambda (report)
              (js-call assert :deepStrictEqual report (aref reports 0))
              (js-call assert :deepStrictEqual report expected))))
          (let ((map (JSON/parse (await (readFile (+ seed ".map") "utf8")))))
            (js-call assert :ok (js-call (aref (get map :sourcesContent) 0) :includes
              "(defun external-method (state record receiver)"))
            (js-call assert :ok (js-call (aref (get map :sourcesContent) 0) :includes
              "(defun dispatch (protocol record receiver arguments)")))
          (finally (await (rm directory (js-object :recursive t :force t))))))) 90000)
)
