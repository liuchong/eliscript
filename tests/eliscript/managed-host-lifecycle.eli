(module tests.managed-host-lifecycle
  (import "node:test" test before after)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../tools/backends/build.mjs" root buildBackends)
  (import "../tools/backends/managed-host-lifecycle.mjs" createManagedHostRuntimeWithLifecycle)
  (import "../tools/backends/managed-module-graph.mjs" createManagedModuleGraph)
  (import "../tools/backends/managed-host.mjs" createManagedHostCapabilityBridge createManagedHostRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)

  ;; This small ABI model proves only notification lifetime/error ordering.
  ;; The real compiled project below and the unchanged complete sequence/nth
  ;; suites remain the independent execution evidence for actual programs.
  (defun model (&optional configuration)
    (let* ((options (if (nullish? configuration) (js-object) configuration))
           (code 0) (source-class 0) (owner 64) (ready false) (closed 0)
           (handler undefined) (roots (new globalThis.Map)) (tuples (new globalThis.Map))
           (events (js-array)) (releases (js-array))
           (buffer (new globalThis.ArrayBuffer 1024)) (view (new globalThis.DataView buffer))
           (bridge (Object/freeze (js-object
             :attach (lambda (value) (setq handler value))
             :dispatch (lambda (name heap arguments) (funcall handler name heap arguments))
             :close (lambda () (setq closed (1+ closed))))))
           (exports (js-object
             :heap-new (lambda (slots initial maximum) owner)
             :last-error (lambda () code)
             :value-error-restore (lambda (failure) (setq code failure) 0)
             :value-exception-class (lambda (heap) (setq code 0) source-class)
             :value-exception-class-set (lambda (heap kind) (setq code 0 source-class kind) 1)
             :value-kind (lambda (heap raw) (setq code 0)
               (cond ((js-call tuples :has raw) 7) ((and (>= raw 4) (< raw 100)) 4) (t (setq code 1) 0)))
             :value-length (lambda (heap raw) (setq code 0) 4)
             :value-get (lambda (heap raw index) (setq code 0) (if (= index 0) (get (js-call tuples :get raw) :opcode) 3))
             :value-data (lambda (heap raw kind) (setq code 0) (* raw 8))
             :heap-pin (lambda (heap raw) (setq code 0)
               (js-call roots :set raw (1+ (get (js-call tuples :get raw) :pins 0)))
               (put (js-call tuples :get raw) :pins (js-call roots :get raw)) 1)
             :heap-release (lambda (heap raw) (setq code 0)
               (js-call releases :push raw)
               (let ((tuple (js-call tuples :get raw)))
                 (put tuple :pins (1- (get tuple :pins 0)))
                 (when (< (get tuple :pins) 0) (throw (new globalThis.Error "unbalanced root release"))))
               (when (get options :cleanupFailure false) (setq code 2)) 1)))
           (make-tuple (lambda (raw operation value)
             (let ((opcode (- raw 100)))
               (js-call view :setFloat64 (* opcode 8) operation t)
               (js-call tuples :set raw (js-object :opcode opcode :value value :pins 0)) raw)))
           (first (funcall make-tuple 118 18 (js-object :first t)))
           (second (funcall make-tuple 119 18 (lambda () undefined)))
           (other (funcall make-tuple 120 1 (funcall globalThis.Symbol "ordinary operation"))))
      (put exports "__eliscript_project_prepare" (lambda (heap)
        (when (get options :wrongOwner false)
          (js-call bridge :dispatch "source-operation" (1+ heap) first))
        (js-call bridge :dispatch "source-operation" heap first)
        (js-call assert :strictEqual (js-length events) 0)
        (js-call assert :strictEqual (get (js-call tuples :get first) :pins) 1)
        (js-call bridge :dispatch "source-operation" heap other)
        (js-call bridge :dispatch "source-operation" heap second)
        (when (Object/hasOwn options "prepareThrow") (throw (get options :prepareThrow)))
        (when (get options :rawFailure false) (setq code 1 source-class 2))
        (when (get options :rawPending false) (setq code 11 source-class 0))
        (setq ready t) 1))
      (when (get options :omitPrepare false) (Reflect/deleteProperty exports "__eliscript_project_prepare"))
      (let* ((original-prepare (get exports "__eliscript_project_prepare"))
             (lifecycle (js-object :capabilityBridge bridge))
             (creator (lambda (received descriptor memory supplied local)
               (when (get options :cloneLifecycle false)
                 (setq local (Object/create (Object/getPrototypeOf local) (Object/getOwnPropertyDescriptors local))))
               (let ((heap (js-call received "heap-new" 1024 65536 1048576)))
                 (js-call (get local :capabilityBridge) :attach (lambda (name actual raw)
                   (unless (= actual heap) (throw (new globalThis.TypeError "original owner mismatch")))
                   (let ((tuple (js-call tuples :get raw)))
                     (when (= (js-call view :getFloat64 (* (get tuple :opcode) 8) t) 18)
                       (js-call assert :strictEqual ready t "notification decoder must not enter before prepare finishes")
                       (when (Object/hasOwn options "replayThrow") (throw (get options :replayThrow)))
                       (when (get options :replayRawFailure false) (setq code 1 source-class 2)))
                     (js-call events :push raw)) 3))
                 (put local :dispose (lambda () (js-call bridge :close)))
                 (Object/freeze (js-object :close (lambda () (js-call local :dispose)) :prepare (lambda ()
                   (let ((result (js-call received "__eliscript_project_prepare" heap)))
                     (when (/= code 0)
                       (cond ((= code 11) (throw (get options :pendingThrow)))
                         ((= source-class 2) (throw (new globalThis.TypeError "original source failure")))
                         (t (throw (new globalThis.Error "original raw failure"))))) result)))))))
             (runtime (createManagedHostRuntimeWithLifecycle creator exports nil
                        (js-object :view (lambda () view)) (js-array (js-object) lifecycle))))
        (js-object :runtime runtime :events events :tuples tuples :first first :second second :other other
          :exports exports :originalPrepare original-prepare :releases releases :lifecycle lifecycle
          :dispatch (lambda (name heap raw) (js-call bridge :dispatch name heap raw))
          :closed (lambda () closed)))))

  (test "raw opcode 18 notifications wait for actual prepare completion while other operations remain synchronous and FIFO roots balance"
    (lambda ()
      (let* ((state (model)) (tuples (get state :tuples)))
        (js-call assert :strictEqual (js-call (get state :runtime) :prepare) 1)
        (js-call assert :deepStrictEqual (get state :events)
          (js-array (get state :other) (get state :first) (get state :second)))
        (js-call assert :strictEqual (get (get state :exports) "__eliscript_project_prepare") (get state :originalPrepare))
        (js-call assert :deepStrictEqual (get state :releases) (js-array (get state :first) (get state :second)))
        (js-call tuples :forEach (lambda (tuple) (js-call assert :strictEqual (get tuple :pins) 0)))
        (js-call (get state :lifecycle) :dispose)
        (js-call assert :strictEqual (funcall (get state :closed)) 1))))

  (test "prepare and replay preserve false undefined and object first failures over root cleanup without replaying unpublished values"
    (lambda ()
      (js-call (js-array false undefined (js-object :original t)) :forEach (lambda (failure)
        (js-call (js-array "prepareThrow" "replayThrow") :forEach (lambda (stage)
          (let* ((options (js-object :cleanupFailure t)) (failed false) (actual undefined))
            (put options stage failure)
            (let ((state (model options)))
              (try (js-call (get state :runtime) :prepare) (catch error (setq failed t actual error)))
              (js-call assert :strictEqual failed t)
              (js-call assert :strictEqual actual failure)
              (js-call (get state :tuples) :forEach (lambda (tuple) (js-call assert :strictEqual (get tuple :pins) 0)))
              (js-call assert :deepStrictEqual (get state :events) (js-array (get state :other)))))))))))

  (test "original numeric error and TypeError class survive deferred root cleanup at prepare and replay boundaries"
    (lambda ()
      (js-call (js-array "rawFailure" "replayRawFailure") :forEach (lambda (stage)
        (let ((options (js-object :cleanupFailure t)))
          (put options stage t)
          (let ((state (model options)))
            (js-call assert :throws (lambda () (js-call (get state :runtime) :prepare))
              (lambda (error) (and (js-call globalThis.TypeError globalThis.Symbol.hasInstance error)
                                  (= (get error :message) "original source failure"))))
            (js-call (get state :tuples) :forEach (lambda (tuple) (js-call assert :strictEqual (get tuple :pins) 0)))))))))

  (test "pending raw source throws remain owned by the original caller over deferred cleanup and preserve every thrown value"
    (lambda ()
      (js-call (js-array false undefined (js-object :original t)) :forEach (lambda (failure)
        (let* ((state (model (js-object :rawPending t :pendingThrow failure :cleanupFailure t)))
               (thrown false) (actual undefined))
          (try (js-call (get state :runtime) :prepare) (catch error (setq thrown t actual error)))
          (js-call assert :strictEqual thrown t)
          (js-call assert :strictEqual actual failure)
          (js-call assert :deepStrictEqual (get state :events) (js-array (get state :other)))
          (js-call (get state :tuples) :forEach (lambda (tuple) (js-call assert :strictEqual (get tuple :pins) 0))))))))

  (test "ordinary creators retain exact omitted undefined and null tails and their first descriptor error without raw API changes"
    (lambda ()
      (js-call (js-array (js-array) (js-array undefined) (js-array nil)) :forEach (lambda (tail)
        (let* ((failure (js-object :original t)) (exports (Object/freeze (js-object)))
               (descriptor (Object/freeze (js-object))) (memory (Object/freeze (js-object)))
               (creator (lambda (&rest received)
                 (js-call assert :deepStrictEqual received (js-call (js-array exports descriptor memory) :concat tail))
                 (throw failure))))
          (js-call assert :throws (lambda ()
            (createManagedHostRuntimeWithLifecycle creator exports descriptor memory tail))
            (lambda (error) (eq error failure))))))))

  (test "wrong owners retain the original capability rejection and successful prepare can be observed again without queued roots"
    (lambda ()
      (let ((state (model)))
        (js-call assert :throws (lambda () (funcall (get state :dispatch) "source-operation" 65 (get state :first)))
          (lambda (error) (and (js-call globalThis.TypeError globalThis.Symbol.hasInstance error)
                              (= (get error :message) "original owner mismatch"))))
        (js-call assert :strictEqual (get (js-call (get state :tuples) :get (get state :first)) :pins) 0)
        (js-call assert :strictEqual (js-call (get state :runtime) :prepare) 1)
        (js-call assert :strictEqual (funcall (get state :dispatch) "source-operation" 64 (get state :first)) 3)
        (js-call assert :strictEqual (get (js-call (get state :tuples) :get (get state :first)) :pins) 0))
      (let ((state (model (js-object :wrongOwner t))))
        (js-call assert :throws (lambda () (js-call (get state :runtime) :prepare))
          (lambda (error) (and (js-call globalThis.TypeError globalThis.Symbol.hasInstance error)
                              (= (get error :message) "original owner mismatch"))))
        (js-call assert :strictEqual (js-length (get state :releases)) 0))))

  (test "nested private lifecycle views observe the factory's later dispose hook for both project and ordinary runtimes"
    (lambda ()
      (js-call (js-array false t) :forEach (lambda (omit-prepare)
        (let* ((state (model (js-object :cloneLifecycle t :omitPrepare omit-prepare)))
               (lifecycle (get state :lifecycle)) (original (get lifecycle :dispose)) (observed 0))
          (js-call assert :strictEqual (value-type original) "function")
          (js-call assert :strictEqual (Object/hasOwn (Object/getOwnPropertyDescriptor lifecycle "dispose") "value") t)
          (put lifecycle :dispose (lambda () (setq observed (1+ observed)) (funcall original)))
          (js-call (get state :runtime) :close)
          (js-call assert :strictEqual observed 1)
          (js-call assert :strictEqual (funcall (get state :closed)) 1)
          (js-call assert :deepStrictEqual (get state :releases) (js-array)))))))

  (defvar directory undefined)
  (defvar backend undefined)
  (defvar bytes undefined)
  (defvar lowered undefined)
  (defconst native-target (when (= (get globalThis.process :arch) "arm64")
    (cond ((= (get globalThis.process :platform) "darwin") "arm64-macos")
          ((= (get globalThis.process :platform) "linux") "arm64-linux"))))
  (defvar native-path undefined)
  (before (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-host-prepare-lifecycle-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (let* ((compiler (get backend :compiler))
           (runtime (js-call compiler :compile_ir_string (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
           (adapter (js-call compiler :compile_ir_string (str
             "(defvar ready false) (defvar current nil)\n"
             "(defun literal-kind (value) (unless ready (throw false)) nil)\n"
             "(defun literal-export-value (value) value) (defun literal-import-value (value) value)\n"
             "(defun read-ready () ready)\n"
             "(defconst initialized (progn (setq current (js-object :slot (funcall globalThis.Symbol \"first\")))"
             " (setq current (lambda () -0.0)) (setq ready t) nil))\n"
             "(export current ready read-ready literal-kind literal-export-value literal-import-value)") "lifecycle-adapter.eli"))
           (value (js-call compiler :compile_ir_string
             "(import \"../../stdlib/managed-literals.mjs\" current ready read-ready) (export current ready read-ready)" "lifecycle-value.eli"))
           (main (js-call compiler :compile_ir_string
             "(import \"eliscript/runtime/core/value.mjs\" current ready) (print \"lifecycle-ready\") (defun result () (js-array (current) ready)) (export result)" "lifecycle-main.eli")))
      (setq lowered (js-call (get backend :managed) :lower_managed_project
        (js-array (js-object :id "main.mjs" :program main)) "main.mjs" runtime
        (js-object :phased t :literalModules (js-array
          (js-object :id "stdlib/managed-literals.mjs" :program adapter)
          (js-object :id "runtime/core/value.mjs" :program value)))))
      (setq bytes (globalThis.Uint8Array.from (js-call (get backend :wasm) :emit_typed_memory_wasm
        (get lowered :typed) (js-object :initialPages 2 :maximumPages 256))))
      (when native-target
        (setq native-path (resolve directory (if (= native-target "arm64-macos") "lifecycle.dylib" "lifecycle.so")))
        (await (writeFile native-path (globalThis.Uint8Array.from
          (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target)))))))
    (js-object :timeout 120000))
  (after (async () (when directory (await (rm directory (js-object :recursive t :force t))))))

  (defun lifecycle-options (graph logs)
    (js-object :initializeModule false :moduleGraph graph :maxSlots 1024 :initialBytes 65536 :maxBytes 1048576
      :console (js-object :log (lambda (&rest values) (js-call logs :push values)))))

  (defun exercise-project (runtime graph logs)
    (let ((primary false))
      (try
        (js-call graph :attachRuntime runtime)
        (js-call assert :throws (lambda () (js-call graph :read 0 0)) globalThis.ReferenceError)
        (js-call runtime :auto 1)
        (js-call graph :prepare)
        (js-call assert :deepStrictEqual logs (js-array))
        (js-call (get (get (get lowered :descriptor) :project) :modules) :forEach (lambda (module)
          (js-call (get module :steps) :forEach (lambda (step) (js-call graph :step (get step :run))))))
        (let ((value (js-call runtime :invoke "result")))
          (try
            (let ((number (js-call runtime :get value 0)) (ready (js-call runtime :get value 1)))
              (try
                (js-call assert :strictEqual (Object/is (js-call runtime :readNumber number) -0.0) t)
                (js-call assert :strictEqual ready t)
                (js-call runtime :collect)
                (js-call assert :strictEqual (Object/is (js-call runtime :readNumber number) -0.0) t)
                (finally (js-call runtime :release number) (js-call runtime :release ready))))
            (finally (js-call runtime :release value))))
        (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
        (js-call assert :deepStrictEqual logs (js-array (js-array "lifecycle-ready")))
        (catch error (setq primary t) (throw error))
        (finally
          (let ((failed false) (failure undefined))
            (js-call (js-array (lambda () (js-call runtime :closeModule))
                        (lambda () (js-call runtime :collect))
                        (lambda () (js-call assert :strictEqual (js-call runtime :live) 0)))
              :forEach (lambda (cleanup)
                (try (funcall cleanup) (catch error (unless failed (setq failed t failure error))))))
            (when (and failed (not primary)) (throw failure)))))))

  (test "real WASM prepare keeps function and Symbol notifications opaque until its actual later initializer is ready"
    (lambda ()
      (let* ((descriptor (get lowered :descriptor)) (graph (createManagedModuleGraph descriptor))
             (logs (js-array)) (options (lifecycle-options graph logs)) (bridge (createManagedHostCapabilityBridge descriptor options))
             (imports (js-object :eliscript.host (js-object)))
             (lifecycle (js-object :capabilityBridge bridge))
             (module (new globalThis.WebAssembly.Module bytes))
             (declared (get descriptor :hostCapabilities))
             (creator-called false))
        (js-call assert :ok (Array/isArray declared))
        (js-call assert :ok (js-call declared :some (lambda (capability) (= (get capability :name) "source-operation"))))
        (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports module)
          (js-call declared :map (lambda (capability)
            (js-object :module (get capability :module) :name (get capability :name) :kind "function"))))
        (js-call (get descriptor :hostCapabilities) :forEach (lambda (capability)
          (put (get imports "eliscript.host") (get capability :name)
            (lambda (heap arguments) (js-call bridge :dispatch (get capability :name) heap arguments)))))
        (let* ((exports (get (new globalThis.WebAssembly.Instance module imports) :exports))
               (memory (js-object
                 :view (lambda () (new globalThis.DataView (get (get exports :memory) :buffer)))
                 :readBytes (lambda (offset length)
                   (js-call (new globalThis.Uint8Array (get (get exports :memory) :buffer) offset length) :slice))
                 :writeBytes (lambda (offset values)
                   (js-call (new globalThis.Uint8Array (get (get exports :memory) :buffer) offset (js-length values)) :set values))))
               (_restore (js-call assert :strictEqual (value-type (get exports "value-error-restore")) "function"))
               (_raw-fail (js-call assert :strictEqual (Object/hasOwn exports "fail") false))
               (creator (lambda (received description owned-memory &rest tail)
                 (setq creator-called t)
                 (js-call assert :notStrictEqual received exports "the actual exports must enter the lifecycle bridge rather than its compatibility fallback")
                 (js-call assert :notStrictEqual (get received "__eliscript_project_prepare") (get exports "__eliscript_project_prepare"))
                 (Reflect/apply createManagedHostRuntime undefined
                   (js-call (js-array received description owned-memory) :concat tail))))
               (runtime (createManagedHostRuntimeWithLifecycle creator exports descriptor memory
                          (js-array options lifecycle))))
          (js-call assert :strictEqual creator-called t)
          (exercise-project runtime graph logs)))))

  (test "real native prepare preserves the same deferred notification initialization and collection contract"
    (js-object :skip (not native-target))
    (async ()
      (let* ((graph (createManagedModuleGraph (get lowered :descriptor))) (logs (js-array))
             (runtime (await (instantiateNativeManagedRuntime native-path lowered (lifecycle-options graph logs)))))
        (exercise-project runtime graph logs))))
)
