(module tests.wire-default-node
  (import "node:assert/strict" :default assert)
  (import "../../bootstrap/host/bun.mjs" loadCompiler)
  (defasync main ()
    (let* ((directory (aref (get globalThis.process :argv) 2))
           (requests (JSON/parse (aref (get globalThis.process :argv) 3)))
           (module (await (loadCompiler directory))) (results (js-array)))
      (js-call requests :forEach (lambda (request)
        (if (= (get request :kind) "key-collection")
          (progn
            (js-call (get request :cases) :forEach (lambda (input)
              (let ((expected (js-call input :flatMap (lambda (item)
                      (if (and (not (eq item nil)) (= (value-type item) "object") (not (Array/isArray item)))
                        (Object/keys item) (js-array)))))
                    (actual (js-call module :flat_object_keys input)))
                (js-call assert :deepStrictEqual actual expected) (js-call results :push actual))))
            (let ((sparse (new globalThis.Array 3)))
              (put sparse 0 (js-object :a 1)) (put sparse 2 (js-object :b 2))
              (js-call assert :deepStrictEqual (js-call module :flat_object_keys sparse) (js-array "a" "b"))
              (js-call results :push (js-array "a" "b"))))
        (let ((prefix (js-call (new globalThis.Array (get request :required)) :fill nil))
              (count (get request :optional)))
          (js-call (js-array "omitted" "undefined" "nil" "false") :forEach (lambda (mode)
            (let ((arguments (js-call prefix :slice)))
              (unless (= mode "omitted")
                (Reflect/apply (get arguments :push) arguments
                  (js-call (new globalThis.Array count) :fill
                    (cond ((= mode "undefined") undefined) ((= mode "nil") nil) (t false)))))
              (js-call results :push (Reflect/apply (get module (get request :name)) undefined arguments)))))))))
      (unless (js-call requests :some (lambda (request) (= (get request :kind) "key-collection")))
        (js-call assert :strictEqual (js-length results) (* 4 (js-length requests))))
      (js-call globalThis.process.stdout :write (str (JSON/stringify results) "\n"))))
  (js-call (main) :catch (lambda (error)
    (js-call globalThis.console :error error) (put globalThis.process :exitCode 1))))
