(module tests.compiler-corpus-identity-host
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:fs/promises" readFile)
  (import "../dist/bootstrap/compiler.mjs" compile-ir-string)
  (import "../tools/backends/compiler-corpus-identity-host.mjs" identityOracleLaunch helperAPI identityHostCompletionThen)
  (test "identity host completion waits for original work and exposes a nonthenable helper API without replacing first failures"
    (async ()
      (let* ((release undefined) (finished false)
             (pending (new globalThis.Promise (lambda (resolve reject) (setq release resolve))))
             (result (new globalThis.Promise (lambda (resolve reject)
               (identityHostCompletionThen pending resolve reject)))))
        (js-call result :then (lambda (value) (setq finished t)))
        (await (Promise/resolve))
        (js-call assert :strictEqual finished false)
        (funcall release "original complete")
        (js-call assert :strictEqual (await result) helperAPI)
        (js-call assert :strictEqual (get helperAPI :then) undefined)
        (js-call assert :strictEqual (get helperAPI :identityOracleLaunch) identityOracleLaunch))
      (let ((failures (js-array (Object/freeze (new globalThis.Error "original identity failure")) false undefined))
            (index 0))
        (while (< index (js-length failures))
          (let* ((first (aref failures index))
                 (pending (Promise/reject first))
                 (result (new globalThis.Promise (lambda (resolve reject)
                   (identityHostCompletionThen pending resolve reject))))
                 (caught false))
            (try (await result)
              (catch error (setq caught t) (js-call assert :strictEqual error first)))
            (js-call assert :strictEqual caught t))
          (setq index (1+ index))))
      (let ((source (await (readFile (resolve "tools/backends/eliscript/compiler-corpus-identity-host.eli") "utf8"))))
        (js-call assert :ok (compile-ir-string source "tools/backends/eliscript/compiler-corpus-identity-host.eli")))))
  (test "identity independent oracle retains original args and authenticated functional policy without selected context"
    (lambda ()
      (let* ((root (resolve ".")) (host (resolve root "tools/backends/compiler-corpus-identity-host.mjs"))
             (path (resolve root "independent/main.mjs"))
             (context (js-object :directory root :caseId "identity:original" :target "wasm"
               :sourceIdentity (js-object :sha256 "retained") :options (js-object :functionalRuntimeProfile "small")))
             (preload (get (pathToFileURL (resolve root "tools/backends/compiler-corpus-host-context.mjs")) :href))
             (environment (js-object :NODE "original-node" :BUN "original-bun"
               :NODE_OPTIONS (str "--trace-warnings --import=" preload)
               :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT "selected.json" :ELISCRIPT_ORIGINAL_TARGET "wasm"))
             (before (JSON/stringify environment)))
        (js-call (js-array "node" "bun") :forEach (lambda (engine)
          (let* ((launch (identityOracleLaunch engine path root host context environment)) (options (get launch :options)))
            (js-call assert :strictEqual (get launch :command) (str "original-" engine))
            (js-call assert :deepStrictEqual (js-call (get launch :args) :slice -3) (js-array host "--observe" path))
            (js-call assert :strictEqual (get (get options :policy) :originalDeadlineMs) 30000)
            (js-call assert :strictEqual (get (get options :policy) :effectiveDeadlineMs) nil)
            (js-call assert :strictEqual (get (get options :env) :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT) undefined)
            (js-call assert :strictEqual (get (get options :env) :ELISCRIPT_ORIGINAL_TARGET) undefined)
            (js-call assert :strictEqual (get (get options :env) :NODE_OPTIONS) "--trace-warnings")
            (js-call assert :strictEqual (get options :sourceIdentity) (get context :sourceIdentity))
            (js-call assert :strictEqual (get options :directory) (resolve root (str "identity-oracle-" engine))))))
        (js-call assert :strictEqual (JSON/stringify environment) before))))
  (test "identity oracle strict profile keeps its original 30000ms deadline"
    (lambda ()
      (let* ((root (resolve "."))
             (launch (identityOracleLaunch "node" "reference.mjs" root "host.mjs"
               (js-object :directory root :options (js-object)) (js-object))))
        (js-call assert :strictEqual (get (get (get launch :options) :policy) :effectiveDeadlineMs) 30000)))))
