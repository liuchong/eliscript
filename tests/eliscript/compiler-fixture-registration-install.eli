(module tests.compiler-fixture-registration-install
  (import "bun:test" :as framework)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "../../tools/backends/build.mjs" root)
  (import "./compiler-artifact-private-cases.mjs" artifactPrivateCases)
  (import "./compiler-metadata-private-cases.mjs" metadataPrivateCases)
  (import "./compiler-original-gates-cases.mjs" originalGateCases)
  (import "./compiler-build-private.mjs" closeCompilerBuildPrivateUnit)
  (defconst plans (js-array
    (js-object :suite "tests/compiler-artifact-archive-selfhosted.test.mjs" :archive "tests/compiler-artifact-archive-test-legacy.mjs" :sha256 "e423e56f00966d7239a4e54884827dc94a5f69813d3fae303ce743d2e0680705" :cases artifactPrivateCases)
    (js-object :suite "tests/compiler-metadata-codec-selfhosted.test.mjs" :archive "tests/compiler-metadata-codec-test-legacy.mjs" :sha256 "ca4ea14ad091edd2be8404e739b1aa54e19c48b3a257df526db5f8a609c3803d" :cases metadataPrivateCases)
    (js-object :suite "tests/compiler-matrix-original-gates-selfhosted.test.mjs" :archive "tests/compiler-matrix-original-gates-test-legacy.mjs" :sha256 "1835d53f92a916f31adaee5898e2c76efd6a8dfe772f1dff9016a11c281a301c" :cases originalGateCases)
  ))
  (defconst selected (js-call plans :filter (lambda (plan)
    (js-call (get globalThis.process :argv) :some (lambda (argument)
      (= (resolve root argument) (resolve root (get plan :suite))))))))
  (when (/= (js-length selected) 1)
    (throw (new globalThis.TypeError "compiler fixture registration requires exactly one declared suite")))
  (defconst plan (aref selected 0))
  (unless (= (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root (get plan :archive)))) :digest "hex") (get plan :sha256))
    (throw (new globalThis.TypeError "compiler fixture original suite source identity changed")))
  (defconst original (Object/assign (js-object) framework))
  (defconst counts (new globalThis.Map))
  (defconst replacements (get plan :cases))
  (defvar restored false)
  (defun restore ()
    (unless restored (js-call (get original :mock) :module "bun:test" (lambda () original)) (setq restored t)))
  (defconst replacement-test (new globalThis.Proxy (get original :test) (js-object
    :apply (lambda (target receiver arguments)
      (let ((title (aref arguments 0)))
        (if (Object/hasOwn replacements title)
          (let ((forwarded (js-call arguments :slice)))
            (when (js-call counts :has title) (throw (new globalThis.Error (+ "duplicate compiler fixture case: " title))))
            (js-call counts :set title 1)
            ;; Every original registration option and deadline is retained.
            (put forwarded 1 (get replacements title)) (Reflect/apply target receiver forwarded))
          (Reflect/apply target receiver arguments))))
    :get (lambda (target key receiver) (Reflect/get target key target)))))
  (defconst exports (Object/assign (js-object) original (js-object :test replacement-test)))
  (js-call original :beforeAll (lambda ()
    (try
      (js-call (Object/keys replacements) :forEach (lambda (title)
        (unless (= (js-call counts :get title) 1) (throw (new globalThis.Error (+ "missing compiler fixture case: " title))))))
      (finally (restore)))))
  (js-call original :afterAll (lambda () (restore) (closeCompilerBuildPrivateUnit)))
  (js-call (get original :mock) :module "bun:test" (lambda () exports)))
