              (let ((observe (lambda (fn)
                (let ((events (js-array)) (sentinel (js-object)) (message (js-object)))
                  (if (= mode "ordinary")
                    (progn (put message :toString (lambda () (js-call events :push "toString") "text"))
                           (put message :valueOf (lambda () (js-call events :push "valueOf") 7)))
                    (put message globalThis.Symbol.toPrimitive (lambda (hint)
                      (js-call events :push hint) (when (= mode "throws") (throw sentinel))
                      (if (= mode "invalid") (js-object) "text"))))
                  (let ((error (capture fn (js-array message "file.eli"))))
                    (js-object :events events :kind (if (Object/is error sentinel) "sentinel" (get (get error :constructor) :name))
                      :message (get error :message) :retained (Object/is (field (get error :eliscriptDiagnostic) "message") message)))))))
                (js-call assert :deepStrictEqual (funcall observe (aref pair 0)) (funcall observe (aref pair 1))))))
            (let* ((descriptor (Object/getOwnPropertyDescriptor globalThis.globalThis "Error"))
                   (returned (js-object)) (calls (js-array)) (Base globalThis.Error)
                   (Constructor (new globalThis.Proxy Base (js-object :construct (lambda (target args)
                     (js-call calls :push (aref args 0)) returned)))) (message (js-object)) (filename (js-array)))
              (try
                (Object/defineProperty globalThis.globalThis "Error" (js-object :configurable t :writable t :value Constructor))
                (js-call assert :strictEqual (capture (aref pair 0) (js-array message filename)) returned)
                (finally (Object/defineProperty globalThis.globalThis "Error" descriptor)))
              (js-call assert :strictEqual (aref calls 0) message)
              (js-call assert :strictEqual (get (get returned :eliscriptDiagnostic) :message) message)
              (js-call assert :strictEqual (get (get (get returned :eliscriptDiagnostic) :location) :file) filename))))))

    (test "retained transient diagnostic optional filename span getters and conversion failures follow the original order"
      (lambda ()
        (let ((actual (helper "transient-analysis" "transient-fail")))
          (arrow actual 3)
          (let ((observe (lambda (fn mode)
            (let ((events (js-array)) (sentinel (js-object)) (span (js-object)))
              (each (js-array (js-array "filename" "input.eli") (js-array "start" 1) (js-array "line" 2)
                             (js-array "column" 3) (js-array "end" 4) (js-array "endLine" 5) (js-array "endColumn" 6))
                (lambda (pair) (let ((name (aref pair 0)) (value (aref pair 1)))
                  (getter span name (lambda ()
                    (js-call events :push (+ "read." name))
                    (when (= mode (+ "read-" name)) (throw sentinel))
                    (if (js-call (js-array "filename" "line" "column") :includes name)
                      (conversion events name value mode sentinel) value))))))
              (let ((error (capture fn (js-array false span (conversion events "message" "bad" mode sentinel)))))
                (js-object :events events :name (if (Object/is error sentinel) "sentinel" (get (get error :constructor) :name))
                  :message (get error :message) :code (field (get error :eliscriptDiagnostic) "code")
                  :phase (field (get error :eliscriptDiagnostic) "phase"))))))
                (modes (js-array "normal")))
            (each (js-array "filename" "start" "line" "column" "end" "endLine" "endColumn")
              (lambda (name) (js-call modes :push (+ "read-" name))))
            (each (js-array "filename" "line" "column" "message") (lambda (name)
              (js-call modes :push (+ "convert-" name) (+ "symbol-" name))))
            (each modes (lambda (mode) (js-call assert :deepStrictEqual
              (funcall observe actual mode) (funcall observe original-transient mode)))))
