            (funcall observe original-transient)))))

    (test "retained formatter project and evaluation diagnostics preserve every original primitive filename message and arrow boundary"
      (lambda ()
        (let ((pairs (js-array
                (js-array (helper "formatter" "formatter-fail") (original-simple "ELI-F0001" "formatter" t) 2)
                (js-array (helper "project" "fail") (original-simple "ELI-B0003" "project-plan" false) 1)
                (js-array (helper "project" "project-request-fail") (original-simple "ELI-B0001" "project-build" false) 1)
                (js-array (helper "project" "project-configuration-fail") (original-simple "ELI-B0002" "project-config" t) 2)
                (js-array (helper "compiler" "evaluation-fail") (original-simple "ELI-E0001" "evaluation-request" t) 2)))
              (messages (js-array undefined nil false 0 -0 globalThis.NaN globalThis.Infinity "" (funcall globalThis.BigInt 1) "中😀\ud800" (funcall globalThis.Symbol "message")))
              (filenames (js-array undefined nil false t 0 -0 globalThis.NaN "" (funcall globalThis.BigInt 0) "输入😀.eli" (js-array) (js-object) (funcall globalThis.Symbol "file"))))
          (each pairs (lambda (pair)
            (arrow (aref pair 0) (aref pair 2))
            (each messages (lambda (message) (each filenames (lambda (filename)
              (let ((a (capture (aref pair 0) (js-array message filename))) (b (capture (aref pair 1) (js-array message filename))))
                (js-call assert :strictEqual (Object/getPrototypeOf a) (Object/getPrototypeOf b))
                (js-call assert :strictEqual (get a :message) (get b :message))
                (js-call assert :deepStrictEqual (get a :eliscriptDiagnostic) (get b :eliscriptDiagnostic))
                (when (get a :eliscriptDiagnostic)
                  (js-call assert :strictEqual (Object/is (get (get a :eliscriptDiagnostic) :message) message) t))))))))))))

