(module tests.compiler-host-scope
  (import "node:test" :as node-test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile rm)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:os" tmpdir)
  (import "node:module" createRequire)
  (import "node:child_process" spawnSync)
  (import "node:vm" :as vm)
  (import "../tools/backends/build.mjs" root buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime loadManagedHostModules)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "./helpers/managed-numeric-selfhosted.mjs" loadReference)
  (import "./compiler-producer-rig.mjs" stringifyCompilerInput producerProfiles)
  (import "./whole-compiler-rig.mjs" finishCompiler)

  ;; Retained cases from the mixed binary-compiler suites. This module never
  ;; compiles Reader/analyzer/lower/emitter/IR themselves to a binary. Only
  ;; their JS APIs and the original, independent user programs run here.
  (defvar directory nil)
  (defvar backend nil)
  (defvar runtime nil)
  (defvar prefix-program nil)
  (defvar prefix-bytes nil)
  (defvar prefix-reference nil)
  (defvar helpers (new globalThis.Map))
  (defconst node-mode (get (get globalThis.process :env) :ELISCRIPT_HOST_SCOPE_NODE))
  (defconst iterator-key globalThis.Symbol.iterator)
  (defconst native-apply Reflect/apply)
  (defconst native-array-from Array/from)

  (defun test (name body &optional timeout)
    (js-call node-test :test name (js-object :timeout (if (nullish? timeout) 5000 timeout)) body))

  (defun each (items action) (js-call items :forEach action))
  (defun original-iterate (items action)
    (let* ((iterator (funcall native-apply (get items iterator-key) items (js-array)))
           (next (get iterator :next)) (done false))
      (while (not done)
        (let ((step (funcall native-apply next iterator (js-array))))
          (unless (and step (= (value-type step) "object")) (throw (new globalThis.TypeError "iterator result is not an object")))
          (if (funcall globalThis.Boolean (get step :done)) (setq done t)
            (try (funcall action (get step :value))
              (catch error
                (try (let ((close (get iterator :return)))
                  (unless (nullish? close) (funcall native-apply close iterator (js-array)))) (catch ignored nil))
                (throw error))))))))
  (defun compiler () (get backend :compiler))
  (defun flatten (nodes)
    (js-call nodes :flatMap (lambda (node)
      (if (= (get node :kind) "module-declaration") (flatten (get node :children)) (js-array node)))))
  (defun read-value (a value)
    (cond
      ((and value (= (get value :kind) 4)) (js-call a :readNumber value))
      ((and value (= (get value :kind) 5)) (js-call a :readString value))
      ((and value (= (get value :kind) 14))
       (let ((out (js-array)) (index 0))
         (while (< index (js-call a :length value))
           (let ((child (js-call a :get value index)))
             (try (js-call out :push (read-value a child)) (finally (js-call a :release child))))
           (setq index (1+ index))) out))
      (t value)))
  (defun boxed (a value)
    (cond ((= (value-type value) "number") (js-call a :number value))
          ((= (value-type value) "string") (js-call a :string value)) (t value)))
  (defun release (a values) (each values (lambda (value) (js-call a :release value))))
  (defun finish (a &optional values)
    (unless (nullish? values) (release a values))
    (js-call a :closeModule) (js-call a :collect)
    (js-call assert :strictEqual (js-call a :live) 0)
    (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))
  (defun emit (program &optional memory-program)
    (let* ((saved (JSON/stringify program))
           (bytes (globalThis.Uint8Array.from
             (js-call (get backend :managed) :emit_managed_wasm program
               (if (nullish? memory-program) runtime memory-program)))))
      (js-call assert :strictEqual (JSON/stringify program) saved)
      (js-call assert :deepStrictEqual
        (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array)) bytes))
  (defasync user-fixture (source filename)
    (let* ((program (js-call (compiler) :compile_ir_string source filename))
           (bytes (emit program))
           (js (await (loadReference (resolve directory (+ filename ".mjs"))
                 (js-call (compiler) :emit_ir_string program)))))
      (js-object :program program :bytes bytes :js js :path (resolve directory (+ filename ".mjs")))))
  (defun instance (bytes &rest options)
    (let ((a (instantiateManagedRuntime bytes (if (> (js-length options) 0) (aref options 0) undefined))))
      (js-call a :auto 1) a))

  (defun vector-result (a name reference &optional arguments)
    (let* ((args (if (nullish? arguments) (js-array) arguments))
           (inputs (js-call args :map (lambda (value) (boxed a value))))
           (out (js-call a :invoke name inputs)))
      (try (js-call assert :deepStrictEqual (read-value a out)
             (Reflect/apply reference undefined args))
        (finally (release a (js-call inputs :concat (js-array out)))))))
  (defasync original-template (file title marker)
    (let* ((text (await (readFile (resolve root file) "utf8")))
           (start (js-call text :indexOf title))
           (begin (js-call text :indexOf marker start)))
      (js-call assert :ok (and (>= start 0) (>= begin start)) (+ file " original fixture locator"))
      (let* ((offset (+ begin (js-length marker))) (end (js-call text :indexOf "`;" offset)))
        (js-call assert :ok (> end offset))
        (js-call text :slice offset end))))
  (defun expose-source (source names filename)
    (let* ((program (js-call (compiler) :compile_ir_string source filename))
           (exported (new globalThis.Set)))
      (each (flatten (get program :body)) (lambda (node)
        (when (= (get node :kind) "export-declaration")
          (each (get node :children) (lambda (reference)
            (js-call exported :add (get reference :value)))))))
      (let ((private-names (js-call names :filter (lambda (name) (not (js-call exported :has name))))))
        (if (= (js-length private-names) 0) source
          (+ (js-call source :slice 0 (js-call source :lastIndexOf ")"))
             "\n(export " (js-call private-names :join " ") "))")))))
  (defasync expose (module-name names)
    (let* ((source (await (readFile (resolve root (+ "bootstrap/compiler/" module-name ".eli")) "utf8")))
           (exposed (expose-source source names (+ module-name ".eli")))
           (path (resolve directory "bootstrap" (+ module-name "-scope.mjs"))))
      (await (writeFile path (js-call (compiler) :compile_string exposed (+ module-name ".eli"))))
      (let ((loaded (await (loadManagedHostModules (js-object :hostModules
               (js-array (js-object :id "scope" :specifier path :referrer "scope.mjs"
                 :allowedExports (js-array) :namespace t)))
               (js-object :moduleBaseURL (pathToFileURL path))))))
        (let ((namespace (js-call loaded :get "scope")))
          (each names (lambda (name) (js-call helpers :set (+ module-name "/" name)
            (get namespace (js-call name :replaceAll "-" "_"))))) namespace))))
  (defasync load-reader-source (source name)
    (let* ((exposed (expose-source source (js-array "read-string-literal") "reader.eli"))
           (path (resolve directory "bootstrap" (+ name ".mjs"))))
      (await (writeFile path (js-call (compiler) :compile_string exposed "reader.eli")))
      (let ((loaded (await (loadManagedHostModules (js-object :hostModules
               (js-array (js-object :id "reader" :specifier path :referrer "reader.eli"
                 :allowedExports (js-array) :namespace t)))
               (js-object :moduleBaseURL (pathToFileURL path))))))
        (js-call loaded :get "reader"))))
  (defun helper (module-name name) (js-call helpers :get (+ module-name "/" name)))

  (defun capture (fn args)
    (let ((caught false) (value undefined))
      (try (Reflect/apply fn undefined args) (catch error (setq caught t value error)))
      (js-call assert :strictEqual caught t "expected the original error") value))
  (defun field (value key) (if (nullish? value) undefined (get value key)))
  (defun implicit-string (value) (js-call "" :concat value))
  (defun original-diagnostic (diagnostic)
    (let* ((point (get (get diagnostic :location) :start)) (Constructor globalThis.Error)
           (message (+ (implicit-string (get (get diagnostic :location) :file)) ":"
                       (implicit-string (get point :line)) ":" (implicit-string (get point :column)) ": "
                       (implicit-string (get diagnostic :message))))
           (error (new Constructor message)))
      (put error :eliscriptDiagnostic diagnostic) (throw error)))
  (defun original-simple (code phase location)
    (lambda (message filename)
      (let* ((error (new globalThis.Error message))
             (diagnostic (js-object :format "eliscript-diagnostic" :version 1 :code code
               :severity "error" :phase phase :message message)))
        (when (and location (funcall globalThis.Boolean filename))
          (put diagnostic :location (js-object :file filename)))
        (put error :eliscriptDiagnostic diagnostic) (throw error))))
  (defun original-transient (filename span message)
    (let* ((file (if (funcall globalThis.Boolean filename) filename
                   (let ((fallback (field span "filename")))
                     (if (funcall globalThis.Boolean fallback) fallback "<input>"))))
           (start (if (funcall globalThis.Boolean span)
                    (js-object :offset (get span :start) :line (get span :line) :column (get span :column))
                    (js-object :offset 0 :line 1 :column 1)))
           (end (if (funcall globalThis.Boolean span)
                  (js-object :offset (get span :end) :line (get span :endLine) :column (get span :endColumn))
                  (js-object :offset 0 :line 1 :column 1)))
           (diagnostic (js-object :format "eliscript-diagnostic" :version 1 :code "ELI-A0001"
             :severity "error" :phase "analysis" :message message :location (js-object :file file :start start :end end)))
           (Constructor globalThis.Error)
           (text (+ (implicit-string file) ":" (implicit-string (get start :line)) ":"
                    (implicit-string (get start :column)) ": " (implicit-string message)))
           (error (new Constructor text)))
      (put error :eliscriptDiagnostic diagnostic) (throw error)))
  (defun getter (object key body)
    (Object/defineProperty object key (js-object :configurable t :get body)) object)
  (defun conversion (events name value mode sentinel)
    (let ((object (js-object)))
      (put object globalThis.Symbol.toPrimitive (lambda (hint)
        (js-call events :push (+ name ":" hint))
        (when (or (= mode (+ "throw-" name)) (= mode (+ "convert-" name))) (throw sentinel))
        (if (= mode (+ "symbol-" name)) (funcall globalThis.Symbol name) value))) object))
  (defun diagnostic-observation (fn mode)
    (let ((events (js-array)) (sentinel (js-object)) (point (js-object))
          (location (js-object)) (diagnostic (js-object)))
      (each (js-array (js-array "line" 3) (js-array "column" 4)) (lambda (pair)
        (let ((name (aref pair 0)) (value (aref pair 1)))
          (getter point name (lambda () (js-call events :push (+ "read." name))
            (conversion events name value mode sentinel))))))
      (getter location "start" (lambda () (js-call events :push "read.start") point))
      (getter location "file" (lambda () (js-call events :push "read.file")
        (conversion events "file" "input.eli" mode sentinel)))
      (getter diagnostic "location" (lambda () (js-call events :push "read.location") location))
      (getter diagnostic "message" (lambda () (js-call events :push "read.message")
        (conversion events "message" "bad" mode sentinel)))
      (let ((error (capture fn (js-array diagnostic))))
        (js-object :events events :name (if (Object/is error sentinel) "sentinel" (get (get error :constructor) :name))
          :message (get error :message) :attached (Object/is (get error :eliscriptDiagnostic) diagnostic)))))
  (defun arrow (fn length)
    (js-call assert :strictEqual (get fn :length) length)
    (js-call assert :strictEqual (Object/hasOwn fn "prototype") false)
    (js-call assert :throws (lambda () (Reflect/construct globalThis.String (js-array) fn)) globalThis.TypeError))

  (defasync prepare ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-retained-host-scope-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (compiler) :compile_ir_string
      (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
    (await (expose "reader" (js-array "fail")))
    (await (expose "analyzer" (js-array "fail")))
    (await (expose "transient-analysis" (js-array "transient-fail")))
    (await (expose "formatter" (js-array "formatter-fail")))
    (await (expose "expander" (js-array "raise-diagnostic")))
    (await (expose "project" (js-array "fail" "project-request-fail" "project-configuration-fail")))
    (await (expose "compiler" (js-array "evaluation-fail")))
    (await (expose "emitter" (js-array "native-locate" "boolean-reference-text-p")))
    (await (expose "ir" (js-array "schema-fail" "dense-json-array-p" "plain-record-keys" "parse-json" "serialize-program")))
    (await (expose "source-map" (js-array "collect-generated-marks" "reference-collect-generated-marks"
      "source-locations" "reference-source-locations")))
    (let ((source (await (original-template "tests/wasm-compiler-emitter.test.mjs"
                    "const prefixSource=" "const prefixSource=`"))))
      (setq prefix-program (js-call (compiler) :compile_ir_string source "array-prefix.eli"))
      (setq prefix-bytes (emit prefix-program))
      (setq prefix-reference (await (loadReference (resolve directory "prefix-reference.mjs")
        (js-call (compiler) :emit_ir_string prefix-program))))))

  (defun original-locate (span output)
    (let* ((fragment (if (= (value-type output) "string") (js-object :text output :marks (js-array)) output))
           (marks (get fragment :marks)))
      (if (or (= (get (get fragment :text) :length) 0) (nullish? span) (eq span false)
              (and (> (get marks :length) 0) (= (get (aref marks 0) :offset) 0))) fragment
        (js-object :text (get fragment :text) :marks
          (js-call (js-array (js-object :offset 0 :span span)) :concat (Array/from marks))))))

  (defun original-dense (value)
    (if (or (not (Array/isArray value)) (not (Object/is (Object/getPrototypeOf value) (get globalThis.Array :prototype)))
            (> (js-length (Object/getOwnPropertySymbols value)) 0)) false
      (let ((names (Object/getOwnPropertyNames value)) (index 0) (valid t))
        (unless (and (= (js-length names) (1+ (get value :length))) (= (aref names (1- (js-length names))) "length"))
          (setq valid false))
        (while (and valid (< index (get value :length)))
          (let* ((name (funcall globalThis.String index)) (descriptor (Object/getOwnPropertyDescriptor value name)))
            (unless (and (= (aref names index) name) descriptor (get descriptor :enumerable) (Object/hasOwn descriptor "value"))
              (setq valid false)))
          (setq index (1+ index))) valid)))
  (defun original-raw-object-p (value)
    ;; Native boxing preserves an object/function without querying its fields.
    ;; Accessor validation asks IsCallable without invoking the value or any
    ;; Proxy trap. Together these retain the original typeof-object boundary;
    ;; language value-type intentionally observes language type descriptors.
    (and (not (nullish? value)) (Object/is (funcall globalThis.Object value) value)
      (try
        (Object/defineProperty (js-object) "callable" (js-object :get value))
        false
        (catch error t))))
  (defun original-record (value)
    (if (or (not (original-raw-object-p value)) (Array/isArray value)) nil
      (let ((prototype (Object/getPrototypeOf value)))
        (if (or (and (not (nullish? prototype)) (not (Object/is prototype (get globalThis.Object :prototype))))
                (> (js-length (Object/getOwnPropertySymbols value)) 0)) nil
          (let ((names (Object/getOwnPropertyNames value)) (index 0) (valid t))
            (while (and valid (< index (js-length names)))
              (let ((descriptor (Object/getOwnPropertyDescriptor value (aref names index))))
                (unless (and descriptor (get descriptor :enumerable) (Object/hasOwn descriptor "value")) (setq valid false)))
              (setq index (1+ index)))
            (if valid (js-call names :sort) nil))))))
  (defun error-result (action)
    (try (js-object :value (funcall action))
      (catch error (js-object :name (get (get error :constructor) :name) :message (get error :message)))))
  (defun receiver-method (fn)
    (new globalThis.Proxy fn (js-object :apply (lambda (target receiver args)
      (funcall native-apply target undefined (js-call (js-array receiver) :concat args))))))
  (defun generated-observation (fn mode)
    (let* ((events (js-array)) (sentinel (js-object)) (generated (js-object)) (mark (js-object))
           (iterator (js-object)) (marks (js-object)) (count 0))
      (getter generated "length" (lambda () (js-call events :push "length")
        (when (= mode "length") (throw sentinel)) 3))
      (getter generated "charCodeAt" (lambda () (js-call events :push "get-char")
        (lambda (index) (js-call events :push (+ "char" index))
          (when (= mode "char") (throw sentinel)) (if (= index 1) 10 97))))
      (getter mark "offset" (lambda () (js-call events :push "offset")
        (when (= mode "offset") (throw sentinel)) 2))
      (getter mark "span" (lambda () (js-call events :push "span")
        (when (= mode "span") (throw sentinel)) (js-object :start 1)))
      (getter iterator "next" (lambda () (js-call events :push "get-next")
        (receiver-method (lambda (receiver)
          (js-call assert :strictEqual receiver iterator)
          (js-call events :push (+ "next" count)) (setq count (1+ count))
          (if (= count 1) (js-object :value mark :done 0) (js-object :done "yes"))))))
      (getter iterator "return" (lambda () (js-call events :push "get-return")
        (receiver-method (lambda (receiver)
          (js-call assert :strictEqual receiver iterator) (js-call events :push "return") (throw "close-error")))))
      (put marks iterator-key (lambda () (js-call events :push "iterator") iterator))
      (let ((value undefined) (error undefined))
        (try (setq value (funcall fn generated marks))
          (catch caught (setq error (if (Object/is caught sentinel) "sentinel" caught))))
        (js-object :events events :value value :error error))))
  (defun simple-observation (fn filename mode)
    (let* ((events (js-array)) (sentinel (js-object)) (Base globalThis.Error)
           (descriptor (Object/getOwnPropertyDescriptor globalThis.globalThis "Error"))
           (message (js-object)) (Ctor nil) (caught nil))
      (put message globalThis.Symbol.toPrimitive (lambda (hint)
        (js-call events :push (+ "message:" hint))
        (when (= mode "coercion") (throw sentinel))
        (if (= mode "symbol") (funcall globalThis.Symbol "message") "错误😀")))
      (setq Ctor (new globalThis.Proxy Base (js-object :construct (lambda (target args)
        (js-call events :push "construct") (when (= mode "constructor") (throw sentinel))
        (let ((error (Reflect/construct target args)))
          (Object/defineProperty error "eliscriptDiagnostic" (js-object :set (lambda (diagnostic)
            (js-call events :push "diagnostic") (when (= mode "setter") (throw sentinel))
            (Object/defineProperty error "saved" (js-object :value diagnostic))))) error)))))
      (try
        (getter globalThis.globalThis "Error" (lambda () (js-call events :push "Error")
          (when (= mode "lookup") (throw sentinel)) Ctor))
        (setq caught (capture fn (js-array message filename "ignored")))
        (finally (Object/defineProperty globalThis.globalThis "Error" descriptor)))
      (let ((saved (get caught :saved)))
        (js-object :events events :thrown (js-object :sentinel (Object/is caught sentinel)
          :type (js-call globalThis.TypeError (get globalThis.Symbol :hasInstance) caught)
          :message (if (js-call Base (get globalThis.Symbol :hasInstance) caught) (get caught :message) undefined)
          :messageIdentity (Object/is (field saved "message") message) :location (field saved "location")
          :keys (if saved (Object/keys saved) (js-array)))))))

  (defun original-generated (generated marks)
    (let ((result (js-array)) (index 0) (line 0) (column 0))
      (original-iterate marks (lambda (mark)
        (let ((target (get mark :offset)))
          (while (and (< index target) (< index (get generated :length)))
            (if (= (js-call generated :charCodeAt index) 10) (setq line (1+ line) column 0) (setq column (1+ column)))
            (setq index (1+ index)))
          (when (and (= index target) (< index (get generated :length)))
            (js-call result :push (js-array line column (get mark :span))))))) result))
  (defun original-locations (source marks)
    (let ((wanted (new globalThis.Set)) (locations (new globalThis.Map)))
      (original-iterate marks (lambda (mark)
        (let* ((array (if (nullish? mark) (js-array) mark))
               (raw-span (aref array 2))
               (span (if (nullish? raw-span) nil raw-span))
               (start (aref span "start")))
          (unless (undefined? start) (js-call wanted :add start)))))
      (let ((starts (js-call (js-call (funcall native-array-from wanted) :filter
                      (lambda (start) (and (funcall globalThis.Boolean (Number/isSafeInteger start)) (>= start 0)))) :sort (lambda (a b) (- a b))))
            (index 0) (offset 0) (line 0) (column 0))
        (each starts (lambda (start)
          (while (and (< offset start) (< index (get source :length)))
            (let* ((code (js-call source :codePointAt index)) (width (if (> code 65535) 2 1)))
              (if (= code 10) (setq line (1+ line) column 0) (setq column (+ column width)))
              (setq index (+ index width) offset (1+ offset))))
          (when (and (= offset start) (or (< index (get source :length)) (= (get source :length) 0)))
            (js-call locations :set offset (js-array line column)))))) locations))

  (defun register-cases ()
    (js-call node-test :before prepare (js-object :timeout 120000))
    (js-call node-test :after (async () (when directory (await (rm directory (js-object :recursive t :force t))))))

    (test "independent reference keeps the real module namespace and packaged Math imports"
      (async ()
        (let* ((source (str "(module reference.math-profile "
                         "(defun observe () (js-array (Math/f16round 1.00048828125) "
                         "(Math/sumPrecise (js-array 1e20 1 -1e20)) globalThis.Math)) "
                         "(export observe))"))
               (program (js-call (compiler) :compile_ir_string source "reference-math.eli"))
               (path (resolve directory "reference-math.mjs"))
               (output (js-call (compiler) :emit_ir_string program))
               (namespace (await (loadReference path output)))
               (canonical (funcall (createRequire path) path))
               (observed (js-call namespace :observe)))
          (js-call assert :strictEqual namespace canonical)
          (js-call assert :strictEqual (get namespace globalThis.Symbol.toStringTag) "Module")
          (js-call assert :strictEqual (await (readFile path "utf8")) output)
          (js-call assert :strictEqual (aref observed 0) 1)
          (js-call assert :strictEqual (aref observed 1) 1)
          (js-call assert :strictEqual (aref observed 2) globalThis.Math))))

    (test "producer IR wire preserves negative zero and the original JSON object omissions array holes and source property order"
      (lambda ()
        (let* ((items (js-array undefined undefined -0 nil false globalThis.NaN globalThis.Infinity (- globalThis.Infinity)))
               (input (js-object :value -0 :positive 0 :absent undefined :items items :text "中😀\ud800"
                 :nested (js-object "2" "two" "1" "one" :z -0))))
          (Reflect/deleteProperty items "0")
          (let* ((wire (stringifyCompilerInput input)) (parsed (JSON/parse wire)))
            (js-call assert :strictEqual (Object/is (get parsed :value) -0) t)
            (js-call assert :strictEqual (Object/is (aref (get parsed :items) 2) -0) t)
            (js-call assert :strictEqual (Object/is (get (get parsed :nested) :z) -0) t)
            (js-call assert :strictEqual (Object/is (get parsed :positive) 0) t)
            (js-call assert :strictEqual wire
              (+ "{\"value\":-0,\"positive\":0,\"items\":[null,null,-0,null,false,null,null,null],\"text\":"
                (JSON/stringify (get input :text)) ",\"nested\":{\"1\":\"one\",\"2\":\"two\",\"z\":-0}}")))
          (each (js-array undefined nil t false 3 "中😀\ud800"
            (js-object :a undefined :b nil :items (js-array undefined undefined (funcall globalThis.Symbol "x") (lambda () 1)))
            (js-object :value globalThis.NaN :items (js-array globalThis.Infinity (- globalThis.Infinity)))
            (js-array "x" (js-object "10" "ten" "2" "two" :a undefined)))
            (lambda (value) (js-call assert :strictEqual (stringifyCompilerInput value) (JSON/stringify value))))
          (let ((repeated (js-object :value -0)) (cycle (js-object)))
            (js-call assert :strictEqual (stringifyCompilerInput (js-array repeated repeated)) "[{\"value\":-0},{\"value\":-0}]")
            (put cycle :self cycle)
            (js-call assert :throws (lambda () (stringifyCompilerInput cycle)) globalThis.TypeError)
            (js-call assert :throws (lambda () (stringifyCompilerInput (funcall globalThis.BigInt 1))) globalThis.TypeError)))))

    (test "producer profiles keep the original default budget distinct from the explicit full-runtime candidate"
      (lambda ()
        (js-call assert :deepStrictEqual (get producerProfiles :small)
          (js-object :budget (js-object :maxSlots 131072 :initialBytes 8388608 :maxBytes 67108864)
            :memory (js-object :initialPages 128 :maximumPages 4096) :auto 65536))
        (js-call assert :deepStrictEqual (get producerProfiles "full-runtime")
          (js-object :budget (js-object :maxSlots 1048575 :initialBytes 67108864 :maxBytes 268435456)
            :memory (js-object :initialPages 2048 :maximumPages 16384) :auto 4194304))))

    (test "compiler teardown closes a native adapter on success and every cleanup failure"
      (lambda ()
        (each (js-array "none" "closeModule" "collect" "live" "frame") (lambda (failure)
          (let* ((calls (js-array)) (sentinel (new globalThis.Error (+ "injected " failure)))
                 (adapter (js-object
                   :closeModule (lambda () (js-call calls :push "closeModule") (when (= failure "closeModule") (throw sentinel)))
                   :collect (lambda () (js-call calls :push "collect") (when (= failure "collect") (throw sentinel)))
                   :live (lambda () (js-call calls :push "live") (if (= failure "live") 1 0))
                   :stats (lambda () (js-call calls :push "stats") (js-object :frameDepth (if (= failure "frame") 1 0)))
                   :close (lambda () (js-call calls :push "close")))))
            (if (= failure "none") (finishCompiler adapter)
              (js-call assert :throws (lambda () (finishCompiler adapter)) (lambda (error)
                (if (or (= failure "closeModule") (= failure "collect")) (Object/is error sentinel)
                  (= (get error :code) "ERR_ASSERTION")))))
            (js-call assert :strictEqual (js-call calls :at -1) "close")
            (js-call assert :strictEqual (js-length (js-call calls :filter (lambda (name) (= name "close")))) 1)
            (js-call assert :deepStrictEqual calls
              (cond ((= failure "closeModule") (js-array "closeModule" "close"))
                    ((= failure "collect") (js-array "closeModule" "collect" "close"))
                    ((= failure "live") (js-array "closeModule" "collect" "live" "close"))
                    (t (js-array "closeModule" "collect" "live" "stats" "close")))))))))

    (test "portable IR predicates retain the original raw JS descriptor and prototype rules, proxy observation order and arrow reflection"
      (lambda ()
        (let* ((values (js-array undefined nil false t 0 -0 globalThis.NaN "" (funcall globalThis.Symbol "x")
                        (lambda () nil) (js-array) (js-array undefined) (js-array nil) (new globalThis.Array 1)
                        (js-object) (Object/create nil) (Object/create (js-object)) (new globalThis.Date)
                        (new globalThis.Map) (get globalThis.Object :prototype) (get globalThis.Array :prototype)))
               (nonenumerable (js-object)) (accessor (js-object)) (symbol (js-object))
               (array (js-array 1)) (named (js-array 1)))
          (Object/defineProperty nonenumerable "x" (js-object :value 1))
          (Object/defineProperty accessor "x" (js-object :enumerable t :get (lambda () (throw (new globalThis.Error "must not invoke data getter")))))
          (put symbol (funcall globalThis.Symbol "x") 1)
          (Object/defineProperty array "0" (js-object :enumerable t :get (lambda () (throw (new globalThis.Error "must not invoke data getter")))))
          (put named :extra t)
          (js-call values :push nonenumerable accessor symbol array named (Object/freeze (js-array 1 2)))
          (each values (lambda (value)
            (js-call assert :strictEqual (funcall (helper "ir" "dense-json-array-p") value) (original-dense value))
            (js-call assert :deepStrictEqual (funcall (helper "ir" "plain-record-keys") value) (original-record value))))
          (each (js-array (js-array (helper "ir" "dense-json-array-p") original-dense)
                         (js-array (helper "ir" "plain-record-keys") original-record)) (lambda (pair)
            (arrow (aref pair 0) 1)
            (let ((observe (lambda (fn)
              (let* ((trace (js-array)) (value (new globalThis.Proxy (js-object :b 2 :a 1)
                (js-object :getPrototypeOf (lambda (target) (js-call trace :push "prototype") (Reflect/getPrototypeOf target))
                  :ownKeys (lambda (target) (js-call trace :push "keys") (Reflect/ownKeys target))
                  :getOwnPropertyDescriptor (lambda (target key)
                    (js-call trace :push (+ "descriptor:" (funcall globalThis.String key)))
                    (Reflect/getOwnPropertyDescriptor target key))))))
                (js-object :out (funcall fn value) :trace trace)))))
              (js-call assert :deepStrictEqual (funcall observe (aref pair 0)) (funcall observe (aref pair 1)))))))))

    (test "ordinary schema failures preserve the original Error constructor argument count"
      (lambda ()
        (let* ((descriptor (Object/getOwnPropertyDescriptor globalThis.globalThis "Error"))
               (Base globalThis.Error) (calls (js-array))
               (Constructor (new globalThis.Proxy Base (js-object :construct (lambda (target args)
                 (js-call calls :push args) (Reflect/construct target args))))) (error nil))
          (try
            (Object/defineProperty globalThis.globalThis "Error" (js-object :value Constructor :configurable t :writable t))
            (setq error (capture (helper "ir" "schema-fail") (js-array "kept" "ignored")))
            (finally (Object/defineProperty globalThis.globalThis "Error" descriptor)))
          (js-call assert :strictEqual (js-call Base (get globalThis.Symbol :hasInstance) error) t)
          (js-call assert :deepStrictEqual calls (js-array (js-array "kept")))
          (js-call assert :strictEqual (Object/hasOwn error "cause") false)
          (js-call assert :strictEqual (get (get error :eliscriptDiagnostic) :message) "kept"))))

    (test "portable schema and JSON rejection helpers keep exact diagnostic values, callback errors and original arrow contracts"
      (lambda ()
        (let ((schema (helper "ir" "schema-fail")) (parse (helper "ir" "parse-json")))
          (arrow schema 1) (arrow parse 2)
          (each (js-array undefined nil false 0 -0 "中😀" (js-object) (funcall globalThis.Symbol "x")) (lambda (message)
            (if (= (value-type message) "symbol") (js-call assert :throws (lambda () (funcall schema message)) globalThis.TypeError)
              (let ((error (capture schema (js-array message))))
                (js-call assert :strictEqual (get (get error :eliscriptDiagnostic) :message) message)
                (js-call assert :strictEqual (get (get error :eliscriptDiagnostic) :code) "ELI-I0001")))))
          (each (js-array "null" "false" "0" "-0" "\"中😀\"" "[1,null]" "{\"x\":2}") (lambda (text)
            (js-call assert :deepStrictEqual (funcall parse text (lambda () (js-call assert :fail "valid JSON"))) (JSON/parse text))))
          (each (js-array "{" "undefined" "[1,]") (lambda (text)
            (let ((calls (js-array)))
              (js-call assert :strictEqual (funcall parse text (lambda (&rest args) (js-call calls :push args) false)) false)
              (js-call assert :deepStrictEqual calls (js-array (js-array "invalid canonical IR JSON"))))
            (let* ((error (capture parse (js-array text schema))) (cause (get error :cause))
                   (descriptor (Object/getOwnPropertyDescriptor error "cause")))
              (js-call assert :strictEqual (get error :message) "invalid canonical IR JSON")
              (js-call assert :strictEqual (get (get error :eliscriptDiagnostic) :message) (get error :message))
              (js-call assert :strictEqual (js-call globalThis.SyntaxError (get globalThis.Symbol :hasInstance) cause) t)
              (js-call assert :strictEqual (get descriptor :enumerable) false)
              (js-call assert :strictEqual (get descriptor :writable) t)
              (js-call assert :strictEqual (get descriptor :configurable) t))))
          (let ((sentinel (js-object)))
            (js-call assert :strictEqual (capture parse (js-array "{" (lambda () (throw sentinel)))) sentinel))
          (let* ((extra (new globalThis.Proxy (js-object) (js-object :get (lambda (&rest ignored) (throw (new globalThis.Error "ignored extra read"))))))
                 (error (capture schema (js-array "ordinary" extra))))
            (js-call assert :strictEqual (funcall parse "null" (lambda () (js-call assert :fail "valid JSON")) extra) nil)
            (js-call assert :strictEqual (get error :message) "ordinary")
            (js-call assert :strictEqual (Object/hasOwn error "cause") false))
          (let ((original (get globalThis.JSON :parse)) (sentinel (new globalThis.SyntaxError "actual parser failure")))
            (try
              (put globalThis.JSON :parse (lambda (&rest ignored) (throw sentinel)))
              (let ((error (capture parse (js-array "{" schema))))
                (js-call assert :strictEqual (get error :message) "invalid canonical IR JSON")
                (js-call assert :strictEqual (get error :cause) sentinel))
              (finally (put globalThis.JSON :parse original)))))))

    (test "canonical IR numeric values keep positive and negative zero distinct after raw Object.is migration"
      (lambda ()
        (each (js-array 0 -0 1 -1) (lambda (value)
          (let* ((program (js-call (compiler) :compile_ir_string "(defconst x 0)" "zero.eli"))
                 (declaration (aref (get program :body) 0)))
            (put (aref (get declaration :children) 0) :value value)
            (js-call assert :strictEqual
              (js-call (funcall (helper "ir" "serialize-program") program) :includes "\"value\":-0") (Object/is value -0)))))))

    (test "retained Reader Analyzer and Expander diagnostic getters conversion order arrow contract and abrupt identity"
      (lambda ()
        (each (js-array (helper "reader" "fail") (helper "analyzer" "fail") (helper "expander" "raise-diagnostic"))
          (lambda (fn)
            (arrow fn 1)
            (let ((modes (js-array "normal")))
              (each (js-array "file" "line" "column" "message") (lambda (name)
                (js-call modes :push (+ "throw-" name) (+ "symbol-" name))))
              (each modes (lambda (mode)
                (js-call assert :deepStrictEqual (diagnostic-observation fn mode)
                  (diagnostic-observation original-diagnostic mode)))))
            (each (js-array undefined nil (js-object) (js-object :location nil) (js-object :location (js-object :start nil)))
              (lambda (diagnostic)
                (let ((a (capture fn (js-array diagnostic))) (b (capture original-diagnostic (js-array diagnostic))))
                  (js-call assert :strictEqual (get (get a :constructor) :name) (get (get b :constructor) :name)))))
            (each (js-array undefined nil false -0 globalThis.NaN globalThis.Infinity (funcall globalThis.BigInt 1) "" "\ud800😀")
              (lambda (file)
                (let* ((diagnostic (js-object :location (js-object :file file :start (js-object :line 1 :column 2)) :message undefined))
                       (a (capture fn (js-array diagnostic))) (b (capture original-diagnostic (js-array diagnostic))))
                  (js-call assert :strictEqual (get a :message) (get b :message))
                  (js-call assert :strictEqual (get a :eliscriptDiagnostic) diagnostic))))))))

    (test "local string scanning preserves the independent original Reader AST cursor and errors for long Unicode escaped and incomplete literals"
      (async ()
        (let* ((text (await (readFile (resolve root "bootstrap/compiler/reader.eli") "utf8")))
               (body (await (original-template "tests/wasm-compiler-reader.test.mjs"
                       "const originalStringLiteral=" "const originalStringLiteral=`")))
               (start (js-call text :indexOf "  (defun read-string-literal\n"))
               (end (js-call text :indexOf "  (defun read-prefix\n" start))
               (original nil) (local nil))
          (js-call assert :ok (and (>= start 0) (> end start)))
          (setq original (await (load-reader-source (+ (js-call text :slice 0 start) body (js-call text :slice end)) "reader-original-string")))
          (setq local (await (load-reader-source text "reader-local-string")))
          (let* ((prefix "😀\n  ") (mark (js-object :index (js-length prefix) :offset (js-length (Array/from prefix)) :line 2 :column 3))
                 (filename "literal😀.eli")
                 (literals (js-array (JSON/stringify (js-call "中😀\"\\\n" :repeat 4096))
                   "\"quote\\\" slash\\\\ end\"" "\"😀𝄞\ud800x\udc00\"" "\"\\uD83D\\uDE00\\uD800\\uDC00\""
                   "\"\udc00\"" "\"a\n😀b\"" "\"a\r😀b\"" "\"a\\\n😀b\"" "\"\\😀\"" "\"\\\ud800\""
                   "\"unfinished😀" "\"unfinished😀\\" "\""))
                 (observe (lambda (module source)
                   (let ((cursor (Object/assign (js-object :source source :filename filename) mark)))
                     (try (js-object :ok t :value (js-call module :read_string_literal cursor (Object/assign (js-object) mark)) :cursor cursor)
                       (catch error (js-object :ok false :name (get error :name) :message (get error :message)
                         :diagnostic (get error :eliscriptDiagnostic) :cursor cursor)))))))
            (each literals (lambda (literal)
              (let* ((source (+ prefix literal)) (expected (funcall observe original source)))
                (js-call assert :deepStrictEqual (funcall observe local source) expected)
                (when (get expected :ok)
                  (js-call assert :deepStrictEqual (js-call local :read_string source filename) (js-call original :read_string source filename))))))))) 5000)

    (test "diagnostic helpers do not format primitive fields through mutable Array join"
      (lambda ()
        (let ((saved (get (get globalThis.Array :prototype) :join)))
          (try
            (put (get globalThis.Array :prototype) :join (lambda (&rest ignored) (throw "join must not format diagnostic fields")))
            (each (js-array (helper "reader" "fail") (helper "analyzer" "fail") (helper "expander" "raise-diagnostic"))
              (lambda (fn)
                (let* ((diagnostic (js-object :location (js-object :file nil :start (js-object :line undefined :column false)) :message undefined))
                       (a (capture fn (js-array diagnostic))) (b (capture original-diagnostic (js-array diagnostic))))
                  (js-call assert :strictEqual (get a :message) (get b :message))
                  (js-call assert :strictEqual (get a :message) "null:undefined:false: undefined"))))
            (let ((a (capture (helper "transient-analysis" "transient-fail") (js-array undefined nil undefined)))
                  (b (capture original-transient (js-array undefined nil undefined))))
              (js-call assert :strictEqual (get a :message) (get b :message)))
            (finally (put (get globalThis.Array :prototype) :join saved))))))

    (test "portable expander diagnostic lookup failures and String global mutation retain the original abrupt priority"
      (lambda ()
        (let ((observe (lambda (fn mode)
          (let* ((events (js-array)) (sentinel (js-object)) (Base globalThis.Error)
                 (descriptor (Object/getOwnPropertyDescriptor globalThis.globalThis "Error"))
                 (string-descriptor (Object/getOwnPropertyDescriptor globalThis.globalThis "String"))
                 (point (js-object)) (location (js-object)) (diagnostic (js-object)) (result nil))
            (getter point "line" (lambda () (js-call events :push "line") (conversion events "line" 2 mode sentinel)))
            (getter point "column" (lambda () (js-call events :push "column") (conversion events "column" 3 mode sentinel)))
            (getter location "start" (lambda () (js-call events :push "start") point))
            (getter location "file" (lambda () (js-call events :push "file")
              (conversion events "file" "输入😀.eli" (if (= mode "symbol") "symbol-file" mode) sentinel)))
            (getter diagnostic "location" (lambda () (js-call events :push "location") (when (= mode "location") (throw sentinel)) location))
            (getter diagnostic "message" (lambda () (js-call events :push "message") (conversion events "message" "failed" mode sentinel)))
            (try
              (getter globalThis.globalThis "Error" (lambda () (js-call events :push "Error") (when (= mode "Error") (throw sentinel)) Base))
              (getter globalThis.globalThis "String" (lambda () (throw sentinel)))
              (let ((error (capture fn (js-array diagnostic))))
                (setq result (js-object :kind (if (Object/is error sentinel) "sentinel"
                  (if (js-call globalThis.TypeError (get globalThis.Symbol :hasInstance) error) "TypeError" "Error"))
                  :message (if (and (js-call Base (get globalThis.Symbol :hasInstance) error)
                    (not (js-call globalThis.TypeError (get globalThis.Symbol :hasInstance) error))) (get error :message) undefined)
                  :diagnostic (Object/is (get error :eliscriptDiagnostic) diagnostic))))
              (finally (Object/defineProperty globalThis.globalThis "Error" descriptor)
                (Object/defineProperty globalThis.globalThis "String" string-descriptor)))
            (js-object :events events :result result)))))
          (each (js-array "normal" "location" "Error" "throw-file" "throw-line" "throw-column" "throw-message" "symbol")
            (lambda (mode) (js-call assert :deepStrictEqual
              (funcall observe (helper "expander" "raise-diagnostic") mode) (funcall observe original-diagnostic mode)))))))

    (test "retained diagnostic Error lookup precedes template conversion and constructors keep returned object identity"
      (lambda ()
        (each (js-array (helper "reader" "fail") (helper "analyzer" "fail")
                       (helper "expander" "raise-diagnostic") original-diagnostic)
          (lambda (fn)
            (let* ((events (js-array)) (returned (js-object)) (descriptor (Object/getOwnPropertyDescriptor globalThis.globalThis "Error"))
                   (Base globalThis.Error) (Constructor nil)
                   (diagnostic (js-object :location (js-object :start (js-object :line 1 :column 2)) :message "bad")))
              (getter (get diagnostic :location) "file" (lambda () (js-call events :push "file") "input.eli"))
              (setq Constructor (new globalThis.Proxy Base (js-object :construct (lambda (target args new-target)
                (js-call events :push (js-array "construct" (Object/is new-target Constructor) (aref args 0))) returned))))
              (try
                (getter globalThis.globalThis "Error" (lambda () (js-call events :push "Error") Constructor))
                (js-call assert :strictEqual (capture fn (js-array diagnostic)) returned)
                (js-call assert :strictEqual (get returned :eliscriptDiagnostic) diagnostic)
                (finally (Object/defineProperty globalThis.globalThis "Error" descriptor)))
              (js-call assert :deepStrictEqual events
                (js-array "Error" "file" (js-array "construct" t "input.eli:1:2: bad"))))))))

    (test "transient diagnostic Error capture retains constructed objects and original unconverted field values"
      (lambda ()
        (let ((observe (lambda (fn)
          (let* ((events (js-array)) (returned (js-object)) (Base globalThis.Error)
                 (descriptor (Object/getOwnPropertyDescriptor globalThis.globalThis "Error"))
                 (file (js-object)) (span (js-object :start 0 :line 1 :column 2 :end 3 :endLine 4 :endColumn 5))
                 (Ctor nil))
