    (test "formatter and evaluation ordinary ToPrimitive conversion and constructor-returned objects retain exact source values"
      (lambda ()
        (each (js-array (js-array (helper "formatter" "formatter-fail") (original-simple "ELI-F0001" "formatter" t))
                       (js-array (helper "compiler" "evaluation-fail") (original-simple "ELI-E0001" "evaluation-request" t)))
          (lambda (pair)
