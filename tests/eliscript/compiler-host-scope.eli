          (js-call assert :strictEqual (raw e "value-standard-prototype-existing" h 2) 0)
          (js-call assert :strictEqual (raw e "last-error") 3)
          (js-call assert :strictEqual (raw e "value-standard-prototype-existing" 4294967295 0) 0)
          (js-call assert :strictEqual (raw e "last-error") 1)
          (let ((stale (raw e "value-string" h 0)))
            (raw e "heap-collect" h)
            (let ((offset (raw e "value-data" h args 7)))
              (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :setUint32 offset stale t)
              (js-call assert :strictEqual (raw e "value-object-reflection" h args 2 0) 0)
              (js-call assert :strictEqual (raw e "last-error") 1)
              (js-call assert :strictEqual (raw e "frame-depth" h) 1)
              (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :setUint32 offset target t)))
          (raw e "frame-pop" h caller) (raw e "value-standard-prototypes-close" h) (raw e "heap-collect" h)
          (js-call assert :strictEqual (raw e "heap-live" h) 0))))

    (test "actual reflection traps escape source catch and unwind only the callee frames"
      (lambda ()
        (let* ((injected (trap-runtime "heap-reflection-label" "heap-reflection-prototype"
                          "(defun heap-reflection-label (heap label) (load-u32 4294967295))"))
               (program (js-call (compiler) :compile_ir_string
                 "(defun run (value) (try (Object/getOwnPropertyDescriptor value \"x\") (catch error \"swallowed\"))) (defun recover () 7) (export run recover)"
                 "reflection-trap-entry.eli"))
               (a (instance (emit program injected))) (seven (js-call a :number 7))
               (input (js-call a :sourceObject (js-object :x seven))) (caller (js-call a :frame 1)))
          (js-call a :frameSet caller 0 input)
          (js-call assert :throws (lambda () (js-call a :invoke "run" (js-array input))) globalThis.WebAssembly.RuntimeError)
          (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
          (let ((value (js-call a :invoke "recover")))
            (js-call assert :strictEqual (js-call a :readNumber value) 7) (release a (js-array value)))
          (js-call a :leaveFrame caller) (finish a (js-array input seven)))))

    ;; One actual user program and one independent Node observation serve both
    ;; output backends. Mutation witnesses expose Has/Delete order without a
    ;; host Proxy or an imported observer changing the zero-import program.
    (let* ((fixture-promise nil)
           (native-target (cond
             ((and (= (get globalThis.process :arch) "arm64") (= (get globalThis.process :platform) "darwin")) "arm64-macos")
             ((and (= (get globalThis.process :arch) "arm64") (= (get globalThis.process :platform) "linux")) "arm64-linux")
             (t nil)))
           (source (js-call (js-array
             "(module retained.reverse"
             "  (defconst prototype (get globalThis.Array :prototype))"
             "  (defconst method (get prototype :reverse))"
             "  (defun atom (value) (cond ((undefined? value) \"undefined\") ((Object/is value -0) \"-0\") ((Number/isNaN value) \"NaN\") (t value)))"
             "  (defun shape (object count) (let ((out (js-array)) (i 0)) (while (< i count) (js-call out :push (js-array (Object/hasOwn object (str i)) (atom (aref object i)))) (setq i (1+ i))) out))"
             "  (defun status (body sentinel) (try (funcall body) \"ok\" (catch error (if (Object/is error sentinel) \"sentinel\" (if (nullish? error) \"nullish-error\" (get error :name))))))"
             "  (defun basic (mode) (let ((items (cond ((= mode 0) (js-array)) ((= mode 1) (js-array -0)) ((= mode 2) (js-array -0 globalThis.NaN undefined 7)) (t (js-array 1 2 3 4 5))))) (when (= mode 3) (Reflect/deleteProperty items \"1\") (Reflect/deleteProperty items \"4\")) (let ((returned (js-call items :reverse))) (js-array (Object/is returned items) (get items :length) (shape items (get items :length))))))"
             "  (defun inherited () (let* ((base (Object/create prototype)) (items (js-array 1 2 3 4)) (trace (js-array))) (Reflect/deleteProperty items \"0\") (Reflect/deleteProperty items \"3\") (Object/defineProperty base \"0\" (js-object :get (lambda () (js-call trace :push \"get:0\") 11) :set (lambda (value) (js-call trace :push (str \"set:0:\" value))) :configurable t)) (Object/defineProperty base \"3\" (js-object :value 33 :writable t :configurable t)) (Object/setPrototypeOf items base) (let* ((returned (js-call items :reverse)) (events (js-call trace :slice))) (js-array (Object/is returned items) events (Object/hasOwn items \"0\") (Object/hasOwn items \"3\") (aref items 3) (shape items 4)))))"
             "  (defun accessors (mode) (let* ((events (js-array)) (marker (if (= mode 7) false (if (= mode 8) undefined (js-object :marker mode)))) (low 10) (high 20) (object (js-object)))"
             "    (Object/defineProperty object \"length\" (js-object :get (lambda () (js-call events :push \"length\") (when (= mode 1) (throw marker)) (js-object :valueOf (lambda () (js-call events :push \"valueOf\") (when (= mode 2) (throw marker)) 2.9))) :configurable t))"
             "    (Object/defineProperty object \"0\" (js-object :get (lambda () (js-call events :push \"get:0\") (when (= mode 3) (throw marker)) low) :set (lambda (value) (js-call events :push (str \"set:0:\" value)) (when (or (= mode 5) (= mode 7) (= mode 8)) (throw marker)) (setq low value)) :configurable t))"
             "    (Object/defineProperty object \"1\" (js-object :get (lambda () (js-call events :push \"get:1\") (when (= mode 4) (throw marker)) high) :set (lambda (value) (js-call events :push (str \"set:1:\" value)) (when (= mode 6) (throw marker)) (setq high value)) :configurable t))"
             "    (let* ((same false) (outcome (status (lambda () (setq same (Object/is (js-call method :call object) object))) marker))) (js-array outcome same events low high))))"
             "  (defun has-order (mode) (let* ((events (js-array)) (object (js-object :length 2)) (marker (js-object)))"
             "    (cond ((or (= mode 0) (= mode 1)) (Object/defineProperty object \"0\" (js-object :get (lambda () (js-call events :push \"get:0\") (if (= mode 0) (Object/defineProperty object \"1\" (js-object :get (lambda () (js-call events :push \"get:1\") 22) :set (lambda (value) (js-call events :push (str \"set:1:\" value))) :configurable t)) (Reflect/deleteProperty object \"1\")) 11) :set (lambda (value) (js-call events :push (str \"set:0:\" value))) :configurable t)) (when (= mode 1) (Object/defineProperty object \"1\" (js-object :value 99 :writable t :configurable t))))"
             "      ((= mode 2) (Object/defineProperty object \"1\" (js-object :get (lambda () (js-call events :push \"get:1\") (Object/defineProperty object \"0\" (js-object :get (lambda () (js-call events :push \"unexpected:get:0\") 99) :set (lambda (value) (js-call events :push (str \"set:0:\" value))) :configurable t)) 22) :configurable t))))"
             "    (let ((outcome (status (lambda () (js-call method :call object)) marker))) (js-array outcome (js-call events :slice) (Object/hasOwn object \"0\") (Object/hasOwn object \"1\")))))"
             "  (defun deletion (mode) (let* ((object (js-object :length 2)) (marker (js-object))) (cond ((= mode 0) (Object/defineProperty object \"0\" (js-object :value 11 :writable t :configurable t)) (Object/preventExtensions object)) ((= mode 1) (Object/defineProperty object \"1\" (js-object :value 22 :writable t :configurable false))) ((= mode 2) (Object/defineProperty object \"0\" (js-object :value 11 :writable t :configurable false)))) (let ((outcome (status (lambda () (js-call method :call object)) marker))) (js-array outcome (shape object 2)))))"
             "  (defun lengths (mode) (let* ((events (js-array)) (marker (js-object)) (object (js-object)) (length (cond ((= mode 0) -3) ((= mode 1) 0.9) ((= mode 2) globalThis.NaN) ((= mode 3) \"3.9\") ((= mode 4) 4294967297) (t globalThis.Infinity))))"
             "    (Object/defineProperty object \"length\" (js-object :get (lambda () (js-call events :push \"length\") length)))"
             "    (Object/defineProperty object \"0\" (js-object :get (lambda () (js-call events :push \"get:0\") 11) :set (lambda (value) (js-call events :push (str \"set:0:\" value))) :configurable t))"
             "    (Object/defineProperty object (cond ((= mode 4) \"4294967296\") ((= mode 5) \"9007199254740990\") (t \"2\")) (js-object :get (lambda () (js-call events :push \"get:last\") (when (>= mode 4) (throw marker)) 33) :set (lambda (value) (js-call events :push (str \"set:last:\" value))) :configurable t))"
             "    (js-array (status (lambda () (js-call method :call object)) marker) events)))"
             "  (defun integrity (mode) (let* ((items (if (= mode 0) (js-array) (if (= mode 1) (js-array 7) (js-array 1 2 3)))) (marker (js-object))) (when (= mode 4) (Reflect/deleteProperty items \"0\")) (cond ((<= mode 2) (Object/freeze items)) ((or (= mode 3) (= mode 4)) (Object/preventExtensions items)) ((= mode 5) (Reflect/deleteProperty items \"0\") (Object/seal items)) ((= mode 6) (Object/defineProperty items \"length\" (js-object :writable false))) (t (Object/defineProperty items \"0\" (js-object :writable false)))) (let* ((same false) (outcome (status (lambda () (setq same (Object/is (js-call method :call items) items))) marker))) (js-array outcome same (shape items (get items :length))))))"
             "  (defun metadata () (let ((descriptor (Object/getOwnPropertyDescriptor prototype \"reverse\"))) (js-array (get method :name) (get method :length) (Object/hasOwn method \"prototype\") (get descriptor :writable) (get descriptor :enumerable) (get descriptor :configurable) (status (lambda () (Reflect/construct method (js-array))) (js-object)) (status (lambda () (js-call method :call nil)) (js-object)) (status (lambda () (js-call method :call undefined)) (js-object)))))"
             "  (defun overwritten () (let* ((descriptor (Object/getOwnPropertyDescriptor prototype \"reverse\")) (items (js-array 1 2)) (marker (js-object)) (replacement (lambda () marker))) (try (put prototype :reverse replacement) (let ((same (Object/is (js-call items :reverse) marker))) (Reflect/deleteProperty prototype \"reverse\") (let ((missing (not (Object/hasOwn prototype \"reverse\"))) (outcome (status (lambda () (js-call items :reverse)) marker))) (js-array same missing outcome (Object/hasOwn prototype \"reverse\")))) (finally (Object/defineProperty prototype \"reverse\" descriptor)))))"
             "  (defun run () (let ((out (js-array)) (i 0)) (while (< i 4) (js-call out :push (JSON/stringify (basic i))) (setq i (1+ i))) (js-call out :push (JSON/stringify (inherited))) (setq i 0) (while (< i 9) (js-call out :push (JSON/stringify (accessors i))) (setq i (1+ i))) (setq i 0) (while (< i 4) (js-call out :push (JSON/stringify (has-order i))) (setq i (1+ i))) (setq i 0) (while (< i 4) (js-call out :push (JSON/stringify (deletion i))) (setq i (1+ i))) (setq i 0) (while (< i 6) (js-call out :push (JSON/stringify (lengths i))) (setq i (1+ i))) (setq i 0) (while (< i 8) (js-call out :push (JSON/stringify (integrity i))) (setq i (1+ i))) (js-call out :push (JSON/stringify (metadata))) (js-call out :push (JSON/stringify (overwritten))) out))"
             "  (export run))") :join "\n")))
      (each (js-array "wasm" "native") (lambda (target)
        (js-call node-test :test (+ target " reverse preserves generic sparse operations, abrupt order, method identity and cleanup")
          (js-object :skip (and (= target "native") (nullish? native-target)) :timeout 120000)
          (async ()
            (unless fixture-promise
              (setq fixture-promise (user-fixture source "array-reverse.eli")))
            (let* ((fixture (await fixture-promise))
                   (expected (JSON/parse (node-oracle "run" (get fixture :path))))
                   (a (if (= target "wasm") (instance (get fixture :bytes))
                     (let* ((lowered (js-call (get backend :managed) :lower_managed_program (get fixture :program) runtime t))
                            (path (resolve directory (if (= native-target "arm64-macos") "array-reverse.dylib" "array-reverse.so"))))
                       (await (writeFile path (globalThis.Uint8Array.from
                         (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target))))
                       (let ((adapter (await (instantiateNativeManagedRuntime path lowered))))
                         (js-call adapter :auto 1) adapter))))
                   (output undefined) (failed false) (failure undefined))
              (try
                ;; Keep independent reference assumptions visible, rather than
                ;; accepting two matching but accidentally empty observations.
                (js-call assert :strictEqual (js-length expected) 38)
                (js-call assert :deepStrictEqual (JSON/parse (aref expected 5))
                  (js-array "ok" t (js-array "length" "valueOf" "get:0" "get:1" "set:0:20" "set:1:10") 20 10))
                (js-call assert :deepStrictEqual (JSON/parse (aref expected 16))
                  (js-array "ok" (js-array "get:1" "set:0:22") t false))
                (js-call assert :deepStrictEqual (JSON/parse (aref expected 36))
                  (js-array "reverse" 0 false t false t "TypeError" "TypeError" "TypeError"))
                (js-call assert :deepStrictEqual (JSON/parse (aref expected 37))
                  (js-array t t "TypeError" false))
                (setq output (js-call a :invoke "run"))
                (js-call assert :deepStrictEqual (read-value a output) expected)
                (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0)
                (catch error (setq failed t failure error))
                (finally
                  (try (finish a (js-array output))
                    (catch cleanup-error (unless failed (setq failed t failure cleanup-error))))
                  (when (= target "native")
                    (try (js-call a :close)
                      (catch close-error (unless failed (setq failed t failure close-error)))))))
              (when failed (throw failure))))))))
  )

  (defun raw (exports name &rest args) (Reflect/apply (get exports name) exports args))
  (defun capacity-p (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0002"))
  (defun trap-runtime (first-name next-name replacement)
    (let* ((text (js-call (readFileSync (resolve root "bootstrap/runtime/memory.eli")) :toString "utf8"))
           (first (js-call text :indexOf (+ "  (defun " first-name " ")))
           (last (js-call text :indexOf (+ "  (defun " next-name " ") first)))
      (js-call assert :ok (and (>= first 0) (> last first)))
      (js-call (compiler) :compile_ir_string (+ (js-call text :slice 0 first) "  " replacement "\n" (js-call text :slice last))
        (+ first-name "-trap.eli"))))
  (defun writeFileSync (path text)
    (funcall (get (funcall (createRequire (resolve root "package.json")) "node:fs") :writeFileSync) path text))
  (defun node-oracle (mode path)
    (let* ((env (Object/assign (js-object) (get globalThis.process :env) (js-object :ELISCRIPT_HOST_SCOPE_NODE mode)))
           (binary (get env :NODE_BINARY "node"))
           (child (spawnSync binary (js-array "--experimental-vm-modules" (resolve root "tests/compiler-host-scope-selfhosted.test.mjs") path)
                    (js-object :cwd root :env env :encoding "utf8" :timeout 10000 :maxBuffer 4194304))))
      (js-call assert :strictEqual (get child :error) undefined)
      (js-call assert :strictEqual (get child :signal) nil)
      (js-call assert :strictEqual (get child :status) 0
        (str (get child :stderr) "\n" (get child :stdout)))
      (js-call (get child :stdout) :trim)))
  (defasync run-node ()
    (let* ((path (aref (get globalThis.process :argv) 2)) (context (js-call vm :createContext (js-object)))
           (dependencies (new globalThis.Map))
           (module (new (get vm :SourceTextModule) (js-call (readFileSync path) :toString "utf8")
             (js-object :context context))))
      (await (js-call module :link (async (specifier referrer)
        (let* ((runtime-file
                 (cond ((= specifier "eliscript/runtime/math.mjs") "runtime/math.mjs")
                       ((= specifier "eliscript/runtime/unicode-case.mjs") "runtime/unicode-case.mjs")
                       ((and (= specifier "./unicode-case-data.mjs")
                             (= (get referrer :identifier) (get (pathToFileURL (resolve root "runtime/unicode-case.mjs")) :href)))
                        "runtime/unicode-case-data.mjs")
                       (t nil)))
               (identity (if runtime-file (get (pathToFileURL (resolve root runtime-file)) :href) specifier)))
          (if (js-call dependencies :has identity) (js-call dependencies :get identity)
            (let ((dependency
              (if runtime-file
                ;; The real complete runtime executes in the oracle realm,
                ;; before the program freezes or mutates its prototypes.
                (new (get vm :SourceTextModule)
                  (js-call (readFileSync (resolve root runtime-file)) :toString "utf8")
                  (js-object :context context :identifier identity))
                (progn
                  (unless (js-call specifier :startsWith "data:text/javascript;base64,")
                    (throw (new globalThis.Error (+ "unexpected oracle dependency: " specifier))))
                  ;; These are the original immutable intrinsic capsules.
                  (let* ((loaded (await (loadManagedHostModules (js-object :hostModules
                            (js-array (js-object :id "capsule" :specifier specifier :referrer "scope-oracle.mjs"
                              :allowedExports (js-array) :namespace t)))
                            (js-object :moduleBaseURL (pathToFileURL path)))))
                         (namespace (js-call loaded :get "capsule")) (names (Object/keys namespace)) (synthetic nil))
                    (setq synthetic (new (get vm :SyntheticModule) names
                      (lambda () (each names (lambda (name) (js-call synthetic :setExport name (get namespace name)))))
                      (js-object :context context :identifier identity))) synthetic)))))
              (js-call dependencies :set identity dependency)
              dependency))))))
      (await (js-call module :evaluate))
      (let* ((namespace (get module :namespace))
             (result (if (= node-mode "frozen-prefix") (js-call namespace :prototype_prefix) (JSON/stringify (js-call namespace :run)))))
        (js-call (get globalThis.process :stdout) :write result))))

  (if (nullish? node-mode) (register-cases)
    (js-call (run-node) :catch (lambda (error)
      (js-call globalThis.console :error error) (put globalThis.process :exitCode 1))))
)
