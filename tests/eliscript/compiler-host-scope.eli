    (test "Seed-produced JavaScript emitter and the original helper oracle retain the same small-program output"
      (async ()
        (let* ((legacy (await (readFile (resolve root "tests/wasm-compiler-emitter.test.mjs") "utf8")))
               (marker "const corpus=[") (start (js-call legacy :indexOf marker))
               (cases (js-call (js-call (js-call legacy :slice (+ start (js-length marker))) :split "','") :slice 0 4))
               (input (resolve directory "seed-programs.json")) (output (resolve directory "seed-emissions.json")))
          (js-call assert :ok (>= start 0))
          (put cases 0 (js-call (aref cases 0) :slice 1))
          (js-call assert :strictEqual (js-length cases) 4)
          (await (writeFile input (JSON/stringify cases)))
          (let* ((script (js-call (js-array
                   "(progn (require 'json) (require 'eliscript)"
                   " (let* ((cases (with-temp-buffer (insert-file-contents (getenv \"ELISCRIPT_SCOPE_INPUT\")) (json-parse-buffer :array-type 'list)))"
                   "        (values (mapcar (lambda (source)"
                   "          (let ((emission (eliscript-compile-string-with-source-map source \"input.eli\" \"out.mjs\" \"input.eli\")))"
                   "           `((javascript . ,(eliscript-emission-javascript emission))"
                   "             (sourceMap . ,(json-parse-string (eliscript-emission-source-map emission)))))) cases)))"
                   "  (let ((coding-system-for-write 'utf-8-unix))"
                   "   (with-temp-file (getenv \"ELISCRIPT_SCOPE_OUTPUT\")"
                   "    (insert (decode-coding-string (json-serialize (vconcat values)) 'utf-8-unix)))))))") :join "\n"))
                 (env (Object/assign (js-object) (get globalThis.process :env)
                   (js-object :ELISCRIPT_SCOPE_INPUT input :ELISCRIPT_SCOPE_OUTPUT output)))
                 (child (spawnSync (get env :EMACS "emacs") (js-array "--batch" "-Q" "-L" "compiler" "--eval" script)
                   (js-object :cwd root :env env :encoding "utf8" :timeout 30000 :maxBuffer 4194304))))
            (js-call assert :strictEqual (get child :error) undefined)
            (js-call assert :strictEqual (get child :signal) nil)
            (js-call assert :strictEqual (get child :status) 0 (get child :stderr)))
          (let ((expected (JSON/parse (await (readFile output "utf8")))) (index 0))
            (while (< index 4)
              (let* ((source (aref cases index)) (program (js-call (compiler) :compile_ir_string source "input.eli"))
                     (emission (js-call (compiler) :emit_ir_string_with_source_map program source "out.mjs" "input.eli")))
                (js-call assert :strictEqual (js-call (compiler) :emit_ir_string program) (get (aref expected index) :javascript))
                (js-call assert :strictEqual (get emission :javascript) (get (aref expected index) :javascript))
                (js-call assert :deepStrictEqual (JSON/parse (get emission :sourceMap)) (get (aref expected index) :sourceMap)))
              (setq index (1+ index)))))))

