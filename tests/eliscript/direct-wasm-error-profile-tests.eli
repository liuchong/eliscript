(module tests.direct-wasm-error-profile-tests
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "./helpers/direct-wasm-error-profile.mjs" assertDirectReflectionProfile)
  (test "the declared Error profile retains complete actual host reflection and classifies every extra member separately"
    (lambda ()
      (let* ((keys (Object/keys globalThis.Error)) (names (Object/getOwnPropertyNames globalThis.Error))
             (before (JSON/stringify (js-array keys names)))
             (standard (js-array "length" "name" "prototype"))
             (report (assertDirectReflectionProfile 3 (js-array) standard keys names)))
        (js-call assert :deepStrictEqual (get report :keys) (js-array))
        (js-call assert :deepStrictEqual (get report :names) standard)
        (js-call assert :deepStrictEqual (get report :hostKeys) keys)
        (js-call assert :deepStrictEqual (get report :hostNames) names)
        (js-call assert :notStrictEqual (get report :hostKeys) keys)
        (js-call assert :notStrictEqual (get report :hostNames) names)
        (js-call assert :deepStrictEqual (get report :hostExtensions)
          (js-call names :filter (lambda (name) (not (js-call standard :includes name)))))
        (js-call assert :strictEqual (JSON/stringify (js-array keys names)) before)
        (js-call assert :deepStrictEqual (Object/getOwnPropertyNames globalThis.Error) names)
        (js-call assert :deepStrictEqual (Object/keys globalThis.Error) keys)
        (when (and (undefined? (get (get globalThis.process :versions) :bun))
                   (js-call (get (get globalThis.process :versions) :node) :startsWith "24."))
          (js-call (js-array "captureStackTrace" "stackTraceLimit" "isError") :forEach (lambda (name)
            (js-call assert :ok (js-call (get report :hostExtensions) :includes name) name)))
          (js-call assert :ok (js-call (get report :hostKeys) :includes "stackTraceLimit")))
        (js-call names :forEach (lambda (name)
          (js-call assert :ok (Object/getOwnPropertyDescriptor globalThis.Error name)))))))
  (test "Error standard keys and names remain strict and every other constructor still requires full host parity"
    (lambda ()
      (let ((standard (js-array "length" "name" "prototype")))
        (js-call assert :throws (lambda () (assertDirectReflectionProfile 3 (js-array "wrong") standard
          (Object/keys globalThis.Error) (Object/getOwnPropertyNames globalThis.Error))) (new globalThis.RegExp "keys mode=3"))
        (js-call assert :throws (lambda () (assertDirectReflectionProfile 3 (js-array) (js-array "name" "length" "prototype")
          (Object/keys globalThis.Error) (Object/getOwnPropertyNames globalThis.Error))) (new globalThis.RegExp "names mode=3"))
        (js-call (js-array (js-array 0 globalThis.Number) (js-array 1 globalThis.String)
                          (js-array 2 globalThis.Symbol) (js-array 4 Number/isFinite)) :forEach
          (lambda (row)
            (let* ((mode (aref row 0)) (owner (aref row 1))
                   (keys (Object/keys owner)) (names (Object/getOwnPropertyNames owner)))
              (assertDirectReflectionProfile mode keys names keys names)
              (js-call assert :throws (lambda () (assertDirectReflectionProfile mode
                (js-call keys :concat (js-array "not-a-real-key")) names keys names)) (new globalThis.RegExp "keys mode="))
              (js-call assert :throws (lambda () (assertDirectReflectionProfile mode
                keys (js-call names :concat (js-array "not-a-real-name")) keys names)) (new globalThis.RegExp "names mode="))))))))
)
