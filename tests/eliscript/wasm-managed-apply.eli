(module tests.wasm-managed-apply
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "./helpers/managed-numeric-selfhosted.mjs" loadReference)
  (import "./helpers/managed-apply-node-selfhosted.mjs" wrapper-program
    exercise-wrappers exercise-receivers exercise-order exercise-iterators exercise-throws)
  (defvar directory undefined) (defvar backend undefined) (defvar runtime-ir undefined)
  (defvar fixture undefined) (defvar lowered undefined) (defvar bytes undefined)
  (defvar reference undefined) (defvar native-path undefined)
  (defconst native-target (when (= (get globalThis.process :arch) "arm64")
    (cond ((= (get globalThis.process :platform) "darwin") "arm64-macos")
          ((= (get globalThis.process :platform) "linux") "arm64-linux"))))
  (defconst native-test (js-call test :skipIf (not native-target)))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-apply-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime-ir (js-call (get backend :compiler) :compile_ir_string
      (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
    (setq fixture (wrapper-program (get backend :compiler)
      (await (readFile (resolve root "stdlib/managed-runtime-transient.eli") "utf8"))
      (await (readFile (resolve root "stdlib/managed-runtime-data.eli") "utf8"))))
    (setq lowered (js-call (get backend :managed) :lower_managed_program (get fixture :program) runtime-ir))
    (setq bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm (get fixture :program) runtime-ir)))
    (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
    (await (writeFile (resolve directory "apply.wasm") bytes))
    (setq reference (await (loadReference (resolve directory "reference.mjs")
      (js-call (get backend :compiler) :emit_ir_string (get fixture :program)))))
    (when native-target
      (setq native-path (resolve directory (if (= native-target "arm64-macos") "apply.dylib" "apply.so")))
      (await (writeFile native-path (globalThis.Uint8Array.from
        (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target)))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defun close-runtime (runtime)
    (js-call runtime :closeModule) (js-call runtime :collect)
    (js-call assert :strictEqual (js-call runtime :live) 0)
    (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
  (defun capacity-error (error)
    (and error (not (nullish? (get error :eliscriptDiagnostic)))
      (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0002")))
  (defasync runtime-for (target options)
    (if (= target "wasm") (instantiateManagedRuntime bytes options)
      (await (instantiateNativeManagedRuntime native-path lowered options))))
  (test "apply wrapper regression uses all five exact maintained function nodes without changing their source IR"
    (lambda ()
      (js-call assert :strictEqual (JSON/stringify (get fixture :original)) (get fixture :originalText))
      (js-call assert :strictEqual (JSON/stringify (get fixture :dataOriginal)) (get fixture :dataText))
      (let* ((wrappers (get fixture :wrappers)) (body (get (get fixture :program) :body))
             (references (get fixture :wrapperExports))
             (exports (js-call body :filter (lambda (node) (= (get node :kind) "export-declaration"))))
             (index 0))
        (js-call assert :strictEqual (js-length wrappers) 5)
        (js-call assert :strictEqual (js-length references) 5)
        (js-call assert :strictEqual (js-length exports) 1)
        (while (< index (js-length wrappers))
          (js-call assert :strictEqual (Object/is (aref wrappers index) (aref body index)) t)
          (js-call assert :strictEqual (get (aref references index) :value) (get (aref wrappers index) :value))
          (js-call assert :strictEqual
            (js-call (get (aref exports 0) :children) :includes (aref references index)) t)
          (let ((span (get (aref wrappers index) :span)))
            (js-call assert :ok (> (get span :end) (get span :start))))
          (let ((span (get (aref references index) :span)))
            (js-call assert :ok (> (get span :end) (get span :start))))
          (setq index (1+ index))))))
  (test "real WASM preserves the five maintained apply wrappers rest forwarding closures and aliases under GC"
    (lambda () (let ((runtime (instantiateManagedRuntime bytes)))
      (try (exercise-wrappers runtime reference) (finally (close-runtime runtime))))) 30000)
  (native-test "real native executes the same five maintained wrappers without using WASM"
    (async ()
      (let* ((old-module (get globalThis.WebAssembly :Module))
             (old-instance (get globalThis.WebAssembly :Instance))
             (reject (lambda (&rest arguments) (throw (new globalThis.Error "native apply must not execute WASM"))))
             (runtime undefined))
        (try
          (put globalThis.WebAssembly :Module (new globalThis.Proxy old-module (js-object :apply reject :construct reject)))
          (put globalThis.WebAssembly :Instance (new globalThis.Proxy old-instance (js-object :apply reject :construct reject)))
          (setq runtime (await (runtime-for "native" (js-object))))
          (exercise-wrappers runtime reference)
          (finally
            (try (when runtime (close-runtime runtime))
              (finally (put globalThis.WebAssembly :Module old-module) (put globalThis.WebAssembly :Instance old-instance))))))) 30000)
  (test "real WASM retains direct property References but leaves default Get results unbound"
    (lambda () (let ((runtime (instantiateManagedRuntime bytes)))
      (try (exercise-receivers runtime reference) (finally (close-runtime runtime))))) 30000)
  (native-test "real native retains direct property References but leaves default Get results unbound"
    (async () (let ((runtime (await (runtime-for "native" (js-object)))))
      (try (exercise-receivers runtime reference) (finally (close-runtime runtime))))) 30000)
  (test "real WASM captures the apply callee before the once-evaluated iterable expression"
    (lambda () (let ((runtime (instantiateManagedRuntime bytes)))
      (try (exercise-order runtime reference) (finally (close-runtime runtime))))) 30000)
  (native-test "real native captures the apply callee before the once-evaluated iterable expression"
    (async () (let ((runtime (await (runtime-for "native" (js-object)))))
      (try (exercise-order runtime reference) (finally (close-runtime runtime))))) 30000)
  (test "real WASM consumes the stepwise apply iterator and preserves getter and next first throws"
    (lambda () (let ((runtime (instantiateManagedRuntime bytes)))
      (try (exercise-iterators runtime reference) (finally (close-runtime runtime))))) 30000)
  (native-test "real native consumes the stepwise apply iterator and preserves getter and next first throws"
    (async () (let ((runtime (await (runtime-for "native" (js-object)))))
      (try (exercise-iterators runtime reference) (finally (close-runtime runtime))))) 30000)
  (test "real WASM rejects noniterables and retains the exact false operand throw with recovery"
    (lambda () (let ((runtime (instantiateManagedRuntime bytes)))
      (try (exercise-throws runtime reference) (finally (close-runtime runtime))))) 30000)
  (native-test "real native rejects noniterables and retains the exact false operand throw with recovery"
    (async () (let ((runtime (await (runtime-for "native" (js-object)))))
      (try (exercise-throws runtime reference) (finally (close-runtime runtime))))) 30000)
  (test "apply retains the borrowed negative-zero argument caller frame and alias through real capacity failure and recovery"
    (async ()
      (let ((targets (if native-target (js-array "wasm" "native") (js-array "wasm"))) (index 0))
        (while (< index (js-length targets))
          (let* ((runtime (await (runtime-for (aref targets index)
                           (js-object :maxSlots 256 :initialBytes 8192 :maxBytes 65536))))
                 (value (js-call runtime :number -0)) (tail (js-call runtime :sourceArray))
                 (caller (js-call runtime :frame 1)) (padding (js-array)) (failed false))
            (js-call runtime :auto 1) (js-call runtime :frameSet caller 0 value)
            (try
              (while (and (not failed) (< (js-length padding) 256))
                (try (js-call padding :push (js-call runtime :array))
                  (catch error (js-call assert :ok (capacity-error error) error) (setq failed t))))
              (js-call assert :strictEqual failed t)
              (js-call assert :throws (lambda () (js-call runtime :invoke "alias" (js-array value tail))) capacity-error)
              (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 1)
              (assert (Object/is (js-call runtime :readNumber value) -0))
              (js-call padding :forEach (lambda (item) (js-call runtime :release item))) (setq padding (js-array))
              (js-call runtime :collect)
              (let ((result (js-call runtime :invoke "alias" (js-array value tail))))
                (try (assert (js-call runtime :keyEqual result value)) (assert (Object/is (js-call runtime :readNumber result) -0))
                  (finally (js-call runtime :release result))))
              (finally
                (js-call padding :forEach (lambda (item) (js-call runtime :release item)))
                (js-call runtime :leaveFrame caller) (js-call runtime :release value) (js-call runtime :release tail)
                (close-runtime runtime))))
          (setq index (1+ index))))) 30000)
  (test "three-operand prefix apply remains a source-bound refusal and never mutates the original program"
    (lambda ()
      (let* ((ir (js-call (get backend :compiler) :compile_ir_string
                   "(defun f (callee values) (apply callee 7 values)) (export f)" "invalid-prefix-apply.eli"))
             (before (JSON/stringify ir)))
        (js-call assert :throws (lambda () (js-call (get backend :managed) :lower_managed_program ir runtime-ir))
          (lambda (error)
            (let ((diagnostic (get error :eliscriptDiagnostic)))
              (js-call assert :ok diagnostic error)
              (js-call assert :strictEqual (get diagnostic :code) "ELI-B0001")
              (js-call assert :strictEqual (get (get diagnostic :location) :file) "invalid-prefix-apply.eli") t)))
        (js-call assert :strictEqual (JSON/stringify ir) before))))
  (test "independent Node executes the actual emitted JS oracle and identical WASM wrapper artifact"
    (lambda ()
      (let ((child (spawnSync "node" (js-array (resolve root "tests/helpers/managed-apply-node-selfhosted.mjs")
                     (resolve directory "apply.wasm") (resolve directory "reference.mjs"))
                   (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :strictEqual (get child :error) undefined)
        (js-call assert :strictEqual (get child :signal) nil)
        (js-call assert :strictEqual (get child :status) 0 (get child :stderr)))))
)
