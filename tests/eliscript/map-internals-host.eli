(module tests.map-internals-host
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "../runtime/core/map-internals.mjs"
    EMPTY_BITMAP_NODE MapEntry BitmapIndexedNode ArrayNode HashCollisionNode
    mapFind mapAssoc mapDissoc mapAssocTransient mapDissocTransient mapEntries
    resetMapMetrics readMapMetrics resetTransientMapMetrics readTransientMapMetrics)

  (defconst missing (funcall globalThis.Symbol "map-host-test.missing"))
  (defconst iterator-key (get globalThis.Symbol :iterator))
  (defun iterator-result (value done) (js-object :value value :done done))
  (defun observed-iterable (events label next close)
    (let ((iterable (js-object)))
      (put iterable iterator-key (lambda ()
        (js-call events :push (str label ".open"))
        (js-object :next next :return close))) iterable))

  (test "Eli HAMT composes persistent and owner-edited branches without mutating retained roots"
    (lambda ()
      (let ((root EMPTY_BITMAP_NODE) (snapshots (js-array)) (index 0))
        (resetMapMetrics) (resetTransientMapMetrics)
        (while (< index 32)
          (js-call snapshots :push root)
          (let ((result (mapAssoc root index (str "key-" index) index)))
            (js-call assert :strictEqual (get result :added) t)
            (setq root (get result :item)))
          (setq index (1+ index)))
        (js-call assert :strictEqual (Object/getPrototypeOf root) (get ArrayNode :prototype))
        (js-call assert :strictEqual (get (readMapMetrics) :promotions) 1)
        (js-call assert :strictEqual (mapFind (get snapshots 31) 31 "key-31" missing) missing)
        (js-call assert :strictEqual (get (mapAssoc root 17 "key-17" 17) :item) root)
        (let* ((retained root) (owner (js-object))
               (edited (get (mapAssocTransient root owner 17 "key-17" 100) :item)))
          (js-call assert :notStrictEqual edited retained)
          (let ((clones (get (readTransientMapMetrics) :nodeClones)))
            (js-call assert :strictEqual (get (mapAssocTransient edited owner 18 "key-18" 101) :item) edited)
            (js-call assert :strictEqual (get (readTransientMapMetrics) :nodeClones) clones))
          (js-call assert :strictEqual (mapFind retained 17 "key-17" missing) 17)
          (js-call assert :strictEqual (mapFind edited 17 "key-17" missing) 100)
          (setq index 0)
          (while (< index 8)
            (setq root (get (mapDissoc root index (str "key-" index)) :item))
            (setq edited (get (mapDissocTransient edited owner index (str "key-" index)) :item))
            (setq index (1+ index)))
          (js-call assert :strictEqual (Object/getPrototypeOf root) (get BitmapIndexedNode :prototype))
          (js-call assert :strictEqual (Object/getPrototypeOf edited) (get BitmapIndexedNode :prototype))
          (js-call assert :strictEqual (js-length (Array/from (mapEntries root))) 24)
          (js-call assert :strictEqual (mapFind retained 0 "key-0" missing) 0))
        (let* ((first (get (mapAssoc EMPTY_BITMAP_NODE 7 "left" 1) :item))
               (collision (get (mapAssoc first 7 "right" 2) :item))
               (remaining (get (mapDissoc collision 7 "left") :item)))
          (js-call assert :strictEqual (mapFind first 7 "right" missing) missing)
          (js-call assert :strictEqual (mapFind collision 7 "left" missing) 1)
          (js-call assert :strictEqual (mapFind collision 7 "right" missing) 2)
          (js-call assert :strictEqual (mapFind remaining 7 "left" missing) missing)
          (js-call assert :strictEqual (mapFind remaining 7 "right" missing) 2)))))

  (test "HAMT host class views retain constructor contracts and lazy iterator closing"
    (lambda ()
      (js-call assert :strictEqual (get MapEntry :length) 3)
      (js-call assert :strictEqual (get BitmapIndexedNode :length) 0)
      (js-call assert :strictEqual (get ArrayNode :length) 2)
      (js-call assert :strictEqual (get HashCollisionNode :length) 2)
      (js-call assert :throws (lambda () (funcall MapEntry "key" 1 0)) globalThis.TypeError)
      (js-call assert :throws (lambda () (new mapEntries EMPTY_BITMAP_NODE)) globalThis.TypeError)
      (let* ((entry (new MapEntry "key" 1 7)) (events (js-array)) (position 0)
             (items (observed-iterable events "items"
               (lambda () (setq position (1+ position)) (iterator-result entry (> position 1)))
               (lambda () (js-call events :push "items.close") (iterator-result undefined t))))
             (node (new HashCollisionNode 7 items)) (iterator (mapEntries node)))
        (js-call assert :strictEqual (Object/isFrozen entry) t)
        (js-call assert :strictEqual (js-length events) 0)
        (js-call assert :strictEqual (js-call iterator iterator-key) iterator)
        (js-call assert :strictEqual (get (js-call iterator :next) :value) entry)
        (js-call assert :deepStrictEqual events (js-array "items.open"))
        (js-call assert :deepStrictEqual (js-call iterator :return "closed") (iterator-result "closed" t))
        (js-call assert :deepStrictEqual events (js-array "items.open" "items.close"))
        (js-call assert :deepStrictEqual (js-call iterator :next) (iterator-result undefined t))
        (js-call assert :throws (lambda () (Reflect/apply (get iterator :next) (js-object) (js-array))) globalThis.TypeError)
        (let ((unstarted (mapEntries node)))
          (js-call assert :deepStrictEqual (js-call unstarted :return 12) (iterator-result 12 t))
          (js-call assert :deepStrictEqual events (js-array "items.open" "items.close"))))))

  (test "HAMT delegated iteration preserves the thrown value when iterator return also fails"
    (lambda ()
      (let* ((events (js-array)) (original (js-object :original t)) (closing (js-object :closing t))
             (entry (new MapEntry "key" 1 7))
             (items (observed-iterable events "items" (lambda () (iterator-result entry false))
               (lambda () (js-call events :push "items.close") (throw closing))))
             (iterator (mapEntries (new HashCollisionNode 7 items))))
        (js-call iterator :next)
        (js-call assert :throws (lambda () (js-call iterator :throw original)) (lambda (error) (eq error original)))
        (js-call assert :deepStrictEqual events (js-array "items.open" "items.close"))
        (js-call assert :deepStrictEqual (js-call iterator :next) (iterator-result undefined t)))))

  (test "HAMT step failures close suspended parents but do not close the failing iterator"
    (lambda ()
      (let* ((events (js-array)) (failure (js-object :failure t))
             (children (observed-iterable events "child" (lambda () (throw failure))
               (lambda () (js-call events :push "child.close") (iterator-result undefined t))))
             (child (new HashCollisionNode 7 children))
             (parents (observed-iterable events "parent" (lambda () (iterator-result child false))
               (lambda () (js-call events :push "parent.close") (iterator-result undefined t))))
             (iterator (mapEntries (new BitmapIndexedNode 1 parents))))
        (js-call assert :throws (lambda () (js-call iterator :next)) (lambda (error) (eq error failure)))
        (js-call assert :deepStrictEqual events (js-array "parent.open" "child.open" "parent.close"))
        (js-call assert :deepStrictEqual (js-call iterator :next) (iterator-result undefined t)))))
  )
