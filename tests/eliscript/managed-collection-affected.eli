        ;; two exported reads above. Closing that realm releases its roots;
        ;; caller-root and frame cleanup must still reach exactly zero.
        (finally (js-call a :closeModule) (finish a roots)))))
  (defasync sourceCollectionNormalCapacity ()
    (let* ((state (await (prepareManagedCollectionCases))) (a (instance state)) (map (js-call a :invoke "empty-map")))
      (try
        (progn
          (let ((index 0)) (while (< index 512)
            (let ((key (js-call a :number index)))
              (try (js-call a :release (js-call a :invoke "set-value" (js-array map key t))) (finally (js-call a :release key))))
            (setq index (1+ index))))
          (eqv (invoke-value a "size" (js-array map)) 512)
          (let ((index 0)) (while (< index 512)
            (let ((key (js-call a :number index)))
              (try (eqv (invoke-value a "lookup" (js-array map key)) t) (finally (js-call a :release key))))
            (setq index (1+ index))))
          (eqv (get (js-call a :stats) :frameDepth) 0))
        (finally (finish a (js-array map))))))
  (defasync collectionForEachNormalCapacity ()
    (let ((state (await (prepareManagedCollectionCases))))
      (each (js-array false t) (lambda (set)
        (let* ((a (instance state)) (items (js-call a :invoke (if set "empty-set" "empty-map")))
               (log (js-call a :sourceArray (js-array))) (callback (js-call a :invoke "record-callback" (js-array log)))
               (caller undefined))
          (try
            (progn
              (let ((index 0)) (while (< index 128)
                (let* ((key (js-call a :number index)) (value (if set (js-call a :number index) t)))
                  (try (js-call a :release (js-call a :invoke (if set "add-value" "set-value")
                    (if set (js-array items value) (js-array items key value))))
                    (finally (js-call a :release key) (js-call a :release value))))
                (setq index (1+ index))))
              (setq caller (js-call a :frame 1)) (js-call a :frameSet caller 0 items)
              (eqv (invoke-value a "for-each-with" (js-array items callback)) undefined)
              (eqv (js-call a :length log) 128) (eqv (get (js-call a :stats) :frameDepth) 1)
              (let ((held (js-call a :frameGet caller 0)))
                (try (ok (js-call a :keyEqual held items)) (finally (js-call a :release held)))))
            (finally (unless (undefined? caller) (js-call a :leaveFrame caller)) (finish a (js-array items log callback)))))))))
  (defconst sourceCollectionCases (js-object))
  (put sourceCollectionCases "lexical constructor shadows retain their actual values and supported ignored operands preserve JS effects" lexical-case)
  (put sourceCollectionCases "real lookup, call and iterator traps preserve argument order, caller frames and owned graph cleanup" trap-case)
  (put sourceCollectionCases "malformed collection IR and ignored unsupported raw operands are source-bound refusals" malformed-case)
  (put sourceCollectionCases "missing members stay undefined, supported methods are canonical callable values and unimplemented methods remain refused" members-case)
  (export prepareManagedCollectionCases closeManagedCollectionCases sourceCollectionCases
    sourceCollectionNormalCapacity collectionForEachNormalCapacity))
