(module tests.managed-collection-affected
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "../../tools/backends/build.mjs" root buildBackends)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../../tools/testing/fixture-environment.mjs" prepareFixtureEnvironment)
  (import "../../dist/bootstrap/ir.mjs" validate-serializable-program)
  (import "./managed-browser-transport.mjs" loadManagedReference)
  (defvar fixture undefined)
  (defvar pending undefined)
  (defun eqv (a b &optional message) (js-call assert :strictEqual a b message))
  (defun deep (a b &optional message) (js-call assert :deepStrictEqual a b message))
  (defun ok (value &optional message) (js-call assert :ok value message))
  (defun each (items callback) (js-call items :forEach callback))
  (defasync each-await (items callback)
    (let ((index 0)) (while (< index (js-length items)) (await (funcall callback (aref items index))) (setq index (1+ index)))))
  (defun fail-code (code) (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) code)))
  (defun read-value (a value)
    (if (or (not value) (/= (value-type value) "object")) value
      (cond ((= (get value :kind) 4) (js-call a :readNumber value))
            ((= (get value :kind) 5) (js-call a :readString value))
            ((= (get value :kind) 14)
              (Array/from (js-object :length (js-call a :length value)) (lambda (ignored index)
                (let ((child (js-call a :get value index))) (try (read-value a child) (finally (js-call a :release child)))))))
            ((= (get value :kind) 13)
              (let ((output (js-object)) (keys (js-call a :objectKeys value)))
                (try (let ((index 0)) (while (< index (js-call a :length keys))
                  (let* ((key (js-call a :get keys index)) (child (js-call a :objectGet value key)))
                    (try (Object/defineProperty output (js-call a :readString key)
                           (js-object :value (read-value a child) :enumerable t :writable t :configurable t))
                      (finally (js-call a :release key) (js-call a :release child))))
                  (setq index (1+ index)))) (finally (js-call a :release keys))) output))
            (t value))))
  (defun invoke-value (a name args)
    (let ((value (js-call a :invoke name args))) (try (read-value a value) (finally (js-call a :release value)))))
  (defun finish (a values)
    (each values (lambda (value) (js-call a :release value))) (js-call a :collect)
    (eqv (js-call a :live) 0) (eqv (get (js-call a :stats) :frameDepth) 0))
  (defasync prepareManagedCollectionCases ()
    (unless pending (setq pending (funcall (async ()
      (setq fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
      (let* ((directory (get fixture :directory)) (b (await (buildBackends (js-object :outputRoot directory))))
             (raw (await (readFile (resolve root "tests/wasm-managed-source-collections-test-legacy.mjs") "utf8")))
             (begin (+ (js-call raw :indexOf "const supportedCollectionSource=`") (js-length "const supportedCollectionSource=`")))
             (end (js-call raw :indexOf "`;\nbeforeAll" begin))
             (source (await (readFile (resolve root "tests/fixtures/wasm-managed-source-collections.eli") "utf8")))
             (runtime-source (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8"))))
        (ok (and (> begin (js-length "const supportedCollectionSource=`")) (> end begin)))
        (setq source (js-call source :replace "  (export " (+ (js-call raw :slice begin end)
          "  (defun collection-shadow-missing (value name) (put value name undefined) (get value name))\n"
          "  (defun collection-delete-prototype-member (value name) (Reflect/deleteProperty (Object/getPrototypeOf value) name) (get value name))\n"
          "  (export collection-shadow-missing collection-delete-prototype-member)\n  (export ")))
        (let* ((compiler (get b :compiler)) (runtime (js-call compiler :compile_ir_string runtime-source "runtime.eli"))
               (program (js-call compiler :compile_ir_string source "source-collections.eli")) (before (JSON/stringify program))
               (bytes (globalThis.Uint8Array.from (js-call (get b :managed) :emit_managed_wasm program runtime))))
          (eqv (JSON/stringify program) before) (eqv (globalThis.WebAssembly.validate bytes) t)
          (deep (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
          (js-object :b b :runtime runtime :runtimeSource runtime-source :program program :bytes bytes
            :js (await (loadManagedReference directory (js-call compiler :emit_ir_string program) "source-collections")))))))))
    (await pending))
  (defun closeManagedCollectionCases () (when fixture (js-call fixture :close) (setq fixture undefined)))
  (defun instance (state)
    (let ((a (instantiateManagedRuntime (get state :bytes)))) (js-call a :auto 1) a))
  (defasync lexical-case ()
    (let* ((state (await (prepareManagedCollectionCases))) (a (instance state)) (js (get state :js))
           (failed false))
      (try
        (progn
          (each (js-array "supported-operands" "successful-shadows") (lambda (name)
            (let ((trace (js-call a :sourceArray (js-array))) (expected (js-array)))
              (try
                (deep (invoke-value a name (js-array trace)) (funcall (get js (js-call name :replaceAll "-" "_")) expected))
                (deep (read-value a trace) expected)
                (finally (js-call a :release trace))))))
          (each (js-array "shadow-map" "shadow-global" "shadow-global-object" "local-map-shadow" "local-global-shadow")
            (lambda (kind)
              (let* ((name (if (= kind "shadow-global-object") "shadow-global" kind))
                     (local (js-call name :startsWith "local-"))
                     (receiver (if (= kind "shadow-global-object") (js-call a :sourceObject (js-object :Map nil)) nil))
                     (host-receiver (if (= kind "shadow-global-object") (js-object :Map nil) nil))
                     (trace (js-call a :sourceArray (js-array))) (expected (js-array))
                     (code (if (or (= kind "shadow-global") (= kind "local-global-shadow")) "ELI-RT0001" "ELI-RT0003")))
                (try
                  (js-call assert :throws (lambda () (Reflect/apply (get js (js-call name :replaceAll "-" "_")) undefined
                    (if local (js-array expected) (js-array host-receiver expected)))) globalThis.TypeError)
                  (js-call assert :throws (lambda () (js-call a :invoke name (if local (js-array trace) (js-array receiver trace))))
                    (lambda (error) (and (= (get error :name) "TypeError") (funcall (fail-code code) error))))
                  (deep (read-value a trace) expected) (eqv (get (js-call a :stats) :frameDepth) 0)
                  (finally (js-call a :release trace) (js-call a :release receiver)))))))
        (catch error (setq failed t) (throw error))
        (finally (try (finish a (js-array)) (catch cleanup (unless failed (throw cleanup))))))))
  (defasync trap-case ()
    (let* ((state (await (prepareManagedCollectionCases))) (source (get state :runtimeSource))
           (specs (js-array
             (js-array "value-source-method-check" "heap value method" "has-extra" false)
             (js-array "value-collection-prototype-builtin" "heap receiver arguments count operation" "has-extra" 9)
             (js-array "value-source-iterator-advance" "heap iterator" "next-extra" 9)
             (js-array "value-source-query-check" "heap value method" "lookup" false)
             (js-array "value-source-method" "heap value method a b" "lookup" false))))
      (await (each-await specs (async (spec)
        (let* ((name (aref spec 0)) (entry (aref spec 2)) (start (js-call source :indexOf (+ "  (defun " name " ")))
               (end (js-call source :indexOf "  (defun " (+ start 3))))
          (ok (and (>= start 0) (> end start)))
          (let* ((injected (js-call (get (get state :b) :compiler) :compile_ir_string
                    (+ (js-call source :slice 0 start) "  (defun " name " (" (aref spec 1) ") (load-u32 4294967295))\n" (js-call source :slice end)) "source-map-trap.eli"))
                 (a (instantiateManagedRuntime (globalThis.Uint8Array.from (js-call (get (get state :b) :managed) :emit_managed_wasm (get state :program) injected))))
                 (ignored (js-call a :auto 1)) (map (js-call a :invoke "empty-map"))
                 (marker (js-call a :sourceArray (js-array false))) (key (js-call a :number 1))
                 (iterator (if (= name "value-source-iterator-advance") (js-call a :invoke "entries" (js-array map)) nil))
                 (frame (js-call a :frame 1)))
            (js-call a :frameSet frame 0 map)
            (js-call assert :throws (lambda () (js-call a :invoke entry
              (if iterator (js-array iterator marker) (if (= entry "lookup") (js-array map key) (js-array map key marker)))))
              globalThis.WebAssembly.RuntimeError)
            (eqv (get (js-call a :stats) :frameDepth) 1) (deep (read-value a marker) (js-array (aref spec 3)))
            (js-call a :leaveFrame frame) (finish a (js-array map marker key iterator)))))))))
  (defun caught (callback)
    (let ((failed false) (failure undefined))
      (try (funcall callback) (catch error (setq failed t failure error)))
      (ok failed "the complete original invalid input must be rejected") failure))
  (defun matching-refusal (state program filename schema)
    (let* ((before (JSON/stringify program))
           (expected (when schema (caught (lambda () (validate-serializable-program program)))))
           (error (caught (lambda () (js-call (get (get state :b) :managed) :emit_managed_wasm program (get state :runtime))))))
      (if schema
        (progn (eqv (get (get error :eliscriptDiagnostic) :code) "ELI-I0001")
          (deep (get error :eliscriptDiagnostic) (get expected :eliscriptDiagnostic))
          (eqv (get error :message) (get expected :message)))
        (progn (eqv (get (get error :eliscriptDiagnostic) :code) "ELI-B0001")
          (eqv (get (get (get error :eliscriptDiagnostic) :location) :file) filename)))
      (eqv (JSON/stringify program) before)))
  (defun constructor-node (program)
    (let ((pending (js-call (get program :body) :slice)) (found undefined))
      (while (and (> (js-length pending) 0) (undefined? found))
        (let ((node (js-call pending :shift)))
          (if (= (get node :kind) "constructor-call") (setq found node)
            (each (get node :children (js-array)) (lambda (child) (js-call pending :push child))))))
      (ok found "the malformed constructor fixture must actually mutate the constructor") found))
  (defasync malformed-case ()
    (let* ((state (await (prepareManagedCollectionCases))) (compiler (get (get state :b) :compiler)))
      (each (js-array
        "(defun f () (let ((Map nil)) (new (js* \"Map\") (js* \"unsupported()\"))))"
        "(defun f () (let ((globalThis nil)) (new globalThis.Set (js* \"unsupported()\"))))"
        "(defun f () (new globalThis.Map nil (js* \"unsupported()\")))"
        "(defun f () (if false (new globalThis.Array (js* \"unsupported()\")) nil))")
        (lambda (source) (matching-refusal state (js-call compiler :compile_ir_string (+ source " (export f)") "bad-collection.eli") "bad-collection.eli" false)))
      (let ((program (js-call compiler :compile_ir_string "(defun f () (new globalThis.Map)) (export f)" "bad-constructor.eli")))
        (put (constructor-node program) :children (js-array))
        (matching-refusal state program "bad-constructor.eli" false))
      (let ((index 0))
        (while (< index 4)
          (let* ((source (if (= index 1) "(defun f (m k) (js-call m :get k))" "(defun f () (new (js* \"Map\")))"))
                 (program (js-call compiler :compile_ir_string (+ source " (export f)") "hidden-collection-ir.eli")))
            (cond
              ((= index 0) (put (aref (get (constructor-node program) :children) 0) :children
                (js-array (js-object :kind "raw-javascript" :value "js*" :children (js-array)))))
              ((= index 1) (put (aref (get (aref (get (aref (get program :body) 0) :children) 2) :children) 1) :children
                (js-array (js-object :kind "raw-javascript" :value "js*" :children (js-array)))))
              ((= index 2) (put (aref (get (aref (get (constructor-node program) :children) 0) :children) 0) :properties (js-object :literalKind "symbol")))
              (t (put (aref (get (constructor-node program) :children) 0) :children (js-array nil))))
            (matching-refusal state program "hidden-collection-ir.eli" (/= index 2)))
          (setq index (1+ index))))))
  (defasync members-case ()
    (let* ((state (await (prepareManagedCollectionCases))) (a (instance state)) (js (get state :js))
           (m (js-call a :invoke "empty-map")) (s (js-call a :invoke "empty-set"))
           (iterator (js-call a :invoke "entries" (js-array m))) (roots (js-array m s iterator)))
      (try
        (progn
          (each (js-array (js-array m (js-array "next" "add" "map" "unknown"))
                         (js-array s (js-array "get" "set" "next" "map"))
                         (js-array iterator (js-array "get" "set" "has" "entries" "size")))
            (lambda (row) (each (aref row 1) (lambda (name)
              (let ((key (js-call a :string name)))
                (try (eqv (invoke-value a "read-value" (js-array (aref row 0) key)) undefined name) (finally (js-call a :release key))))))))
          (let* ((reference-map (new globalThis.Map (js-array (js-array "key" 7))))
                 (reference-set (new globalThis.Set (js-array "key")))
                 (key (js-call a :string "key")) (value (js-call a :number 7)) (other (js-call a :invoke "empty-map")))
            (each (js-array key value other) (lambda (v) (js-call roots :push v)))
            (js-call a :release (js-call a :invoke "set-value" (js-array m key value)))
            (js-call a :release (js-call a :invoke "add-value" (js-array s key)))
            (each (js-array
              (js-array m reference-map (js-array "get" "set" "has" "delete" "clear" "entries" "keys" "values" "forEach"))
              (js-array s reference-set (js-array "add" "has" "delete" "clear" "entries" "keys" "values" "forEach"))
              (js-array iterator (js-call reference-map :entries) (js-array "next")))
              (lambda (row) (each (aref row 2) (lambda (name)
                (let* ((label (js-call a :string name)) (first (js-call a :invoke "read-value" (js-array (aref row 0) label)))
                       (again (js-call a :invoke "read-value" (js-array (aref row 0) label)))
                       (name-key (js-call a :string "name")) (length-key (js-call a :string "length")))
                  (try (eqv (get first :kind) 18 name) (ok (js-call a :keyEqual first again) name)
                    (eqv (invoke-value a "read-value" (js-array first name-key)) (get (get (aref row 1) name) :name))
                    (eqv (invoke-value a "read-value" (js-array first length-key)) (get (get (aref row 1) name) :length))
                    (finally (each (js-array label first again name-key length-key) (lambda (v) (js-call a :release v))))))))))
            (each (js-array (js-array m reference-map "get" (js-array key) (js-array "key"))
              (js-array m reference-map "has" (js-array key) (js-array "key"))
              (js-array s reference-set "has" (js-array key) (js-array "key"))
              (js-array iterator (js-call reference-map :entries) "next" (js-array) (js-array)))
              (lambda (row)
                (let* ((name (aref row 2)) (k (js-call a :string name)) (fn (js-call a :invoke "read-value" (js-array (aref row 0) k)))
                       (trace (js-call a :sourceArray (js-array))) (expected (js-array)))
                  (try
                    (deep (invoke-value a "captured-call" (js-call (js-array fn (aref row 0)) :concat (aref row 3)))
                      (Reflect/apply (get (aref row 1) name) (aref row 1) (aref row 4)))
                    (js-call assert :throws (lambda () (js-call js :detached_call (get (aref row 1) name) (aref (aref row 4) 0) expected)) globalThis.TypeError)
                    (js-call assert :throws (lambda () (js-call a :invoke "detached-call" (js-array fn key trace))) (fail-code "ELI-RT0003"))
                    (deep (read-value a trace) expected)
                    (finally (each (js-array k fn trace) (lambda (v) (js-call a :release v))))))))
            (let* ((get-key (js-call a :string "get")) (first (js-call a :invoke "read-value" (js-array m get-key)))
                   (second (js-call a :invoke "read-value" (js-array other get-key)))
                   (trace (js-call a :sourceArray (js-array))) (expected (js-array)))
              (try (ok (js-call a :keyEqual first second))
                (eqv (invoke-value a "captured-get" (js-array m trace)) (js-call js :captured_get reference-map expected))
                (deep (read-value a trace) expected) (eqv (invoke-value a "read-value" (js-array m get-key)) false)
                (finally (each (js-array get-key first second trace) (lambda (v) (js-call a :release v))))))
            ;; Preserve the original six unsupported-method refusals. These
            ;; are not implemented by the backend's canonical method table.
            (each (js-array (js-array m (js-array "getOrInsert" "getOrInsertComputed"))
                (js-array s (js-array "union" "intersection"))
                (js-array iterator (js-array "map" "toArray")))
              (lambda (row) (each (aref row 1) (lambda (name)
                (let ((key (js-call a :string name)))
