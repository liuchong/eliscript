(module tests.managed-exceptions-browser
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "./helpers/managed-browser-transport.mjs" writeManagedReference bundleManagedBrowserPage serveManagedBrowserPage)
  (import "playwright-core" chromium firefox webkit)
  (defvar directory undefined) (defvar backend undefined) (defvar runtime undefined) (defvar scenarios undefined)
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve root ".eliscript-exception-browser-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
    (let ((catalog (JSON/parse (await (readFile "tests/fixtures/wasm-managed-behavior.json" "utf8")))))
      (setq scenarios (js-call (js-call (get catalog :features) :filter (lambda (feature)
        (js-call (js-array "Source exceptions" "Source Error construction" "Catch destructuring") :includes (get feature :name))))
        :flatMap (lambda (feature) (get feature :scenarios)))))
    (js-call assert :strictEqual (js-length scenarios) 14)) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))

  (test "the real browser compiles and executes every shared exception scenario with identical zero-import WASM bytes"
    (async ()
      (let* ((compiler (get backend :compiler)) (references (js-array)) (index 0)
             (bundle (await (bundleManagedBrowserPage (resolve root "tests/helpers/managed-exceptions-browser-page.mjs")
               (js-object "eliscript-test/compiler" (resolve directory "bootstrap/compiler.mjs")
                          "eliscript-test/managed" (resolve directory "backends/managed.mjs")))))
             (name (get (get globalThis.process :env) :ELISCRIPT_TEST_BROWSER "chromium"))
             (engines (js-object :chromium chromium :firefox firefox :webkit webkit)) (browser undefined)
             (evidence (js-array)))
        (while (< index (js-length scenarios))
          (let* ((scenario (aref scenarios index))
                 (source (str "(defconst marker 1)\n" (get scenario :source) "\n(export run)"))
                 (filename (str "bdd-" (get scenario :id) ".eli"))
                 (javascript (js-call compiler :emit_ir_string (js-call compiler :compile_ir_string source filename)))
                 (reference (await (writeManagedReference directory javascript (str "exception-reference-" index))))
                 (result (await (js-call globalThis.Bun :build
                   (js-object :entrypoints (js-array reference) :target "browser" :format "esm")))))
            (js-call assert :strictEqual (get result :success) t (str (get scenario :id) ": bundle actual JavaScript runtime dependencies"))
            (js-call references :push (js-object :javascript javascript :bundle (await (js-call (aref (get result :outputs) 0) :text)))))
          (setq index (1+ index)))
        (js-call assert :ok (Object/hasOwn engines name))
        (try
          (setq browser (await (js-call (get engines name) :launch)))
          (let ((page (await (js-call browser :newPage))))
            (setq index 0)
            (while (< index (js-length scenarios))
              (let* ((reference (aref references index))
                     (server (serveManagedBrowserPage bundle (get reference :bundle))))
                (try
                  (await (js-call page :goto (get (get server :url) :href)))
                  (await (js-call page :waitForFunction (lambda () (get globalThis.globalThis :__eliscriptExceptionScenario))))
                  (js-call evidence :push (await (js-call page :evaluate
                    (lambda (input) (funcall (get globalThis.globalThis :__eliscriptExceptionScenario) input))
                    (js-object :scenario (aref scenarios index) :runtime runtime :javascript (get reference :javascript)))))
                  (finally (js-call server :stop t))))
              (setq index (1+ index))))
          (let ((runtime-ir (js-call compiler :compile_ir_string runtime "runtime.eli")))
            (js-call assert :strictEqual (js-length evidence) 14)
            (setq index 0)
            (while (< index (js-length scenarios))
              (let* ((scenario (aref scenarios index))
                     (source (str "(defconst marker 1)\n" (get scenario :source) "\n(export run)"))
                     (filename (str "bdd-" (get scenario :id) ".eli"))
                     (expected (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm
                       (js-call compiler :compile_ir_string source filename) runtime-ir))))
                (js-call assert :strictEqual (get (aref evidence index) :id) (get scenario :id))
                (js-call assert :deepStrictEqual (globalThis.Uint8Array.from (get (aref evidence index) :bytes)) expected (get scenario :id)))
              (setq index (1+ index))))
          (finally (when browser (await (js-call browser :close))))))) 300000)
)
