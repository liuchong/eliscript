(module tests.initializer-array-fixture
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "../dist/bootstrap/compiler.mjs" compile-ir-string)
  (import "../tools/testing/initializer-array-fixture.mjs"
    initializerArrayMethods assertInitializerArrayRegistration projectInitializerArraySuite
    currentExpectationPlans projectCurrentSourceExpectations projectInitializerArraySource verifyInitializerShape sourceInitializerPart)
  (test "initializer registration checks its actual method-vector bound and keeps advancement inside that loop"
    (lambda ()
      (let* ((runtime (compile-ir-string (readFileSync (resolve root "bootstrap/runtime/memory.eli") "utf8") "runtime.eli"))
             (before (JSON/stringify runtime)))
        (assertInitializerArrayRegistration runtime)
        (js-call assert :strictEqual (JSON/stringify runtime) before)
        (let* ((bad (globalThis.structuredClone runtime)) (pending (js-call (get bad :body) :slice)))
          (while (> (js-length pending) 0)
            (let ((node (js-call pending :pop)))
              (when (and (= (get node :kind) "assignment-pair") (= (get node :value) "index"))
                (put node :value "lost-index"))
              (Reflect/apply (get pending :push) pending (get node :children))))
          (js-call assert :throws (lambda () (assertInitializerArrayRegistration bad)))))))
    (test "initializer suite projection preserves maintained source bytes outside its four authenticated repair regions"
    (lambda ()
      (let* ((source (readFileSync (resolve root "tests/wasm-managed-initializer-outlining.test.mjs") "utf8"))
             (proof (projectInitializerArraySource root source))
             (original (Array/from (get proof :original))) (actual (Array/from (get proof :source)))
             (changes (js-call (js-call (get proof :changes) :slice) :sort (lambda (a b) (- (get a :start) (get b :start)))))
             (original-cursor 0) (actual-cursor 0))
        (js-call assert :strictEqual (js-length changes) 4)
        (js-call changes :forEach (lambda (change)
          (let* ((start (get change :start)) (end (get change :end))
                 (unchanged (js-call original :slice original-cursor start))
                 (replacement (Array/from (get change :replacement))))
            (js-call assert :ok (and (>= start original-cursor) (> end start)))
            (js-call assert :deepStrictEqual (js-call actual :slice actual-cursor (+ actual-cursor (js-length unchanged))) unchanged)
            (setq actual-cursor (+ actual-cursor (js-length unchanged)))
            (js-call assert :deepStrictEqual (js-call actual :slice actual-cursor (+ actual-cursor (js-length replacement))) replacement)
            (setq actual-cursor (+ actual-cursor (js-length replacement)) original-cursor end))))
        (js-call assert :deepStrictEqual (js-call actual :slice actual-cursor) (js-call original :slice original-cursor))
        (let* ((emitted (projectInitializerArraySuite root source))
               (titles (new globalThis.RegExp "^test\\(\"(?:\\\\.|[^\"\\\\])*\"" "gm"))
               (before (Array/from (js-call source :matchAll titles) (lambda (match) (aref match 0))))
               (after (Array/from (js-call emitted :matchAll titles) (lambda (match) (aref match 0)))))
          (js-call assert :ok (> (js-length before) 0))
          (js-call assert :deepStrictEqual after before))
        (js-call assert :strictEqual (js-length initializerArrayMethods) 28)
        (js-call assert :deepStrictEqual (aref initializerArrayMethods 27) (js-array "reverse" 0))
        (js-call assert :throws (lambda () (projectInitializerArraySuite root (str source "\n"))) globalThis.TypeError))))

  (test "all current expectation projections retain original case registrations and reject changed or unknown input"
    (lambda ()
      (let ((seen (new globalThis.Set)))
        (js-call currentExpectationPlans :forEach (lambda (plan)
          (let* ((file (get plan :suite)) (source (readFileSync (resolve root file) "utf8"))
                 (actual (projectCurrentSourceExpectations root file source))
                 (titles (new globalThis.RegExp "test\\(\"(?:\\\\.|[^\"\\\\])*\"" "g")))
            (js-call assert :ok (not (js-call seen :has file))) (js-call seen :add file)
            (js-call assert :ok (> (js-length (Array/from (js-call source :matchAll titles))) 0))
            (js-call assert :deepStrictEqual (js-call actual :match titles) (js-call source :match titles))
            (js-call assert :throws (lambda () (projectCurrentSourceExpectations root file (str source "\n")))))))
        (js-call assert :strictEqual (get seen :size) 6)
        (js-call assert :throws (lambda () (projectCurrentSourceExpectations root "unknown.mjs" "")) globalThis.TypeError))))
  (test "initializer selection separates actual source binding slots from private caches and refuses reordered or duplicate writes"
    (lambda ()
      (letfn ((literal (value) (js-object :kind "literal" :value value :children (js-array)))
              (call (index children) (js-object :kind "call" :value index :children children))
              (sequence (children) (js-object :kind "sequence" :children children)))
        (let* ((prepare (js-object :name "__eliscript_module_part_0" :index 11 :locals (js-array)
                 :body (funcall call 10 (js-array (funcall literal 0) (funcall literal 1) (funcall literal 0)))))
               (source (js-object :name "__eliscript_module_part_1" :index 12 :locals (js-array 0 1 2)
                 :body (funcall call 10 (js-array (funcall literal 0) (funcall literal 0) (funcall literal 7)))))
               (body (js-object :name "__eliscript_module_body" :index 13 :locals (js-array 0)
                 :body (funcall sequence (js-array (funcall call 11 (js-array)) (funcall call 12 (js-array))))))
               (lowered (js-object :typed (js-object :aliases (js-array) :functions
                  (js-array (js-object :name "value-module-init" :index 10) prepare source body))
                 :descriptor (js-object :module (js-object :bindingCount 2 :functionCount 1)
                   :functions (js-array (js-object :name "read")))))
               (saved (JSON/stringify lowered)))
          (js-call assert :strictEqual (get (verifyInitializerShape lowered 1 1) :partLocals) 3)
          (js-call assert :strictEqual (sourceInitializerPart lowered 0) source)
          (js-call (js-array "order" "duplicate" "cache") :forEach (lambda (mutation)
            (let* ((bad (globalThis.structuredClone lowered)) (functions (get (get bad :typed) :functions)))
              (cond ((= mutation "order") (js-call (get (get (aref functions 3) :body) :children) :reverse))
                    ((= mutation "duplicate") (put (aref (get (get (aref functions 2) :body) :children) 1) :value 1))
                    (t (put (aref (get (get (aref functions 1) :body) :children) 2) :value 7)))
              (js-call assert :throws (lambda () (verifyInitializerShape bad 1 1))))))
          (js-call assert :strictEqual (JSON/stringify lowered) saved)))))
)
