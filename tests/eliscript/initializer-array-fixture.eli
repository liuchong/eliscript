(module tests.initializer-array-fixture
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "../dist/bootstrap/compiler.mjs" compile-ir-string)
  (import "../tools/testing/initializer-array-fixture.mjs"
    initializerArrayMethods assertInitializerArrayRegistration projectInitializerArraySuite)
  (test "initializer registration checks its actual method-vector bound and keeps advancement inside that loop"
    (lambda ()
      (let* ((runtime (compile-ir-string (readFileSync (resolve root "bootstrap/runtime/memory.eli") "utf8") "runtime.eli"))
             (before (JSON/stringify runtime)))
        (assertInitializerArrayRegistration runtime)
        (js-call assert :strictEqual (JSON/stringify runtime) before)
        (let* ((bad (globalThis.structuredClone runtime)) (pending (js-call (get bad :body) :slice)))
          (while (> (js-length pending) 0)
            (let ((node (js-call pending :pop)))
              (when (and (= (get node :kind) "assignment-pair") (= (get node :value) "index"))
                (put node :value "lost-index"))
              (Reflect/apply (get pending :push) pending (get node :children))))
          (js-call assert :throws (lambda () (assertInitializerArrayRegistration bad)))))))
  (test "initializer suite projection preserves every original assertion outside the two authenticated source regions"
    (lambda ()
      (let* ((source (readFileSync (resolve root "tests/wasm-managed-initializer-outlining.test.mjs") "utf8"))
             (actual (projectInitializerArraySuite root source))
             (begin (js-call source :indexOf "function assertArrayRegistrationAdvances(){"))
             (end (js-call source :indexOf "\ntest('the actual runtime IR" begin))
             (table (js-call source :indexOf " const methods=[[" end))
             (finish (+ (js-call source :indexOf "];" table) 2)))
        (js-call assert :ok (js-call actual :startsWith (js-call source :slice 0 begin)))
        (js-call assert :ok (js-call actual :includes (js-call source :slice end table)))
        (js-call assert :ok (js-call actual :endsWith (js-call source :slice finish)))
        (js-call assert :strictEqual (js-length initializerArrayMethods) 28)
        (js-call assert :deepStrictEqual (aref initializerArrayMethods 27) (js-array "reverse" 0))
        (js-call assert :throws (lambda () (projectInitializerArraySuite root (str source "\n"))) globalThis.TypeError))))
)
