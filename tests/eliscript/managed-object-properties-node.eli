(module tests.managed-object-properties-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (let* ((a (instantiateManagedRuntime (readFileSync 0))))
    (js-call a :auto 1) (js-call assert :strictEqual (js-call a :invoke "identities") t)
    (let* ((text (js-call a :string "A😀")) (keys (js-call a :invoke "keys" (js-array text))))
      (js-call assert :strictEqual (js-call a :length keys) 3)
      (let ((index 0)) (while (< index 3)
        (let ((value (js-call a :get keys index))) (js-call assert :strictEqual (js-call a :readString value) (funcall globalThis.String index)) (js-call a :release value))
        (setq index (1+ index))))
      (let* ((target (js-call a :sourceObject (js-object))) (source (js-call a :sourceObject (js-object :saved t)))
        (out (js-call a :invoke "assign" (js-array target source))) (key (js-call a :string "saved")))
        (js-call assert :strictEqual (js-call a :keyEqual out target) t)
        (js-call assert :strictEqual (js-call a :invoke "own" (js-array target key)) t)
        (js-call assert :strictEqual (js-call a :invoke "member" (js-array target key)) t)
        (js-call (js-array text keys target source out key) :forEach (lambda (value) (js-call a :release value)))))
    (js-call a :closeModule) (js-call a :collect)
    (js-call assert :strictEqual (js-call a :live) 0) (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0)))
