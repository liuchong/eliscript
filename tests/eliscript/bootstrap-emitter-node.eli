(module tests.bootstrap-emitter-node
  (import "node:module" createRequire)
  (import "node:url" fileURLToPath)
  (defconst path (fileURLToPath (get (get globalThis.process :env) :ELISCRIPT_TEST_MODULE)))
  (defconst m (funcall (createRequire path) path))
  (defasync main ()
    (let ((result (if (Object/hasOwn m "primitive_report")
                    (js-call m :primitive_report)
                    (js-object :factorial (js-call m :factorial 5) :sum (js-call m :sum_to 5)
                      :message (get (get m :result) :message)))))
      (when (Object/hasOwn m "async_report") (put result :async (await (js-call m :async_report))))
      (js-call globalThis.console :log (JSON/stringify result))))
  (main))
