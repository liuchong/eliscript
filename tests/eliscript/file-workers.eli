(module tests.file-workers
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:path" resolve isAbsolute)
  (import "node:fs/promises" mkdtemp mkdir writeFile readFile rm symlink)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "../dist/bootstrap/compiler.mjs" compile-string)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/testing/file-workers.mjs"
    FILE_WORKERS isExclusiveTestFile parseTestFileArgs partitionTestFiles scheduleTestFiles runTestFiles workerTestArguments parseSuiteArgs runSuiteCommand)
  (import "../tools/testing/fixture-environment.mjs" fixtureChildArguments)

  (defasync tick ()
    (await (new globalThis.Promise (lambda (resolve reject) (funcall globalThis.setImmediate resolve)))))

  (test "a requested file runs once even when an archived copy has the same path suffix"
    (async ()
      (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-exact-test-file-")))))
        (try
          (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
          (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
          (await (writeFile (resolve directory "package.json") "{\"type\":\"module\",\"private\":true}\n"))
          (await (mkdir (resolve directory "selected") (js-object :recursive t)))
          (await (mkdir (resolve directory "archive/selected") (js-object :recursive t)))
          (await (writeFile (resolve directory "selected/exact.test.mjs")
            (compile-string "(import \"bun:test\" test) (test \"selected original\" (lambda () t))" "selected.eli")))
          (await (writeFile (resolve directory "archive/selected/exact.test.mjs")
            (compile-string "(throw (new globalThis.Error \"archived copy must not execute\"))" "archive.eli")))
          (let ((result (spawnSync (get globalThis.process :execPath)
                         (workerTestArguments "selected/exact.test.mjs")
                         (js-object :cwd directory :encoding "utf8" :timeout 10000 :maxBuffer 1048576))))
            (js-call assert :strictEqual (get result :error) undefined)
            (js-call assert :strictEqual (get result :status) 0 (get result :stderr))
            (js-call assert :match (get result :stderr) (new globalThis.RegExp "1 pass"))
            (js-call assert :doesNotMatch (get result :stderr) (new globalThis.RegExp "archived copy")))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "only the exact compiler-heavy Bun files use standard mode and every original input is dispatched"
    (async ()
      (let* ((files (js-array
                "tests/compiler-seed-runtime-identity.test.mjs"
                (resolve "independent" "compiler-corpus-matchers-selfhosted.test.mjs")
                "tests/compiler-package-session.test.mjs"
                "tests/direct-wasm-backend.test.mjs"
                "tests/wasm-managed-symbols.test.mjs"
                "tests/wasm-managed-sorted-core.test.mjs"
                "tests/wasm-managed-wire-selfhosted.test.mjs"
                "compiler-seed-runtime-identity-copy.test.mjs"
                "compiler-corpus-matchers-selfhosted-copy.test.mjs"
                "wasm-managed-sorted-core-copy.test.mjs"
                "wasm-managed-wire-selfhosted-copy.test.mjs"
                "Compiler-seed-runtime-identity.test.mjs"
                "synthetic-ci.test.mjs"))
             (requests (js-array))
             (supervisor (js-object :failure nil
               :run (async (request) (js-call requests :push request) (js-object :exitCode 0))
               :cancel (lambda (signal) (js-call assert :fail "unexpected cancellation"))))
             (result (await (scheduleTestFiles files supervisor))))
        (js-call assert :strictEqual FILE_WORKERS 2)
        (js-call assert :strictEqual (get result :exitCode) 0)
        (js-call assert :deepStrictEqual (js-call requests :map (lambda (request) (get request :file))) files)
        (js-call assert :deepStrictEqual (js-call (get result :results) :map (lambda (row) (get row :file))) files)
        (js-call requests :forEach (lambda (request index)
          (js-call assert :deepStrictEqual (get request :args)
            (fixtureChildArguments
              (let* ((file (aref files index)) (entry (if (isAbsolute file) file (+ "./" file))))
                (if (< index 7) (js-array "test" "--timeout" "300000" entry)
                  (js-array "--smol" "test" "--timeout" "300000" entry))) (get globalThis.process :env)))
          (js-call assert :strictEqual (get request :command) (get globalThis.process :execPath))
          (js-call assert :strictEqual (get request :env) (get globalThis.process :env))
          (js-call assert :strictEqual (get request :cwd) (js-call globalThis.process :cwd))
          (js-call assert :strictEqual (get request :id) (funcall globalThis.String index)))))))

  (test "only the exact Number text suite selects the Node LTS bridge while preserving inventory and ordinary Bun commands"
    (async ()
      (let* ((root (js-call globalThis.process :cwd)) (environment (js-object :NODE "selected-node24"))
             (files (js-array "./tests/wasm-managed-number-text.test.mjs" "./tests/wasm-managed-number-text-copy.test.mjs"))
             (requests (js-array)) (supervisor (js-object :failure nil
               :run (async (request) (js-call requests :push request) (js-object :exitCode 0))))
             (result (await (scheduleTestFiles files supervisor (js-object :environment environment :sourceRoot root)))))
        (js-call assert :strictEqual (get result :exitCode) 0)
        (js-call assert :deepStrictEqual (js-call (get result :results) :map (lambda (row) (get row :file))) files)
        (js-call assert :strictEqual (get (aref requests 0) :command) "selected-node24")
        (js-call assert :deepStrictEqual (get (aref requests 0) :args) (js-array
          "--import" (resolve root "tools/testing/fixture-environment.mjs")
          "--import" (resolve root "tests/helpers/number-text-node-install.mjs") "--test" (aref files 0)))
        (js-call assert :strictEqual (get (aref requests 1) :command) (get globalThis.process :execPath))
        (js-call assert :deepStrictEqual (get (aref requests 1) :args)
          (fixtureChildArguments (js-array "--smol" "test" "--timeout" "300000" (aref files 1)) environment))
        (js-call requests :forEach (lambda (request)
          (js-call assert :strictEqual (get request :env) environment)
          (js-call assert :strictEqual (get request :cwd) root))))))
  (test "only the exact static data and guard logical suites select their complete Node entries without dropping inventory rows"
    (async ()
      (let* ((root (js-call globalThis.process :cwd)) (environment (js-object :NODE "selected-node24"))
             (files (js-array "./tests/wasm-memory-static-data.test.mjs" "./tests/compiler-portable-guards.test.mjs"
               "./tests/wasm-memory-static-data-copy.test.mjs" "./tests/compiler-portable-guards-copy.test.mjs"))
             (requests (js-array)) (supervisor (js-object :failure nil
               :run (async (request) (js-call requests :push request) (js-object :exitCode 0))))
             (result (await (scheduleTestFiles files supervisor (js-object :environment environment :sourceRoot root)))))
        (js-call assert :strictEqual (get result :exitCode) 0)
        (js-call assert :deepStrictEqual (js-call (get result :results) :map (lambda (row) (get row :file))) files)
        (js-call (js-array 0 1) :forEach (lambda (index)
          (js-call assert :strictEqual (get (aref requests index) :command) "selected-node24")
          (js-call assert :deepStrictEqual (get (aref requests index) :args) (js-array
            "--import" (resolve root "tools/testing/fixture-environment.mjs")
            "--import" (resolve root "tests/helpers/portable-node-install.mjs") "--test"
            (if (= index 0) "./tests/wasm-memory-static-data-test-ground.mjs" (aref files index))))))
        (js-call (js-array 2 3) :forEach (lambda (index)
          (js-call assert :strictEqual (get (aref requests index) :command) (get globalThis.process :execPath))
          (js-call assert :deepStrictEqual (get (aref requests index) :args)
            (fixtureChildArguments (js-array "--smol" "test" "--timeout" "300000" (aref files index)) environment))))
        (js-call requests :forEach (lambda (request)
          (js-call assert :strictEqual (get request :env) environment)
          (js-call assert :strictEqual (get request :cwd) root))))))
  (test "worker fixture overrides reach only the owned children with original supervision and arguments"
    (async ()
      (let* ((environment (js-object :PATH "original-path" :TMPDIR "private-fixtures"))
             (fixture-root (resolve "fixture-project"))
             (requests (js-array)) (parent (get (get globalThis.process :env) :TMPDIR))
             (supervisor (js-object :failure nil
               :run (async (request) (js-call requests :push request) (js-object :exitCode 0))
               :cancel (lambda (signal) (js-call assert :fail "unexpected cancellation"))))
             (result (await (scheduleTestFiles (js-array "original.test.mjs") supervisor
               (js-object :environment environment :sourceRoot fixture-root)))))
        (js-call assert :strictEqual (get result :exitCode) 0)
        (js-call assert :strictEqual (get (aref requests 0) :env) environment)
        (js-call assert :strictEqual (get (aref requests 0) :cwd) fixture-root)
        (js-call assert :deepStrictEqual (get (aref requests 0) :args)
          (js-array "--smol" "test" "--timeout" "300000" "./original.test.mjs"))
        (js-call assert :strictEqual (get (get globalThis.process :env) :TMPDIR) parent))))

  (test "two ordinary workers settle before exact standard-mode files and later results retain original order"
    (async ()
      (let* ((files (js-array "a.test.mjs" "b.test.mjs"
                 "tests/compiler-seed-runtime-identity.test.mjs"
                 "tests/compiler-corpus-matchers-selfhosted.test.mjs" "c.test.mjs" "d.test.mjs"))
             (active (new globalThis.Map)) (started (js-array))
             (complete (lambda (file code)
               (let ((resolve (js-call active :get file)))
                 (js-call assert :strictEqual (value-type resolve) "function")
                 (js-call active :delete file) (funcall resolve (js-object :exitCode code)))))
             (supervisor (js-object :failure nil
               :run (lambda (request)
                 (js-call started :push (get request :file))
                 (new globalThis.Promise (lambda (resolve reject)
                   (js-call active :set (get request :file) resolve))))
               :cancel (lambda (signal)
                 (js-call (Array/from (js-call active :keys)) :forEach (lambda (file)
                   (funcall complete file (if (= signal "SIGINT") 130 143)))))))
             (running (scheduleTestFiles files supervisor)))
        (try
          (progn
            (js-call assert :deepStrictEqual (Array/from (js-call active :keys)) (js-call files :slice 0 2))
            (funcall complete (aref files 1) 9) (await (tick))
            (js-call assert :deepStrictEqual (Array/from (js-call active :keys)) (js-array (aref files 0)))
            (funcall complete (aref files 0) 0) (await (tick))
            (js-call assert :deepStrictEqual (Array/from (js-call active :keys)) (js-array (aref files 2)))
            (funcall complete (aref files 2) 0) (await (tick))
            (js-call assert :deepStrictEqual (Array/from (js-call active :keys)) (js-array (aref files 3)))
            (funcall complete (aref files 3) 0) (await (tick))
            (js-call assert :deepStrictEqual (Array/from (js-call active :keys)) (js-call files :slice 4))
            (funcall complete (aref files 5) 0) (funcall complete (aref files 4) 0)
            (let ((result (await running)))
              (js-call assert :strictEqual (get result :exitCode) 1)
              (js-call assert :deepStrictEqual started files)
              (js-call assert :deepStrictEqual (get result :results)
                (js-call files :map (lambda (file index) (js-object :file file :exitCode (if (= index 1) 9 0)))))))
          (finally (js-call globalThis.process :emit "SIGTERM") (await running))))))

  (test "documentation builders settle ordinary workers and each other before touching shared generated inputs"
    (async ()
      (let* ((files (js-array "ordinary.test.mjs" "tests/docs-site.test.mjs"
                      "tests/pages-assembly.test.mjs" "later.test.mjs"))
             (active (new globalThis.Map)) (started (js-array))
             (supervisor (js-object :failure nil :run (lambda (request)
               (js-call started :push (get request :file))
               (new globalThis.Promise (lambda (complete)
                 (js-call active :set (get request :file) complete))))))
             (running (scheduleTestFiles files supervisor)))
        (let ((index 0))
          (while (< index (js-length files))
            (js-call assert :deepStrictEqual (Array/from (js-call active :keys)) (js-array (aref files index)))
            (let ((complete (js-call active :get (aref files index))))
              (js-call active :delete (aref files index)) (funcall complete (js-object :exitCode 0)))
            (await (tick)) (setq index (1+ index))))
        (js-call assert :strictEqual (get (await running) :exitCode) 0)
        (js-call assert :deepStrictEqual started files)
        (js-call assert :strictEqual (isExclusiveTestFile "tests/docs-site-copy.test.mjs") false)
        (js-call assert :strictEqual (isExclusiveTestFile "tests/pages-assembly-copy.test.mjs") false))))

  (test "cancellation keeps its original code stops queued work and restores both signal listeners"
    (async ()
      (let ((rows (js-array (js-array "SIGINT" 130) (js-array "SIGTERM" 143))) (index 0))
        (while (< index (js-length rows))
          (let* ((row (aref rows index)) (pending (js-array)) (started (js-array))
                 (before (js-array (js-call globalThis.process :listenerCount "SIGINT")
                                  (js-call globalThis.process :listenerCount "SIGTERM")))
                 (files (js-array "tests/compiler-corpus-matchers-selfhosted.test.mjs" "never.test.mjs"))
                 (supervisor (js-object :failure nil
                   :run (lambda (request)
                     (js-call started :push (get request :file))
                     (new globalThis.Promise (lambda (resolve reject) (js-call pending :push resolve))))
                   :cancel (lambda (signal)
                     (js-call assert :strictEqual signal (aref row 0))
                     (js-call pending :forEach (lambda (resolve)
                       (funcall resolve (js-object :exitCode (aref row 1))))))))
                 (running (scheduleTestFiles files supervisor)))
            (js-call assert :deepStrictEqual started (js-array (aref files 0)))
            (js-call globalThis.process :emit (aref row 0))
            (let ((result (await running)))
              (js-call assert :strictEqual (get result :exitCode) (aref row 1))
              (js-call assert :deepStrictEqual (get result :results)
                (js-array (js-object :file (aref files 0) :exitCode (aref row 1)))))
            (js-call assert :deepStrictEqual
              (js-array (js-call globalThis.process :listenerCount "SIGINT")
                        (js-call globalThis.process :listenerCount "SIGTERM")) before))
          (setq index (1+ index))))))

  (test "primitive run rejections and real resource metadata remain failures without filtering later files"
    (async ()
      (let* ((files (js-array "a.test.mjs" "b.test.mjs" "c.test.mjs" "d.test.mjs"))
             (calls (js-array)) (resource (js-object :peak 23))
             (result (await (scheduleTestFiles files (js-object :failure nil
               :cancel (lambda (signal) nil)
               :run (async (request)
                 (let ((file (get request :file)))
                   (js-call calls :push file)
                   (cond ((= file "a.test.mjs") (throw false))
                         ((= file "b.test.mjs") (throw undefined))
                         ((= file "c.test.mjs") (js-object :exitCode 1 :failure "guard" :resource resource :message "original"))
                         (t (js-object :exitCode 0 :failure "cancelled"))))))))))
        (js-call assert :strictEqual (get result :exitCode) 1)
        (js-call assert :deepStrictEqual calls files)
        (js-call assert :deepStrictEqual (get result :results) (js-array
          (js-object :file "a.test.mjs" :exitCode 1)
          (js-object :file "b.test.mjs" :exitCode 1)
          (js-object :file "c.test.mjs" :exitCode 1 :failure "guard" :resource resource :message "original")
          (js-object :file "d.test.mjs" :exitCode 0))))))

  (test "all original shard and validation contracts remain strict and importing the runner starts no CLI"
    (async ()
      (let ((files (js-array "a.test.mjs" "b.test.mjs" "c.test.mjs")))
        (js-call assert :deepStrictEqual (parseTestFileArgs files) (js-object :files files :shard nil))
        (js-call assert :deepStrictEqual
          (parseTestFileArgs (js-call (js-array "--shard-index" "2" "--shard-count" "2") :concat files))
          (js-object :files files :shard (js-object :index 2 :count 2)))
        (js-call assert :deepStrictEqual (partitionTestFiles files 2 2) (js-array "b.test.mjs"))
        (js-call assert :strictEqual (isExclusiveTestFile "tests/compiler-corpus-matchers-selfhosted.test.mjs") t)
        (js-call assert :strictEqual (isExclusiveTestFile "ordinary.test.mjs") false)
        (js-call (js-array nil (js-array) (js-array "a.mjs") (js-array "a.test.mjs" "a.test.mjs")) :forEach
          (lambda (bad) (js-call assert :throws (lambda () (parseTestFileArgs bad)))))
        (js-call assert :throws (lambda () (partitionTestFiles files 0 2)))
        (js-call assert :throws (lambda () (parseTestFileArgs
          (js-array "--shard-index" "1" "a.test.mjs")))))))

  (test "suite runner collects all independent failures blocks prerequisite dependents as unexecuted and preserves run-isolated evidence for targeted re-test"
    (async ()
      (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-suite-runner-")))))
        (try
          (let* ((ledger-path (resolve directory "suite-unit.json"))
                 (script-a (resolve directory "pass-a.test.mjs"))
                 (script-b (resolve directory "fail-b.test.mjs"))
                 (script-c (resolve directory "pass-c.test.mjs"))
                 (node-bin (or (get (get globalThis.process :env) :NODE) "node"))
                 (env (Object/assign (js-object) (get globalThis.process :env)
                        (js-object :ELISCRIPT_TEST_SUITE_LEDGER ledger-path
                                   :ELISCRIPT_SUITE_RUN_ID "run-1"))))
            (await (writeFile script-a
              (compile-string "(import \"node:test\" test) (test \"a\" (lambda () nil))" "pass-a.eli")))
            (await (writeFile script-b
              (compile-string "(import \"node:test\" test) (import \"node:assert/strict\" :default assert) (test \"b\" (lambda () (js-call assert :strictEqual 1 2)))" "fail-b.eli")))
            (await (writeFile script-c
              (compile-string "(import \"node:test\" test) (test \"c\" (lambda () nil))" "pass-c.eli")))
            ;; 0. Finalizing a missing ledger fails with exitCode 1
            (let ((missing-fin (await (runSuiteCommand
                                 (js-array "--suite-finalize" "unit")
                                 (js-object :sourceRoot directory :environment env)))))
              (js-call assert :strictEqual (get missing-fin :exitCode) 1)
              (js-call assert :strictEqual (get missing-fin :processExitCode) 1))
            ;; 1. Step 1 (multi-file node --test with 1 pass, 1 fail, 1 pass): continues through all 3 files without aborting
            (let ((s1 (await (runSuiteCommand
                        (js-array "--suite-step" "unit" "node-batch" "" "--" node-bin "--test" "--test-concurrency=1" script-a script-b script-c)
                        (js-object :sourceRoot directory :environment env)))))
              (js-call assert :strictEqual (get s1 :status) "failed")
              (js-call assert :strictEqual (get s1 :exitCode) 1)
              (js-call assert :strictEqual (get s1 :processExitCode) 0)
              (js-call assert :deepStrictEqual (get s1 :failedFiles) (js-array script-b))
              (js-call assert :deepStrictEqual (get s1 :unexecutedFiles) (js-array))
              (js-call assert :deepStrictEqual (get s1 :fileSummary)
                (js-object :total 3 :passed 2 :failed 1 :unexecuted 0)))
            ;; 2. Failing prerequisite and missing prerequisite both block dependent steps as unexecuted (never passed)
            (let ((p1 (await (runSuiteCommand
                        (js-array "--suite-prereq" "unit" "build-assets" "" "--" "sh" "-c" "exit 2")
                        (js-object :sourceRoot directory :environment env))))
                  (s2 (await (runSuiteCommand
                        (js-array "--suite-step" "unit" "dependent-suite" "build-assets" "--" "sh" "-c" "exit 0")
                        (js-object :sourceRoot directory :environment env))))
                  (s-missing (await (runSuiteCommand
                               (js-array "--suite-step" "unit" "missing-prereq-suite" "nonexistent-prereq" "--" "sh" "-c" "exit 0")
                               (js-object :sourceRoot directory :environment env))))
                  (s3 (await (runSuiteCommand
                        (js-array "--suite-step" "unit" "independent-after" "" "--" node-bin "--test" script-a)
                        (js-object :sourceRoot directory :environment env))))
                  (fin (await (runSuiteCommand
                         (js-array "--suite-finalize" "unit" "node-batch,build-assets,dependent-suite,missing-prereq-suite,independent-after")
                         (js-object :sourceRoot directory :environment env)))))
              (js-call assert :strictEqual (get p1 :status) "failed")
              (js-call assert :strictEqual (get s2 :status) "unexecuted")
              (js-call assert :strictEqual (get s2 :started) false)
              (js-call assert :strictEqual (get s2 :exitCode) nil)
              (js-call assert :strictEqual (get s2 :failure) "prerequisite-failed")
              (js-call assert :strictEqual (get s2 :blockedBy) "build-assets")
              (js-call assert :strictEqual (get s-missing :status) "unexecuted")
              (js-call assert :strictEqual (get s-missing :started) false)
              (js-call assert :strictEqual (get s-missing :exitCode) nil)
              (js-call assert :strictEqual (get s-missing :failure) "prerequisite-missing")
              (js-call assert :strictEqual (get s-missing :blockedBy) "nonexistent-prereq")
              (js-call assert :strictEqual (get s3 :status) "passed")
              (js-call assert :strictEqual (get fin :exitCode) 1)
              (js-call assert :strictEqual (get fin :processExitCode) 1)
              (js-call assert :deepStrictEqual (js-object
                  :total (get (get fin :summary) :total)
                  :passed (get (get fin :summary) :passed)
                  :failed (get (get fin :summary) :failed)
                  :unexecuted (get (get fin :summary) :unexecuted)
                  :failedSteps (get (get fin :summary) :failedSteps)
                  :unexecutedSteps (get (get fin :summary) :unexecutedSteps))
                (js-object :total 5 :passed 1 :failed 2 :unexecuted 2
                  :failedSteps (js-array "node-batch" "build-assets")
                  :unexecutedSteps (js-array "dependent-suite" "missing-prereq-suite")))
              ;; 3. --suite-finalize rejects mismatched runId, mismatched suite, or missing expected step
              (let ((wrong-run (await (runSuiteCommand
                                 (js-array "--suite-finalize" "unit")
                                 (js-object :sourceRoot directory :environment
                                   (Object/assign (js-object) env (js-object :ELISCRIPT_SUITE_RUN_ID "run-other"))))))
                    (wrong-suite (await (runSuiteCommand
                                   (js-array "--suite-finalize" "other-suite")
                                   (js-object :sourceRoot directory :environment env))))
                    (incomplete-steps (await (runSuiteCommand
                                        (js-array "--suite-finalize" "unit" "node-batch,build-assets,dependent-suite,missing-prereq-suite,independent-after,never-ran")
                                        (js-object :sourceRoot directory :environment env)))))
                (js-call assert :strictEqual (get wrong-run :exitCode) 1)
                (js-call assert :strictEqual (get wrong-suite :exitCode) 1)
                (js-call assert :strictEqual (get incomplete-steps :exitCode) 1)
                (js-call assert :strictEqual (get incomplete-steps :failure) "incomplete-suite-ledger"))
              ;; 4. Fix failing script-b and prerequisite, then re-run only the failed/unexecuted items under run-2
              ;;    using exact file/step entrypoints while preserving run-1's passed evidence in suite-unit-run-run-1.json
              (await (writeFile script-b
                (compile-string "(import \"node:test\" test) (test \"b-fixed\" (lambda () nil))" "fail-b.eli")))
              (let* ((run2-env (Object/assign (js-object) env (js-object :ELISCRIPT_SUITE_RUN_ID "run-2")))
                     (r-fixed-file (await (runSuiteCommand
                                     (js-array "--suite-step" "unit" "node-batch-fixed" "" "--" node-bin "--test" script-b)
                                     (js-object :sourceRoot directory :environment run2-env))))
                     (r-p1 (await (runSuiteCommand
                             (js-array "--suite-prereq" "unit" "build-assets" "" "--" "sh" "-c" "exit 0")
                             (js-object :sourceRoot directory :environment run2-env))))
                     (r-s2 (await (runSuiteCommand
                             (js-array "--suite-step" "unit" "dependent-suite" "build-assets" "--" "sh" "-c" "exit 0")
                             (js-object :sourceRoot directory :environment run2-env))))
                     (r-fin (await (runSuiteCommand
                              (js-array "--suite-finalize" "unit" "node-batch-fixed,build-assets,dependent-suite")
                              (js-object :sourceRoot directory :environment run2-env))))
                     (preserved-run1 (JSON/parse (await (readFile (get fin :runLedgerPath) "utf8"))))
                     (preserved-scope1 (JSON/parse (await (readFile (get (aref (get preserved-run1 :steps) 0) :scopeArchive) "utf8")))))
                (js-call assert :strictEqual (get r-fixed-file :status) "passed")
                (js-call assert :strictEqual (get r-p1 :status) "passed")
                (js-call assert :strictEqual (get r-s2 :status) "passed")
                (js-call assert :strictEqual (get r-fin :exitCode) 0)
                (js-call assert :strictEqual (get (get r-fin :summary) :passed) 3)
                (js-call assert :strictEqual (get preserved-run1 :runId) "run-1")
                (js-call assert :ok (= (value-type (get (get preserved-scope1 :passedFileDigests) script-a)) "string"))
                (js-call assert :ok (= (value-type (get (get preserved-scope1 :passedFileDigests) script-c)) "string")))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
)
