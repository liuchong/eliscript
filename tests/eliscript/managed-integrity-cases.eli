(module tests.managed-integrity-cases
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../../tools/backends/build.mjs" buildBackends root)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../../tools/backends/compiler-build.mjs" independentCompilerResources)
  (import "./managed-numeric-selfhosted.mjs" loadReference)
  (defvar directory undefined)
  (defvar backend undefined)
  (defvar runtime undefined)
  (defvar family undefined)
  (defvar image undefined)
  (defasync prepareManagedIntegrity ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-integrity-maintained-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get backend :compiler) :compile_ir_string
      (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
    (let* ((archive (await (readFile (resolve root "tests/wasm-managed-object-integrity-test-legacy.mjs") "utf8")))
           (marker "const family=`") (start (js-call archive :indexOf marker)))
      (js-call assert :ok (>= start 0))
      (setq start (+ start (js-length marker)))
      (let ((end (js-call archive :indexOf "`;" start)))
        (js-call assert :ok (> end start)) (setq family (js-call archive :slice start end))))
    (setq image (emit (js-call (get backend :compiler) :compile_ir_string (+ "(defconst marker 1)\n" family) "integrity.eli"))))
  (defasync closeManagedIntegrity ()
    (when directory (await (rm directory (js-object :recursive t :force t))) (setq directory undefined)))
  (defun emit (program)
    (let* ((before (JSON/stringify program))
           (bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime))))
      (js-call assert :strictEqual (JSON/stringify program) before)
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array)) bytes))
  (defun read (a value)
    (cond ((and value (= (get value :kind) 4)) (js-call a :readNumber value))
      ((and value (= (get value :kind) 5)) (js-call a :readString value))
      ((and value (= (get value :kind) 14))
        (let ((out (js-array)) (index 0))
          (while (< index (js-call a :length value))
            (let ((item (js-call a :get value index))) (try (js-call out :push (read a item)) (finally (js-call a :release item))))
            (setq index (1+ index))) out)) (t value)))
  (defun finish (a values)
    (js-call values :forEach (lambda (value) (js-call a :release value)))
    (js-call a :closeModule) (js-call a :collect)
    (js-call assert :strictEqual (js-call a :live) 0)
    (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))
  (defasync compiled (text name)
    (let* ((p (js-call (get backend :compiler) :compile_ir_string (+ "(defconst marker 1)\n" text) name))
           (bytes (emit p)) (a (instantiateManagedRuntime bytes))
           (js (await (loadReference (resolve directory (+ name ".mjs")) (js-call (get backend :compiler) :emit_ir_string p)))))
      (js-call a :auto 1) (js-object :a a :js js)))
  (defun invoke-read (a name args)
    (let ((output (js-call a :invoke name args))) (try (read a output) (finally (js-call a :release output)))))
  (defasync shadow-case ()
    (let* ((source (str "(defun run () (let ((trace (js-object :n 0)) (o (js-object)))"
               " (let ((out (js-call globalThis.Object :freeze o (put trace :n 7))))"
               " (js-array (eq out o) (Object/isFrozen o) (get trace :n) (Object/isFrozen o (put trace :n 9)) (get trace :n)))))"
               " (defun shadow (Object trace) (js-call Object :freeze (put trace :seen 3)"
               " (if (= (value-type Object) \"object\") (put Object :freeze false) false)))"
               " (defun factory () (lambda (&rest args) (js-length args))) (export run shadow factory)"))
           (fixture (await (compiled source "integrity-shadow.eli"))) (a (get fixture :a)) (js (get fixture :js))
           (out (js-call a :invoke "run")) (expected (js-call js :run)))
      (js-call assert :deepStrictEqual (read a out) expected)
      (let* ((f (js-call a :invoke "factory")) (object (js-call a :sourceObject (js-object :freeze f)))
             (trace (js-call a :sourceObject (js-object))) (result (js-call a :invoke "shadow" (js-array object trace))))
        (js-call assert :strictEqual (js-call a :readNumber result) 2)
        (js-call (js-array nil false) :forEach (lambda (receiver)
          (let ((effects (js-call a :sourceObject (js-object))) (control (js-object)) (key (js-call a :string "seen")))
            (js-call assert :throws (lambda () (js-call js :shadow receiver control)) globalThis.TypeError)
            (js-call assert :throws (lambda () (js-call a :invoke "shadow" (js-array receiver effects)))
              (lambda (error) (and (js-call globalThis.TypeError globalThis.Symbol.hasInstance error)
                (= (get (get error :eliscriptDiagnostic) :code) (if (eq receiver nil) "ELI-RT0001" "ELI-RT0003")))))
            (let ((seen (js-call a :objectGet effects key)))
              (js-call assert :strictEqual (read a seen) (get control :seen))
              (js-call assert :strictEqual (get control :seen) (if (eq receiver nil) undefined 3))
              (js-call a :release seen))
            (js-call a :release effects) (js-call a :release key))))
        (finish a (js-array out f object trace result)))))
  (defun raw-context (slots initial maximum)
    (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module image)) :exports))
           (heap (funcall (get e "heap-new") slots initial maximum)))
      (js-call assert :ok (> heap 0))
      (let ((call (lambda (name &rest args)
                    (let ((result (uint32 (Reflect/apply (get e name) e (js-call (js-array heap) :concat args)))))
                      (js-call assert :strictEqual (funcall (get e "last-error")) 0 name) result))))
        (js-object :e e :h heap :call call))))
  (defun capacity-case ()
    (let* ((environment (get globalThis.process :env))
           (deferred (and (= (get environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1")
                          (= (get environment :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE) "small")))
           (original (js-object :maxSlots 32 :initialBytes 8192 :maxBytes 8192))
           (effective (if deferred (get (independentCompilerResources (js-object :profile "small")) :budget) original))
           (context (raw-context (get effective :maxSlots) (get effective :initialBytes) (get effective :maxBytes)))
           (e (get context :e)) (heap (get context :h)) (call (get context :call))
           (object (funcall call "value-object-new" 3)) (array (funcall call "value-array-new" 0))
           (frame (funcall call "frame-new" 2)))
      (funcall call "frame-set" frame 0 object) (funcall call "frame-set" frame 1 array)
      (let* ((unsealed (funcall call "value-string" 1)) (refs (funcall call "value-refs" 7 0))
             (record (funcall call "value-refs" 8 0)) (bytesValue (funcall call "value-bytes" 0))
             (held (js-array unsealed refs record bytesValue)))
        (js-call held :forEach (lambda (value) (funcall call "heap-pin" value)))
        (js-call (js-array (js-array 4294967295 1) (js-array frame 3) (js-array unsealed 6)
                   (js-array refs 3) (js-array record 3) (js-array bytesValue 3)) :forEach (lambda (entry)
          (let ((operation 0))
            (while (< operation 2)
              (js-call assert :strictEqual (funcall (get e "value-object-integrity") heap (aref entry 0) operation) 0)
              (js-call assert :strictEqual (funcall (get e "last-error")) (aref entry 1))
              (js-call assert :strictEqual (funcall call "frame-depth") 1)
              (js-call assert :strictEqual (funcall call "frame-get" frame 0) object)
              (setq operation (1+ operation))))))
        (js-call assert :strictEqual (funcall (get e "value-object-integrity") heap object 2) 0)
        (js-call assert :strictEqual (funcall (get e "last-error")) 3)
        (let ((stale (funcall call "value-number" 0 0)))
          (funcall call "heap-collect")
          (js-call assert :strictEqual (funcall (get e "value-object-integrity") heap stale 0) 0)
          (js-call assert :strictEqual (funcall (get e "last-error")) 1))
        (if deferred
          (progn
            (funcall call "heap-auto" 1)
            (js-call globalThis.console :error (JSON/stringify (js-object :case "raw integrity allocation at capacity"
              :originalCapacityAcceptance "DEFERRED / NOT ACCEPTED" :originalRuntimeOptions original :effectiveRuntimeOptions effective))))
          (let ((full false))
            (while (and (< (js-length held) 32) (not full))
              (let ((value (uint32 (funcall (get e "value-number") heap 0 0))))
                (if (= value 0)
                  (progn (js-call assert :strictEqual (funcall (get e "last-error")) 2) (setq full t))
                  (progn (funcall call "heap-pin" value) (js-call held :push value)))))))
        (let ((used (funcall call "heap-used")))
          (js-call (js-array object array) :forEach (lambda (value)
            (js-call assert :strictEqual (funcall call "value-object-integrity" value 0) value)
            (js-call assert :strictEqual (funcall call "value-object-integrity" value 0) value)
            (js-call assert :strictEqual (funcall call "value-object-integrity" value 1) 2)))
          (unless deferred (js-call assert :strictEqual (funcall call "heap-used") used)))
        (js-call held :forEach (lambda (value) (funcall call "heap-release" value)))
        (funcall call "frame-pop" frame) (funcall call "heap-collect")
        (js-call assert :strictEqual (funcall call "heap-live") 0)
        (let ((fresh (funcall call "value-array-new" 0)))
          (funcall call "heap-pin" fresh)
          (js-call assert :strictEqual (funcall call "value-object-integrity" fresh 1) 1)
          (funcall call "heap-release" fresh))
        (funcall call "heap-collect")
        (js-call assert :strictEqual (funcall call "heap-live") 0)
        (js-call assert :strictEqual (funcall call "frame-depth") 0))))
  (defun mutation-case ()
    (let* ((context (raw-context 64 16384 16384)) (e (get context :e)) (heap (get context :h)) (call (get context :call))
           (object (funcall call "value-object-new" 3)) (array (funcall call "value-array-new" 2))
           (key (funcall call "value-string" 1)) (frame (funcall call "frame-new" 3)))
      (funcall call "frame-set" frame 0 object) (funcall call "frame-set" frame 1 array) (funcall call "frame-set" frame 2 key)
      ;; The roots are installed before automatic collection is enabled.
      ;; Reflection's dead temporary descriptors must not mask write errors.
      (funcall call "heap-auto" 1)
      (funcall call "value-unit-set" key 0 120) (funcall call "value-seal" key)
      (funcall call "value-object-put" object key 2 2) (funcall call "value-set" array 0 2)
      (funcall call "value-object-integrity" object 0) (funcall call "value-object-integrity" array 0)
      (js-call (js-array (js-array "value-set" (js-array array 0 2)) (js-array "value-set" (js-array array 1 2))
                 (js-array "value-array-resize" (js-array array 2)) (js-array "value-array-resize" (js-array array 0))
                 (js-array "value-array-put" (js-array array key 2)) (js-array "value-array-define" (js-array array key 2))
                 (js-array "value-object-put" (js-array object key 2 0)) (js-array "value-object-put" (js-array object key 2 1))
                 (js-array "value-object-put" (js-array object key 2 2))) :forEach (lambda (entry)
        (js-call assert :strictEqual (Reflect/apply (get e (aref entry 0)) e (js-call (js-array heap) :concat (aref entry 1))) 0 (aref entry 0))
        (js-call assert :strictEqual (funcall (get e "last-error")) 3 (aref entry 0))
        (js-call assert :strictEqual (funcall call "frame-depth") 1)
        (js-call assert :strictEqual (funcall call "value-object-get" object key) 2)
        (js-call assert :strictEqual (funcall call "value-get" array 0) 2)))
      (funcall call "heap-collect")
      (js-call assert :strictEqual (funcall call "value-object-integrity" object 1) 2)
      (js-call assert :strictEqual (funcall call "value-object-integrity" array 1) 2)
      (funcall call "frame-pop" frame) (funcall call "heap-collect")
      (js-call assert :strictEqual (funcall call "heap-live") 0)
      (js-call assert :strictEqual (funcall call "frame-depth") 0)))
  (defasync supported-case ()
    (let* ((source (str "(defun report () (let ((fn (lambda (x) x)) (regex (new globalThis.RegExp \"x\" \"u\")))"
               " (let ((before (js-array (Object/isFrozen fn) (Object/isFrozen regex)))"
               "       (function-result (Object/freeze fn)) (regexp-result (Object/freeze regex)))"
               " (js-array before (eq function-result fn) (eq regexp-result regex) (Object/isFrozen fn) (Object/isFrozen regex)"
               " (get (Object/getOwnPropertyDescriptor fn \"length\") :writable)"
               " (get (Object/getOwnPropertyDescriptor regex \"lastIndex\") :writable)"
               " (Reflect/defineProperty fn \"new\" (js-object :value 1))"
               " (Reflect/defineProperty regex \"new\" (js-object :value 1))"
               " (funcall fn 7) (aref (js-call regex :exec \"x\") 0))))) (export report)"))
           (fixture (await (compiled source "integrity-supported.eli"))) (a (get fixture :a)) (js (get fixture :js))
           (expected (js-call js :report)))
      (js-call assert :deepStrictEqual expected (js-array (js-array false false) t t t t false false false false 7 "x"))
      (js-call assert :deepStrictEqual (invoke-read a "report" (js-array)) expected)
      (finish a (js-array))))
  (defconst managedIntegrityCases (js-object
    "freeze aliases capture global functions before ignored argument effects and lexical methods retain ordinary lookup order" shadow-case
    "raw integrity rejects invalid private stale and unrepresented kinds, and freezing uses no allocations even at capacity" capacity-case
    "raw array and ordinary object mutation paths enforce freezing without leaking roots" mutation-case
    "unrepresented function and RegExp own-property models explicitly refuse integrity rather than claiming to freeze them" supported-case))
  (export managedIntegrityCases prepareManagedIntegrity closeManagedIntegrity))
