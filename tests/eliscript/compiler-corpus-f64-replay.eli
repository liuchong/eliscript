(module tests.compiler-corpus-f64-replay
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "node:buffer" Buffer)
  (import "node:crypto" createHash)
  (import "../tools/backends/compiler-corpus.mjs" createOriginalCorpusSourceReader)
  (import "../tools/backends/compiler-corpus-managed-fixtures.mjs"
    addOriginalManagedFixtureAdapters readOriginalStaticDataFixtureMigration readOriginalFinalFixtureMigrations)
  (import "../tools/backends/compiler-corpus-managed-cases.mjs" originalSourceCaseLocators)
  (defconst sourceRoot (fileURLToPath (new globalThis.URL ".." (js* "import.meta.url"))))
  (defconst unary "tests/wasm-memory-f64-unary.test.mjs")
  (defconst literal "tests/wasm-memory-f64-literal.test.mjs")
  (defconst indices "tests/wasm-managed-regexp-indices.test.mjs")
  (defconst unicodeSets "tests/wasm-managed-regexp-unicode-sets.test.mjs")
  (defconst propertyData "tests/wasm-managed-regexp-property-data.test.mjs")
  (defconst staticData "tests/wasm-memory-static-data.test.mjs")
  (defconst nativeData "tests/native-memory-data-copy.test.mjs")
  (defconst transcendental "tests/wasm-managed-math-transcendental.test.mjs")
  (defconst unretained "tests/wasm-memory-f64-unretained.test.mjs")
  (defconst originalSuites (js-call (js-array
    "wasm-managed-arithmetic" "wasm-managed-word" "wasm-managed-array-callbacks"
    "wasm-managed-arrays" "wasm-managed-array-text" "wasm-managed-callables"
    "wasm-managed-control" "wasm-managed-empty-bindings" "wasm-managed-exceptions"
    "wasm-managed-catch-destructuring" "wasm-managed-function-properties"
    "wasm-managed-json" "wasm-managed-math" "wasm-managed-module-bindings"
    "wasm-managed-number-conversion" "wasm-managed-objects" "wasm-managed-primitive-operators"
    "wasm-managed-regexp" "wasm-managed-regexp-indices" "wasm-managed-replacement" "wasm-managed-source-collections"
    "wasm-managed-strings" "wasm-managed-variadic-calls" "wasm-managed-tables"
    "wasm-managed-runtime" "wasm-managed-js-cons" "managed-persistent-vector"
    "wasm-managed-array-construction" "wasm-managed-array-search" "wasm-managed-object-properties"
    "wasm-managed-symbols" "wasm-managed-builtins" "wasm-managed-typeof"
    "wasm-managed-project-linking" "direct-wasm-backend") :map
      (lambda (name) (str "tests/" name ".test.mjs"))))
  (defun digest (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun assert-equal (actual expected &optional message) (js-call assert :equal actual expected message))
  (defun deep (actual expected &optional message) (js-call assert :deepEqual actual expected message))
  (defun ok (value &optional message) (js-call assert :ok value message))
  (defasync each (items action)
    (let ((index 0)) (while (< index (js-length items))
      (await (funcall action (aref items index))) (setq index (1+ index)))))
  (defasync replay (includeUnaryLocators)
    (let* ((records (js-array)) (unretainedReads 0)
           (reader (createOriginalCorpusSourceReader (js-object :sourceRoot sourceRoot
             :read (async (filename)
               (if (= filename (resolve sourceRoot unretained))
                 (progn (setq unretainedReads (1+ unretainedReads))
                   (js-call Buffer :from "test('unretained case', () => { throw Error('must not enter replay'); });\n"))
                 (await (readFile filename)))))))
           (options (js-object :sourceRoot sourceRoot :locators (js-array)
             :stableFiles (new globalThis.Set) :file (get reader :file) :text (get reader :text)
             :add (lambda (record) (js-call records :push record))))
           (locators (originalSourceCaseLocators literal (await (js-call reader :text literal))))
           (migration (await (readOriginalStaticDataFixtureMigration options))))
      (await (each (js-array indices unicodeSets propertyData nativeData transcendental)
        (async (filename) (setq locators (js-call locators :concat
          (originalSourceCaseLocators filename (await (js-call reader :text filename))))))))
      (when includeUnaryLocators
        (setq locators (js-call locators :concat (originalSourceCaseLocators unary (await (js-call reader :text unary))))))
      ;; The maintained static suite imports its original assertions. Its
      ;; generated wrapper is not a source containing the old registrations.
      ;; Authenticate all nineteen cases through their actual archive and map.
      (assert-equal (get migration :executedSuite) staticData)
      (let* ((assertions (get migration :assertionSource)) (archive (get assertions :file))
             (bytes (await (readFile (resolve sourceRoot archive))))
             (cases (get assertions :cases)) (wrapper (await (js-call reader :text staticData))))
        (assert-equal archive "tests/wasm-memory-static-data-test-legacy.mjs")
        (ok (js-call wrapper :includes
          (str "import \"./" (js-call archive :slice (js-length "tests/")) "\";"))
          "the selected canonical suite must actually import its complete original assertion archive")
        (assert-equal (get assertions :sourceSha256) (digest bytes))
        (assert-equal (js-length cases) 19)
        (await (each cases (async (item)
          (assert-equal (get item :file) archive)
          (assert-equal (get item :originalSuite) staticData)
          (assert-equal (get (get item :originalCase) :sourceSha256) (digest bytes))
          (ok (js-call (js-call bytes :toString "utf8") :includes (get item :contains)))))))
      ;; Execution selection is authenticated independently of retained case
      ;; coverage. Generated wrappers do not contain their old registrations.
      (let ((execution-locators (js-call locators :slice)))
        (await (each (await (readOriginalFinalFixtureMigrations options)) (async (final-migration)
          (when (get final-migration :existingReplaySuite)
            (let ((identity (await (js-call reader :file (get final-migration :suite)))))
              (js-call execution-locators :push (js-object :file (get identity :file)
                :sourceSha256 (get identity :sha256) :kind "maintained-fixture-execution-selection")))))))
        (put options :locators execution-locators))
      (deep (await (addOriginalManagedFixtureAdapters options)) (js-array))
      (assert-equal (js-length records) 1 "the complete selected compiler replay is one real product record")
      (let* ((record (aref records 0)) (request (get record :request)) (execution (get record :execution))
             (original (get record :original)) (bindings (get original :suites))
             (files (js-call bindings :map (lambda (binding) (get binding :file))))
             (host (get execution :hostSource)))
        (assert-equal (get record :id) "original-managed-suite:complete-fixture-suites")
        (assert-equal (get record :kind) "project") (assert-equal (get request :operation) "project")
        (assert-equal (get request :phased) t) (assert-equal (get request :resolveImports) t)
        (deep (get request :entries) (js-call (get record :modules) :map (lambda (item) (get item :id))))
        (ok (> (js-length (get record :modules)) 0))
        (ok (js-call (get record :modules) :every (lambda (item) (= (value-type (get item :source)) "string"))))
        (assert-equal (get execution :kind) "original-program") (assert-equal (get execution :hostRuntime) "bun")
        (assert-equal (get execution :referenceArtifact) t) (assert-equal (get execution :zeroImports) t)
        (assert-equal (get execution :timeoutMs) 1800000) (assert-equal (get original :testSource) "unmodified")
        (assert-equal (get (new globalThis.Set files) :size) (js-length files))
        (deep files (js-call (js-call files :slice) :sort))
        (await (each (js-call originalSuites :concat
          (js-array unary literal unicodeSets propertyData staticData nativeData transcendental))
          (async (filename) (ok (js-call files :includes filename) (str filename " keeps its complete original source")))))
        (await (each (await (readOriginalFinalFixtureMigrations options)) (async (final-migration)
          (when (get final-migration :existingReplaySuite)
            (ok (js-call files :includes (get final-migration :suite))
              "every authenticated original final suite has a real execution selection")))))
        (ok (not (js-call files :includes unretained))) (assert-equal unretainedReads 0)
        (ok (not (js-call (js-call reader :evidence) :some (lambda (item) (= (get item :file) unretained)))))
        (let ((schedule (js-call (new globalThis.RegExp "for\\s*\\(\\s*const\\s+suite\\s+of\\s+(\\[[^\\n]*\\])\\s*\\)\\s*await\\s+run\\s*\\(") :exec host)))
          (ok schedule "the actual host must sequentially invoke every complete original suite")
          (deep (JSON/parse (aref schedule 1)) files "hash bindings and the real selected-host execution list must match"))
        (js-call assert :match host (new globalThis.RegExp "spawn\\s*\\(\\s*process[.]env[.]BUN\\s*\\?\\?\\s*['\"]bun['\"]\\s*,\\s*args\\s*,"))
        (js-call assert :match host (new globalThis.RegExp "args\\s*[.]\\s*push\\s*\\(\\s*['\"]--preload['\"]\\s*,\\s*plugin\\s*,\\s*['\"]test['\"]\\s*,\\s*suite\\s*,?\\s*\\)"))
        (js-call assert :match host (new globalThis.RegExp "assert[.]equal\\s*\\(\\s*result[.]code\\s*,\\s*0\\s*,"))
        (deep (get original :staticDataFixtureMigration) migration)
        (await (each bindings (async (binding)
          (let* ((bytes (await (readFile (resolve sourceRoot (get binding :file)))))
                 (evidence (await (js-call reader :file (get binding :file)))))
            (assert-equal (get binding :sourceSha256) (digest bytes))
            (assert-equal (get binding :sourceSha256) (get evidence :sha256))
            (assert-equal (get evidence :bytes) (get bytes :length))
            (deep (js-call Buffer :from (get evidence :content) "base64") bytes)))))
        (deep (js-call (js-call (get record :coverage) :slice) :sort)
          (js-call (js-call locators :map (lambda (item) (get item :id))) :sort))
        (await (each locators (async (locator)
          (let ((binding (js-call bindings :find (lambda (item) (= (get item :file) (get locator :file))))))
            (ok (js-call (get binding :coverage) :includes (get locator :id))
              (str (get locator :contains) " must retain its own complete-case coverage"))
            (assert-equal (get binding :sourceSha256) (get (get locator :originalCase) :sourceSha256))
            (ok (js-call (await (js-call reader :text (get locator :file))) :includes (get locator :contains)))))))
        (js-object :record record :locators locators))))
  (test "the original f64 unary suite is mandatory even without retained unary locators and preserves every prior complete suite"
    (async ()
      (let* ((result (await (replay false))) (locators (get result :locators)) (record (get result :record)))
        (ok (js-call locators :some (lambda (item) (= (get item :file) literal))))
        (ok (js-call locators :some (lambda (item) (= (get item :file) indices))))
        (ok (js-call locators :every (lambda (item)
          (js-call (js-array literal indices unicodeSets propertyData nativeData transcendental) :includes (get item :file)))))
        (deep (get (js-call (get (get record :original) :suites) :find
          (lambda (item) (= (get item :file) unary))) :coverage) (js-array)))))
  (test "retained f64 literal and unary registrations all bind their actual source hashes and selected-host execution without omissions"
    (async ()
      (let* ((result (await (replay t))) (record (get result :record)) (locators (get result :locators)))
        (await (each (js-array literal unary indices unicodeSets propertyData nativeData transcendental)
          (async (filename)
            (let ((cases (js-call locators :filter (lambda (item) (= (get item :file) filename)))))
              (ok (> (js-length cases) 0))
              (deep (get (js-call (get (get record :original) :suites) :find
                (lambda (item) (= (get item :file) filename))) :coverage)
                (js-call cases :map (lambda (item) (get item :id)))))))))))
)
