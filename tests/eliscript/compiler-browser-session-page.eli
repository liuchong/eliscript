        (let* ((source (if (= operation "emit-memory-ir") "(import \"eliscript:memory32\" load-u32) (defun read32 (p) (load-u32 p)) (export read32)" "(defun run () 42) (export run)"))
               (filename "posted-ir.eli") (ir (get (await (js-call c :request (js-object :operation "compile-ir" :source source :filename filename))) :ir))
               (request (if (= operation "project-ir") (js-object :operation operation :target "javascript" :entry "posted.mjs" :modules (js-array (js-object :id "posted.mjs" :filename filename :source source :ir ir)))
                 (js-object :operation operation :target (if (= operation "emit-memory-ir") "wasm" "javascript") :filename filename :source source :ir ir :memory (js-object :initialPages 1 :maximumPages 2)))))
          (await (js-call c :setSource request (js-object :revision 100)))
          (put prototype :postMessage (new globalThis.Proxy previous (js-object :apply (lambda (target receiver arguments)
            (let* ((message (aref arguments 0)) (result (Reflect/apply target receiver arguments)))
              (when (and message (= (get message :type) "request") (= (value-type (get message :request)) "string") (= (get (JSON/parse (get message :request)) :operation) operation))
                (setq actual-post (js-object :type (get message :type) :operation (get (JSON/parse (get message :request)) :operation))) (funcall resolve-posted)) result)))))
          (let* ((controller (new globalThis.AbortController)) (reason (new globalThis.Error (+ "cancel posted " operation)))
                 (pending (js-call c :request request (js-object :signal (get controller :signal))))
                 (rejected (js-call pending :then (lambda () (throw (new globalThis.Error "posted request ignored cancellation")))
                   (lambda (error) (check (Object/is error reason) "posted cancellation reason identity") (get error :message)))))
