              (await (js-call c :dispose)) (await (js-call c :dispose))
              (assert-same actual-post (js-object :type "request" :operation operation) "actual requested operation was posted")
              (js-object :host (get c :host) :operation operation :message message :actualPost actual-post :lifetime (lifetime)))))
        (finally (put prototype :postMessage previous) (await (js-call c :dispose))))))

  (defasync dispatch (input)
    (let ((kind (get input :case)))
      (cond ((= kind "initialize") (await (initialize input)))
        ((= kind "project") (await (emit-project input)))
        ((= kind "ingress") (await (ingress input)))
        ((= kind "basic") (await (basic input)))
        ((= kind "asset") (await (asset-case input)))
        ((= kind "semantic") (await (semantic input)))
        ((= kind "ir-edits") (await (ir-edits input)))
        ((= kind "cancel-posted") (await (cancel-posted input)))
        ((= kind "dispose") (try (when compiler (await (js-call compiler :dispose)) (await (js-call compiler :dispose)))
          (finally (setq compiler nil) (setq resources nil))) (lifetime))
        (t (throw (new globalThis.Error (+ "unknown actual browser case " kind)))))))
  (put globalThis.globalThis :__eliscriptBrowserCase dispatch))
