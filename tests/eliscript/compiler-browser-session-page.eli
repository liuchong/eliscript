(module tests.compiler-browser-session-page
  (import "/package/browser/compiler-browser.mjs" createBrowserCompiler)
  (import "/managed-project-runtime.mjs" instantiateManagedRuntime)
  (import "/debug-map.mjs" createCompilerDebugMap)

  (defvar compiler nil)
  (defvar resources nil)
  (defvar project-input nil)
  (defvar sequence-number 0)
  (defvar created 0)
  (defvar terminated 0)
  (defconst live-workers (new globalThis.Set))
  (defconst live-urls (new globalThis.Set))
  (defun check (condition message) (unless condition (throw (new globalThis.Error message))))
  (defun assert-same (actual expected message) (check (= (JSON/stringify actual) (JSON/stringify expected)) message))
  (defun runtime-error-p (error)
    (Reflect/apply (get globalThis.WebAssembly.RuntimeError globalThis.Symbol.hasInstance)
      globalThis.WebAssembly.RuntimeError (js-array error)))
  (defun report-export-name (product)
    (let ((matches (js-call (get (get product :descriptor) :functions) :filter
      (lambda (item) (or (= (get item :name) "expression-form-report") (= (get item :name) "expression_form_report"))))))
      (check (= (js-length matches) 1) "the actual descriptor must identify the original report export exactly once")
      (get (aref matches 0) :name)))
  (defun merge (&rest values) (Reflect/apply Object/assign undefined (js-call (js-array (js-object)) :concat values)))
  (defun lifetime () (js-object :created created :terminated terminated :workers (get live-workers :size) :blobs (get live-urls :size)))
  (defun counters ()
    (let ((Native (get globalThis.globalThis :Worker)))
      ;; Keep the native Worker prototype and actual platform workers. Only
      ;; construction/termination and object URL ownership are observed.
      (let ((original-create (get globalThis.URL :createObjectURL)) (original-revoke (get globalThis.URL :revokeObjectURL)))
        (put globalThis.globalThis :Worker (new globalThis.Proxy Native
          (js-object :construct (lambda (target arguments new-target)
            (let* ((worker (Reflect/construct target arguments new-target)) (stop (get worker :terminate)))
              (setq created (1+ created)) (js-call live-workers :add worker)
              (put worker :terminate (lambda (&rest arguments)
                (when (js-call live-workers :delete worker) (setq terminated (1+ terminated)))
                (Reflect/apply stop worker arguments))) worker)))))
        (put globalThis.URL :createObjectURL (lambda (&rest arguments)
          (let ((url (Reflect/apply original-create globalThis.URL arguments))) (js-call live-urls :add url) url)))
        (put globalThis.URL :revokeObjectURL (lambda (url)
          (js-call live-urls :delete url) (Reflect/apply original-revoke globalThis.URL (js-array url)))))))

  (defasync execute-js (javascript name arguments)
    (setq sequence-number (1+ sequence-number))
    (let* ((base (+ "/programs/" sequence-number "/"))
           (saved (await (funcall globalThis.fetch (+ base "program.mjs")
             (js-object :method "POST" :body javascript)))))
      (check (get saved :ok) "the exact emitted user module must be retained")
      (await (new globalThis.Promise (lambda (accept reject)
        (let ((script (js-call globalThis.document :createElement "script")))
          (put globalThis.globalThis :__eliscriptProgramRequest (js-object :name name :arguments arguments
            :resolve (lambda (value) (js-call script :remove) (funcall accept value))
            :reject (lambda (error) (js-call script :remove) (funcall reject error))))
          (put script :type "module") (put script :src (+ base "runner.mjs"))
          (put script :onerror (lambda () (js-call script :remove) (funcall reject (new globalThis.Error "actual emitted browser module failed to load"))))
          (js-call (get globalThis.document :head) :appendChild script)))))))

  (defasync save-product (key target product)
    (let ((metadata (merge product)))
      (Reflect/deleteProperty metadata "bytes")
      (let* ((body (JSON/stringify metadata))
             (saved (await (funcall globalThis.fetch (+ "/products/" key "/metadata")
               (js-object :method "POST" :headers (js-object "content-type" "application/json") :body body)))))
        (check (get saved :ok) (+ "retain actual emitted metadata: HTTP " (get saved :status) ", UTF16 units " (js-length body))))
      ;; Single JavaScript IR deliberately returns javascript/sourceMap without
      ;; a target field. Preserve that response, and use the submitted target.
      (unless (= target "javascript")
        (check (get (await (funcall globalThis.fetch (+ "/products/" key "/bytes")
          (js-object :method "POST" :body (js-call globalThis.Uint8Array :from (get product :bytes))))) :ok) "retain actual emitted binary"))))

  (defun verify-debug (product filename)
    (let* ((debug (get product :debug))
           ;; Lookup selects the deepest covering instruction. Choose that
           ;; actual range, rather than an enclosing first record at its start.
           (ranges (js-call (get debug :ranges) :filter
             (lambda (item) (and (get item :span) (= (get (get item :span) :filename) filename) (> (get item :end) (get item :start))))))
           (ordered (js-call ranges :sort (lambda (a b)
             (let ((depth (- (get b :depth 0) (get a :depth 0))))
               (if (= depth 0)
                 (- (- (get a :end) (get a :start)) (- (get b :end) (get b :start))) depth)))))
           (range (aref ordered 0)))
      (check range "actual emitted source range")
      (let ((mapped (js-call (createCompilerDebugMap debug) :lookup (get range :start)
        (js-object :functionIndex (get range :functionIndex)))))
        (check (and (= (get (get mapped :span) :filename) filename)
                    (= (get (get mapped :span) :start) (get (get range :span) :start))
                    (= (get (get mapped :span) :end) (get (get range :span) :end)))
          "exact actual instruction range"))))

  (defun run-managed (product memory)
    (let* ((binary (js-call globalThis.Uint8Array :from (get product :bytes)))
           (module (new globalThis.WebAssembly.Module binary))
           (runtime nil) (failed false) (failure undefined) (report undefined))
      (assert-same (js-call globalThis.WebAssembly.Module :imports module) (js-array) "managed user output requires zero imports")
      (setq runtime (instantiateManagedRuntime binary (merge (get resources :budget) memory (js-object :debug (get product :debug)))))
      (try
        (js-call runtime :auto (get resources :auto))
        (let ((value undefined))
          (try (setq value (js-call runtime :invoke (report-export-name product)))
            (setq report (JSON/parse (JSON/stringify (js-call runtime :toHostValue value))))
            (finally (unless (undefined? value) (js-call runtime :release value)))))
        (js-call runtime :collect) (check (= (get (js-call runtime :stats) :frameDepth) 0) "program call frame cleanup")
        (catch error (setq failed t) (setq failure error))
        (finally
          (let ((cleanup undefined) (has-cleanup false)
                (actions (js-array (lambda () (js-call runtime :closeModule)) (lambda () (js-call runtime :collect))
                  (lambda () (check (= (js-call runtime :live) 0) "program root cleanup")
                    (check (= (get (js-call runtime :stats) :frameDepth) 0) "closed program frame cleanup"))
                  (lambda () (when (get runtime :close) (js-call runtime :close))))))
            (let ((index 0)) (while (< index (js-length actions))
              (try (funcall (aref actions index)) (catch error (unless has-cleanup (setq has-cleanup t) (setq cleanup error))))
              (setq index (1+ index))))
            (when (and (not failed) has-cleanup) (setq failed t) (setq failure cleanup)))))
      (when failed (throw failure)) report))

  (defasync initialize (input)
    (counters) (setq resources (get input :resources)) (setq project-input input)
    (setq compiler (await (createBrowserCompiler (js-object :host "javascript" :manifestURL (get input :manifestURL) :worker t))))
    (check (= (get compiler :host) "javascript") "the actual final JavaScript stage3 must run")
    ;; Match the independent Node reference's explicit runtime revision before
    ;; any output target. The browser still authenticates its own literal assets.
    (await (js-call compiler :request (js-object :operation "runtime"
      :source (get (get input :runtime) :source) :filename (get (get input :runtime) :filename))))
    (let* ((source (get input :source)) (filename (get input :filename)) (entry (get input :entry))
           (compiled (await (js-call compiler :compile_string_with_source_map source filename entry filename)))
           (ir (await (js-call compiler :compile_ir_string source filename)))
           (canonical (await (js-call compiler :serialize_ir_program ir))))
      (assert-same (await (js-call compiler :serialize_ir_program (await (js-call compiler :deserialize_ir_program canonical)))) canonical "full canonical IR roundtrip")
      (js-object :compile compiled :ir ir :canonical canonical)))

  (defasync emit-project (input)
    (let* ((target (get input :target)) (memory (get resources :memory))
           (product (await (js-call compiler :compile_project
             (js-object :target target :entry (get project-input :entry) :modules (get project-input :modules)
               :resolveImports t :sourceMap t :debug t :memory memory :nativeTarget (get project-input :nativeTarget) :nativeFormat "library"))))
           (report nil))
      (check (= (get product :target) target) "project target")
      (check (= (get product :entry) (get project-input :entry)) "project entry")
      (await (save-product (+ "project/" target) target product))
      (cond ((= target "javascript")
        (check (= (js-length (get product :modules)) (js-length (get project-input :modules))) "original complete module graph")
        (let ((output (js-call (get product :modules) :find (lambda (item) (= (get item :id) (get project-input :entry))))))
          (check output "actual emitted original fixture")
          (setq report (await (execute-js (get output :javascript) "expression_form_report" (js-array))))))
        ((= target "wasm") (setq report (run-managed product memory))))
      (unless (= target "javascript") (verify-debug product (get project-input :filename)))
      (js-object :host (get compiler :host) :target target :report report :lifetime (lifetime))))

  (defconst raw-source (str "(import \"eliscript:memory32\" load-u32 store-u32 memory-size memory-grow) "
    "(defun read32 (p) (load-u32 p)) (defun set32 (p v) (store-u32 p v) (load-u32 p)) "
    "(defun grow (n) (memory-grow n)) (defun size () (memory-size)) (export read32 set32 grow size)"))
  (defasync ingress (input)
    (let* ((kind (get input :kind)) (caps (await (js-call compiler :request (js-object :operation "capabilities"))))
           (inputs (js-array)) (out (js-array)) (raw nil) (source (get project-input :source))
           (filename (get project-input :filename)) (entry (get project-input :entry)) (index 0))
      (js-call (js-array "emit-ir" "project-ir" "emit-memory-ir" "emit-typed-memory") :forEach
        (lambda (operation) (check (js-call (get caps :operations) :includes operation) (+ "actual IR operation " operation))))
      (assert-same (get caps :memoryIRTargets) (js-array "wasm" "native") "raw memory target contract")
      (while (< index (js-length (get project-input :modules)))
        (let* ((item (aref (get project-input :modules) index))
               (ir (get (await (js-call compiler :request (js-object :operation "compile-ir" :source (get item :source) :filename (get item :filename)))) :ir)))
          (js-call inputs :push (merge item (js-object :ir ir)))) (setq index (1+ index)))
      (when (= kind "memory") (setq raw (get (await (js-call compiler :request (js-object :operation "compile-ir" :source raw-source :filename "browser-memory-ir.eli"))) :ir)))
      (let* ((targets (if (= kind "memory") (get caps :memoryIRTargets) (js-array "javascript" "wasm" "native")))
             (single (get (js-call inputs :find (lambda (item) (= (get item :id) entry))) :ir)) (position 0))
        (while (< position (js-length targets))
          (let* ((target (aref targets position))
                 (memory (if (= kind "memory") (js-object :initialPages 1 :maximumPages 2) (get resources :memory)))
                 (common (js-object :target target :nativeTarget (get project-input :nativeTarget) :nativeFormat "library" :debug t :memory memory))
                 (request (cond ((= kind "project") (merge common (js-object :operation "project-ir" :entry entry :modules inputs :resolveImports t :sourceMap t)))
                   ((= kind "single") (merge common (js-object :operation "emit-ir" :ir single :source source :sourceMap (js-object :generatedFile entry :sourceName filename))))
                   (t (merge common (js-object :operation "emit-memory-ir" :ir raw)))))
                 (product (await (js-call compiler :request request))) (report nil) (trap nil))
            (await (save-product (+ kind "/" target) target product))
            (if (= target "javascript")
              (let ((output (if (= kind "project") (js-call (get product :modules) :find (lambda (item) (= (get item :id) entry))) product)))
                (check (= (value-type (get output :javascript)) "string") "actual JS emission")
                (check (= (aref (get (JSON/parse (get output :sourceMap)) :sources) 0) filename) "actual JS IR source map")
                (setq report (await (execute-js (get output :javascript) "expression_form_report" (js-array)))))
              (progn
                (if (= kind "memory")
                  (progn
                    (check (and (= (get product :abi) "memory-u32") (undefined? (get product :descriptor))) "raw and managed ABI separation")
                    (when (= target "wasm")
                      (let* ((module (new globalThis.WebAssembly.Module (js-call globalThis.Uint8Array :from (get product :bytes))))
                             (e (get (new globalThis.WebAssembly.Instance module) :exports)))
                        (assert-same (js-call globalThis.WebAssembly.Module :imports module) (js-array) "raw zero imports")
                        (check (= (unsigned-bit-shift-right (js-call e :set32 8 4294967295) 0) 4294967295) "raw write u32")
                        (check (= (unsigned-bit-shift-right (js-call e :read32 8) 0) 4294967295) "raw read u32")
                        (try (js-call e :read32 65533) (catch error
                          (check (runtime-error-p error) "actual raw bounds trap")
                          (setq trap (js-object :name (get error :name) :message (get error :message)))))
                        (check trap "raw read must trap")
                        (check (and (= (js-call e :grow 1) 1) (= (js-call e :size) 2)) "actual raw memory growth")
                        (check (and (= (unsigned-bit-shift-right (js-call e :grow 1) 0) 4294967295) (= (js-call e :set32 65536 42) 42)) "raw growth refusal and recovery")))
                    (let ((same (await (js-call compiler :request (merge common (js-object :operation "emit-typed-memory" :ir (JSON/stringify (get product :typed))))))))
                      (assert-same (get same :bytes) (get product :bytes) "actual typed and raw IR bytes")))
                  (when (= target "wasm") (setq report (run-managed product memory))))
                (verify-debug product (if (= kind "memory") "browser-memory-ir.eli" filename))))
            (js-call out :push (js-object :target target :report report :trap trap :abi (if (undefined? (get product :abi)) nil (get product :abi)))))
          (setq position (1+ position))))
      (when (= kind "memory")
        (let ((refused false))
          (try (await (js-call compiler :request (js-object :operation "emit-memory-ir" :ir raw :target "javascript" :memory (js-object :initialPages 1 :maximumPages 2))))
            (catch error (setq refused t)))
          (check refused "raw memory JavaScript target refusal"))) out))

  (defasync basic (input)
    (let ((results (js-array)) (index 0))
      (while (< index 2)
        (let* ((worker (= index 1)) (c (await (createBrowserCompiler (js-object :host "javascript" :manifestURL (get input :manifestURL) :worker worker))))
               (source "(defun add (a b) (+ a b)) (export add)") (diagnostic undefined) (stale undefined) (cancelled undefined))
          (try
            (let ((product (await (js-call c :compile_string_with_source_map source "sum.eli" "sum.mjs"))))
              (check (= (await (execute-js (get product :javascript) "add" (js-array 19 23))) 42) "actual compiled module execution")
              (check (= (aref (get (JSON/parse (get product :sourceMap)) :sources) 0) "sum.eli") "source map filename"))
            (let* ((ir (await (js-call c :compile_ir_string source "sum.eli"))) (canonical (await (js-call c :serialize_ir_program ir))))
              (assert-same (await (js-call c :serialize_ir_program (await (js-call c :deserialize_ir_program canonical)))) canonical "IR roundtrip")
              (assert-same (await (js-call c :emit_ir_string ir)) (await (js-call c :compile_string source "sum.eli")) "IR emission parity"))
            (try (await (js-call c :compile_string "(print missing)" "broken.eli")) (catch error (setq diagnostic (get error :eliscriptDiagnostic))))
            (check (= (get (get diagnostic :location) :file) "broken.eli") "structured original diagnostic")
            (let* ((request (js-object :operation "compile" :filename "revision.eli" :source source))
                   (snapshot (await (js-call c :setSource request (js-object :revision 10)))))
              (await (js-call c :request request (js-object :expectedRevision 10 :expectedSourceIdentity (get snapshot :sourceIdentity))))
              (await (js-call c :setSource (merge request (js-object :source (+ source "\n; changed"))) (js-object :revision 11)))
              (try (await (js-call c :request request (js-object :expectedRevision 10))) (catch error (setq stale (get error :code)))))
            (check (= stale "stale-source") "stale result rejection")
            (let ((controller (new globalThis.AbortController)))
              (js-call controller :abort (new globalThis.Error "cancelled acceptance request"))
              (try (await (js-call c :compile_string source "cancelled.eli" nil (js-object :signal (get controller :signal))))
                (catch error (setq cancelled (get error :message)))))
            (check (= cancelled "cancelled acceptance request") "original cancellation reason")
            (js-call results :push (js-object :worker worker :executed 42 :diagnostic (get diagnostic :code) :stale stale :cancelled cancelled))
            (finally (await (js-call c :dispose))))
          (let ((message undefined))
            (try (await (js-call c :compile_string "1")) (catch error (setq message (get error :message))))
            (check (= message "browser compiler is disposed") "disposed compiler refusal")))
        (setq index (1+ index))) results))

  (defun client (registered dispatched &optional explicit-fails explicit)
    (js-object :setSource (async (payload options) (js-call registered :push (js-object :payload payload :options options)))
      :request (async (payload)
        (if (= (get payload :operation) "capabilities") (js-object :host "javascript")
          (progn (js-call dispatched :push payload)
            (when (and explicit-fails (= (get payload :source) explicit)) (throw (new globalThis.Error "explicit runtime compilation failed")))
            (js-object :host "javascript" :result (js-object :cached t))))) :close (async () nil)))
  (defun stream-bytes (bytes)
    (new globalThis.Response (new globalThis.ReadableStream (js-object :start (lambda (controller)
      (js-call bytes :forEach (lambda (byte) (js-call controller :enqueue (js-call globalThis.Uint8Array :of byte))))
      (js-call controller :close))))))
  (defun manifest (encoding)
    (let ((result (js-object :host "javascript" :path "unused.mjs" :runtimePath "runtime.eli"
      :literalSources (js-array (js-object :id "runtime/core/value.mjs" :filename "stdlib/managed-runtime-value.eli" :path "library.eli")))))
      (when encoding (put result :runtimeEncoding encoding) (put (aref (get result :literalSources) 0) :encoding encoding)) result))
  (defasync hash-bytes (bytes)
    (js-call (js-call (js-call globalThis.Array :from (new globalThis.Uint8Array
      (await (js-call (get globalThis.crypto :subtle) :digest "SHA-256" bytes)))) :map
        (lambda (byte) (js-call (js-call byte :toString 16) :padStart 2 "0"))) :join ""))
  (defasync asset-case (input)
    (let ((mode (get input :mode)) (old-fetch (get globalThis.globalThis :fetch)) (out (js-array)))
      (try
        (cond
          ((or (= mode "split") (= mode "json"))
            (let* ((runtime (if (= mode "json") "\uFEFF; runtime \ud800😀\n(module runtime)" "\uFEFF; runtime 中😀é\n(module runtime)"))
                   (library (if (= mode "json") "\uFEFF; library \udc00中\n(module library)" "\uFEFF; library 😀中文\n(module library)"))
                   (calls (js-array)) (registered (js-array)) (dispatched (js-array))
                   (document (manifest (when (= mode "json") "json-utf16"))) (c nil))
              (when (= mode "json")
                (put document :runtimePath "runtime.eli.json")
                (put document :literalSources (js-array (js-object :id "stdlib/bit.mjs" :filename "stdlib/bit.eli" :path "bit.eli.json" :encoding "json-utf16"))))
              (put globalThis.globalThis :fetch (async (input)
                (let* ((url (funcall globalThis.String input)) (name (js-call (get (new globalThis.URL url) :pathname) :split "/")))
                  (setq name (js-call name :at -1)) (js-call calls :push url)
                  (cond ((= name "compiler-artifact.json") (js-call globalThis.Response :json document))
                    ((or (= name "runtime.eli") (= name "runtime.eli.json"))
                      (if (= mode "json") (js-call globalThis.Response :json runtime) (stream-bytes (js-call (new globalThis.TextEncoder) :encode runtime))))
                    ((or (= name "library.eli") (= name "bit.eli.json"))
                      (if (= mode "json") (js-call globalThis.Response :json library) (stream-bytes (js-call (new globalThis.TextEncoder) :encode library))))
                    (t (throw (new globalThis.Error (+ "unexpected asset " url))))))))
              (try
                (setq c (await (createBrowserCompiler (js-object :host "javascript" :manifestURL (if (= mode "json") "https://compiler-assets.invalid/codeunits/compiler-artifact.json" "https://compiler-assets.invalid/split/compiler-artifact.json") :workerClient (client registered dispatched)))))
                (await (js-call c :loadRuntime)) (await (js-call c :loadRuntime))
                (check (= (js-length dispatched) 1) "one actual runtime dispatch")
                (check (= (js-length registered) 1) "one actual source registration")
                (let ((payload (aref dispatched 0)))
                  (check (= (get payload :source) runtime) "exact runtime code units")
                  (check (= (get (aref (get payload :literalSources) 0) :source) library) "exact library code units")
                  (assert-same (get (aref registered 0) :payload) payload "registered payload identity")
                  (if (= mode "split")
                    (progn (check (= (js-call (get payload :source) :charCodeAt 0) 65279) "runtime BOM")
                      (check (= (js-call (get (aref (get payload :literalSources) 0) :source) :charCodeAt 0) 65279) "library BOM")
                      (check (= (get (aref (get payload :literalSources) 0) :id) "runtime/core/value.mjs") "library id")
                      (check (= (get (aref (get payload :literalSources) 0) :filename) "stdlib/managed-runtime-value.eli") "library filename")
                      (assert-same (js-call calls :map (lambda (url) (get (new globalThis.URL url) :pathname)))
                        (js-array "/split/compiler-artifact.json" "/split/runtime.eli" "/split/library.eli") "actual asset fetch order"))
                    (progn (check (js-call runtime :includes "\ud800") "isolated high surrogate")
                      (check (js-call library :includes "\udc00") "isolated low surrogate")
                      (check (not (js-call runtime :includes "\ufffd")) "runtime has no replacement")
                      (check (not (js-call library :includes "\ufffd")) "library has no replacement"))))
                (js-object :calls calls :registered registered :dispatched dispatched :runtime runtime :library library)
                (finally (when c (await (js-call c :dispose)))))))
          ((= mode "declarations")
            (let* ((bytes (js-call (new globalThis.TextEncoder) :encode "(module runtime)"))
                   (correct (js-object :path "runtime.eli" :bytes (js-length bytes) :sha256 (await (hash-bytes bytes))))
                   (cases (js-array (js-object :algorithm "sha1" :files (js-array correct))
                     (js-object :algorithm "sha256" :files nil) (js-object :algorithm "sha256" :files (js-array))
                     (js-object :algorithm "sha256" :files (js-array correct (merge correct))))) (index 0))
              (js-call (js-array nil -1 1.5 globalThis.Infinity "16") :forEach (lambda (size)
                (js-call cases :push (js-object :algorithm "sha256" :files (js-array (merge correct (js-object :bytes size)))))))
              (js-call (js-array "bad" (js-call "g" :repeat 64) "" nil) :forEach (lambda (hash)
                (js-call cases :push (js-object :algorithm "sha256" :files (js-array (merge correct (js-object :sha256 hash)))))))
              (while (< index (js-length cases))
                (let ((reads 0) (dispatched (js-array)) (registered (js-array)) (c nil) (failure nil))
                  (put globalThis.globalThis :fetch (async (input)
                    (if (js-call (funcall globalThis.String input) :endsWith "/compiler-artifact.json")
                      (js-call globalThis.Response :json (merge (manifest nil) (js-object :literalSources (js-array) :artifactIdentity (aref cases index))))
                      (progn (setq reads (1+ reads)) (new globalThis.Response bytes)))))
                  (try
                    (setq c (await (createBrowserCompiler (js-object :host "javascript" :manifestURL "https://compiler-assets.invalid/bindings/compiler-artifact.json" :workerClient (client registered dispatched)))))
                    (try (await (js-call c :loadRuntime)) (catch error (setq failure (js-object :name (get error :name) :message (get error :message)))))
                    (check (and failure (= reads 0) (= (js-length dispatched) 0) (= (js-length registered) 0)) "invalid artifact declaration must not reach source IO or dispatch")
                    (js-call out :push failure) (finally (when c (await (js-call c :dispose))))))
                (setq index (1+ index))) out))
          ((or (= mode "malformed") (= mode "identity"))
            (let* ((encoder (new globalThis.TextEncoder))
                   (runtime "\uFEFF; runtime 😀\n(module runtime)") (library (if (= mode "identity") "\uFEFF; library 中文\n(module library)" "\uFEFF; library 中\n(module library)"))
                   (assets (js-object "runtime.eli" (js-call encoder :encode runtime) "library.eli" (js-call encoder :encode library)))
                   (document (manifest nil)) (variants (if (= mode "malformed")
                     (js-array (js-array 192 175) (js-array 226 40 161) (js-array 237 160 128) (js-array 240 159 152)) (js-array "length" "digest")))
                   (names (js-array "runtime.eli" "library.eli")) (name-index 0))
              (when (= mode "identity")
                (let ((files (js-array)) (i 0))
                  (while (< i 2) (let* ((name (aref names i)) (bytes (get assets name)))
                    (js-call files :push (js-object :path name :bytes (js-length bytes) :sha256 (await (hash-bytes bytes))))) (setq i (1+ i)))
                  (put document :artifactIdentity (js-object :algorithm "sha256" :files files))))
              (while (< name-index 2)
                (let ((variant-index 0))
                  (while (< variant-index (js-length variants))
                    (let* ((failing (aref names name-index)) (variant (aref variants variant-index))
                           (counts (new globalThis.Map)) (registered (js-array)) (dispatched (js-array)) (c nil) (failure nil))
                      (put globalThis.globalThis :fetch (async (input)
                        (let* ((name (js-call (js-call (get (new globalThis.URL (funcall globalThis.String input)) :pathname) :split "/") :at -1))
                               (count (1+ (or (js-call counts :get name) 0))) (bytes (get assets name)))
                          (js-call counts :set name count)
                          (if (= name "compiler-artifact.json") (js-call globalThis.Response :json document)
                            (progn
                              (check bytes (+ "unexpected asset " name))
                              (when (and (= name failing) (= count 1))
                                (setq bytes (if (= mode "malformed") (js-call globalThis.Uint8Array :from (js-call (js-array 239 187 191) :concat variant))
                                  (if (= variant "length") (js-call bytes :slice 0 -1)
                                    (let ((changed (js-call bytes :slice))) (put changed (1- (js-length changed)) (bit-xor (aref changed (1- (js-length changed))) 1)) changed)))))
                              (if (= mode "malformed") (stream-bytes bytes) (new globalThis.Response bytes)))))))
                      (try
                        (setq c (await (createBrowserCompiler (js-object :host "javascript" :manifestURL "https://compiler-assets.invalid/retry/compiler-artifact.json" :workerClient (client registered dispatched)))))
                        (try (await (js-call c :loadRuntime)) (catch error (setq failure (js-object :name (get error :name) :message (get error :message)))))
                        (check failure "invalid source must reject")
                        (check (and (= (js-length registered) 0) (= (js-length dispatched) 0)) "invalid source must not dispatch")
                        (await (js-call c :loadRuntime)) (await (js-call c :loadRuntime))
                        (check (and (= (js-length registered) 1) (= (js-length dispatched) 1)) "exactly one successful retry dispatch")
                        (check (= (get (aref dispatched 0) :source) runtime) "retry runtime exact BOM and code units")
                        (check (= (get (aref (get (aref dispatched 0) :literalSources) 0) :source) library) "retry library exact code units")
                        (js-call out :push (js-object :failing failing :invalid variant :mismatch variant :failure failure :counts (Object/fromEntries counts) :registered (js-length registered) :dispatched (js-length dispatched)))
                        (finally (when c (await (js-call c :dispose))))))
                    (setq variant-index (1+ variant-index))))
                (setq name-index (1+ name-index))) out))
          ((= mode "competition")
            (let* ((registered (js-array)) (dispatched (js-array)) (entered undefined) (release undefined)
                   (downloading (new globalThis.Promise (lambda (resolve) (setq entered resolve))))
                   (waiting (new globalThis.Promise (lambda (resolve) (setq release resolve))))
                   (fallback "\uFEFF; downloaded 😀\n(module runtime)") (explicit "\uFEFF; explicit 中文\n(module runtime)")
                   (fails (get input :explicitFails)) (c nil) (pending undefined) (failure undefined))
              (put globalThis.globalThis :fetch (async (input)
                (let ((name (js-call (js-call (get (new globalThis.URL (funcall globalThis.String input)) :pathname) :split "/") :at -1)))
                  (cond ((= name "compiler-artifact.json") (js-call globalThis.Response :json (merge (manifest nil) (js-object :literalSources (js-array)))))
                    ((= name "runtime.eli") (funcall entered) (await waiting) (new globalThis.Response (js-call (new globalThis.TextEncoder) :encode fallback)))
                    (t (throw (new globalThis.Error (+ "unexpected asset " name))))))))
              (try
                (setq c (await (createBrowserCompiler (js-object :host "javascript" :manifestURL "https://compiler-assets.invalid/competition/compiler-artifact.json" :workerClient (client registered dispatched fails explicit)))))
                (setq pending (js-call c :loadRuntime)) (await downloading)
                (try (await (js-call c :request (js-object :operation "runtime" :filename "bootstrap/runtime/memory.eli" :source explicit :literalSources (js-array))))
                  (catch error (setq failure (get error :message))))
                (funcall release) (await pending) (await (js-call c :loadRuntime))
                (js-object :registered registered :dispatched dispatched :failure failure :explicit explicit :fallback fallback)
