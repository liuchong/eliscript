        (finally (put globalThis.globalThis :fetch old-fetch)))))

  (defasync semantic (input)
    (let ((results (js-array)) (index 0))
      (while (< index 2)
        (let* ((worker (= index 1)) (c (await (createBrowserCompiler (js-object :host "javascript" :manifestURL (get input :manifestURL) :worker worker))))
               (filename "edit-😀.eli") (source "; 😀\n(defun run (值) (+ 值 1)) (export run)")
               (request (js-object :operation "analyze" :source source :filename filename)))
          (try
            (let* ((snapshot (await (js-call c :setSource request (js-object :revision 3))))
                   (original (await (js-call c :request request)))
                   (at (js-length (js-call globalThis.Array :from (js-call source :slice 0 (js-call source :indexOf "1")))))
                   (edit (js-object :operation "edit-preview" :source source :filename filename :offsetUnit "unicode-scalar"
                     :expectedSourceIdentity (get original :sourceIdentity) :edits (js-array (js-object :start at :end (1+ at) :text "2"))))
                   (preview (await (js-call c :request edit (js-object :expectedRevision 3 :expectedSourceIdentity (get snapshot :sourceIdentity)))))
                   (unpublished undefined) (stale undefined))
              (check (and (get original :ok) (get original :readOnly)) "original semantic result")
              (check (and (get preview :ok) (get preview :readOnly) (= (get preview :source) (js-call source :replace "1" "2"))) "exact Unicode preview")
              (assert-same (get preview :previousSourceIdentity) (get original :sourceIdentity) "previous text identity")
              (try (await (js-call c :request (merge request (js-object :source (get preview :source))))) (catch error (setq unpublished (get error :code))))
              (check (= unpublished "stale-source") "preview must not publish edited text")
              (assert-same (await (js-call c :request request (js-object :expectedRevision 3))) original "preview leaves current result unchanged")
              (await (js-call c :setSource (merge request (js-object :source (get preview :source))) (js-object :revision 4)))
              (try (await (js-call c :request edit (js-object :expectedRevision 3))) (catch error (setq stale (get error :code))))
              (check (= stale "stale-source") "old semantic revision rejection")
              (let* ((refused (await (js-call c :request (merge edit (js-object :source (get preview :source))) (js-object :expectedRevision 4))))
                     (current (await (js-call c :request (merge request (js-object :source (get preview :source)))))))
                (check (and (not (get refused :ok)) (= (get (aref (get refused :diagnostics) 0) :code) "ELI-T0002")) "compiler refuses older text identity")
                (check (get current :ok) "current full analysis")
                (assert-same (get current :sourceIdentity) (get preview :sourceIdentity) "full analysis matches preview identity")
                (js-call results :push (js-object :worker worker :unpublished unpublished :stale stale :compilerRefusal (get (aref (get refused :diagnostics) 0) :code)))))
            (finally (await (js-call c :dispose)))))
        (setq index (1+ index))) results))
  (defasync export-run (product project)
    (let ((code (if project (get (js-call (get product :modules) :find (lambda (item) (= (get item :id) "edit-entry.mjs"))) :javascript) (get product :javascript))))
      (await (execute-js code "run" (js-array)))))
  (defasync ir-edits (input)
    (counters)
    (let* ((c (await (createBrowserCompiler (js-object :host "javascript" :manifestURL (get input :manifestURL) :worker t))))
           (codes (js-array))
           (stale (async (request options)
             (let ((failure nil))
               (try (await (js-call c :request request options)) (catch error (setq failure error)))
               (check (= (get failure :code) "stale-source") "actual IR snapshot refusal")
               (js-call codes :push (get failure :code))))))
      (try
        (let* ((source "; 中😀é\n(defun run () 1) (export run)") (filename "same-source.eli")
               (ir (get (await (js-call c :request (js-object :operation "compile-ir" :source source :filename filename))) :ir))
               (changed (JSON/parse ir))
               (fn (js-call (get changed :body) :find (lambda (node) (and (= (get node :kind) "function-declaration") (= (get node :value) "run")))))
               (last (js-call (get fn :children) :at -1)))
          (check (and (= (get last :kind) "literal") (= (get last :value) 1)) "edit actual compiled literal")
          (put last :value 2)
          (let* ((next-ir (JSON/stringify changed)) (first (js-object :operation "emit-ir" :target "javascript" :ir ir :source source :filename filename))
                 (next (merge first (js-object :ir next-ir)))
                 (before (await (js-call c :setSource first (js-object :revision 10)))))
            (check (= (await (export-run (await (js-call c :request first (js-object :expectedRevision 10 :expectedSourceIdentity (get before :sourceIdentity)))) false)) 1) "actual initial IR output")
            (let ((after (await (js-call c :setSource next (js-object :revision 11)))))
              (check (not (= (get before :sourceIdentity) (get after :sourceIdentity))) "IR operand changes source identity")
              (await (stale first (js-object :expectedRevision 10 :expectedSourceIdentity (get before :sourceIdentity))))
              (await (stale first (js-object :expectedRevision 11 :expectedSourceIdentity (get after :sourceIdentity))))
              (check (= (await (export-run (await (js-call c :request next (js-object :expectedRevision 11 :expectedSourceIdentity (get after :sourceIdentity)))) false)) 2) "IR changes must not recompile unchanged text")
              (let ((choice (await (js-call c :setSource (merge next (js-object :target "wasm" :debug t)) (js-object :revision 11)))))
                (assert-same (get choice :sourceIdentity) (get after :sourceIdentity) "output choice excludes source identity"))
              (let* ((source-project (js-object :operation "project" :entry "edit-entry.mjs" :target "javascript" :resolveImports t
                         :modules (js-array (js-object :id "edit-entry.mjs" :source source :filename filename))))
                     (project-ir (merge source-project (js-object :operation "project-ir" :modules (js-array (merge (aref (get source-project :modules) 0) (js-object :ir ir))))))
                     (changed-project (merge project-ir (js-object :modules (js-array (merge (aref (get project-ir :modules) 0) (js-object :ir next-ir))))))
                     (source-snapshot (await (js-call c :setSource source-project (js-object :revision 70))))
                     (project-before (await (js-call c :setSource project-ir (js-object :revision 20))))
                     (project-after (await (js-call c :setSource changed-project (js-object :revision 21)))))
                (check (not (= (get project-before :sourceIdentity) (get project-after :sourceIdentity))) "project IR graph identity")
                (await (stale project-ir (js-object :expectedRevision 20 :expectedSourceIdentity (get project-before :sourceIdentity))))
                (check (= (await (export-run (await (js-call c :request source-project (js-object :expectedRevision 70 :expectedSourceIdentity (get source-snapshot :sourceIdentity)))) t)) 1) "source project remains isolated")
                (check (= (await (export-run (await (js-call c :request changed-project (js-object :expectedRevision 21 :expectedSourceIdentity (get project-after :sourceIdentity)))) t)) 2) "edited project actual execution")
                (check (= (await (export-run (await (js-call c :request next (js-object :expectedRevision 11 :expectedSourceIdentity (get after :sourceIdentity)))) false)) 2) "single IR remains isolated")
                (let ((controller (new globalThis.AbortController)) (reason (new globalThis.Error "cancel real browser IR request")) (caught undefined))
                  (js-call controller :abort reason)
                  (try (await (js-call c :request next (js-object :signal (get controller :signal)))) (catch error (setq caught error)))
                  (check (Object/is caught reason) "pre-dispatch reason identity")
                  (check (= (await (export-run (await (js-call c :request next (js-object :expectedRevision 11 :expectedSourceIdentity (get after :sourceIdentity)))) false)) 2) "cancelled IR leaves source usable"))))))
        (finally (await (js-call c :dispose)) (await (js-call c :dispose))))
      (let ((closed undefined)) (try (await (js-call c :request (js-object :operation "capabilities"))) (catch error (setq closed (get error :message))))
        (check (= closed "browser compiler is disposed") "closed IR worker rejects requests"))
      (js-object :host (get c :host) :codes codes :lifetime (lifetime))))

  (defasync cancel-posted (input)
    (counters)
    (let* ((operation (get input :operation))
           (c (await (createBrowserCompiler (js-object :host "javascript" :manifestURL (get input :manifestURL) :worker t))))
           (prototype (get (get globalThis.globalThis :Worker) :prototype)) (previous (get prototype :postMessage))
           (resolve-posted undefined) (actual-post undefined)
           (posted (new globalThis.Promise (lambda (resolve) (setq resolve-posted resolve)))))
