(module tests.wasm-managed-sequence-data
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir mkdtemp readFile rm symlink writeFile)
  (import "node:os" tmpdir)
  (import "node:path" dirname posix resolve)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "node:crypto" createHash)
  (import "node:module" createRequire)
  (import "../dist/bootstrap/ir.mjs" deserialize-program)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/compiler-build.mjs" independentCompilerResources)
  (import "../tools/backends/compiler-corpus-process.mjs" originalCorpusExecutionPolicy runOriginalCorpusProcess)
  (import "../tools/backends/managed-module-graph.mjs" createManagedProjectFacades createManagedModuleGraph)
  (import "../tools/backends/managed-runtime.mjs" loadManagedHostModules)
  (import "../tools/backends/managed-source-view.mjs" createManagedSourceView isManagedSourceView)
  (import "../tools/backends/native-managed-runtime.mjs" snapshotNativeManagedRuntimeABI instantiateNativeManagedRuntime)
  (import "./helpers/managed-sequence-data-host-selfhosted.mjs"
    withSequenceSourceFailure readSequenceSourceFailureReport createSequenceDiagnosticGraph assertSequenceProtocolRejection)
  (defconst native-supported (and (= (get globalThis.process :arch) "arm64")
    (js-call (js-array "darwin" "linux") :includes (get globalThis.process :platform))))
  (defconst native-target (if (= (get globalThis.process :platform) "linux") "arm64-linux" "arm64-macos"))
  (defconst memory (Object/freeze (js-object :initialPages 128 :maximumPages 4096)))
  (defconst budget (Object/freeze (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216)))
  (defun sequence-functional-resources (profile)
    (if (undefined? profile)
      (js-object :originalRuntimeOptions (Object/assign (js-object) budget (js-object :auto 65536))
        :effectiveRuntimeOptions (Object/assign (js-object) budget (js-object :auto 65536)) :resourceAcceptance "baseline")
      (progn
        (unless (= profile "small") (throw (new globalThis.TypeError "sequence functional runtime profile must be small")))
        (js-object :functionalRuntimeProfile "small" :resourceAcceptance "deferred"
          :originalRuntimeOptions (Object/assign (js-object) budget (js-object :auto 65536))
          :effectiveRuntimeOptions (Object/assign (js-object)
            (get (independentCompilerResources (js-object :profile "small")) :budget) (js-object :auto 65536))))))
  (defconst functional-resources (sequence-functional-resources
    (get (get globalThis.process :env) "ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE")))
  (when (= (get functional-resources :resourceAcceptance) "deferred")
    (console/error "[sequence-resource-acceptance]" (JSON/stringify functional-resources)))
  (defconst entry "sequence-data.mjs")
  (defconst observations (js-array "bounded_consumption" "cached_realization" "successful_cache"
    "early_stop_and_partitions" "paths_aliases_and_collisions" "shared_hash_state" "ieee_arithmetic" "rejection_order" "persistent_map_prototype_identity"))
  (defconst original-hosts (js-array "transducer" "core-stdlib" "data-text" "value-hash"))
  (defvar directory undefined) (defvar backend undefined) (defvar lowered undefined)
  (defvar runtime-ir undefined) (defvar literal-ir undefined)
  (defvar build-receipt undefined)
  (defvar native-path undefined) (defvar wasm-path undefined) (defvar oracle-directory undefined)
  (defconst original-sources (new globalThis.Map))
  (defconst public-modules (new globalThis.Map))

  (test "explicit sequence functional resources keep the original 1024 baseline separate from the public small profile"
    (lambda ()
      (let ((baseline (sequence-functional-resources undefined))
            (functional (sequence-functional-resources "small")))
        (js-call assert :deepStrictEqual budget (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216))
        (js-call assert :deepStrictEqual (get baseline :effectiveRuntimeOptions) (get baseline :originalRuntimeOptions))
        (js-call assert :strictEqual (get baseline :resourceAcceptance) "baseline")
        (js-call assert :deepStrictEqual (get functional :originalRuntimeOptions) (get baseline :originalRuntimeOptions))
        (js-call assert :deepStrictEqual (get functional :effectiveRuntimeOptions)
          (Object/assign (js-object) (get (independentCompilerResources (js-object :profile "small")) :budget) (js-object :auto 65536)))
        (js-call assert :strictEqual (get functional :resourceAcceptance) "deferred")
        (js-call assert :strictEqual (get (sequence-execution-policy baseline) :effectiveDeadlineMs) 60000)
        (js-call assert :strictEqual (get (sequence-execution-policy functional) :originalDeadlineMs) 60000)
        (js-call assert :strictEqual (get (sequence-execution-policy functional) :effectiveDeadlineMs) nil)
        (js-call assert :strictEqual (sequence-test-deadline baseline) 60000)
        (js-call assert :strictEqual (sequence-test-deadline functional) 0)
        (let* ((registrations (js-array))
               (body (lambda () "original body"))
               (receipt (js-object :registered t))
               (registrar (lambda (name callback deadline)
                 (js-call registrations :push (js-array name callback deadline))
                 receipt)))
          (js-call assert :strictEqual
            (funcall (sequence-test-registrar registrar baseline) "strict original" body 60000) receipt)
          (js-call assert :strictEqual
            (funcall (sequence-test-registrar registrar functional) "functional original" body 60000) receipt)
          (js-call assert :deepStrictEqual registrations
            (js-array (js-array "strict original" body 60000)
                      (js-array "functional original" body 0)))
          (js-call assert :strictEqual (get (sequence-execution-policy functional) :originalDeadlineMs) 60000))
        (js-call assert :strictEqual (get build-receipt :format) "eliscript-sequence-build")
        (js-call assert :strictEqual (get build-receipt :version) 1)
        (js-call assert :strictEqual (get build-receipt :directory) directory)
        (js-call assert :notStrictEqual (get build-receipt :producerPid) (get globalThis.process :pid))
        (js-call assert :strictEqual (get build-receipt :entry) entry)
        (js-call assert :strictEqual (get build-receipt :canonicalRoundTrip) t)
        (js-call assert :deepStrictEqual (js-call original-sources :get "transducer")
          (aref (aref (get build-receipt :originalSources) 0) 1))
        (js-call assert :strictEqual (js-length literal-ir) (js-length (get build-receipt :literalIR)))
        ;; The beforeAll build scope has returned. A full host GC must retain
        ;; the real graphs used by the final negative case and compact ABI.
        (let ((saved-runtime runtime-ir) (saved-literal literal-ir) (saved-lowered lowered))
          (js-call assert :ok saved-runtime)
          (js-call assert :ok (> (js-length saved-literal) 0))
          (collect-sequence-build-garbage)
          (js-call assert :strictEqual runtime-ir saved-runtime)
          (js-call assert :strictEqual literal-ir saved-literal)
          (js-call assert :strictEqual lowered saved-lowered))
        (js-call assert :throws (lambda () (sequence-functional-resources "unknown")) globalThis.TypeError)
        (js-call assert :deepStrictEqual (sequence-child-flags "node")
          (js-array "--wasm-num-compilation-tasks=2" "--experimental-loader"
            (resolve root "tests/fixtures/compiled-eli-node-loader.mjs")))
        (js-call assert :deepStrictEqual (sequence-child-flags "bun")
          (js-array "--preload" (resolve root "tests/fixtures/compiled-eli-bun-preload.mjs"))))))

  (test "sequence original host launch preserves complete output identity first failure and later execution"
    (async ()
      (let* ((context (js-object :directory (resolve root "_worktree/sequence-launch-contract")
                        :target "native" :caseId "original-sequence" :sourceIdentity (js-object :sha256 "retained")))
             (configuration "original-run.json") (calls 0)
             (first (Object/freeze (new globalThis.Error "original child failed")))
             (output (str "  " (js-call "original-output" :repeat 10000) "\n"))
             (runner (async (command args options)
               (setq calls (1+ calls))
               (js-call assert :deepStrictEqual args (js-call (sequence-child-flags "node") :concat
                 (js-array (resolve root "tests/helpers/managed-sequence-data-host-selfhosted.mjs") configuration)))
               (js-call assert :strictEqual (get options :sourceIdentity) (get context :sourceIdentity))
               (js-call assert :strictEqual (get options :directory) (get context :directory))
               (js-call assert :strictEqual (get (get options :policy) :effectiveDeadlineMs) nil)
               (if (= calls 1) (throw first) (js-object :stdout output)))))
        (await (js-call assert :rejects
          (run-sequence-child "node" configuration context (sequence-functional-resources "small") runner)
          (lambda (error) (eq error first))))
        (js-call assert :strictEqual
          (await (run-sequence-child "node" configuration context (sequence-functional-resources "small") runner))
          (js-call output :trim))
        (js-call assert :strictEqual calls 2))))

  (defasync write (path source)
    (await (mkdir (dirname path) (js-object :recursive t))) (await (writeFile path source)))

  (test "sequence failure diagnostics preserve the first value and balance actual owner roots when source field getters also fail"
    (async ()
      (let ((secondary-values (js-array "success" false undefined)) (position 0))
        (while (< position (js-length secondary-values))
          (let* ((secondary (aref secondary-values position)) (read-fails (> position 0))
                 (primary (Object/freeze (js-object :kind 13)))
                 (roots 1) (allocations 0) (released 0) (original-releases 0) (reads (js-array))
                 (runtime (js-object
                   :pin (lambda (value)
                     (js-call assert :strictEqual value primary) (setq roots (1+ roots)))
                   :string (lambda (text) (setq allocations (1+ allocations)) (js-object :kind 5 :text text))
                   :objectGet (lambda (value key)
                     (js-call assert :strictEqual value primary)
                     (js-call reads :push (get key :text))
                     (when read-fails (throw secondary))
                     (setq allocations (1+ allocations))
                     (js-object :kind 5 :text (if (= (get key :text) "name") "TypeError" "original source message")))
                   :readString (lambda (value) (get value :text))
                   :release (lambda (value)
                     (if (eq value primary)
                       (progn (setq roots (1- roots)) (setq original-releases (1+ original-releases)))
                       (unless (undefined? value) (setq released (1+ released)))))
                   :toHostValue (lambda (&rest args) (throw (new globalThis.Error "full reflection must not run")))))
                 (caught false) (failure undefined))
            (try (withSequenceSourceFailure runtime (lambda () (throw primary)))
              (catch error (setq caught t failure error)))
            (js-call assert :strictEqual caught t)
            (js-call assert :strictEqual failure primary)
            (js-call assert :strictEqual roots 0)
            (js-call assert :strictEqual original-releases 2)
            (js-call assert :strictEqual released allocations)
            (let ((report (readSequenceSourceFailureReport primary)))
              (js-call assert :strictEqual (get report :kind) 13)
              (if read-fails
                (progn (js-call assert :strictEqual (get report :fieldReadFailed) t)
                  (js-call assert :deepStrictEqual reads (js-array "name")))
                (progn (js-call assert :strictEqual (get report :name) "TypeError")
                  (js-call assert :strictEqual (get report :message) "original source message")
                  (js-call assert :deepStrictEqual reads (js-array "name" "message"))))))
          (setq position (1+ position))))
      (let ((pins 0) (field-reads 0))
        (js-call (js-array false undefined) :forEach (lambda (primary)
          (let ((failed false) (failure nil)
                (runtime (js-object :pin (lambda (&rest args) (setq pins (1+ pins))))))
            (try (withSequenceSourceFailure runtime (lambda () (throw primary)))
              (catch error (setq failed t failure error)))
            (js-call assert :strictEqual failed t)
            (js-call assert :strictEqual failure primary)
            (js-call assert :strictEqual (readSequenceSourceFailureReport primary) undefined))))
        (let* ((primary (Object/create nil))
               (runtime (js-object :pin (lambda (&rest args) (throw false)))))
          (Object/defineProperty primary "name" (js-object :get (lambda () (setq field-reads (1+ field-reads)) (throw undefined))))
          (let ((failed false) (failure undefined))
            (try (withSequenceSourceFailure runtime (lambda () (throw primary)))
              (catch error (setq failed t failure error)))
            (js-call assert :strictEqual failed t)
            (js-call assert :strictEqual failure primary)
            (js-call assert :strictEqual field-reads 0)))
        (js-call assert :strictEqual pins 0))
      (let* ((primary (new globalThis.Error "original protocol failure"))
             (pin-attempts 0) (releases 0)
             (adapter (js-object
               :pin (lambda (value) (js-call assert :strictEqual value primary)
                 (setq pin-attempts (1+ pin-attempts)) (throw (new globalThis.Error "not an owned token")))
               :release (lambda (&rest arguments) (setq releases (1+ releases)))
               :objectGet (lambda (&rest arguments) (throw (new globalThis.Error "raw Object ABI must not receive a host Error"))))))
        (put primary :name "ProtocolDispatchError") (put primary :reason "invalid-direct-slot")
        (let ((before (Object/getOwnPropertyDescriptors primary)))
          (assertSequenceProtocolRejection adapter (lambda () (throw primary)) "invalid-direct-slot")
          (let ((failed false) (failure undefined))
            (try (withSequenceSourceFailure adapter (lambda () (throw primary)))
              (catch error (setq failed t failure error)))
            (js-call assert :strictEqual failed t)
            (js-call assert :strictEqual failure primary)
            (let ((report (readSequenceSourceFailureReport primary)))
              (js-call assert :strictEqual (get report :source) "native-error")
              (js-call assert :strictEqual (get report :name) "ProtocolDispatchError")
              (js-call assert :strictEqual (get report :message) "original protocol failure")
              (js-call assert :strictEqual (get report :reason) "invalid-direct-slot")))
          (js-call assert :deepStrictEqual (Object/getOwnPropertyDescriptors primary) before))
        (js-call assert :strictEqual pin-attempts 2)
        (js-call assert :strictEqual releases 0))
      (let* ((primary (Object/freeze (js-object :kind 13)))
             (roots 1) (allocations 0) (released 0)
             (adapter (js-object
               :pin (lambda (value) (js-call assert :strictEqual value primary) (setq roots (1+ roots)))
               :string (lambda (text) (setq allocations (1+ allocations)) (js-object :text text))
               :objectGet (lambda (value key)
                 (js-call assert :strictEqual value primary) (setq allocations (1+ allocations))
                 (js-object :text (if (= (get key :text) "name") "ProtocolDispatchError" "missing")))
               :readString (lambda (value) (get value :text))
               :release (lambda (value)
                 (if (eq value primary) (setq roots (1- roots)) (setq released (1+ released)))))))
        (assertSequenceProtocolRejection adapter (lambda () (throw primary)) "missing")
        (js-call assert :strictEqual roots 0)
        (js-call assert :strictEqual released allocations))
      (let* ((released 0) (unknown-reads 0)
            (adapter (js-object :pin (lambda (&rest arguments) (throw false))
              :release (lambda (&rest arguments) (setq released (1+ released))))))
        (js-call (js-array "success" false undefined) :forEach (lambda (secondary)
          (let* ((trace (js-array))
                 (view (createManagedSourceView (js-object :target (js-object)
                   :operations (js-object :descriptor (lambda (key) undefined)
                     :get (lambda (key receiver)
                       (js-call trace :push key)
                       (when (and (= key "message") (not (= secondary "success"))) (throw secondary))
                       (cond ((= key "name") "ProtocolDispatchError")
                             ((= key "message") "authenticated source view")
                             ((= key "reason") "invalid-direct-slot") (t undefined)))))))
                 (primary (get view :value)) (failed false) (failure undefined))
            (js-call assert :strictEqual (isManagedSourceView primary) t)
            (try (withSequenceSourceFailure adapter (lambda () (throw primary)))
              (catch error (setq failed t failure error)))
            (js-call assert :strictEqual failed t)
            (js-call assert :strictEqual failure primary)
            (let ((report (readSequenceSourceFailureReport primary)))
              (js-call assert :strictEqual (get report :source) "source-view")
              (js-call assert :strictEqual (get report :name) "ProtocolDispatchError")
              (if (= secondary "success")
                (progn
                  (js-call assert :strictEqual (get report :message) "authenticated source view")
                  (js-call assert :strictEqual (get report :reason) "invalid-direct-slot")
                  (js-call assert :deepStrictEqual trace (js-array "name" "message" "reason")))
                (progn
                  (js-call assert :strictEqual (get report :fieldReadFailed) t)
                  (js-call assert :deepStrictEqual trace (js-array "name" "message"))))))))
        (let* ((primary (new globalThis.Proxy (js-object) (js-object
                  :get (lambda (&rest arguments) (setq unknown-reads (1+ unknown-reads)) (throw undefined))
                  :getOwnPropertyDescriptor (lambda (&rest arguments) (setq unknown-reads (1+ unknown-reads)) (throw false))
                  :getPrototypeOf (lambda (&rest arguments) (setq unknown-reads (1+ unknown-reads)) (throw false)))))
               (failed false) (failure undefined))
          (try (withSequenceSourceFailure adapter (lambda () (throw primary)))
            (catch error (setq failed t failure error)))
          (js-call assert :strictEqual failed t)
          (js-call assert :strictEqual failure primary)
          (js-call assert :strictEqual (readSequenceSourceFailureReport primary) undefined))
        (js-call assert :strictEqual unknown-reads 0)
        (js-call assert :strictEqual released 0))
      (when native-supported
        ;; Reuse the actual native artifact emitted by this suite's beforeAll.
        ;; The factory attaches this graph before publishing its frozen runtime.
        (let* ((graph (createManagedModuleGraph (get lowered :descriptor)))
               (options (Object/assign (js-object) memory (get functional-resources :effectiveRuntimeOptions)
                 (js-object :moduleGraph graph :initializeModule false :nativeTarget native-target)))
               (runtime (await (instantiateNativeManagedRuntime native-path lowered options)))
               (project (get runtime :project))
               (observed (createSequenceDiagnosticGraph runtime graph)))
          (try
            (progn
              (js-call assert :strictEqual (get graph :attached) t)
              (js-call assert :strictEqual (js-call observed :attachRuntime runtime) graph)
              (js-call assert :strictEqual (get runtime :project) project)
              (js-call assert :throws
                (lambda () (js-call observed :attachRuntime
                  (Object/assign (js-object) runtime (js-object :project (Object/assign (js-object) project)))))
                (lambda (error) (= (get error :message) "managed module graph transport cannot attach")))
              (js-call assert :strictEqual (get graph :closed) false)
              (js-call runtime :auto 65536)
              (js-call observed :prepare)
              (js-call assert :strictEqual (get runtime :project) project)
              (js-call assert :strictEqual (js-call graph :attachRuntime runtime) graph)
              (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
            (finally
              (try
                (progn (js-call runtime :closeModule) (js-call runtime :collect)
                  (js-call assert :strictEqual (js-call runtime :live) 0))
                (finally (js-call runtime :close) (js-call graph :close)))))))))
  (defun retained-runtime-input (full)
    (let ((compact (snapshotNativeManagedRuntimeABI full)))
      ;; ABI extraction deliberately does not inspect debug. Retain any real
      ;; diagnostic inputs separately, after both actual emitters have finished.
      (js-call (js-array "debug" "trapSites") :forEach (lambda (name)
        (when (Object/hasOwn full name) (put compact name (get full name)))))
      compact))

  (test "native runtime ABI snapshot preserves getter order source errors and descriptor values without reading bodies or debug"
    (lambda ()
      (let* ((trace (js-array)) (body-error (new globalThis.Error "executable body must not be read"))
             (first (js-object))
             (functions (js-array first
               (js-object :name "heap-new" :arity 3) (js-object :name "value-kind" :arity 2)
               (js-object :name "heap-pin" :arity 2) (js-object :name "heap-release" :arity 2)
               (js-object :name "frame-current" :arity 1) (js-object :name "frame-unwind" :arity 2)))
             (exports (js-array "last-error" "heap-new" "value-kind" "heap-pin" "heap-release" "frame-current" "frame-unwind"))
             (alias (js-object)) (typed (js-object)) (input (js-object))
             (descriptor (js-object :source "中😀\ud800" :negativeZero -0
                           :project (js-object :modules (js-array (js-object :id "source.mjs" :steps (js-array)))))))
        (Object/defineProperties first (js-object
          :name (js-object :enumerable t :get (lambda () (js-call trace :push "name") "last-error"))
          :arity (js-object :enumerable t :get (lambda () (js-call trace :push "arity") 0))
          :body (js-object :enumerable t :get (lambda () (throw body-error)))))
        (Object/defineProperties alias (js-object
          :name (js-object :enumerable t :get (lambda () (js-call trace :push "alias-name") "last-error-alias"))
          :function (js-object :enumerable t :get (lambda () (js-call trace :push "alias-function") "last-error"))))
        (Object/defineProperties typed (js-object
          :abi (js-object :get (lambda () (js-call trace :push "abi") "memory-u32"))
          :functions (js-object :get (lambda () (js-call trace :push "functions") functions))
          :exports (js-object :get (lambda () (js-call trace :push "exports") exports))
          :aliases (js-object :get (lambda () (js-call trace :push "aliases") (js-array alias)))))
        (Object/defineProperties input (js-object
          :typed (js-object :get (lambda () (js-call trace :push "typed") typed))
          :descriptor (js-object :get (lambda () (js-call trace :push "descriptor") descriptor))
          :debug (js-object :enumerable t :get (lambda () (throw body-error)))))
        (let ((snapshot (snapshotNativeManagedRuntimeABI input)))
          (js-call assert :deepStrictEqual trace (js-array "typed" "abi" "typed" "functions" "typed" "exports" "descriptor"
            "typed" "functions" "name" "arity" "exports" "aliases" "alias-name" "alias-function" "descriptor"))
          (js-call assert :strictEqual (get (get snapshot :typed) :abi) "memory-u32")
          (js-call assert :deepStrictEqual (get snapshot :descriptor) descriptor)
          (js-call assert :notStrictEqual (get snapshot :descriptor) descriptor)
          (assert (Object/is (get (get snapshot :descriptor) :negativeZero) -0))
          (js-call assert :strictEqual (Object/hasOwn snapshot "debug") false)
          (js-call assert :strictEqual (Object/hasOwn (aref (get (get snapshot :typed) :functions) 0) "body") false)
          (put descriptor :source "changed") (js-call exports :pop)
          (put (aref functions 1) :arity 99)
          (js-call assert :strictEqual (get (get snapshot :descriptor) :source) "中😀\ud800")
          (js-call assert :strictEqual (js-length (get (get snapshot :typed) :exports)) 7)
          (js-call assert :strictEqual (get (aref (get (get snapshot :typed) :functions) 1) :arity) 3)))
      (let ((first-error (new globalThis.Error "original ABI getter")) (input (js-object)))
        (Object/defineProperty input "typed" (js-object :get (lambda () (throw first-error))))
        (js-call assert :throws (lambda () (snapshotNativeManagedRuntimeABI input))
          (lambda (error) (eq error first-error))))))
  (test "real complete native ABI snapshot retains the full descriptor and strictly rejects malformed export arities"
    (lambda ()
      (let ((snapshot (snapshotNativeManagedRuntimeABI lowered)))
        (js-call assert :deepStrictEqual (get snapshot :descriptor) (get lowered :descriptor))
        (js-call assert :notStrictEqual (get snapshot :descriptor) (get lowered :descriptor))
        (js-call assert :deepStrictEqual (get snapshot :typed) (get lowered :typed))
        (js-call (get (get snapshot :typed) :functions) :forEach (lambda (fn)
          (js-call assert :deepStrictEqual (Object/keys fn) (js-array "name" "arity"))))
        (put (aref (get (get snapshot :typed) :functions) 0) :arity -1)
        (js-call assert :throws (lambda () (snapshotNativeManagedRuntimeABI snapshot))
          (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0003"))))
      (let* ((debug (js-object :sources (js-array "中\ud800") :trapSites (js-array)))
             (source (Object/assign (js-object) lowered (js-object :debug debug :trapSites (get debug :trapSites))))
             (compact (retained-runtime-input source)))
        (js-call assert :strictEqual (get compact :debug) debug)
        (js-call assert :strictEqual (get compact :trapSites) (get debug :trapSites))
        (js-call assert :deepStrictEqual (get compact :descriptor) (get source :descriptor))
        (js-call assert :deepStrictEqual (get compact :typed) (get source :typed)))))

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-sequence-data-"))))
    (let ((request (resolve directory "build-request.json")))
      (await (writeFile request (JSON/stringify (js-object :entry entry :memory memory
        :originalHosts original-hosts :nativeSupported native-supported :nativeTarget native-target))))
      ;; One owned child does the original complete build, then exits. Its
      ;; emitter/JIT pages cannot overlap the subsequent Node execution tree.
      (let ((child (spawnSync (get globalThis.process :execPath)
                     (js-array "--smol" (resolve root "tests/helpers/managed-sequence-build-selfhosted.mjs") directory request)
                     (js-object :cwd root :stdio "inherit"))))
        (js-call assert :strictEqual (get child :error) undefined)
        (js-call assert :strictEqual (get child :status) 0 "complete original sequence build must succeed")))
    (setq build-receipt (JSON/parse (await (readFile (resolve directory "build-complete.json") "utf8"))))
    (js-call assert :strictEqual (get build-receipt :format) "eliscript-sequence-build")
    (js-call assert :strictEqual (get build-receipt :directory) directory)
    (setq oracle-directory (get build-receipt :oracleDirectory)
          wasm-path (get build-receipt :wasmPath) native-path (get build-receipt :nativePath)
          lowered (JSON/parse (await (readFile (resolve directory "lowered.json") "utf8"))))
    (setq runtime-ir (deserialize-program
      (await (readFile (resolve directory (get build-receipt :runtimeIR)) "utf8"))))
    (setq literal-ir (js-array))
    (let ((records (get build-receipt :literalIR)) (index 0))
      (while (< index (js-length records))
        (let ((record (aref records index)))
          (js-call literal-ir :push (js-object :id (get record :id)
            :program (deserialize-program (await (readFile (resolve directory (get record :path)) "utf8"))))))
        (setq index (1+ index))))
    (js-call (get build-receipt :originalSources) :forEach (lambda (pair)
      (js-call original-sources :set (aref pair 0) (aref pair 1))))
    (js-call (get build-receipt :publicModules) :forEach (lambda (pair)
      (js-call public-modules :set (aref pair 0) (aref pair 1))))) 120000)
  (afterAll (async ()
    (setq runtime-ir undefined literal-ir undefined)
    (when directory (await (rm directory (js-object :recursive t :force t))))))

  ;; Bound V8's parallel compiler workers, whose default is 128 on this
  ;; engine. This changes scheduling only: the original image, tiering, host
  ;; source, inputs, GC threshold and assertions remain exact. Strict execution
  ;; retains the original deadline; explicit functional execution defers it.
  (defun sequence-child-flags (engine)
    (if (= engine "bun")
      (js-array "--preload" (resolve root "tests/fixtures/compiled-eli-bun-preload.mjs"))
      (js-array "--wasm-num-compilation-tasks=2" "--experimental-loader"
        (resolve root "tests/fixtures/compiled-eli-node-loader.mjs"))))

  (defun collect-sequence-build-garbage ()
    ;; Collect dead emitter/build objects after their scopes have returned,
    ;; before adding the real child
    ;; compiler's memory to this process tree. Live test inputs stay rooted.
    (js-call globalThis.Bun :gc t))

  (defun sequence-execution-policy (resources)
    (originalCorpusExecutionPolicy (js-object
      :record (js-object :execution (js-object :timeoutMs 60000))
      :options (js-object :functionalRuntimeProfile (get resources :functionalRuntimeProfile)))))
  (defun sequence-test-deadline (resources)
    (let ((deadline (get (sequence-execution-policy resources) :effectiveDeadlineMs)))
      (if (nullish? deadline) 0 deadline)))
  (defun sequence-test-registrar (registrar resources)
    ;; Keep numeric deadlines at each original callsite for authenticated
    ;; corpus discovery. Only the selected Bun registrar receives the
    ;; functional execution override; strict registration keeps its argument.
    (lambda (name body original-deadline)
      (funcall registrar name body
        (if (nullish? (get (sequence-execution-policy resources) :effectiveDeadlineMs))
          0 original-deadline))))
  (defasync run-sequence-child (engine configuration context resources runner)
    (let* ((node (get (get globalThis.process :env) "NODE_BINARY" "node"))
           (command (if (= engine "bun") (get globalThis.process :execPath) node))
           (flags (sequence-child-flags engine))
           (receipt (await (funcall runner command (js-call flags :concat
             (js-array (resolve root "tests/helpers/managed-sequence-data-host-selfhosted.mjs") configuration))
             (Object/assign (js-object) context (js-object :cwd root
               :policy (sequence-execution-policy resources)
               :env (Object/assign (js-object) (get globalThis.process :env)
                 (js-object :BUN (get globalThis.process :execPath)))))))))
      (js-call (get receipt :stdout) :trim)))
  (defvar sequence-execution-index 0)
  (defasync successful (engine configuration)
    (collect-sequence-build-garbage)
    (let* ((source (await (readFile configuration "utf8"))) (input (JSON/parse source))
           (index sequence-execution-index)
           (context (js-object
             :directory (resolve root "_worktree/evidence/goal-0.0.2"
               (str "sequence-process-" (get globalThis.process :pid)) (str index "-" engine))
             :caseId (str "original-sequence:" (get input :host) ":" engine ":" (get input :mode) ":" index)
             :target (if (= (get input :host) "reference") "javascript" (get input :host))
             :sourceIdentity (js-object :suite "tests/wasm-managed-sequence-data.test.mjs"
               :configurationSha256 (js-call (js-call (createHash "sha256") :update source) :digest "hex")
               :originalSourcesSha256 (js-call (js-call (createHash "sha256")
                 :update (JSON/stringify (Array/from original-sources))) :digest "hex")))))
      (setq sequence-execution-index (1+ sequence-execution-index))
      ;; Output and lifecycle receipts survive afterAll's temporary build cleanup.
      ;; The existing outer controlled run owns the complete spawned process tree.
      (await (run-sequence-child engine configuration context functional-resources runOriginalCorpusProcess))))
  (defun selected-imports (source deployment)
    (js-call source :replace (new globalThis.RegExp "from ([\"'])(?:\\.\\.\\/)+runtime\\/(core|testing)\\/([^\"']+)\\1" "g")
      (lambda (all quote family filename)
        (let ((id (js-call public-modules :get (+ "runtime/" family "/" filename))))
          (assert id (+ "the complete original host requires an actual target module: " filename))
          (+ "from " (JSON/stringify (get (pathToFileURL (resolve deployment id)) :href)))))))
  (defasync prepare (host label)
    (let* ((deployment (resolve directory (+ host "-" label)))
           (facades (createManagedProjectFacades (get lowered :descriptor) (js-object :entry entry)))
           (files (get facades :files)) (index 0))
      (await (mkdir deployment (js-object :recursive t)))
      (while (< index (js-length files))
        (let ((file (aref files index))) (await (write (resolve deployment (get file :id)) (get file :source))))
        (setq index (1+ index)))
      deployment))
  (defasync selected (host engine label mode source ids)
    (let* ((deployment (await (prepare host (+ label "-" engine))))
           (configuration (resolve deployment "run.json")) (body (resolve deployment "original-host.mjs")))
      (when source (await (writeFile body (selected-imports source deployment))))
      (await (writeFile configuration (JSON/stringify (js-object :host host :mode mode :body body
        :module (resolve deployment (if (> (js-length ids) 0) (aref ids 0) entry))
        :deployment deployment :entry entry :lowered (resolve directory "lowered.json")
        :wasmPath wasm-path :nativePath native-path :nativeTarget native-target :memory memory
        :budget (get functional-resources :effectiveRuntimeOptions)
        :functionalRuntimeProfile (get functional-resources :functionalRuntimeProfile)
        :resourceAcceptance (get functional-resources :resourceAcceptance)
        :originalRuntimeOptions (get functional-resources :originalRuntimeOptions)
        :effectiveRuntimeOptions (get functional-resources :effectiveRuntimeOptions)
        :observations observations :arguments (js-call ids :map (lambda (id) (resolve deployment id)))))))
      (successful engine configuration)))
  (defasync reference (engine label mode source ids)
    (let ((configuration (resolve directory (+ "reference-" label "-" engine ".json")))
          (body (resolve directory (+ "reference-" label "-" engine ".mjs"))))
      (when source
        (await (writeFile body (js-call source :replace
          (new globalThis.RegExp "from ([\"'])(\\.\\.\\/\\.\\.\\/runtime\\/[^\"']+)\\1" "g")
          (lambda (all quote path) (+ "from " (JSON/stringify (get (pathToFileURL (resolve root "tests/fixtures" path)) :href))))))))
      (await (writeFile configuration (JSON/stringify (js-object :host "reference" :mode mode :body body
        :module (resolve oracle-directory (if (> (js-length ids) 0) (aref ids 0) entry))
        :observations observations :arguments (js-call ids :map (lambda (id) (resolve oracle-directory id)))))))
      (successful engine configuration)))

  (defun register-cases (host engine)
    (let ((actual-test (sequence-test-registrar
            (js-call test :skipIf (and (= host "native") (not native-supported))) functional-resources))
          (index 0))
      (while (< index (js-length original-hosts))
        (let ((name (aref original-hosts index)))
          (funcall actual-test (+ host "/" engine ": complete original " name " host corpus")
            (async ()
              (let* ((source (js-call original-sources :get name))
                     (expected (await (reference engine name "body" source (js-array))))
                     (actual (await (selected host engine name "body" source (js-array)))))
                (js-call assert :deepStrictEqual (JSON/parse actual) (JSON/parse expected))
                (when (= name "value-hash")
                  (js-call assert :deepStrictEqual (JSON/parse actual)
                    (JSON/parse (await (readFile (resolve root "tests/fixtures/value-hashes.json") "utf8"))))))) 60000))
        (setq index (1+ index)))
      (funcall actual-test (+ host "/" engine ": complete original compiled lazy-sequence fixture")
        (async ()
          (let ((source (js-call original-sources :get "lazy-sequence")) (ids (js-array "tests/fixtures/lazy-sequence.mjs")))
            (js-call assert :ok (js-call source :includes
              "const fixture = await import(pathToFileURL(modulePath).href);"))
            (js-call assert :deepStrictEqual (JSON/parse (await (selected host engine "lazy" "body" source ids)))
              (JSON/parse (await (reference engine "lazy" "body" source ids)))))) 60000)
      (funcall actual-test (+ host "/" engine ": complete original core text/object host corpus")
        (async ()
          (let ((source (js-call original-sources :get "core-text-object"))
                (ids (js-array "public/runtime/core/text.mjs" "public/runtime/core/object.mjs")))
            (js-call assert :ok (js-call source :includes
              "const Text = await import(pathToFileURL(textModule).href);"))
            (js-call assert :ok (js-call source :includes
              "const ObjectCore = await import(pathToFileURL(objectModule).href);"))
            (js-call assert :deepStrictEqual (JSON/parse (await (selected host engine "text-object" "body" source ids)))
              (JSON/parse (await (reference engine "text-object" "body" source ids)))))) 60000)
      (let ((families (js-array "sequence" "text" "object")) (position 0))
        (while (< position (js-length families))
          (let ((family (aref families position)))
            (funcall actual-test (+ host "/" engine ": entire original portable " family " usage")
              (async ()
                (let* ((id (+ family "-usage.mjs")) (ids (js-array id))
                       (expected (await (reference engine (+ "portable-" family) "usage" nil ids)))
                       (actual (await (selected host engine (+ "portable-" family) "usage" nil ids))))
                  (js-call assert :deepStrictEqual (JSON/parse actual) (JSON/parse expected)))) 60000))
          (setq position (1+ position))))
      (funcall actual-test (+ host "/" engine ": original relational set complete usage and host observations")
        (async ()
          (let* ((ids (js-array "core-set-usage.mjs"))
                 (expected (await (reference engine "set" "set" nil ids)))
                 (actual (await (selected host engine "set" "set" nil ids))))
            (js-call assert :deepStrictEqual (JSON/parse actual) (JSON/parse expected)))) 60000)
      (funcall actual-test (+ host "/" engine ": internal infinite, cache, close, metadata, paths, metrics and IEEE observations")
        (async ()
          (let* ((ids (js-array entry)) (expected (JSON/parse (await (reference engine "boundaries" "observations" nil ids))))
                 (actual (JSON/parse (await (selected host engine "boundaries" "observations" nil ids)))))
            (js-call assert :deepStrictEqual actual expected)
            (js-call assert :deepStrictEqual (get actual :bounded_consumption)
              (js-array (js-array 1 2 3) (js-object :pulls 3 :closes 1) 7 (js-object :pulls 0 :closes 0) (js-array 0 1 2 3 4)))
            (js-call assert :deepStrictEqual (get actual :persistent_map_prototype_identity) (js-array t t t t))
            (js-call assert :deepStrictEqual (get actual :cached_realization)
              (js-array 1 2 (js-array 1 2) 1 (js-object :pulls 3 :closes 1) t t t 2))
            (js-call assert :deepStrictEqual (get actual :successful_cache)
              (js-array (js-array false 0) (js-array 20 40 60) (js-array 20 40 60) 1 3 t t 3))
            (js-call assert :strictEqual (aref (get actual :rejection_order) 0) t)
            (js-call assert :deepStrictEqual (aref (get actual :rejection_order) 1) (js-array 1))
            (js-call assert :deepStrictEqual (aref (get actual :rejection_order) 2) (js-object :pulls 1 :closes 1))
            (js-call assert :deepStrictEqual (js-call (get actual :ieee_arithmetic) :slice 0 5)
              (js-array (js-object :$number "-0") (js-object :$number "-Infinity") (js-object :$number "NaN")
                        (js-object :$number "+Infinity") (js-object :$number "NaN"))))) 60000)
      (funcall actual-test (+ host "/" engine ": standard print/compare slots keep identity in both boundary directions")
        (async () (js-call assert :strictEqual
          (await (selected host engine "standard-protocols" "protocols" nil (js-array entry)))
          "standard identities preserved")) 60000)
      (funcall actual-test (+ host "/" engine ": exact host collection dispatch preserves direct slots getters and original prototype identity")
        (async ()
          (let* ((ids (js-array (js-call public-modules :get "runtime/core/collection.mjs")))
                 (expected (await (reference engine "protocol-exact" "protocol-exact" nil
                   (js-array "protocol-exact-reference.mjs"))))
                 (actual (await (selected host engine "protocol-exact" "protocol-exact" nil ids))))
            (js-call assert :strictEqual expected "exact host protocol dispatch preserved")
            (js-call assert :strictEqual actual expected))) 60000)
      (funcall actual-test (+ host "/" engine ": actual indexed sequence branches preserve collection-first nth and complete tree order")
        (async ()
          (let* ((ids (js-array (js-call public-modules :get "runtime/core/sequence.mjs")))
                 (expected (JSON/parse (await (reference engine "indexed-sequence" "indexed-sequence" nil ids))))
                 (actual (JSON/parse (await (selected host engine "indexed-sequence" "indexed-sequence" nil ids)))))
            (js-call assert :deepStrictEqual expected (js-object
              :partitionAll (js-array (js-array 0 1 2) (js-array 2 3 4) (js-array 4))
              :interleave (js-array 1 10 2 20)
              :interleaveAll (js-array 1 10 2 20 30)
              :treeSeq (js-array (js-array 1 (js-array 2 3) 4) 1 (js-array 2 3) 2 3 4)
              :flatten (js-array (js-object :$number "-0") 2 3 false "中")))
            (js-call assert :deepStrictEqual actual expected))) 60000)))
  (register-cases "wasm" "bun") (register-cases "wasm" "node")
  (register-cases "native" "bun") (register-cases "native" "node")
  (test "missing relative dependencies and nonexistent external packages preserve IR and fail at their real boundary"
    (async ()
      ;; These independent negative paths cannot block any of the original
      ;; 48 cases in beforeAll. They share the already compiled real inputs.
      (setq backend (await (buildBackends (js-object :outputRoot (resolve directory "backend")))))
      (let ((bad-imports (js-array "./runtime/core/__missing_sequence_data.mjs"
                                   "eliscript/runtime/core/__missing_sequence_data.mjs")) (bad-index 0))
        (while (< bad-index (js-length bad-imports))
          (let* ((specifier (aref bad-imports bad-index))
                 (bad-program (js-call (get backend :compiler) :compile_ir_string
                   (+ "(import " (JSON/stringify specifier) " missing) (defun f () missing) (export f)")
                   "missing-canonical.eli"))
                 (before (js-call (get backend :compiler) :serialize_ir_program bad-program)))
            (if (js-call specifier :startsWith ".")
              (js-call assert :throws (lambda () (js-call (get backend :managed) :lower_managed_project
                (js-array (js-object :id "missing.mjs" :program bad-program)) "missing.mjs" runtime-ir
                (js-object :literalModules literal-ir :phased t)))
                (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-B0001")))
              (let* ((external (js-call (get backend :managed) :lower_managed_project
                                (js-array (js-object :id "missing.mjs" :program bad-program)) "missing.mjs" runtime-ir
                                (js-object :literalModules literal-ir :phased t)))
                     (descriptor (get external :descriptor))
                     (declarations (get descriptor :hostModules)))
                (js-call assert :ok (js-call declarations :some
                  (lambda (declaration) (= (get declaration :specifier) specifier))))
                ;; The independent host loader consumes declarations, not the
                ;; project's phased graph. Every declaration is the actual
                ;; lowerer's unchanged record. Resolve the real bare package
                ;; explicitly, as required by the loader; no fake provider is
                ;; supplied and resolution must fail on the original name.
                (await (js-call assert :rejects
                  (loadManagedHostModules (js-object :hostModules declarations)
                    (js-object :importModule (lambda (requested declaration)
                      (js-call assert :strictEqual requested specifier)
                      (js-call assert :strictEqual (get declaration :specifier) specifier)
                      (funcall (createRequire (resolve root "tests/wasm-managed-sequence-data.test.mjs")) requested))))
                  (lambda (error)
                    (and (js-call (js-array "ERR_MODULE_NOT_FOUND" "MODULE_NOT_FOUND" "ERR_PACKAGE_PATH_NOT_EXPORTED")
                           :includes (get error :code))
                         (js-call (get error :message) :includes "__missing_sequence_data.mjs")))))))
            (js-call assert :strictEqual (js-call (get backend :compiler) :serialize_ir_program bad-program) before))
          (setq bad-index (1+ bad-index))))) 60000))
