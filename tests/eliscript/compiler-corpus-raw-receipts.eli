(module tests.compiler-corpus-raw-receipts
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs" mkdtempSync readFileSync writeFileSync rmSync existsSync)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "../tools/backends/compiler-corpus-raw-language-fixtures.mjs" finishOriginalFixtureObservation)

  (defconst env-key "ELISCRIPT_ORIGINAL_EXECUTION_CONTEXT")
  (defconst host-sha (js-call "a" :repeat 64))
  (defconst source-identity (js-object :entry "original-fixture"
    :modules (js-array (js-object :id "original-fixture" :sourceSha256 (js-call "b" :repeat 64)))))
  (defun fixture (target body)
    (let* ((directory (mkdtempSync (resolve (tmpdir) "eliscript-original-receipt-")))
           (environment (get globalThis.process :env)) (present (Object/hasOwn environment env-key))
           (previous (get environment env-key)) (log (get globalThis.console :log)) (printed (js-array))
           (context (js-object :directory directory :target target :caseId "original-fixture:receipt"
             :sourceIdentity source-identity))
           (path (resolve directory "original-fixture-observations.json")))
      (try
        (put environment env-key (JSON/stringify context))
        (put globalThis.console :log (lambda (line) (js-call printed :push line)))
        (funcall body (js-object :directory directory :context context :path path :printed printed))
        (finally
          (put globalThis.console :log log)
          (if present (put environment env-key previous) (Reflect/deleteProperty environment env-key))
          (rmSync directory (js-object :recursive t :force t))))))
  (defun configuration (family) (js-object :family family :originalHostSha256 host-sha))
  (defun count-groups (groups) (js-call (Object/values groups) :reduce (lambda (sum count) (+ sum count)) 0))
  (defconst boundaries (js-array
    (js-object :family "catch-destructuring" :groups (js-object "iterator destructuring" 5) :subtract 1 :rows 1)
    (js-object :family "typeof" :groups (js-object "typeof and captured member" 16 "existing predicates and imported paths" 16) :subtract 2 :rows 2)
    (js-object :family "js-cons" :groups (js-object "js-cons spread" 11) :subtract 2 :rows 1)
    (js-object :family "object-properties" :groups (js-object "assign effects and partial mutation" 1 "own property key hook" 1) :subtract 2 :rows 2)
    (js-object :family "array-construction" :groups (js-object "Array.from" 7) :subtract 1 :rows 1)
    (js-object :family "primitive-operators" :groups (js-object "source hooks and bigint" 1) :subtract 0 :rows 1 :direct 8)
    (js-object :family "objects" :groups (js-object "own order and prototypes" 1) :subtract 0 :rows 1)))

  (test "original receipt retains complete denominator and exact documented host boundaries for every affected family"
    (lambda ()
      (js-call boundaries :forEach (lambda (plan)
        (fixture "wasm" (lambda (state)
          (let* ((family (get plan :family)) (groups (Object/assign (js-object) (get plan :groups) (js-object :other 3)))
                 (total (+ (count-groups groups) (or (get plan :direct) 0)))
                 (portable (- total (get plan :subtract))))
            (finishOriginalFixtureObservation (configuration family) total groups)
            (let ((receipt (JSON/parse (readFileSync (get state :path) "utf8"))))
              (js-call assert :strictEqual (get receipt :version) 1)
              (js-call assert :strictEqual (get receipt :family) family)
              (js-call assert :strictEqual (get receipt :target) "wasm")
              (js-call assert :strictEqual (get receipt :originalHostSha256) host-sha)
              (js-call assert :deepStrictEqual (get receipt :sourceIdentity) source-identity)
              (js-call assert :deepStrictEqual (get receipt :groups) groups)
              (js-call assert :strictEqual (get receipt :completeOriginalObservations) total)
              (js-call assert :strictEqual (get receipt :portableObservations) portable)
              (js-call assert :strictEqual (js-length (get receipt :hostOnlyGroups)) (get plan :rows))
              (js-call assert :strictEqual (js-call (get receipt :hostOnlyGroups) :reduce
                (lambda (sum item) (+ sum (get item :hostOnlyCalls))) 0) (get plan :subtract))
              (js-call (get receipt :hostOnlyGroups) :forEach (lambda (item)
                (js-call assert :strictEqual (get item :actualOriginalCalls) (get groups (get item :label)))
                (js-call assert :ok (> (js-length (get item :boundary)) 0))))
              (js-call assert :deepStrictEqual (get state :printed) (js-array (JSON/stringify (js-object :observations portable))))))))))))

  (test "raw BigInt and original eight direct primitive assertions stay in the portable denominator"
    (lambda ()
      (fixture "native" (lambda (state)
        (let ((groups (js-object "source hooks and bigint" 1)))
          (js-call assert :throws (lambda () (finishOriginalFixtureObservation (configuration "primitive-operators") 1 groups)))
          (js-call assert :strictEqual (existsSync (get state :path)) false)
          (finishOriginalFixtureObservation (configuration "primitive-operators") 9 groups)
          (let* ((receipt (JSON/parse (readFileSync (get state :path) "utf8"))) (row (aref (get receipt :hostOnlyGroups) 0)))
            (js-call assert :strictEqual (get receipt :portableObservations) 9)
            (js-call assert :strictEqual (get row :hostOnlyCalls) 0)
            (js-call assert :ok (js-call (get row :boundary) :includes "BigInt"))))))))

  (test "missing or inflated original boundary counts cannot mint or replace a completed receipt"
    (lambda ()
      (js-call boundaries :forEach (lambda (plan)
        (js-call (Object/keys (get plan :groups)) :forEach (lambda (label)
          (js-call (js-array -1 1) :forEach (lambda (delta)
            (fixture "wasm" (lambda (state)
              (let* ((groups (Object/assign (js-object) (get plan :groups)))
                     (unused (put groups label (+ (get groups label) delta)))
                     (total (+ (count-groups groups) (or (get plan :direct) 0))))
                (writeFileSync (get state :path) "previous-authenticated-receipt")
                (js-call assert :throws (lambda () (finishOriginalFixtureObservation (configuration (get plan :family)) total groups)))
                (js-call assert :strictEqual (readFileSync (get state :path) "utf8") "previous-authenticated-receipt")
                (js-call assert :deepStrictEqual (get state :printed) (js-array)))))))))))
      (fixture "wasm" (lambda (state)
        (js-call assert :throws (lambda () (finishOriginalFixtureObservation (configuration "objects") 2
          (js-object "own order and prototypes" 1))))
        (js-call assert :strictEqual (existsSync (get state :path)) false)
        (js-call assert :deepStrictEqual (get state :printed) (js-array))))))

  (test "group counts must be actual nonnegative integer observations even when their sum balances"
    (lambda ()
      (js-call (js-array (js-object "own order and prototypes" 1 :fake -1 :offset 2)
        (js-object "own order and prototypes" 1 :fake 0.5 :offset 0.5)) :forEach (lambda (groups)
        (fixture "wasm" (lambda (state)
          (js-call assert :throws (lambda () (finishOriginalFixtureObservation (configuration "objects") 2 groups)))
          (js-call assert :strictEqual (existsSync (get state :path)) false)
          (js-call assert :deepStrictEqual (get state :printed) (js-array))))))))

  (test "each execution target retains its own authoritative source and sidecar directory"
    (lambda ()
      (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (target)
        (fixture target (lambda (state)
          (finishOriginalFixtureObservation (configuration "objects") 1 (js-object "own order and prototypes" 1))
          (let ((receipt (JSON/parse (readFileSync (get state :path) "utf8"))))
            (js-call assert :strictEqual (get receipt :target) target)
            (js-call assert :deepStrictEqual (get receipt :sourceIdentity) source-identity))))))))

  (test "invalid target missing source identity and forged host identity cannot create observation evidence"
    (lambda ()
      (js-call (js-array (js-object :target "unknown") (js-object :target "")
        (js-object :sourceIdentity nil) (js-object :sourceIdentity (js-object))
        (js-object :sourceIdentity (js-array)) (js-object :sourceIdentity "forged")) :forEach (lambda (invalid)
        (fixture "wasm" (lambda (state)
          (put (get globalThis.process :env) env-key (JSON/stringify (Object/assign (js-object) (get state :context) invalid)))
          (js-call assert :throws (lambda () (finishOriginalFixtureObservation (configuration "objects") 1 (js-object "own order and prototypes" 1))))
          (js-call assert :strictEqual (existsSync (get state :path)) false)
          (js-call assert :deepStrictEqual (get state :printed) (js-array))))))
      (fixture "wasm" (lambda (state)
        (js-call assert :throws (lambda () (finishOriginalFixtureObservation
          (js-object :family "objects" :originalHostSha256 "forged") 1 (js-object "own order and prototypes" 1))))
        (js-call assert :strictEqual (existsSync (get state :path)) false)
        (js-call assert :deepStrictEqual (get state :printed) (js-array))))))
)
