                            (js-call assert :strictEqual (aref parts 3) (+ 17 index)))
                          (finally (js-call runtime :release result))))
                      (setq round (1+ round))))
                  (finally (finish runtime (js-array input callback)))))
              (setq index (1+ index))))))))

  (native-test "primitive Number literal IR keeps signed zero finite limits and existing nonfinite rejection"
    (async ()
      (let* ((text "(defconst anchor nil) (defun positive () 0.0) (defun negative () -0.0) (export positive negative)")
             (program (js-call (get backend :compiler) :compile_ir_string text "primitive-number-ir.eli"))
             (runtime (js-call (get backend :compiler) :compile_ir_string runtime-source "primitive-number-runtime.eli")))
        (js-call (js-array globalThis.NaN globalThis.Infinity (- globalThis.Infinity)) :forEach (lambda (number)
          (let ((copy (funcall globalThis.structuredClone program)))
            ;; Modify an actual literal IR node, not a reference to a mutable
            ;; global named NaN or Infinity. Both emitters retain rejection.
            (let ((positive (js-call (get copy :body) :find (lambda (node)
                     (and (= (get node :kind) "function-declaration") (= (get node :value) "positive"))))))
              (put (aref (get positive :children) 0) :value number))
            (js-call assert :throws (lambda () (js-call (get backend :compiler) :emit_ir_string copy)))
            (js-call assert :throws (lambda () (js-call (get backend :managed) :lower_managed_program copy runtime t)))))))))

