                 "(let* ((callback (reference/make 17)) (result (reference/call callback))) (js-array (aref result 0) (aref result 1) (Object/is (aref result 2) -0.0) (aref result 3)))"))))
          (js-call assert :deepStrictEqual expected
            (js-array (str "closure" (String/fromCharCode 0 56320)) 42 t 17))
