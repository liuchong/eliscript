                  (setq attempt (1+ attempt)))
                (cond ((= thrown "nil") (js-call assert :deepStrictEqual errors (js-array nil nil)))
                      ((= thrown "undefined") (js-call assert :deepStrictEqual errors (js-array undefined undefined)))
                      ((= thrown "false") (js-call assert :deepStrictEqual errors (js-array false false)))
                      (t
                        (assert (js-call runtime :keyEqual (aref errors 0) (aref errors 1)))
                        (let* ((key (js-call runtime :string "message")) (message (js-call runtime :objectGet (aref errors 0) key)))
                          (js-call assert :strictEqual (js-call runtime :readString message) "initialization")
                          (js-call runtime :release key) (js-call runtime :release message))
                        (js-call runtime :closeModule) (js-call runtime :collect)
                        (let* ((key (js-call runtime :string "name")) (name (js-call runtime :objectGet (aref errors 0) key)))
                          (js-call assert :strictEqual (js-call runtime :readString name) "TypeError")
                          (js-call runtime :release key) (js-call runtime :release name))))
                (finish runtime errors))
              (setq index (1+ index)))
            (let ((entered false))
              (try (await (open artifact))
                (catch error (setq entered t)
                  (cond ((= thrown "nil") (js-call assert :strictEqual error nil))
                        ((= thrown "undefined") (js-call assert :strictEqual error undefined))
                        ((= thrown "false") (js-call assert :strictEqual error false))
                        (t (js-call assert :strictEqual (get error :kind) 13)))))
              (assert entered)))
          (setq position (1+ position))))) 120000)
  (native-test "native managed instances reject foreign handles and closing during getters cannot reuse a freed mapping"
    (async ()
      (let* ((first (await (open normal))) (second (await (open normal)))
             (number (js-call first :number 2)) (other (js-call second :number 3)) (arguments (js-array)))
        (js-call assert :throws (lambda () (js-call second :readNumber number)) (lambda (error) (= (code error) "ELI-RT0001")))
        (js-call assert :strictEqual (js-call second :readNumber other) 3)
        (Object/defineProperty arguments "0" (js-object :get (lambda () (js-call first :close) number)))
        (put arguments :length 1)
        (js-call assert :throws (lambda () (js-call first :invoke "caught" arguments)) (new globalThis.RegExp "closed"))
        (js-call assert :throws (lambda () (js-call first :readNumber number)) (new globalThis.RegExp "closed"))
        (finish second (js-array other)) (js-call first :close))))
  (native-test "native managed capacity failures retain caller roots and source operands"
    (async ()
      (js-call (js-array (wasm normal (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 4096))
                        (await (open normal (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 4096)))) :forEach (lambda (runtime)
        (js-call runtime :auto 1)
        (let* ((text (js-call runtime :string "中😀\ud800")) (count (js-call runtime :number 10000)) (frame (js-call runtime :frame 1)))
          (js-call runtime :frameSet frame 0 text)
          (js-call assert :throws (lambda () (js-call runtime :invoke "repeat-text" (js-array text count)))
            (lambda (error) (= (code error) "ELI-RT0002")))
          (js-call assert :strictEqual (js-call runtime :readString text) "中😀\ud800")
          (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 1)
          (js-call runtime :leaveFrame frame) (finish runtime (js-array text count)))))))
  (native-test "native owned scalar access preserves bits bounds and zero-copy private storage"
    (async ()
      (let* ((owned (await (openNativeMemory (get normal :path) (js-object "last-error" 0)
                      (js-object :initialPages 1 :maximumPages 2))))
             (packed (new globalThis.Uint8Array 96))
             (data (new globalThis.DataView (get packed :buffer)))
             (original-view globalThis.DataView) (original-slice (get globalThis.Uint8Array.prototype :slice))
             (copies 0) (views 0))
        (try
          (js-call data :setUint32 3 2309737967 t)
          (js-call data :setFloat64 32 -0 t)
          (js-call data :setFloat64 40 globalThis.Infinity t)
          (js-call data :setFloat64 48 globalThis.NaN t)
          (js-call data :setFloat64 56 1.25 false)
          (js-call assert :strictEqual (js-call owned :write packed 0) undefined)
          (js-call assert :strictEqual (js-call owned :write (new globalThis.Uint8Array 0) 0) undefined)
          (put (js* "globalThis") :DataView (new globalThis.Proxy original-view
            (js-object :construct (lambda (target arguments new-target)
              (setq views (1+ views)) (Reflect/construct target arguments new-target)))))
          (put globalThis.Uint8Array.prototype :slice (new globalThis.Proxy original-slice
            (js-object :apply (lambda (target receiver arguments)
              (setq copies (1+ copies)) (Reflect/apply target receiver arguments)))))
          (let ((index 0))
            (while (< index 1000)
              (js-call assert :strictEqual (js-call owned :getUint32 3 t) 2309737967)
              (js-call assert :strictEqual (js-call owned :getUint32 3 false) 4023233417)
              (js-call assert :ok (Object/is (js-call owned :getFloat64 32 t) -0))
              (js-call assert :strictEqual (js-call owned :getFloat64 40 t) globalThis.Infinity)
              (js-call assert :ok (Number/isNaN (js-call owned :getFloat64 48 t)))
              (js-call assert :strictEqual (js-call owned :getFloat64 56 false) 1.25)
              (js-call owned :setUint16 7 4660 t)
              (js-call owned :setUint32 11 2309737967 false)
              (js-call assert :strictEqual (js-call owned :getUint16 7 t) 4660)
              (js-call assert :strictEqual (js-call owned :getUint32 11 false) 2309737967)
              (setq index (1+ index))))
          (js-call assert :strictEqual copies 0)
          (js-call assert :strictEqual views 0)
          (put (js* "globalThis") :DataView original-view)
          (put globalThis.Uint8Array.prototype :slice original-slice)
          (let ((copy (js-call owned :read 3 4)))
            (put copy 0 0)
            (js-call assert :strictEqual (js-call owned :getUint32 3 t) 2309737967))
          (js-call (js-array -1 65536 globalThis.Infinity globalThis.NaN 0.5) :forEach (lambda (offset)
            (js-call assert :throws (lambda () (js-call owned :getUint32 offset t)) globalThis.RangeError)))
          (js-call assert :throws (lambda () (js-call owned :setUint32 65534 1 t)) globalThis.RangeError)
          (js-call assert :throws (lambda () (js-call owned :setUint16 0 (globalThis.BigInt 1) t)) globalThis.TypeError)
          (js-call (Object/values (Object/getOwnPropertyDescriptors owned)) :forEach (lambda (entry)
            (when (Object/hasOwn entry "value")
              (js-call assert :strictEqual (ArrayBuffer/isView (get entry :value)) false))))
          (js-call assert :strictEqual (js-call owned :close) undefined)
          (js-call assert :strictEqual (js-call owned :close) undefined)
          (js-call assert :throws (lambda () (js-call owned :getUint16 0 t)) (new globalThis.RegExp "closed"))
          (js-call assert :throws (lambda () (js-call owned :setUint32 0 1 t)) (new globalThis.RegExp "closed"))
        (finally
          (put (js* "globalThis") :DataView original-view)
          (put globalThis.Uint8Array.prototype :slice original-slice)
          (js-call owned :close))))))
  (native-test "native maximum memory is privately mapped without a capacity-sized JavaScript buffer"
    (async ()
      (let* ((scope (js* "globalThis"))
             (descriptor (Object/getOwnPropertyDescriptor scope "Uint8Array"))
             (original (get descriptor :value))
             (largest 0) (first undefined) (second undefined))
        (try
          (Object/defineProperty scope "Uint8Array" (Object/assign (js-object) descriptor
            (js-object :value (new globalThis.Proxy original
              (js-object :construct (lambda (target arguments new-target)
                (let ((requested (aref arguments 0)))
                  (when (= (value-type requested) "number")
                    (setq largest (Math/max largest requested))
                    (js-call assert :ok (< requested 1048576) "native reserve must not construct a capacity-sized JavaScript array")))
                (Reflect/construct target arguments new-target)))))))
          (setq first (await (openNativeMemory (get normal :path) (js-object "last-error" 0)
            (js-object :initialPages 2 :maximumPages 65535))))
          (setq second (await (openNativeMemory (get normal :path) (js-object "last-error" 0)
            (js-object :initialPages 2 :maximumPages 65535))))
          (js-call assert :strictEqual (get first :byteLength) 131072)
          (js-call assert :strictEqual (get second :byteLength) 131072)
          (js-call first :setUint32 0 305419896 t)
          (js-call first :setUint32 131068 2309737967 false)
          (js-call assert :strictEqual (js-call first :getUint32 0 t) 305419896)
          (js-call assert :strictEqual (js-call first :getUint32 131068 false) 2309737967)
          (js-call assert :strictEqual (js-call second :getUint32 0 t) 0)
          (js-call second :setUint32 0 7 t)
          (js-call assert :strictEqual (js-call first :getUint32 0 t) 305419896)
          (let ((copy (js-call first :read 0 4)))
            (put copy 0 0)
            (js-call assert :strictEqual (js-call first :getUint32 0 t) 305419896))
          (js-call assert :strictEqual (js-call first :write (new original 0) 131072) undefined)
          (js-call assert :throws (lambda () (js-call first :read 131072 1)) globalThis.RangeError)
          (js-call assert :throws (lambda () (js-call first :setUint32 131069 1 t)) globalThis.RangeError)
          (js-call assert :throws (lambda () (js-call first :write (new original 2) 131071)) globalThis.RangeError)
          (js-call assert :strictEqual (js-call first :close) undefined)
          (js-call assert :strictEqual (js-call first :close) undefined)
          (js-call assert :throws (lambda () (js-call first :getUint32 0 t)) (new globalThis.RegExp "closed"))
          (js-call assert :strictEqual (js-call second :getUint32 0 t) 7)
          (js-call assert :ok (< largest 1048576))
        (finally
          (Object/defineProperty scope "Uint8Array" descriptor)
          (when first (js-call first :close))
          (when second (js-call second :close)))))))
  (native-test "native scalar stores convert once before checking reentrant close and preserve first throw"
    (async ()
      (let* ((owned (await (openNativeMemory (get normal :path) (js-object "last-error" 0)
                      (js-object :initialPages 1 :maximumPages 1))))
             (conversions 0) (first (js-object :original t)))
        (try
          (js-call assert :throws (lambda () (js-call owned :setUint32 0
            (js-object :valueOf (lambda () (setq conversions (1+ conversions)) (throw first))) t))
            (lambda (error) (eq error first)))
          (js-call assert :strictEqual conversions 1)
          (setq conversions 0)
          (js-call assert :throws (lambda () (js-call owned :setUint16 0
            (js-object :valueOf (lambda () (setq conversions (1+ conversions)) (js-call owned :close) 7)) t))
            (new globalThis.RegExp "closed"))
          (js-call assert :strictEqual conversions 1)
        (finally (js-call owned :close))))))
  (test "shared WASM loader rejects an explicitly null control descriptor before runtime entry"
    (lambda ()
      (let* ((ir (js-call (get backend :compiler) :compile_ir_string "(defun identity (x) x) (export identity)" "bad-control.eli"))
             (plain (js-call (get backend :wasm) :emit_memory_wasm ir)))
        (js-call (js-array "null" "false" "0" "[]" "{}") :forEach (lambda (descriptor)
          (let ((bytes (globalThis.Uint8Array.from (js-call (get backend :wasm) :append_metadata_section plain "eliscript-managed-control" descriptor))))
            (js-call assert :throws (lambda () (instantiateManagedRuntime bytes)) (lambda (error) (= (code error) "ELI-RT0003"))))))
        (js-call assert :throws (lambda () (instantiateManagedRuntime (new globalThis.Uint8Array) (js-object :initializeModule 1)))
          (lambda (error) (= (code error) "ELI-RT0003"))))))
)
