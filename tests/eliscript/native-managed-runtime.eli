(module tests.native-managed-runtime
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile rm realpath mkdir)
  (import "node:path" resolve dirname)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "node:module" createRequire)
  (import "node:child_process" spawnSync)
  (import "../tools/compiler/controlled-baseline.mjs" definition)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime instantiateManagedRuntimeWithHostModules loadManagedHostModules)
  (import "../tools/backends/managed-host-runtime.mjs" createManagedHostRuntime)
  (import "../tools/backends/managed-module-graph.mjs" createManagedModuleGraph createManagedProjectFacades loadManagedProjectGraph)
  (import "../tools/testing/persistent-literal-fixture.mjs" persistentLiteralPrivateRegexURL)
  (import "../tools/testing/fixture-environment.mjs" prepareFixtureEnvironment)
  (import "../runtime/core/regex.mjs" :as canonical-regex)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime closeNativeManagedResources)
  (import "../tools/backends/native-memory.mjs" openNativeMemory)

  (defconst native-test (js-call test :skipIf
    (or (/= (get globalThis.process :platform) "darwin") (/= (get globalThis.process :arch) "arm64"))))
  (test "native cleanup attempts both owners once and preserves every first thrown value over a later close failure"
    (lambda ()
      (js-call (js-array false undefined (js-object :original t) (new globalThis.Error "original disposal")) :forEach
        (lambda (first)
          (let ((events (js-array)) (caught false) (actual nil))
            (try (closeNativeManagedResources
              (js-object :dispose (lambda () (js-call events :push "dispose") (throw first)))
              (js-object :close (lambda () (js-call events :push "close") (throw (new globalThis.Error "later close")))))
              (catch error (setq caught t actual error)))
            (js-call assert :strictEqual caught t)
            (js-call assert :strictEqual actual first)
            (js-call assert :deepStrictEqual events (js-array "dispose" "close")))))
      (let ((first (js-object :closeFailure t)))
        (js-call assert :throws (lambda () (closeNativeManagedResources
          (js-object) (js-object :close (lambda () (throw first))))) (lambda (error) (eq error first))))))
  (defconst source-root (resolve (get (get globalThis.process :env) "ELISCRIPT_NATIVE_MANAGED_SOURCE_ROOT" root)))
  (defvar directory undefined) (defvar backend undefined) (defvar normal undefined)
  (defvar trapped undefined) (defvar runtime-source undefined)
  (defconst source (js-call (js-array
    "(defconst marker 1)"
    "(defun make (x) (let ((box (js-object :value x))) (lambda (step) (put box :value (+ (get box :value) step)) (get box :value))))"
    "(defun call (callback step) (funcall callback step))"
    "(defun transformed (array text) (js-array (js-call array :slice 1) (js-call text :toUpperCase)))"
    "(defun caught (value) (try (throw value) (catch error error)))"
    "(defun uncaught (value) (throw value))"
    "(defun make-error (kind message) (cond ((= kind 0) (new globalThis.Error message)) ((= kind 1) (new globalThis.TypeError message)) ((= kind 2) (new globalThis.RangeError message)) (t (new globalThis.SyntaxError message))))"
    "(defun error-summary (error) (js-array (aref error \"name\") (aref error \"message\")))"
    "(defun diagnosis (mode) (try (if mode (Math/round (js-object :valueOf (lambda () (js-object)) :toString (lambda () (js-object)))) (js-call 1 :toString 1)) (catch error (js-array (aref error \"name\") (aref (aref error \"eliscriptDiagnostic\") \"code\")))))"
    "(defun tdz (input) (let ((a 99)) (try (throw input) (catch {:strs [a] :or {a a}} a))))"
    "(defun repeat-text (text count) (js-call text :repeat count))"
    "(defun fault (text start) (js-call text :indexOf \"x\" start))"
    "(defun rooted-call (callback input) (funcall callback input))"
    "(defun rooted-roundtrip (input) (rooted-call (lambda (value) (let ((box (js-object :value value))) (rooted-call (lambda (ignored) (get box :value)) value))) input))"
    "(defun rooted-caught (input) (try (rooted-call (lambda (value) (throw value)) input) (catch error error)))"
    "(defun rooted-trap (text start) (rooted-call (lambda (value) (fault value start)) text))"
    "(export make call transformed caught uncaught make-error error-summary diagnosis tdz repeat-text fault rooted-roundtrip rooted-caught rooted-trap)") :join "\n"))

  (defun code (error)
    (let ((diagnostic (if (nullish? error) undefined (get error :eliscriptDiagnostic))))
      (if (nullish? diagnostic) undefined (get diagnostic :code))))
  (defun reference-error-p (error expected)
    (and (js-call globalThis.ReferenceError globalThis.Symbol.hasInstance error) (= (code error) expected)))
  (defasync selected-builder ()
    (if (= source-root root) buildBackends
      (let* ((path (resolve source-root "tools/backends/build.mjs"))
             (modules (await (loadManagedHostModules (js-object :hostModules
               (js-array (js-object :id "selected-backend" :specifier (get (pathToFileURL path) :href)
                 :referrer "native-managed-runtime.test.mjs" :allowedExports (js-array "buildBackends") :namespace false)))))))
        (get (js-call modules :get "selected-backend") :buildBackends))))
  (defasync build-artifact (runtime-text name &rest arguments)
    (let* ((text (if (or (= (js-length arguments) 0) (undefined? (aref arguments 0))) source (aref arguments 0)))
           (foreign-entry (and (> (js-length arguments) 1) (eq (aref arguments 1) t)))
           (program (js-call (get backend :compiler) :compile_ir_string text "native-managed-adapter.eli"))
           (runtime (js-call (get backend :compiler) :compile_ir_string runtime-text (+ name "-runtime.eli")))
           (lowered (if foreign-entry
             (js-call (get backend :managed) :lower_managed_program program runtime t nil nil nil nil nil nil nil t)
             (js-call (get backend :managed) :lower_managed_program program runtime t)))
           (wasm (globalThis.Uint8Array.from (if foreign-entry
             (js-call (get backend :wasm) :append_metadata_section
               (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) (js-object :maximumPages 32))
               "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))
             (js-call (get backend :managed) :emit_managed_wasm program runtime
               (js-object :abi "managed-module-v1" :maximumPages 32)))))
           (path (resolve directory (+ name ".dylib"))))
      (unless foreign-entry
        (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module wasm)) (js-array)))
      (await (writeFile path (globalThis.Uint8Array.from
        (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) "arm64-macos"))))
      (js-object :path path :lowered lowered :wasm wasm)))
  (defasync open (artifact &rest arguments)
    (let ((options (if (or (= (js-length arguments) 0) (undefined? (aref arguments 0))) (js-object) (aref arguments 0))))
      (await (instantiateNativeManagedRuntime (get artifact :path) (get artifact :lowered)
        (Object/assign (js-object :maxSlots 256 :initialBytes 16384 :maxBytes 1048576 :maximumPages 32) options)))))
  (defun wasm (&rest arguments)
    (let ((artifact (if (or (= (js-length arguments) 0) (undefined? (aref arguments 0))) normal (aref arguments 0)))
          (options (if (or (< (js-length arguments) 2) (undefined? (aref arguments 1))) (js-object) (aref arguments 1))))
      (instantiateManagedRuntime (get artifact :wasm)
        (Object/assign (js-object :maxSlots 256 :initialBytes 16384 :maxBytes 1048576) options))))
  (defun value (runtime input)
    (let ((kind (if (nullish? input) undefined (get input :kind))))
      (cond ((= kind 4) (js-call runtime :readNumber input))
            ((= kind 5) (js-call runtime :readString input))
            ((or (= kind 14) (= kind 7))
             (Array/from (js-object :length (js-call runtime :length input)) (lambda (unused index)
               (let ((child (js-call runtime :get input index)))
                 (try (value runtime child) (finally (js-call runtime :release child)))))))
            (t input))))
  (defun box (runtime input)
    (cond ((= (value-type input) "number") (js-call runtime :number input))
          ((= (value-type input) "string") (js-call runtime :string input)) (t input)))
  (defun finish (runtime &rest arguments)
    (let ((values (if (or (= (js-length arguments) 0) (undefined? (aref arguments 0))) (js-array) (aref arguments 0))))
      (js-call values :forEach (lambda (item) (js-call runtime :release item)))
      (js-call runtime :closeModule) (js-call runtime :collect)
      (js-call assert :strictEqual (js-call runtime :live) 0)
      (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
      (when (get runtime :close) (js-call runtime :close))))

  (beforeAll (async ()
    (try
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-native-managed-"))))
    (let ((builder (await (selected-builder)))) (setq backend (await (funcall builder (js-object :outputRoot directory)))))
    (let ((native-module (resolve (get backend :directory) "native-under-test.mjs")))
      (await (writeFile native-module (js-call (get backend :compiler) :compile_string
        (await (readFile (resolve root "bootstrap/backends/native.eli") "utf8")) "native.eli")))
      (put backend :native (funcall (createRequire native-module) native-module)))
    (setq runtime-source (await (readFile (resolve source-root "bootstrap/runtime/memory.eli") "utf8")))
    (setq normal (await (build-artifact runtime-source "normal")))
    (setq trapped (await (build-artifact
      (js-call runtime-source :replace (definition runtime-source "heap-text-search-unit")
        "(defun heap-text-search-unit (data length index reverse) (load-u16 4294967295))") "trap")))
    (catch error
      (console/error error)
      (throw (new globalThis.Error (str "native fixture preparation failed: "
        (get error :message (JSON/stringify error))) (js-object :cause error)))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))

  ;; Keep the complete first coercible-key input and its strict trace. This
  ;; independent case uses the selected Node JS baseline. The same native JS
  ;; computed property emitted by Emacs converted after the value on Bun;
  ;; that separate host compatibility failure is retained in the evidence.
  (defconst literal-key-coercible-source (js-call (js-array
    "(defconst initialized 7) (defvar saved nil)"
    "(defun factory () (lambda (value rest) (js-object :kind \"node\" :count (1+ (get rest :count 0)) :empty false :value value :rest rest :metadata nil)))"
    "(defun retain (count) (let ((make (factory)) (list (js-object :kind \"node\" :count 0 :empty t :value nil :rest nil :metadata nil)) (index 0)) (while (< index count) (setq list (funcall make index list) index (1+ index))) (setq saved list) (get saved :count)))"
    "(defun report () (JSON/stringify (js-array initialized (get saved :count) (get saved :value) (get (get saved :rest) :value))))"
    "(defun computed () (let* ((trace (js-array)) (symbol (funcall globalThis.Symbol \"key\")) (key (js-object :toString (lambda () (js-call trace :push \"key\") \"dynamic\"))) (object (js-object :first (progn (js-call trace :push \"first\") 1) (progn key) (progn (js-call trace :push \"value\") 2) (progn symbol) 3 :__proto__ nil))) (JSON/stringify (js-array trace (Object/keys object) (get object symbol) (nil? (Object/getPrototypeOf object)) (get object :first) (get object :dynamic)))))"
    "(export retain report computed)") :join "\n"))

  (native-test "coercible literal keys retain the complete original Node JS and managed conversion-order regression"
    (async ()
      (let* ((artifact (await (build-artifact runtime-source "literal-key-coercion" literal-key-coercible-source)))
             (reference-path (resolve directory "literal-key-coercion-reference.mjs"))
             (seed-source (resolve directory "literal-key-coercion.eli"))
             (seed-reference (resolve directory "literal-key-coercion-seed.mjs"))
             (options (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 1048576))
             (reports (js-array)))
        (await (writeFile reference-path (js-call (get backend :compiler) :compile_string
          literal-key-coercible-source "literal-key-coercion.eli")))
        (await (writeFile seed-source literal-key-coercible-source))
        (let ((compiled (spawnSync (resolve root "bin/eliscript-seed")
                        (js-array "--output" seed-reference seed-source)
                        (js-object :cwd root :encoding "utf8"))))
          (js-call assert :strictEqual (get compiled :status) 0 (get compiled :stderr)))
        (let ((references (js-array seed-reference reference-path)) (index 0))
          (while (< index (js-length references))
            (let* ((driver (resolve directory (str "literal-key-coercion-node-" index ".mjs")))
                   (source (str "(import " (JSON/stringify (aref references index)) " retain computed)\n"
                     "(unless (= (retain 128) 128) (throw (new globalThis.Error \"retained node count differs\")))\n"
                     "(console/log (computed))\n")))
              ;; The driver is emitted from Eli too; the actual Node process
              ;; evaluates both independent Emacs and selfhosted JS products.
              (await (writeFile driver (js-call (get backend :compiler) :compile_string source "literal-key-node-driver.eli")))
              (let ((observed (spawnSync (get (get globalThis.process :env) :NODE "node") (js-array driver)
                               (js-object :cwd directory :encoding "utf8"))))
                (js-call assert :strictEqual (get observed :status) 0 (get observed :stderr))
                (js-call reports :push (JSON/parse (get observed :stdout)))))
            (setq index (1+ index))))
        (let ((target 0))
          (while (< target 2)
            (let* ((runtime (if (= target 0) (wasm artifact options) (await (open artifact options))))
                   (count (js-call runtime :number 128)))
              (try
                (js-call runtime :auto 1)
                (let ((result (js-call runtime :invoke "retain" (js-array count)))) (js-call runtime :release result))
                (let ((result (js-call runtime :invoke "computed")))
                  (try (js-call reports :push (JSON/parse (js-call runtime :readString result)))
                    (finally (js-call runtime :release result))))
                (finally (finish runtime (js-array count)))))
            (setq target (1+ target))))
        (let ((expected (js-array (js-array "first" "key" "value") (js-array "first" "dynamic") 3 t 1 2)))
          (js-call assert :deepStrictEqual reports (js-array expected expected expected expected))))))

  (native-test "ordinary host views preserve cross-call roots reentry descriptors and closure identity after their decoding call returns"
    (async ()
      (let* ((text (str
               "(defun make (value rest) (js-object :value value :rest rest :read (lambda (callback) (funcall callback value rest))))\n"
               "(defun echo (value) value) (export make echo)"))
             (artifact (await (build-artifact runtime-source "ordinary-host-call-lifetime" text t)))
             (configuration (js-object :maxSlots 4096 :initialBytes 1048576 :maxBytes 16777216))
             (runtimes (js-array (await (instantiateManagedRuntimeWithHostModules (get artifact :wasm) configuration))
                         (await (open artifact configuration)))))
        (js-call runtimes :forEach (lambda (runtime)
          (let ((head nil) (previous nil) (index 0) (roots (js-array)) (closed false))
            (try
              (js-call runtime :auto 1)
              (while (< index 64)
                (let* ((number (js-call runtime :number (if (= index 63) -0.0 index)))
                       (rest (js-call runtime :fromHostValue head))
                       (raw (js-call runtime :invoke "make" (js-array number rest))))
                  (try
                    (setq previous head head (js-call runtime :toHostValue raw))
                    (js-call assert :strictEqual (get head :rest) previous)
                    (let ((identity (js-call runtime :invoke "echo" (js-array raw))))
                      (try (js-call assert :strictEqual (js-call runtime :toHostValue identity) head)
                        (finally (js-call runtime :release identity))))
                    (let ((callback (lambda (value tail)
                            (js-call assert :strictEqual tail previous)
                            (let* ((argument (js-call runtime :fromHostValue tail))
                                   (result (js-call runtime :invoke "echo" (js-array argument))))
                              (try (js-call assert :strictEqual (js-call runtime :toHostValue result) tail)
                                (finally (js-call runtime :release result) (js-call runtime :release argument))))
                            value)))
                      (js-call assert :strictEqual (Object/is (js-call head :read callback)
                        (if (= index 63) -0.0 index)) t))
                    (finally (js-call runtime :release raw) (js-call runtime :release rest)
                      (js-call runtime :release number))))
                (setq index (1+ index)))
              (js-call runtime :collect)
              (let ((cursor (get head :rest)) (sum 0))
                (while (not (nil? cursor))
                  (setq sum (+ sum (get cursor :value)) cursor (get cursor :rest)))
                (js-call assert :strictEqual sum 1953))
              (let ((read (get head :read)))
                (Object/freeze head)
                (js-call assert :strictEqual (get head :read) read)
                (js-call assert :strictEqual (get (Object/getOwnPropertyDescriptor head "rest") :value) previous)
                (js-call assert :strictEqual (Object/isFrozen head) t)
                (js-call assert :strictEqual (Reflect/set head "value" 9) false))
              (finish runtime roots) (setq closed t)
              (js-call assert :throws (lambda () (Reflect/get head "value")) (new globalThis.RegExp "closed"))
              (finally (unless closed (finish runtime roots))))))))))

  (test "foreign liveness is enumerated once per collection epoch and retained identities survive the next collection"
    (lambda ()
      (let* ((exports (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module (get normal :wasm))) :exports))
             (descriptors (Object/getOwnPropertyDescriptors exports))
             (entry (get descriptors "value-foreign-live-tokens-into")) (original (get entry :value))
             (enumerations 0) (lifecycle (js-object))
             (memory (js-object
               :view (lambda () (new globalThis.DataView (get (get exports :memory) :buffer)))
               :readBytes (lambda (offset length)
                 (js-call (new globalThis.Uint8Array (get (get exports :memory) :buffer) offset length) :slice))
               :writeBytes (lambda (offset bytes)
                 (js-call (new globalThis.Uint8Array (get (get exports :memory) :buffer) offset (js-length bytes)) :set bytes))))
             (runtime undefined))
        (put entry :value (lambda (heap buffer)
          (setq enumerations (1+ enumerations)) (Reflect/apply original exports (js-array heap buffer))))
        (setq runtime (createManagedHostRuntime (Object/defineProperties (Object/create nil) descriptors)
          (get (get normal :lowered) :descriptor) memory
          (js-object :maxSlots 4096 :initialBytes 1048576 :maxBytes 16777216) lifecycle))
        (try
          (let ((index 0))
            (while (< index 128)
              (let ((value (js-call runtime :fromHostValue (js-object :index index))))
                (js-call runtime :release value))
              (setq index (1+ index))))
          (js-call assert :strictEqual enumerations 1)
          (js-call runtime :collect)
          (js-call assert :strictEqual enumerations 2)
          (let* ((input (js-object :retained t)) (survivor (js-call runtime :fromHostValue input)) (index 0))
            (try
              (while (< index 128)
                (let ((value (js-call runtime :fromHostValue (js-object :index index))))
                  (js-call runtime :release value))
                (setq index (1+ index)))
              (js-call assert :strictEqual enumerations 2)
              (js-call runtime :collect)
              (js-call assert :strictEqual enumerations 3)
              (js-call assert :strictEqual (js-call runtime :toHostValue survivor) input)
              (finally (js-call runtime :release survivor))))
          (finally
            (js-call runtime :closeModule) (js-call lifecycle :dispose) (js-call runtime :collect)))
        (js-call assert :strictEqual (js-call runtime :live) 0)
        (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))))

  (native-test "fresh host object and callable identities preserve aliases after collection on WASM and native"
    (async ()
      (let* ((text (str "(defun call (callback value) (funcall callback value))\n"
                     "(defun echo (value) value)\n"
                     "(defun aliases (value) (js-array value value)) (export call echo aliases)"))
             (artifact (await (build-artifact runtime-source "fresh-foreign-identities" text t)))
             (configuration (js-object :maxSlots 4096 :initialBytes 1048576 :maxBytes 16777216))
             (runtimes (js-array (await (instantiateManagedRuntimeWithHostModules (get artifact :wasm) configuration))
                         (await (open artifact configuration)))))
        (js-call runtimes :forEach (lambda (runtime)
          (try
            (js-call runtime :auto 1)
            (let ((index 0))
              (while (< index 128)
                (let* ((input (js-object :index index)) (callback (lambda (value) value))
                       (argument (js-call runtime :fromHostValue input))
                       (function (js-call runtime :fromHostValue callback)))
                  (try
                    (let ((result (js-call runtime :invoke "call" (js-array function argument))))
                      (try (js-call assert :strictEqual (js-call runtime :toHostValue result) input)
                        (finally (js-call runtime :release result))))
                    (let ((result (js-call runtime :invoke "aliases" (js-array argument))))
                      (try
                        (let ((aliases (js-call runtime :toHostValue result)))
                          (js-call assert :strictEqual (aref aliases 0) input)
                          (js-call assert :strictEqual (aref aliases 1) input))
                        (finally (js-call runtime :release result))))
                    (let ((result (js-call runtime :invoke "echo" (js-array function))))
                      (try (js-call assert :strictEqual (js-call runtime :toHostValue result) callback)
                        (finally (js-call runtime :release result))))
                    (finally (js-call runtime :release function) (js-call runtime :release argument)))
                  (js-call runtime :collect)
                  (let ((again (js-call runtime :fromHostValue input)))
                    (try (js-call assert :strictEqual (js-call runtime :toHostValue again) input)
                      (finally (js-call runtime :release again)))))
                (setq index (1+ index))))
            (finally (finish runtime))))))))

  (defasync native-js-reference (reference-path expression)
    (let* ((driver (str reference-path ".driver.mjs"))
           (source (str "(import " (JSON/stringify reference-path) " :as reference)\n"
                     "(console/log (JSON/stringify " expression "))\n")))
      (await (writeFile driver (js-call (get backend :compiler) :compile_string source "native-js-reference.eli")))
      (let ((observed (spawnSync (get (get globalThis.process :env) :NODE "node") (js-array driver)
                        (js-object :cwd directory :encoding "utf8"))))
        (js-call assert :strictEqual (get observed :status) 0 (get observed :stderr))
        (JSON/parse (get observed :stdout)))))

  (native-test "module literal property keys share readonly cells across retained nodes and lambdas without changing computed keys or prototypes"
    (async ()
      (let* ((text (js-call (js-array
               "(defconst initialized 7) (defvar saved nil)"
               "(defun factory () (lambda (value rest) (js-object :kind \"node\" :count (1+ (get rest :count 0)) :empty false :value value :rest rest :metadata nil)))"
               "(defun retain (count) (let ((make (factory)) (list (js-object :kind \"node\" :count 0 :empty t :value nil :rest nil :metadata nil)) (index 0)) (while (< index count) (setq list (funcall make index list) index (1+ index))) (setq saved list) (get saved :count)))"
               "(defun report () (JSON/stringify (js-array initialized (get saved :count) (get saved :value) (get (get saved :rest) :value))))"
               "(defun computed () (let* ((trace (js-array)) (symbol (funcall globalThis.Symbol \"key\")) (object (js-object :first (progn (js-call trace :push \"first\") 1) (progn (js-call trace :push \"key\") \"dynamic\") (progn (js-call trace :push \"value\") 2) (progn symbol) 3 :__proto__ nil))) (JSON/stringify (js-array trace (Object/keys object) (get object symbol) (nil? (Object/getPrototypeOf object)) (get object :first) (get object :dynamic)))))"
               "(export retain report computed)") :join "\n"))
             (artifact (await (build-artifact runtime-source "shared-literal-keys" text)))
             (reference-path (resolve directory "shared-literal-keys-reference.mjs"))
             (options (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 1048576)))
        (await (writeFile reference-path (js-call (get backend :compiler) :compile_string text "shared-literal-keys.eli")))
        (let* ((reference (await (native-js-reference reference-path
                             "(js-object :retained (reference/retain 128) :report (reference/report) :computed (reference/computed))")))
               (adapters (js-array (wasm artifact options) (await (open artifact options)))))
          (js-call assert :strictEqual (get reference :retained) 128)
          (let ((expected (get reference :report)) (computed (get reference :computed)))
            (js-call assert :deepStrictEqual (JSON/parse expected) (js-array 7 128 127 126))
            (js-call assert :deepStrictEqual (JSON/parse computed)
              (js-array (js-array "first" "key" "value") (js-array "first" "dynamic") 3 t 1 2))
            (js-call adapters :forEach (lambda (runtime)
              (let ((count (js-call runtime :number 128)) (frame (js-call runtime :frame 1))
                    (zero (js-call runtime :number -0.0)))
                (try
                  (js-call runtime :frameSet frame 0 zero) (js-call runtime :auto 1)
                  (let ((result (js-call runtime :invoke "retain" (js-array count))))
                    (try (js-call assert :strictEqual (js-call runtime :readNumber result) 128)
                      (finally (js-call runtime :release result))))
                  (js-call runtime :collect)
                  (js-call (js-array (js-array "report" expected) (js-array "computed" computed)) :forEach (lambda (observation)
                    (let ((result (js-call runtime :invoke (aref observation 0))))
                      (try (js-call assert :strictEqual (js-call runtime :readString result) (aref observation 1))
                        (finally (js-call runtime :release result))))))
                  (js-call assert :ok (Object/is (js-call runtime :readNumber zero) -0.0))
                  (finally
                    (js-call runtime :leaveFrame frame) (js-call runtime :release zero)
                    (finish runtime (js-array count))))))))))))

  (native-test "module primitive literals share lazy cells with global constants without repeated String or Number allocations"
    (async ()
      (let* ((text (js-call (js-array
               "(defconst storedText \"hot\\u0000😀\\ud800\") (defconst storedNumber 42)"
               "(defun literal-text () \"hot\\u0000😀\\ud800\") (defun global-text () storedText)"
               "(defun literal-number () 42) (defun global-number () storedNumber)"
               "(defun report () (JSON/stringify (js-array (literal-text) (literal-number) (Object/is -0.0 -0.0) (Object/is 0 -0.0) 1.7976931348623157e308 5e-324)))"
               "(export literal-text global-text literal-number global-number report)") :join "\n"))
             (artifact (await (build-artifact runtime-source "shared-primitive-literals" text)))
             (reference-path (resolve directory "shared-primitive-literals-reference.mjs"))
             (options (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 1048576)))
        (await (writeFile reference-path (js-call (get backend :compiler) :compile_string text "shared-primitive-literals.eli")))
        (let ((reference (await (native-js-reference reference-path "(reference/report)")))
              (runtimes (js-array (wasm artifact options) (await (open artifact options)))))
          (js-call assert :deepStrictEqual (JSON/parse reference)
            (js-array (str "hot" (String/fromCharCode 0) "😀" (String/fromCharCode 55296)) 42 t false 1.7976931348623157e308 5e-324))
          (js-call runtimes :forEach (lambda (runtime)
            (try
              ;; Warm both paths, then compare actual heap-object counts. Their
              ;; existing call frames are equal; no constant should be recreated.
              (js-call runtime :auto 0)
              (js-call (js-array "literal-text" "global-text" "literal-number" "global-number") :forEach
                (lambda (name) (let ((result (js-call runtime :invoke name))) (js-call runtime :release result))))
              (js-call runtime :collect)
              (js-call (js-array (js-array "literal-text" "global-text") (js-array "literal-number" "global-number")) :forEach
                (lambda (pair)
                  (let ((costs (js-array)))
                    (js-call pair :forEach (lambda (name)
                      (let ((before (js-call runtime :live)) (index 0))
                        (while (< index 32)
                          (let ((result (js-call runtime :invoke name))) (js-call runtime :release result))
                          (setq index (1+ index)))
                        (js-call costs :push (- (js-call runtime :live) before)))))
                    (js-call assert :strictEqual (aref costs 0) (aref costs 1) (aref pair 0)))))
              (js-call runtime :collect)
              (let ((result (js-call runtime :invoke "report")))
                (try (js-call assert :strictEqual (js-call runtime :readString result) reference)
                  (finally (js-call runtime :release result))))
              (finally (finish runtime)))))))))

  (native-test "immediate snapshots use no root slots and pooled cold allocation reuses the hot result root"
    (async ()
      (let* ((text (js-call (js-array
               "(defconst anchor nil)"
               "(defun nil-value () nil) (defun false-value () false) (defun true-value () t) (defun undefined-value () undefined)"
               "(defun immediate-sequence () nil false t undefined)"
               "(defun number-value () -0.0) (defun text-value () \"shared\\u0000\\ud800\")"
               "(defun snapshots () (js-array nil false t undefined))"
               "(defun report () (JSON/stringify (js-array (nil-value) (false-value) (true-value) (undefined-value) (snapshots) (Object/is (number-value) -0.0) (text-value))))"
               "(export nil-value false-value true-value undefined-value immediate-sequence number-value text-value snapshots report)") :join "\n"))
             (artifact (await (build-artifact runtime-source "primitive-root-slots" text)))
             (typed (get (get artifact :lowered) :typed)) (functions (get typed :functions))
             (descriptor (get (get (get artifact :lowered) :descriptor) :module))
             (entry (lambda (name)
               (let ((binding (js-call (get descriptor :exports) :find (lambda (item) (= (get item :name) name)))))
                 (js-call assert :strictEqual (get binding :kind) 1)
                 (js-call functions :find (lambda (function)
                   (= (get function :name) (str "__eliscript_managed_" (get binding :index))))))))
             (root-slots (lambda (function)
               (let ((pending (js-array (get function :body))) (slots (js-array)))
                 (while (> (js-length pending) 0)
                   (let ((node (js-call pending :pop)))
                     (when (and (= (get node :kind) "call")
                                (= (get (aref functions (get node :value)) :name) "frame-new"))
                       (js-call slots :push (get (aref (get node :children) 1) :value)))
                     (js-call (get node :children) :forEach (lambda (child) (js-call pending :push child)))))
                 (js-call assert :strictEqual (js-length slots) 1)
                 (aref slots 0))))
             (reference-path (resolve directory "primitive-root-slots-reference.mjs")))
        ;; This checks the emitted runtime frame capacity, including cold-only
        ;; branches. A warm-only allocation counter cannot prove this property.
        (js-call (js-array "nil-value" "false-value" "true-value" "undefined-value" "immediate-sequence") :forEach
          (lambda (name) (js-call assert :strictEqual (funcall root-slots (funcall entry name)) 0 name)))
        (js-call (js-array "number-value" "text-value" "snapshots") :forEach
          (lambda (name) (js-call assert :strictEqual (funcall root-slots (funcall entry name)) 1 name)))
        (await (writeFile reference-path (js-call (get backend :compiler) :compile_string text "primitive-root-slots.eli")))
        (let ((expected (await (native-js-reference reference-path "(reference/report)")))
              (runtimes (js-array (wasm artifact) (await (open artifact)))))
          (js-call assert :deepStrictEqual (JSON/parse expected)
            (js-array nil false t nil (js-array nil false t nil) t (str "shared" (String/fromCharCode 0 55296))))
          (js-call runtimes :forEach (lambda (runtime)
            (try
              (js-call runtime :auto 1)
              (let ((index 0))
                (while (< index 3)
                  (let ((result (js-call runtime :invoke "report")))
                    (try (js-call assert :strictEqual (js-call runtime :readString result) expected)
                      (finally (js-call runtime :release result))))
                  (js-call runtime :collect)
                  (setq index (1+ index))))
              (finally (finish runtime)))))))))

