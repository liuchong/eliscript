                :initialPages 128 :maximumPages 4096 :initializeModule false :moduleGraph graph :hostModules providers)))))
          (js-call runtime :auto 65536)
          (let* ((loaded (await (loadManagedProjectGraph runtime (get lowered :descriptor)
