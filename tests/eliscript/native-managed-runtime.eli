  (native-test "module static calls preserve dynamic fallback evaluation identity and errors on all three outputs"
    (async ()
      (let* ((text (js-call (js-array
               "(defconst marker 7)"
               "(defun plain (x) (+ marker x))"
               "(defvar target plain)"
               "(defun direct (x) (plain x))"
               "(defun shadow (plain x) (funcall plain x))"
               "(defun dynamic (x) (funcall target x))"
               "(defun optional (&optional x) x)"
               "(defun optional-caller () (optional))"
               "(defun variadic (&rest xs) (js-length xs))"
               "(defun pair (a b) (js-array a b))"
               "(defun arity-caller () (pair 8))"
               "(defun arrow () (lambda (x) (plain x)))"
               "(defun relay (x) x)"
               "(defun throwing (x) (throw x))"
               "(defun record (trace label x) (js-call trace :push label) x)"
               "(defun combine (a b) (+ a b))"
               "(defun errors () (let ((failure (js-object :error 1))) (js-array (try (throwing failure) (catch error (eq error failure))) (try (throwing false) (catch error (eq error false))))))"
               "(defun report () (let* ((trace (js-array)) (object (js-object :alias 1)) (before (dynamic 3)) (_ (setq target (lambda (x) (+ x 100))))) (JSON/stringify (js-array (direct 3) (shadow (lambda (x) (+ x 90)) 3) before (dynamic 3) (optional-caller) (variadic 1 2 3) (arity-caller) (funcall (arrow) 3) (Object/is (relay -0.0) -0.0) (eq (relay object) object) (combine (record trace \"left\" 1) (record trace \"right\" 2)) trace (errors)))))"
               "(export plain direct shadow dynamic optional-caller arity-caller arrow report)") :join "\n"))
             (artifact (await (build-artifact runtime-source "module-static-calls" text)))
             (typed (get (get artifact :lowered) :typed))
             (functions (get typed :functions))
             (exports (get (get (get artifact :lowered) :descriptor) :module))
             (entry (lambda (name)
               (let ((record (js-call (get exports :exports) :find (lambda (item) (= (get item :name) name)))))
                 (js-call assert :strictEqual (get record :kind) 1)
                 (js-call functions :find (lambda (fn) (= (get fn :name) (str "__eliscript_managed_" (get record :index))))))))
             (calls (lambda (fn)
               (let ((pending (js-array (get fn :body))) (found (js-array)))
                 (while (> (js-length pending) 0)
                   (let* ((node (js-call pending :pop)) (children (get node :children)))
                     (when (= (get node :kind) "call")
                       (js-call found :push (get (aref functions (get node :value)) :name)))
                     (js-call children :forEach (lambda (child) (js-call pending :push child))))) found)))
             (direct-calls (funcall calls (funcall entry "direct")))
             (reference-path (resolve directory "module-static-calls-reference.mjs"))
             (expected (js-array 10 93 10 103 nil 3 (js-array 8 nil) 10 t t 3
               (js-array "left" "right") (js-array t t))))
        ;; Inspect the emitted shared IR, not an implementation-shaped mock.
        ;; Module ownership must survive while only the fixed call bypasses
        ;; callable materialization and its temporary argument tuple.
        (js-call assert :strictEqual (get (get (get artifact :lowered) :descriptor) :abi) "managed-module-v1")
        (assert (js-call direct-calls :includes (get (funcall entry "plain") :name)))
        (assert (js-call direct-calls :includes "value-function-current-this"))
        (js-call assert :strictEqual
          (js-length (js-call direct-calls :filter (lambda (name) (= name "value-call-restore")))) 2)
        (js-call (js-array "value-function-named" "value-refs" "value-source-invoke-with-this" "value-source-invoke-rooted-with-this") :forEach
          (lambda (name) (js-call assert :strictEqual (js-call direct-calls :includes name) false name)))
        (js-call (js-array "shadow" "dynamic" "optional-caller" "arity-caller") :forEach
          (lambda (name)
            (assert (js-call (funcall calls (funcall entry name)) :includes "value-source-invoke-rooted-with-this") name)))
        ;; A tail-marked lambda calling a known module function must retain
        ;; its trampoline, rather than consuming the host stack recursively.
        (assert (js-call functions :some (lambda (fn)
          (js-call (funcall calls fn) :includes "value-source-tail-call"))))
        (await (writeFile reference-path (js-call (get backend :compiler) :compile_string text "module-static-calls.eli")))
        (let ((reference (await (native-js-reference reference-path "(reference/report)"))))
          (js-call assert :deepStrictEqual (JSON/parse reference) expected))
        (let ((runtimes (js-array (wasm artifact) (await (open artifact)))))
          (js-call runtimes :forEach (lambda (runtime)
            (try
              (js-call runtime :auto 1)
              (let ((result (js-call runtime :invoke "report")))
                (try (js-call assert :deepStrictEqual (JSON/parse (js-call runtime :readString result)) expected)
                  (finally (js-call runtime :release result))))
              (finally (finish runtime)))))))))

