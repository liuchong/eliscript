(module tests.native-managed-runtime
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile rm realpath)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:module" createRequire)
  (import "../tools/compiler/controlled-baseline.mjs" definition)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime loadManagedHostModules)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)

  (defconst native-test (js-call test :skipIf
    (or (/= (get globalThis.process :platform) "darwin") (/= (get globalThis.process :arch) "arm64"))))
  (defconst source-root (resolve (get (get globalThis.process :env) "ELISCRIPT_NATIVE_MANAGED_SOURCE_ROOT" root)))
  (defvar directory undefined) (defvar backend undefined) (defvar normal undefined)
  (defvar trapped undefined) (defvar runtime-source undefined)
  (defconst source (js-call (js-array
    "(defconst marker 1)"
    "(defun make (x) (let ((box (js-object :value x))) (lambda (step) (put box :value (+ (get box :value) step)) (get box :value))))"
    "(defun call (callback step) (funcall callback step))"
    "(defun transformed (array text) (js-array (js-call array :slice 1) (js-call text :toUpperCase)))"
    "(defun caught (value) (try (throw value) (catch error error)))"
    "(defun uncaught (value) (throw value))"
    "(defun make-error (kind message) (cond ((= kind 0) (new globalThis.Error message)) ((= kind 1) (new globalThis.TypeError message)) ((= kind 2) (new globalThis.RangeError message)) (t (new globalThis.SyntaxError message))))"
    "(defun error-summary (error) (js-array (aref error \"name\") (aref error \"message\")))"
    "(defun diagnosis (mode) (try (if mode (Math/round (js-object :valueOf (lambda () (js-object)) :toString (lambda () (js-object)))) (js-call 1 :toString 1)) (catch error (js-array (aref error \"name\") (aref (aref error \"eliscriptDiagnostic\") \"code\")))))"
    "(defun tdz (input) (let ((a 99)) (try (throw input) (catch {:strs [a] :or {a a}} a))))"
    "(defun repeat-text (text count) (js-call text :repeat count))"
    "(defun fault (text start) (js-call text :indexOf \"x\" start))"
    "(export make call transformed caught uncaught make-error error-summary diagnosis tdz repeat-text fault)") :join "\n"))

  (defun code (error)
    (let ((diagnostic (if (nullish? error) undefined (get error :eliscriptDiagnostic))))
      (if (nullish? diagnostic) undefined (get diagnostic :code))))
  (defun reference-error-p (error expected)
    (and (js-call globalThis.ReferenceError globalThis.Symbol.hasInstance error) (= (code error) expected)))
  (defasync selected-builder ()
    (if (= source-root root) buildBackends
      (let* ((path (resolve source-root "tools/backends/build.mjs"))
             (modules (await (loadManagedHostModules (js-object :hostModules
               (js-array (js-object :id "selected-backend" :specifier (get (pathToFileURL path) :href)
                 :referrer "native-managed-runtime.test.mjs" :allowedExports (js-array "buildBackends") :namespace false)))))))
        (get (js-call modules :get "selected-backend") :buildBackends))))
  (defasync build-artifact (runtime-text name &rest arguments)
    (let* ((text (if (or (= (js-length arguments) 0) (undefined? (aref arguments 0))) source (aref arguments 0)))
           (program (js-call (get backend :compiler) :compile_ir_string text "native-managed-adapter.eli"))
           (runtime (js-call (get backend :compiler) :compile_ir_string runtime-text (+ name "-runtime.eli")))
           (lowered (js-call (get backend :managed) :lower_managed_program program runtime t))
           (wasm (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime
                   (js-object :abi "managed-module-v1" :maximumPages 32))))
           (path (resolve directory (+ name ".dylib"))))
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module wasm)) (js-array))
      (await (writeFile path (globalThis.Uint8Array.from
        (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) "arm64-macos"))))
      (js-object :path path :lowered lowered :wasm wasm)))
  (defasync open (artifact &rest arguments)
    (let ((options (if (or (= (js-length arguments) 0) (undefined? (aref arguments 0))) (js-object) (aref arguments 0))))
      (await (instantiateNativeManagedRuntime (get artifact :path) (get artifact :lowered)
        (Object/assign (js-object :maxSlots 256 :initialBytes 16384 :maxBytes 1048576 :maximumPages 32) options)))))
  (defun wasm (&rest arguments)
    (let ((artifact (if (or (= (js-length arguments) 0) (undefined? (aref arguments 0))) normal (aref arguments 0)))
          (options (if (or (< (js-length arguments) 2) (undefined? (aref arguments 1))) (js-object) (aref arguments 1))))
      (instantiateManagedRuntime (get artifact :wasm)
        (Object/assign (js-object :maxSlots 256 :initialBytes 16384 :maxBytes 1048576) options))))
  (defun value (runtime input)
    (let ((kind (if (nullish? input) undefined (get input :kind))))
      (cond ((= kind 4) (js-call runtime :readNumber input))
            ((= kind 5) (js-call runtime :readString input))
            ((or (= kind 14) (= kind 7))
             (Array/from (js-object :length (js-call runtime :length input)) (lambda (unused index)
               (let ((child (js-call runtime :get input index)))
                 (try (value runtime child) (finally (js-call runtime :release child)))))))
            (t input))))
  (defun box (runtime input)
    (cond ((= (value-type input) "number") (js-call runtime :number input))
          ((= (value-type input) "string") (js-call runtime :string input)) (t input)))
  (defun finish (runtime &rest arguments)
    (let ((values (if (or (= (js-length arguments) 0) (undefined? (aref arguments 0))) (js-array) (aref arguments 0))))
      (js-call values :forEach (lambda (item) (js-call runtime :release item)))
      (js-call runtime :closeModule) (js-call runtime :collect)
      (js-call assert :strictEqual (js-call runtime :live) 0)
      (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
      (when (get runtime :close) (js-call runtime :close))))

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-native-managed-"))))
    (let ((builder (await (selected-builder)))) (setq backend (await (funcall builder (js-object :outputRoot directory)))))
    (let ((native-module (resolve (get backend :directory) "native-under-test.mjs")))
      (await (writeFile native-module (js-call (get backend :compiler) :compile_string
        (await (readFile (resolve root "bootstrap/backends/native.eli") "utf8")) "native.eli")))
      (put backend :native (funcall (createRequire native-module) native-module)))
    (setq runtime-source (await (readFile (resolve source-root "bootstrap/runtime/memory.eli") "utf8")))
    (setq normal (await (build-artifact runtime-source "normal")))
    (setq trapped (await (build-artifact
      (js-call runtime-source :replace (definition runtime-source "heap-text-search-unit")
        "(defun heap-text-search-unit (data length index reverse) (load-u16 4294967295))") "trap")))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))

  (native-test "native managed adapter executes object captures and escaped closures with the existing WASM API"
    (async ()
      (let ((adapters (js-array (wasm) (await (open normal)))))
        (js-call assert :deepStrictEqual
          (js-call (Object/keys (aref adapters 1)) :filter (lambda (name) (/= name "close"))) (Object/keys (aref adapters 0)))
        (js-call (Object/entries (aref adapters 0)) :forEach (lambda (entry)
          (when (= (value-type (aref entry 1)) "function")
            (js-call assert :strictEqual (get (get (aref adapters 1) (aref entry 0)) :length) (get (aref entry 1) :length) (aref entry 0)))))
        (js-call adapters :forEach (lambda (runtime)
          (js-call runtime :auto 1)
          (let* ((ten (js-call runtime :number 10)) (two (js-call runtime :number 2))
                 (fn (js-call runtime :invoke "make" (js-array ten))))
            (js-call runtime :collect)
            (js-call (js-array 12 14 16) :forEach (lambda (expected)
              (let ((out (js-call runtime :invoke "call" (js-array fn two))))
                (js-call assert :strictEqual (js-call runtime :readNumber out) expected)
                (js-call runtime :release out) (js-call runtime :collect))))
            (finish runtime (js-array ten two fn))))))))
  (native-test "native managed array and Unicode text transfers preserve roots, holes and copied results"
    (async ()
      (js-call (js-array (wasm) (await (open normal))) :forEach (lambda (runtime)
        (js-call runtime :auto 1)
        (let* ((one (js-call runtime :number 1)) (text (js-call runtime :string "a中😀\ud800"))
               (items (js-array one undefined undefined text))
               (_hole (Reflect/deleteProperty items "1"))
               (input (js-call runtime :sourceArray items))
               (out (js-call runtime :invoke "transformed" (js-array input text))))
          (js-call assert :deepStrictEqual (value runtime out)
            (js-array (js-array undefined undefined "a中😀\ud800") "A中😀\ud800"))
          (js-call assert :strictEqual (js-call runtime :length input) 4)
          (let* ((bytes (js-call runtime :bytes (js-array 1 2 3))) (copy (js-call runtime :readBytes bytes)))
            (put copy 0 99)
            (js-call assert :deepStrictEqual (js-call runtime :readBytes bytes) (globalThis.Uint8Array.of 1 2 3))
            (js-call runtime :release bytes))
          (finish runtime (js-array one text input out)))))))
  (native-test "native managed source throws retain primitive and object identity and Error class semantics"
    (async ()
      (js-call (js-array (wasm) (await (open normal))) :forEach (lambda (runtime)
        (js-call runtime :auto 1)
        (let ((retained (js-array)))
          (js-call (js-array nil undefined false t 0 -0 globalThis.NaN "中\ud800") :forEach (lambda (item)
            (let* ((input (box runtime item)) (out (js-call runtime :invoke "caught" (js-array input))) (entered false))
              (js-call retained :push input) (js-call assert :deepStrictEqual (value runtime out) item) (js-call runtime :release out)
              (try (js-call runtime :invoke "uncaught" (js-array input))
                (catch error
                  (setq entered t)
                  (if (and input (= (value-type input) "object"))
                    (progn (assert (js-call runtime :keyEqual input error)) (js-call runtime :release error))
                    (js-call assert :strictEqual error input))))
              (assert entered) (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))))
          (let ((object (js-call runtime :sourceObject (js-object))) (thrown undefined))
            (js-call retained :push object)
            (try (js-call runtime :invoke "uncaught" (js-array object)) (catch error (setq thrown error)))
            (assert (js-call runtime :keyEqual thrown object)) (js-call retained :push thrown)
            (js-call (js-array "Error" "TypeError" "RangeError" "SyntaxError") :forEach (lambda (name kind)
              (let* ((k (js-call runtime :number kind)) (message (js-call runtime :string "message"))
                     (error (js-call runtime :invoke "make-error" (js-array k message)))
                     (summary (js-call runtime :invoke "error-summary" (js-array error))))
                (js-call assert :deepStrictEqual (value runtime summary) (js-array name "message"))
                (js-call retained :push k message error summary))))
            (js-call assert :throws (lambda () (js-call runtime :invoke "tdz" (js-array object)))
              (lambda (error) (reference-error-p error "ELI-RT0012"))))
          (js-call (js-array (js-array t (js-array "TypeError" "ELI-RT0003"))
                            (js-array false (js-array "RangeError" "ELI-RT0010"))) :forEach (lambda (entry)
            (let ((mode (aref entry 0)) (expected (aref entry 1)) (out undefined))
              (try (setq out (js-call runtime :invoke "diagnosis" (js-array mode)))
                (catch error
                  (try (console/error "[native-managed-diagnosis-failure]"
                    (JSON/stringify (js-object :mode mode :code (code error) :stats (js-call runtime :stats)))) (catch ignored nil))
                  (throw error)))
              (js-call assert :deepStrictEqual (value runtime out) expected) (js-call runtime :release out))))
          (finish runtime retained))))))
  (native-test "native managed fault injection automatically unwinds private roots and preserves the caller frame"
    (async ()
      (js-call (js-array (wasm trapped) (await (open trapped))) :forEach (lambda (runtime)
        (js-call runtime :auto 1)
        (let* ((text (js-call runtime :string "xxx")) (bad (js-call runtime :sourceObject (js-object)))
               (good (js-call runtime :number 0)) (frame (js-call runtime :frame 1)))
          (js-call runtime :frameSet frame 0 text)
          (js-call assert :throws (lambda () (js-call runtime :invoke "fault" (js-array text bad)))
            (lambda (error) (= (code error) "ELI-RT0003")))
          (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 1)
          (js-call assert :throws (lambda () (js-call runtime :invoke "fault" (js-array text good))) globalThis.WebAssembly.RuntimeError)
          (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 1)
          (js-call assert :strictEqual (js-call runtime :readString text) "xxx")
          (let ((retained (js-call runtime :frameGet frame 0)))
            (assert (js-call runtime :keyEqual retained text)) (js-call runtime :release retained))
          (js-call runtime :leaveFrame frame) (finish runtime (js-array text bad good)))))))
  (native-test "native managed loader owns close and validates descriptor failure without a WASM execution wrapper"
    (async ()
      (let ((old-module (get globalThis.WebAssembly :Module)) (old-instance (get globalThis.WebAssembly :Instance)) (runtime undefined))
        (try
          (put globalThis.WebAssembly :Module (lambda (&rest arguments) (throw (new globalThis.Error "native loading must not construct WASM"))))
          (put globalThis.WebAssembly :Instance (lambda (&rest arguments) (throw (new globalThis.Error "native execution must not construct WASM"))))
          (setq runtime (await (open normal)))
          (let ((item (js-call runtime :number 7)))
            (js-call assert :strictEqual (js-call runtime :readNumber item) 7) (js-call runtime :release item))
          (finally (put globalThis.WebAssembly :Module old-module) (put globalThis.WebAssembly :Instance old-instance)))
        (js-call runtime :close) (js-call runtime :close)
        (js-call (js-array (lambda () (js-call runtime :number 1)) (lambda () (js-call runtime :collect))
                          (lambda () (js-call runtime :release nil)) (lambda () (js-call runtime :stats))) :forEach (lambda (run)
          (js-call assert :throws run (new globalThis.RegExp "closed"))))
        (let ((invalid (Object/assign (js-object) normal (js-object :lowered
                (Object/assign (js-object) (get normal :lowered) (js-object :descriptor
                  (Object/assign (js-object) (get (get normal :lowered) :descriptor) (js-object :version 99))))))))
          (await (js-call assert :rejects (open invalid) (lambda (error) (= (code error) "ELI-RT0003")))))
        (let ((next (await (open normal (js-object :initializeModule false)))))
          (js-call assert :throws (lambda () (js-call next :invoke "caught" (js-array nil)))
            (lambda (error) (reference-error-p error "ELI-RT0008")))
          (js-call next :initializeModule) (finish next)))))

  (native-test "native managed loading snapshots only its ABI before asynchronous host imports and isolates all consumed metadata"
    (async ()
      (let ((provider-path (resolve directory "snapshot-provider.mjs")))
        (await (writeFile provider-path (js-call (get backend :compiler) :compile_string
          "(defconst marker 7) (export marker)" "snapshot-provider.eli")))
        (let* ((provider-real-path (await (realpath provider-path)))
               (namespace (funcall (createRequire provider-real-path) provider-real-path))
               (_namespace (js-call assert :strictEqual (get namespace globalThis.Symbol.toStringTag) "Module"))
               (_marker (js-call assert :strictEqual (get namespace :marker) 7))
               (source-typed (get (get normal :lowered) :typed))
               (original-body (get (aref (get source-typed :functions) 0) :body))
               (typed (Object/assign (js-object) source-typed
                 (js-object :functions (js-call (get source-typed :functions) :map (lambda (fn) (Object/assign (js-object) fn)))
                   :exports (js-call (get source-typed :exports) :slice)
                   :aliases (js-call (get source-typed :aliases) :map (lambda (alias) (Object/assign (js-object) alias))))))
               (descriptor (funcall globalThis.structuredClone (get (get normal :lowered) :descriptor)))
               (body-reads 0) (release undefined) (imports 0) (runtime undefined))
          (put descriptor :hostModules (js-array (js-object :id "snapshot-provider.mjs" :specifier "./snapshot-provider.mjs"
            :referrer "entry.mjs" :allowedExports (js-array "marker") :namespace false)))
          (Object/defineProperty (aref (get typed :functions) 0) "body" (js-object :enumerable t :get (lambda ()
            (setq body-reads (1+ body-reads)) (throw (new globalThis.Error "native loading must not traverse executable IR")))))
          (Object/defineProperty (aref (get typed :functions) 0) "locals" (js-object :enumerable t :get (lambda ()
            (setq body-reads (1+ body-reads)) (throw (new globalThis.Error "native loading must not traverse compiler locals")))))
          (let* ((input (js-object :typed typed :descriptor descriptor))
                 (host-ready (new globalThis.Promise (lambda (resolve-ready) (setq release resolve-ready))))
                 (old-module (get globalThis.WebAssembly :Module)) (old-instance (get globalThis.WebAssembly :Instance)))
            (try
              (put globalThis.WebAssembly :Module (lambda (&rest arguments) (throw (new globalThis.Error "native snapshot loading must not construct WASM"))))
              (put globalThis.WebAssembly :Instance (lambda (&rest arguments) (throw (new globalThis.Error "native snapshot execution must not construct WASM"))))
              (let ((pending (instantiateNativeManagedRuntime (get normal :path) input
                       (js-object :maxSlots 256 :initialBytes 16384 :maxBytes 1048576 :maximumPages 32 :initializeModule false
                         :importModule (lambda (specifier declaration)
                           (setq imports (1+ imports))
                           (js-call assert :strictEqual specifier "./snapshot-provider.mjs")
                           (js-call assert :strictEqual (get declaration :id) "snapshot-provider.mjs") host-ready)))))
                (js-call assert :strictEqual imports 1 "ABI and descriptor snapshots must finish before the asynchronous resolver starts")
                (js-call assert :strictEqual body-reads 0)
                (js-call (get typed :functions) :forEach (lambda (fn index)
                  (put fn :name (+ "changed-function-" index)) (put fn :arity 65535)))
                (put (get typed :exports) :length 0)
                (js-call (get typed :aliases) :forEach (lambda (alias index)
                  (put alias :name (+ "changed-alias-" index)) (put alias :function "missing")))
                (put descriptor :version 99)
                (put (aref (get descriptor :functions) 0) :name "changed-entry")
                (put (aref (get descriptor :functions) 0) :arity 65535)
                (put (get descriptor :module) :initialize "missing")
                (put (aref (get (get descriptor :module) :exports) 0) :name "changed-entry")
                (js-call (get (aref (get descriptor :hostModules) 0) :allowedExports) :push "missing")
                (put input :typed (js-object)) (put input :descriptor (js-object))
                (funcall release namespace) (setq runtime (await pending)))
              (js-call assert :strictEqual body-reads 0)
              (js-call assert :strictEqual (get (aref (get source-typed :functions) 0) :body) original-body)
              (js-call runtime :auto 1) (js-call runtime :initializeModule)
              (let* ((keep (js-call runtime :number -0)) (frame (js-call runtime :frame 1)))
                (js-call runtime :frameSet frame 0 keep)
                (try
                  (let ((out (js-call runtime :invoke "caught" (js-array keep))))
                    (try (assert (js-call runtime :keyEqual out keep)) (js-call runtime :collect)
                      (assert (Object/is (js-call runtime :readNumber out) -0))
                      (finally (js-call runtime :release out))))
                  (let ((thrown false))
                    (try (js-call runtime :invoke "uncaught" (js-array keep))
                      (catch error (setq thrown t)
                        (try (assert (js-call runtime :keyEqual error keep)) (finally (js-call runtime :release error)))))
                    (assert thrown))
                  (js-call runtime :collect) (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 1)
                  (let ((saved (js-call runtime :frameGet frame 0)))
                    (try (assert (Object/is (js-call runtime :readNumber saved) -0)) (finally (js-call runtime :release saved))))
                  (finally (js-call runtime :leaveFrame frame) (finish runtime (js-array keep)) (setq runtime undefined))))
              (finally
                (funcall release namespace) (when runtime (js-call runtime :close))
                (put globalThis.WebAssembly :Module old-module) (put globalThis.WebAssembly :Instance old-instance))))))))
  (native-test "native managed ABI snapshots retain function alias and required export validation"
    (async ()
      (let ((changes (js-array
        (lambda (typed) (put (aref (get typed :functions) 1) :name (get (aref (get typed :functions) 0) :name)))
        (lambda (typed) (put (aref (get typed :functions) 0) :arity -1))
        (lambda (typed) (put (aref (get typed :functions) 0) :arity 65536))
        (lambda (typed) (js-call (get typed :exports) :push "missing"))
        (lambda (typed) (put typed :aliases (js-object)))
        (lambda (typed) (js-call (get typed :aliases) :push (js-object :name "missing-target" :function "missing")))
        (lambda (typed) (js-call (get typed :aliases) :push (Object/assign (js-object) (aref (get typed :aliases) 0))))
        (lambda (typed)
          (put typed :exports (js-call (get typed :exports) :filter (lambda (name) (/= name "heap-new"))))
          (put typed :aliases (js-call (get typed :aliases) :filter (lambda (alias) (/= (get alias :name) "heap-new")))))))
            (index 0))
        (while (< index (js-length changes))
          (let* ((original (get (get normal :lowered) :typed))
                 (typed (Object/assign (js-object) original (js-object
                   :functions (js-call (get original :functions) :map (lambda (fn) (js-object :name (get fn :name) :arity (get fn :arity))))
                   :exports (js-call (get original :exports) :slice)
                   :aliases (js-call (get original :aliases) :map (lambda (alias) (Object/assign (js-object) alias)))))))
            (funcall (aref changes index) typed)
            (await (js-call assert :rejects
              (instantiateNativeManagedRuntime (get normal :path) (js-object :typed typed :descriptor (get (get normal :lowered) :descriptor)))
              (lambda (error) (= (code error) "ELI-RT0003")))))
          (setq index (1+ index))))))
  (native-test "native managed initialization caches exact thrown values and can close failed modules"
    (async ()
      (let ((inputs (js-array "nil" "undefined" "false" "(new globalThis.TypeError \"initialization\")")) (position 0))
        (while (< position (js-length inputs))
          (let* ((thrown (aref inputs position))
                 (artifact (await (build-artifact runtime-source (+ "initialize-" (js-length thrown))
                   (+ "(defconst failed (throw " thrown ")) (defun entry () failed) (export entry)"))))
                 (adapters (js-array (wasm artifact (js-object :initializeModule false))
                                    (await (open artifact (js-object :initializeModule false)))))
                 (index 0))
            (while (< index (js-length adapters))
              (let ((runtime (aref adapters index)) (errors (js-array)) (attempt 0))
                (while (< attempt 2)
                  (let ((entered false))
                    (try (js-call runtime :initializeModule) (catch error (setq entered t) (js-call errors :push error)))
                    (assert entered) (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
                  (setq attempt (1+ attempt)))
                (cond ((= thrown "nil") (js-call assert :deepStrictEqual errors (js-array nil nil)))
                      ((= thrown "undefined") (js-call assert :deepStrictEqual errors (js-array undefined undefined)))
                      ((= thrown "false") (js-call assert :deepStrictEqual errors (js-array false false)))
                      (t
                        (assert (js-call runtime :keyEqual (aref errors 0) (aref errors 1)))
                        (let* ((key (js-call runtime :string "message")) (message (js-call runtime :objectGet (aref errors 0) key)))
                          (js-call assert :strictEqual (js-call runtime :readString message) "initialization")
                          (js-call runtime :release key) (js-call runtime :release message))
                        (js-call runtime :closeModule) (js-call runtime :collect)
                        (let* ((key (js-call runtime :string "name")) (name (js-call runtime :objectGet (aref errors 0) key)))
                          (js-call assert :strictEqual (js-call runtime :readString name) "TypeError")
                          (js-call runtime :release key) (js-call runtime :release name))))
                (finish runtime errors))
              (setq index (1+ index)))
            (let ((entered false))
              (try (await (open artifact))
                (catch error (setq entered t)
                  (cond ((= thrown "nil") (js-call assert :strictEqual error nil))
                        ((= thrown "undefined") (js-call assert :strictEqual error undefined))
                        ((= thrown "false") (js-call assert :strictEqual error false))
                        (t (js-call assert :strictEqual (get error :kind) 13)))))
              (assert entered)))
          (setq position (1+ position))))) 120000)
  (native-test "native managed instances reject foreign handles and closing during getters cannot reuse a freed mapping"
    (async ()
      (let* ((first (await (open normal))) (second (await (open normal)))
             (number (js-call first :number 2)) (other (js-call second :number 3)) (arguments (js-array)))
        (js-call assert :throws (lambda () (js-call second :readNumber number)) (lambda (error) (= (code error) "ELI-RT0001")))
        (js-call assert :strictEqual (js-call second :readNumber other) 3)
        (Object/defineProperty arguments "0" (js-object :get (lambda () (js-call first :close) number)))
        (put arguments :length 1)
        (js-call assert :throws (lambda () (js-call first :invoke "caught" arguments)) (new globalThis.RegExp "closed"))
        (js-call assert :throws (lambda () (js-call first :readNumber number)) (new globalThis.RegExp "closed"))
        (finish second (js-array other)) (js-call first :close))))
  (native-test "native managed capacity failures retain caller roots and source operands"
    (async ()
      (js-call (js-array (wasm normal (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 4096))
                        (await (open normal (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 4096)))) :forEach (lambda (runtime)
        (js-call runtime :auto 1)
        (let* ((text (js-call runtime :string "中😀\ud800")) (count (js-call runtime :number 10000)) (frame (js-call runtime :frame 1)))
          (js-call runtime :frameSet frame 0 text)
          (js-call assert :throws (lambda () (js-call runtime :invoke "repeat-text" (js-array text count)))
            (lambda (error) (= (code error) "ELI-RT0002")))
          (js-call assert :strictEqual (js-call runtime :readString text) "中😀\ud800")
          (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 1)
          (js-call runtime :leaveFrame frame) (finish runtime (js-array text count)))))))
  (test "shared WASM loader rejects an explicitly null control descriptor before runtime entry"
    (lambda ()
      (let* ((ir (js-call (get backend :compiler) :compile_ir_string "(defun identity (x) x) (export identity)" "bad-control.eli"))
             (plain (js-call (get backend :wasm) :emit_memory_wasm ir)))
        (js-call (js-array "null" "false" "0" "[]" "{}") :forEach (lambda (descriptor)
          (let ((bytes (globalThis.Uint8Array.from (js-call (get backend :wasm) :append_metadata_section plain "eliscript-managed-control" descriptor))))
            (js-call assert :throws (lambda () (instantiateManagedRuntime bytes)) (lambda (error) (= (code error) "ELI-RT0003"))))))
        (js-call assert :throws (lambda () (instantiateManagedRuntime (new globalThis.Uint8Array) (js-object :initializeModule 1)))
          (lambda (error) (= (code error) "ELI-RT0003"))))))
)
