            (js-call assert :strictEqual (aref result 0) (aref result 1))
            (js-call assert :strictEqual (js-call alternative :isRegexPattern (aref result 0)) t)
            (js-call assert :strictEqual (js-call canonical-regex :isRegexPattern (aref result 0)) false)
            (js-call assert :strictEqual (aref result 2) "AAA")
            (js-call assert :strictEqual (js-call namespace :private_echo original) original)
            (js-call assert :strictEqual (js-call namespace :private_pattern_QMARK_ original) t)
            (js-call assert :strictEqual (get providers :size) 1)
            (js-call assert :strictEqual (js-call providers :get "eliscript/runtime/core/regex") alternative)
            (js-call assert :strictEqual (js-call (get graph :hostModules) :get "eliscript/runtime/core/regex") alternative))
