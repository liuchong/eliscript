  (native-test "memory ABI preserves snapshots unused arguments local reset recursion and first traps"
    (async ()
      (let* ((text (js-call (js-array
               "(import \"eliscript:memory32\" load-u32 store-u32 memory-grow)"
               "(defun saved (a unused) (load-u32 a))"
               "(defun write-cell (value) (store-u32 44 value))"
               "(defun grow-memory (pages) (memory-grow pages))"
               "(defun choose (flag) (if (/= flag 0) (load-u32 4294967295) (load-u32 44)))"
               "(defun scratch (x) (let ((v 0)) (if (= x 0) (setq v 9) 0) v))"
               "(defun recurse (x) (if (= x 0) 0 (recurse (1- x))))"
               "(defun setup () (store-u32 32 64) (store-u32 64 11) (store-u32 96 22) (store-u32 44 17))"
               "(defun snapshot () (saved (load-u32 32) (store-u32 32 96)))"
               "(defun unused () (saved 64 (write-cell 23)))"
               "(defun grow () (grow-memory 0))"
               "(defun safe () (choose 0))"
               "(defun locals () (let ((i 0) (sum 0)) (while (< i 2) (setq sum (+ sum (scratch i)) i (1+ i))) sum))"
               "(defun recursive () (recurse 7))"
               "(defun trap () (saved (load-u32 4294967295) (store-u32 44 99)))"
               "(defun read44 () (load-u32 44))"
               "(export setup snapshot unused safe locals recursive trap read44 grow)") :join "\n"))
             (memory-module (resolve (get backend :directory) "memory.mjs"))
             (lowerer (get (funcall (createRequire memory-module) memory-module) :lower_memory_program))
             (ir (js-call (get backend :compiler) :compile_ir_string text "memory-abi-boundaries.eli"))
             (plain (funcall lowerer ir))
             (plain-image (JSON/stringify plain))
             (signatures (js-object :setup 0 :snapshot 0 :unused 0 :safe 0 :locals 0 :recursive 0 :trap 0 :read44 0 :grow 0)))
        (let ((programs (js-array plain)) (index 0))
          (while (< index (js-length programs))
            (let* ((program (aref programs index))
                   (bytes (globalThis.Uint8Array.from (js-call (get backend :wasm) :emit_typed_memory_wasm program)))
                   (instance (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)))
                   (wasm-exports (get instance :exports))
                   (path (resolve directory (str "memory-helper-" index ".dylib"))))
              (await (writeFile path (globalThis.Uint8Array.from
                (js-call (get backend :native) :emit_typed_native_memory_library program "arm64-macos"))))
              (let* ((native (await (openNativeMemory path signatures (js-object :initialPages 1 :maximumPages 2))))
                     (invokers (js-array (lambda (name) (funcall (get wasm-exports name)))
                                        (lambda (name) (js-call native :invoke name)))))
                (try
                  (js-call invokers :forEach (lambda (invoke)
                    (funcall invoke "setup")
                    (js-call assert :strictEqual (funcall invoke "snapshot") 11)
                    (js-call assert :strictEqual (funcall invoke "unused") 11)
                    (js-call assert :strictEqual (funcall invoke "safe") 23)
                    (js-call assert :strictEqual (funcall invoke "locals") 9)
                    (js-call assert :strictEqual (funcall invoke "recursive") 0)
                    (js-call assert :strictEqual (funcall invoke "grow") 1)
                    (js-call assert :throws (lambda () (funcall invoke "trap")))
                    (js-call assert :strictEqual (funcall invoke "read44") 23)))
                  (finally (js-call native :close)))))
            (setq index (1+ index))))
        (js-call assert :strictEqual (JSON/stringify plain) plain-image))))

  (defun module-getter-source (size)
    (let ((lines (js-array "(defconst marker 7)")) (names (js-array "marker" "maker" "signal")) (index 0))
      (while (< index size)
        (js-call lines :push (str "(defun f" index " (x) (+ x " index "))"))
        (js-call names :push (str "f" index))
        (setq index (1+ index)))
      (js-call lines :push "(defun maker (x) (lambda (step) (+ x step)))"
        "(defun signal (x) (throw x))" (str "(export " (js-call names :join " ") ")"))
      (js-call lines :join "\n")))
  (defun module-getter-cost (artifact)
    (let* ((functions (get (get (get artifact :lowered) :typed) :functions))
           (getter (js-call functions :find (lambda (fn) (= (get fn :name) "__eliscript_module_get"))))
           (allocate (js-call functions :find (lambda (fn) (= (get fn :name) "frame-new"))))
           (pending (js-array (js-array (get getter :body) 0))) (roots nil) (maximum 0) (cases 0))
      (while (> (js-length pending) 0)
        (let* ((work (js-call pending :pop)) (node (aref work 0)) (depth (aref work 1))
               (children (get node :children)) (next depth))
          (when (and (= (get node :kind) "call") (= (get node :value) (get allocate :index)))
            (js-call assert :strictEqual roots nil "one owned frame per module read")
            (setq roots (get (aref children 1) :value)))
          (when (= (get node :kind) "if")
            (let* ((condition (aref children 0)) (operands (get condition :children)))
              (when (and (= (get condition :kind) "word-compare")
                         (= (get (aref operands 0) :kind) "local")
                         (= (get (aref operands 0) :value) 2))
                (setq next (1+ depth) maximum (Math/max maximum next))
                (when (= (get condition :value) "=") (setq cases (1+ cases))))))
          (js-call children :forEach (lambda (child) (js-call pending :push (js-array child next))))))
      (js-call assert :ok (Number/isInteger roots))
      (js-object :roots roots :locals (js-length (get getter :locals)) :depth maximum :cases cases)))

