(module tests.managed-sequence-build
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir readFile writeFile symlink)
  (import "node:path" basename dirname posix resolve)
  (import "../../tools/backends/build.mjs" buildBackends root)
  (import "../../tools/backends/native-managed-runtime.mjs" snapshotNativeManagedRuntimeABI)
  (import "../../dist/bootstrap/ir.mjs" serialize-program deserialize-program)

  (defasync write (path source)
    (await (mkdir (dirname path) (js-object :recursive t))) (await (writeFile path source)))

  (defun import-nodes (program)
    (let ((pending (js-call (get program :body) :slice)) (result (js-array)))
      (while (> (js-length pending) 0)
        (let ((node (js-call pending :shift)))
          (when (= (get node :kind) "import-declaration") (js-call result :push node))
          (Reflect/apply (get pending :push) pending (get node :children (js-array)))))
      result))
  (defun exported-names (program)
    (let ((pending (js-call (get program :body) :slice)) (names (js-array)))
      (while (> (js-length pending) 0)
        (let ((node (js-call pending :shift)))
          (cond ((= (get node :kind) "module-declaration")
                 (Reflect/apply (get pending :unshift) pending (get node :children)))
                ((= (get node :kind) "export-declaration")
                 (js-call (get node :children) :forEach (lambda (child) (js-call names :push (get child :value))))))))
      names))
  (defun local-path (path)
    (let ((normalized (js-call posix :normalize path)))
      (assert (and (not (js-call posix :isAbsolute normalized))
                   (/= normalized "..") (not (js-call normalized :startsWith "../")))
        (+ "fixture dependency escapes its source root: " normalized))
      normalized))
  (defun output-id (path)
    (let ((normalized (local-path path)))
      (if (js-call normalized :endsWith ".eli") (+ (js-call normalized :slice 0 -4) ".mjs") normalized)))
  (defun relative-import (from to)
    (let ((path (js-call posix :relative (js-call posix :dirname from) to)))
      (if (js-call path :startsWith ".") path (+ "./" path))))
  (defun retained-runtime-input (full)
    (let ((compact (snapshotNativeManagedRuntimeABI full)))
      ;; ABI extraction deliberately does not inspect debug. Retain any real
      ;; diagnostic inputs separately, after both actual emitters have finished.
      (js-call (js-array "debug" "trapSites") :forEach (lambda (name)
        (when (Object/hasOwn full name) (put compact name (get full name)))))
      compact))

  (defasync buildSequenceArtifacts (directory settings)
    (let ((backend undefined) (lowered undefined) (runtime-ir undefined) (literal-ir undefined)
          (oracle-directory undefined) (wasm-path undefined) (native-path undefined)
          (original-sources (new globalThis.Map)) (public-modules (new globalThis.Map))
          (entry (get settings :entry)) (memory (get settings :memory))
          (original-hosts (get settings :originalHosts))
          (native-supported (get settings :nativeSupported)) (native-target (get settings :nativeTarget)))
    (setq backend (await (buildBackends (js-object :outputRoot (resolve directory "backend")))))
    (let* ((libraries (await (js-call backend :loadLiteralModules)))
           (literal-sources (get libraries :literalSources)) (literal-modules (get libraries :literalModules))
           (modules (new globalThis.Map)) (source-files (new globalThis.Map))
           (canonical-ids (new globalThis.Set)) (index 0))
      (js-call assert :strictEqual (js-length literal-sources) (js-length literal-modules))
      (while (< index (js-length literal-sources))
        (let ((source (aref literal-sources index)) (module (aref literal-modules index)))
          (js-call assert :strictEqual (get source :id) (get module :id))
          (js-call assert :strictEqual (get source :source)
            (await (readFile (resolve root (get source :filename)) "utf8")))
          (js-call canonical-ids :add (get source :id))
          (js-call source-files :set (get source :id) (get source :filename)))
        (setq index (1+ index)))
      ;; Output IDs describe the original test's virtual deployment. Physical
      ;; .eli filenames independently describe where each dependency is read.
      (js-call (js-array
        (js-array entry "tests/fixtures/wasm-managed-sequence-data.eli")
        (js-array "tests/fixtures/lazy-sequence.mjs" "tests/fixtures/lazy-sequence.eli")
        (js-array "core-set-usage.mjs" "tests/fixtures/core-set-usage.eli")
        (js-array "sequence.mjs" "stdlib/sequence.eli") (js-array "text.mjs" "stdlib/text.eli")
        (js-array "object.mjs" "stdlib/object.eli") (js-array "data.mjs" "stdlib/data.eli")
        (js-array "sequence-usage.mjs" "tests/fixtures/sequence-usage.eli")
        (js-array "text-usage.mjs" "tests/fixtures/text-usage.eli")
        (js-array "object-usage.mjs" "tests/fixtures/object-usage.eli"))
        :forEach (lambda (pair) (js-call source-files :set (aref pair 0) (aref pair 1))))
      (setq oracle-directory (resolve directory "oracle"))
      (await (mkdir oracle-directory (js-object :recursive t)))
      (await (symlink (resolve root "runtime") (resolve oracle-directory "runtime") "dir"))
      (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
      (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
      (letfn ((add (id filename &optional source)
                (async ()
                  (local-path id) (local-path filename)
                  (unless (js-call modules :has id)
                    (when (nullish? source) (setq source (await (readFile (resolve root filename) "utf8"))))
                    (let* ((program (js-call (get backend :compiler) :compile_ir_string source filename))
                           (imports (import-nodes program)) (position 0))
                      (js-call modules :set id (js-object :id id :program program))
                      (while (< position (js-length imports))
                        (let* ((node (aref imports position)) (specifier (get node :value)))
                          (when (js-call specifier :startsWith ".")
                            (let ((target (output-id (js-call posix :join (js-call posix :dirname id) specifier))))
                              ;; Direct project lowering needs the declared
                              ;; package identity, while ordinary ESM resolves
                              ;; the same provider through the real symlink.
                              ;; Unknown runtime IDs retain their import and
                              ;; therefore the original strict link rejection.
                              (if (js-call target :startsWith "runtime/")
                                (when (js-call canonical-ids :has target)
                                  (put node :value (+ "eliscript/" target)))
                                (let* ((physical (if (js-call source-files :has target) (js-call source-files :get target)
                                                   (local-path (js-call posix :join (js-call posix :dirname filename) specifier))))
                                       (source-path (if (js-call physical :endsWith ".mjs")
                                                      (+ (js-call physical :slice 0 -4) ".eli") physical)))
                                  (put node :value (relative-import id target))
                                  (await (funcall (add target source-path))))))))
                        (setq position (1+ position)))
                      (await (write (resolve oracle-directory id) (js-call (get backend :compiler) :emit_ir_string program))))))))
        (setq index 0)
        (while (< index (js-length literal-modules))
          (let* ((record (aref literal-modules index)) (id (get record :id)))
            (when (and (or (js-call id :startsWith "runtime/core/") (js-call id :startsWith "runtime/testing/"))
                       (js-call id :endsWith ".mjs"))
              (let* ((names (exported-names (get record :program))) (public-id (+ "public/" id)))
                (assert (> (js-length names) 0) (+ id " must expose its actual public contract"))
                (await (funcall (add public-id (+ "sequence-data-public/" id)
                  (+ "(import " (JSON/stringify (+ "eliscript/" id)) " " (js-call names :join " ") ")\n(export "
                     (js-call names :join " ") ")\n"))))
                (js-call public-modules :set id public-id))))
          (setq index (1+ index)))
        (await (funcall (add entry "tests/fixtures/wasm-managed-sequence-data.eli")))
        (await (funcall (add "tests/fixtures/lazy-sequence.mjs" "tests/fixtures/lazy-sequence.eli")))
        (await (funcall (add "core-set-usage.mjs" "tests/fixtures/core-set-usage.eli")))
        (let ((families (js-array "sequence" "text" "object")) (position 0))
          (while (< position (js-length families))
            (let ((family (aref families position)))
              (await (funcall (add (+ family ".mjs") (+ "stdlib/" family ".eli"))))
              (when (= family "object") (await (funcall (add "data.mjs" "stdlib/data.eli"))))
              (await (funcall (add (+ family "-usage.mjs") (+ "tests/fixtures/" family "-usage.eli")))))
            (setq position (1+ position)))))
      (let ((hosts (js-call original-hosts :concat (js-array "lazy-sequence" "core-text-object"))) (position 0))
        (while (< position (js-length hosts))
          (let ((name (aref hosts position)))
            (js-call original-sources :set name (await (readFile (resolve root (+ "tests/fixtures/" name "-host.mjs")) "utf8"))))
          (setq position (1+ position))))
      ;; The binary facade exposes the actual managed collection contract,
      ;; including its extra private helpers. The independent reference needs
      ;; only these four original public exports, never those managed extras.
      (await (write (resolve oracle-directory "protocol-exact-reference.mjs")
        (js-call (get backend :compiler) :compile_string
          "(import \"eliscript/runtime/core/collection.mjs\" reduce assoc IReduce IAssociative) (export reduce assoc IReduce IAssociative)"
          "protocol-exact-reference.eli")))
      (let* ((runtime (js-call (get backend :compiler) :compile_ir_string
                        (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
             (input (Array/from (js-call modules :values)))
             (saved (funcall globalThis.structuredClone input)) (library (funcall globalThis.structuredClone literal-modules)))
        (setq runtime-ir runtime literal-ir literal-modules)
        (let* ((usage (js-call modules :get "core-set-usage.mjs"))
               (specifiers (js-call (import-nodes (get usage :program)) :map (lambda (node) (get node :value)))))
          (js-call assert :ok (js-call specifiers :includes "eliscript/runtime/core/collection.mjs"))
          (js-call assert :ok (js-call specifiers :includes "./stdlib/core/set.mjs")))
        (js-call input :forEach (lambda (module)
          (js-call (import-nodes (get module :program)) :forEach (lambda (node)
            (let ((specifier (get node :value)))
              (when (js-call specifier :startsWith "eliscript/runtime/")
                (js-call assert :ok (js-call canonical-ids :has (js-call specifier :slice (js-length "eliscript/"))))))))))
        (setq lowered (js-call (get backend :managed) :lower_managed_project input entry runtime
                        (js-object :literalModules literal-modules :phased t)))
        (js-call assert :deepStrictEqual input saved) (js-call assert :deepStrictEqual literal-modules library)
        ;; Keep the actual small descriptor available to the existing fixture
        ;; lifecycle without creating another copy of the typed program.
        (await (writeFile (resolve directory "descriptor.json") (JSON/stringify (get lowered :descriptor))))
        (let ((bytes (globalThis.Uint8Array.from (js-call (get backend :wasm) :append_metadata_section
                       (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) memory)
                       "eliscript-managed-control" (JSON/stringify (get lowered :descriptor))))))
          ;; The complete original usage programs print their results. Check
          ;; only their three real declared capabilities, including order.
          (let* ((names (js-array "source-operation" "console-log-capture" "console-log"))
                 (imports (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)))
                 (declared (get (get lowered :descriptor) :hostCapabilities)))
            (js-call assert :deepStrictEqual declared
              (js-call names :map (lambda (name)
                (js-object :name name :module "eliscript.host" :arity 2 :abi "managed-host-call-v1"))))
            (js-call assert :deepStrictEqual
              (js-call imports :map (lambda (item)
                (js-object :module (get item :module) :name (get item :name) :kind (get item :kind))))
              (js-call names :map (lambda (name)
                (js-object :module "eliscript.host" :name name :kind "function"))))
            (js-call imports :forEach (lambda (item)
              (when (Object/hasOwn item "type")
                (js-call assert :deepStrictEqual (get item :type)
                  (js-object :parameters (js-array "i32" "i32") :results (js-array "i32")))))))
          (setq wasm-path (resolve directory "sequence-data.wasm")) (await (writeFile wasm-path bytes)))
        (when native-supported
          (setq native-path (resolve directory (if (= (get globalThis.process :platform) "linux") "sequence-data.so" "sequence-data.dylib")))
          (await (writeFile native-path (globalThis.Uint8Array.from
            (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target)))))
        (setq lowered (retained-runtime-input lowered))
        (await (writeFile (resolve directory "lowered.json") (JSON/stringify lowered)))))
      ;; Canonical compiler transport validates every original program field.
      ;; Round trips are checked against the real graphs before publication.
      (let ((literal-records (js-array)) (index 0))
        (await (mkdir (resolve directory "build-ir") (js-object :recursive t)))
        (let ((wire (serialize-program runtime-ir)))
          (js-call assert :deepStrictEqual (deserialize-program wire) runtime-ir)
          (await (writeFile (resolve directory "build-ir/runtime.json") wire)))
        (while (< index (js-length literal-ir))
          (let* ((record (aref literal-ir index)) (program (get record :program))
                 (path (+ "build-ir/literal-" index ".json")) (wire (serialize-program program)))
            (js-call assert :deepStrictEqual (deserialize-program wire) program)
            (await (writeFile (resolve directory path) wire))
            (js-call literal-records :push (js-object :id (get record :id) :path path)))
          (setq index (1+ index)))
        (let ((receipt (js-object :format "eliscript-sequence-build" :version 1
          :directory directory :producerPid (get globalThis.process :pid) :entry entry
          :canonicalRoundTrip t :runtimeIR "build-ir/runtime.json" :literalIR literal-records
          :oracleDirectory oracle-directory :wasmPath wasm-path :nativePath native-path
          :originalSources (Array/from (js-call original-sources :entries))
          :publicModules (Array/from (js-call public-modules :entries)))))
          ;; Publish only after all original assertions and file writes succeed.
          (await (writeFile (resolve directory "build-complete.json") (JSON/stringify receipt))) receipt))))
  (export buildSequenceArtifacts)
  (defasync run ()
    (let* ((arguments (get globalThis.process :argv))
           (directory (resolve (aref arguments 2)))
           (settings (JSON/parse (await (readFile (aref arguments 3) "utf8")))))
      (await (buildSequenceArtifacts directory settings))))
  (when (= (basename (get (get globalThis.process :argv) 1 "")) "managed-sequence-build-selfhosted.mjs")
    (js-call (run)
      :catch (lambda (error) (console/error error) (put globalThis.process :exitCode 1)))))
