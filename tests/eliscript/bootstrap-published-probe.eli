(module tests.bootstrap-published-probe
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" writeFile realpath)
  (import "node:path" resolve)
  (import "node:module" createRequire)
  (defasync main ()
    (let* ((arguments (get globalThis.process :argv))
           (compiler-path (await (realpath (resolve (aref arguments 2)))))
           (output-path (resolve (aref arguments 3)))
           (require-module (createRequire compiler-path))
           (compiler (funcall require-module compiler-path))
           (output (js-call compiler :compile_string "(defun square (x) (* x x)) (export square)" "packaged.eli")))
      (await (writeFile output-path output))
      (let* ((canonical (await (realpath output-path)))
             (module (funcall (createRequire canonical) canonical)))
        (js-call assert :strictEqual (js-call module :square 7) 49 "packaged compiler did not execute"))))
  (js-call (main) :catch (lambda (error)
    (js-call globalThis.console :error error)
    (put globalThis.process :exitCode 1)))
)
