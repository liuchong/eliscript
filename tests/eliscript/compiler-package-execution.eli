(module tests.compiler-package-execution
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync writeFileSync mkdirSync)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/testing/fixture-environment.mjs" prepareFixtureEnvironment fixtureChildArguments)
  (import "../tools/testing/compiler-package-execution.mjs" rewriteCompilerPackageExecution compilerPackageRuntimeFacade compilerPackageFunctionalArguments)
  (test "only both explicit functional flags separate the two authenticated complete Node package CLI cases from their original total deadline"
    (lambda ()
      (let* ((body (async () 42))
             (environment (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1"
               :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small"))
             (titles (js-call (js-array "emit-ir" "project-ir") :map (lambda (operation)
               (str "Given the original and relocated javascript compiler When node CLI request submits " operation
                 " Then real products sidecars and recovery preserve their ABI")))))
        (js-call titles :forEach (lambda (title)
          (let ((arguments (js-array title body 120000)))
            (js-call (js-array (js-object) (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1")
              (js-object :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small")
              (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "0" :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "small")
              (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1" :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE "large"))
              :forEach (lambda (env)
                (js-call assert :strictEqual (compilerPackageFunctionalArguments root env arguments) arguments)))
            (let ((forwarded (compilerPackageFunctionalArguments root environment arguments)))
              (js-call assert :notStrictEqual forwarded arguments)
              (js-call assert :deepStrictEqual forwarded (js-array title body 0))
              (js-call assert :deepStrictEqual arguments (js-array title body 120000))
              (js-call assert :strictEqual (aref forwarded 1) body))
            (js-call (js-array (js-array title body 119999) (js-array title body 120000 "extra")
              (js-array title nil 120000) (js-array (str title " changed") body 120000)
              (js-array (js-call title :replace "When node" "When bun") body 120000)
              (js-array (js-call title :replace "javascript compiler" "native compiler") body 120000))
              :forEach (lambda (original)
                (js-call assert :strictEqual (compilerPackageFunctionalArguments root environment original) original))))))
        (js-call (js-array "emit-memory-ir" "emit-typed-memory") :forEach (lambda (operation)
          (let ((arguments (js-array (str "Given the original and relocated javascript compiler When node CLI request submits "
                    operation " Then real products sidecars and recovery preserve their ABI") body 120000)))
            (js-call assert :strictEqual (compilerPackageFunctionalArguments root environment arguments) arguments))))
        (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
               (directory (get fixture :directory)) (suite (resolve directory "tests/compiler-package-session.test.mjs"))
               (arguments (js-array (aref titles 0) body 120000)))
          (try
            (mkdirSync (resolve directory "tests"))
            (writeFileSync suite (readFileSync (resolve root "tests/compiler-package-session.test.mjs")))
            (js-call assert :deepStrictEqual (compilerPackageFunctionalArguments directory environment arguments)
              (js-array (aref titles 0) body 0))
            (writeFileSync suite "changed complete original package suite")
            (js-call assert :throws (lambda () (compilerPackageFunctionalArguments directory environment arguments)) globalThis.TypeError)
            (finally (js-call fixture :close)))))))
  (test "only the exact original relocated package child selects maintained file execution with its complete source authenticated"
    (lambda ()
      (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
             (directory (get fixture :directory))
             (suite (readFileSync (resolve root "tests/compiler-package-session.test.mjs") "utf8"))
             (marker "const runPackage = String.raw`")
             (begin (+ (js-call suite :indexOf marker) (js-length marker)))
             (end (js-call suite :indexOf "`;" begin))
             (file (resolve directory "run-package-node.mjs"))
             (arguments (js-array file)) (options (js-object :cwd directory :env (get fixture :environment))))
        (try
          (writeFileSync file (js-call suite :slice begin end))
          (js-call assert :deepStrictEqual (rewriteCompilerPackageExecution arguments options root)
            (js-array (resolve root "tools/testing/compiler-package-execution.mjs")))
          (js-call assert :deepStrictEqual arguments (js-array file))
          (js-call assert :strictEqual (rewriteCompilerPackageExecution (js-array "ordinary.mjs") options root) undefined)
          (js-call assert :strictEqual (rewriteCompilerPackageExecution (js-array) options root) undefined)
          (js-call assert :strictEqual (rewriteCompilerPackageExecution (js-array "--eval" "original body") options root) undefined)
          (writeFileSync file (str (js-call suite :slice begin end) "\n"))
          (js-call assert :throws (lambda () (rewriteCompilerPackageExecution arguments options root)) globalThis.TypeError)
          (finally (js-call fixture :close))))))
  (test "package runtime cleanup adapts only the historical WASM close spelling while retaining every native descriptor and failure identity"
    (lambda ()
      (let* ((calls 0) (marker (Object/freeze (js-object :first t)))
             (runtime (Object/freeze (js-object :closeModule (lambda () (setq calls (1+ calls)) (throw marker))
               :invoke (lambda () 42))))
             (facade (compilerPackageRuntimeFacade runtime)))
        (js-call assert :strictEqual (Object/getPrototypeOf facade) (Object/getPrototypeOf runtime))
        (js-call assert :deepStrictEqual (Object/getOwnPropertyDescriptor facade "invoke") (Object/getOwnPropertyDescriptor runtime "invoke"))
        (js-call assert :throws (lambda () (js-call facade :close)) (lambda (error) (eq error marker)))
        (js-call assert :strictEqual calls 1)
        (js-call assert :strictEqual (Object/hasOwn runtime "close") false))
      (let ((native (js-object :close (lambda () undefined) :closeModule (lambda () undefined))))
        (js-call assert :strictEqual (compilerPackageRuntimeFacade native) native))))
  (test "complete original product child selects the maintained runner without changing input coordinates or accepting a changed assertion body"
    (lambda ()
      (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
             (directory (get fixture :directory))
             (suite (readFileSync (resolve root "tests/compiler-package-session.test.mjs") "utf8"))
             (marker "const executeCLIRequestProduct = String.raw`")
             (begin (+ (js-call suite :indexOf marker) (js-length marker)))
             (end (js-call suite :indexOf "`;" begin))
             (file (resolve directory "execute-product.mjs"))
             (input (resolve directory "原😀-input.json"))
             (arguments (js-array file input)) (options (js-object :cwd directory :env (get fixture :environment))))
        (try
          (writeFileSync file (js-call suite :slice begin end))
          (js-call assert :deepStrictEqual (rewriteCompilerPackageExecution arguments options root)
            (js-array (resolve root "tools/testing/compiler-package-product.mjs") input))
          (js-call assert :deepStrictEqual arguments (js-array file input))
          (writeFileSync file (str (js-call suite :slice begin end) "\n"))
          (js-call assert :throws (lambda () (rewriteCompilerPackageExecution arguments options root)) globalThis.TypeError)
          (finally (js-call fixture :close))))))
  (test "the complete package suite retains parser and bounded assertion preloads while adding its authenticated cleanup adapter exactly once"
    (lambda ()
      (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
             (environment (get fixture :environment))
             (arguments (js-array "--smol" "test" "--timeout" "300000" "./tests/compiler-package-session.test.mjs")))
        (try
          (let ((prepared (fixtureChildArguments arguments environment)))
            (js-call assert :deepStrictEqual prepared
              (js-array "--smol" "test" "--preload" (resolve root "tools/testing/fixture-environment.mjs")
                "--preload" (resolve root "tools/testing/independent-cli-fixture.mjs")
                "--preload" (resolve root "tests/helpers/bounded-assertions-install.mjs")
                "--preload" (resolve root "tests/helpers/compiler-package-runtime-install.mjs")
                "--timeout" "300000" "./tests/compiler-package-session.test.mjs"))
            (js-call assert :deepStrictEqual (fixtureChildArguments prepared environment) prepared))
          (finally (js-call fixture :close))))))
)
