(module tests.bootstrap-seed-batch
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile readdir rm mkdir cp symlink lstat)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)

  (defconst environment (get globalThis.process :env))
  (defconst modules (js-array "symbol" "syntax" "reader" "formatter" "expander" "transient-analysis"
    "analyzer" "ir" "lower" "source-map" "emitter" "project" "compiler"))
  (defconst support-names (js-array "math" "unicode-case" "unicode-case-data"))
  (defun child-env (changes) (Object/assign (js-object) environment changes))
  (defun original-emacs () (if (undefined? (get environment :EMACS)) "emacs" (get environment :EMACS)))
  (defasync install-proxy (directory name)
    (let ((path (resolve directory name)))
      (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
      (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
      (await (writeFile path (+ "#!" (get globalThis.process :execPath) "\n"
        (await (readFile (resolve root "tests/helpers/bootstrap-seed-proxy.mjs") "utf8")))
        (js-object :mode 448))) path))
  (defun check-process (child)
    (js-call assert :equal (get child :status) 0 (get child :stderr)))
  (defasync count-calls (path)
    (js-length (js-call (js-call (await (readFile path "utf8")) :trim) :split "\n")))
  (defasync check-compiler-inventory (directory expected)
    (let ((names (await (readdir directory))))
      (js-call assert :deepEqual (js-call (js-call names :filter (lambda (name)
        (and (not (= name "runtime")) (not (= name "package.json"))))) :sort)
        (js-call (Array/from (js-call expected :keys)) :sort)))
    (let ((entries (Array/from (js-call expected :entries))) (index 0))
      (while (< index (js-length entries))
        (let ((entry (aref entries index)))
          (js-call assert :ok (js-call (await (readFile (resolve directory (aref entry 0)))) :equals (aref entry 1)) (aref entry 0)))
        (setq index (1+ index)))))
  (defasync read-runtime-support (directory)
    (let ((expected (js-array)) (index 0) (files (new globalThis.Map)))
      (while (< index (js-length support-names))
        (let ((name (aref support-names index)))
          (js-call expected :push (+ name ".mjs") (+ name ".mjs.map")))
        (setq index (1+ index)))
      (js-call assert :deepEqual (js-call (await (readdir (resolve directory "runtime"))) :sort) (js-call expected :sort))
      (setq index 0)
      (while (< index (js-length expected))
        (let ((path (+ "runtime/" (aref expected index))))
          (js-call files :set path (await (readFile (resolve directory path)))))
        (setq index (1+ index)))
      (let* ((bytes (await (readFile (resolve directory "package.json"))))
             (package (JSON/parse (js-call bytes :toString "utf8"))))
        (js-call assert :equal (get package :name) "eliscript")
        (js-call assert :equal (get package :type) "module")
        (js-call support-names :forEach (lambda (name)
          (js-call assert :equal (get (get package :exports) (+ "./runtime/" name ".mjs")) (+ "./runtime/" name ".mjs"))))
        (js-call files :set "package.json" bytes)) files))
  (defasync equal-support (directory expected)
    (let ((actual (await (read-runtime-support directory))) (entries (Array/from (js-call expected :entries))) (index 0))
      (js-call assert :equal (get actual :size) (get expected :size))
      (while (< index (js-length entries))
        (let ((entry (aref entries index)))
          (js-call assert :ok (js-call (js-call actual :get (aref entry 0)) :equals (aref entry 1)) (aref entry 0)))
        (setq index (1+ index)))))

  (test "backend fixtures seed all compiler modules in one Emacs process with byte-identical independent CLI artifacts"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-seed-batch-"))))
             (output (resolve directory "bootstrap")) (calls (resolve directory "calls"))
             (keys (js-array "EMACS" "ELISCRIPT_BATCH_CALL_LOG" "ELISCRIPT_BATCH_REAL_EMACS"))
             (saved (Object/fromEntries (js-call keys :map (lambda (key) (js-array key (get environment key)))))))
        (try
          (progn
            ;; All thirteen independent public seed calls remain the reference.
            (let ((index 0))
              (while (< index (js-length modules))
                (let* ((name (aref modules index))
                       (baseline (spawnSync (resolve root "bin/eliscript-seed")
                         (js-array "--source-map" "--output" (resolve output (+ name ".mjs"))
                           (resolve root "bootstrap/compiler" (+ name ".eli")))
                         (js-object :cwd root :encoding "utf8" :timeout 120000))))
                  (check-process baseline))
                (setq index (1+ index))))
            (let ((expected (new globalThis.Map)) (index 0))
              (while (< index (js-length modules))
                (let ((suffixes (js-array ".mjs" ".mjs.map")) (suffix-index 0))
                  (while (< suffix-index 2)
                    (let ((name (+ (aref modules index) (aref suffixes suffix-index))))
                      (js-call expected :set name (await (readFile (resolve output name)))))
                    (setq suffix-index (1+ suffix-index))))
                (setq index (1+ index)))
              (await (rm output (js-object :recursive t :force t)))
              (let ((proxy (await (install-proxy directory "emacs-proxy.mjs"))))
                (put environment :EMACS proxy)
                (put environment :ELISCRIPT_BATCH_CALL_LOG calls)
                (put environment :ELISCRIPT_BATCH_REAL_EMACS (if (undefined? (get saved :EMACS)) "emacs" (get saved :EMACS))))
              (await (buildBackends (js-object :outputRoot directory)))
              (js-call assert :equal (await (count-calls calls)) 1)
              (await (check-compiler-inventory output expected))
              (let ((support (await (read-runtime-support output))) (semantic (resolve directory "semantic")))
                (await (writeFile calls "")) (await (seedCompilerFixture semantic))
                (js-call assert :equal (await (count-calls calls)) 1)
                (await (check-compiler-inventory semantic expected))
                (await (equal-support semantic support))
                (await (rm output (js-object :recursive t :force t))) (await (writeFile calls ""))
                (check-process (spawnSync (resolve root "bin/eliscript-bootstrap") (js-array)
                  (js-object :cwd root :encoding "utf8" :timeout 120000
                    :env (child-env (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR output)))))
                (js-call assert :equal (await (count-calls calls)) 1 "public bootstrap must seed all modules in one fresh Emacs process")
                (await (check-compiler-inventory output expected))
                (await (equal-support output support)))))
          (finally
            (js-call keys :forEach (lambda (key)
              (if (undefined? (get saved key)) (Reflect/deleteProperty environment key) (put environment key (get saved key)))))
            (await (rm directory (js-object :recursive t :force t))))))) 120000)

  (test "the batch seed entry passes strict byte compilation and refuses malformed module paths with a failing exit status"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-seed-batch-errors-"))))
             (tool (resolve root "tools/bootstrap-seed.el")) (copied (resolve directory "tools/bootstrap-seed.el")))
        (try
          (progn
            (await (mkdir (resolve directory "tools"))) (await (writeFile copied (await (readFile tool))))
            (check-process (spawnSync (original-emacs)
              (js-array "--batch" "-Q" "-L" (resolve root "compiler") "-L" (resolve root "tools")
                "--eval" "(setq byte-compile-error-on-warn t)" "--eval"
                (+ "(unless (byte-compile-file " (JSON/stringify copied) ") (kill-emacs 1))"))
              (js-object :encoding "utf8" :timeout 30000)))
            (let ((result (spawnSync (original-emacs)
                    (js-array "--batch" "-Q" "--script" tool "--" root (resolve directory "output") "../outside")
                    (js-object :encoding "utf8" :timeout 30000))))
              (js-call assert :equal (get result :status) 1)
              (js-call assert :match (get result :stderr) (new globalThis.RegExp "invalid bootstrap module name"))
              (js-call assert :deepEqual (js-call (await (readdir directory)) :sort) (js-array "tools"))))
          (finally (await (rm directory (js-object :recursive t :force t))))))) 60000)

  (test "semantic compiler fixture setup rejects a failing seed process instead of reusing stale artifacts"
    (async ()
      (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-semantic-seed-failure-")))))
        (try
          (let* ((proxy (await (install-proxy directory "failing-emacs.mjs"))) (output (resolve directory "output"))
                 (previous (get environment :ELISCRIPT_BATCH_FAILURE)))
            (await (mkdir output))
            (await (writeFile (resolve output "compiler.mjs") "stale fixture must not bypass the seed"))
            (put environment :ELISCRIPT_BATCH_FAILURE "intentional semantic seed failure")
            (try
              (await (js-call assert :rejects (seedCompilerFixture output (js-object :emacs proxy))
                (lambda (error) (and (= (get error :exitCode) 17)
                  (js-call (get error :message) :includes "intentional semantic seed failure")))))
              (finally (if (undefined? previous) (Reflect/deleteProperty environment "ELISCRIPT_BATCH_FAILURE")
                (put environment :ELISCRIPT_BATCH_FAILURE previous)))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "public bootstrap refuses a failed fresh seed even when stale compiler files exist"
    (async ()
      (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript public seed failure ")))))
        (try
          (let* ((proxy (await (install-proxy directory "failing emacs.mjs"))) (output (resolve directory "old output")))
            (await (mkdir output))
            (await (writeFile (resolve output "compiler.mjs") "stale compiler must not bypass bootstrap"))
            (let ((result (spawnSync (resolve root "bin/eliscript-bootstrap") (js-array)
                    (js-object :cwd root :encoding "utf8" :timeout 30000
                      :env (child-env (js-object :EMACS proxy :ELISCRIPT_BOOTSTRAP_OUT_DIR output
                        :ELISCRIPT_BATCH_FAILURE "intentional public bootstrap failure"))))))
              (js-call assert :equal (get result :status) 17)
              (js-call assert :match (get result :stderr) (new globalThis.RegExp "intentional public bootstrap failure"))
              (js-call assert :equal (await (readFile (resolve output "compiler.mjs") "utf8")) "stale compiler must not bypass bootstrap")))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "public bootstrap runs from the published compiler trees without development tools"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript packaged seed "))))
             (packaged (resolve directory "package")) (output (resolve directory "compiled output")))
        (try
          (progn
            (let ((trees (js-array "bin" "compiler" "bootstrap/compiler")) (index 0))
              (while (< index (js-length trees))
                (let ((tree (aref trees index)))
                  (await (cp (resolve root tree) (resolve packaged tree) (js-object :recursive t :dereference t))))
                (setq index (1+ index))))
            ;; Only public seed launcher dependencies and maintained runtime
            ;; sources are shipped, with no backend/dev tools or old dist.
            (await (mkdir (resolve packaged "tools") (js-object :recursive t)))
            (let ((tools (js-array "bootstrap-runtime.el" "bootstrap-seed.el")) (index 0))
              (while (< index 2)
                (let ((name (aref tools index)))
                  (await (cp (resolve root "tools" name) (resolve packaged "tools" name) (js-object :dereference t))))
                (setq index (1+ index))))
            (await (mkdir (resolve packaged "runtime") (js-object :recursive t)))
            (let ((index 0))
              (while (< index (js-length support-names))
                (let ((name (aref support-names index)))
                  (await (cp (resolve root "runtime" (+ name ".eli"))
                    (resolve packaged "runtime" (+ name ".eli")) (js-object :dereference t))))
                (setq index (1+ index))))
            (js-call assert :deepEqual (js-call (await (readdir (resolve packaged "tools"))) :sort)
              (js-array "bootstrap-runtime.el" "bootstrap-seed.el"))
            (await (js-call assert :rejects (lstat (resolve packaged "dist"))))
            (check-process (spawnSync (resolve packaged "bin/eliscript-bootstrap") (js-array)
              (js-object :cwd directory :encoding "utf8" :timeout 120000
                :env (child-env (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR output)))))
            (js-call assert :equal (js-length (js-call (await (readdir output)) :filter
              (lambda (name) (js-call name :endsWith ".mjs")))) 13)
            (js-call assert :equal (js-length (js-call (await (readdir output)) :filter
              (lambda (name) (js-call name :endsWith ".mjs.map")))) 13)
            (await (read-runtime-support output))
            ;; The generated Eli test driver invokes this package's freshly
            ;; built compiler. It is not a compiler supplied to the package.
            (let* ((driver (resolve output "published-probe.mjs"))
                   (probe (await (readFile (resolve root "tests/helpers/bootstrap-published-probe.mjs")))))
              (await (writeFile driver probe))
              (js-call assert :deepEqual (await (readFile driver)) probe)
              (check-process (spawnSync "bun" (js-array driver (resolve output "compiler.mjs") (resolve output "user.mjs"))
                (js-object :cwd directory :encoding "utf8" :timeout 30000)))))
          (finally (await (rm directory (js-object :recursive t :force t))))))) 120000)
)
