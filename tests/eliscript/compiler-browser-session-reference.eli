(module tests.compiler-browser-session-reference
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile realpath)
  (import "node:path" resolve dirname)
  (import "node:module" createRequire)
  (import "../../tools/backends/compiler-bootstrap.mjs" openCompilerArtifact)
  (import "../../tools/backends/compiler-build.mjs" loadCompilerSources)
  (import "../../tools/backends/compiler-metadata.mjs" readCompilerMetadata)
  (import "../../tools/backends/stage3-targets.mjs" authenticateStage3Targets)
  (defun merge (&rest values) (Reflect/apply Object/assign undefined (js-call (js-array (js-object)) :concat values)))
  (defasync save (input kind target product)
    (let ((metadata (merge product)) (base (resolve (get input :output) (+ "reference-" kind "-" target))))
      (Reflect/deleteProperty metadata "bytes")
      (await (writeFile (+ base ".json") (JSON/stringify metadata)))
      (unless (= target "javascript") (await (writeFile (+ base ".bytes") (js-call globalThis.Uint8Array :from (get product :bytes)))))))
  (defasync run ()
    (let* ((input (JSON/parse (await (readFile (aref (get globalThis.process :argv) 2) "utf8"))))
           (expected (get input :authentication))
           (authentication (await (authenticateStage3Targets (js-object :bootstrapManifestPath (get expected :bootstrapManifestPath)
             :stage3MetadataPath (get expected :stage3MetadataPath)))))
           (path (get authentication :stage3MetadataPath))
           (artifact (merge (await (readCompilerMetadata path)) (js-object :directory (dirname path))))
           (session (await (openCompilerArtifact artifact)))
           (failed false) (first undefined))
      (js-call assert :deepStrictEqual authentication expected)
      (try
        (let* ((source (get input :source)) (filename (get input :filename)) (entry (get input :entry))
               (compiled (await (js-call session :request (js-object :operation "compile" :source source :filename filename
                 :sourceMap (js-object :generatedFile entry :sourceName filename)))))
               (ir (get (await (js-call session :request (js-object :operation "compile-ir" :source source :filename filename))) :ir))
               (canonical (get (await (js-call session :request (js-object :operation "serialize-ir" :ir ir))) :canonicalIR))
               (sources (await (loadCompilerSources))) (report undefined)
               (targets (js-array "javascript" "wasm" "native")) (index 0))
          (js-call assert :strictEqual (get compiled :filename) filename)
          (await (js-call session :request (js-object :operation "runtime" :source (get (get sources :runtime) :source)
            :filename (get (get sources :runtime) :filename) :literalSources (get sources :literalSources))))
          (while (< index 3)
            (let* ((target (aref targets index))
                   (common (js-object :target target :debug t :memory (get (get input :resources) :memory)
                     :nativeTarget (get input :nativeTarget) :nativeFormat "library"))
                   (product (await (js-call session :request (merge common (js-object :operation "project" :modules (get input :modules) :entry entry :resolveImports t :sourceMap t)))))
                   (single (await (js-call session :request (merge common (js-object :operation "emit-ir" :ir ir :source source :sourceMap (js-object :generatedFile entry :sourceName filename)))))))
              (js-call assert :strictEqual (get product :target) target) (js-call assert :strictEqual (get product :entry) entry)
              (await (save input "products" target product)) (await (save input "single" target single))
              (if (= target "javascript")
                (let* ((output (js-call (get product :modules) :find (lambda (item) (= (get item :id) entry))))
                       (path (resolve (get input :output) "reference-program.mjs")))
                  (js-call assert :strictEqual (js-length (get product :modules)) (js-length (get input :modules)))
                  (js-call assert :ok output)
                  (await (writeFile path (get output :javascript))) (await (writeFile (+ path ".map") (get output :sourceMap)))
                  (setq report (js-call (funcall (createRequire path) (await (realpath path))) :expression_form_report)))
                (when (= target "wasm")
                  (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports
                    (new globalThis.WebAssembly.Module (js-call globalThis.Uint8Array :from (get product :bytes)))) (js-array)))))
            (setq index (1+ index)))
          (await (writeFile (resolve (get input :output) "reference-language.json")
            (JSON/stringify (js-object :compile (js-object :javascript (get compiled :javascript) :sourceMap (get compiled :sourceMap)) :ir ir :canonical canonical :report report)))))
        (catch error (setq failed t) (setq first error))
        (finally (try (await (js-call session :close)) (catch error (unless failed (setq failed t) (setq first error))))))
      (when failed (throw first))))
  (js-call (run) :catch (lambda (error) (js-call globalThis.console :error error) (put globalThis.process :exitCode 1))))
