(module tests.stdlib-bit
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile readdir)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/testing/stdlib-bit.mjs" runStdlibBitAcceptance)
  (import "../tools/backends/compiler-corpus-bit.mjs" transportOriginalStdlibBitCorpus)

  (defun hash (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))
  (defasync original-document ()
    (let* ((source (await (readFile (resolve root "tests/stdlib-bit.test.mjs") "utf8")))
           (modules (js-array))
           (files (js-call (await (readdir (resolve root "bootstrap/compiler"))) :filter (lambda (name)
             (js-call (new globalThis.RegExp "^[a-z][a-z-]*[.]eli$") :test name))))
           (index 0))
      (js-call files :sort)
      (while (< index (js-length files))
        (let* ((filename (str "bootstrap/compiler/" (aref files index)))
               (id (str (js-call filename :slice 0 -4) ".mjs")))
          (js-call modules :push (js-object :id id :filename filename :source (await (readFile (resolve root filename) "utf8")))))
        (setq index (1+ index)))
      (js-object :records (js-array (js-object :id "unrelated" :expected (js-object :value 42))
        (js-object :id "original-program:compiler-stdlib-bit-complete" :kind "project"
          :modules modules :entry "bootstrap/compiler/compiler.mjs"
          :coverage (js-array "original-complete-bit") :request (js-object :operation "project" :sourceMap t)
          :expected (js-object :kind "seed-program" :oracleRequired t :stdout "")
          :execution (js-object :kind "original-program" :host "tests/__eliscript_original_stdlib-bit_complete.mjs"
            :hostSource "historical setup and complete original assertions" :requiresBun t :hostRuntime "bun"
            :referenceArtifact t :timeoutMs 30000 :runtimeProfile "compiler" :aliases t
            :setupReplacement (js-object :kind "selected-and-independent-reference-compiler-directories"
              :algorithms "selected-target-only" :originalCaseTimeouts (js-array 30000)))
          :original (js-object :suite "tests/stdlib-bit.test.mjs" :fixture "tests/stdlib-bit.test.mjs"
            :host "tests/stdlib-bit.test.mjs" :sourceSha256 (hash source)
            :regions (js-array (js-object :start 0 :end (js-length source) :byteStart 0
              :byteEnd (js-call Buffer :byteLength source) :sha256 (hash source))))))
        :evidence (js-array) :originalGateEvidence (js-object :verification "pending"))))

  (test "portable 32-bit operations and algorithms agree under Bun and Node"
    (async () (await (runStdlibBitAcceptance))) 30000)

  (test "the complete bit transport binds the original source and keeps every compiler input, result and original deadline"
    (async ()
      (let* ((document (await (original-document))) (record (aref (get document :records) 1))
             (other (aref (get document :records) 0)) (gate (get document :originalGateEvidence))
             (before (globalThis.structuredClone record)))
        (js-call assert :strictEqual (get (get record :original) :sourceSha256)
          "c550405d71455b5ce694c929b63b6a0843ea637f5b35ccf221afd5780ce16771")
        (js-call assert :strictEqual (await (transportOriginalStdlibBitCorpus document (js-object :sourceRoot root))) document)
        (js-call assert :strictEqual (aref (get document :records) 0) other)
        (js-call assert :strictEqual (get document :originalGateEvidence) gate)
        (js-call (js-array "modules" "request" "coverage" "entry" "expected") :forEach (lambda (key)
          (js-call assert :deepStrictEqual (get record key) (get before key))))
        (js-call (js-array "suite" "fixture" "host" "sourceSha256" "regions") :forEach (lambda (key)
          (js-call assert :deepStrictEqual (get (get record :original) key) (get (get before :original) key))))
        (let ((execution (Object/assign (js-object) (get record :execution)))
              (baseline (Object/assign (js-object) (get before :execution))))
          (js-call assert :strictEqual (get baseline :host) "tests/__eliscript_original_stdlib-bit_complete.mjs")
          (js-call assert :strictEqual (get execution :host) "tools/testing/stdlib-bit-corpus-host.mjs")
          ;; Transport replaces the historical generated host with its real
          ;; maintained entry; all compiler inputs and execution contracts stay.
          (put baseline :host "tools/testing/stdlib-bit-corpus-host.mjs")
          (Reflect/deleteProperty execution "hostSource") (Reflect/deleteProperty baseline "hostSource")
          (js-call assert :deepStrictEqual execution baseline))
        (let* ((host "tools/testing/stdlib-bit-corpus-host.mjs")
               (source "tools/testing/stdlib-bit-corpus-host.eli")
               (bytes (await (readFile (resolve root host))))
               (source-bytes (await (readFile (resolve root source))))
               (asset (js-call (get document :evidence) :find (lambda (item) (= (get item :file) host))))
               (source-asset (js-call (get document :evidence) :find (lambda (item) (= (get item :file) source))))
               (proofs (get (get record :original) :sourceAssets))
               (transport (get (get record :original) :maintainedTransport)))
          (js-call assert :strictEqual (Object/hasOwn (get record :execution) "hostSource") false)
          (js-call assert :strictEqual (get (get record :execution) :host) host)
          (js-call (js-array (js-array asset bytes host) (js-array source-asset source-bytes source)) :forEach
            (lambda (entry)
              (let* ((identity (aref entry 0)) (actual (aref entry 1)) (filename (aref entry 2))
                     (bound (js-call proofs :find (lambda (proof) (= (get proof :file) filename)))))
                (js-call assert :ok identity)
                (js-call assert :ok bound)
                (js-call assert :strictEqual (get identity :encoding) "base64")
                (js-call assert :deepStrictEqual (js-call Buffer :from (get identity :content) "base64") actual)
                (js-call assert :strictEqual (get identity :content) (js-call actual :toString "base64"))
                (js-call assert :strictEqual (get identity :bytes) (js-length actual))
                (js-call assert :strictEqual (get identity :sha256) (hash actual))
                (js-call assert :strictEqual (get bound :sourceSha256) (hash actual)))))
          (js-call assert :strictEqual (get transport :sourceFile) source)
          (js-call assert :strictEqual (get transport :generatedFile) host)
          (js-call assert :strictEqual (get transport :generatedSha256) (hash bytes)))
        (let ((metadata (get (get record :original) :maintainedTransport)))
          (js-call assert :strictEqual (get metadata :kind) "maintained-eli-complete-stdlib-bit")
          (js-call assert :strictEqual (get metadata :originalTimeoutMs) 30000)
          (js-call assert :deepStrictEqual (get metadata :hosts) (js-array "bun" "node"))
          (js-call assert :strictEqual (get metadata :compilerCount) 2)
          (js-call assert :strictEqual (get metadata :hostExecutions) 4)
          (js-call assert :strictEqual (get metadata :fallback) false))
        (js-call assert :ok (> (js-length (get (get record :original) :sourceAssets)) 15)))))

  (test "bit transport rejects original hash, complete region, timeout, duplicate recipe and actual asset proof drift"
    (async ()
      (let ((changes (js-array
        (lambda (record) (put (get record :original) :sourceSha256 (js-call "0" :repeat 64)))
        (lambda (record) (put (aref (get (get record :original) :regions) 0) :end 1))
        (lambda (record) (put (get record :execution) :timeoutMs 30001))
        (lambda (record) (put (get (get record :execution) :setupReplacement) :originalCaseTimeouts (js-array 30001))))))
        (let ((index 0))
          (while (< index (js-length changes))
            (let ((document (await (original-document))))
              (funcall (aref changes index) (aref (get document :records) 1))
              (await (js-call assert :rejects (transportOriginalStdlibBitCorpus document (js-object :sourceRoot root)) globalThis.TypeError)))
            (setq index (1+ index)))))
      (let ((document (await (original-document))))
        (js-call (get document :records) :push (globalThis.structuredClone (aref (get document :records) 1)))
        (await (js-call assert :rejects (transportOriginalStdlibBitCorpus document (js-object :sourceRoot root)) globalThis.TypeError)))
      (let* ((document (await (original-document)))
             (original (globalThis.structuredClone (aref (get document :records) 1))))
        (await (transportOriginalStdlibBitCorpus document (js-object :sourceRoot root)))
        (put (get document :records) 1 original)
        (put (aref (get document :evidence) 0) :sha256 (js-call "0" :repeat 64))
        (await (js-call assert :rejects (transportOriginalStdlibBitCorpus document (js-object :sourceRoot root)) globalThis.TypeError)))
      (let* ((document (await (original-document)))
             (original (globalThis.structuredClone (aref (get document :records) 1))))
        (await (transportOriginalStdlibBitCorpus document (js-object :sourceRoot root)))
        (put (get document :records) 1 original)
        (let* ((host "tools/testing/stdlib-bit-corpus-host.mjs")
               (asset (js-call (get document :evidence) :find (lambda (item) (= (get item :file) host))))
               (changed (js-call Buffer :concat (js-array (js-call Buffer :from (get asset :content) "base64")
                          (js-call Buffer :from "\n")))))
          (put asset :content (js-call changed :toString "base64"))
          (put asset :bytes (js-length changed))
          (put asset :sha256 (hash changed))
          (await (js-call assert :rejects (transportOriginalStdlibBitCorpus document (js-object :sourceRoot root))
            (lambda (error)
              (and (js-call globalThis.TypeError (get globalThis.Symbol :hasInstance) error)
                   (= (get error :message) (str "original complete bit asset identity changed: " host))))))))
      (let ((document (js-object :records (js-array (js-object :id "unrelated")) :evidence (js-array))))
        (js-call assert :strictEqual (await (transportOriginalStdlibBitCorpus document (js-object :sourceRoot root))) document))))
)
