(module tests.retained-soak-refresh-install
  (import "bun:test" :as framework)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "../../tools/backends/build.mjs" root)
  (import "./direct-wasm-registration.mjs" createDirectWasmRegistration)
  (import "./retained-refresh.mjs" runFreshSoakCase)
  (defconst original (Object/assign (js-object) framework))
  (js-call assert :strictEqual (js-call (js-call (createHash "sha256") :update
    (readFileSync (resolve root "tests/retained-soak-refresh-test-ground.mjs"))) :digest "hex")
    "c5ca16412ed1f14460b46d5f782ca77594730331577079218aa248f028f25eea")
  (defconst registration (createDirectWasmRegistration original (js-object
    "fresh strict soak acceptance remains accepted when deferral is explicitly enabled" runFreshSoakCase)))
  (defvar restored false)
  (defun restore () (unless restored
    (js-call (get original :mock) :module "bun:test" (lambda () original)) (setq restored t)))
  (js-call original :beforeAll (lambda () (try (js-call registration :complete) (finally (restore)))))
  (js-call original :afterAll restore)
  (js-call (get original :mock) :module "bun:test" (lambda () (get registration :exports))))
