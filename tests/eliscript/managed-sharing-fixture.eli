(module tests.managed-sharing-fixture
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:url" pathToFileURL)
  (import "node:path" resolve)
  (import "../tools/testing/managed-sharing-fixture.mjs" managedSharingFixtureSource adaptManagedSharingCompiler managedSharingNodeArguments)
  (test "authenticated sharing Node oracle retains its exact original script while the actual module hook supplies package resolution"
    (lambda ()
      (let* ((source (readFileSync "tests/wasm-managed-project-sharing.test.mjs" "utf8"))
             (boundary (js-call source :indexOf "const oracle=spawnSync('node',['--input-type=module','-e',"))
             (start (js-call source :indexOf "\"" boundary))
             (end (js-call source :indexOf "\"]," start))
             (script (JSON/parse (js-call source :slice start (1+ end))))
             (arguments (Object/freeze (js-array "--input-type=module" "-e" script)))
             (actual (managedSharingNodeArguments "node" arguments)))
        (js-call assert :ok (>= boundary 0)) (js-call assert :ok (> end start))
        (js-call assert :deepStrictEqual actual
          (js-array "--import" (resolve "tests/helpers/managed-reference-node.mjs") "--input-type=module" "-e" script))
        (js-call assert :strictEqual (aref actual 4) script)
        (js-call assert :strictEqual (managedSharingNodeArguments "bun" arguments) arguments)
        (let ((unrelated (js-array "--version")))
          (js-call assert :strictEqual (managedSharingNodeArguments "node" unrelated) unrelated)))))
  (import "../tools/compiler/controlled-baseline.mjs" definition)
  (test "sharing fixture includes both actual production dependencies while preserving unrelated compiler calls and method identities" (lambda ()
    (let* ((source (readFileSync "bootstrap/backends/managed.eli" "utf8"))
           (directory (resolve ".eliscript-cache/sharing-fixture-source-proof"))
           (url (get (pathToFileURL (resolve directory "backends/numeric.mjs")) :href))
           (before (managedSharingFixtureSource source url false))
           (after (managedSharingFixtureSource source url t))
           (calls (js-array)) (marker (js-object))
           (compiler (js-object :compile_string (lambda (&rest arguments) (js-call calls :push arguments) marker)
             :compile_ir_string (lambda () marker)))
           (adapted (adaptManagedSharingCompiler compiler directory)))
      (js-call assert :strictEqual (js-call adapted :compile_string before "managed-guard-sharing.eli") marker)
      (js-call assert :deepStrictEqual (js-call calls :pop) (js-array after "managed-guard-sharing.eli"))
      (js-call (js-array "managed-source-root" "finish-managed-bindings-core") :forEach (lambda (name)
        (js-call assert :ok (js-call after :includes (definition source (str name " "))))))
      (js-call assert :throws (lambda () (js-call adapted :compile_string (+ before " ") "managed-guard-sharing.eli")))
      (js-call assert :strictEqual (js-call adapted :compile_string "ordinary" "ordinary.eli" marker) marker)
      (js-call assert :deepStrictEqual (js-call calls :pop) (js-array "ordinary" "ordinary.eli" marker))
      (js-call assert :strictEqual (get adapted :compile_ir_string) (get compiler :compile_ir_string)))))
)
