(module tests.repository-integrity
  (import "bun:test" test expect)
  (import "node:fs/promises" mkdtemp mkdir readFile writeFile rm rename)
  (import "node:path" :default path)
  (import "node:os" tmpdir)
  (import "../dist/bootstrap/compiler.mjs" :as compiler)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/integrity/check.mjs" checkGeneratedMarkerCoverage checkGeneratedArtifacts
    RepositoryIntegrityError repositoryTrackedFiles)
  (import "../tools/integrity/check-legacy.mjs" :as legacy)

  (defconst ROOT root)
  (defconst marker "// Generated by Eliscript. Do not edit.")
  (defasync git (directory &rest arguments)
    (let* ((child (js-call globalThis.Bun :spawn (js-call (js-array "git") :concat arguments)
                    (js-object :cwd directory :stdout "pipe" :stderr "pipe")))
           (results (await (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text)
             (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (unless (= (aref results 0) 0) (throw (new globalThis.Error (aref results 2))))
      (aref results 1)))

  (defasync fixture ()
    (let* ((directory (await (mkdtemp (js-call path :join (tmpdir) "eliscript-integrity-storage-"))))
           (source "(defconst value -0) (defun read () value) (export read)")
           (source-path (js-call path :join directory "source.eli"))
           (output "tests/snapshots/core.mjs") (source-map (+ output ".map"))
           (output-path (js-call path :join directory output))
           (map-path (js-call path :join directory source-map))
           (contract (JSON/parse (await (readFile (js-call path :join ROOT "contracts/repository-integrity.json") "utf8")))))
      (try
        (await (mkdir (js-call path :dirname output-path) (js-object :recursive t)))
        (await (writeFile source-path source))
        (await (writeFile (js-call path :join directory ".gitignore") (+ output "\n" source-map "\n")))
        (await (git directory "init" "--quiet"))
        (await (git directory "add" "--" "source.eli" ".gitignore"))
        (let* ((emission (js-call compiler :compile_string_with_source_map source source-path
                           "core.mjs" "../../source.eli"))
               (javascript (+ (get emission :javascript) "//# sourceMappingURL=core.mjs.map\n")))
          (await (writeFile output-path javascript))
          (await (writeFile map-path (get emission :sourceMap)))
          (put (get contract :artifacts) :deterministic
            (js-array (js-object :source "source.eli" :output output :sourceMap source-map)))
          (js-object :directory directory :contract contract :output output :sourceMap source-map
            :javascript javascript :map (get emission :sourceMap)))
        (catch error (await (rm directory (js-object :recursive t :force t))) (throw error)))))

  (test "generated marker coverage accepts real ignored untracked files and retains the original public validation identities"
    (async ()
      (let* ((state (await (fixture))) (directory (get state :directory)))
        (try
          (let ((tracked (await (repositoryTrackedFiles directory))))
            (js-call (expect tracked) :toEqual (js-array ".gitignore" "source.eli"))
            (js-call (expect (await (checkGeneratedMarkerCoverage directory tracked (get state :contract))))
              :toEqual (js-array (get state :output)))
            (js-call (expect RepositoryIntegrityError) :toBe (get legacy :RepositoryIntegrityError)))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "generated registry coverage still detects omitted ignored outputs and a missing generated marker"
    (async ()
      (let* ((state (await (fixture))) (directory (get state :directory)))
        (try
          (let* ((tracked (await (repositoryTrackedFiles directory)))
                 (missing (globalThis.structuredClone (get state :contract))))
            (put (get missing :artifacts) :deterministic (js-array))
            (await (js-call (get (expect (checkGeneratedMarkerCoverage directory tracked missing)) :rejects) :toThrow
              "markers differ from the artifact registry"))
            (await (writeFile (js-call path :join directory (get state :output)) ""))
            (await (js-call (get (expect (checkGeneratedMarkerCoverage directory tracked (get state :contract))) :rejects)
              :toThrow "markers differ from the artifact registry")))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "real Git ignore policy transports exact output and map paths through NUL stdin without quoting or newline splitting"
    (async ()
      (let* ((state (await (fixture))) (directory (get state :directory))
             (output "tests/snapshots/-quoted \"name\"\nnext.mjs") (source-map (+ output ".map"))
             (contract (get state :contract))
             (artifact (aref (get (get contract :artifacts) :deterministic) 0)))
        (try
          (await (rename (js-call path :join directory (get state :output)) (js-call path :join directory output)))
          (await (rename (js-call path :join directory (get state :sourceMap)) (js-call path :join directory source-map)))
          (put artifact :output output) (put artifact :sourceMap source-map)
          (await (writeFile (js-call path :join directory ".gitignore")
            "/tests/snapshots/*.mjs\n/tests/snapshots/*.mjs.map\n"))
          (let ((tracked (await (repositoryTrackedFiles directory))))
            (js-call (expect (await (checkGeneratedMarkerCoverage directory tracked contract))) :toEqual (js-array output))
            (let ((invalid (globalThis.structuredClone contract)))
              (put (aref (get (get invalid :artifacts) :deterministic) 0) :output (+ output "\u0000other.mjs"))
              (await (js-call (get (expect (checkGeneratedMarkerCoverage directory tracked invalid)) :rejects)
                :toThrow "generated artifact output must be a safe path")))
            (await (writeFile (js-call path :join directory ".gitignore") "/tests/snapshots/*.mjs\n"))
            (await (js-call (get (expect (checkGeneratedMarkerCoverage directory tracked contract)) :rejects)
              :toThrow (+ "generated artifact output must be ignored: " source-map))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "generated storage refuses tracked outputs maps untracked source and an absent ignore policy"
    (async ()
      (let* ((state (await (fixture))) (directory (get state :directory)))
        (try
          (await (git directory "add" "--force" "--" (get state :output)))
          (await (js-call (get (expect (checkGeneratedMarkerCoverage directory
            (await (repositoryTrackedFiles directory)) (get state :contract))) :rejects) :toThrow "must not be tracked"))
          (await (git directory "rm" "--cached" "--" (get state :output)))
          (await (git directory "add" "--force" "--" (get state :sourceMap)))
          (await (js-call (get (expect (checkGeneratedMarkerCoverage directory
            (await (repositoryTrackedFiles directory)) (get state :contract))) :rejects) :toThrow "must not be tracked"))
          (await (git directory "rm" "--cached" "--" (get state :sourceMap)))
          (await (git directory "rm" "--cached" "--" "source.eli"))
          (await (js-call (get (expect (checkGeneratedMarkerCoverage directory
            (await (repositoryTrackedFiles directory)) (get state :contract))) :rejects) :toThrow "source must be tracked"))
          (await (git directory "add" "--" "source.eli"))
          (await (writeFile (js-call path :join directory ".gitignore") ""))
          (await (js-call (get (expect (checkGeneratedMarkerCoverage directory
            (await (repositoryTrackedFiles directory)) (get state :contract))) :rejects) :toThrow "must be ignored"))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (test "ignored output storage keeps exact regenerated JavaScript and map byte checks before derived or performance gates"
    (async ()
      (let* ((state (await (fixture))) (directory (get state :directory))
             (options (js-object :root directory :contract (get state :contract)
                        :compiler compiler :deferPerformanceAcceptance t)))
        (try
          (await (writeFile (js-call path :join directory (get state :output))
            (+ (get state :javascript) "\n")))
          (await (js-call (get (expect (checkGeneratedArtifacts options)) :rejects) :toThrow
            (+ (get state :output) " is stale")))
          (await (writeFile (js-call path :join directory (get state :output)) (get state :javascript)))
          (await (writeFile (js-call path :join directory (get state :sourceMap)) (+ (get state :map) "\n")))
          (await (js-call (get (expect (checkGeneratedArtifacts options)) :rejects) :toThrow
            (+ (get state :sourceMap) " is stale")))
          (await (rm (js-call path :join directory (get state :output))))
          (await (js-call (get (expect (checkGeneratedArtifacts options)) :rejects) :toMatchObject
            (js-object :code "ENOENT")))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
)
