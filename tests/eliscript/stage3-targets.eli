(module tests.stage3-targets
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp mkdir readFile writeFile rm realpath lstat)
  (import "node:child_process" spawnSync)
  (import "node:path" resolve dirname relative)
  (import "node:os" tmpdir)
  (import "node:module" createRequire)
  (import "../tools/backends/build.mjs" root buildBackends)
  (import "../tools/backends/compiler-build.mjs" buildIndependentCompiler writeCompilerMetadata independentCompilerResources)
  (import "../tools/backends/compiler-corpus-execution.mjs" compilerCorpusRuntimeAcceptance)
  (import "../tools/backends/compiler-bootstrap.mjs" compilerSourceIdentity compilerDigest)
  (import "../tools/backends/compiler-metadata.mjs" readCompilerMetadata)
  (import "../tools/backends/compiler-session.mjs" encodeCompilerIR)
  (import "../tools/backends/compiler-matrix.mjs" loadCompilerMatrixCorpus classifyStage3Corpus)
  (import "../tools/backends/dist/bootstrap-js-stages.mjs" compareJsFixedPoint)
  (import "../tools/backends/dist/release-cli.mjs" runReleaseCLI)
  (import "../tools/backends/stage3-targets.mjs"
    authenticateStage3Targets runStage3Targets run-stage3-target-schedule)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../dist/bootstrap/compiler.mjs"
    compile-ir-string emit-ir-string emit-ir-string-with-source-map serialize-ir-program)

  (defconst targets (js-array "javascript" "wasm" "native"))
  (defasync workspace (run)
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-stage3-targets-")))))
      (try (await (funcall run directory))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defun type-error-p (error) (js-call globalThis.TypeError.prototype :isPrototypeOf error))
  (defun sequence-resource-record ()
    (js-object :id "original-managed:sequence-data:node:auto-65536" :kind "project"
      :entry "sequence-data.mjs" :auto 65536 :memory (js-object :initialPages 128 :maximumPages 4096)
      :modules (js-array (js-object :id "sequence-data.mjs" :source "(defun result () -0) (export result)"))
      :request (js-object :operation "project" :phased t)
      :execution (js-object :kind "original-program" :hostSource "unchanged original host bytes"
        :runtimeOptions (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216))
      :expected (js-object :kind "seed-program" :oracleRequired t)
      :original (js-object :suite "tests/wasm-managed-sequence-data.test.mjs"
        :fixture "tests/fixtures/wasm-managed-sequence-data.eli")))

  (test "explicit sequence functional resources preserve raw records and distinguish function acceptance from the original capacity failure"
    (lambda ()
      (let* ((record (sequence-resource-record)) (before (globalThis.structuredClone record))
             (wire (JSON/stringify record)) (resources (independentCompilerResources (js-object :profile "small")))
             (options (js-object :functionalRuntimeProfile "small"))
             (acceptance (compilerCorpusRuntimeAcceptance record options)))
        (js-call assert :strictEqual (compilerCorpusRuntimeAcceptance record (js-object)) undefined)
        (js-call assert :strictEqual (get acceptance :functionalRuntimeProfile) "small")
        (js-call assert :strictEqual (get acceptance :resourceAcceptance) "deferred")
        (js-call assert :deepStrictEqual (get acceptance :originalRuntimeOptions)
          (Object/assign (js-object) (get (get record :execution) :runtimeOptions) (js-object :auto 65536)))
        (js-call assert :deepStrictEqual (get acceptance :effectiveRuntimeOptions)
          (Object/assign (js-object) (get resources :budget) (js-object :auto 65536)))
        (js-call assert :deepStrictEqual record before)
        (js-call assert :strictEqual (JSON/stringify record) wire)
        (put (get acceptance :effectiveRuntimeOptions) :maxSlots 1)
        (js-call assert :strictEqual (get (get (compilerCorpusRuntimeAcceptance record options) :effectiveRuntimeOptions) :maxSlots)
          (get (get resources :budget) :maxSlots))
        (js-call assert :strictEqual (Object/hasOwn acceptance "verification") false))))

  (test "functional resources cannot override diagnostic capacity recovery other-suite or unbound records and reject unknown profiles"
    (lambda ()
      (let ((changes (js-array
              (lambda (record) (put record :kind "sequence"))
              (lambda (record) (put record :error (js-object :code "ELI-RT0002")))
              (lambda (record) (put record :id "original-managed:sequence-data-capacity-recovery:node:auto-65536"))
              (lambda (record) (put (get record :expected) :kind "diagnostic"))
              (lambda (record) (put (get record :execution) :kind "exports"))
              (lambda (record) (put (get record :original) :fixture "tests/fixtures/other.eli"))
              (lambda (record) (put record :id "original-managed:other:node:auto-65536")))) (index 0))
        (while (< index (js-length changes))
          (let ((record (sequence-resource-record)))
            (funcall (aref changes index) record)
            (js-call assert :strictEqual (compilerCorpusRuntimeAcceptance record (js-object :functionalRuntimeProfile "small")) undefined))
          (setq index (1+ index)))
        (js-call (js-array nil false "full-compiler" "unknown") :forEach (lambda (profile)
          (js-call assert :throws (lambda () (compilerCorpusRuntimeAcceptance (sequence-resource-record)
            (js-object :functionalRuntimeProfile profile))) type-error-p))))))
  (defun captured-ir (id filename source revision)
    (let ((program (compile-ir-string source filename)))
      (js-object :id id :filename filename :revision revision :stage "frontend"
        :ir (encodeCompilerIR program) :canonicalIR (serialize-ir-program program))))

  (defasync identity-fixture (directory &rest no-execution)
    ;; Real emitted files and real byte comparison exercise authentication.
    ;; This small protocol is not the formal compiler or a bootstrap proof.
    (let* ((ordinary-source (js-call (js-array
             "(module fixture.stage3-identity"
             " (defun compiler_session_new () (js-object))"
             " (defun compiler_session_request (state text) text)"
             " (defun compiler_session_close (state) t)"
             " (export compiler_session_new compiler_session_request compiler_session_close))") :join "\n"))
           (source (if (and (> (js-length no-execution) 0) (eq (aref no-execution 0) t))
                     (str ordinary-source "\n(throw (new globalThis.Error \"verification must never execute the compiler product\"))") ordinary-source))
           (runtime-source "(module fixture.runtime)")
           (sources (js-object :entry "driver.mjs"
             :modules (js-array (js-object :id "driver.mjs" :filename "driver.eli" :source source))
             :runtime (js-object :filename "runtime.eli" :source runtime-source) :literalSources (js-array)))
           (identity (compilerSourceIdentity sources))
           (emission (emit-ir-string-with-source-map (compile-ir-string source "driver.eli") source "driver.mjs" "driver.eli"))
           (runtime-ir (captured-ir "runtime" "runtime.eli" runtime-source 1))
           (module-ir (captured-ir "driver.mjs" "driver.eli" source 1))
           (producer (js-object :host "javascript" :request (lambda (request)
             (cond ((= (get request :operation) "runtime") (js-object :revision 1 :literalRevision 0))
               ((= (get request :operation) "cached-ir")
                 (if (= (get request :kind) "runtime") runtime-ir module-ir))
               ((= (get request :operation) "project")
                 (js-object :target "javascript" :entry "driver.mjs" :revision 1 :modules
                   (js-array (js-object :id "driver.mjs" :javascript (get emission :javascript)
                     :sourceMap (get emission :sourceMap) :macroOrigins (js-array)))))
               (t (throw (new globalThis.Error "identity fixture cannot execute an unrequested compiler operation")))))))
           (stage2 (await (buildIndependentCompiler (js-object :host "javascript" :sources sources
             :session producer :retainIR t :debug t :outputRoot (resolve directory "stage2")))))
           (stage3 (await (buildIndependentCompiler (js-object :host "javascript" :sources sources
             :session producer :retainIR t :debug t :outputRoot (resolve directory "stage3")))))
           (comparison (await (compareJsFixedPoint (js-object :stage2 (get stage2 :metadataPath)
                           :stage3 (get stage3 :metadataPath) :sourceIdentity identity))))
           (manifest-path (resolve directory "bootstrap.json"))
           (comparison-path (resolve directory "fixed-point.json"))
           (manifest (js-object :format "eliscript-js-bootstrap" :version 1 :status "accepted"
             :seedSourceIdentity identity :formalSourceIdentity identity
             :stages (js-call (js-array 0 1 2 3) :map (lambda (stage)
               (let ((artifact (if (= stage 3) stage3 stage2)))
                 (js-object :stage stage :host "javascript" :target "javascript"
                   :producer (if (= stage 0) "emacs-lisp" (+ "stage" (1- stage)))
                   :status "built" :metadataPath (relative directory (get artifact :metadataPath))
                   :inputIdentity identity :productIdentity (get artifact :productIdentity)))))
             :fixedPoint (js-object :from 2 :to 3 :status "identical" :comparisonPath "fixed-point.json")
             :finalAcceptance (js-object :status "pending" :targets targets))))
      (await (writeCompilerMetadata comparison-path comparison))
      (await (writeCompilerMetadata manifest-path manifest))
      (js-object :stage2 stage2 :stage3 stage3 :manifest manifest :manifestPath manifest-path
        :comparison comparison :comparisonPath comparison-path :sourceIdentity identity)))

  (test "stage3 authentication derives the exact final JS artifact from a real fixed-point comparison without requiring a corpus or binary compiler host"
    (async ()
      (await (workspace (async (directory)
        (let* ((fixture (await (identity-fixture directory)))
               (options (js-object :bootstrapManifestPath (get fixture :manifestPath)))
               (actual (await (authenticateStage3Targets options)))
               (stage3 (get fixture :stage3)))
          (js-call assert :strictEqual (get actual :scope) "stage3-identity")
          (js-call assert :strictEqual (get actual :verification) "authenticated")
          (js-call assert :strictEqual (get actual :stage3MetadataPath) (await (realpath (get stage3 :metadataPath))))
          (js-call assert :strictEqual (get actual :bootstrapManifestPath) (await (realpath (get fixture :manifestPath))))
          (js-call assert :deepStrictEqual (get actual :sourceIdentity) (get fixture :sourceIdentity))
          (js-call assert :deepStrictEqual (get actual :productIdentity) (get stage3 :productIdentity))
          (js-call assert :strictEqual (get actual :stage2MetadataPath)
            (await (realpath (get (get fixture :stage2) :metadataPath))))
          (js-call assert :deepStrictEqual (get actual :stage2ProductIdentity) (get (get fixture :stage2) :productIdentity))
          (js-call assert :strictEqual (get actual :fixedPointFileCount) (js-length (get (get fixture :comparison) :files)))
          (js-call assert :strictEqual (Object/hasOwn actual "targets") false)
          (js-call assert :strictEqual (Object/hasOwn actual "passed") false)
          (js-call assert :deepStrictEqual (await (authenticateStage3Targets (Object/assign (js-object) options
            (js-object :stage3MetadataPath (get stage3 :metadataPath))))) actual)
          ;; Equal files do not make stage2 the designated final stage3.
          (await (js-call assert :rejects (authenticateStage3Targets (Object/assign (js-object) options
            (js-object :stage3MetadataPath (get (get fixture :stage2) :metadataPath))))))))))))

  (defun verify-bootstrap-child (manifest)
    (spawnSync (get globalThis.process :execPath)
      (js-array (resolve root "tools/backends/dist/release-cli.mjs") "verify-bootstrap"
        "--bootstrap-manifest" manifest "--json-errors")
      (js-object :cwd root :encoding "utf8" :env (get globalThis.process :env))))
  (defun rejected-bootstrap-child (manifest)
    (let ((child (verify-bootstrap-child manifest)))
      (js-call assert :strictEqual (get child :error) undefined)
      (js-call assert :strictEqual (get child :signal) nil)
      (js-call assert :strictEqual (get child :status) 1)
      (js-call assert :strictEqual (get child :stdout) "")
      (js-call assert :strictEqual (get (JSON/parse (get child :stderr)) :format) "eliscript-compiler-cli-error")))
  (defasync bootstrap-read-only-snapshot (fixture)
    (let ((files (js-array (get fixture :manifestPath) (get fixture :comparisonPath))) (out (js-array)))
      (js-call (js-array (get fixture :stage2) (get fixture :stage3)) :forEach (lambda (artifact)
        (js-call files :push (get artifact :metadataPath))
        (js-call (get (get fixture :comparison) :files) :forEach (lambda (file)
          (js-call files :push (resolve (get artifact :directory) (get file :path)))))))
      (let ((index 0))
        (while (< index (js-length files))
          (let* ((path (aref files index)) (bytes (await (readFile path))) (details (await (lstat path))))
            (js-call out :push (js-object :path path :bytes bytes :mtimeMs (get details :mtimeMs))))
          (setq index (1+ index)))) out))

  (test "verify-bootstrap rechecks complete real products without loading the compiler or writing any artifact"
    (async ()
      (await (workspace (async (directory)
        (let* ((fixture (await (identity-fixture directory t))) (path (get fixture :manifestPath))
               (before (await (bootstrap-read-only-snapshot fixture))) (lines (js-array))
               (report (await (runReleaseCLI (js-array "verify-bootstrap" "--bootstrap-manifest" path)
                         (js-object :write (lambda (text) (js-call lines :push text))))))
               (stage2 (get fixture :stage2)) (stage3 (get fixture :stage3))
               (identity (get fixture :sourceIdentity))
               (expected (js-object :format "eliscript-bootstrap-verification" :version 1
                 :scope "stage2-stage3-complete-products" :verification "identical"
                 :bootstrapManifestPath (await (realpath path))
                 :fileCount (js-length (get (get fixture :comparison) :files))
                 :stage2 (js-object :stage 2 :metadataPath (await (realpath (get stage2 :metadataPath)))
                   :productSha256 (get (get stage2 :productIdentity) :sha256))
                 :stage3 (js-object :stage 3 :metadataPath (await (realpath (get stage3 :metadataPath)))
                   :productSha256 (get (get stage3 :productIdentity) :sha256))
                 :sourceIdentity (js-object :entry (get identity :entry) :encoding (get identity :encoding)
                   :sha256 (get identity :sha256)))))
          (js-call assert :deepStrictEqual report expected)
          (js-call assert :deepStrictEqual (JSON/parse (js-call lines :join "")) expected)
          (js-call assert :strictEqual (js-length lines) 1)
          (let ((child (verify-bootstrap-child path)))
            (js-call assert :strictEqual (get child :status) 0 (get child :stderr))
            (js-call assert :strictEqual (get child :signal) nil)
            (js-call assert :strictEqual (get child :stderr) "")
            (js-call assert :deepStrictEqual (JSON/parse (get child :stdout)) expected))
          (js-call assert :deepStrictEqual (await (bootstrap-read-only-snapshot fixture)) before)
          (await (js-call assert :rejects (runReleaseCLI
            (js-array "verify-bootstrap" "--bootstrap-manifest" path "--output" (resolve directory "must-not-write")))))
          (await (js-call assert :rejects (lstat (resolve directory "must-not-write")))))
        )))))

  (test "verify-bootstrap rejects missing files one changed byte extra product files and a changed receipt"
    (async ()
      (await (workspace (async (directory)
        (let* ((fixture (await (identity-fixture directory))) (manifest (get fixture :manifestPath))
               (artifact (get fixture :stage3)) (path (get artifact :path))
               (before (await (readFile path))) (extra (resolve (get artifact :directory) "undeclared-product.txt")))
          (rejected-bootstrap-child (resolve directory "missing-bootstrap.json"))
          (try
            (progn
              (await (rm path)) (rejected-bootstrap-child manifest))
            (finally (await (writeFile path before))))
          (try
            (let ((changed (globalThis.Uint8Array.from before)))
              (put changed 0 (bit-xor (aref changed 0) 1))
              (await (writeFile path changed)) (rejected-bootstrap-child manifest))
            (finally (await (writeFile path before))))
          (try
            (progn (await (writeFile extra "retained unexpected product bytes\n")) (rejected-bootstrap-child manifest))
            (finally (await (rm extra))))
          (let ((receipt-path (get fixture :comparisonPath)) (receipt (get fixture :comparison)))
            (try
              (let ((forged (globalThis.structuredClone receipt)))
                (put forged :files (js-array)) (await (writeCompilerMetadata receipt-path forged))
                (rejected-bootstrap-child manifest))
              (finally (await (writeCompilerMetadata receipt-path receipt)))))
        ))))))

  (test "stage3 authentication rejects forged fixed points wrong stages altered files and changed source identities before dispatch"
    (async ()
      (await (workspace (async (directory)
        (let* ((fixture (await (identity-fixture directory))) (path (get fixture :manifestPath))
               (original (get fixture :manifest)) (comparison (get fixture :comparison))
               (changes (js-array
                 (lambda (value) (put value :status "building"))
                 (lambda (value) (put (get value :fixedPoint) :status "pending"))
                 (lambda (value) (put (get value :fixedPoint) :from 1))
                 (lambda (value) (put (aref (get value :stages) 3) :host "wasm"))
                 (lambda (value) (put (aref (get value :stages) 3) :producer "stage1"))
                 (lambda (value) (put (get (aref (get value :stages) 3) :productIdentity) :sha256 (js-call "0" :repeat 64)))
                 (lambda (value) (put (get value :formalSourceIdentity) :sha256 (js-call "0" :repeat 64)))))
               (index 0))
          (while (< index (js-length changes))
            (let ((changed (globalThis.structuredClone original)))
              (funcall (aref changes index) changed)
              (await (writeCompilerMetadata path changed))
              (await (js-call assert :rejects (authenticateStage3Targets (js-object :bootstrapManifestPath path))))
              (rejected-bootstrap-child path))
            (setq index (1+ index)))
          (await (writeCompilerMetadata path original))
          (let ((forged (globalThis.structuredClone comparison)))
            (put forged :files (js-array))
            (await (writeCompilerMetadata (get fixture :comparisonPath) forged))
            (await (js-call assert :rejects (authenticateStage3Targets (js-object :bootstrapManifestPath path))))
            (rejected-bootstrap-child path))
          (await (writeCompilerMetadata (get fixture :comparisonPath) comparison))
          (let* ((stage3 (get fixture :stage3))
                 (files (js-array (get stage3 :path) (get (aref (get stage3 :modules) 0) :sourceMapPath)
                                 (get (aref (get stage3 :frontendIR) 0) :canonicalPath)))
                 (index 0))
            (while (< index (js-length files))
              (let* ((file (aref files index)) (before (await (readFile file))))
                (try
                  (progn
                    (await (writeFile file (globalThis.Uint8Array.of 0)))
                    (await (js-call assert :rejects (authenticateStage3Targets (js-object :bootstrapManifestPath path))))
                    (rejected-bootstrap-child path))
                  (finally (await (writeFile file before)))))
              (setq index (1+ index))))))))))

  (test "the official final-target entry refuses caller-provided producers fixtures and comparison replacements"
    (async ()
      (let ((fields (js-array "host" "target" "producer" "producers" "compilerArtifact"
                     "runCell" "execute" "compare" "corpusRecords" "originalOracle" "programCache" "seedOracleCache" "parallelTargets")) (index 0))
        (while (< index (js-length fields))
          (let ((options (js-object :bootstrapManifestPath "must-not-read.json" :outputRoot "must-not-write")))
            (put options (aref fields index) (lambda () (throw false)))
            (await (js-call assert :rejects (runStage3Targets options) type-error-p)))
          (setq index (1+ index))))))

  (test "the three-target schedule captures one final producer and one complete frozen original corpus for every target"
    (async ()
      (await (workspace (async (directory)
        (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
               (path (resolve directory "corpus.json")) (seen (js-array))
               (options (js-object :stage3MetadataPath (resolve directory "stage3/compiler-artifact.json")
                 :corpusRecordsPath path :outputRoot directory :sourceRoot root :nativeTarget "arm64-macos"
                 :functionalRuntimeProfile "small"))
               (producer (get options :stage3MetadataPath)))
          (await (writeFile path (get corpus :recordsBytes)))
          (let* ((expected-bytes (await (readFile path)))
                 (result (await (run-stage3-target-schedule options (async (call)
                   (js-call seen :push call)
                   (js-call assert :strictEqual (get call :host) "javascript")
                   (js-call assert :strictEqual (get call :metadataPath) producer)
                   (js-call assert :strictEqual (get call :corpusRecordsPath) path)
                   (js-call assert :strictEqual (get call :functionalRuntimeProfile) "small")
                   (js-call assert :strictEqual (compilerDigest (await (readFile path))) (get corpus :recordsSha256))
                   (js-call assert :ok (>= (js-length (get corpus :records)) 794))
                   (put options :stage3MetadataPath "forged-stage1.json")
                   (put options :corpusRecordsPath "different-fixture.json")
                   (js-object :directory (resolve directory (get call :target))
                     :metadata (js-object :verification "equivalent" :status "consistent" :resourceAcceptance "deferred"
                       :resourceOutcomes (js-array (Object/assign (js-object :id "original-managed:sequence-data:node:auto-65536")
                         (compilerCorpusRuntimeAcceptance (sequence-resource-record) (js-object :functionalRuntimeProfile "small")))))))))))
            (js-call assert :deepStrictEqual (js-call seen :map (lambda (call) (get call :target))) targets)
            (js-call assert :strictEqual (get (new globalThis.Set (js-call seen :map
              (lambda (call) (get call :outputRoot)))) :size) 3)
            (js-call assert :strictEqual (get result :scope) "target-schedule")
            (js-call assert :strictEqual (get result :verification) "unverified")
            (js-call assert :strictEqual (get result :status) "completed")
            (js-call assert :strictEqual (get result :hasFailure) false)
            (js-call (get result :targets) :forEach (lambda (entry)
              (js-call assert :strictEqual (get entry :status) "passed")
              (js-call assert :strictEqual (get entry :resourceAcceptance) "deferred")
              (js-call assert :deepStrictEqual (get entry :resourceOutcomes)
                (js-array (Object/assign (js-object :id "original-managed:sequence-data:node:auto-65536")
                  (compilerCorpusRuntimeAcceptance (sequence-resource-record) (js-object :functionalRuntimeProfile "small")))))))
            (js-call assert :deepStrictEqual (await (readFile path)) expected-bytes))))))))

  (test "independent target failures are all retained without replacing false or undefined first errors or certifying partial success"
    (async ()
      (let* ((seen (js-array))
             (result (await (run-stage3-target-schedule
               (js-object :stage3MetadataPath "stage3.json" :corpusRecordsPath "same-corpus.json" :outputRoot "targets")
               (async (call)
                 (js-call seen :push (get call :target))
                 (cond ((= (get call :target) "javascript") (throw false))
                       ((= (get call :target) "wasm") (throw undefined))
                       (t (js-object :directory "native" :metadata (js-object :verification "equivalent")))))))))
        (js-call assert :deepStrictEqual seen targets)
        (js-call assert :strictEqual (get result :status) "failed")
        (js-call assert :strictEqual (get result :hasFailure) t)
        (js-call assert :strictEqual (get result :failure) false)
        (js-call assert :strictEqual (get result :verification) "unverified")
        (js-call assert :strictEqual (js-length (get result :targets)) 3)
        (js-call assert :deepStrictEqual (js-call (get result :targets) :map (lambda (item) (get item :status)))
          (js-array "failed" "failed" "passed")))))

  (test "goal cancellations retain every original ID and move exact original runners and JS compiler generations to final gates"
    (async ()
      (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
             (records (get corpus :records)) (before (JSON/stringify records))
             (all (js-call records :map (lambda (record) (get record :id))))
             (javascript (classifyStage3Corpus records "javascript"))
             (runner "original-managed-suite:complete-fixture-suites")
             (generations "original-program:compiler-cli-bootstrap-generations")
             (runner-record (js-call records :find (lambda (record) (= (get record :id) runner)))))
        (js-call assert :deepStrictEqual (get javascript :completeIds) all)
        (js-call assert :deepStrictEqual (get javascript :effectiveIds)
          (js-call all :filter (lambda (id) (and (/= id runner) (/= id generations)))))
        (js-call assert :strictEqual (js-length (get javascript :cancelled)) 2)
        (js-call assert :ok (js-call (get (get runner-record :original) :suites) :some
          (lambda (suite) (= (get suite :file) "tests/direct-wasm-backend.test.mjs"))))
        (js-call assert :ok (js-call (await (readFile (resolve root "Makefile") "utf8")) :includes
          "./tests/direct-wasm-backend.test.mjs"))
        (js-call targets :forEach (lambda (target)
          (let* ((selection (classifyStage3Corpus records target))
                 (item (js-call (get selection :cancelled) :find (lambda (entry) (= (get entry :id) runner)))))
            (js-call assert :strictEqual (get item :target) target)
            (js-call assert :strictEqual (get item :status) "cancelled")
            (js-call assert :strictEqual (get item :movedTo) "original-final-functional-gates")
            (js-call assert :strictEqual (get item :gateCommand) "make test")
            (js-call assert :strictEqual (get item :gateVerification) "pending")
            (js-call assert :ok (js-call (get item :reason) :includes "original.testRunner=bun test")))))
        (js-call (js-array "wasm" "native") :forEach (lambda (target)
          (let* ((selection (classifyStage3Corpus records target))
                 (cancelled (get selection :cancelled))
                 (ids (js-call cancelled :map (lambda (item) (get item :id)))))
            (js-call assert :deepStrictEqual (get selection :completeIds) all)
            (js-call assert :strictEqual (+ (js-length cancelled) (js-length (get selection :effectiveIds))) (js-length all))
            (js-call assert :ok (js-call ids :includes "original-managed-suite:complete-fixture-suites"))
            (js-call assert :ok (js-call ids :includes "original-tools-artifact:compiler-session-tools:node"))
            (js-call cancelled :forEach (lambda (item)
              (js-call assert :strictEqual (get item :target) target)
              (js-call assert :strictEqual (get item :status) "cancelled")
              (js-call assert :ok (cond ((= (get item :id) runner)
                (js-call (get item :reason) :startsWith "moved original suite runner:"))
                ((= (get item :id) generations)
                  (js-call (get item :reason) :startsWith "moved original JS compiler generations:"))
                (t (js-call (get item :reason) :startsWith "cancelled compiler binary host:"))))
              (js-call assert :strictEqual (js-call (get selection :effectiveIds) :includes (get item :id)) false)))
            (js-call assert :deepStrictEqual (js-call (js-call (get selection :effectiveIds) :concat ids) :sort)
              (js-call (Array/from all) :sort))
            (js-call assert :strictEqual (js-length (get selection :identitySha256)) 64))))
        ;; Merely matching an ID is insufficient to cancel a normal program.
        (js-call assert :deepStrictEqual (get (classifyStage3Corpus
          (js-array (js-object :id "original-managed-suite:complete-fixture-suites" :kind "project"
            :modules (js-array (js-object :id "program.mjs")) :execution (js-object :kind "exports"))) "wasm") :cancelled) (js-array))
        (js-call assert :strictEqual (JSON/stringify records) before))))

  (test "only the exact original compiler generation contract moves to the unchanged JS final gate without dropping source coverage or user outputs"
    (async ()
      (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
             (record (js-call (get corpus :records) :find
               (lambda (item) (= (get item :id) "original-program:compiler-cli-bootstrap-generations"))))
             (before (JSON/stringify record))
             (makefile (await (readFile (resolve root "Makefile") "utf8"))))
        (js-call assert :ok record)
        (js-call assert :ok (js-call makefile :includes "./tests/bootstrap-compiler.test.mjs"))
        (js-call targets :forEach (lambda (target)
          (let* ((selection (classifyStage3Corpus (js-array record) target))
                 (item (aref (get selection :cancelled) 0)))
            (js-call assert :deepStrictEqual (get selection :completeIds) (js-array (get record :id)))
            (js-call assert :deepStrictEqual (get selection :effectiveIds) (js-array))
            (js-call assert :strictEqual (js-length (get selection :cancelled)) 1)
            (js-call assert :strictEqual (get item :id) (get record :id))
            (js-call assert :strictEqual (get item :target) target)
            (js-call assert :strictEqual (get item :status) "cancelled")
            (js-call assert :strictEqual (get item :movedTo) "original-javascript-compiler-functional-gates")
            (js-call assert :strictEqual (get item :gateCommand) "make test")
            (js-call assert :strictEqual (get item :gateFile) "tests/bootstrap-compiler.test.mjs")
            (js-call assert :strictEqual (get item :gateVerification) "pending")
            (js-call assert :deepStrictEqual (get item :coverage) (get record :coverage))
            (js-call assert :strictEqual (get item :sourceSha256) (get (get record :original) :sourceSha256)))))
        (let ((changes (js-array
                (lambda (item) (put item :id "ordinary-program:compiler-generations"))
                (lambda (item) (put (get item :execution) :kind "exports"))
                (lambda (item) (put (get item :original) :suite "tests/ordinary-user.test.mjs"))
                (lambda (item) (put (get (get item :execution) :setupReplacement) :kind "selected-user-program"))
                (lambda (item) (put (get (get item :execution) :compilerGenerations) :count 2))
                (lambda (item) (put (get (get item :execution) :compilerGenerations) :producer "seed"))
                (lambda (item) (put (get (get item :execution) :compilerGenerations) :target "javascript"))
                (lambda (item) (put (get (get item :execution) :compilerGenerations) :completeCompiler false))
                (lambda (item) (put (get (get item :execution) :compilerGenerations) :sourceMaps false))
                (lambda (item) (put (get (get item :execution) :compilerGenerations) :manifestEnvironment "OTHER"))
                (lambda (item) (put (get (get item :execution) :compilerGenerations) :manifestFormat "other"))
                (lambda (item) (put (get (get item :execution) :compilerGenerations) :manifestVersion 2))
                (lambda (item) (put (get (get item :execution) :compilerGenerations) :javascriptCompanions "seed"))
                (lambda (item) (put (get (get item :execution) :compilerGenerations) :fixedPoint "user-observation")))))
          (js-call changes :forEach (lambda (change)
            (let ((changed (globalThis.structuredClone record)))
              (funcall change changed)
              (js-call assert :deepStrictEqual (get (classifyStage3Corpus (js-array changed) "javascript") :cancelled) (js-array))
              (js-call assert :deepStrictEqual (get (classifyStage3Corpus (js-array changed) "javascript") :effectiveIds)
                (js-array (get changed :id)))))))
        (js-call targets :forEach (lambda (target)
          (let* ((ordinary (js-object :id "original-program:compiler-cli-bootstrap-generations" :kind "project"
                    :entry "user.mjs" :modules (js-array (js-object :id "user.mjs" :source "(defun compiler () 3) (export compiler)"))
                    :execution (js-object :kind "exports") :coverage (js-array "user-program")))
                 (selection (classifyStage3Corpus (js-array ordinary) target)))
            (js-call assert :deepStrictEqual (get selection :cancelled) (js-array))
            (js-call assert :deepStrictEqual (get selection :effectiveIds) (js-array (get ordinary :id))))))
        (js-call assert :strictEqual (JSON/stringify record) before))))

  (test "the complete source-debugging compiler graph keeps its five JS cases and cancels only binary compiler hosts"
    (async ()
      (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
             (record (js-call (get corpus :records) :find
               (lambda (item) (= (get item :id) "original-program:compiler-source-debugging"))))
             (execution (get record :execution)) (original (get record :original)))
        (js-call assert :strictEqual (get record :entry) "bootstrap/compiler/compiler.mjs")
        (js-call assert :strictEqual (js-length (get record :modules)) 13)
        (js-call assert :strictEqual (get execution :runtimeProfile) "compiler")
        (js-call assert :strictEqual (js-length (get original :originalAssertions)) 5)
        (js-call assert :deepStrictEqual (get (classifyStage3Corpus (js-array record) "javascript") :effectiveIds)
          (js-array (get record :id)))
        (js-call (js-array "wasm" "native") :forEach (lambda (target)
          (js-call assert :deepStrictEqual (get (classifyStage3Corpus (js-array record) target) :effectiveIds) (js-array))
          (let ((user (js-object :id (get record :id) :kind "project" :entry "user.mjs"
                        :modules (js-array (js-object :id "user.mjs" :source "(defun compiler () 3) (export compiler)"))
                        :execution (js-object :kind "exports"))))
            (js-call assert :deepStrictEqual (get (classifyStage3Corpus (js-array user) target) :cancelled) (js-array))))))))

  (test "cancellation preserves its original reason and never starts pending targets or restarts completed work"
    (async ()
      (let ((positions (js-array "before" "after-javascript")) (index 0))
        (while (< index (js-length positions))
          (let* ((position (aref positions index)) (controller (new globalThis.AbortController))
                 (reason (js-object :cancelled position)) (seen (js-array)))
            (when (= position "before") (js-call controller :abort reason))
            (let ((result (await (run-stage3-target-schedule
                    (js-object :stage3MetadataPath "stage3.json" :corpusRecordsPath "same-corpus.json"
                      :outputRoot "targets" :signal (get controller :signal))
                    (async (call)
                      (js-call seen :push (get call :target))
                      (js-call controller :abort reason)
                      (js-object :directory "javascript" :metadata (js-object :verification "equivalent")))))))
              (js-call assert :strictEqual (get result :status) "cancelled")
              (js-call assert :strictEqual (get result :failure) reason)
              (js-call assert :strictEqual (get result :verification) "unverified")
              (js-call assert :deepStrictEqual seen (if (= position "before") (js-array) (js-array "javascript")))))
          (setq index (1+ index))))))
  (defun primitive-observation (runtime value)
    (cond ((or (nullish? value) (= (value-type value) "boolean")) value)
      ((= (get value :kind) 4) (js-call runtime :readNumber value))
      ((= (get value :kind) 5) (js-call runtime :readString value))
      ((= (get value :kind) 14)
        (let ((result (js-array)) (index 0))
          (while (< index (js-call runtime :length value))
            (let ((child (js-call runtime :get value index)))
              (try (js-call result :push (primitive-observation runtime child))
                (finally (js-call runtime :release child))))
            (setq index (1+ index))) result))
      (t (js-call assert :fail "unexpected primitive target observation"))))

  (defun schedule-gate ()
    (let ((accept undefined) (reject undefined))
      (let ((promise (new globalThis.Promise (lambda (yes no) (setq accept yes reject no)))))
        (js-object :promise promise :accept accept :reject reject))))
  (defasync schedule-turns ()
    (let ((index 0))
      (while (< index 16)
        (await (Promise/resolve))
        (setq index (1+ index)))))
  (defun schedule-process-resources ()
    (js-call (js-call globalThis.process :getActiveResourcesInfo) :filter
      (lambda (name) (js-call (js-array "ProcessWrap" "Worker" "WorkerWrap") :includes name))))

  (test "parallel targets all enter the real scheduling seam before any target is released and retain deterministic result order in one process"
    (async ()
      (let* ((gates (js-call targets :map (lambda (target) (schedule-gate))))
             (seen (js-array)) (completed (js-array)) (events (js-array))
             (processes (schedule-process-resources)) (pid (get globalThis.process :pid))
             (cache (new globalThis.Map))
             (options (js-object :parallelTargets t :stage3MetadataPath "real-stage3.json"
                        :corpusRecordsPath "frozen-corpus.json" :outputRoot "parallel-targets"
                        :programCache cache :functionalRuntimeProfile "small"
                        :onStage (async (event)
                          (js-call assert :strictEqual (Object/isFrozen event) t)
                          (js-call events :push event)
                          (throw false))))
             (result undefined)
             (work (run-stage3-target-schedule options (async (call)
               (js-call assert :strictEqual (get globalThis.process :pid) pid)
               (js-call assert :strictEqual (get call :metadataPath) "real-stage3.json")
               (js-call assert :strictEqual (get call :corpusRecordsPath) "frozen-corpus.json")
               (js-call assert :strictEqual (get call :programCache) cache)
               (js-call assert :strictEqual (get call :functionalRuntimeProfile) "small")
               (let* ((target (get call :target)) (index (js-call targets :indexOf target)))
                 (js-call seen :push target)
                 (await (get (aref gates index) :promise))
                 (js-call completed :push target)
                 (js-object :directory (resolve "parallel-targets" target)
                   :metadata (js-object :verification "equivalent" :resourceAcceptance "deferred"
                     :resourceOutcomes (js-array (js-object :id target :resourceAcceptance "deferred")))))))))
        (try
          (await (schedule-turns))
          (js-call assert :deepStrictEqual seen targets)
          (js-call assert :deepStrictEqual completed (js-array))
          (js-call assert :deepStrictEqual (schedule-process-resources) processes)
          (put options :stage3MetadataPath "must-not-replace-captured-producer.json")
          (funcall (get (aref gates 2) :accept))
          (await (schedule-turns))
          (js-call assert :deepStrictEqual completed (js-array "native"))
          (funcall (get (aref gates 1) :accept))
          (await (schedule-turns))
          (js-call assert :deepStrictEqual completed (js-array "native" "wasm"))
          (finally
            (js-call gates :forEach (lambda (gate) (funcall (get gate :accept))))
            (setq result (await work))))
        (js-call assert :strictEqual (get result :status) "completed")
        (js-call assert :strictEqual (get result :hasFailure) false)
        (js-call assert :strictEqual (get result :verification) "unverified")
        (js-call assert :deepStrictEqual (js-call (get result :targets) :map (lambda (entry) (get entry :target))) targets)
        (js-call (get result :targets) :forEach (lambda (entry)
          (js-call assert :strictEqual (get entry :status) "passed")
          (js-call assert :strictEqual (get entry :resourceAcceptance) "deferred")
          (js-call assert :strictEqual (js-length (get entry :resourceOutcomes)) 1)))
        (js-call assert :strictEqual (js-length (js-call events :filter (lambda (event) (= (get event :phase) "target-complete")))) 3)
        (js-call assert :deepStrictEqual (schedule-process-resources) processes))))

  (test "parallel target failures preserve the first temporal rejection including false and undefined while retaining all independent outcomes"
    (async ()
      (let ((errors (js-array false undefined (js-object :first "wasm"))) (index 0))
        (while (< index (js-length errors))
          (let* ((first (aref errors index)) (later (js-object :later "javascript"))
                 (gates (js-call targets :map (lambda (target) (schedule-gate))))
                 (started (js-array)) (result undefined)
                 (work (run-stage3-target-schedule
                   (js-object :parallelTargets t :stage3MetadataPath "stage3.json"
                     :corpusRecordsPath "same.json" :outputRoot "parallel-failures")
                   (async (call)
                     (let ((position (js-call targets :indexOf (get call :target))))
                       (js-call started :push (get call :target))
                       (await (get (aref gates position) :promise)))))))
            (try
              (await (schedule-turns))
              (js-call assert :deepStrictEqual started targets)
              (funcall (get (aref gates 1) :reject) first)
              (await (schedule-turns))
              (funcall (get (aref gates 0) :reject) later)
              (finally
                (funcall (get (aref gates 0) :accept) (js-object :directory "javascript" :metadata (js-object :verification "equivalent")))
                (funcall (get (aref gates 1) :accept) (js-object :directory "wasm" :metadata (js-object :verification "equivalent")))
                (funcall (get (aref gates 2) :accept) (js-object :directory "native" :metadata (js-object :verification "equivalent")))
                (setq result (await work))))
            (js-call assert :strictEqual (get result :hasFailure) t)
            (js-call assert :strictEqual (get result :failure) first)
            (js-call assert :strictEqual (get result :status) "failed")
            (js-call assert :strictEqual (get result :verification) "unverified")
            (js-call assert :deepStrictEqual (js-call (get result :targets) :map (lambda (entry) (get entry :target))) targets)
            (js-call assert :deepStrictEqual (js-call (get result :targets) :map (lambda (entry) (get entry :status)))
              (js-array "failed" "failed" "passed"))
            (js-call assert :strictEqual (Object/hasOwn (aref (get result :targets) 0) "failure") t)
            (js-call assert :strictEqual (Object/hasOwn (aref (get result :targets) 1) "failure") t))
          (setq index (1+ index))))))

  (test "parallel cancellation never enters pending target cells and preserves observer isolation and original cancellation identity"
    (async ()
      (let ((modes (js-array "before" "observer" "first-cell")) (index 0))
        (while (< index (js-length modes))
          (let* ((mode (aref modes index)) (controller (new globalThis.AbortController))
                 (reason (js-object :cancelled mode)) (started (js-array)) (events (js-array)))
            (when (= mode "before") (js-call controller :abort reason))
            (let ((result (await (run-stage3-target-schedule
                    (js-object :parallelTargets t :stage3MetadataPath "stage3.json"
                      :corpusRecordsPath "same.json" :outputRoot "parallel-cancelled"
                      :signal (get controller :signal)
                      :onStage (lambda (event)
                        (js-call events :push (get event :target))
                        (when (and (= mode "observer") (= (get event :phase) "target-start")
                                   (= (get event :target) "wasm")) (js-call controller :abort reason))
                        (throw undefined)))
                    (async (call)
                      (js-call started :push (get call :target))
                      (js-call controller :abort reason)
                      (js-object :directory "javascript" :metadata (js-object :verification "equivalent")))))))
              (js-call assert :strictEqual (get result :status) "cancelled")
              (js-call assert :strictEqual (get result :failure) reason)
              (js-call assert :strictEqual (get result :verification) "unverified")
              (js-call assert :deepStrictEqual started (if (= mode "first-cell") (js-array "javascript") (js-array)))
              (js-call assert :deepStrictEqual (js-call (get result :targets) :map (lambda (entry) (get entry :target))) targets)
              (js-call assert :deepStrictEqual (js-call (get result :targets) :map (lambda (entry) (get entry :status)))
                (if (= mode "first-cell") (js-array "passed" "cancelled" "cancelled")
                  (js-array "cancelled" "cancelled" "cancelled")))
              (when (= mode "before") (js-call assert :deepStrictEqual events (js-array)))))
          (setq index (1+ index))))))

  (test "one shared Eli source really emits and executes three output targets while a test schedule remains unverified"
    (js-object :skip (not (and (= (get globalThis.process :arch) "arm64")
      (js-call (js-array "darwin" "linux") :includes (get globalThis.process :platform)))))
    (async ()
      (await (workspace (async (directory)
        (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
               (compiler (get backend :compiler))
               (source (js-call (js-array
                 "(module fixture.shared-output"
                 " (defun observation () (js-array -0.0 (/ 0 0) (/ 1 0) 5e-324 \"中😀\""
                 "  (try (throw false) (catch error error))"
                 "  (funcall (lambda (x) (+ x 2)) 3)))"
                 " (export observation))") :join "\n"))
               (source-sha (compilerDigest source))
               (program (js-call compiler :compile_ir_string source "shared-output.eli"))
               (saved (JSON/stringify program))
               (runtime-ir (js-call compiler :compile_ir_string
                 (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
               (lowered (js-call (get backend :managed) :lower_managed_program program runtime-ir t))
               (native-target (if (= (get globalThis.process :platform) "linux") "arm64-linux" "arm64-macos"))
               (observations (js-array))
               (result (await (run-stage3-target-schedule
                 (js-object :stage3MetadataPath "fixture-only-not-a-certified-stage3.json"
                   :corpusRecordsPath "fixture-only-not-the-final-corpus.json" :outputRoot directory)
                 (async (call)
                   (js-call assert :strictEqual (get call :host) "javascript")
                   (js-call assert :strictEqual (compilerDigest source) source-sha)
                   (js-call assert :strictEqual (JSON/stringify program) saved)
                   (let ((target (get call :target)) (runtime undefined) (value undefined) (actual undefined))
                     (try
                       (if (= target "javascript")
                         (let* ((path (resolve directory "shared-output.mjs"))
                                (emission (js-call compiler :emit_ir_string_with_source_map program source "shared-output.mjs" "shared-output.eli")))
                           (js-call assert :ok (> (js-length (get emission :javascript)) 0))
                           (js-call assert :strictEqual (get (JSON/parse (get emission :sourceMap)) :version) 3)
                           (await (writeFile path (get emission :javascript)))
                           (setq actual (js-call (funcall (createRequire (resolve directory "reference.cjs")) (await (realpath path))) :observation)))
                         (progn
                           (if (= target "wasm")
                             (let ((bytes (globalThis.Uint8Array.from
                               (js-call (get backend :wasm) :append_metadata_section
                                 (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed))
                                 "eliscript-managed-control" (JSON/stringify (get lowered :descriptor))))))
                               (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
                               (setq runtime (instantiateManagedRuntime bytes)))
                             (let ((path (resolve directory (if (= native-target "arm64-linux") "shared-output.so" "shared-output.dylib"))))
                               (await (writeFile path (globalThis.Uint8Array.from
                                 (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target))))
                               (setq runtime (await (instantiateNativeManagedRuntime path lowered (js-object :nativeTarget native-target))))))
                           (js-call runtime :auto 1)
                           (setq value (js-call runtime :invoke "observation"))
                           (setq actual (primitive-observation runtime value))))
                       (js-call assert :deepStrictEqual actual (js-array -0 globalThis.NaN globalThis.Infinity 5e-324 "中😀" false 5))
                       (js-call observations :push actual)
                       (js-object :directory directory :metadata (js-object :verification "equivalent"))
                       (finally
                         (when runtime
                           (js-call runtime :release value)
                           (js-call runtime :closeModule) (js-call runtime :collect)
                           (js-call assert :strictEqual (js-call runtime :live) 0)
                           (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                           (when (get runtime :close) (js-call runtime :close)))))))))))
          (when (get result :hasFailure) (throw (get result :failure)))
          (js-call assert :strictEqual (js-length observations) 3)
          (js-call assert :deepStrictEqual (aref observations 0) (aref observations 1))
          (js-call assert :deepStrictEqual (aref observations 1) (aref observations 2))
          (js-call assert :strictEqual (get result :scope) "target-schedule")
          (js-call assert :strictEqual (get result :verification) "unverified")
          (js-call assert :strictEqual (get result :status) "completed")
          (js-call assert :strictEqual (get result :hasFailure) false)))))))
)
