(module tests.managed-numeric-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (defconst argv (get globalThis.process :argv))
  (defconst mode (aref argv 2))
  (defconst runtime (instantiateManagedRuntime (readFileSync (aref argv 3))))
  (js-call runtime :auto 1)
  (if (= mode "arithmetic")
    (let* ((zero (js-call runtime :number -0)) (nan (js-call runtime :number globalThis.NaN))
           (one (js-call runtime :number 1)) (negative (js-call runtime :invoke "multiply" (js-array zero one))))
      (assert (Object/is (js-call runtime :readNumber negative) -0))
      (js-call assert :strictEqual (js-call runtime :invoke "equal" (js-array nan nan)) false)
      (js-call assert :strictEqual (js-call runtime :invoke "less" (js-array nan zero)) false)
      (js-call runtime :release negative) (js-call runtime :release nan)
      (js-call runtime :release zero) (js-call runtime :release one)
      (let* ((n (js-call runtime :number 32)) (sum (js-call runtime :invoke "sum-to" (js-array n))))
        (js-call assert :strictEqual (js-call runtime :readNumber sum) 496)
        (js-call runtime :release sum) (js-call runtime :release n)))
    (if (= mode "word")
      (let* ((x (js-call runtime :number globalThis.Number.MAX_VALUE)) (y (js-call runtime :number 3))
             (out (js-call runtime :invoke "remainder" (js-array x y))))
        (assert (Object/is (js-call runtime :readNumber out) (% globalThis.Number.MAX_VALUE 3)))
        (js-call runtime :release out) (js-call runtime :release x) (js-call runtime :release y)
        (let* ((n (js-call runtime :number 128)) (seed (js-call runtime :number 4294967293))
               (mixed (js-call runtime :invoke "loop-mix" (js-array n seed))) (expected 4294967293) (index 0))
          (while (< index 128)
            (setq expected (bit-xor (imul32 expected 1664525) (uint32 index))) (setq index (1+ index)))
          (js-call assert :strictEqual (js-call runtime :readNumber mixed) expected)
          (js-call runtime :release mixed) (js-call runtime :release n) (js-call runtime :release seed)))
      (throw (new globalThis.TypeError "unknown independent numeric oracle"))))
  (js-call runtime :collect)
  (js-call assert :strictEqual (js-call runtime :live) 0)
  (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
