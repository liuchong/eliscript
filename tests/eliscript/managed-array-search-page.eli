(module tests.managed-array-search-page
	(import "eliscript-test/compiler" compile-ir-string emit-ir-string)
	(import "eliscript-test/managed" emit-managed-wasm)
	(import "/oracle.mjs" :as js)
	(import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
	(defun check (value message) (unless value (throw (new globalThis.Error message))))
	(defasync run (input)
		  (let* ((p (compile-ir-string (get input :source) "array-search.eli"))
			 (bytes (js-call globalThis.Uint8Array :from (emit-managed-wasm p (compile-ir-string (get input :runtimeSource) "runtime.eli"))))
			 (javascript (emit-ir-string p))
			 (a undefined))
		    (check (= (js-length (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes))) 0) "imports")
		    (check (= javascript (get input :javascript)) "browser and served original JavaScript bytes differ")
		    (try
		     (let* ((seed 1096984885)
			    (pool (js-array undefined nil false globalThis.NaN 0 -0.0 "中😀" "\ud800" 1 3)))
		       (setq a (instantiateManagedRuntime bytes)) (js-call a :auto 1)
		       (letfn ((next () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223))))
			       (box (v) (cond ((= (value-type v) "number") (js-call a :number v))
					      ((= (value-type v) "string") (js-call a :string v)) (t v))))
			      (let ((k 0) (search-loop-bound 64))
				(while (< k search-loop-bound)
				  (let* ((values (Array/from (js-object :length (% (next) 24)) (lambda () (aref pool (% (next) (js-length pool))))))
					 (refs undefined) (items undefined))
				    (let ((i 0) (search-loop-bound (js-length values)))
				      (while (< i search-loop-bound) (when (= (% (next) 4) 0) (Reflect/deleteProperty values (funcall globalThis.String i)))
					     (setq i (1+ i))))
				    (setq refs (js-call values :map box) items (js-call a :sourceArray refs))
				    (js-call refs :forEach (lambda (v) (js-call a :release v)))
				    (js-call (js-array undefined globalThis.NaN 0 "中😀") :forEach (lambda (needle)
												     (let ((n (box needle)))
												       (js-call (js-array undefined (- globalThis.Infinity) globalThis.Infinity globalThis.NaN -0.9 -1.9 0 1.9 9)
														:forEach (lambda (start)
															   (let ((from (box start)))
															     (js-call (js-array "includes" "index" "last") :forEach (lambda (name)
																						      (let* ((out (js-call a :invoke name (js-array items n from)))
																							     (actual (if (and out (= (get out :kind) 4)) (js-call a :readNumber out) out)))
																							(check (Object/is actual (js-call js name values needle start)) (str name ":" start))
																							(js-call a :release out))))
															     (js-call a :release from))))
												       (let ((out (js-call a :invoke "default-last" (js-array items n))))
													 (check (Object/is (js-call a :readNumber out) (js-call js :default_last values needle)) "missing last fromIndex")
													 (js-call a :release out))
												       (js-call a :release n))))
				    (js-call a :release items))
				  (setq k (1+ k)))))
		       (js-call a :closeModule) (js-call a :collect)
		       (check (and (= (js-call a :live) 0) (= (get (js-call a :stats) :frameDepth) 0)) "cleanup")
		       (Array/from bytes))
		     (finally nil))))
	(put globalThis.globalThis :__eliscriptArraySearchCase run))
