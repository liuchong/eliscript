(module tests.independent-cli-named
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:child_process" spawnSync)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/testing/independent-cli-fixture.mjs" installIndependentCLIFixture)
  (test "the SHA-bound independent CLI fixture transports real named spawnSync help and structured errors in Node LTS and Bun"
    (lambda ()
      (let ((restore (installIndependentCLIFixture "tests/compiler-corpus-arguments.test.mjs"))
            (canonical (resolve root "tools/backends/compiler-cli.mjs"))
            (index 0) (engines (js-array (get globalThis.process :execPath) (get (get globalThis.process :env) :NODE "node"))))
        (try
          (while (< index (js-length engines))
            (let* ((engine (aref engines index))
                   (help (spawnSync engine (js-array canonical "--help" "--json-errors")
                     (js-object :encoding "utf8" :timeout 10000))))
              (js-call assert :strictEqual (get help :error) undefined)
              (js-call assert :strictEqual (get help :status) 0 (get help :stderr))
              (js-call assert :strictEqual (get help :stderr) "")
              (js-call assert :strictEqual (js-call (get help :stdout) :startsWith "Usage:") t)
              (let* ((child (spawnSync engine (js-array canonical "compile" "--unknown-option" "--json-errors")
                       (js-object :encoding "utf8" :timeout 10000)))
                     (record (JSON/parse (get child :stderr))))
                (js-call assert :strictEqual (get child :error) undefined)
                (js-call assert :strictEqual (get child :status) 1)
                (js-call assert :strictEqual (get child :stdout) "")
                (js-call assert :strictEqual (get record :format) "eliscript-compiler-cli-error")
                (js-call assert :strictEqual (get record :version) 1)
                (js-call assert :strictEqual (get (get record :error) :code) "ERR_PARSE_ARGS_UNKNOWN_OPTION")))
            (setq index (1+ index)))
          (finally (funcall restore))))) 30000))
