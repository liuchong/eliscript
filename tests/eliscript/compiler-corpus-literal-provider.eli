(module tests.compiler-corpus-literal-provider
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" cp mkdtemp readdir readFile writeFile rm mkdir symlink realpath lstat)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:module" createRequire)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/backends/compiler-corpus-literal-provider.mjs"
    prepareOriginalLiteralHostProvider resolveOriginalLiteralHostProvider)
  (import "../tools/backends/managed-source-view.mjs" createManagedLiteralHostProvider)
  (import "../tools/backends/compiler-corpus-original-program.mjs" originalProgramSidecars originalProgramAliases)
  (import "../runtime/core/collection.mjs" IReduce)
  (import "../runtime/core/protocol.mjs" extendProtocolType protocolSlot readExternalProtocolMethod)
  (defun HostExtensionProbe () nil)
  (test "canonical foreign protocol lookup keeps exact registered methods without reading direct slots or invoking callbacks"
    (lambda ()
      (let* ((prototype (get HostExtensionProbe :prototype)) (receiver (Object/create prototype))
             (implementation (lambda (value reducer initial) (funcall reducer initial 42)))
             (reads 0) (calls 0) (slot (protocolSlot IReduce "reduce"))
             (provider (createManagedLiteralHostProvider)))
        (extendProtocolType IReduce HostExtensionProbe (js-object :reduce implementation))
        (Object/defineProperty prototype slot (js-object :get (lambda ()
          (setq reads (1+ reads)) (throw false)) :configurable t))
        (js-call assert :strictEqual (readExternalProtocolMethod IReduce "reduce" receiver) implementation)
        (let ((method (js-call provider :externalProtocolMethod IReduce "reduce" receiver)))
          (js-call assert :strictEqual method implementation)
          (js-call assert :strictEqual reads 0)
          (js-call assert :strictEqual (funcall method receiver (lambda (sum value)
            (setq calls (1+ calls)) (+ sum value)) 0) 42)
          (js-call assert :strictEqual calls 1)
          (js-call assert :strictEqual reads 0))
        (js-call assert :strictEqual (js-call provider :externalProtocolMethod IReduce "reduce" (Object/create nil)) undefined)
        (js-call assert :strictEqual reads 0))))
  (test "compiler stage records without program execution keep their real context for every output"
    (async ()
      (let ((targets (js-array "javascript" "wasm" "native")) (index 0))
        (while (< index (js-length targets))
          (let* ((context (js-object :target (aref targets index)
                   :artifact (js-object :descriptor (js-object :literalRuntime (js-object)))
                   :record (js-object :id "compiler-parity:reader:valid:0" :kind "stage"
                     :request (js-object :operation "read" :source "42"))))
                 (before (JSON/stringify context)))
            (js-call assert :strictEqual (await (prepareOriginalLiteralHostProvider context)) context)
            (js-call assert :strictEqual (JSON/stringify context) before))
          (setq index (1+ index))))))
  (defasync sources (directory prefix)
    (let ((result (js-array)) (items (await (readdir directory (js-object :withFileTypes t)))) (index 0))
      (while (< index (js-length items))
        (let* ((item (aref items index)) (name (get item :name)) (id (+ prefix "/" name)))
          (cond ((js-call item :isDirectory)
            (setq result (js-call result :concat (await (sources (resolve directory name) id)))))
            ((and (js-call item :isFile) (js-call name :endsWith ".mjs"))
              (js-call result :push (js-object :id id :source (await (readFile (resolve directory name) "utf8")))))))
        (setq index (1+ index))) result))
  (test "binary literal child sidecars share the authenticated provider namespace and cannot replace compiled modules"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-canonical-literal-sidecars-"))))
             (assets (await (sources (resolve root "runtime") "runtime"))))
        (try
          (let ((targets (js-array "wasm" "native")) (index 0))
            (while (< index (js-length targets))
              (let* ((target (aref targets index)) (local (resolve directory target))
                     (artifact (js-object :target target :directory local :path (resolve local "program")
                       :descriptor (js-object :literalRuntime (js-object) :project (js-object :modules (js-array)))))
                     (context (js-object :target target :sourceRoot root :artifact artifact
                       :record (js-object :id "original-program:literal-runtime-complete-hosts" :kind "project" :sourceRoot root
                         :original (js-object :suite "tests/literal-runtime.test.mjs")
                         :request (js-object :hostSources assets) :execution (js-object :kind "original-program"))))
                     (configured (await (prepareOriginalLiteralHostProvider context)))
                     (record (get configured :record)) (before (JSON/stringify record)))
                (await (mkdir local (js-object :recursive t)))
                (await (originalProgramSidecars artifact record))
                (await (originalProgramAliases artifact root))
                (js-call assert :strictEqual (js-call (await (lstat (resolve local "runtime"))) :isSymbolicLink) t)
                (js-call assert :strictEqual (await (realpath (resolve local "runtime"))) (await (realpath (resolve root "runtime"))))
                (let* ((input (js-object :target target :sourceRoot root :descriptor (get artifact :descriptor)
                         :base (get (pathToFileURL (+ local "/")) :href)
                         :runtimeOptions (get (get record :execution) :runtimeOptions)))
                       (resolved (await (resolveOriginalLiteralHostProvider input)))
                       (provider (get (get resolved :runtimeOptions) :literalHostProvider))
                       (require (createRequire (resolve local "host.mjs")))
                       (text (funcall require (resolve local "runtime/core/data-text.mjs"))))
                  (js-call assert :strictEqual text (get (get provider :protocolNamespaces) "data-text"))
                  (js-call assert :strictEqual (js-call text :printValue (js-call provider :queue 1 2)) "#queue [1 2]"))
                (let ((changed (globalThis.structuredClone record)))
                  (put (aref (get (get changed :request) :hostSources) 0) :source
                    (str (get (aref (get (get changed :request) :hostSources) 0) :source) "\n"))
                  (await (js-call assert :rejects (lambda () (originalProgramSidecars artifact changed)) globalThis.TypeError)))
                (let ((collision (Object/assign (js-object) artifact (js-object :descriptor
                         (js-object :literalRuntime (js-object) :project (js-object :modules
                           (js-array (js-object :id "runtime/literals.mjs"))))))))
                  (await (js-call assert :rejects (lambda () (originalProgramSidecars collision record)) globalThis.TypeError)))
                (js-call assert :strictEqual (JSON/stringify record) before))
              (setq index (1+ index))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
  (test "binary original hosts use their authenticated local literal and protocol graph without replacing selected code"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-local-literal-provider-"))))
             (local (resolve directory "product"))
             (assets (await (sources (resolve root "runtime") "runtime")))
             (context (js-object :target "wasm" :artifact (js-object :directory local :descriptor (js-object :literalRuntime (js-object)))
               :record (js-object :kind "project" :request (js-object :hostSources assets)
                 :execution (js-object :kind "original-program" :runtimeOptions (js-object :auto 1)))))
             (original (JSON/stringify (get context :record))))
        (try
          (progn
            (await (cp (resolve root "runtime") (resolve local "runtime") (js-object :recursive t)))
            (await (mkdir (resolve local "node_modules") (js-object :recursive t)))
            (await (symlink root (resolve local "node_modules/eliscript") "dir"))
            (let* ((configured (await (prepareOriginalLiteralHostProvider context)))
                   (options (get (get (get configured :record) :execution) :runtimeOptions))
                   (input (js-object :target "wasm" :base (get (pathToFileURL (+ local "/")) :href)
                     :descriptor (js-object :literalRuntime (js-object)) :runtimeOptions options))
                   (resolved (await (resolveOriginalLiteralHostProvider input)))
                   (provider (get (get resolved :runtimeOptions) :literalHostProvider))
                   (require (createRequire (resolve local "entry.mjs")))
                   (literal (funcall require (resolve local "runtime/literals.mjs")))
                   (text (funcall require (resolve local "runtime/core/data-text.mjs")))
                   (queue (js-call provider :queue 1 2)))
              (js-call assert :strictEqual (get provider :queue) (get literal :queue))
              (js-call assert :strictEqual (get (get provider :protocolNamespaces) "data-text") text)
              (js-call assert :strictEqual (js-call text :printValue queue) "#queue [1 2]")
              (js-call assert :strictEqual (get (get resolved :runtimeOptions) :auto) 1)
              (js-call assert :strictEqual (JSON/stringify (get context :record)) original)
              (js-call assert :strictEqual (await (prepareOriginalLiteralHostProvider configured)) configured)
              (let ((plain (js-object :target "wasm" :runtimeOptions (js-object))))
                (js-call assert :strictEqual (await (resolveOriginalLiteralHostProvider plain)) plain))
              (let* ((broken (globalThis.structuredClone input))
                     (proof (get (get broken :runtimeOptions) :literalHostProvider)))
                (put (aref (get proof :files) 0) :sha256 (js-call "0" :repeat 64))
                (await (js-call assert :rejects (lambda () (resolveOriginalLiteralHostProvider broken)) globalThis.TypeError)))
              (await (writeFile (resolve local "runtime/literals.mjs") "changed original asset"))
              (await (js-call assert :rejects (lambda () (resolveOriginalLiteralHostProvider input)) globalThis.TypeError))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
)
