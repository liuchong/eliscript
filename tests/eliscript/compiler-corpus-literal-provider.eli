(module tests.compiler-corpus-literal-provider
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" cp mkdtemp readdir readFile writeFile rm mkdir symlink)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:module" createRequire)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/backends/compiler-corpus-literal-provider.mjs"
    prepareOriginalLiteralHostProvider resolveOriginalLiteralHostProvider)
  (defasync sources (directory prefix)
    (let ((result (js-array)) (items (await (readdir directory (js-object :withFileTypes t)))) (index 0))
      (while (< index (js-length items))
        (let* ((item (aref items index)) (name (get item :name)) (id (+ prefix "/" name)))
          (cond ((js-call item :isDirectory)
            (setq result (js-call result :concat (await (sources (resolve directory name) id)))))
            ((and (js-call item :isFile) (js-call name :endsWith ".mjs"))
              (js-call result :push (js-object :id id :source (await (readFile (resolve directory name) "utf8")))))))
        (setq index (1+ index))) result))
  (test "binary original hosts use their authenticated local literal and protocol graph without replacing selected code"
    (async ()
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-local-literal-provider-"))))
             (local (resolve directory "product"))
             (assets (await (sources (resolve root "runtime") "runtime")))
             (context (js-object :target "wasm" :artifact (js-object :directory local :descriptor (js-object :literalRuntime (js-object)))
               :record (js-object :kind "project" :request (js-object :hostSources assets)
                 :execution (js-object :kind "original-program" :runtimeOptions (js-object :auto 1)))))
             (original (JSON/stringify (get context :record))))
        (try
          (progn
            (await (cp (resolve root "runtime") (resolve local "runtime") (js-object :recursive t)))
            (await (mkdir (resolve local "node_modules") (js-object :recursive t)))
            (await (symlink root (resolve local "node_modules/eliscript") "dir"))
            (let* ((configured (await (prepareOriginalLiteralHostProvider context)))
                   (options (get (get (get configured :record) :execution) :runtimeOptions))
                   (input (js-object :target "wasm" :base (get (pathToFileURL (+ local "/")) :href)
                     :descriptor (js-object :literalRuntime (js-object)) :runtimeOptions options))
                   (resolved (await (resolveOriginalLiteralHostProvider input)))
                   (provider (get (get resolved :runtimeOptions) :literalHostProvider))
                   (require (createRequire (resolve local "entry.mjs")))
                   (literal (funcall require (resolve local "runtime/literals.mjs")))
                   (text (funcall require (resolve local "runtime/core/data-text.mjs")))
                   (queue (js-call provider :queue 1 2)))
              (js-call assert :strictEqual (get provider :queue) (get literal :queue))
              (js-call assert :strictEqual (get (get provider :protocolNamespaces) "data-text") text)
              (js-call assert :strictEqual (js-call text :printValue queue) "#queue [1 2]")
              (js-call assert :strictEqual (get (get resolved :runtimeOptions) :auto) 1)
              (js-call assert :strictEqual (JSON/stringify (get context :record)) original)
              (js-call assert :strictEqual (await (prepareOriginalLiteralHostProvider configured)) configured)
              (let ((plain (js-object :target "wasm" :runtimeOptions (js-object))))
                (js-call assert :strictEqual (await (resolveOriginalLiteralHostProvider plain)) plain))
              (let* ((broken (globalThis.structuredClone input))
                     (proof (get (get broken :runtimeOptions) :literalHostProvider)))
                (put (aref (get proof :files) 0) :sha256 (js-call "0" :repeat 64))
                (await (js-call assert :rejects (lambda () (resolveOriginalLiteralHostProvider broken)) globalThis.TypeError)))
              (await (writeFile (resolve local "runtime/literals.mjs") "changed original asset"))
              (await (js-call assert :rejects (lambda () (resolveOriginalLiteralHostProvider input)) globalThis.TypeError))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
)
