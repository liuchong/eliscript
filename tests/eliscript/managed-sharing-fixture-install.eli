(module tests.managed-sharing-fixture-install
  (import "bun:test" mock afterAll)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "node:child_process" :as child-processes)
  (import "node:child_process" :default processes)
  (import "node:module" syncBuiltinESMExports)
  (import "../../tools/backends/build.mjs" :as actual)
  (import "../../tools/testing/managed-sharing-fixture.mjs" adaptManagedSharingCompiler managedSharingNodeArguments)
  (defconst original (Object/assign (js-object) actual))
  (defconst root (get original :root))
  (defconst original-processes (Object/assign (js-object) child-processes))
  (defconst original-spawn (get processes :spawnSync))
  (defconst suite "tests/wasm-managed-project-sharing.test.mjs")
  (js-call assert :ok (js-call (get globalThis.process :argv) :some
    (lambda (argument) (= (resolve root argument) (resolve root suite)))))
  (js-call assert :strictEqual (js-call (js-call (createHash "sha256") :update
    (readFileSync (resolve root suite))) :digest "hex")
    "dc3b44f656da9f4126b09a7830e760e7e0bfcb7f8e738e357b3072baccb0c106")
  (defasync buildBackends (&rest arguments)
    (let* ((backend (await (Reflect/apply (get original :buildBackends) original arguments)))
           (directory (get (aref arguments 0) :outputRoot)))
      (js-call assert :strictEqual (value-type directory) "string")
      (Object/assign (js-object) backend (js-object :compiler
        (adaptManagedSharingCompiler (get backend :compiler) directory)))))
  (defun spawnSync (command arguments &rest options)
    (Reflect/apply original-spawn processes
      (js-call (js-array command (managedSharingNodeArguments command arguments)) :concat options)))
  (put processes :spawnSync spawnSync) (syncBuiltinESMExports)
  (js-call mock :module "node:child_process"
    (lambda () (Object/assign (js-object) original-processes (js-object :default processes :spawnSync spawnSync))))
  (afterAll (lambda ()
    (put processes :spawnSync original-spawn) (syncBuiltinESMExports)
    (js-call mock :module "node:child_process" (lambda () original-processes))
    (js-call mock :module (resolve root "tools/backends/build.mjs") (lambda () original))))
  (js-call mock :module (resolve root "tools/backends/build.mjs")
    (lambda () (Object/assign (js-object) original (js-object :buildBackends buildBackends)))))
