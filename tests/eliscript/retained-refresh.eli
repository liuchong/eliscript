(module tests.retained-refresh
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdir mkdtemp rm symlink)
  (import "node:path" resolve dirname)
  (import "../../tools/backends/build.mjs" root)
  (import "../../tools/acceptance/retained-performance-snapshot.mjs" retainedPerformanceSnapshot retainedGitSnapshotBytes)
  (import "../../tools/acceptance/retained-soak.mjs" validateRefreshedWorkerSoak)
  (import "../../tools/acceptance/retained-transient.mjs" validateRefreshedTransientBuilder)
  (defun git-text (arguments)
    (js-call (new globalThis.TextDecoder) :decode (retainedGitSnapshotBytes root arguments)))
  (defasync fresh-measured-source (file validate)
    (let* ((bytes (await (readFile (resolve root file))))
           (measured (retainedPerformanceSnapshot root file bytes))
           (report (JSON/parse (js-call bytes :toString "utf8")))
           (run (JSON/parse (await (readFile (resolve root "acceptance/runs/m13-01.json") "utf8"))))
           (files (if (= file "benchmarks/transient-builder-macos-arm64.json")
                    (get (get report :sourceDigest) :files)
                    (js-call (get (get report :source) :files) :map (lambda (item) (get item :file)))))
           (base (resolve root ".eliscript-cache/retained-fresh")))
      (await (mkdir base (js-object :recursive t)))
      (let ((directory (await (mkdtemp (resolve base "source-")))))
        (try
          ;; This is an explicit test fixture of the real measured sources,
          ;; not a claim that the current checkout passed old performance.
          (await (symlink (js-call (git-text (js-array "rev-parse" "--absolute-git-dir")) :trim)
            (resolve directory ".git") "dir"))
          (let ((index 0))
            (while (< index (js-length files))
              (let* ((name (aref files index)) (path (resolve directory name)))
                (unless (and (= (value-type name) "string")
                  (js-call path :startsWith (str directory "/")) (not (js-call (js-call name :split "/") :includes "..")))
                  (throw (new globalThis.TypeError "measured source fixture path is outside its owned directory")))
                (await (mkdir (dirname path) (js-object :recursive t)))
                (await (writeFile path (retainedGitSnapshotBytes root
                  (js-array "show" (str (get measured :commit) ":" name))))))
              (setq index (1+ index))))
          (js-call assert :strictEqual (await (funcall validate directory file bytes run)) t)
          (js-call assert :strictEqual (await (funcall validate directory file bytes run
            (js-object :deferPerformanceAcceptance t))) t)
          (finally (await (rm directory (js-object :recursive t :force t))))))))
  (defasync runFreshSoakCase ()
    (await (fresh-measured-source "benchmarks/worker-lifecycle-soak-macos-arm64.json" validateRefreshedWorkerSoak)))
  (defasync runFreshTransientCase ()
    (await (fresh-measured-source "benchmarks/transient-builder-macos-arm64.json" validateRefreshedTransientBuilder)))
  (export runFreshSoakCase runFreshTransientCase))
