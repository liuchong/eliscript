(module tests.managed-object-properties-page
  (import "eliscript-test/compiler" compile-ir-string emit-ir-string)
  (import "eliscript-test/managed" emit-managed-wasm)
  (import "/oracle.mjs" :as js)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (defun check (value message) (unless value (throw (new globalThis.Error message))))
  (defun read (a x)
    (cond ((and x (= (get x :kind) 4)) (js-call a :readNumber x)) ((and x (= (get x :kind) 5)) (js-call a :readString x))
      ((and x (= (get x :kind) 14)) (Array/from (js-object :length (js-call a :length x)) (lambda (ignored index)
        (let ((item (js-call a :get x index))) (try (read a item) (finally (js-call a :release item))))))) (t x)))
  (defasync run (input)
    (let* ((p (compile-ir-string (get input :source) (get input :filename)))
      (rt (compile-ir-string (get input :runtime) "runtime.eli"))
      (bytes (globalThis.Uint8Array.from (emit-managed-wasm p rt))))
      (check (= (emit-ir-string p) (get input :seed)) "public Seed JS")
      (check (= (js-length (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes))) 0) "imports")
      (let* ((a (instantiateManagedRuntime bytes))) (js-call a :auto 1)
        (let ((out (js-call a :invoke "exercise")))
          (check (= (JSON/stringify (read a out)) (JSON/stringify (js-call js :exercise))) "property-operation behavior")
          (check (eq (js-call a :invoke "identities") t) "firstclass") (js-call a :release out))
        (js-call a :closeModule) (js-call a :collect)
        (check (and (= (js-call a :live) 0) (= (get (js-call a :stats) :frameDepth) 0)) "roots"))
      (Array/from bytes)))
  (put globalThis.globalThis :__eliscriptObjectPropertiesCase run))
