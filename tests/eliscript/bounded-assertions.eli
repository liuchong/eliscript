(module tests.bounded-assertions
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "../tools/testing/bounded-assertions.mjs" boundedStrictAssertions)
  (test "complete IR strings use the original strict scalar comparator and fail without retaining a whole product diff"
    (lambda ()
      (let* ((calls 0) (actual (js-call "exact-ir-source" :repeat 1048576))
             (expected (str actual "changed"))
             (original (lambda (left right message)
               (setq calls (1+ calls))
               (js-call assert :strictEqual left actual) (js-call assert :strictEqual right expected)
               (js-call assert :strictEqual left right message)))
             (facade (boundedStrictAssertions (js-object :equal original :strictEqual original
                       :deepEqual (get assert :deepEqual) :deepStrictEqual (get assert :deepStrictEqual)))))
        (js-call assert :throws (lambda () (js-call facade :equal actual expected "complete IR must be identical"))
          (lambda (error) (and (= (get error :operator) "strictEqual")
            (< (js-length (get error :message)) 300) (undefined? (get error :actual)) (undefined? (get error :expected)))))
        (js-call assert :strictEqual calls 1))))
  (test "bounded diagnostics forward the original strict comparator once and preserve caller errors and exact failures"
    (lambda ()
      (let* ((calls (js-array)) (original (lambda (actual expected message)
               (js-call calls :push (js-array actual expected message))
               (js-call assert :deepStrictEqual actual expected message)))
             (facade (boundedStrictAssertions (js-object :deepEqual original :deepStrictEqual original)))
             (left (js-object :bytes (js-array 0 255) :metadata (js-object :negative -0.0)))
             (right (globalThis.structuredClone left)))
        (js-call facade :deepEqual left right "complete product")
        (js-call assert :strictEqual (js-length calls) 1)
        (js-call assert :strictEqual (aref (aref calls 0) 0) left)
        (js-call assert :strictEqual (aref (aref calls 0) 1) right)
        (let ((failure undefined))
          (try (js-call facade :deepStrictEqual left (js-object) "complete product")
            (catch error (setq failure error)))
          (js-call assert :ok (js-call (get assert :AssertionError) (get globalThis.Symbol :hasInstance) failure))
          (js-call assert :strictEqual (Object/getPrototypeOf failure) (get (get assert :AssertionError) :prototype))
          (js-call assert :strictEqual (get failure :operator) "deepStrictEqual")
          (js-call assert :ok (< (js-length (get failure :message)) 300))
          (js-call assert :strictEqual (get failure :actual) undefined)
          (js-call assert :strictEqual (get failure :expected) undefined))
        (let ((marker (new globalThis.Error "original assertion message")))
          (js-call assert :throws (lambda () (js-call facade :deepEqual left nil marker))
            (lambda (error) (eq error marker)))))))
  (test "bounded diagnostics retain every byte key hole signed zero prototype and first throwing getter"
    (lambda ()
      (let ((facade (boundedStrictAssertions assert)))
        (js-call (js-array
          (js-array (js-array 0 255) (js-array 0 254))
          (js-array (js-object :x -0.0) (js-object :x 0))
          (js-array (js-object :missing undefined) (js-object))
          (js-array (new globalThis.Array 1) (js-array undefined))
          (js-array (Object/create nil) (js-object))) :forEach
          (lambda (row) (js-call assert :throws (lambda () (js-call facade :deepEqual (aref row 0) (aref row 1))))))
        (let* ((marker (Object/freeze (js-object :first t))) (reads (js-array))
               (value (Object/defineProperty (js-object) "first" (js-object :enumerable t
                 :get (lambda () (js-call reads :push "first") (throw marker))))))
          (js-call assert :throws (lambda () (js-call facade :deepEqual value (js-object :first 1)))
            (lambda (error) (eq error marker)))
          (js-call assert :deepStrictEqual reads (js-array "first")))
        (let* ((large (js-call "complete-byte-stream" :repeat 1048576))
               (left (js-object :bytes large)) (right (js-object :bytes (str large "changed"))))
          (js-call assert :throws (lambda () (js-call facade :deepStrictEqual left right))
            (lambda (error)
              (and (< (js-length (get error :message)) 300)
                   (undefined? (get error :actual)) (undefined? (get error :expected))))))))))
