(module tests.number-text-node-test
  (import "node:test" :as node)
  (import "node:assert/strict" :default assert)
  (import "../../tools/testing/number-text-node.mjs" numberTextTestArguments numberTextHookArguments)
  (import "../../tools/testing/number-text-regressions.mjs" numberCrossHostTitle assertNumberCrossHost)
  (defvar registrations 0) (defvar crossHostRegistrations 0)
  (defun test (&rest arguments)
    (setq registrations (1+ registrations))
    (let ((forwarded (js-call arguments :slice)))
      (when (= (aref arguments 0) numberCrossHostTitle)
        (setq crossHostRegistrations (1+ crossHostRegistrations))
        (put forwarded 1 (async () (await (assertNumberCrossHost)))))
      (Reflect/apply (get node :test) node (numberTextTestArguments forwarded))))
  (defun beforeAll (&rest arguments)
    (Reflect/apply (get node :before) node (numberTextHookArguments arguments)))
  (defun afterAll (&rest arguments)
    (Reflect/apply (get node :after) node (numberTextHookArguments arguments)))
  (js-call node :after (lambda ()
    (js-call assert :strictEqual registrations 9 "the complete original Number text suite must register all nine cases")
    (js-call assert :strictEqual crossHostRegistrations 1)))
  (export test beforeAll afterAll))
