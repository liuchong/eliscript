(module tests.independent-cli-fixture
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:path" resolve)
  (import "node:fs" readFileSync)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/testing/independent-cli-fixture.mjs" rewriteIndependentCLIArguments rewriteIndependentCLIInvocation installIndependentCLIFixture)
  (import "../tools/testing/compiler-request-cases.mjs" compilerRequestModes compilerRequestTargets
    compilerRequestTestRegistration projectCompilerRequestSuite)
  (import "../tools/testing/fixture-environment.mjs" prepareFixtureEnvironment fixtureChildArguments)
  (defconst canonical (resolve root "tools/backends/compiler-cli.mjs"))
  (defconst independent (resolve root "tools/backends/compiler-cli-ground.mjs"))
  (test "independent CLI transport relocates only one exact actual parser coordinate and preserves every argument"
    (lambda ()
      (let* ((arguments (js-array "--smol" canonical "compile" "--compiler-artifact" "原😀.json" "--input" "-"))
             (before (js-call arguments :slice)) (result (rewriteIndependentCLIArguments arguments)))
        (js-call assert :deepStrictEqual arguments before)
        (js-call assert :notStrictEqual (get result :arguments) arguments)
        (js-call assert :strictEqual (get result :substitutions) 1)
        (put before 1 independent)
        (js-call assert :deepStrictEqual (get result :arguments) before))
      (let* ((url (get (pathToFileURL canonical) :href))
             (script (+ "prefix😀" url "suffix"))
             (result (rewriteIndependentCLIArguments (js-array "--input-type=module" "--eval" script))))
        (js-call assert :strictEqual (get result :substitutions) 1)
        (js-call assert :strictEqual (aref (get result :arguments) 2)
          (+ "prefix😀" (get (pathToFileURL independent) :href) "suffix")))
      (let ((arguments (js-array "unrelated.mjs" "--bootstrap-manifest" "strict.json")))
        (js-call assert :deepStrictEqual (get (rewriteIndependentCLIArguments arguments) :arguments) arguments)
        (js-call assert :strictEqual (get (rewriteIndependentCLIArguments arguments) :substitutions) 0))
      (js-call assert :throws (lambda () (rewriteIndependentCLIArguments (js-array canonical canonical))) globalThis.TypeError)
      (let ((url (get (pathToFileURL canonical) :href)))
        (js-call assert :throws (lambda () (rewriteIndependentCLIArguments (js-array "-e" (+ url url)))) globalThis.TypeError))
      (js-call assert :throws (lambda () (installIndependentCLIFixture "tests/unknown.test.mjs")) globalThis.TypeError)))
  (test "compiler request partitions execute all twenty original artifact output pairs once and restore selection on success and failure"
    (async ()
      (let* ((registered (js-array)) (observed (js-array))
             (test (compilerRequestTestRegistration (lambda (&rest arguments) (js-call registered :push arguments))))
             (callback (lambda ()
               (let ((modes (compilerRequestModes)) (targets (compilerRequestTargets (js-array "javascript" "wasm" "native"))))
                 (js-call assert :strictEqual (js-length modes) 1)
                 (js-call assert :strictEqual (js-length targets) 1)
                 (js-call observed :push (str (aref modes 0) "/" (aref targets 0)))))))
        (js-call (js-array "bun" "node") :forEach (lambda (engine)
          (js-call (js-array "emit-ir" "project-ir") :forEach (lambda (operation)
            (funcall test (str "Given the original and relocated javascript compiler When " engine
              " CLI request submits " operation " Then real products sidecars and recovery preserve their ABI") callback 120000)))))
        (js-call assert :strictEqual (js-length registered) 20)
        (let ((index 0))
          (while (< index (js-length registered))
            (let ((record (aref registered index)))
              (js-call assert :strictEqual (aref record 2)
                (if (js-call (aref record 0) :endsWith "/native]") 240000 120000))
              (await (funcall (aref record 1))))
            (setq index (1+ index))))
        (js-call assert :deepStrictEqual observed (js-call (js-array
          "original/wasm" "original/native" "package/wasm" "package/native"
          "original/javascript" "original/wasm" "original/native" "package/javascript" "package/wasm" "package/native")
          :concat (js-call observed :slice 0 10)))
        (funcall test "unaffected original test" callback 30000)
        (js-call assert :strictEqual (aref (js-call registered :at -1) 1) callback)
        (js-call assert :strictEqual (aref (js-call registered :at -1) 2) 30000)
        (let* ((failure (new globalThis.Error "original callback failure")) (failures (js-array))
               (registration (compilerRequestTestRegistration (lambda (&rest arguments) (js-call failures :push arguments)))))
          (funcall registration (aref (aref registered 0) 0) (lambda () (throw failure)) 120000)
          ;; A title with an existing partition suffix is passed through.
          (js-call assert :strictEqual (js-length failures) 1)
          (js-call failures :splice 0)
          (funcall registration "Given the original and relocated javascript compiler When bun CLI request submits emit-ir Then real products sidecars and recovery preserve their ABI"
            (lambda () (throw failure)) 120000)
          (await (js-call assert :rejects (aref (aref failures 0) 1) (lambda (error) (eq error failure)))))
        (js-call assert :deepStrictEqual (compilerRequestModes) (js-array "original" "package"))
        (let ((targets (js-array "wasm" "native")))
          (js-call assert :strictEqual (compilerRequestTargets targets) targets)))))
  (test "compiler request projection is explicit-defer-only and symlink coordinates still select the authenticated independent parser"
    (lambda ()
      (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
             (environment (get fixture :environment))
             (file "./tests/compiler-package-session.test.mjs")
             (input (js-array "test" file))
             (strict (Object/assign (js-object) environment (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "0"))))
        (try
          (let ((strict-args (fixtureChildArguments input strict)))
            (js-call assert :ok (js-call strict-args :includes file)))
          (let* ((deferred (Object/assign (js-object) environment (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1")))
                 (arguments (fixtureChildArguments input deferred))
                 (projected (resolve (get fixture :directory) "initializer-source/tests/compiler-package-session.test.mjs"))
                 (source (readFileSync (resolve root file) "utf8"))
                 (actual (readFileSync projected "utf8"))
                 (anchor "for (const mode of ['original', 'package']) for (const target of targets) {")
                 (at (js-call source :indexOf anchor)))
            (js-call assert :ok (js-call arguments :includes projected))
            (js-call assert :strictEqual actual (projectCompilerRequestSuite root source))
            (js-call assert :ok (js-call actual :includes (js-call source :slice 0 at)))
            (js-call assert :ok (js-call actual :endsWith (js-call source :slice (+ at (js-length anchor)))))
            (js-call assert :throws (lambda () (projectCompilerRequestSuite root (str source " "))) globalThis.TypeError)
            (let* ((path (resolve (get fixture :directory) "initializer-source/tools/backends/compiler-cli.mjs"))
                   (rewritten (rewriteIndependentCLIArguments (js-array path "--help"))))
              (js-call assert :deepStrictEqual (get rewritten :arguments) (js-array independent "--help"))
              (js-call assert :strictEqual (get rewritten :substitutions) 1)
              (let* ((script (str "prefix😀" (get (pathToFileURL path) :href) "suffix"))
                     (rewritten-eval (rewriteIndependentCLIArguments (js-array "-e" script))))
                (js-call assert :strictEqual (get rewritten-eval :substitutions) 1)
                (js-call assert :deepStrictEqual (get rewritten-eval :arguments)
                  (js-array "-e" (str "prefix😀" (get (pathToFileURL independent) :href) "suffix"))))
              (let* ((command (resolve (get fixture :directory) "initializer-source/bin/eliscript-compiler"))
                     (options (js-object :env (js-object :BUN "node")))
                     (invocation (rewriteIndependentCLIInvocation command (js-array "--help") options)))
                (js-call assert :strictEqual (get invocation :command) "node")
                (js-call assert :deepStrictEqual (get invocation :arguments) (js-array independent "--help"))
                (js-call assert :strictEqual (get invocation :options) options)
                (js-call assert :strictEqual (get invocation :substitutions) 1))))
          (finally (js-call fixture :close)))))))
