(module tests.managed-symbols-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:module" createRequire)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (defun read (runtime value)
    (cond ((and value (= (get value :kind) 4)) (js-call runtime :readNumber value))
      ((and value (= (get value :kind) 5)) (js-call runtime :readString value))
      ((and value (= (get value :kind) 14))
        (Array/from (js-object :length (js-call runtime :length value)) (lambda (unused index)
          (let ((item (js-call runtime :get value index))) (try (read runtime item) (finally (js-call runtime :release item)))))))
      (t value)))
  (let* ((argv (get globalThis.process :argv)) (mode (aref argv 2)))
    (cond
      ((= mode "bigint")
        (let* ((data (JSON/parse (readFileSync 0 "utf8")))
               (parse (lambda (text) (try (js-object :value (js-call (funcall globalThis.BigInt text) :toString))
                 (catch error (js-object :error (get error :name)))))))
          (js-call (get globalThis.process :stdout) :write (JSON/stringify
            (js-object :valid (js-call (get data :valid) :map parse) :invalid (js-call (get data :invalid) :map parse))))))
      ((= mode "cold")
        (let* ((path (aref argv 3)) (m (funcall (createRequire path) path)) (names (JSON/parse (aref argv 4)))
               (stages (Object/fromEntries (js-call names :map (lambda (name)
                 (js-array name (funcall (get m (js-call name :replaceAll "-" "_"))))))))
               (observations (js-call (js-array 0 1 2 3 4) :map (lambda (mode) (js-call m :observe mode)))))
          (console/log (JSON/stringify (js-object :stages stages :observe observations)))))
      ((= mode "exercise")
        (let* ((a (instantiateManagedRuntime (readFileSync 0))) (_ (js-call a :auto 1)) (out (js-call a :invoke "exercise")))
          (js-call assert :deepStrictEqual (read a out) (JSON/parse (aref argv 3)))
          (js-call assert :strictEqual (js-call a :invoke "identities") t)
          (js-call a :release out) (js-call a :closeModule) (js-call a :collect)
          (js-call assert :strictEqual (js-call a :live) 0) (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0)))
      (t (throw (new globalThis.Error "unknown Symbol Node case")))))
)
