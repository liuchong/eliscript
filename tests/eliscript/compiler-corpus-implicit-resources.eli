(module tests.compiler-corpus-implicit-resources
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/backends/compiler-build.mjs" independentCompilerResources)
  (import "../tools/backends/compiler-corpus.mjs" compilerCorpusFunctionalResources compilerCorpusRequest compilerCorpusResourceDeferred)
  (import "../tools/backends/compiler-matrix.mjs" loadCompilerMatrixCorpus classifyStage3Corpus)
  (import "../tools/backends/compiler-corpus-execution.mjs" prepareCompilerCorpusRuntimeContext)
  (defun digest (text) (js-call (js-call (createHash "sha256") :update text) :digest "hex"))
  (defasync original-record (name)
    (let* ((formatter (= name "formatter-node"))
           (suite (if formatter "tests/bootstrap-formatter.test.mjs" "tests/macro-generated-names.test.mjs"))
           (filename (if formatter "bootstrap/compiler/formatter.eli" "generated-names.eli"))
           (entry (if formatter "bootstrap/compiler/formatter.mjs" "generated-names.mjs"))
           (suite-source (await (readFile (resolve root suite) "utf8")))
           (source (if formatter (await (readFile (resolve root filename) "utf8"))
             "(defconst original 1) (defun read () original) (export read)"))
           (bytes (get (globalThis.Buffer.from suite-source) :length)))
      ;; The classification consumes the source-bound recipe shape. Matrix
      ;; corpus authentication still verifies all archived source bytes first;
      ;; this helper does not grant verification to a caller-created record.
      (js-object :id (+ "original-program:" name) :kind "project" :entry entry
        :modules (js-array (js-object :id entry :filename filename :source source))
        :request (js-object :operation "project")
        :execution (js-object :kind "original-program")
        :expected (js-object :kind "seed-program" :oracleRequired t)
        :original (js-object :suite suite :fixture (if formatter filename suite) :host suite
          :sourceSha256 (digest suite-source)
          :regions (js-array (js-object :start 0 :end (js-length suite-source) :byteStart 0 :byteEnd bytes :sha256 (digest suite-source)))))))

  (test "the three source-bound positive tool programs admit only an explicit functional profile and keep their implicit capacity evidence"
    (async ()
      (let ((names (js-array "formatter-node" "macro-generated-names-bun" "macro-generated-names-node"))
            (resources (independentCompilerResources (js-object :profile "small"))) (index 0))
        (while (< index (js-length names))
          (let* ((record (await (original-record (aref names index))))
                 (before (globalThis.structuredClone record)) (options (js-object :functionalRuntimeProfile "small"))
                 (actual (compilerCorpusFunctionalResources record options)))
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record (js-object)) undefined)
            (js-call assert :deepStrictEqual (get actual :originalRuntimeOptions)
              (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216 :auto 0))
            (js-call assert :deepStrictEqual (get actual :effectiveRuntimeOptions)
              (Object/assign (js-object) (get resources :budget) (js-object :auto (get resources :auto))))
            (js-call assert :strictEqual (get actual :resourceAcceptance) "deferred")
            (js-call assert :strictEqual (Object/hasOwn actual "verification") false)
            (js-call (js-array "wasm" "native") :forEach (lambda (target)
              (js-call assert :deepStrictEqual (get (compilerCorpusRequest record target options) :memory) (get resources :memory))))
            (put record :auto 0)
            (js-call assert :strictEqual (get (get (compilerCorpusFunctionalResources record options) :effectiveRuntimeOptions) :auto) 0)
            (Reflect/deleteProperty record "auto")
            (js-call assert :deepStrictEqual record before))
          (setq index (1+ index))))))

  (test "implicit tool resources cannot admit an unbound recipe diagnostics explicit capacity or a different original program"
    (async ()
      (let ((mutations (js-array
        (lambda (record) (put record :id "original-program:formatter-capacity-recovery"))
        (lambda (record) (put (get record :original) :suite "tests/unrelated.test.mjs"))
        (lambda (record) (put (get record :original) :fixture "unrelated.eli"))
        (lambda (record) (put (get record :original) :host "tests/unrelated.test.mjs"))
        (lambda (record) (put (get record :original) :sourceSha256 "bad"))
        (lambda (record) (put (get record :original) :regions (js-array)))
        (lambda (record) (put (aref (get (get record :original) :regions) 0) :sha256 "bad"))
        (lambda (record) (put record :entry "other.mjs"))
        (lambda (record) (put (aref (get record :modules) 0) :filename "other.eli"))
        (lambda (record) (put record :error (js-object :code "ELI-RT0002")))
        (lambda (record) (put (get record :expected) :oracleRequired false))
        (lambda (record) (put (get record :expected) :kind "diagnostic"))
        (lambda (record) (put (get record :execution) :runtimeOptions (js-object :maxSlots 64)))
        (lambda (record) (put (get record :execution) :runtimeOptions (js-object :initialBytes 4096)))
        (lambda (record) (put (get record :execution) :runtimeOptions (js-object :maxBytes 16384)))
        (lambda (record) (put (get record :execution) :runtimeProfile "compiler"))
        (lambda (record) (put record :kind "sequence")))) (index 0))
        (while (< index (js-length mutations))
          (let ((record (await (original-record "formatter-node"))))
            (funcall (aref mutations index) record)
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record (js-object :functionalRuntimeProfile "small")) undefined))
          (setq index (1+ index)))
        (let ((record (await (original-record "macro-generated-names-node"))))
          (js-call assert :strictEqual (compilerCorpusFunctionalResources record
            (js-object :functionalRuntimeProfile "small" :runtimeOptions (js-object :maxSlots 64))) undefined)
          (js-call assert :throws (lambda () (compilerCorpusFunctionalResources record
            (js-object :functionalRuntimeProfile "unrecognized"))) globalThis.TypeError)))))
  (test "the three source-bound persistent core exit hosts retain explicit capacity refusals and raw recipe identity"
    (async ()
      (let ((source (await (readFile (resolve root "stdlib/value.eli") "utf8")))
            (options (js-object :functionalRuntimeProfile "small")))
        (js-call (js-array "vector" "map" "set") :forEach (lambda (name)
          (let* ((record (js-object :id (+ "stable-compatibility:program:persistent-core-exit-" name)
                   :kind "project" :entry "value.mjs"
                   :modules (js-array (js-object :id "value.mjs" :filename "stdlib/value.eli" :source source))
                   :execution (js-object :kind "original-program")
                   :expected (js-object :kind "seed-program" :oracleRequired t)
                   :original (js-object :manifest "stable-compatibility" :fixture "stdlib/value.eli"
                     :host "tests/fixtures/persistent-core-exit-host.mjs")))
                 (before (globalThis.structuredClone record)))
            (js-call assert :strictEqual (get (compilerCorpusFunctionalResources record options) :resourceAcceptance) "deferred")
            (js-call assert :deepStrictEqual record before)
            (put (get record :execution) :runtimeOptions (js-object :maxSlots 64))
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record options) undefined)
            (Reflect/deleteProperty (get record :execution) "runtimeOptions")
            (put (get record :original) :host "tests/fixtures/other-host.mjs")
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record options) undefined)))))))
  (test "functional prelaunch transports the same linear memory as each original million compilation without changing its heap budget"
    (async ()
      (let ((source (await (readFile (resolve root "stdlib/value.eli") "utf8")))
            (profiles (js-array "vector" "map" "set")) (index 0))
        (while (< index (js-length profiles))
          (let* ((name (aref profiles index))
                 (record (js-object :id (+ "stable-compatibility:program:persistent-core-exit-" name)
                   :kind "project" :entry "value.mjs"
                   :modules (js-array (js-object :id "value.mjs" :filename "stdlib/value.eli" :source source))
                   :request (js-object :operation "project")
                   :execution (js-object :kind "original-program" :host "tests/fixtures/persistent-core-exit-host.mjs"
                     :arguments (js-array (js-object :directory t) (js-object :literal name)))
                   :expected (js-object :kind "seed-program" :oracleRequired t)
                   :original (js-object :manifest "stable-compatibility" :fixture "stdlib/value.eli"
                     :host "tests/fixtures/persistent-core-exit-host.mjs")))
                 (before (globalThis.structuredClone record))
                 (options (js-object :functionalRuntimeProfile "small" :node "actual-node"))
                 (context (js-object :target "native" :record record :options options))
                 (acceptance (compilerCorpusFunctionalResources record options))
                 (configured (prepareCompilerCorpusRuntimeContext context acceptance))
                 (request (compilerCorpusRequest record "native" options))
                 (resources (independentCompilerResources (js-object :profile "full-compiler"))))
            (js-call assert :strictEqual (get acceptance :resourceAcceptance) "deferred")
            (js-call assert :strictEqual (get acceptance :effectiveRuntimeProfile) "full-compiler")
            (js-call assert :deepStrictEqual (get (get configured :options) :memory) (get request :memory))
            (js-call assert :deepStrictEqual (get (get configured :options) :memory) (get resources :memory))
            (js-call assert :strictEqual (get (get configured :options) :node) "actual-node")
            (js-call assert :deepStrictEqual (get (get (get configured :record) :execution) :runtimeOptions)
              (get acceptance :effectiveRuntimeOptions))
            (js-call assert :strictEqual (prepareCompilerCorpusRuntimeContext context undefined) context)
            (js-call assert :deepStrictEqual record before)
            (js-call assert :deepStrictEqual options (js-object :functionalRuntimeProfile "small" :node "actual-node"))
            (put record :memory (js-object :initialPages 1 :maximumPages 2))
            (let ((explicit (prepareCompilerCorpusRuntimeContext context acceptance)))
              (js-call assert :strictEqual (get (get explicit :options) :memory) (get record :memory))
              (js-call assert :deepStrictEqual (get (get explicit :options) :memory)
                (get (compilerCorpusRequest record "native" options) :memory)))
            (Reflect/deleteProperty record "memory")
            (put record :auto 0)
            (let* ((strict-auto (compilerCorpusFunctionalResources record options))
                   (configured-auto (prepareCompilerCorpusRuntimeContext context strict-auto)))
              (js-call assert :strictEqual (get (get (get (get configured-auto :record) :execution) :runtimeOptions) :auto) 0))
            (put (get record :execution) :runtimeOptions (js-object :maxSlots 64))
            (js-call assert :strictEqual (prepareCompilerCorpusRuntimeContext context
              (compilerCorpusFunctionalResources record options)) context))
          (setq index (1+ index))))))

  (test "ordinary functional small programs retain matching memory and their source identity at prelaunch"
    (async ()
      (let* ((record (await (original-record "formatter-node")))
             (options (js-object :functionalRuntimeProfile "small"))
             (context (js-object :target "native" :record record :options options))
             (acceptance (compilerCorpusFunctionalResources record options))
             (configured (prepareCompilerCorpusRuntimeContext context acceptance))
             (resources (independentCompilerResources (js-object :profile "small"))))
        (js-call assert :deepStrictEqual (get (get configured :options) :memory) (get resources :memory))
        (js-call assert :deepStrictEqual (get (get configured :options) :memory)
          (get (compilerCorpusRequest record "native" options) :memory))
        (js-call assert :strictEqual (get (get configured :record) :original) (get record :original))
        (js-call assert :strictEqual (get (get configured :record) :modules) (get record :modules))
        (js-call assert :strictEqual (get (get configured :record) :expected) (get record :expected)))))
  (test "functional acceptance defers exactly six authenticated million-value recipes equally on all targets without passing or cancelling them"
    (async ()
      (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
             (records (get corpus :records))
             (ids (js-array "stable-compatibility:program:persistent-core-exit-vector"
               "stable-compatibility:program:persistent-core-exit-map" "stable-compatibility:program:persistent-core-exit-set"
               "original-program:portable-persistent-vector-1" "original-program:portable-persistent-map-2"
               "original-program:portable-persistent-set-2"))
             (options (js-object :functionalRuntimeProfile "small" :sourceAssets (get (get corpus :document) :evidence)))
             (selected (js-call ids :map (lambda (id)
               (let ((record (js-call records :find (lambda (record) (= (get record :id) id)))))
                 (js-call assert :ok record id) record))))
             (before (JSON/stringify selected)))
        (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (target)
          (let ((selection (classifyStage3Corpus records target options))
                (strict (classifyStage3Corpus records target)))
            (js-call assert :deepStrictEqual
              (js-call (get selection :resourceDeferred) :map (lambda (entry) (get entry :id)))
              (js-call (js-call records :filter (lambda (record) (js-call ids :includes (get record :id))))
                :map (lambda (record) (get record :id))))
            (js-call assert :strictEqual (js-length (get selection :resourceDeferred)) 6)
            (js-call assert :deepStrictEqual (get strict :resourceDeferred) (js-array))
            (js-call assert :deepStrictEqual (get selection :completeIds) (get strict :completeIds))
            (js-call selected :forEach (lambda (record)
              (let ((proof (compilerCorpusResourceDeferred record target options)))
                (js-call assert :strictEqual (get proof :status) "resource-deferred")
                (js-call assert :strictEqual (get proof :verification) "deferred")
                (js-call assert :strictEqual (get proof :target) target)
                (js-call assert :strictEqual (get proof :valueCount) 1000000)
                (js-call assert :strictEqual (get proof :fullCorpusVerification) "unverified")
                (js-call assert :strictEqual (js-call (get selection :effectiveIds) :includes (get record :id)) false)
                (js-call assert :strictEqual (js-call (get selection :cancelled) :some
                  (lambda (entry) (= (get entry :id) (get record :id)))) false)
                (js-call assert :strictEqual (compilerCorpusResourceDeferred record target (js-object)) undefined)
                (js-call assert :strictEqual (compilerCorpusResourceDeferred record target
                  (js-object :functionalRuntimeProfile "small" :runtimeOptions (js-object :maxSlots 64))) undefined)))))))
        (js-call assert :strictEqual (JSON/stringify selected) before)
        (let ((reference (aref selected 3)))
          (js-call (js-array
            (lambda (record) (put (get record :original) :sourceSha256 (js-call "0" :repeat 64)))
            (lambda (record) (put (aref (get (get record :original) :regions) 0) :sha256 (js-call "0" :repeat 64)))
            (lambda (record) (put (get record :execution) :hostSource
              (js-call (get (get record :execution) :hostSource) :replaceAll "1_000_000" "999_999"))))
            :forEach (lambda (mutate)
              (let ((record (globalThis.structuredClone reference)))
                (funcall mutate record)
                (js-call assert :throws (lambda () (compilerCorpusResourceDeferred record "wasm" options)) globalThis.TypeError))))
          (js-call assert :throws (lambda () (compilerCorpusResourceDeferred reference "wasm"
            (js-object :functionalRuntimeProfile "small" :sourceAssets (js-array)))) globalThis.TypeError))
        (js-call (js-array "vector" "map" "set") :forEach (lambda (name)
          (let* ((id (+ "original-program:portable-persistent-" name "-complete-hosts"))
                 (record (js-call records :find (lambda (record) (= (get record :id) id)))))
            (js-call assert :ok record id)
            (js-call assert :strictEqual (compilerCorpusResourceDeferred record "wasm" options) undefined)))))))
  (test "the unchanged twelve-thousand-layer walk has a bounded full profile for its retained graph while original capacity remains unaccepted"
    (async ()
      (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
             (records (get corpus :records))
             (ids (js-array "stable-compatibility:program:tests/fixtures/persistent-tree-walk.eli"
                    "original-program:persistent-tree-walk-complete-hosts"))
             (resources (independentCompilerResources (js-object :profile "full-compiler")))
             (options (js-object :functionalRuntimeProfile "small")) (index 0))
        (while (< index (js-length ids))
          (let* ((id (aref ids index)) (record (js-call records :find (lambda (item) (= (get item :id) id))))
                 (before (JSON/stringify record)) (acceptance (compilerCorpusFunctionalResources record options))
                 (context (js-object :record record :options options))
                 (configured (prepareCompilerCorpusRuntimeContext context acceptance)))
            (js-call assert :ok record id)
            (js-call assert :strictEqual (get acceptance :effectiveRuntimeProfile) "full-compiler")
            (js-call assert :strictEqual (get acceptance :resourceAcceptance) "deferred")
            (js-call assert :strictEqual (get (get acceptance :originalRuntimeOptions) :maxSlots) 1024)
            (js-call assert :deepStrictEqual (get acceptance :effectiveRuntimeOptions)
              (Object/assign (js-object) (get resources :budget) (js-object :auto (get resources :auto))))
            (js-call assert :deepStrictEqual (get (get configured :options) :memory) (get resources :memory))
            (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (target)
              (if (= target "javascript")
                (js-call assert :strictEqual (get (compilerCorpusRequest record target options) :memory) undefined)
                (js-call assert :deepStrictEqual (get (compilerCorpusRequest record target options) :memory) (get resources :memory)))
              (js-call assert :strictEqual (compilerCorpusResourceDeferred record target options) undefined)))
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record (js-object)) undefined)
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record
              (js-object :functionalRuntimeProfile "small" :runtimeOptions (js-object :maxSlots 64))) undefined)
            (js-call assert :strictEqual (JSON/stringify record) before)
            (let* ((changed (globalThis.structuredClone record))
                   (module (js-call (get changed :modules) :find
                     (lambda (item) (= (get item :filename) "tests/fixtures/persistent-tree-walk.eli")))))
              (js-call assert :ok module)
              (put module :source (js-call (get module :source) :replace "(depth 12000)" "(depth 12001)"))
              (js-call assert :strictEqual (get (compilerCorpusFunctionalResources changed options) :effectiveRuntimeProfile) "small")))
          (setq index (1+ index))))))
)
