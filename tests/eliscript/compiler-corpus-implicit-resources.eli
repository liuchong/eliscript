(module tests.compiler-corpus-implicit-resources
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:crypto" createHash)
  (import "../tools/backends/build.mjs" root loadLiteralSources)
  (import "../tools/backends/compiler-build.mjs" independentCompilerResources loadCompilerSources buildIndependentCompiler decodeCompilerBinary compilerMetadataDigest)
  (import "../tools/backends/compiler-bootstrap.mjs" compilerSourceIdentity openCompilerArtifact)
  (import "../tools/backends/compiler-metadata.mjs" readCompilerMetadata)
  (import "../tools/backends/compiler-session.mjs" isOwnedCompilerBuildProduct encodeCompilerIR)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/backends/managed-runtime.mjs" createManagedModuleGraph loadManagedProjectGraph)
  (import "../tools/testing/original-regression-product.mjs" originalCompilerProductRequest requestOriginalCompilerProduct)
  (import "../tools/testing/fixture-environment.mjs" prepareFixtureEnvironment)
  (import "../tools/backends/compiler-corpus.mjs" compilerCorpusFunctionalResources compilerCorpusRequest compilerCorpusResourceDeferred)
  (import "../tools/backends/compiler-matrix.mjs" loadCompilerMatrixCorpus classifyStage3Corpus archiveProduct)
  (import "../tools/backends/compiler-corpus-execution.mjs" prepareCompilerCorpusRuntimeContext prepareOriginalSeedCorpusRecord)
  (defun digest (text) (js-call (js-call (createHash "sha256") :update text) :digest "hex"))
  (test "all six complete original regression records select packed binary transport without changing any source request or resource contract"
    (async ()
      (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
             (literal-sources (await (loadLiteralSources)))
             (options (js-object :functionalRuntimeProfile "small" :profile "small"
               :sourceAssets (get (get corpus :document) :evidence) :literalSources literal-sources))
             (ids (js-array "stable-compatibility:program:tests/fixtures/persistent-zipper.eli"
               "original-program:stdlib-object-complete-host" "original-program:persistent-zipper-complete-hosts"
               "original-program:persistent-zipper-indexed-ascent" "original-program:portable-persistent-list-1"
               "original-program:portable-value-2"))
             (saved-options (globalThis.structuredClone options)))
        (js-call ids :forEach (lambda (id)
          (let* ((matches (js-call (get corpus :records) :filter (lambda (record) (= (get record :id) id))))
                 (record (aref matches 0)) (saved (globalThis.structuredClone record)))
            (js-call assert :strictEqual (js-length matches) 1)
            (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (target)
              (let* ((ordinary (compilerCorpusRequest record target options))
                     (packed (originalCompilerProductRequest record target options))
                     (expected (Object/assign (js-object) ordinary)))
                (unless (= target "javascript") (put expected :binaryEncoding "u16le-chunks"))
                (js-call assert :deepStrictEqual packed expected)
                (when (= target "javascript") (js-call assert :strictEqual (Object/hasOwn packed "binaryEncoding") false)))))
            (js-call assert :deepStrictEqual record saved))))
        (js-call assert :deepStrictEqual options saved-options))))
  (test "original product dispatch preserves ordinary session options return values and every first thrown identity"
    (lambda ()
      (let* ((calls (js-array)) (sentinel (Object/freeze (js-object :result t)))
             (options (js-object :signal (js-object :original t)))
             (session (js-object :request (lambda (request actual-options)
               (js-call calls :push (js-array request actual-options)) sentinel))))
        (js-call (js-array (js-object :operation "runtime") (js-object :operation "capabilities")
          (js-object :operation "project" :target "javascript") (js-object :operation "project" :target "native"))
          :forEach (lambda (request)
            (js-call assert :strictEqual (requestOriginalCompilerProduct session request options) sentinel)
            (js-call assert :strictEqual (aref (aref calls (1- (js-length calls))) 0) request)
            (js-call assert :strictEqual (aref (aref calls (1- (js-length calls))) 1) options)))
        (js-call (js-array undefined nil false 0 "original failure" (new globalThis.Error "original failure"))
          :forEach (lambda (marker)
            (let ((caught false))
              (put session :request (lambda (&rest ignored) (throw marker)))
              (try (requestOriginalCompilerProduct session (js-object :operation "project" :target "native") options)
                (catch error (setq caught t) (js-call assert :strictEqual error marker)))
              (js-call assert :strictEqual caught t)))))))
  (test "real selected compiler native object and library owned products retain every ordinary byte typed node debug field and archive hash"
    (async ()
      (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
             (directory (get fixture :directory)) (sessions (js-array)))
        (try
          (let* ((artifact (await (buildIndependentCompiler (js-object :host "javascript" :profile "full-compiler"
                    :outputRoot (resolve directory "compiler") :retainIR false :debug false))))
                 (modules (js-array (js-object :id "original.mjs" :filename "original-中文😀.eli"
                   :source "(defun negative-zero () -0.0) (defun echo (value) (js-array value value)) (export negative-zero echo)"))))
            (let ((index 0))
              (while (< index 2)
                (let* ((format (aref (js-array "object" "library") index))
                       (ordinary-session (await (openCompilerArtifact artifact)))
                       (owned-session (await (openCompilerArtifact artifact)))
                       (request (js-object :operation "project" :target "native" :entry "original.mjs"
                         :modules modules :resolveImports t :phased t :debug t :sourceMap t
                         :nativeTarget "arm64-macos" :nativeFormat format
                         :memory (js-object :initialPages 2 :maximumPages 8)))
                       (saved (globalThis.structuredClone request)))
                  (js-call sessions :push ordinary-session owned-session)
                  (await (js-call ordinary-session :request (js-object :operation "runtime")))
                  (await (js-call owned-session :request (js-object :operation "runtime")))
                  (let* ((ordinary (await (js-call ordinary-session :request request)))
                         (packed-request (Object/assign (js-object) request (js-object :binaryEncoding "u16le-chunks")))
                         (owned (await (requestOriginalCompilerProduct owned-session packed-request)))
                         (bytes (decodeCompilerBinary (get owned :bytes)))
                         (ordinary-bytes (decodeCompilerBinary (get ordinary :bytes))))
                    (js-call assert :strictEqual (isOwnedCompilerBuildProduct owned) t)
                    (js-call assert :strictEqual (isOwnedCompilerBuildProduct ordinary) false)
                    (js-call assert :strictEqual (Array/isArray (get ordinary :bytes)) t)
                    (js-call assert :strictEqual (get (get owned :bytes) :encoding) "u16le-chunks")
                    (js-call assert :deepStrictEqual bytes ordinary-bytes)
                    (js-call assert :deepStrictEqual (Object/assign (js-object) owned (js-object :bytes nil))
                      (Object/assign (js-object) ordinary (js-object :bytes nil)))
                    (let* ((seen (new globalThis.WeakSet)) (pending (js-array (get owned :typed) (get owned :debug)))
                           (number-function (js-call (get (get owned :typed) :functions) :find
                             (lambda (function) (= (get function :name) "value-number"))))
                           (shared 0) (negative-zero-bits false))
                      (js-call assert :ok number-function "the real typed ABI contains its managed number constructor")
                      (while (> (js-length pending) 0)
                        (let ((value (js-call pending :pop)))
                          (when (and value (= (value-type value) "object"))
                            (if (js-call seen :has value) (setq shared (1+ shared))
                              (progn
                                (js-call seen :add value)
                                ;; Managed numeric literals are a value-number
                                ;; call with exact low/high u32 words, rather
                                ;; than a host f64 number in the typed graph.
                                (when (and (= (get value :kind) "call")
                                           (= (get value :value) (get number-function :index))
                                           (= (js-length (get value :children)) 3))
                                  (let* ((children (get value :children))
                                         (low (aref children 1)) (high (aref children 2)))
                                    (when (and (= (get low :kind) "literal") (= (get low :type) "u32")
                                               (= (get low :value) 0)
                                               (= (get high :kind) "literal") (= (get high :type) "u32")
                                               (= (get high :value) 2147483648))
                                      (setq negative-zero-bits t))))
                                (js-call (Object/values value) :forEach (lambda (child) (js-call pending :push child))))))))
                      (js-call assert :ok (> shared 0) "real lowered typed/debug data retains its shared graph")
                      (js-call assert :strictEqual negative-zero-bits t "managed negative zero retains the exact IEEE sign bit"))
                    (let ((numbers (get (JSON/parse (encodeCompilerIR (js-object :typed (get owned :typed)
                                      :numbers (js-array -0.0 globalThis.NaN)))) :numbers)))
                      (js-call assert :strictEqual (Object/is (aref numbers 0) -0.0) t)
                      (js-call assert :strictEqual (aref numbers 1) nil))
                    (let* ((ordinary-archive (await (archiveProduct ordinary "native" (resolve directory format "ordinary"))))
                           (owned-archive (await (archiveProduct owned "native" (resolve directory format "owned")))))
                      (js-call assert :deepStrictEqual (new globalThis.Uint8Array (await (readFile (get owned-archive :path)))) bytes)
                      (js-call (js-array "sha256" "bytes" "typedSha256" "descriptorSha256" "debugSha256" "nativeTarget" "nativeFormat")
                        :forEach (lambda (key) (js-call assert :strictEqual (get owned-archive key) (get ordinary-archive key))))
                      (let ((field 0))
                        (while (< field 3)
                          (let* ((name (aref (js-array "typed" "descriptor" "debug") field))
                                 (actual (await (readCompilerMetadata (resolve directory format "owned" (str name ".json"))))))
                            (js-call assert :deepStrictEqual actual (get owned name))
                            (js-call assert :strictEqual (compilerMetadataDigest actual) (get owned-archive (str name "Sha256"))))
                          (setq field (1+ field))))
                      (let* ((facades (get owned-archive :facades)) (position 0))
                        (js-call assert :ok (> (js-length facades) 0) "the actual archive deployed every managed project facade")
                        (while (< position (js-length facades))
                          (let ((facade (aref facades position)))
                            (js-call assert :strictEqual (get facade :path)
                              (resolve (get owned-archive :directory) (get facade :id)))
                            (js-call assert :strictEqual (digest (await (readFile (get facade :path)))) (get facade :sha256)))
                          (setq position (1+ position)))
                        (js-call (js-array "entry" "facadeRegistry" "facadeEntry") :forEach (lambda (key)
                          (js-call assert :ok (js-call facades :some
                            (lambda (facade) (= (get facade :id) (get owned-archive key))))
                            (str "the real archived project requires its deployed " key)))))
                      (when (= format "library")
                        (let* ((descriptor (get owned :descriptor))
                               (graph (createManagedModuleGraph descriptor))
                               (configuration (Object/assign (js-object) (get request :memory)
                                 (js-object :nativeTarget (get request :nativeTarget) :debug (get owned :debug)
                                   :moduleGraph graph :projectEntry (get owned-archive :entry)
                                   :moduleBaseURL (get (pathToFileURL (get owned-archive :path)) :href)
                                   :projectModuleBaseURL (get (pathToFileURL (str (get owned-archive :directory) "/")) :href)
                                   :maxSlots 256 :initialBytes 16384 :maxBytes 262144 :auto 1)))
                               (runtime undefined) (failed false) (failure undefined))
                          (try
                            ;; Keep default initialization: the actual registry
                            ;; and entry imports prepare every source module.
                            (setq runtime (await (instantiateNativeManagedRuntime (get owned-archive :path)
                              (js-object :typed (get owned :typed) :descriptor descriptor) configuration)))
                            (let* ((loaded (await (loadManagedProjectGraph runtime descriptor configuration)))
                                   (namespace (get loaded :namespace)))
                              (js-call assert :strictEqual (get loaded :runtime) runtime)
                              (js-call assert :strictEqual (get loaded :graph) graph)
                              (js-call assert :strictEqual (await (loadManagedProjectGraph runtime descriptor configuration)) loaded
                                "the completed real project initialization is reused without attaching a second graph")
                              (js-call assert :strictEqual (value-type (get namespace :negative_zero)) "function")
                              (js-call assert :strictEqual (Object/is (js-call namespace :negative_zero) -0.0) t
                                "the actual initialized native ESM facade returns negative zero"))
                            (js-call runtime :closeModule) (js-call runtime :collect)
                            (js-call assert :strictEqual (js-call runtime :live) 0)
                            (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                            (catch error (setq failed t failure error))
                            (finally
                              (when runtime
                                (try (js-call runtime :close)
                                  (catch error (unless failed (setq failed t failure error)))))
                              (try (js-call graph :close)
                                (catch error (unless failed (setq failed t failure error))))))
                          (when failed (throw failure)))))
                    (js-call assert :deepStrictEqual request saved)
                    (let* ((wrapper (js-object :request (lambda (&rest arguments)
                                      (Reflect/apply (get owned-session :request) owned-session arguments))))
                           (public (await (requestOriginalCompilerProduct wrapper packed-request))))
                      (js-call assert :strictEqual (isOwnedCompilerBuildProduct public) false)
                      (js-call assert :deepStrictEqual (decodeCompilerBinary (get public :bytes)) bytes)
                      (js-call assert :deepStrictEqual (get public :typed) (get owned :typed))))
                  (await (js-call ordinary-session :close)) (await (js-call owned-session :close)))
                (setq index (1+ index)))))
          (finally
            (let ((index 0)) (while (< index (js-length sessions))
              (await (js-call (aref sessions index) :close)) (setq index (1+ index))))
            (js-call fixture :close))))))
  (defasync original-record (name)
    (let* ((formatter (= name "formatter-node"))
           (suite (if formatter "tests/bootstrap-formatter.test.mjs" "tests/macro-generated-names.test.mjs"))
           (filename (if formatter "bootstrap/compiler/formatter.eli" "generated-names.eli"))
           (entry (if formatter "bootstrap/compiler/formatter.mjs" "generated-names.mjs"))
           (suite-source (await (readFile (resolve root suite) "utf8")))
           (source (if formatter (await (readFile (resolve root filename) "utf8"))
             "(defconst original 1) (defun read () original) (export read)"))
           (bytes (get (globalThis.Buffer.from suite-source) :length)))
      ;; The classification consumes the source-bound recipe shape. Matrix
      ;; corpus authentication still verifies all archived source bytes first;
      ;; this helper does not grant verification to a caller-created record.
      (js-object :id (+ "original-program:" name) :kind "project" :entry entry
        :modules (js-array (js-object :id entry :filename filename :source source))
        :request (js-object :operation "project")
        :execution (js-object :kind "original-program")
        :expected (js-object :kind "seed-program" :oracleRequired t)
        :original (js-object :suite suite :fixture (if formatter filename suite) :host suite
          :sourceSha256 (digest suite-source)
          :regions (js-array (js-object :start 0 :end (js-length suite-source) :byteStart 0 :byteEnd bytes :sha256 (digest suite-source)))))))

  (test "the three source-bound positive tool programs admit only an explicit functional profile and keep their implicit capacity evidence"
    (async ()
      (let ((names (js-array "formatter-node" "macro-generated-names-bun" "macro-generated-names-node"))
            (resources (independentCompilerResources (js-object :profile "small"))) (index 0))
        (while (< index (js-length names))
          (let* ((record (await (original-record (aref names index))))
                 (before (globalThis.structuredClone record)) (options (js-object :functionalRuntimeProfile "small"))
                 (actual (compilerCorpusFunctionalResources record options)))
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record (js-object)) undefined)
            (js-call assert :deepStrictEqual (get actual :originalRuntimeOptions)
              (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216 :auto 0))
            (js-call assert :deepStrictEqual (get actual :effectiveRuntimeOptions)
              (Object/assign (js-object) (get resources :budget) (js-object :auto (get resources :auto))))
            (js-call assert :strictEqual (get actual :resourceAcceptance) "deferred")
            (js-call assert :strictEqual (Object/hasOwn actual "verification") false)
            (js-call (js-array "wasm" "native") :forEach (lambda (target)
              (js-call assert :deepStrictEqual (get (compilerCorpusRequest record target options) :memory) (get resources :memory))))
            (put record :auto 0)
            (js-call assert :strictEqual (get (get (compilerCorpusFunctionalResources record options) :effectiveRuntimeOptions) :auto) 0)
            (Reflect/deleteProperty record "auto")
            (js-call assert :deepStrictEqual record before))
          (setq index (1+ index))))))

  (test "implicit tool resources cannot admit an unbound recipe diagnostics explicit capacity or a different original program"
    (async ()
      (let ((mutations (js-array
        (lambda (record) (put record :id "original-program:formatter-capacity-recovery"))
        (lambda (record) (put (get record :original) :suite "tests/unrelated.test.mjs"))
        (lambda (record) (put (get record :original) :fixture "unrelated.eli"))
        (lambda (record) (put (get record :original) :host "tests/unrelated.test.mjs"))
        (lambda (record) (put (get record :original) :sourceSha256 "bad"))
        (lambda (record) (put (get record :original) :regions (js-array)))
        (lambda (record) (put (aref (get (get record :original) :regions) 0) :sha256 "bad"))
        (lambda (record) (put record :entry "other.mjs"))
        (lambda (record) (put (aref (get record :modules) 0) :filename "other.eli"))
        (lambda (record) (put record :error (js-object :code "ELI-RT0002")))
        (lambda (record) (put (get record :expected) :oracleRequired false))
        (lambda (record) (put (get record :expected) :kind "diagnostic"))
        (lambda (record) (put (get record :execution) :runtimeOptions (js-object :maxSlots 64)))
        (lambda (record) (put (get record :execution) :runtimeOptions (js-object :initialBytes 4096)))
        (lambda (record) (put (get record :execution) :runtimeOptions (js-object :maxBytes 16384)))
        (lambda (record) (put (get record :execution) :runtimeProfile "compiler"))
        (lambda (record) (put record :kind "sequence")))) (index 0))
        (while (< index (js-length mutations))
          (let ((record (await (original-record "formatter-node"))))
            (funcall (aref mutations index) record)
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record (js-object :functionalRuntimeProfile "small")) undefined))
          (setq index (1+ index)))
        (let ((record (await (original-record "macro-generated-names-node"))))
          (js-call assert :strictEqual (compilerCorpusFunctionalResources record
            (js-object :functionalRuntimeProfile "small" :runtimeOptions (js-object :maxSlots 64))) undefined)
          (js-call assert :throws (lambda () (compilerCorpusFunctionalResources record
            (js-object :functionalRuntimeProfile "unrecognized"))) globalThis.TypeError)))))
  (test "the three source-bound persistent core exit hosts retain explicit capacity refusals and raw recipe identity"
    (async ()
      (let ((source (await (readFile (resolve root "stdlib/value.eli") "utf8")))
            (options (js-object :functionalRuntimeProfile "small")))
        (js-call (js-array "vector" "map" "set") :forEach (lambda (name)
          (let* ((record (js-object :id (+ "stable-compatibility:program:persistent-core-exit-" name)
                   :kind "project" :entry "value.mjs"
                   :modules (js-array (js-object :id "value.mjs" :filename "stdlib/value.eli" :source source))
                   :execution (js-object :kind "original-program")
                   :expected (js-object :kind "seed-program" :oracleRequired t)
                   :original (js-object :manifest "stable-compatibility" :fixture "stdlib/value.eli"
                     :host "tests/fixtures/persistent-core-exit-host.mjs")))
                 (before (globalThis.structuredClone record)))
            (js-call assert :strictEqual (get (compilerCorpusFunctionalResources record options) :resourceAcceptance) "deferred")
            (js-call assert :deepStrictEqual record before)
            (put (get record :execution) :runtimeOptions (js-object :maxSlots 64))
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record options) undefined)
            (Reflect/deleteProperty (get record :execution) "runtimeOptions")
            (put (get record :original) :host "tests/fixtures/other-host.mjs")
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record options) undefined)))))))
  (test "functional prelaunch transports the same linear memory as each original million compilation without changing its heap budget"
    (async ()
      (let ((source (await (readFile (resolve root "stdlib/value.eli") "utf8")))
            (profiles (js-array "vector" "map" "set")) (index 0))
        (while (< index (js-length profiles))
          (let* ((name (aref profiles index))
                 (record (js-object :id (+ "stable-compatibility:program:persistent-core-exit-" name)
                   :kind "project" :entry "value.mjs"
                   :modules (js-array (js-object :id "value.mjs" :filename "stdlib/value.eli" :source source))
                   :request (js-object :operation "project")
                   :execution (js-object :kind "original-program" :host "tests/fixtures/persistent-core-exit-host.mjs"
                     :arguments (js-array (js-object :directory t) (js-object :literal name)))
                   :expected (js-object :kind "seed-program" :oracleRequired t)
                   :original (js-object :manifest "stable-compatibility" :fixture "stdlib/value.eli"
                     :host "tests/fixtures/persistent-core-exit-host.mjs")))
                 (before (globalThis.structuredClone record))
                 (options (js-object :functionalRuntimeProfile "small" :node "actual-node"))
                 (context (js-object :target "native" :record record :options options))
                 (acceptance (compilerCorpusFunctionalResources record options))
                 (configured (prepareCompilerCorpusRuntimeContext context acceptance))
                 (request (compilerCorpusRequest record "native" options))
                 (resources (independentCompilerResources (js-object :profile "full-compiler"))))
            (js-call assert :strictEqual (get acceptance :resourceAcceptance) "deferred")
            (js-call assert :strictEqual (get acceptance :effectiveRuntimeProfile) "full-compiler")
            (js-call assert :deepStrictEqual (get (get configured :options) :memory) (get request :memory))
            (js-call assert :deepStrictEqual (get (get configured :options) :memory) (get resources :memory))
            (js-call assert :strictEqual (get (get configured :options) :node) "actual-node")
            (js-call assert :deepStrictEqual (get (get (get configured :record) :execution) :runtimeOptions)
              (get acceptance :effectiveRuntimeOptions))
            (js-call assert :strictEqual (prepareCompilerCorpusRuntimeContext context undefined) context)
            (js-call assert :deepStrictEqual record before)
            (js-call assert :deepStrictEqual options (js-object :functionalRuntimeProfile "small" :node "actual-node"))
            (put record :memory (js-object :initialPages 1 :maximumPages 2))
            (let ((explicit (prepareCompilerCorpusRuntimeContext context acceptance)))
              (js-call assert :strictEqual (get (get explicit :options) :memory) (get record :memory))
              (js-call assert :deepStrictEqual (get (get explicit :options) :memory)
                (get (compilerCorpusRequest record "native" options) :memory)))
            (Reflect/deleteProperty record "memory")
            (put record :auto 0)
            (let* ((strict-auto (compilerCorpusFunctionalResources record options))
                   (configured-auto (prepareCompilerCorpusRuntimeContext context strict-auto)))
              (js-call assert :strictEqual (get (get (get (get configured-auto :record) :execution) :runtimeOptions) :auto) 0))
            (put (get record :execution) :runtimeOptions (js-object :maxSlots 64))
            (js-call assert :strictEqual (prepareCompilerCorpusRuntimeContext context
              (compilerCorpusFunctionalResources record options)) context))
          (setq index (1+ index))))))

  (test "complete positive library programs use a bounded functional heap without accepting their original capacity gate"
    (async ()
      (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
             (options (js-object :functionalRuntimeProfile "small"))
             (resources (independentCompilerResources (js-object :profile "full-compiler")))
             (fixtures (js-array "stdlib/result.eli" "stdlib/multimethod.eli" "stdlib/persistent-list.eli"
               "stdlib/persistent-vector.eli" "stdlib/persistent-map.eli" "stdlib/persistent-set.eli"
               "stdlib/value.eli" "tests/fixtures/map-patterns.eli")))
        (js-call fixtures :forEach (lambda (fixture)
          (let* ((id (str "stable-compatibility:program:" fixture))
                 (record (js-call (get corpus :records) :find (lambda (item) (= (get item :id) id))))
                 (before (JSON/stringify record))
                 (actual (compilerCorpusFunctionalResources record options)))
            (js-call assert :ok record id)
            (js-call assert :strictEqual (get actual :effectiveRuntimeProfile) "full-compiler")
            (js-call assert :strictEqual (get actual :resourceAcceptance) "deferred")
            (js-call assert :strictEqual (Object/hasOwn actual "verification") false)
            (js-call (js-array "wasm" "native") :forEach (lambda (target)
              (js-call assert :deepStrictEqual (get (compilerCorpusRequest record target options) :memory)
                (get resources :memory))))
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record (js-object)) undefined)
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record
              (js-object :functionalRuntimeProfile "small" :runtimeOptions (js-object :maxSlots 64))) undefined)
            (js-call assert :strictEqual (JSON/stringify record) before)
            (js-call (js-array
                (lambda (changed) (put (aref (get changed :modules) 0) :source
                  (str (get (aref (get changed :modules) 0) :source) "\n")))
                (lambda (changed) (put (get changed :execution) :hostSource
                  (str (get (get changed :execution) :hostSource) "\n")))
                (lambda (changed) (put (get changed :request) :entry "unrelated.mjs"))
                (lambda (changed) (put changed :entry "unrelated.mjs"))
                (lambda (changed) (put changed :modules (js-array)))
                (lambda (changed) (put (js-call (get changed :modules) :find
                  (lambda (module) (= (get module :id) (get changed :entry)))) :filename "unrelated.eli"))
                (lambda (changed) (js-call (get changed :modules) :pop))) :forEach
              (lambda (change)
                (let ((changed (globalThis.structuredClone record)))
                  (funcall change changed)
                  (js-call assert :throws (lambda () (compilerCorpusFunctionalResources changed options)) globalThis.TypeError))))
            (let ((changed (globalThis.structuredClone record)))
              (put (get changed :original) :fixture "tests/fixtures/unrelated.eli")
              (js-call assert :strictEqual (compilerCorpusFunctionalResources changed options) undefined))))))))

  (test "the complete original zipper Seed dependency graph rebinds resources only after authenticating the original and every expanded input"
    (async ()
      (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
             (id "stable-compatibility:program:tests/fixtures/persistent-zipper.eli")
             (record (js-call (get corpus :records) :find (lambda (item) (= (get item :id) id))))
             (before (JSON/stringify record))
             (assets (get (get corpus :document) :evidence))
             (sources (await (loadCompilerSources (js-object :sourceRoot root))))
             (identity (compilerSourceIdentity sources))
             (configuration (js-object :sourceAssets assets :functionalRuntimeProfile "small"
               :literalSources (get sources :literalSources) :literalSourceIdentity (get identity :literalSources)))
             (expanded (prepareOriginalSeedCorpusRecord record configuration))
             (proof (get (get expanded :original) :functionalResourceInputs)))
        (js-call assert :notStrictEqual expanded record)
        (js-call assert :strictEqual (JSON/stringify record) before)
        (js-call assert :strictEqual (get (compilerCorpusFunctionalResources expanded configuration) :effectiveRuntimeProfile) "full-compiler")
        (js-call assert :strictEqual (get proof :modulesSha256) (digest (JSON/stringify (get expanded :modules))))
        (js-call assert :strictEqual (get proof :requestSha256) (digest (JSON/stringify (get expanded :request))))
        (js-call assert :strictEqual (get proof :executionSha256) (digest (JSON/stringify (get expanded :execution))))
        (let ((changed (globalThis.structuredClone record)))
          (put (aref (get changed :modules) 0) :source (str (get (aref (get changed :modules) 0) :source) "\n"))
          (js-call assert :throws (lambda () (prepareOriginalSeedCorpusRecord changed configuration)) globalThis.TypeError))
        (let* ((changed (js-call assets :slice))
               (filename (get (aref (get record :modules) 0) :filename))
               (at (js-call changed :findIndex (lambda (asset) (= (get asset :file) filename)))))
          (js-call assert :ok (>= at 0))
          (put changed at (Object/assign (js-object) (aref changed at) (js-object :content "AA==")))
          (js-call assert :throws (lambda () (prepareOriginalSeedCorpusRecord record
            (Object/assign (js-object) configuration (js-object :sourceAssets changed)))) globalThis.TypeError))
        (js-call assert :strictEqual (JSON/stringify record) before))))

  (test "ordinary functional small programs retain matching memory and their source identity at prelaunch"
    (async ()
      (let* ((record (await (original-record "formatter-node")))
             (options (js-object :functionalRuntimeProfile "small"))
             (context (js-object :target "native" :record record :options options))
             (acceptance (compilerCorpusFunctionalResources record options))
             (configured (prepareCompilerCorpusRuntimeContext context acceptance))
             (resources (independentCompilerResources (js-object :profile "small"))))
        (js-call assert :deepStrictEqual (get (get configured :options) :memory) (get resources :memory))
        (js-call assert :deepStrictEqual (get (get configured :options) :memory)
          (get (compilerCorpusRequest record "native" options) :memory))
        (js-call assert :strictEqual (get (get configured :record) :original) (get record :original))
        (js-call assert :strictEqual (get (get configured :record) :modules) (get record :modules))
        (js-call assert :strictEqual (get (get configured :record) :expected) (get record :expected)))))
  (test "only explicit functional performance deferral retains three authenticated binary zipper stress jobs as unverified"
    (async ()
      (let* ((environment (get globalThis.process :env))
             (had-flag (Object/hasOwn environment "ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE"))
             (saved-flag (get environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE))
             (corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
             (records (get corpus :records))
             (ids (js-array "stable-compatibility:program:tests/fixtures/persistent-zipper.eli"
               "original-program:persistent-zipper-complete-hosts" "original-program:persistent-zipper-indexed-ascent"))
             (options (js-object :functionalRuntimeProfile "small" :sourceAssets (get (get corpus :document) :evidence)))
             (selected (js-call ids :map (lambda (id)
               (let ((record (js-call records :find (lambda (item) (= (get item :id) id)))))
                 (js-call assert :ok record id) record))))
             (before (JSON/stringify selected)) (options-before (JSON/stringify options)))
        (try
          (put environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1")
          (js-call selected :forEach (lambda (record)
            (if (= (get record :id) "stable-compatibility:program:tests/fixtures/persistent-zipper.eli")
              ;; The ordinary archived program has a complete host, not a
              ;; synthetic suite region. Its actual shape must remain intact.
              (js-call assert :strictEqual (Object/hasOwn (get record :original) "suite") false)
              (progn
                (js-call assert :strictEqual (get (get record :original) :suite) "tests/persistent-zipper.test.mjs")
                (js-call (js-array "suite" "suite-hash" "region") :forEach (lambda (change)
                  (let* ((changed (globalThis.structuredClone record)) (original (get changed :original)))
                    (cond
                      ((= change "suite") (put original :suite "tests/changed-suite.mjs"))
                      ((= change "suite-hash") (put original :sourceSha256 (js-call "0" :repeat 64)))
                      (t (put (aref (get original :regions) 0) :sha256 (js-call "0" :repeat 64))))
                    (js-call assert :throws (lambda () (compilerCorpusResourceDeferred changed "wasm" options)) globalThis.TypeError))))))
            (js-call assert :strictEqual (compilerCorpusResourceDeferred record "javascript" options) undefined)
            (js-call assert :strictEqual (compilerCorpusResourceDeferred record "wasm" (js-object)) undefined)
            (js-call assert :strictEqual (compilerCorpusResourceDeferred record "native"
              (js-object :functionalRuntimeProfile "small")) undefined)
            (js-call assert :strictEqual (compilerCorpusResourceDeferred record "native"
              (Object/assign (js-object) options (js-object :runtimeOptions (js-object :maxSlots 64)))) undefined)
            (js-call (js-array "wasm" "native") :forEach (lambda (target)
              (let ((receipt (compilerCorpusResourceDeferred record target options)))
                (js-call assert :strictEqual (get receipt :id) (get record :id))
                (js-call assert :strictEqual (get receipt :target) target)
                (js-call assert :strictEqual (get receipt :status) "resource-deferred")
                (js-call assert :strictEqual (get receipt :verification) "deferred")
                (js-call assert :strictEqual (get receipt :functionalVerification) "unverified")
                (js-call assert :strictEqual (get receipt :fullCorpusVerification) "unverified")
                (js-call assert :strictEqual (get receipt :performanceAcceptance) "failed")
                (js-call assert :strictEqual (get receipt :scope) "complete-original-zipper-stress-family")
                (js-call assert :deepStrictEqual (get receipt :inputIdentity) (get (get record :original) :functionalResourceInputs))
                (js-call assert :strictEqual (get receipt :hostSourceSha256) (digest (get (get record :execution) :hostSource)))
                (js-call assert :ok (> (js-length (get receipt :sourceProofs)) 0))
                (js-call assert :strictEqual (Object/hasOwn receipt "depth") false))))
            (js-call (js-array "entry" "dependency" "request" "host" "binding" "missing-entry" "renamed-entry") :forEach
              (lambda (change)
                (let* ((changed (globalThis.structuredClone record))
                       (modules (get changed :modules))
                       (entry (js-call modules :find (lambda (item) (= (get item :id) (get changed :entry))))))
                  (cond
                    ((= change "entry") (put entry :source (str (get entry :source) "\n")))
                    ((= change "dependency") (let ((dependency (js-call modules :find
                        (lambda (item) (/= (get item :id) (get changed :entry))))))
                      (js-call assert :ok dependency)
                      (put dependency :source (str (get dependency :source) "\n"))))
                    ((= change "request") (put (get changed :request) :sourceMap false))
                    ((= change "host") (put (get changed :execution) :hostSource (str (get (get changed :execution) :hostSource) "\n")))
                    ((= change "binding") (Reflect/deleteProperty (get changed :original) "functionalResourceInputs"))
                    ((= change "missing-entry") (put changed :modules (js-call modules :filter (lambda (item) (/= item entry)))))
                    (t (put entry :filename "changed.eli")))
                  (js-call assert :throws (lambda () (compilerCorpusResourceDeferred changed "wasm" options)) globalThis.TypeError))))
            (let ((unknown (globalThis.structuredClone record)))
              (put unknown :id "original-program:unknown-zipper-stress")
              (js-call assert :strictEqual (compilerCorpusResourceDeferred unknown "wasm" options) undefined))
            (js-call assert :throws (lambda () (compilerCorpusResourceDeferred record "wasm"
              (js-object :functionalRuntimeProfile "small" :sourceAssets (js-array)))) globalThis.TypeError)
            (let* ((proofs (globalThis.structuredClone (get options :sourceAssets)))
                   (fixture (get (get record :original) :fixture))
                   (proof (js-call proofs :find (lambda (asset) (= (get asset :file) fixture)))))
              (js-call assert :ok proof)
              (put proof :sha256 (js-call "0" :repeat 64))
              (js-call assert :throws (lambda () (compilerCorpusResourceDeferred record "native"
                (js-object :functionalRuntimeProfile "small" :sourceAssets proofs))) globalThis.TypeError))))
          (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (target)
            (let* ((selection (classifyStage3Corpus records target options))
                   (strict (classifyStage3Corpus records target))
                   (receipts (js-call (get selection :resourceDeferred) :filter (lambda (entry) (js-call ids :includes (get entry :id))))))
              (js-call assert :deepStrictEqual (get selection :completeIds) (get strict :completeIds))
              (js-call assert :deepStrictEqual (js-call receipts :map (lambda (entry) (get entry :id)))
                (if (= target "javascript") (js-array)
                  (js-call (js-call records :filter (lambda (record) (js-call ids :includes (get record :id)))) :map (lambda (record) (get record :id)))))
              (js-call receipts :forEach (lambda (receipt)
                (js-call assert :strictEqual (js-call (get selection :effectiveIds) :includes (get receipt :id)) false)
                (js-call assert :strictEqual (js-call (get selection :cancelled) :some
                  (lambda (entry) (= (get entry :id) (get receipt :id)))) false))))))
          (js-call (js-array "0" "") :forEach (lambda (flag)
            (put environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE flag)
            (js-call selected :forEach (lambda (record)
              (js-call assert :strictEqual (compilerCorpusResourceDeferred record "wasm" options) undefined)))))
          (Reflect/deleteProperty environment "ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE")
          (js-call selected :forEach (lambda (record)
            (js-call assert :strictEqual (compilerCorpusResourceDeferred record "native" options) undefined)))
          (js-call assert :strictEqual (JSON/stringify selected) before)
          (js-call assert :strictEqual (JSON/stringify options) options-before)
          (finally
            (if had-flag (put environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE saved-flag)
              (Reflect/deleteProperty environment "ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE")))))))
  (test "functional acceptance defers exactly six authenticated million-value recipes equally on all targets without passing or cancelling them"
    (async ()
      (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
             (records (get corpus :records))
             (ids (js-array "stable-compatibility:program:persistent-core-exit-vector"
               "stable-compatibility:program:persistent-core-exit-map" "stable-compatibility:program:persistent-core-exit-set"
               "original-program:portable-persistent-vector-1" "original-program:portable-persistent-map-2"
               "original-program:portable-persistent-set-2"))
             (options (js-object :functionalRuntimeProfile "small" :sourceAssets (get (get corpus :document) :evidence)))
             (selected (js-call ids :map (lambda (id)
               (let ((record (js-call records :find (lambda (record) (= (get record :id) id)))))
                 (js-call assert :ok record id) record))))
             (before (JSON/stringify selected)))
        (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (target)
          (let ((selection (classifyStage3Corpus records target options))
                (strict (classifyStage3Corpus records target)))
            (js-call assert :deepStrictEqual
              (js-call (js-call (get selection :resourceDeferred) :filter (lambda (entry) (js-call ids :includes (get entry :id))))
                :map (lambda (entry) (get entry :id)))
              (js-call (js-call records :filter (lambda (record) (js-call ids :includes (get record :id))))
                :map (lambda (record) (get record :id))))
            (js-call assert :strictEqual (js-length (js-call (get selection :resourceDeferred) :filter
              (lambda (entry) (js-call ids :includes (get entry :id))))) 6)
            (js-call assert :deepStrictEqual (get strict :resourceDeferred) (js-array))
            (js-call assert :deepStrictEqual (get selection :completeIds) (get strict :completeIds))
            (js-call selected :forEach (lambda (record)
              (let ((proof (compilerCorpusResourceDeferred record target options)))
                (js-call assert :strictEqual (get proof :status) "resource-deferred")
                (js-call assert :strictEqual (get proof :verification) "deferred")
                (js-call assert :strictEqual (get proof :target) target)
                (js-call assert :strictEqual (get proof :valueCount) 1000000)
                (js-call assert :strictEqual (get proof :fullCorpusVerification) "unverified")
                (js-call assert :strictEqual (js-call (get selection :effectiveIds) :includes (get record :id)) false)
                (js-call assert :strictEqual (js-call (get selection :cancelled) :some
                  (lambda (entry) (= (get entry :id) (get record :id)))) false)
                (js-call assert :strictEqual (compilerCorpusResourceDeferred record target (js-object)) undefined)
                (js-call assert :strictEqual (compilerCorpusResourceDeferred record target
                  (js-object :functionalRuntimeProfile "small" :runtimeOptions (js-object :maxSlots 64))) undefined)))))))
        (js-call assert :strictEqual (JSON/stringify selected) before)
        (let ((reference (aref selected 3)))
          (js-call (js-array
            (lambda (record) (put (get record :original) :sourceSha256 (js-call "0" :repeat 64)))
            (lambda (record) (put (aref (get (get record :original) :regions) 0) :sha256 (js-call "0" :repeat 64)))
            (lambda (record) (put (get record :execution) :hostSource
              (js-call (get (get record :execution) :hostSource) :replaceAll "1_000_000" "999_999"))))
            :forEach (lambda (mutate)
              (let ((record (globalThis.structuredClone reference)))
                (funcall mutate record)
                (js-call assert :throws (lambda () (compilerCorpusResourceDeferred record "wasm" options)) globalThis.TypeError))))
          (js-call assert :throws (lambda () (compilerCorpusResourceDeferred reference "wasm"
            (js-object :functionalRuntimeProfile "small" :sourceAssets (js-array)))) globalThis.TypeError))
        (js-call (js-array "vector" "map" "set") :forEach (lambda (name)
          (let* ((id (+ "original-program:portable-persistent-" name "-complete-hosts"))
                 (record (js-call records :find (lambda (record) (= (get record :id) id)))))
            (js-call assert :ok record id)
            (js-call assert :strictEqual (compilerCorpusResourceDeferred record "wasm" options) undefined)))))))
  (test "the unchanged twelve-thousand-layer walk has a bounded full profile for its retained graph while original capacity remains unaccepted"
    (async ()
      (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
             (records (get corpus :records))
             (ids (js-array "stable-compatibility:program:tests/fixtures/persistent-tree-walk.eli"
                    "original-program:persistent-tree-walk-complete-hosts"))
             (resources (independentCompilerResources (js-object :profile "full-compiler")))
             (options (js-object :functionalRuntimeProfile "small")) (index 0))
        (while (< index (js-length ids))
          (let* ((id (aref ids index)) (record (js-call records :find (lambda (item) (= (get item :id) id))))
                 (before (JSON/stringify record)) (acceptance (compilerCorpusFunctionalResources record options))
                 (context (js-object :record record :options options))
                 (configured (prepareCompilerCorpusRuntimeContext context acceptance)))
            (js-call assert :ok record id)
            (js-call assert :strictEqual (get acceptance :effectiveRuntimeProfile) "full-compiler")
            (js-call assert :strictEqual (get acceptance :resourceAcceptance) "deferred")
            (js-call assert :strictEqual (get (get acceptance :originalRuntimeOptions) :maxSlots) 1024)
            (js-call assert :deepStrictEqual (get acceptance :effectiveRuntimeOptions)
              (Object/assign (js-object) (get resources :budget) (js-object :auto (get resources :auto))))
            (js-call assert :deepStrictEqual (get (get configured :options) :memory) (get resources :memory))
            (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (target)
              (if (= target "javascript")
                (js-call assert :strictEqual (get (compilerCorpusRequest record target options) :memory) undefined)
                (js-call assert :deepStrictEqual (get (compilerCorpusRequest record target options) :memory) (get resources :memory)))
              (js-call assert :strictEqual (compilerCorpusResourceDeferred record target options) undefined)))
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record (js-object)) undefined)
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record
              (js-object :functionalRuntimeProfile "small" :runtimeOptions (js-object :maxSlots 64))) undefined)
            (js-call assert :strictEqual (JSON/stringify record) before)
            (let* ((changed (globalThis.structuredClone record))
                   (module (js-call (get changed :modules) :find
                     (lambda (item) (= (get item :filename) "tests/fixtures/persistent-tree-walk.eli")))))
              (js-call assert :ok module)
              (put module :source (js-call (get module :source) :replace "(depth 12000)" "(depth 12001)"))
              (js-call assert :strictEqual (get (compilerCorpusFunctionalResources changed options) :effectiveRuntimeProfile) "small")))
          (setq index (1+ index))))))
  (test "authenticated complete and indexed original zipper programs bind every input before selecting a bounded functional heap"
    (async ()
      (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
             (options (js-object :functionalRuntimeProfile "small"))
             (resources (independentCompilerResources (js-object :profile "full-compiler"))))
        (js-call (js-array "original-program:persistent-zipper-complete-hosts"
                  "original-program:persistent-zipper-indexed-ascent") :forEach (lambda (id)
          (let* ((matches (js-call (get corpus :records) :filter (lambda (item) (= (get item :id) id))))
                 (record (aref matches 0)) (before (JSON/stringify record))
                 (actual (compilerCorpusFunctionalResources record options))
                 (configured (prepareCompilerCorpusRuntimeContext (js-object :record record :options options) actual))
                 (bound (get (get record :original) :functionalResourceInputs)))
            (js-call assert :strictEqual (js-length matches) 1)
            (js-call assert :strictEqual (get actual :effectiveRuntimeProfile) "full-compiler")
            (js-call assert :strictEqual (get actual :resourceAcceptance) "deferred")
            (js-call assert :deepStrictEqual (get actual :effectiveRuntimeOptions)
              (Object/assign (js-object) (get resources :budget) (js-object :auto (get resources :auto))))
            (js-call assert :deepStrictEqual (get (get configured :options) :memory) (get resources :memory))
            (js-call assert :deepStrictEqual (get actual :originalRuntimeOptions)
              (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216 :auto 0))
            (js-call assert :strictEqual (get bound :modulesSha256) (digest (JSON/stringify (get record :modules))))
            (js-call assert :strictEqual (get bound :requestSha256) (digest (JSON/stringify (get record :request))))
            (js-call assert :strictEqual (get bound :executionSha256) (digest (JSON/stringify (get record :execution))))
            (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (target)
              (js-call assert :strictEqual (compilerCorpusResourceDeferred record target options) undefined)))
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record (js-object)) undefined)
            (js-call assert :strictEqual (compilerCorpusFunctionalResources record
              (js-object :functionalRuntimeProfile "small" :runtimeOptions (js-object :maxSlots 64))) undefined)
            (let ((explicit (globalThis.structuredClone record)) (without-oracle (globalThis.structuredClone record)))
              (put (get explicit :execution) :runtimeOptions (js-object :maxSlots 64))
              (js-call assert :strictEqual (compilerCorpusFunctionalResources explicit options) undefined)
              (put (get without-oracle :expected) :oracleRequired false)
              (js-call assert :strictEqual (compilerCorpusFunctionalResources without-oracle options) undefined))
            (js-call assert :strictEqual
              (get (get (compilerCorpusFunctionalResources record
                (js-object :functionalRuntimeProfile "small" :runtimeOptions (js-object :auto 17))) :effectiveRuntimeOptions) :auto) 17)
            (js-call (js-array "host" "entry" "dependency" "request" "arguments" "suite" "region" "binding") :forEach
              (lambda (change)
                (let* ((changed (globalThis.structuredClone record)) (original (get changed :original))
                       (execution (get changed :execution)))
                  (cond
                    ((= change "host") (put execution :hostSource (str (get execution :hostSource) "\n")))
                    ((= change "entry") (put (aref (get changed :modules) 0) :source
                      (str (get (aref (get changed :modules) 0) :source) "\n")))
                    ((= change "dependency") (put (aref (get changed :modules) 1) :source
                      (str (get (aref (get changed :modules) 1) :source) "\n")))
                    ((= change "request") (put (get changed :request) :sourceMap false))
                    ((= change "arguments") (put execution :arguments (js-array (js-object :literal "changed"))))
                    ((= change "suite") (put original :sourceSha256 "changed"))
                    ((= change "region") (put (aref (get original :regions) 0) :sha256 "changed"))
                    (t (Reflect/deleteProperty original "functionalResourceInputs")))
                  (js-call assert :throws (lambda () (compilerCorpusFunctionalResources changed options)) globalThis.TypeError))))
            (js-call (js-array "original-program:zipper-capacity" "original-program:zipper-oom" "original-program:forged-zipper") :forEach
              (lambda (changed-id)
                (let ((changed (globalThis.structuredClone record)))
                  (put changed :id changed-id)
                  (let ((result (compilerCorpusFunctionalResources changed options)))
                    (js-call assert :ok (or (undefined? result) (= (get result :effectiveRuntimeProfile) "small")))))))
            (js-call assert :strictEqual (JSON/stringify record) before)))))))
