(module tests.interop-scalar-paths
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "../dist/bootstrap/compiler.mjs" compile-string)
  (import "../bootstrap/host/bun.mjs" loadCompiler)
  (defun section (source start end)
    (let ((first (js-call source :indexOf start)) (last (js-call source :indexOf end)))
      (js-call assert :ok (and (>= first 0) (> last first)))
      (js-call source :slice first last)))
  (test "scalar conversion keeps ordered resource errors exact indexed paths identity and shallow boundaries"
    (async ()
      (let* ((source (await (readFile (resolve root "stdlib/interop/js.eli") "utf8")))
             (directory (await (mkdtemp (resolve root "_worktree/interop-scalar-paths-"))))
             (body (str
               (section source "  (defun interop-fail " "  (defun array? ")
               (section source "  (defun interop-step " "  (defun interop-kind ")
               (section source "  (defun interop-index-path " "  (defun interop-map-key-path ")
               (section source "  (defun interop-sequence-child " "  (defun interop-to-js-sequence ")
               "\n(export interop-sequence-child)"))
             (calls 0) (sentinel (js-object))
             (convert (lambda (value context path depth)
               (setq calls (1+ calls))
               (js-call assert :strictEqual path "$[3]")
               (js-call assert :strictEqual depth 1)
               sentinel)))
        (try
          (await (writeFile (resolve directory "compiler.mjs") (compile-string body "interop-scalar-paths.eli")))
          (let* ((compiled (await (loadCompiler directory)))
                 (context (js-object :deep t :max-depth 1 :max-values 100 :count 1))
                 (values (js-array nil undefined false 0 -0.0 Number/NaN "text" (funcall globalThis.Symbol "scalar"))))
            (js-call values :forEach (lambda (value index)
              (js-call assert :ok (Object/is
                (js-call compiled :interop_sequence_child value context "$" index 1 convert) value))))
            (js-call assert :strictEqual (get context :count) (1+ (js-length values)))
            (js-call assert :strictEqual calls 0)
            (js-call assert :strictEqual
              (js-call compiled :interop_sequence_child (js-object) context "$" 3 1 convert) sentinel)
            (js-call assert :strictEqual calls 1)
            (let ((limited (js-object :deep t :max-depth 0 :max-values 0 :count 1)))
              (js-call assert :throws
                (lambda () (js-call compiled :interop_sequence_child 0 limited "$" 0 1 convert))
                (lambda (error)
                  (js-call assert :strictEqual (get error :code) "ELI-INTEROP-DEPTH-LIMIT")
                  (js-call assert :strictEqual (get error :path) "$[0]") t))
              (js-call assert :strictEqual (get limited :count) 1)
              (put limited :max-depth 1)
              (js-call assert :throws
                (lambda () (js-call compiled :interop_sequence_child false limited "$" 7 1 convert))
                (lambda (error)
                  (js-call assert :strictEqual (get error :code) "ELI-INTEROP-VALUE-LIMIT")
                  (js-call assert :strictEqual (get error :path) "$[7]") t))
              (js-call assert :strictEqual (get limited :count) 2)
              (put limited :deep false)
              (js-call assert :strictEqual
                (js-call compiled :interop_sequence_child sentinel limited "$" 0 99 convert) sentinel)
              (js-call assert :strictEqual (get limited :count) 2)
              (js-call assert :strictEqual calls 1)))
          (finally (await (rm directory (js-object :recursive t))))))))
  (test "native default uses real in-process FFI without overriding either explicit host or other output defaults"
    (async ()
      (let* ((source (await (readFile (resolve root "tools/backends/eliscript/compiler-corpus-original-program.eli") "utf8")))
             (directory (await (mkdtemp (resolve root "_worktree/native-host-choice-"))))
             (body (str (section source "  (defun original-program-bun? " "  (defun safe-id ")
               "\n(defun selected-host (target contract options) (if (original-program-bun? target contract options) t false)) (export selected-host)")))
        (try
          (await (writeFile (resolve directory "compiler.mjs") (compile-string body "native-host-choice.eli")))
          (let* ((compiled (await (loadCompiler directory)))
                 (cases (js-array
                   (js-array "native" (js-object) (js-object) t)
                   (js-array "javascript" (js-object) (js-object) false)
                   (js-array "wasm" (js-object) (js-object) false)
                   (js-array "native" (js-object :hostRuntime "node") (js-object :programHost "bun") false)
                   (js-array "native" (js-object :hostRuntime "bun") (js-object :programHost "node") t)
                   (js-array "native" (js-object) (js-object :programHost "node") false)
                   (js-array "javascript" (js-object) (js-object :programHost "bun") t)
                   (js-array "wasm" (js-object :requiresBun t) (js-object :programHost "node") t)
                   (js-array "native" (js-object :hostRuntime "node" :requiresBun t) (js-object) false))))
            (js-call cases :forEach (lambda (row)
              (js-call assert :strictEqual
                (js-call compiled :selected_host (aref row 0) (aref row 1) (aref row 2)) (aref row 3)))))
          (finally (await (rm directory (js-object :recursive t))))))))
  (test "conversion key enumeration preserves symbol order descriptor traps and uncalled accessors"
    (async ()
      (let* ((source (await (readFile (resolve root "stdlib/interop/js.eli") "utf8")))
             (directory (await (mkdtemp (resolve root "_worktree/interop-own-keys-"))))
             (body (str (section source "  (defconst interop-enumerable-own-keys" "  (defconst interop-own-data-property")
               "\n(defun enumerable-keys (value) (funcall interop-enumerable-own-keys value)) (export enumerable-keys)"))
             (symbol (funcall globalThis.Symbol "enumerable"))
             (value (Object/create (js-object :inherited 1)))
             (reads 0) (traps (js-array)))
        (Object/defineProperty value "10" (js-object :value 10 :enumerable t :configurable t))
        (Object/defineProperty value "2" (js-object :value 2 :enumerable t :configurable t))
        (Object/defineProperty value "hidden" (js-object :value 3 :enumerable false :configurable t))
        (Object/defineProperty value "accessor" (js-object :get (lambda () (setq reads (1+ reads))) :enumerable t :configurable t))
        (Object/defineProperty value symbol (js-object :value 4 :enumerable t :configurable t))
        (try
          (await (writeFile (resolve directory "compiler.mjs") (compile-string body "interop-own-keys.eli")))
          (let* ((compiled (await (loadCompiler directory)))
                 (proxy (new globalThis.Proxy value (js-object :getOwnPropertyDescriptor
                   (lambda (target key)
                     (js-call traps :push key)
                     (Reflect/getOwnPropertyDescriptor target key))))))
            (js-call assert :deepStrictEqual (js-call compiled :enumerable_keys proxy)
              (js-array "2" "10" "accessor" symbol))
            (js-call assert :deepStrictEqual traps (js-array "2" "10" "hidden" "accessor" symbol))
            (js-call assert :strictEqual reads 0))
          (finally (await (rm directory (js-object :recursive t)))))))))
