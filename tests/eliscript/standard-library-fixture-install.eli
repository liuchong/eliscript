(module tests.standard-library-fixture-install
  (import "bun:test" :as framework)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "../../tools/backends/build.mjs" root)
  (import "../../tools/backends/managed-runtime.mjs" :as actual-wasm)
  (import "../../tools/backends/native-managed-runtime.mjs" :as actual-native)
  (import "../../tools/backends/compiler-corpus-managed-cases.mjs" originalSourceCaseLocators)
  (import "./standard-library-fixture.mjs" standardLibraryFixturePlans standardLibraryFixtureOptions
    readStandardLibraryDescriptor standardLibraryRuntimeFacade standardLibraryFixtureTestRegistration)
  (defconst selected (js-call standardLibraryFixturePlans :filter (lambda (plan)
    (js-call (get globalThis.process :argv) :some (lambda (argument)
      (= (resolve root argument) (resolve root (get plan :suite))))))))
  (unless (= (js-length selected) 1)
    (throw (new globalThis.TypeError "standard library fixture requires exactly one authenticated suite")))
  (defconst plan (aref selected 0))
  (unless (= (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root (get plan :suite)))) :digest "hex")
             (get plan :sha256))
    (throw (new globalThis.TypeError "standard library original suite source identity changed")))
  (defconst wasm (Object/assign (js-object) actual-wasm))
  (defconst native (Object/assign (js-object) actual-native))
  (defconst original-framework (Object/assign (js-object) framework))
  (defconst original-cases (originalSourceCaseLocators (get plan :suite) (readFileSync (resolve root (get plan :suite)) "utf8")))
  (defconst registration (standardLibraryFixtureTestRegistration (get original-framework :test) plan (get globalThis.process :env) original-cases))
  (unless (eq registration (get original-framework :test))
    (console/error "[standard-library-fixture-time-acceptance]" (get plan :suite)
      "original 30000/120000ms total-case performance DEFERRED / NOT ACCEPTED; complete functional cases have no total deadline")
    (js-call (get original-framework :mock) :module "bun:test"
      (lambda () (Object/assign (js-object) original-framework (js-object :test registration)))))
  (defun options-for (input)
    (let ((acceptance (standardLibraryFixtureOptions (get plan :suite) (get globalThis.process :env) input)))
      (when (= (get acceptance :resourceAcceptance) "deferred")
        (console/error "[standard-library-fixture-resource-acceptance]" (JSON/stringify
          (js-object :suite (get plan :suite) :resourceAcceptance "deferred"
            :originalCapacityAcceptance (get acceptance :originalCapacityAcceptance)
            :originalRuntimeOptions (get acceptance :originalRuntimeOptions)
            :effectiveRuntimeOptions (get acceptance :effectiveRuntimeOptions)
            :automaticCollection "the original callback sets its unchanged threshold"))))
      (get acceptance :options)))
  (defun instantiate-wasm (bytes &rest arguments)
    (let ((forwarded (js-call arguments :slice)))
      (when (> (js-length forwarded) 0) (put forwarded 0 (options-for (aref forwarded 0))))
      (standardLibraryRuntimeFacade
        (Reflect/apply (get wasm :instantiateManagedRuntime) undefined (js-call (js-array bytes) :concat forwarded))
        (readStandardLibraryDescriptor bytes) plan)))
  (defasync instantiate-native (path lowered &rest arguments)
    (let ((forwarded (js-call arguments :slice)))
      (when (> (js-length forwarded) 0) (put forwarded 0 (options-for (aref forwarded 0))))
      (standardLibraryRuntimeFacade
        (await (Reflect/apply (get native :instantiateNativeManagedRuntime) undefined
                 (js-call (js-array path lowered) :concat forwarded)))
        (get lowered :descriptor) plan)))
  (js-call (get framework :mock) :module (resolve root "tools/backends/managed-runtime.mjs")
    (lambda () (Object/assign (js-object) wasm (js-object :instantiateManagedRuntime instantiate-wasm))))
  (js-call (get framework :mock) :module (resolve root "tools/backends/native-managed-runtime.mjs")
    (lambda () (Object/assign (js-object) native (js-object :instantiateNativeManagedRuntime instantiate-native))))
  (js-call framework :afterAll (lambda ()
    (js-call (get framework :mock) :module (resolve root "tools/backends/managed-runtime.mjs") (lambda () wasm))
    (js-call (get framework :mock) :module (resolve root "tools/backends/native-managed-runtime.mjs") (lambda () native))
    (js-call (get framework :mock) :module "bun:test" (lambda () original-framework)))))
