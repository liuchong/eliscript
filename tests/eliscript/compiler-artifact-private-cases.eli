(module tests.compiler-artifact-private-cases
  (import "node:assert/strict" :default assert)
  (import "../../tools/backends/compiler-cli-legacy.mjs" renderCompilerCLIError)
  (import "./compiler-build-private.mjs" loadCompilerBuildPrivateUnit)
  (defasync scheduling-case ()
    (let* ((schedule (get (get (await (loadCompilerBuildPrivateUnit)) :real) :seedJavaScriptProduct))
           (sources (Object/freeze (js-object :modules (Object/freeze (js-array
             (Object/freeze (js-object :id "first.mjs" :filename "原😀/first.eli" :source "first"))
             (Object/freeze (js-object :id "second.mjs" :source "second"))))
             :runtime (Object/freeze (js-object :source "complete runtime" :filename "runtime.eli"))))))
      (js-call (js-array false t) :forEach (lambda (debug)
        (let ((calls (js-array)))
          (letfn ((compile (source filename)
            (js-call calls :push (js-array "compile" source filename)) (Object/freeze (js-object :source source :filename filename)))
            (emission (program) (+ "JS:" (get program :source))))
            (let* ((compiler (js-object :compile_ir_string compile
                     :compile_ir_string_with_origins (lambda (source filename)
                       (js-object :program (compile source filename) :macroOrigins (js-array (js-object :source source :filename filename))))
                     :emit_ir_string (lambda (program) (js-call calls :push (js-array "emit" (get program :source))) (emission program))
                     :emit_ir_string_with_source_map (lambda (program source id filename)
                       (js-call calls :push (js-array "emit" (get program :source)))
                       (js-call assert :strictEqual source (get program :source))
                       (js-object :javascript (emission program) :sourceMap (JSON/stringify (js-object :id id :filename filename))))))
                   (actual (funcall schedule sources compiler debug)))
              (js-call assert :deepStrictEqual calls (js-array
                (js-array "compile" "first" "原😀/first.eli") (js-array "emit" "first")
                (js-array "compile" "second" "second.mjs") (js-array "emit" "second")
                (js-array "compile" "complete runtime" "runtime.eli")))
              (js-call assert :deepStrictEqual actual (js-object :target "javascript" :modules
                (js-call (get sources :modules) :map (lambda (record)
                  (let ((output (js-object :id (get record :id) :javascript (+ "JS:" (get record :source)))))
                    (when debug
                      (let ((mapping (js-object :id (get record :id))))
                        (when (Object/hasOwn record "filename") (put mapping :filename (get record :filename)))
                        (put output :sourceMap (JSON/stringify mapping)))
                      (put output :macroOrigins (js-array (js-object :source (get record :source)
                        :filename (if (nullish? (get record :filename)) (get record :id) (get record :filename)))))) output))))))))))))
  (defasync failure-case ()
    (let* ((schedule (get (get (await (loadCompilerBuildPrivateUnit)) :real) :seedJavaScriptProduct))
           (sources (js-object :modules (js-array (js-object :id "first.mjs" :source "first") (js-object :id "second.mjs" :source "second"))
             :runtime (js-object :source "runtime" :filename "runtime.eli")))
           (emitted (new globalThis.Error "first emitter failure")) (frontend (new globalThis.Error "later frontend failure")))
      (js-call (js-array false t) :forEach (lambda (debug)
        (js-call (js-array "first" "second" "runtime" "none") :forEach (lambda (failure)
          (let ((calls (js-array)))
            (letfn ((compile (source filename)
              (js-call calls :push (+ "compile:" source)) (when (= source failure) (throw frontend))
              (js-object :source source :filename filename))
              (emit (program) (js-call calls :push (+ "emit:" (get program :source))) (throw emitted)))
              (let ((compiler (js-object :compile_ir_string compile :emit_ir_string emit
                :compile_ir_string_with_origins (lambda (source filename) (js-object :program (compile source filename) :macroOrigins (js-array)))
                :emit_ir_string_with_source_map emit)))
                (js-call assert :throws (lambda () (funcall schedule sources compiler debug))
                  (lambda (error) (eq error (if (= failure "none") emitted frontend))))
                (js-call assert :deepStrictEqual calls (cond
                  ((= failure "first") (js-array "compile:first"))
                  ((= failure "second") (js-array "compile:first" "emit:first" "compile:second"))
                  (t (js-array "compile:first" "emit:first" "compile:second" "compile:runtime")))))))))))
      (let ((compiled (js-array)) (caught false))
        (try (funcall schedule sources (js-object :compile_ir_string (lambda (source) (js-call compiled :push source) (js-object :source source))
               :emit_ir_string (lambda () (throw undefined))) false)
          (catch error (setq caught t) (js-call assert :strictEqual error undefined)))
        (js-call assert :strictEqual caught t "an undefined first emitter error must still be rethrown")
        (js-call assert :deepStrictEqual compiled (js-array "first" "second" "runtime")))
      (let ((recovered (funcall schedule sources (js-object :compile_ir_string (lambda (source) (js-object :source source))
                        :emit_ir_string (lambda (program) (get program :source))) false)))
        (js-call assert :deepStrictEqual (js-call (get recovered :modules) :map (lambda (record) (get record :javascript))) (js-array "first" "second")))))
  (defun rendering-case ()
    (let* ((diagnostic (js-object :format "eliscript-diagnostic" :version 1 :code "ELI-B0001" :severity "error" :phase "managed-backend"
                         :message "unsupported source operation" :location (js-object :file "original.eli" :start (js-object :line 3 :column 7))))
           (rendered (JSON/parse (renderCompilerCLIError (js-object :message (get diagnostic :message) :eliscriptDiagnostic diagnostic)))))
      (js-call assert :strictEqual (get rendered :message) (get diagnostic :message))
      (js-call assert :deepStrictEqual (get rendered :eliscriptDiagnostic) diagnostic)
      (let ((error (new globalThis.TypeError "original transport failure"))) (js-call assert :strictEqual (renderCompilerCLIError error) (get error :stack)))
      (js-call (js-array undefined nil 0 false "source throw") :forEach (lambda (value)
        (js-call assert :strictEqual (renderCompilerCLIError value) (funcall globalThis.String value))))))
  (defconst artifactPrivateCases (js-object
    "internal sequential JS scheduling retains exact output maps origins and the complete runtime compilation" scheduling-case
    "internal early JS emission preserves original frontend-first failure identity including undefined throws" failure-case
    "the public compiler CLI retains structured backend failures without an Error stack" rendering-case))
  (export artifactPrivateCases))
