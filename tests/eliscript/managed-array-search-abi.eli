(module tests.managed-array-search-abi
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defun registerOriginalArraySearchAbi (context)
    (test "invalid receivers, conversion failures and real WASM traps preserve caller roots and evaluated argument effects"
      (async ()
        (let* ((state (funcall context))
               (compiled (get state :compiled)) (array (get state :array))
               (finish (get state :finish)) (fixture (get state :fixture))
               (b (get state :b))
               (text (await (funcall fixture "invalid")))
               (result (await (funcall compiled text)))
               (a (get result :a)) (js (get result :js))
               (trace (js-call a :sourceObject (js-object :visited false)))
               (key (js-call a :string "visited")))
          (js-call (js-array nil undefined false t) :forEach (lambda (receiver)
            (js-call a :objectSet trace key false)
            (js-call assert :throws
              (lambda () (js-call a :invoke "bad" (js-array receiver trace)))
              (lambda (error)
                (and (get error :eliscriptDiagnostic)
                     (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0003"))))
            (let ((reference (js-object :visited false)))
              (js-call assert :throws (lambda () (js-call js :bad receiver reference)) globalThis.TypeError)
              (js-call assert :equal (js-call a :objectGet trace key) (get reference :visited)))))
          (let* ((items (funcall array a (js-array nil))) (caller (js-call a :frame 1)))
            (js-call a :frameSet caller 0 items)
            (js-call assert :throws
              (lambda () (js-call a :invoke "convert" (js-array items trace)))
              (lambda (error)
                (and (get error :eliscriptDiagnostic)
                     (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0003"))))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (js-call a :leaveFrame caller)
            (funcall finish a (js-array items trace key)))
          (let* ((raw (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
                 (start (js-call raw :indexOf "  (defun heap-array-search "))
                 (end (js-call raw :indexOf "  (defun value-sequence-search " start)))
            (js-call assert :ok (and (>= start 0) (> end start)))
            (let* ((compiler (get b :compiler))
                   (injected (js-call compiler :compile_ir_string
                     (str (js-call raw :slice 0 start)
                       "  (defun heap-array-search (heap items needle from present mode) (load-u32 4294967295))\n"
                       (js-call raw :slice end)) "trap.eli"))
                   (program (js-call compiler :compile_ir_string text "search-trap.eli"))
                   (trap (instantiateManagedRuntime (globalThis.Uint8Array.from
                     (js-call (get b :managed) :emit_managed_wasm program injected)))))
              (js-call trap :auto 1)
              (let* ((trace (js-call trap :sourceObject (js-object :visited false)))
                     (key (js-call trap :string "visited"))
                     (input (funcall array trap (js-array 1)))
                     (frame (js-call trap :frame 1)))
                (js-call trap :frameSet frame 0 input)
                (js-call assert :throws
                  (lambda () (js-call trap :invoke "bad" (js-array input trace)))
                  globalThis.WebAssembly.RuntimeError)
                (js-call assert :equal (get (js-call trap :stats) :frameDepth) 1)
                (js-call assert :equal (js-call trap :objectGet trace key) t)
                (js-call trap :leaveFrame frame)
                (funcall finish trap (js-array trace key input))))))))

    (test "raw search boundaries reject invalid handles and private frames, preserve sparse shape and recover after slot exhaustion"
      (async ()
        (let* ((state (funcall context))
               (compiled (get state :compiled)) (finish (get state :finish))
               (result (await (funcall compiled)))
               (a (get result :a)) (bytes (get result :bytes)))
          (funcall finish a)
          (let* ((exports (get (new globalThis.WebAssembly.Instance
                             (new globalThis.WebAssembly.Module bytes)) :exports))
                 (heap (js-call exports "heap-new" 32 8192 8192))
                 (call (lambda (name &rest args)
                   (let ((out (uint32 (Reflect/apply (get exports name) exports
                                (js-call (js-array heap) :concat args)))))
                     (js-call assert :equal (js-call exports "last-error") 0 name)
                     out)))
                 (items (funcall call "value-array-new" 2))
                 (empty (funcall call "value-array-new" 0))
                 (unsealed (funcall call "value-string" 1))
                 (frame (funcall call "frame-new" 2)))
            (funcall call "frame-set" frame 0 items)
            (funcall call "frame-set" frame 1 empty)
            (funcall call "heap-pin" unsealed)
            (funcall call "heap-auto" 1)
            (js-call (js-array
              (js-array 4294967295 3 3 0 0 1)
              (js-array items 4294967295 3 0 0 1)
              (js-array items 3 4294967295 1 0 1)
              (js-array items frame 3 0 0 3)
              (js-array items unsealed 3 0 0 6)
              (js-array items 3 frame 1 0 3)
              (js-array items 3 3 2 0 3)
              (js-array items 3 3 0 3 3)
              (js-array frame 3 3 0 0 3))
              :forEach (lambda (row)
                (js-call assert :equal
                  (js-call exports "value-sequence-search" heap
                    (aref row 0) (aref row 1) (aref row 2) (aref row 3) (aref row 4)) 0)
                (js-call assert :equal (js-call exports "last-error") (aref row 5))
                (js-call assert :equal (funcall call "frame-depth") 1)
                (js-call assert :equal (funcall call "frame-get" frame 0) items)))
            (let ((held (js-array)) (index 0) (exhausted false))
              (while (and (< index 64) (not exhausted))
                (let ((number (js-call exports "value-number" heap 0 0)))
                  (if (= number 0)
                    (progn
                      (js-call assert :equal (js-call exports "last-error") 2)
                      (setq exhausted t))
                    (progn
                      (funcall call "heap-pin" number)
                      (js-call held :push number))))
                (setq index (1+ index)))
              (js-call assert :equal (funcall call "value-sequence-search" empty 3 unsealed 1 0) 1)
              (js-call assert :equal (js-call exports "value-sequence-search" heap items 3 3 0 0) 0)
              (js-call assert :equal (js-call exports "last-error") 2)
              (js-call assert :equal (funcall call "frame-depth") 1)
              (js-call held :forEach (lambda (number) (funcall call "heap-release" number)))
              (funcall call "heap-collect")
              (js-call assert :equal (funcall call "value-sequence-search" items 3 3 0 0) 2)
              (js-call assert :equal
                (js-call (new globalThis.DataView (get (get exports :memory) :buffer))
                  :getUint32 (funcall call "value-data" items 14) t) 4)
              (funcall call "heap-release" unsealed)
              (funcall call "frame-pop" frame)
              (funcall call "heap-collect")
              (js-call assert :equal (funcall call "heap-live") 0)))))))

  (export registerOriginalArraySearchAbi))
