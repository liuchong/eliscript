(module tests.portable-node-test
  (import "node:test" :as node)
  (import "node:assert/strict" :default assert)
  (import "../../tools/testing/number-text-node.mjs" numberTextTestArguments numberTextHookArguments)
  (import "../../tools/testing/portable-node-fixtures.mjs" portableNodePlan portableStaticBackend portableStaticDirectory)
  (import "../../tools/testing/wasm-static-repairs.mjs" staticSourceRefusalTitle staticFreshMemoTitle assertStaticSourceRefusals assertStaticFreshMemo)
  (defvar registrations 0) (defvar sourceChecks 0) (defvar memoChecks 0)
  (defun test (&rest arguments)
    (setq registrations (1+ registrations))
    (let ((forwarded (js-call arguments :slice)))
      (when (= (get portableNodePlan :cases) 19)
        (cond
          ((= (aref arguments 0) staticSourceRefusalTitle)
            (setq sourceChecks (1+ sourceChecks))
            (put forwarded 1 (lambda () (assertStaticSourceRefusals portableStaticBackend))))
          ((= (aref arguments 0) staticFreshMemoTitle)
            (setq memoChecks (1+ memoChecks))
            (put forwarded 1 (async () (await (assertStaticFreshMemo portableStaticBackend portableStaticDirectory)))))))
      (Reflect/apply (get node :test) node (numberTextTestArguments forwarded))))
  (defun beforeAll (&rest arguments) (Reflect/apply (get node :before) node (numberTextHookArguments arguments)))
  (defun afterAll (&rest arguments) (Reflect/apply (get node :after) node (numberTextHookArguments arguments)))
  (js-call node :after (lambda ()
    (js-call assert :strictEqual registrations (get portableNodePlan :cases))
    (when (= registrations 19)
      (js-call assert :strictEqual sourceChecks 1) (js-call assert :strictEqual memoChecks 1))))
  (export test beforeAll afterAll))
