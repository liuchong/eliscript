(module tests.compiler-browser-session
  (import "bun:test" beforeAll afterAll describe test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir mkdtemp readFile writeFile rm realpath)
  (import "node:os" tmpdir)
  (import "node:module" createRequire)
  (import "node:path" resolve dirname relative sep delimiter)
  (import "node:crypto" createHash)
  (import "node:child_process" execFile)
  (import "node:util" promisify)
  (import "../tools/backends/compiler-package.mjs" packageIndependentCompiler)
  (import "../tools/backends/compiler-build.mjs" loadCompilerSources independentCompilerProfiles)
  (import "../tools/backends/compiler-bootstrap.mjs" openCompilerArtifact)
  (import "../tools/backends/compiler-metadata.mjs" readCompilerMetadata)
  (import "../tools/backends/stage3-targets.mjs" authenticateStage3Targets)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/backends/native-memory.mjs" openNativeMemory)
  (import "../tools/backends/compiler-debug.mjs" createCompilerDebugMap)
  (import "../tools/backends/compiler-worker.mjs" compilerSourceIdentity compilerRequestIdentity)

  (defvar directory nil)
  (defvar artifact nil)
  (defvar authentication nil)
  (defvar packaged nil)
  (defvar server nil)
  (defvar browser nil)
  (defvar fixture nil)
  (defvar page nil)
  (defconst products (new globalThis.Map))
  (defconst pending (new globalThis.Map))
  (defconst ingress-pending (new globalThis.Map))
  (defconst observations (js-array))
  (defconst cancellations (js-array))
  (defconst programs (new globalThis.Map))
  (defconst execute-file (promisify execFile))
  (defconst source-name "tests/fixtures/core-expression-forms.eli")
  (defconst entry-name "tests/fixtures/core-expression-forms.mjs")
  (defconst native-supported (and (= (get globalThis.process :arch) "arm64") (js-call (js-array "darwin" "linux") :includes (get globalThis.process :platform))))
  (defconst native-target (if (= (get globalThis.process :platform) "darwin") "arm64-macos" "arm64-linux"))
  (defconst resources (get independentCompilerProfiles :small))
  (defconst report (Object/freeze (js-object :threadFirst 8 :threadLast 8 :named 8
    :conditionalFirst (js-array 3 1 2) :conditionalLast (js-array 1 2 3)
    :someFirst (js-array 3 1 2) :someLast (js-array 1 2 3) :someNil nil :someFalse false :someUndefined "continued"
    :captureSafe 11 :conditionalNoop 4 :someNoop 5 :events (js-array "initial" "test-false" "test-true" "selected")
    :ifLetFalse "missing" :ifLetValue 8 :ifSomeFalse false :ifSomeUndefined "present" :ifSomeNil "missing"
    :whenLetValue 15 :whenSomeFalse "missing" :calls 20)))
  (defun merge (&rest values) (Reflect/apply Object/assign undefined (js-call (js-array (js-object)) :concat values)))
  (defun digest (text) (js-call (js-call (createHash "sha256") :update text) :digest "hex"))
  (defun normalized (value) (JSON/parse (JSON/stringify value)))
  (defun metadata (product) (let ((value (merge product))) (Reflect/deleteProperty value "bytes") (normalized value)))
  (defun failure (error) (js-object :name (when error (get error :name)) :message (when error (get error :message)) :code (when error (get error :code))))
  (defun runtime-error-p (error)
    (Reflect/apply (get globalThis.WebAssembly.RuntimeError globalThis.Symbol.hasInstance)
      globalThis.WebAssembly.RuntimeError (js-array error)))
  (defun report-export-name (product)
    (let* ((entries (get (get product :descriptor) :functions))
           (matches (js-call entries :filter (lambda (item)
             (or (= (get item :name) "expression-form-report") (= (get item :name) "expression_form_report"))))))
      ;; A project uses its actual public emitted name; direct single IR may
      ;; retain the source name. Never invent an alias in the runtime adapter.
      (js-call assert :strictEqual (js-length matches) 1 "the actual descriptor must identify the original report export exactly once")
      (get (aref matches 0) :name)))
  (defun register (title body timeout &optional skip)
    (funcall (if skip (get test :skip) test) title (async ()
      (try (await (funcall body)) (js-call observations :push (js-object :title title :status "passed"))
        (catch error (js-call observations :push (js-object :title title :status "failed" :error (failure error))) (throw error)))) timeout))
  (defun cancelled (id title start end)
    (js-call cancellations :push (js-object :id id :title title :status "cancelled" :host "wasm"
      :reason "WASM compiler host is outside the JavaScript stage0-stage3 delivery; user WASM/native output remains required"
      :sourceFile "tests/compiler-browser-session-test-legacy.mjs" :startLine start :endLine end))
    (js-call test :skip title (lambda () nil)))

  ;; Exact expanded old registrations remain source-bound evidence, not passes.
  (let ((targets (js-array "javascript" "wasm" "native")) (index 0))
    (while (< index 3)
      (let ((target (aref targets index)))
        (cancelled (+ "full-project/wasm/" target)
          (+ "complete browser compiler hosts emit actual three-target language projects wasm compiler in its actual owned module Worker emits the complete original language fixture to " target " with exact independent Node IR maps debug and product bytes") 463 465))
      (setq index (1+ index))))
  (js-call (js-array "single" "project" "memory") :forEach (lambda (kind)
    (cancelled (+ "ir/wasm/" kind)
      (+ "complete browser compiler hosts emit actual three-target language projects wasm compiler in its actual owned module Worker Given the real wasm compiler Worker When " kind " IR is submitted Then actual supported target products execute with exact source maps and cleanup") 466 468)))
  (cancelled "native-ir-execution/wasm" "complete browser compiler hosts emit actual three-target language projects wasm compiler in its actual owned module Worker Given browser IR emission When its real native libraries execute Then managed and raw ABIs preserve original observations and traps" 469 498)
  (cancelled "native-project-execution/wasm" "complete browser compiler hosts emit actual three-target language projects wasm compiler in its actual owned module Worker the browser-emitted native library actually executes the complete fixture with GC and close cleanup" 499 519)
  (cancelled "wasm-compiler-debug/automatic" "browser and owned Worker both load the emitted WASM debug sidecar and retain exact source positions" 538 570)
  (cancelled "wasm-compiler-debug/explicit-priority-malformed" "explicit browser debug takes precedence and automatic malformed debug is rejected in both execution modes" 572 600)
  (cancelled "wasm-compiler-debug/http-recovery" "browser debug HTTP failures release Worker resources and do not poison a subsequent real initialization" 602 624)
  (cancelled "wasm-compiler-debug/changed-binary" "a changed emitted WASM resource is rejected before initialization in the browser and its owned Worker" 626 656)
  (js-call (js-array false t) :forEach (lambda (worker)
    (cancelled (+ "wasm-compiler-debug/abort-" (if worker "worker" "inline"))
      (+ "aborting browser debug loading cleans its actual resources with worker=" (funcall globalThis.String worker)) 658 686)))
  (cancelled "semantics/wasm/unicode-edit" "Given wasm browser semantic results When previewing Unicode edits Then text identities and Worker revisions reject stale changes without publishing" 1020 1062)
  (cancelled "semantics/wasm/ir-snapshot" "Given a real wasm browser compiler Worker When IR changes under unchanged source text Then stale edits reject and source projects remain isolated" 1064 1125)
  (js-call (js-array "emit-ir" "project-ir" "emit-memory-ir") :forEach (lambda (operation)
    (cancelled (+ "semantics/wasm/cancel-" operation)
      (+ "Given an actual posted " operation " request in the wasm browser compiler Worker When it is cancelled and disposed Then owned resources are released") 1127 1175)))

  (defasync bundle (path &optional external)
    (let* ((plugins (js-array (js-object :name "eliscript-unicode-runtime-url"
                     :setup (lambda (builder)
                       (js-call builder :onResolve
                         (js-object :filter (new globalThis.RegExp "^eliscript/runtime/unicode-case\\.mjs$"))
                         (lambda (request) (js-object :path "/runtime/unicode-case.mjs" :external t)))))))
           (options (js-object :entrypoints (js-array (resolve path)) :target "browser" :format "esm"
                      :external (if external external (js-array)) :plugins plugins)))
      (when (and external (js-call external :includes "./program.mjs"))
        ;; The browser serves this exact future-emitted module beside its
        ;; runner; it must never resolve against the test source directory.
        (js-call plugins :push (js-object :name "eliscript-emitted-program-url"
          :setup (lambda (builder)
            (js-call builder :onResolve
              (js-object :filter (new globalThis.RegExp "^\\./program\\.mjs$"))
              (lambda (request) (js-object :path (get request :path) :external t)))))))
      (let ((result (await (js-call globalThis.Bun :build options))))
        (js-call assert :strictEqual (get result :success) t (funcall globalThis.String (get result :logs)))
        (await (js-call (aref (get result :outputs) 0) :text)))))
  (defasync browser-call (owned input)
    ;; Playwright serializes only this closure-free Eli-emitted function. All
    ;; actual case code is the statically imported browser ESM page module.
    (await (js-call owned :evaluate (async (input)
      (await (funcall (get globalThis.globalThis :__eliscriptBrowserCase) input))) input)))
  (defun manifest-url () (+ (get (get server :url) :href) "package/" (get (get packaged :manifest) :browserArtifact)))
  (defasync open-page ()
    (let ((owned (await (js-call browser :newPage))))
      (await (js-call owned :goto (get (get server :url) :href)))
      (await (js-call owned :waitForFunction (lambda () (get globalThis.globalThis :__eliscriptBrowserCase)))) owned))
  (defasync fresh (input)
    (let ((owned (await (open-page))))
      (try (await (browser-call owned (merge (js-object :manifestURL (manifest-url)) input))) (finally (await (js-call owned :close))))))

  (beforeAll (async ()
    (let* ((environment (get globalThis.process :env)) (supplied (get environment :ELISCRIPT_TEST_COMPILER_ARTIFACT))
           (manifest (or (get environment :ELISCRIPT_BOOTSTRAP_MANIFEST) (resolve "dist/bootstrap-release/bootstrap.json"))))
      (setq authentication (await (authenticateStage3Targets (js-object :bootstrapManifestPath manifest :stage3MetadataPath supplied))))
      (let ((path (get authentication :stage3MetadataPath)))
        (setq artifact (merge (await (readCompilerMetadata path)) (js-object :directory (dirname path)))))
      (js-call assert :strictEqual (get artifact :host) "javascript")
      (let ((sources (await (loadCompilerSources))))
        (js-call assert :deepStrictEqual (js-call (js-call (get (get artifact :provenance) :compiledModuleIds) :slice) :sort)
          (js-call (js-call (get sources :modules) :map (lambda (item) (get item :id))) :sort))))
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-stage3-browser-"))))
    (setq packaged (await (packageIndependentCompiler (js-object :artifact artifact :outputRoot (resolve directory "package")))))
    (js-call assert :strictEqual (get (get packaged :manifest) :browserArtifact) "browser/compiler-artifact.json")
    (let* ((derived (await (readCompilerMetadata (resolve (get packaged :directory) (get (get packaged :manifest) :browserArtifact)))))
           (legacy (await (readFile (resolve "tests/compiler-browser-session-test-legacy.mjs") "utf8")))
           (lines (js-call legacy :split "\n")))
      (js-call assert :deepStrictEqual (get derived :sourceIdentity) (get artifact :sourceIdentity))
      (js-call assert :deepStrictEqual (get (get derived :provenance) :originalProductIdentity) (get artifact :productIdentity))
      (js-call assert :strictEqual (js-length cancellations) 19)
      (js-call cancellations :forEach (lambda (item)
        (let ((region (js-call (js-call lines :slice (1- (get item :startLine)) (get item :endLine)) :join "\n")))
          (put item :sourceSha256 (digest legacy)) (put item :regionSha256 (digest region))
          (put item :region (js-object :startLine (get item :startLine) :endLine (get item :endLine) :sha256 (digest region)))))))
    (let* ((page-code (await (bundle "tests/helpers/compiler-browser-session-page.mjs"
                       (js-array "/package/browser/compiler-browser.mjs" "/managed-project-runtime.mjs" "/debug-map.mjs"))))
           (runner (await (bundle "tests/helpers/compiler-browser-session-program.mjs" (js-array "./program.mjs"))))
           (managed (await (bundle "tools/backends/managed-runtime.mjs")))
           (debug (await (bundle "tools/backends/compiler-debug.mjs"))))
      ;; Complete typed products include their runtime IR. Retain the full
      ;; authenticated result instead of applying Bun's default upload ceiling.
      (setq server (js-call globalThis.Bun :serve (js-object :port 0 :maxRequestBodySize 1073741824 :fetch (async (request)
        (let* ((url (new globalThis.URL (get request :url))) (path (get url :pathname)))
          (cond
            ((= path "/") (new globalThis.Response "<!doctype html><title>Authenticated stage3 browser acceptance</title><script type=\"module\" src=\"/page.mjs\"></script>" (js-object :headers (js-object "content-type" "text/html"))))
            ((= path "/page.mjs") (new globalThis.Response page-code (js-object :headers (js-object "content-type" "text/javascript"))))
            ((= path "/managed-project-runtime.mjs") (new globalThis.Response managed (js-object :headers (js-object "content-type" "text/javascript"))))
            ((= path "/debug-map.mjs") (new globalThis.Response debug (js-object :headers (js-object "content-type" "text/javascript"))))
            ((js-call (js-array "/runtime/unicode-case.mjs" "/runtime/unicode-case-data.mjs") :includes path)
              (let* ((id (js-call path :slice 1))
                     (entry (js-call (get (get packaged :manifest) :files) :find
                       (lambda (record) (= (get record :path) id))))
                     (bytes (await (readFile (resolve (get packaged :directory) id)))))
                (js-call assert :ok entry "the shared Unicode URL must name a packaged, declared runtime product")
                (js-call assert :strictEqual (digest bytes) (get entry :sha256))
                (js-call assert :strictEqual (js-length bytes) (get entry :bytes))
                (new globalThis.Response bytes (js-object :headers (js-object "content-type" "text/javascript")))))
            ((js-call path :startsWith "/package/")
              (let* ((base (get packaged :directory)) (file (resolve base (funcall globalThis.decodeURIComponent (js-call path :slice 9))))
                     (id (js-call (js-call (relative base file) :split sep) :join "/")))
                (if (js-call (get (get packaged :manifest) :files) :some (lambda (record) (= (get record :path) id)))
                  (new globalThis.Response (await (readFile file)) (js-object :headers (js-object "content-type" (if (js-call file :endsWith ".mjs") "text/javascript" "application/octet-stream"))))
                  (new globalThis.Response "Not found" (js-object :status 404)))))
            ((js-call path :startsWith "/products/")
              (if (= (get request :method) "POST")
                (let* ((parts (js-call path :split "/")) (key (+ (aref parts 2) "/" (aref parts 3))) (record (or (js-call products :get key) (js-object))))
                  (if (= (aref parts 4) "metadata") (put record :metadata (await (js-call request :json)))
                    (put record :bytes (new globalThis.Uint8Array (await (js-call request :arrayBuffer)))))
                  (js-call products :set key record) (new globalThis.Response nil (js-object :status 204)))
                (new globalThis.Response "Method not allowed" (js-object :status 405))))
            ((js-call path :startsWith "/programs/")
              (cond ((= (get request :method) "POST")
                (unless (js-call (new globalThis.RegExp "^/programs/[1-9][0-9]*/program\\.mjs$") :test path)
                  (throw (new globalThis.TypeError "invalid emitted program transport path")))
                (let* ((original (await (js-call request :text)))
                       (source-path (resolve directory (js-call path :slice 1))))
                  (await (mkdir (dirname source-path) (js-object :recursive t)))
                  (await (writeFile source-path original))
                  (js-call assert :strictEqual (await (readFile source-path "utf8")) original)
                  (let ((transport (await (bundle source-path))))
                    ;; Keep the original compiler byte stream and independent
                    ;; identity alongside the derived URL transport. Neither
                    ;; this bundle nor its hash is a compiler product proof.
                    (js-call programs :set path (js-object :original original :originalSha256 (digest original)
                      :transport transport :transportSha256 (digest transport)))))
                (new globalThis.Response nil (js-object :status 204)))
                ((js-call path :endsWith "/runner.mjs") (new globalThis.Response runner (js-object :headers (js-object "content-type" "text/javascript"))))
                ((js-call programs :has path) (new globalThis.Response (get (js-call programs :get path) :transport) (js-object :headers (js-object "content-type" "text/javascript"))))
                (t (new globalThis.Response "Not found" (js-object :status 404)))))
            (t (new globalThis.Response "Not found" (js-object :status 404)))))))))
    (let* ((require (createRequire (resolve "package.json")))
           (paths (js-call (js-array (js-call globalThis.process :cwd)) :concat
             (js-call (js-call (or (get (get globalThis.process :env) :NODE_PATH) "") :split delimiter) :filter globalThis.Boolean)))
           (playwright (funcall require (js-call require :resolve "playwright-core" (js-object :paths paths))))
           (engine (or (get (get globalThis.process :env) :ELISCRIPT_TEST_BROWSER) "chromium")))
      (js-call assert :ok (js-call (js-array "chromium" "firefox" "webkit") :includes engine))
      (setq browser (await (js-call (get playwright engine) :launch)))))) 120000)

  (afterAll (async ()
    (let ((failed false) (first undefined))
      (try (when browser (await (js-call browser :close))) (catch error (setq failed t) (setq first error)))
      (when server (js-call server :stop t))
      (try
        (let* ((environment (get globalThis.process :env)) (engine (or (get environment :ELISCRIPT_TEST_BROWSER) "chromium"))
               (path (resolve (or (get environment :ELISCRIPT_BROWSER_ACCEPTANCE_REPORT) (+ "dist/browser-session-stage3-" engine ".json")))))
          (await (mkdir (dirname path) (js-object :recursive t)))
          (await (writeFile path (JSON/stringify (js-object :format "eliscript-stage3-browser-acceptance" :version 1
            :engine engine :stage3 authentication :effectiveCount 22 :cancelledCount 19 :observations observations :cancelled cancellations) nil 2))))
        (catch error (unless failed (setq failed t) (setq first error))))
      (when directory (try (await (rm directory (js-object :recursive t :force t))) (catch error (unless failed (setq failed t) (setq first error)))))
      (when failed (throw first)))))

  (register "the complete independent JS compiler runs in a browser and its module Worker with source revision and disposal checks"
    (async () (let ((evidence (await (fresh (js-object :case "basic")))))
      (js-call assert :deepStrictEqual (js-call evidence :map (lambda (item) (js-array (get item :worker) (get item :executed) (get item :stale))))
        (js-array (js-array false 42 "stale-source") (js-array t 42 "stale-source"))))) 120000)

  (defasync prepare-reference ()
    (let* ((source (await (readFile (resolve source-name) "utf8")))
           (modules (js-array (js-object :id entry-name :filename source-name :source source)))
           (sources (await (loadCompilerSources)))
           (reference (js-object :source source :modules modules :runtime (get sources :runtime) :products (js-object) :single (js-object)
             :preparation (resolve directory "products")))
           (configuration (resolve directory "node-reference.json")))
      (await (mkdir (get reference :preparation) (js-object :recursive t)))
      ;; Keep the original independent Node execution boundary while replacing
      ;; its handwritten script with an Eli-emitted maintained helper.
      (await (writeFile configuration (JSON/stringify (js-object :authentication authentication :modules modules
        :source source :filename source-name :entry entry-name :resources resources :nativeTarget native-target
        :output (get reference :preparation)))))
      (let ((child (await (execute-file (or (get (get globalThis.process :env) :NODE) "node")
        (js-array (resolve "tests/helpers/compiler-browser-session-reference.mjs") configuration)
        (js-object :cwd (js-call globalThis.process :cwd) :encoding "utf8" :maxBuffer 1048576)))))
        (js-call assert :strictEqual (get child :stderr) ""))
      (put reference :language (JSON/parse (await (readFile (resolve (get reference :preparation) "reference-language.json") "utf8"))))
      (js-call assert :deepStrictEqual (get (get reference :language) :report) report)
      (let ((targets (js-array "javascript" "wasm" "native")) (index 0))
        (while (< index 3)
          (let ((target (aref targets index)))
            (let ((kinds (js-array "products" "single")) (i 0))
              (while (< i 2)
                (let* ((kind (aref kinds i)) (base (resolve (get reference :preparation) (+ "reference-" kind "-" target)))
                       (record (js-object :metadata (JSON/parse (await (readFile (+ base ".json") "utf8"))))))
                  (unless (= target "javascript") (put record :bytes (new globalThis.Uint8Array (await (readFile (+ base ".bytes"))))))
                  (put (get reference kind) target record)) (setq i (1+ i)))))
          (setq index (1+ index)))) reference))
  (defasync emitted (target)
    (unless (js-call pending :has target)
      (js-call pending :set target (funcall (async ()
        (let* ((result (await (browser-call page (js-object :case "project" :target target))))
               (saved (js-call products :get (+ "project/" target)))
               (expected (get (get fixture :products) target)))
          (js-call assert :ok (get saved :metadata) "actual browser-emitted metadata")
          (js-call assert :strictEqual (get result :host) "javascript")
          (js-call assert :strictEqual (get result :target) target)
          (js-call assert :deepStrictEqual (get saved :metadata) (get expected :metadata) "complete metadata and source spans match independent Node stage3")
          (if (= target "javascript")
            (let ((output (js-call (get (get saved :metadata) :modules) :find (lambda (item) (= (get item :id) entry-name)))))
              (js-call assert :strictEqual (get output :javascript) (get (get (get fixture :language) :compile) :javascript))
              (js-call assert :strictEqual (get output :sourceMap) (get (get (get fixture :language) :compile) :sourceMap)))
            (progn (js-call assert :deepStrictEqual (get saved :bytes) (get expected :bytes) "actual target product bytes")
              (let* ((debug (get (get saved :metadata) :debug)) (map (createCompilerDebugMap debug))
                     (range (js-call (get debug :ranges) :find (lambda (item) (and (get item :span)
                       (= (get (get item :span) :filename) source-name) (> (get item :end) (get item :start)))))))
                (js-call assert :ok (js-call (get debug :sources) :some (lambda (item) (and (= (get item :id) entry-name) (= (get item :filename) source-name)))))
                (js-call assert :ok range)
                (let ((mapped (js-call map :lookup (get range :start) (js-object :functionIndex (get range :functionIndex)))))
                  (js-call assert :strictEqual (get (get mapped :span) :filename) source-name)
                  (js-call assert :ok (and (Number/isInteger (get (get mapped :span) :start)) (Number/isInteger (get (get mapped :span) :end))
                    (>= (get (get mapped :span) :start) 0) (> (get (get mapped :span) :end) (get (get mapped :span) :start))
                    (<= (get (get mapped :span) :end) (js-length (js-call globalThis.Array :from (get fixture :source))))))))))
          (unless (= target "native") (js-call assert :deepStrictEqual (get result :report) report))
          (js-call assert :strictEqual (get (get result :lifetime) :workers) 1)
          (js-call assert :strictEqual (get (get result :lifetime) :terminated) 0) saved)))))
    (await (js-call pending :get target)))
  (defasync ingress (kind)
    (unless (js-call ingress-pending :has kind)
      (js-call ingress-pending :set kind (funcall (async ()
        (let ((results (await (browser-call page (js-object :case "ingress" :kind kind)))))
          (js-call results :forEach (lambda (result)
            (let* ((target (get result :target)) (saved (js-call products :get (+ kind "/" target))))
              (js-call assert :ok (get saved :metadata))
              (when (= kind "single") (js-call assert :deepStrictEqual saved (get (get fixture :single) target)))
              (when (= kind "project")
                (let ((actual (merge (get saved :metadata))) (expected (merge (get (get (get fixture :products) target) :metadata))))
                  (js-call assert :ok (Number/isSafeInteger (get actual :revision)))
                  (js-call assert :ok (Number/isSafeInteger (get expected :revision)))
                  (Reflect/deleteProperty actual "revision") (Reflect/deleteProperty expected "revision")
                  (Reflect/deleteProperty actual "literalRevision") (Reflect/deleteProperty expected "literalRevision")
                  (js-call assert :deepStrictEqual actual expected))
                (unless (= target "javascript") (js-call assert :deepStrictEqual (get saved :bytes) (get (get (get fixture :products) target) :bytes))))
              (when (and (not (= kind "memory")) (not (= target "native"))) (js-call assert :deepStrictEqual (get result :report) report))
              (when (= kind "memory") (js-call assert :strictEqual (get result :abi) "memory-u32"))))) results)))))
    (await (js-call ingress-pending :get kind)))
  (defasync native-managed (product path)
    (await (writeFile path (get product :bytes)))
    (let* ((metadata (get product :metadata))
           (runtime (await (instantiateNativeManagedRuntime path (js-object :typed (get metadata :typed) :descriptor (get metadata :descriptor))
             (merge (get resources :budget) (get resources :memory) (js-object :nativeTarget native-target :debug (get metadata :debug))))))
           (failed false) (first undefined))
      (try
        (js-call runtime :auto (get resources :auto))
        (let ((value (js-call runtime :invoke (report-export-name metadata))))
          (try (js-call assert :deepStrictEqual (normalized (js-call runtime :toHostValue value)) report)
            (finally (js-call runtime :release value))))
        (js-call runtime :collect) (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
        (catch error (setq failed t) (setq first error))
        (finally
          (let ((actions (js-array (lambda () (js-call runtime :closeModule)) (lambda () (js-call runtime :collect))
            (lambda () (js-call assert :strictEqual (js-call runtime :live) 0) (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
            (lambda () (js-call runtime :close)))) (index 0))
            (while (< index (js-length actions)) (try (funcall (aref actions index)) (catch error (unless failed (setq failed t) (setq first error)))) (setq index (1+ index))))))
      (when failed (throw first))))

  (describe "complete browser compiler hosts emit actual three-target language projects" (lambda ()
    (describe "javascript compiler in its actual owned module Worker" (lambda ()
      (beforeAll (async ()
        (setq fixture (await (prepare-reference))) (setq page (await (open-page)))
        (let ((result (await (browser-call page (js-object :case "initialize" :manifestURL (manifest-url) :source (get fixture :source)
          :filename source-name :entry entry-name :modules (get fixture :modules) :runtime (get fixture :runtime)
          :resources resources :nativeTarget native-target)))))
          (js-call assert :deepStrictEqual (get result :compile) (get (get fixture :language) :compile))
          (js-call assert :deepStrictEqual (get result :ir) (JSON/parse (get (get fixture :language) :ir)))
          (js-call assert :strictEqual (get result :canonical) (get (get fixture :language) :canonical)))) 180000)
      (afterAll (async ()
        (when page (try
          (js-call assert :deepStrictEqual (await (browser-call page (js-object :case "dispose"))) (js-object :created 1 :terminated 1 :workers 0 :blobs 0))
          (finally (await (js-call page :close)))))))
      (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (target)
        (register (+ "emits the complete original language fixture to " target " with exact independent Node IR maps debug and product bytes")
          (async () (await (emitted target))) 180000)))
      (js-call (js-array "single" "project" "memory") :forEach (lambda (kind)
        (register (+ "Given the real javascript compiler Worker When " kind " IR is submitted Then actual supported target products execute with exact source maps and cleanup")
          (async () (await (ingress kind))) 180000)))
      (register "Given browser IR emission When its real native libraries execute Then managed and raw ABIs preserve original observations and traps"
        (async ()
          (let ((kinds (js-array "single" "project")) (index 0))
            (while (< index 2)
              (let ((kind (aref kinds index))) (await (ingress kind))
                (await (native-managed (js-call products :get (+ kind "/native")) (resolve (get fixture :preparation) (+ kind (if (= (get globalThis.process :platform) "linux") ".so" ".dylib"))))))
              (setq index (1+ index))))
          (await (ingress "memory"))
          (let* ((product (js-call products :get "memory/native")) (metadata (get product :metadata))
                 (path (resolve (get fixture :preparation) (if (= (get globalThis.process :platform) "linux") "raw.so" "raw.dylib")))
                 (runtime nil) (original undefined) (snapshot undefined))
            (await (writeFile path (get product :bytes)))
            (setq runtime (await (openNativeMemory path (js-object :read32 1 :set32 2 :grow 1 :size 0)
              (js-object :initialPages 1 :maximumPages 2 :nativeTarget native-target :debug (get metadata :debug) :trapSites (get (get metadata :debug) :trapSites)))))
            (try
              (js-call assert :strictEqual (unsigned-bit-shift-right (js-call runtime :invoke "set32" 8 4294967295) 0) 4294967295)
              (js-call assert :strictEqual (unsigned-bit-shift-right (js-call runtime :invoke "read32" 8) 0) 4294967295)
              (js-call assert :throws (lambda () (js-call runtime :invoke "read32" 65533)) (lambda (error) (setq original error) (runtime-error-p error)))
              (js-call assert :ok (and (Array/isArray (get original :eliscriptFrames)) (> (js-length (get original :eliscriptFrames)) 0)))
              (js-call assert :ok (js-call (js-call (createCompilerDebugMap (get metadata :debug)) :mapFrames (get original :eliscriptFrames)) :some
                (lambda (item) (and (get item :source) (get (get item :source) :span) (= (get (get (get item :source) :span) :filename) "browser-memory-ir.eli")))))
              (setq snapshot (funcall globalThis.structuredClone (js-object :frames (get original :eliscriptFrames) :sourceFrames (get original :eliscriptSourceFrames))))
              (js-call assert :strictEqual (js-call runtime :invoke "grow" 1) 1) (js-call assert :strictEqual (js-call runtime :invoke "size") 2)
              (js-call assert :strictEqual (unsigned-bit-shift-right (js-call runtime :invoke "grow" 1) 0) 4294967295)
              (js-call assert :strictEqual (js-call runtime :invoke "set32" 65536 42) 42)
              (finally (js-call runtime :close)))
            (js-call assert :deepStrictEqual (js-object :frames (get original :eliscriptFrames) :sourceFrames (get original :eliscriptSourceFrames)) snapshot))) 180000 (not native-supported))
      (register "the browser-emitted native library actually executes the complete fixture with GC and close cleanup"
        (async ()
          (let ((product (await (emitted "native"))) (old-module (get globalThis.WebAssembly :Module)) (old-instance (get globalThis.WebAssembly :Instance))
                (reject (lambda () (throw (new globalThis.Error "native browser-product execution must not use WASM")))))
            (try
              (put globalThis.WebAssembly :Module (new globalThis.Proxy old-module (js-object :construct reject :apply reject)))
              (put globalThis.WebAssembly :Instance (new globalThis.Proxy old-instance (js-object :construct reject :apply reject)))
              (await (native-managed product (resolve (get fixture :preparation) (if (= (get globalThis.process :platform) "linux") "browser.so" "browser.dylib"))))
              (finally (put globalThis.WebAssembly :Module old-module) (put globalThis.WebAssembly :Instance old-instance))))) 180000 (not native-supported))))))

  (register "runtime source identity binds the complete explicit library input while ordinary compile identity remains stable"
    (async ()
      (let* ((source "\uFEFF(module runtime (defun value () \"中😀\"))")
             (library (js-object :id "runtime/core/value.mjs" :filename "stdlib/managed-runtime-value.eli" :source "\uFEFF(module values (defun value () \"é😀\"))"))
             (request (js-object :operation "runtime" :source source :filename "bootstrap/runtime/memory.eli" :literalSources (js-array library)))
             (before (JSON/stringify request)) (identity (await (compilerSourceIdentity request)))
             (changes (js-array (merge library (js-object :id "runtime/core/other.mjs")) (merge library (js-object :filename "stdlib/renamed-value.eli"))
               (merge library (js-object :source (+ (get library :source) "\n"))) (merge library (js-object :source (js-call (get library :source) :slice 1)))
               (merge library (js-object :source (js-call (get library :source) :replace "é😀" "e\u0301😀")))
               (merge library (js-object :source (js-call (get library :source) :replace "😀" "😁")))
               (merge library (js-object :source (+ (get library :source) "; \ud800"))) (merge library (js-object :source (+ (get library :source) "; \udc00"))))) (index 0))
        (js-call assert :strictEqual (await (compilerSourceIdentity (JSON/stringify request))) identity)
        (js-call assert :strictEqual (JSON/stringify request) before "identity must not alter source records")
        (while (< index (js-length changes))
          (js-call assert :notStrictEqual (await (compilerSourceIdentity (merge request (js-object :literalSources (js-array (aref changes index)))))) identity)
          (setq index (1+ index)))
        (js-call assert :notStrictEqual (await (compilerSourceIdentity (merge request (js-object :source (js-call source :slice 1))))) identity)
        (let* ((omitted (js-object :operation "runtime" :source source :filename (get request :filename)))
               (second (js-object :id "runtime/core/list.mjs" :filename "stdlib/managed-runtime-list.eli" :source "(module list)"))
               (options (merge request (js-object :target "native" :nativeTarget "arm64-linux" :memory (js-object :initialPages 4 :maximumPages 1024)
                 :options (js-object :debug t) :sourceMap (js-object :generatedFile "ignored.mjs")))))
          (js-call assert :notStrictEqual (await (compilerSourceIdentity omitted)) (await (compilerSourceIdentity (merge omitted (js-object :literalSources (js-array))))))
          (js-call assert :notStrictEqual identity (await (compilerSourceIdentity (merge request (js-object :literalSources (js-array))))))
          (js-call assert :notStrictEqual (await (compilerSourceIdentity (merge request (js-object :literalSources (js-array library second)))))
            (await (compilerSourceIdentity (merge request (js-object :literalSources (js-array second library))))))
          (js-call assert :strictEqual (await (compilerSourceIdentity options)) identity "output choices are not source changes")
          (js-call assert :notStrictEqual (await (compilerRequestIdentity options)) (await (compilerRequestIdentity request))))
        (let* ((compile (js-object :operation "compile" :source "(defun run () \"😀\")" :filename "ordinary.eli"))
               (snapshot (JSON/stringify (js-object :filename (get compile :filename) :source (get compile :source)
                 :macroContext (js-object :capabilities (js-array) :files (js-array)))))
               (bytes (new globalThis.Uint8Array (* (js-length snapshot) 2))) (view (new globalThis.DataView (get bytes :buffer))) (position 0))
          (while (< position (js-length snapshot))
            (js-call view :setUint16 (* position 2) (js-call snapshot :charCodeAt position) t) (setq position (1+ position)))
          (let ((hash (digest bytes)))
            (js-call assert :strictEqual (await (compilerSourceIdentity compile)) hash)
            (js-call assert :strictEqual (await (compilerSourceIdentity (merge compile (js-object :target "wasm" :options (js-object :debug t) :literalSources (js-array library))))) hash))
          (let ((operations (js-array "compile" "compile-ir" "stage" "format" "analyze" "query")) (i 0))
            (while (< i (js-length operations))
              (let* ((operation (aref operations i)) (original (merge compile (js-object :operation operation)))
                     (ignored (merge original (js-object :literalSources (js-array library) :target "native" :options (js-object :debug t)))))
                (js-call assert :strictEqual (await (compilerSourceIdentity ignored)) (await (compilerSourceIdentity original)) operation)
                (js-call assert :notStrictEqual (await (compilerRequestIdentity ignored)) (await (compilerRequestIdentity original)) operation))
              (setq i (1+ i))))
          (let ((project (js-object :operation "project" :entry "entry.mjs" :modules (js-array (js-object :id "entry.mjs" :source (get compile :source) :filename (get compile :filename))))))
            (js-call assert :notStrictEqual (await (compilerSourceIdentity project)) (await (compilerSourceIdentity (merge project (js-object :literalSources (js-array))))))
            (js-call assert :notStrictEqual (await (compilerSourceIdentity (merge project (js-object :literalSources (js-array library)))))
              (await (compilerSourceIdentity (merge project (js-object :literalSources (js-array (merge library (js-object :source (+ (get library :source) "\n"))))))))))))) 120000)

  (register "browser runtime and library downloads preserve BOM and split UTF-8 through the actual asset loader"
    (async () (await (fresh (js-object :case "asset" :mode "split")))) 120000)
  (register "browser runtime and library JSON source assets preserve isolated UTF16 surrogates without replacement"
    (async () (await (fresh (js-object :case "asset" :mode "json")))) 120000)
  (register "malformed UTF-8 in either runtime or library rejects before dispatch and a corrected retry has no failed cached state"
    (async ()
      (let ((results (await (fresh (js-object :case "asset" :mode "malformed")))))
        (js-call assert :strictEqual (js-length results) 8)
        (js-call results :forEach (lambda (result)
          (js-call assert :strictEqual (get (get result :failure) :name) "TypeError")
          (js-call assert :strictEqual (get result :registered) 1) (js-call assert :strictEqual (get result :dispatched) 1)
          (js-call assert :strictEqual (get (get result :counts) "runtime.eli") 2)
          (js-call assert :strictEqual (get (get result :counts) "library.eli") (if (= (get result :failing) "runtime.eli") 1 2))
          (js-call assert :strictEqual (get (get result :counts) "compiler-artifact.json") 1))))) 120000)
  (register "a declared browser artifact identity must completely and unambiguously bind the requested source asset"
    (async ()
      (let ((failures (await (fresh (js-object :case "asset" :mode "declarations")))))
        (js-call assert :strictEqual (js-length failures) 13)
        (js-call failures :forEach (lambda (failure)
          (js-call assert :strictEqual (get failure :name) "TypeError")
          (js-call assert :match (get failure :message) (new globalThis.RegExp "compiler (?:artifact resource identit|resource has no artifact identity)")))))) 120000)
  (register "browser source assets must match their emitted byte identities before any compiler dispatch and may retry an interrupted download"
    (async ()
      (let ((results (await (fresh (js-object :case "asset" :mode "identity")))))
        (js-call assert :strictEqual (js-length results) 4)
        (js-call results :forEach (lambda (result)
          (js-call assert :match (get (get result :failure) :message)
            (new globalThis.RegExp (if (= (get result :mismatch) "length") "byte count mismatch" "SHA-256 mismatch")))
          (js-call assert :strictEqual (get (get result :counts) (get result :failing)) 2))))) 120000)
  (js-call (js-array false t) :forEach (lambda (fails)
    (register (+ "a pending browser runtime download respects an explicit runtime " (if fails "failure without losing the default initialization" "success without a second default dispatch"))
      (async ()
        (let* ((result (await (fresh (js-object :case "asset" :mode "competition" :explicitFails fails))))
               (expected (if fails (js-array (get result :explicit) (get result :fallback)) (js-array (get result :explicit)))))
          (js-call assert :deepStrictEqual (js-call (get result :dispatched) :map (lambda (payload) (get payload :source))) expected)
          (js-call assert :deepStrictEqual (js-call (get result :registered) :map (lambda (item) (get (get item :payload) :source))) expected)
          (js-call assert :strictEqual (get result :failure) (if fails "explicit runtime compilation failed" undefined)))) 120000)))
  (register "Given javascript browser semantic results When previewing Unicode edits Then text identities and Worker revisions reject stale changes without publishing"
    (async ()
      (js-call assert :deepStrictEqual (await (fresh (js-object :case "semantic")))
        (js-call (js-array false t) :map (lambda (worker) (js-object :worker worker :unpublished "stale-source" :stale "stale-source" :compilerRefusal "ELI-T0002"))))) 180000)
  (register "Given a real javascript browser compiler Worker When IR changes under unchanged source text Then stale edits reject and source projects remain isolated"
    (async ()
      (let ((result (await (fresh (js-object :case "ir-edits")))))
        (js-call assert :strictEqual (get result :host) "javascript")
        (js-call assert :deepStrictEqual (get result :codes) (js-array "stale-source" "stale-source" "stale-source"))
        (js-call assert :deepStrictEqual (get result :lifetime) (js-object :created 1 :terminated 1 :workers 0 :blobs 0)))) 180000)
  (js-call (js-array "emit-ir" "project-ir" "emit-memory-ir") :forEach (lambda (operation)
    (register (+ "Given an actual posted " operation " request in the javascript browser compiler Worker When it is cancelled and disposed Then owned resources are released")
      (async ()
        (let ((result (await (fresh (js-object :case "cancel-posted" :operation operation)))))
          (js-call assert :strictEqual (get result :host) "javascript") (js-call assert :strictEqual (get result :operation) operation)
          (js-call assert :strictEqual (get result :message) (+ "cancel posted " operation))
          (js-call assert :deepStrictEqual (get result :actualPost) (js-object :type "request" :operation operation))
          (js-call assert :deepStrictEqual (get result :lifetime) (js-object :created 1 :terminated 1 :workers 0 :blobs 0)))) 180000)))
  (export cancellations))
