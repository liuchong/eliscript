(module tests.core-syntax
  ;; 0.1.0 core syntax and runtime acceptance for the JavaScript runtime.
  ;; Programs and expectations live in tests/fixtures/core-syntax/*.el;
  ;; this module isolates and times each case, compares "oracle" cases with
  ;; native Emacs, and adds the WASM, package, che and AOT module compiler checks.
  (import "bun:test" test expect)
  (import "node:child_process" spawnSync)
  (import "node:fs" existsSync mkdirSync readFileSync readdirSync rmSync writeFileSync)
  (import "node:module" createRequire)
  (import "node:path" resolve)
  (import "node:perf_hooks" performance)
  (import "node:url" pathToFileURL)
  (import "../dist/bootstrap/compiler.mjs" compile-string)
  (import "../dist/runtime/lisp.mjs"
          callSession compileModule createSession evalProgram
          getTimingReport invokeFunction resetSessionState
          runAbiNative runAbiWasm serializeValue)

  (defconst project-root (js-call globalThis.process :cwd))
  (defconst fixture-directory (resolve project-root "tests/fixtures/core-syntax"))
  (defconst emacs-program (or (get (get globalThis.process :env) :EMACS) "emacs"))
  (defconst che-root (resolve project-root "../termini-platform/che"))
  (defconst che-files
    (js-array "lisp/core/che-align.el" "lisp/core/che-session-delta.el"
              "lisp/core/che-session-restore-codec.el" "lisp/core/che-session-restore-value.el"
              "lisp/core/che-session-publication-capture.el" "lisp/core/che-session-publication-json.el"
              "lisp/core/che-mdp.el" "lisp/core/che-context-budget.el" "lisp/cli/che-cli.el"))
  (defconst che-stub-features
    (js-array "che-session" "che-context" "che-event" "che-model-capabilities" "che-agent" "che-ui"))
  (defconst timings (js-array))

  ;; ------------------------------------------------------------------
  ;; Fixture parsing and isolated, timed execution
  ;; ------------------------------------------------------------------

  (defun parse-fixture (file)
    (let ((lines (js-call (readFileSync file "utf8") :split "\n"))
          (cases (js-array))
          (current nil)
          (index 0))
      (while (< index (js-length lines))
        (let ((line (js-nth index lines)))
          (cond
            ((js-call line :startsWith ";;;; case ")
              (setq current (js-object :id (js-call (js-call line :slice 10) :trim)
                                       :code "" :expect undefined :error nil :oracle false :extension false
                                       :file file))
              (js-call cases :push current))
            ((nil? current) nil)
            ((js-call line :startsWith ";;;; expect ")
              (put current :expect (JSON/parse (js-call line :slice 12))))
            ((js-call line :startsWith ";;;; error ")
              (put current :error (js-call (js-call line :slice 11) :trim)))
            ((= (js-call line :trim) ";;;; oracle")
              (put current :oracle t))
            ((= (js-call line :trim) ";;;; oracle extension")
              (put current :oracle t)
              (put current :extension t))
            (t (put current :code (str (get current :code) line "\n")))))
        (setq index (1+ index)))
      (js-call cases :forEach (lambda (entry)
        (unless (get entry :oracle)
          (throw (new globalThis.TypeError
            (str "language fixture must declare a GNU Emacs reference: " (get entry :id)))))))
      cases))

  (defun fixture-files ()
    (let ((names (js-call (js-call (readdirSync fixture-directory) :filter
                                   (lambda (name) (and (js-call name :startsWith "t")
                                                       (js-call name :endsWith ".el"))))
                          :sort)))
      (js-call names :map (lambda (name) (resolve fixture-directory name)))))

  (defun record-timing (id domain started status)
    (js-call timings :push
             (js-object :id id :domain domain :status status
                        :elapsedMs (/ (Math/round (* (- (js-call performance :now) started) 10000)) 10000))))

  (defun run-timed (id domain thunk)
    (resetSessionState)
    (let ((started (js-call performance :now))
          (status "failed"))
      (try
        (let ((value (funcall thunk)))
          (setq status "passed")
          value)
        (finally
          (record-timing id domain started status)
          (resetSessionState)))))

  (defun error-text (error)
    (str (get error :message) " " (or (get error :conditionSymbol) "")))

  (defun evaluate-case (entry session)
    ;; Return {ok, value} or {ok: false, message} without throwing.
    (try
      (js-object :ok t
                 :value (serializeValue
                         (evalProgram (get entry :code) (js-object :session session))))
      (catch error (js-object :ok false :message (error-text error)
                             :condition (get error :conditionSymbol)))))

  ;; ------------------------------------------------------------------
  ;; Native Emacs oracle
  ;; ------------------------------------------------------------------

  (defun run-emacs-oracle (entries provide load)
    (let* ((payload (JSON/stringify
                     (js-call entries :map
                              (lambda (entry) (js-object :id (get entry :id) :code (get entry :code)
                                                        :extension (= (get entry :extension) t))))))
           (environment (Object/assign (js-object) (get globalThis.process :env)
                                       (js-object :ELISCRIPT_ORACLE_CASES payload
                                                  :ELISCRIPT_ORACLE_PROVIDE (JSON/stringify provide)
                                                  :ELISCRIPT_ORACLE_LOAD (JSON/stringify load))))
           (child (spawnSync emacs-program
                             (js-array "--batch" "-Q" "-L" "editor" "-L" "compiler"
                                       "-l" "tests/fixtures/core-syntax/oracle-driver.el")
                             (js-object :cwd project-root :env environment :encoding "utf8"
                                        :maxBuffer 67108864 :timeout 10000))))
      (unless (= (get child :status) 0)
        (throw (new globalThis.Error (str "native Emacs oracle failed: "
                                          (get child :stderr) (get child :stdout)))))
      (let ((results (new globalThis.Map))
            (parsed (JSON/parse (js-call (get child :stdout) :trim))))
        (js-call parsed :forEach (lambda (item) (js-call results :set (get item :id) item)))
        results)))

  (defvar runtime-oracle nil)

  (defun runtime-oracle-results ()
    (when (nil? runtime-oracle)
      (let ((entries (js-array)))
        (js-call (fixture-files) :forEach
                 (lambda (file)
                   (js-call (parse-fixture file) :forEach
                            (lambda (entry) (when (get entry :oracle) (js-call entries :push entry))))))
        (setq runtime-oracle (run-emacs-oracle entries (js-array) (js-array)))))
    runtime-oracle)

  (defun check-case (entry)
    (let* ((domain (js-call (get entry :id) :slice 0 3))
           (outcome (run-timed (get entry :id) domain
                               (lambda () (evaluate-case entry (createSession))))))
      (when (get entry :oracle)
        (let ((native (js-call (runtime-oracle-results) :get (get entry :id))))
          (js-call (expect native) :toBeDefined)
          (js-call (expect (get native :ok)) :toBe (get outcome :ok))
          (if (get native :ok)
            (progn
              (unless (undefined? (get entry :expect))
                (js-call (expect (get entry :expect)) :toEqual (get native :value)))
              (js-call (expect (get outcome :value)) :toEqual (get native :value)))
            (js-call (expect (get outcome :condition)) :toBe (get native :condition)))))
      (if (get entry :error)
          (progn
            (js-call (expect (get outcome :ok)) :toBe false)
            (js-call (expect (get outcome :message)) :toMatch
                     (new globalThis.RegExp (get entry :error) "i")))
        (progn
          (unless (get outcome :ok)
            (throw (new globalThis.Error (str (get entry :id) " failed: " (get outcome :message)))))
          (unless (undefined? (get entry :expect))
            (js-call (expect (get outcome :value)) :toEqual (get entry :expect)))))))

  ;; One Bun test per fixture case: T01-T11 and T13.
  (js-call (fixture-files) :forEach
           (lambda (file)
             (js-call (parse-fixture file) :forEach
                      (lambda (entry)
                        (test (str (get entry :id) ": " (js-call (get entry :file) :slice
                                                                 (1+ (js-length fixture-directory))))
                              (lambda () (check-case entry)))))))

  ;; ------------------------------------------------------------------
  ;; T10: WebAssembly and ARM64 Native ABI kernels
  ;; ------------------------------------------------------------------

  (defconst abi-source
    (str "(require 'eliscript) (require 'eliscript-abi)\n"
         "(defun hyp-sq (a b) (declare (eliscript :abi :numeric-f64 :export \"hyp_sq\"\n"
         "  :params ((a :f64) (b :f64)) :returns :f64)) (+ (* a a) (* b b)))\n"
         "(defun dot3 (x y z) (declare (eliscript :abi :numeric-f64 :export \"dot3\"\n"
         "  :params ((x :f64) (y :f64) (z :f64)) :returns :f64)) (- (+ (* x 2.0) (* y 3.0)) z))\n"
         "(defun mem-checksum (offset) (declare (eliscript :abi :memory-u32 :export \"mem_checksum\"\n"
         "  :params ((offset :u32)) :returns :u32)) (mem-store-u32 offset 305419896)\n"
         "  (word-add (mem-load-u32 offset) 1))\n"
         "(defun mem-mix (offset seed) (declare (eliscript :abi :memory-u32 :export \"mem_mix\"\n"
         "  :params ((offset :u32) (seed :u32)) :returns :u32))\n"
         "  (mem-store-u32 offset (word-xor (word-shl seed 3) 255))\n"
         "  (word-add (mem-load-u32 offset) 7))\n"
         "(defun mem-unaligned (offset) (declare (eliscript :abi :memory-u32 :export \"mem_unaligned\"\n"
         "  :params ((offset :u32)) :returns :u32))\n"
         "  (mem-store-u32 offset 305419896) (mem-load-u32 offset))\n"
         "(defun let-demo (x) (declare (eliscript :abi :numeric-f64 :export \"let_demo\"\n"
         "  :params ((x :f64)) :returns :f64))\n"
         "  (let ((y (+ x 1.0))) (* y y)))\n"
         "(defun kernel-saxpy (n a) (declare (eliscript :abi :numeric-f64 :export \"kernel_saxpy\"\n"
         "  :params ((n :u32) (a :f64)) :returns :f64))\n"
         "  (let ((i 0) (acc 0.0))\n"
         "    (while (< i n)\n"
         "      (setq acc (+ acc (* a 2.0)))\n"
         "      (setq i (+ i 1)))\n"
         "    acc))\n"
         "(defun neg-inv (x) (declare (eliscript :abi :numeric-f64 :export \"neg_inv\"\n"
         "  :params ((x :f64)) :returns :f64)) (/ 1.0 (- x)))\n"
         "(defun neg-zero-lit () (declare (eliscript :abi :numeric-f64 :export \"neg_zero_lit\"\n"
         "  :params () :returns :f64)) (/ 1.0 -0.0))\n"
         "(defun ident-clash (a-b a_b) (declare (eliscript :abi :numeric-f64 :export \"ident_sep\"\n"
         "  :params ((a-b :f64) (a_b :f64)) :returns :f64)) (- a-b a_b))\n"))

  (test "T10-02: :abi kernels execute on WebAssembly and ARM64 Native"
        (async ()
          (resetSessionState)
          (let ((started (js-call performance :now)))
            (js-call (expect (await (runAbiWasm abi-source "hyp_sq" (js-array 3.0 4.0)))) :toBe 25)
            (js-call (expect (await (runAbiWasm abi-source "dot3" (js-array 4.0 5.0 3.5)))) :toBe 19.5)
            (js-call (expect (unsigned-bit-shift-right
                              (await (runAbiWasm abi-source "mem_checksum" (js-array 64))) 0))
                     :toBe 305419897)
            (js-call (expect (unsigned-bit-shift-right
                              (await (runAbiWasm abi-source "mem_mix" (js-array 128 9))) 0))
                     :toBe 190)
            (js-call (expect (await (runAbiNative abi-source "hyp_sq" (js-array 3.0 4.0)))) :toBe 25)
            (js-call (expect (await (runAbiNative abi-source "dot3" (js-array 4.0 5.0 3.5)))) :toBe 19.5)
            (js-call (expect (unsigned-bit-shift-right
                              (await (runAbiNative abi-source "mem_checksum" (js-array 64))) 0))
                     :toBe 305419897)
            (js-call (expect (unsigned-bit-shift-right
                              (await (runAbiNative abi-source "mem_mix" (js-array 128 9))) 0))
                     :toBe 190)
            (record-timing "T10-02" "T10" started "passed"))))

  (test "T10-03: :abi WebAssembly and ARM64 Native parity on bounds traps, control flow, -0.0, and identifiers"
        (async ()
          (resetSessionState)
          (let ((started (js-call performance :now)))
            ;; Unaligned memory access and out-of-bounds traps match between WASM and Native
            (js-call (expect (unsigned-bit-shift-right
                              (await (runAbiWasm abi-source "mem_unaligned" (js-array 1))) 0))
                     :toBe 305419896)
            (js-call (expect (unsigned-bit-shift-right
                              (await (runAbiNative abi-source "mem_unaligned" (js-array 1))) 0))
                     :toBe 305419896)
            (let ((oob-wasm false) (oob-nat false) (neg-wasm false) (neg-nat false))
              (try (await (runAbiWasm abi-source "mem_unaligned" (js-array 65536))) (catch _e (setq oob-wasm t)))
              (try (await (runAbiNative abi-source "mem_unaligned" (js-array 65536))) (catch _e (setq oob-nat t)))
              (try (await (runAbiWasm abi-source "mem_unaligned" (js-array -4))) (catch _e (setq neg-wasm t)))
              (try (await (runAbiNative abi-source "mem_unaligned" (js-array -4))) (catch _e (setq neg-nat t)))
              (js-call (expect (js-array oob-wasm oob-nat neg-wasm neg-nat)) :toEqual (js-array t t t t)))
            ;; let, while, setq, unary negation, -0.0, and identifier encoding parity
            (js-call (expect (await (runAbiWasm abi-source "let_demo" (js-array 3.0)))) :toBe 16)
            (js-call (expect (await (runAbiNative abi-source "let_demo" (js-array 3.0)))) :toBe 16)
            (js-call (expect (await (runAbiWasm abi-source "kernel_saxpy" (js-array 4 3.5)))) :toBe 28)
            (js-call (expect (await (runAbiNative abi-source "kernel_saxpy" (js-array 4 3.5)))) :toBe 28)
            (js-call (expect (await (runAbiWasm abi-source "neg_inv" (js-array 0.0)))) :toBe (- (/ 1.0 0.0)))
            (js-call (expect (await (runAbiNative abi-source "neg_inv" (js-array 0.0)))) :toBe (- (/ 1.0 0.0)))
            (js-call (expect (await (runAbiWasm abi-source "neg_zero_lit" (js-array)))) :toBe (- (/ 1.0 0.0)))
            (js-call (expect (await (runAbiNative abi-source "neg_zero_lit" (js-array)))) :toBe (- (/ 1.0 0.0)))
            (js-call (expect (await (runAbiWasm abi-source "ident_sep" (js-array 9.0 4.0)))) :toBe 5)
            (js-call (expect (await (runAbiNative abi-source "ident_sep" (js-array 9.0 4.0)))) :toBe 5)
            ;; Duplicate parameter names are rejected by both WASM and Native
            (let ((dup-src "(require 'eliscript-abi) (defun dup (x x) (declare (eliscript :abi :numeric-f64 :export \"dup\" :params ((x :f64) (x :f64)) :returns :f64)) x)")
                  (dup-wasm false)
                  (dup-nat false))
              (try (await (runAbiWasm dup-src "dup" (js-array 1.0 2.0))) (catch _e (setq dup-wasm t)))
              (try (await (runAbiNative dup-src "dup" (js-array 1.0 2.0))) (catch _e (setq dup-nat t)))
              (js-call (expect (js-array dup-wasm dup-nat)) :toEqual (js-array t t)))
            (record-timing "T10-03" "T10" started "passed"))))

  ;; ------------------------------------------------------------------
  ;; T14/T15: unmodified che modules and native Emacs differential oracle
  ;; ------------------------------------------------------------------

  (defun che-available ()
    (existsSync (resolve che-root "lisp/core/che-align.el")))

  (defun che-absolute-files ()
    (js-call che-files :map (lambda (relative) (resolve che-root relative))))

  (defun che-session ()
    (let ((session (createSession)))
      (js-call che-stub-features :forEach
               (lambda (feat) (evalProgram (str "(provide '" feat ")") (js-object :session session))))
      (js-call (che-absolute-files) :forEach
               (lambda (file) (evalProgram (readFileSync file "utf8") (js-object :session session :filename file))))
      session))

  (defun che-optional-in-ci ()
    (and (not (che-available))
         (= (get (get globalThis.process :env) :GITHUB_ACTIONS) "true")))

  (funcall (js-call test :skipIf (che-optional-in-ci))
        "T14-01 & T15-01: unmodified che modules load and match native Emacs"
        (lambda ()
          (js-call (expect (che-available)) :toBe t)
          (run-timed "T15-01" "T15"
                     (lambda ()
                       (let* ((probes (parse-fixture (resolve fixture-directory "che-probes.el")))
                              (native (run-emacs-oracle probes che-stub-features
                                                        (che-absolute-files)))
                              (session (che-session)))
                         (js-call probes :forEach
                                  (lambda (probe)
                                    (let ((actual (evaluate-case probe session))
                                          (expected (js-call native :get (get probe :id))))
                                      (unless (get expected :ok)
                                        (throw (new globalThis.Error
                                                    (str (get probe :id) " native failure: "
                                                         (get expected :error)))))
                                      (unless (get actual :ok)
                                        (throw (new globalThis.Error
                                                    (str (get probe :id) " failed: " (get actual :message)))))
                                      (js-call (expect (js-array (get probe :id) (get actual :value))) :toEqual
                                               (js-array (get probe :id) (get expected :value)))))))))))

  ;; ------------------------------------------------------------------
  ;; T16: Dual-Host .el -> Eliscript module -> .mjs, and Worker entry points
  ;; ------------------------------------------------------------------

  (defconst fallback-align-source
    (str "(defun che-align-column-widths (rows)\n"
         "  (let ((widths nil))\n"
         "    (dolist (row rows)\n"
         "      (let ((index 0))\n"
         "        (dolist (cell row)\n"
         "          (let ((w (string-width (or cell \"\"))))\n"
         "            (if (< index (length widths))\n"
         "                (setf (nth index widths) (max (nth index widths) w))\n"
         "              (setq widths (append widths (list w)))))\n"
         "          (setq index (1+ index)))))\n"
         "    widths))\n"))

  (test "T16-01: compileModule emits a genuine AOT Eliscript module that compiles and runs"
        (lambda ()
          (unless (che-optional-in-ci)
            (js-call (expect (che-available)) :toBe t))
          (run-timed "T16-01" "T16"
                     (lambda ()
                       (let* ((source (if (che-available)
                                          (str (readFileSync (resolve che-root "lisp/core/che-align.el") "utf8") "\n"
                                               (readFileSync (resolve che-root "lisp/core/che-mdp.el") "utf8"))
                                        fallback-align-source))
                              (module-source (compileModule source
                                                            (js-object :moduleName "tests.generated.che-accelerated"
                                                                       :runtime "../runtime/lisp.mjs")))
                              (directory (resolve project-root "dist/lisp-tests"))
                              (output (resolve directory "che-accelerated.mjs")))
                         (js-call (expect (js-call module-source :startsWith "(module ")) :toBe t)
                         (js-call (expect (js-call module-source :includes (str "(js" "*"))) :toBe false)
                         (js-call (expect (js-call module-source :includes "elisp-source")) :toBe false)
                         (js-call (expect (js-call module-source :includes "callElisp")) :toBe t)
                         (mkdirSync directory (js-object :recursive t))
                         (try
                           (progn
                             (let ((compiled-js (compile-string module-source "che-accelerated.eli")))
                               (js-call (expect (js-call compiled-js :includes "elisp_source")) :toBe false)
                               (writeFileSync output compiled-js "utf8"))
                             (let* ((loaded (funcall (createRequire (get (pathToFileURL output) :href)) output))
                                    (rows (js-array (js-array "模块名称" "编译状态" "双端一致性")
                                                    (js-array "che-align.el" "direct-mjs" "100% 通过")
                                                    (js-array "che-session-restore-codec.el" "direct-mjs" "SHA-256 链一致"))))
                               (js-call (expect (js-call (funcall (get loaded :elispFunctions)) :includes
                                                         "che-align-column-widths"))
                                        :toBe t)
                               (js-call (expect (serializeValue
                                                 (funcall (get loaded :invokeElisp) "che-align-column-widths" rows)))
                                        :toEqual (js-array 28 10 14))
                               (js-call (expect (funcall (get loaded :callElisp) "che-align-column-widths"
                                                         "(((\"中文\" \"abc\") (\"a\" \"测试值\")))"))
                                        :toBe "(4 6)")))
                           (finally
                             (rmSync directory (js-object :recursive t :force t))))
                         ;; The same entry points work directly on a session.
                         (let ((session (createSession)))
                           (evalProgram fallback-align-source (js-object :session session))
                           (js-call (expect (callSession session "che-align-column-widths" "(((\"ab\" \"中\")))"))
                                    :toBe "(2 2)")
                           (js-call (expect (serializeValue
                                             (invokeFunction session "che-align-column-widths"
                                                             (js-array (js-array (js-array "x" "yy"))))))
                                    :toEqual (js-array 1 2))))))))

  (test "T16-02: AOT compileModule matches interpreter and native Emacs across t13 and che-probes"
        (lambda ()
          (run-timed "T16-02" "T16"
                     (lambda ()
                       (let* ((t13-cases (parse-fixture (resolve fixture-directory "t13.el")))
                              (directory (resolve project-root "dist/lisp-aot-tests"))
                              (require-fn (createRequire (get (pathToFileURL (resolve project-root "package.json")) :href))))
                         (mkdirSync directory (js-object :recursive t))
                         (try
                           (js-call t13-cases :forEach
                                    (lambda (entry idx)
                                      (let* ((eli (compileModule (get entry :code)
                                                                 (js-object :moduleName (str "tests.aot.t13." idx)
                                                                            :runtime "../runtime/lisp.mjs")))
                                             (js (compile-string eli (str "t13-" idx ".eli")))
                                             (mjs-path (resolve directory (str "t13-" idx ".mjs")))
                                             (native (js-call (runtime-oracle-results) :get (get entry :id))))
                                        (js-call (expect (js-call eli :includes "elisp-source")) :toBe false)
                                        (js-call (expect (js-call js :includes "elisp_source")) :toBe false)
                                        (writeFileSync mjs-path js "utf8")
                                        (let* ((mod (funcall require-fn mjs-path))
                                               (actual (serializeValue (funcall (get mod :getLoaded)))))
                                          (js-call (expect (js-array (get entry :id) actual)) :toEqual
                                                   (js-array (get entry :id) (get native :value)))))))
                           (finally
                             (rmSync directory (js-object :recursive t :force t)))))))))

  (test "T16-03: extension gating, with-eval-after-load deferral, and dynamic lexical-binding parity across GNU Emacs, interpreter, and AOT"
        (lambda ()
          (run-timed "T16-03" "T16"
                     (lambda ()
                       (let* ((directory (resolve project-root "dist/lisp-parity-tests"))
                              (require-fn (createRequire (get (pathToFileURL (resolve project-root "package.json")) :href)))
                              (run-emacs-file
                               (lambda (file-path after-expr)
                                 (let* ((args (js-array "--batch" "-Q" "-L" "editor" "-l" file-path
                                                        "--eval" (str "(princ (prin1-to-string " after-expr "))")))
                                        (child (spawnSync emacs-program args
                                                          (js-object :cwd project-root :encoding "utf8"))))
                                   (unless (= (get child :status) 0)
                                     (throw (new globalThis.Error (str "GNU Emacs failed on " file-path ": " (get child :stderr)))))
                                   (js-call (get child :stdout) :trim))))
                              (run-all-three
                               (lambda (name code ext after-expr)
                                 (let ((src-path (resolve directory (str name ext))))
                                   (writeFileSync src-path code "utf8")
                                   (let ((emacs-out (funcall run-emacs-file src-path after-expr))
                                         (interp-session (createSession)))
                                     (evalProgram code (js-object :session interp-session :filename src-path))
                                     (let* ((interp-out (evalProgram (str "(prin1-to-string " after-expr ")")
                                                                     (js-object :session interp-session)))
                                            (eli (compileModule code (js-object :moduleName (str "tests.parity." name)
                                                                                :runtime "../runtime/lisp.mjs"
                                                                                :sourceFile src-path)))
                                            (js (compile-string eli (str name ".eli")))
                                            (mjs-path (resolve directory (str name ".mjs"))))
                                       (writeFileSync mjs-path js "utf8")
                                       (let ((mod (funcall require-fn mjs-path)))
                                         (funcall (get mod :getLoaded))
                                         (let ((aot-out (funcall (get mod :evalElisp) after-expr)))
                                           (js-call (expect interp-out) :toBe emacs-out)
                                           (js-call (expect aot-out) :toBe emacs-out)
                                           emacs-out))))))))
                         (mkdirSync directory (js-object :recursive t))
                         (try
                           (progn
                             ;; 1. Unextended Elisp can define ordinary functions named pmap, match, if-let, and fset when
                             (js-call (expect (funcall run-all-three "ext-gate"
                                                       "(defun pmap (x) (+ x 1)) (defun match (a b) (list a b)) (defun if-let (a b) (+ a b)) (fset 'when (lambda (a b) (list a b)))"
                                                       ".el"
                                                       "(list (pmap 41) (match 'k 9) (if-let 1 2) (when 1 2))"))
                                      :toBe "(42 (k 9) 3 (1 2))")
                             ;; 2. with-eval-after-load defers until end of file load and does not duplicate-fire on repeated provide
                             (js-call (expect (funcall run-all-three "after-load-order"
                                                       "(setq review-seen nil) (with-eval-after-load 'review-order (setq review-seen review-late)) (provide 'review-order) (setq review-late 9) (setq review-in-file review-seen)"
                                                       ".el"
                                                       "(list review-in-file review-seen)"))
                                      :toBe "(nil 9)")
                             (js-call (expect (funcall run-all-three "after-load-once"
                                                       "(setq hits 0) (with-eval-after-load 'f (setq hits (1+ hits))) (provide 'f) (provide 'f) (setq hits-in-file hits)"
                                                       ".el"
                                                       "(list hits-in-file hits)"))
                                      :toBe "(0 2)")
                             ;; 3. Dynamic binding cross-function call and uncookied .el / .eli parity (R655-01 & R655-03)
                             (js-call (expect (funcall run-all-three "dyn-cross-call"
                                                       "(defun reader () x) (defun forward (x) (reader))"
                                                       ".el"
                                                       "(condition-case nil (forward 17) (void-variable 'unbound))"))
                                      :toBe "17")
                             (js-call (expect (funcall run-all-three "dyn-escaped-el"
                                                       "(setq saved (let ((x 7)) (lambda () x)))"
                                                       ".el"
                                                       "(condition-case nil (funcall saved) (void-variable 'unbound))"))
                                      :toBe "unbound")
                             (js-call (expect (funcall run-all-three "dyn-escaped-eli"
                                                       "(setq saved (let ((x 7)) (lambda () x)))"
                                                       ".eli"
                                                       "(condition-case nil (funcall saved) (void-variable 'unbound))"))
                                      :toBe "unbound")
                             (js-call (expect (funcall run-all-three "lex-closure-in-dyn"
                                                       ";;; -*- lexical-binding: t -*-\n(setq cb (let ((x 7)) (lambda () x)))"
                                                       ".el"
                                                       "(let ((lexical-binding nil)) (funcall cb))"))
                                      :toBe "7")
                             ;; 4. Dynamic condition-case error binding and with-demoted-errors (R655-02 & R655-06)
                             (js-call (expect (funcall run-all-three "dyn-cond-case"
                                                       "(defun test-cc () (list (condition-case caught (error \"oops\") (error (car caught))) (condition-case nil (with-demoted-errors \"probe: %S\" (error \"oops\")) (error 'escaped))))"
                                                       ".el"
                                                       "(test-cc)"))
                                      :toBe "(error nil)")
                             ;; 5. Missing require / featurep, bounded async channel backpressure, engine-call rejection, autoload/keymap/narrowing (R655-11..R655-14)
                             (js-call (expect (funcall run-all-three "req-missing"
                                                       "(defun test-req () (list (condition-case nil (list (require 'review-library-that-does-not-exist) (featurep 'review-library-that-does-not-exist)) (file-missing 'file-missing)) (list (require 'review-library-that-does-not-exist nil t) (featurep 'review-library-that-does-not-exist))))"
                                                       ".el"
                                                       "(test-req)"))
                                      :toBe "(file-missing (nil nil))")
                             (js-call (expect (funcall run-all-three "async-backpressure"
                                                       ";;; -*- lexical-binding: t -*-\n(require 'eliscript-async)\n(defun test-chan () (let* ((ch (make-async-channel 1)) (t1 (channel-take! ch)) (s1 (future-state t1)) (p1 (channel-put! ch 'first)) (s2 (future-state t1)) (v1 (option-value (eliscript-async-wait t1))) (p2 (channel-put! ch 'second)) (sp2 (future-state p2)) (p3 (channel-put! ch 'third)) (sp3-before (future-state p3)) (v2 (option-value (eliscript-async-wait (channel-take! ch)))) (sp3-after (future-state p3)) (v3 (option-value (eliscript-async-wait (channel-take! ch))))) (list s1 s2 v1 sp2 sp3-before v2 sp3-after v3)))"
                                                       ".el"
                                                       "(test-chan)"))
                                      :toBe "(pending fulfilled first fulfilled pending second fulfilled third)")
                             (js-call (expect (funcall run-all-three "engine-reject"
                                                       ";;; -*- lexical-binding: t -*-\n(require 'eliscript-async)\n(defun test-eng () (let ((h (engine-bind (lambda () 42) nil 'review-engine-that-does-not-exist))) (condition-case nil (eliscript-async-wait (engine-call 'review-engine-that-does-not-exist h)) (error 'rejected))))"
                                                       ".el"
                                                       "(test-eng)"))
                                      :toBe "rejected")
                             (js-call (expect (funcall run-all-three "apis-real"
                                                       ";;; -*- lexical-binding: t -*-\n(defun test-apis () (autoload 'review-lazy-function \"review-library-that-does-not-exist\") (let ((km (make-sparse-keymap))) (define-key km \"x\" 'ignore) (list (fboundp 'review-lazy-function) (lookup-key km \"x\") (with-temp-buffer (insert \"abc\") (narrow-to-region 2 3) (let ((narrowed (buffer-string)) (pmin (point-min)) (pmax (point-max))) (widen) (list narrowed pmin pmax (buffer-string)))))))"
                                                       ".el"
                                                       "(test-apis)"))
                                      :toBe "(t ignore (\"b\" 2 3 \"abc\"))"))
                           (finally
                             (rmSync directory (js-object :recursive t :force t)))))))))

  ;; ------------------------------------------------------------------
  ;; T12: package surface and per-case timing telemetry (runs last)
  ;; ------------------------------------------------------------------

  (test "T12-01: package exports the runtime and every case recorded a passing timing"
        (lambda ()
          (let ((manifest (JSON/parse (readFileSync (resolve project-root "package.json") "utf8")))
                (report (getTimingReport timings)))
            (js-call (expect (get (get manifest :exports) "./runtime/lisp")) :toBe "./dist/runtime/lisp.mjs")
            (js-call (expect (get (get manifest :exports) "./runtime/lisp.mjs")) :toBe "./dist/runtime/lisp.mjs")
            (js-call (expect (>= (js-length timings) 100)) :toBe t)
            (js-call timings :forEach
                     (lambda (entry)
                       (js-call (expect (= (value-type (get entry :elapsedMs)) "number")) :toBe t)
                       (js-call (expect (get entry :status)) :toBe "passed")))
            (js-call (expect (get report :totalTests)) :toBe (js-length timings))
            (js-call globalThis.console :log
                     (JSON/stringify (js-object :timingReport report)))))))
