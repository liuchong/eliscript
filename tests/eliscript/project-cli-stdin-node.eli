(module tests.project-cli-stdin-node
  (import "node:fs" :default fs)
  (import "node:fs/promises" readFile)
  (import "node:path" dirname)
  (import "node:module" createRequire syncBuiltinESMExports)
  (import "../../bootstrap/host/project-cli.mjs" execute)
  (defasync main ()
    (let* ((arguments (js-call (get globalThis.process :argv) :slice 2))
           (mode (aref arguments 0)) (entry (aref arguments 1)) (output (aref arguments 2))
           (module-directory (aref arguments 3))
           (options (js-object :moduleDirectory module-directory))
           (parameters (js-array "--root" (dirname entry) "--out-dir" output "--no-cache"))
           (original (get fs :readFileSync)) (reads 0))
      (if (= mode "file") (js-call parameters :push entry)
        (js-call parameters :push "--stdin-file" entry entry))
      (when (= mode "provided")
        (put options :stdinSource "(defun answer () 41)\n(export answer)\n"))
      (when (= mode "empty") (put options :stdinSource ""))
      (when (= mode "null") (put options :stdinSource nil))
      (put fs :readFileSync (lambda (&rest arguments)
        (when (= (aref arguments 0) 0) (setq reads (1+ reads)))
        (Reflect/apply original fs arguments)))
      (syncBuiltinESMExports)
      (try
        (let* ((execution (await (execute parameters options)))
               (result (get execution :result)) (emitted (aref (get result :entryOutputs) 0))
               (require-module (createRequire (js* "import.meta.url")))
               (loaded (funcall require-module emitted)) (answer (get loaded :answer)))
          (console/log (JSON/stringify (js-object :stdinReads reads
            :answer (if (undefined? answer) nil (funcall answer))
            :hasAnswer (not (undefined? answer)) :node (get (get globalThis.process :versions) :node)
            :emitted (await (readFile emitted "utf8"))))))
        (finally (put fs :readFileSync original) (syncBuiltinESMExports)))))
  (js-call (main) :catch (lambda (error) (console/error error) (put globalThis.process :exitCode 1))))
