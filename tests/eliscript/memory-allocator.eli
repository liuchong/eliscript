        (setq index (1+ index)))
      (js-call view :setUint32 288 5 t)
      (js-call view :setUint32 292 (js-length text) t)
      (js-call view :setUint32 296 (js-length text) t)
      (js-call view :setUint32 300 1 t)
      (setq index 0)
      (while (< index (js-length text))
        (js-call view :setUint16 (+ 320 (* index 2)) (js-call text :charCodeAt index) t)
        (setq index (1+ index)))
      (js-call view :setUint32 336 4 t)
      (js-call view :setUint32 340 1 t)
      (js-call view :setUint32 344 1 t)
      (js-call view :setUint32 368 65 t)
      (js-call view :setUint32 372 4294377472 t)
      (js-call view :setUint32 376 288 t)
      (js-call view :setUint32 380 336 t)
