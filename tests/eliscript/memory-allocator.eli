          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
          (js-call assert :notStrictEqual (js-call r "value-function-named" heap 11) (aref functions 0))
          (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)))))
  (test "ephemeron marking retains a complete 12000-key reverse chain with bounded propagation and survives compaction"
    (lambda ()
      (let* ((r (extended-fresh)) (depth 12000)
             (heap (js-call r "heap-new" 32768 2097152 4194304))
             (frame (js-call r "frame-new" heap 2))
             (table (js-call r "allocator-weak-table" heap 32768))
             (keys (js-array)) (previous 3) (index 0))
        (js-call assert :ok (> heap 0))
        (js-call assert :ok (> frame 3))
        (js-call assert :ok (> table 3))
        (js-call r "frame-set" heap frame 0 table)
        (while (< index depth)
          (let ((key (js-call r "allocator-weak-key" heap)))
            (js-call assert :ok (> key 3))
            (js-call assert :strictEqual (js-call r "allocator-weak-set" heap table key previous) 1)
            (js-call keys :push key) (setq previous key))
          (setq index (1+ index)))
        (js-call r "frame-set" heap frame 1 previous)
        (js-call (js-array false t) :forEach (lambda (compact)
          (when compact (js-call r "allocator-compact" heap))
          (js-call r "allocator-reset-weak-work")
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
          (js-call assert :strictEqual (js-call r "last-error") 0)
          (js-call assert :strictEqual (js-call r "allocator-weak-seeds") 1)
          (js-call assert :ok (<= (js-call r "allocator-weak-probes") (+ depth 8)))
          (js-call assert :strictEqual (js-call r "allocator-weak-count" heap table) depth)
          (let ((cursor previous) (position (1- depth)))
            (while (>= position 0)
              (js-call assert :strictEqual cursor (aref keys position))
              (setq cursor (js-call r "allocator-weak-get" heap table cursor) position (1- position)))
            (js-call assert :strictEqual cursor 3))))
        (js-call r "frame-set" heap frame 1 3)
        (js-call assert :strictEqual (js-call r "heap-collect" heap) depth)
        (js-call assert :strictEqual (js-call r "allocator-weak-count" heap table) 0)
        (js-call assert :strictEqual (js-call r "value-kind" heap previous) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0))))

  (test "ephemeron marking handles late tables late keys and unrooted value-to-key cycles"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 64 4096 16384))
             (frame (js-call r "frame-new" heap 2))
             (first-table (js-call r "allocator-weak-table" heap 8))
             (second-table (js-call r "allocator-weak-table" heap 8))
             (holder (js-call r "allocator-weak-holder" heap second-table))
             (a (js-call r "allocator-weak-key" heap))
             (b (js-call r "allocator-weak-key" heap))
             (c (js-call r "allocator-weak-key" heap)))
        (js-call assert :ok (> frame 3))
        (js-call assert :strictEqual (js-call r "last-error") 0)
        ;; Only the first table and a are roots. The second table arrives
        ;; through a weak value after a has already been processed.
        (js-call r "frame-set" heap frame 0 first-table)
        (js-call r "frame-set" heap frame 1 a)
        (js-call r "allocator-weak-set" heap first-table a holder)
        (js-call r "allocator-weak-set" heap second-table a b)
        (js-call r "allocator-weak-set" heap first-table b c)
        (js-call r "allocator-weak-set" heap second-table c a)
        (js-call r "allocator-reset-weak-work")
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
        (js-call assert :strictEqual (js-call r "allocator-weak-seeds") 2)
        (js-call assert :strictEqual (js-call r "allocator-weak-get" heap first-table a) holder)
        (js-call assert :strictEqual (js-call r "allocator-weak-get" heap second-table a) b)
        (js-call assert :strictEqual (js-call r "allocator-weak-get" heap first-table b) c)
        (js-call assert :strictEqual (js-call r "allocator-weak-get" heap second-table c) a)
        ;; a -> holder/table -> b -> c -> a must not seed its own liveness.
        (js-call r "frame-set" heap frame 1 3)
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 5)
        (js-call assert :strictEqual (js-call r "allocator-weak-count" heap first-table) 0)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 2)
        (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0))))
  (test "sparse occupied-slot scans preserve word boundaries FIFO reuse foreign tokens and moving GC"
    (lambda ()
      (let* ((r (extended-fresh)) (heap (js-call r "allocator-layout" 8192 524288 1048576 21))
             (frame (js-call r "frame-new" heap 12))
             (selected (js-array 31 32 63 64 127 128 8191 8192))
             (survivors (js-array)) (position 2))
        (js-call assert :ok (> frame 3))
        (while (<= position 8192)
          (let ((value (js-call r "allocator-weak-key" heap)))
            (js-call assert :strictEqual (bit-and value 2097151) position)
            (when (js-call selected :includes position)
              (js-call r "frame-set" heap frame (js-length survivors) value)
              (js-call survivors :push value)))
          (setq position (1+ position)))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 8183)
        (js-call assert :strictEqual (control r heap 3) 8192)
        (js-call r "allocator-reset-slot-visits")
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
        (js-call assert :ok (<= (js-call r "allocator-slot-visits") 32))
        (js-call survivors :forEach (lambda (value)
          (js-call assert :strictEqual (js-call r "value-kind" heap value) 13)))
        ;; The historical ascending FIFO chooses slot 2, then 3, then 4.
        (let ((first (js-call r "allocator-weak-key" heap))
              (foreign (js-call r "value-foreign-new" heap 4096 0))
              (buffer (js-call r "value-bytes" heap 8)))
          (js-call assert :strictEqual (bit-and first 2097151) 2)
          (js-call assert :strictEqual (bit-and foreign 2097151) 3)
          (js-call assert :strictEqual (bit-and buffer 2097151) 4)
          (js-call r "frame-set" heap frame 8 first)
          (js-call r "frame-set" heap frame 9 foreign)
          (js-call r "frame-set" heap frame 10 buffer)
          (js-call r "allocator-compact" heap)
          (js-call r "allocator-reset-slot-visits")
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
          (js-call assert :strictEqual (js-call r "value-foreign-live-tokens-into" heap buffer) 1)
          (let ((offset (js-call r "allocator-offset" heap buffer)))
            (js-call assert :strictEqual (word r heap (+ offset 32)) 4096))
          (js-call assert :ok (<= (js-call r "allocator-slot-visits") 64)))
        (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0))))
  (test "readonly primitive literal cells retain exact Number words and sealed String identity across moving GC and close"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 1024 65536 262144))
             (words (js-array (js-array 0 0) (js-array 0 2147483648)
                      (js-array 305419896 2146959360) (js-array 1 2146435072)))
             (values (js-array)) (index 0))
        (js-call r "value-bytes" heap 4096)
        (js-call assert :strictEqual (js-call r "value-module-begin" heap 5) 1)
        (while (< index 5)
          (js-call assert :strictEqual (js-call r "value-module-declare" heap index 0) 1)
          (js-call assert :strictEqual (js-call r "value-module-init" heap index 0) 0)
          (js-call assert :strictEqual (js-call r "last-error") 0)
          (setq index (1+ index)))
        ;; The same lazy private slots remain legal after module completion.
        (js-call assert :strictEqual (js-call r "value-module-complete" heap) 1)
        (setq index 0)
        (while (< index 4)
          (let* ((payload (aref words index))
                 (number (uint32 (js-call r "value-number" heap (aref payload 0) (aref payload 1))))
                 (used (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap))
                 (frames (js-call r "allocator-frame-count")))
            (js-call assert :strictEqual (uint32 (js-call r "value-module-literal-init" heap index number)) number)
            (js-call assert :strictEqual (uint32 (js-call r "value-module-get" heap index)) number)
            (js-call assert :strictEqual (js-call r "heap-used" heap) used)
            (js-call assert :strictEqual (js-call r "heap-live" heap) live)
            (js-call assert :strictEqual (js-call r "allocator-frame-count") frames)
            (js-call values :push number))
          (setq index (1+ index)))
        (let ((text (uint32 (js-call r "value-string" heap 1))))
          (js-call r "value-unit-set" heap text 0 120) (js-call r "value-seal" heap text)
          (js-call assert :strictEqual (uint32 (js-call r "value-module-literal-init" heap 4 text)) text)
          (js-call values :push text))
        (let ((before (js-call r "allocator-offset" heap (aref values 0))))
          (js-call r "heap-collect" heap) (js-call r "allocator-compact" heap)
          (js-call assert :strictEqual (js-call r "last-error") 0)
          (js-call assert :ok (< (js-call r "allocator-offset" heap (aref values 0)) before)))
        (setq index 0)
        (while (< index 4)
          (let* ((value (uint32 (js-call r "value-module-get" heap index)))
                 (offset (js-call r "allocator-offset" heap value)) (payload (aref words index)))
            (js-call assert :strictEqual value (aref values index))
            (js-call assert :strictEqual (word r heap (+ offset 32)) (aref payload 0))
            (js-call assert :strictEqual (word r heap (+ offset 36)) (aref payload 1)))
          (setq index (1+ index)))
        (js-call assert :strictEqual (uint32 (js-call r "value-module-get" heap 4)) (aref values 4))
        (js-call assert :strictEqual (js-call r "value-unit-get" heap (aref values 4) 0) 120)
        (js-call assert :strictEqual (js-call r "value-module-literal-init" heap 0 (aref values 1)) 0)
        (js-call assert :strictEqual (js-call r "last-error") 3)
        (js-call assert :strictEqual (uint32 (js-call r "value-module-get" heap 0)) (aref values 0))
        (js-call assert :strictEqual (js-call r "value-module-set" heap 0 (aref values 1)) 0)
        (js-call assert :strictEqual (js-call r "last-error") 3)
        (js-call assert :strictEqual (js-call r "value-module-close" heap) 1)
        (js-call assert :strictEqual (js-call r "value-module-literal-init" heap 0 (aref values 0)) 0)
        (js-call assert :strictEqual (js-call r "last-error") 3)
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))

  (test "primitive literal initialization preserves the old string-only ABI and refuses mutable text objects symbols and stale generations"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 512 65536 262144))
             (number (uint32 (js-call r "value-number" heap 0 2147483648)))
             (mutable (uint32 (js-call r "value-string" heap 1)))
             (object (uint32 (js-call r "value-object-new" heap 0)))
             (symbol (uint32 (js-call r "value-symbol-well-known" heap 0)))
             (frame (js-call r "frame-new" heap 4)))
        (js-call (js-array number mutable object symbol) :forEach (lambda (value index) (js-call r "frame-set" heap frame index value)))
        (js-call assert :strictEqual (js-call r "value-module-begin" heap 2) 1)
        (js-call (js-array 0 1) :forEach (lambda (index)
          (js-call r "value-module-declare" heap index 0) (js-call r "value-module-init" heap index 0)))
        (js-call assert :strictEqual (js-call r "value-module-literal-key-init" heap 0 number) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (js-call (js-array (js-array mutable 6) (js-array object 1) (js-array symbol 1)
                   (js-array 0 1) (js-array 1 1) (js-array 2 1) (js-array 3 1)) :forEach (lambda (entry)
          (js-call assert :strictEqual (js-call r "value-module-literal-init" heap 0 (aref entry 0)) 0)
          (js-call assert :strictEqual (js-call r "last-error") (aref entry 1))
          (js-call assert :strictEqual (js-call r "value-module-get" heap 0) 0)))
        (let ((stale (uint32 (js-call r "value-number" heap 9 0))))
          (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "value-module-literal-init" heap 0 stale) 0)
          (js-call assert :strictEqual (js-call r "last-error") 1))
        (js-call r "value-unit-set" heap mutable 0 97) (js-call r "value-seal" heap mutable)
        (js-call assert :strictEqual (uint32 (js-call r "value-module-literal-key-init" heap 0 mutable)) mutable)
        (js-call assert :strictEqual (uint32 (js-call r "value-module-literal-init" heap 1 number)) number)
        (js-call assert :strictEqual (js-call r "value-module-literal-key-init" heap 0 mutable) 0)
        (js-call assert :strictEqual (js-call r "last-error") 3)
        (js-call assert :strictEqual (uint32 (js-call r "value-module-get" heap 0)) mutable)
        (js-call r "frame-pop" heap frame) (js-call r "value-module-close" heap)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))

  (test "primitive literal initialization retains TDZ readonly local sentinel bounds and aborted-module checks"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 512 65536 262144))
             (value (uint32 (js-call r "value-number" heap 7 0)))
             (module (uint32 (js-call r "value-string" heap 1)))
             (frame (js-call r "frame-new" heap 2)))
        (js-call r "frame-set" heap frame 0 value) (js-call r "frame-set" heap frame 1 module)
        (js-call r "value-unit-set" heap module 0 109) (js-call r "value-seal" heap module)
        (js-call assert :strictEqual (js-call r "value-module-literal-init" heap 0 value) 0)
        (js-call assert :strictEqual (js-call r "last-error") 8)
        (js-call r "value-module-begin" heap 5)
        (js-call (js-array 0 1 2 3) :forEach (lambda (index)
          (js-call r "value-module-declare" heap index (if (= index 1) 1 0))))
        (js-call assert :strictEqual (js-call r "value-module-get" heap 0) 0)
        (js-call assert :strictEqual (js-call r "last-error") 8)
        (js-call assert :strictEqual (js-call r "value-module-literal-init" heap 0 value) 0)
        (js-call assert :strictEqual (js-call r "last-error") 3)
        (js-call r "value-module-init" heap 0 0)
        (js-call r "value-module-init" heap 1 0)
        (js-call r "value-module-init" heap 2 3)
        (js-call r "value-module-external-init" heap 3 module 3)
        (js-call (js-array (js-array 1 3) (js-array 2 3) (js-array 3 3) (js-array 4 8) (js-array 5 3))
          :forEach (lambda (entry)
            (js-call assert :strictEqual (js-call r "value-module-literal-init" heap (aref entry 0) value) 0)
            (js-call assert :strictEqual (js-call r "last-error") (aref entry 1))))
        (js-call assert :strictEqual (uint32 (js-call r "value-module-literal-init" heap 0 value)) value)
        (js-call assert :strictEqual (js-call r "value-module-abort" heap 8) 0)
        (js-call assert :strictEqual (js-call r "last-error") 8)
        (js-call assert :strictEqual (js-call r "value-module-literal-init" heap 0 value) 0)
        (js-call assert :strictEqual (js-call r "last-error") 8)
        (js-call r "frame-pop" heap frame))))
  (test "generic owned Object Get reuses the ordinary inherited data and terminal miss path without extra frames or allocation"
    (lambda ()
      (let* ((f (allocator-property-fixture)) (r (get f :r)) (heap (get f :heap))
             (own (get f :own)) (text (get f :text))
             (parent (funcall own (js-call r "value-object-new" heap 0)))
             (middle (funcall own (js-call r "value-object-new" heap parent)))
             (object (funcall own (js-call r "value-object-new" heap middle)))
             (receiver (funcall own (js-call r "value-array-new" heap 0)))
             (child (funcall own (js-call r "value-array-new" heap 0)))
             (key (funcall text "inherited")) (missing (funcall text "absent"))
             (symbol (funcall own (js-call r "value-symbol-well-known" heap 0))))
        (js-call r "value-object-put" heap parent key child 2)
        (js-call r "value-object-put" heap parent symbol 3 2)
        (js-call r "heap-collect" heap) (js-call r "allocator-compact" heap)
        (js-call r "allocator-reset-callbacks")
        (let ((used (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap))
              (frames (js-call r "allocator-frame-count")) (descriptors (js-call r "allocator-descriptors"))
              (round 0))
          (while (< round 64)
            (js-call assert :strictEqual (uint32 (js-call r "value-source-get-with-receiver" heap object key receiver)) child)
            (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object symbol receiver) 3)
            (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object missing receiver) 3)
            (js-call assert :strictEqual (js-call r "last-error") 0)
            (setq round (1+ round)))
          (js-call assert :strictEqual (js-call r "heap-used" heap) used)
          (js-call assert :strictEqual (js-call r "heap-live" heap) live)
          (js-call assert :strictEqual (js-call r "allocator-frame-count") frames)
          (js-call assert :strictEqual (js-call r "allocator-descriptors") descriptors)
          (js-call assert :strictEqual (js-call r "allocator-callback-count") 0))
        ;; Current tables, not a cached prototype result, remain authoritative.
        (js-call r "value-object-put" heap parent key 1 2)
        (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object key receiver) 1)
        (js-call r "value-object-put" heap object key 3 2)
        (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object key receiver) 3)
        (js-call r "value-source-delete" heap object key)
        (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object key receiver) 1)
        (allocator-property-finish f))))

  (test "generic Object delegation preserves accessor receiver moving GC key-conversion first errors foreign and lazy boundaries"
    (lambda ()
      (let* ((f (allocator-property-fixture)) (r (get f :r)) (heap (get f :heap))
             (own (get f :own)) (text (get f :text))
             (parent (funcall own (js-call r "value-object-new" heap 0)))
             (object (funcall own (js-call r "value-object-new" heap parent)))
             (receiver (funcall own (js-call r "value-array-new" heap 0)))
             (key (funcall text "sample")) (builtin (funcall text "toString"))
             (getter (funcall own (js-call r "allocator-described" heap 9001 0 0 0))))
        (js-call r "value-object-define-accessor" heap parent key getter 3 6)
        (js-call r "allocator-reset-callbacks") (js-call r "allocator-callback-compact-next")
        (js-call assert :strictEqual (uint32 (js-call r "value-source-get-with-receiver" heap object key receiver)) receiver)
        (js-call assert :strictEqual (js-call r "allocator-callback-count") 1)
        (js-call assert :strictEqual (uint32 (js-call r "allocator-callback-receiver")) receiver)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
        (js-call (js-array (js-array 9002 1) (js-array 9003 3)) :forEach (lambda (entry)
          (let ((thrower (funcall own (js-call r "allocator-described" heap (aref entry 0) 0 0 0))))
            (js-call r "value-object-define-accessor" heap parent key thrower 3 6)
            (js-call r "allocator-reset-callbacks")
            (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object key receiver) 0)
            (js-call assert :strictEqual (js-call r "last-error") 11)
            (js-call assert :strictEqual (js-call r "value-exception-take" heap) (aref entry 1))
            (js-call assert :strictEqual (js-call r "allocator-callback-count") 1)
            (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
            (let ((conversion (funcall own (js-call r "value-object-new" heap 0))))
              (js-call r "value-object-put" heap conversion builtin thrower 2)
              (js-call r "allocator-reset-callbacks")
              (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object conversion receiver) 0)
              (js-call assert :strictEqual (js-call r "last-error") 11)
              (js-call assert :strictEqual (js-call r "value-exception-take" heap) (aref entry 1))
              (js-call assert :strictEqual (js-call r "allocator-callback-count") 1)
              (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))))
        (js-call r "value-object-put" heap object builtin 2 2)
        (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object builtin receiver) 2)
        (let ((numeric (funcall own (js-call r "value-number" heap 0 1072693248)))
              (one (funcall text "1")))
          (js-call r "value-object-put" heap object one 1 2)
          (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object numeric receiver) 1))
        (let ((unfinished (funcall own (js-call r "value-string" heap 0))))
          (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object unfinished receiver) 0)
          (js-call assert :strictEqual (js-call r "last-error") 6))
        (let ((foreign (funcall own (js-call r "value-foreign-new" heap 1731 0)))
              (missing (funcall text "foreignMissing")))
          (js-call assert :strictEqual (js-call r "value-source-set-prototype" heap object foreign) 2)
          ;; This zero-import runtime has the original refusing capability.
          (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object missing receiver) 0)
          (js-call assert :strictEqual (js-call r "last-error") 3)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))
        (let ((stale (uint32 (js-call r "value-bytes" heap 0))))
          (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object key stale) 0)
          (js-call assert :strictEqual (js-call r "last-error") 1))
        (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap 0 key receiver) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (allocator-property-finish f))))
)
