          (js-call r "allocator-cache-set" heap 7 stale)
          (js-call assert :strictEqual (js-call r "value-function-named" heap 7) (aref functions 0))
          (js-call assert :strictEqual (js-call r "last-error") 0))
        (js-call r "allocator-cache-set" heap 7 4294967295)
        (js-call assert :strictEqual (js-call r "value-function-named" heap 7) (aref functions 0))
        (js-call assert :strictEqual (js-call r "last-error") 0)
        (let ((base (js-call r "allocator-base" heap)) (large (js-call r "value-bytes" heap 60000)))
          (js-call assert :ok (> large 3)) (js-call r "frame-set" heap frame 66 large)
          (js-call assert :notStrictEqual (js-call r "allocator-base" heap) base)
          (js-call r "heap-collect" heap)
