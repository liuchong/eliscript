            (js-call assert :ok (> missing 3))
            (js-call r "frame-set" heap frame 10 missing)
            (js-call assert :ok (> (js-call r "allocator-named-scans") 0))))
        (js-call r "heap-collect" heap) (js-call r "allocator-compact" heap)
        (js-call r "allocator-reset-named-scans")
        (js-call assert :strictEqual (js-call r "value-function-named" heap 7) (aref functions 0))
        (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
        (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))

  (test "named weak buckets retain colliding canonical identities without repeat whole-slot scans"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 1024 32768 131072))
             (frame (js-call r "frame-new" heap 67)) (functions (js-array)) (index 0))
        (js-call assert :ok (> heap 3)) (js-call assert :ok (> frame 3))
        (while (< index 64)
          (let* ((code (+ 7 (* index 256))) (function (js-call r "value-function-named" heap code)))
            (js-call assert :ok (> function 3))
            (js-call assert :strictEqual (js-call r "frame-set" heap frame index function) 1)
            (js-call functions :push function))
          (setq index (1+ index)))
        (let ((used (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap)) (repeat 0))
          (js-call r "allocator-reset-named-scans")
          (while (< repeat 16)
            (setq index 0)
            (while (< index 64)
              (js-call assert :strictEqual (js-call r "value-function-named" heap (+ 7 (* index 256))) (aref functions index))
              (js-call assert :strictEqual (js-call r "last-error") 0)
              (setq index (1+ index)))
            (setq repeat (1+ repeat)))
          (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
          (js-call assert :strictEqual (js-call r "heap-used" heap) used)
          (js-call assert :strictEqual (js-call r "heap-live" heap) live))
        ;; An ordinary captured callable with identical code is never canonical,
        ;; and its real capture-capacity word must never become a weak link.
        (let ((captured (js-call r "value-function-new" heap 7 2)))
          (js-call r "frame-set" heap frame 64 captured)
          (js-call assert :strictEqual (js-call r "allocator-function-capacity" heap captured) 2)
          (js-call assert :strictEqual (js-call r "allocator-cache-set" heap 7 captured) 1)
          (js-call r "allocator-reset-named-scans")
          (js-call assert :strictEqual (js-call r "value-function-named" heap 7) (aref functions 0))
          (js-call assert :ok (> (js-call r "allocator-named-scans") 0))
          (js-call assert :strictEqual (js-call r "allocator-function-capacity" heap captured) 2))
        (let ((other (js-call r "value-function-named" heap 8)))
          (js-call r "frame-set" heap frame 65 other)
          (js-call r "allocator-cache-set" heap 7 other)
          (js-call assert :strictEqual (js-call r "value-function-named" heap 7) (aref functions 0))
          (js-call assert :strictEqual (js-call r "last-error") 0))
        ;; A valid-but-cyclic wrong-code chain must terminate and use the
        ;; original canonical scan; invalid data must not become an ABI error.
        (js-call r "allocator-next-set" heap (aref functions 1) (aref functions 1))
        (js-call r "allocator-cache-set" heap 7 (aref functions 1))
        (js-call assert :strictEqual (js-call r "value-function-named" heap 7) (aref functions 0))
        (js-call assert :strictEqual (js-call r "last-error") 0)
        (let ((stale (js-call r "value-bytes" heap 1)))
          (js-call r "heap-collect" heap)
          (js-call r "allocator-cache-set" heap 7 stale)
          (js-call assert :strictEqual (js-call r "value-function-named" heap 7) (aref functions 0))
          (js-call assert :strictEqual (js-call r "last-error") 0))
        (js-call r "allocator-cache-set" heap 7 4294967295)
        (js-call assert :strictEqual (js-call r "value-function-named" heap 7) (aref functions 0))
        (js-call assert :strictEqual (js-call r "last-error") 0)
        (let ((base (js-call r "allocator-base" heap)) (large (js-call r "value-bytes" heap 60000)))
          (js-call assert :ok (> large 3)) (js-call r "frame-set" heap frame 66 large)
          (js-call assert :notStrictEqual (js-call r "allocator-base" heap) base)
          (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "allocator-compact" heap) 1)
          (js-call r "allocator-reset-named-scans")
          (setq index 0)
          (while (< index 64)
            (js-call assert :strictEqual (js-call r "value-function-named" heap (+ 7 (* index 256))) (aref functions index))
            (setq index (1+ index)))
          (js-call assert :strictEqual (js-call r "allocator-named-scans") 0))
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 1)
        (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))

  (test "named cache GC rebuild is weak, preserves survivors and recreates collected generations"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 1024 32768 131072))
             (frame (js-call r "frame-new" heap 66)) (functions (js-array)) (index 0))
        (while (< index 64)
