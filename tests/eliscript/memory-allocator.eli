  (test "function property growth preserves first byte-capacity failure roots and existing fields and retries after releasing real storage"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 128 32768 32768)) (roots (js-array))
             (own (lambda (value)
