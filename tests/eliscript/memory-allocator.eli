(module tests.memory-allocator
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  ;; Bootstrap emits this source at tests/wasm-memory-allocator.test.mjs.
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/compiler/controlled-baseline.mjs" definition)

  (defvar directory undefined)
  (defvar image undefined)
  (defvar lifo-image undefined)
  (defvar extended-image undefined)
  (defun allocator-runtime-image (backend source filename maximum-pages)
    ;; Finish one image before compiling the reference, so its compiler IR
    ;; does not remain a beforeAll local beside the next full runtime IR.
    (let* ((program (js-call (get backend :compiler) :compile_ir_string source filename))
           (bytes (js-call globalThis.Uint8Array :from
             (js-call (get backend :wasm) :emit_memory_wasm program
               (js-object :initialPages 1 :maximumPages maximum-pages)))))
      (new globalThis.WebAssembly.Module bytes)))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-avl-allocator-"))))
    (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
           (source (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
           (needle "(let* ((p (+ base current)) (left (load-u32 (+ p 8))))")
           (counted (js-call source :replace needle
             "(let* ((p (+ base current)) (left (progn (store-u32 64 (1+ (load-u32 64))) (load-u32 (+ p 8)))))"))
           (free-needle "(while (/= current 0)\n        (if (< current offset)")
           (linked (js-call counted :replace free-needle
             "(while (/= current 0)\n        (store-u32 68 (1+ (load-u32 68)))\n        (if (< current offset)"))
           (safepoint "  (defun heap-allocate-with-gc (heap size)\n")
           (moving (js-call linked :replace safepoint (+ safepoint
             "    (when (= (load-u32 72) 1) (store-u32 72 0) (heap-collect heap) (heap-defragment heap))\n")))
           (named-start (js-call moving :indexOf "  (defun value-function-named (heap code)"))
           (named-end (js-call moving :indexOf "  (defun value-function-code " named-start))
           (named (js-call moving :slice named-start named-end))
           (named-scan "(while (and (<= slot slots) (= result 0))")
           (named-counted (js-call named :replace named-scan
             "(while (and (<= slot slots) (= result 0)) (store-u32 76 (1+ (load-u32 76)))"))
           (instrumented (+ (js-call moving :slice 0 named-start) named-counted (js-call moving :slice named-end)))
           (extended (+ (js-call instrumented :slice 0 (js-call instrumented :lastIndexOf ")"))
             (js-call (js-array ""
               "    (defun allocator-allocate (heap size)"
               "      (begin-operation) (if (= (heap-check heap) 0) 0 (heap-allocate-block heap size)))"
               "    (defun allocator-free (heap offset size)"
               "      (begin-operation) (if (= (heap-check heap) 0) 0 (heap-free-block heap offset size)))"
               "    (defun allocator-control (heap index) (heap-control heap index))"
               ;; Exercise the actual extended layout with a small finite slot
               ;; set; public constructors still select their original widths.
               "    (defun allocator-layout (slots initial maximum bits)"
               "      (begin-operation) (heap-new-layout slots initial maximum bits))"
               "    (defun allocator-base (heap) (heap-base heap))"
               "    (defun allocator-word (heap offset) (load-u32 (+ (heap-base heap) offset)))"
               "    (defun allocator-offset (heap value) (- (heap-block heap value) (heap-base heap)))"
               "    (defun allocator-size (heap value) (load-u32 (+ (heap-entry heap (heap-slot-index heap value)) 12)))"
               "    (defun allocator-compact (heap) (heap-defragment heap))"
               "    (defun allocator-visits () (load-u32 64))"
               "    (defun allocator-reset-visits () (store-u32 64 0))"
               "    (defun allocator-free-visits () (load-u32 68))"
               "    (defun allocator-reset-free-visits () (store-u32 68 0))"
               "    (defun allocator-compact-next () (store-u32 72 1))"
               "    (defun allocator-named-scans () (load-u32 76))"
               "    (defun allocator-reset-named-scans () (store-u32 76 0))"
               "    (defun allocator-cache-set (heap code value)"
               "      (let ((p (heap-named-cache-entry heap code))) (if (= p 0) 0 (progn (store-u32 p value) 1))))"
               "    (defun allocator-cache-enabled (heap code) (if (= (heap-named-cache-entry heap code) 0) 0 1))"
               "    (defun allocator-next-set (heap function value) (store-u32 (+ (heap-block heap function) 8) value))"
               "    (defun allocator-function-capacity (heap function) (load-u32 (+ (heap-block heap function) 8)))"
               "    (defun allocator-root-count (heap value) (load-u32 (+ (heap-entry heap (heap-slot-index heap value)) 16)))"
               "    (defun allocator-fill-refs (heap roots count)"
               "      (let ((index 0))"
               "        (while (and (< index count) (= (last-error) 0))"
               "          (let ((value (value-bytes heap 0)))"
               "            (when (/= value 0) (value-set heap roots index value)))"
               "          (setq index (1+ index))) index))"
               "    (export allocator-allocate allocator-free allocator-control allocator-layout allocator-word allocator-base allocator-compact-next"
               "      allocator-offset allocator-size allocator-compact allocator-visits allocator-reset-visits"
               "      allocator-free-visits allocator-reset-free-visits allocator-named-scans allocator-reset-named-scans"
               "      allocator-cache-set allocator-cache-enabled allocator-next-set allocator-function-capacity allocator-root-count"
               "      allocator-fill-refs value-function-named value-function-new value-function-code))") :join "\n")))
           (enqueue (definition extended "heap-free-slot-append "))
           ;; Exact former sweep policy: the newly dead entry becomes head.
           ;; All generation/retirement, byte allocation and GC are unchanged.
           (lifo (js-call extended :replace enqueue
             (js-call (js-array
               "  (defun heap-free-slot-append (base control entry slot)"
               "    (store-u32 (+ entry 20) (load-u32 (+ control 16)))"
               "    (store-u32 (+ control 16) slot) 0)") :join "\n"))))
      ;; A single increment counts actual production search steps in this test
      ;; image only; it changes neither block choice nor the public runtime ABI.
      (js-call assert :notStrictEqual counted source)
      (js-call assert :notStrictEqual linked counted)
      (js-call assert :notStrictEqual moving linked)
      (js-call assert :ok (and (>= named-start 0) (> named-end named-start)))
      (js-call assert :notStrictEqual named-counted named)
      (js-call assert :notStrictEqual lifo extended)
      (setq image (allocator-runtime-image backend extended "allocator-runtime.eli" 32))
      (setq lifo-image (allocator-runtime-image backend lifo "allocator-lifo-runtime.eli" 32))
      ;; A separate image permits the explicit extended profile. The original
      ;; allocator cases retain their existing 32-page memory limit.
      (setq extended-image (allocator-runtime-image backend extended "allocator-extended-runtime.eli" 8192))
      (js-call assert :deepStrictEqual (js-call globalThis.WebAssembly.Module :imports image) (js-array))))
    120000)
  (afterAll (async ()
    (setq image undefined lifo-image undefined extended-image undefined)
    (when directory (await (rm directory (js-object :recursive t :force t))))))

  (defun fresh () (get (new globalThis.WebAssembly.Instance image) :exports))
  (defun word (r heap offset) (uint32 (js-call r "allocator-word" heap offset)))
  (defun control (r heap index) (js-call r "allocator-control" heap index))
  (defun free-slot-queue (r heap)
    (let ((seen (new globalThis.Set)) (result (js-array)) (slot (control r heap 4)) (last 0))
      (while (/= slot 0)
        (js-call assert :ok (and (> slot 0) (<= slot (control r heap 3))))
        (js-call assert :strictEqual (js-call seen :has slot) false)
        (js-call seen :add slot) (js-call result :push slot)
        (js-call assert :strictEqual (word r heap (+ (* slot 24) 4)) 0)
        (js-call assert :ok (< (word r heap (* slot 24)) (control r heap 293)))
        (setq last slot slot (word r heap (+ (* slot 24) 20))))
      (js-call assert :strictEqual (control r heap 290) last) result))
  (defun retired-slots (r heap)
    (let ((slot 1) (retired 0))
      (while (<= slot (control r heap 3))
        (when (and (= (word r heap (* slot 24)) 4095)
                   (= (word r heap (+ (* slot 24) 4)) 0))
          (setq retired (1+ retired)))
        (setq slot (1+ slot))) retired))

  (test "free slots append newly dead generations after older idle slots and survive growth and failure"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 8 4096 32768)) (values (js-array)) (index 0))
        (while (< index 8)
          (let ((value (js-call r "value-bytes" heap 0)))
            (js-call assert :ok (> value 3)) (js-call values :push value))
          (setq index (1+ index)))
        (js-call r "heap-pin" heap (aref values 1)) (js-call r "heap-pin" heap (aref values 4))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 6)
        (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 1 3 4 6 7 8))
        (let ((reused (js-call r "value-bytes" heap 0)))
          (js-call assert :strictEqual (bit-and reused 1048575) 1)
          (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 3 4 6 7 8))
          (let ((used (js-call r "heap-used" heap)))
            (js-call assert :strictEqual (js-call r "value-bytes" heap 65536) 0)
            (js-call assert :strictEqual (js-call r "last-error") 2)
            (js-call assert :strictEqual (js-call r "heap-used" heap) used)
            (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 3 4 6 7 8)))
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 3 4 6 7 8 1))
          (let* ((base (js-call r "allocator-base" heap)) (large (js-call r "value-bytes" heap 10000)))
            (js-call assert :ok (> large 3))
            (js-call assert :strictEqual (bit-and large 1048575) 3)
            (js-call assert :notStrictEqual (js-call r "allocator-base" heap) base)
            (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 4 6 7 8 1))
            (js-call assert :strictEqual (js-call r "value-kind" heap reused) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)))
        (js-call r "heap-release" heap (aref values 1)) (js-call r "heap-release" heap (aref values 4))
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
        (js-call assert :strictEqual (js-length (free-slot-queue r heap)) 8))))

  (defun churn-slots (module expected-retired expected-capacity)
    (let* ((r (get (new globalThis.WebAssembly.Instance module) :exports))
           (heap (js-call r "heap-new" 32 4096 8192)) (frame (js-call r "frame-new" heap 32))
           (zero (js-call r "value-number" heap 0 2147483648)) (seeds (js-array)) (index 0))
      (js-call r "frame-set" heap frame 0 zero)
      (while (< index 16)
        (let ((value (js-call r "value-bytes" heap 0)))
          (js-call assert :ok (> value 3)) (js-call seeds :push value))
        (setq index (1+ index)))
      (js-call assert :strictEqual (js-call r "heap-collect" heap) 16)
      (setq index 0)
      (while (< index 4096)
        ;; Raw WASM exposes i32 as signed JS Numbers after generation 2047.
        (js-call assert :ok (> (uint32 (js-call r "value-bytes" heap 0)) 3))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
        (setq index (1+ index)))
      (js-call assert :strictEqual (retired-slots r heap) expected-retired)
      (js-call assert :strictEqual (js-call r "heap-live" heap) 2)
      (js-call assert :strictEqual (js-call r "frame-get" heap frame 0) zero)
      (js-call assert :strictEqual (word r heap (+ (js-call r "allocator-offset" heap zero) 36)) 2147483648)
      (js-call assert :strictEqual (js-call r "value-kind" heap (aref seeds 15)) 0)
      (js-call assert :strictEqual (js-call r "last-error") 1)
      (setq index 0)
      (while (< index 30)
        (let ((value (js-call r "value-bytes" heap 0)) (error (js-call r "last-error")))
          (if (< index expected-capacity)
            (progn (js-call assert :ok (> value 3)) (js-call assert :strictEqual error 0)
              (js-call r "frame-set" heap frame (1+ index) value))
            (progn (js-call assert :strictEqual value 0) (js-call assert :strictEqual error 2))))
        (setq index (1+ index)))
      (js-call assert :strictEqual (js-call r "heap-live" heap) (+ 2 expected-capacity))
      (js-call assert :strictEqual (js-call r "frame-depth" heap) 1)
      (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
      (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
      (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))

  (test "FIFO preserves the full live slot capacity after temporary churn that retires a LIFO hotspot"
    (lambda ()
      ;; Identical 32 slots/bytes/input/GC schedule. The former LIFO policy
      ;; loses one slot despite fifteen older idle seed slots. FIFO rotates
      ;; these generations and still admits the original full live peak.
      (churn-slots lifo-image 1 29)
      (churn-slots image 0 30)) 30000)

  (test "a sole reusable slot still retires permanently at generation 4095 without ABA"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 1 4096 8192)) (first 0) (last 0) (index 0))
        (while (< index 4095)
          (setq last (uint32 (js-call r "value-bytes" heap 0)))
          (when (= index 0) (setq first last))
          (js-call assert :strictEqual (unsigned-bit-shift-right last 20) (1+ index))
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          (setq index (1+ index)))
        (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array))
        (js-call assert :strictEqual (js-call r "value-bytes" heap 0) 0)
        (js-call assert :strictEqual (js-call r "last-error") 2)
        (js-call assert :strictEqual (js-call r "value-kind" heap first) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (js-call assert :strictEqual (js-call r "value-kind" heap last) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))) 30000)

  (defun extended-fresh ()
    (get (new globalThis.WebAssembly.Instance extended-image) :exports))

  (test "extended layouts spend fresh slots before FIFO reuse without changing the legacy policy"
    (lambda ()
      (js-call (js-array 20 21 22 23) :forEach (lambda (bits)
        (let* ((r (fresh))
               (heap (if (= bits 20) (js-call r "heap-new" 4 4096 8192)
                       (js-call r "allocator-layout" 4 4096 8192 bits)))
               (mask (control r heap 292)) (first (uint32 (js-call r "value-bytes" heap 0))))
          (js-call assert :strictEqual (unsigned-bit-shift-right first bits) 1)
          (js-call assert :strictEqual (bit-and first mask) 1)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          ;; A byte-capacity failure must not consume a fresh slot or unlink
          ;; the older reusable entry before its allocation actually succeeds.
          (let ((used (js-call r "heap-used" heap)))
            (js-call assert :strictEqual (js-call r "value-bytes" heap 65536) 0)
            (js-call assert :strictEqual (js-call r "last-error") 2)
            (js-call assert :strictEqual (js-call r "heap-used" heap) used)
            (js-call assert :strictEqual (control r heap 3) 1)
            (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 1)))
          (if (= bits 20)
            (let ((again (uint32 (js-call r "value-bytes" heap 0))))
              (js-call assert :strictEqual (bit-and again mask) 1)
              (js-call assert :strictEqual (unsigned-bit-shift-right again bits) 2)
              (js-call assert :strictEqual (control r heap 3) 1)
              (js-call assert :strictEqual (js-call r "heap-collect" heap) 1))
            (let ((slot 2) (queue (js-array 1)))
              (while (<= slot 4)
                (let ((value (uint32 (js-call r "value-bytes" heap 0))))
                  (js-call assert :strictEqual (bit-and value mask) slot)
                  (js-call assert :strictEqual (unsigned-bit-shift-right value bits) 1)
                  (js-call assert :strictEqual (control r heap 3) slot)
                  (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
                  (js-call queue :push slot)
                  (js-call assert :deepStrictEqual (free-slot-queue r heap) queue))
                (setq slot (1+ slot)))
              ;; Once all slots have been used, the original FIFO order and
              ;; generation increment apply, rather than early retirement.
              (setq slot 1)
              (while (<= slot 4)
                (let ((value (uint32 (js-call r "value-bytes" heap 0))))
                  (js-call assert :strictEqual (bit-and value mask) slot)
                  (js-call assert :strictEqual (unsigned-bit-shift-right value bits) 2)
                  (js-call assert :strictEqual (js-call r "heap-collect" heap) 1))
                (setq slot (1+ slot)))
              (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 1 2 3 4))
              (let ((held (js-array)))
                (setq slot 1)
                (while (<= slot 4)
                  (let ((value (uint32 (js-call r "value-bytes" heap 0))))
                    (js-call assert :strictEqual (bit-and value mask) slot)
                    (js-call assert :strictEqual (unsigned-bit-shift-right value bits) 3)
                    (js-call r "heap-pin" heap value) (js-call held :push value))
                  (setq slot (1+ slot)))
                (js-call assert :strictEqual (js-call r "value-bytes" heap 0) 0)
                (js-call assert :strictEqual (js-call r "last-error") 2)
                (js-call assert :strictEqual (js-call r "heap-live" heap) 4)
                (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
                (let ((stale (aref held 0)))
                  (js-call r "heap-release" heap stale)
                  (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
                  (let ((recovered (uint32 (js-call r "value-bytes" heap 0))))
                    (js-call assert :strictEqual (bit-and recovered mask) 1)
                    (js-call assert :strictEqual (unsigned-bit-shift-right recovered bits) 4)
                    (js-call assert :notStrictEqual recovered stale)
                    (js-call assert :strictEqual (js-call r "value-kind" heap stale) 0)
                    (js-call assert :strictEqual (js-call r "last-error") 1)
                    (js-call assert :strictEqual (js-call r "value-kind" heap recovered) 6)))
                (js-call (js-call held :slice 1) :forEach (lambda (value) (js-call r "heap-release" heap value)))
                (js-call assert :strictEqual (js-call r "heap-collect" heap) 4))))
          (js-call assert :strictEqual (js-call r "value-kind" heap first) 0)
          (js-call assert :strictEqual (js-call r "last-error") 1)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))))

  (test "extended heap is explicit and preserves the old constructor and single-object limits"
    (lambda ()
      (let ((r (extended-fresh)))
        (js-call (js-array
                  (js-array 1048576 33554432 67108864)
                  (js-array 8 4096 268435457)) :forEach (lambda (parameters)
          (js-call assert :strictEqual
            (js-call r "heap-new" (aref parameters 0) (aref parameters 1) (aref parameters 2)) 0)
          (js-call assert :strictEqual (js-call r "last-error") 3)))
        (js-call (js-array
                  (js-array 0 4096 8192)
                  (js-array 8388608 268435456 536870912)
                  (js-array 8 4096 1073741825)
                  (js-array 8 4096 2048)
                  (js-array 8 128 8192)) :forEach (lambda (parameters)
          (js-call assert :strictEqual
            (js-call r "heap-new-extended" (aref parameters 0) (aref parameters 1) (aref parameters 2)) 0)
          (js-call assert :strictEqual (js-call r "last-error") 3)))
        (let ((ordinary (js-call r "heap-new" 8 4096 8192))
              (extended (js-call r "heap-new-extended" 8 4096 1073741824)))
          (js-call (js-array ordinary extended) :forEach (lambda (heap)
            (js-call assert :ok (> heap 0))
            (js-call assert :strictEqual (control r heap 291) 20)
            (js-call assert :strictEqual (uint32 (control r heap 292)) 1048575)
            (js-call assert :strictEqual (control r heap 293) 4095)
            (let ((value (uint32 (js-call r "value-bytes" heap 0)))
                  (used (js-call r "heap-used" heap)))
              (js-call assert :strictEqual value 1048577)
              (js-call assert :strictEqual (js-call r "value-bytes" heap 268435417) 0)
              (js-call assert :strictEqual (js-call r "last-error") 2)
              (js-call assert :strictEqual (js-call r "heap-used" heap) used)
              (js-call assert :strictEqual (js-call r "value-kind" heap value) 6)
              (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
              (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
              (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))
          (js-call assert :strictEqual (control r ordinary 8) 8192)
          (js-call assert :strictEqual (control r extended 8) 1073741824)
          (js-call r "retire")
          (js-call assert :strictEqual (js-call r "heap-live" extended) 0)
          (js-call assert :strictEqual (js-call r "last-error") 1)
          (let ((next (js-call r "heap-new-extended" 8 4096 8192)))
            (js-call assert :ok (> (js-call r "value-bytes" next 0) 3))
            (js-call assert :strictEqual (js-call r "heap-collect" next) 1)
            (js-call assert :strictEqual (js-call r "heap-live" next) 0))))))

  (test "extended generation widths retire without wrap and preserve weak named identities"
    (lambda ()
      (js-call (js-array (js-array 1048576 33554432 21 2047)
                         (js-array 2097152 67108864 22 1023)
                         (js-array 4194304 134217728 23 511)) :forEach (lambda (profile)
        (let* ((r (extended-fresh))
               (public-heap (js-call r "heap-new-extended" (aref profile 0) (aref profile 1) 134217728))
               (bits (aref profile 2)) (maximum (aref profile 3))
               ;; The real public layouts retain their width boundaries. A
               ;; sole-slot instance of that same implementation then reaches
               ;; retirement without relying on an early-reuse policy.
               (heap (js-call r "allocator-layout" 1 4096 8192 bits))
               (first 0) (last 0) (index 0))
          (js-call assert :ok (> public-heap 0))
          (js-call assert :strictEqual (control r public-heap 2) (aref profile 0))
          (js-call assert :strictEqual (control r public-heap 291) bits)
          (js-call assert :strictEqual (control r public-heap 293) maximum)
          (js-call assert :ok (> heap 0))
          (js-call assert :strictEqual (control r heap 291) bits)
          (js-call assert :strictEqual (control r heap 293) maximum)
          (while (< index maximum)
            (setq last (uint32 (js-call r "value-bytes" heap 0)))
            (when (= index 0) (setq first last))
            (js-call assert :strictEqual (unsigned-bit-shift-right last bits) (1+ index))
            (js-call assert :strictEqual (bit-and last (control r heap 292)) 1)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
            (setq index (1+ index)))
          (js-call assert :strictEqual (word r heap 24) maximum)
          (js-call assert :strictEqual (word r heap 28) 0)
          (js-call assert :strictEqual (control r heap 4) 0)
          (js-call assert :strictEqual (control r heap 290) 0)
          (js-call assert :strictEqual (js-call r "value-bytes" heap 0) 0)
          (js-call assert :strictEqual (js-call r "last-error") 2)
          (js-call (js-array first last) :forEach (lambda (stale)
            (js-call assert :strictEqual (js-call r "value-kind" heap stale) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)))
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
          ;; Reserve slot one, so weak named identity/reuse exercises slot two
          ;; after fresh capacity is exhausted, independently of retirement.
          (setq heap (js-call r "allocator-layout" 2 4096 8192 bits))
          (let* ((blocker (js-call r "value-bytes" heap 0))
                 (pin (js-call r "heap-pin" heap blocker))
                 (named (uint32 (js-call r "value-function-named" heap 4294967295))))
            (js-call assert :strictEqual (unsigned-bit-shift-right named bits) 1)
            (js-call assert :strictEqual (bit-and named (control r heap 292)) 2)
            (js-call r "heap-pin" heap named)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
            (js-call assert :strictEqual (js-call r "allocator-compact" heap) 1)
            (js-call r "allocator-reset-named-scans")
            (js-call assert :strictEqual
              (uint32 (js-call r "value-function-named" heap 4294967295)) named)
            (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
            (js-call assert :strictEqual (uint32 (js-call r "value-function-code" heap named)) 4294967295)
            (js-call r "heap-release" heap named)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
            (js-call assert :strictEqual (js-call r "value-kind" heap named) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)
            (let ((again (uint32 (js-call r "value-function-named" heap 4294967295))))
              (js-call assert :notStrictEqual again named)
              (js-call assert :strictEqual (unsigned-bit-shift-right again bits) 2)
              (js-call assert :strictEqual (bit-and again (control r heap 292)) 2))
            (js-call r "heap-release" heap blocker)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 2)
            (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
            (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))))) 30000)

  (test "23-bit opt-in allocates the complete slot table and keeps each earlier width boundary"
    (lambda ()
      (js-call (js-array (js-array 1048575 33554432 20 1048575 4095)
                         (js-array 1048576 33554432 21 2097151 2047)
                         (js-array 4194303 134217728 22 4194303 1023)
                         (js-array 4194304 134217728 23 8388607 511 268435456)
                         (js-array 8388607 201326624 23 8388607 511)
                         (js-array 8388607 268435456 23 8388607 511)) :forEach
        (lambda (profile)
          (let* ((r (extended-fresh))
                 (maximum (if (= (js-length profile) 6) (aref profile 5) 1073741824))
                 (heap (js-call r "heap-new-extended" (aref profile 0) (aref profile 1) maximum))
                 (bits (aref profile 2)) (mask (aref profile 3))
                 (value (uint32 (js-call r "value-bytes" heap 0))))
            (js-call assert :ok (> heap 0))
            (js-call assert :strictEqual (control r heap 2) (aref profile 0))
            (js-call assert :strictEqual (control r heap 291) bits)
            (js-call assert :strictEqual (uint32 (control r heap 292)) mask)
            (js-call assert :strictEqual (control r heap 293) (aref profile 4))
            (js-call assert :strictEqual (control r heap 8) maximum)
            (js-call assert :strictEqual (js-call r "heap-capacity" heap) (aref profile 1))
            (js-call assert :strictEqual (unsigned-bit-shift-right value bits) 1)
            (js-call assert :strictEqual (bit-and value mask) 1)
            (js-call assert :strictEqual (js-call r "value-kind" heap value) 6)
            (js-call assert :strictEqual (js-call r "heap-pin" heap value) 1)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
            (js-call assert :strictEqual (js-call r "heap-live" heap) 1)
            (js-call r "heap-release" heap value)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
            (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
            (js-call assert :strictEqual (js-call r "value-kind" heap value) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)
            (let ((next (uint32 (js-call r "value-bytes" heap 0))))
              (js-call assert :strictEqual (bit-and next mask) (if (= bits 20) 1 2))
              (js-call assert :strictEqual (unsigned-bit-shift-right next bits) (if (= bits 20) 2 1))
              (js-call assert :notStrictEqual next value)
              (js-call assert :strictEqual (js-call r "heap-collect" heap) 1))
            (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))))

  (test "23-bit opt-in rejects oversized tables and byte budgets before allocating a heap"
    (lambda ()
      (let ((r (extended-fresh)))
        (js-call (js-array (js-array 8388608 268435456 1073741824)
                           (js-array 8388607 201326623 1073741824)
                           (js-array 8388607 268435456 1073741825)
                           (js-array 8388607 268435456 134217728)) :forEach
          (lambda (parameters)
            (js-call assert :strictEqual
              (js-call r "heap-new-extended" (aref parameters 0) (aref parameters 1) (aref parameters 2)) 0)
            (js-call assert :strictEqual (js-call r "last-error") 3)))
        ;; The same instance is usable after each rejected constructor. The
        ;; legacy ABI still has its original twenty-bit handle and budget.
        (let* ((heap (js-call r "heap-new" 1 4096 8192))
               (value (uint32 (js-call r "value-bytes" heap 0))))
          (js-call assert :ok (> heap 0))
          (js-call assert :strictEqual (control r heap 291) 20)
          (js-call assert :strictEqual (control r heap 292) 1048575)
          (js-call assert :strictEqual (control r heap 293) 4095)
          (js-call assert :strictEqual (control r heap 8) 8192)
          (js-call assert :strictEqual value 1048577)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))))

  (test "extended heaps retain over one million real objects through growth, GC and capacity recovery"
    (lambda ()
      (let* ((r (extended-fresh)) (count 1048608)
             (heap (js-call r "heap-new-extended" (+ count 3) 33554432 134217728))
             (frame (js-call r "frame-new" heap 2))
             (roots (js-call r "value-refs" heap 7 count))
             (zero (js-call r "value-number" heap 0 2147483648))
             (base (js-call r "allocator-base" heap)))
        (js-call assert :ok (> roots 3))
        (js-call r "frame-set" heap frame 0 roots)
        (js-call r "frame-set" heap frame 1 zero)
        (js-call assert :strictEqual (js-call r "allocator-fill-refs" heap roots count) count)
        (js-call assert :strictEqual (js-call r "last-error") 0)
        (js-call assert :strictEqual (js-call r "heap-live" heap) (+ count 3))
        (js-call assert :notStrictEqual (js-call r "allocator-base" heap) base)
        (js-call assert :ok (> (js-call r "heap-capacity" heap) 33554432))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
        (js-call (js-array 0 1048574 1048575 (1- count)) :forEach (lambda (index)
          (let ((value (uint32 (js-call r "value-get" heap roots index))))
            (js-call assert :strictEqual (js-call r "value-kind" heap value) 6)
            (js-call assert :strictEqual (unsigned-bit-shift-right value 21) 1)
            (js-call assert :strictEqual (bit-and value 2097151) (+ index 4)))))
        (js-call assert :strictEqual (js-call r "value-bytes" heap 0) 0)
        (js-call assert :strictEqual (js-call r "last-error") 2)
        (js-call assert :strictEqual (js-call r "heap-live" heap) (+ count 3))
        (js-call assert :strictEqual (js-call r "frame-get" heap frame 1) zero)
        (js-call assert :strictEqual (word r heap (+ (js-call r "allocator-offset" heap zero) 36)) 2147483648)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 1)
        (let ((stale (uint32 (js-call r "value-get" heap roots (1- count)))))
          (js-call r "value-set" heap roots (1- count) 0)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          (let ((again (uint32 (js-call r "value-bytes" heap 0))))
            (js-call assert :notStrictEqual again stale)
            (js-call assert :strictEqual (unsigned-bit-shift-right again 21) 2)
            (js-call assert :strictEqual (bit-and again 2097151) (+ count 3))
            (js-call r "value-set" heap roots (1- count) again)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
            (js-call assert :strictEqual (js-call r "value-kind" heap stale) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)
            (js-call assert :strictEqual (js-call r "value-kind" heap again) 6)))
        (js-call r "frame-pop" heap frame)
        (js-call assert :strictEqual (js-call r "heap-collect" heap) (+ count 3))
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))) 120000)

  ;; This reference model knows only the original address-list rules. It has
  ;; no tree, cached maximum, rotation or representation-dependent choice.
  (defun model-allocate (model size)
    (let ((holes (get model :holes)) (index 0) (answer nil))
      (while (and (< index (js-length holes)) (nil? answer))
        (let ((block (aref holes index)))
          (when (>= (get block :size) size)
            (setq answer (js-object :offset (get block :offset) :size size))
            (if (>= (- (get block :size) size) 32)
              (put holes index (js-object :offset (+ (get block :offset) size) :size (- (get block :size) size)))
              (progn (put answer :size (get block :size)) (js-call holes :splice index 1)))))
        (setq index (1+ index)))
      (when (nil? answer)
        (let ((end (uint32 (+ (get model :cursor) size))))
          (when (and (>= end (get model :cursor)) (<= end (get model :maximum)))
            (setq answer (js-object :offset (get model :cursor) :size size))
            (put model :cursor end)))) answer))
  (defun model-free (model block)
    (let ((holes (get model :holes)) (index 1))
      (js-call holes :push (js-object :offset (get block :offset) :size (get block :size)))
      (js-call holes :sort (lambda (a b) (- (get a :offset) (get b :offset))))
      (while (< index (js-length holes))
        (let ((left (aref holes (1- index))) (right (aref holes index)))
          (if (= (+ (get left :offset) (get left :size)) (get right :offset))
            (progn (put left :size (+ (get left :size) (get right :size))) (js-call holes :splice index 1))
            (setq index (1+ index)))))
      (when (> (js-length holes) 0)
        (let ((tail (aref holes (1- (js-length holes)))))
          (when (= (+ (get tail :offset) (get tail :size)) (get model :cursor))
            (put model :cursor (get tail :offset)) (js-call holes :pop))))) 0)

  (defun tree-check (r heap node parent low high seen)
    (if (= node 0) (js-object :height 0 :maximum 0 :count 0)
      (progn
        (js-call assert :ok (and (> node low) (< node high)))
        (js-call assert :strictEqual (js-call seen :has node) false)
        (js-call seen :add node)
        (js-call assert :strictEqual (word r heap (+ node 16)) parent)
        (let* ((left (tree-check r heap (word r heap (+ node 8)) node low node seen))
               (right (tree-check r heap (word r heap (+ node 12)) node node high seen))
               (height (1+ (Math/max (get left :height) (get right :height))))
               (maximum (Math/max (word r heap node) (get left :maximum) (get right :maximum))))
          (js-call assert :ok (<= (Math/abs (- (get left :height) (get right :height))) 1))
          (js-call assert :strictEqual (word r heap (+ node 20)) height)
          (js-call assert :strictEqual (word r heap (+ node 24)) maximum)
          (js-object :height height :maximum maximum :count (+ 1 (get left :count) (get right :count)))))))
  (defun check (fixture)
    (let* ((r (get fixture :r)) (heap (get fixture :heap)) (model (get fixture :model))
           (actual (js-array)) (seen (new globalThis.Set)) (previous 0) (node (control r heap 6))
           (tree-seen (new globalThis.Set)))
      (js-call assert :strictEqual (js-call r "heap-used" heap) (get model :cursor))
      (while (/= node 0)
        (js-call assert :strictEqual (js-call seen :has node) false)
        (js-call seen :add node)
        (js-call assert :strictEqual (word r heap (+ node 28)) previous)
        (js-call actual :push (js-object :offset node :size (word r heap node)))
        (setq previous node node (word r heap (+ node 4))))
      (js-call assert :deepStrictEqual actual (get model :holes))
      (let ((summary (tree-check r heap (control r heap 33) 0 0 4294967295 tree-seen)))
        (js-call assert :strictEqual (get summary :count) (js-length actual))
        (js-call assert :deepStrictEqual tree-seen seen) summary)))
  (defun fixture (&optional supplied maximum)
    (let* ((r (or supplied (fresh))) (limit (or maximum 131072))
           (heap (js-call r "heap-new" 8 4096 limit)))
      (js-call assert :ok (> heap 3))
      (js-object :r r :heap heap :start (js-call r "heap-used" heap)
        :model (js-object :cursor (js-call r "heap-used" heap) :maximum limit :holes (js-array)))))
  (defun allocate-block (f size)
    (let* ((r (get f :r)) (heap (get f :heap)) (expected (model-allocate (get f :model) size))
           (offset (js-call r "allocator-allocate" heap size)) (error (js-call r "last-error")))
      (if (nil? expected)
        (progn (js-call assert :strictEqual offset 0) (js-call assert :strictEqual error 2))
        (progn (js-call assert :strictEqual error 0)
          (js-call assert :strictEqual offset (get expected :offset))
          (js-call assert :strictEqual (word r heap offset) (get expected :size))))
      (check f) expected))
  (defun release-block (f block)
    (let ((r (get f :r)) (height (get (check f) :height)))
      (js-call r "allocator-reset-free-visits")
      (js-call assert :strictEqual (js-call r "allocator-free" (get f :heap) (get block :offset) (get block :size)) 0)
      (js-call assert :strictEqual (js-call r "last-error") 0)
      (js-call assert :ok (<= (js-call r "allocator-free-visits") height)))
    (model-free (get f :model) block) (check f))

  (test "allocator preserves original first fit through mixed sizes, rotations, splits and two-sided coalescing"
    (lambda ()
      (let ((f (fixture)) (live (js-array)) (seed 7919) (step 0))
        (while (< step 1400)
          (setq seed (% (+ (* seed 48271) 1) 2147483647))
          (if (and (> (js-length live) 0) (< (% seed 7) 3))
            (let* ((index (% seed (js-length live))) (block (aref live index)))
              (js-call live :splice index 1) (release-block f block))
            (let ((block (allocate-block f (* 8 (+ 4 (% seed 41))))))
              (when block (js-call live :push block))))
          (setq step (1+ step)))
        (while (> (js-length live) 0) (release-block f (js-call live :pop)))
        (js-call assert :strictEqual (control (get f :r) (get f :heap) 33) 0)
        (js-call assert :strictEqual (get (get f :model) :cursor) (get f :start)))))

  (test "allocator skips mixed undersized prefixes with logarithmic production search visits"
    (lambda ()
      (let ((f (fixture)) (holes (js-array)) (guards (js-array)) (index 0))
        (while (< index 384)
          (js-call holes :push (allocate-block f (* 8 (+ 4 (% index 5)))))
          (js-call guards :push (allocate-block f 32))
          (setq index (1+ index)))
        (setq index 0)
        (while (< index (js-length holes)) (release-block f (aref holes index)) (setq index (1+ index)))
        (setq index 0)
        (while (< index 96)
          (let* ((summary (check f)) (r (get f :r)) (size (+ 72 (* 8 (% index 17)))))
            (js-call r "allocator-reset-visits")
            (let ((block (allocate-block f size)))
              (js-call assert :ok (<= (js-call r "allocator-visits") (get summary :height)))
              (release-block f block)))
          (setq index (1+ index)))
        (while (> (js-length guards) 0) (release-block f (js-call guards :pop)))
        (js-call assert :strictEqual (get (get f :model) :cursor) (get f :start)))))

  (test "allocator growth, whole-block consumption and failed requests preserve the address index"
    (lambda ()
      (let* ((f (fixture nil 32768)) (r (get f :r)) (heap (get f :heap))
             (left (allocate-block f 72)) (guard (allocate-block f 32))
             (middle (allocate-block f 8000)) (tail (allocate-block f 32)))
        (release-block f left)
        ;; A 16-byte remainder must be consumed, not indexed as a new node.
        (let ((whole (allocate-block f 56)))
          (js-call assert :strictEqual (get whole :size) 72)
          (release-block f whole))
        (let ((grown (allocate-block f 16000)))
          (js-call assert :ok (> (js-call r "heap-capacity" heap) 4096))
          (release-block f middle)
          (allocate-block f 32768)
          (let ((recovered (allocate-block f 128))) (release-block f recovered))
          (release-block f grown))
        (release-block f tail) (release-block f guard)
        (js-call assert :strictEqual (control r heap 33) 0)
        (js-call assert :strictEqual (get (get f :model) :cursor) (get f :start)))))

  (test "allocator GC merge and moving compaction rebuild the index without retaining garbage"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 64 4096 32768))
             (start (js-call r "heap-used" heap)) (frame (js-call r "frame-new" heap 2))
             (a (js-call r "value-bytes" heap 96)) (b (js-call r "value-bytes" heap 160))
             (c (js-call r "value-bytes" heap 96))
             (b-offset (js-call r "allocator-offset" heap b)) (b-size (js-call r "allocator-size" heap b)))
        (js-call r "frame-set" heap frame 0 a) (js-call r "frame-set" heap frame 1 c)
        (js-call r "value-byte-set" heap a 0 17) (js-call r "value-byte-set" heap c 95 231)
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "last-error") 0)
        (js-call assert :strictEqual (control r heap 6) b-offset)
        (js-call assert :strictEqual (word r heap b-offset) b-size)
        (let ((summary (tree-check r heap (control r heap 33) 0 0 4294967295 (new globalThis.Set))))
          (js-call assert :strictEqual (get summary :count) 1))
        (let* ((offset (js-call r "allocator-allocate" heap 64)) (actual (word r heap offset)))
          (js-call assert :strictEqual offset b-offset)
          (js-call r "allocator-free" heap offset actual))
        (js-call assert :strictEqual (js-call r "allocator-compact" heap) 1)
        (js-call assert :strictEqual (control r heap 6) 0)
        (js-call assert :strictEqual (control r heap 33) 0)
        (js-call assert :strictEqual (js-call r "value-byte-get" heap a 0) 17)
        (js-call assert :strictEqual (js-call r "value-byte-get" heap c 95) 231)
        (js-call r "value-byte-get" heap b 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (let ((recovered (js-call r "value-bytes" heap 160)))
          (js-call assert :ok (> recovered 3)) (js-call assert :notStrictEqual recovered b))
        (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
        (js-call assert :strictEqual (js-call r "heap-used" heap) start)
        (js-call assert :strictEqual (control r heap 33) 0))))

  (test "allocator roots are per heap and retirement cannot expose an earlier free tree"
    (lambda ()
      (let* ((r (fresh)) (a (fixture r)) (b (fixture r))
             (hole (allocate-block a 128)) (guard (allocate-block a 32)))
        (release-block a hole)
        (js-call assert :notStrictEqual (control r (get a :heap) 33) 0)
        (js-call assert :strictEqual (control r (get b :heap) 33) 0)
        (let ((block (allocate-block b 64))) (release-block b block))
        (release-block a guard)
        (js-call r "retire")
        (js-call assert :strictEqual (js-call r "heap-used" (get a :heap)) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (let ((next (fixture r))) (check next)
          (js-call assert :strictEqual (control r (get next :heap) 33) 0)))))

  ;; Preserve the original allocator suite's exact request/address scenarios.
  ;; Only its old prefix-header and linked-scan counts are replaced by AVL
  ;; invariants and actual search bounds; capacity and lifetime checks remain.
  (test "original first-fit split consume coalesce and changed-size addresses survive AVL indexing"
    (lambda ()
      (let* ((f (fixture nil 32768)) (r (get f :r)) (heap (get f :heap))
             (holes (js-array)) (separators (js-array)) (index 0))
        (while (< index 24)
          (js-call holes :push (allocate-block f 32)) (js-call separators :push (allocate-block f 32))
          (setq index (1+ index)))
        (let ((large (allocate-block f 256)) (guard (allocate-block f 32)))
          (setq index 0)
          (while (< index (js-length holes)) (release-block f (aref holes index)) (setq index (1+ index)))
          (release-block f large)
          (let ((first (allocate-block f 80)) (second (allocate-block f 80))
                (absorbed (allocate-block f 80)) (bump (allocate-block f 80)) (small (allocate-block f 32)))
            (js-call assert :strictEqual (get first :offset) (get large :offset))
            (js-call assert :strictEqual (get second :offset) (+ (get large :offset) 80))
            (js-call assert :deepStrictEqual absorbed (js-object :offset (+ (get large :offset) 160) :size 96))
            (js-call assert :strictEqual (get bump :offset) (+ (get guard :offset) (get guard :size)))
            (js-call assert :strictEqual (get small :offset) (get (aref holes 0) :offset))
            (release-block f (aref separators 1))
            (let ((merged (allocate-block f 80)))
              (js-call assert :strictEqual (get merged :offset) (get (aref holes 1) :offset))
              (release-block f small) (release-block f merged))
            (release-block f first) (release-block f second) (release-block f absorbed)
            (release-block f bump) (release-block f guard))
          (setq index 0)
          (while (< index (js-length separators))
            (unless (= index 1) (release-block f (aref separators index))) (setq index (1+ index))))
        (js-call assert :strictEqual (js-call r "heap-used" heap) (get f :start))
        (let* ((head (allocate-block f 256)) (guard (allocate-block f 32))
               (view (new globalThis.DataView (get (get r :memory) :buffer)))
               (address (+ (js-call r "allocator-base" heap) (get head :offset))))
          (js-call view :setUint32 (+ address 8) 80 t)
          (js-call view :setUint32 (+ address 12) 4294967288 t)
          (release-block f head)
          (let ((a (allocate-block f 80)) (b (allocate-block f 80)) (c (allocate-block f 80)))
            (js-call assert :strictEqual (get c :size) 96)
            (js-call assert :strictEqual (control r heap 33) 0)
            (release-block f a) (release-block f b) (release-block f c) (release-block f guard)))
        (js-call assert :strictEqual (js-call r "heap-used" heap) (get f :start))
        (js-call assert :strictEqual (js-call r "retire") 1))))

  (test "original changing requests retain every independent first-fit address and rejection"
    (lambda ()
      (let* ((f (fixture nil 32768)) (r (get f :r)) (holes (js-array)) (separators (js-array))
             (allocated (js-array)) (sizes (js-array 32 40 56 64 48)) (index 0))
        (while (< index 96)
          (js-call holes :push (allocate-block f (aref sizes (% index 5))))
          (js-call separators :push (allocate-block f 32)) (setq index (1+ index)))
        (let ((large (allocate-block f 2048)) (guard (allocate-block f 32)))
          (setq index 0)
          (while (< index 96) (release-block f (aref holes index)) (setq index (1+ index)))
          (release-block f large)
          (let ((requests (js-array 96 112 80 144 72 160 96 128 64 72)))
            (setq index 0)
            (while (< index (js-length requests))
              (let ((height (get (check f) :height)))
                (js-call r "allocator-reset-visits")
                (js-call allocated :push (allocate-block f (aref requests index)))
                (js-call assert :ok (<= (js-call r "allocator-visits") height)))
              (setq index (1+ index))))
          (js-call assert :strictEqual (get (aref allocated 8) :offset) (get (aref holes 3) :offset))
          (allocate-block f 4294967288) (allocate-block f 4294967280)
          (release-block f (aref separators 1))
          (let ((merged (allocate-block f 96)))
            (js-call assert :strictEqual (get merged :offset) (get (aref holes 1) :offset))
            (js-call allocated :push merged))
          (while (> (js-length allocated) 0) (release-block f (js-call allocated :pop)))
          (release-block f guard)
          (setq index 0)
          (while (< index 96)
