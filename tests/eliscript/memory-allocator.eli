        (js-call assert :strictEqual (js-call r "value-module-begin" heap 2) 1)
        (js-call (js-array 0 1) :forEach (lambda (index)
          (js-call r "value-module-declare" heap index 0) (js-call r "value-module-init" heap index (v64 0))))
        (js-call (js-array (js-array mutable 6) (js-array object 1) (js-array symbol 1)
                   (js-array (v64 0) 1) (js-array (v64 1) 1) (js-array (v64 2) 1) (js-array (v64 3) 1)) :forEach (lambda (entry)
          (js-call assert :strictEqual (js-call r "value-module-literal-init" heap 0 (aref entry 0)) (v64 0))
          (js-call assert :strictEqual (js-call r "last-error") (aref entry 1))
