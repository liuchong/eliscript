  (test "named weak buckets retain colliding canonical identities without repeat whole-slot scans"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 1024 32768 262144)) (_ (js-call r "string-new" 0))
             (frame (js-call r "frame-new" heap 67)) (functions (js-array)) (index 0))
        (js-call assert :ok (> heap 3)) (js-call assert :ok (v64-ref-p frame))
        (while (< index 64)
