    (uint32 (+ (unsigned-bit-shift-right (js-call scratch-view :getUint32 0 t) 24)
               (bit-shift-left (bit-and (js-call scratch-view :getUint32 4 t) 65535) 8))))
  (defun read-number (r heap raw)
    (js-call scratch-view :setBigUint64 0 (normalize-u64 (js-call r "value-number-bits" heap raw)) t)
    (js-call scratch-view :getFloat64 0 t))
  (defun number-low (r heap raw)
    (js-call scratch-view :setBigUint64 0 (normalize-u64 (js-call r "value-number-bits" heap raw)) t)
    (js-call scratch-view :getUint32 0 t))
  (defun number-high (r heap raw)
    (js-call scratch-view :setBigUint64 0 (normalize-u64 (js-call r "value-number-bits" heap raw)) t)
    (js-call scratch-view :getUint32 4 t))

  (defun word (r heap offset) (uint32 (js-call r "allocator-word" heap offset)))
  (defun v64-word (r heap offset) (normalize-u64 (js-call r "allocator-v64-word" heap offset)))
  (defun slot-word (r heap offset) (uint32 (js-call r "allocator-slot-word" heap offset)))
  (defun control (r heap name)
