          (js-call assert :strictEqual (control r heap 3) 1020)
          (js-call assert :ok (>= (js-call r "heap-collect" heap) 954))
          (js-call assert :strictEqual (js-call r "heap-live" heap) 66)
          (js-call assert :strictEqual (control r heap 3) 1020)
