(module tests.memory-allocator
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  ;; Bootstrap emits this source at tests/wasm-memory-allocator.test.mjs.
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/compiler/controlled-baseline.mjs" definition)

  (defvar directory undefined)
  (defvar image undefined)
  (defvar lifo-image undefined)
  (defvar extended-image undefined)
  (defun allocator-runtime-image (backend source filename maximum-pages)
    ;; Finish one image before compiling the reference, so its compiler IR
    ;; does not remain a beforeAll local beside the next full runtime IR.
    (let* ((program (js-call (get backend :compiler) :compile_ir_string source filename))
           (bytes (js-call globalThis.Uint8Array :from
             (js-call (get backend :wasm) :emit_memory_wasm program
               (js-object :initialPages 1 :maximumPages maximum-pages)))))
      (new globalThis.WebAssembly.Module bytes)))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-avl-allocator-"))))
    (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
           (source (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
           (needle "(let* ((p (+ base current)) (left (load-u32 (+ p 8))))")
           (counted (js-call source :replace needle
             "(let* ((p (+ base current)) (left (progn (store-u32 64 (1+ (load-u32 64))) (load-u32 (+ p 8)))))"))
           (free-needle "(while (/= current 0)\n        (if (< current offset)")
           (linked (js-call counted :replace free-needle
             "(while (/= current 0)\n        (store-u32 68 (1+ (load-u32 68)))\n        (if (< current offset)"))
           (safepoint "  (defun heap-allocate-with-gc (heap size)\n")
           (moving (js-call linked :replace safepoint (+ safepoint
             "    (when (= (load-u32 72) 1) (store-u32 72 0) (heap-collect heap) (heap-defragment heap))\n")))
           (named-start (js-call moving :indexOf "  (defun value-function-named (heap code)"))
           (named-end (js-call moving :indexOf "  (defun value-function-code " named-start))
           (named (js-call moving :slice named-start named-end))
           (named-scan "(while (and (<= slot slots) (= result 0))")
           (named-counted (js-call named :replace named-scan
             "(while (and (<= slot slots) (= result 0)) (store-u32 76 (1+ (load-u32 76)))"))
           (named-instrumented (+ (js-call moving :slice 0 named-start) named-counted (js-call moving :slice named-end)))
           (foreign-start (js-call named-instrumented :indexOf "  (defun value-foreign-new (heap token subtype)"))
           (foreign-end (js-call named-instrumented :indexOf "  (defun value-foreign-token " foreign-start))
           (foreign (js-call named-instrumented :slice foreign-start foreign-end))
           (foreign-scan "(while (and (<= slot (heap-control heap 3)) (= result 0))")
           (foreign-counted (js-call foreign :replace foreign-scan
             (+ foreign-scan " (store-u32 80 (1+ (load-u32 80)))")))
           (foreign-instrumented (+ (js-call named-instrumented :slice 0 foreign-start) foreign-counted
             (js-call named-instrumented :slice foreign-end)))
           (descriptor-head "  (defun heap-source-descriptor-object (heap value getter setter flags frozen)\n")
           (descriptor-instrumented (js-call foreign-instrumented :replace descriptor-head
             (+ descriptor-head "    (store-u32 84 (1+ (load-u32 84)))\n")))
           (weak-table-head "  (defun heap-weak-mark-table (base control p old-color)\n")
           (weak-key-head "  (defun heap-weak-mark-key (base control key old-color)\n")
           (weak-table-instrumented (js-call descriptor-instrumented :replace weak-table-head
             (+ weak-table-head "    (store-u32 88 (1+ (load-u32 88)))\n")))
           (weak-key-instrumented (js-call weak-table-instrumented :replace weak-key-head
             (+ weak-key-head "    (store-u32 92 (1+ (load-u32 92)))\n")))
           (slot-head "  (defun heap-next-allocated-slot (heap after)\n")
           (slot-instrumented (js-call weak-key-instrumented :replace slot-head
             (+ slot-head "    (store-u32 96 (1+ (load-u32 96)))\n")))
           (remove-head "  (defun heap-free-tree-remove (heap base node)\n")
           (remove-instrumented (js-call slot-instrumented :replace remove-head
             (+ remove-head "    (store-u32 100 (1+ (load-u32 100)))\n")))
           (insert-head "  (defun heap-free-tree-insert (heap base node)\n")
           (instrumented (js-call remove-instrumented :replace insert-head
             (+ insert-head "    (store-u32 104 (1+ (load-u32 104)))\n")))
           (symbol-start (js-call instrumented :indexOf "  (defun heap-symbol-new (heap description provenance identifier)"))
           (symbol-end (js-call instrumented :indexOf "  (defun heap-symbol-well-known-label " symbol-start))
           (symbol-body (js-call instrumented :slice symbol-start symbol-end))
           (symbol-counted (js-call symbol-body :replace
             "(while (and (= result 0) (<= slot (heap-control heap 3)))"
             "(while (and (= result 0) (<= slot (heap-control heap 3))) (store-u32 108 (1+ (load-u32 108)))"))
           (symbol-instrumented (+ (js-call instrumented :slice 0 symbol-start) symbol-counted
             (js-call instrumented :slice symbol-end)))
           (number-head "  (defun heap-number-positional-text (heap value radix)\n")
           (number-instrumented (js-call symbol-instrumented :replace number-head
             (+ number-head "    (store-u32 112 (1+ (load-u32 112)))\n")))
           ;; This test image owns a deterministic Eliscript callback table.
           ;; Replace calls, not the memory intrinsic import or production ABI.
           (callback-instrumented (js-call number-instrumented :replaceAll "(call-source " "(allocator-call-source "))
           (next-head "  (defun value-source-iterator-next (heap iterator)\n")
           (next-instrumented (js-call callback-instrumented :replace next-head
             (+ next-head "    (store-u32 124 (1+ (load-u32 124)))\n")))
           (object-head "  (defun value-object-new (heap prototype)\n")
           (object-instrumented (js-call next-instrumented :replace object-head
             (+ object-head "    (store-u32 140 (1+ (load-u32 140)))\n")))
           (frame-head "  (defun frame-new (heap count)\n")
           (frame-instrumented (js-call object-instrumented :replace frame-head
             (+ frame-head "    (store-u32 148 (1+ (load-u32 148)))\n")))
           (extended (+ (js-call frame-instrumented :slice 0 (js-call frame-instrumented :lastIndexOf ")"))
             (js-call (js-array ""
               "    (defun allocator-call-source (heap function arguments count code)"
               "      (store-u32 116 (1+ (load-u32 116)))"
               "      (store-u32 120 (heap-control heap 27))"
               "      (store-u32 152 (frame-depth heap))"
               "      (when (= (load-u32 136) 1) (store-u32 136 0) (heap-collect heap) (heap-defragment heap))"
               "      (cond"
               "        ((= code 9001) (heap-control heap 27))"
               "        ((= code 9002) (value-throw heap 1))"
               "        ((= code 9003) (value-throw heap 3))"
               "        ((= code 9004) (value-function-capture-get heap function 0))"
               "        ((= code 9005) (store-u32 132 (1+ (load-u32 132))) (value-throw heap 1))"
               "        ((= code 9006) 1)"
               "        ((= code 1000) (heap-control heap 27))"
               "        ((and (>= code 1001) (<= code 1005))"
               "          (value-collection-prototype-iterator-builtin heap (heap-control heap 27) arguments count"
               "            (if (= code 1001) 328 (if (= code 1002) 329 (if (= code 1003) 330 (if (= code 1004) 332 333))))))"
               "        (t (fail 3))))"
               "    (defun allocator-described (heap code builtin marked captures)"
               "      (begin-operation) (let ((function (value-function-new heap code captures)) (frame 0))"
               "        (when (/= function 0) (setq frame (heap-argument-frame heap function 0 0 2))"
               "          (when (/= frame 0) (let ((name (value-string heap 0)))"
               "            (when (/= name 0) (frame-set heap frame 1 name) (value-seal heap name)"
               "              (heap-function-info-new heap function name 0 0 builtin 3)"
               "              (when (= marked 1) (value-function-mark-builtin heap function))))"
               "            (setq function (heap-frame-result heap frame function)))) function))"
               "    (defun allocator-function-data (heap function key value)"
               "      (begin-operation) (heap-function-data-put heap (heap-function-info heap function) key value 7))"
               "    (defun allocator-function-accessor (heap function key getter)"
               "      (begin-operation) (let ((frame (heap-argument-frame heap function key getter 4)) (result 0))"
               "        (when (/= frame 0) (let ((pair (value-refs heap 7 2)))"
               "          (when (/= pair 0) (frame-set heap frame 3 pair) (value-set heap pair 0 getter) (value-set heap pair 1 3)"
               "            (setq result (heap-function-data-put heap (heap-function-info heap function) key pair 14))))"
               "          (setq result (heap-frame-result heap frame result))) result))"
               "    (defun allocator-function-parent (heap function parent)"
               "      (store-u32 (+ (heap-block heap (heap-function-info heap function)) 40) parent))"
               "    (defun allocator-capture-set (heap function value) (heap-function-native-capture-set heap function 0 value))"
               "    (defun allocator-protocol-record (heap iterator) (begin-operation) (heap-source-protocol-record heap iterator))"
               "    (defun allocator-protocol-native (heap iterator method) (begin-operation) (heap-source-protocol-native heap iterator method))"
               "    (defun allocator-iterator-item (heap iterator) (begin-operation) (heap-source-iterator-item heap iterator))"
               "    (defun allocator-iterator-method (heap iterator) (load-u32 (+ (heap-block heap iterator) 48)))"
               "    (defun allocator-callback-count () (load-u32 116))"
               "    (defun allocator-callback-receiver () (load-u32 120))"
               "    (defun allocator-next-count () (load-u32 124))"
               "    (defun allocator-object-count () (load-u32 140))"
               "    (defun allocator-frame-count () (load-u32 148))"
               "    (defun allocator-callback-depth () (load-u32 152))"
               "    (defun allocator-own-data (heap target key) (begin-operation) (heap-source-own-data-get heap target key))"
               "    (defun allocator-namespace-mark (heap target) (store-u32 (+ (heap-block heap target) 20) 1))"
               "    (defun allocator-create-own (heap object key child mode) (begin-operation) (heap-object-create-own-try heap object key child mode))"
               "    (defun allocator-object-flags-set (heap object flags) (store-u32 (+ (heap-block heap object) 24) flags))"
               "    (defun allocator-current-this-set (heap value) (heap-control-set heap 27 value))"
               "    (defun allocator-value-reads () (load-u32 132))"
               "    (defun allocator-reset-callbacks () (store-u32 116 0) (store-u32 120 0) (store-u32 124 0) (store-u32 132 0) (store-u32 140 0))"
               "    (defun allocator-callback-compact-next () (store-u32 136 1))"
               "    (defun allocator-clear-realm (heap)"
               "      (heap-control-set heap 20 0) (heap-control-set heap 21 0) (heap-control-set heap 26 0)"
               "      (heap-control-set heap 27 3) (heap-control-set heap 28 0) (heap-control-set heap 29 0)"
               "      (heap-control-set heap 30 0) (heap-control-set heap 31 0) (heap-control-set heap 32 0))"
               "    (defun allocator-expose-string (heap constructor)"
               "      (let ((frame (heap-argument-frame heap constructor 0 0 3)) (result 0))"
               "        (when (/= frame 0) (let ((table (value-table-new heap 10 8)))"
               "          (when (/= table 0) (frame-set heap frame 1 table)"
               "            (let ((key (heap-number-from-word heap 6 0)))"
               "              (when (/= key 0) (frame-set heap frame 2 key) (value-table-put heap table key constructor)"
               "                (heap-control-set heap 28 table) (setq result 1)))))"
               "          (setq result (heap-frame-result heap frame result))) result))"
               "    (defun allocator-allocate (heap size)"
               "      (begin-operation) (if (= (heap-check heap) 0) 0 (heap-allocate-block heap size)))"
               "    (defun allocator-free (heap offset size)"
               "      (begin-operation) (if (= (heap-check heap) 0) 0 (heap-free-block heap offset size)))"
               "    (defun allocator-control (heap index) (heap-control heap index))"
               ;; Exercise the actual extended layout with a small finite slot
               ;; set; public constructors still select their original widths.
               "    (defun allocator-layout (slots initial maximum bits)"
               "      (begin-operation) (heap-new-layout slots initial maximum bits))"
               "    (defun allocator-base (heap) (heap-base heap))"
               "    (defun allocator-word (heap offset) (load-u32 (+ (heap-base heap) offset)))"
               "    (defun allocator-offset (heap value) (- (heap-block heap value) (heap-base heap)))"
               "    (defun allocator-size (heap value) (load-u32 (+ (heap-entry heap (heap-slot-index heap value)) 12)))"
               "    (defun allocator-compact (heap) (heap-defragment heap))"
               "    (defun allocator-visits () (load-u32 64))"
               "    (defun allocator-reset-visits () (store-u32 64 0))"
               "    (defun allocator-free-visits () (load-u32 68))"
               "    (defun allocator-reset-free-visits () (store-u32 68 0))"
               "    (defun allocator-compact-next () (store-u32 72 1))"
               "    (defun allocator-named-scans () (load-u32 76))"
               "    (defun allocator-reset-named-scans () (store-u32 76 0))"
               "    (defun allocator-foreign-scans () (load-u32 80))"
               "    (defun allocator-reset-foreign-scans () (store-u32 80 0))"
               "    (defun allocator-descriptors () (load-u32 84))"
               "    (defun allocator-reset-descriptors () (store-u32 84 0))"
               "    (defun allocator-weak-key (heap) (begin-operation) (heap-object heap 13 0 4))"
               "    (defun allocator-weak-table (heap capacity) (begin-operation) (heap-weak-new heap capacity))"
               "    (defun allocator-weak-set (heap table key value) (begin-operation) (heap-weak-install heap table key value))"
               "    (defun allocator-weak-get (heap table key)"
               "      (begin-operation) (let ((position (heap-weak-find heap table key 0)))"
               "        (if (= position 0) 3 (load-u32 (+ (+ (heap-block heap table) 36) (* (1- position) 8))))))"
               "    (defun allocator-weak-count (heap table) (begin-operation) (load-u32 (+ (heap-block heap table) 4)))"
               "    (defun allocator-weak-holder (heap table)"
               "      (begin-operation) (let ((result (heap-object heap 23 1 4)))"
               "        (when (/= result 0) (store-u32 (+ (heap-block heap result) 32) table)) result))"
               "    (defun allocator-weak-seeds () (load-u32 88))"
               "    (defun allocator-weak-probes () (load-u32 92))"
               "    (defun allocator-reset-weak-work () (store-u32 88 0) (store-u32 92 0))"
               "    (defun allocator-slot-visits () (load-u32 96))"
               "    (defun allocator-reset-slot-visits () (store-u32 96 0))"
               "    (defun allocator-tree-removes () (load-u32 100))"
               "    (defun allocator-tree-inserts () (load-u32 104))"
               "    (defun allocator-reset-tree-mutations () (store-u32 100 0) (store-u32 104 0))"
               "    (defun allocator-cache-set (heap code value)"
               "      (let ((p (heap-named-cache-entry heap code))) (if (= p 0) 0 (progn (store-u32 p value) 1))))"
               "    (defun allocator-cache-enabled (heap code) (if (= (heap-named-cache-entry heap code) 0) 0 1))"
               "    (defun allocator-next-set (heap function value) (store-u32 (+ (heap-block heap function) 8) value))"
               "    (defun allocator-function-capacity (heap function) (load-u32 (+ (heap-block heap function) 8)))"
               "    (defun allocator-root-count (heap value) (load-u32 (+ (heap-entry heap (heap-slot-index heap value)) 16)))"
               "    (defun allocator-fill-refs (heap roots count)"
               "      (let ((index 0))"
               "        (while (and (< index count) (= (last-error) 0))"
               "          (let ((value (value-bytes heap 0)))"
               "            (when (/= value 0) (value-set heap roots index value)))"
               "          (setq index (1+ index))) index))"
               "    (defun allocator-symbol-scans () (load-u32 108))"
               "    (defun allocator-reset-symbol-scans () (store-u32 108 0))"
               "    (defun allocator-symbol-cache-set (heap identifier raw)"
               "      (store-u32 (heap-symbol-cache-entry heap identifier) raw))"
               "    (defun allocator-number-text (heap value) (begin-operation) (heap-number-text heap value))"
               "    (defun allocator-number-reference (heap value) (begin-operation) (heap-number-positional-text heap value 10))"
               "    (defun allocator-number-scratch-calls () (load-u32 112))"
               "    (defun allocator-reset-number-scratch () (store-u32 112 0))"
               "    (defun allocator-array-index (heap object index mode child)"
               "      (begin-operation) (heap-source-array-prototype-index heap object index mode child))"
               "    (defun allocator-array-word (heap object index mode child)"
               "      (begin-operation) (heap-source-array-prototype-index-word heap object index mode child))"
               "    (defun allocator-array-direct (heap object index mode child)"
               "      (begin-operation) (heap-source-array-prototype-index-direct heap object index mode child))"
               "    (export allocator-allocate allocator-free allocator-control allocator-layout allocator-word allocator-base allocator-compact-next"
               "      allocator-offset allocator-size allocator-compact allocator-visits allocator-reset-visits"
               "      allocator-free-visits allocator-reset-free-visits allocator-named-scans allocator-reset-named-scans"
               "      allocator-foreign-scans allocator-reset-foreign-scans allocator-descriptors allocator-reset-descriptors"
               "      allocator-weak-key allocator-weak-table allocator-weak-set allocator-weak-get allocator-weak-count allocator-weak-holder"
               "      allocator-weak-seeds allocator-weak-probes allocator-reset-weak-work"
               "      allocator-tree-removes allocator-tree-inserts allocator-reset-tree-mutations"
               "      allocator-slot-visits allocator-reset-slot-visits"
               "      allocator-cache-set allocator-cache-enabled allocator-next-set allocator-function-capacity allocator-root-count"
               "      allocator-symbol-scans allocator-reset-symbol-scans allocator-symbol-cache-set"
               "      allocator-number-text allocator-number-reference allocator-number-scratch-calls allocator-reset-number-scratch"
               "      allocator-array-index allocator-array-word allocator-array-direct"
               "      allocator-described allocator-function-data allocator-function-accessor allocator-function-parent allocator-capture-set"
               "      allocator-protocol-record allocator-protocol-native allocator-iterator-item allocator-iterator-method"
               "      allocator-callback-count allocator-callback-receiver allocator-next-count allocator-object-count allocator-value-reads"
               "      allocator-reset-callbacks allocator-callback-compact-next allocator-clear-realm"
               "      allocator-expose-string"
               "      allocator-frame-count allocator-callback-depth allocator-own-data allocator-current-this-set allocator-namespace-mark"
               "      allocator-create-own allocator-object-flags-set"
               ;; The production module lifecycle helpers are private raw
               ;; functions. Export their real names only in this test image,
               ;; as the existing module-binding regression images do.
               "      value-module-begin value-module-declare value-module-init value-module-get value-module-set"
               "      value-module-complete value-module-close value-module-abort value-module-literal-key-init"
               "      allocator-fill-refs value-function-named value-function-new value-function-code))") :join "\n")))
           (enqueue (definition extended "heap-free-slot-append "))
           ;; Exact former sweep policy: the newly dead entry becomes head.
           ;; All generation/retirement, byte allocation and GC are unchanged.
           (lifo (js-call extended :replace enqueue
             (js-call (js-array
               "  (defun heap-free-slot-append (base control entry slot)"
               "    (store-u32 (+ entry 20) (load-u32 (+ control 16)))"
               "    (store-u32 (+ control 16) slot) 0)") :join "\n"))))
      ;; A single increment counts actual production search steps in this test
      ;; image only; it changes neither block choice nor the public runtime ABI.
      (js-call assert :notStrictEqual counted source)
      (js-call assert :notStrictEqual linked counted)
      (js-call assert :notStrictEqual moving linked)
      (js-call assert :ok (and (>= named-start 0) (> named-end named-start)))
      (js-call assert :notStrictEqual named-counted named)
      (js-call assert :ok (and (>= foreign-start 0) (> foreign-end foreign-start)))
      (js-call assert :notStrictEqual foreign-counted foreign)
      (js-call assert :notStrictEqual instrumented foreign-instrumented)
      (js-call assert :notStrictEqual weak-table-instrumented descriptor-instrumented)
      (js-call assert :notStrictEqual instrumented weak-table-instrumented)
      (js-call assert :notStrictEqual instrumented weak-key-instrumented)
      (js-call assert :notStrictEqual remove-instrumented slot-instrumented)
      (js-call assert :notStrictEqual instrumented remove-instrumented)
      (js-call assert :ok (and (>= symbol-start 0) (> symbol-end symbol-start)))
      (js-call assert :notStrictEqual symbol-counted symbol-body)
      (js-call assert :notStrictEqual number-instrumented symbol-instrumented)
      (js-call assert :notStrictEqual callback-instrumented number-instrumented)
      (js-call assert :notStrictEqual next-instrumented callback-instrumented)
      (js-call assert :notStrictEqual object-instrumented next-instrumented)
      (js-call assert :notStrictEqual frame-instrumented object-instrumented)
      (js-call assert :notStrictEqual lifo extended)
      (setq image (allocator-runtime-image backend extended "allocator-runtime.eli" 32))
      (setq lifo-image (allocator-runtime-image backend lifo "allocator-lifo-runtime.eli" 32))
      ;; A separate image permits the explicit extended profile. The original
      ;; allocator cases retain their existing 32-page memory limit.
      (setq extended-image (allocator-runtime-image backend extended "allocator-extended-runtime.eli" 8192))
      (js-call assert :deepStrictEqual (js-call globalThis.WebAssembly.Module :imports image) (js-array))))
    120000)
  (afterAll (async ()
    (setq image undefined lifo-image undefined extended-image undefined)
    (when directory (await (rm directory (js-object :recursive t :force t))))))

  (defun fresh () (get (new globalThis.WebAssembly.Instance image) :exports))
  (defun word (r heap offset) (uint32 (js-call r "allocator-word" heap offset)))
  (defun control (r heap index) (js-call r "allocator-control" heap index))

  (defun allocator-read-text (r heap raw)
    (let ((text "") (index 0) (length (js-call r "value-length" heap raw)))
      (while (< index length)
        (setq text (str text (String/fromCharCode (js-call r "value-unit-get" heap raw index))) index (1+ index))) text))

  (defun allocator-property-fixture ()
    (let* ((r (fresh)) (heap (js-call r "heap-new" 4096 131072 1048576)) (roots (js-array))
           (own (lambda (raw)
             (setq raw (uint32 raw)) (js-call assert :ok (> raw 3))
             (js-call assert :strictEqual (js-call r "heap-pin" heap raw) 1)
             (js-call roots :push raw) raw))
           (text (lambda (value)
             (let ((raw (funcall own (js-call r "value-string" heap (js-length value)))) (index 0))
               (while (< index (js-length value))
                 (js-call r "value-unit-set" heap raw index (js-call value :charCodeAt index)) (setq index (1+ index)))
               (js-call r "value-seal" heap raw) raw))))
      (js-object :r r :heap heap :roots roots :own own :text text)))
  (defun allocator-property-finish (fixture)
    (let ((r (get fixture :r)) (heap (get fixture :heap)))
      (js-call r "value-exception-clear" heap)
      (js-call r "allocator-clear-realm" heap)
      (js-call (get fixture :roots) :forEach (lambda (raw) (js-call r "heap-release" heap raw)))
      (js-call r "heap-collect" heap)
      (js-call assert :strictEqual (js-call r "last-error") 0)
      (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
      (js-call assert :strictEqual (js-call r "heap-live" heap) 0)))
  (defun allocator-iterator-registry (fixture custom)
    (let* ((r (get fixture :r)) (heap (get fixture :heap)) (own (get fixture :own))
           (methods (funcall own (js-call r "value-refs" heap 7 6))) (index 0)
           (tags (js-array 332 329 330 331 333 334)))
      (while (< index 6)
        (let ((function (if (and (= index 1) custom) custom
                 (funcall own (js-call r "allocator-described" heap (+ 1000 index) (aref tags index) 1 0)))))
          (js-call r "value-set" heap methods index function))
        (setq index (1+ index)))
      (let ((record (js-call r "value-collection-prototype-iterator-register" heap methods)))
        (js-call assert :ok (> record 3)) (js-call assert :strictEqual (js-call r "last-error") 0)
        (js-object :record (uint32 record) :methods methods))))

  ;; Independent execution of the maintained public algorithm, using language
  ;; numeric operations rather than the runtime's private word helpers.
  (defun allocator-hash-reference (text tag)
    (let* ((mix (lambda (hash value)
                  (let ((mixed (imul32 (uint32 (bit-xor hash value)) 1540483477)))
                    (uint32 (bit-xor mixed (unsigned-bit-shift-right mixed 15))))))
           (hash (funcall mix tag (js-length text))) (index 0))
      (while (< index (js-length text))
        (setq hash (funcall mix hash (string-code-unit-at text index)) index (1+ index)))
      (setq hash (funcall mix hash (uint32 (js-length text))))
      (setq hash (bit-xor hash (unsigned-bit-shift-right hash 16)))
      (setq hash (imul32 hash 2246822507))
      (setq hash (bit-xor hash (unsigned-bit-shift-right hash 13)))
      (setq hash (imul32 hash 3266489909))
      (uint32 (bit-xor hash (unsigned-bit-shift-right hash 16)))))
