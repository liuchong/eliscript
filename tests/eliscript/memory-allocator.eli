        (js-call assert :strictEqual (js-call r "value-function-named" heap 7) (aref functions 0))
        (js-call assert :ok (> (js-call r "allocator-named-scans") 0))
        (js-call r "allocator-reset-named-scans")
        (let ((function (js-call r "value-function-named" heap (+ 7 (* 8 256)))))
          (js-call r "frame-set" heap frame 8 function)
          (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
          (js-call r "allocator-next-set" heap function 0)
          (js-call r "allocator-reset-named-scans")
          (js-call assert :strictEqual (js-call r "value-function-named" heap 7) (aref functions 0))
          (js-call assert :ok (> (js-call r "allocator-named-scans") 0)))
        (js-call r "allocator-reset-named-scans")
        (let ((function (js-call r "value-function-named" heap (+ 7 (* 9 256)))))
          (js-call r "frame-set" heap frame 9 function)
          (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
          (js-call r "allocator-next-set" heap function function)
          (js-call r "allocator-reset-named-scans")
