          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
          (js-call assert :strictEqual (js-call r "allocator-root-count" heap function) 1)
          (js-call assert :strictEqual (js-call r "value-function-property-get" heap function (aref keys 0) (v64 0)) (v64 2))
          (js-call assert :strictEqual (js-call r "heap-release" heap filler) 1)
          (js-call r "heap-collect" heap) (js-call r "allocator-compact" heap)
          (js-call assert :strictEqual (js-call r "allocator-function-data" heap function (aref keys failed) (v64 2)) 1)
          (js-call assert :strictEqual (js-call r "last-error") 0)
          (js-call assert :strictEqual (js-call r "value-function-property-get" heap function (aref keys failed) (v64 0)) (v64 2)))
        (js-call roots :forEach (lambda (value) (js-call r "heap-release" heap value)))
        (js-call r "allocator-clear-realm" heap) (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0))))

