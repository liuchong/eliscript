        (js-call assert :strictEqual (js-call r "frame-depth" heap) 1)
        (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))

  (test "named cache GC rebuild is weak, preserves survivors and recreates collected generations"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 1024 32768 131072))
             (frame (js-call r "frame-new" heap 66)) (functions (js-array)) (index 0))
        (while (< index 64)
          (let ((function (js-call r "value-function-named" heap (+ 255 (* index 256)))))
            (js-call assert :ok (> function 3)) (js-call r "frame-set" heap frame index function)
            (js-call functions :push function))
          (setq index (1+ index)))
        (let ((zero (js-call r "value-number" heap 0 2147483648))
              (last (js-call r "value-function-named" heap 4294967295)))
          (js-call r "frame-set" heap frame 64 zero) (js-call r "frame-set" heap frame 65 last)
          (js-call assert :strictEqual (uint32 (js-call r "value-function-code" heap last)) 4294967295)
          (setq index 1)
          (while (< index 64) (js-call r "frame-set" heap frame index 0) (setq index (+ index 2)))
          (js-call assert :ok (>= (js-call r "heap-collect" heap) 32))
          (js-call r "allocator-reset-named-scans")
          (setq index 0)
          (while (< index 64)
            (js-call assert :strictEqual (js-call r "value-function-named" heap (+ 255 (* index 256))) (aref functions index))
            (setq index (+ index 2)))
          (js-call assert :strictEqual (js-call r "value-function-named" heap 4294967295) last)
          (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
          (setq index 1)
          (while (< index 64)
            (js-call assert :strictEqual (js-call r "value-kind" heap (aref functions index)) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)
            (let ((replacement (js-call r "value-function-named" heap (+ 255 (* index 256)))))
              (js-call assert :ok (> replacement 3))
              (js-call assert :notStrictEqual replacement (aref functions index))
              (js-call assert :strictEqual (js-call r "last-error") 0)
              (js-call r "frame-set" heap frame index replacement))
            (setq index (+ index 2)))
          (js-call assert :strictEqual (js-call r "frame-get" heap frame 64) zero)
          (let ((offset (js-call r "allocator-offset" heap zero)))
            (js-call assert :strictEqual (word r heap (+ offset 36)) 2147483648))
          (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
          (js-call assert :notStrictEqual (js-call r "value-function-named" heap 4294967295) last)
          (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)))))

  (test "named weak cache survives small heaps, former tail-entry boundaries, failure, isolation and retirement"
    (lambda ()
      (let* ((r (fresh)) (small (js-call r "heap-new" 511 16384 65536))
             (small-frame (js-call r "frame-new" small 1)) (plain (js-call r "value-function-named" small 7)))
        (js-call r "frame-set" small small-frame 0 plain)
        (js-call assert :strictEqual (js-call r "allocator-cache-enabled" small 7) 1)
        (js-call r "allocator-reset-named-scans")
        (js-call assert :strictEqual (js-call r "value-function-named" small 7) plain)
        (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
        (let* ((heap (js-call r "heap-new" 512 16384 65536)) (frame (js-call r "frame-new" heap 512))
               (zero (js-call r "value-number" heap 0 2147483648))
               (named (js-call r "value-function-named" heap 7)))
          (js-call r "frame-set" heap frame 0 zero) (js-call r "frame-set" heap frame 2 named)
          (while (< (control r heap 3) 256)
            (let ((value (js-call r "value-bytes" heap 0)))
              (js-call assert :ok (> value 3))
              (js-call r "frame-set" heap frame (1- (control r heap 3)) value)))
          (js-call assert :strictEqual (js-call r "allocator-cache-enabled" heap 7) 1)
          ;; A weak bucket must never alias a newly allocated real slot's root
          ;; count, even at the former borrowed-tail boundary.
          (js-call assert :strictEqual (js-call r "allocator-cache-set" heap 0 named) 1)
          (let ((boundary (js-call r "value-function-named" heap 777)))
            (js-call assert :ok (> boundary 3))
            (js-call assert :strictEqual (control r heap 3) 257)
            (js-call r "frame-set" heap frame 256 boundary)
            (js-call assert :strictEqual (js-call r "allocator-root-count" heap boundary) 0)
            (js-call assert :strictEqual (js-call r "allocator-cache-enabled" heap 7) 1))
          (while (< (control r heap 3) 512)
            (let ((value (js-call r "value-bytes" heap 0)))
              (js-call assert :ok (> value 3))
              (js-call r "frame-set" heap frame (1- (control r heap 3)) value)))
          (let ((used (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap)))
            (js-call assert :strictEqual (js-call r "value-function-named" heap 4095) 0)
            (js-call assert :strictEqual (js-call r "last-error") 2)
            (js-call assert :strictEqual (js-call r "heap-used" heap) used)
            (js-call assert :strictEqual (js-call r "heap-live" heap) live)
            (js-call assert :strictEqual (js-call r "frame-depth" heap) 1))
          (js-call r "allocator-reset-named-scans")
          (js-call assert :strictEqual (js-call r "value-function-named" heap 7) named)
          (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
          (js-call assert :strictEqual (control r heap 3) 512)
          (js-call r "allocator-reset-named-scans")
          (let ((repeat 0))
            (while (< repeat 64)
              (js-call assert :strictEqual (js-call r "value-function-named" heap 7) named)
              (setq repeat (1+ repeat))))
          (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
          (js-call assert :strictEqual (js-call r "value-function-named" small 7) plain)
          (js-call assert :strictEqual (js-call r "frame-get" heap frame 0) zero)
          (js-call r "frame-set" heap frame 511 0) (js-call r "heap-collect" heap)
          (let ((recovered (js-call r "value-function-named" heap 4095)))
            (js-call assert :ok (> recovered 3)) (js-call assert :strictEqual (js-call r "last-error") 0))
          (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))
        (js-call r "frame-pop" small small-frame) (js-call r "heap-collect" small)
        (js-call assert :strictEqual (js-call r "heap-live" small) 0)
        (js-call r "retire")
        (js-call assert :strictEqual (js-call r "value-function-named" small 7) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (let ((next (js-call r "heap-new" 1024 32768 131072)))
          (js-call assert :ok (> (js-call r "value-function-named" next 0) 3))
          (js-call r "heap-collect" next)
          (js-call assert :strictEqual (js-call r "heap-live" next) 0)))))

  (test "named buckets stay allocation-free after near-maximum highwater, GC and moving compaction"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 1024 32768 131072))
             (frame (js-call r "frame-new" heap 66)) (functions (js-array)) (index 0))
        (while (< index 64)
          (let ((function (js-call r "value-function-named" heap (+ 11 (* index 256)))))
            (js-call assert :ok (> function 3)) (js-call r "frame-set" heap frame index function)
            (js-call functions :push function))
          (setq index (1+ index)))
        (let ((zero (js-call r "value-number" heap 0 2147483648)) (base (js-call r "allocator-base" heap)))
          (js-call r "frame-set" heap frame 64 zero)
          ;; Keep only the real caller roots. Dead short-lived objects drive
          ;; highwater past the old permanent-disable threshold without GC.
          (while (< (control r heap 3) 1020)
            (js-call assert :ok (> (js-call r "value-bytes" heap 0) 3)))
          (js-call assert :notStrictEqual (js-call r "allocator-base" heap) base)
          (js-call assert :strictEqual (control r heap 3) 1020)
          (js-call assert :ok (>= (js-call r "heap-collect" heap) 954))
          (js-call assert :strictEqual (js-call r "heap-live" heap) 66)
          (js-call assert :strictEqual (control r heap 3) 1020)
          (js-call assert :strictEqual (js-call r "allocator-cache-enabled" heap 11) 1)
          (js-call assert :strictEqual (js-call r "allocator-compact" heap) 1)
          (js-call r "heap-auto" heap 1)
          (let ((extra (js-call r "value-function-named" heap 17)))
            (js-call assert :ok (> extra 3)) (js-call r "frame-set" heap frame 65 extra))
          (let ((used (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap))
                (collections (js-call r "heap-collections" heap)) (repeat 0))
            (js-call r "allocator-reset-named-scans")
            (while (< repeat 16)
              (setq index 0)
              (while (< index 64)
                (js-call assert :strictEqual (js-call r "value-function-named" heap (+ 11 (* index 256)))
                  (aref functions index))
                (js-call assert :strictEqual (js-call r "last-error") 0)
                (setq index (1+ index)))
              (setq repeat (1+ repeat)))
            (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
            (js-call assert :strictEqual (js-call r "heap-used" heap) used)
            (js-call assert :strictEqual (js-call r "heap-live" heap) live)
            (js-call assert :strictEqual (js-call r "heap-collections" heap) collections))
          (js-call assert :strictEqual (js-call r "frame-get" heap frame 64) zero)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 1)
          (let ((offset (js-call r "allocator-offset" heap zero)))
            (js-call assert :strictEqual (word r heap (+ offset 36)) 2147483648))
          (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
          (js-call assert :notStrictEqual (js-call r "value-function-named" heap 11) (aref functions 0))
          (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)))))
)
