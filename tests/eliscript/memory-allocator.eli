(module tests.memory-allocator
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  ;; Bootstrap emits this source at tests/wasm-memory-allocator.test.mjs.
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/compiler/controlled-baseline.mjs" definition)
  (import "../tools/backends/managed-layout.mjs" CONTROL_U32_OFFSETS)

  (defvar directory undefined)
  (defvar image undefined)
  (defvar lifo-image undefined)
  (defvar extended-image undefined)
  (defvar ro-image undefined)
  (defvar scratch-view (new globalThis.DataView (new globalThis.ArrayBuffer 8)))

  ;; The RO directory image must come from a real managed lowering rather than
  ;; a hand-written header. This test-only program interns the labels that the
  ;; runtime itself later reads through heap-static-text.
  (defconst static-label-source
    (js-call (js-array
      "(module tests.allocator-static-labels"
      "  (defun labels (target)"
      "    (js-array (get target \"call\") (get target \"Map\")"
      "      (get target \"Symbol.iterator\")"
      "      (js-object \"call\" 1 \"Map\" 2 \"Symbol.iterator\" 3)))"
      "  (export labels))") :join "\n"))

  (defasync allocator-real-ro-data (backend)
    (let* ((compiler (get backend :compiler))
           (runtime (js-call compiler :compile_ir_string
                      (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
           (labels (js-call compiler :compile_ir_string static-label-source
                     "tests/allocator-static-labels.eli"))
           (lowered (js-call (get backend :managed) :lower_managed_project
                      (js-array (js-object :id "tests/allocator-static-labels.mjs" :program labels))
                      "tests/allocator-static-labels.mjs" runtime (js-object))))
      (get (get lowered :typed) :roData)))

  (defun allocator-runtime-image (backend source filename maximum-pages &optional ro-data)
    ;; Finish one image before compiling the reference, so its compiler IR
    ;; does not remain a beforeAll local beside the next full runtime IR.
    (let* ((program (js-call (get backend :compiler) :compile_ir_string source filename))
           (options (js-object :initialPages 1 :maximumPages maximum-pages)))
      (when ro-data (put options :roData ro-data))
      (let ((bytes (js-call globalThis.Uint8Array :from
              (js-call (get backend :wasm) :emit_memory_wasm program options))))
        (new globalThis.WebAssembly.Module bytes))))

