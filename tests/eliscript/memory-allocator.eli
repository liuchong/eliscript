             (own (get f :own)) (receiver (funcall own (js-call r "value-array-new" heap 0)))
             (previous (funcall own (js-call r "value-array-new" heap 0)))
             (arguments (funcall own (js-call r "value-refs" heap 7 0)))
             (caller (js-call r "frame-new" heap 4)))
        (js-call r "frame-set" heap caller 1 arguments)
        (js-call r "frame-set" heap caller 2 receiver)
        (js-call r "frame-set" heap caller 3 previous)
        (js-call r "allocator-current-this-set" heap previous)
        (js-call (js-array (js-array 9002 1) (js-array 9003 3)) :forEach (lambda (entry)
          (let ((function (uint32 (js-call r "allocator-described" heap (aref entry 0) 0 0 0))))
            (js-call r "frame-set" heap caller 0 function)
            (js-call r "allocator-callback-compact-next")
            (js-call assert :strictEqual (js-call r "value-source-invoke-rooted-with-this" heap function receiver arguments 0) 0)
            (js-call assert :strictEqual (js-call r "last-error") 11)
            (js-call assert :strictEqual (js-call r "value-exception-take" heap) (aref entry 1))
            (js-call assert :strictEqual (uint32 (js-call r "value-function-current-this" heap)) previous)
            (js-call assert :strictEqual (js-call r "frame-depth" heap) 1)
            (js-call assert :strictEqual (js-call r "value-source-invoke-with-this" heap function receiver arguments 0) 0)
            (js-call assert :strictEqual (js-call r "last-error") 11)
            (js-call assert :strictEqual (js-call r "value-exception-take" heap) (aref entry 1)))))
        ;; Runtime-generated TypeError uses the raw error code plus exception
        ;; class, whereas explicit source throw uses code11/pending payload.
        ;; The compiler-only ABI must reproduce the existing raw ABI in both
        ;; argument-priority and noncallable cases, without assuming a throw.
        (js-call (js-array 1 0) :forEach (lambda (count)
          (js-call r "value-exception-clear" heap)
          (let* ((expected (js-call r "value-source-invoke-with-this" heap 1 receiver arguments count))
                 (error (js-call r "last-error"))
                 (kind (js-call r "value-exception-class" heap))
                 (pending (js-call r "value-exception-pending" heap)))
            (js-call r "value-exception-clear" heap)
            (js-call assert :strictEqual
              (js-call r "value-source-invoke-rooted-with-this" heap 1 receiver arguments count) expected)
            (js-call assert :strictEqual (js-call r "last-error") error)
            (js-call assert :strictEqual (js-call r "value-exception-class" heap) kind)
            (js-call assert :strictEqual (js-call r "value-exception-pending" heap) pending))))
        (js-call r "value-exception-clear" heap)
        (js-call r "allocator-current-this-set" heap 3)
        (js-call r "frame-pop" heap caller)
        (allocator-property-finish f))))

  (test "function Get reads real data and accessor records without reflection objects and preserves own undefined and receivers"
    (lambda ()
      (let* ((f (allocator-property-fixture)) (r (get f :r)) (heap (get f :heap))
             (own (get f :own)) (text (get f :text))
             (function (funcall own (js-call r "allocator-described" heap 9010 0 0 0)))
             (receiver (funcall own (js-call r "value-array-new" heap 0)))
             (parent (funcall own (js-call r "value-object-new" heap 0)))
             (key (funcall text "sample")) (missing (funcall text "absent"))
             (getter (funcall own (js-call r "allocator-described" heap 9001 0 0 0))))
        (js-call r "value-object-put" heap parent key 2 2)
        (js-call r "allocator-function-parent" heap function parent)
        (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap function key receiver) 2)
        (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap function missing receiver) 3)
        (js-call r "allocator-function-data" heap function key 3)
        (js-call r "allocator-reset-descriptors")
        (let ((round 0))
          (while (< round 64)
            (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap function key receiver) 3)
            (setq round (1+ round))))
        (js-call assert :strictEqual (js-call r "allocator-descriptors") 0)
        ;; Public reflection remains a real independently allocated descriptor.
        (let ((descriptor (js-call r "value-function-own-descriptor" heap function key)))
          (js-call assert :ok (> descriptor 3))
          (js-call assert :strictEqual (js-call r "allocator-descriptors") 1))
        (js-call r "allocator-function-accessor" heap function key getter)
        (js-call r "heap-auto" heap 1)
        (js-call r "allocator-reset-callbacks")
        (js-call r "allocator-reset-descriptors")
        (js-call r "allocator-callback-compact-next")
        (js-call assert :strictEqual (uint32 (js-call r "value-source-get-with-receiver" heap function key receiver)) receiver)
        (js-call assert :strictEqual (js-call r "allocator-callback-count") 1)
        (js-call assert :strictEqual (uint32 (js-call r "allocator-callback-receiver")) receiver)
        (js-call assert :strictEqual (js-call r "value-function-current-this" heap) 3)
        (js-call assert :strictEqual (js-call r "allocator-descriptors") 0)
        (js-call r "allocator-function-accessor" heap function key 3)
        (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap function key receiver) 3)
        (js-call (js-array (js-array 9002 1) (js-array 9003 3)) :forEach (lambda (entry)
          (let ((thrower (funcall own (js-call r "allocator-described" heap (aref entry 0) 0 0 0))))
            (js-call r "allocator-function-accessor" heap function key thrower)
            (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap function key receiver) 0)
            (js-call assert :strictEqual (js-call r "last-error") 11)
            (js-call assert :strictEqual (js-call r "value-exception-take" heap) (aref entry 1))
            (js-call assert :strictEqual (js-call r "value-function-current-this" heap) 3))))
        (let* ((bare (funcall own (js-call r "value-function-new" heap 9011 0)))
               (symbol (funcall own (js-call r "value-symbol-well-known" heap 0))))
          (js-call assert :strictEqual (js-call r "value-function-own-descriptor" heap bare symbol) 3)
          (js-call assert :strictEqual (js-call r "last-error") 0)
          (js-call assert :strictEqual (js-call r "value-function-description-state" heap bare 0) 0)
          ;; The own Symbol query stays lazy; a full Get still needs the
          ;; unavailable bare-function prototype and retains that refusal.
          (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap bare symbol receiver) 0)
          (js-call assert :strictEqual (js-call r "last-error") 3)
          (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap bare key receiver) 0)
          (js-call assert :strictEqual (js-call r "last-error") 3))
        (allocator-property-finish f))))

  (test "captured intrinsic iterator next bypasses result boxing after prototype replacement and keeps entries and moving GC"
    (lambda ()
      (let* ((f (allocator-property-fixture)) (r (get f :r)) (heap (get f :heap)) (own (get f :own))
             (registry (allocator-iterator-registry f undefined))
             (method (uint32 (js-call r "value-get" heap (get registry :methods) 1)))
             (prototype (uint32 (js-call r "value-get" heap (get registry :record) 1)))
             (array (funcall own (js-call r "value-array-new" heap 2)))
             (child (funcall own (js-call r "value-array-new" heap 0)))
             (raw (funcall own (js-call r "value-source-iterator-new" heap array 2)))
             (record (funcall own (js-call r "allocator-protocol-record" heap raw)))
             (next-key (funcall (get f :text) "next"))
             (replacement (funcall own (js-call r "allocator-described" heap 9002 0 0 0))))
        (js-call r "value-set" heap array 0 child) (js-call r "value-set" heap array 1 3)
        (js-call assert :strictEqual (uint32 (js-call r "allocator-iterator-method" heap record)) method)
        (js-call assert :strictEqual (uint32 (js-call r "allocator-protocol-native" heap record method)) raw)
        (js-call r "value-object-put" heap prototype next-key replacement 2)
        (js-call r "heap-auto" heap 1) (js-call r "heap-collect" heap) (js-call r "allocator-compact" heap)
        (js-call r "allocator-reset-callbacks")
        (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap record) 1)
        (js-call assert :strictEqual (uint32 (js-call r "allocator-iterator-item" heap record)) child)
        (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap record) 1)
        (js-call assert :strictEqual (js-call r "allocator-iterator-item" heap record) 3)
        (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap record) 0)
        (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap record) 0)
        (js-call assert :strictEqual (js-call r "last-error") 0)
        (js-call assert :strictEqual (js-call r "allocator-callback-count") 0)
        (js-call assert :strictEqual (js-call r "allocator-next-count") 0)
        (js-call assert :strictEqual (js-call r "allocator-object-count") 0)
        ;; New acquisition observes the replaced method, old records do not.
        (let* ((later (funcall own (js-call r "value-source-iterator-new" heap array 2)))
               (changed (funcall own (js-call r "allocator-protocol-record" heap later))))
          (js-call assert :strictEqual (js-call r "allocator-protocol-native" heap changed replacement) 0)
          (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap changed) 0)
          (js-call assert :strictEqual (js-call r "last-error") 11)
          (js-call assert :strictEqual (js-call r "value-exception-take" heap) 1))
        (js-call r "value-object-put" heap prototype next-key method 2)
        (let* ((entries (funcall own (js-call r "value-source-iterator-new" heap array 0)))
               (wrapped (funcall own (js-call r "allocator-protocol-record" heap entries))))
          (js-call r "allocator-reset-callbacks")
          (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap wrapped) 1)
          (let ((pair (js-call r "allocator-iterator-item" heap wrapped)))
            (js-call assert :strictEqual (js-call r "value-length" heap pair) 2)
            (js-call assert :strictEqual (uint32 (js-call r "value-get" heap pair 1)) child))
          (js-call assert :strictEqual (js-call r "value-source-iterator-skip" heap wrapped) 1)
          (js-call assert :strictEqual (js-call r "allocator-iterator-item" heap wrapped) 3)
          (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap wrapped) 0)
          (js-call assert :strictEqual (js-call r "allocator-next-count") 0))
        (allocator-property-finish f))))

  (test "iterator registry alone cannot authorize bypass and custom skip preserves captured calls value laziness and first error on close"
    (lambda ()
      (let* ((f (allocator-property-fixture)) (r (get f :r)) (heap (get f :heap)) (own (get f :own)) (text (get f :text))
             (custom (funcall own (js-call r "allocator-described" heap 9004 0 0 1)))
             (registry (allocator-iterator-registry f custom))
             (array (funcall own (js-call r "value-array-new" heap 1)))
             (raw (funcall own (js-call r "value-source-iterator-new" heap array 2)))
             (record (funcall own (js-call r "allocator-protocol-record" heap raw)))
             (step (funcall own (js-call r "value-object-new" heap 0)))
             (done-key (funcall text "done")) (value-key (funcall text "value"))
             (value-getter (funcall own (js-call r "allocator-described" heap 9005 0 0 0))))
        (js-call r "value-object-put" heap step done-key 1 2)
        (js-call r "value-object-define-accessor" heap step value-key value-getter 3 6)
        (js-call r "allocator-capture-set" heap custom step)
        (js-call assert :strictEqual (js-call r "allocator-protocol-native" heap record custom) 0)
        (js-call r "heap-auto" heap 1) (js-call r "allocator-reset-callbacks")
        (js-call r "allocator-callback-compact-next")
        (js-call assert :strictEqual (js-call r "value-source-iterator-skip" heap record) 1)
        (js-call assert :strictEqual (js-call r "allocator-value-reads") 0)
        (js-call assert :strictEqual (js-call r "allocator-callback-count") 1)
        (js-call assert :strictEqual (uint32 (js-call r "allocator-callback-receiver")) raw)
        (js-call assert :strictEqual (js-call r "value-function-current-this" heap) 3)
        (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap record) 0)
        (js-call assert :strictEqual (js-call r "last-error") 11)
        (js-call assert :strictEqual (js-call r "value-exception-take" heap) 1)
        (js-call assert :strictEqual (js-call r "allocator-value-reads") 1)
        ;; A matching numeric intrinsic tag on a captured source function is
        ;; insufficient, as is an unmarked zero-capture function.
        (let ((methods (get registry :methods)))
          (js-call (js-array (js-array 329 0 0) (js-array 329 1 1) (js-array 330 1 0)) :forEach (lambda (shape)
            (let ((forged (funcall own (js-call r "allocator-described" heap 9004
                           (aref shape 0) (aref shape 1) (aref shape 2)))))
              (js-call r "value-set" heap methods 1 forged)
              (js-call assert :strictEqual (js-call r "allocator-protocol-native" heap record forged) 0)))))
        ;; Close still reads return dynamically and keeps the already pending
        ;; undefined exception even though return throws false.
        (let* ((return-key (funcall text "return"))
               (thrower (funcall own (js-call r "allocator-described" heap 9002 0 0 0))))
          (js-call assert :strictEqual (js-call r "value-source-set-with-receiver" heap raw return-key thrower raw) 2)
          (js-call r "value-throw" heap 3)
          (js-call assert :strictEqual (js-call r "value-source-iterator-close" heap record 11) 0)
          (js-call assert :strictEqual (js-call r "last-error") 11)
          (js-call assert :strictEqual (js-call r "value-exception-take" heap) 3)
          (js-call assert :strictEqual (js-call r "value-function-current-this" heap) 3))
        (allocator-property-finish f))))
  (test "exact u32 decimal text allocates only its result and retains all numeric fallback boundaries"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 2048 65536 1048576))
             (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
             (cases (js-array
               (js-array 0 "0" t) (js-array -0 "0" t)
               (js-array 1 "1" t) (js-array 9 "9" t) (js-array 10 "10" t)
               (js-array 99 "99" t) (js-array 100 "100" t)
               (js-array 1048575 "1048575" t) (js-array 1048576 "1048576" t)
               (js-array 2147483647 "2147483647" t) (js-array 2147483648 "2147483648" t)
               (js-array 4294967294 "4294967294" t) (js-array 4294967295 "4294967295" t)
               (js-array -1 "-1" false) (js-array -2147483648 "-2147483648" false)
               (js-array 4294967296 "4294967296" false)
               (js-array 0.5 "0.5" false) (js-array -0.5 "-0.5" false)
               (js-array 1e-7 "1e-7" false) (js-array 1e21 "1e+21" false)
               (js-array globalThis.NaN "NaN" false)
               (js-array globalThis.Infinity "Infinity" false)
               (js-array (- globalThis.Infinity) "-Infinity" false))))
        (js-call cases :forEach (lambda (entry)
          (js-call bits :setFloat64 0 (aref entry 0) t)
          (let ((input (uint32 (js-call r "value-number" heap
                         (js-call bits :getUint32 0 t) (js-call bits :getUint32 4 t)))))
            (js-call assert :strictEqual (js-call r "heap-pin" heap input) 1)
            (js-call r "allocator-reset-number-scratch")
            (let* ((before (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap))
                   (text (uint32 (js-call r "allocator-number-text" heap input))))
              (js-call assert :strictEqual (js-call r "last-error") 0)
              (js-call assert :strictEqual (allocator-read-text r heap text) (aref entry 1))
              (js-call assert :strictEqual (js-call r "allocator-number-scratch-calls") (if (aref entry 2) 0 1))
              (when (aref entry 2)
                (js-call assert :strictEqual (- (js-call r "heap-live" heap) live) 1)
                (js-call assert :ok (<= (- (js-call r "heap-used" heap) before) 56)))
              (js-call assert :strictEqual (js-call r "heap-pin" heap text) 1)
              (let ((reference (uint32 (js-call r "allocator-number-reference" heap input))))
                (js-call assert :strictEqual (allocator-read-text r heap reference) (aref entry 1)))
              (js-call r "heap-auto" heap 1)
              (let ((collected (uint32 (js-call r "allocator-number-text" heap input))))
                (js-call assert :strictEqual (js-call r "last-error") 0)
                (js-call assert :strictEqual (allocator-read-text r heap collected) (aref entry 1)))
              (js-call r "heap-release" heap text))
            (js-call r "heap-release" heap input)
            (js-call r "heap-collect" heap)
            (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
            (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
            (js-call r "heap-auto" heap 0)))))))

  (test "well-known symbol hits use constant work and allocate nothing at a growing historical highwater"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 2048 65536 262144))
             (symbols (js-array)) (index 0))
        (while (< index 15)
          (let ((symbol (uint32 (js-call r "value-symbol-well-known" heap index))))
            (js-call assert :ok (> symbol 3))
            (js-call assert :strictEqual (js-call r "heap-pin" heap symbol) 1)
            (js-call symbols :push symbol))
          (setq index (1+ index)))
        (setq index 0)
        (while (< index 1024)
          (js-call assert :ok (> (js-call r "value-bytes" heap 0) 3))
          (setq index (1+ index)))
        (let ((used (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap))
              (collections (js-call r "heap-collections" heap)) (round 0))
          (js-call r "allocator-reset-symbol-scans")
          (js-call r "heap-auto" heap 1)
          (while (< round 64)
            (setq index 0)
            (while (< index 15)
              (js-call assert :strictEqual (uint32 (js-call r "value-symbol-well-known" heap index)) (aref symbols index))
              (js-call assert :strictEqual (js-call r "last-error") 0)
              (setq index (1+ index)))
            (setq round (1+ round)))
          (js-call assert :strictEqual (js-call r "allocator-symbol-scans") 0)
          (js-call assert :strictEqual (js-call r "heap-used" heap) used)
          (js-call assert :strictEqual (js-call r "heap-live" heap) live)
          (js-call assert :strictEqual (js-call r "heap-collections" heap) collections))
        (js-call symbols :forEach (lambda (symbol) (js-call r "heap-release" heap symbol)))
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))

  (test "well-known symbol weak indexes validate expired generations and recover incorrect entries without changing canonical identity"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 128 8192 65536))
             (first (uint32 (js-call r "value-symbol-well-known" heap 0))))
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (let* ((second (uint32 (js-call r "value-symbol-well-known" heap 0)))
               (other (uint32 (js-call r "value-symbol-well-known" heap 1)))
               (bytes (uint32 (js-call r "value-bytes" heap 0))))
          (js-call assert :notStrictEqual first second)
          (js-call assert :strictEqual (js-call r "heap-pin" heap second) 1)
          (js-call assert :strictEqual (js-call r "heap-pin" heap other) 1)
          (js-call assert :strictEqual (js-call r "heap-pin" heap bytes) 1)
          (js-call (js-array first other bytes 3 4294967295) :forEach (lambda (bad)
            (js-call r "allocator-symbol-cache-set" heap 0 bad)
            (js-call assert :strictEqual (uint32 (js-call r "value-symbol-well-known" heap 0)) second)
            (js-call assert :strictEqual (js-call r "last-error") 0)))
          (js-call assert :strictEqual (js-call r "value-symbol-well-known" heap 15) 0)
          (js-call assert :strictEqual (js-call r "last-error") 3)
          (js-call (js-array second other bytes) :forEach (lambda (value) (js-call r "heap-release" heap value)))
          (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))))

  (test "well-known symbol indexes remain heap-local across extended layouts and collection with automatic safepoints"
    (lambda ()
      (let* ((r (fresh)) (a (js-call r "heap-new" 128 8192 65536))
             (b (js-call r "allocator-layout" 128 8192 65536 23)) (index 0))
        (js-call (js-array a b) :forEach (lambda (heap)
          (js-call assert :ok (> heap 0))
          (js-call r "heap-auto" heap 1)
          (setq index 0)
          (while (< index 15)
            (let ((symbol (uint32 (js-call r "value-symbol-well-known" heap index))))
              (js-call assert :ok (> symbol 3))
              (js-call assert :strictEqual (js-call r "heap-pin" heap symbol) 1)
              (js-call r "heap-collect" heap)
              (js-call r "allocator-reset-symbol-scans")
              (js-call assert :strictEqual (uint32 (js-call r "value-symbol-well-known" heap index)) symbol)
              (js-call assert :strictEqual (js-call r "allocator-symbol-scans") 0)
              (js-call assert :strictEqual (js-call r "heap-release" heap symbol) 1)
              (js-call r "heap-collect" heap)
              (js-call assert :strictEqual (js-call r "heap-live" heap) 0))
            (setq index (1+ index)))
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))))

  (test "own array Get reads current slots length and undefined without constructing public descriptors"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 256 16384 262144)) (roots (js-array))
             (own (lambda (raw)
               (js-call assert :ok (> raw 3)) (js-call assert :strictEqual (js-call r "heap-pin" heap raw) 1)
               (js-call roots :push raw) raw))
             (text (lambda (value)
               (let ((raw (funcall own (js-call r "value-string" heap (js-length value)))) (index 0))
                 (while (< index (js-length value))
                   (js-call assert :strictEqual (js-call r "value-unit-set" heap raw index (js-call value :charCodeAt index)) 1)
                   (setq index (1+ index)))
                 (js-call assert :strictEqual (js-call r "value-seal" heap raw) raw) raw))))
        (js-call r "heap-auto" heap 1)
        (let* ((array (funcall own (js-call r "value-array-new" heap 2)))
               (zero (funcall own (js-call r "value-number" heap 0 2147483648)))
               (first (funcall text "0")) (second (funcall text "1")) (length (funcall text "length"))
               (index 0))
          (js-call assert :strictEqual (js-call r "value-set" heap array 0 zero) 1)
          (js-call assert :strictEqual (js-call r "value-set" heap array 1 3) 1)
          (js-call r "allocator-reset-descriptors")
          (while (< index 64)
            (js-call assert :strictEqual (uint32 (js-call r "value-source-get-with-receiver" heap array first array)) (uint32 zero))
            (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap array second array) 3)
            (let ((size (js-call r "value-source-get-with-receiver" heap array length array)))
              (js-call assert :strictEqual (js-call r "last-error") 0)
              (js-call assert :strictEqual (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getFloat64
                (js-call r "value-data" heap size 4) t) 2))
            (setq index (1+ index)))
          (js-call assert :strictEqual (js-call r "allocator-descriptors") 0)
          ;; Public reflection still creates the real descriptor; it is never
          ;; replaced by the allocation-free Get path or a synthetic answer.
          (let ((descriptor (js-call r "value-source-own-descriptor" heap array first)))
            (js-call assert :ok (> descriptor 3))
            (js-call assert :strictEqual (js-call r "last-error") 0)
            (js-call assert :strictEqual (js-call r "allocator-descriptors") 1))
          (js-call roots :forEach (lambda (raw) (js-call r "heap-release" heap raw)))
          (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))))

  (test "ordinary internal Array indices read and replace actual slots without temporary roots keys or collection"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 256 16384 262144))
             (array (uint32 (js-call r "value-array-new" heap 3)))
             (index (uint32 (js-call r "value-number" heap 0 1072693248)))
             (child (uint32 (js-call r "value-array-new" heap 0))))
        (js-call (js-array array index child) :forEach (lambda (raw) (js-call r "heap-pin" heap raw)))
        (js-call r "value-set" heap array 0 0)
        (js-call r "value-set" heap array 1 1)
        (js-call r "value-set" heap array 2 3)
        (js-call r "heap-auto" heap 1)
        (let ((used (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap))
              (collections (js-call r "heap-collections" heap)) (round 0))
          (while (< round 64)
            (js-call assert :strictEqual (js-call r "allocator-array-word" heap array 0 0 0) 0)
            (js-call assert :strictEqual (js-call r "allocator-array-index" heap array index 0 0) 1)
            (js-call assert :strictEqual (js-call r "allocator-array-word" heap array 2 0 0) 3)
            (js-call assert :strictEqual (js-call r "allocator-array-index" heap array index 1 0) 2)
            (js-call assert :strictEqual (js-call r "allocator-array-word" heap array 2 2 child) 2)
            (js-call assert :strictEqual (uint32 (js-call r "allocator-array-word" heap array 2 0 0)) child)
            (js-call assert :strictEqual (js-call r "allocator-array-word" heap array 2 3 0) 2)
            (js-call assert :strictEqual (js-call r "allocator-array-direct" heap array 2 0 0) 4)
            (js-call assert :strictEqual (js-call r "allocator-array-direct" heap array 3 0 0) 4)
            (js-call assert :strictEqual (js-call r "allocator-array-direct" heap array 4294967295 0 0) 4)
            (js-call assert :strictEqual (js-call r "allocator-array-word" heap array 2 4 3) 2)
            (js-call assert :strictEqual (js-call r "last-error") 0)
            (setq round (1+ round)))
          (js-call assert :strictEqual (js-call r "heap-used" heap) used)
          (js-call assert :strictEqual (js-call r "heap-live" heap) live)
          (js-call assert :strictEqual (js-call r "heap-collections" heap) collections)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))
        (js-call r "allocator-array-word" heap array 2 2 child)
        (js-call r "heap-release" heap child)
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "value-length" heap child) 0)
        (js-call assert :strictEqual (js-call r "last-error") 0)
        (js-call assert :strictEqual (uint32 (js-call r "allocator-array-word" heap array 2 0 0)) child)
        (js-call r "heap-release" heap index)
        (js-call r "heap-release" heap array)
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))

  (test "fresh foreign tokens avoid slot scans while duplicates unordered tokens and collected generations keep canonical identity"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 1024 65536 262144))
             (values (js-array)) (index 0))
        (while (< index 512)
          (js-call assert :ok (> (js-call r "value-bytes" heap 0) 3))
          (setq index (1+ index)))
        (js-call r "allocator-reset-foreign-scans")
        (setq index 1)
        (while (<= index 64)
          (let ((raw (uint32 (js-call r "value-foreign-new" heap index (% index 2)))))
            (js-call assert :ok (> raw 3))
            (js-call assert :strictEqual (uint32 (js-call r "value-foreign-token" heap raw)) index)
            (js-call r "heap-pin" heap raw) (js-call values :push raw))
          (setq index (1+ index)))
        (js-call assert :strictEqual (js-call r "allocator-foreign-scans") 0)
        (js-call assert :strictEqual (control r heap 294) 64)
        (js-call (js-array 2147483648 4294967295) :forEach (lambda (token)
          (js-call r "allocator-reset-foreign-scans")
          (let ((raw (uint32 (js-call r "value-foreign-new" heap token 1))))
            (js-call assert :ok (> raw 3))
            (js-call r "heap-pin" heap raw) (js-call values :push raw)
            (js-call assert :strictEqual (uint32 (js-call r "value-foreign-token" heap raw)) token))
          (js-call assert :strictEqual (js-call r "allocator-foreign-scans") 0)))
        (js-call assert :strictEqual (uint32 (control r heap 294)) 4294967295)
        ;; Existing token/subtype identity remains authoritative, including
        ;; callers presenting an unordered or differently classified token.
        (js-call assert :strictEqual (uint32 (js-call r "value-foreign-new" heap 3 0)) (aref values 2))
        (js-call assert :strictEqual (js-call r "value-foreign-subtype" heap (aref values 2)) 1)
        (let ((stale (aref values 1)))
          (js-call r "heap-release" heap stale)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 513)
          (js-call assert :strictEqual (js-call r "value-kind" heap stale) 0)
          (js-call assert :strictEqual (js-call r "last-error") 1)
          (let ((replacement (uint32 (js-call r "value-foreign-new" heap 2 1))))
            (js-call assert :ok (> replacement 3))
            (js-call assert :notStrictEqual replacement stale)
            (js-call assert :strictEqual (js-call r "value-foreign-token" heap replacement) 2)
            (js-call assert :strictEqual (js-call r "value-foreign-subtype" heap replacement) 1)
            (js-call assert :strictEqual (uint32 (js-call r "value-foreign-new" heap 2 0)) replacement)
            (js-call r "heap-pin" heap replacement) (put values 1 replacement)))
        (js-call assert :strictEqual (js-call r "allocator-compact" heap) 1)
        (js-call assert :strictEqual (uint32 (js-call r "value-foreign-new" heap 4294967295 0)) (aref values 65))
        (js-call values :forEach (lambda (raw) (js-call r "heap-release" heap raw)))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 66)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))

  (test "foreign token watermark commits only successful allocations and remains private to each heap lifetime"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 2 4096 32768))
             (a (uint32 (js-call r "value-foreign-new" heap 1 0)))
             (b (uint32 (js-call r "value-foreign-new" heap 2 1))))
        (js-call r "heap-pin" heap a) (js-call r "heap-pin" heap b)
        (js-call assert :strictEqual (js-call r "value-foreign-new" heap 3 0) 0)
        (js-call assert :strictEqual (js-call r "last-error") 2)
        (js-call assert :strictEqual (control r heap 294) 2)
        (js-call assert :strictEqual (uint32 (js-call r "value-foreign-new" heap 2 0)) b)
        (js-call r "heap-release" heap a)
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
        (js-call r "allocator-reset-foreign-scans")
        (let ((c (uint32 (js-call r "value-foreign-new" heap 3 0))))
          (js-call assert :ok (> c 3))
          (js-call assert :notStrictEqual c a)
          (js-call r "heap-pin" heap c)
          (js-call assert :strictEqual (js-call r "allocator-foreign-scans") 0)
          (js-call assert :strictEqual (control r heap 294) 3)
          (js-call (js-array (js-array 0 0) (js-array 4 2)) :forEach (lambda (bad)
            (js-call assert :strictEqual (js-call r "value-foreign-new" heap (aref bad 0) (aref bad 1)) 0)
            (js-call assert :strictEqual (js-call r "last-error") 3)
            (js-call assert :strictEqual (control r heap 294) 3)))
          (let* ((other (js-call r "heap-new" 2 4096 32768))
                 (value (uint32 (js-call r "value-foreign-new" other 1 1))))
            (js-call assert :ok (> value 3))
            (js-call assert :strictEqual (control r other 294) 1)
            (js-call assert :strictEqual (control r heap 294) 3))
          (js-call r "heap-release" heap b) (js-call r "heap-release" heap c)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 2)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call r "retire")
          (js-call assert :strictEqual (js-call r "value-foreign-new" heap 4 0) 0)
          (js-call assert :strictEqual (js-call r "last-error") 1)
          (let ((next (js-call r "heap-new" 2 4096 32768)))
            (js-call assert :strictEqual (control r next 294) 0))))))
  (defun free-slot-queue (r heap)
    (let ((seen (new globalThis.Set)) (result (js-array)) (slot (control r heap 4)) (last 0))
      (while (/= slot 0)
        (js-call assert :ok (and (> slot 0) (<= slot (control r heap 3))))
        (js-call assert :strictEqual (js-call seen :has slot) false)
        (js-call seen :add slot) (js-call result :push slot)
        (js-call assert :strictEqual (word r heap (+ (* slot 24) 4)) 0)
        (js-call assert :ok (< (word r heap (* slot 24)) (control r heap 293)))
        (setq last slot slot (word r heap (+ (* slot 24) 20))))
      (js-call assert :strictEqual (control r heap 290) last) result))
  (defun retired-slots (r heap)
    (let ((slot 1) (retired 0))
      (while (<= slot (control r heap 3))
        (when (and (= (word r heap (* slot 24)) 4095)
                   (= (word r heap (+ (* slot 24) 4)) 0))
          (setq retired (1+ retired)))
        (setq slot (1+ slot))) retired))

  (test "free slots append newly dead generations after older idle slots and survive growth and failure"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 8 4096 32768)) (values (js-array)) (index 0))
        (while (< index 8)
          (let ((value (js-call r "value-bytes" heap 0)))
            (js-call assert :ok (> value 3)) (js-call values :push value))
          (setq index (1+ index)))
        (js-call r "heap-pin" heap (aref values 1)) (js-call r "heap-pin" heap (aref values 4))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 6)
        (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 1 3 4 6 7 8))
        (let ((reused (js-call r "value-bytes" heap 0)))
          (js-call assert :strictEqual (bit-and reused 1048575) 1)
          (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 3 4 6 7 8))
          (let ((used (js-call r "heap-used" heap)))
            (js-call assert :strictEqual (js-call r "value-bytes" heap 65536) 0)
            (js-call assert :strictEqual (js-call r "last-error") 2)
            (js-call assert :strictEqual (js-call r "heap-used" heap) used)
            (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 3 4 6 7 8)))
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 3 4 6 7 8 1))
          (let* ((base (js-call r "allocator-base" heap)) (large (js-call r "value-bytes" heap 10000)))
            (js-call assert :ok (> large 3))
            (js-call assert :strictEqual (bit-and large 1048575) 3)
            (js-call assert :notStrictEqual (js-call r "allocator-base" heap) base)
            (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 4 6 7 8 1))
            (js-call assert :strictEqual (js-call r "value-kind" heap reused) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)))
        (js-call r "heap-release" heap (aref values 1)) (js-call r "heap-release" heap (aref values 4))
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
        (js-call assert :strictEqual (js-length (free-slot-queue r heap)) 8))))

  (defun churn-slots (module expected-retired expected-capacity)
    (let* ((r (get (new globalThis.WebAssembly.Instance module) :exports))
           (heap (js-call r "heap-new" 32 4096 8192)) (frame (js-call r "frame-new" heap 32))
           (zero (js-call r "value-number" heap 0 2147483648)) (seeds (js-array)) (index 0))
      (js-call r "frame-set" heap frame 0 zero)
      (while (< index 16)
        (let ((value (js-call r "value-bytes" heap 0)))
          (js-call assert :ok (> value 3)) (js-call seeds :push value))
        (setq index (1+ index)))
      (js-call assert :strictEqual (js-call r "heap-collect" heap) 16)
      (setq index 0)
      (while (< index 4096)
        ;; Raw WASM exposes i32 as signed JS Numbers after generation 2047.
        (js-call assert :ok (> (uint32 (js-call r "value-bytes" heap 0)) 3))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
        (setq index (1+ index)))
      (js-call assert :strictEqual (retired-slots r heap) expected-retired)
      (js-call assert :strictEqual (js-call r "heap-live" heap) 2)
      (js-call assert :strictEqual (js-call r "frame-get" heap frame 0) zero)
      (js-call assert :strictEqual (word r heap (+ (js-call r "allocator-offset" heap zero) 36)) 2147483648)
      (js-call assert :strictEqual (js-call r "value-kind" heap (aref seeds 15)) 0)
      (js-call assert :strictEqual (js-call r "last-error") 1)
      (setq index 0)
      (while (< index 30)
        (let ((value (js-call r "value-bytes" heap 0)) (error (js-call r "last-error")))
          (if (< index expected-capacity)
            (progn (js-call assert :ok (> value 3)) (js-call assert :strictEqual error 0)
              (js-call r "frame-set" heap frame (1+ index) value))
            (progn (js-call assert :strictEqual value 0) (js-call assert :strictEqual error 2))))
        (setq index (1+ index)))
      (js-call assert :strictEqual (js-call r "heap-live" heap) (+ 2 expected-capacity))
      (js-call assert :strictEqual (js-call r "frame-depth" heap) 1)
      (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
      (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
      (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))

  (test "FIFO preserves the full live slot capacity after temporary churn that retires a LIFO hotspot"
    (lambda ()
      ;; Identical 32 slots/bytes/input/GC schedule. The former LIFO policy
      ;; loses one slot despite fifteen older idle seed slots. FIFO rotates
      ;; these generations and still admits the original full live peak.
      (churn-slots lifo-image 1 29)
      (churn-slots image 0 30)) 30000)

  (test "a sole reusable slot still retires permanently at generation 4095 without ABA"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 1 4096 8192)) (first 0) (last 0) (index 0))
        (while (< index 4095)
          (setq last (uint32 (js-call r "value-bytes" heap 0)))
          (when (= index 0) (setq first last))
          (js-call assert :strictEqual (unsigned-bit-shift-right last 20) (1+ index))
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          (setq index (1+ index)))
        (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array))
        (js-call assert :strictEqual (js-call r "value-bytes" heap 0) 0)
        (js-call assert :strictEqual (js-call r "last-error") 2)
        (js-call assert :strictEqual (js-call r "value-kind" heap first) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (js-call assert :strictEqual (js-call r "value-kind" heap last) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))) 30000)

  (defun extended-fresh ()
    (get (new globalThis.WebAssembly.Instance extended-image) :exports))

  (test "extended layouts spend fresh slots before FIFO reuse without changing the legacy policy"
    (lambda ()
      (js-call (js-array 20 21 22 23) :forEach (lambda (bits)
        (let* ((r (fresh))
               (heap (if (= bits 20) (js-call r "heap-new" 4 4096 8192)
                       (js-call r "allocator-layout" 4 4096 8192 bits)))
               (mask (control r heap 292)) (first (uint32 (js-call r "value-bytes" heap 0))))
          (js-call assert :strictEqual (unsigned-bit-shift-right first bits) 1)
          (js-call assert :strictEqual (bit-and first mask) 1)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          ;; A byte-capacity failure must not consume a fresh slot or unlink
          ;; the older reusable entry before its allocation actually succeeds.
          (let ((used (js-call r "heap-used" heap)))
            (js-call assert :strictEqual (js-call r "value-bytes" heap 65536) 0)
            (js-call assert :strictEqual (js-call r "last-error") 2)
            (js-call assert :strictEqual (js-call r "heap-used" heap) used)
            (js-call assert :strictEqual (control r heap 3) 1)
            (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 1)))
          (if (= bits 20)
            (let ((again (uint32 (js-call r "value-bytes" heap 0))))
              (js-call assert :strictEqual (bit-and again mask) 1)
              (js-call assert :strictEqual (unsigned-bit-shift-right again bits) 2)
              (js-call assert :strictEqual (control r heap 3) 1)
              (js-call assert :strictEqual (js-call r "heap-collect" heap) 1))
            (let ((slot 2) (queue (js-array 1)))
              (while (<= slot 4)
                (let ((value (uint32 (js-call r "value-bytes" heap 0))))
                  (js-call assert :strictEqual (bit-and value mask) slot)
                  (js-call assert :strictEqual (unsigned-bit-shift-right value bits) 1)
                  (js-call assert :strictEqual (control r heap 3) slot)
                  (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
                  (js-call queue :push slot)
                  (js-call assert :deepStrictEqual (free-slot-queue r heap) queue))
                (setq slot (1+ slot)))
              ;; Once all slots have been used, the original FIFO order and
              ;; generation increment apply, rather than early retirement.
              (setq slot 1)
              (while (<= slot 4)
                (let ((value (uint32 (js-call r "value-bytes" heap 0))))
                  (js-call assert :strictEqual (bit-and value mask) slot)
                  (js-call assert :strictEqual (unsigned-bit-shift-right value bits) 2)
                  (js-call assert :strictEqual (js-call r "heap-collect" heap) 1))
                (setq slot (1+ slot)))
              (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 1 2 3 4))
              (let ((held (js-array)))
                (setq slot 1)
                (while (<= slot 4)
                  (let ((value (uint32 (js-call r "value-bytes" heap 0))))
                    (js-call assert :strictEqual (bit-and value mask) slot)
                    (js-call assert :strictEqual (unsigned-bit-shift-right value bits) 3)
                    (js-call r "heap-pin" heap value) (js-call held :push value))
                  (setq slot (1+ slot)))
                (js-call assert :strictEqual (js-call r "value-bytes" heap 0) 0)
                (js-call assert :strictEqual (js-call r "last-error") 2)
                (js-call assert :strictEqual (js-call r "heap-live" heap) 4)
                (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
                (let ((stale (aref held 0)))
                  (js-call r "heap-release" heap stale)
                  (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
                  (let ((recovered (uint32 (js-call r "value-bytes" heap 0))))
                    (js-call assert :strictEqual (bit-and recovered mask) 1)
                    (js-call assert :strictEqual (unsigned-bit-shift-right recovered bits) 4)
                    (js-call assert :notStrictEqual recovered stale)
                    (js-call assert :strictEqual (js-call r "value-kind" heap stale) 0)
                    (js-call assert :strictEqual (js-call r "last-error") 1)
                    (js-call assert :strictEqual (js-call r "value-kind" heap recovered) 6)))
                (js-call (js-call held :slice 1) :forEach (lambda (value) (js-call r "heap-release" heap value)))
                (js-call assert :strictEqual (js-call r "heap-collect" heap) 4))))
          (js-call assert :strictEqual (js-call r "value-kind" heap first) 0)
          (js-call assert :strictEqual (js-call r "last-error") 1)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))))

  (test "extended heap is explicit and preserves the old constructor and single-object limits"
    (lambda ()
      (let ((r (extended-fresh)))
        (js-call (js-array
                  (js-array 1048576 33554432 67108864)
                  (js-array 8 4096 268435457)) :forEach (lambda (parameters)
          (js-call assert :strictEqual
            (js-call r "heap-new" (aref parameters 0) (aref parameters 1) (aref parameters 2)) 0)
          (js-call assert :strictEqual (js-call r "last-error") 3)))
        (js-call (js-array
                  (js-array 0 4096 8192)
                  (js-array 8388608 268435456 536870912)
                  (js-array 8 4096 1073741825)
                  (js-array 8 4096 2048)
                  (js-array 8 128 8192)) :forEach (lambda (parameters)
          (js-call assert :strictEqual
            (js-call r "heap-new-extended" (aref parameters 0) (aref parameters 1) (aref parameters 2)) 0)
          (js-call assert :strictEqual (js-call r "last-error") 3)))
        (let ((ordinary (js-call r "heap-new" 8 4096 8192))
              (extended (js-call r "heap-new-extended" 8 4096 1073741824)))
          (js-call (js-array ordinary extended) :forEach (lambda (heap)
            (js-call assert :ok (> heap 0))
            (js-call assert :strictEqual (control r heap 291) 20)
            (js-call assert :strictEqual (uint32 (control r heap 292)) 1048575)
            (js-call assert :strictEqual (control r heap 293) 4095)
            (let ((value (uint32 (js-call r "value-bytes" heap 0)))
                  (used (js-call r "heap-used" heap)))
              (js-call assert :strictEqual value 1048577)
              (js-call assert :strictEqual (js-call r "value-bytes" heap 268435417) 0)
              (js-call assert :strictEqual (js-call r "last-error") 2)
              (js-call assert :strictEqual (js-call r "heap-used" heap) used)
              (js-call assert :strictEqual (js-call r "value-kind" heap value) 6)
              (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
              (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
              (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))
          (js-call assert :strictEqual (control r ordinary 8) 8192)
          (js-call assert :strictEqual (control r extended 8) 1073741824)
          (js-call r "retire")
          (js-call assert :strictEqual (js-call r "heap-live" extended) 0)
          (js-call assert :strictEqual (js-call r "last-error") 1)
          (let ((next (js-call r "heap-new-extended" 8 4096 8192)))
            (js-call assert :ok (> (js-call r "value-bytes" next 0) 3))
            (js-call assert :strictEqual (js-call r "heap-collect" next) 1)
            (js-call assert :strictEqual (js-call r "heap-live" next) 0))))))

  (test "extended generation widths retire without wrap and preserve weak named identities"
    (lambda ()
      (js-call (js-array (js-array 1048576 33554432 21 2047)
                         (js-array 2097152 67108864 22 1023)
                         (js-array 4194304 134217728 23 511)) :forEach (lambda (profile)
        (let* ((r (extended-fresh))
               (public-heap (js-call r "heap-new-extended" (aref profile 0) (aref profile 1) 134217728))
               (bits (aref profile 2)) (maximum (aref profile 3))
               ;; The real public layouts retain their width boundaries. A
               ;; sole-slot instance of that same implementation then reaches
               ;; retirement without relying on an early-reuse policy.
               (heap (js-call r "allocator-layout" 1 4096 8192 bits))
               (first 0) (last 0) (index 0))
          (js-call assert :ok (> public-heap 0))
          (js-call assert :strictEqual (control r public-heap 2) (aref profile 0))
          (js-call assert :strictEqual (control r public-heap 291) bits)
          (js-call assert :strictEqual (control r public-heap 293) maximum)
          (js-call assert :ok (> heap 0))
          (js-call assert :strictEqual (control r heap 291) bits)
          (js-call assert :strictEqual (control r heap 293) maximum)
          (while (< index maximum)
            (setq last (uint32 (js-call r "value-bytes" heap 0)))
            (when (= index 0) (setq first last))
            (js-call assert :strictEqual (unsigned-bit-shift-right last bits) (1+ index))
            (js-call assert :strictEqual (bit-and last (control r heap 292)) 1)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
            (setq index (1+ index)))
          (js-call assert :strictEqual (word r heap 24) maximum)
          (js-call assert :strictEqual (word r heap 28) 0)
          (js-call assert :strictEqual (control r heap 4) 0)
          (js-call assert :strictEqual (control r heap 290) 0)
          (js-call assert :strictEqual (js-call r "value-bytes" heap 0) 0)
          (js-call assert :strictEqual (js-call r "last-error") 2)
          (js-call (js-array first last) :forEach (lambda (stale)
            (js-call assert :strictEqual (js-call r "value-kind" heap stale) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)))
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
          ;; Reserve slot one, so weak named identity/reuse exercises slot two
          ;; after fresh capacity is exhausted, independently of retirement.
          (setq heap (js-call r "allocator-layout" 2 4096 8192 bits))
          (let* ((blocker (js-call r "value-bytes" heap 0))
                 (pin (js-call r "heap-pin" heap blocker))
                 (named (uint32 (js-call r "value-function-named" heap 4294967295))))
            (js-call assert :strictEqual (unsigned-bit-shift-right named bits) 1)
            (js-call assert :strictEqual (bit-and named (control r heap 292)) 2)
            (js-call r "heap-pin" heap named)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
            (js-call assert :strictEqual (js-call r "allocator-compact" heap) 1)
            (js-call r "allocator-reset-named-scans")
            (js-call assert :strictEqual
              (uint32 (js-call r "value-function-named" heap 4294967295)) named)
            (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
            (js-call assert :strictEqual (uint32 (js-call r "value-function-code" heap named)) 4294967295)
            (js-call r "heap-release" heap named)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
            (js-call assert :strictEqual (js-call r "value-kind" heap named) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)
            (let ((again (uint32 (js-call r "value-function-named" heap 4294967295))))
              (js-call assert :notStrictEqual again named)
              (js-call assert :strictEqual (unsigned-bit-shift-right again bits) 2)
              (js-call assert :strictEqual (bit-and again (control r heap 292)) 2))
            (js-call r "heap-release" heap blocker)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 2)
            (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
            (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))))) 30000)

  (test "23-bit opt-in allocates the complete slot table and keeps each earlier width boundary"
    (lambda ()
      (js-call (js-array (js-array 1048575 33554432 20 1048575 4095)
                         (js-array 1048576 33554432 21 2097151 2047)
                         (js-array 4194303 134217728 22 4194303 1023)
                         (js-array 4194304 134217728 23 8388607 511 268435456)
                         (js-array 8388607 201326624 23 8388607 511)
                         (js-array 8388607 268435456 23 8388607 511)) :forEach
        (lambda (profile)
          (let* ((r (extended-fresh))
                 (maximum (if (= (js-length profile) 6) (aref profile 5) 1073741824))
                 (heap (js-call r "heap-new-extended" (aref profile 0) (aref profile 1) maximum))
                 (bits (aref profile 2)) (mask (aref profile 3))
                 (value (uint32 (js-call r "value-bytes" heap 0))))
            (js-call assert :ok (> heap 0))
            (js-call assert :strictEqual (control r heap 2) (aref profile 0))
            (js-call assert :strictEqual (control r heap 291) bits)
            (js-call assert :strictEqual (uint32 (control r heap 292)) mask)
            (js-call assert :strictEqual (control r heap 293) (aref profile 4))
            (js-call assert :strictEqual (control r heap 8) maximum)
            (js-call assert :strictEqual (js-call r "heap-capacity" heap) (aref profile 1))
            (js-call assert :strictEqual (unsigned-bit-shift-right value bits) 1)
            (js-call assert :strictEqual (bit-and value mask) 1)
            (js-call assert :strictEqual (js-call r "value-kind" heap value) 6)
            (js-call assert :strictEqual (js-call r "heap-pin" heap value) 1)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
            (js-call assert :strictEqual (js-call r "heap-live" heap) 1)
            (js-call r "heap-release" heap value)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
            (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
            (js-call assert :strictEqual (js-call r "value-kind" heap value) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)
            (let ((next (uint32 (js-call r "value-bytes" heap 0))))
              (js-call assert :strictEqual (bit-and next mask) (if (= bits 20) 1 2))
              (js-call assert :strictEqual (unsigned-bit-shift-right next bits) (if (= bits 20) 2 1))
              (js-call assert :notStrictEqual next value)
              (js-call assert :strictEqual (js-call r "heap-collect" heap) 1))
            (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))))

  (test "23-bit opt-in rejects oversized tables and byte budgets before allocating a heap"
    (lambda ()
      (let ((r (extended-fresh)))
        (js-call (js-array (js-array 8388608 268435456 1073741824)
                           (js-array 8388607 201326623 1073741824)
                           (js-array 8388607 268435456 1073741825)
                           (js-array 8388607 268435456 134217728)) :forEach
          (lambda (parameters)
            (js-call assert :strictEqual
              (js-call r "heap-new-extended" (aref parameters 0) (aref parameters 1) (aref parameters 2)) 0)
            (js-call assert :strictEqual (js-call r "last-error") 3)))
        ;; The same instance is usable after each rejected constructor. The
        ;; legacy ABI still has its original twenty-bit handle and budget.
        (let* ((heap (js-call r "heap-new" 1 4096 8192))
               (value (uint32 (js-call r "value-bytes" heap 0))))
          (js-call assert :ok (> heap 0))
          (js-call assert :strictEqual (control r heap 291) 20)
          (js-call assert :strictEqual (control r heap 292) 1048575)
          (js-call assert :strictEqual (control r heap 293) 4095)
          (js-call assert :strictEqual (control r heap 8) 8192)
          (js-call assert :strictEqual value 1048577)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))))

  (test "extended heaps retain over one million real objects through growth, GC and capacity recovery"
    (lambda ()
      (let* ((r (extended-fresh)) (count 1048608)
             (heap (js-call r "heap-new-extended" (+ count 3) 33554432 134217728))
             (frame (js-call r "frame-new" heap 2))
             (roots (js-call r "value-refs" heap 7 count))
             (zero (js-call r "value-number" heap 0 2147483648))
             (base (js-call r "allocator-base" heap)))
        (js-call assert :ok (> roots 3))
        (js-call r "frame-set" heap frame 0 roots)
        (js-call r "frame-set" heap frame 1 zero)
        (js-call assert :strictEqual (js-call r "allocator-fill-refs" heap roots count) count)
        (js-call assert :strictEqual (js-call r "last-error") 0)
        (js-call assert :strictEqual (js-call r "heap-live" heap) (+ count 3))
        (js-call assert :notStrictEqual (js-call r "allocator-base" heap) base)
        (js-call assert :ok (> (js-call r "heap-capacity" heap) 33554432))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
        (js-call (js-array 0 1048574 1048575 (1- count)) :forEach (lambda (index)
          (let ((value (uint32 (js-call r "value-get" heap roots index))))
            (js-call assert :strictEqual (js-call r "value-kind" heap value) 6)
            (js-call assert :strictEqual (unsigned-bit-shift-right value 21) 1)
            (js-call assert :strictEqual (bit-and value 2097151) (+ index 4)))))
        (js-call assert :strictEqual (js-call r "value-bytes" heap 0) 0)
        (js-call assert :strictEqual (js-call r "last-error") 2)
        (js-call assert :strictEqual (js-call r "heap-live" heap) (+ count 3))
        (js-call assert :strictEqual (js-call r "frame-get" heap frame 1) zero)
        (js-call assert :strictEqual (word r heap (+ (js-call r "allocator-offset" heap zero) 36)) 2147483648)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 1)
        (let ((stale (uint32 (js-call r "value-get" heap roots (1- count)))))
          (js-call r "value-set" heap roots (1- count) 0)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          (let ((again (uint32 (js-call r "value-bytes" heap 0))))
            (js-call assert :notStrictEqual again stale)
            (js-call assert :strictEqual (unsigned-bit-shift-right again 21) 2)
            (js-call assert :strictEqual (bit-and again 2097151) (+ count 3))
            (js-call r "value-set" heap roots (1- count) again)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
            (js-call assert :strictEqual (js-call r "value-kind" heap stale) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)
            (js-call assert :strictEqual (js-call r "value-kind" heap again) 6)))
        (js-call r "frame-pop" heap frame)
        (js-call assert :strictEqual (js-call r "heap-collect" heap) (+ count 3))
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))) 120000)

  ;; This reference model knows only the original address-list rules. It has
  ;; no tree, cached maximum, rotation or representation-dependent choice.
  (defun model-allocate (model size)
    (let ((holes (get model :holes)) (index 0) (answer nil))
      (while (and (< index (js-length holes)) (nil? answer))
        (let ((block (aref holes index)))
          (when (>= (get block :size) size)
            (setq answer (js-object :offset (get block :offset) :size size))
            (if (>= (- (get block :size) size) 32)
              (put holes index (js-object :offset (+ (get block :offset) size) :size (- (get block :size) size)))
              (progn (put answer :size (get block :size)) (js-call holes :splice index 1)))))
        (setq index (1+ index)))
      (when (nil? answer)
        (let ((end (uint32 (+ (get model :cursor) size))))
          (when (and (>= end (get model :cursor)) (<= end (get model :maximum)))
            (setq answer (js-object :offset (get model :cursor) :size size))
            (put model :cursor end)))) answer))
  (defun model-free (model block)
    (let ((holes (get model :holes)) (index 1))
      (js-call holes :push (js-object :offset (get block :offset) :size (get block :size)))
      (js-call holes :sort (lambda (a b) (- (get a :offset) (get b :offset))))
      (while (< index (js-length holes))
        (let ((left (aref holes (1- index))) (right (aref holes index)))
          (if (= (+ (get left :offset) (get left :size)) (get right :offset))
            (progn (put left :size (+ (get left :size) (get right :size))) (js-call holes :splice index 1))
            (setq index (1+ index)))))
      (when (> (js-length holes) 0)
        (let ((tail (aref holes (1- (js-length holes)))))
          (when (= (+ (get tail :offset) (get tail :size)) (get model :cursor))
            (put model :cursor (get tail :offset)) (js-call holes :pop))))) 0)

  (defun tree-check (r heap node parent low high seen)
    (if (= node 0) (js-object :height 0 :maximum 0 :count 0)
      (progn
        (js-call assert :ok (and (> node low) (< node high)))
        (js-call assert :strictEqual (js-call seen :has node) false)
        (js-call seen :add node)
        (js-call assert :strictEqual (word r heap (+ node 16)) parent)
        (let* ((left (tree-check r heap (word r heap (+ node 8)) node low node seen))
               (right (tree-check r heap (word r heap (+ node 12)) node node high seen))
               (height (1+ (Math/max (get left :height) (get right :height))))
               (maximum (Math/max (word r heap node) (get left :maximum) (get right :maximum))))
          (js-call assert :ok (<= (Math/abs (- (get left :height) (get right :height))) 1))
          (js-call assert :strictEqual (word r heap (+ node 20)) height)
          (js-call assert :strictEqual (word r heap (+ node 24)) maximum)
          (js-object :height height :maximum maximum :count (+ 1 (get left :count) (get right :count)))))))
  (defun check (fixture)
    (let* ((r (get fixture :r)) (heap (get fixture :heap)) (model (get fixture :model))
           (actual (js-array)) (seen (new globalThis.Set)) (previous 0) (node (control r heap 6))
           (tree-seen (new globalThis.Set)))
      (js-call assert :strictEqual (js-call r "heap-used" heap) (get model :cursor))
      (while (/= node 0)
        (js-call assert :strictEqual (js-call seen :has node) false)
        (js-call seen :add node)
        (js-call assert :strictEqual (word r heap (+ node 28)) previous)
        (js-call actual :push (js-object :offset node :size (word r heap node)))
        (setq previous node node (word r heap (+ node 4))))
      (js-call assert :deepStrictEqual actual (get model :holes))
      (let ((summary (tree-check r heap (control r heap 33) 0 0 4294967295 tree-seen)))
        (js-call assert :strictEqual (get summary :count) (js-length actual))
        (js-call assert :deepStrictEqual tree-seen seen) summary)))
  (defun fixture (&optional supplied maximum)
    (let* ((r (or supplied (fresh))) (limit (or maximum 131072))
           (heap (js-call r "heap-new" 8 4096 limit)))
      (js-call assert :ok (> heap 3))
      (js-object :r r :heap heap :start (js-call r "heap-used" heap)
        :model (js-object :cursor (js-call r "heap-used" heap) :maximum limit :holes (js-array)))))
  (defun allocate-block (f size)
    (let* ((r (get f :r)) (heap (get f :heap)) (expected (model-allocate (get f :model) size))
           (offset (js-call r "allocator-allocate" heap size)) (error (js-call r "last-error")))
      (if (nil? expected)
        (progn (js-call assert :strictEqual offset 0) (js-call assert :strictEqual error 2))
        (progn (js-call assert :strictEqual error 0)
          (js-call assert :strictEqual offset (get expected :offset))
          (js-call assert :strictEqual (word r heap offset) (get expected :size))))
      (check f) expected))
  (defun release-block (f block)
    (let ((r (get f :r)) (height (get (check f) :height)))
      (js-call r "allocator-reset-free-visits")
      (js-call assert :strictEqual (js-call r "allocator-free" (get f :heap) (get block :offset) (get block :size)) 0)
      (js-call assert :strictEqual (js-call r "last-error") 0)
      (js-call assert :ok (<= (js-call r "allocator-free-visits") height)))
    (model-free (get f :model) block) (check f))

  (test "first-fit splits preserve the existing AVL topology without deletion or reinsertion"
    (lambda ()
      (js-call (js-array (js-array 1 0) (js-array 33 0) (js-array 33 16) (js-array 33 32)) :forEach
        (lambda (specification)
          (let* ((f (fixture)) (r (get f :r)) (heap (get f :heap))
                 (holes (js-array)) (separators (js-array)) (allocated (js-array))
                 (count (aref specification 0)) (wanted (aref specification 1)) (index 0) (offset 0))
            (while (< index count)
              (let ((block (allocate-block f (if (= index wanted) 2560 32))))
                (js-call holes :push block)
                (when (= index wanted) (setq offset (get block :offset))))
              (js-call separators :push (allocate-block f 32))
              (setq index (1+ index)))
            (js-call holes :forEach (lambda (block) (release-block f block)))
            (let ((height (get (check f) :height)))
              (js-call r "allocator-reset-tree-mutations")
              (setq index 0)
              (while (< index 20)
                (let* ((block (allocate-block f 80)) (summary (check f)))
                  ;; The independent model checks every selected address and
                  ;; size; check verifies both links, heights and subtree maxima.
                  (js-call assert :strictEqual (get block :offset) (+ offset (* index 80)))
                  (js-call assert :strictEqual (get summary :height) height)
                  (js-call assert :strictEqual (get summary :count) count)
                  (js-call assert :strictEqual (get summary :maximum) (- 2560 (* (1+ index) 80)))
                  (js-call allocated :push block))
                (setq index (1+ index)))
              (js-call assert :strictEqual (js-call r "allocator-tree-removes") 0)
              (js-call assert :strictEqual (js-call r "allocator-tree-inserts") 0))
            (js-call allocated :forEach (lambda (block) (release-block f block)))
            (js-call separators :forEach (lambda (block) (release-block f block)))
            (js-call assert :strictEqual (js-call r "heap-used" heap) (get f :start))
            (js-call assert :strictEqual (control r heap 33) 0))))))

  (test "allocator preserves original first fit through mixed sizes, rotations, splits and two-sided coalescing"
    (lambda ()
      (let ((f (fixture)) (live (js-array)) (seed 7919) (step 0))
        (while (< step 1400)
          (setq seed (% (+ (* seed 48271) 1) 2147483647))
          (if (and (> (js-length live) 0) (< (% seed 7) 3))
            (let* ((index (% seed (js-length live))) (block (aref live index)))
              (js-call live :splice index 1) (release-block f block))
            (let ((block (allocate-block f (* 8 (+ 4 (% seed 41))))))
              (when block (js-call live :push block))))
          (setq step (1+ step)))
        (while (> (js-length live) 0) (release-block f (js-call live :pop)))
        (js-call assert :strictEqual (control (get f :r) (get f :heap) 33) 0)
        (js-call assert :strictEqual (get (get f :model) :cursor) (get f :start)))))

  (test "allocator skips mixed undersized prefixes with logarithmic production search visits"
    (lambda ()
      (let ((f (fixture)) (holes (js-array)) (guards (js-array)) (index 0))
        (while (< index 384)
          (js-call holes :push (allocate-block f (* 8 (+ 4 (% index 5)))))
          (js-call guards :push (allocate-block f 32))
          (setq index (1+ index)))
        (setq index 0)
        (while (< index (js-length holes)) (release-block f (aref holes index)) (setq index (1+ index)))
        (setq index 0)
        (while (< index 96)
          (let* ((summary (check f)) (r (get f :r)) (size (+ 72 (* 8 (% index 17)))))
            (js-call r "allocator-reset-visits")
            (let ((block (allocate-block f size)))
              (js-call assert :ok (<= (js-call r "allocator-visits") (get summary :height)))
              (release-block f block)))
          (setq index (1+ index)))
        (while (> (js-length guards) 0) (release-block f (js-call guards :pop)))
        (js-call assert :strictEqual (get (get f :model) :cursor) (get f :start)))))

  (test "allocator growth, whole-block consumption and failed requests preserve the address index"
    (lambda ()
      (let* ((f (fixture nil 32768)) (r (get f :r)) (heap (get f :heap))
             (left (allocate-block f 72)) (guard (allocate-block f 32))
             (middle (allocate-block f 8000)) (tail (allocate-block f 32)))
        (release-block f left)
        ;; A 16-byte remainder must be consumed, not indexed as a new node.
        (let ((whole (allocate-block f 56)))
          (js-call assert :strictEqual (get whole :size) 72)
          (release-block f whole))
        (let ((grown (allocate-block f 16000)))
          (js-call assert :ok (> (js-call r "heap-capacity" heap) 4096))
          (release-block f middle)
          (allocate-block f 32768)
          (let ((recovered (allocate-block f 128))) (release-block f recovered))
          (release-block f grown))
        (release-block f tail) (release-block f guard)
        (js-call assert :strictEqual (control r heap 33) 0)
        (js-call assert :strictEqual (get (get f :model) :cursor) (get f :start)))))

  (test "allocator GC merge and moving compaction rebuild the index without retaining garbage"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 64 4096 32768))
             (start (js-call r "heap-used" heap)) (frame (js-call r "frame-new" heap 2))
             (a (js-call r "value-bytes" heap 96)) (b (js-call r "value-bytes" heap 160))
             (c (js-call r "value-bytes" heap 96))
             (b-offset (js-call r "allocator-offset" heap b)) (b-size (js-call r "allocator-size" heap b)))
        (js-call r "frame-set" heap frame 0 a) (js-call r "frame-set" heap frame 1 c)
        (js-call r "value-byte-set" heap a 0 17) (js-call r "value-byte-set" heap c 95 231)
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "last-error") 0)
        (js-call assert :strictEqual (control r heap 6) b-offset)
        (js-call assert :strictEqual (word r heap b-offset) b-size)
        (let ((summary (tree-check r heap (control r heap 33) 0 0 4294967295 (new globalThis.Set))))
          (js-call assert :strictEqual (get summary :count) 1))
        (let* ((offset (js-call r "allocator-allocate" heap 64)) (actual (word r heap offset)))
          (js-call assert :strictEqual offset b-offset)
          (js-call r "allocator-free" heap offset actual))
        (js-call assert :strictEqual (js-call r "allocator-compact" heap) 1)
        (js-call assert :strictEqual (control r heap 6) 0)
        (js-call assert :strictEqual (control r heap 33) 0)
        (js-call assert :strictEqual (js-call r "value-byte-get" heap a 0) 17)
        (js-call assert :strictEqual (js-call r "value-byte-get" heap c 95) 231)
        (js-call r "value-byte-get" heap b 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (let ((recovered (js-call r "value-bytes" heap 160)))
          (js-call assert :ok (> recovered 3)) (js-call assert :notStrictEqual recovered b))
        (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
        (js-call assert :strictEqual (js-call r "heap-used" heap) start)
        (js-call assert :strictEqual (control r heap 33) 0))))

  (test "allocator roots are per heap and retirement cannot expose an earlier free tree"
    (lambda ()
      (let* ((r (fresh)) (a (fixture r)) (b (fixture r))
             (hole (allocate-block a 128)) (guard (allocate-block a 32)))
        (release-block a hole)
        (js-call assert :notStrictEqual (control r (get a :heap) 33) 0)
        (js-call assert :strictEqual (control r (get b :heap) 33) 0)
        (let ((block (allocate-block b 64))) (release-block b block))
        (release-block a guard)
        (js-call r "retire")
        (js-call assert :strictEqual (js-call r "heap-used" (get a :heap)) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (let ((next (fixture r))) (check next)
          (js-call assert :strictEqual (control r (get next :heap) 33) 0)))))

  ;; Preserve the original allocator suite's exact request/address scenarios.
  ;; Only its old prefix-header and linked-scan counts are replaced by AVL
  ;; invariants and actual search bounds; capacity and lifetime checks remain.
  (test "original first-fit split consume coalesce and changed-size addresses survive AVL indexing"
    (lambda ()
      (let* ((f (fixture nil 32768)) (r (get f :r)) (heap (get f :heap))
             (holes (js-array)) (separators (js-array)) (index 0))
        (while (< index 24)
          (js-call holes :push (allocate-block f 32)) (js-call separators :push (allocate-block f 32))
          (setq index (1+ index)))
        (let ((large (allocate-block f 256)) (guard (allocate-block f 32)))
          (setq index 0)
          (while (< index (js-length holes)) (release-block f (aref holes index)) (setq index (1+ index)))
          (release-block f large)
          (let ((first (allocate-block f 80)) (second (allocate-block f 80))
                (absorbed (allocate-block f 80)) (bump (allocate-block f 80)) (small (allocate-block f 32)))
            (js-call assert :strictEqual (get first :offset) (get large :offset))
            (js-call assert :strictEqual (get second :offset) (+ (get large :offset) 80))
            (js-call assert :deepStrictEqual absorbed (js-object :offset (+ (get large :offset) 160) :size 96))
