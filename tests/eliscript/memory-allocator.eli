          (js-call assert :strictEqual (uint32 (js-call r "value-function-code" heap last)) 4294967295)
          (setq index 1)
          (while (< index 64) (js-call r "frame-set" heap frame index (v64 0)) (setq index (+ index 2)))
          (let ((occupied (js-call r "heap-live" heap)))
            (js-call r "allocator-reset-slot-visits")
            (js-call assert :ok (>= (js-call r "heap-collect" heap) 32))
            ;; Marking named functions needs no slot scan. Sweep must rebuild
            ;; the weak cache during its one occupancy traversal, rather than
            ;; rescanning every survivor after each every-allocation GC.
            (js-call assert :ok (<= (js-call r "allocator-slot-visits") (1+ occupied))))
          (js-call r "allocator-reset-named-scans")
          (setq index 0)
          (while (< index 64)
            (js-call assert :strictEqual (js-call r "value-function-named" heap (+ 255 (* index 256))) (aref functions index))
            (setq index (+ index 2)))
          (js-call assert :strictEqual (js-call r "value-function-named" heap 4294967295) last)
          (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
          (setq index 1)
          (while (< index 64)
            (js-call assert :strictEqual (js-call r "value-kind" heap (aref functions index)) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)
            (let ((replacement (js-call r "value-function-named" heap (+ 255 (* index 256)))))
              (js-call assert :ok (v64-ref-p replacement))
              (js-call assert :notStrictEqual replacement (aref functions index))
              (js-call assert :strictEqual (js-call r "last-error") 0)
              (js-call r "frame-set" heap frame index replacement))
            (setq index (+ index 2)))
          (js-call assert :strictEqual (js-call r "frame-get" heap frame 64) zero)
          (let ((offset (js-call r "allocator-offset" heap zero)))
            (js-call assert :strictEqual (word r heap (+ offset 36)) 4294410240))
          (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
          (js-call assert :notStrictEqual (js-call r "value-function-named" heap 4294967295) last)
          (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)))))

  (test "named weak cache survives small heaps, former tail-entry boundaries, failure, isolation and retirement"
    (lambda ()
      (let* ((r (fresh)) (small (js-call r "heap-new" 511 32768 131072))
             (small-frame (js-call r "frame-new" small 1)) (plain (js-call r "value-function-named" small 7)))
        (js-call r "frame-set" small small-frame 0 plain)
        (js-call assert :strictEqual (js-call r "allocator-cache-enabled" small 7) 1)
        (js-call r "allocator-reset-named-scans")
        (js-call assert :strictEqual (js-call r "value-function-named" small 7) plain)
        (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
        (let* ((heap (js-call r "heap-new" 512 32768 131072)) (frame (js-call r "frame-new" heap 512))
               (zero (js-call r "value-number" heap 0 4294410240))
               (named (js-call r "value-function-named" heap 7)))
          (js-call r "frame-set" heap frame 0 zero) (js-call r "frame-set" heap frame 2 named)
          (while (< (control r heap :highWater) 256)
            (let ((value (js-call r "value-bytes" heap 0)))
              (js-call assert :ok (v64-ref-p value))
              (js-call r "frame-set" heap frame (1- (control r heap :highWater)) value)))
          (js-call assert :strictEqual (js-call r "allocator-cache-enabled" heap 7) 1)
          ;; A weak bucket must never alias a newly allocated real slot's root
          ;; count, even at the former borrowed-tail boundary.
          (js-call assert :strictEqual (js-call r "allocator-cache-set" heap 0 named) 1)
          (let ((boundary (js-call r "value-function-named" heap 777)))
            (js-call assert :ok (v64-ref-p boundary))
            (js-call assert :strictEqual (control r heap :highWater) 257)
            (js-call r "frame-set" heap frame 256 boundary)
            (js-call assert :strictEqual (js-call r "allocator-root-count" heap boundary) 0)
            (js-call assert :strictEqual (js-call r "allocator-cache-enabled" heap 7) 1))
          (while (< (control r heap :highWater) 512)
            (let ((value (js-call r "value-bytes" heap 0)))
              (js-call assert :ok (v64-ref-p value))
              (js-call r "frame-set" heap frame (1- (control r heap :highWater)) value)))
          (let ((used (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap)))
            (js-call assert :strictEqual (js-call r "value-function-named" heap 4095) (v64 0))
            (js-call assert :strictEqual (js-call r "last-error") 2)
            (js-call assert :strictEqual (js-call r "heap-used" heap) used)
            (js-call assert :strictEqual (js-call r "heap-live" heap) live)
            (js-call assert :strictEqual (js-call r "frame-depth" heap) 1))
          (js-call r "allocator-reset-named-scans")
          (js-call assert :strictEqual (js-call r "value-function-named" heap 7) named)
          (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
          (js-call assert :strictEqual (control r heap :highWater) 512)
          (js-call r "allocator-reset-named-scans")
          (let ((repeat 0))
            (while (< repeat 64)
              (js-call assert :strictEqual (js-call r "value-function-named" heap 7) named)
              (setq repeat (1+ repeat))))
          (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
          (js-call assert :strictEqual (js-call r "value-function-named" small 7) plain)
          (js-call assert :strictEqual (js-call r "frame-get" heap frame 0) zero)
          (js-call r "frame-set" heap frame 511 (v64 0)) (js-call r "heap-collect" heap)
          (let ((recovered (js-call r "value-function-named" heap 4095)))
            (js-call assert :ok (v64-ref-p recovered)) (js-call assert :strictEqual (js-call r "last-error") 0))
          (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))
        (js-call r "frame-pop" small small-frame) (js-call r "heap-collect" small)
        (js-call assert :strictEqual (js-call r "heap-live" small) 0)
        (js-call r "retire")
        (js-call assert :strictEqual (js-call r "value-function-named" small 7) (v64 0))
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (let ((next (js-call r "heap-new" 1024 32768 262144)))
          (js-call assert :ok (v64-ref-p (js-call r "value-function-named" next 0)))
          (js-call r "heap-collect" next)
          (js-call assert :strictEqual (js-call r "heap-live" next) 0)))))

  (test "named buckets stay allocation-free after near-maximum highwater, GC and moving compaction"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 1024 32768 262144)) (_ (js-call r "string-new" 0))
             (frame (js-call r "frame-new" heap 66)) (functions (js-array)) (index 0))
        (while (< index 64)
          (let ((function (js-call r "value-function-named" heap (+ 11 (* index 256)))))
            (js-call assert :ok (v64-ref-p function)) (js-call r "frame-set" heap frame index function)
            (js-call functions :push function))
          (setq index (1+ index)))
        (let ((zero (js-call r "value-number" heap 0 4294410240)) (base (js-call r "allocator-base" heap)))
          (js-call r "frame-set" heap frame 64 zero)
          ;; Keep only the real caller roots. Dead short-lived objects drive
          ;; highwater past the old permanent-disable threshold without GC.
          (while (< (control r heap :highWater) 1020)
            (js-call assert :ok (v64-ref-p (js-call r "value-bytes" heap 0))))
          (js-call assert :notStrictEqual (js-call r "allocator-base" heap) base)
          (js-call assert :strictEqual (control r heap :highWater) 1020)
          (js-call assert :ok (>= (js-call r "heap-collect" heap) 954))
          (js-call assert :strictEqual (js-call r "heap-live" heap) 66)
          (js-call assert :strictEqual (control r heap :highWater) 1020)
          (js-call assert :strictEqual (js-call r "allocator-cache-enabled" heap 11) 1)
          (js-call assert :strictEqual (js-call r "allocator-compact" heap) 1)
          (js-call r "heap-auto" heap 1)
          (let ((extra (js-call r "value-function-named" heap 17)))
            (js-call assert :ok (v64-ref-p extra)) (js-call r "frame-set" heap frame 65 extra))
          (let ((used (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap))
                (collections (js-call r "heap-collections" heap)) (repeat 0))
            (js-call r "allocator-reset-named-scans")
            (while (< repeat 16)
              (setq index 0)
              (while (< index 64)
                (js-call assert :strictEqual (js-call r "value-function-named" heap (+ 11 (* index 256)))
                  (aref functions index))
                (js-call assert :strictEqual (js-call r "last-error") 0)
                (setq index (1+ index)))
              (setq repeat (1+ repeat)))
            (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
            (js-call assert :strictEqual (js-call r "heap-used" heap) used)
            (js-call assert :strictEqual (js-call r "heap-live" heap) live)
            (js-call assert :strictEqual (js-call r "heap-collections" heap) collections))
          (js-call assert :strictEqual (js-call r "frame-get" heap frame 64) zero)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 1)
          (let ((offset (js-call r "allocator-offset" heap zero)))
            (js-call assert :strictEqual (word r heap (+ offset 36)) 4294410240))
          (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
          (js-call assert :notStrictEqual (js-call r "value-function-named" heap 11) (aref functions 0))
          (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)))))

  (test "ephemeron marking retains a complete 12000-key reverse chain with bounded propagation and survives compaction"
    (lambda ()
      (let* ((r (extended-fresh)) (depth 12000)
             (heap (js-call r "heap-new" 32768 2097152 8388608))
             (frame (js-call r "frame-new" heap 2))
             (table (js-call r "allocator-weak-table" heap 32768))
             (keys (js-array)) (previous (v64 3)) (index 0))
        (js-call assert :ok (> heap 0))
        (js-call assert :ok (v64-ref-p frame))
        (js-call assert :ok (v64-ref-p table))
        (js-call r "frame-set" heap frame 0 table)
        (while (< index depth)
          (let ((key (js-call r "allocator-weak-key" heap)))
            (js-call assert :ok (v64-ref-p key))
            (js-call assert :strictEqual (js-call r "allocator-weak-set" heap table key previous) 1)
            (js-call keys :push key) (setq previous key))
          (setq index (1+ index)))
        (js-call r "frame-set" heap frame 1 previous)
        (js-call (js-array false t) :forEach (lambda (compact)
          (when compact (js-call r "allocator-compact" heap))
          (js-call r "allocator-reset-weak-work")
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
          (js-call assert :strictEqual (js-call r "last-error") 0)
          (js-call assert :strictEqual (js-call r "allocator-weak-seeds") 1)
          (js-call assert :ok (<= (js-call r "allocator-weak-probes") (+ depth 8)))
          (js-call assert :strictEqual (js-call r "allocator-weak-count" heap table) depth)
          (let ((cursor previous) (position (1- depth)))
            (while (>= position 0)
              (js-call assert :strictEqual cursor (aref keys position))
              (setq cursor (js-call r "allocator-weak-get" heap table cursor) position (1- position)))
            (js-call assert :strictEqual cursor (v64 3)))))
        (js-call r "frame-set" heap frame 1 (v64 3))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) depth)
        (js-call assert :strictEqual (js-call r "allocator-weak-count" heap table) 0)
        (js-call assert :strictEqual (js-call r "value-kind" heap previous) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0))))

  (test "weak-key filtering skips unrelated leaf functions but preserves weak values captures compaction and slot reuse"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 256 32768 131072))
             (frame (js-call r "frame-new" heap 4))
             (table (js-call r "allocator-weak-table" heap 8))
             (key (js-call r "value-function-new" heap 500 0))
             (value (js-call r "allocator-weak-key" heap))
             (leaves (js-call r "value-refs" heap 7 32))
             (captured (js-call r "allocator-weak-key" heap))
             (closure (js-call r "value-function-new" heap 501 1)) (index 0))
        (js-call r "frame-set" heap frame 0 table)
        (js-call r "frame-set" heap frame 1 key)
        (js-call r "frame-set" heap frame 2 leaves)
        (js-call r "frame-set" heap frame 3 closure)
        (js-call assert :strictEqual (js-call r "allocator-capture-set" heap closure captured) 1)
        (while (< index 32)
          (js-call r "value-set" heap leaves index (js-call r "value-function-new" heap (+ 1000 index) 0))
          (setq index (1+ index)))
        (js-call assert :strictEqual (js-call r "allocator-weak-set" heap table key value) 1)
        (js-call (js-array false t) :forEach (lambda (compact)
          (when compact (js-call r "allocator-compact" heap))
          (js-call r "allocator-reset-weak-work")
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
          (js-call assert :strictEqual (js-call r "allocator-weak-probes") 1)
          (js-call assert :strictEqual (js-call r "allocator-weak-get" heap table key) value)
          (js-call assert :strictEqual (js-call r "value-kind" heap value) 13)
          (js-call assert :strictEqual (v64-word r heap (+ (js-call r "allocator-offset" heap closure) 48)) captured)
          (js-call assert :strictEqual (js-call r "value-kind" heap captured) 13)))
        (js-call r "frame-set" heap frame 1 (v64 3))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 2)
        (js-call assert :strictEqual (js-call r "allocator-weak-count" heap table) 0)
        (let ((replacement (js-call r "value-function-new" heap 502 0)))
          (js-call assert :strictEqual (v64-slot replacement) (v64-slot key))
          (js-call assert :notStrictEqual replacement key)
          (js-call r "frame-set" heap frame 1 replacement)
          (js-call r "allocator-reset-weak-work")
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
          (js-call assert :strictEqual (js-call r "allocator-weak-probes") 0))
        (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "last-error") 0)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0))))

  (test "ephemeron marking handles late tables late keys and unrooted value-to-key cycles"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 64 8192 32768))
             (frame (js-call r "frame-new" heap 2))
             (first-table (js-call r "allocator-weak-table" heap 8))
             (second-table (js-call r "allocator-weak-table" heap 8))
             (holder (js-call r "allocator-weak-holder" heap second-table))
             (a (js-call r "allocator-weak-key" heap))
             (b (js-call r "allocator-weak-key" heap))
             (c (js-call r "allocator-weak-key" heap)))
        (js-call assert :ok (v64-ref-p frame))
        (js-call assert :strictEqual (js-call r "last-error") 0)
        ;; Only the first table and a are roots. The second table arrives
        ;; through a weak value after a has already been processed.
        (js-call r "frame-set" heap frame 0 first-table)
        (js-call r "frame-set" heap frame 1 a)
        (js-call r "allocator-weak-set" heap first-table a holder)
        (js-call r "allocator-weak-set" heap second-table a b)
        (js-call r "allocator-weak-set" heap first-table b c)
        (js-call r "allocator-weak-set" heap second-table c a)
        (js-call r "allocator-reset-weak-work")
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
        (js-call assert :strictEqual (js-call r "allocator-weak-seeds") 2)
        (js-call assert :strictEqual (js-call r "allocator-weak-get" heap first-table a) holder)
        (js-call assert :strictEqual (js-call r "allocator-weak-get" heap second-table a) b)
        (js-call assert :strictEqual (js-call r "allocator-weak-get" heap first-table b) c)
        (js-call assert :strictEqual (js-call r "allocator-weak-get" heap second-table c) a)
        ;; a -> holder/table -> b -> c -> a must not seed its own liveness.
        (js-call r "frame-set" heap frame 1 (v64 3))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 5)
        (js-call assert :strictEqual (js-call r "allocator-weak-count" heap first-table) 0)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 2)
        (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0))))

  (test "sparse occupied-slot scans preserve word boundaries FIFO reuse foreign tokens and moving GC"
    (lambda ()
      (let* ((r (extended-fresh)) (heap (js-call r "heap-new" 8192 1048576 4194304))
             (frame (js-call r "frame-new" heap 12))
             (selected (js-array 31 32 63 64 127 128 8191 8192))
             (survivors (js-array)) (position 2))
        (js-call assert :ok (v64-ref-p frame))
        (while (<= position 8192)
          (let ((value (js-call r "allocator-weak-key" heap)))
            (js-call assert :strictEqual (v64-slot value) position)
            (when (js-call selected :includes position)
              (js-call r "frame-set" heap frame (js-length survivors) value)
              (js-call survivors :push value)))
          (setq position (1+ position)))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 8183)
        (js-call assert :strictEqual (control r heap :highWater) 8192)
        (js-call r "allocator-reset-slot-visits")
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
        (js-call assert :ok (<= (js-call r "allocator-slot-visits") 32))
        (js-call survivors :forEach (lambda (value)
          (js-call assert :strictEqual (js-call r "value-kind" heap value) 13)))
        ;; The ascending FIFO chooses slot 2, then 3, then 4.
        (let ((first (js-call r "allocator-weak-key" heap))
              (foreign (js-call r "value-foreign-new" heap 4096 0))
              (buffer (js-call r "value-bytes" heap 8)))
          (js-call assert :strictEqual (v64-slot first) 2)
          (js-call assert :strictEqual (v64-slot foreign) 3)
          (js-call assert :strictEqual (v64-slot buffer) 4)
          (js-call r "frame-set" heap frame 8 first)
          (js-call r "frame-set" heap frame 9 foreign)
          (js-call r "frame-set" heap frame 10 buffer)
          (js-call r "allocator-compact" heap)
          (js-call r "allocator-reset-slot-visits")
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
          (js-call assert :strictEqual (js-call r "value-foreign-live-tokens-into" heap buffer) 1)
          (let ((offset (js-call r "allocator-offset" heap buffer)))
            (js-call assert :strictEqual (word r heap (+ offset 32)) 4096))
          (js-call assert :ok (<= (js-call r "allocator-slot-visits") 64)))
        (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0))))

  (test "readonly primitive literal cells retain exact inline and boxed Number words and sealed String identity across moving GC and close"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 1024 65536 262144))
             (words (js-array (js-array 0 0) (js-array 0 2147483648)
                      (js-array 305419896 2146959360) (js-array 1 4294410240)))
             (values (js-array)) (index 0))
        (js-call r "value-bytes" heap 4096)
        (js-call assert :strictEqual (js-call r "value-module-begin" heap 5) 1)
        (while (< index 5)
          (js-call assert :strictEqual (js-call r "value-module-declare" heap index 0) 1)
          (js-call assert :strictEqual (js-call r "value-module-init" heap index (v64 0)) (v64 0))
          (js-call assert :strictEqual (js-call r "last-error") 0)
          (setq index (1+ index)))
        ;; The same lazy private slots remain legal after module completion.
        (js-call assert :strictEqual (js-call r "value-module-complete" heap) 1)
        (setq index 0)
        (while (< index 4)
          (let* ((payload (aref words index))
                 (number (js-call r "value-number" heap (aref payload 0) (aref payload 1)))
                 (used (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap))
                 (frames (js-call r "allocator-frame-count")))
            (js-call assert :strictEqual (js-call r "value-module-literal-init" heap index number) number)
            (js-call assert :strictEqual (js-call r "value-module-get" heap index) number)
            (js-call assert :strictEqual (js-call r "heap-used" heap) used)
            (js-call assert :strictEqual (js-call r "heap-live" heap) live)
            (js-call assert :strictEqual (js-call r "allocator-frame-count") frames)
            (js-call values :push number))
          (setq index (1+ index)))
        (let ((text (js-call r "value-string" heap 1)))
          (js-call r "value-unit-set" heap text 0 120) (js-call r "value-seal" heap text)
          (js-call assert :strictEqual (js-call r "value-module-literal-init" heap 4 text) text)
          (js-call values :push text))
        (let ((before-nan (js-call r "allocator-offset" heap (aref values 3)))
              (before-text (js-call r "allocator-offset" heap (aref values 4))))
          (js-call r "heap-collect" heap) (js-call r "allocator-compact" heap)
          (js-call assert :strictEqual (js-call r "last-error") 0)
          (js-call assert :ok (< (js-call r "allocator-offset" heap (aref values 3)) before-nan))
          (js-call assert :ok (< (js-call r "allocator-offset" heap (aref values 4)) before-text)))
        (setq index 0)
        (while (< index 4)
          (let* ((value (js-call r "value-module-get" heap index))
                 (payload (aref words index)))
            (js-call assert :strictEqual value (aref values index))
            (js-call assert :strictEqual (number-low r heap value) (aref payload 0))
            (js-call assert :strictEqual (number-high r heap value) (aref payload 1)))
          (setq index (1+ index)))
        (js-call assert :strictEqual (js-call r "value-module-get" heap 4) (aref values 4))
        (js-call assert :strictEqual (js-call r "value-unit-get" heap (aref values 4) 0) 120)
        (js-call assert :strictEqual (js-call r "value-module-literal-init" heap 0 (aref values 1)) (v64 0))
        (js-call assert :strictEqual (js-call r "last-error") 3)
        (js-call assert :strictEqual (js-call r "value-module-get" heap 0) (aref values 0))
        (js-call assert :strictEqual (js-call r "value-module-set" heap 0 (aref values 1)) (v64 0))
        (js-call assert :strictEqual (js-call r "last-error") 3)
        (js-call assert :strictEqual (js-call r "value-module-close" heap) 1)
        (js-call assert :strictEqual (js-call r "value-module-literal-init" heap 0 (aref values 0)) (v64 0))
        (js-call assert :strictEqual (js-call r "last-error") 3)
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))

  (test "primitive literal initialization accepts sealed strings and numbers and refuses mutable text objects symbols and stale generations"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 512 65536 262144))
             (number (js-call r "value-number" heap 0 2147483648))
             (mutable (js-call r "value-string" heap 1))
