        (js-call assert :strictEqual (js-call r "value-module-literal-init" heap 1 number) number)
        (js-call assert :strictEqual (js-call r "value-module-literal-init" heap 0 mutable) (v64 0))
        (js-call assert :strictEqual (js-call r "last-error") 3)
        (js-call assert :strictEqual (js-call r "value-module-literal-init" heap 1 number) (v64 0))
        (js-call assert :strictEqual (js-call r "last-error") 3)
        (js-call assert :strictEqual (js-call r "value-module-get" heap 0) mutable)
        (js-call assert :strictEqual (js-call r "value-module-get" heap 1) number)
        (js-call r "frame-pop" heap frame) (js-call r "value-module-close" heap)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))

