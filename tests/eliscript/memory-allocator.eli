        (js-call r "value-set" heap arguments 0 object) (js-call r "value-set" heap arguments 1 (v64 3))
        (js-call assert :strictEqual (js-call r "value-canonical-string-hash-try" heap arguments 2) (v64 0))
        (js-call assert :strictEqual (js-call r "last-error") 0)
        (js-call assert :strictEqual (js-call r "allocator-callback-count") 0)
