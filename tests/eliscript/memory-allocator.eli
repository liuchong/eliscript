      (setq hash (funcall mix hash (uint32 (js-length text))))
      (setq hash (bit-xor hash (unsigned-bit-shift-right hash 16)))
      (setq hash (imul32 hash 2246822507))
      (setq hash (bit-xor hash (unsigned-bit-shift-right hash 13)))
      (setq hash (imul32 hash 3266489909))
      (uint32 (bit-xor hash (unsigned-bit-shift-right hash 16)))))
  (test "canonical string hash try keeps UTF16 and u32 tags with zero-allocation inline Val64 Number results and moving GC"
    (lambda ()
      (let* ((f (allocator-property-fixture)) (r (get f :r)) (heap (get f :heap)) (own (get f :own))
             (text (get f :text)) (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
             (number (lambda (value)
               (js-call bits :setFloat64 0 value t)
               (funcall own (js-call r "value-number" heap (js-call bits :getUint32 0 t) (js-call bits :getUint32 4 t)))))
             (texts (js-array "" "Eliscript" "abc" (String/fromCharCode 0 65 0)
                      (String/fromCharCode 55296) (String/fromCharCode 56320)
                      (String/fromCharCode 55357 56832) (js-call "aλ" :repeat 1024)))
             (tags (js-array undefined 0 -0 1 2147483648 4294967295))
             (arguments (funcall own (js-call r "value-refs" heap 7 3))))
        (js-call texts :forEach (lambda (input)
          (let ((value (funcall text input)))
            (js-call tags :forEach (lambda (tag)
              (js-call r "value-set" heap arguments 0 value)
              (js-call r "value-set" heap arguments 1 (if (undefined? tag) (v64 3) (funcall number tag)))
              ;; Extra parameters are validated but remain ignored, as &rest
              ;; tags only observes its first member in the original source.
              (js-call r "value-set" heap arguments 2 (v64 1))
              (js-call r "heap-collect" heap)
              (let* ((before (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap))
                     (collections (js-call r "heap-collections" heap))
                     (result (js-call r "value-canonical-string-hash-try" heap arguments 3)))
                (js-call assert :ok (v64-ref-p result))
                (js-call assert :strictEqual (js-call r "last-error") 0)
                (js-call assert :strictEqual (read-number r heap result)
                  (allocator-hash-reference input (if (undefined? tag) 1831565813 tag)))
                (js-call assert :strictEqual (- (js-call r "heap-live" heap) live) 0)
                (js-call assert :strictEqual (- (js-call r "heap-used" heap) before) 0)
                (js-call assert :strictEqual (js-call r "heap-collections" heap) collections)
                (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))))))
        (js-call (js-array (js-array "" 439960318) (js-array "Eliscript" 1222682721)
                   (js-array "key-50691" 2357254775) (js-array "key-194634" 2357254775)) :forEach
          (lambda (entry)
            (js-call assert :strictEqual (allocator-hash-reference (aref entry 0) 1831565813) (aref entry 1))))
        (let* ((input (funcall text (String/fromCharCode 55296 0 65 56320)))
               (single (funcall own (js-call r "value-refs" heap 7 1))))
          (js-call r "value-set" heap single 0 input)
          (js-call r "heap-auto" heap 1)
          (js-call r "allocator-compact-next")
          (let ((result (js-call r "value-canonical-string-hash-try" heap single 1)))
            (js-call assert :strictEqual (read-number r heap result)
              (allocator-hash-reference (String/fromCharCode 55296 0 65 56320) 1831565813)))
          (js-call assert :strictEqual (js-call r "value-length" heap input) 4))
        (allocator-property-finish f))))
  (test "canonical string hash try misses without coercion or allocation after String exposure or invalid primitive inputs"
    (lambda ()
      (let* ((f (allocator-property-fixture)) (r (get f :r)) (heap (get f :heap)) (own (get f :own))
             (text (funcall (get f :text) "hello"))
             (arguments (funcall own (js-call r "value-refs" heap 7 2)))
