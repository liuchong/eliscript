  (test "original 512 mixed allocations preserve exact capacity failures across independent heaps"
    (lambda ()
      (let* ((r (fresh)) (heaps (js-array (fixture r 16384) (fixture r 32768)))
             (live (js-array (js-array) (js-array))) (seed 2702232190)
             (next (lambda ()
               (setq seed (bit-xor seed (bit-shift-left seed 13)))
               (setq seed (bit-xor seed (unsigned-bit-shift-right seed 17)))
               (setq seed (bit-xor seed (bit-shift-left seed 5))) (uint32 seed)))
             (sizes (js-array 32 40 48 64 80 96 128 160 256)) (step 0))
        (while (< step 512)
          (let* ((index (bit-and (funcall next) 1)) (f (aref heaps index)) (values (aref live index)))
            (if (and (> (js-length values) 0) (= (% (funcall next) 3) 0))
              (release-block f (aref (js-call values :splice (% (funcall next) (js-length values)) 1) 0))
              (let ((block (allocate-block f (aref sizes (% (funcall next) (js-length sizes))))))
                (when block (js-call values :push block))))
            (check (aref heaps 0)) (check (aref heaps 1)))
          (setq step (1+ step)))
        (setq step 0)
        (while (< step 2)
          (let ((f (aref heaps step)) (values (aref live step)))
            (allocate-block f 4294967288)
            (while (> (js-length values) 0) (release-block f (js-call values :pop)))
            (js-call assert :strictEqual (js-call r "heap-used" (get f :heap)) (get f :start))
            (js-call assert :strictEqual (control r (get f :heap) :freeBlockHead) 0)
            (let ((block (allocate-block f 32)))
              (js-call assert :strictEqual (get block :offset) (get f :start)) (release-block f block)))
          (setq step (1+ step)))
        (js-call assert :strictEqual (js-call r "retire") 1))))

