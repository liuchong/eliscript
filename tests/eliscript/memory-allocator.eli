                     (funcall own (js-call r "value-symbol-well-known" heap 0))))
             (values (js-array (v64 3) child (v64 1))) (frames (js-call r "allocator-frame-count")))
        (js-call keys :forEach (lambda (key index)
          (js-call assert :strictEqual (js-call r "value-object-put" heap object key (aref values index) 2) 1)))
        (js-call assert :strictEqual (js-call r "allocator-frame-count") frames)
        (js-call keys :forEach (lambda (key index)
          (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object key object)
            (aref values index))))
        ;; mode2 __proto__ is an own data property, not a prototype mutation.
        (js-call assert :strictEqual (js-call r "allocator-create-own" heap object (aref keys 0) (v64 2) 2) 4)
        (js-call assert :strictEqual (js-call r "last-error") 0)
        (allocator-property-finish f))))

  (test "ROData keys and inline or readonly children create own fields without frames bytes slots or collections"
    (lambda ()
      (let* ((f (allocator-property-fixture t)) (r (get f :r)) (heap (get f :heap))
             (own (get f :own)) (text (get f :text)) (static (get f :static))
             (object (funcall own (js-call r "value-object-new" heap (v64 0))))
             (keys (js-array (get static :key) (funcall text "inline")
                     (funcall text "readonlyText") (funcall text "readonlyNaN")))
             (values (js-array (js-call r "value-number" heap 0 2147483648)
                       (js-call r "value-number" heap 0 1072693248) (get static :key) (get static :number))))
        (js-call r "heap-auto" heap 1)
        (let ((frames (js-call r "allocator-frame-count")) (bytes (js-call r "heap-used" heap))
              (live (js-call r "heap-live" heap)) (collections (js-call r "heap-collections" heap)))
          (js-call keys :forEach (lambda (key index)
            (js-call assert :strictEqual (js-call r "value-object-put" heap object key (aref values index) 2) 1)
            (js-call assert :strictEqual (js-call r "last-error") 0)))
          (js-call assert :strictEqual (js-call r "allocator-frame-count") frames)
          (js-call assert :strictEqual (js-call r "heap-used" heap) bytes)
          (js-call assert :strictEqual (js-call r "heap-live" heap) live)
          (js-call assert :strictEqual (js-call r "heap-collections" heap) collections))
        (js-call keys :forEach (lambda (key index)
          (js-call assert :strictEqual (js-call r "value-object-get" heap object key) (aref values index))))
        (js-call assert :ok (Object/is (read-number r heap (aref values 0)) -0.0))
        (js-call assert :strictEqual (js-call r "value-number-bits" heap (get static :number)) (v64 "0xfff7000000000041"))
        ;; Tag admission never replaces the public handle and sentinel checks.
        (js-call assert :strictEqual (js-call r "value-object-put" heap object (v64 "0xfff9000900000002") (v64 2) 2) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (js-call assert :strictEqual (js-call r "value-object-put" heap object (get static :key) (v64 5) 2) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (js-call assert :deepStrictEqual (allocator-property-static-bytes f) (get static :bytes))
        (allocator-property-finish f))))

  (test "ROData and inline operands survive new own field moving growth and preserve numeric key conversion"
    (lambda ()
      (js-call (js-array 0 1 2) :forEach (lambda (mode)
        (let* ((f (allocator-property-fixture t)) (r (get f :r)) (heap (get f :heap))
               (own (get f :own)) (text (get f :text)) (roots (get f :roots)) (static (get f :static))
               (object (funcall own (js-call r "value-object-new" heap (v64 0))))
               (key (if (= mode 1) (funcall text "last") (get static :key)))
               (child (cond ((= mode 0) (js-call r "value-number" heap 0 1072693248))
                        ((= mode 1) (get static :key))
                        (t (funcall own (js-call r "value-array-new" heap 0)))))
               (borrowed (js-array object)))
          (js-call (js-array "a" "b" "c" "d") :forEach (lambda (name)
            (js-call assert :strictEqual (js-call r "value-object-put" heap object (funcall text name) (v64 2) 2) 1)))
          (when (= mode 1) (js-call borrowed :push key))
          (when (= mode 2) (js-call borrowed :push child))
          (js-call borrowed :forEach (lambda (raw)
            (js-call r "heap-release" heap raw)
            (js-call roots :splice (js-call roots :indexOf raw) 1)))
          (let ((frames (js-call r "allocator-frame-count")))
            (js-call r "allocator-compact-next")
            (js-call assert :strictEqual (js-call r "value-object-put" heap object key child 2) 1)
            (js-call assert :strictEqual (js-call r "last-error") 0)
            (js-call assert :strictEqual (js-call r "allocator-frame-count") frames))
          (js-call borrowed :forEach (lambda (raw)
            (js-call assert :strictEqual (js-call r "allocator-root-count" heap raw) 0)))
          (funcall own object)
          (js-call assert :strictEqual (js-call r "value-object-get" heap object key) child)
          ;; Inline numeric keys miss the block fast path and retain ToPropertyKey.
          (let ((zero (js-call r "value-number" heap 0 2147483648)) (name (funcall text "0")))
            (js-call assert :strictEqual (js-call r "allocator-create-own" heap object zero child 2) 4)
            (js-call assert :strictEqual (js-call r "last-error") 0)
            (js-call assert :strictEqual (js-call r "value-object-put" heap object zero child 2) 1)
            (js-call assert :strictEqual (js-call r "value-object-get" heap object name) child))
          (js-call assert :deepStrictEqual (allocator-property-static-bytes f) (get static :bytes))
          (allocator-property-finish f))))))

  (test "ROData new own field tight budget OOM preserves first error roots and recovery"
    (lambda ()
      (js-call (js-array 0 1 2) :forEach (lambda (mode)
        (let* ((f (allocator-property-fixture t)) (r (get f :r)) (heap (get f :heap))
               (own (get f :own)) (text (get f :text)) (roots (get f :roots)) (static (get f :static))
