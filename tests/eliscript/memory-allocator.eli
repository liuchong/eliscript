  (test "new own fields use sealed String Symbol undefined and proto keys without conversion frames"
    (lambda ()
      (let* ((f (allocator-property-fixture)) (r (get f :r)) (heap (get f :heap))
             (own (get f :own)) (text (get f :text))
             (object (funcall own (js-call r "value-object-new" heap (v64 0))))
             (child (funcall own (js-call r "value-array-new" heap 0)))
