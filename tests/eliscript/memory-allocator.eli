                  (normalize-u64 (Reflect/apply item undefined args)))
                item)))))
      wrapped))
  (defun fresh () (wrap-exports (get (new globalThis.WebAssembly.Instance image) :exports)))
  (defun extended-fresh () (wrap-exports (get (new globalThis.WebAssembly.Instance extended-image) :exports)))
  (defun v64-ref-p (raw) (> (normalize-u64 raw) (v64 3)))
  (defun v64-slot (value)
