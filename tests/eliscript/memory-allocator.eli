  (let ((kinds (js-array 6 7 14)) (kind-index 0))
    (while (< kind-index (js-length kinds))
      (let ((kind (aref kinds kind-index)))
        (test (+ "original collecting compaction preserves growing kind " kind " bytes, refs, flags and neighbors")
          (lambda ()
            (let* ((r (fresh)) (heap (js-call r "heap-new" 32 8192 24576))
                   (frame (js-call r "frame-new" heap 2)) (hole (js-call r "value-bytes" heap 7000))
                   (count (if (= kind 6) 256 64)) (width (if (= kind 6) 1 8))
                   (value (if (= kind 6) (js-call r "value-bytes" heap count)
                     (if (= kind 7) (js-call r "value-refs" heap 7 count) (js-call r "value-array-new" heap count))))
                   (index 0))
              (js-call assert :ok (> heap 3)) (js-call assert :ok (v64-ref-p hole))
              (js-call assert :ok (v64-ref-p frame)) (js-call assert :ok (v64-ref-p value))
              (js-call r "frame-set" heap frame 0 value)
              (let* ((tail (js-call r "value-bytes" heap 7000))
                     (original (new globalThis.Uint8Array (* count width)))
                     (words (new globalThis.DataView (get original :buffer))))
                (js-call assert :ok (v64-ref-p tail)) (js-call r "frame-set" heap frame 1 tail)
                (while (< index count)
                  (if (= kind 6) (put original index (% (+ (* index 17) 3) 251))
                    (js-call words :setBigUint64 (* index 8) (v64 (1+ (% index 3))) t))
                  (setq index (1+ index)))
                (js-call (new globalThis.Uint8Array (get (get r :memory) :buffer)
                           (js-call r "value-data" heap value kind) (js-length original)) :set original)
                (let ((neighbor (new globalThis.Uint8Array 7000)))
                  (setq index 0)
                  (while (< index 7000) (put neighbor index (% (+ (* index 13) 7) 251)) (setq index (1+ index)))
                  (js-call (new globalThis.Uint8Array (get (get r :memory) :buffer)
                             (js-call r "value-data" heap tail 6) 7000) :set neighbor)
                  (when (= kind 14) (js-call assert :strictEqual (js-call r "value-source-prevent-extensions" heap value) (v64 2)))
                  (let ((tail-before (js-call r "allocator-offset" heap tail)) (collections (js-call r "heap-collections" heap)))
                    (js-call r "heap-auto" heap 1) (js-call r "allocator-compact-next")
                    (js-call assert :strictEqual
                      (if (= kind 6) (js-call r "value-bytes-resize" heap value 8192)
                        (if (= kind 7) (js-call r "value-refs-resize" heap value 1024)
