  (test "own data probe rejects lazy keys accessors missing mutable keys and lazy function roles without observable work"
    (lambda ()
      (let* ((f (allocator-property-fixture)) (r (get f :r)) (heap (get f :heap))
             (own (get f :own)) (text (get f :text))
             (parent (funcall own (js-call r "value-object-new" heap (v64 0))))
             (object (funcall own (js-call r "value-object-new" heap parent)))
             (namespace (funcall own (js-call r "value-object-new" heap (v64 0))))
             (foreign (funcall own (js-call r "value-foreign-new" heap 731 0)))
             (key (funcall text "sample")) (missing (funcall text "absent"))
             (builtin (funcall text "toString")) (mutable (funcall own (js-call r "value-string" heap 0)))
             (getter (funcall own (js-call r "allocator-described" heap 9001 0 0 0))))
        (js-call r "value-object-put" heap parent key (v64 2) 2)
        (js-call r "value-object-put" heap object builtin (v64 1) 2)
        (js-call r "value-object-put" heap namespace key (v64 2) 2)
        (js-call r "allocator-namespace-mark" heap namespace)
        (let ((frames (js-call r "allocator-frame-count")) (bytes (js-call r "heap-used" heap)))
          (js-call assert :strictEqual (js-call r "allocator-own-data" heap object key) (v64 4))
          (js-call assert :strictEqual (js-call r "allocator-own-data" heap object missing) (v64 4))
          (js-call assert :strictEqual (js-call r "allocator-own-data" heap object builtin) (v64 4))
          (js-call assert :strictEqual (js-call r "allocator-own-data" heap object mutable) (v64 4))
          (js-call assert :strictEqual (js-call r "allocator-own-data" heap namespace key) (v64 4))
          (js-call assert :strictEqual (js-call r "allocator-own-data" heap foreign key) (v64 4))
          (js-call assert :strictEqual (js-call r "allocator-frame-count") frames)
          (js-call assert :strictEqual (js-call r "heap-used" heap) bytes))
        (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object key object) (v64 2))
        (js-call r "value-object-define-accessor" heap object key getter (v64 3) 6)
        (js-call r "allocator-reset-callbacks")
        (js-call assert :strictEqual (js-call r "allocator-own-data" heap object key) (v64 4))
        (js-call assert :strictEqual (js-call r "allocator-callback-count") 0)
        (js-call r "allocator-callback-compact-next")
        (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object key parent) parent)
        (js-call assert :strictEqual (js-call r "allocator-callback-count") 1)
        (js-call (js-array 1 25 76 77) :forEach (lambda (role)
          (let ((function (funcall own (js-call r "allocator-described" heap 9010 role 1 0))))
            (js-call r "allocator-function-data" heap function key (v64 2))
            (js-call assert :strictEqual (js-call r "allocator-own-data" heap function key) (v64 4)))))
        (js-call (js-array (js-array 9002 (v64 1)) (js-array 9003 (v64 3))) :forEach (lambda (entry)
          (let ((thrower (funcall own (js-call r "allocator-described" heap (aref entry 0) 0 0 0))))
            (js-call r "value-object-define-accessor" heap object key thrower (v64 3) 6)
            (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap object key parent) (v64 0))
            (js-call assert :strictEqual (js-call r "last-error") 11)
            (js-call assert :strictEqual (js-call r "value-exception-take" heap) (aref entry 1)))))
        (allocator-property-finish f))))

  (test "caller rooted invoke uses the existing frame under moving GC and restores previous this without pins"
    (lambda ()
      (let* ((f (allocator-property-fixture)) (r (get f :r)) (heap (get f :heap))
             (caller (js-call r "frame-new" heap 4))
             (function (js-call r "allocator-described" heap 9001 0 0 0)))
        (js-call r "frame-set" heap caller 0 function)
        (let ((arguments (js-call r "value-refs" heap 7 0)))
          (js-call r "frame-set" heap caller 1 arguments)
          (let ((receiver (js-call r "value-array-new" heap 0)))
            (js-call r "frame-set" heap caller 2 receiver)
            (let ((previous (js-call r "value-array-new" heap 0)))
              (js-call r "frame-set" heap caller 3 previous)
              (js-call r "allocator-current-this-set" heap previous)
              (let ((frames (js-call r "allocator-frame-count")))
                (js-call r "allocator-callback-compact-next")
                (js-call assert :strictEqual (js-call r "value-source-invoke-rooted-with-this" heap function receiver arguments 0) receiver)
                (js-call assert :strictEqual (js-call r "allocator-frame-count") frames)
                (js-call assert :strictEqual (js-call r "allocator-callback-depth") 1)
                (js-call assert :strictEqual (js-call r "value-function-current-this" heap) previous)
                (js-call assert :strictEqual (js-call r "allocator-root-count" heap function) 0)
                (js-call assert :strictEqual (js-call r "allocator-root-count" heap arguments) 0)
                (js-call assert :strictEqual (js-call r "allocator-root-count" heap receiver) 0)
                (js-call assert :strictEqual (js-call r "allocator-root-count" heap previous) 0)
                (js-call assert :strictEqual (js-call r "value-source-invoke-with-this" heap function receiver arguments 0) receiver)
                (js-call assert :strictEqual (js-call r "allocator-callback-depth") 2)
                (js-call assert :strictEqual (js-call r "allocator-frame-count") (1+ frames)))
              (js-call r "allocator-current-this-set" heap (v64 3)))))
        (js-call r "frame-pop" heap caller)
        (allocator-property-finish f))))

  (test "caller rooted invoke preserves false undefined first throws raw validation and public invoke errors"
    (lambda ()
      (let* ((f (allocator-property-fixture)) (r (get f :r)) (heap (get f :heap))
             (own (get f :own)) (receiver (funcall own (js-call r "value-array-new" heap 0)))
             (previous (funcall own (js-call r "value-array-new" heap 0)))
             (arguments (funcall own (js-call r "value-refs" heap 7 0)))
             (caller (js-call r "frame-new" heap 4)))
        (js-call r "frame-set" heap caller 1 arguments)
        (js-call r "frame-set" heap caller 2 receiver)
        (js-call r "frame-set" heap caller 3 previous)
        (js-call r "allocator-current-this-set" heap previous)
        (js-call (js-array (js-array 9002 (v64 1)) (js-array 9003 (v64 3))) :forEach (lambda (entry)
          (let ((function (js-call r "allocator-described" heap (aref entry 0) 0 0 0)))
            (js-call r "frame-set" heap caller 0 function)
            (js-call r "allocator-callback-compact-next")
            (js-call assert :strictEqual (js-call r "value-source-invoke-rooted-with-this" heap function receiver arguments 0) (v64 0))
            (js-call assert :strictEqual (js-call r "last-error") 11)
            (js-call assert :strictEqual (js-call r "value-exception-take" heap) (aref entry 1))
            (js-call assert :strictEqual (js-call r "value-function-current-this" heap) previous)
            (js-call assert :strictEqual (js-call r "frame-depth" heap) 1)
            (js-call assert :strictEqual (js-call r "value-source-invoke-with-this" heap function receiver arguments 0) (v64 0))
            (js-call assert :strictEqual (js-call r "last-error") 11)
            (js-call assert :strictEqual (js-call r "value-exception-take" heap) (aref entry 1)))))
        ;; Runtime-generated TypeError uses the raw error code plus exception
        ;; class, whereas explicit source throw uses code11/pending payload.
        ;; The compiler-only ABI must reproduce the existing raw ABI in both
        ;; argument-priority and noncallable cases, without assuming a throw.
        (js-call (js-array 1 0) :forEach (lambda (count)
          (js-call r "value-exception-clear" heap)
          (let* ((expected (js-call r "value-source-invoke-with-this" heap (v64 1) receiver arguments count))
                 (error (js-call r "last-error"))
                 (kind (js-call r "value-exception-class" heap))
                 (pending (js-call r "value-exception-pending" heap)))
            (js-call r "value-exception-clear" heap)
            (js-call assert :strictEqual
              (js-call r "value-source-invoke-rooted-with-this" heap (v64 1) receiver arguments count) expected)
            (js-call assert :strictEqual (js-call r "last-error") error)
            (js-call assert :strictEqual (js-call r "value-exception-class" heap) kind)
            (js-call assert :strictEqual (js-call r "value-exception-pending" heap) pending))))
        (js-call r "value-exception-clear" heap)
        (js-call r "allocator-current-this-set" heap (v64 3))
        (js-call r "frame-pop" heap caller)
        (allocator-property-finish f))))

  (test "function Get reads real data and accessor records without reflection objects and preserves own undefined and receivers"
    (lambda ()
      (let* ((f (allocator-property-fixture)) (r (get f :r)) (heap (get f :heap))
             (own (get f :own)) (text (get f :text))
             (function (funcall own (js-call r "allocator-described" heap 9010 0 0 0)))
             (receiver (funcall own (js-call r "value-array-new" heap 0)))
             (parent (funcall own (js-call r "value-object-new" heap (v64 0))))
             (key (funcall text "sample")) (missing (funcall text "absent"))
             (getter (funcall own (js-call r "allocator-described" heap 9001 0 0 0))))
        (js-call r "value-object-put" heap parent key (v64 2) 2)
        (js-call r "allocator-function-parent" heap function parent)
        (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap function key receiver) (v64 2))
        (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap function missing receiver) (v64 3))
        (js-call r "allocator-function-data" heap function key (v64 3))
        (js-call r "allocator-reset-descriptors")
        (let ((round 0))
          (while (< round 64)
            (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap function key receiver) (v64 3))
            (setq round (1+ round))))
        (js-call assert :strictEqual (js-call r "allocator-descriptors") 0)
        ;; Public reflection remains a real independently allocated descriptor.
        (let ((descriptor (js-call r "value-function-own-descriptor" heap function key)))
          (js-call assert :ok (v64-ref-p descriptor))
          (js-call assert :strictEqual (js-call r "allocator-descriptors") 1))
        (js-call r "allocator-function-accessor" heap function key getter)
        (js-call r "heap-auto" heap 1)
        (js-call r "allocator-reset-callbacks")
        (js-call r "allocator-reset-descriptors")
        (js-call r "allocator-callback-compact-next")
        (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap function key receiver) receiver)
        (js-call assert :strictEqual (js-call r "allocator-callback-count") 1)
        (js-call assert :strictEqual (js-call r "allocator-callback-receiver") receiver)
        (js-call assert :strictEqual (js-call r "value-function-current-this" heap) (v64 3))
        (js-call assert :strictEqual (js-call r "allocator-descriptors") 0)
        (js-call r "allocator-function-accessor" heap function key (v64 3))
        (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap function key receiver) (v64 3))
        (js-call (js-array (js-array 9002 (v64 1)) (js-array 9003 (v64 3))) :forEach (lambda (entry)
          (let ((thrower (funcall own (js-call r "allocator-described" heap (aref entry 0) 0 0 0))))
            (js-call r "allocator-function-accessor" heap function key thrower)
            (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap function key receiver) (v64 0))
            (js-call assert :strictEqual (js-call r "last-error") 11)
            (js-call assert :strictEqual (js-call r "value-exception-take" heap) (aref entry 1))
            (js-call assert :strictEqual (js-call r "value-function-current-this" heap) (v64 3)))))
        (let* ((bare (funcall own (js-call r "value-function-new" heap 9011 0)))
               (symbol (funcall own (js-call r "value-symbol-well-known" heap 0))))
          (js-call assert :strictEqual (js-call r "value-function-own-descriptor" heap bare symbol) (v64 3))
          (js-call assert :strictEqual (js-call r "last-error") 0)
          (js-call assert :strictEqual (js-call r "value-function-description-state" heap bare 0) 0)
          ;; The own Symbol query stays lazy; a full Get still needs the
          ;; unavailable bare-function prototype and retains that refusal.
          (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap bare symbol receiver) (v64 0))
          (js-call assert :strictEqual (js-call r "last-error") 3)
          (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap bare key receiver) (v64 0))
          (js-call assert :strictEqual (js-call r "last-error") 3))
        (allocator-property-finish f))))

  (test "captured intrinsic iterator next bypasses result boxing after prototype replacement and keeps entries and moving GC"
    (lambda ()
      (let* ((f (allocator-property-fixture)) (r (get f :r)) (heap (get f :heap)) (own (get f :own))
             (registry (allocator-iterator-registry f undefined))
             (method (js-call r "value-get" heap (get registry :methods) 1))
             (prototype (js-call r "value-get" heap (get registry :record) 1))
             (array (funcall own (js-call r "value-array-new" heap 2)))
             (child (funcall own (js-call r "value-array-new" heap 0)))
             (raw (funcall own (js-call r "value-source-iterator-new" heap array 2)))
             (record (funcall own (js-call r "allocator-protocol-record" heap raw)))
             (next-key (funcall (get f :text) "next"))
             (replacement (funcall own (js-call r "allocator-described" heap 9002 0 0 0))))
        (js-call r "value-set" heap array 0 child) (js-call r "value-set" heap array 1 (v64 3))
        (js-call assert :strictEqual (js-call r "allocator-iterator-method" heap record) method)
        (js-call assert :strictEqual (js-call r "allocator-protocol-native" heap record method) raw)
        (js-call r "value-object-put" heap prototype next-key replacement 2)
        (js-call r "heap-auto" heap 1) (js-call r "heap-collect" heap) (js-call r "allocator-compact" heap)
        (js-call r "allocator-reset-callbacks")
        (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap record) 1)
        (js-call assert :strictEqual (js-call r "allocator-iterator-item" heap record) child)
        (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap record) 1)
        (js-call assert :strictEqual (js-call r "allocator-iterator-item" heap record) (v64 3))
        (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap record) 0)
        (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap record) 0)
        (js-call assert :strictEqual (js-call r "last-error") 0)
        (js-call assert :strictEqual (js-call r "allocator-callback-count") 0)
        (js-call assert :strictEqual (js-call r "allocator-next-count") 0)
        (js-call assert :strictEqual (js-call r "allocator-object-count") 0)
        ;; New acquisition observes the replaced method, old records do not.
        (let* ((later (funcall own (js-call r "value-source-iterator-new" heap array 2)))
               (changed (funcall own (js-call r "allocator-protocol-record" heap later))))
          (js-call assert :strictEqual (js-call r "allocator-protocol-native" heap changed replacement) (v64 0))
          (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap changed) 0)
          (js-call assert :strictEqual (js-call r "last-error") 11)
          (js-call assert :strictEqual (js-call r "value-exception-take" heap) (v64 1)))
        (js-call r "value-object-put" heap prototype next-key method 2)
        (let* ((entries (funcall own (js-call r "value-source-iterator-new" heap array 0)))
               (wrapped (funcall own (js-call r "allocator-protocol-record" heap entries))))
          (js-call r "allocator-reset-callbacks")
          (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap wrapped) 1)
          (let ((pair (js-call r "allocator-iterator-item" heap wrapped)))
            (js-call assert :strictEqual (js-call r "value-length" heap pair) 2)
            (js-call assert :strictEqual (js-call r "value-get" heap pair 1) child))
          (js-call assert :strictEqual (js-call r "value-source-iterator-skip" heap wrapped) 1)
          (js-call assert :strictEqual (js-call r "allocator-iterator-item" heap wrapped) (v64 3))
          (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap wrapped) 0)
          (js-call assert :strictEqual (js-call r "allocator-next-count") 0))
        (allocator-property-finish f))))

  (test "iterator registry alone cannot authorize bypass and custom skip preserves captured calls value laziness and first error on close"
    (lambda ()
      (let* ((f (allocator-property-fixture)) (r (get f :r)) (heap (get f :heap)) (own (get f :own)) (text (get f :text))
             (custom (funcall own (js-call r "allocator-described" heap 9004 0 0 1)))
             (registry (allocator-iterator-registry f custom))
             (array (funcall own (js-call r "value-array-new" heap 1)))
             (raw (funcall own (js-call r "value-source-iterator-new" heap array 2)))
             (record (funcall own (js-call r "allocator-protocol-record" heap raw)))
             (step (funcall own (js-call r "value-object-new" heap (v64 0))))
             (done-key (funcall text "done")) (value-key (funcall text "value"))
             (value-getter (funcall own (js-call r "allocator-described" heap 9005 0 0 0))))
        (js-call r "value-object-put" heap step done-key (v64 1) 2)
        (js-call r "value-object-define-accessor" heap step value-key value-getter (v64 3) 6)
        (js-call r "allocator-capture-set" heap custom step)
        (js-call assert :strictEqual (js-call r "allocator-protocol-native" heap record custom) (v64 0))
        (js-call r "heap-auto" heap 1) (js-call r "allocator-reset-callbacks")
        (js-call r "allocator-callback-compact-next")
        (js-call assert :strictEqual (js-call r "value-source-iterator-skip" heap record) 1)
        (js-call assert :strictEqual (js-call r "allocator-value-reads") 0)
        (js-call assert :strictEqual (js-call r "allocator-callback-count") 1)
        (js-call assert :strictEqual (js-call r "allocator-callback-receiver") raw)
        (js-call assert :strictEqual (js-call r "value-function-current-this" heap) (v64 3))
        (js-call assert :strictEqual (js-call r "value-source-iterator-advance" heap record) 0)
        (js-call assert :strictEqual (js-call r "last-error") 11)
        (js-call assert :strictEqual (js-call r "value-exception-take" heap) (v64 1))
        (js-call assert :strictEqual (js-call r "allocator-value-reads") 1)
        ;; A matching numeric intrinsic tag on a captured source function is
        ;; insufficient, as is an unmarked zero-capture function.
        (let ((methods (get registry :methods)))
          (js-call (js-array (js-array 329 0 0) (js-array 329 1 1) (js-array 330 1 0)) :forEach (lambda (shape)
            (let ((forged (funcall own (js-call r "allocator-described" heap 9004
                           (aref shape 0) (aref shape 1) (aref shape 2)))))
              (js-call r "value-set" heap methods 1 forged)
              (js-call assert :strictEqual (js-call r "allocator-protocol-native" heap record forged) (v64 0))))))
        ;; Close still reads return dynamically and keeps the already pending
        ;; undefined exception even though return throws false.
        (let* ((return-key (funcall text "return"))
               (thrower (funcall own (js-call r "allocator-described" heap 9002 0 0 0))))
          (js-call assert :strictEqual (js-call r "value-source-set-with-receiver" heap raw return-key thrower raw) (v64 2))
          (js-call r "value-throw" heap (v64 3))
          (js-call assert :strictEqual (js-call r "value-source-iterator-close" heap record 11) 0)
          (js-call assert :strictEqual (js-call r "last-error") 11)
          (js-call assert :strictEqual (js-call r "value-exception-take" heap) (v64 3))
          (js-call assert :strictEqual (js-call r "value-function-current-this" heap) (v64 3)))
        (allocator-property-finish f))))

  (test "exact u32 decimal text allocates only its result and retains all numeric fallback boundaries"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 2048 65536 1048576))
             (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
             (cases (js-array
               (js-array 0 "0" t) (js-array -0 "0" t)
               (js-array 1 "1" t) (js-array 9 "9" t) (js-array 10 "10" t)
               (js-array 99 "99" t) (js-array 100 "100" t)
               (js-array 1048575 "1048575" t) (js-array 1048576 "1048576" t)
               (js-array 2147483647 "2147483647" t) (js-array 2147483648 "2147483648" t)
               (js-array 4294967294 "4294967294" t) (js-array 4294967295 "4294967295" t)
               (js-array -1 "-1" false) (js-array -2147483648 "-2147483648" false)
               (js-array 4294967296 "4294967296" false)
               (js-array 0.5 "0.5" false) (js-array -0.5 "-0.5" false)
               (js-array 1e-7 "1e-7" false) (js-array 1e21 "1e+21" false)
               (js-array globalThis.NaN "NaN" false)
               (js-array globalThis.Infinity "Infinity" false)
               (js-array (- globalThis.Infinity) "-Infinity" false))))
        (js-call cases :forEach (lambda (entry)
          (js-call bits :setFloat64 0 (aref entry 0) t)
          (let ((input (js-call r "value-number" heap
                         (js-call bits :getUint32 0 t) (js-call bits :getUint32 4 t))))
            (js-call assert :strictEqual (js-call r "heap-pin" heap input) 1)
            (js-call r "allocator-reset-number-scratch")
            (let* ((before (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap))
                   (text (js-call r "allocator-number-text" heap input)))
              (js-call assert :strictEqual (js-call r "last-error") 0)
              (js-call assert :strictEqual (allocator-read-text r heap text) (aref entry 1))
              (js-call assert :strictEqual (js-call r "allocator-number-scratch-calls") (if (aref entry 2) 0 1))
              (when (aref entry 2)
                (js-call assert :strictEqual (- (js-call r "heap-live" heap) live) 1)
                (js-call assert :ok (<= (- (js-call r "heap-used" heap) before) 56)))
              (js-call assert :strictEqual (js-call r "heap-pin" heap text) 1)
              (let ((reference (js-call r "allocator-number-reference" heap input)))
                (js-call assert :strictEqual (allocator-read-text r heap reference) (aref entry 1)))
              (js-call r "heap-auto" heap 1)
              (let ((collected (js-call r "allocator-number-text" heap input)))
                (js-call assert :strictEqual (js-call r "last-error") 0)
                (js-call assert :strictEqual (allocator-read-text r heap collected) (aref entry 1)))
              (js-call r "heap-release" heap text))
            (js-call r "heap-release" heap input)
            (js-call r "heap-collect" heap)
            (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
            (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
            (js-call r "heap-auto" heap 0)))))))

  (test "well-known symbol hits use constant work and allocate nothing at a growing historical highwater"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 2048 65536 262144))
             (symbols (js-array)) (index 0))
        (while (< index 15)
          (let ((symbol (js-call r "value-symbol-well-known" heap index)))
            (js-call assert :ok (v64-ref-p symbol))
            (js-call assert :strictEqual (js-call r "heap-pin" heap symbol) 1)
            (js-call symbols :push symbol))
          (setq index (1+ index)))
        (setq index 0)
        (while (< index 1024)
          (js-call assert :ok (v64-ref-p (js-call r "value-bytes" heap 0)))
          (setq index (1+ index)))
        (let ((used (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap))
              (collections (js-call r "heap-collections" heap)) (round 0))
          (js-call r "allocator-reset-symbol-scans")
          (js-call r "heap-auto" heap 1)
          (while (< round 64)
            (setq index 0)
            (while (< index 15)
              (js-call assert :strictEqual (js-call r "value-symbol-well-known" heap index) (aref symbols index))
              (js-call assert :strictEqual (js-call r "last-error") 0)
              (setq index (1+ index)))
            (setq round (1+ round)))
          (js-call assert :strictEqual (js-call r "allocator-symbol-scans") 0)
          (js-call assert :strictEqual (js-call r "heap-used" heap) used)
          (js-call assert :strictEqual (js-call r "heap-live" heap) live)
          (js-call assert :strictEqual (js-call r "heap-collections" heap) collections))
        (js-call symbols :forEach (lambda (symbol) (js-call r "heap-release" heap symbol)))
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))

  (test "well-known symbol weak indexes validate expired generations and recover incorrect entries without changing canonical identity"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 128 8192 65536))
             (first (js-call r "value-symbol-well-known" heap 0)))
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (let* ((second (js-call r "value-symbol-well-known" heap 0))
               (other (js-call r "value-symbol-well-known" heap 1))
               (bytes (js-call r "value-bytes" heap 0)))
          (js-call assert :notStrictEqual first second)
          (js-call assert :strictEqual (js-call r "heap-pin" heap second) 1)
          (js-call assert :strictEqual (js-call r "heap-pin" heap other) 1)
          (js-call assert :strictEqual (js-call r "heap-pin" heap bytes) 1)
          (js-call (js-array first other bytes (v64 3) (invalid-v64)) :forEach (lambda (bad)
            (js-call r "allocator-symbol-cache-set" heap 0 bad)
            (js-call assert :strictEqual (js-call r "value-symbol-well-known" heap 0) second)
            (js-call assert :strictEqual (js-call r "last-error") 0)))
          (js-call assert :strictEqual (js-call r "value-symbol-well-known" heap 15) (v64 0))
          (js-call assert :strictEqual (js-call r "last-error") 3)
          (js-call (js-array second other bytes) :forEach (lambda (value) (js-call r "heap-release" heap value)))
          (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))))

  (test "well-known symbol indexes remain heap-local across independent heaps and collection with automatic safepoints"
    (lambda ()
      (let* ((r (fresh)) (a (js-call r "heap-new" 128 16384 65536))
             (b (js-call r "heap-new" 4096 131072 524288)) (index 0))
        (js-call (js-array a b) :forEach (lambda (heap)
          (js-call assert :ok (> heap 0))
          (js-call r "heap-auto" heap 1)
          (setq index 0)
          (while (< index 15)
            (let ((symbol (js-call r "value-symbol-well-known" heap index)))
              (js-call assert :ok (v64-ref-p symbol))
              (js-call assert :strictEqual (js-call r "heap-pin" heap symbol) 1)
              (js-call r "heap-collect" heap)
              (js-call r "allocator-reset-symbol-scans")
              (js-call assert :strictEqual (js-call r "value-symbol-well-known" heap index) symbol)
              (js-call assert :strictEqual (js-call r "allocator-symbol-scans") 0)
              (js-call assert :strictEqual (js-call r "heap-release" heap symbol) 1)
              (js-call r "heap-collect" heap)
              (js-call assert :strictEqual (js-call r "heap-live" heap) 0))
            (setq index (1+ index)))
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))))

  (test "own array Get reads current slots length and undefined without constructing public descriptors"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 256 16384 262144)) (roots (js-array))
             (own (lambda (raw)
               (setq raw (normalize-u64 raw))
               (js-call assert :ok (v64-ref-p raw)) (js-call assert :strictEqual (js-call r "heap-pin" heap raw) 1)
               (js-call roots :push raw) raw))
             (text (lambda (value)
               (let ((raw (funcall own (js-call r "value-string" heap (js-length value)))) (index 0))
                 (while (< index (js-length value))
                   (js-call assert :strictEqual (js-call r "value-unit-set" heap raw index (js-call value :charCodeAt index)) 1)
                   (setq index (1+ index)))
                 (js-call assert :strictEqual (js-call r "value-seal" heap raw) raw) raw))))
        (js-call r "heap-auto" heap 1)
        (let* ((array (funcall own (js-call r "value-array-new" heap 2)))
               (zero (funcall own (js-call r "value-number" heap 0 2147483648)))
               (first (funcall text "0")) (second (funcall text "1")) (length (funcall text "length"))
               (index 0))
          (js-call assert :strictEqual (js-call r "value-set" heap array 0 zero) 1)
          (js-call assert :strictEqual (js-call r "value-set" heap array 1 (v64 3)) 1)
          (js-call r "allocator-reset-descriptors")
          (while (< index 64)
            (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap array first array) zero)
            (js-call assert :strictEqual (js-call r "value-source-get-with-receiver" heap array second array) (v64 3))
            (let ((size (js-call r "value-source-get-with-receiver" heap array length array)))
              (js-call assert :strictEqual (js-call r "last-error") 0)
              (js-call assert :strictEqual (read-number r heap size) 2))
            (setq index (1+ index)))
          (js-call assert :strictEqual (js-call r "allocator-descriptors") 0)
          ;; Public reflection still creates the real descriptor; it is never
          ;; replaced by the allocation-free Get path or a synthetic answer.
          (let ((descriptor (js-call r "value-source-own-descriptor" heap array first)))
            (js-call assert :ok (v64-ref-p descriptor))
            (js-call assert :strictEqual (js-call r "last-error") 0)
            (js-call assert :strictEqual (js-call r "allocator-descriptors") 1))
          (js-call roots :forEach (lambda (raw) (js-call r "heap-release" heap raw)))
          (js-call r "heap-collect" heap)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))))

  (test "ordinary internal Array indices read and replace actual slots without temporary roots keys or collection"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 256 16384 262144))
             (array (js-call r "value-array-new" heap 3))
             (index (js-call r "value-number" heap 0 1072693248))
             (child (js-call r "value-array-new" heap 0)))
        (js-call (js-array array index child) :forEach (lambda (raw) (js-call r "heap-pin" heap raw)))
        (js-call r "value-set" heap array 0 (v64 0))
        (js-call r "value-set" heap array 1 (v64 1))
        (js-call r "value-set" heap array 2 (v64 3))
        (js-call r "heap-auto" heap 1)
        (let ((used (js-call r "heap-used" heap)) (live (js-call r "heap-live" heap))
              (collections (js-call r "heap-collections" heap)) (round 0))
          (while (< round 64)
            (js-call assert :strictEqual (js-call r "allocator-array-word" heap array 0 0 (v64 0)) (v64 0))
            (js-call assert :strictEqual (js-call r "allocator-array-index" heap array index 0 (v64 0)) (v64 1))
            (js-call assert :strictEqual (js-call r "allocator-array-word" heap array 2 0 (v64 0)) (v64 3))
            (js-call assert :strictEqual (js-call r "allocator-array-index" heap array index 1 (v64 0)) (v64 2))
            (js-call assert :strictEqual (js-call r "allocator-array-word" heap array 2 2 child) (v64 2))
            (js-call assert :strictEqual (js-call r "allocator-array-word" heap array 2 0 (v64 0)) child)
            (js-call assert :strictEqual (js-call r "allocator-array-word" heap array 2 3 (v64 0)) (v64 2))
            (js-call assert :strictEqual (js-call r "allocator-array-direct" heap array 2 0 (v64 0)) (v64 4))
            (js-call assert :strictEqual (js-call r "allocator-array-direct" heap array 3 0 (v64 0)) (v64 4))
            (js-call assert :strictEqual (js-call r "allocator-array-direct" heap array 4294967295 0 (v64 0)) (v64 4))
            (js-call assert :strictEqual (js-call r "allocator-array-word" heap array 2 4 (v64 3)) (v64 2))
            (js-call assert :strictEqual (js-call r "last-error") 0)
            (setq round (1+ round)))
          (js-call assert :strictEqual (js-call r "heap-used" heap) used)
          (js-call assert :strictEqual (js-call r "heap-live" heap) live)
          (js-call assert :strictEqual (js-call r "heap-collections" heap) collections)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))
        (js-call r "allocator-array-word" heap array 2 2 child)
        (js-call r "heap-release" heap child)
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "value-length" heap child) 0)
        (js-call assert :strictEqual (js-call r "last-error") 0)
        (js-call assert :strictEqual (js-call r "allocator-array-word" heap array 2 0 (v64 0)) child)
        (js-call r "heap-release" heap index)
        (js-call r "heap-release" heap array)
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))

  (test "fresh foreign tokens avoid slot scans while duplicates unordered tokens and collected generations keep canonical identity"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 1024 65536 262144))
             (values (js-array)) (index 0))
        (while (< index 512)
          (js-call assert :ok (v64-ref-p (js-call r "value-bytes" heap 0)))
          (setq index (1+ index)))
        (js-call r "allocator-reset-foreign-scans")
        (setq index 1)
        (while (<= index 64)
          (let ((raw (js-call r "value-foreign-new" heap index (% index 2))))
            (js-call assert :ok (v64-ref-p raw))
            (js-call assert :strictEqual (uint32 (js-call r "value-foreign-token" heap raw)) index)
            (js-call r "heap-pin" heap raw) (js-call values :push raw))
          (setq index (1+ index)))
        (js-call assert :strictEqual (js-call r "allocator-foreign-scans") 0)
        (js-call assert :strictEqual (control r heap :foreignTokenWatermark) 64)
        (js-call (js-array 2147483648 4294967295) :forEach (lambda (token)
          (js-call r "allocator-reset-foreign-scans")
          (let ((raw (js-call r "value-foreign-new" heap token 1)))
            (js-call assert :ok (v64-ref-p raw))
            (js-call r "heap-pin" heap raw) (js-call values :push raw)
            (js-call assert :strictEqual (uint32 (js-call r "value-foreign-token" heap raw)) token))
          (js-call assert :strictEqual (js-call r "allocator-foreign-scans") 0)))
        (js-call assert :strictEqual (uint32 (control r heap :foreignTokenWatermark)) 4294967295)
        ;; Existing token/subtype identity remains authoritative, including
        ;; callers presenting an unordered or differently classified token.
        (js-call assert :strictEqual (js-call r "value-foreign-new" heap 3 0) (aref values 2))
        (js-call assert :strictEqual (js-call r "value-foreign-subtype" heap (aref values 2)) 1)
        (let ((stale (aref values 1)))
          (js-call r "heap-release" heap stale)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 513)
          (js-call assert :strictEqual (js-call r "value-kind" heap stale) 0)
          (js-call assert :strictEqual (js-call r "last-error") 1)
          (let ((replacement (js-call r "value-foreign-new" heap 2 1)))
            (js-call assert :ok (v64-ref-p replacement))
            (js-call assert :notStrictEqual replacement stale)
            (js-call assert :strictEqual (js-call r "value-foreign-token" heap replacement) 2)
            (js-call assert :strictEqual (js-call r "value-foreign-subtype" heap replacement) 1)
            (js-call assert :strictEqual (js-call r "value-foreign-new" heap 2 0) replacement)
            (js-call r "heap-pin" heap replacement) (put values 1 replacement)))
        (js-call assert :strictEqual (js-call r "allocator-compact" heap) 1)
        (js-call assert :strictEqual (js-call r "value-foreign-new" heap 4294967295 0) (aref values 65))
        (js-call values :forEach (lambda (raw) (js-call r "heap-release" heap raw)))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 66)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))

  (test "foreign token watermark commits only successful allocations and remains private to each heap lifetime"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 2 4096 32768))
             (a (js-call r "value-foreign-new" heap 1 0))
             (b (js-call r "value-foreign-new" heap 2 1)))
        (js-call r "heap-pin" heap a) (js-call r "heap-pin" heap b)
        (js-call assert :strictEqual (js-call r "value-foreign-new" heap 3 0) (v64 0))
        (js-call assert :strictEqual (js-call r "last-error") 2)
        (js-call assert :strictEqual (control r heap :foreignTokenWatermark) 2)
        (js-call assert :strictEqual (js-call r "value-foreign-new" heap 2 0) b)
        (js-call r "heap-release" heap a)
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
        (js-call r "allocator-reset-foreign-scans")
        (let ((c (js-call r "value-foreign-new" heap 3 0)))
          (js-call assert :ok (v64-ref-p c))
          (js-call assert :notStrictEqual c a)
          (js-call r "heap-pin" heap c)
          (js-call assert :strictEqual (js-call r "allocator-foreign-scans") 0)
          (js-call assert :strictEqual (control r heap :foreignTokenWatermark) 3)
          (js-call (js-array (js-array 0 0) (js-array 4 2)) :forEach (lambda (bad)
            (js-call assert :strictEqual (js-call r "value-foreign-new" heap (aref bad 0) (aref bad 1)) (v64 0))
            (js-call assert :strictEqual (js-call r "last-error") 3)
            (js-call assert :strictEqual (control r heap :foreignTokenWatermark) 3)))
          (let* ((other (js-call r "heap-new" 2 4096 32768))
                 (value (js-call r "value-foreign-new" other 1 1)))
            (js-call assert :ok (v64-ref-p value))
            (js-call assert :strictEqual (control r other :foreignTokenWatermark) 1)
            (js-call assert :strictEqual (control r heap :foreignTokenWatermark) 3))
          (js-call r "heap-release" heap b) (js-call r "heap-release" heap c)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 2)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call r "retire")
          (js-call assert :strictEqual (js-call r "value-foreign-new" heap 4 0) (v64 0))
          (js-call assert :strictEqual (js-call r "last-error") 1)
          (let ((next (js-call r "heap-new" 2 4096 32768)))
            (js-call assert :strictEqual (control r next :foreignTokenWatermark) 0))))))

  (defun free-slot-queue (r heap)
    (let ((seen (new globalThis.Set)) (result (js-array)) (slot (control r heap :freeSlotHead)) (last 0))
      (while (/= slot 0)
        (js-call assert :ok (and (> slot 0) (<= slot (control r heap :highWater))))
        (js-call assert :strictEqual (js-call seen :has slot) false)
        (js-call seen :add slot) (js-call result :push slot)
        (js-call assert :strictEqual (slot-word r heap (+ (* slot 24) 4)) 0)
        (js-call assert :ok (< (slot-word r heap (* slot 24)) (control r heap :slotMask)))
        (setq last slot slot (slot-word r heap (+ (* slot 24) 20))))
      (js-call assert :strictEqual (control r heap :freeSlotTail) last) result))
  (defun retired-slots (r heap)
    (let ((slot 1) (retired 0))
      (while (<= slot (control r heap :highWater))
        (when (and (= (slot-word r heap (* slot 24)) 16777215)
                   (= (slot-word r heap (+ (* slot 24) 4)) 0))
          (setq retired (1+ retired)))
        (setq slot (1+ slot))) retired))

  (test "arena remaps charge coexistence while tail growth uses only the committed delta"
    (lambda ()
      ;; 4096 owns a 216-byte object arena at eight slots. The 4320 budget
      ;; permits its 216-byte tail increment, but not a non-tail copy whose
      ;; smallest viable payload is 272 bytes. At 4480 a clipped 384-byte
      ;; replacement fits even though the geometric 432-byte target does not.
      (js-call (js-array
          (js-array false 4320 432)
          (js-array t 4320 216)
          (js-array t 4480 384)) :forEach
        (lambda (scenario)
          (let* ((r (fresh)) (heap (js-call r "heap-new" 8 4096 (aref scenario 1)))
                 (root (js-call r "value-bytes" heap 8))
                 (_pin (js-call r "heap-pin" heap root))
                 (_write (js-call r "value-byte-set" heap root 0 173))
                 (base (js-call r "allocator-base" heap)) (used (js-call r "heap-used" heap))
                 (owned (js-call r "heap-capacity" heap)) (capacity (object-capacity r heap)))
            (js-call assert :strictEqual capacity 216)
            (when (aref scenario 0) (js-call r "string-new" 0))
            (let ((offset (js-call r "allocator-allocate" heap 224)))
              (if (= (aref scenario 2) capacity)
                (progn
                  (js-call assert :strictEqual offset 0)
                  (js-call assert :strictEqual (js-call r "last-error") 2)
                  (js-call assert :strictEqual (js-call r "allocator-base" heap) base)
                  (js-call assert :strictEqual (js-call r "heap-used" heap) used)
                  (js-call assert :strictEqual (js-call r "heap-capacity" heap) owned))
                (progn
                  (js-call assert :strictEqual (js-call r "last-error") 0)
                  (js-call assert :strictEqual offset used)
                  (js-call assert :strictEqual (js-call r "heap-capacity" heap)
                    (+ owned (- (aref scenario 2) capacity)))
                  (js-call assert :strictEqual (= (js-call r "allocator-base" heap) base)
                    (not (aref scenario 0)))
                  (js-call r "allocator-free" heap offset 224))))
            (js-call assert :strictEqual (object-capacity r heap) (aref scenario 2))
            (js-call assert :strictEqual (js-call r "value-byte-get" heap root 0) 173)
            (js-call assert :strictEqual (js-call r "allocator-root-count" heap root) 1)
            (js-call r "heap-release" heap root)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
            (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
            (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))))

  (test "slot and bitmap copy peaks reject before publishing and preserve reusable slots"
    (lambda ()
      ;; A 4096-byte heap starts with 14 slots and 72 object bytes. Fourteen
      ;; empty byte blocks grow the object arena to 576 bytes (4600 owned).
      ;; Replacing the slot/bitmap payloads needs 696+8 temporary bytes; its
      ;; final 336-byte delta alone would incorrectly fit the 5000 budget.
      (let* ((r (fresh)) (heap (js-call r "heap-new" 64 4096 5000))
             (values (js-array)) (index 0))
        (while (< index 14)
          (let ((value (js-call r "value-bytes" heap 0)))
            (js-call assert :ok (v64-ref-p value))
            (js-call r "heap-pin" heap value) (js-call values :push value))
          (setq index (1+ index)))
        (js-call assert :strictEqual (object-capacity r heap) 576)
        (js-call assert :strictEqual (js-call r "heap-capacity" heap) 4600)
        (let ((slots (control r heap :slotArena)) (bitmap (control r heap :bitmapArena))
              (used (js-call r "heap-used" heap)))
          (js-call assert :strictEqual (js-call r "value-bytes" heap 0) (v64 0))
          (js-call assert :strictEqual (js-call r "last-error") 2)
          (js-call assert :strictEqual (control r heap :slotArena) slots)
          (js-call assert :strictEqual (control r heap :bitmapArena) bitmap)
          (js-call assert :strictEqual (control r heap :slotCapacity) 14)
          (js-call assert :strictEqual (control r heap :highWater) 14)
          (js-call assert :strictEqual (js-call r "heap-capacity" heap) 4600)
          (js-call assert :strictEqual (js-call r "heap-used" heap) used))
        (js-call r "heap-release" heap (aref values 0))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
        (let ((recovered (js-call r "value-bytes" heap 0)))
          (js-call assert :strictEqual (v64-slot recovered) 1)
          (js-call assert :strictEqual (v64-gen recovered) 2)
          (js-call (js-call values :slice 1) :forEach (lambda (value)
            (js-call assert :strictEqual (js-call r "value-kind" heap value) 6)
            (js-call r "heap-release" heap value)))
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 14)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))))

  (test "unpublished slot arenas roll back when object remapping exceeds the shared copy peak"
    (lambda ()
      ;; At 4600 owned, the two table copies fit 5800, but leave only 496
      ;; bytes for a non-tail object copy which needs at least 584 bytes.
      (let* ((r (fresh)) (heap (js-call r "heap-new" 64 4096 5800))
             (values (js-array)) (index 0))
        (while (< index 14)
          (let ((value (js-call r "value-bytes" heap (if (= index 13) 96 0))))
            (js-call assert :ok (v64-ref-p value))
            (js-call r "heap-pin" heap value) (js-call values :push value))
          (setq index (1+ index)))
        (let* ((view (new globalThis.DataView (get (get r "memory") :buffer)))
               (slots (control r heap :slotArena)) (bitmap (control r heap :bitmapArena))
               (slot-data (js-call view :getUint32 (+ slots 16) t))
               (bitmap-data (js-call view :getUint32 (+ bitmap 16) t))
               (base (js-call r "allocator-base" heap)) (used (js-call r "heap-used" heap))
               (cursor nil) (attempt 0))
          (js-call assert :strictEqual used 552)
          (js-call assert :strictEqual (js-call r "heap-capacity" heap) 4600)
          (while (< attempt 2)
            (js-call assert :strictEqual (js-call r "value-bytes" heap 0) (v64 0))
            (js-call assert :strictEqual (js-call r "last-error") 2)
            (setq view (new globalThis.DataView (get (get r "memory") :buffer)))
            (js-call assert :strictEqual (js-call view :getUint32 (+ slots 16) t) slot-data)
            (js-call assert :strictEqual (js-call view :getUint32 (+ bitmap 16) t) bitmap-data)
            (js-call assert :strictEqual (control r heap :slotCapacity) 14)
            (js-call assert :strictEqual (control r heap :highWater) 14)
            (js-call assert :strictEqual (js-call r "allocator-base" heap) base)
            (js-call assert :strictEqual (js-call r "heap-capacity" heap) 4600)
            (js-call assert :strictEqual (js-call r "heap-used" heap) used)
            (js-call assert :strictEqual (js-call r "heap-live" heap) 14)
            (when cursor
              (js-call assert :strictEqual (js-call view :getUint32 0 t) cursor))
            (setq cursor (js-call view :getUint32 0 t))
            (setq attempt (1+ attempt)))
          (js-call r "heap-release" heap (aref values 13))
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          (let ((replacement (js-call r "value-bytes" heap 0)))
            (js-call r "heap-pin" heap replacement)
            (let ((extra (js-call r "value-bytes" heap 0)))
              (js-call assert :ok (v64-ref-p extra))
              (js-call assert :strictEqual (v64-slot extra) 15)
              (js-call assert :strictEqual (control r heap :slotCapacity) 28)
              (js-call assert :strictEqual (js-call r "heap-capacity" heap) 4936)
              (js-call (js-call values :slice 0 13) :forEach (lambda (value)
                (js-call assert :strictEqual (js-call r "value-kind" heap value) 6)
                (js-call r "heap-release" heap value)))
              (js-call r "heap-release" heap replacement)
              (js-call assert :strictEqual (js-call r "heap-collect" heap) 15)
              (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
              (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))))))

  (test "a failed second arena allocation releases the unpublished bitmap and preserves the original heap"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 2048 65536 16777216))
             (values (js-array)) (index 0))
        (while (< index 1024)
          (let ((value (js-call r "value-bytes" heap 0)))
            (js-call assert :ok (v64-ref-p value))
            (js-call r "heap-pin" heap value) (js-call values :push value))
          (setq index (1+ index)))
        (let* ((view (new globalThis.DataView (get (get r "memory") :buffer)))
               (slots (control r heap :slotArena)) (bitmap (control r heap :bitmapArena))
               (slot-data (js-call view :getUint32 (+ slots 16) t))
               (bitmap-data (js-call view :getUint32 (+ bitmap 16) t))
               (used (js-call r "heap-used" heap)) (owned (js-call r "heap-capacity" heap))
               ;; The existing image has maximumPages=32. Leave exactly the
               ;; new 2049-bit bitmap's aligned 264 bytes; its allocation
               ;; succeeds, but the subsequent 49176-byte slot table cannot.
               (space (- (* 32 65536) (js-call view :getUint32 0 t) 32 264))
               (blocker (js-call r "buffer-new" space)) (attempt 0))
          (js-call assert :ok (> blocker 0))
          (while (< attempt 2)
            (js-call assert :strictEqual (js-call r "value-bytes" heap 0) (v64 0))
            (js-call assert :strictEqual (js-call r "last-error") 2)
            (setq view (new globalThis.DataView (get (get r "memory") :buffer)))
            (js-call assert :strictEqual (js-call view :getUint32 (+ slots 16) t) slot-data)
            (js-call assert :strictEqual (js-call view :getUint32 (+ bitmap 16) t) bitmap-data)
            (js-call assert :strictEqual (js-call r "heap-used" heap) used)
            (js-call assert :strictEqual (js-call r "heap-capacity" heap) owned)
            (js-call assert :strictEqual (control r heap :slotCapacity) 1024)
            (js-call assert :strictEqual (control r heap :highWater) 1024)
            (js-call assert :strictEqual (js-call view :getUint32 0 t) (* 32 65536))
            (let ((free (js-call view :getUint32 92 t)))
              (js-call assert :ok (> free 0))
              (js-call assert :strictEqual (js-call view :getUint32 free t) 264))
            (setq attempt (1+ attempt)))
          (js-call r "heap-release" heap (aref values 0))
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          (let ((recovered (js-call r "value-bytes" heap 0)))
            (js-call assert :strictEqual (v64-slot recovered) 1)
            (js-call assert :strictEqual (v64-gen recovered) 2)
            (js-call (js-call values :slice 1) :forEach (lambda (value)
              (js-call assert :strictEqual (js-call r "value-kind" heap value) 6)
              (js-call r "heap-release" heap value)))
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 1024)
            (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
            (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))))

  (test "free slots append newly dead generations after older idle slots and survive growth and failure"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 8 4608 32768)) (_ (js-call r "string-new" 0)) (values (js-array)) (index 0))
        (while (< index 8)
          (let ((value (js-call r "value-bytes" heap 0)))
            (js-call assert :ok (v64-ref-p value))
            (js-call values :push value))
          (setq index (1+ index)))
        (js-call r "heap-pin" heap (aref values 1)) (js-call r "heap-pin" heap (aref values 4))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 6)
        (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 1 3 4 6 7 8))
        (let ((reused (js-call r "value-bytes" heap 0)))
          (js-call assert :strictEqual (v64-slot reused) 1)
          (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 3 4 6 7 8))
          (let ((used (js-call r "heap-used" heap)))
            (js-call assert :strictEqual (js-call r "value-bytes" heap 65536) (v64 0))
            (js-call assert :strictEqual (js-call r "last-error") 2)
            (js-call assert :strictEqual (js-call r "heap-used" heap) used)
            (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 3 4 6 7 8)))
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 3 4 6 7 8 1))
          (let* ((base (js-call r "allocator-base" heap)) (large (js-call r "value-bytes" heap 10000)))
            (js-call assert :ok (v64-ref-p large))
            (js-call assert :strictEqual (v64-slot large) 3)
            (js-call assert :notStrictEqual (js-call r "allocator-base" heap) base)
            (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 4 6 7 8 1))
            (js-call assert :strictEqual (js-call r "value-kind" heap reused) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)))
        (js-call r "heap-release" heap (aref values 1)) (js-call r "heap-release" heap (aref values 4))
        (js-call r "heap-collect" heap)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
        (js-call assert :strictEqual (js-length (free-slot-queue r heap)) 8))))

  (defun churn-slots (module expected-retired expected-capacity)
    (let* ((r (wrap-exports (get (new globalThis.WebAssembly.Instance module) :exports)))
           (heap (js-call r "heap-new" 32 8192 16384)) (frame (js-call r "frame-new" heap 32))
           (zero (js-call r "value-number" heap 0 4294410240)) (seeds (js-array)) (index 0))
      (js-call r "frame-set" heap frame 0 zero)
      (while (< index 16)
        (let ((value (js-call r "value-bytes" heap 0)))
          (js-call assert :ok (v64-ref-p value)) (js-call seeds :push value)
          (js-call r "allocator-slot-gen-set" heap (v64-slot value) 16773200))
        (setq index (1+ index)))
      (js-call assert :strictEqual (js-call r "heap-collect" heap) 16)
      (setq index 0)
      (while (< index 4096)
        (js-call assert :ok (v64-ref-p (js-call r "value-bytes" heap 0)))
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
        (setq index (1+ index)))
      (js-call assert :strictEqual (retired-slots r heap) expected-retired)
      (js-call assert :strictEqual (js-call r "heap-live" heap) 2)
      (js-call assert :strictEqual (js-call r "frame-get" heap frame 0) zero)
      (js-call assert :strictEqual (word r heap (+ (js-call r "allocator-offset" heap zero) 36)) 4294410240)
      (js-call assert :strictEqual (js-call r "value-kind" heap (aref seeds 15)) 0)
      (js-call assert :strictEqual (js-call r "last-error") 1)
      (setq index 0)
      (while (< index 30)
        (let ((value (js-call r "value-bytes" heap 0)) (error (js-call r "last-error")))
          (if (< index expected-capacity)
            (progn (js-call assert :ok (v64-ref-p value)) (js-call assert :strictEqual error 0)
              (js-call r "frame-set" heap frame (1+ index) value))
            (progn (js-call assert :strictEqual value (v64 0)) (js-call assert :strictEqual error 2))))
        (setq index (1+ index)))
      (js-call assert :strictEqual (js-call r "heap-live" heap) (+ 2 expected-capacity))
      (js-call assert :strictEqual (js-call r "frame-depth" heap) 1)
      (js-call r "frame-pop" heap frame) (js-call r "heap-collect" heap)
      (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
      (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))

  (test "FIFO preserves the full live slot capacity after temporary churn that retires a LIFO hotspot"
    (lambda ()
      ;; Identical 32 slots/bytes/input/GC schedule. The former LIFO policy
      ;; loses one slot despite fifteen older idle seed slots. FIFO rotates
      ;; these generations and still admits the original full live peak.
      (churn-slots lifo-image 1 29)
      (churn-slots image 0 30)) 30000)

  (test "a sole reusable slot still retires permanently at generation 16777215 without ABA"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 1 4096 8192))
             (first (js-call r "value-bytes" heap 0)) (last (v64 0)) (index 0))
        (js-call assert :strictEqual (v64-slot first) 1)
        (js-call assert :strictEqual (v64-gen first) 1)
        (js-call r "allocator-slot-gen-set" heap 1 16773120)
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
        (while (< index 4095)
          (setq last (js-call r "value-bytes" heap 0))
          (js-call assert :strictEqual (v64-slot last) 1)
          (js-call assert :strictEqual (v64-gen last) (+ 16773121 index))
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          (setq index (1+ index)))
        (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array))
        (js-call assert :strictEqual (js-call r "value-bytes" heap 0) (v64 0))
        (js-call assert :strictEqual (js-call r "last-error") 2)
        (js-call assert :strictEqual (js-call r "value-kind" heap first) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (js-call assert :strictEqual (js-call r "value-kind" heap last) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))) 30000)

  (test "unified 24-bit layout reuses older FIFO slots before growing highwater and preserves byte-failure rollback"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 4 4608 16384))
             (mask (control r heap :slotMask)) (first (js-call r "value-bytes" heap 0)))
        (js-call assert :strictEqual (control r heap :slotBits) 24)
        (js-call assert :strictEqual mask 16777215)
        (js-call assert :strictEqual (v64-gen first) 1)
        (js-call assert :strictEqual (v64-slot first) 1)
        (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
        ;; A byte-capacity failure must not consume a fresh slot or unlink
        ;; the older reusable entry before its allocation actually succeeds.
        (let ((used (js-call r "heap-used" heap)))
          (js-call assert :strictEqual (js-call r "value-bytes" heap 65536) (v64 0))
          (js-call assert :strictEqual (js-call r "last-error") 2)
          (js-call assert :strictEqual (js-call r "heap-used" heap) used)
          (js-call assert :strictEqual (control r heap :highWater) 1)
          (js-call assert :deepStrictEqual (free-slot-queue r heap) (js-array 1)))
        (let ((again (js-call r "value-bytes" heap 0)))
          (js-call assert :strictEqual (v64-slot again) 1)
          (js-call assert :strictEqual (v64-gen again) 2)
          (js-call assert :strictEqual (control r heap :highWater) 1)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1))
        (let ((held (js-array)) (slot 1))
          (while (<= slot 4)
            (let ((value (js-call r "value-bytes" heap 0)))
              (js-call assert :strictEqual (v64-slot value) slot)
              (js-call assert :strictEqual (v64-gen value) (if (= slot 1) 3 1))
              (js-call r "heap-pin" heap value) (js-call held :push value))
            (setq slot (1+ slot)))
          (js-call assert :strictEqual (control r heap :highWater) 4)
          (js-call assert :strictEqual (js-call r "value-bytes" heap 0) (v64 0))
          (js-call assert :strictEqual (js-call r "last-error") 2)
          (js-call assert :strictEqual (js-call r "heap-live" heap) 4)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
          (let ((stale (aref held 0)))
            (js-call r "heap-release" heap stale)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
            (let ((recovered (js-call r "value-bytes" heap 0)))
              (js-call assert :strictEqual (v64-slot recovered) 1)
              (js-call assert :strictEqual (v64-gen recovered) 4)
              (js-call assert :notStrictEqual recovered stale)
              (js-call assert :strictEqual (js-call r "value-kind" heap stale) 0)
              (js-call assert :strictEqual (js-call r "last-error") 1)
              (js-call assert :strictEqual (js-call r "value-kind" heap recovered) 6)))
          (js-call (js-call held :slice 1) :forEach (lambda (value) (js-call r "heap-release" heap value)))
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 4))
        (js-call assert :strictEqual (js-call r "value-kind" heap first) 0)
        (js-call assert :strictEqual (js-call r "last-error") 1)
        (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
        (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))

  (test "unified 24-bit heap enforces constructor bounds and single-object 256MiB ceiling"
    (lambda ()
      (let ((r (extended-fresh)))
        (js-call (js-array
                  (js-array 0 4096 8192)
                  (js-array 16777216 268435456 536870912)
                  (js-array 8 4096 1073741825)
                  (js-array 8 4096 2048)
                  (js-array 8 3775 8192)) :forEach (lambda (parameters)
          (js-call assert :strictEqual
            (js-call r "heap-new" (aref parameters 0) (aref parameters 1) (aref parameters 2)) 0)
          (js-call assert :strictEqual (js-call r "last-error") 3)))
        (let ((ordinary (js-call r "heap-new" 8 4096 8192))
              (large (js-call r "heap-new" 8 4096 1073741824)))
          (js-call (js-array ordinary large) :forEach (lambda (heap)
            (js-call assert :ok (> heap 0))
            (js-call assert :strictEqual (control r heap :slotBits) 24)
            (js-call assert :strictEqual (uint32 (control r heap :slotMask)) 16777215)
            (js-call assert :strictEqual (control r heap :slotMask) 16777215)
            (let ((value (js-call r "value-bytes" heap 0))
                  (used (js-call r "heap-used" heap)))
              (js-call assert :strictEqual (v64-slot value) 1)
              (js-call assert :strictEqual (v64-gen value) 1)
              (js-call assert :strictEqual (js-call r "value-bytes" heap 268435417) (v64 0))
              (js-call assert :strictEqual (js-call r "last-error") 2)
              (js-call assert :strictEqual (js-call r "heap-used" heap) used)
              (js-call assert :strictEqual (js-call r "value-kind" heap value) 6)
              (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
              (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
              (js-call assert :strictEqual (js-call r "frame-depth" heap) 0))))
          (js-call assert :strictEqual (control r ordinary :maxBytes) 8192)
          (js-call assert :strictEqual (control r large :maxBytes) 1073741824)
          (js-call r "retire")
          (js-call assert :strictEqual (js-call r "heap-live" large) 0)
          (js-call assert :strictEqual (js-call r "last-error") 1)
          (let ((next (js-call r "heap-new" 8 4096 8192)))
            (js-call assert :ok (v64-ref-p (js-call r "value-bytes" next 0)))
            (js-call assert :strictEqual (js-call r "heap-collect" next) 1)
            (js-call assert :strictEqual (js-call r "heap-live" next) 0))))))

  (test "24-bit generation ceiling retires without wrap and preserves weak named identities across multi-million maxSlots"
    (lambda ()
      (js-call (js-array (js-array 1048576 65536)
                         (js-array 4194304 65536)
                         (js-array 16777215 65536)) :forEach (lambda (profile)
        (let* ((r (extended-fresh))
               (public-heap (js-call r "heap-new" (aref profile 0) (aref profile 1) 134217728))
               (heap (js-call r "heap-new" 1 4096 8192))
               (first (js-call r "value-bytes" heap 0)) (last (v64 0)) (index 0))
          (js-call assert :ok (> public-heap 0))
          (js-call assert :strictEqual (control r public-heap :maxSlotsCeiling) (aref profile 0))
          (js-call assert :strictEqual (control r public-heap :slotBits) 24)
          (js-call assert :strictEqual (control r public-heap :slotMask) 16777215)
          (js-call assert :ok (> heap 0))
          (js-call r "allocator-slot-gen-set" heap 1 16776704)
          (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
          (while (< index 511)
            (setq last (js-call r "value-bytes" heap 0))
            (js-call assert :strictEqual (v64-gen last) (+ 16776705 index))
            (js-call assert :strictEqual (v64-slot last) 1)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
            (setq index (1+ index)))
          (js-call assert :strictEqual (slot-word r heap 24) 16777215)
          (js-call assert :strictEqual (slot-word r heap 28) 0)
          (js-call assert :strictEqual (control r heap :freeSlotHead) 0)
          (js-call assert :strictEqual (control r heap :freeSlotTail) 0)
          (js-call assert :strictEqual (js-call r "value-bytes" heap 0) (v64 0))
          (js-call assert :strictEqual (js-call r "last-error") 2)
          (js-call (js-array first last) :forEach (lambda (stale)
            (js-call assert :strictEqual (js-call r "value-kind" heap stale) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)))
          (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
          (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)
          ;; Reserve slot one, so weak named identity/reuse exercises slot two
          ;; independently of retirement.
          (setq heap (js-call r "heap-new" 2 4608 8192))
          (let* ((blocker (js-call r "value-bytes" heap 0))
                 (pin (js-call r "heap-pin" heap blocker))
                 (named (js-call r "value-function-named" heap 4294967295)))
            (js-call assert :strictEqual pin 1)
            (js-call assert :strictEqual (v64-gen named) 1)
            (js-call assert :strictEqual (v64-slot named) 2)
            (js-call r "heap-pin" heap named)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 0)
            (js-call assert :strictEqual (js-call r "allocator-compact" heap) 1)
            (js-call r "allocator-reset-named-scans")
            (js-call assert :strictEqual
              (js-call r "value-function-named" heap 4294967295) named)
            (js-call assert :strictEqual (js-call r "allocator-named-scans") 0)
            (js-call assert :strictEqual (uint32 (js-call r "value-function-code" heap named)) 4294967295)
            (js-call r "heap-release" heap named)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 1)
            (js-call assert :strictEqual (js-call r "value-kind" heap named) 0)
            (js-call assert :strictEqual (js-call r "last-error") 1)
            (let ((again (js-call r "value-function-named" heap 4294967295)))
              (js-call assert :notStrictEqual again named)
              (js-call assert :strictEqual (v64-gen again) 2)
              (js-call assert :strictEqual (v64-slot again) 2))
            (js-call r "heap-release" heap blocker)
            (js-call assert :strictEqual (js-call r "heap-collect" heap) 2)
            (js-call assert :strictEqual (js-call r "heap-live" heap) 0)
            (js-call assert :strictEqual (js-call r "frame-depth" heap) 0)))))) 30000)

  (test "single-spec 24-bit heaps keep elastic initial bytes across multi-million slot ceilings"
    (lambda ()
      (js-call (js-array (js-array 1048575 65536 1073741824)
                         (js-array 1048576 65536 1073741824)
                         (js-array 4194304 131072 268435456)
