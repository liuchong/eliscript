  (test "named weak buckets retain colliding canonical identities without repeat whole-slot scans"
    (lambda ()
      (let* ((r (fresh)) (heap (js-call r "heap-new" 1024 32768 131072))
             (frame (js-call r "frame-new" heap 67)) (functions (js-array)) (index 0))
