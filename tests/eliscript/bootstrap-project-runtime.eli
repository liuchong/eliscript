(module tests.bootstrap-project-runtime
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp mkdir readFile writeFile rm symlink link access)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:crypto" createHash)
  (import "node:child_process" spawnSync)
  (import "../bootstrap/host/project.mjs" buildProject checkProject)
  (import "../bootstrap/host/project-legacy.mjs" :as legacy)
  (import "../bootstrap/host/evaluation.mjs" EvaluationSession)
  (import "../bootstrap/host/bun.mjs" loadCompiler)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/backends/compiler-matrix.mjs" loadCompilerMatrixCorpus)

  (defconst capsules (js-array "math" "prelude" "unicode-case" "unicode-case-data"))
  (defun digest (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun deployment-temp-root ()
    ;; These cases exercise deployment into a consumer outside the provider
    ;; package. A browser fixture preload must not turn that consumer into
    ;; this checkout's own package scope and suppress the deployment under test.
    (let* ((environment (get globalThis.process :env))
           (saved (js-call (js-array "TMPDIR" "TMP" "TEMP") :map
             (lambda (name) (js-array name (Object/hasOwn environment name) (get environment name))))))
      (try
        (js-call saved :forEach (lambda (entry) (Reflect/deleteProperty environment (aref entry 0))))
        (tmpdir)
        (finally (js-call saved :forEach (lambda (entry)
          (if (aref entry 1) (put environment (aref entry 0) (aref entry 2))
            (Reflect/deleteProperty environment (aref entry 0)))))))))
  (defasync workspace (run)
    (let ((directory (await (mkdtemp (resolve (deployment-temp-root) "eliscript-project-runtime-")))))
      (try (await (funcall run directory))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (test "deployment fixtures retain an independent consumer scope and preserve preloaded temporary environment"
    (async ()
      (let* ((environment (get globalThis.process :env))
             (before (js-call (js-array "TMPDIR" "TMP" "TEMP") :map
               (lambda (name) (js-array name (Object/hasOwn environment name) (get environment name)))))
             (directory (deployment-temp-root)))
        (js-call assert :notEqual directory (resolve root ".eliscript-cache/test-fixtures"))
        (js-call assert :strictEqual (js-call directory :startsWith (str root "/")) false)
        (js-call assert :deepStrictEqual
          (js-call (js-array "TMPDIR" "TMP" "TEMP") :map
            (lambda (name) (js-array name (Object/hasOwn environment name) (get environment name)))) before)
        (let ((maintained (await (readFile (resolve root "tools/project/project-cli.eli") "utf8")))
              (contract (JSON/parse (await (readFile (resolve root "contracts/public-surface.json") "utf8")))))
          (js-call assert :ok (js-call maintained :includes "(import \"./project-cli-legacy.mjs\" :as legacy)"))
          (js-call assert :ok (js-call maintained :includes "(defconst parseArguments (get legacy :parseArguments))"))
          (js-call assert :strictEqual
            (get (js-call (get contract :commands) :find (lambda (command) (= (get command :name) "eliscript-build"))) :implementation)
            "bootstrap/host/project-cli-legacy.mjs")))))
  (defasync fixture (directory)
    (let ((source-root (resolve directory "source")))
      (await (mkdir source-root))
      (await (writeFile (resolve source-root "helper.eli") "(defconst answer 42)\n(export answer)\n"))
      (await (writeFile (resolve source-root "main.eli") "(import \"./helper.eli\" answer)\n(print answer)\n"))
      (js-object :root source-root :entry (resolve source-root "main.eli")
        :moduleDirectory (resolve root "dist/bootstrap") :useCache t)))
  (defasync authenticated-runtime (out-dir)
    (let* ((package-root (resolve out-dir "node_modules/eliscript"))
           (metadata (JSON/parse (await (readFile (resolve package-root "eliscript-runtime.json") "utf8"))))
           (scope (JSON/parse (await (readFile (resolve package-root "package.json") "utf8")))))
      (js-call assert :strictEqual (get metadata :format) "eliscript-project-runtime")
      (js-call assert :strictEqual (get metadata :version) 1)
      (js-call assert :strictEqual (get scope :name) "eliscript")
      (js-call assert :strictEqual (get scope :type) "module")
      (js-call assert :strictEqual (get scope :private) t)
      (js-call assert :deepStrictEqual (get scope :exports)
        (js-object "./runtime/math.mjs" "./runtime/math.mjs"
          "./runtime/prelude.mjs" "./runtime/prelude.mjs"
          "./runtime/unicode-case.mjs" "./runtime/unicode-case.mjs"
          "./runtime/unicode-case-data.mjs" "./runtime/unicode-case-data.mjs"))
      (js-call assert :strictEqual (js-length (get metadata :capsules)) 4)
      (let ((index 0))
        (while (< index 3)
          (let* ((name (aref capsules index)) (record (aref (get metadata :capsules) index))
                 (source-path (str "runtime/" name ".eli"))
                 (module-path (str "runtime/" name ".mjs")) (map-path (str module-path ".map"))
                 (source (await (readFile (resolve root source-path))))
                 (module (await (readFile (resolve root module-path))))
                 (map (await (readFile (resolve root map-path)))))
            (js-call assert :deepStrictEqual record
              (js-object :source (js-object :path source-path :bytes (js-length source) :sha256 (digest source))
                :module (js-object :path module-path :bytes (js-length module) :sha256 (digest module))
                :sourceMap (js-object :path map-path :bytes (js-length map) :sha256 (digest map))))
            (js-call assert :deepStrictEqual (await (readFile (resolve package-root module-path))) module)
            (js-call assert :deepStrictEqual (await (readFile (resolve package-root map-path))) map)
            (js-call assert :deepStrictEqual (get (JSON/parse (js-call map :toString "utf8")) :sourcesContent)
              (js-array (js-call source :toString "utf8"))))
          (setq index (1+ index)))) metadata))
  (defun execute (command path)
    (let ((result (spawnSync command (js-array path) (js-object :encoding "utf8"))))
      (js-call assert :strictEqual (get result :error) undefined)
      (js-call assert :strictEqual (get result :signal) nil)
      (js-call assert :strictEqual (get result :status) 0 (get result :stderr))
      (js-call (get result :stdout) :trim)))

  (test "project virtual sources retain original manifest and maps while real Node and Bun resolve the authenticated default runtime"
    (async () (await (workspace (async (directory)
      (let* ((options (await (fixture directory))) (out-dir (resolve directory "output"))
             (virtual "(import \"./helper.eli\" answer)\n(print (+ answer 1))\n")
             (overrides (js-object))
             (before (await (readFile (get options :entry)))))
        (put overrides (get options :entry) virtual)
        (let* ((request (Object/assign (js-object) options (js-object :sourceOverrides overrides :outDir out-dir)))
               (actual (await (buildProject request)))
               (original (await (js-call legacy :buildProject (Object/assign (js-object) request
                 (js-object :outDir (resolve directory "original")))))))
          (js-call assert :strictEqual (get (get (get actual :report) :cache) :enabled) false)
          (js-call assert :deepStrictEqual (await (readFile (get actual :manifest))) (await (readFile (get original :manifest))))
          (let ((index 0))
            (while (< index (js-length (get actual :modules)))
              (let ((left (aref (get actual :modules) index)) (right (aref (get original :modules) index)))
                (js-call assert :strictEqual (get left :sourceDigest) (get right :sourceDigest))
                (js-call assert :deepStrictEqual (await (readFile (get left :output))) (await (readFile (get right :output))))
                (js-call assert :deepStrictEqual (await (readFile (get left :sourceMap))) (await (readFile (get right :sourceMap)))))
              (setq index (1+ index))))
          (await (authenticated-runtime out-dir))
          (js-call assert :strictEqual (execute (get (get globalThis.process :env) :NODE_BINARY "node") (get actual :entryOutput)) "43")
          (js-call assert :strictEqual (execute (get (get globalThis.process :env) :BUN "bun") (get actual :entryOutput)) "43")
          (js-call assert :deepStrictEqual (await (readFile (get options :entry))) before)
          (js-call assert :deepStrictEqual (get (JSON/parse (await (readFile (str (get actual :entryOutput) ".map") "utf8"))) :sourcesContent)
            (js-array virtual))
          (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
                 (document (get corpus :document))
                 (records (js-call (get corpus :records) :filter (lambda (record)
                   (js-call (js-array "tests/bootstrap-project.test.mjs" "tests/bootstrap-evaluation.test.mjs")
                     :includes (get (get record :original (js-object)) :suite)))))
                 (files (js-array "bootstrap/host/project.mjs" "bootstrap/host/project-legacy.mjs" "tools/project/project.eli"
                   "bootstrap/host/project-cli.mjs" "bootstrap/host/project-cli.mjs.map"
                   "bootstrap/host/project-cli-legacy.mjs" "tools/project/project-cli.eli")))
            (js-call assert :ok (> (js-length records) 0))
            (js-call assert :strictEqual (digest (await (readFile (resolve root "bootstrap/host/project-cli-legacy.mjs"))))
              "79980b2a6e38e4ab9daca31b04cb366bd749b66e3b384fbd04e696ddc465cd82")
            (js-call capsules :forEach (lambda (name)
              (js-call files :push (str "runtime/" name ".eli") (str "runtime/" name ".mjs") (str "runtime/" name ".mjs.map"))))
            (let ((index 0))
              (while (< index (js-length files))
                (let* ((filename (aref files index)) (bytes (await (readFile (resolve root filename))))
                       (asset (js-call (get document :evidence) :find (lambda (item) (= (get item :file) filename)))))
                  (js-call assert :strictEqual (get asset :bytes) (js-length bytes))
                  (js-call assert :strictEqual (get asset :sha256) (digest bytes))
                  (js-call records :forEach (lambda (record)
                    (js-call assert :deepStrictEqual (js-call (get (get record :original) :sourceAssets) :filter
                      (lambda (proof) (= (get proof :file) filename)))
                      (js-array (js-object :file filename :sourceSha256 (digest bytes)))))))
                (setq index (1+ index))))))))))))

  (test "project cache reuses original products and leaves the user's independent package scope unchanged"
    (async () (await (workspace (async (directory)
      (let* ((options (await (fixture directory))) (out-dir (resolve directory "output"))
             (user-scope "{\"name\":\"a-user-project\",\"type\":\"module\",\"private\":true}\n")
             (request (Object/assign (js-object) options (js-object :outDir out-dir))))
        (await (mkdir out-dir)) (await (writeFile (resolve out-dir "package.json") user-scope))
        (let* ((first (await (buildProject request)))
               (support (await (readFile (resolve out-dir "node_modules/eliscript/eliscript-runtime.json"))))
               (second (await (buildProject request))))
          (js-call assert :strictEqual (get first :digest) (get second :digest))
          (js-call assert :strictEqual (get (get (get second :report) :counts) :reused) 2)
          (js-call assert :strictEqual (await (readFile (resolve out-dir "package.json") "utf8")) user-scope)
          (js-call assert :deepStrictEqual (await (readFile (resolve out-dir "node_modules/eliscript/eliscript-runtime.json"))) support)
          (await (authenticated-runtime out-dir))
          (js-call assert :strictEqual (execute (get (get globalThis.process :env) :NODE_BINARY "node") (get second :entryOutput)) "42"))))))))

  (test "project runtime refuses each changed module or map and a conflicting scope without overwriting original bytes"
    (async () (await (workspace (async (directory)
      (let* ((options (await (fixture directory))) (paths (js-array "package.json")))
        (js-call capsules :forEach (lambda (name)
          (js-call paths :push (str "runtime/" name ".mjs") (str "runtime/" name ".mjs.map"))))
        (let ((index 0))
          (while (< index (js-length paths))
            (let* ((out-dir (resolve directory (str "output-" index)))
                   (request (Object/assign (js-object) options (js-object :outDir out-dir))))
              (await (buildProject request))
              (let* ((path (resolve out-dir "node_modules/eliscript" (aref paths index)))
                     (changed "user-owned conflicting bytes\n"))
                (await (writeFile path changed))
                (await (js-call assert :rejects (buildProject request) (lambda (error)
                  (and (= (get (get error :eliscriptDiagnostic) :code) "ELI-B0001")
                    (= (get (get error :eliscriptDiagnostic) :phase) "project-build")
                    (= (get error :message) (str "project runtime support conflicts with existing output: " (aref paths index)))))))
                (js-call assert :strictEqual (await (readFile path "utf8")) changed)))
            (setq index (1+ index))))))))))

  (test "project runtime cannot follow an output package symlink or silently substitute a missing deployed dependency"
    (async () (await (workspace (async (directory)
      (let* ((options (await (fixture directory))) (out-dir (resolve directory "output"))
             (outside (resolve directory "outside"))
             (request (Object/assign (js-object) options (js-object :outDir out-dir))))
        (await (mkdir (resolve out-dir "node_modules") (js-object :recursive t)))
        (await (mkdir outside)) (await (writeFile (resolve outside "sentinel") "preserved"))
        (await (symlink outside (resolve out-dir "node_modules/eliscript") "dir"))
        (await (js-call assert :rejects (buildProject request) (lambda (error)
          (= (get error :message) "project runtime support contains a symlink: node_modules/eliscript"))))
        (js-call assert :strictEqual (await (readFile (resolve outside "sentinel") "utf8")) "preserved")
        (await (js-call assert :rejects (access (resolve outside "package.json"))))
        (let* ((normal (resolve directory "normal"))
               (actual (await (buildProject (Object/assign (js-object) options (js-object :outDir normal))))))
          (await (rm (resolve normal "node_modules/eliscript/runtime/unicode-case-data.mjs")))
          (let ((child (spawnSync (get (get globalThis.process :env) :NODE_BINARY "node")
                         (js-array (get actual :entryOutput)) (js-object :encoding "utf8"))))
            (js-call assert :notStrictEqual (get child :status) 0)
            (js-call assert :ok (js-call (get child :stderr) :includes "unicode-case-data.mjs")))
          (await (buildProject (Object/assign (js-object) options (js-object :outDir normal))))
          (await (authenticated-runtime normal))
          (js-call assert :strictEqual (execute (get (get globalThis.process :env) :NODE_BINARY "node")
            (get actual :entryOutput)) "42")
          (let* ((alias-output (resolve directory "alias"))
                 (alias (resolve alias-output "node_modules/eliscript/runtime/math.mjs"))
                 (source (resolve root "runtime/math.mjs"))
                 (before (await (readFile source))))
            (await (mkdir (resolve alias-output "node_modules/eliscript/runtime") (js-object :recursive t)))
            (await (link source alias))
            (await (js-call assert :rejects (buildProject (Object/assign (js-object) options
              (js-object :outDir alias-output))) (lambda (error)
                (= (get error :message) "project runtime output aliases a source: runtime/math.mjs"))))
            (js-call assert :deepStrictEqual (await (readFile source)) before)
            (js-call assert :deepStrictEqual (await (readFile alias)) before)
            (await (js-call assert :rejects (access (resolve alias-output "node_modules/eliscript/package.json"))))))))))))

  (test "project facade keeps the original checker identity and original option getter first failure"
    (async () (await (workspace (async (directory)
      (js-call assert :strictEqual checkProject (get legacy :checkProject))
      (let* ((first (js-object :original t)) (options (js-object))
             (out-dir (resolve directory "never-created")) (reads (js-array)))
        (Object/defineProperty options "entry" (js-object :get (lambda ()
          (js-call reads :push "entry") (throw first))))
        (Object/defineProperty options "outDir" (js-object :get (lambda ()
          (js-call reads :push "outDir") out-dir)))
        (await (js-call assert :rejects (buildProject options) (lambda (error) (eq error first))))
        (js-call assert :deepStrictEqual reads (js-array "entry"))
        (await (js-call assert :rejects (access out-dir)))))))))

  (test "a project reuses the genuine parent runtime package without shadowing persistent literal exports in Node and Bun"
    (async () (await (workspace (async (directory)
      (let* ((options (await (fixture directory))) (session (resolve directory "session"))
             (out-dir (resolve session "namespace-1")) (package (await (readFile (resolve root "package.json"))))
             (source "(js-call globalThis.console :log (length [1 1]))\n"))
        (await (mkdir (resolve session "node_modules") (js-object :recursive t)))
        (await (symlink root (resolve session "node_modules/eliscript") "dir"))
        (await (writeFile (get options :entry) source))
        (let ((result (await (buildProject (Object/assign (js-object) options (js-object :outDir out-dir))))))
          (js-call assert :strictEqual (execute (get (get globalThis.process :env) :NODE_BINARY "node") (get result :entryOutput)) "2")
          (js-call assert :strictEqual (execute (get (get globalThis.process :env) :BUN "bun") (get result :entryOutput)) "2")
          (await (js-call assert :rejects (access (resolve out-dir "node_modules/eliscript"))))
          (js-call assert :deepStrictEqual (await (readFile (resolve session "node_modules/eliscript/package.json"))) package))))))))

  (test "the original evaluation fixture retains persistent values and shared runtime identity after project loading"
    (async ()
      (let* ((compiler (await (loadCompiler (resolve root "dist/bootstrap"))))
             (session (await (js-call EvaluationSession :create (js-object :compiler compiler))))
             (filename (resolve root "tests/fixtures/evaluation-session/main.eli")))
        (try
          (let ((loaded (await (js-call session :execute (js-object :id 1 :operation "load"
                         :source (await (readFile filename "utf8")) :filename filename :root root)))))
            (js-call assert :strictEqual (get loaded :status) "ok" (JSON/stringify loaded))
            (js-call assert :strictEqual (get loaded :revision) 1)
            (js-call assert :strictEqual (get loaded :stdout) "evaluation fixture loaded\n"))
          (let ((current (await (js-call session :execute (js-object :id 2 :operation "evaluate" :source "(current)" :filename filename)))))
            (js-call assert :strictEqual (get current :status) "ok")
            (js-call assert :strictEqual (get current :value) "[1 1]"))
          (let ((bumped (await (js-call session :execute (js-object :id 3 :operation "evaluate" :source "(bump)" :filename filename)))))
            (js-call assert :strictEqual (get bumped :status) "ok")
            (js-call assert :strictEqual (get bumped :value) "2"))
          (let ((current (await (js-call session :execute (js-object :id 4 :operation "evaluate" :source "(current)" :filename filename)))))
            (js-call assert :strictEqual (get current :status) "ok")
            (js-call assert :strictEqual (get current :value) "[2 1]"))
          (finally (await (js-call session :close)))))))

  (test "equal runtime bytes at another package URL do not replace canonical provider identity"
    (async () (await (workspace (async (directory)
      (let* ((options (await (fixture directory))) (session (resolve directory "session"))
             (foreign (resolve session "node_modules/eliscript")) (out-dir (resolve session "namespace-1"))
             (foreign-package "{\"name\":\"eliscript\",\"type\":\"module\",\"exports\":{\"./runtime/*\":\"./runtime/*\"}}\n"))
        (await (mkdir (resolve foreign "runtime") (js-object :recursive t)))
        (await (writeFile (resolve foreign "package.json") foreign-package))
        (let ((index 0))
          (while (< index (js-length capsules))
            (let ((name (aref capsules index)))
              (await (writeFile (resolve foreign (str "runtime/" name ".mjs"))
                (await (readFile (resolve root (str "runtime/" name ".mjs"))))))
              (await (writeFile (resolve foreign (str "runtime/" name ".mjs.map"))
                (await (readFile (resolve root (str "runtime/" name ".mjs.map")))))))
            (setq index (1+ index))))
        (let ((result (await (buildProject (Object/assign (js-object) options (js-object :outDir out-dir))))))
          (await (authenticated-runtime out-dir))
          (js-call assert :strictEqual (execute (get (get globalThis.process :env) :NODE_BINARY "node") (get result :entryOutput)) "42")
          (js-call assert :strictEqual (await (readFile (resolve foreign "package.json") "utf8")) foreign-package))))))))
)
