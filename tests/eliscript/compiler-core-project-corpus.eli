(module tests.compiler-core-project-corpus
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp mkdir readFile writeFile readdir copyFile rm realpath lstat symlink)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:module" createRequire)
  (import "node:crypto" createHash)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/backends/compiler-matrix.mjs" loadOriginalCompilerManifests)
  (import "../tools/backends/compiler-corpus.mjs" loadOriginalCompilerCorpus compilerCorpusRequest)
  (import "../tools/backends/compiler-corpus-project-transport.mjs" buildProject)
  (import "../tools/backends/compiler-corpus-execution.mjs"
    prepareCompilerCorpusNativeProviders executeCompilerCorpusRecord)

  (defun hash (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defasync directory-hash (directory)
    (let* ((names (js-call (await (readdir directory)) :filter
                    (lambda (name) (or (js-call name :endsWith ".mjs") (js-call name :endsWith ".mjs.map")))))
           (digest (createHash "sha256")) (index 0))
      (js-call names :sort)
      (while (< index (js-length names))
        (let ((name (aref names index)))
          (js-call digest :update name) (js-call digest :update "\u0000")
          (js-call digest :update (await (readFile (resolve directory name))))
          (js-call digest :update "\u0000"))
        (setq index (1+ index)))
      (js-call digest :digest "hex")))
  (defasync workspace (run)
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-core-project-transport-")))))
      (try (await (funcall run directory))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defasync actual-compiler (directory)
    (await (mkdir directory (js-object :recursive t)))
    ;; The actual compiler now has a public Math runtime import, like its
    ;; persistent-literal imports. Keep the same package baseline as the real
    ;; out-of-tree builder; the compiler digest still covers only module/maps.
    (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
    (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
    (let* ((manifest (JSON/parse (await (readFile (resolve root "contracts/compiler-parity-corpus.json") "utf8"))))
           (sources (get manifest :bootstrapSources)) (index 0))
      (js-call assert :strictEqual (js-length sources) 13)
      (while (< index (js-length sources))
        (let* ((source (aref sources index))
               (name (+ (js-call source :slice (js-length "bootstrap/compiler/") -4) ".mjs")))
          (await (copyFile (resolve root "dist/bootstrap" name) (resolve directory name)))
          (await (copyFile (resolve root "dist/bootstrap" (+ name ".map")) (resolve directory (+ name ".map")))))
        (setq index (1+ index))))
    (let ((entry (resolve directory "compiler.mjs"))) (funcall (createRequire entry) entry)))

  (test "core project transport passes the real selected compiler and exact module plus map digest into the original builder"
    (async ()
      (await (workspace (async (directory)
        (let* ((modules (resolve directory "selected")) (compiler (await (actual-compiler modules)))
               (source-root (resolve directory "sources")) (source (resolve source-root "main.eli")))
          (await (mkdir source-root))
          (await (writeFile source "(defun answer () 42)\n(export answer)\n"))
          (let* ((options (js-object :root source-root :entry source :outDir (resolve directory "first")
                           :compiler compiler :moduleDirectory modules :useCache false))
                 (before (Object/assign (js-object) options))
                 (result (await (buildProject options)))
                 (manifest (JSON/parse (await (readFile (get result :manifest) "utf8"))))
                 (digest (await (directory-hash modules))))
            (js-call assert :strictEqual (get (get manifest :cache) :compilerDigest) digest)
            (js-call assert :deepStrictEqual options before)
            (js-call assert :strictEqual (get options :compiler) compiler)
            (js-call assert :strictEqual (Object/hasOwn options "compilerDigest") false)
            (js-call assert :match (await (readFile (get result :entryOutput) "utf8"))
              (new globalThis.RegExp "function answer"))
            (await (writeFile (resolve modules "compiler.mjs.map")
              (+ (await (readFile (resolve modules "compiler.mjs.map") "utf8")) "\n")))
            (let* ((next (await (buildProject (Object/assign (js-object) options
                              (js-object :outDir (resolve directory "second"))))))
                   (next-manifest (JSON/parse (await (readFile (get next :manifest) "utf8")))))
              (js-call assert :notStrictEqual (get (get next-manifest :cache) :compilerDigest) digest)
              (js-call assert :strictEqual (get (get next-manifest :cache) :compilerDigest) (await (directory-hash modules)))))))))))

  (test "core project transport preserves explicit digest rejection and original compiler diagnostics"
    (async ()
      (await (workspace (async (directory)
        (let* ((modules (resolve directory "selected")) (compiler (await (actual-compiler modules)))
               (source-root (resolve directory "sources")) (source (resolve source-root "main.eli")))
          (await (mkdir source-root)) (await (writeFile source "(defun answer () 42) (export answer)"))
          (let ((invalid (js-array nil false "" (js-call "A" :repeat 64) "not-a-digest")) (index 0))
            (while (< index (js-length invalid))
              (let ((failure undefined) (failed false))
                (try (await (buildProject (js-object :root source-root :entry source
                       :outDir (resolve directory (+ "bad-" index)) :moduleDirectory modules
                       :compiler compiler :compilerDigest (aref invalid index))))
                  (catch error (setq failed t failure error)))
                (js-call assert :strictEqual failed t)
                (js-call assert :strictEqual (get (get failure :eliscriptDiagnostic) :code) "ELI-B0001")
                (js-call assert :strictEqual (get failure :message)
                  "injected compiler requires a lowercase SHA-256 compilerDigest"))
              (setq index (1+ index))))
          (let* ((options (js-object :root source-root :entry source
                    :outDir (resolve directory "getter") :moduleDirectory modules :compiler compiler))
                 (calls 0) (failed false) (failure undefined))
            (Object/defineProperty options "compilerDigest" (js-object :enumerable t :configurable t
              :get (lambda () (setq calls (1+ calls)) (throw false))))
            (try (await (buildProject options)) (catch error (setq failed t failure error)))
            (js-call assert :strictEqual failed t)
            (js-call assert :strictEqual failure false)
            (js-call assert :strictEqual calls 1))
          (let ((failed false) (failure undefined))
            (try (await (buildProject (js-object :root source-root :entry (resolve source-root "missing.eli")
                   :outDir (resolve directory "missing-source") :moduleDirectory (resolve directory "missing-compiler")
                   :compiler compiler)))
              (catch error (setq failed t failure error)))
            (js-call assert :strictEqual failed t)
            (js-call assert :match (get failure :message)
              (new globalThis.RegExp "local Eliscript module does not exist")))
          (await (writeFile source "(defun broken () missing)"))
          (let ((failure undefined) (failed false))
            (try (await (buildProject (js-object :root source-root :entry source
              :outDir (resolve directory "unbound") :moduleDirectory modules :compiler compiler)))
              (catch error (setq failed t failure error)))
            (js-call assert :strictEqual failed t)
            (js-call assert :match (get failure :message) (new globalThis.RegExp "unbound symbol: missing")))))))))

  (test "all five complete core project recipes bind the digest transport without dropping original assertions regions or oracle"
    (async ()
      (let* ((originals (await (loadOriginalCompilerManifests (js-object :sourceRoot root))))
             (corpus (await (loadOriginalCompilerCorpus (js-object :sourceRoot root :originals originals))))
             (source (await (readFile (resolve root "tests/core-stdlib.test.mjs") "utf8")))
             (ids (js-array "core" "utility" "persistent-values" "value-text" "public"))
             (index 0))
        (while (< index (js-length ids))
          (let* ((id (+ "original-program:core-project-" (aref ids index)))
                 (record (js-call (get corpus :records) :find (lambda (record) (= (get record :id) id))))
                 (execution (get record :execution)) (original (get record :original))
                 (host (get execution :hostSource)))
            (js-call assert :ok record id)
            (js-call assert :strictEqual (get original :sourceSha256) (hash source))
            (js-call assert :strictEqual (get execution :runtimeProfile) "compiler")
            (js-call assert :strictEqual (get execution :requiresBun) t)
            (js-call assert :ok (> (get execution :timeoutMs) 0))
            (js-call assert :strictEqual (get (get record :expected) :kind) "seed-program")
            (js-call assert :strictEqual (get (get record :expected) :oracleRequired) t)
            (js-call assert :strictEqual (get (get record :expected) :stdout) "")
            (js-call assert :strictEqual (js-call host :includes "compiler:selectedCompiler") t)
            (js-call assert :strictEqual (js-call host :includes "tools/backends/compiler-corpus-project-transport.mjs") t)
            (js-call assert :strictEqual (js-call host :includes "bootstrap/host/project.mjs") false)
            (js-call (get original :regions) :forEach (lambda (region)
              (let ((text (js-call source :slice (get region :start) (get region :end))))
                (js-call assert :strictEqual (get region :sha256) (hash text))
                (js-call assert :strictEqual (js-call host :includes text) t))))
            (let ((files (js-array "tools/backends/eliscript/compiler-corpus-project-transport.eli"
                                  "tools/backends/compiler-corpus-project-transport.mjs")) (at 0))
              (while (< at (js-length files))
                (let* ((file (aref files at))
                       (asset (js-call (get original :sourceAssets) :find (lambda (item) (= (get item :file) file)))))
                  (js-call assert :ok asset)
                  (js-call assert :strictEqual (get asset :sourceSha256) (hash (await (readFile (resolve root file))))))
                (setq at (1+ at)))))
          (setq index (1+ index))))))

  (defasync provider-record ()
    (let* ((originals (await (loadOriginalCompilerManifests (js-object :sourceRoot root))))
           (corpus (await (loadOriginalCompilerCorpus (js-object :sourceRoot root :originals originals)))))
      (js-call (get corpus :records) :find
        (lambda (record) (= (get record :id) "original-program:core-project-core")))))
  (defun provider-context (record directory)
    (js-object :target "javascript" :record record :sourceRoot root :directory directory
      :options (js-object) :transportEvidence (js-object)
      :artifact (js-object :target "javascript" :directory directory
        :path (resolve directory "core/transient.mjs") :entry "core/transient.mjs"
        :modules (js-array (js-object :id "core/transient.mjs")))))
  (defun top-level-imports (nodes)
    (let ((imports (js-array)))
      (js-call nodes :forEach (lambda (node)
        (cond
          ((= (get node :kind) "import-declaration") (js-call imports :push node))
          ((= (get node :kind) "module-declaration")
           (js-call (top-level-imports (get node :children)) :forEach
             (lambda (child) (js-call imports :push child)))))))
      imports))
  (defasync actual-transient-artifact (compiler directory)
    ;; Exercise only the transport seam here, not claim the full core suite.
    ;; Retain the complete real transient program and relocate its one native
    ;; import to the same product-relative path used by corpus project output.
    (let* ((source (await (readFile (resolve root "stdlib/core/transient.eli") "utf8")))
           (program (js-call compiler :compile_ir_string source "stdlib/core/transient.eli"))
           (before (globalThis.structuredClone program))
           (imports (top-level-imports (get program :body)))
           (path (resolve directory "core/transient.mjs")))
      (js-call assert :strictEqual (js-length imports) 1)
      (js-call assert :strictEqual (get (aref imports 0) :value) "../../runtime/core/transient.mjs")
      (put (aref imports 0) :value "../runtime/core/transient.mjs")
      (let ((emitted (js-call compiler :emit_ir_string program)))
        (put (aref imports 0) :value "../../runtime/core/transient.mjs")
        (js-call assert :deepStrictEqual program before)
        (await (mkdir (resolve directory "core") (js-object :recursive t)))
        (await (writeFile path emitted))
        (js-object :entryOutput path))))

  (test "native core interop keeps the actual canonical provider identity without changing archived source declarations"
    (async ()
      (await (workspace (async (directory)
        (let* ((record (await (provider-record)))
               (before (globalThis.structuredClone record))
               (modules (resolve directory "selected")) (compiler (await (actual-compiler modules)))
               (product (resolve directory "product"))
               (result (await (actual-transient-artifact compiler product)))
               (emitted (await (readFile (get result :entryOutput))))
               ;; Generate the real transport fixture from Eli. Its vector is
               ;; deliberately supplied by the original native provider, while
               ;; all transient calls use the selected compiler's actual output.
               (host-source (str "(module fixture.native-provider\n"
                 " (import \"node:assert/strict\" :default assert)\n"
                 " (import " (JSON/stringify (get (pathToFileURL (resolve root "runtime/core/vector.mjs")) :href))
                 " persistentVector PersistentVector)\n"
                 " (import \"../core/transient.mjs\" transient conj! persistent!)\n"
                 " (let* ((original (persistentVector 1 -0)) (working (transient original))"
                 " (result (persistent! (conj! working 3))))\n"
                 " (js-call assert :strictEqual (js-call PersistentVector globalThis.Symbol.hasInstance result) t)\n"
                 " (js-call assert :strictEqual (Object/getPrototypeOf result) PersistentVector.prototype)\n"
                 " (js-call assert :deepStrictEqual (Array/from result) (js-array 1 -0 3))\n"
                 " (js-call assert :deepStrictEqual (Array/from original) (js-array 1 -0))))\n"))
               (host (js-call compiler :compile_string host-source "native-provider.eli"))
               (execution (Object/assign (js-object) (get record :execution)
                 (js-object :host "tests/native-provider.mjs" :hostSource host
                   :hostRuntime "node" :requiresBun false :runtimeLaunchers false)))
               (configured-record (Object/assign (js-object) record (js-object :execution execution)))
               (context (provider-context configured-record product))
               (routed (await (prepareCompilerCorpusNativeProviders context)))
               (proof (get (get context :transportEvidence) :nativeProviderIdentity)))
          (js-call assert :notStrictEqual routed context)
          (js-call assert :notStrictEqual (get routed :record) configured-record)
          (js-call assert :deepStrictEqual record before)
          (js-call assert :strictEqual (get (get routed :record) :modules) (get record :modules))
          (js-call assert :strictEqual (get (get routed :record) :expected) (get record :expected))
          (js-call assert :strictEqual (get (get routed :record) :execution) execution)
          (js-call assert :strictEqual (js-call (get (get (get routed :record) :request) :hostSources)
            :some (lambda (item) (js-call (get item :id) :startsWith "runtime/"))) false)
          (js-call assert :strictEqual (get proof :policy) "canonical-source-runtime")
          (js-call assert :strictEqual (get proof :runtimeRoot) (await (realpath (resolve root "runtime"))))
          (js-call assert :ok (> (js-length (get proof :files)) 0))
          (let ((index 0))
            (while (< index (js-length (get proof :files)))
              (let* ((item (aref (get proof :files) index)) (bytes (await (readFile (resolve root (get item :id))))))
                (js-call assert :strictEqual (get item :sha256) (hash bytes))
                (js-call assert :strictEqual (get item :bytes) (js-length bytes)))
              (setq index (1+ index))))
          (let ((observation (await (executeCompilerCorpusRecord context))))
            (js-call assert :strictEqual (get observation :stdout) "")
            (js-call assert :deepStrictEqual (get observation :nativeProviderIdentity) proof))
          (js-call assert :strictEqual (js-call (await (lstat (resolve product "runtime"))) :isSymbolicLink) t)
          (js-call assert :strictEqual (await (realpath (resolve product "runtime"))) (get proof :runtimeRoot))
          (js-call assert :deepStrictEqual (await (readFile (get result :entryOutput))) emitted)
          (js-call assert :deepStrictEqual record before)))))))

  (test "canonical native provider policy rejects tampered incomplete duplicate and emitted providers and stays scoped to the five native interop records"
    (async ()
      (await (workspace (async (directory)
        (let* ((record (await (provider-record))) (before (globalThis.structuredClone record))
               (sources (get (get record :request) :hostSources))
               (provider (js-call sources :find (lambda (item) (js-call (get item :id) :startsWith "runtime/"))))
               (variants (js-array
                 (js-call sources :map (lambda (item) (if (eq item provider)
                   (Object/assign (js-object) item (js-object :source (str (get item :source) "\n"))) item)))
                 (js-call sources :filter (lambda (item) (not (eq item provider))))
                 (js-call sources :concat (js-array provider))))
               (index 0))
          (while (< index (js-length variants))
            (let* ((modified (Object/assign (js-object) record
                      (js-object :request (Object/assign (js-object) (get record :request)
                        (js-object :hostSources (aref variants index))))))
                   (context (provider-context modified directory)))
              (await (js-call assert :rejects (lambda () (prepareCompilerCorpusNativeProviders context))
                (new globalThis.RegExp "canonical native provider"))))
            (setq index (1+ index)))
          (let ((context (provider-context record directory)))
            (js-call (get (get context :artifact) :modules) :push (js-object :id "runtime/core/vector.mjs"))
            (await (js-call assert :rejects (lambda () (prepareCompilerCorpusNativeProviders context))
              (new globalThis.RegExp "canonical native provider"))))
          (await (mkdir (resolve directory "runtime")))
          (await (js-call assert :rejects
            (lambda () (prepareCompilerCorpusNativeProviders (provider-context record directory)))
            (new globalThis.RegExp "canonical native provider")))
          (let ((other (provider-context record directory)))
            (put other :target "wasm")
            (js-call assert :strictEqual (await (prepareCompilerCorpusNativeProviders other)) other))
          (let ((other (provider-context (Object/assign (js-object) record
                          (js-object :id "original-program:unrelated")) directory)))
            (js-call assert :strictEqual (await (prepareCompilerCorpusNativeProviders other)) other))
          (js-call assert :deepStrictEqual record before)))))))
  (defasync sorted-provider-corpus ()
    (let ((originals (await (loadOriginalCompilerManifests (js-object :sourceRoot root)))))
      (await (loadOriginalCompilerCorpus (js-object :sourceRoot root :originals originals)))))
  (defun sorted-provider-record (corpus host auto)
    (let ((id (str "original-managed:sorted-core:" host ":auto-" auto)))
      (js-call (get corpus :records) :find (lambda (record) (= (get record :id) id)))))
  (defun sorted-provider-context (record directory assets)
    (let ((context (provider-context record directory)))
      (put context :sourceAssets assets)
      (put context :artifact (js-object :target "javascript" :directory directory
        :entry (get record :entry) :path (resolve directory (get record :entry))
        :modules (js-call (get record :modules) :map (lambda (module)
          (js-object :id (get module :id))))))
      context))

  (test "all four original sorted selected products authenticate archived providers when raw declarations were completed only for compilation"
    (async ()
      (await (workspace (async (directory)
        (let* ((corpus (await (sorted-provider-corpus))) (assets (get corpus :evidence))
               (combinations (js-array (js-array "node" 65536) (js-array "bun" 65536)
                                      (js-array "node" 1) (js-array "bun" 1))) (index 0))
          (while (< index (js-length combinations))
            (let* ((pair (aref combinations index))
                   (record (sorted-provider-record corpus (aref pair 0) (aref pair 1)))
                   (before (globalThis.structuredClone record))
                   (request (compilerCorpusRequest record "javascript" (js-object :sourceAssets assets)))
                   (context (sorted-provider-context record directory assets))
                   (routed (await (prepareCompilerCorpusNativeProviders context)))
                   (proof (get routed :nativeProviderIdentity))
                   (providers (js-call (get request :hostSources) :filter
                     (lambda (item) (js-call (get item :id) :startsWith "runtime/")))))
              (js-call assert :strictEqual (Object/hasOwn (get record :request) "hostSources") false)
              (js-call assert :ok (> (js-length providers) 0))
              (js-call assert :strictEqual (get proof :policy) "canonical-source-runtime")
              (js-call assert :strictEqual (get proof :runtimeRoot) (await (realpath (resolve root "runtime"))))
              (js-call assert :strictEqual (js-length (get proof :files)) (js-length providers))
              (js-call assert :deepStrictEqual (get (get (get routed :record) :request) :hostSources) (js-array))
              (js-call assert :strictEqual (get (get routed :record) :execution) (get record :execution))
              (js-call assert :strictEqual (get (get routed :record) :modules) (get record :modules))
              (js-call assert :deepStrictEqual (get (get context :transportEvidence) :nativeProviderIdentity) proof)
              (let ((position 0))
                (while (< position (js-length providers))
                  (let* ((provider (aref providers position))
                         (item (js-call (get proof :files) :find
                           (lambda (item) (= (get item :id) (get provider :id)))))
                         (bytes (await (readFile (resolve root (get provider :id))))))
                    (js-call assert :strictEqual (get provider :source) (js-call bytes :toString "utf8"))
                    (js-call assert :strictEqual (get item :sha256) (hash bytes))
                    (js-call assert :strictEqual (get item :bytes) (js-length bytes)))
                  (setq position (1+ position))))
              (js-call assert :deepStrictEqual record before))
            (setq index (1+ index)))))))))

  (test "sorted archived provider routing rejects invalid proofs explicit declarations products and aliases without admitting lookalike records"
    (async ()
      (await (workspace (async (directory)
        (let* ((corpus (await (sorted-provider-corpus))) (assets (get corpus :evidence))
               (record (sorted-provider-record corpus "node" 65536))
               (before (globalThis.structuredClone record))
               (provider (js-call assets :find (lambda (item) (= (get item :file) "runtime/core/sorted.mjs"))))
               (changed-bytes (js-call globalThis.Buffer :from
                 (str (js-call (js-call globalThis.Buffer :from (get provider :content) "base64") :toString "utf8") "\n")))
               (changed (Object/assign (js-object) provider (js-object
                 :content (js-call changed-bytes :toString "base64") :bytes (js-length changed-bytes)
                 :sha256 (hash changed-bytes))))
               (variants (js-array
                 (js-call assets :filter (lambda (item) (not (eq item provider))))
                 (js-call assets :concat (js-array provider))
                 (js-call assets :map (lambda (item) (if (eq item provider)
                   (Object/assign (js-object) item (js-object :content (str (get item :content) "!"))) item)))
                 (js-call assets :map (lambda (item) (if (eq item provider)
                   (Object/assign (js-object) item (js-object :sha256 (js-call "0" :repeat 64))) item)))
                 (js-call assets :map (lambda (item) (if (eq item provider) changed item)))))
               (index 0))
          (while (< index (js-length variants))
            (let ((context (sorted-provider-context record directory (aref variants index))))
              (await (js-call assert :rejects (lambda () (prepareCompilerCorpusNativeProviders context))
                (new globalThis.RegExp "canonical native provider")))
              (js-call assert :strictEqual (Object/hasOwn (get context :transportEvidence) "nativeProviderIdentity") false))
            (setq index (1+ index)))
          (let ((declarations (js-array undefined nil (js-array)
                    (js-array (js-object :id "runtime/core/sorted.mjs" :source "changed")))) (at 0))
            (while (< at (js-length declarations))
              (let* ((declared (Object/assign (js-object) record (js-object :request
                        (Object/assign (js-object) (get record :request)
                          (js-object :hostSources (aref declarations at))))))
                     (context (sorted-provider-context declared directory assets)))
                (await (js-call assert :rejects (lambda () (prepareCompilerCorpusNativeProviders context))
                  (new globalThis.RegExp "canonical native provider"))))
              (setq at (1+ at))))
          (let ((context (sorted-provider-context record directory (js-array))))
            (await (js-call assert :rejects (lambda () (prepareCompilerCorpusNativeProviders context))
              (new globalThis.RegExp "canonical native provider"))))
          (let* ((bytes (js-call globalThis.Buffer :from (js-array 255)))
                 (invalid (Object/assign (js-object) provider (js-object
                   :content (js-call bytes :toString "base64") :bytes 1 :sha256 (hash bytes))))
                 (context (sorted-provider-context record directory
                   (js-call assets :map (lambda (item) (if (eq item provider) invalid item))))))
            (await (js-call assert :rejects (lambda () (prepareCompilerCorpusNativeProviders context))
              (lambda (error) (and (eq (get error :constructor) globalThis.TypeError)
                                  (= (get error :code) "ERR_ENCODING_INVALID_ENCODED_DATA"))))))
          (let ((context (sorted-provider-context record directory assets)))
            (js-call (get (get context :artifact) :modules) :push (js-object :id "runtime/core/sorted.mjs"))
            (await (js-call assert :rejects (lambda () (prepareCompilerCorpusNativeProviders context))
              (new globalThis.RegExp "canonical native provider"))))
          (let* ((unrelated (Object/assign (js-object) record (js-object :id "original-managed:sorted-core:node:auto-2")))
                 (context (sorted-provider-context unrelated directory assets)))
            (js-call assert :strictEqual (await (prepareCompilerCorpusNativeProviders context)) context))
          (let* ((unrelated (Object/assign (js-object) record (js-object :original
                            (Object/assign (js-object) (get record :original) (js-object :fixture "other.eli")))))
                 (context (sorted-provider-context unrelated directory assets)))
            (js-call assert :strictEqual (await (prepareCompilerCorpusNativeProviders context)) context))
          (await (mkdir (resolve directory "runtime")))
          (await (js-call assert :rejects
            (lambda () (prepareCompilerCorpusNativeProviders (sorted-provider-context record directory assets)))
            (new globalThis.RegExp "canonical native provider")))
          (js-call assert :deepStrictEqual record before)))))))
)
