                (ok (not (some (get document :missingCaseAdapters) (lambda (item) (= (get item :coverageId) (get locator :id)))))))))
          (let* ((legacy (find (get document :records) (lambda (record) (= (get record :id) "original-sequence:legacy-native-container-rejection"))))
