(module tests.compiler-corpus-source-archive
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile readdir rm mkdir symlink)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:buffer" Buffer)
  (import "node:crypto" createHash)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/compiler-corpus-source-archive.mjs" archiveCompilerCorpusSources readArchivedCompilerCorpusSources)
  (import "../tools/backends/compiler-session.mjs" encodeCompilerIR)
  (import "../tools/backends/compiler-matrix.mjs" verifyOriginalCompilerCorpusFiles loadOriginalCompilerManifests loadCompilerMatrixCorpus)
  (import "../tools/backends/compiler-corpus.mjs" loadOriginalCompilerCorpus)
  (import "../tools/backends/compiler-corpus-managed-cases.mjs" originalSourceCaseLocators)
  (import "../tools/backends/compiler-corpus-runtime-adapters.mjs" originalRuntimeSourceSuites originalRuntimeCaseLocators)
  (import "../tools/backends/compiler-corpus-identity-value-adapters.mjs" originalIdentityValueSuites originalIdentityValueCaseLocators)
  (import "../tools/backends/compiler-corpus-managed-fixtures.mjs" addOriginalManagedFixtureAdapters readOriginalManagedStaticTemplate bindOriginalManagedSourceEvidence)
  (import "../tools/backends/compiler-corpus-project-adapters.mjs" addOriginalProjectPrograms)

  (defun hash (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun ok (value &optional message) (js-call assert :ok value message))
  (defun eq-check (actual expected &optional message) (js-call assert :equal actual expected message))
  (defun neq-check (actual expected &optional message) (js-call assert :notEqual actual expected message))
  (defun deep (actual expected &optional message) (js-call assert :deepEqual actual expected message))
  (defun includes (text part) (js-call text :includes part))
  (defun rx (pattern) (new globalThis.RegExp pattern))
  (defun clone (value) (globalThis.structuredClone value))
  (defun array-map (items fn) (js-call items :map fn))
  (defun select (items fn) (js-call items :filter fn))
  (defun find (items fn) (js-call items :find fn))
  (defun some (items fn) (js-call items :some fn))
  (defun each (items fn)
    (let ((index 0)) (while (< index (js-length items))
      (funcall fn (aref items index) index) (setq index (1+ index)))))
  (defasync each-await (items fn)
    (let ((index 0)) (while (< index (js-length items))
      (await (funcall fn (aref items index) index)) (setq index (1+ index)))))
  (defasync workspace (run)
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-case-source-")))))
      (try (await (funcall run directory))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defun exact-corpus-wire (actual expected label)
    (unless (= actual expected)
      (let ((index 0))
        (while (and (< index (js-length actual)) (< index (js-length expected))
          (= (js-call actual :charCodeAt index) (js-call expected :charCodeAt index)))
          (setq index (1+ index)))
        ;; Keep exact equality without materializing a pretty diff of inventories.
        (js-call assert :fail (+ label ": first mismatch at " index "; lengths "
          (js-length actual) "/" (js-length expected) "; actual "
          (JSON/stringify (js-call actual :slice index (+ index 80))) "; expected "
          (JSON/stringify (js-call expected :slice index (+ index 80))))))))
  (defun project (source)
    (js-object :id "case:中😀" :kind "project" :entry "entry.mjs"
      :modules (js-array (js-object :id "entry.mjs" :filename "src/原文😀.eli" :source source))
      :request (js-object :operation "project" :resolveImports t :sourceMap t
        :literalSources (js-array (js-object :id "literal.mjs" :filename "literal.eli" :source "; literal \udc00"))
        :hostSources (js-array (js-object :id "host.mjs" :filename "host.mjs" :source "export const raw=\"\ud800\";")))
      :memory (js-object :initialPages 4 :maximumPages 1024) :auto 1
      :execution (js-object :kind "exports" :calls (js-array (js-object :name "run" :args (js-array -0 globalThis.Number.MIN_VALUE))))
      :expected (js-object :kind "value" :value -0) :coverage (js-array "original:case")
      :original (js-object :suite "tests/original.test.mjs" :sourceSha256 "original-suite-hash")))

  (test "Given static original JS templates When transported Then cooked escapes exact UTF16 and the actual closing backtick survive without executing the suite"
    (lambda ()
      (let ((vectors (js-array
        (js-array "" "") (js-array "plain 中😀\ud800\udfff" "plain 中😀\ud800\udfff")
        (js-array "\\n\\r\\t\\b\\f\\v\\0" "\n\r\t\b\f\u000b\u0000")
        (js-array "\\x00\\x41\\uFEFF\\uD800\\uDC00\\uDFFF" "\u0000A\uFEFF\ud800\udc00\udfff")
        (js-array "\\u{1F600}\\u{0}\\u{D800}\\u{10FFFF}" "😀\u0000\ud800\udbff\udfff")
        (js-array "\\\\\\`\\$\\'\\\"\\/\\z" "\\`$'\"/z")
        (js-array "\\${notDeclared}" "${notDeclared}")
        (js-array "before\\`;still inside" "before`;still inside")
        (js-array "a\rb\r\nc\nd\u2028e\u2029f" "a\nb\nc\nd\u2028e\u2029f")
        (js-array "a\\\nb\\\r\nc\\\rd\\\u2028e\\\u2029f" "abcdef"))))
        (each vectors (lambda (pair index)
          (let* ((raw (aref pair 0)) (expected (aref pair 1))
                 (source (+ "const sample = `" raw "`;\nthrow new Error(\"suite must remain data\");")))
            (eq-check (readOriginalManagedStaticTemplate source "sample") expected)
            (eq-check (readOriginalManagedStaticTemplate
              (js-call source :replace "const sample =" "const\n sample\t=") "sample") expected)))))
      (let* ((expression "names.map(name=>`inner ${name}`)")
             (source (+ "const sample=`before ${" expression "} after`;")))
        (eq-check (readOriginalManagedStaticTemplate source "sample"
          (new globalThis.Map (js-array (js-array expression "literal \ud800 `; ${unchanged}"))))
          "before literal \ud800 `; ${unchanged} after"))
      (eq-check (readOriginalManagedStaticTemplate "const $sample=`dollar identifier`;" "$sample") "dollar identifier")))

  (test "Given undeclared interpolation invalid escapes or incomplete template boundaries When original data is read Then transport fails before adding any recipe"
    (async ()
      (each (js-array "${globalThis.sideEffect=1}" "\\1" "\\8" "\\9" "\\00" "\\09" "\\x0g" "\\u123" "\\u{110000}" "\\u{}" "\\u{xyz}")
        (lambda (body index) (js-call assert :throws
          (lambda () (readOriginalManagedStaticTemplate (+ "const sample=`" body "`;") "sample")) globalThis.TypeError)))
      (each (js-array "const other=`value`;" "const sample=`unterminated" "const sample=`escape\\"
        "const sample=`closed` + dangerous();" "const sample=`first` + `second`;")
        (lambda (source index) (js-call assert :throws (lambda () (readOriginalManagedStaticTemplate source "sample")) globalThis.TypeError)))
      (js-call assert :throws (lambda () (readOriginalManagedStaticTemplate "const sample=`${known + unknown}`;" "sample"
        (new globalThis.Map (js-array (js-array "known" "value"))))) (rx "unbound interpolation"))
      (js-call assert :throws (lambda () (readOriginalManagedStaticTemplate "const sample=`${known}`;" "sample"
        (new globalThis.Map (js-array (js-array "known" 42))))) (rx "invalid explicit interpolation"))
      (let ((fixture "tests/fixtures/wasm-managed-function-properties.eli") (suite "tests/wasm-managed-function-properties.test.mjs"))
        (await (each-await (js-array
          "const wellKnownSymbolNames=[\"iterator\"]; const reflectionSource=`unchanged`;"
          "const wellKnownSymbolNames=['iterator']; const reflectionSource=`${undeclared()}`;"
          "const wellKnownSymbolNames=['iterator']; const reflectionSource=`\\u{110000}`;")
          (async (source index)
            (let ((records (js-array)) (reads (js-array)))
              (await (js-call assert :rejects (addOriginalManagedFixtureAdapters
                (js-object :sourceRoot (resolve ".") :stableFiles (new globalThis.Set (js-array fixture)) :locators (js-array)
                  :text (async (filename) (js-call reads :push filename)
                    (ok (includes (js-array fixture suite) filename)) (if (= filename fixture) "(module fixture)\n" source))
                  :file (async () (throw (new globalThis.Error "invalid template must fail before recipe evidence or compiler sources are loaded")))
                  :add (lambda (record) (js-call records :push record)))) globalThis.TypeError))
              (deep records (js-array)) (deep reads (js-array fixture suite)))))))))

  (test "Given the original source debugging suite When its selected compiler setup changes Then recipe construction refuses the boundary instead of using a default compiler"
    (async ()
      (let* ((source-root (resolve ".")) (originals (await (loadOriginalCompilerManifests (js-object :sourceRoot source-root))))
             (bootstrap-sources (get (get (find (get originals :manifests) (lambda (item) (= (get item :id) "compiler-parity"))) :document) :bootstrapSources))
             (suite "tests/source-debugging.test.mjs") (original (await (readFile suite "utf8")))
             (changed (js-call original :replace "const compiler = await loadCompiler();" "const compiler = await loadCompiler(\"unselected\");"))
             (records (js-array)) (locators (js-array (js-object :id "original-debugging-boundary" :file suite :contains "browser event and async rejection map under Bun and Node"))))
        (neq-check changed original)
        (await (js-call assert :rejects (addOriginalProjectPrograms
          (js-object :sourceRoot source-root :bootstrapSources bootstrap-sources :locators locators :stableFiles (new globalThis.Set)
            :text (async (filename) (if (= filename suite) changed (await (readFile (resolve source-root filename) "utf8"))))
            :file (async (filename) (js-object :sha256 (hash (await (readFile (resolve source-root filename))))))
            :add (lambda (record) (js-call records :push record))))
          (rx "original project setup boundary changed: const compiler = await loadCompiler")))
        (deep records (js-array)))))

  (test "Given a retained source locator When binding existing execution evidence Then only the exact real module argument host and current source revision can claim it"
    (async ()
      (let* ((fixture "tests/fixtures/core-expression-forms.eli") (host "tests/fixtures/core-expression-forms-host.mjs")
             (source (await (readFile fixture "utf8"))) (host-source (await (readFile host "utf8")))
             (locator (js-object :id "retained-source-evidence" :file fixture :contains "(defun expression-form-report ()"))
             (original (js-object :id (+ "stable-compatibility:program:" fixture) :kind "project" :entry "forms.mjs" :coverage (js-array)
               :modules (js-array (js-object :id "forms.mjs" :filename fixture :source source)) :request (js-object :entries (js-array "forms.mjs"))
               :execution (js-object :kind "original-program" :host host :hostSource host-source)))
             (services (js-object :locators (js-array locator) :text (async (filename) (await (readFile filename "utf8")))
               :file (async (filename) (js-object :sha256 (hash (await (readFile filename)))))))
             (record (clone original)))
        (await (bindOriginalManagedSourceEvidence (Object/assign (js-object) services
          (js-object :records (js-array record) :bindCoverage (lambda (actual ids)
            (eq-check actual record) (deep ids (js-array (get locator :id)))
            (js-call (get actual :coverage) :push (aref ids 0)))))))
        (deep (get record :coverage) (js-array (get locator :id)))
        (eq-check (get (aref (get (get record :original) :sourceEvidenceBindings) 0) :sourceSha256) (hash (js-call Buffer :from source)))
        (eq-check (get (aref (get (get record :original) :sourceEvidenceBindings) 0) :hostSourceSha256) (hash (js-call Buffer :from host-source)))
        (eq-check (get original :original) undefined) (deep (get original :coverage) (js-array))
        (await (each-await (js-array
          (lambda (record) (put (aref (get record :modules) 0) :source (+ (get (aref (get record :modules) 0) :source) "; changed")))
          (lambda (record) (put record :entry "unrelated.mjs") (put (get record :execution) :argumentModules (js-array)))
          (lambda (record) (put (get record :request) :entries (js-array)))
          (lambda (record) (put (get record :execution) :hostSource
            (js-call (get (get record :execution) :hostSource) :replace "module.expression_form_report()" "module.unrelated()")))
          (lambda (record) (put (get record :execution) :host "tests/fixtures/unrelated-host.mjs")))
          (async (mutate index)
            (let ((changed (clone original)) (claims 0))
              (funcall mutate changed)
              (await (js-call assert :rejects (bindOriginalManagedSourceEvidence (Object/assign (js-object) services
                (js-object :records (js-array changed) :bindCoverage (lambda () (setq claims (1+ claims)))))) (rx "not an actually executed input")))
              (eq-check claims 0) (deep (get changed :coverage) (js-array)) (eq-check (get changed :original) undefined))))))))

  (test "Given exact original Unicode and IEEE inputs When a matrix case is archived Then replay preserves its complete case recipe"
    (async () (await (workspace (async (directory)
      (await (each-await (js-array "" "\uFEFF; 中😀e\u0301\n(defconst x -0)"
        "(defconst high \"\ud800\")" "(defconst low \"\udc00\")" "(defconst replacement \"�\")")
        (async (source index)
          (let* ((record (project source)) (path (resolve directory (globalThis.String index)))
                 (identity (await (archiveCompilerCorpusSources record path)))
                 (restored (await (readArchivedCompilerCorpusSources path (js-object :expectedIdentity (get identity :sha256))))))
            (deep restored record) (ok (Object/is (get (get restored :expected) :value) -0))
            (ok (Object/is (aref (get (aref (get (get restored :execution) :calls) 0) :args) 0) -0))
            (eq-check (aref (get (aref (get (get restored :execution) :calls) 0) :args) 1) globalThis.Number.MIN_VALUE)
            (let* ((module (aref (get identity :modules) 0)) (asset (get module :asset))
                   (bytes (await (readFile (resolve path (get asset :path))))))
              (eq-check (get module :encoding) "utf16le") (eq-check (get module :bytes) (* (js-length source) 2))
              (eq-check (get module :sha256) (hash (js-call Buffer :from source "utf16le")))
              (eq-check (get asset :bytes) (js-length bytes)) (eq-check (get asset :sha256) (hash bytes))
              (if (or (includes source "\ud800") (includes source "\udc00")) (eq-check (get asset :encoding) "json-utf16")
                (progn (eq-check (get asset :encoding) "utf8") (eq-check (js-call bytes :toString "utf8") source))))
            (deep (JSON/parse (await (readFile (resolve path "source-identity.json") "utf8"))) identity))))))))))

  (test "Given lone surrogates and U+FFFD When source identities are emitted Then distinct UTF16 inputs cannot share an identity"
    (async () (await (workspace (async (directory)
      (let ((sources (js-array "\ud800" "\udc00" "�")) (identities (js-array)))
        (await (each-await sources (async (source index)
          (js-call identities :push (await (archiveCompilerCorpusSources (project source) (resolve directory (globalThis.String index))))))))
        (eq-check (get (new globalThis.Set (array-map identities (lambda (item) (get item :sha256)))) :size) 3)
        (eq-check (get (new globalThis.Set (array-map identities (lambda (item) (get (aref (get item :modules) 0) :sha256)))) :size) 3)
        (let* ((negative (await (archiveCompilerCorpusSources (project "-0") (resolve directory "negative")))) (changed (project "-0")))
          (put (get changed :expected) :value 0)
          (let ((positive (await (archiveCompilerCorpusSources changed (resolve directory "positive")))))
            (neq-check (get negative :sha256) (get positive :sha256) "expected IEEE sign remains bound even when source text is unchanged")))))))))

  (test "Given stage and sequence recipes When archived Then source macro context and every dependent request remain replayable"
    (async () (await (workspace (async (directory)
      (let* ((stage (js-object :id "stage:reader" :kind "stage" :coverage (js-array "original:reader")
               :request (js-object :operation "stage" :stage "reader" :filename "原文😀.eli" :source "\uFEFF; \ud800\n(value)"
                 :macroContext (js-object :sources (js-array (js-object :path "macro.eli" :source "; \udc00")) :offset -0))
               :expected (js-object :kind "diagnostic" :message "original diagnostic")))
             (first (await (archiveCompilerCorpusSources stage (resolve directory "stage")))))
        (deep (await (readArchivedCompilerCorpusSources (resolve directory "stage") (js-object :expectedIdentity (get first :sha256)))) stage)
        (eq-check (get (get (get first :stage) :asset) :path) "stage-input.eli.json")
        (let* ((sequence (js-object :id "sequence:recovery" :kind "sequence" :coverage (js-array "original:sequence")
                 :steps (js-array
                   (js-object :id "edit" :request (js-object :operation "setSource" :filename "virtual.eli" :source "; \ud800"))
                   (js-object :id "negative-zero" :request (js-object :operation "compile-ir" :ir "{\"value\":-0}"))
                   (js-object :id "recover" :request (js-object :operation "stage" :stage "reader" :source "(value)" :filename "virtual.eli")))
                 :expected (js-object :kind "sequence")))
               (second (await (archiveCompilerCorpusSources sequence (resolve directory "sequence")))))
          (deep (await (readArchivedCompilerCorpusSources (resolve directory "sequence") (js-object :expectedIdentity (get second :sha256)))) sequence)
          (deep (get second :modules) (js-array)) (eq-check (get second :stage) undefined))))))))

  (test "Given a mutable caller When archive I/O begins Then all source and request fields already belong to one revision"
    (async () (await (workspace (async (directory)
      (let* ((record (project "; original \ud800")) (before (clone record)) (pending (archiveCompilerCorpusSources record directory)))
        (put (aref (get record :modules) 0) :source "; changed")
        (put (aref (get (get record :request) :literalSources) 0) :source "; changed literal")
        (put (get record :expected) :value 0) (js-call (get (aref (get (get record :execution) :calls) 0) :args) :push 42)
        (let ((identity (await pending)))
          (deep (await (readArchivedCompilerCorpusSources directory (js-object :expectedIdentity (get identity :sha256)))) before))))))))

  (test "Given a first throwing source getter or invalid IR scalar When snapshotting Then no archive file exists and the original failure permits an exact retry"
    (async () (await (workspace (async (directory)
      (await (each-await (js-array false undefined (js-object :original "source getter"))
        (async (reason index)
          (let ((record (project "; original")) (visits (js-array)) (caught false))
            (Object/defineProperty (aref (get record :modules) 0) "source" (js-object :enumerable t
              :get (lambda () (js-call visits :push "source") (throw reason))))
            (Object/defineProperty (aref (get (get record :request) :literalSources) 0) "source" (js-object :enumerable t
              :get (lambda () (js-call visits :push "later") "; later")))
            (try (await (archiveCompilerCorpusSources record (resolve directory "attempt")))
              (catch error (setq caught t) (js-call assert :strictEqual error reason)))
            (ok caught) (deep visits (js-array "source")) (deep (await (readdir directory)) (js-array))))))
      (let ((invalid (project "; invalid scalar")))
          (put (get invalid :expected) :value (globalThis.BigInt "1"))
        (await (js-call assert :rejects (archiveCompilerCorpusSources invalid (resolve directory "attempt")) globalThis.TypeError)))
      (deep (await (readdir directory)) (js-array) "IR rejection still precedes directory creation")
      (let* ((record (project "; recovered \ud800")) (identity (await (archiveCompilerCorpusSources record (resolve directory "attempt")))))
        (deep (await (readArchivedCompilerCorpusSources (resolve directory "attempt") (js-object :expectedIdentity (get identity :sha256)))) record)))))))

  (test "Given repeated source values and shared request metadata When streamed Then ordinal assets full recipe bytes and every source identity retain their original order"
    (async () (await (workspace (async (directory)
      (let* ((record (project (js-call "; shared 中😀\n" :repeat 10000))) (shared (js-object :value -0 :text "\uFEFF中😀\ud800")))
        (Object/defineProperty shared "__proto__" (js-object :value (js-object :own t) :writable t :enumerable t :configurable t))
        (js-call (get record :modules) :push
          (js-object :id "second.mjs" :filename "src/second.eli" :source (get (aref (get record :modules) 0) :source))
          (js-object :id "third.mjs" :filename "src/third\udfff.eli" :source (js-call "; escaped \udfff\u0000" :repeat 10000)))
        (put (get record :original) :shared shared) (put (get record :execution) :shared shared)
        (let* ((before (clone record)) (expected (js-call Buffer :from (+ (encodeCompilerIR before) "\n")))
               (path (resolve directory "streamed")) (pending (archiveCompilerCorpusSources record path)))
          (js-call (get record :modules) :reverse) (put shared :value 0)
          (put (aref (get record :modules) 0) :source "caller changed after dispatch")
          (let ((identity (await pending)))
            (deep (array-map (get identity :modules) (lambda (module) (get module :id)))
              (array-map (get before :modules) (lambda (module) (get module :id))))
            (deep (array-map (get identity :modules) (lambda (module) (get (get module :asset) :path)))
              (js-array "modules/000000.eli" "modules/000001.eli" "modules/000002.eli.json"))
            (let ((recipe (await (readFile (resolve path "record.json")))))
              (eq-check (js-call Buffer :compare recipe expected) 0)
              (eq-check (get (get identity :record) :bytes) (js-length expected))
              (eq-check (get (get identity :record) :sha256) (hash expected)))
            (await (each-await (get before :modules) (async (original index)
              (let* ((source (get original :source)) (module (aref (get identity :modules) index))
                     (expected-asset (js-call Buffer :from (if (= index 2) (JSON/stringify source) source)))
                     (actual (await (readFile (resolve path (get (get module :asset) :path))))))
                (eq-check (js-call Buffer :compare actual expected-asset) 0)
                (eq-check (get (get module :asset) :bytes) (js-length expected-asset))
                (eq-check (get (get module :asset) :sha256) (hash expected-asset))
                (eq-check (get module :bytes) (* (js-length source) 2))
                (eq-check (get module :sha256) (hash (js-call Buffer :from source "utf16le")))))))
            (let ((restored (await (readArchivedCompilerCorpusSources path (js-object :expectedIdentity (get identity :sha256))))))
              (deep restored before) (ok (Object/is (get (get (get restored :original) :shared) :value) -0))
              (js-call assert :notStrictEqual (get (get restored :original) :shared) (get (get restored :execution) :shared)
                "JSON duplicates containers while preserving all primitive values")
              (eq-check (Object/getPrototypeOf (get (get restored :original) :shared)) globalThis.Object.prototype)
              (ok (Object/hasOwn (get (get restored :original) :shared) "__proto__")) (eq-check (get (js-object) :own) undefined))
            (let* ((asset (resolve path (get (get (aref (get identity :modules) 2) :asset) :path)))
                   (good (await (readFile asset))) (bad (js-call Buffer :from good)) (last (- (js-length bad) 2)))
              (put bad last (bit-xor (aref bad last) 1)) (await (writeFile asset bad))
              (await (js-call assert :rejects (readArchivedCompilerCorpusSources path (js-object :expectedIdentity (get identity :sha256))) (rx "asset bytes changed")))
              (await (writeFile asset good))
              (deep (await (readArchivedCompilerCorpusSources path (js-object :expectedIdentity (get identity :sha256)))) before))))))))))

  ;; This frozen JavaScript string is the original subprocess fixture input,
  ;; transported unchanged as data; the maintained test implementation is Eli.
  (test "Given many complete repeated source assets When archived under a small Node heap Then every recipe byte and source file is retained without an aggregate text copy"
    (lambda ()
      (let* ((archive (get (pathToFileURL (resolve "." "tools/backends/compiler-corpus-source-archive.mjs")) :href))
             (script (js-call (js-array
              "import assert from'node:assert/strict';import{mkdtemp,readFile,rm}from'node:fs/promises';"
              "import{createReadStream}from'node:fs';import{tmpdir}from'node:os';import{join}from'node:path';import{createHash}from'node:crypto';"
              (+ "import{archiveCompilerCorpusSources}from " (JSON/stringify archive) ";")
              "const directory=await mkdtemp(join(tmpdir(),'eliscript-bounded-source-'));"
              "try{const source='; complete source\\n'.repeat(131072),count=24;"
              "const modules=Array.from({length:count},(_,index)=>({id:'m'+index+'.mjs',filename:'f'+index+'.eli',source}));"
              "const record={id:'bounded',kind:'project',modules,expected:{kind:'value',value:-0}};"
              "const identity=await archiveCompilerCorpusSources(record,directory),quoted=JSON.stringify(source);"
              "function* expected(){yield '{\"id\":\"bounded\",\"kind\":\"project\",\"modules\":[';"
              "for(let i=0;i<count;i++){if(i)yield ',';yield '{\"id\":'+JSON.stringify(modules[i].id)+',\"filename\":'+JSON.stringify(modules[i].filename)+',\"source\":';yield quoted;yield '}';}"
              "yield '],\"expected\":{\"kind\":\"value\",\"value\":-0}}\\n';}"
              "const parts=expected();let part=parts.next(),offset=0,total=0;const hash=createHash('sha256');"
              "for await(const bytes of createReadStream(join(directory,'record.json'),{highWaterMark:65536})){"
              "hash.update(bytes);total+=bytes.length;let at=0;while(at<bytes.length){while(!part.done&&offset===part.value.length){part=parts.next();offset=0;}"
              "assert(!part.done,'record has unexpected trailing bytes');const size=Math.min(bytes.length-at,part.value.length-offset);"
              "assert.equal(bytes.subarray(at,at+size).toString('utf8'),part.value.slice(offset,offset+size));offset+=size;at+=size;}}"
              "while(!part.done&&offset===part.value.length){part=parts.next();offset=0;}assert(part.done,'record was truncated');"
              "assert.equal(identity.record.bytes,total);assert.equal(identity.record.sha256,hash.digest('hex'));"
              "for(let i=0;i<count;i++){const entry=identity.modules[i],bytes=await readFile(join(directory,entry.asset.path));"
              "assert.equal(entry.id,modules[i].id);assert.equal(entry.filename,modules[i].filename);assert.equal(bytes.toString('utf8'),source);"
              "assert.equal(entry.asset.bytes,bytes.length);assert.equal(entry.asset.sha256,createHash('sha256').update(bytes).digest('hex'));"
              "assert.equal(entry.bytes,source.length*2);assert.equal(entry.sha256,createHash('sha256').update(Buffer.from(source,'utf16le')).digest('hex'));}"
              "assert.equal(modules.length,count);assert(Object.is(record.expected.value,-0));process.stdout.write('all source recipe and asset bytes preserved');"
              "}finally{await rm(directory,{recursive:true,force:true});}") :join "\n"))
             (child (spawnSync "node" (js-array "--max-old-space-size=64" "--input-type=module" "--eval" script)
               (js-object :encoding "utf8" :timeout 30000 :maxBuffer 65536))))
        (eq-check (get child :error) undefined) (eq-check (get child :signal) nil)
        (eq-check (get child :status) 0 (get child :stderr))
        (eq-check (get child :stdout) "all source recipe and asset bytes preserved"))) 30000)

  (test "Given original sources When retained assets recipes or identities change Then replay refuses the changed bytes"
    (async () (await (workspace (async (directory)
      (await (each-await (js-array "asset" "recipe" "identity" "traversal" "duplicate")
        (async (mutation index)
          (let* ((path (resolve directory mutation)) (record (project "; \ud800")) (identity (await (archiveCompilerCorpusSources record path))))
            (when (= mutation "asset") (await (writeFile (resolve path (get (get (aref (get identity :modules) 0) :asset) :path)) "\"; \\udc00\"")))
            (when (= mutation "recipe")
              (let ((changed (clone record))) (put (get changed :expected) :value 0)
                (await (writeFile (resolve path "record.json") (+ (encodeCompilerIR changed) "\n")))))
            (when (= mutation "identity") (await (writeFile (resolve path "source-identity.json") "{}")))
            (when (or (= mutation "traversal") (= mutation "duplicate"))
              (let ((changed (clone identity)))
                (Reflect/deleteProperty changed "sha256")
                (put (get (aref (get changed :modules) 0) :asset) :path (if (= mutation "traversal") "../outside.eli" "record.json"))
                (put changed :sha256 (hash (js-call Buffer :from (+ (encodeCompilerIR changed) "\n"))))
                (await (writeFile (resolve path "source-identity.json") (+ (encodeCompilerIR changed) "\n")))))
            (await (js-call assert :rejects (readArchivedCompilerCorpusSources path (js-object :expectedIdentity (get identity :sha256))))))))))))))

  (test "Given malformed archived bytes When identity differs Then integrity precedes decoding and only an authenticated malformed asset exposes its original codec error"
    (async () (await (workspace (async (directory)
      (await (each-await (js-array "utf8" "json-utf16") (async (mode index)
        (let* ((path (resolve directory mode)) (record (project (if (= mode "utf8") "; original" "; \ud800")))
               (identity (await (archiveCompilerCorpusSources record path))) (asset (get (aref (get identity :modules) 0) :asset))
               (good (await (readFile (resolve path (get asset :path)))))
               (malformed (if (= mode "utf8") (js-call Buffer :from (js-array 192 175)) (js-call Buffer :from "\"\\u12X4\""))))
          (await (writeFile (resolve path (get asset :path)) malformed))
          (await (js-call assert :rejects (readArchivedCompilerCorpusSources path (js-object :expectedIdentity (get identity :sha256))) (rx "asset bytes changed")))
          (let ((body (clone identity)))
            (Reflect/deleteProperty body "sha256")
            (put (get (aref (get body :modules) 0) :asset) :bytes (js-length malformed))
            (put (get (aref (get body :modules) 0) :asset) :sha256 (hash malformed))
            (let ((changed (Object/assign (js-object) body (js-object :sha256 (hash (js-call Buffer :from (+ (encodeCompilerIR body) "\n")))))))
              (await (writeFile (resolve path "source-identity.json") (+ (encodeCompilerIR changed) "\n")))
              (await (js-call assert :rejects (readArchivedCompilerCorpusSources path (js-object :expectedIdentity (get changed :sha256)))
                (if (= mode "utf8") globalThis.TypeError globalThis.SyntaxError)))))
          (await (writeFile (resolve path (get asset :path)) good))
          (await (writeFile (resolve path "source-identity.json") (+ (encodeCompilerIR identity) "\n")))
          (deep (await (readArchivedCompilerCorpusSources path (js-object :expectedIdentity (get identity :sha256)))) record)))))
      (let* ((path (resolve directory "recipe")) (record (project "; recipe")) (identity (await (archiveCompilerCorpusSources record path)))
             (original (await (readFile (resolve path "record.json")))) (malformed (js-call Buffer :from (js-array 123 192 175 125))))
        (await (writeFile (resolve path "record.json") malformed))
        (await (js-call assert :rejects (readArchivedCompilerCorpusSources path (js-object :expectedIdentity (get identity :sha256))) (rx "recipe bytes changed")))
        (let ((body (clone identity)))
          (Reflect/deleteProperty body "sha256") (put (get body :record) :bytes (js-length malformed)) (put (get body :record) :sha256 (hash malformed))
          (let ((changed (Object/assign (js-object) body (js-object :sha256 (hash (js-call Buffer :from (+ (encodeCompilerIR body) "\n")))))))
            (await (writeFile (resolve path "source-identity.json") (+ (encodeCompilerIR changed) "\n")))
            (await (js-call assert :rejects (readArchivedCompilerCorpusSources path (js-object :expectedIdentity (get changed :sha256))) globalThis.TypeError))))
        (await (writeFile (resolve path "record.json") original))
        (await (writeFile (resolve path "source-identity.json") (+ (encodeCompilerIR identity) "\n")))
        (deep (await (readArchivedCompilerCorpusSources path (js-object :expectedIdentity (get identity :sha256)))) record)))))))

  (test "Given virtual identities unsuitable as disk names When archived Then ordinal paths preserve distinct source identities"
    (async () (await (workspace (async (directory)
      (let ((record (project "; high")))
        (put (aref (get record :modules) 0) :id "same-\ud800.mjs") (put record :entry (get (aref (get record :modules) 0) :id))
        (js-call (get record :modules) :push (js-object :id "same-\udc00.mjs" :filename "same-\udc00.eli" :source "; low"))
        (js-call (get record :modules) :push (js-object :id "same-�.mjs" :filename "same-�.eli" :source "; replacement"))
        (let ((identity (await (archiveCompilerCorpusSources record directory))))
          (eq-check (get (new globalThis.Set (array-map (get identity :modules) (lambda (item) (get (get item :asset) :path)))) :size) 3)
          (deep (await (readArchivedCompilerCorpusSources directory (js-object :expectedIdentity (get identity :sha256)))) record))))))))

  (test "Given filesystem aliases When source assets are written or replayed Then the case archive cannot escape its owned directory"
    (async () (await (workspace (async (directory)
      (let ((outside (resolve directory "outside")))
        (await (mkdir outside))
        (let* ((path (resolve directory "case")) (identity (await (archiveCompilerCorpusSources (project "; original") path)))
               (asset (get (get (aref (get identity :modules) 0) :asset) :path)))
          (await (writeFile (resolve outside "source.eli") "; original"))
          (await (rm (resolve path asset))) (await (symlink (resolve outside "source.eli") (resolve path asset)))
          (await (js-call assert :rejects (readArchivedCompilerCorpusSources path (js-object :expectedIdentity (get identity :sha256))) (rx "alias")))
          (let ((link-root (resolve directory "root-alias")))
            (await (symlink outside link-root "dir"))
            (await (js-call assert :rejects (archiveCompilerCorpusSources (project "; outside") link-root) (rx "real directory"))))
          (let ((child-root (resolve directory "child-alias")))
            (await (mkdir child-root)) (await (symlink outside (resolve child-root "modules") "dir"))
            (await (js-call assert :rejects (archiveCompilerCorpusSources (project "; outside") child-root) (rx "alias")))))))))))

  (test "Given frozen original suites When an auxiliary source changes without manifest edits Then the matrix refuses mixed corpus revisions"
    (async () (await (workspace (async (directory)
      (let ((original (js-object :parity.json "{\"identity\":\"parity\"}" :stable.json "{\"identity\":\"stable\"}"
        :suite.mjs "export const expected = -0;\n" :provider.mjs "export const original = \"中😀\";\n")))
        (await (each-await (Object/entries original) (async (entry index) (await (writeFile (resolve directory (aref entry 0)) (aref entry 1))))))
        (let* ((declaration (lambda (file) (js-object :file file :sha256 (hash (js-call Buffer :from (get original file))) :bytes (js-call Buffer :byteLength (get original file)))))
               (corpus (js-object :originals (js-object :manifests (array-map (js-array "parity.json" "stable.json") declaration) :evidence (js-array (funcall declaration "suite.mjs")))
                 :document (js-object :evidence (js-array (funcall declaration "suite.mjs") (funcall declaration "provider.mjs")))))
               (first (await (verifyOriginalCompilerCorpusFiles (js-object :sourceRoot directory :corpus corpus)))))
          (eq-check (get first :status) "unchanged") (deep (get first :changedFiles) (js-array)) (eq-check (js-length (get first :files)) 4)
          (await (writeFile (resolve directory "provider.mjs") "export const original = \"中😁\";\n"))
          (let ((changed (await (verifyOriginalCompilerCorpusFiles (js-object :sourceRoot directory :corpus corpus)))))
            (eq-check (get changed :status) "changed") (deep (get changed :changedFiles) (js-array "provider.mjs"))
            (eq-check (get (find (get changed :files) (lambda (item) (= (get item :file) "provider.mjs"))) :bytes)
              (js-call Buffer :byteLength (get original "provider.mjs")))
            (each (js-array "parity.json" "stable.json") (lambda (file index)
              (eq-check (get (find (get changed :files) (lambda (item) (= (get item :file) file))) :unchanged) t))))
          (await (writeFile (resolve directory "provider.mjs") (get original "provider.mjs")))
          (eq-check (get (await (verifyOriginalCompilerCorpusFiles (js-object :sourceRoot directory :corpus corpus))) :status) "unchanged")
          (await (rm (resolve directory "suite.mjs")))
          (let ((removed (await (verifyOriginalCompilerCorpusFiles (js-object :sourceRoot directory :corpus corpus)))))
            (deep (get removed :changedFiles) (js-array "suite.mjs"))
            (eq-check (get (get (find (get removed :files) (lambda (item) (= (get item :file) "suite.mjs"))) :error) :code) "ENOENT"))
          (let ((conflict (clone corpus)))
            (put (aref (get (get conflict :document) :evidence) 0) :sha256 (js-call "0" :repeat 64))
            (await (js-call assert :rejects (verifyOriginalCompilerCorpusFiles (js-object :sourceRoot directory :corpus conflict)) (rx "conflicting source revisions"))))
          (let ((escaping (clone corpus)))
            (put (aref (get (get escaping :document) :evidence) 1) :file "../outside.mjs")
            (await (js-call assert :rejects (verifyOriginalCompilerCorpusFiles (js-object :sourceRoot directory :corpus escaping)) (rx "relative module identities")))))))))))

  (test "Given a complete original corpus recipe When loaded from bytes or a mutable caller Then its retained input has one exact revision"
    (async () (await (workspace (async (directory)
      (let* ((source-root (resolve ".")) (originals (await (loadOriginalCompilerManifests (js-object :sourceRoot source-root))))
             (document (await (loadOriginalCompilerCorpus (js-object :sourceRoot source-root :originals originals)))))
        (ok (> (js-length (get document :records)) 0))
        ;; Nested backticks remain source data, never an import of the test.
        (let* ((reflection-suite "tests/wasm-managed-function-properties.test.mjs")
               (symbol-forms (js-call (array-map (js-array "iterator" "toPrimitive" "match" "replace" "search" "split" "species" "isConcatSpreadable"
                 "toStringTag" "hasInstance" "asyncIterator" "unscopables" "matchAll" "dispose" "asyncDispose")
                 (lambda (name) (+ "(js* \"Symbol." name "\")"))) :join " "))
               (reflection-records (select (get document :records) (lambda (record) (js-call (get record :id) :startsWith "original-managed-fixture:function-properties:")))))
          (eq-check (js-length reflection-records) 2)
          (await (each-await reflection-records (async (record index)
            (let ((entry (find (get record :modules) (lambda (module) (= (get module :filename) "tests/fixtures/wasm-managed-function-properties.eli")))))
              (ok (includes (get entry :source) (+ "(aref (js-array " symbol-forms ") index)")))
              (ok (includes (get entry :source) "(defun error-stack-observation ()"))
              (ok (includes (get entry :source) "(export descriptor-field error-stack-observation"))
              (ok (not (includes (get entry :source) "${wellKnownSymbolNames")))
              (ok (includes (get (get record :execution) :hostSource) "const wellKnownSymbolNames=['iterator','toPrimitive'")
                "the transported reflectionKeys spread keeps its original static declaration")
              (eq-check (get (get record :original) :sourceSha256) (hash (await (readFile reflection-suite))))
              (deep (get record :coverage) (js-array "stable-compatibility:tests/fixtures/wasm-managed-function-properties.eli")))))))
        (let* ((extra (select (get originals :additionalLocators) (lambda (locator)
                 (and (includes originalRuntimeSourceSuites (get locator :file)) (get locator :originalExecution)))))
               (extra-record-ids (new globalThis.Set (array-map extra (lambda (locator) (get (get locator :originalExecution) :record)))))
               (complete-core (select extra (lambda (locator) (= (get (get locator :originalExecution) :record) "original-program:core-stdlib-complete-protocols")))))
          (eq-check (js-length extra) 13 "all twelve retained regions and the complete core protocol body enter the original inventory")
          (eq-check (js-length complete-core) 1)
          (eq-check (get (aref complete-core 0) :id) "stable-compatibility:source-region:tests/core-stdlib.test.mjs:complete-protocols:0")
          (each extra (lambda (locator index)
            (let ((record (find (get document :records) (lambda (item) (= (get item :id) (get (get locator :originalExecution) :record))))))
              (ok record "the original region retains its actual selected-product record")
              (ok (includes (get record :coverage) (get locator :id)) "the exact executed region must cover its own record")
              (ok (includes (get document :coverageIds) (get locator :id)))
              (eq-check (get (get record :original) :sourceSha256) (get (get locator :originalCase) :sourceSha256))
              (each (select (get document :records) (lambda (item) (and (not (= (get item :id) (get record :id))) (js-call extra-record-ids :has (get item :id)))))
                (lambda (other ignored) (ok (not (includes (get other :coverage) (get locator :id))) "a sibling record cannot borrow this execution region")))
              (when (get record :execution) (eq-check (get (get record :execution) :timeoutMs) (get (get locator :originalCase) :timeoutMs)
                "the host preserves its original registered case deadline"))))))
        (let* ((zipper (find (get document :records) (lambda (item) (= (get item :id) "original-program:persistent-zipper-indexed-ascent"))))
               (invalid (find (get document :records) (lambda (item) (= (get item :id) "original-sequence:literal-runtime-invalid-inputs"))))
               (identity-cases (select (get originals :additionalLocators) (lambda (locator)
                 (and (includes originalIdentityValueSuites (get locator :file)) (not (get locator :originalExecution))))))
               (replay (find (get document :records) (lambda (record) (= (get record :id) "original-managed-suite:complete-fixture-suites"))))
               (array-index-suite "tests/wasm-managed-array-index-storage.test.mjs")
               (array-index-binding (find (get (get replay :original) :suites) (lambda (item) (= (get item :file) array-index-suite))))
               (trie-fixture "tests/fixtures/regexp-property-original-trie.eli")
               (trie-suite (find (get (get replay :original) :suites) (lambda (item) (= (get item :file) "tests/regexp-property-outlining.test.mjs")))))
          (ok (includes (get (get zipper :execution) :hostSource) "for(let i=0;i<512;i++)"))
          (ok (includes (get (get zipper :execution) :hostSource) "assert.equal(visits,0,'one ancestor lookup must not scan wide parent vectors')"))
          (eq-check (get (get zipper :execution) :timeoutMs) 30000)
          (eq-check (get (get (aref (get invalid :steps) 0) :request) :source) "(hash-map \"key\")\n")
          (eq-check (get (get (aref (get invalid :steps) 1) :request) :source) "(defportable build () [missing])\n(export build)\n")
          (eq-check (js-length identity-cases) 25 "all 20 identity and 5 Value/JSON registrations remain mandatory")
          (ok array-index-binding "the new array-index storage regression must run even before a frozen conformance locator names it")
          (eq-check (get array-index-binding :sourceSha256) (hash (await (readFile array-index-suite))))
          (ok (includes (get (get replay :execution) :hostSource) (JSON/stringify array-index-suite)))
          (ok trie-suite "the exact frozen trie must be reconstructed compiled and executed by its original full suite")
          (ok (includes (get (get replay :execution) :hostSource) (JSON/stringify (get trie-suite :file))))
          (eq-check (get trie-suite :sourceSha256) (hash (await (readFile (get trie-suite :file)))))
          (ok (includes (get trie-suite :coverage) (+ "stable-compatibility:" trie-fixture)))
          (ok (includes (get replay :coverage) (+ "stable-compatibility:" trie-fixture)))
          (eq-check (get (find (get trie-suite :sourceInputs) (lambda (item) (= (get item :file) trie-fixture))) :sourceSha256) (hash (await (readFile trie-fixture))))
          (each identity-cases (lambda (locator index)
            (ok (includes (get document :coverageIds) (get locator :id))) (ok (includes (get replay :coverage) (get locator :id)))
            (let ((suite (find (get (get replay :original) :suites) (lambda (item) (= (get item :file) (get locator :file))))))
              (ok (includes (get suite :coverage) (get locator :id)))
              (eq-check (get suite :sourceSha256) (get (get locator :originalCase) :sourceSha256))
              (ok (not (some (get document :missingCaseAdapters) (lambda (item) (= (get item :coverageId) (get locator :id)))))
                "an exact original identity/Value JSON registration already in the complete selected replay is not a missing fragment"))))
          (let* ((debugging (find (get document :records) (lambda (record) (= (get record :id) "original-program:compiler-source-debugging"))))
                 (debugging-source (await (readFile "tests/source-debugging.test.mjs" "utf8")))
                 (body-start (js-call debugging-source :indexOf "test(\"source mapping decodes V8 and browser stack dialects without a host API\"")))
            (ok debugging "source debugging retains an executable selected-compiler recipe")
            (eq-check (get debugging :kind) "project") (eq-check (get (get debugging :request) :sourceMap) t)
            (eq-check (js-length (get debugging :modules)) 13) (eq-check (get debugging :entry) "bootstrap/compiler/compiler.mjs")
            (eq-check (get (get debugging :execution) :runtimeLaunchers) t) (eq-check (get (get debugging :execution) :compilerSourceMaps) t)
            (deep (get (get (get debugging :execution) :setupReplacement) :originalCaseTimeouts) (js-array 5000 5000 5000 5000 5000))
            (eq-check (get (get debugging :original) :sourceSha256) (hash (js-call Buffer :from debugging-source)))
            (deep (get (get debugging :original) :regions) (js-array (js-object :start 0 :end (js-length debugging-source) :byteStart 0
              :byteEnd (js-call Buffer :byteLength debugging-source) :sha256 (hash (js-call Buffer :from debugging-source)))))
            (ok (>= body-start 0)) (ok (includes (get (get debugging :execution) :hostSource) (js-call debugging-source :slice body-start))
              "all original mapping, CLI, persistent-evaluation, Node/Bun event and manifest-drift assertions remain verbatim")
            (ok (includes (get (get debugging :execution) :hostSource) "loadCompiler(__eliscript_debug_compiler_directory)"))
            (ok (includes (get (get debugging :execution) :hostSource) "ELISCRIPT_BOOTSTRAP_MODULE_DIR: __eliscript_debug_compiler_directory"))
            (ok (not (includes (get (get debugging :execution) :hostSource) "const compiler = await loadCompiler();")))
            (await (each-await (get (get debugging :original) :sourceAssets) (async (asset index)
              (eq-check (get asset :sourceSha256) (hash (await (readFile (get asset :file)))))
              (when (includes (get (get (find (get originals :manifests) (lambda (item) (= (get item :id) "stable-compatibility"))) :document) :fixtureFiles) (get asset :file))
                (ok (includes (get debugging :coverage) (+ "stable-compatibility:" (get asset :file))))))))
            (each (select (get (get document :originalGateEvidence) :locators) (lambda (item) (= (get item :file) "tests/source-debugging.test.mjs")))
              (lambda (locator index) (ok (includes (get debugging :coverage) (get locator :id)))
                (ok (not (some (get document :missingCaseAdapters) (lambda (item) (= (get item :coverageId) (get locator :id)))))))))
          (let* ((literal (find (get document :records) (lambda (record) (= (get record :id) "original-program:compiler-literal-runtime-complete"))))
                 (literal-source (await (readFile "tests/literal-runtime.test.mjs" "utf8")))
                 (eli-file "tests/eliscript/literal-runtime.eli") (eli-source (await (readFile eli-file "utf8")))
                 (setup (get (get literal :execution) :setupReplacement)))
            (ok literal "the remaining literal suite has its own complete selected/reference compiler execution")
            (eq-check (js-length (get literal :modules)) 13) (eq-check (get (get literal :execution) :referenceArtifact) t)
            (eq-check (get (get literal :execution) :runtimeLaunchers) t) (eq-check (get (get literal :execution) :compilerSourceMaps) t)
            (deep (get setup :originalCaseTimeouts) (js-array 60000 60000 60000 5000 60000))
            ;; The maintained suite is now generated as one source revision.
            ;; Compare the complete source, not a formatting-dependent tail.
            (eq-check (get (get literal :execution) :hostSource) literal-source
              "both complete byte/map comparisons, original value categories, both compiler failures and the original source audit remain verbatim")
            (eq-check (get (get literal :original) :sourceSha256) (hash (js-call Buffer :from literal-source)))
            (eq-check (get setup :sourceSha256) (hash (js-call Buffer :from literal-source)))
            (eq-check (get setup :kind) "selected-and-independent-reference-compiler-directories")
            (eq-check (get setup :algorithms) "selected-target-only") (deep (get setup :changes) (js-array))
            (let ((binding (find (get (get literal :original) :sourceAssets) (lambda (asset) (= (get asset :file) eli-file)))))
              (ok binding "the generated complete host source is bound to its maintained Eli source")
              (eq-check (get binding :sourceSha256) (hash (js-call Buffer :from eli-source))))
            (ok (includes eli-source "(defconst reference-root (get environment :ELISCRIPT_ORIGINAL_REFERENCE_PRODUCT_ROOT))"))
            (ok (includes eli-source "(resolve reference-root \"bootstrap/compiler\")"))
            (ok (includes eli-source "(resolve (aref (get globalThis.process :argv) 2) \"bootstrap/compiler\")"))
            (ok (includes eli-source "(await (install-selected (get extra :ELISCRIPT_BOOTSTRAP_OUT_DIR)))"))
            (ok (includes eli-source "(js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR reference)"))
            (ok (includes eli-source "(defasync runLiteralRuntimeCases ()"))
            (ok (includes eli-source "(defasync literal-runtime-source-audit ()"))
            (await (each-await (get (get literal :original) :sourceAssets) (async (asset index)
              (eq-check (get asset :sourceSha256) (hash (await (readFile (get asset :file))))))))
            (each (select (get (get document :originalGateEvidence) :locators) (lambda (item) (= (get item :file) "tests/literal-runtime.test.mjs")))
              (lambda (locator index)
                (if (= (get locator :contains) "maintained Eliscript sources use explicit host constructors")
                  (progn (ok (not (includes (get literal :coverage) (get locator :id))))
                    (ok (includes (get (get document :originalGateEvidence) :coverageIds) (get locator :id)))
                    (ok (some (get (get document :originalGateEvidence) :hostOnlyDependencies) (lambda (item)
                      (and (= (get item :coverageId) (get locator :id)) (= (get item :kind) "source-only-case"))))))
                  (ok (includes (get literal :coverage) (get locator :id))))
                (ok (not (some (get document :missingCaseAdapters) (lambda (item) (= (get item :coverageId) (get locator :id)))))))))
          (let* ((interop (find (get document :records) (lambda (record) (= (get record :id) "original-program:compiler-interop-package-complete"))))
                 (interop-source (await (readFile "tests/interop-package.test.mjs" "utf8")))
                 (interop-body (js-call interop-source :indexOf "test(\"maintained JavaScript package consumes native values across compilers and hosts\"")))
            (ok interop "the actual package consumer executes with both original project builders")
            (eq-check (js-length (get interop :modules)) 13) (eq-check (get (get interop :execution) :runtimeLaunchers) t)
            (eq-check (get (get interop :execution) :timeoutMs) 120000)
            (deep (get (get (get interop :execution) :setupReplacement) :originalCaseTimeouts) (js-array 120000))
            (ok (>= interop-body 0)) (ok (includes (get (get interop :execution) :hostSource) (js-call interop-source :slice interop-body))
              "both complete package trees, every emitted JS/map equality, all four Bun/Node consumers and exact mutation/isolation assertions remain verbatim")
            (eq-check (get (get interop :original) :sourceSha256) (hash (js-call Buffer :from interop-source)))
            (ok (includes (get (get interop :execution) :hostSource) "await compilePackage(seedBuild, seedPackage)"))
            (ok (includes (get (get interop :execution) :hostSource) "await compilePackage(selfHostedBuild, selfHostedPackage"))
            (ok (includes (get (get interop :execution) :hostSource) "if (command[0] === selfHostedBuild)"))
            (ok (not (includes (get (get interop :execution) :hostSource) "if (command[0] === seedBuild)"))
              "the independent original Emacs project oracle must not be replaced by the selected implementation")
            (await (each-await (get (get interop :original) :sourceAssets) (async (asset index)
              (eq-check (get asset :sourceSha256) (hash (await (readFile (get asset :file)))))
              (when (includes (get (get (find (get originals :manifests) (lambda (item) (= (get item :id) "stable-compatibility"))) :document) :fixtureFiles) (get asset :file))
                (ok (includes (get interop :coverage) (+ "stable-compatibility:" (get asset :file))))))))
            (each (select (get (get document :originalGateEvidence) :locators) (lambda (item) (= (get item :file) "tests/interop-package.test.mjs")))
              (lambda (locator index) (ok (includes (get interop :coverage) (get locator :id)))
                (ok (not (some (get document :missingCaseAdapters) (lambda (item) (= (get item :coverageId) (get locator :id)))))))))
          (let* ((legacy (find (get document :records) (lambda (record) (= (get record :id) "original-sequence:legacy-native-container-rejection"))))
                 (legacy-fixture "tests/fixtures/compatibility/native-containers-v1.eli")
                 (legacy-source (await (readFile legacy-fixture "utf8")))
                 (migration-contract (JSON/parse (await (readFile "contracts/compatibility-rehearsal.json" "utf8"))))
                 (migration (find (get migration-contract :migrations) (lambda (item) (= (get item :legacySource) legacy-fixture)))))
            (ok legacy "the ignored legacy source is separately executed as its original complete negative stage input")
            (deep (get legacy :coverage) (js-array (+ "stable-compatibility:" legacy-fixture))) (eq-check (js-length (get legacy :steps)) 1)
            (deep (get (aref (get legacy :steps) 0) :request) (js-object :operation "stage" :stage "emitter" :source legacy-source :filename legacy-fixture))
            (deep (get (get legacy :original) :expectedLegacyDiagnostic) (get migration :expectedLegacyDiagnostic))
            (deep (get (aref (get legacy :steps) 0) :error) (js-object :code (get (get migration :expectedLegacyDiagnostic) :code)
              :phase (get (get migration :expectedLegacyDiagnostic) :phase) :expectFields (js-array
                (js-object :path (js-array "message") :value (get (get migration :expectedLegacyDiagnostic) :message))
                (js-object :path (js-array "location" "file") :value legacy-fixture))))
            (eq-check (get (get legacy :original) :sourceSha256) (hash (js-call Buffer :from legacy-source)))
            (eq-check (get (get (get legacy :original) :contract) :sourceSha256) (hash (await (readFile (get (get (get legacy :original) :contract) :file)))))
            (eq-check (get (get legacy :original) :hostSourceSha256) (hash (await (readFile (get (get legacy :original) :host)))))
            (ok (not (some (get document :missingCaseAdapters) (lambda (item) (= (get item :coverageId) (+ "stable-compatibility:" legacy-fixture)))))))
          (await (each-await (js-array
            (js-array "tests/fixtures/declarative-protocol.eli" "stable-compatibility:program:tests/fixtures/declarative-protocol.eli")
            (js-array "tests/fixtures/declarative-multimethod.eli" "stable-compatibility:program:stdlib/multimethod.eli")
            (js-array "tests/fixtures/multimethod-host.mjs" "stable-compatibility:program:stdlib/multimethod.eli")
            (js-array "tests/fixtures/core-expression-forms.eli" "stable-compatibility:program:tests/fixtures/core-expression-forms.eli"))
            (async (pair index)
              (let* ((filename (aref pair 0)) (record-id (aref pair 1))
                     (record (find (get document :records) (lambda (item) (= (get item :id) record-id))))
                     (locators (select (get (get document :originalGateEvidence) :locators) (lambda (item) (= (get item :file) filename)))))
                (ok record) (ok (> (js-length locators) 0))
                (await (each-await locators (async (locator ignored)
                  (let ((proof (find (get (get record :original) :sourceEvidenceBindings) (lambda (item) (= (get item :coverageId) (get locator :id))))))
                    (ok proof) (eq-check (get proof :file) filename) (eq-check (get proof :sourceSha256) (hash (await (readFile filename))))
                    (ok (includes (get record :coverage) (get locator :id)))
                    (ok (not (some (get document :missingCaseAdapters) (lambda (item) (= (get item :coverageId) (get locator :id))))))))))))))
          (await (each-await (js-array (js-array "loop-recur" "loop/recur is stack-safe and identical after self-hosting")
            (js-array "stdlib-bit" "portable 32-bit operations and algorithms agree under Bun and Node"))
            (async (pair index)
              (let* ((name (aref pair 0)) (title (aref pair 1)) (suite (+ "tests/" name ".test.mjs"))
                     (source (await (readFile suite "utf8")))
                     (record (find (get document :records) (lambda (item) (= (get item :id) (+ "original-program:compiler-" name "-complete")))))
                     (at (js-call source :indexOf (+ "test(" (JSON/stringify title)))))
                (ok record) (eq-check (js-length (get record :modules)) 13) (eq-check (get (get record :execution) :referenceArtifact) t)
                (eq-check (get (get record :execution) :runtimeLaunchers) t) (eq-check (get (get record :execution) :compilerSourceMaps) t)
                (eq-check (get (get record :execution) :timeoutMs) 30000)
                (deep (get (get (get record :execution) :setupReplacement) :originalCaseTimeouts) (js-array 30000))
                (ok (>= at 0)) (ok (includes (get (get record :execution) :hostSource) (js-call source :slice at))
                  "all original byte/map, million-iteration, async, independent Node and bit/golden assertions must remain verbatim")
                (eq-check (get (get record :original) :sourceSha256) (hash (js-call Buffer :from source)))
                (ok (includes (get (get record :execution) :hostSource) "ELISCRIPT_ORIGINAL_REFERENCE_PRODUCT_ROOT"))
                (ok (includes (get (get record :execution) :hostSource) "ELISCRIPT_BOOTSTRAP_MODULE_DIR: __frontend_reference"))
                (each (select (get (get document :originalGateEvidence) :locators) (lambda (item) (= (get item :file) suite)))
                  (lambda (locator ignored) (ok (includes (get record :coverage) (get locator :id)))
                    (ok (not (some (get document :missingCaseAdapters) (lambda (item) (= (get item :coverageId) (get locator :id))))))))))))
          (let* ((isolation "tests/fixtures/collection-adapter-isolation.mjs") (isolation-id (+ "stable-compatibility:" isolation))
                 (isolation-gate (find (get (get document :originalGateEvidence) :hostOnlyDependencies) (lambda (item) (= (get item :coverageId) isolation-id))))
                 (isolation-case (get isolation-gate :originalCase)) (original-collection (await (readFile (get isolation-case :file) "utf8")))
                 (isolation-region (js-call original-collection :slice (get (get isolation-case :region) :start) (get (get isolation-case :region) :end))))
            (ok isolation-gate) (eq-check (get isolation-gate :kind) "host-only-runtime-case-fixture")
            (eq-check (get isolation-gate :file) isolation) (eq-check (get isolation-gate :sourceSha256) (hash (await (readFile isolation))))
            (deep (get isolation-gate :engines) (js-array "bun" "node"))
            (eq-check (get isolation-case :sourceSha256) (hash (js-call Buffer :from original-collection)))
            (eq-check (get (get isolation-case :region) :sha256) (hash (js-call Buffer :from isolation-region)))
            (ok (includes isolation-region "await runHost(process.execPath, fixture)"))
            (ok (includes isolation-region "await runHost(\"node\", fixture)"))
            (ok (includes isolation-region "protocolSlotsAbsent: [true, true, true]"))
            (eq-check (js-length (get isolation-gate :dependencies)) 2)
            (await (each-await (get isolation-gate :dependencies) (async (dependency index)
              (eq-check (get dependency :sourceSha256) (hash (await (readFile (get dependency :file))))))))
            (ok (includes (get (get document :originalGateEvidence) :coverageIds) isolation-id)))
          (eq-check (js-length (get document :missingCaseAdapters)) 0 (+ "complete original recipes still require selected-session adapters:\n"
            (js-call (array-map (get document :missingCaseAdapters) (lambda (item) (+ (get item :file) " :: " (get item :coverageId)))) :join "\n")))
          (each (select (get document :records) (lambda (item) (and (js-call (get item :id) :startsWith "original-identity-value:") (= (get item :kind) "project"))))
            (lambda (record index)
              (ok (> (js-length (get record :coverage)) 0)) (eq-check (get (get record :original) :completeOriginalCaseCoverage) false)
              (ok (> (js-length (get (get record :original) :originalCases)) 0))
              (ok (not (some identity-cases (lambda (locator) (includes (get record :coverage) (get locator :id)))))
                "transported fragments cannot claim a compound native or Node suite case")))
          (let* ((order-locator (find (get originals :additionalLocators) (lambda (locator)
                   (= (and (get locator :originalExecution) (get (get locator :originalExecution) :record)) "original-identity-value:host-token-module-order"))))
                 (order (find (get document :records) (lambda (record) (= (get record :id) (get (get order-locator :originalExecution) :record))))))
            (deep (get order :coverage) (js-array (get order-locator :id))) (ok (includes (get replay :coverage) (get order-locator :id)))
            (ok (not (some (get document :missingCaseAdapters) (lambda (item) (= (get item :coverageId) (get order-locator :id))))))
            (deep (get (get order :original) :originalCase) (get order-locator :originalCase))
            (deep (get (get order :original) :originalExecution) (get order-locator :originalExecution))
            (deep (get (get (aref (get order :steps) 1) :request) :modules)
              (js-call (js-call (get (get (aref (get order :steps) 0) :request) :modules) :slice) :reverse))
            (eq-check (get (aref (get order :steps) 1) :sameProductAs) "original-order"))
          (let ((rejected (find (get document :records) (lambda (record) (= (get record :id) "original-identity-value:host-token-rejections")))))
            (eq-check (js-length (get (get rejected :original) :originalCases)) 2)
            (deep (array-map (get (get rejected :original) :originalCases) (lambda (item) (get item :title))) (js-array
              "Given wrong source and IR arity when lowering then no operand is dropped or accepted"
              "Given no intrinsic when an ordinary function is lowered then no hidden state or module ABI is allocated")))
          (each (select (get document :records) (lambda (item) (js-call (rx "^original-identity-value:host-token-cycle(?:Operands)?:") :test (get item :id))))
            (lambda (record index)
              (ok (js-call (get (get record :original) :originalCases) :every (lambda (item) (includes (get item :title) "cyclic"))))
              (deep (array-map (js-call (get (get record :original) :regions) :slice 1) (lambda (region) (get region :sha256)))
                (array-map (get (get record :original) :originalCases) (lambda (item) (get item :sha256)))
                "cycle recipes bind their real cases instead of the unused encounters helper")))
          (let ((empty (Object/assign (js-object) document (js-object :records
            (array-map (get document :records) (lambda (item) (if (= (get item :id) (get zipper :id))
              (Object/assign (js-object) item (js-object :coverage (js-array))) item)))))))
            (await (js-call assert :rejects (loadCompilerMatrixCorpus (js-object :sourceRoot source-root :records empty)) (rx "no original coverage identity"))))
          (ok (> (js-length (get zipper :coverage)) 0))
          (put (aref (get document :records) 0) :original (Object/assign (js-object) (get (aref (get document :records) 0) :original)
            (js-object :transportProbe (js-object :ieee -0 :text "\uFEFF中😀\ud800\udc00\ud800"))))
          ;; Finish this complete file boundary before taking the caller snapshot.
          (await (funcall (async ()
            (let* ((bytes (js-call Buffer :from (+ "\n  " (encodeCompilerIR document) "\n\n"))) (path (resolve directory "recipes.json")))
              (await (writeFile path bytes))
              (let ((loaded (await (loadCompilerMatrixCorpus (js-object :sourceRoot source-root :recordsPath path)))))
                (eq-check (js-call Buffer :compare (get loaded :recordsBytes) bytes) 0) (eq-check (get loaded :recordsSha256) (hash bytes))
                (ok (Object/is (get (get (get (aref (get (get loaded :document) :records) 0) :original) :transportProbe) :ieee) -0))
                (eq-check (get (get (get (aref (get (get loaded :document) :records) 0) :original) :transportProbe) :text)
                  (get (get (get (aref (get document :records) 0) :original) :transportProbe) :text)))))))
          (let* ((before (encodeCompilerIR document)) (pending (loadCompilerMatrixCorpus (js-object :sourceRoot source-root :records document))))
            (put (get (get (aref (get document :records) 0) :original) :transportProbe) :ieee 0)
            (put (get (get (aref (get document :records) 0) :original) :transportProbe) :text "changed after load began")
            (let ((captured (await pending)))
              (exact-corpus-wire (encodeCompilerIR (get captured :document)) before "caller snapshot")
              (exact-corpus-wire (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode (get captured :recordsBytes))
                (+ before "\n") "retained corpus bytes")
              (eq-check (get captured :recordsSha256) (hash (get captured :recordsBytes)))))
          (let ((invalid-bytes-path (resolve directory "invalid-utf8.json")))
            (await (writeFile invalid-bytes-path (js-call globalThis.Uint8Array :from (js-array 123 192 175 125))))
            (await (js-call assert :rejects (loadCompilerMatrixCorpus (js-object :sourceRoot source-root :recordsPath invalid-bytes-path)) globalThis.TypeError))))))))))

  (test "Given original runtime regions absent from older feature manifests When inventoried Then case text spans parameters hashes and original deadlines remain bound"
    (async ()
      (let ((source-root (resolve ".")))
        (await (each-await originalRuntimeSourceSuites (async (file index)
          (let ((source (await (readFile (resolve source-root file) "utf8"))))
            (each (originalRuntimeCaseLocators file source) (lambda (locator ignored)
              (let ((original (get locator :originalCase)) (region (get locator :originalExecution)))
                (eq-check (get original :sourceSha256) (hash (js-call Buffer :from source)))
                (eq-check (get original :sha256) (hash (js-call Buffer :from
                  (js-call source :slice (get (get original :span) :start) (get (get original :span) :end)))))
                (eq-check (get original :byteStart) (js-call Buffer :byteLength (js-call source :slice 0 (get (get original :span) :start))))
                (eq-check (get original :byteEnd) (js-call Buffer :byteLength (js-call source :slice 0 (get (get original :span) :end))))
                (deep (get original :parameters) (js-object))
                (eq-check (js-call source :slice (get (get region :span) :start) (get (get region :span) :end)) (get locator :contains))
                (eq-check (get region :sha256) (hash (js-call Buffer :from (get locator :contains))))
                (eq-check (get region :byteStart) (js-call Buffer :byteLength (js-call source :slice 0 (get (get region :span) :start))))
                (eq-check (get region :byteEnd) (js-call Buffer :byteLength (js-call source :slice 0 (get (get region :span) :end))))
                (ok (and (>= (get (get region :span) :start) (get (get original :span) :start))
                  (<= (get (get region :span) :end) (get (get original :span) :end)))))))))))
        (let* ((file "tests/persistent-zipper.test.mjs") (source (await (readFile (resolve source-root file) "utf8")))
               (original (aref (originalRuntimeCaseLocators file source) 0))
               (changed (aref (originalRuntimeCaseLocators file (js-call source :replace "assert.equal(visits,0," "assert.equal(visits,1,")) 0)))
          (neq-check (get (get changed :originalCase) :sha256) (get (get original :originalCase) :sha256))
          (neq-check (get (get changed :originalExecution) :sha256) (get (get original :originalExecution) :sha256))
          (js-call assert :throws (lambda () (originalRuntimeCaseLocators file (js-call source :replace (get (get original :originalCase) :title) "removed original case")))
            (rx "lost its source case"))
          (js-call assert :throws (lambda () (originalRuntimeCaseLocators "tests/unregistered.test.mjs" source)) (rx "unregistered"))))))

  (test "Given an additional original source suite with dynamic case inputs When registrations are read Then variants retain their actual literal arguments without executing the suite"
    (lambda ()
      (let* ((file "tests/persistent-zipper.test.mjs")
             (source (js-call (js-array "const ignored=\"test('not a case',()=>{})\";" "const engines=['bun','node'];"
               "for(const engine of engines){for(const auto of [1,65536])"
               "test('original '+engine+' '+auto,()=>{throw Error('source-only');},30_000);}" "") :join "\n"))
             (locators (originalSourceCaseLocators file source)))
        (deep (array-map locators (lambda (item) (get (get item :originalCase) :parameters))) (js-array
          (js-object :engine "bun" :auto 1) (js-object :engine "bun" :auto 65536)
          (js-object :engine "node" :auto 1) (js-object :engine "node" :auto 65536)))
        (deep (array-map locators (lambda (item) (get item :contains))) (js-array "original bun 1" "original bun 65536" "original node 1" "original node 65536"))
        (ok (js-call locators :every (lambda (item) (= (get (get item :originalCase) :timeoutMs) 30000))))
        (eq-check (get (new globalThis.Set (array-map locators (lambda (item) (get (get item :originalCase) :sha256)))) :size) 1)
        (eq-check (get (new globalThis.Set (array-map locators (lambda (item) (get item :id)))) :size) 4)
        (js-call assert :throws (lambda () (originalSourceCaseLocators "../outside.test.mjs" source)) (rx "relative source suite")))))

  (test "Given the complete original identity and Value JSON suites When source cases and the module-order helper are retained Then every original registration and actual execution region keeps its exact provenance"
    (async ()
      (let ((deadlines (new globalThis.Map (js-array
        (js-array "tests/wasm-managed-host-identity.test.mjs" (js-array 5000 5000 5000 5000 30000 5000 5000 120000 30000 40000 30000
          5000 5000 5000 5000 5000 120000 120000 5000 5000))
        (js-array "tests/managed-stdlib-value-json.test.mjs" (js-array 30000 30000 120000 40000 30000))))))
        (await (each-await originalIdentityValueSuites (async (file index)
          (let* ((source (await (readFile (resolve file) "utf8"))) (locators (originalIdentityValueCaseLocators file source))
                 (cases (select locators (lambda (locator) (not (get locator :originalExecution))))))
            (deep (array-map cases (lambda (locator) (get (get locator :originalCase) :timeoutMs))) (js-call deadlines :get file))
            (if (= file "tests/wasm-managed-host-identity.test.mjs")
              (progn
                (eq-check (js-length cases) 20)
                (deep (array-map (js-call cases :slice 11) (lambda (locator) (get (get locator :originalCase) :title))) (js-array
                  "Given only functions and no source globals when the default nil boundary is lowered then one private table initializes before the first call"
                  "Given a first source initializer that invokes identity when module state is created then the private helper precedes source effects without changing global indices"
                  "Given multiple explicit groups at one empty-global boundary when functions execute then group-index insertion retains separate monotonic identity tables"
                  "Given malformed group records or a foreign before node when lowering then structured ownership rejection precedes any metadata dereference"
                  "Given malformed identity IR when the independent source prepass rejects it then direct lowering retains the original Error message and exact structured node span"
                  "Given a true native function-only module when its absent project boundary initializes then native preserves the same one-table token order"
                  "Given phased projects when each defining module reaches its evaluation boundary then private helpers stay out of preparation and cyclic TDZ still precedes operand effects"
                  "Given finite JSON identity domains when linking without serialization then escaped keys values and normalized binding spellings choose the original exact salt"
                  "Given exported reachable namespaces and unused imported namespaces when linking then only actual module order owns namespace bindings independent of input order"))
                (eq-check (js-length (select locators (lambda (locator) (get locator :originalExecution)))) 1
                  "new complete cases must not acquire fake fragment/helper execution claims"))
              (eq-check (js-length cases) 5))
            (each locators (lambda (locator ignored)
              (let ((original (get locator :originalCase)))
                (eq-check (get original :sourceSha256) (hash (js-call Buffer :from source)))
                (eq-check (get original :sha256) (hash (js-call Buffer :from
                  (js-call source :slice (get (get original :span) :start) (get (get original :span) :end)))))
                (eq-check (get original :byteStart) (js-call Buffer :byteLength (js-call source :slice 0 (get (get original :span) :start))))
                (eq-check (get original :byteEnd) (js-call Buffer :byteLength (js-call source :slice 0 (get (get original :span) :end))))
                (deep (get original :parameters) (js-object))
                (eq-check (get original :titleExpression) (+ "'" (get original :title) "'")
                  "these actual source case names remain literal single-quoted registrations")
                (if (not (get locator :originalExecution)) (eq-check (get locator :contains) (get original :title))
                  (let ((execution (get locator :originalExecution)))
                    (eq-check (js-call source :slice (get (get execution :span) :start) (get (get execution :span) :end)) (get locator :contains))
                    (eq-check (get execution :sha256) (hash (js-call Buffer :from (get locator :contains))))
                    (eq-check (get execution :byteStart) (js-call Buffer :byteLength (js-call source :slice 0 (get (get execution :span) :start))))
                    (eq-check (get execution :byteEnd) (js-call Buffer :byteLength (js-call source :slice 0 (get (get execution :span) :end))))
                    (each (js-array (get execution :helper) (get execution :invocation)) (lambda (region ignored-region)
                      (eq-check (get region :sha256) (hash (js-call Buffer :from (js-call source :slice (get region :start) (get region :end)))))
                      (eq-check (get region :byteStart) (js-call Buffer :byteLength (js-call source :slice 0 (get region :start))))
                      (eq-check (get region :byteEnd) (js-call Buffer :byteLength (js-call source :slice 0 (get region :end))))))
                    (ok (and (>= (get (get execution :span) :start) (get (get execution :helper) :start))
                      (<= (get (get execution :span) :end) (get (get execution :helper) :end))))
                    (ok (and (>= (get (get execution :invocation) :start) (get (get original :span) :start))
                      (<= (get (get execution :invocation) :end) (get (get original :span) :end))))
                    (eq-check (js-call source :slice (get (get execution :invocation) :start) (get (get execution :invocation) :end)) "const p=await project();")
                    (js-call assert :throws (lambda () (originalIdentityValueCaseLocators file
                      (js-call source :replace (get locator :contains) "assert.deepEqual(bytes,bytes);"))) (rx "module-order assertion left its helper"))
                    (js-call assert :throws (lambda () (originalIdentityValueCaseLocators file
                      (js-call source :replace "const p=await project();" "const p=undefined;"))) (rx "no longer invokes its module-order helper")))))))))))
        (js-call assert :throws (lambda () (originalIdentityValueCaseLocators "tests/unregistered.test.mjs" "")) (rx "unregistered")))))
)
