            (deep (get (aref (get legacy :steps) 0) :request) (js-object :operation "stage" :stage "emitter" :source legacy-source :filename legacy-fixture))
            (deep (get (get legacy :original) :expectedLegacyDiagnostic) (get migration :expectedLegacyDiagnostic))
            (deep (get (aref (get legacy :steps) 0) :error) (js-object :code (get (get migration :expectedLegacyDiagnostic) :code)
              :phase (get (get migration :expectedLegacyDiagnostic) :phase) :expectFields (js-array
                (js-object :path (js-array "message") :value (get (get migration :expectedLegacyDiagnostic) :message))
                (js-object :path (js-array "location" "file") :value legacy-fixture))))
            (eq-check (get (get legacy :original) :sourceSha256) (hash (js-call Buffer :from legacy-source)))
            (eq-check (get (get (get legacy :original) :contract) :sourceSha256) (hash (await (readFile (get (get (get legacy :original) :contract) :file)))))
            (eq-check (get (get legacy :original) :hostSourceSha256) (hash (await (readFile (get (get legacy :original) :host)))))
            (ok (not (some (get document :missingCaseAdapters) (lambda (item) (= (get item :coverageId) (+ "stable-compatibility:" legacy-fixture)))))))
          (await (each-await (js-array
            (js-array "tests/fixtures/declarative-protocol.eli" "stable-compatibility:program:tests/fixtures/declarative-protocol.eli")
            (js-array "tests/fixtures/declarative-multimethod.eli" "stable-compatibility:program:stdlib/multimethod.eli")
            (js-array "tests/fixtures/multimethod-host.mjs" "stable-compatibility:program:stdlib/multimethod.eli")
            (js-array "tests/fixtures/core-expression-forms.eli" "stable-compatibility:program:tests/fixtures/core-expression-forms.eli"))
