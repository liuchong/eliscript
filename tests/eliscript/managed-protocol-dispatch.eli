        :reverse globalThis.Array.prototype.reverse :entries globalThis.Array.prototype.entries
        :keys globalThis.Array.prototype.keys :values globalThis.Array.prototype.values
        :next (get (Object/getPrototypeOf iterator) :next))))
      (js-call (js-array "get" "set" "getPrototypeOf" "setPrototypeOf" "ownKeys" "getOwnPropertyDescriptor"
        "defineProperty" "deleteProperty" "has" "isExtensible" "preventExtensions" "apply" "construct")
