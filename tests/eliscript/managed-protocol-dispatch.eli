(module tests.managed-protocol-dispatch
  (import "node:test" before after test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm mkdir symlink realpath)
  (import "node:path" resolve dirname)
  (import "node:url" pathToFileURL)
  (import "node:os" tmpdir)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs"
    instantiateManagedRuntime instantiateManagedRuntimeWithHostModules loadManagedHostModules)
  (import "../tools/backends/managed-module-graph.mjs"
    createManagedModuleGraph createManagedProjectFacades loadManagedProjectGraph)
  (import "../tools/backends/managed-source-view.mjs" createManagedLiteralHostProvider)
  (import "../tools/backends/managed-source-view-legacy.mjs" :as original-source-view)
  (import "../runtime/literals.mjs" :as literals)
  (import "../runtime/core/protocol-error.mjs" :as protocol-errors)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/backends/managed-foreign-binding.mjs" readManagedForeignProtocolPrototype)
  (import "./helpers/managed-numeric-selfhosted.mjs" loadReference)

  (test "protocol-only foreign prototype classification preserves exact native identity without rereading a prototype or changing ordinary reflection"
    (lambda ()
      (js-call assert :strictEqual (readManagedForeignProtocolPrototype (get globalThis.Object :prototype)) 0)
      (js-call assert :strictEqual (readManagedForeignProtocolPrototype (get globalThis.Array :prototype)) 1)
      (js-call assert :strictEqual (readManagedForeignProtocolPrototype (get globalThis.Map :prototype)) 2)
      (js-call assert :strictEqual (readManagedForeignProtocolPrototype (get globalThis.Set :prototype)) 3)
      (js-call assert :strictEqual (readManagedForeignProtocolPrototype nil) nil)
      (let* ((prototype (js-object)) (value (Object/create prototype)))
        (js-call assert :strictEqual (readManagedForeignProtocolPrototype prototype) prototype)
        (js-call assert :strictEqual (Object/getPrototypeOf value) prototype))
      (let ((value (js-array)))
        (Object/setPrototypeOf value (js-object))
        (let ((prototype (Object/getPrototypeOf value)))
          (js-call assert :strictEqual (readManagedForeignProtocolPrototype prototype) prototype)))
      (js-call (js-array (new globalThis.Map) (new globalThis.Set)) :forEach (lambda (value)
        (let ((custom (Object/create (Object/getPrototypeOf value))))
          (Object/setPrototypeOf value custom)
          (js-call assert :strictEqual (readManagedForeignProtocolPrototype (Object/getPrototypeOf value)) custom))))
      (let ((reads 0) (prototype (get globalThis.Array :prototype)))
        (let ((value (new globalThis.Proxy (js-object)
                       (js-object :getPrototypeOf (lambda (target) (setq reads (1+ reads)) prototype)))))
          (let ((original (Object/getPrototypeOf value)))
            (js-call assert :strictEqual (readManagedForeignProtocolPrototype original) 1))
          (js-call assert :strictEqual reads 1)
          ;; No global codec or Reflect operation is patched by this helper.
          (js-call assert :strictEqual (Object/getPrototypeOf value) prototype)
          (js-call assert :strictEqual reads 2)))
      (let ((failures (js-array false undefined (js-object :original t))) (index 0))
        (while (< index (js-length failures))
          (let* ((first (aref failures index)) (caught false) (actual nil)
                 (value (new globalThis.Proxy (js-object)
                   (js-object :getPrototypeOf (lambda (target) (throw first))))))
            (try (readManagedForeignProtocolPrototype (Object/getPrototypeOf value))
              (catch error (setq caught t actual error)))
            (js-call assert :strictEqual caught t)
            (js-call assert :strictEqual actual first))
          (setq index (1+ index))))))

  (test "actual host Proxy authentication excludes foreign capabilities without any reflection while retaining real literal classifications and custom providers"
    (async ()
      ;; This is the same asynchronous importer used before a synchronous
      ;; runtime enters the complete original host body on Bun.
      (await (loadManagedHostModules (js-object :hostModules (js-array))))
      (let* ((provider (createManagedLiteralHostProvider))
             (original (js-call original-source-view :createManagedLiteralHostProvider))
             (reads 0)
             (traps (js-object
               :get (lambda (&rest arguments) (setq reads (1+ reads)) (throw false))
               :getPrototypeOf (lambda (&rest arguments) (setq reads (1+ reads)) (throw false))
               :getOwnPropertyDescriptor (lambda (&rest arguments) (setq reads (1+ reads)) (throw false))
               :ownKeys (lambda (&rest arguments) (setq reads (1+ reads)) (throw false)))))
        (js-call (js-array (js-object) (js-array) (new globalThis.Map) (new globalThis.Set)
                   (lambda () undefined) (js-call literals :vector 1 2))
          :forEach (lambda (target)
            (js-call assert :strictEqual (js-call provider :kind (new globalThis.Proxy target traps)) nil)))
        (let ((revoked (globalThis.Proxy.revocable (js-object) traps)))
          (js-call revoked :revoke)
          (js-call assert :strictEqual (js-call provider :kind (get revoked :proxy)) nil))
        (js-call assert :strictEqual reads 0)
        ;; Genuine values still use every original provider predicate, state
        ;; reader, constructor test and read operation. No visible brand is
        ;; accepted as proof of ownership, and their algorithms stay intact.
        (js-call (js-array
          (js-array "list" (js-call literals :list 1 2))
          (js-array "vector" (js-call literals :vector 1 2))
          (js-array "map" (js-call literals :hashMap "a" 1))
          (js-array "set" (js-call literals :hashSet 1 2))
          (js-array "queue" (js-call literals :queue 1 2))
          (js-array "keyword" (js-call literals :keyword "actual"))
          (js-array "symbol" (js-call literals :symbol "actual")))
          :forEach (lambda (row)
            (let ((value (aref row 1)))
              (js-call assert :strictEqual (js-call provider :kind value) (aref row 0))
              (js-call assert :strictEqual (js-call provider :kind value) (js-call original :kind value))
              (js-call assert :deepStrictEqual (js-call provider :read value) (js-call original :read value)))))
        (let ((comparison (lambda (left right) (- left right))))
          (js-call (js-array "sorted-map" "sorted-set") :forEach (lambda (kind)
            (let ((value (js-call original :create kind (js-array) nil (js-object :comparison comparison))))
              (js-call assert :strictEqual (js-call provider :kind value) kind)
              (js-call assert :deepStrictEqual (js-call provider :read value) (js-call original :read value))))))
        (let ((custom (js-object :kind (lambda (value) "custom") :read (lambda (value) value)
                        :create (lambda (&rest arguments) nil))))
          (js-call assert :strictEqual (createManagedLiteralHostProvider custom) custom)
          (js-call assert :strictEqual (js-call custom :kind (new globalThis.Proxy (js-object) traps)) "custom"))
        (js-call assert :strictEqual reads 0))))

  (test "automatic literal classification does not enter a foreign Proxy anywhere in an ordinary prototype chain"
    (async ()
      (await (loadManagedHostModules (js-object :hostModules (js-array))))
      (let ((provider (createManagedLiteralHostProvider)) (reads 0))
        (js-call (js-array false undefined) :forEach (lambda (first)
          (let ((proxy (new globalThis.Proxy (js-object) (js-object
            :get (lambda (&rest ignored) (setq reads (1+ reads)) (throw first))
            :getPrototypeOf (lambda (&rest ignored) (setq reads (1+ reads)) (throw first))
            :getOwnPropertyDescriptor (lambda (&rest ignored) (setq reads (1+ reads)) (throw first))))))
            (js-call (js-array (js-object) (js-array) (lambda () nil)) :forEach (lambda (value)
              (Object/setPrototypeOf value proxy)
              (js-call assert :strictEqual (js-call provider :kind value) nil)
              (Object/setPrototypeOf value (Object/create proxy))
              (js-call assert :strictEqual (js-call provider :kind value) nil)))
            (let ((custom (js-object :kind (lambda (value) "custom") :read (lambda (value) value)
                            :create (lambda (&rest ignored) nil))))
              (js-call assert :strictEqual (createManagedLiteralHostProvider custom) custom)
              (js-call assert :strictEqual (js-call custom :kind (Object/create proxy)) "custom")))))
        (let ((revoked (globalThis.Proxy.revocable (js-object) (js-object))))
          (js-call revoked :revoke)
          (js-call assert :strictEqual (js-call provider :kind (Object/create (get revoked :proxy))) nil))
        (js-call (js-array nil undefined false 0 "value" (funcall globalThis.Symbol "primitive")
                   (funcall globalThis.BigInt 1)) :forEach
          (lambda (value) (js-call assert :strictEqual (js-call provider :kind value) nil)))
        (js-call assert :strictEqual reads 0)
        ;; Classification must not patch normal user reflection or swallow
        ;; its first thrown value after it has declined automatic branding.
        (let* ((first (js-object :original t)) (caught false) (actual nil)
               (proxy (new globalThis.Proxy (js-object) (js-object
                 :getPrototypeOf (lambda (&rest ignored) (throw first))))))
          (try (Reflect/getPrototypeOf proxy) (catch error (setq caught t actual error)))
          (js-call assert :strictEqual caught t) (js-call assert :strictEqual actual first)))))

  (defvar directory undefined)
  (defvar backend undefined)
  (defvar lowered undefined)
  (defvar bytes undefined)
  (defvar reference undefined)
  (defvar library undefined)
  (defvar runtime-ir undefined)
  (defvar canonical-hash-runtime-ir undefined)
  (defconst native-target (when (= (get globalThis.process :arch) "arm64")
    (cond ((= (get globalThis.process :platform) "darwin") "arm64-macos")
          ((= (get globalThis.process :platform) "linux") "arm64-linux"))))
  (defconst report-source (js-call (js-array
    "(defun ProtocolDispatchError (protocol operation receiver &rest reasons) nil)"
    "(defun error-row (arguments)"
    " (let ((error (Reflect/construct ProtocolDispatchError arguments)))"
    "  (js-array (get error :name) (get error :code) (get error :reason)"
    "    (get error :message) (get error :protocol) (get error :operation))))"
    "(defun report () (let ((prefix (js-array (js-object :name \"Probe\") \"read\" (js-array))))"
    " (JSON/stringify (js-array (error-row prefix)"
    "  (error-row (js-call prefix :concat (js-array undefined)))"
    "  (error-row (js-call prefix :concat (js-array nil)))"
    "  (error-row (js-call prefix :concat (js-array false)))"
    "  (error-row (js-call prefix :concat (js-array \"invalid-direct-slot\")))))))"
    "(export report)") :join "\n"))

  (before (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-protocol-reasons-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (let* ((compiler (get backend :compiler))
           (source (await (readFile (resolve root "stdlib/managed-protocol-error.eli") "utf8")))
           (original (js-call compiler :compile_ir_string source "stdlib/managed-protocol-error.eli"))
           (before (JSON/stringify original))
           (program (js-call compiler :compile_ir_string report-source "protocol-reasons.eli"))
           (actual (get (aref (get original :body) 0) :children))
           (runtime (js-call compiler :compile_ir_string
             (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli")))
      (setq runtime-ir runtime)
      ;; Actual maintained constructor nodes retain their source spans/body.
      (put program :body (js-call actual :concat
        (js-call (get program :body) :filter (lambda (node)
          (not (and (= (get node :kind) "function-declaration")
                    (= (get node :value) "ProtocolDispatchError")))))))
      (setq reference (await (loadReference (resolve directory "reference.mjs")
        (js-call compiler :emit_ir_string program))))
      (setq lowered (js-call (get backend :managed) :lower_managed_program program runtime))
      (setq bytes (globalThis.Uint8Array.from
        (js-call (get backend :wasm) :append_metadata_section
          (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed))
          "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (when native-target
        (setq library (resolve directory (if (= native-target "arm64-macos") "protocol.dylib" "protocol.so")))
        (await (writeFile library (globalThis.Uint8Array.from
          (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target)))))
      (js-call assert :strictEqual (JSON/stringify original) before)))
    (js-object :timeout 120000))
  (after (async () (when directory (await (rm directory (js-object :recursive t :force t))))))

  (defun expected ()
    (let ((row (lambda (reason detail)
      (js-array "ProtocolDispatchError" "ELI-RUNTIME-PROTOCOL" reason
        (str "protocol Probe/read " detail " for object:Array") "Probe" "read"))))
      (JSON/stringify (js-array
        (funcall row "missing" "has no implementation")
        (funcall row "missing" "has no implementation")
        (funcall row nil "has a non-callable direct slot")
        (funcall row false "has a non-callable direct slot")
        (funcall row "invalid-direct-slot" "has a non-callable direct slot")))))
  (test "the actual canonical protocol defconst lambda receives the private exact registry bridge without changing its original source tree"
    (async ()
      (let* ((libraries (get (await (js-call backend :loadLiteralModules)) :literalModules))
             (core (js-call libraries :find (lambda (item) (= (get item :id) "stdlib/core/protocol.mjs"))))
             (program (get core :program)) (before (JSON/stringify program))
             (pending (js-call (get program :body) :slice)) (declaration undefined))
        (while (> (js-length pending) 0)
          (let ((node (js-call pending :pop)))
            (when (and (= (get node :kind) "variable-declaration")
                       (= (get node :value) "protocol-exact-prototype"))
              (setq declaration node))
            (js-call (get node :children) :forEach (lambda (child) (js-call pending :push child)))))
        (js-call assert :ok declaration)
        (let* ((initializer (aref (get declaration :children) 0))
               (input (js-call (get backend :compiler) :compile_ir_string
                 "(import \"eliscript/runtime/core/collection.mjs\" reduce) (defun report (values) (funcall reduce values (lambda (left right) (+ left right)) 0)) (export report)"
                 "actual-protocol-link.eli"))
               (linked (js-call (get backend :managed) :link_managed_project
                 (js-array (js-object :id "entry.mjs" :program input)) "entry.mjs"
                 (js-object :literalModules libraries)))
               (nodes (js-call (get (get linked :program) :body) :slice))
               (marked (js-array)))
          (js-call assert :strictEqual (get initializer :kind) "function-expression")
          (js-call assert :strictEqual (get (get initializer :properties) :parameterCount) 2)
          (js-call assert :strictEqual (Object/hasOwn initializer "managedProtocolExactPrototype") false)
          (while (> (js-length nodes) 0)
            (let ((node (js-call nodes :pop)))
              (when (get node :managedProtocolExactPrototype false) (js-call marked :push node))
              (js-call (get node :children) :forEach (lambda (child) (js-call nodes :push child)))))
          (js-call assert :strictEqual (js-length marked) 2)
          (let ((exact (js-call marked :find (lambda (node) (= (get (get node :properties) :parameterCount) 2)))))
            (js-call assert :ok exact)
            (js-call assert :strictEqual (get exact :kind) "function-expression")
            (js-call assert :strictEqual (get exact :span) (get initializer :span))
            (js-call assert :strictEqual (get (get exact :span) :filename) "stdlib/core/protocol.eli")))
        (js-call assert :strictEqual (JSON/stringify program) before))))

  (defun protocol-bridge-nodes (program)
    (let ((pending (js-call (get program :body) :slice)) (found (js-array)))
      (while (> (js-length pending) 0)
        (let ((node (js-call pending :pop)))
          (when (get node :managedProtocolExactPrototype false) (js-call found :push node))
          (js-call (get node :children) :forEach (lambda (child) (js-call pending :push child))))) found))
  (defconst canonical-hash-names (js-array "avalancheHash" "mixHash" "finishHash" "hashString"))
  (defun canonical-hash-helpers (program)
    (let ((pending (js-call (get program :body) :slice)) (helpers (js-array)))
      (while (> (js-length pending) 0)
        (let ((node (js-call pending :shift)))
          (if (= (get node :kind) "module-declaration")
            (setq pending (js-call (get node :children) :concat pending))
            (when (and (= (get node :kind) "function-declaration")
                       (js-call canonical-hash-names :includes (get node :value)))
              (js-call helpers :push node))))) helpers))
  (defun canonical-hash-test-program (compiler helpers extra)
    ;; Analyze the callers with declared bindings, then substitute the exact
    ;; standard-library IR. The placeholders never reach either target.
    (let* ((bindings (js-call (js-array
               "(defun avalancheHash (value) value)"
               "(defun mixHash (hash value) hash)"
               "(defun finishHash (hash count) hash)"
               "(defvar hashString (lambda (value &rest tags) value))") :join "\n"))
           (program (js-call compiler :compile_ir_string
                      (js-call (js-array bindings extra) :join "\n") "canonical-hash-test.eli"))
           (body (js-call (get program :body) :filter (lambda (node)
             (not (and (js-call (js-array "function-declaration" "variable-declaration") :includes (get node :kind))
                       (js-call canonical-hash-names :includes (get node :value))))))))
      (put program :body (js-call helpers :concat body)) program))
  (defun canonical-hash-fast-call-count (lowered)
    (let* ((functions (get (get lowered :typed) :functions))
           (helper (js-call functions :find (lambda (function) (= (get function :name) "value-canonical-string-hash-try"))))
           (count 0))
      (js-call assert :ok helper)
      (js-call functions :forEach (lambda (function)
        (when (js-call (get function :name "") :startsWith "__eliscript_managed_")
          (let ((pending (js-array (get function :body))))
            (while (> (js-length pending) 0)
              (let ((node (js-call pending :pop)))
                (when (and (= (get node :kind) "call") (= (get node :value) (get helper :index)))
                  (setq count (1+ count)))
                (js-call (get node :children) :forEach (lambda (child) (js-call pending :push child))))))))) count))
  (defasync canonical-hash-counted-runtime ()
    (unless canonical-hash-runtime-ir
      (let* ((source (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
             (needle "(heap-number-from-word heap string-hash 0)")
             (counted (js-call source :replace needle
               "(progn (store-u32 144 (1+ (load-u32 144))) (heap-number-from-word heap string-hash 0))")))
        (js-call assert :notStrictEqual counted source)
        (setq canonical-hash-runtime-ir
          (js-call (get backend :compiler) :compile_ir_string counted "canonical-hash-counted-runtime.eli"))))
    canonical-hash-runtime-ir)
  (defasync canonical-hash-observed-runtime (image options)
    (let ((original (get globalThis.WebAssembly :Instance)) (captured undefined) (adapter undefined))
      (try
        (progn
          (put globalThis.WebAssembly :Instance (new globalThis.Proxy original (js-object
            :construct (lambda (target arguments)
              (setq captured (Reflect/construct target arguments)) captured))))
          (setq adapter (await (instantiateManagedRuntimeWithHostModules image options))))
        (finally (put globalThis.WebAssembly :Instance original)))
      (js-call assert :ok captured)
      (js-object :adapter adapter :hits (lambda ()
        (js-call (new globalThis.DataView (get (get (get captured :exports) :memory) :buffer)) :getUint32 144 t)))))
  (test "only all four canonical hash definitions without writes or shadows receive the private whole-hash lowering"
    (async ()
      (let* ((compiler (get backend :compiler))
             (source (await (readFile (resolve root "stdlib/managed-value-state.eli") "utf8")))
             (canonical (js-call compiler :compile_ir_string source "stdlib/managed-value-state.eli"))
             (before (JSON/stringify canonical)) (helpers (canonical-hash-helpers canonical))
             (program (canonical-hash-test-program compiler helpers "(export hashString)"))
             (lower (lambda (input id)
               (js-call (get backend :managed) :lower_managed_project
                 (js-array (js-object :id id :program input)) id runtime-ir))))
        (js-call assert :strictEqual (js-length helpers) 4)
        (js-call assert :strictEqual (canonical-hash-fast-call-count (funcall lower program "stdlib/managed-value-state.mjs")) 1)
        (js-call assert :strictEqual (canonical-hash-fast-call-count (funcall lower program "user/managed-value-state.mjs")) 0)
        (let ((changed (globalThis.structuredClone program)) (pending undefined) (replaced false))
          (setq pending (js-call (get changed :body) :slice))
          (while (> (js-length pending) 0)
            (let ((node (js-call pending :pop)))
              (when (and (= (get node :kind) "literal") (= (get node :value) 2246822507))
                (put node :value 2246822509) (setq replaced t))
              (js-call (get node :children) :forEach (lambda (child) (js-call pending :push child)))))
          (js-call assert :strictEqual replaced t)
          (js-call assert :strictEqual (canonical-hash-fast-call-count (funcall lower changed "stdlib/managed-value-state.mjs")) 0))
        (let ((shadow (canonical-hash-test-program compiler helpers
                        "(defun shadow (mixHash) mixHash) (export hashString)")))
          (js-call assert :strictEqual (canonical-hash-fast-call-count (funcall lower shadow "stdlib/managed-value-state.mjs")) 0))
        (let ((written (canonical-hash-test-program compiler helpers
                         "(defun replaceHash () (setq hashString undefined)) (export hashString)")))
          ;; The original backend refuses assignment to a function declaration.
          ;; Neither authentication nor a caller marker may bypass that error.
          (js-call assert :throws (lambda () (funcall lower written "stdlib/managed-value-state.mjs"))
            (lambda (error) (js-call (get error :message "") :includes "existing mutable managed binding"))))
        (let ((forged (globalThis.structuredClone program)))
          (put forged :canonicalStringHash t)
          (put forged :managedStringHashFast t)
          (js-call (get forged :body) :forEach (lambda (node)
            (when (= (get node :value) "hashString") (put node :canonicalStringHash t))))
          (js-call assert :throws (lambda () (funcall lower forged "user/managed-value-state.mjs"))
            (lambda (error) (js-call (get error :message "") :includes "unknown or missing fields"))))
        ;; A serialized or cloned linked program carries no private admission,
        ;; even when it retains all of the linker's visible ordinary fields.
        (let* ((linked (js-call (get backend :managed) :link_managed_project
                        (js-array (js-object :id "stdlib/managed-value-state.mjs" :program program))
                        "stdlib/managed-value-state.mjs"))
               (copy (globalThis.structuredClone (get linked :program)))
               (plain (js-call (get backend :managed) :lower_managed_program copy runtime-ir t)))
          (js-call assert :strictEqual (canonical-hash-fast-call-count plain) 0))
        (let* ((linked (js-call (get backend :managed) :link_managed_project
                        (js-array (js-object :id "stdlib/managed-value-state.mjs" :program (globalThis.structuredClone program)))
                        "stdlib/managed-value-state.mjs"))
               (same (get linked :program)) (pending (js-call (get same :body) :slice)))
          (while (> (js-length pending) 0)
            (let ((node (js-call pending :pop)))
              (when (and (= (get node :kind) "literal") (= (get node :value) 2246822507))
                (put node :value 2246822509))
              (js-call (get node :children) :forEach (lambda (child) (js-call pending :push child)))))
          (js-call assert :strictEqual (canonical-hash-fast-call-count
            (js-call (get backend :managed) :lower_managed_program same runtime-ir t)) 0))
        (js-call assert :strictEqual (JSON/stringify canonical) before))) (js-object :timeout 120000))
  (defconst canonical-hash-report-source (js-call (js-array
    "(defvar early (hashString \"Eliscript\"))"
    "(defun hashReport () (JSON/stringify (js-array early (hashString \"\") (hashString \"Eliscript\")"
    " (hashString \"\" undefined) (hashString \"\" nil) (hashString \"\" 0)"
    " (hashString \"key-50691\") (hashString \"key-194634\")"
    " (hashString (String/fromCharCode 55296 0 65 56320) 4294967295))))"
    "(defun overrideReport (mode)"
    " (let* ((prototype (get globalThis.String :prototype)) (original (get prototype :charCodeAt)))"
    "  (try (progn (put prototype :charCodeAt (lambda (index) (if (= mode 0) 65 (if (= mode 1) (throw false) (throw undefined)))))"
    "    (hashString \"ab\"))"
    "   (catch error (if (undefined? error) \"undefined\" (if (eq error false) \"false\" \"other\")))"
    "   (finally (put prototype :charCodeAt original)))))"
    "(export hashReport overrideReport)") :join "\n"))
  (test "canonical hash generated WASM keeps JS goldens early calls and overridden charCodeAt primitive throws"
    (async ()
      (let* ((compiler (get backend :compiler))
             (canonical (js-call compiler :compile_ir_string
               (await (readFile (resolve root "stdlib/managed-value-state.eli") "utf8")) "stdlib/managed-value-state.eli"))
             (helpers (canonical-hash-helpers canonical))
             (program (canonical-hash-test-program compiler helpers canonical-hash-report-source))
             (body (get program :body))
             (early (js-call body :find (lambda (node) (= (get node :value) "early")))))
        ;; Function declarations are hoisted in both targets: this initializer
        ;; occurs before their source positions, not after all ordinary values.
        (put program :body (js-call (js-array early) :concat (js-call body :filter (lambda (node) (not (eq node early))))))
        (let* ((reference (await (loadReference (resolve directory "canonical-hash-reference.mjs")
                            (js-call compiler :emit_ir_string program))))
               (actual (js-call (get backend :managed) :lower_managed_project
                 (js-array (js-object :id "stdlib/managed-value-state.mjs" :program program))
                 "stdlib/managed-value-state.mjs" (await (canonical-hash-counted-runtime))))
               (image (globalThis.Uint8Array.from (js-call (get backend :wasm) :append_metadata_section
