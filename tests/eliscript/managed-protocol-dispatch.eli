      (js-call assert :strictEqual (js-call api :definitionReport bare) expected)
      (js-call assert :strictEqual (js-call api :prototypeOf plain) (get globalThis.Object :prototype))
      (js-call assert :strictEqual (js-call api :prototypeOf bare) nil)
      (js-call (js-array (js-object) (get globalThis.Array :prototype)) :forEach (lambda (prototype)
        (let ((custom (Object/assign (Object/create prototype) plain)))
          (js-call assert :strictEqual (js-call api :definitionReport custom)
            "[\"TypeError\",\"protocol definition must be a plain object\"]")
          (js-call assert :strictEqual (js-call api :prototypeOf custom) prototype))))
      (let* ((reads 0) (wrapped (new globalThis.Proxy plain
               (js-object :getPrototypeOf (lambda (target) (setq reads (1+ reads)) (Object/getPrototypeOf target))))))
        (js-call assert :strictEqual (js-call api :definitionReport wrapped) expected)
        (js-call assert :strictEqual reads 1))
      (js-call (js-array false undefined) :forEach (lambda (first)
        ;; Catching inside the original source preserves the distinction
        ;; between an actual primitive throw and a synthesized TypeError.
        (let* ((reads 0) (wrapped (new globalThis.Proxy plain
                 (js-object :getPrototypeOf (lambda (target) (setq reads (1+ reads)) (throw first))))))
          (let ((failed false) (actual nil))
            (try (js-call api :definitionReport wrapped) (catch error (setq failed t actual error)))
            (js-call assert :strictEqual failed t)
            (js-call assert :strictEqual actual first))
          (js-call assert :strictEqual reads 1))))))

  (test "direct canonical protocol IR authenticates the private reader and rejects renamed or changed user IR without mutation"
    (async ()
      (let* ((libraries (get (await (js-call backend :loadLiteralModules)) :literalModules))
             (canonical (get (js-call libraries :find (lambda (item) (= (get item :id) "stdlib/core/protocol.mjs"))) :program))
             (compiler (get backend :compiler))
             (program (js-call compiler :compile_ir_string
               (await (readFile (resolve root "stdlib/core/protocol.eli") "utf8")) "stdlib/core/protocol.eli"))
             (before (globalThis.structuredClone program)))
        (js-call assert :strictEqual
          (get (aref (get (aref (get program :body) 0) :children) 0) :value)
          "../../runtime/core/protocol-error.mjs")
        ;; Keep the original direct linker boundary strict. A declaration in
        ;; the runtime factory cannot repair an undeclared compile-time edge.
        (js-call assert :throws
          (lambda () (js-call (get backend :managed) :link_managed_project
            (js-array (js-object :id "stdlib/core/protocol-impl.mjs" :program program))
            "stdlib/core/protocol-impl.mjs" (js-object :literalModules libraries)))
          (lambda (error)
            (let ((diagnostic (get error :eliscriptDiagnostic)))
              (and (= (get diagnostic :code) "ELI-B0001")
                   (= (get diagnostic :phase) "managed-link")
                   (= (get diagnostic :message) "missing managed project module: runtime/core/protocol-error.mjs")))))
        (let ((linked (js-call (get backend :managed) :link_managed_project
                (js-array (js-object :id "stdlib/core/protocol-impl.mjs" :program program))
                "stdlib/core/protocol-impl.mjs" (js-object :literalModules libraries
                  :hostModules (direct-protocol-host-declarations "stdlib/core/protocol-impl.mjs")))))
          (js-call assert :strictEqual (js-length (protocol-bridge-nodes (get linked :program))) 2))
        (js-call (js-array "renamed" "changed") :forEach (lambda (kind)
          (let* ((copy (globalThis.structuredClone program))
                 (id (if (= kind "renamed") "user/core/protocol-impl.mjs" "stdlib/core/protocol-impl.mjs")))
            (when (= kind "changed")
              ;; IR programs are closed records with only body/filename.
              ;; Change a genuine source literal within that schema, so the
              ;; private authentication (not an unknown-field error) refuses it.
              (let ((pending (js-call (get copy :body) :slice)) (changes 0))
                (while (> (js-length pending) 0)
                  (let ((node (js-call pending :pop)))
                    (when (and (= (get node :kind) "variable-declaration")
                               (= (get node :value) "protocol-definition-version"))
                      (let ((literal (aref (get node :children) 0)))
                        (js-call assert :strictEqual (get literal :kind) "literal")
                        (js-call assert :strictEqual (get literal :value) 1)
                        (put literal :value 2)
                        (setq changes (1+ changes))))
                    (js-call (get node :children) :forEach (lambda (child) (js-call pending :push child)))))
                (js-call assert :strictEqual changes 1)
                (js-call assert :deepStrictEqual (Object/keys copy) (Object/keys program))))
            (let ((linked (js-call (get backend :managed) :link_managed_project
                    (js-array (js-object :id id :program copy)) id (js-object :literalModules libraries
                      :hostModules (direct-protocol-host-declarations id)))))
              (js-call assert :strictEqual (js-length (protocol-bridge-nodes (get linked :program))) 0)))))
        (js-call assert :deepStrictEqual program before)
        (js-call assert :deepStrictEqual canonical before))))

