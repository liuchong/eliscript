    "  (cond ((= kind 0) (put definition :value undefined) (put definition :writable t))"
    "   ((= kind 1) (Object/defineProperty definition \"value\" (js-object :get (lambda () (throw false)))))"
    "   ((= kind 2) (put definition :get undefined)) ((= kind 3) (put definition :set nil))"
