                        (lambda () (when adapter (js-call adapter :closeModule)))
                        (lambda () (when adapter (js-call adapter :collect)))
                        (lambda () (when adapter (js-call assert :strictEqual (js-call adapter :live) 0)))
                        (lambda () (when adapter
