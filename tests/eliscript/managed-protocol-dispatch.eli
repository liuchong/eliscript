    "(defun objectBoundaryReport (native)"
    " (let* ((object (js-object :a 7)) (array (js-array 2 3)) (prototype (js-object :inherited 9))"
    "        (created (funcall (get native :objectCreate) prototype))"
    "        (null-prototype (funcall (get native :objectCreate) nil))"
    "        (descriptor (funcall (get native :objectGetOwnPropertyDescriptor) object \"a\"))"
    "        (has (funcall (get native :objectHasOwn) object \"a\"))"
    "        (missing (funcall (get native :objectHasOwn) object \"absent\"))"
