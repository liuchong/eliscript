    "   (eq (funcall (get native :objectGetPrototypeOf) null-prototype) nil) (get created :inherited)"
    "   (get descriptor :value) has missing defined empty (get object :b) frozen frozen-array"
    "   (funcall (get native :objectIsFrozen) object) (funcall (get native :objectIsFrozen) array)"
    "   (funcall (get native :objectIsFrozen) function) (get function :mark)))))"
    "(defun boundaryDefinition (kind)"
