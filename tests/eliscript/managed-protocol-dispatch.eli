    "         (popped (funcall apply (get native :pop) (js-call array :slice 0) (js-array)))"
    "         (concatenated (funcall apply (get native :concat) array (js-array (js-array 8))))"
    "         (reversed (funcall apply (get native :reverse) (js-call array :slice 0) (js-array)))"
    "         (entries (funcall apply (get native :entries) array (js-array)))"
    "         (indices (funcall apply (get native :keys) array (js-array)))"
    "         (values (funcall apply (get native :values) array (js-array))))"
    "   (JSON/stringify (js-array identity (funcall (get native :ownKeys) nullish) (funcall (get native :ownKeys) omitted) array-test not-array missing-array"
    "    read trace written parent-set parent keys (get descriptor :value) defined present empty deleted extensible prevented closed called (get box :value) slice"
    "    pushed popped concatenated reversed"
    "    (funcall apply next entries (js-array)) (funcall apply next indices (js-array)) (funcall apply next values (js-array)))))))"
    "(defun intrinsicBoundaryThrow (get first)"
    " (let ((object (js-object))) (Object/defineProperty object \"x\" (js-object :get (lambda () (throw first))))"
    "  (funcall get object \"x\")))"
    "(defun intrinsicBoundaryKey (get)"
    " (let ((trace (js-array)) (object (js-object :x 14)))"
    "  (let ((key (js-object :toString (lambda () (js-call trace :push \"key\") \"x\"))))"
