                    (if (= target "wasm") (setq adapter (await (instantiateManagedRuntimeWithHostModules image options)))
                      (let ((path (resolve deployment (if (= native-target "arm64-macos") "definition.dylib" "definition.so"))))
                        (await (writeFile path (globalThis.Uint8Array.from
