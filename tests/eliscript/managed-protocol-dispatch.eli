                             (js-call registrations :push
                               (js-array (aref arguments 1) (aref arguments 2))))
                           result))))))
               (Object/create (Object/getPrototypeOf exports) descriptors))))
           (construct (lambda (target arguments)
             (let* ((instance (Reflect/construct target arguments))
                    (forwarded (funcall instrument (get instance :exports))))
               (new globalThis.Proxy instance
                 (js-object :get (lambda (target key receiver)
                   (if (= key "exports") forwarded (Reflect/get target key receiver)))))))))
      (try
        (progn
          (put globalThis.WebAssembly :Instance (new globalThis.Proxy original (js-object :construct construct)))
          (setq adapter (await (instantiateManagedRuntimeWithHostModules image options))))
        (finally (put globalThis.WebAssembly :Instance original)))
      (js-object :adapter adapter :raw raw :owner owner :registrations registrations
        :reset (lambda () (js-call (new globalThis.DataView (get (get raw :memory) :buffer)) :setUint32 144 0 t))
        :calls (lambda () (js-call (new globalThis.DataView (get (get raw :memory) :buffer)) :getUint32 144 t)))))
  (defun exercise-intrinsic-boundary (api expected)
    (let ((native (intrinsic-boundary-hosts)))
      (js-call assert :strictEqual (js-call api :intrinsicBoundaryReport native) expected)
      (js-call assert :strictEqual (js-call api :intrinsicBoundaryKey (get native :get)) "[14,[\"key\"]]")
      (js-call (js-array false undefined) :forEach (lambda (first)
        (let ((caught false) (actual nil))
          (try (js-call api :intrinsicBoundaryThrow (get native :get) first)
            (catch error (setq caught t actual error)))
          (js-call assert :strictEqual caught t) (js-call assert :strictEqual actual first))))
      (js-call assert :throws (lambda ()
        (js-call api :intrinsicBoundaryWrongIterator (get native :apply) (get native :next)))
        (lambda (error) (= (get error :name) "TypeError")))))
  (defun exercise-object-boundary (api independent target)
    (js-call (js-array "freeze" "isFrozen" "create" "getPrototypeOf" "getOwnPropertyDescriptor" "hasOwn" "defineProperties")
      :forEach (lambda (name)
        (let ((observe (lambda (callee)
          (let* ((trace (js-array)) (target (js-object :x 1))
                 (proxy (new globalThis.Proxy target (js-object
                   :getPrototypeOf (lambda (target) (js-call trace :push "prototype") (Reflect/getPrototypeOf target))
                   :isExtensible (lambda (target) (js-call trace :push "extensible") (Reflect/isExtensible target))
                   :preventExtensions (lambda (target) (js-call trace :push "prevent") (Reflect/preventExtensions target))
                   :ownKeys (lambda (target) (js-call trace :push "keys") (Reflect/ownKeys target))
                   :getOwnPropertyDescriptor (lambda (target key) (js-call trace :push (str "own:" key)) (Reflect/getOwnPropertyDescriptor target key))
                   :defineProperty (lambda (target key descriptor) (js-call trace :push (str "define:" key)) (Reflect/defineProperty target key descriptor)))))
                 (arguments (cond ((or (= name "getOwnPropertyDescriptor") (= name "hasOwn")) (js-array proxy "x"))
                   ((= name "defineProperties") (js-array proxy (js-object :y (js-object :value 2))))
                   (t (js-array proxy))))
                 (result (js-call callee :applyBoundary (get globalThis.Object name) undefined arguments)))
            (js-array trace (if (eq result proxy) "identity"
              (cond ((= name "getOwnPropertyDescriptor") (get result :value))
                ((= name "create") (eq (Object/getPrototypeOf result) proxy))
                ((= name "getPrototypeOf") (eq result globalThis.Object.prototype)) (t result))))))))
          (let ((expected (funcall observe independent)))
            (js-call assert :deepStrictEqual (funcall observe api) expected (str target " Object." name " Proxy trace/result"))))))
    (js-call (js-array false undefined) :forEach (lambda (first)
      (js-call (js-array globalThis.Object.hasOwn globalThis.Object.getOwnPropertyDescriptor) :forEach (lambda (function)
        (let ((caught false) (actual nil))
          (try (js-call api :objectBoundaryKey function first) (catch error (setq caught t actual error)))
          (js-call assert :strictEqual caught t) (js-call assert :strictEqual actual first))))
      (let ((caught false) (actual nil) (reads 0))
        (let ((descriptor (new globalThis.Proxy (js-object :value 1) (js-object
          :has (lambda (target key) (setq reads (1+ reads)) (throw first))))))
          (try (js-call api :objectBoundaryDefinitions globalThis.Object.defineProperties descriptor)
            (catch error (setq caught t actual error)))
          (js-call assert :strictEqual caught t) (js-call assert :strictEqual actual first)
          (js-call assert :strictEqual reads 1)))
      (let ((caught false) (actual nil) (reads 0))
        (try
          (progn
            (Object/defineProperty globalThis.Object.prototype "enumerable" (js-object :configurable t
              :get (lambda () (setq reads (1+ reads)) (throw first))))
            (try (js-call api :objectBoundaryPolluted globalThis.Object.defineProperty)
              (catch error (setq caught t actual error))))
          (finally (Reflect/deleteProperty globalThis.Object.prototype "enumerable")))
        (js-call assert :strictEqual caught t) (js-call assert :strictEqual actual first)
        (js-call assert :strictEqual reads 1))))
    (let ((kind 0))
      (while (< kind 10)
        (let ((observe (lambda (callee)
          (try (js-array "value" (js-call callee :objectBoundaryDefine globalThis.Object.defineProperty kind))
            (catch error (js-array "throw" (if (and error (= (value-type error) "object")) (get error :name) error)))))))
          (js-call assert :deepStrictEqual (funcall observe api) (funcall observe independent)))
        (setq kind (1+ kind))))
    (let ((calls 0))
      (let ((replacement (lambda (value) (setq calls (1+ calls)) 37)))
        (js-call assert :strictEqual (js-call api :applyBoundary replacement undefined (js-array (js-object))) 37)
        (js-call assert :strictEqual calls 1))
      (let ((proxy (new globalThis.Proxy globalThis.Object.freeze (js-object
        :apply (lambda (target receiver arguments) (setq calls (1+ calls)) (Reflect/apply target receiver arguments))))))
        (let ((value (js-object :x 1)))
          (js-call assert :strictEqual (js-call api :applyBoundary proxy undefined (js-array value)) value)
          (js-call assert :strictEqual calls 2)))))
  (test "authenticated native operations stay inside the owned runtime and retain real JS WASM native semantics"
    (async ()
      (let* ((compiler (get backend :compiler))
             (source (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
             (needle "(defun heap-host-request (heap operation a b c arguments count)")
             (counted (js-call source :replace needle (+ needle
               "\n    (when (= operation 8) (store-u32 144 (1+ (load-u32 144))))")))
             (counted-ir (js-call compiler :compile_ir_string counted "intrinsic-boundary-counted-runtime.eli"))
             (program (js-call compiler :compile_ir_string intrinsic-boundary-source "intrinsic-boundary.eli"))
             (independent (await (loadReference (resolve directory "intrinsic-boundary-reference.mjs")
               (js-call compiler :emit_ir_string program))))
             (actual (js-call (get backend :managed) :lower_managed_project
               (js-array (js-object :id "main.mjs" :program program)) "main.mjs" counted-ir
               (js-object :foreignEntry t :entries (js-array "main.mjs"))))
             (image (globalThis.Uint8Array.from (js-call (get backend :wasm) :append_metadata_section
               (js-call (get backend :wasm) :emit_typed_memory_wasm (get actual :typed))
               "eliscript-managed-control" (JSON/stringify (get actual :descriptor)))))
             (options (js-object :maxSlots 65536 :initialBytes 8388608 :maxBytes 67108864 :auto 1))
             (observed (await (intrinsic-boundary-observed-runtime image options)))
             (expected (js-call independent :intrinsicBoundaryReport (intrinsic-boundary-hosts)))
             (object-expected (js-call independent :objectBoundaryReport (intrinsic-boundary-hosts)))
             (targets (js-array (js-object :target "wasm" :adapter (get observed :adapter)))))
        (js-call assert :notStrictEqual counted source)
        (exercise-intrinsic-boundary independent expected)
        (when native-target
          (let ((path (resolve directory (if (= native-target "arm64-macos") "intrinsic-boundary.dylib" "intrinsic-boundary.so"))))
            (await (writeFile path (globalThis.Uint8Array.from
              (js-call (get backend :native) :emit_typed_native_memory_library (get actual :typed) native-target))))
            (js-call targets :push (js-object :target "native" :adapter
              (await (instantiateNativeManagedRuntime path actual (Object/assign (js-object :nativeTarget native-target) options)))))))
        (js-call targets :forEach (lambda (entry)
          (let ((adapter (get entry :adapter)) (handles (js-array)) (api (js-object)))
            (try
              (progn
                (js-call (js-array "intrinsicBoundaryReport" "intrinsicBoundaryThrow" "intrinsicBoundaryKey"
                  "intrinsicBoundaryWrongIterator" "intrinsicBoundaryForeignArguments" "objectBoundaryReport" "boundaryDefinition"
                  "objectBoundaryDefine" "objectBoundaryPolluted" "objectBoundaryDefinitions" "objectBoundaryKey" "applyBoundary") :forEach (lambda (name)
                    (let ((handle (js-call adapter :getExport name)))
                      (js-call handles :push handle) (put api name (js-call adapter :toHostValue handle)))))
                (when (= (get entry :target) "wasm") (js-call observed :reset))
                (js-call assert :strictEqual (js-call api :intrinsicBoundaryReport (intrinsic-boundary-hosts)) expected)
                ;; Exact native callees on represented receivers need no Call
                ;; capability roundtrip, including Reflect.apply's nested calls.
                (when (= (get entry :target) "wasm") (js-call assert :strictEqual (js-call observed :calls) 0))
                (when (= (get entry :target) "wasm") (js-call observed :reset))
                (js-call assert :strictEqual (js-call api :objectBoundaryReport (intrinsic-boundary-hosts)) object-expected)
                (when (= (get entry :target) "wasm") (js-call assert :strictEqual (js-call observed :calls) 0))
                (js-call adapter :collect)
                (js-call assert :strictEqual (js-call api :objectBoundaryReport (intrinsic-boundary-hosts)) object-expected)
                (when (= (get entry :target) "wasm") (js-call assert :strictEqual (js-call observed :calls) 0))
                (exercise-intrinsic-boundary api expected)
                (exercise-object-boundary api independent (get entry :target))
                (let ((calls 0) (receiver (js-object :original t)))
                  (let ((replacement (lambda (&rest arguments) (setq calls (1+ calls)) receiver)))
                    (js-call assert :strictEqual (js-call api :applyBoundary replacement receiver (js-array)) receiver)
                    (js-call assert :strictEqual calls 1))
                  (let ((proxy (new globalThis.Proxy globalThis.Reflect.get (js-object
                    :apply (lambda (target receiver arguments) (setq calls (1+ calls)) (Reflect/apply target receiver arguments))))))
                    (js-call assert :strictEqual (js-call api :applyBoundary proxy undefined (js-array receiver "original")) t)
                    (js-call assert :strictEqual calls 2)))
                (let ((reads (js-array)) (array (js-array 2 3)))
                  (let ((proxy (new globalThis.Proxy array (js-object :get (lambda (target key receiver)
                    (js-call reads :push key) (Reflect/get target key receiver))))))
                    (js-call assert :deepStrictEqual (js-call api :applyBoundary globalThis.Array.prototype.slice proxy (js-array 1)) (js-array 3))
                    (js-call assert :deepStrictEqual reads (js-array "length" "constructor" "1"))))
                (when (= (get entry :target) "wasm") (js-call observed :reset))
                (let ((reads (js-array)))
                  (let ((arguments (new globalThis.Proxy (js-array 1) (js-object :get (lambda (target key receiver)
                    (js-call reads :push key) (Reflect/get target key receiver))))))
                    (js-call assert :deepStrictEqual
                      (js-call api :intrinsicBoundaryForeignArguments globalThis.Reflect.apply globalThis.Array.prototype.slice arguments)
                      (js-array 3))
                    (js-call assert :deepStrictEqual reads (js-array "length" "0"))))
                (when (= (get entry :target) "wasm") (js-call assert :ok (> (js-call observed :calls) 0)))
                (js-call (js-array "get" "set" "getPrototypeOf" "setPrototypeOf" "ownKeys" "getOwnPropertyDescriptor"
                  "defineProperty" "deleteProperty" "has" "isExtensible" "preventExtensions" "apply" "construct")
                  :forEach (lambda (name)
                    (js-call assert :throws (lambda ()
                      (js-call api :applyBoundary (get globalThis.Reflect name) undefined (js-array)))
                      (lambda (error) (= (get error :name) "TypeError")))))
                (let ((boxed (js-call api :applyBoundary globalThis.Object undefined (js-array 7))))
                  (js-call assert :strictEqual (js-call boxed :valueOf) 7))
                (when (= (get entry :target) "wasm")
                  (js-call assert :ok (> (js-call observed :calls) 0))
                  (let* ((raw (get observed :raw)) (owner (get observed :owner))
                         (registered (js-call (get observed :registrations) :filter (lambda (row) (/= (aref row 1) 0))))
                         (operations (new globalThis.Set (js-call registered :map (lambda (row) (aref row 1))))))
                    (js-call (js-array 76 5 181 182 183 184 185 186 187 188 189 190 191 192 193
                      200 201 202 203 204 205 206 207 208 209 210 211 212 213 214 215 216 217 218 219 220 221 222 223 224 225 226 227 328
                      401 402 403 404 405 406 407)
                      :forEach (lambda (operation) (js-call assert :ok (js-call operations :has operation) (str operation))))
                    (let ((function (aref (aref registered 0) 0)))
                      (js-call assert :strictEqual (js-call raw :value-foreign-intrinsic-register owner function 75) 0)
                      (js-call assert :strictEqual (js-call raw :last-error) 3)
                      (js-call raw :value-error-restore 0)
                      (js-call assert :strictEqual (js-call raw :value-foreign-intrinsic-register owner 3 5) 0)
                      (js-call assert :notStrictEqual (js-call raw :last-error) 0)
                      (js-call raw :value-error-restore 0))
                    (let ((kind 0) (expected (js-array 1 0 0 0 0 1 0 1 1 1)))
                      (while (< kind 10)
                        (let* ((argument (js-call adapter :number kind))
                               (definition (js-call adapter :invoke "boundaryDefinition" (js-array argument)))
                               (frame (js-call adapter :frame 1)))
                          (try
                            (progn
                              (js-call adapter :frameSet frame 0 definition)
                              (let* ((handle (js-call raw :frame-get owner (js-call raw :frame-current owner) 0))
                                     (live (js-call raw :heap-live owner)) (used (js-call raw :heap-used owner)))
                                (js-call assert :strictEqual (js-call raw :value-source-data-definition-p owner handle) (aref expected kind))
                                (js-call assert :strictEqual (js-call raw :last-error) 0)
                                (js-call assert :strictEqual (js-call raw :heap-live owner) live)
                                (js-call assert :strictEqual (js-call raw :heap-used owner) used)))
                            (finally
                              (js-call adapter :leaveFrame frame)
                              (js-call adapter :release definition) (js-call adapter :release argument))))
                        (setq kind (1+ kind))))))
                (js-call adapter :collect)
                (js-call assert :strictEqual (get (js-call adapter :stats) :frameDepth) 0))
              (finally
                (js-call handles :forEach (lambda (handle) (js-call adapter :release handle)))
                (js-call adapter :closeModule) (js-call adapter :collect)
                (when (get adapter :close) (js-call adapter :close)))))))
        (let ((registered (new globalThis.Set)) (cleared (new globalThis.Set)))
          (js-call (get observed :registrations) :forEach (lambda (row)
            (js-call (if (= (aref row 1) 0) cleared registered) :add (aref row 0))))
          (js-call assert :ok (> (get registered :size) 0))
          (js-call assert :deepStrictEqual cleared registered))))
    (js-object :timeout 120000))

  (test "the actual protocol error constructor distinguishes omitted undefined null false and invalid direct slots in JS and real WASM"
    (lambda ()
      (js-call assert :strictEqual (js-call reference :report) (expected))
      (exercise (instantiateManagedRuntime bytes (js-object :maxSlots 4096 :initialBytes 1048576 :maxBytes 16777216)))))
  (test "real native preserves the same actual protocol reason defaults and error fields without a WASM execution fallback"
    (js-object :skip (not native-target))
    (async ()
      (exercise (await (instantiateNativeManagedRuntime library lowered
        (js-object :nativeTarget native-target :maxSlots 4096 :initialBytes 1048576 :maxBytes 16777216)))))))
