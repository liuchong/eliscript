    "   ((= kind 9) (put definition :value 3) (Object/freeze definition))) definition))"
    "(defun objectBoundaryDefine (function kind)"
    " (let ((target (js-object))) (funcall function target \"x\" (boundaryDefinition kind)) (get target :x)))"
    "(defun objectBoundaryPolluted (function) (let ((target (js-object)))"
    " (funcall function target \"x\" (js-object :value 1)) (get target :x)))"
    "(defun objectBoundaryDefinitions (function descriptor)"
    " (let ((target (js-object))) (funcall function target (js-object :x descriptor)) (get target :x)))"
    "(defun objectBoundaryKey (function first)"
    " (funcall function (js-object :x 1) (js-object :toString (lambda () (throw first)))))"
    "(export intrinsicBoundaryReport intrinsicBoundaryThrow intrinsicBoundaryKey intrinsicBoundaryWrongIterator intrinsicBoundaryForeignArguments"
    " objectBoundaryReport boundaryDefinition objectBoundaryDefine objectBoundaryPolluted objectBoundaryDefinitions objectBoundaryKey applyBoundary)") :join "\n"))
  (defun intrinsic-boundary-hosts ()
    (let* ((iterator (js-call (js-array) :values))
           (native (js-object :object globalThis.Object :isArray globalThis.Array.isArray
