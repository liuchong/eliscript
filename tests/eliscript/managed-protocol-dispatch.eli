    "(import \"./protocol-impl.mjs\" define-protocol-from-definition protocol-definition)"
    "(defun definitionReport (input) (try (JSON/stringify (protocol-definition (define-protocol-from-definition input)))"
    " (catch error (if (or (eq error false) (undefined? error)) (throw error) (JSON/stringify (js-array (get error :name) (get error :message)))))))"
    "(defun prototypeOf (input) (Object/getPrototypeOf input))"
    "(export definitionReport prototypeOf)") :join "\n"))
