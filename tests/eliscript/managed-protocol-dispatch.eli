  (defasync intrinsic-boundary-observed-runtime (image options)
    (let* ((original (get globalThis.WebAssembly :Instance)) (raw undefined) (owner 0)
           (registrations (js-array)) (adapter undefined)
           (instrument (lambda (exports)
             (let ((descriptors (Object/getOwnPropertyDescriptors exports)))
