    "  (let* ((identity (eq (funcall (get native :object) object) object))"
    "         (nullish (funcall (get native :object) nil))"
    "         (omitted (funcall (get native :object)))"
    "         (array-test (funcall (get native :isArray) array))"
    "         (not-array (funcall (get native :isArray) object))"
    "         (missing-array (funcall (get native :isArray)))"
    "         (read (funcall (get native :get) object \"observed\"))"
    "         (written (funcall (get native :set) object \"b\" 8))"
    "         (parent-set (funcall (get native :setPrototypeOf) object prototype))"
    "         (parent (eq (funcall (get native :getPrototypeOf) object) prototype))"
    "         (keys (funcall (get native :ownKeys) object))"
    "         (descriptor (funcall (get native :getOwnPropertyDescriptor) object \"a\"))"
    "         (defined (funcall (get native :defineProperty) object \"empty\" (js-object :value undefined :configurable t)))"
    "         (present (funcall (get native :has) object \"empty\"))"
    "         (empty (funcall (get native :get) object \"empty\"))"
    "         (deleted (funcall (get native :deleteProperty) object \"b\"))"
    "         (extensible (funcall (get native :isExtensible) object))"
    "         (prevented (funcall (get native :preventExtensions) object))"
    "         (closed (funcall (get native :isExtensible) object))"
    "         (called (funcall apply (lambda (a b) (+ a b)) nil (js-array 5 6)))"
