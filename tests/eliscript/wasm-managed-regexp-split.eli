(module tests.wasm-managed-regexp-split
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir mkdtemp readFile rm writeFile)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "./helpers/managed-browser-transport.mjs" loadManagedReference)
  (defvar directory undefined) (defvar bytes undefined) (defvar lowered undefined) (defvar reference undefined) (defvar native-path undefined)
  (defconst native-target (when (= (get globalThis.process :arch) "arm64")
    (cond ((= (get globalThis.process :platform) "darwin") "arm64-macos") ((= (get globalThis.process :platform) "linux") "arm64-linux"))))
  (defconst source (str
    "(defun captures (text limit) (js-call text :split (js* \"/([,;])|\\\\s+/u\") limit))\n"
    "(defun plain (text limit) (js-call text :split (js* \"/,/u\") limit))\n"
    "(defun empty-match (text limit) (js-call text :split (js* \"/(?:)/u\") limit))\n"
    "(export captures plain empty-match)\n"))
  (defconst rows (js-array
    (js-array "captures" "a, b;😀 a" 8 (js-array "a" "," "" undefined "b" ";" "😀" undefined))
    (js-array "captures" "a, b;😀 a" 4294967295 (js-array "a" "," "" undefined "b" ";" "😀" undefined "a"))
    (js-array "captures" "a, b;😀 a" 1 (js-array "a"))
    (js-array "captures" "a, b;😀 a" 2 (js-array "a" ","))
    (js-array "captures" "a, b;😀 a" 3 (js-array "a" "," ""))
    (js-array "captures" "a, b;😀 a" 4 (js-array "a" "," "" undefined))
    (js-array "captures" "a, b;😀 a" 0 (js-array))
    (js-array "plain" "abc" 8 (js-array "abc"))
    (js-array "plain" "abc" 0 (js-array))
    (js-array "plain" "" 8 (js-array ""))
    (js-array "plain" "" 0 (js-array))
    (js-array "plain" "a,b," 8 (js-array "a" "b" ""))
    (js-array "plain" ",a,," 8 (js-array "" "a" "" ""))
    (js-array "plain" "," 1 (js-array ""))
    (js-array "empty-match" "" 8 (js-array))
    (js-array "empty-match" "A😀B" 8 (js-array "A" "😀" "B"))
    (js-array "empty-match" "A😀B" 2 (js-array "A" "😀"))
    (js-array "plain" "\ud800x\udfff" 8 (js-array "\ud800x\udfff"))))
  (defun read (runtime value)
    (cond ((and value (= (get value :kind) 4)) (js-call runtime :readNumber value))
      ((and value (= (get value :kind) 5)) (js-call runtime :readString value))
      ((and value (= (get value :kind) 14)) (Array/from (js-object :length (js-call runtime :length value)) (lambda (unused index)
        (let ((child (js-call runtime :get value index))) (try (read runtime child) (finally (js-call runtime :release child))))))) (t value)))
  (beforeAll (async ()
    (await (mkdir (resolve root "_worktree") (js-object :recursive t)))
    (setq directory (await (mkdtemp (resolve root "_worktree/regexp-split-"))))
    (let* ((backend (await (buildBackends (js-object :outputRoot (resolve directory "backend")))))
           (compiler (get backend :compiler)) (program (js-call compiler :compile_ir_string source "regexp-split-regression.eli"))
           (runtime (js-call compiler :compile_ir_string (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli")))
      (setq lowered (js-call (get backend :managed) :lower_managed_program program runtime))
      (setq bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime)))
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (setq reference (await (loadManagedReference directory (js-call compiler :emit_ir_string program) "split-reference")))
      (when native-target
        (setq native-path (resolve directory (if (= native-target "arm64-macos") "split.dylib" "split.so")))
        (await (writeFile native-path (globalThis.Uint8Array.from (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target))))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (test "RegExp split appends one final suffix retains exact captures and limit and returns arrays after zero search iterations"
    (async ()
      (let ((targets (if native-target (js-array "wasm" "native") (js-array "wasm"))) (target-index 0))
        (while (< target-index (js-length targets))
          (let* ((target (aref targets target-index))
                 (runtime (if (= target "wasm") (instantiateManagedRuntime bytes)
                   (await (instantiateNativeManagedRuntime native-path lowered))))
                 (_ (js-call runtime :auto 1)) (held (js-call runtime :number -0.0)) (caller (js-call runtime :frame 1)))
            (js-call runtime :frameSet caller 0 held)
            (try
              (js-call rows :forEach (lambda (row)
                (let* ((name (aref row 0)) (text (aref row 1)) (limit (aref row 2)) (expected (aref row 3))
                       (input (js-call runtime :string text)) (bound (js-call runtime :number limit)) (out undefined))
                  (try
                    (js-call assert :deepStrictEqual (funcall (get reference (js-call name :replaceAll "-" "_")) text limit) expected)
                    (setq out (js-call runtime :invoke name (js-array input bound)))
                    (js-call assert :deepStrictEqual (read runtime out) expected (str target ":" name ":" limit))
                    (js-call runtime :collect)
                    (js-call assert :deepStrictEqual (read runtime out) expected)
                    (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 1)
                    (assert (Object/is (js-call runtime :readNumber held) -0.0))
                    (finally (js-call runtime :release out) (js-call runtime :release input) (js-call runtime :release bound))))))
              (finally
                (js-call runtime :leaveFrame caller) (js-call runtime :release held)
                (js-call runtime :closeModule) (js-call runtime :collect)
                (js-call assert :strictEqual (js-call runtime :live) 0)
                (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
                (when (get runtime :close) (js-call runtime :close)))))
          (setq target-index (1+ target-index))))) 120000)
)
