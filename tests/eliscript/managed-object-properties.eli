(module tests.managed-object-properties
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm mkdir readdir writeFile)
  (import "node:path" resolve relative delimiter)
  (import "node:module" createRequire)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/managed-browser-transport.mjs" loadManagedReference runManagedNode bundleManagedBrowserPage serveManagedBrowserPage)
  (defvar directory undefined) (defvar b undefined) (defvar runtime undefined) (defvar family undefined)
  (defvar generationEvidence undefined)
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve root ".eliscript-object-properties-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (setq family (await (readFile "tests/fixtures/wasm-managed-object-properties.eli" "utf8")))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defun same (&rest args) (Reflect/apply (get assert :strictEqual) assert args))
  (defun deep (&rest args) (Reflect/apply (get assert :deepStrictEqual) assert args))
  (defun each (values body) (js-call values :forEach body))
  (defun times (count body) (let ((index 0)) (while (< index count) (funcall body index) (setq index (1+ index)))))
  (defun code (name) (lambda (error) (and (get error :eliscriptDiagnostic) (= (get (get error :eliscriptDiagnostic) :code) name))))
  (defun throws (operation) (js-call assert :throws operation (code "ELI-RT0003")))
  (defasync fixture (index &rest ordinal)
    (await (readFile (resolve root (str "tests/fixtures/managed-object-properties-case-" index "-"
      (if (undefined? (aref ordinal 0)) 0 (aref ordinal 0)) ".eli")) "utf8")))
  (defasync compiled (&rest supplied)
    (let* ((source (if (undefined? (aref supplied 0)) family (aref supplied 0)))
           (options (aref supplied 1)) (rt (if (undefined? (aref supplied 2)) runtime (aref supplied 2)))
           (p (js-call (get b :compiler) :compile_ir_string (str "(defconst property-marker 1)\n" source) "properties.eli"))
           (before (JSON/stringify p)) (bytes (globalThis.Uint8Array.from (js-call (get b :managed) :emit_managed_wasm p rt))))
      (same (JSON/stringify p) before)
      (deep (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let ((a (instantiateManagedRuntime bytes options))) (js-call a :auto 1)
        (js-object :a a :bytes bytes :js (await (loadManagedReference directory (js-call (get b :compiler) :emit_ir_string p) "properties-oracle"))))))
  (defun read (a x)
    (cond ((and x (= (get x :kind) 4)) (js-call a :readNumber x)) ((and x (= (get x :kind) 5)) (js-call a :readString x))
      ((and x (= (get x :kind) 14))
        (let ((out (js-array))) (times (js-call a :length x) (lambda (index)
          (let ((v (js-call a :get x index))) (js-call out :push (read a v)) (js-call a :release v)))) out)) (t x)))
  (defun finish (a &rest supplied)
    (each (if (undefined? (aref supplied 0)) (js-array) (aref supplied 0)) (lambda (x) (js-call a :release x)))
    (js-call a :closeModule) (js-call a :collect) (same (js-call a :live) 0) (same (get (js-call a :stats) :frameDepth) 0))
  (defun sparse () (let ((array (js-array t undefined undefined))) (Reflect/deleteProperty array "1") array))
  (defun raw (e heap) (lambda (name &rest arguments)
    (let ((value (uint32 (Reflect/apply (get e name) e (js-call (js-array heap) :concat arguments)))))
      (same (js-call e "last-error") 0 name) value)))

  (test "Object property builtins are first-class zero-import WASM functions with original static aliases and identity"
    (async () (let* ((c (await (compiled))) (a (get c :a)))
      (same (js-call a :invoke "identities") t)
      (let ((out (js-call a :invoke "exercise")))
        (deep (read a out) (js-call (get c :js) :exercise)) (finish a (js-array out))))))
  (test "Object.keys follows integer-key then insertion order for objects, sparse arrays and UTF16 string indices"
    (async () (let* ((a (get (await (compiled)) :a))
      (names (js-array "z" "10" "2" "01" "4294967294" "4294967295" "a"))
      (object (Object/fromEntries (js-call names :map (lambda (key) (js-array key t)))))
      (pairs (js-array (js-array (js-call a :sourceObject object) object) (js-array (js-call a :sourceArray (sparse)) (sparse))
        (js-array (js-call a :string "A😀\ud800") "A😀\ud800") (js-array (js-call a :number 0) 0) (js-array false false) (js-array t t))))
      (each pairs (lambda (pair) (each (js-array "keys" "direct-keys") (lambda (name)
        (let ((out (js-call a :invoke name (js-array (aref pair 0))))) (deep (read a out) (Object/keys (aref pair 1))) (js-call a :release out))))
        (js-call a :release (aref pair 0)))) (finish a))))
  (test "Object.hasOwn converts property keys with string hint exactly once after all argument effects"
    (async () (let* ((c (await (compiled (await (fixture 2))))) (a (get c :a)) (out (js-call a :invoke "run")))
      (deep (read a out) (js-call (get c :js) :run)) (same (js-call a :invoke "fallback") (js-call (get c :js) :fallback)) (finish a (js-array out)))))
  (test "Object.assign preserves target identity, skips nullish sources and copies source own properties to object, array and collection targets"
    (async () (let* ((a (get (await (compiled)) :a)) (number (js-call a :number 3)) (source (js-call a :sourceObject (js-object :tag number)))
      (targets (js-array (js-call a :sourceObject (js-object)) (js-call a :sourceArray (js-array)) (js-call a :invoke "map") (js-call a :invoke "set") (js-call a :invoke "iterator"))))
      (each targets (lambda (target) (let ((out (js-call a :invoke "assign" (js-array target nil undefined false source))))
        (same (js-call a :keyEqual out target) t)
        (let* ((key (js-call a :string "tag")) (value (js-call a :invoke "member" (js-array target key))))
          (same (js-call a :readNumber value) 3)
          (each (js-array key value out) (lambda (v) (js-call a :release v))))
        (let ((keys (js-call a :invoke "keys" (js-array target))))
          (deep (read a keys) (js-array "tag")) (js-call a :release keys)))))
      (finish a (js-call (js-array number source) :concat targets)))))
  (test "hasOwn distinguishes inherited, sparse, named and primitive string properties using original ToPropertyKey behavior"
    (async () (let* ((a (get (await (compiled)) :a))
      (oracle (js-object "undefined" t "null" t "NaN" t "0" t))
      (object (js-call a :sourceObject (Object/assign (js-object) oracle (js-object "[object Map]" t "[object Set]" t))))
      (array (js-call a :sourceArray (sparse))) (string (js-call a :string "😀")) (map (js-call a :invoke "map")) (set (js-call a :invoke "set")))
      (each (js-array undefined nil globalThis.NaN -0.0 0 "0" "1" "2" "length" "01" "-0" "constructor" "toString") (lambda (key)
        (let ((v (cond ((= (value-type key) "number") (js-call a :number key)) ((= (value-type key) "string") (js-call a :string key)) (t key))))
          (each (js-array (js-array object oracle) (js-array array (sparse)) (js-array string "😀") (js-array false false)) (lambda (pair)
            (each (js-array "own" "direct-own") (lambda (name)
              (same (js-call a :invoke name (js-array (aref pair 0) v)) (Object/hasOwn (aref pair 1) key) (funcall globalThis.String key))))))
          (js-call a :release v))))
      (same (js-call a :invoke "own" (js-array object map)) t) (same (js-call a :invoke "own" (js-array object set)) t)
      (let ((hooks (get (await (compiled (await (fixture 4)))) :a)))
        (each (js-array 0 1 2) (lambda (kind) (let ((n (js-call hooks :number kind))) (same (js-call hooks :invoke "hooked" (js-array n)) t) (js-call hooks :release n)))) (finish hooks))
      (finish a (js-array object array string map set)))))
  (test "hasOwn nullish receivers fail before key hooks, missing keys mean undefined, and bad conversions preserve diagnostics"
    (async () (let* ((a (get (await (compiled (await (fixture 5)))) :a)) (key (js-call a :string "visited")))
      (each (js-array nil undefined) (lambda (receiver) (let ((trace (js-call a :sourceObject (js-object))))
        (throws (lambda () (js-call a :invoke "run" (js-array receiver trace)))) (same (js-call a :objectGet trace key) undefined) (js-call a :release trace))))
      (throws (lambda () (js-call a :invoke "bad"))) (finish a (js-array key))
      (let* ((other (get (await (compiled)) :a)) (object (js-call other :sourceObject (js-object "undefined" false))))
        (same (js-call other :invoke "own" (js-array object)) t)
        (each (js-array "keys" "own" "assign") (lambda (name) (each (js-array (js-array) (js-array nil) (js-array undefined))
          (lambda (args) (throws (lambda () (js-call other :invoke name args))))))) (finish other (js-array object))))))
  (test "property-key hooks can reenter enumeration and assignment under GC before the final own-property lookup"
    (async () (let* ((c (await (compiled (await (fixture 6))))) (a (get c :a)) (out (js-call a :invoke "run")))
      (deep (read a out) (js-call (get c :js) :run)) (finish a (js-array out)))))
  (test "assign honors own __proto__ data, inherited setters, null prototypes, source ordering and partial writes after a later failure"
    (async () (let* ((c (await (compiled (await (fixture 7))))) (a (get c :a)))
      (each (js-array "run" "own") (lambda (name) (let ((out (js-call a :invoke name))) (deep (read a out) (funcall (get (get c :js) name))) (js-call a :release out))))
      (let* ((target (js-call a :sourceObject (js-object))) (first (js-call a :string "first")) (late (js-call a :string "late")))
        (throws (lambda () (js-call a :invoke "partial" (js-array target))))
        (let ((value (js-call a :objectGet target first))) (same (js-call a :readNumber value) 1) (same (js-call a :objectGet target late) undefined)
          (finish a (js-array target first late value)))))))
  (test "Object methods capture a shadowed ordinary callee before argument effects and evaluate ignored extras once"
    (async () (let* ((c (await (compiled (await (fixture 8))))) (a (get c :a)) (fn (js-call a :invoke "factory"))
      (object (js-call a :sourceObject (js-object :keys fn))) (trace (js-call a :sourceObject (js-object)))
      (out (js-call a :invoke "run" (js-array object trace))) (count (js-call a :invoke "extras")) (missing (js-call a :sourceObject (js-object))) (key (js-call a :string "n")))
      (deep (read a out) (js-array 1 2)) (same (js-call a :readNumber count) (js-call (get c :js) :extras))
      (let ((caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 missing)
        (try
          (each (js-array nil undefined) (lambda (receiver)
            (js-call assert :throws (lambda () (js-call a :invoke "run" (js-array receiver missing)))
              (lambda (error) (and (js-call globalThis.TypeError globalThis.Symbol.hasInstance error) (funcall (code "ELI-RT0001") error))))
            (same (js-call a :objectGet missing key) undefined)
            (same (get (js-call a :stats) :frameDepth) 1)))
          (finally (js-call a :leaveFrame caller))))
      (finish a (js-array fn object trace out count missing key)))))
  (test "assign copies string UTF16 code units and collection own properties while arrays retain holes and independent ownership"
    (async () (let* ((a (get (await (compiled)) :a)) (text "A😀\ud800") (string (js-call a :string text))
      (target (js-call a :sourceObject (js-object))) (out (js-call a :invoke "assign" (js-array target string))))
      (same (js-call a :keyEqual out target) t)
      (times (js-length text) (lambda (i) (let* ((key (js-call a :string (funcall globalThis.String i))) (value (js-call a :invoke "member" (js-array out key))))
        (same (js-call a :readString value) (aref text i)) (js-call a :release key) (js-call a :release value))))
      (each (js-array "map" "set" "iterator") (lambda (kind)
        (let* ((item (js-call a :invoke kind)) (property (js-call a :string "tag")) (number (js-call a :number 7))
          (support (js-call a :sourceObject (js-object :tag number))) (written (js-call a :invoke "assign" (js-array item support)))
          (copy (js-call a :sourceObject (js-object))) (result (js-call a :invoke "assign" (js-array copy item))) (keys (js-call a :invoke "keys" (js-array result))))
          (deep (read a keys) (js-array "tag")) (same (js-call a :invoke "own" (js-array result property)) t)
          (each (js-array item property number support written copy result keys) (lambda (v) (js-call a :release v))))))
      (let* ((array (js-call a :sourceArray (sparse))) (copy (js-call a :sourceObject (js-object)))
        (result (js-call a :invoke "assign" (js-array copy array))) (keys (js-call a :invoke "keys" (js-array result))))
        (deep (read a keys) (js-array "0" "2")) (finish a (js-array string target out array copy result keys))))))
  (test "raw Object property calls preserve caller roots on invalid handles, private frames, unsealed strings and malformed argument lists"
    (async () (let* ((c (await (compiled))) (a (get c :a)) (bytes (get c :bytes))) (finish a)
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
        (heap (js-call e "heap-new" 64 8192 65536)) (call (raw e heap)) (args (funcall call "value-refs" 7 2))
        (caller (funcall call "frame-new" 4)) (refs (funcall call "value-refs" 7 0))
        (text (funcall call "value-string" 1)) (object (funcall call "value-object-new" 3)))
        (each (js-array args refs text object) (lambda (value index) (funcall call "frame-set" caller index value)))
        (funcall call "value-set" args 0 object) (funcall call "heap-auto" 1)
        (each (js-array (js-array 4294967295 2 0 1) (js-array caller 4 0 1) (js-array args 1 0 3) (js-array args 2 3 3))
          (lambda (row) (same (js-call e "value-object-properties" heap (aref row 0) (aref row 1) (aref row 2)) 0)
            (same (js-call e "last-error") (aref row 3)) (same (funcall call "frame-depth") 1)))
        (each (js-array 0 1 2) (lambda (op) (each (js-array (js-array 4294967295 1) (js-array caller 3) (js-array refs 3) (js-array text 6))
          (lambda (row) (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :setUint32 (funcall call "value-data" args 7) (aref row 0) t)
            (same (js-call e "value-object-properties" heap args 2 op) 0) (same (js-call e "last-error") (aref row 1)) (same (funcall call "frame-depth") 1)))))
        (funcall call "frame-pop" caller) (funcall call "heap-collect") (same (funcall call "heap-live") 0)))))
  (test "frozen-header integration rejects mutations but permits inherited __proto__ setter no-ops with unchanged target identity"
    (async () (let* ((c (await (compiled))) (a (get c :a)) (bytes (get c :bytes))) (finish a)
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
        (heap (js-call e "heap-new" 64 8192 65536)) (call (raw e heap)) (prototype (funcall call "value-object-new" 3))
        (target (funcall call "value-object-new" prototype)) (source (funcall call "value-object-new" 0))
        (args (funcall call "value-refs" 7 2)) (caller (funcall call "frame-new" 6)) (key (funcall call "value-string" 9)) (normal (funcall call "value-string" 1)))
        (each (js-array prototype target source args key normal) (lambda (value index) (funcall call "frame-set" caller index value)))
        (times 9 (lambda (index) (funcall call "value-unit-set" key index (js-call "__proto__" :charCodeAt index)))) (funcall call "value-seal" key)
        (funcall call "value-unit-set" normal 0 120) (funcall call "value-seal" normal)
        (funcall call "value-set" args 0 target) (funcall call "value-set" args 1 source)
        (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :setUint32 (- (funcall call "value-data" target 13) 4) 1 t)
        (funcall call "heap-auto" 1)
        (each (js-array 1 2 3 prototype) (lambda (value) (funcall call "value-object-put" source key value 2) (same (funcall call "value-object-properties" args 2 2) target)))
        (funcall call "value-object-put" source key 0 2) (same (js-call e "value-object-properties" heap args 2 2) 0) (same (js-call e "last-error") 3)
        (funcall call "value-object-put" source key prototype 2) (funcall call "value-object-put" source normal 2 2)
        (same (js-call e "value-object-properties" heap args 2 2) 0) (same (js-call e "last-error") 3)
        (same (funcall call "value-object-has" target normal) 0) (same (funcall call "frame-depth") 1)
        (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :setUint32 (- (funcall call "value-data" target 13) 4) 0 t)
        (funcall call "value-object-put" prototype normal 1 2)
        (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :setUint32 (- (funcall call "value-data" prototype 13) 4) 1 t)
        (same (js-call e "value-object-properties" heap args 2 2) 0) (same (js-call e "last-error") 3)
        (same (funcall call "value-object-has" target normal) 0) (funcall call "frame-pop" caller) (funcall call "heap-collect") (same (funcall call "heap-live") 0))
      (let* ((parent (js-object)) (frozen (Object/freeze (Object/create parent))))
        (each (js-array false t undefined parent) (lambda (value)
          (same (Object/assign frozen (Object/defineProperty (js-object) "__proto__" (js-object :value value :enumerable t))) frozen)))
        (js-call assert :throws (lambda () (Object/assign frozen (Object/defineProperty (js-object) "__proto__" (js-object :value nil :enumerable t)))) globalThis.TypeError)))))
  (test "capacity exhaustion during key enumeration and assignment keeps prior source writes and allows later calls to recover"
    (async () (let* ((a (get (await (compiled undefined (js-object :maxSlots 128 :initialBytes 8192 :maxBytes 65536))) :a))
      (text (js-call a :string (js-call "x" :repeat 256))) (target (js-call a :sourceObject (js-object))) (first (js-call a :sourceObject (js-object :saved t))))
      (js-call assert :throws (lambda () (js-call a :invoke "keys" (js-array text))) (code "ELI-RT0002"))
      (same (get (js-call a :stats) :frameDepth) 0)
      (js-call assert :throws (lambda () (js-call a :invoke "assign" (js-array target first text))) (code "ELI-RT0002"))
      (let* ((key (js-call a :string "saved")) (keys (js-call a :invoke "keys" (js-array target))))
        (same (js-call a :objectGet target key) t) (deep (read a keys) (js-array "saved")) (finish a (js-array text target first key keys))))))
  (test "real assignment traps unwind private key snapshots and retain caller roots while prior null target errors suppress the trap"
    (async () (let* ((source (await (fixture 13))) (a (get (await (compiled source)) :a))) (finish a)
      (let* ((text (await (readFile "bootstrap/runtime/memory.eli" "utf8"))) (needle "(heap-object-properties-set heap target key value)")
        (point (js-call text :indexOf needle (js-call text :indexOf "  (defun value-object-properties "))))
        (js-call assert :ok (>= point 0))
        (let* ((rt (js-call (get b :compiler) :compile_ir_string (str (js-call text :slice 0 point) "(load-u32 4294967295)"
                          (js-call text :slice (+ point (js-length needle)))) "property-trap.eli"))
          (broken (get (await (compiled source undefined rt)) :a)) (target (js-call broken :sourceObject (js-object :saved t)))
          (input (js-call broken :sourceObject (js-object :x false))) (caller (js-call broken :frame 1)))
          (js-call broken :frameSet caller 0 target)
          (js-call assert :throws (lambda () (js-call broken :invoke "run" (js-array target input))) globalThis.WebAssembly.RuntimeError)
          (same (get (js-call broken :stats) :frameDepth) 1)
          (throws (lambda () (js-call broken :invoke "run" (js-array nil input)))) (same (get (js-call broken :stats) :frameDepth) 1)
          (let ((key (js-call broken :string "saved"))) (same (js-call broken :objectGet target key) t)
            (js-call broken :leaveFrame caller) (finish broken (js-array target input key))))))))
  (test "fixed-seed ordinary own keys and property merging match native Object operations under allocation on every step"
    (async () (let ((a (get (await (compiled)) :a)) (seed 1950093914))
      (letfn ((next () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223)))))
        (times 256 (lambda (trial) (let ((object (js-object)) (other (js-object)))
          (times (% (next) 24) (lambda (i)
            (let ((key (aref (js-array "z" "a" "01" "4294967294" "4294967295" "constructor" "toString" (funcall globalThis.String (% (next) 20))) (% (next) 8))))
              (put object key (/= (% (next) 2) 0)))))
          (times (% (next) 12) (lambda (i) (put other (funcall globalThis.String (% (next) 32)) (/= (% (next) 2) 0))))
          (let* ((input (js-call a :sourceObject object)) (source (js-call a :sourceObject other)) (keys (js-call a :invoke "keys" (js-array input)))
            (out (js-call a :invoke "assign" (js-array input source))) (merged (Object/assign (js-object) object other)) (result-keys (js-call a :invoke "keys" (js-array out))))
            (deep (read a keys) (Object/keys object)) (deep (read a result-keys) (Object/keys merged))
            (each (Object/keys merged) (lambda (key) (let* ((k (js-call a :string key)) (v (js-call a :invoke "member" (js-array out k))))
              (same v (get merged key)) (same (js-call a :invoke "own" (js-array out k)) t) (js-call a :release k) (js-call a :release v))))
            (each (js-array input source keys out result-keys) (lambda (value) (js-call a :release value)))))))) (finish a))))
  (test "Node consumes identical property-operation bytes with ordering, UTF16, own checks, identity and root cleanup"
    (async () (let* ((c (await (compiled))) (bytes (get c :bytes))) (finish (get c :a))
      (let ((result (runManagedNode (resolve root "tests/helpers/managed-object-properties-node.mjs") (js-array)
                     (js-object :input (globalThis.Buffer.from bytes) :encoding "utf8" :timeout 30000))))
        (same (get result :status) 0 (get result :stderr))))))
  (test "unrepresented primitive boxes, descriptors and callable object property models fail accurately instead of returning fabricated results"
    (async () (let ((a (get (await (compiled)) :a)))
      (each (js-array t false (js-call a :number 1) (js-call a :string "x")) (lambda (value)
        (throws (lambda () (js-call a :invoke "assign" (js-array value)))) (js-call a :release value))) (finish a))
      (let* ((c (await (compiled (await (fixture 16))))) (a (get c :a)) (js (get c :js)) (fn (js-call a :invoke "value")) (reference (js-call js :value))
             (keys (js-call a :invoke "keys" (js-array fn))))
        (deep (read a keys) (js-call js :keys reference)) (same (js-call a :invoke "own" (js-array fn)) (js-call js :own reference)) (finish a (js-array fn keys)))
      (let* ((source (str (await (fixture 16 1)) "\n" (await (readFile (resolve root "tests/fixtures/managed-object-properties-descriptor-probes.eli") "utf8"))))
             (c (await (compiled source))) (a (get c :a)) (js (get c :js)) (object (js-call a :invoke "run")) (reference (js-call js :run))
             (value (js-call a :invoke "read-probe" (js-array object))))
        (same (read a value) (js-call js :read_probe reference))
        (each (js-array "invalid-target" "invalid-descriptor" "mixed-descriptor") (lambda (name)
          (js-call assert :throws (lambda () (funcall (get js (js-call name :replaceAll "-" "_")))) globalThis.TypeError)
          (throws (lambda () (js-call a :invoke name))))) (finish a (js-array object value)))))
  (test "public Seed and three full compiler generations produce identical object property JS and WASM bytes"
    (async () (let* ((evidence (await (generations))) (js (await (loadManagedReference directory (get evidence :javascript) "properties-generation")))
      (a (instantiateManagedRuntime (get evidence :bytes)))) (js-call a :auto 1)
      (let ((out (js-call a :invoke "exercise"))) (deep (read a out) (js-call js :exercise)) (finish a (js-array out))))) 30000)
  (test "browser compiler emits identical property-operation bytes and runs the shared fixture without host imports"
    (async () (let* ((evidence (await (generations)))
      (bundle (await (bundleManagedBrowserPage (resolve root "tests/helpers/managed-object-properties-page.mjs")
        (js-object "eliscript-test/compiler" (resolve directory "g3/bootstrap/compiler.mjs") "eliscript-test/managed" (resolve directory "g3/backends/managed.mjs")))))
      (server (serveManagedBrowserPage bundle (get evidence :javascript)))
      (name (get (get globalThis.process :env) :ELISCRIPT_TEST_BROWSER "chromium"))
      (require (createRequire (resolve root "tests/wasm-managed-object-properties.test.mjs")))
      (engines (funcall require (js-call require :resolve "playwright-core" (js-object :paths
        (js-call (js-array (js-call globalThis.process :cwd)) :concat
          (js-call (js-call (get (get globalThis.process :env) :NODE_PATH "") :split delimiter) :filter
            (lambda (value) (> (js-length value) 0)))))))) (browser undefined))
      (js-call assert :ok (js-call (js-array "chromium" "firefox" "webkit") :includes name))
      (try (setq browser (await (js-call (get engines name) :launch)))
        (let ((page (await (js-call browser :newPage)))) (await (js-call page :goto (get (get server :url) :href)))
          (await (js-call page :waitForFunction (lambda () (get globalThis.globalThis :__eliscriptObjectPropertiesCase))))
          (let ((bytes (await (js-call page :evaluate (async (input) (await (funcall (get globalThis.globalThis :__eliscriptObjectPropertiesCase) input)))
                        (js-object :source family :runtime (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                          :seed (get evidence :javascript) :filename (get evidence :filename))))))
            (deep (globalThis.Uint8Array.from bytes) (get evidence :bytes))))
        (finally (try (when browser (await (js-call browser :close))) (finally (js-call server :stop t))))))) 30000)
  (test "Object.hasOwn accepts a real well-known Symbol key instead of the former compile refusal"
    (async () (let* ((a (get (await (compiled (await (fixture 19)))) :a)) (object (js-call a :sourceObject (js-object))))
      (same (js-call a :invoke "run" (js-array object)) false) (finish a (js-array object)))))
  (defasync generations ()
    (if generationEvidence generationEvidence
      (let* ((files (js-call (js-call (await (readdir "bootstrap/compiler")) :filter (lambda (file) (js-call file :endsWith ".eli"))) :sort))
             (all (js-array b)) (previous b) (generation 2))
        (while (<= generation 3)
          (let* ((output (resolve directory (str "g" generation))) (bootstrap (resolve output "bootstrap")) (index 0))
            (await (mkdir bootstrap (js-object :recursive t)))
            (while (< index (js-length files))
              (let* ((file (aref files index)) (path (resolve root "bootstrap/compiler" file))
                (name (str (js-call file :slice 0 -4) ".mjs"))
                (emission (js-call (get previous :compiler) :compile_string_with_source_map (await (readFile path "utf8")) path name (relative bootstrap path))))
                (await (writeFile (resolve bootstrap name) (str (get emission :javascript) "//# sourceMappingURL=" name ".map\n")))
                (await (writeFile (resolve bootstrap (str name ".map")) (get emission :sourceMap))))
              (setq index (1+ index)))
            (let* ((current (await (buildBackends (js-object :outputRoot output :frontend (get previous :compiler)))))
                   (path (resolve bootstrap "compiler.mjs")))
              (put current :compiler (funcall (createRequire path) path)) (js-call all :push current) (setq previous current)))
          (setq generation (1+ generation)))
        (let* ((filename (resolve root "tests/fixtures/wasm-managed-object-properties.eli"))
          (seed-file (resolve directory "object-properties-seed.mjs"))
          (seed (spawnSync (resolve root "bin/eliscript-seed") (js-array "--output" seed-file filename) (js-object :encoding "utf8" :timeout 30000))))
          (same (get seed :status) 0 (get seed :stderr))
          (let ((javascript (await (readFile seed-file "utf8"))) (bytes (js-array)) (index 0))
          (while (< index (js-length all))
            (let* ((current (aref all index)) (p (js-call (get current :compiler) :compile_ir_string family filename))
              (rt (js-call (get current :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli")))
              (same (js-call (get current :compiler) :emit_ir_string p) javascript)
              (js-call bytes :push (globalThis.Uint8Array.from (js-call (get current :managed) :emit_managed_wasm p rt))))
            (setq index (1+ index)))
          (deep (aref bytes 0) (aref bytes 1)) (deep (aref bytes 1) (aref bytes 2))
          (setq generationEvidence (js-object :all all :bytes (aref bytes 2) :javascript javascript :filename filename)))))))
)
