(module tests.compiler-corpus-project-entry
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:assert" AssertionError)
  (import "../tools/backends/compiler-corpus-program-driver.mjs" recordOriginalWireFailure loadOriginalProgramBody)
  (import "../tools/backends/managed-source-view.mjs" createManagedSourceView withManagedSourceDecode)
  (import "node:fs/promises" mkdtemp mkdir readFile writeFile rm symlink)
  (import "node:path" resolve dirname basename posix)
  (import "node:buffer" Buffer)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "node:os" tmpdir)
  (import "node:module" createRequire)
  (import "node:crypto" createHash)
  (import "../tools/backends/build.mjs" root buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/compiler-corpus-raw-language-fixtures.mjs" runOriginalRawLanguageFixtureHost originalRawLanguageFixturePlans loadOriginalRawLanguageModels)
  (import "../dist/bootstrap/compiler.mjs" compile-string)
  (import "../tools/backends/compiler-corpus.mjs" createOriginalCorpusSourceReader)
  (import "../tools/backends/compiler-corpus-managed-fixtures.mjs" addOriginalManagedFixtureAdapters readOriginalFinalFixtureMigrations)
  (import "../tools/testing/persistent-literal-fixture.mjs" projectPersistentLiteralSuite persistentLiteralPrivateRegexExpression)
  (import "../tools/backends/compiler-corpus-managed-adapters.mjs" originalManagedProgramCompletionSource)
  (import "../tools/backends/compiler-corpus-managed-fixtures-legacy.mjs" :as legacy)

  (import "../tools/backends/compiler-corpus-process.mjs" readOriginalProcessHostDependency bindOriginalProcessHostDependency)
  (import "../tools/backends/compiler-corpus-original-program.mjs" originalProgramSidecars)

  (defconst harness "tools/backends/eliscript/compiler-corpus-project-entry-host.eli")
  (defconst fixture "tests/fixtures/wasm-managed-project-entry.eli")
  (defconst state-file "tests/fixtures/wasm-managed-project-state.eli")
  (defconst host-bridge-assets (js-array "tools/backends/eliscript/managed-host.eli"
    "tools/backends/managed-host.mjs" "tools/backends/managed-host-legacy.mjs"))
  (defun hash (source) (js-call (js-call (createHash "sha256") :update source) :digest "hex"))
  (test "authenticated original JSON models compile their expression node and retain both complete input lists"
    (async ()
      (let* ((source (await (readFile (resolve root "tests/wasm-managed-json.test.mjs") "utf8")))
             (models (loadOriginalRawLanguageModels (js-object :source source :sourceSha256 (hash source)))))
        (js-call assert :ok (> (js-length (get models :valid)) 0))
        (js-call assert :ok (> (js-length (get models :invalid)) 0))
        (js-call (get models :valid) :forEach (lambda (text) (JSON/parse text)))
        (js-call (get models :invalid) :forEach (lambda (text)
          (js-call assert :throws (lambda () (JSON/parse text)))))
        (js-call assert :throws (lambda () (loadOriginalRawLanguageModels
          (js-object :source (str source "\n") :sourceSha256 (hash source)))) globalThis.TypeError))))
  (defasync workspace (run)
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-project-entry-replay-")))))
      (try (await (funcall run directory))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defasync deploy-observer (path)
    (let* ((reader (createOriginalCorpusSourceReader (js-object :sourceRoot root)))
           (dependency (await (readOriginalProcessHostDependency reader)))
           (source (compile-string (await (readFile (resolve root harness) "utf8")) harness))
           (record (bindOriginalProcessHostDependency (js-object :request (js-object) :original (js-object)
             :execution (js-object :host (basename path) :hostSource source)) dependency)))
      (await (originalProgramSidecars (js-object :directory (dirname path)) record))
      (js-call assert :strictEqual (await (readFile path "utf8")) source)
      (js-call assert :strictEqual (await (readFile (resolve (dirname path) "compiler-corpus-process.mjs") "utf8"))
        (get dependency :source))
      record))
  (defasync receipt-execution-options (options)
    (let ((locators (js-call (get options :locators) :slice)))
      (let ((migrations (await (readOriginalFinalFixtureMigrations options))) (index 0))
        (while (< index (js-length migrations))
          (let ((migration (aref migrations index)))
            (when (get migration :existingReplaySuite)
              (let ((identity (await (js-call options :file (get migration :suite)))))
                (js-call locators :push (js-object :file (get identity :file) :sourceSha256 (get identity :sha256)
                  :kind "maintained-fixture-execution-selection")))))
          (setq index (1+ index))))
      (Object/assign (js-object) options (js-object :locators locators))))
  (defasync real-module (directory)
    (await (mkdir directory (js-object :recursive t)))
    (let ((files (js-array fixture state-file)) (index 0))
      (while (< index (js-length files))
        (let* ((file (aref files index)) (name (aref (js-call file :split "/") 2))
               (source (await (readFile (resolve root file) "utf8"))))
          (await (writeFile (resolve directory (+ (js-call name :slice 0 -4) ".mjs"))
            (compile-string source file))))
        (setq index (1+ index))))
    (let ((path (resolve directory "wasm-managed-project-entry.mjs")))
      (funcall (createRequire path) path)))
  (defasync observer-module (path)
    (let* ((loader-path (resolve root "tools/backends/managed-runtime.mjs"))
           (loader (funcall (createRequire loader-path) loader-path))
           (namespace (funcall (createRequire path) path))
           (descriptor (js-object :hostModules
             (js-array (js-object :id "observer" :specifier (get (pathToFileURL path) :href)
               :referrer "project-entry-test.mjs" :allowedExports (js-array) :namespace t))))
           (provided (js-object :hostModules (new globalThis.Map (js-array (js-array "observer" namespace)))))
           (modules (await (js-call loader :loadManagedHostModules descriptor provided))))
      (js-call modules :get "observer")))
  (defasync services ()
    (let ((reader (createOriginalCorpusSourceReader (js-object :sourceRoot root))) (records (js-array)))
      (js-object :reader reader :records records :options
        (js-object :sourceRoot root :text (get reader :text) :file (get reader :file)
          :stableFiles (new globalThis.Set (js-array fixture state-file)) :locators (js-array)
          :records (js-array) :bindCoverage (lambda (record ids) (throw (new globalThis.Error "unexpected fixture source binding")))
          :add (lambda (record) (js-call records :push record))))))

  (test "project-entry replay checks each real graph's function identity then compares all original data and effects"
    (async ()
      (await (workspace (async (directory)
        (let* ((left (await (real-module (resolve directory "selected"))))
               (right (await (real-module (resolve directory "independent"))))
               (path (resolve directory "observer.mjs")))
          (await (deploy-observer path))
          (let* ((observer (await (observer-module path)))
                 (left-read (js-call left :read)) (right-read (js-call right :read)))
            (js-call assert :strictEqual left-read (get (get left :api) :read_counter))
            (js-call assert :strictEqual right-read (get (get right :api) :read_counter))
            (js-call assert :notStrictEqual left-read right-read)
            (js-call assert :strictEqual (funcall left-read) 3)
            (js-call assert :strictEqual (funcall right-read) 3)
            (let* ((actual (js-call observer :observeProjectEntry left))
                   (expected (js-call observer :observeProjectEntry right)))
              (js-call assert :deepStrictEqual actual expected)
              (js-call assert :deepStrictEqual (js-call (aref actual 0) :slice 0 5)
                (js-array 3 3 3 (js-array 1 3) (js-array 1 3)))
              ;; value-name and value_name have the same emitted binding name.
              ;; alias(99) therefore observes its parameter; the earlier live
              ;; counter reads are still 3 and the real increments end at 8.
              (js-call assert :strictEqual (aref (aref actual 0) 5) 99)
              (js-call assert :strictEqual (aref (aref expected 0) 5) 99)
              (js-call assert :strictEqual (aref actual 1) 8)
              (js-call assert :deepStrictEqual (aref actual 2) (js-array 1 3 7 7 6 8))
              (js-call assert :strictEqual (aref actual 4) "TypeError")
              (js-call assert :strictEqual (Object/is (aref (aref actual 5) 0) -0) t)
              (js-call assert :strictEqual (Number/isNaN (aref (aref actual 5) 1)) t)
              (js-call assert :strictEqual (aref (aref actual 5) 2) globalThis.Number.MIN_VALUE)
              (js-call assert :strictEqual (aref actual 6) "中😀")
              (js-call assert :strictEqual (js-call left :read) left-read)
              (js-call assert :strictEqual (js-call right :read) right-read)
              (js-call assert :strictEqual (funcall left-read) 8)
              (js-call assert :strictEqual (funcall right-read) 8)))))))))

  (test "project-entry preload passes the actual synchronous namespace in the loader second-argument Map"
    (async ()
      (await (workspace (async (directory)
        (let* ((actual (await (real-module (resolve directory "selected"))))
               (path (resolve directory "observer.mjs"))
               (loader-path (resolve root "tools/backends/managed-runtime.mjs"))
               (loader (funcall (createRequire loader-path) loader-path)))
          (await (deploy-observer path))
          (let* ((observer (await (observer-module path)))
                 (loaded (await (js-call observer :loadProjectEntryNamespace
                   (resolve directory "selected/wasm-managed-project-entry.mjs") "selected" loader))))
            (js-call assert :strictEqual loaded actual)
            (js-call assert :strictEqual (get loaded globalThis.Symbol.toStringTag) "Module")
            (js-call assert :strictEqual (js-call loaded :read) (get (get loaded :api) :read_counter))
            (js-call assert :strictEqual (funcall (js-call loaded :read)) 3))))))))

  (test "original program body loading retains the genuine namespace and awaits completion in both Node and Bun"
    (async () (await (workspace (async (directory)
      (let ((engines (js-array "node" "bun")) (index 0))
        (while (< index (js-length engines))
          (let* ((engine (aref engines index)) (trace (resolve directory (str engine "-body.trace")))
                 (host (resolve directory (str engine "-original-body.mjs")))
                 (driver (resolve directory (str engine "-body-driver.mjs")))
                 (helper (get (pathToFileURL (resolve root "tools/backends/compiler-corpus-program-driver.mjs")) :href))
                 (body (str "(import \"node:fs/promises\" appendFile)"
                   "(defconst originalIdentity (Object/freeze (js-object :source \"original-body\"))) (export originalIdentity)"
                   (originalManagedProgramCompletionSource (str "(await (appendFile " (JSON/stringify trace) " \"entered\\n\"))"
                     "(await (Promise/resolve undefined))(await (appendFile " (JSON/stringify trace) " \"completed\\n\"))"))))
                 (source (str "(import " (JSON/stringify helper) " loadOriginalProgramBody)"
                   "(import \"node:fs/promises\" readFile)(import \"node:assert/strict\" :default assert)(import \"node:module\" createRequire)"
                   (originalManagedProgramCompletionSource (str
                     "(let* ((loaded (await (loadOriginalProgramBody " (JSON/stringify (get (pathToFileURL host) :href)) " " (JSON/stringify directory) ")))"
                     " (namespace (js-call loaded :get \"original-body\")) (actual (funcall (createRequire " (JSON/stringify host) ") " (JSON/stringify host) ")))"
                     "(js-call assert :strictEqual namespace actual)"
                     "(js-call assert :strictEqual (get namespace globalThis.Symbol.toStringTag) \"Module\")"
                     "(js-call assert :strictEqual (get namespace :originalIdentity) (get actual :originalIdentity))"
                     "(js-call assert :strictEqual (await (readFile " (JSON/stringify trace) " \"utf8\")) \"entered\\ncompleted\\n\")"
                     "(console/log \"ORIGINAL-BODY-COMPLETE\"))")))))
            (await (writeFile host (compile-string body "original-program-body.eli")))
            (await (writeFile driver (compile-string source "original-program-body-driver.eli")))
            (let ((child (spawnSync engine (js-array driver) (js-object :cwd directory :encoding "utf8"))))
              (js-call assert :strictEqual (get child :error) undefined)
              (js-call assert :strictEqual (get child :signal) nil (get child :stderr))
              (js-call assert :strictEqual (get child :status) 0 (get child :stderr))
              (js-call assert :strictEqual (get child :stdout) "ORIGINAL-BODY-COMPLETE\n")))
          (setq index (1+ index)))))))))

  (test "original body namespace completion preserves the first rejection identity"
    (async () (await (workspace (async (directory)
      (let ((host (resolve directory "rejecting-body.mjs")))
        (await (writeFile host (compile-string
          "(defconst marker (Object/freeze (js-object :source \"original rejection\")))(defun then (accept reject) (funcall reject marker))(export marker then)"
          "rejecting-original-body.eli")))
        (await (js-call assert :rejects
          (loadOriginalProgramBody (get (pathToFileURL host) :href) directory)
          (lambda (error) (eq error (get (funcall (createRequire host) host) :marker)))))))))))

  (test "only the two project-entry hosts migrate and retain real source identity original records budgets and mandatory oracle"
    (async ()
      (let* ((state (await (services))) (options (get state :options)) (baseline (js-array))
             (original (Object/assign (js-object) options
               (js-object :add (lambda (record) (js-call baseline :push record))))))
        (await (js-call legacy :addOriginalManagedFixtureAdapters original))
        (await (addOriginalManagedFixtureAdapters options))
        (let ((records (get state :records)) (changed 0) (index 0))
          (js-call assert :strictEqual (js-length records) (js-length baseline))
          (while (< index (js-length records))
            (let ((record (aref records index)) (old (aref baseline index)))
              (js-call assert :strictEqual (get record :id) (get old :id))
              (if (js-call (get record :id) :startsWith "original-managed-fixture:project-entry:")
                (progn
                  (setq changed (1+ changed))
                  (js-call (js-array "kind" "coverage" "entry" "modules" "auto" "memory" "expected") :forEach
                    (lambda (key) (js-call assert :deepStrictEqual (get record key) (get old key))))
                  (let* ((execution (Object/assign (js-object) (get record :execution)))
                         (before (Object/assign (js-object) (get old :execution))))
                    (Reflect/deleteProperty execution "hostSource") (Reflect/deleteProperty before "hostSource")
                    (js-call assert :deepStrictEqual execution before))
                  (js-call assert :strictEqual (get (get record :execution) :hostSource)
                    (compile-string (await (readFile (resolve root harness) "utf8")) harness))
                  (js-call assert :strictEqual (get (get record :execution) :referenceArtifact) t)
                  (js-call assert :strictEqual (get (get record :expected) :oracleRequired) t)
                  (let ((asset (js-call (get (get record :original) :sourceAssets) :find
                                 (lambda (item) (= (get item :file) harness)))))
                    (js-call assert :ok asset)
                    (js-call assert :strictEqual (get asset :sourceSha256) (hash (await (readFile (resolve root harness))))))
                  (let ((asset-index 0))
                    (while (< asset-index (js-length host-bridge-assets))
                      (let* ((filename (aref host-bridge-assets asset-index))
                             (bound (js-call (get (get record :original) :sourceAssets) :filter
                               (lambda (item) (= (get item :file) filename)))))
                        (js-call assert :strictEqual (js-length bound) 1)
                        (js-call assert :strictEqual (get (aref bound 0) :sourceSha256)
                          (hash (await (readFile (resolve root filename))))))
                      (setq asset-index (1+ asset-index))))
                  (let* ((metadata (Object/assign (js-object) (get record :original)))
                         (process-files (js-array "tools/backends/eliscript/compiler-corpus-process.eli"
                           "tools/backends/compiler-corpus-process.mjs"))
                         (process-proofs (js-array))
                         (process-id (js-call posix :join
                           (js-call posix :dirname (get (get record :execution) :host)) "compiler-corpus-process.mjs"))
                         (expected-marker (js-object :version 1 :id process-id :sourceAssets process-proofs))
                         (expected-sources (js-call (or (get (get old :request) :hostSources) (js-array)) :slice))
                         (process-index 0))
                    ;; Construct the marker oracle from both complete physical
                    ;; files, independently of the dependency binding helper.
                    (js-call assert :strictEqual (js-length (js-call expected-sources :filter
                      (lambda (source) (= (get source :id) process-id)))) 0)
                    (while (< process-index (js-length process-files))
                      (let* ((filename (aref process-files process-index))
                             (bytes (await (readFile (resolve root filename))))
                             (proof (js-object :file filename :bytes (js-length bytes) :sourceSha256 (hash bytes))))
                        (js-call process-proofs :push proof)
                        (js-call assert :deepStrictEqual
                          (js-call (get (get record :original) :sourceAssets) :filter
                            (lambda (asset) (= (get asset :file) filename))) (js-array proof))
                        (when (= process-index 1)
                          (let ((declarations (js-call (get (get record :request) :hostSources) :filter
                                  (lambda (source) (= (get source :id) process-id)))))
                            (js-call assert :strictEqual (js-length declarations) 1)
                            (js-call assert :strictEqual (get (aref declarations 0) :filename) filename)
                            (js-call assert :ok (js-call bytes :equals
                              (Buffer/from (get (aref declarations 0) :source) "utf8")))
                            (js-call expected-sources :push (js-object :id process-id :filename filename
                              :source (js-call bytes :toString "utf8"))))))
                      (setq process-index (1+ process-index)))
                    (js-call assert :deepStrictEqual (get metadata :processHostDependency) expected-marker)
                    (js-call assert :deepStrictEqual (get record :request)
                      (Object/assign (js-object) (get old :request) (js-object :hostSources expected-sources)))
                    (Reflect/deleteProperty metadata "sourceAssets")
                    (let* ((archive-file "tests/direct-wasm-backend-test-legacy.mjs")
                           (bytes (await (readFile (resolve root archive-file))))
                           (sha "f0fa57d2aae13f0bef9f7afa04ee51d1d3386c4a3e011ad231ad2577c99876c2")
                           (proof (js-object :file archive-file :bytes (js-length bytes) :sourceSha256 sha
                             :region (js-object :start 0 :end (js-length (js-call bytes :toString "utf8"))
                               :byteStart 0 :byteEnd (js-length bytes) :sha256 sha)))
                           (migration (get metadata :directWasmSourceMigration)))
                      (js-call assert :strictEqual (hash bytes) sha)
                      (js-call assert :deepStrictEqual (get metadata :assertionSource) proof)
                      (js-call assert :deepStrictEqual (get migration :assertionSource) proof)
                      (js-call assert :strictEqual (get migration :executedSuite) "tests/direct-wasm-backend.test.mjs")
                      (js-call assert :strictEqual (get migration :registration) "complete-native-bun-registration-with-exact-maintained-callbacks")
                      (js-call assert :strictEqual (js-length (get migration :sourceAssets)) 28)
                      (let ((index 0))
                        (while (< index (js-length (get migration :sourceAssets)))
                          (let* ((asset (aref (get migration :sourceAssets) index))
                                 (actual (await (readFile (resolve root (get asset :file))))))
                            (js-call assert :strictEqual (js-length actual) (get asset :bytes))
                            (js-call assert :strictEqual (hash actual) (get asset :sourceSha256))
                            (js-call assert :deepStrictEqual
                              (js-call (get (get record :original) :sourceAssets) :filter
                                (lambda (item) (= (get item :file) (get asset :file)))) (js-array asset)))
                          (setq index (1+ index)))))
                    (Reflect/deleteProperty metadata "assertionSource")
                    (Reflect/deleteProperty metadata "directWasmSourceMigration")
                    (js-call assert :deepStrictEqual metadata
                      (Object/assign (js-object) (get old :original)
                        (js-object :suite "tests/direct-wasm-backend-test-legacy.mjs"
                          :processHostDependency expected-marker
                          :sourceSha256 "f0fa57d2aae13f0bef9f7afa04ee51d1d3386c4a3e011ad231ad2577c99876c2")))))
                (js-call assert :deepStrictEqual record old)))
            (setq index (1+ index)))
          (js-call assert :strictEqual changed 2)))))

  (test "project-entry harness asset failures keep the original thrown value and publish no falsely bound host"
    (async ()
      (let* ((state (await (services))) (options (get state :options)) (marker (js-object :asset harness)))
        (put options :text (async (filename)
          (if (= filename harness) (throw marker) (await (js-call (get state :reader) :text filename)))))
        (await (js-call assert :rejects (lambda () (addOriginalManagedFixtureAdapters options))
          (lambda (error) (eq error marker))))
        (js-call assert :strictEqual (js-length (get state :records)) 0))))
  (test "original project-entry module import does not finish before its asynchronous main finishes"
    (async ()
      (await (workspace (async (directory)
        (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
        (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
        (await (real-module (resolve directory "selected")))
        (await (real-module (resolve directory "reference")))
        (let* ((engines (js-array "node" "bun")) (index 0))
          (while (< index (js-length engines))
            (let* ((engine (aref engines index))
                   (host (resolve directory (str "__eliscript_managed_fixture_project-entry_" engine ".mjs")))
                   (driver (resolve directory (str "completion-" engine ".mjs")))
                   (loader (get (pathToFileURL (resolve root "tools/backends/managed-runtime.mjs")) :href))
                   (source (str "(import " (JSON/stringify loader) " loadManagedHostModules)(import \"node:module\" createRequire)"
                     (originalManagedProgramCompletionSource (str " (put (get globalThis.process :argv) 1 " (JSON/stringify host) ")"
                     " (let* ((namespace (funcall (createRequire " (JSON/stringify host) ") " (JSON/stringify host) "))"
                     " (descriptor (js-object :hostModules (js-array (js-object :id \"host\" :specifier "
                     (JSON/stringify (get (pathToFileURL host) :href))
                     " :referrer \"completion.mjs\" :allowedExports (js-array) :namespace t))))"
                     " (provided (js-object :hostModules (new globalThis.Map (js-array (js-array \"host\" namespace)))))"
                     " (loaded (await (loadManagedHostModules descriptor provided))))"
                     " (await (js-call loaded :get \"host\")))"
                     " (js-call globalThis.console :log \"HOST-COMPLETE\")")))))
              (await (deploy-observer host))
              (await (writeFile driver (compile-string source "completion.eli")))
              (let ((child (spawnSync engine
                      (js-array driver (resolve directory "selected") "wasm-managed-project-entry.mjs")
                      (js-object :cwd directory :encoding "utf8" :env
                        (Object/assign (js-object) (get globalThis.process :env) (js-object
                          :ELISCRIPT_ORIGINAL_TARGET "javascript" :ELISCRIPT_ORIGINAL_SOURCE_ROOT root
                          :ELISCRIPT_ORIGINAL_REFERENCE_PRODUCT_ROOT (resolve directory "reference")))))))
                (when (get child :error) (throw (get child :error)))
                (js-call assert :strictEqual (get child :status) 0 (get child :stderr))
                (js-call assert :strictEqual (get child :stdout) "{\"observations\":1}\nHOST-COMPLETE\n")))
            (setq index (1+ index)))))))))

  (test "function properties retains Node reference ordering and the original binary Error standard boundary"
    (async ()
      (await (workspace (async (directory)
        (let ((path (resolve directory "observer.mjs")))
          (await (deploy-observer path))
          (let* ((observer (await (observer-module path)))
                 (host-shape (JSON/stringify (js-array (Object/keys globalThis.Error)
                   (Object/getOwnPropertyNames globalThis.Error) (js-array) t
                   (js-array "function" "" 0 false t))))
                 (standard "[[],[\"length\",\"name\",\"prototype\"],[],true,[\"function\",\"\",0,false,true]]"))
            (js-call assert :strictEqual (js-call observer :functionPropertiesExpectedShape "javascript" 3 host-shape) host-shape)
            (js-call assert :strictEqual (js-call observer :functionPropertiesExpectedShape "wasm" 3 host-shape) standard)
            (js-call assert :strictEqual (js-call observer :functionPropertiesExpectedShape "native" 3 host-shape) standard)
            (js-call assert :strictEqual (js-call observer :functionPropertiesExpectedShape "wasm" 0 "ordered-own-names") "ordered-own-names")
            (js-call assert :throws (lambda () (js-call observer :functionPropertiesExpectedShape "unknown" 3 host-shape)))
            (js-call assert :throws (lambda () (js-call observer :observeFunctionProperties (js-object) (js-array "name")))))))))))
  (test "raw language fixture observers use actual zero-import bytes and preserve complete declared inputs without host injection"
    (async ()
      (await (workspace (async (directory)
        (let* ((backends (await (buildBackends (js-object :outputRoot directory))))
               (compiler (get backends :compiler))
               (memory (js-call compiler :compile_ir_string
                 (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
               (plans (originalRawLanguageFixturePlans)) (index 0))
          (while (< index (js-length plans))
            (let* ((plan (aref plans index)) (family (get plan :family))
                   (file (str "tests/fixtures/wasm-managed-" family ".eli"))
                   (source (await (readFile (resolve root file) "utf8")))
                   (program (js-call compiler :compile_ir_string source file))
                   (emission-options (if (undefined? (get plan :requiredABI)) undefined
                     (js-object :abi (get plan :requiredABI))))
                   (bytes (globalThis.Uint8Array.from (js-call (get backends :managed) :emit_managed_wasm program memory emission-options)))
                   (path (resolve directory (str family ".mjs"))))
              (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
              (await (writeFile path (js-call compiler :emit_ir_string program)))
              (let* ((oracle (funcall (createRequire path) path))
                     (runtime (instantiateManagedRuntime bytes)))
                (try
                  (js-call runtime :auto 1)
                  (let ((result (runOriginalRawLanguageFixtureHost (js-object :family family :runtime runtime :oracle oracle
                    :source (await (readFile (resolve root (str "tests/wasm-managed-" family ".test.mjs")) "utf8"))
                    :sourceSha256 (hash (await (readFile (resolve root (str "tests/wasm-managed-" family ".test.mjs")) "utf8")))))))
                    (js-call assert :ok (> (get result :observations) 0))
                    (js-call assert :deepStrictEqual (get result :hostOnlyGroups) (get plan :hostOnlyGroups)))
                  (finally (js-call runtime :closeModule) (js-call runtime :collect)))
                (js-call assert :strictEqual (js-call runtime :live) 0)))
            (setq index (1+ index)))))))))
  (test "raw language failure evidence retains the actual family operation and completed ordinal without replacing the first error"
    (lambda ()
      (let* ((failure (new globalThis.Error "actual raw operation failure")) (released 0)
             (runtime (js-object :number (lambda (value) (js-object :kind 4 :value value))
               :invoke (lambda (&rest ignored) (throw failure))
               :release (lambda (value) (setq released (1+ released)))
               :collect (lambda () undefined) :stats (lambda () (js-object :frameDepth 0)))))
        (js-call assert :throws (lambda () (runOriginalRawLanguageFixtureHost
          (js-object :family "empty-bindings" :runtime runtime :oracle (js-object))))
          (lambda (error)
            (js-call assert :strictEqual error failure)
            (js-call assert :deepStrictEqual (get error :originalRawFixture)
              (js-object :family "empty-bindings" :label "parallel-value" :completedObservations 0)) t))
        (js-call assert :strictEqual released 0))))
  (test "raw language observer refuses an unknown family before touching a runtime"
    (lambda () (js-call assert :throws (lambda ()
      (runOriginalRawLanguageFixtureHost (js-object :family "unknown" :runtime (js-object) :oracle (js-object)))) globalThis.TypeError)))
  (defun wire-diagnostic-view (backing)
    (get (withManagedSourceDecode (lambda ()
      (createManagedSourceView (js-object :target (if (Array/isArray backing) (new globalThis.Array (js-length backing)) (js-object))
        :operations (js-object
          :keys (lambda () (Reflect/ownKeys backing))
          :descriptor (lambda (key) (Reflect/getOwnPropertyDescriptor backing key))
          :get (lambda (key receiver) (Reflect/get backing key backing))
          :prototype (lambda () (Reflect/getPrototypeOf backing))
          :extensible (lambda () (Reflect/isExtensible backing))))))) :value))
  (defasync wire-diagnostic-case (body)
    (await (workspace (async (directory)
      (let* ((environment (get globalThis.process :env))
             (key "ELISCRIPT_ORIGINAL_EXECUTION_CONTEXT") (present (Object/hasOwn environment key))
             (previous (get environment key))
             (context (js-object :caseId "stable-compatibility:program:tests/fixtures/wire.eli"
               :target "wasm" :directory directory :sourceIdentity (js-object :sha256 "original-wire-source")))
             (input (js-object :sourceRoot root :host (resolve root "tests/fixtures/wire-host.mjs"))))
        (try
          (put environment key (JSON/stringify context))
          (await (funcall body input context directory))
          (finally (if present (put environment key previous) (Reflect/deleteProperty environment key)))))))))
  (test "wire failure evidence reads the same result without getters and preserves sparse values and first error"
    (async ()
      (await (wire-diagnostic-case (async (input context directory)
        (let* ((reads 0) (items (new globalThis.Array 3)) (symbol (globalThis.Symbol "wire-key"))
               (prototype (Object/create globalThis.Array.prototype))
               (unused (Object/defineProperty prototype "constructor" (js-object :get (lambda () (setq reads (1+ reads)) globalThis.Array))))
               (unused2 (Object/setPrototypeOf items prototype)))
          (put items 1 undefined) (put items 2 -0) (put items symbol "symbol-value")
          (let* ((tags (wire-diagnostic-view items))
                 (actual (wire-diagnostic-view (js-object :User (wire-diagnostic-view (js-object :tags tags :name "小明😀")))))
                 (failure (new AssertionError (js-object :actual actual
                   :expected (js-object :User (js-object :tags (js-array undefined undefined 0)))
                   :operator "deepStrictEqual" :message "original-first-error")))
                 (first (Object/freeze failure))
                 (message (get first :message)))
            (await (recordOriginalWireFailure input first))
            (js-call assert :strictEqual first failure)
            (js-call assert :strictEqual (get first :message) message)
            (js-call assert :strictEqual reads 0)
            (js-call assert :strictEqual (Object/hasOwn items "0") false)
            (js-call assert :strictEqual (Object/is (aref items 2) -0) t)
            (let ((receipt (JSON/parse (await (readFile (resolve directory "wire-first-failure.json") "utf8")))))
              (js-call assert :strictEqual (get receipt :status) "observed")
              (js-call assert :deepStrictEqual (get receipt :sourceIdentity) (get context :sourceIdentity))
              (js-call (js-array "undefined" "-0" "wire-key" "symbol-value") :forEach (lambda (part)
                (js-call assert :ok (js-call (get receipt :actualSnapshot) :includes part))))
              (js-call assert :strictEqual (get (get receipt :tags) :constructorObservable) false)
              (js-call assert :strictEqual (get (get receipt :tags) :prototypeSame) false)))))))))
  (test "wire diagnostic refuses unknown cases and changed host bytes before observing the original result"
    (async ()
      (await (wire-diagnostic-case (async (input context directory)
        (let* ((reads 0) (view (wire-diagnostic-view (js-object :User (js-object :tags (js-array 1)))))
               (failure (new AssertionError (js-object :actual view :expected (js-object) :message "original"))))
          (Object/defineProperty failure "actual" (js-object :get (lambda () (setq reads (1+ reads)) view)))
          (put context :caseId "unrelated")
          (put (get globalThis.process :env) :ELISCRIPT_ORIGINAL_EXECUTION_CONTEXT (JSON/stringify context))
          (await (recordOriginalWireFailure input failure))
          (put context :caseId "stable-compatibility:program:tests/fixtures/wire.eli")
          (put (get globalThis.process :env) :ELISCRIPT_ORIGINAL_EXECUTION_CONTEXT (JSON/stringify context))
          (let ((changed (resolve directory "changed.mjs")))
            (await (writeFile changed (str (await (readFile (get input :host) "utf8")) "\n")))
            (await (recordOriginalWireFailure (Object/assign (js-object) input (js-object :host changed)) failure)))
          (await (recordOriginalWireFailure input failure))
          (js-call assert :strictEqual reads 0)
          (await (js-call assert :rejects (lambda () (readFile (resolve directory "wire-first-failure.json")))))))))))
  (test "wire observation failures are secondary evidence and cannot replace the original assertion"
    (async ()
      (await (wire-diagnostic-case (async (input context directory)
        (let* ((view (get (withManagedSourceDecode (lambda ()
                 (createManagedSourceView (js-object :target (js-object) :operations
                   (js-object :keys (lambda () (throw false)) :descriptor (lambda (key) undefined)
                     :get (lambda (key receiver) undefined) :prototype (lambda () globalThis.Object.prototype)
                     :extensible (lambda () t)))))) :value))
               (first (new AssertionError (js-object :actual view :expected (js-object) :message "original"))))
          (await (recordOriginalWireFailure input first))
          (let ((receipt (JSON/parse (await (readFile (resolve directory "wire-first-failure.json") "utf8")))))
            (js-call assert :strictEqual (get receipt :status) "unobservable")
            (js-call assert :strictEqual (get receipt :diagnosticError) "false"))
          (js-call assert :strictEqual (get first :message) "original")))))))

  (test "all seven original fixture receipt callers compile with their imported helper in the same lexical unit"
    (async ()
      (let* ((state (await (services))) (baseline (js-array)) (actual (get state :records))
             (families (js-array "catch-destructuring" "typeof" "js-cons" "object-properties"
                         "array-construction" "primitive-operators" "objects"))
             (options (Object/assign (js-object) (get state :options)
               (js-object :stableFiles (new globalThis.Set (js-call families :map (lambda (family)
                 (str "tests/fixtures/wasm-managed-" family ".eli"))))))))
        (setq options (await (receipt-execution-options options)))
        (await (js-call legacy :addOriginalManagedFixtureAdapters (Object/assign (js-object) options
          (js-object :add (lambda (record) (js-call baseline :push record))))))
        (await (addOriginalManagedFixtureAdapters options))
        (js-call assert :strictEqual (js-length actual) (js-length baseline))
        (js-call assert :ok (> (js-length actual) 0))
        (let ((callers (js-call actual :filter (lambda (record)
          (get (get record :original) :observationTransport)))))
          (js-call assert :strictEqual (js-length callers) 14)
          (js-call families :forEach (lambda (family)
            (js-call (js-array "node" "bun") :forEach (lambda (host)
              (js-call assert :strictEqual (js-length (js-call callers :filter (lambda (record)
                (= (get record :id) (str "original-managed-fixture:" family ":" host))))) 1)))))
          (js-call callers :forEach (lambda (record)
          (let* ((before (js-call baseline :find (lambda (item) (= (get item :id) (get record :id)))))
                 (transport (get (get record :original) :observationTransport))
                 (javascript (get (get record :execution) :javascriptHostSource)))
            (js-call assert :ok before)
            (js-call assert :deepStrictEqual (get record :expected) (get before :expected))
            (js-call assert :strictEqual (get transport :originalHostSource) (get (get before :execution) :hostSource))
            (js-call assert :strictEqual (get transport :originalHostSha256) (hash (get transport :originalHostSource)))
            (js-call assert :ok (js-call javascript :includes "function originalFixtureReceipt("))
            (js-call assert :ok (js-call javascript :includes "finishOriginalFixtureObservation")))))))))
  (test "persistent literal projection preserves the original query instance test and its real source root"
    (async ()
      (let* ((file "tests/wasm-managed-persistent-literals.test.mjs")
             (source (await (readFile (resolve root file) "utf8")))
             (projected (projectPersistentLiteralSuite root source))
             (expression (persistentLiteralPrivateRegexExpression))
             (coordinate "pathToFileURL(resolve(root, 'runtime/core/regex.mjs')).href")
             (restored (js-call projected :replace expression coordinate))
             (begin (js-call source :indexOf "  hostTest(host + ' regex boundaries use the declared host provider private registry'"))
             (end (js-call source :indexOf "\n  hostTest(" (1+ begin))))
        (js-call assert :ok (>= begin 0))
        (js-call assert :ok (> end begin))
        (js-call assert :strictEqual (js-length (js-call projected :split expression)) 2)
        (js-call assert :ok (js-call restored :includes (js-call source :slice begin end)))
        (js-call assert :ok (js-call projected :includes (JSON/stringify root)))
        (js-call assert :strictEqual (js-call projected :includes "const root = resolve(import.meta.dir, '..');") false)
        (js-call assert :strictEqual (await (readFile (resolve root file) "utf8")) source))))
)
