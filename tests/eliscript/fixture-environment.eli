(module tests.fixture-environment
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs" existsSync mkdirSync mkdtempSync writeFileSync rmSync readFileSync)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/testing/fixture-environment.mjs" prepareFixtureEnvironment
    fixtureChildArguments fixtureRuntimeResponse installFixtureImportMap installFixtureBrowserEnvironment)
  (import "../tools/testing/persistent-literal-fixture.mjs" projectPersistentLiteralSuite)

  (test "fixture environment owns package-scoped scratch and preserves caller state and original arguments"
    (lambda ()
      (let* ((environment (Object/assign (js-object) (get globalThis.process :env)
               (js-object :TMPDIR "/original-private-tmp" :TMP "original-tmp" :TEMP "original-temp" :KEEP "kept")))
             (before (JSON/stringify environment))
             (fixture (prepareFixtureEnvironment root environment))
             (other (prepareFixtureEnvironment root environment)))
        (try
          (let* ((env (get fixture :environment)) (directory (get fixture :directory))
                 (arguments (js-array "--smol" "test" "tests/direct-wasm-backend.test.mjs")))
            (js-call assert :notStrictEqual env environment)
            (js-call assert :strictEqual (JSON/stringify environment) before)
            (js-call assert :strictEqual (get env :KEEP) "kept")
            (js-call assert :strictEqual (get env :TMPDIR) directory)
            (js-call assert :strictEqual (get env :TMP) directory)
            (js-call assert :strictEqual (get env :TEMP) directory)
            (js-call assert :strictEqual (existsSync directory) t)
            (js-call assert :notStrictEqual directory (get other :directory))
            (js-call assert :deepStrictEqual (fixtureChildArguments arguments env)
              (js-array "--smol" "test" "--preload" (resolve root "tools/testing/fixture-environment.mjs")
                "--preload" (resolve root "tests/helpers/direct-wasm-registration-install.mjs")
                "tests/direct-wasm-backend.test.mjs"))
            (js-call assert :deepStrictEqual arguments (js-array "--smol" "test" "tests/direct-wasm-backend.test.mjs"))
            (js-call assert :deepStrictEqual (fixtureChildArguments (js-array "test" "original.test.mjs") env)
              (js-array "test" "--preload" (resolve root "tools/testing/fixture-environment.mjs") "original.test.mjs"))
            (js-call assert :throws (lambda () (fixtureChildArguments (js-array "--smol" "original.test.mjs") env))
              globalThis.TypeError)
            (js-call assert :deepStrictEqual (fixtureChildArguments arguments (js-object))
              (js-array "--smol" "test" "--preload"
                (resolve root "tests/helpers/direct-wasm-registration-install.mjs")
                "tests/direct-wasm-backend.test.mjs"))
            (let ((ordinary (js-array "test" "original.test.mjs")))
              (js-call assert :strictEqual (fixtureChildArguments ordinary (js-object)) ordinary))
            (js-call fixture :close)
            (js-call assert :strictEqual (existsSync directory) false)
            (js-call assert :strictEqual (existsSync (get other :directory)) t)
            (js-call fixture :close))
          (finally (js-call fixture :close) (js-call other :close))))))

  (test "fixture setup rejects an unrelated package and forged preload coordinates without deleting caller files"
    (lambda ()
      (mkdirSync (resolve root ".eliscript-cache") (js-object :recursive t))
      (let ((directory (mkdtempSync (resolve root ".eliscript-cache/fixture-environment-negative-"))))
        (try
          (writeFileSync (resolve directory "package.json") (JSON/stringify (js-object :name "unrelated")))
          (writeFileSync (resolve directory "retained") "keep")
          (js-call assert :throws (lambda () (prepareFixtureEnvironment directory (js-object))) globalThis.TypeError)
          (js-call assert :strictEqual (readFileSync (resolve directory "retained") "utf8") "keep")
          (js-call assert :throws (lambda () (fixtureChildArguments (js-array "test")
            (js-object :ELISCRIPT_TEST_FIXTURE_PRELOAD "1" :ELISCRIPT_TEST_FIXTURE_ROOT root
              :ELISCRIPT_TEST_FIXTURE_PRELOAD_PATH (resolve directory "forged.mjs")))) globalThis.TypeError)
          (finally (rmSync directory (js-object :recursive t :force t)))))))

  (test "complete archived suite registration installs before entry linking without changing original files or child options"
    (lambda ()
      (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
             (environment (get fixture :environment))
             (routes (js-array
               (js-array "tests/wasm-managed-number-text.test.mjs" "tests/helpers/managed-numeric-fixtures-install.mjs")
               (js-array "tests/wasm-managed-primitive-operators.test.mjs" "tests/helpers/managed-numeric-fixtures-install.mjs")
               (js-array "tests/native-node-memory.test.mjs" "tests/helpers/compiler-portable-fixtures-install.mjs")
               (js-array "tests/emacs-analysis-evidence.test.mjs" "tests/helpers/managed-capacity-registration.mjs")
               (js-array "tests/compiler-fragment-combine.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/compiler-portable-predicates.test.mjs" "tests/helpers/compiler-portable-fixtures-install.mjs")
               (js-array "tests/compiler-portable-reader.test.mjs" "tests/helpers/compiler-portable-fixtures-install.mjs")
               (js-array "tests/wasm-managed-object-integrity.test.mjs" "tests/helpers/managed-integrity-install.mjs")
               (js-array "tests/wasm-managed-function-properties.test.mjs" "tests/helpers/managed-function-properties-install.mjs")
               (js-array "tests/direct-wasm-backend.test.mjs" "tests/helpers/direct-wasm-registration-install.mjs")
               (js-array "tests/wasm-managed-runtime.test.mjs" "tests/helpers/managed-runtime-install.mjs")
               (js-array "tests/wasm-managed-primitive-properties.test.mjs" "tests/helpers/managed-primitive-properties-install.mjs")
               (js-array "tests/wasm-managed-objects.test.mjs" "tests/helpers/managed-container-install.mjs")
               (js-array "tests/wasm-managed-arrays.test.mjs" "tests/helpers/managed-container-install.mjs")
               (js-array "tests/wasm-managed-builtins.test.mjs" "tests/helpers/managed-container-install.mjs")
               (js-array "tests/wasm-managed-identity.test.mjs" "tests/helpers/managed-container-install.mjs")
               (js-array "tests/compiler-response-events.test.mjs" "tests/helpers/response-identities-install.mjs")
               (js-array "tests/wasm-managed-transient-state.test.mjs" "tests/helpers/standard-library-fixture-install.mjs")
               (js-array "tests/wasm-managed-core-modules.test.mjs" "tests/helpers/standard-library-fixture-install.mjs")
               (js-array "tests/wasm-managed-sorted-core.test.mjs" "tests/helpers/standard-library-fixture-install.mjs")
               (js-array "tests/wasm-managed-empty-bindings.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-callables.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-realm-lifetime.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-native-prototype-callables.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-str.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-persistent-literals.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-variadic-calls.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-typeof.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-typeof-paths.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-array-callbacks.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-array-splice.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-project-linking.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-strings.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-text-constructors.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-regexp.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-regexp-exact.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/wasm-managed-regexp-indices.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/regexp-property-outlining.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
               (js-array "tests/dogfood-action.test.mjs" "tests/helpers/dogfood-action-install.mjs")
               (js-array "tests/dogfood-workflow.test.mjs" "tests/helpers/dogfood-workflow-install.mjs"))))
        (try
          (js-call routes :forEach (lambda (route)
            (let* ((file (str "./" (aref route 0))) (installer (resolve root (aref route 1)))
                   (arguments (js-array "--smol" "test" "--timeout" "300000" file))
                   (before (js-call arguments :slice)))
              (if (= (aref route 0) "tests/wasm-managed-persistent-literals.test.mjs")
                (let* ((prepared (fixtureChildArguments arguments environment))
                       (owned (resolve (get environment :ELISCRIPT_TEST_FIXTURE_DIRECTORY)
                                "initializer-source/tests/wasm-managed-persistent-literals.test.mjs"))
                       (source (readFileSync (resolve root (aref route 0)) "utf8")))
                  (js-call assert :deepStrictEqual prepared
                    (js-array "--smol" "test" "--preload" (resolve root "tools/testing/fixture-environment.mjs")
                      "--preload" installer "--timeout" "300000" owned))
                  (js-call assert :strictEqual (readFileSync owned "utf8") (projectPersistentLiteralSuite root source))
                  (js-call assert :strictEqual (readFileSync (resolve root (aref route 0)) "utf8") source)
                  (js-call assert :throws (lambda () (fixtureChildArguments arguments (js-object))) globalThis.TypeError))
                (progn
                  (js-call assert :deepStrictEqual (fixtureChildArguments arguments environment)
                    (js-array "--smol" "test" "--preload" (resolve root "tools/testing/fixture-environment.mjs")
                      "--preload" installer "--timeout" "300000" file))
                  (js-call assert :deepStrictEqual (fixtureChildArguments arguments (js-object))
                    (js-array "--smol" "test" "--preload" installer "--timeout" "300000" file))))
              (js-call assert :deepStrictEqual arguments before)
              (let ((prepared (fixtureChildArguments arguments environment)))
                (js-call assert :deepStrictEqual (fixtureChildArguments prepared environment) prepared)))))
          (let ((ordinary (js-array "test" "tests/direct-wasm-backend-test-legacy.mjs" "tests/unrelated.test.mjs")))
            (js-call assert :strictEqual (fixtureChildArguments ordinary (js-object)) ordinary))
          (finally (js-call fixture :close))))))

  (test "browser fixture routes only real allowlisted runtime bytes and refuses unrelated origins and paths"
    (lambda ()
      (let ((response (fixtureRuntimeResponse root "http://eliscript-fixture.invalid/runtime/unicode-case.mjs")))
        (js-call assert :strictEqual (get response :status) 200)
        (js-call assert :strictEqual (get response :body) (readFileSync (resolve root "runtime/unicode-case.mjs") "utf8")))
      (js-call (js-array "http://unrelated.invalid/runtime/unicode-case.mjs"
                        "http://eliscript-fixture.invalid/runtime/../package.json"
                        "http://eliscript-fixture.invalid/runtime/missing.mjs") :forEach
        (lambda (url) (js-call assert :strictEqual (get (fixtureRuntimeResponse root url) :status) 404)))))

  (test "browser fixture preserves actual launch/context identities and arguments and restores only its own wrappers"
    (async ()
      (let* ((calls (js-array)) (script undefined) (routing undefined)
             (context (js-object
               :addInitScript (async (function argument) (setq script (js-array function argument)))
               :route (async (pattern handler) (setq routing (js-array pattern handler)))))
             (browser (js-object :newContext (async (&rest arguments)
               (js-call calls :push (js-array "context" arguments)) context)))
             (type (js-object :launch (async (&rest arguments)
               (js-call calls :push (js-array "launch" arguments)) browser)))
             (original-launch (get type :launch)) (original-context (get browser :newContext))
             (restore (installFixtureBrowserEnvironment (js-array type) root)))
        (try
          (let* ((options (js-object :headless t)) (configuration (js-object :locale "zh-CN"))
                 (launched (await (js-call type :launch options)))
                 (created (await (js-call launched :newContext configuration))))
            (js-call assert :strictEqual launched browser)
            (js-call assert :strictEqual created context)
            (js-call assert :deepStrictEqual calls
              (js-array (js-array "launch" (js-array options)) (js-array "context" (js-array configuration))))
            (js-call assert :strictEqual (aref script 0) installFixtureImportMap)
            (js-call assert :strictEqual (get (get (aref script 1) :imports) "eliscript/runtime/unicode-case.mjs")
              "http://eliscript-fixture.invalid/runtime/unicode-case.mjs")
            (js-call assert :strictEqual (aref routing 0) "http://eliscript-fixture.invalid/**")
            (let ((response undefined))
              (await (funcall (aref routing 1) (js-object
                :request (lambda () (js-object :url (lambda () "http://eliscript-fixture.invalid/runtime/unicode-case-data.mjs")))
                :fulfill (async (value) (setq response value)))))
              (js-call assert :strictEqual (get response :body)
                (readFileSync (resolve root "runtime/unicode-case-data.mjs") "utf8"))))
          (finally (funcall restore)))
        (js-call assert :strictEqual (get type :launch) original-launch)
        (js-call assert :strictEqual (get browser :newContext) original-context))))

  (test "DOM importmap preparation contains only actual module coordinates and does not evaluate a compiler"
    (lambda ()
      (let* ((had-document (Object/hasOwn globalThis.globalThis "document"))
             (previous (get globalThis.globalThis :document)) (elements (js-array))
             (configuration (js-object :imports (js-object "eliscript/runtime/unicode-case.mjs"
               "http://eliscript-fixture.invalid/runtime/unicode-case.mjs"))))
        (try
          (put globalThis.globalThis :document (js-object
            :createElement (lambda (name) (js-call assert :strictEqual name "script") (js-object))
            :head (js-object :appendChild (lambda (element) (js-call elements :push element)))))
          (installFixtureImportMap configuration)
          (js-call assert :strictEqual (js-length elements) 1)
          (js-call assert :strictEqual (get (aref elements 0) :type) "importmap")
          (js-call assert :deepStrictEqual (JSON/parse (get (aref elements 0) :textContent)) configuration)
          (finally (if had-document (put globalThis.globalThis :document previous)
            (Reflect/deleteProperty globalThis.globalThis "document")))))))
  (test "DOM importmap init waits for the parser head and disconnects exactly once without replacing the document"
    (lambda ()
      (let* ((had-document (Object/hasOwn globalThis.globalThis "document"))
             (previous (get globalThis.globalThis :document))
             (had-observer (Object/hasOwn globalThis.globalThis "MutationObserver"))
             (previous-observer (get globalThis.globalThis :MutationObserver))
             (callback undefined) (observed undefined) (disconnected 0) (elements (js-array))
             (document (js-object :head nil :createElement (lambda (name) (js-call assert :strictEqual name "script") (js-object))))
             (configuration (js-object :imports (js-object "eliscript/runtime/" "/runtime/"))))
        (try
          (put globalThis.globalThis :document document)
          (put globalThis.globalThis :MutationObserver (new globalThis.Proxy globalThis.Object
            (js-object :construct (lambda (target arguments)
              (setq callback (aref arguments 0))
              (js-object :observe (lambda (target options)
                (js-call assert :strictEqual target document)
                (js-call assert :deepStrictEqual options (js-object :childList t :subtree t)) (setq observed target))
                :disconnect (lambda () (setq disconnected (1+ disconnected))))))))
          (installFixtureImportMap configuration)
          (js-call assert :strictEqual observed document) (js-call assert :strictEqual (js-length elements) 0)
          (funcall callback)
          (js-call assert :strictEqual (js-length elements) 0)
          (put document :head (js-object :appendChild (lambda (element) (js-call elements :push element))))
          (funcall callback) (funcall callback)
          (js-call assert :strictEqual (js-length elements) 1) (js-call assert :strictEqual disconnected 1)
          (js-call assert :deepStrictEqual (JSON/parse (get (aref elements 0) :textContent)) configuration)
          (finally
            (if had-document (put globalThis.globalThis :document previous) (Reflect/deleteProperty globalThis.globalThis "document"))
            (if had-observer (put globalThis.globalThis :MutationObserver previous-observer) (Reflect/deleteProperty globalThis.globalThis "MutationObserver")))))))
)
