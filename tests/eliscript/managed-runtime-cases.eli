(module tests.managed-runtime-cases
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "../../tools/backends/build.mjs" buildBackends root)
  (defvar directory undefined)
  (defvar image undefined)
  (defvar preparation undefined)
  (defun eq-check (actual expected &rest messages)
    (Reflect/apply (get assert :strictEqual) assert
      (js-call (js-array actual expected) :concat messages)))
  (defun ok (value &rest messages)
    (Reflect/apply (get assert :ok) assert (js-call (js-array value) :concat messages)))
  (defasync prepareManagedRuntimeCases ()
    (unless preparation
      (setq preparation (funcall (async ()
        (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-maintained-"))))
        (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
               (original (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
               (source (+ original "\n(defun gc-named (heap code) (value-function-named heap code))"
                 "\n(defun gc-unnamed (heap code) (value-function-new heap code 0))"
                 "\n(defun gc-defragment (heap) (heap-defragment heap))"
                 "\n(defun gc-cache (heap code) (load-u32 (heap-named-cache-entry heap code)))"
                 "\n(defun gc-cache-set (heap code value) (store-u32 (heap-named-cache-entry heap code) value))"
                 "\n(export gc-named gc-unnamed gc-defragment gc-cache gc-cache-set)"))
               (program (js-call (get backend :compiler) :compile_ir_string source "managed-runtime.eli"))
               (bytes (globalThis.Uint8Array.from (js-call (get backend :wasm) :emit_memory_wasm program
                        (js-object :maximumPages 256)))))
          (eq-check (js-call source :slice 0 (js-length original)) original)
          (ok (globalThis.WebAssembly.validate bytes))
          (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
          (setq image (new globalThis.WebAssembly.Module bytes)))))))
    (await preparation))
  (defasync closeManagedRuntimeCases ()
    (setq image undefined preparation undefined)
    (when directory
      (await (rm directory (js-object :recursive t :force t)))
      (setq directory undefined)))
  (defun fresh (slots initial maximum)
    (let* ((exports (get (new globalThis.WebAssembly.Instance image) :exports)) (r (js-object)))
      (js-call (Object/entries exports) :forEach (lambda (entry)
        (let ((name (aref entry 0)) (value (aref entry 1)))
          (put r (js-call name :replaceAll "-" "_")
            (if (= (value-type value) "function")
              (lambda (&rest arguments) (uint32 (Reflect/apply value undefined arguments))) value)))))
      (let ((heap (js-call r :heap_new slots initial maximum)))
        (ok (> heap 0)) (js-object :r r :h heap))))
  (defun number (r heap value)
    (let ((view (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
      (js-call view :setFloat64 0 value t)
      (js-call r :value_number heap (js-call view :getUint32 0 t) (js-call view :getUint32 4 t))))
  (defun unbox (r heap value)
    (let ((pointer (js-call r :value_data heap value 4)))
      (ok (> pointer 0)) (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getFloat64 pointer t)))
  (defun layout (r heap)
    (let* ((view (new globalThis.DataView (get (get r :memory) :buffer)))
           (control (js-call view :getUint32 (+ heap 16) t))
           (pool (js-call view :getUint32 (+ control 4) t)))
      (js-object :view view :base (js-call view :getUint32 (+ pool 16) t)
        :maximum (js-call view :getUint32 (+ control 8) t)
        :highwater (js-call view :getUint32 (+ control 12) t))))
  (defun own (r heap values value)
    (ok (> value 3)) (eq-check (js-call r :heap_pin heap value) 1)
    (js-call values :add value) value)
  (defun counts (r heap)
    (js-array (js-call r :heap_live heap) (js-call r :heap_used heap) (js-call r :frame_depth heap)))
  (defun close-owned (r heap values frame)
    (eq-check (js-call r :frame_pop heap frame) 1)
    (js-call values :forEach (lambda (value) (eq-check (js-call r :heap_release heap value) 1)))
    (js-call r :heap_collect heap)
    (eq-check (js-call r :heap_live heap) 0) (eq-check (js-call r :frame_depth heap) 0))
  (defun collision-case ()
    (let* ((context (fresh 512 16384 262144)) (r (get context :r)) (heap (get context :h))
           (owned (new globalThis.Set)) (pin (lambda (value) (own r heap owned value)))
           (held (funcall pin (number r heap -0.0)))
           (first (funcall pin (js-call r :gc_named heap 0)))
           (collision (funcall pin (js-call r :gc_named heap 256)))
           (frame (js-call r :frame_new heap 1)))
      (ok (> frame 3)) (eq-check (js-call r :frame_set heap frame 0 held) 1)
      (try
        (progn
          (eq-check (js-call r :gc_cache heap 0) collision)
          (let ((before (counts r heap)) (repeat 0))
            (while (< repeat 16)
              (eq-check (js-call r :gc_named heap 0) first)
              (eq-check (js-call r :gc_cache heap 0) collision "a chain hit keeps its bucket head")
              (eq-check (js-call r :gc_named heap 256) collision)
              (eq-check (js-call r :gc_cache heap 0) collision)
              (setq repeat (1+ repeat)))
            (js-call assert :deepStrictEqual (counts r heap) before "hits and collision lookup do not allocate"))
          (js-call (js-array 4294967295 held collision) :forEach (lambda (candidate)
            (js-call r :gc_cache_set heap 0 candidate)
            (eq-check (js-call r :gc_named heap 0) first)
            (eq-check (js-call r :last_error) 0)))
          (let ((dead (js-call r :gc_named heap 321)))
            (ok (> dead 3)) (eq-check (js-call r :gc_cache heap 321) dead)
            (eq-check (js-call r :heap_collect heap) 1 "a weak hint cannot retain an unrooted function")
            (eq-check (js-call r :value_kind heap dead) 0) (eq-check (js-call r :last_error) 1)
            (let* ((unnamed (funcall pin (js-call r :gc_unnamed heap 321)))
                   (replacement (funcall pin (js-call r :gc_named heap 321))))
              (eq-check (bit-and unnamed 1048575) (bit-and dead 1048575))
              (js-call assert :notStrictEqual (unsigned-bit-shift-right unnamed 20) (unsigned-bit-shift-right dead 20))
              (js-call assert :notStrictEqual replacement dead) (js-call assert :notStrictEqual replacement unnamed)
              (eq-check (js-call r :value_kind heap unnamed) 18)
              (let ((before (counts r heap)))
                (js-call r :gc_cache_set heap 321 unnamed)
                (eq-check (js-call r :gc_named heap 321) replacement)
                (js-call assert :deepStrictEqual (counts r heap) before))
              (let* ((high (funcall pin (js-call r :gc_named heap 4294967295)))
                     (previous (get (layout r heap) :base))
                     (gap (funcall pin (js-call r :value_bytes heap 31)))
                     (blob (funcall pin (js-call r :value_bytes heap 30000))))
                (eq-check (js-call r :gc_named heap 4294967295) high)
                (js-call assert :notStrictEqual (get (layout r heap) :base) previous)
                (eq-check (js-call r :value_byte_set heap blob 0 17) 1)
                (eq-check (js-call r :value_byte_set heap blob 29999 239) 1)
                (eq-check (js-call r :heap_release heap gap) 1) (js-call owned :delete gap)
                (js-call r :heap_collect heap) (eq-check (js-call r :gc_defragment heap) 1)
                (js-call (js-array (js-array 0 first) (js-array 256 collision) (js-array 321 replacement)
                                  (js-array 4294967295 high)) :forEach
                  (lambda (entry) (eq-check (js-call r :gc_named heap (aref entry 0)) (aref entry 1))))
                (eq-check (js-call r :value_byte_get heap blob 0) 17)
                (eq-check (js-call r :value_byte_get heap blob 29999) 239))))
          (eq-check (js-call r :frame_get heap frame 0) held)
          (ok (Object/is (unbox r heap held) -0.0)) (eq-check (js-call r :frame_depth heap) 1)
          (eq-check (js-call r :gc_named 0 0) 0) (eq-check (js-call r :last_error) 1)
          (eq-check (js-call r :gc_named heap 0) first))
        (finally (close-owned r heap owned frame)))))
  (defun per-heap-case ()
    (let* ((context (fresh 512 16384 65536)) (r (get context :r)) (heap (get context :h))
           (peer (js-call r :heap_new 512 16384 65536))
           (first (js-call r :gc_named heap 73)))
      (ok (> peer 0)) (eq-check (js-call r :heap_pin heap first) 1)
      (let* ((prefix (number r peer -0.0)) (_prefix (js-call r :heap_pin peer prefix))
             (second (js-call r :gc_named peer 73)) (_second (js-call r :heap_pin peer second)))
        (try
          (progn
            (js-call assert :notStrictEqual first second)
            (eq-check (js-call r :gc_cache heap 73) first) (eq-check (js-call r :gc_cache peer 73) second)
            (js-call r :heap_collect heap) (js-call r :heap_collect peer)
            (eq-check (js-call r :gc_named heap 73) first) (eq-check (js-call r :gc_named peer 73) second)
            (ok (Object/is (unbox r peer prefix) -0.0)))
          (finally
            (js-call r :heap_release heap first) (js-call r :heap_release peer prefix) (js-call r :heap_release peer second)
            (js-call r :heap_collect heap) (js-call r :heap_collect peer)
            (eq-check (js-call r :heap_live heap) 0) (eq-check (js-call r :heap_live peer) 0))))
      (let* ((small (js-call r :heap_new 511 16384 65536)) (_small (ok (> small 0)))
             (state (layout r small)) (untouched (+ (get state :base) (* 511 24) 16)))
        (js-call (get state :view) :setUint32 untouched 1985229328 t)
        (let ((value (js-call r :gc_named small 255)))
          (ok (> value 3)) (js-call r :heap_pin small value)
          (eq-check (js-call r :gc_named small 255) value)
          (eq-check (js-call r :gc_cache small 255) value)
          (eq-check (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 untouched t) 1985229328)
          (js-call r :heap_release small value) (js-call r :heap_collect small)
          (eq-check (js-call r :heap_live small) 0)))
      (eq-check (js-call r :retire) 1) (eq-check (js-call r :gc_named heap 73) 0) (eq-check (js-call r :last_error) 1)
      (let ((fresh-heap (js-call r :heap_new 512 16384 65536)))
        (ok (> fresh-heap 0)) (ok (> (js-call r :gc_named fresh-heap 73) 3))
        (js-call r :heap_collect fresh-heap) (eq-check (js-call r :heap_live fresh-heap) 0))))
  (defun tail-boundary-case ()
    (let* ((context (fresh 512 65536 65536)) (r (get context :r)) (heap (get context :h))
           (owned (new globalThis.Set)) (pin (lambda (value) (own r heap owned value)))
           (first (funcall pin (js-call r :gc_named heap 0)))
           (held (funcall pin (number r heap -0.0))) (frame (js-call r :frame_new heap 1)))
      (ok (> frame 3)) (eq-check (js-call r :frame_set heap frame 0 held) 1)
      (try
        (progn
          (while (< (get (layout r heap) :highwater) 256) (funcall pin (number r heap 7)))
          (let* ((old-cell (+ (get (layout r heap) :base) (* 257 24) 16))
                 (_head (eq-check (js-call r :gc_cache heap 0) first))
                 (boundary (js-call r :gc_named heap 256)))
            (ok (> boundary 3)) (eq-check (bit-and boundary 1048575) 257)
            (eq-check (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 old-cell t) 0)
            (funcall pin boundary)
            (eq-check (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 old-cell t) 1)
            (eq-check (js-call r :gc_named heap 0) first) (eq-check (js-call r :gc_named heap 256) boundary)
            (eq-check (js-call r :gc_cache heap 0) boundary)
            (while (< (js-call r :heap_live heap) 512) (funcall pin (number r heap 7)))
            (let ((before (counts r heap)))
              (eq-check (js-call r :gc_named heap 512) 0) (eq-check (js-call r :last_error) 2)
              (js-call assert :deepStrictEqual (counts r heap) before))
            (eq-check (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 old-cell t) 1)
            (eq-check (js-call r :gc_named heap 0) first) (eq-check (js-call r :gc_named heap 256) boundary)
            (js-call r :heap_collect heap) (eq-check (js-call r :heap_live heap) 512)
            (eq-check (js-call r :frame_depth heap) 1) (ok (Object/is (unbox r heap held) -0.0))))
        (finally (close-owned r heap owned frame)))
      (let ((rebuilt (js-call r :gc_named heap 0)))
        (ok (> rebuilt 3)) (js-call assert :notStrictEqual rebuilt first)
        (eq-check (js-call r :gc_named heap 0) rebuilt)
        (js-call r :heap_collect heap) (eq-check (js-call r :heap_live heap) 0))))
  (defun free-slot-case ()
    (let* ((context (fresh 2 320 320)) (r (get context :r)) (heap (get context :h))
           (a (js-call r :value_bytes heap 80)) (b (js-call r :value_bytes heap 80)))
      (ok (and (> a 3) (> b 3))) (eq-check (js-call r :heap_pin heap b) 1)
      (eq-check (js-call r :heap_collect heap) 1) (eq-check (js-call r :heap_release heap b) 1)
      (js-call r :heap_auto heap 4294967295)
      (let ((big (js-call r :value_bytes heap 130)))
        (ok (> big 3)) (eq-check (js-call r :heap_pin heap big) 1)
        (let ((small (js-call r :value_bytes heap 8)))
          (ok (> small 3)) (eq-check (js-call r :heap_pin heap small) 1)
          (js-call assert :deepStrictEqual
            (js-call (js-array (bit-and big 1048575) (bit-and small 1048575)) :sort)
            (js-call (js-array (bit-and a 1048575) (bit-and b 1048575)) :sort))
          (js-call assert :notStrictEqual (bit-and big 1048575) (bit-and small 1048575))
          (eq-check (js-call r :heap_collections heap) 2) (eq-check (js-call r :heap_live heap) 2)
          (eq-check (js-call r :value_byte_set heap big 129 239) 1)
          (eq-check (js-call r :value_byte_set heap small 7 17) 1)
          (eq-check (js-call r :value_byte_get heap big 129) 239)
          (eq-check (js-call r :value_byte_get heap small 7) 17)
          (js-call (js-array a b) :forEach (lambda (old)
            (eq-check (js-call r :value_kind heap old) 0) (eq-check (js-call r :last_error) 1)))
          (js-call r :heap_release heap big) (js-call r :heap_release heap small)
          (js-call r :heap_collect heap) (eq-check (js-call r :heap_live heap) 0) (eq-check (js-call r :frame_depth heap) 0)))))
  (defconst managedRuntimeCases (js-object
    "weak named cache validates collisions and candidate identity without retaining values through collection or pool movement" collision-case
    "weak named caches are per heap and small heaps keep their original uncached slot-table contract" per-heap-case
    "allocating the first cache-tail entry disables lookup and writes before all slots remain usable" tail-boundary-case
    "automatic capacity retry reselects the free-slot head without losing older free slots" free-slot-case))
  (export managedRuntimeCases prepareManagedRuntimeCases closeManagedRuntimeCases))
