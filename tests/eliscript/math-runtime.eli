(module tests.math-runtime
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:child_process" spawnSync)
  (import "node:path" resolve)
  (import "node:module" createRequire)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/backends/managed-runtime.mjs" loadManagedHostModules)
  (import "node:fs/promises" readFile realpath)
  (import "../dist/bootstrap/compiler.mjs" compile-ir-string emit-ir-string)
  (import "../runtime/math.mjs" f16round sumPrecise)

  (defconst math (Reflect/get globalThis.globalThis "Math"))
  (defconst bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
  (defconst zero (funcall globalThis.BigInt 0))
  (defconst one (funcall globalThis.BigInt 1))
  (defun big (value) (funcall globalThis.BigInt value))
  (defun shl (value count) (bit-shift-left value (big count)))
  (defun shr (value count) (bit-shift-right value (big count)))
  (defun word (value) (js-call bits :setFloat64 0 value t) (js-call bits :getBigUint64 0 t))
  (defun number (value) (js-call bits :setBigUint64 0 value t) (js-call bits :getFloat64 0 t))
  (defun exact (actual expected)
    (if (Number/isNaN expected) (js-call assert :strictEqual (Number/isNaN actual) t)
      (js-call assert :strictEqual (word actual) (word expected))))
  ;; The original golden uses arbitrary-precision integer units. Production
  ;; uses bounded Number limbs instead; the oracle never calls that algorithm.
  (defun units (value)
    (let* ((raw (word value)) (exponent (funcall globalThis.Number (bit-and (shr raw 52) (big 2047))))
           (fraction (bit-and raw (- (shl one 52) one)))
           (magnitude (if (= exponent 0) fraction (shl (bit-or (shl one 52) fraction) (1- exponent)))))
      (if (= (shr raw 63) zero) magnitude (- magnitude))))
  (defun integer-even (magnitude shift)
    (if (= shift 0) magnitude
      (let* ((quotient (shr magnitude shift)) (remainder (- magnitude (shl quotient shift)))
             (half (shl one (1- shift))))
        (+ quotient (if (or (> remainder half) (and (= remainder half) (/= (bit-and quotient one) zero))) one zero)))))
  (defun from-units (value negative-zero)
    (if (= value zero) (if negative-zero -0.0 0)
      (let* ((negative (< value zero)) (sign (if negative (shl one 63) zero))
             (magnitude (if negative (- value) value)))
        (if (< magnitude (shl one 52)) (number (bit-or sign magnitude))
          (let* ((shift (Math/max 0 (- (js-length (js-call magnitude :toString 2)) 53)))
                 (significand (integer-even magnitude shift)))
            (when (= significand (shl one 53)) (setq significand (shr significand 1) shift (1+ shift)))
            (if (>= shift 2046) (if negative (- globalThis.Infinity) globalThis.Infinity)
              (number (bit-or sign (bit-or (shl (big (1+ shift)) 52) (- significand (shl one 52)))))))))))
  (defun half-model (input)
    (js-call bits :setFloat64 0 input t)
    (let ((value (js-call bits :getFloat64 0 t)))
      (if (or (not (Number/isFinite value)) (= value 0)) value
        (let* ((whole (units value)) (magnitude (if (< whole zero) (- whole) whole))
               (shift (Math/max 1050 (- (js-length (js-call magnitude :toString 2)) 11)))
               (rounded (shl (integer-even magnitude shift) shift)))
          (if (>= rounded (shl one 1090)) (if (< whole zero) (- globalThis.Infinity) globalThis.Infinity)
            (from-units (if (< whole zero) (- rounded) rounded) (< whole zero)))))))
  (defun sum-model (values)
    (let ((total zero) (minus t) (nan false) (positive false) (negative false))
      (js-call values :forEach (lambda (value)
        (setq minus (and minus (Object/is value -0.0)))
        (cond ((Number/isNaN value) (setq nan t))
          ((= value globalThis.Infinity) (setq positive t))
          ((= value (- globalThis.Infinity)) (setq negative t))
          (t (setq total (+ total (units value)))))))
      (cond ((or nan (and positive negative)) globalThis.NaN)
        (positive globalThis.Infinity) (negative (- globalThis.Infinity))
        (t (from-units total minus)))))
  (defun next-number (value up)
    (number (+ (word value) (if up one (- one)))))
  (defun random-values ()
    (let ((state 51783563) (values (js-array)) (index 0))
      (while (< index 256)
        (setq state (uint32 (+ (imul32 state 1664525) 1013904223)))
        (js-call bits :setUint32 0 state t)
        (setq state (uint32 (+ (imul32 state 1664525) 1013904223)))
        (js-call bits :setUint32 4 state t)
        (js-call values :push (js-call bits :getFloat64 0 t))
        (setq index (1+ index))) values))
  (defun check-half ()
    (let ((values (js-array 0 -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                    5e-324 -5e-324 1.7976931348623157e308 -1.7976931348623157e308
                    (Math/pow 2 -24) (Math/pow 2 -14) 65504 65536)))
      (js-call (js-array (Math/pow 2 -25) (* 3 (Math/pow 2 -25))
                  (- (Math/pow 2 -14) (Math/pow 2 -25)) (+ (Math/pow 2 -14) (Math/pow 2 -25))
                  (+ 1 (Math/pow 2 -11)) (+ 1 (* 3 (Math/pow 2 -11))) 65520)
        :forEach (lambda (midpoint)
          (js-call (js-array (next-number midpoint false) midpoint (next-number midpoint t)) :forEach
            (lambda (value) (js-call values :push value (- value))))))
      (setq values (js-call values :concat (random-values)))
      (js-call values :forEach (lambda (value)
        (exact (f16round value) (half-model value))
        (exact (Math/f16round value) (half-model value))
        (exact (globalThis.Math.f16round value) (half-model value)))))
    (js-call (js-array undefined nil false t "" "-0" "1.0004882812500002" (new globalThis.Number -0.0))
      :forEach (lambda (value) (exact (f16round value) (half-model value))))
    (js-call (js-array (big 1) (funcall globalThis.Symbol "x")) :forEach (lambda (value)
      (js-call assert :throws (lambda () (f16round value)) globalThis.TypeError)))
    (let ((marker (js-object)) (calls (js-array)) (input (js-object)))
      (put input globalThis.Symbol.toPrimitive (lambda (hint)
        (js-call calls :push hint) (exact (f16round 1.5) 1.5) (throw marker)))
      (js-call assert :throws (lambda () (f16round input)) (lambda (error) (Object/is error marker)))
      (js-call assert :deepStrictEqual calls (js-array "number"))))
  (defun check-sum ()
    (let* ((maximum 1.7976931348623157e308) (tiny 5e-324)
           (samples (js-array (js-array) (js-array -0.0) (js-array -0.0 -0.0) (js-array 0) (js-array -0.0 0)
             (js-array 1 -1) (js-array 1e16 1 -1e16) (js-array 1e16 -1e16 1)
             (js-array maximum maximum (- maximum)) (js-array (- maximum) (- maximum) maximum)
             (js-array maximum maximum (- maximum) (- maximum) tiny) (js-array maximum maximum)
             (js-array (- maximum) (- maximum)) (js-array tiny tiny (- tiny)) (js-array tiny (- tiny))
             (js-array (Math/pow 2 -1022) (- (Math/pow 2 -1022)) tiny)
             (js-array 1 (Math/pow 2 -53)) (js-array 1 (Math/pow 2 -53) tiny)
             (js-array 1 (Math/pow 2 -52) (Math/pow 2 -53))
             (js-array 1 (Math/pow 2 -52) (Math/pow 2 -53) (- tiny))
             (js-array globalThis.Infinity) (js-array (- globalThis.Infinity))
             (js-array globalThis.Infinity (- globalThis.Infinity)) (js-array globalThis.NaN)
             (js-array globalThis.NaN globalThis.Infinity)
             (js-array globalThis.Infinity maximum (- maximum)) (js-array (- globalThis.Infinity) maximum (- maximum))))
           (random (js-call (random-values) :filter Number/isFinite)) (index 0))
      (while (< index 24)
        (let ((x (aref random index)) (y (aref random (+ index 24))) (z (aref random (+ index 48))))
          (js-call samples :push (js-array x y (- x) z (- y)) (js-array (- x) (- y) x (- z) y)))
        (setq index (1+ index)))
      (js-call samples :forEach (lambda (values)
        (exact (sumPrecise values) (sum-model values))
        (exact (Math/sumPrecise values) (sum-model values)))))
    (exact (sumPrecise (js-array)) -0.0)
    (exact (sumPrecise (js-array 1e16 1 -1e16)) 1))
  (defun receiver (body)
    (new globalThis.Proxy (lambda () nil) (js-object :apply (lambda (target self args) (funcall body self args)))))
  (defun check-iterator ()
    (let ((mode 0))
      (while (< mode 30)
        (let* ((events (js-array)) (marker (js-object)) (bad (js-object))
               (values (cond ((= mode 6) (js-array (big 1))) ((= mode 7) (js-array (new globalThis.Number 1)))
                 ((= mode 19) (js-array globalThis.NaN bad)) ((= mode 20) (js-array globalThis.Infinity bad))
                 ((= mode 17) (js-array 5)) ((= mode 25) (js-array (funcall globalThis.Symbol "x")))
                 ((= mode 26) (js-array "1")) ((= mode 27) (js-array false)) ((= mode 28) (js-array nil))
                 ((= mode 29) (js-array undefined))
                 ((js-call (js-array 5 8 9 10 11 22 23) :includes mode) (js-array bad))
                 (t (js-array 1e16 1 -1e16))))
               (iterator (js-object)) (iterable (js-object)) (position 0) (actual undefined))
          (put bad :valueOf (lambda () (js-call events :push "bad.valueOf") (throw marker)))
          (put bad :toString (lambda () (js-call events :push "bad.toString") (throw marker)))
          (Object/defineProperty iterator "next" (js-object :configurable t :get (lambda ()
            (js-call events :push "next.get") (when (= mode 1) (throw marker))
            (if (= mode 21) false
              (receiver (lambda (self args)
                (js-call assert :strictEqual self iterator) (js-call assert :strictEqual (js-length args) 0)
                (js-call events :push "next.call" 0 t)
                (when (= mode 2) (throw marker)) (when (= mode 14) (throw (new globalThis.RangeError "next failure")))
                (if (= mode 15) 7
                  (let ((current position) (result (js-object)))
                    (setq position (1+ position))
                    (Object/defineProperty result "done" (js-object :get (lambda ()
                      (js-call events :push "done.get") (when (= mode 3) (throw marker))
                      (when (and (= mode 24) (= current 0))
                        (Object/defineProperty iterator "next" (js-object :configurable t :get (lambda () (throw marker)))))
                      (cond ((= mode 16) "finished") ((= mode 17) (if (= current 0) globalThis.NaN t))
                        ((= mode 18) (js-object)) (t (>= current (js-length values)))))))
                    (Object/defineProperty result "value" (js-object :get (lambda ()
                      (js-call events :push "value.get") (when (= mode 4) (throw marker)) (aref values current)))) result))))))))
          (Object/defineProperty iterator "return" (js-object :get (lambda ()
            (js-call events :push "return.get") (when (= mode 8) (throw marker))
            (cond ((= mode 10) 1) ((= mode 22) nil) ((= mode 23) undefined)
              (t (receiver (lambda (self args)
                (js-call assert :strictEqual self iterator) (js-call assert :strictEqual (js-length args) 0)
                (js-call events :push "return.call" 0 t) (when (= mode 9) (throw marker))
                (if (= mode 11) 7 (js-object)))))))))
          (Object/defineProperty iterable (get globalThis.Symbol :iterator) (js-object :get (lambda ()
            (js-call events :push "iterator.get")
            (cond ((= mode 12) nil) ((= mode 13) false)
              (t (receiver (lambda (self args)
                (js-call assert :strictEqual self iterable) (js-call assert :strictEqual (js-length args) 0)
                (js-call events :push "iterator.call" 0 t) iterator)))))))
          (try (setq actual (sumPrecise iterable))
            (catch error (setq actual (if (Object/is error marker) "marker" (get error :name)))))
          (let* ((expected (js-array "iterator.get"))
                 (bad-item (js-call (js-array 5 6 7 8 9 10 11 19 20 22 23 25 26 27 28 29) :includes mode))
                 (count (if (or (= mode 19) (= mode 20)) 2 1)) (step 0))
            (unless (or (= mode 12) (= mode 13))
              (js-call expected :push "iterator.call" 0 t "next.get")
              (unless (or (= mode 1) (= mode 21))
                (while (< step (if bad-item count (if (js-call (js-array 2 3 4 14 15 16 18) :includes mode) 1 (if (= mode 17) 2 4))))
                  (js-call expected :push "next.call" 0 t)
                  (unless (js-call (js-array 2 14 15) :includes mode)
                    (js-call expected :push "done.get")
                    (unless (or (= mode 3) (= mode 16) (= mode 18) (and (= mode 17) (= step 1)) (= step 3))
                      (js-call expected :push "value.get")))
                  (setq step (1+ step)))
                (when bad-item
                  (js-call expected :push "return.get")
                  (unless (js-call (js-array 8 10 22 23) :includes mode) (js-call expected :push "return.call" 0 t)))))
            (js-call assert :deepStrictEqual events expected (str "iterator mode " mode))
            (cond ((js-call (js-array 1 2 3 4) :includes mode) (js-call assert :strictEqual actual "marker"))
              ((= mode 14) (js-call assert :strictEqual actual "RangeError"))
              ((or bad-item (js-call (js-array 12 13 15 21) :includes mode)) (js-call assert :strictEqual actual "TypeError"))
              ((or (= mode 16) (= mode 18)) (exact actual -0.0))
              ((= mode 17) (exact actual 5)) (t (exact actual 1))))
          (exact (sumPrecise (js-array 1 2)) 3))
        (setq mode (1+ mode)))))

  (defasync check-metadata-and-mutation ()
    (js-call assert :strictEqual math globalThis.Math)
    (let ((abs (get math :abs)) (prototype (Object/getPrototypeOf math)))
      (js-call (js-array (js-array "f16round" f16round) (js-array "sumPrecise" sumPrecise)) :forEach (lambda (entry)
        (let* ((key (aref entry 0)) (method (aref entry 1)) (descriptor (Object/getOwnPropertyDescriptor math key)))
          (js-call assert :strictEqual (get math key) method)
          (js-call assert :deepStrictEqual (js-array (get descriptor :writable) (get descriptor :enumerable) (get descriptor :configurable)) (js-array t false t))
          (js-call assert :strictEqual (get method :name) key) (js-call assert :strictEqual (get method :length) 1)
          (js-call assert :deepStrictEqual (Object/getOwnPropertyDescriptor method "name")
            (js-object :value key :writable false :enumerable false :configurable t))
          (js-call assert :deepStrictEqual (Object/getOwnPropertyDescriptor method "length")
            (js-object :value 1 :writable false :enumerable false :configurable t))
          (js-call assert :strictEqual (Object/hasOwn method "prototype") false)
          (js-call assert :throws (lambda () (Reflect/construct globalThis.String (js-array) method)) globalThis.TypeError))))
      (let ((keys (js-array "f16round" "sumPrecise")) (index 0))
        (while (< index 2)
          (let* ((key (aref keys index)) (saved (Object/getOwnPropertyDescriptor math key)) (trace (js-array))
                 (method (receiver (lambda (self args) (js-call assert :strictEqual self math)
                           (js-call trace :push "call") (aref args 0))))
                 (argument (lambda () (js-call trace :push "arg")
                   (Object/defineProperty math key (js-object :value false :writable t :configurable t)) -0.0)))
            (try
              (Object/defineProperty math key (js-object :configurable t :get
                (receiver (lambda (self args) (js-call assert :strictEqual self math)
                  (js-call assert :strictEqual (js-length args) 0) (js-call trace :push "get") method))))
              (exact (if (= key "f16round") (Math/f16round (funcall argument)) (Math/sumPrecise (funcall argument))) -0.0)
              (js-call assert :deepStrictEqual trace (js-array "get" "arg" "call"))
              (js-call assert :throws (lambda ()
                (js-call math key (progn (js-call trace :push "noncallable-arg") 1))) globalThis.TypeError)
              (js-call assert :strictEqual (aref trace 3) "noncallable-arg")
              (Reflect/deleteProperty math key)
              (let* ((canonical (await (realpath (resolve root "runtime/math.mjs"))))
                     (namespace (funcall (createRequire canonical) canonical))
                     (loaded (await (loadManagedHostModules (js-object :hostModules (js-array
                       (js-object :id "same-runtime" :specifier "eliscript/runtime/math.mjs" :referrer "math-runtime.mjs"
                         :allowedExports (js-array "f16round" "sumPrecise") :namespace t)))
                       (js-object :hostModules (new globalThis.Map (js-array (js-array "same-runtime" namespace))))))))
                (js-call assert :strictEqual (js-call loaded :get "same-runtime") namespace))
              (js-call assert :strictEqual (Object/hasOwn math key) false)
              (exact (funcall (get saved :value) (if (= key "f16round") -0.0 (js-array 1 2)))
                (if (= key "f16round") -0.0 3))
              (finally (Object/defineProperty math key saved))))
          (setq index (1+ index))))
      (js-call assert :strictEqual (get math :abs) abs)
      (js-call assert :strictEqual (Object/getPrototypeOf math) prototype)))
  (defasync all-checks ()
    (check-half) (check-sum) (check-iterator) (await (check-metadata-and-mutation)))
  (if (= (get (get globalThis.process :env) :ELISCRIPT_MATH_RUNTIME_CHILD) "1")
    (js-call (all-checks) :then
      (lambda () (js-call (get globalThis.process :stdout) :write "math-runtime-complete\n"))
      (lambda (error) (js-call globalThis.console :error error) (put globalThis.process :exitCode 1)))
    (progn
      (test "production Math binary16 rounds directly from binary64 against the independent exact integer model" check-half)
      (test "production precise sum matches the original integer model across overflow cancellation ties and seeded binary64 values" check-sum)
      (test "production precise sum preserves all thirty iterator close and first-error cases" check-iterator)
      (test "production Math initialization preserves the actual namespace descriptors dynamic Get callee capture and deletion" check-metadata-and-mutation)
      (test "actual compiler emits the production Math import and the maintained runtime has no self dependency" (async ()
        (let ((sources (js-array "(defun run (x) (Math/f16round x)) (export run)"
                       "(defun run (xs) (Math/sumPrecise xs)) (export run)"
                       "(defun run () globalThis.Math) (export run)")))
          (js-call sources :forEach (lambda (source)
            (js-call assert :ok (js-call (emit-ir-string (compile-ir-string source "math-user.eli")) :includes
              "import \"eliscript/runtime/math.mjs\";")))))
        (let* ((source (await (readFile (resolve root "runtime/math.eli") "utf8")))
               (javascript (emit-ir-string (compile-ir-string source "runtime/math.eli"))))
          (js-call assert :strictEqual (js-call javascript :includes "import \"eliscript/runtime/math.mjs\";") false))))
      (test "independent Bun executes the same maintained Math runtime and complete original semantic checks" (lambda ()
        (let* ((environment (Object/assign (js-object) (get globalThis.process :env) (js-object :ELISCRIPT_MATH_RUNTIME_CHILD "1")))
               (child (spawnSync "bun" (js-array (resolve root "tests/math-runtime-selfhosted.test.mjs"))
                        (js-object :cwd root :env environment :stdio (js-array "ignore" "pipe" "pipe") :encoding "utf8"))))
          (js-call assert :strictEqual (get child :error) undefined)
          (js-call assert :strictEqual (get child :signal) nil)
          (js-call assert :strictEqual (get child :status) 0 (get child :stderr))
          (js-call assert :strictEqual (get child :stdout) "math-runtime-complete\n"))))))
)
