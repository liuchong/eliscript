(module tests.compiler-cli-corpus
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/backends/compiler-corpus-cli-adapters.mjs" addOriginalCLIPrograms addOriginalWorkerProgram)
  (import "../tools/backends/compiler-corpus-cli-adapters-legacy.mjs" :as legacy)
  (import "../tools/backends/compiler-corpus-managed-cases.mjs" originalSourceCaseLocators)

  (defun hash (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defconst generation-suite "tests/bootstrap-compiler.test.mjs")
  (defconst generation-archive "tests/bootstrap-compiler-test-legacy.mjs")
  (defconst generation-eli "tests/eliscript/bootstrap-compiler.eli")
  (defasync generation-services ()
    (let* ((service (await (services))) (options (get service :options)))
      (put options :locators (js-array (js-object :file generation-suite
        :id "original-js-bootstrap-generations" :contains "portable compiler driver reaches a reproducible fixed point")))
      service))
  (defun legacy-generation-carrier (options)
    ;; Historical transport receives the actual archive, never today's
    ;; generated canonical bytes represented as if they were the old body.
    (let ((text (get options :text)) (file (get options :file)))
      (Object/assign (js-object) options (js-object
        :text (async (filename) (await (funcall text (if (= filename generation-suite) generation-archive filename))))
        :file (async (filename) (await (funcall file (if (= filename generation-suite) generation-archive filename))))))))

  (test "CLI generation replay retains authentic archived assertions and binds the maintained and actual generated gates separately"
    (async ()
      (let* ((service (await (generation-services))) (options (get service :options))
             (baseline (js-array))
             (old-options (legacy-generation-carrier (Object/assign (js-object) options
               (js-object :add (lambda (record) (js-call baseline :push record))))))
             (mapped (await (addOriginalCLIPrograms options)))
             (old-mapped (await (js-call legacy :addOriginalCLIPrograms old-options)))
             (record (aref (get service :records) 0)) (old-record (aref baseline 0))
             (original (get record :original))
             (source (await (readFile (resolve root generation-archive) "utf8")))
             (maintained (await (readFile (resolve root generation-eli) "utf8")))
             (generated (await (readFile (resolve root generation-suite) "utf8")))
             (region (js-object :start 0 :end (js-length source) :byteStart 0
               :byteEnd (js-length (globalThis.Buffer.from source)) :sha256 (hash source)))
             (asset-files (js-array generation-archive generation-eli generation-suite))
             (assets (js-array)) (index 0))
        (while (< index (js-length asset-files))
          (let ((filename (aref asset-files index)))
            (js-call assets :push (js-object :file filename
              :sourceSha256 (hash (await (readFile (resolve root filename)))))))
          (setq index (1+ index)))
        (js-call assert :deepStrictEqual mapped (js-array generation-suite))
        (js-call assert :deepStrictEqual mapped old-mapped)
        (js-call assert :strictEqual (js-length (get service :records)) 1)
        (js-call assert :strictEqual (get record :id) "original-program:compiler-cli-bootstrap-generations")
        (js-call assert :deepStrictEqual (get record :coverage) (js-array "original-js-bootstrap-generations"))
        (js-call assert :strictEqual (get original :suite) generation-suite)
        (js-call assert :strictEqual (get original :fixture) generation-suite)
        (js-call assert :strictEqual (get original :host) generation-suite)
        (js-call assert :strictEqual (get original :sourceSha256) (hash source))
        (js-call assert :deepStrictEqual (get original :regions)
          (js-array (Object/assign (js-object) region (js-object :sourceFile generation-archive))))
        (js-call assert :deepStrictEqual (get original :assertionSource)
          (js-object :file generation-archive :sourceSha256 (hash source)
            :bytes (js-length (globalThis.Buffer.from source)) :regions (js-array region)))
        (js-call assert :deepStrictEqual (get original :sourceAssets) assets)
        (js-call assert :deepStrictEqual (get original :maintainedGate)
          (js-object :kind "maintained-eli-original-js-bootstrap-gate"
            :logicalSuite generation-suite :sourceFile generation-eli :sourceSha256 (hash maintained)
            :generatedFile generation-suite :generatedSha256 (hash generated)
            :finalGate "make test" :originalTimeoutMs 30000))
        (let* ((cases (originalSourceCaseLocators generation-suite source))
               (expected (Object/assign (js-object) (get (aref cases 0) :originalCase)
                 (js-object :id "original-js-bootstrap-generations" :sourceFile generation-archive))))
          (js-call assert :strictEqual (js-length cases) 1)
          (js-call assert :strictEqual (get expected :timeoutMs) 30000)
          (js-call assert :strictEqual (get expected :title) "portable compiler driver reaches a reproducible fixed point")
          (js-call assert :deepStrictEqual (get original :cases) (js-array expected)))
        ;; The entire historical transport/body/13 modules/oracle/IDs survive;
        ;; only the separately explicit, authenticated provenance is new.
        (let ((restored (globalThis.structuredClone record)))
          (js-call (js-array "assertionSource" "sourceAssets" "maintainedGate" "cases") :forEach
            (lambda (key) (Reflect/deleteProperty (get restored :original) key)))
          (put (get restored :original) :regions (get (get old-record :original) :regions))
          (js-call assert :deepStrictEqual restored old-record)))))

  (test "CLI generation provenance refuses missing mismatched and mislabeled physical source assets before publishing"
    (async ()
      (let ((files (js-array generation-archive generation-eli generation-suite)) (index 0))
        (while (< index (js-length files))
          (let* ((filename (aref files index)) (service (await (generation-services)))
                 (options (get service :options)) (original-file (get options :file)))
            (put options :file (async (path)
              (let ((asset (await (funcall original-file path))))
                (if (= path filename) (Object/assign (js-object) asset
                  (js-object :sha256 (js-call "0" :repeat 64))) asset))))
            (await (js-call assert :rejects (addOriginalCLIPrograms options)
              (lambda (error) (and (= (get error :name) "TypeError")
                (js-call (get error :message) :includes "original CLI generation source asset")))))
            (js-call assert :strictEqual (js-length (get service :records)) 0))
          (setq index (1+ index))))
      (let* ((service (await (generation-services))) (options (get service :options))
             (original-file (get options :file)))
        (put options :file (async (path)
          (let ((asset (await (funcall original-file path))))
            (if (= path generation-archive) (Object/assign (js-object) asset (js-object :file generation-suite)) asset))))
        (await (js-call assert :rejects (addOriginalCLIPrograms options)
          (lambda (error) (js-call (get error :message) :includes "original CLI generation source asset"))))
        (js-call assert :strictEqual (js-length (get service :records)) 0))
      (let* ((service (await (generation-services))) (options (get service :options))
             (original-text (get options :text)) (missing (new globalThis.Error "archive read failed")))
        (put options :text (async (path)
          (if (= path generation-archive) (throw missing) (await (funcall original-text path)))))
        (await (js-call assert :rejects (addOriginalCLIPrograms options) (lambda (error) (eq error missing))))
        (js-call assert :strictEqual (js-length (get service :records)) 0))
      (let* ((service (await (generation-services))) (options (get service :options)))
        (put (aref (get options :locators) 0) :contains "unrepresented original assertion")
        (await (js-call assert :rejects (addOriginalCLIPrograms options)
          (lambda (error) (js-call (get error :message) :includes "coverage locator"))))
        (js-call assert :strictEqual (js-length (get service :records)) 0))))
  (defasync services (&optional change-source)
    (let* ((manifest (JSON/parse (await (readFile (resolve root "contracts/compiler-parity-corpus.json") "utf8"))))
           (records (js-array))
           (options (js-object :sourceRoot root :bootstrapSources (get manifest :bootstrapSources)
             :locators (js-array (js-object :file "tests/cli-test.sh" :id "original-cli-shell"
               :contains "set -eu"))
             :text (async (filename)
               (let ((source (await (readFile (resolve root filename) "utf8"))))
                 (if (and (= filename "tests/cli-test.sh") (= (value-type change-source) "function"))
                   (funcall change-source source) source)))
             :file (async (filename)
               (let ((bytes (await (readFile (resolve root filename)))))
                 (js-object :file filename :sha256 (hash bytes) :bytes (js-length bytes))))
             :add (lambda (record) (js-call records :push record)))))
      (js-object :records records :options options)))

  (test "CLI replay retains the complete shell stdout source identity Seed oracle and unchanged original recipe"
    (async ()
      (let* ((service (await (services))) (options (get service :options))
             (legacy-records (js-array))
             (legacy-options (Object/assign (js-object) options
               (js-object :add (lambda (record) (js-call legacy-records :push record)))))
             (mapped (await (addOriginalCLIPrograms options)))
             (old-mapped (await (js-call legacy :addOriginalCLIPrograms legacy-options)))
             (record (aref (get service :records) 0)) (old-record (aref legacy-records 0))
             (expected "CLI and Bun execution test passed\nPublic Seed RAM bytecode and unchanged small-input path passed\n"))
        (js-call assert :deepStrictEqual mapped old-mapped)
        (js-call assert :strictEqual (js-length (get service :records)) 1)
        (js-call assert :strictEqual (get record :id) "original-program:compiler-cli-shell")
        (js-call assert :deepStrictEqual (get record :coverage) (js-array "original-cli-shell"))
        (js-call assert :strictEqual (get (get record :expected) :kind) "seed-program")
        (js-call assert :strictEqual (get (get record :expected) :oracleRequired) t)
        (js-call assert :strictEqual (get (get record :expected) :stdout) expected)
        (js-call assert :strictEqual (get (get old-record :expected) :stdout) "CLI and Bun execution test passed\n")
        (put old-record :expected (get record :expected))
        (js-call assert :deepStrictEqual record old-record)
        (js-call assert :strictEqual addOriginalWorkerProgram (get legacy :addOriginalWorkerProgram)))))

  (test "CLI replay refuses missing duplicated reordered and unbound original success statements before publishing"
    (async ()
      (let* ((first "printf 'CLI and Bun execution test passed\\n'")
            (second "console.log(\"Public Seed RAM bytecode and unchanged small-input path passed\");")
            (changes (js-array
              (lambda (source) (js-call source :replace second ""))
              (lambda (source) (+ source "\n" second "\n"))
              (lambda (source) (+ second "\n" (js-call source :replace second "")))
              (lambda (source) (js-call source :replace first "printf 'different\\n'")))))
        (let ((index 0))
          (while (< index (js-length changes))
            (let* ((service (await (services (aref changes index))))
                   (failure undefined) (failed false))
              (try (await (addOriginalCLIPrograms (get service :options)))
                (catch error (setq failed t failure error)))
              (js-call assert :strictEqual failed t)
              (js-call assert :strictEqual (get failure :name) "TypeError")
              (js-call assert :match (get failure :message) (new globalThis.RegExp "original shell CLI"))
              (js-call assert :strictEqual (js-length (get service :records)) 0))
            (setq index (1+ index))))))))
