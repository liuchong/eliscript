          (setq index (1+ index))))) 60000)

  (test "FIX29 original standard-main observes the same Seed protocol graph in both Node and Bun"
    (async ()
      (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot root))))
             (libraries (await (loadLiteralSources (js-object :sourceRoot root))))
             (identities (js-call libraries :map (lambda (library)
               (js-object :id (get library :id) :filename (get library :filename)
                 :sha256 (js-call (js-call (createHash "sha256") :update (get library :source) "utf16le") :digest "hex")))))
             (engines (js-array "node" "bun")) (index 0))
        (while (< index (js-length engines))
          (let* ((engine (aref engines index))
                 (id (str "original-managed:sequence-data-standard-identities:" engine ":auto-65536"))
                 (record (js-call (get corpus :records) :find (lambda (item) (= (get item :id) id))))
                 (before (JSON/stringify record))
                 (run (provider-oracle (js-object :options (js-object
                         :sourceAssets (get (get corpus :document) :evidence)
                         :literalSources libraries :literalSourceIdentity identities))
                        (resolve directory (str "actual-standard-main-" engine)))))
            (js-call assert :ok record)
            ;; This executes the authenticated maintained observer from the
            ;; actual record, not the reduced vector/queue transport fixture.
            (let ((actual (await (funcall run (js-object :record record :target "javascript")))))
              (js-call assert :strictEqual (get actual :stdout) "standard identities preserved\n"))
            (js-call assert :strictEqual (JSON/stringify record) before))
          (setq index (1+ index))))))

)
