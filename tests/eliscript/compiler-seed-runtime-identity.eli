(module tests.compiler-seed-runtime-identity
  (import "../tools/backends/compiler-matrix.mjs" loadCompilerMatrixCorpus)
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile readdir lstat realpath rm mkdir)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "../dist/bootstrap/compiler.mjs" compile-string)
  (import "../tools/backends/build.mjs" root loadLiteralSources)
  (import "../tools/backends/compiler-corpus-process.mjs" readOriginalCorpusExecutionContext)
  (import "../tools/backends/compiler-corpus-execution.mjs" createOriginalSeedOracle executeCompilerCorpusRecord)
  (import "../tools/backends/compiler-corpus-source-archive.mjs"
    archiveCompilerCorpusSources readArchivedCompilerCorpusSources)

  (import "../tools/backends/compiler-corpus.mjs" createOriginalCorpusSourceReader)
  (import "../tools/backends/compiler-corpus-process.mjs" readOriginalProcessHostDependency bindOriginalProcessHostDependency)

  (defvar directory undefined)
  (defvar providers undefined)
  (defvar assets undefined)
  (defconst maintained-source "tests/eliscript/compiler-seed-runtime-identity.eli")
  (defconst program-source
    "(module seed.identity (defconst vector-value [1 2 3]) (defconst queue-value #queue [1 2]) (export vector-value queue-value))")
  (defconst host-source
    (js-call (js-array
      "(module seed.identity.host"
      " (import \"node:assert/strict\" :default assert)"
      " (import \"../entry.mjs\" :as emitted)"
      " (import \"../runtime/core/vector.mjs\" PersistentVector)"
      " (import \"../runtime/core/queue.mjs\" PersistentQueue)"
      " (import \"../runtime/core/collection.mjs\" IReduce reduce)"
      " (import \"../runtime/core/collection-internals.mjs\" COLLECTION_REDUCE)"
      " (import \"../runtime/core/data-text.mjs\" IPrint printValue)"
      " (import \"eliscript/runtime/core/vector.mjs\" :as BareVector)"
      " (import \"eliscript/runtime/core/queue.mjs\" :as BareQueue)"
      " (import \"eliscript/runtime/core/collection.mjs\" :as BareCollection)"
      " (import \"eliscript/runtime/core/collection-internals.mjs\" :as BareInternals)"
      " (import \"eliscript/runtime/core/data-text.mjs\" :as BareText)"
      " (import \"eliscript/runtime/literals\" :as ShortLiteral)"
      " (import \"eliscript/runtime/literals.mjs\" :as FullLiteral)"
      " (js-call assert :strictEqual PersistentVector (get BareVector :PersistentVector))"
      " (js-call assert :strictEqual PersistentQueue (get BareQueue :PersistentQueue))"
      " (js-call assert :strictEqual IReduce (get BareCollection :IReduce))"
      " (js-call assert :strictEqual COLLECTION_REDUCE (get BareInternals :COLLECTION_REDUCE))"
      " (js-call assert :strictEqual IPrint (get BareText :IPrint))"
      " (js-call assert :strictEqual (get ShortLiteral :queue) (get FullLiteral :queue))"
      " (js-call assert :strictEqual (get ShortLiteral :vector) (get FullLiteral :vector))"
      " (js-call assert :strictEqual (Object/getPrototypeOf (get emitted :vector_value)) (get PersistentVector :prototype))"
      " (js-call assert :strictEqual (Object/getPrototypeOf (get emitted :queue_value)) (get PersistentQueue :prototype))"
      " (js-call assert :strictEqual (Reflect/has (get emitted :vector_value) COLLECTION_REDUCE) t)"
      " (js-call assert :strictEqual (reduce (get emitted :vector_value) (lambda (sum value) (+ sum value)) 0) 6)"
      " (js-call assert :strictEqual (printValue (get emitted :queue_value)) \"#queue [1 2]\")"
      " (js-call assert :strictEqual (js-call BareText :printValue (js-call FullLiteral :queue 1 2)) \"#queue [1 2]\")"
      " (js-call (get globalThis.process :stdout) :write \"runtime identity verified\\n\"))") :join "\n"))

  (defun digest (bytes)
    (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defasync runtime-assets (path prefix)
    (let ((entries (await (readdir path (js-object :withFileTypes t)))) (result (js-array)) (index 0))
      (js-call entries :sort (lambda (left right) (js-call (get left :name) :localeCompare (get right :name))))
      (while (< index (js-length entries))
        (let* ((entry (aref entries index)) (name (get entry :name)) (id (str prefix "/" name)))
          (cond
            ((js-call entry :isDirectory)
              (setq result (js-call result :concat (await (runtime-assets (resolve path name) id)))))
            ((and (js-call entry :isFile) (js-call name :endsWith ".mjs"))
              (let ((bytes (await (readFile (resolve path name)))))
                (js-call result :push (js-object :id id :filename id
                  :source (js-call bytes :toString "utf8") :bytes (js-length bytes) :sha256 (digest bytes)))))))
        (setq index (1+ index))) result))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-seed-runtime-identity-"))))
    (setq providers (await (runtime-assets (resolve root "runtime") "runtime")))
    (setq assets (js-call providers :map (lambda (item)
      (js-object :file (get item :filename) :bytes (get item :bytes) :sha256 (get item :sha256)))))
    (let ((bytes (await (readFile (resolve root maintained-source)))))
      (js-call assets :push (js-object :file maintained-source :bytes (js-length bytes) :sha256 (digest bytes))))) 30000)
  (afterAll (async ()
    (setq providers undefined assets undefined)
    (when directory (await (rm directory (js-object :recursive t :force t))))))

  (defun recipe (id)
    (js-object :id id :kind "project" :entry "entry.mjs" :coverage (js-array id)
      :modules (js-array (js-object :id "entry.mjs" :filename "seed-identity.eli" :source program-source))
      :request (js-object :operation "project" :hostSources (js-call providers :map (lambda (item)
        (js-object :id (get item :id) :filename (get item :filename) :source (get item :source)))))
      :original (js-object :sourceAssets (js-call assets :map (lambda (item) (Object/assign (js-object) item))))
      :execution (js-object :kind "original-program" :host "tests/seed-identity-host.mjs"
        :hostSource (compile-string host-source "seed-identity-host.eli") :hostRuntime "node" :timeoutMs 10000
        :arguments (js-array))
      :expected (js-object :kind "seed-program" :oracleRequired t :stdout "runtime identity verified\n")))

  (defun oracle (path)
    (let ((node (get (get globalThis.process :env) :NODE_BINARY)))
      (createOriginalSeedOracle (js-object :sourceRoot root :directory path
        :node (if (nullish? node) "node" node) :programHost "node"))))

  (test "the original host executor derives evidence from its artifact when the caller supplies no context directory"
    (async ()
      (let* ((product (resolve directory "implicit-execution-directory"))
             (entry (resolve product "entry.mjs"))
             (payload (js-call "完整原始source/map/alias😀" :repeat 131072))
             (settings (js-object :sourceAssets (js-array (js-object :source payload :map payload)) :aliases (js-object :original payload)))
             (record (js-object :id "original-arguments-without-context-directory" :request (js-object :hostSources (js-array))
               :execution (js-object :kind "original-program" :host "original-host.mjs"
                 :hostSource (compile-string
                   "(import \"node:path\" resolve)(import \"node:module\" createRequire)(defconst args (js-call (get globalThis.process :argv) :slice 2))(defconst path (resolve (aref args 0) \"entry.mjs\"))(defconst entry (funcall (createRequire path) path))(console/log (JSON/stringify (js-array (aref args 1) (aref args 2) (get entry :value))))"
                   "original-argument-host.eli")
                 :arguments (js-array (js-object :directory t) (js-object :literal "vector") (js-object :literal "1000000")))))
             (artifact (js-object :target "javascript" :entry "entry.mjs" :path entry :directory product
               :modules (js-array (js-object :id "entry.mjs")))))
        (await (mkdir product (js-object :recursive t)))
        (await (writeFile entry (compile-string "(module original.arguments (defconst value 42)(export value))" "arguments.eli")))
        (let ((result (await (executeCompilerCorpusRecord (js-object :record record :artifact artifact
                 :target "javascript" :sourceRoot root :options settings)))))
          (js-call assert :deepStrictEqual result
            (js-object :kind "original-program" :stdout "[\"vector\",\"1000000\",42]\n"))
          (let* ((receipt (JSON/parse (await (readFile (resolve product "original-process/process-outcome.json") "utf8"))))
                 (reference (JSON/stringify (get receipt :executionContext)))
                 (transferred (readOriginalCorpusExecutionContext reference)))
            (js-call assert :strictEqual (get receipt :status) "passed")
            (js-call assert :ok (< (Buffer/byteLength reference) 2048))
            (js-call assert :strictEqual (get (aref (get (get transferred :options) :sourceAssets) 0) :source) payload)
            (js-call assert :strictEqual (get (aref (get (get transferred :options) :sourceAssets) 0) :map) payload)
            (js-call assert :strictEqual (get (get (get transferred :options) :aliases) :original) payload))))))

  (test "independent Seed program literals and relative runtime share exact constructors symbols prototypes and registered protocols"
    (async ()
      (let* ((record (recipe "seed-runtime-exact-identities")) (before (JSON/stringify record))
             (output (resolve directory "complete-oracle")) (run (oracle output))
             (first (await (funcall run (js-object :record record :target "javascript"))))
             (second (await (funcall run (js-object :record record :target "javascript")))))
        (js-call assert :deepStrictEqual first (js-object :kind "original-program" :stdout "runtime identity verified\n"))
        (js-call assert :strictEqual second first)
        (js-call assert :strictEqual (JSON/stringify record) before)
        (let ((sources (get (get record :request) :hostSources)) (bound (get (get record :original) :sourceAssets)))
          (js-call assert :strictEqual (js-length sources) (js-length providers))
          (js-call sources :forEach (lambda (source)
            (let* ((asset (js-call bound :find (lambda (item) (= (get item :file) (get source :filename)))))
                   (bytes (js-call Buffer :from (get source :source) "utf8")))
              (js-call assert :ok asset)
              (js-call assert :strictEqual (get asset :sha256) (digest bytes))
              (js-call assert :strictEqual (get asset :bytes) (js-length bytes))))))
        (let* ((path (resolve directory "complete-archive"))
               (identity (await (archiveCompilerCorpusSources record path)))
               (restored (await (readArchivedCompilerCorpusSources path (js-object :expectedIdentity (get identity :sha256))))))
          (js-call assert :deepStrictEqual restored record)))) 60000)

  (test "independent Seed oracle does not invent missing runtime source declarations or mutate the retained recipe"
    (async ()
      (let* ((record (recipe "seed-runtime-missing-queue"))
             (sources (get (get record :request) :hostSources)))
        (put (get record :request) :hostSources (js-call sources :filter (lambda (item)
          (not (= (get item :id) "runtime/core/queue.mjs")))))
        (let* ((before (JSON/stringify record)) (run (oracle (resolve directory "missing-oracle"))))
          (await (js-call assert :rejects (funcall run (js-object :record record :target "javascript"))))
          (js-call assert :strictEqual (JSON/stringify record) before)))) 60000)

  (test "independent Seed local runtime refuses an emitted module conflicting with authentic declared runtime bytes"
    (async ()
      (let ((record (recipe "seed-runtime-conflicting-vector")))
        (js-call (get record :modules) :push (js-object :id "runtime/core/vector.mjs"
          :filename "conflicting-vector.eli" :source "(defconst incompatible 1) (export incompatible)"))
        (let* ((before (JSON/stringify record)) (run (oracle (resolve directory "conflicting-oracle"))))
          (await (js-call assert :rejects (funcall run (js-object :record record :target "javascript"))
            (lambda (error) (= (get error :message) "original local runtime graph conflicts with emitted source"))))
          (js-call assert :strictEqual (JSON/stringify record) before)))) 60000)

  (test "the complete Seed runtime recipe archive rejects changed hostSource bytes under its original identity"
    (async ()
      (let* ((record (recipe "seed-runtime-archive-tamper")) (path (resolve directory "tamper-archive"))
             (identity (await (archiveCompilerCorpusSources record path)))
             (stored (resolve path "record.json")) (bytes (await (readFile stored "utf8"))))
        (js-call assert :ok (js-call bytes :includes "runtime identity verified"))
        (await (writeFile stored (js-call bytes :replace "runtime identity verified" "runtime identity modified")))
        (await (js-call assert :rejects
          (readArchivedCompilerCorpusSources path (js-object :expectedIdentity (get identity :sha256)))
          (lambda (error) (= (get error :message) "original source case recipe bytes changed")))))))

  (test "the Seed program reference installs all real declared runtime files before preparing its independent reference"
    (async ()
      (let* ((record (recipe "seed-runtime-complete-independent-reference"))
             (output (resolve directory "complete-reference")) (run (oracle output)))
        (put (get record :execution) :referenceArtifact t)
        (let* ((before (JSON/stringify record))
               (actual (await (funcall run (js-object :record record :target "javascript")))))
          (js-call assert :strictEqual (get actual :stdout) "runtime identity verified\n")
          (js-call assert :strictEqual (js-length (get actual :supportingProducts)) 1)
          (js-call assert :strictEqual (get (aref (get actual :supportingProducts) 0) :producer) "emacs-seed")
          (js-call assert :strictEqual (JSON/stringify record) before)))) 60000)

  (test "Seed source projects resolve actual eli dependency exports for loader-free Node and Bun children"
    (async ()
      (let* ((record (recipe "seed-runtime-source-project-imports"))
             (child (compile-string
               "(import \"../data.mjs\" value) (import \"node:assert/strict\" :default assert) (js-call assert :strictEqual (value) 42) (console/log \"resolved real exports\")"
               "source-project-child.eli"))
             (host (compile-string (js-call (js-array
               "(import \"node:assert/strict\" :default assert) (import \"node:child_process\" spawnSync)"
               "(import \"node:path\" resolve dirname)"
               "(defconst child (resolve (dirname (aref (get globalThis.process :argv) 1)) \"source-project-child.mjs\"))"
               "(defconst env (get globalThis.process :env))"
               "(defconst engines (js-array (if (nullish? (get env :NODE_BINARY)) \"node\" (get env :NODE_BINARY)) (if (nullish? (get env :BUN)) \"bun\" (get env :BUN))))"
               "(js-call engines :forEach (lambda (engine)"
               " (let ((result (spawnSync engine (js-array child) (js-object :encoding \"utf8\" :timeout 10000))))"
               "  (js-call assert :strictEqual (get result :error) undefined)"
               "  (js-call assert :strictEqual (get result :signal) nil (get result :stderr))"
               "  (js-call assert :strictEqual (get result :status) 0 (get result :stderr))"
               "  (js-call assert :strictEqual (get result :stdout) \"resolved real exports\\n\"))))") :join "\n") "source-project-host.eli")))
        (put record :entry "data.mjs")
        (put record :modules (js-array
          (js-object :id "object.mjs" :filename "stdlib/object.eli"
            :source "(defportable assoc (value) (+ value 1)) (export assoc)")
          (js-object :id "data.mjs" :filename "stdlib/data.eli"
            :source "(import-portable \"./object.eli\" assoc) (defun value () (assoc 41)) (export value)")))
        (put (get record :request) :resolveImports t)
        (js-call (get (get record :request) :hostSources) :push
          (js-object :id "tests/source-project-child.mjs" :filename "source-project-child.eli" :source child))
        (put (get record :execution) :hostSource host)
        (let* ((before (JSON/stringify record)) (run (oracle (resolve directory "source-project-oracle")))
               (actual (await (funcall run (js-object :record record :target "javascript")))))
          (js-call assert :strictEqual (get actual :stdout) "")
          (js-call assert :strictEqual (JSON/stringify record) before)))) 60000)

  (defasync stdlib-inputs (path prefix)
    (let ((entries (await (readdir path (js-object :withFileTypes t)))) (modules (js-array)) (index 0))
      (js-call entries :sort (lambda (left right) (js-call (get left :name) :localeCompare (get right :name))))
      (while (< index (js-length entries))
        (let* ((entry (aref entries index)) (name (get entry :name))
               (id (if (= prefix "") name (str prefix "/" name))))
          (cond ((js-call entry :isDirectory)
                  (setq modules (js-call modules :concat (await (stdlib-inputs (resolve path name) id)))))
                ((and (js-call entry :isFile) (js-call name :endsWith ".eli"))
                  (js-call modules :push (js-object :id (str (js-call id :slice 0 -4) ".mjs")
                    :filename (str "stdlib/" id) :source (await (readFile (resolve path name) "utf8")))))))
        (setq index (1+ index))) modules))

  (test "Seed program portable pruning retains the original numeric JSON and result source goldens"
    (async ()
      (let ((modules (await (stdlib-inputs (resolve root "stdlib") "")))
            (cases (js-array
              (js-array "numeric" "gcd" (js-array "function gcd(" "function rem(" "function safe_integer_QMARK_(") "function lcm(")
              (js-array "json" "parse-json" (js-array "function parse_json(") "function stringify_json(")
              (js-array "result" "unwrap-or" (js-array "function unwrap_or(" "function ok_QMARK_(") "function collect_results(")))
            (index 0))
        (while (< index (js-length cases))
          (let* ((item (aref cases index)) (name (aref item 0))
                 (record (recipe (str "seed-portable-" name)))
                 (forms (js-array "(import \"node:assert/strict\" :default assert)"
                                  "(import \"node:fs\" readFileSync)" "(import \"node:path\" resolve)"
                   (str "(defconst text (readFileSync (resolve (get (get globalThis.process :env) :ELISCRIPT_ORIGINAL_JAVASCRIPT_PRODUCT_ROOT) "
                     (JSON/stringify (str name ".mjs")) ") \"utf8\"))"))))
            (js-call (aref item 2) :forEach (lambda (text)
              (js-call forms :push (str "(js-call assert :ok (js-call text :includes " (JSON/stringify text) "))"))))
            (js-call forms :push (str "(js-call assert :strictEqual (js-call text :includes "
              (JSON/stringify (aref item 3)) ") false)"))
            (put record :modules modules) (put record :entry (str name ".mjs"))
            (put (get record :request) :resolveImports t)
            (put (get record :request) :portableEntries (js-array (aref item 1)))
            (put (get record :execution) :hostSource
              (compile-string (js-call forms :join "\n") (str "portable-" name "-host.eli")))
            (let* ((before (JSON/stringify record)) (run (oracle (resolve directory (str "portable-oracle-" name))))
                   (actual (await (funcall run (js-object :record record :target "javascript")))))
              (js-call assert :strictEqual (get actual :stdout) "")
              (js-call assert :strictEqual (JSON/stringify record) before)))
          (setq index (1+ index))))) 120000)

  (test "Seed oracle uses the same maintained physical-file identity host capability as the selected product"
    (async ()
      (let* ((record (recipe "seed-physical-identity-host"))
             (fixture "tests/fixtures/wasm-managed-host-identity.eli")
             (host-file "tools/backends/compiler-corpus-identity-host.mjs")
             (host-eli "tools/backends/eliscript/compiler-corpus-identity-host.eli"))
        (put record :modules (js-array (js-object :id "main.mjs" :filename "host-identity.eli"
          :source (await (readFile (resolve root fixture) "utf8")))))
        (put record :entry "main.mjs")
        (put (get record :execution) :referenceArtifact t)
        (put (get record :execution) :host "tests/renamed-physical-identity-host.mjs")
        (put (get record :execution) :hostRuntime "bun")
        (put (get record :execution) :arguments (js-array (js-object :directory t) (js-object :literal "main.mjs")))
        (put (get record :execution) :hostSource
          (compile-string "(throw (new globalThis.Error \"legacy host must not replace explicit JavaScript capability\"))" "old-host.eli"))
        (put (get record :execution) :javascriptHostSource (await (readFile (resolve root host-file) "utf8")))
        (let ((files (js-array fixture host-file host-eli)) (index 0))
          (while (< index (js-length files))
            (let* ((file (aref files index)) (bytes (await (readFile (resolve root file)))))
              (js-call (get (get record :original) :sourceAssets) :push
                (js-object :file file :sourceSha256 (digest bytes))))
            (setq index (1+ index))))
        (let* ((reader (createOriginalCorpusSourceReader (js-object :sourceRoot root)))
               (dependency (await (readOriginalProcessHostDependency reader)))
               (bound (bindOriginalProcessHostDependency record dependency))
               (engines (js-array "node" "bun")) (index 0))
          (while (< index (js-length engines))
            (let* ((engine (aref engines index)) (selected (globalThis.structuredClone bound)))
              (put (get selected :execution) :hostRuntime engine)
              (let* ((before (JSON/stringify selected)) (run (oracle (resolve directory (str "physical-identity-oracle-" engine))))
                     (actual (await (funcall run (js-object :record selected :target "javascript")))))
                (js-call assert :deepStrictEqual (JSON/parse (get actual :stdout))
                  (js-object :tokens (js-array 1 1 1 2) :effects (js-array t (js-array 1 2))
                    :abrupt (js-array t (js-array 1)) :conversion (js-array) :symbols (js-array t t) :functions (js-array t t)))
                (js-call assert :strictEqual (JSON/stringify selected) before)))
            (setq index (1+ index)))))) 120000)
  (defun seed-provider-fixture (id)
    (let* ((record (recipe id))
           (replacement (js-object :id "managed-runtime-identifier.mjs"
             :filename "stdlib/managed-runtime-identifier.eli"
             :source "(module seed.shadow (defconst shadow-value 17) (export shadow-value))"))
           (libraries (js-array replacement))
           (proofs (js-call providers :map (lambda (item)
             (let ((bytes (js-call Buffer :from (get item :source) "utf8")))
               (js-object :file (get item :filename) :encoding "base64"
                 :content (js-call bytes :toString "base64") :bytes (js-length bytes) :sha256 (digest bytes))))))
           (bytes (js-call Buffer :from (get replacement :source) "utf8")))
      (js-call proofs :push (js-object :file (get replacement :filename) :encoding "base64"
        :content (js-call bytes :toString "base64") :bytes (js-length bytes) :sha256 (digest bytes)))
      (js-call (get record :modules) :push (Object/assign (js-object) replacement))
      (put (get record :request) :resolveImports t)
      (js-object :record record :options (js-object :sourceAssets proofs
        :literalSources (js-array (Object/assign (js-object) replacement (js-object :id "runtime/core/identifier.mjs")))
        :literalSourceIdentity (js-array (js-object :id "runtime/core/identifier.mjs"
          :filename (get replacement :filename)
          :sha256 (js-call (js-call (createHash "sha256") :update (get replacement :source) "utf16le") :digest "hex")))))))

  (defun provider-oracle (fixture path)
    (let ((node (get (get globalThis.process :env) :NODE_BINARY)))
      (createOriginalSeedOracle (Object/assign (js-object :sourceRoot root :directory path
        :node (if (nullish? node) "node" node) :programHost "node") (get fixture :options)))))

  (defasync archived-sequence-seed-fixture (family engine)
    ;; A small transport regression, not an alternative observation for the
    ;; retained complete sequence programs. Exercise their actual private
    ;; archive-provider branch through the real independent Emacs Seed route.
    (let* ((record (recipe (str "original-managed:sequence-data-" family ":" engine ":auto-65536")))
           (libraries (await (loadLiteralSources (js-object :sourceRoot root))))
           (proofs (js-call providers :map (lambda (provider)
             (let ((bytes (js-call Buffer :from (get provider :source) "utf8")))
               (js-object :file (get provider :filename) :encoding "base64"
                 :content (js-call bytes :toString "base64") :bytes (js-length bytes) :sha256 (digest bytes))))))
           (identities (js-array)))
      (put (get record :original) :suite "tests/wasm-managed-sequence-data.test.mjs")
      (put (get record :execution) :hostRuntime engine)
      (put (get record :request) :resolveImports t)
      (js-call libraries :forEach (lambda (library)
        (let ((bytes (js-call Buffer :from (get library :source) "utf8")))
          (js-call proofs :push (js-object :file (get library :filename) :encoding "base64"
            :content (js-call bytes :toString "base64") :bytes (js-length bytes) :sha256 (digest bytes)))
          (js-call (get (get record :original) :sourceAssets) :push
            (js-object :file (get library :filename) :sourceSha256 (digest bytes)))
          (js-call identities :push (js-object :id (get library :id) :filename (get library :filename)
            :sha256 (js-call (js-call (createHash "sha256") :update (get library :source) "utf16le") :digest "hex"))))))
      ;; Retain the complete original declarations in the source archive too;
      ;; restore the oracle configuration from these exact archived bytes.
      (put record :seedSourceAssets proofs)
      (js-object :record record :options (js-object :sourceAssets proofs
        :literalSources libraries :literalSourceIdentity identities))))

  (test "independent sequence Seed contexts authenticate the complete restored provider archive for both hosts and families"
    (async ()
      (let ((families (js-array "relational-set" "standard-identities"))
            (engines (js-array "node" "bun")) (family-index 0))
        (while (< family-index (js-length families))
          (let ((engine-index 0))
            (while (< engine-index (js-length engines))
              (let* ((family (aref families family-index)) (engine (aref engines engine-index))
                     (fixture (await (archived-sequence-seed-fixture family engine)))
                     (record (get fixture :record)) (before (JSON/stringify record))
                     (path (resolve directory (str "sequence-source-archive-" family "-" engine)))
                     (identity (await (archiveCompilerCorpusSources record path)))
                     (restored (await (readArchivedCompilerCorpusSources path
                                 (js-object :expectedIdentity (get identity :sha256)))))
                     (options (Object/assign (js-object) (get fixture :options)
                                (js-object :sourceAssets (get restored :seedSourceAssets))))
                     (run (provider-oracle (js-object :options options)
                            (resolve directory (str "sequence-seed-" family "-" engine)))))
                (js-call assert :deepStrictEqual restored record)
                (js-call assert :strictEqual (js-length (get options :sourceAssets))
                  (+ (js-length providers) (js-length (get options :literalSources))))
                (let ((actual (await (funcall run (js-object :record restored :target "javascript")))))
                  (js-call assert :strictEqual (get actual :kind) "original-program")
                  (js-call assert :strictEqual (get actual :stdout) "runtime identity verified\n")
                  (let ((provider-proof (get actual :nativeProviderIdentity)))
                    (js-call assert :strictEqual (get provider-proof :policy) "canonical-source-runtime")
                    (js-call assert :strictEqual (get provider-proof :runtimeRoot) (await (realpath (resolve root "runtime"))))
                    (js-call assert :strictEqual (js-length (get provider-proof :files)) (js-length providers))
                    (js-call providers :forEach (lambda (provider)
                      (let ((proof (js-call (get provider-proof :files) :find
                                     (lambda (item) (= (get item :id) (get provider :id))))))
                        (js-call assert :ok proof)
                        (js-call assert :strictEqual (get proof :sha256) (get provider :sha256))
                        (js-call assert :strictEqual (get proof :bytes) (get provider :bytes)))))))
                (js-call assert :strictEqual (JSON/stringify record) before)
                (js-call assert :strictEqual (JSON/stringify restored) before))
              (setq engine-index (1+ engine-index))))
          (setq family-index (1+ family-index))))) 60000)

  (test "sequence Seed archive routing never substitutes request host sources for missing changed or duplicate provider proofs"
    (async ()
      (let ((modes (js-array "missing" "changed" "duplicate")) (index 0))
        (while (< index (js-length modes))
          (let* ((mode (aref modes index)) (fixture (await (archived-sequence-seed-fixture "relational-set" "node")))
                 (record (get fixture :record))
                 (path (resolve directory (str "sequence-refusal-archive-" mode)))
                 (identity (await (archiveCompilerCorpusSources record path)))
                 (restored (await (readArchivedCompilerCorpusSources path
                             (js-object :expectedIdentity (get identity :sha256)))))
                 (proofs (funcall globalThis.structuredClone (get restored :seedSourceAssets)))
                 (proof (js-call proofs :find (lambda (item) (= (get item :file) "runtime/core/queue.mjs")))))
            (js-call assert :ok proof)
            (cond
              ((= mode "missing")
                (setq proofs (js-call proofs :filter (lambda (item) (/= (get item :file) (get proof :file))))))
              ((= mode "changed")
                (let ((bytes (js-call Buffer :from
                              (str (js-call (js-call Buffer :from (get proof :content) "base64") :toString "utf8") "\n "))))
                  (put proof :content (js-call bytes :toString "base64"))
                  (put proof :bytes (js-length bytes)) (put proof :sha256 (digest bytes))))
              (t (js-call proofs :push (Object/assign (js-object) proof))))
            (let* ((before (JSON/stringify restored))
                   (options (Object/assign (js-object) (get fixture :options) (js-object :sourceAssets proofs)))
                   (run (provider-oracle (js-object :options options)
                          (resolve directory (str "sequence-refusal-seed-" mode)))))
              ;; request.hostSources still contains the authentic provider.
              ;; It is deliberately insufficient for the archived branch.
              (js-call assert :strictEqual
                (js-length (get (get restored :request) :hostSources)) (js-length providers))
              (await (js-call assert :rejects (funcall run (js-object :record restored :target "javascript"))
                (lambda (error) (= (get error :message)
                  "original canonical native provider identity conflicts with the selected product"))))
              (js-call assert :strictEqual (JSON/stringify restored) before)))
          (setq index (1+ index))))) 60000)

