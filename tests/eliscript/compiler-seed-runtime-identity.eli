  (test "Seed provider source proof changes are rejected before compiling or installing a local runtime"
    (async ()
      (let* ((fixture (seed-provider-fixture "seed-provider-source-proof")) (record (get fixture :record))
             (proofs (get (get fixture :options) :sourceAssets))
             (proof (aref proofs (1- (js-length proofs))))
             (before (JSON/stringify record))
             (run (provider-oracle fixture (resolve directory "provider-source-proof"))))
        (put proof :sha256 (js-call "0" :repeat 64))
        ;; Create the oracle after changing its input proof; it captures its
        ;; own immutable source declaration snapshot on construction.
        (setq run (provider-oracle fixture (resolve directory "provider-source-proof-changed")))
        (await (js-call assert :rejects (funcall run (js-object :record record :target "javascript"))
          (lambda (error) (= (get error :message)
            "original recipe source asset identity differs: stdlib/managed-runtime-identifier.eli"))))
        (js-call assert :strictEqual (JSON/stringify record) before))))

  (test "Seed local package exposes only actually declared platform files through their original explicit aliases"
    (async ()
      (let* ((record (recipe "seed-declared-http-provider"))
             (http (await (readFile (resolve root "platform/http.mjs") "utf8")))
             (source (str program-source
               "\n(import \"eliscript/platform/http.mjs\" readHttpGlobal)"
               "\n(defconst headers-value (readHttpGlobal \"Headers\")) (export headers-value)")))
        (put (aref (get record :modules) 0) :source source)
        (js-call (get (get record :request) :hostSources) :push
          (js-object :id "platform/http.mjs" :filename "platform/http.mjs" :source http))
        (put (get record :execution) :hostSource (compile-string (str host-source
          "\n(import \"eliscript/platform/http\" :as ShortHTTP)"
          "\n(import \"eliscript/platform/http.mjs\" :as FullHTTP)"
          "\n(js-call assert :strictEqual ShortHTTP FullHTTP)"
          "\n(js-call assert :strictEqual (get emitted :headers_value) globalThis.Headers)"
          "\n(js-call assert :strictEqual (js-call FullHTTP :readHttpGlobal \"Headers\") globalThis.Headers)"
          "\n(js-call assert :throws (lambda () (js-call FullHTTP :readHttpGlobal \"unapproved\")) globalThis.TypeError)")
          "declared-http-host.eli"))
        (let* ((before (JSON/stringify record)) (run (oracle (resolve directory "declared-http-oracle")))
               (actual (await (funcall run (js-object :record record :target "javascript")))))
          (js-call assert :strictEqual (get actual :stdout) "runtime identity verified\n")
          (js-call assert :strictEqual (JSON/stringify record) before))
        (let* ((missing (funcall globalThis.structuredClone record))
               (run (oracle (resolve directory "undeclared-http-oracle"))))
          (put (get missing :request) :hostSources (js-call (get (get missing :request) :hostSources) :filter
            (lambda (item) (/= (get item :id) "platform/http.mjs"))))
          (await (js-call assert :rejects (funcall run (js-object :record missing :target "javascript"))
            (lambda (error) (js-call (get error :message) :includes "platform/http")))))
        (let* ((unrelated (funcall globalThis.structuredClone record))
               (run (oracle (resolve directory "undeclared-platform-oracle"))))
          (put (aref (get unrelated :modules) 0) :source (str program-source
            "\n(import \"eliscript/platform/browser.mjs\" :as Unrelated)"))
          (await (js-call assert :rejects (funcall run (js-object :record unrelated :target "javascript"))
            (lambda (error) (js-call (get error :message) :includes "platform/browser"))))))) 60000)

  (test "independent sorted provider originals retain real source runtime constructors comparators metadata and incoming identity"
    (async ()
      (let ((engines (js-array "node" "bun")) (index 0))
        (while (< index (js-length engines))
          (let* ((engine (aref engines index)) (record (recipe (str "original-managed:sorted-core:" engine ":auto-1")))
                 (source (str
                   "(import \"./runtime/core/sorted.mjs\" persistentSortedMap defaultSortedComparator)\n"
                   "(defun provider-value () (persistentSortedMap 2 \"b\" 1 \"a\"))\n"
                   "(defun provider-identity (value) value)\n"
                   "(export provider-value provider-identity)"))
                 (original-sorted (JSON/stringify (resolve root "runtime/core/sorted.mjs")))
                 (original-metadata (JSON/stringify (resolve root "runtime/core/metadata.mjs")))
                 (original-literals (JSON/stringify (resolve root "runtime/literals.mjs"))))
            (put (aref (get record :modules) 0) :source source)
            (put (get record :original) :suite "tests/wasm-managed-sorted-core.test.mjs")
            (put (get record :original) :fixture "tests/fixtures/wasm-managed-sorted.eli")
            (put (get record :execution) :hostRuntime engine)
            (put (get record :execution) :referenceArtifact t)
            (put (get record :execution) :aliases t)
            (put (get record :execution) :hostSource (compile-string (js-call (js-array
              "(import \"node:assert/strict\" :default assert)"
              "(import \"../entry.mjs\" :as emitted)"
              (str "(import " original-sorted " :as OriginalSorted)")
              (str "(import " original-metadata " :as OriginalMetadata)")
              (str "(import " original-literals " :as OriginalLiterals)")
              "(defconst value (js-call emitted :provider_value))"
              "(js-call assert :strictEqual (Object/getPrototypeOf value) (get (get OriginalSorted :PersistentSortedMap) :prototype))"
              "(js-call assert :strictEqual (get value :comparator) (js-call OriginalSorted :defaultSortedComparator))"
              "(js-call assert :strictEqual (js-call emitted :provider_identity value) value)"
              "(defconst metadata (js-call OriginalLiterals :hashMap \"provider\" 17))"
              "(defconst incoming (js-call OriginalMetadata :withMeta (js-call OriginalSorted :persistentSortedMap 1 \"a\") metadata))"
              "(js-call assert :strictEqual (js-call emitted :provider_identity incoming) incoming)"
              "(js-call assert :strictEqual (js-call OriginalMetadata :meta incoming) metadata)"
              "(js-call (get globalThis.process :stdout) :write \"sorted provider identity verified\\n\")") :join "\n")
              "sorted-provider-host.eli"))
            (let* ((before (JSON/stringify record)) (run (oracle (resolve directory (str "sorted-provider-" engine))))
                   (actual (await (funcall run (js-object :record record :target "javascript")))))
              (js-call assert :strictEqual (get actual :stdout) "sorted provider identity verified\n")
              (js-call assert :strictEqual (JSON/stringify record) before))
            (let* ((changed (funcall globalThis.structuredClone record))
                   (provider (js-call (get (get changed :request) :hostSources) :find
                     (lambda (item) (= (get item :id) "runtime/core/sorted.mjs"))))
                   (run (oracle (resolve directory (str "sorted-provider-changed-" engine)))))
              (put provider :source (str (get provider :source) "\n "))
              (await (js-call assert :rejects (funcall run (js-object :record changed :target "javascript"))
                (lambda (error) (= (get error :message)
                  "original canonical native provider identity conflicts with the selected product")))))
            (let* ((missing (funcall globalThis.structuredClone record))
                   (run (oracle (resolve directory (str "sorted-provider-missing-" engine)))))
              (put (get missing :request) :hostSources (js-call (get (get missing :request) :hostSources) :filter
                (lambda (item) (/= (get item :id) "runtime/core/sorted.mjs"))))
              (await (js-call assert :rejects (funcall run (js-object :record missing :target "javascript"))
                (lambda (error) (= (get error :message)
                  "original canonical native provider identity conflicts with the selected product"))))))
          (setq index (1+ index))))) 60000)
  (defun literal-codec-seed-record ()
    (let ((record (recipe "original-program:compiler-literal-runtime-complete")))
      (put (get record :original) :suite "tests/literal-runtime.test.mjs")
      (put (get record :original) :fixture "tests/fixtures/literal-runtime.eli")
      (put (get record :execution) :host "tests/__eliscript_original_literal_runtime_complete.mjs")
      (put (get record :execution) :runtimeProfile "compiler")
      (put (get record :execution) :referenceArtifact t)
      (put (get record :execution) :aliases t)
      (put (get record :execution) :setupReplacement
        (js-object :kind "selected-and-independent-reference-compiler-directories"))
      record))

  (test "independent literal Seed replay shares the real runtime URL with genuine portable compiler outputs and the strict worker codec"
    (async ()
      (let* ((record (literal-codec-seed-record))
             (host (js-call (js-array
               "(import \"node:assert/strict\" :default assert)"
               "(import \"node:fs\" mkdtempSync mkdirSync readFileSync writeFileSync rmSync)"
               "(import \"node:path\" resolve)"
               "(import \"node:child_process\" spawnSync)"
               "(import \"node:module\" createRequire)"
               "(import \"../runtime/worker-value-codec.mjs\" encodeWorkerValue decodeWorkerValue)"
               "(import \"../runtime/core/vector.mjs\" persistentVector isPersistentVector)"
               "(import \"../runtime/core/map.mjs\" isPersistentHashMap)"
               "(import \"../runtime/core/set.mjs\" isPersistentHashSet)"
               "(import \"../runtime/core/list.mjs\" isPersistentList)"
               "(import \"../runtime/core/identifier.mjs\" keyword)"
               "(import \"../runtime/core/value.mjs\" equalValues)"
               "(defconst ROOT (get (get globalThis.process :env) :ELISCRIPT_ORIGINAL_SOURCE_ROOT))"
               "(defconst directory (mkdtempSync (resolve ROOT \".eliscript-seed-codec-\")))"
               "(try (let* ((source (resolve directory \"portable.eli\"))"
               " (outputs (js-array (resolve directory \"first/module.mjs\") (resolve directory \"second/module.mjs\"))))"
               " (writeFileSync source \"(defportable build (argument) {:argument argument :keyword :ready :vector [1 undefined] :map {:nested [2]} :set #{argument [4]} :quote '(alpha :beta [3] nil)}) (export build)\")"
               " (js-call outputs :forEach (lambda (output)"
               "  (mkdirSync (resolve output \"..\") (js-object :recursive t))"
               "  (let ((result (spawnSync (resolve ROOT \"bin/eliscript-seed\") (js-array \"--source-map\" \"--portable\" \"build\" \"--output\" output source) (js-object :cwd ROOT :encoding \"utf8\"))))"
               "   (js-call assert :strictEqual (get result :error) undefined)"
               "   (js-call assert :strictEqual (get result :signal) nil (get result :stderr))"
               "   (js-call assert :strictEqual (get result :status) 0 (get result :stderr)))))"
               " (js-call assert :strictEqual (readFileSync (aref outputs 0) \"utf8\") (readFileSync (aref outputs 1) \"utf8\"))"
               " (js-call assert :strictEqual (readFileSync (str (aref outputs 0) \".map\") \"utf8\") (readFileSync (str (aref outputs 1) \".map\") \"utf8\"))"
               " (let* ((load (createRequire (resolve ROOT \"tests/literal-runtime.test.mjs\")))"
               " (first (funcall load (aref outputs 0))) (second (funcall load (aref outputs 1)))"
               " (argument (persistentVector 8 9))"
               " (left (js-call first :build argument)) (right (js-call second :build argument))"
               " (transported (decodeWorkerValue (encodeWorkerValue left))))"
               " (js-call assert :strictEqual (isPersistentHashMap left) t)"
               " (js-call assert :strictEqual (equalValues left right) t)"
               " (js-call assert :strictEqual (equalValues left transported) t)"
               " (js-call assert :strictEqual (js-call left :get (keyword \"argument\")) argument)"
               " (js-call assert :strictEqual (js-call left :get (keyword \"keyword\")) (keyword \"ready\"))"
               " (js-call assert :strictEqual (isPersistentVector (js-call left :get (keyword \"vector\"))) t)"
               " (js-call assert :strictEqual (isPersistentHashMap (js-call left :get (keyword \"map\"))) t)"
               " (js-call assert :strictEqual (isPersistentHashSet (js-call left :get (keyword \"set\"))) t)"
               " (js-call assert :strictEqual (isPersistentList (js-call left :get (keyword \"quote\"))) t)"
               " (js-call (get globalThis.process :stdout) :write \"real Seed codec identity verified\\n\")))"
               " (finally (rmSync directory (js-object :recursive t :force t))))") :join "\n")))
        (put (get record :execution) :hostSource (compile-string host "seed-real-portable-codec-host.eli"))
        (let* ((before (JSON/stringify record)) (run (oracle (resolve directory "real-seed-codec")))
               (actual (await (funcall run (js-object :record record :target "javascript")))))
          (js-call assert :strictEqual (get actual :stdout) "real Seed codec identity verified\n")
          (js-call assert :strictEqual (js-length (get actual :supportingProducts)) 1)
          (js-call assert :strictEqual (get (aref (get actual :supportingProducts) 0) :producer) "emacs-seed")
          (js-call assert :strictEqual (get (get actual :nativeProviderIdentity) :runtimeRoot)
            (await (realpath (resolve root "runtime"))))
          (js-call assert :strictEqual (JSON/stringify record) before)))) 60000)

