(module tests.compiler-corpus-process
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:events" EventEmitter)
  (import "node:stream" PassThrough)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" mkdir mkdtemp readFile writeFile symlink unlink rm)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/backends/compiler-corpus-process.mjs"
    originalCorpusExecutionPolicy runOriginalCorpusProcess writeOriginalCorpusExecutionContext readOriginalCorpusExecutionContext
    readOriginalProcessHostDependency bindOriginalProcessHostDependency validateOriginalProcessHostDependency)

  (import "../tools/backends/compiler-corpus.mjs" createOriginalCorpusSourceReader)
  (import "../tools/backends/compiler-corpus-original-program.mjs" originalProgramSidecars)

  (defconst identity (Object/freeze (js-object :sha256 "fixture-source-identity")))
  (test "export sequence children retain an absent original deadline without requiring a program execution contract"
    (lambda ()
      (let* ((record (Object/freeze (js-object :kind "sequence" :id "exports")))
             (policy (originalCorpusExecutionPolicy
               (js-object :record record :target "javascript" :options (js-object)))))
        (js-call assert :strictEqual (get policy :mode) "strict")
        (js-call assert :strictEqual (get policy :originalDeadlineMs) nil)
        (js-call assert :strictEqual (get policy :effectiveDeadlineMs) nil))))
  (defun context (profile &optional target)
    (js-object :target (or target "wasm") :sourceIdentity identity
      :options (if (undefined? profile) (js-object) (js-object :functionalRuntimeProfile profile))
      :record (js-object :id "original-program:lifecycle-fixture"
        :execution (js-object :kind "original-program" :timeoutMs 30
          :timeoutByTarget (js-object :native 60) :httpTimeoutMs 10))))
  (defun watch (promise)
    (let ((state (js-object :settlements 0 :done false)))
      (put state :result (js-call promise :then
        (lambda (value) (put state :settlements (1+ (get state :settlements)))
          (put state :done t) (js-object :ok t :value value))
        (lambda (error) (put state :settlements (1+ (get state :settlements)))
          (put state :done t) (js-object :ok false :error error)))) state))
  (defun harness ()
    (let* ((child (new EventEmitter)) (timers (new globalThis.Map))
           (state (js-object :spawns 0 :terminations (js-array) :cleanups 0
                    :time 0 :timerId 0 :child child :timers timers)) (ready undefined))
      (put state :started (new globalThis.Promise (lambda (accept) (setq ready accept))))
      (put child :pid 73001)
      (put child :stdout (new PassThrough)) (put child :stderr (new PassThrough))
      (put state :services (js-object
        :spawn (lambda (command args options)
          (put state :spawns (1+ (get state :spawns)))
          (put state :invocation (js-object :command command :args args :options options))
          (funcall ready child) child)
        :now (lambda () (get state :time))
        :setTimeout (lambda (callback delay)
          (put state :timerId (1+ (get state :timerId)))
          (let ((id (get state :timerId)))
            (js-call timers :set id (js-object :callback callback :at (+ (get state :time) delay))) id))
        :clearTimeout (lambda (id) (js-call timers :delete id))))
      (put state :terminate (lambda (owned reason)
        (js-call assert :strictEqual owned child)
        (js-call (get state :terminations) :push reason)))
      (put state :cleanup (async (owned)
        (js-call assert :strictEqual owned child)
        (put state :cleanups (1+ (get state :cleanups)))))
      state))
  (defun advance (state amount)
    (put state :time (+ (get state :time) amount))
    (js-call (Array/from (js-call (get state :timers) :entries)) :forEach
      (lambda (pair)
        (when (<= (get (aref pair 1) :at) (get state :time))
          (js-call (get state :timers) :delete (aref pair 0))
          (funcall (get (aref pair 1) :callback))))))
  (defun finish (state code &optional signal)
    (js-call (get (get state :child) :stdout) :end)
    (js-call (get (get state :child) :stderr) :end)
    (js-call (get state :child) :emit "exit" code (if (undefined? signal) nil signal))
    (js-call (get state :child) :emit "close" code (if (undefined? signal) nil signal)))
  (defun options (directory state policy &optional signal)
    (js-object :directory directory :caseId "original-program:lifecycle-fixture"
      :target "wasm" :sourceIdentity identity :policy policy :signal signal
      :services (get state :services) :terminate (get state :terminate)
      :cleanup (get state :cleanup) :cwd root :env (js-object :FIX36 "original")))
  (defasync with-directory (body)
    (let ((parent (resolve root "_worktree/evidence/fix36-process-tests")))
      (await (mkdir parent (js-object :recursive t)))
      (let ((directory (await (mkdtemp (resolve parent "case-")))))
        (try (await (funcall body directory))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
  (defasync evidence (directory)
    (JSON/parse (await (readFile (resolve directory "process-outcome.json") "utf8"))))

  (test "complete original execution contexts use authenticated files without changing argv or inherited source evidence"
    (async () (await (with-directory (async (directory)
      (let* ((payload (js-call "原始源码😀\ufeff" :repeat 262144))
             (input (js-object :directory directory :caseId "original-full-input" :target "javascript"
               :sourceIdentity identity :options (js-object :sourceAssets (js-array (js-object :source payload :map payload))
                 :aliases (js-object :original payload))))
             (serialized (JSON/stringify input))
             (reference (await (writeOriginalCorpusExecutionContext directory input)))
             (descriptor (JSON/parse reference))
             (bytes (await (readFile (get descriptor :path))))
             (state (harness)) (settings (options directory state (originalCorpusExecutionPolicy (context "small"))))
             (args (js-array "original-directory" "vector" "1000000")))
        (js-call assert :ok (< (Buffer/byteLength reference) 2048))
        (js-call assert :strictEqual (js-call bytes :toString "utf8") serialized)
        (js-call assert :strictEqual (get descriptor :bytes) (get bytes :length))
        (js-call assert :strictEqual (get descriptor :sha256)
          (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
        (js-call assert :deepStrictEqual (readOriginalCorpusExecutionContext reference) input)
        (js-call assert :deepStrictEqual (readOriginalCorpusExecutionContext serialized) input)
        (put settings :env (js-object :ELISCRIPT_ORIGINAL_EXECUTION_CONTEXT reference))
        (put settings :executionContext descriptor)
        (let ((run (watch (runOriginalCorpusProcess "original-host" args settings))))
          (await (get state :started))
          (js-call assert :strictEqual (get (get state :invocation) :args) args)
          (js-call assert :deepStrictEqual
            (readOriginalCorpusExecutionContext (get (get (get (get state :invocation) :options) :env) :ELISCRIPT_ORIGINAL_EXECUTION_CONTEXT)) input)
          (finish state 0)
          (js-call assert :strictEqual (get (await (get run :result)) :ok) t)
          (js-call assert :deepStrictEqual (get (await (evidence directory)) :executionContext) descriptor))
        (js-call assert :strictEqual (JSON/stringify input) serialized)))))))

  (test "original execution context references reject corrupt bytes aliases and invalid metadata before exposing any input"
    (async () (await (with-directory (async (directory)
      (let* ((input (js-object :directory directory :options (js-object :source "complete source")))
             (reference (await (writeOriginalCorpusExecutionContext directory input)))
             (descriptor (JSON/parse reference)) (path (get descriptor :path))
             (bytes (await (readFile path))) (alias (resolve directory "context-alias.json")))
        (await (writeFile path (Buffer/alloc (get bytes :length) 120)))
        (js-call assert :throws (lambda () (readOriginalCorpusExecutionContext reference)) globalThis.TypeError)
        (await (writeFile path bytes))
        (js-call assert :deepStrictEqual (readOriginalCorpusExecutionContext reference) input)
        (await (symlink path alias))
        (js-call assert :throws (lambda () (readOriginalCorpusExecutionContext
          (JSON/stringify (Object/assign (js-object) descriptor (js-object :path alias))))) globalThis.TypeError)
        (js-call (js-array (js-object :version 2) (js-object :bytes (1+ (get bytes :length)))
          (js-object :sha256 (js-call "0" :repeat 64)) (js-object :path "relative.json") (js-object :extra t)) :forEach
          (lambda (change) (js-call assert :throws (lambda () (readOriginalCorpusExecutionContext
            (JSON/stringify (Object/assign (js-object) descriptor change)))) globalThis.TypeError)))
        (await (unlink path))
        (js-call assert :throws (lambda () (readOriginalCorpusExecutionContext reference)) (js-object :code "ENOENT"))))))))

  (test "original sidecars prefer their actual directory without reading path and retain path-only deployment"
    (async () (await (with-directory (async (directory)
      (let* ((record (js-object :original (js-object) :request (js-object)
               :execution (js-object :host "host.mjs" :hostSource "")))
             (marker (js-object :unexpectedPathRead t)) (reads 0)
             (artifact (js-object :directory directory)))
        (Object/defineProperty artifact "path" (js-object :get (lambda ()
          (setq reads (1+ reads)) (throw marker))))
        (js-call assert :strictEqual (await (originalProgramSidecars artifact record)) (resolve directory "host.mjs"))
        (js-call assert :strictEqual reads 0)
        (js-call assert :strictEqual (await (readFile (resolve directory "host.mjs") "utf8")) "")
        (let ((nested (resolve directory "path-only")))
          (await (mkdir nested))
          (js-call assert :strictEqual (await (originalProgramSidecars
            (js-object :path (resolve nested "entry.mjs")) record)) (resolve nested "host.mjs"))
          (js-call assert :strictEqual (await (readFile (resolve nested "host.mjs") "utf8")) ""))))))))

  (test "relocated original hosts deploy the complete authenticated process dependency and refuse missing changed or conflicting declarations"
    (async () (await (with-directory (async (directory)
      (let* ((reader (createOriginalCorpusSourceReader (js-object :sourceRoot root)))
             (dependency (await (readOriginalProcessHostDependency reader)))
             (record (js-object :id "original-relocated-host" :request (js-object :hostSources (js-array))
               :original (js-object) :execution (js-object :host "tests/renamed-host.mjs" :hostSource "")))
             (saved (JSON/stringify record)) (bound (bindOriginalProcessHostDependency record dependency))
             (declaration (aref (get (get bound :request) :hostSources) 0)))
        (js-call assert :strictEqual (JSON/stringify record) saved)
        (js-call assert :strictEqual (get declaration :id) "tests/compiler-corpus-process.mjs")
        (js-call assert :strictEqual (get declaration :filename) "tools/backends/compiler-corpus-process.mjs")
        (js-call assert :strictEqual (get declaration :source) (await (readFile (resolve root (get declaration :filename)) "utf8")))
        (js-call assert :strictEqual (js-length (get (get bound :original) :sourceAssets)) 2)
        (js-call (get (get bound :original) :sourceAssets) :forEach (lambda (proof)
          (js-call assert :ok (> (get proof :bytes) 0))
          (js-call assert :match (get proof :sourceSha256) (new globalThis.RegExp "^[0-9a-f]{64}$"))))
        (await (originalProgramSidecars (js-object :directory directory) bound))
        (js-call assert :strictEqual (await (readFile (resolve directory (get declaration :id)) "utf8")) (get dependency :source))
        (js-call assert :deepStrictEqual (bindOriginalProcessHostDependency bound dependency) bound)
        (js-call (js-array
          (lambda (changed) (put (get changed :request) :hostSources (js-array)))
          (lambda (changed) (put (aref (get (get changed :request) :hostSources) 0) :source "changed"))
          (lambda (changed) (put (aref (get (get changed :original) :sourceAssets) 0) :sourceSha256 (js-call "0" :repeat 64)))) :forEach
          (lambda (change) (let ((changed (globalThis.structuredClone bound)))
            (funcall change changed)
            (js-call assert :throws (lambda () (validateOriginalProcessHostDependency changed)) globalThis.TypeError))))
        (let ((conflict (globalThis.structuredClone record)))
          (put (get conflict :request) :hostSources (js-array (Object/assign (js-object) declaration (js-object :source "changed"))))
          (js-call assert :throws (lambda () (bindOriginalProcessHostDependency conflict dependency)) globalThis.TypeError))
        (await (writeFile (resolve directory (get declaration :id)) (str (get dependency :source) "\n")))
        (await (js-call assert :rejects (originalProgramSidecars (js-object :directory directory) bound)))
        (let ((missing (Object/assign (js-object) reader (js-object :text (async (file)
          (if (= file "tools/backends/compiler-corpus-process.mjs")
            (let ((error (new globalThis.Error "missing original dependency"))) (put error :code "ENOENT") (throw error))
            (await (js-call reader :text file))))))))
          (await (js-call assert :rejects (readOriginalProcessHostDependency missing) (js-object :code "ENOENT"))))
        (let ((changed (Object/assign (js-object) reader (js-object :text (async (file)
          (str (await (js-call reader :text file)) "\n"))))))
          (await (js-call assert :rejects (readOriginalProcessHostDependency changed) globalThis.TypeError)))))))))

  (test "FIX36 policy uses the actual context declaration and preserves original deadlines and HTTP semantics"
    (lambda ()
      (let* ((input (context "small")) (before (JSON/stringify input))
             (functional (originalCorpusExecutionPolicy input)))
        (js-call assert :deepStrictEqual functional
          (js-object :mode "functional" :originalDeadlineMs 30 :effectiveDeadlineMs nil :performanceAcceptance "deferred"))
        (js-call assert :strictEqual (JSON/stringify input) before)
        (js-call assert :strictEqual (get (get (get input :record) :execution) :httpTimeoutMs) 10)
        (put (get input :record) :functionalRuntimeProfile "small")
        (put input :options (js-object))
        (js-call assert :deepStrictEqual (originalCorpusExecutionPolicy input)
          (js-object :mode "strict" :originalDeadlineMs 30 :effectiveDeadlineMs 30 :performanceAcceptance "not-evaluated"))
        (js-call assert :strictEqual (get (originalCorpusExecutionPolicy (context undefined "native")) :effectiveDeadlineMs) 60)
        (js-call assert :throws (lambda () (originalCorpusExecutionPolicy (context "unknown"))) globalThis.TypeError)
        (put (get (get input :record) :execution) :timeoutMs 0)
        (js-call assert :throws (lambda () (originalCorpusExecutionPolicy input)) globalThis.TypeError))))

  (test "FIX36 functional execution crosses the original deadline without a watchdog and preserves all output bytes"
    (async () (await (with-directory (async (directory)
      (let* ((state (harness)) (policy (originalCorpusExecutionPolicy (context "small")))
             (run (watch (runOriginalCorpusProcess "original-host" (js-array "unchanged") (options directory state policy))))
             (utf8 (Buffer/from "小明😀\n" "utf8")) (large (Buffer/alloc 262144 120)))
        (await (get state :started))
        (js-call (get (get state :child) :stdout) :write (js-call utf8 :subarray 0 5))
        (js-call (get (get state :child) :stderr) :write (Buffer/from "original stderr\n"))
        (js-call (get (get state :child) :stdout) :write (js-call utf8 :subarray 5))
        (js-call (get (get state :child) :stdout) :write large)
        (advance state 1000000)
        (await (Promise/resolve undefined))
        (js-call assert :strictEqual (get run :done) false)
        (js-call assert :strictEqual (get (get state :timers) :size) 0)
        (js-call assert :strictEqual (js-length (get state :terminations)) 0)
        (finish state 0)
        (let* ((out (await (get run :result))) (receipt (get out :value))
               (expected (Buffer/concat (js-array utf8 large))))
          (js-call assert :strictEqual (get out :ok) t)
          (js-call assert :strictEqual (get receipt :stdout) (js-call expected :toString "utf8"))
          (js-call assert :strictEqual (get receipt :stderr) "original stderr\n")
          (js-call assert :deepStrictEqual (await (readFile (get (get receipt :outputFiles) :stdout))) expected)
          (js-call assert :strictEqual (get (get receipt :outputBytes) :stdout) (get expected :length))
          (js-call assert :strictEqual (get (get receipt :policy) :performanceAcceptance) "deferred")
          (let* ((text (await (readFile (get (get receipt :outputFiles) :events) "utf8")))
                 (events (js-call (js-call (js-call text :trim) :split "\n") :map (lambda (line) (JSON/parse line)))))
            (js-call assert :ok (> (js-length events) 0))
            (let ((previous -1))
              (js-call events :forEach (lambda (event)
                (js-call assert :ok (> (get event :sequence) previous))
                (setq previous (get event :sequence))
                (js-call assert :strictEqual (get event :caseId) "original-program:lifecycle-fixture")
                (js-call assert :deepStrictEqual (get event :sourceIdentity) identity))))
            (js-call assert :strictEqual (get (js-call events :at -1) :phase) "tree-cleanup-end")))
        (js-call assert :strictEqual (get state :cleanups) 1)
        (js-call assert :strictEqual (get run :settlements) 1)))))))

  (test "FIX36 strict timeout terminates only its child once and drains failure output before rejection"
    (async () (await (with-directory (async (directory)
      (let* ((state (harness)) (run (watch (runOriginalCorpusProcess "strict-host" (js-array)
          (options directory state (originalCorpusExecutionPolicy (context undefined)))))))
        (await (get state :started)) (advance state 30)
        (js-call assert :strictEqual (js-length (get state :terminations)) 1)
        (js-call assert :strictEqual (get run :done) false)
        (js-call (get (get state :child) :stderr) :write "before termination\n")
        (finish state nil "SIGTERM")
        (let ((out (await (get run :result))))
          (js-call assert :strictEqual (get out :ok) false)
          (js-call assert :strictEqual (get (get out :error) :code) "ELISCRIPT_ORIGINAL_HOST_TIMEOUT")
          (js-call assert :strictEqual (get (get out :error) :timeoutMs) 30)
          (js-call assert :strictEqual (await (readFile (resolve directory "stderr.log") "utf8")) "before termination\n")
          (js-call assert :strictEqual (get (await (evidence directory)) :status) "failed"))
        (advance state 1000000)
        (js-call assert :strictEqual (get run :settlements) 1)
        (js-call assert :strictEqual (get state :cleanups) 1)))))))

  (test "FIX36 abort close and child error races keep the first reason and settle once"
    (async () (await (with-directory (async (directory)
      (let* ((state (harness)) (controller (new globalThis.AbortController))
             (first (new globalThis.Error "explicit cancel"))
             (run (watch (runOriginalCorpusProcess "cancel-host" (js-array)
               (options directory state (originalCorpusExecutionPolicy (context "small")) (get controller :signal))))))
        (await (get state :started))
        (js-call controller :abort first)
        (js-call (get state :child) :emit "error" (new globalThis.Error "late child error"))
        (finish state nil "SIGTERM")
        (let ((out (await (get run :result))))
          (js-call assert :strictEqual (get out :error) first)
          (js-call assert :strictEqual (get run :settlements) 1)
          (js-call assert :strictEqual (js-length (get state :terminations)) 1)
          (js-call assert :strictEqual (get state :cleanups) 1))))))))

  (test "FIX36 an already aborted signal never spawns and a synchronous spawn error remains original"
    (async () (await (with-directory (async (directory)
      (let* ((state (harness)) (controller (new globalThis.AbortController))
             (cancel (new globalThis.Error "cancel before spawn")))
        (js-call controller :abort cancel)
        (let ((out (await (get (watch (runOriginalCorpusProcess "not-started" (js-array)
          (options directory state (originalCorpusExecutionPolicy (context "small")) (get controller :signal)))) :result))))
          (js-call assert :strictEqual (get out :error) cancel)
          (js-call assert :strictEqual (get state :spawns) 0)))
      (let* ((state (harness)) (failure (new globalThis.Error "spawn ENOENT")))
        (put (get state :services) :spawn (lambda (&rest ignored) (throw failure)))
        (let ((out (await (get (watch (runOriginalCorpusProcess "missing" (js-array)
          (options (resolve directory "spawn") state (originalCorpusExecutionPolicy (context "small"))))) :result))))
          (js-call assert :strictEqual (get out :error) failure)
          (js-call assert :strictEqual (get state :cleanups) 0))))))))

  (test "FIX36 frozen first errors survive close and false cleanup failures with a durable independent receipt"
    (async () (await (with-directory (async (directory)
      (let* ((state (harness)) (first (Object/freeze (new globalThis.Error "original spawn event"))))
        (put state :cleanup (async (child) (put state :cleanups (1+ (get state :cleanups))) (throw false)))
        (let ((run (watch (runOriginalCorpusProcess "error-host" (js-array)
          (options directory state (originalCorpusExecutionPolicy (context "small")))))))
          (await (get state :started))
          (js-call (get (get state :child) :stderr) :write "preserved diagnostic")
          (js-call (get state :child) :emit "error" first)
          (finish state 7)
          (let ((out (await (get run :result))) (receipt (await (evidence directory))))
            (js-call assert :strictEqual (get out :error) first)
            (js-call assert :strictEqual (Object/isFrozen first) t)
            (js-call assert :strictEqual (get (get receipt :failure) :message) "original spawn event")
            (js-call assert :ok (js-call (get receipt :secondaryFailures) :includes false))
            (js-call assert :strictEqual (get state :cleanups) 1)
            (js-call assert :strictEqual (get run :settlements) 1)))))))))

  (test "FIX36 successful output followed by cleanup failure fails and the next independent case still runs"
    (async () (await (with-directory (async (directory)
      (let* ((state (harness)) (failure (new globalThis.Error "cleanup failed")))
        (put state :cleanup (async (child) (throw failure)))
        (let ((run (watch (runOriginalCorpusProcess "first" (js-array)
          (options (resolve directory "first") state (originalCorpusExecutionPolicy (context "small")))))))
          (await (get state :started)) (js-call (get (get state :child) :stdout) :write "golden\n")
          (finish state 0)
          (js-call assert :strictEqual (get (await (get run :result)) :error) failure)
          (js-call assert :strictEqual (await (readFile (resolve directory "first/stdout.log") "utf8")) "golden\n")))
      (let* ((state (harness)) (run (watch (runOriginalCorpusProcess "next" (js-array)
          (options (resolve directory "next") state (originalCorpusExecutionPolicy (context "small")))))))
        (await (get state :started)) (finish state 0)
        (js-call assert :strictEqual (get (await (get run :result)) :ok) t)
        (js-call assert :strictEqual (get state :spawns) 1)))))))

  (test "FIX36 nonzero and signal exits preserve status and all diagnostics"
    (async () (await (with-directory (async (directory)
      (let ((index 0))
        (while (< index 2)
          (let* ((state (harness)) (case-directory (resolve directory (funcall globalThis.String index)))
                 (run (watch (runOriginalCorpusProcess "exit-host" (js-array)
                   (options case-directory state (originalCorpusExecutionPolicy (context "small")))))))
            (await (get state :started))
            (js-call (get (get state :child) :stderr) :write "real stderr")
            (finish state (if (= index 0) 9 nil) (if (= index 0) nil "SIGKILL"))
            (let ((out (await (get run :result))) (receipt (await (evidence case-directory))))
              (js-call assert :strictEqual (get (get out :error) :code)
                (if (= index 0) "ELISCRIPT_ORIGINAL_HOST_EXIT" "ELISCRIPT_ORIGINAL_HOST_SIGNAL"))
              (js-call assert :ok (js-call (get (get out :error) :message) :includes "real stderr"))
              (js-call assert :strictEqual (get (get receipt :failure) :message) (get (get out :error) :message))
              (js-call assert :strictEqual (get receipt :exitCode) (if (= index 0) 9 nil))
              (js-call assert :strictEqual (get receipt :signal) (if (= index 0) nil "SIGKILL"))
              (js-call assert :strictEqual (await (readFile (resolve case-directory "stderr.log") "utf8")) "real stderr")))
          (setq index (1+ index)))))))))

  (test "FIX36 close waits for cleanup and preserves an undefined secondary failure"
    (async () (await (with-directory (async (directory)
      (let* ((state (harness)) (first (new globalThis.Error "first child failure"))
             (release undefined)
             (pending (new globalThis.Promise (lambda (accept) (setq release accept)))))
        (put state :cleanup (async (child)
          (put state :cleanups (1+ (get state :cleanups)))
          (await pending) (throw undefined)))
        (let ((run (watch (runOriginalCorpusProcess "pending-cleanup" (js-array)
          (options directory state (originalCorpusExecutionPolicy (context "small")))))))
          (await (get state :started))
          (js-call (get state :child) :emit "error" first)
          (finish state 1)
          (await (Promise/resolve undefined))
          (js-call assert :strictEqual (get run :done) false)
          (funcall release undefined)
          (let ((out (await (get run :result))) (receipt (await (evidence directory))))
            (js-call assert :strictEqual (get out :error) first)
            (js-call assert :ok (js-call (get (get first :execution) :secondaryFailures) :includes undefined))
            (js-call assert :ok (js-call (get receipt :secondaryFailures) :some
              (lambda (value) (and value (= (get value :$eliscriptObservation) "undefined")))))
            (js-call assert :strictEqual (get run :settlements) 1)))))))))

  (test "FIX36 output stream errors retain their first identity and request owned termination"
    (async () (await (with-directory (async (directory)
      (let* ((state (harness)) (failure (new globalThis.Error "stdout read failure"))
             (run (watch (runOriginalCorpusProcess "stream-host" (js-array)
               (options directory state (originalCorpusExecutionPolicy (context "small")))))))
        (await (get state :started))
        (js-call (get (get state :child) :stdout) :write "retained prefix")
        (js-call (get (get state :child) :stdout) :emit "error" failure)
        (finish state nil "SIGTERM")
        (js-call assert :strictEqual (get (await (get run :result)) :error) failure)
        (js-call assert :strictEqual (js-length (get state :terminations)) 1)
        (js-call assert :strictEqual (await (readFile (resolve directory "stdout.log") "utf8")) "retained prefix")))))))

  (test "FIX36 evidence creation failures cannot report a passing child"
    (async () (await (with-directory (async (directory)
      (await (mkdir (resolve directory "stdout.log") (js-object :recursive t)))
      (let* ((state (harness)) (out (await (get (watch (runOriginalCorpusProcess "io-host" (js-array)
         (options directory state (originalCorpusExecutionPolicy (context "small"))))) :result))))
        (js-call assert :strictEqual (get out :ok) false)
        (js-call assert :strictEqual (get (get out :error) :code) "EISDIR")
        (js-call assert :strictEqual (get state :spawns) 0)))))))
)
