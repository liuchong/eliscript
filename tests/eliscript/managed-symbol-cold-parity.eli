(module tests.managed-symbol-cold-parity
  (import "node:assert/strict" :default assert)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (defun same (&rest arguments) (Reflect/apply (get assert :strictEqual) assert arguments))
  (defun deep (&rest arguments) (Reflect/apply (get assert :deepStrictEqual) assert arguments))
  (defun each (items body) (js-call items :forEach body))
  (defun times (count body) (let ((index 0)) (while (< index count) (funcall body index) (setq index (1+ index)))))
  (defun code-error (code) (lambda (error) (and error (not (nullish? (get error :eliscriptDiagnostic))) (= (get (get error :eliscriptDiagnostic) :code) code))))
  (defun read (a value)
    (cond ((and value (= (get value :kind) 4)) (js-call a :readNumber value))
      ((and value (= (get value :kind) 5)) (js-call a :readString value))
      ((and value (= (get value :kind) 14)) (Array/from (js-object :length (js-call a :length value)) (lambda (unused index)
        (let ((item (js-call a :get value index))) (try (read a item) (finally (js-call a :release item))))))) (t value)))
  (defun release-all (a values) (each values (lambda (value) (js-call a :release value))))
  (defun finish (a &rest arguments)
    (release-all a (if (> (js-length arguments) 0) (aref arguments 0) (js-array)))
    (js-call a :closeModule) (js-call a :collect) (same (js-call a :live) 0) (same (get (js-call a :stats) :frameDepth) 0))
  (defun cold-runtime (bytes) (let ((a (instantiateManagedRuntime bytes (js-object :initializeModule false)))) (js-call a :auto 1) (js-call a :initializeModule) a))
  (defun inSymbolCase (a name operation)
    (try (funcall operation) (catch error
      (try (let ((stats (js-call a :stats))) (Object/defineProperty error "symbolCase" (js-object :value (js-object :name name :stats stats :statsJSON (JSON/stringify stats)) :enumerable t :configurable t))) (catch ignored nil)) (throw error))))
  ;; Both hosts execute this entire original scenario, including capacity refusal,
  ;; roots, identity, recovery and cleanup. Only their independent native JS oracle differs.
  (defun runColdSymbolParity (bytes expected stages)
      (let* ((a (cold-runtime bytes)) (held (js-call a :number -0.0)) (frame (js-call a :frame 1)))
        (js-call a :frameSet frame 0 held)
        (try
          (let ((errors (js-array)))
            (each stages (lambda (name)
              (try (let ((out (inSymbolCase a (str "cold Symbol stage " name) (lambda () (js-call a :invoke name)))))
                (try (deep (read a out) (get (get expected :stages) name) name) (finally (js-call a :release out))))
                (catch error (js-call errors :push error)))
              (js-call a :collect) (same (get (js-call a :stats) :frameDepth) 1) (assert (Object/is (js-call a :readNumber held) -0.0))))
            (when (> (js-length errors) 0) (throw (new globalThis.AggregateError errors "cold Symbol independent observation stages"))))
          (finally (js-call a :leaveFrame frame) (finish a (js-array held)))))
      (each (js-array 0 1 2 3 4) (lambda (mode)
        (let* ((a (cold-runtime bytes)) (input (js-call a :number mode)) (held (js-call a :number -0.0)) (frame (js-call a :frame 1)))
          (js-call a :frameSet frame 0 held)
          (try (times 2 (lambda (repeat)
            (let ((out (inSymbolCase a (str "cold first observation mode=" mode " repeat=" repeat) (lambda () (js-call a :invoke "observe" (js-array input))))))
              (try (same (js-call a :readString out) (aref (get expected :observe) mode) (str mode "/" repeat)) (finally (js-call a :release out))))
            (js-call a :collect) (same (get (js-call a :stats) :frameDepth) 1) (assert (Object/is (js-call a :readNumber held) -0.0))))
            (finally (js-call a :leaveFrame frame) (finish a (js-array input held)))))))
      (let* ((a (cold-runtime bytes)) (constructor (js-call a :invoke "constructor")) (key (js-call a :string "dispose"))
             (held (js-call a :number -0.0)) (frame (js-call a :frame 1)) (fillers (js-array)))
        (js-call a :frameSet frame 0 held)
        (try
          (while (< (js-call a :live) 1012) (js-call fillers :push (js-call a :number 7)))
          (js-call assert :throws (lambda () (js-call a :objectHas constructor key)) (code-error "ELI-RT0002"))
          (same (get (js-call a :stats) :frameDepth) 1) (assert (Object/is (js-call a :readNumber held) -0.0))
          (release-all a fillers) (put fillers :length 0) (js-call a :collect)
          (same (js-call a :objectHas constructor key) t)
          (let ((current (js-call a :invoke "constructor")))
            (try (same (js-call a :invoke "same" (js-array constructor current)) t) (finally (js-call a :release current))))
          (let* ((mode (js-call a :number 2)) (out (js-call a :invoke "observe" (js-array mode))))
            (try (same (js-call a :readString out) (aref (get expected :observe) 2)) (finally (release-all a (js-array mode out)))))
          (finally (release-all a fillers) (js-call a :leaveFrame frame) (finish a (js-array constructor key held))))))
  (export runColdSymbolParity))
