(module tests.wasm-managed-arithmetic
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile)
  (import "node:child_process" spawnSync)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/managed-numeric-selfhosted.mjs" makeFixture closeFixture box read rawNumber rawRead)
  (import "./helpers/managed-numeric-selfhosted.mjs" :as shared)
  (defvar fixture undefined) (defvar backend undefined) (defvar runtimeProgram undefined)
  (defvar program undefined) (defvar bytes undefined) (defvar js undefined) (defvar directory undefined)
  (beforeAll (async ()
    (setq fixture (await (makeFixture "arithmetic")))
    (setq backend (get fixture :backend) runtimeProgram (get fixture :runtimeProgram)
      program (get fixture :program) bytes (get fixture :bytes) js (get fixture :js) directory (get fixture :directory))) 120000)
  (afterAll (async () (await (closeFixture fixture))))
  (defconst numbers (js-array 0 -0 1 -1 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
    globalThis.Number.MIN_VALUE (- globalThis.Number.MIN_VALUE) globalThis.Number.MAX_VALUE 9007199254740992 1e16 .1 -.25))
  (defun check (a name inputs) (js-call shared :check fixture a name inputs))
  (defun call (exports name &rest args) (Reflect/apply (get exports name) undefined args))
  (defun error-code (error code)
    (and (not (nullish? error)) (not (nullish? (get error :eliscriptDiagnostic)))
      (= (get (get error :eliscriptDiagnostic) :code) code)))
  (test "ordinary Number arithmetic, unary operations and relations exactly match JS IEEE semantics under GC"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes (js-object :maxSlots 128 :initialBytes 8192 :maxBytes 65536))))
        (js-call a :auto 1)
        (js-call numbers :forEach (lambda (x)
          (js-call (js-array "negate" "reciprocal" "increment" "decrement" "unary-add" "unary-multiply") :forEach
            (lambda (name) (check a name (js-array x))))
          (js-call numbers :forEach (lambda (y)
            (js-call (js-array "add" "subtract" "multiply" "divide" "equal" "distinct" "not-equal"
              "less" "less-equal" "greater" "greater-equal" "snapshot") :forEach
              (lambda (name) (check a name (js-array x y))))))))
        (check a "zero" (js-array)) (check a "one" (js-array))
        (assert (> (get (js-call a :stats) :collections) 1000)))))
  (test "Number increment and decrement allocate only their result and call frame, preserving every input bit"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (js-call (js-array "increment" "decrement") :forEach (lambda (name)
          (js-call numbers :forEach (lambda (x)
            (let* ((input (js-call a :number x)) (before (get (js-call a :stats) :collections))
                   (out (js-call a :invoke name (js-array input))))
              (assert (Object/is (js-call a :readNumber out) (funcall (get js name) x)))
              (assert (Object/is (js-call a :readNumber input) x))
              (js-call assert :strictEqual (- (get (js-call a :stats) :collections) before) 2
                "one frame and one Number, without a boxed literal one")
              (js-call a :release out) (js-call a :release input))))))
        (js-call a :collect) (js-call assert :strictEqual (js-call a :live) 0)
        (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))))
  (test "increment and decrement retain mixed primitive conversion and reject malformed raw inputs before allocating"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (h (call e "heap-new" 32 8192 8192)) (input (rawNumber e h -0)) (frame (call e "frame-new" h 1)))
        (js-call a :auto 1)
        (js-call (js-array undefined nil false t "" " " "x" "-0" "0x10" "中\ud800") :forEach (lambda (value)
          (js-call (js-array "increment" "decrement") :forEach (lambda (name) (check a name (js-array value))))))
        (call e "frame-set" h frame 0 input)
        (let ((before (call e "heap-live" h)))
          (js-call (js-array (js-array 4294967295 0 1) (js-array frame 0 3) (js-array input 2 3)) :forEach
            (lambda (entry)
              (js-call assert :strictEqual (call e "value-primitive-step" h (aref entry 0) (aref entry 1)) 0)
              (js-call assert :strictEqual (call e "last-error") (aref entry 2))
              (js-call assert :strictEqual (call e "frame-depth" h) 1)
              (js-call assert :strictEqual (call e "heap-live" h) before))))
        (assert (Object/is (rawRead e h input) -0))
        (call e "frame-pop" h frame) (call e "heap-collect" h)
        (js-call assert :strictEqual (call e "heap-live" h) 0))))
  (test "Number steps retain borrowed operands across capacity failure and pool relocation, then recover without a literal allocation"
    (lambda ()
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (h (call e "heap-new" 2 384 384)) (input (rawNumber e h -0)) (held (rawNumber e h 9)))
        (call e "heap-pin" h input) (call e "heap-pin" h held) (call e "heap-auto" h 1)
        (js-call (js-array 0 1) :forEach (lambda (mode)
          (js-call assert :strictEqual (call e "value-primitive-step" h input mode) 0)
          (js-call assert :strictEqual (call e "last-error") 2)
          (assert (Object/is (rawRead e h input) -0)) (js-call assert :strictEqual (call e "frame-depth" h) 0)))
        (call e "heap-release" h held) (call e "heap-collect" h)
        (let ((result (call e "value-primitive-step" h input 0)))
          (js-call assert :strictEqual (call e "last-error") 0) (js-call assert :strictEqual (rawRead e h result) 1)
          (assert (Object/is (rawRead e h input) -0)))
        (call e "heap-release" h input) (call e "heap-collect" h) (js-call assert :strictEqual (call e "heap-live" h) 0)
        (let* ((grown (call e "heap-new" 16 512 65536)) (value (rawNumber e grown globalThis.Number.MIN_VALUE)))
          (call e "heap-pin" grown value)
          (let* ((initial (call e "heap-capacity" grown))
                 (padding (call e "value-bytes" grown (- initial (call e "heap-used" grown) 32))))
            (assert padding) (call e "heap-pin" grown padding) (call e "heap-auto" grown 1)
            (let ((out (call e "value-primitive-step" grown value 1)))
              (js-call assert :strictEqual (call e "last-error") 0) (assert (> (call e "heap-capacity" grown) initial))
              (assert (Object/is (rawRead e grown out) (- globalThis.Number.MIN_VALUE 1)))
              (js-call assert :strictEqual (rawRead e grown value) globalThis.Number.MIN_VALUE))
            (call e "heap-release" grown value) (call e "heap-release" grown padding) (call e "heap-collect" grown)
            (js-call assert :strictEqual (call e "heap-live" grown) 0))))))
  (test "variadic arithmetic keeps left association and comparisons capture every argument before comparing"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes))
            (triples (js-array (js-array 1 1e16 -1e16) (js-array 1e16 -1e16 1)
              (js-array globalThis.Number.MAX_VALUE 2 .5) (js-array -0 0 -0) (js-array globalThis.NaN 1 2)
              (js-array 1 globalThis.NaN 2) (js-array 1 1 2) (js-array 1 2 1) (js-array 3 2 1)
              (js-array 0 1 1) (js-array globalThis.Infinity (- globalThis.Infinity) globalThis.Number.MIN_VALUE))))
        (js-call a :auto 1)
        (js-call triples :forEach (lambda (inputs)
          (js-call (js-array "ordered-sum" "ordered-product" "ordered-subtract" "ordered-divide" "equal-three"
            "distinct-three" "less-three" "compare-snapshot") :forEach (lambda (name) (check a name inputs)))))
        (check a "comparison-effects" (js-array 2 1)) (check a "comparison-effects" (js-array globalThis.NaN globalThis.NaN)))))
  (test "strict equality preserves primitive types, NaN and opaque identity independently of Map key equivalence"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (values (js-call (js-array nil false t undefined) :concat numbers (js-array "" "x" "中😀\ud800"))))
        (js-call a :auto 1)
        (js-call values :forEach (lambda (left) (js-call values :forEach (lambda (right)
          (js-call (js-array "equal" "identical" "distinct" "not-equal") :forEach (lambda (name) (check a name (js-array left right))))))))
        (let* ((object (js-call a :map)) (alias (js-call a :invoke "unary-add" (js-array object)))
               (other (js-call a :map)) (array (js-call a :array)) (nan (js-call a :number globalThis.NaN)))
          (js-call (js-array (js-array object alias t) (js-array object other false) (js-array object array false)
            (js-array array array t) (js-array object nil false)) :forEach (lambda (entry)
              (let ((args (js-array (aref entry 0) (aref entry 1))) (expected (aref entry 2)))
                (js-call assert :strictEqual (js-call a :invoke "equal" args) expected)
                (js-call assert :strictEqual (js-call a :invoke "identical" args) expected)
                (js-call assert :strictEqual (js-call a :invoke "distinct" args) (not expected)))))
          (assert (js-call a :keyEqual nan nan)) (js-call assert :strictEqual (js-call a :invoke "equal" (js-array nan nan)) false)
          (js-call (js-array nan object alias other array) :forEach (lambda (value) (js-call a :release value))))
        (js-call a :collect) (js-call assert :strictEqual (js-call a :live) 0))))
  (test "UTF16 relational comparisons use code unit order including NUL and unpaired surrogates"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)) (values (js-array "" "a" "aa" "\u0000" "中" "😀" "\ud800" "\udfff" "\ud800x")))
        (js-call a :auto 1)
        (js-call values :forEach (lambda (x) (js-call values :forEach (lambda (y)
          (js-call (js-array "less" "less-equal" "greater" "greater-equal") :forEach (lambda (name) (check a name (js-array x y))))))))
        (js-call values :forEach (lambda (x) (check a "unary-multiply" (js-array x)))))))
  (test "ordinary numeric loops and recursive calls reclaim expression temporaries and retain caller roots"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes (js-object :maxSlots 256 :initialBytes 8192 :maxBytes 1048576))))
        (js-call a :auto 1)
        (js-call (js-array "sum-to" "recursive-sum") :forEach (lambda (name)
          (js-call (js-array 0 1 8 32) :forEach (lambda (n) (check a name (js-array n))))))
        (let ((index 0)) (while (< index 100) (check a "sum-to" (js-array 32)) (setq index (1+ index))))
        (assert (> (get (js-call a :stats) :collections) 1000)))))
  (test "arithmetic type or capacity failures unwind their frames without evaluating a later trapping expression"
    (async ()
      (let* ((source (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
             (start (js-call source :indexOf "  (defun value-truth (heap value)"))
             (end (js-call source :indexOf "  (defun " (+ start 3))))
        (assert (and (>= start 0) (> end start)))
        (let* ((injected (js-call (get backend :compiler) :compile_ir_string
                  (+ (js-call source :slice 0 start) "  (defun value-truth (heap value) (load-u32 4294967295))\n" (js-call source :slice end)) "later-trap.eli"))
               (original (js-call (get backend :compiler) :compile_ir_string
                  "(defun first-error (x y) (+ (+ x y) (if x 1 2))) (export first-error)" "first-error.eli"))
               (a (instantiateManagedRuntime (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm original injected))))
               (text (js-call a :sourceObject (js-object :valueOf t :toString t))) (n (js-call a :number 2)) (frame (js-call a :frame 1)))
          (js-call a :frameSet frame 0 n)
          (js-call assert :throws (lambda () (js-call a :invoke "first-error" (js-array text n))) (lambda (e) (error-code e "ELI-RT0003")))
          (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
          (js-call assert :throws (lambda () (js-call a :invoke "first-error" (js-array n n))) globalThis.WebAssembly.RuntimeError)
          (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
          (let ((saved (js-call a :frameGet frame 0))) (js-call assert :strictEqual (js-call a :readNumber saved) 2) (js-call a :release saved))
          (js-call a :leaveFrame frame) (js-call a :release text) (js-call a :release n) (js-call a :collect)
          (js-call assert :strictEqual (js-call a :live) 0))
        (let* ((small (instantiateManagedRuntime bytes (js-object :maxSlots 8 :initialBytes 512 :maxBytes 512)))
               (_auto (js-call small :auto 1)) (input (js-call small :number -0))
               (caller (js-call small :frame 1)) (_root (js-call small :frameSet caller 0 input))
               (padding (js-array (js-call small :array) (js-call small :array))))
          (js-call assert :throws (lambda () (js-call small :invoke "sum-to" (js-array input))) (lambda (e) (error-code e "ELI-RT0002")))
          (js-call assert :strictEqual (get (js-call small :stats) :frameDepth) 1)
          (let ((retained (js-call small :frameGet caller 0))) (assert (Object/is (js-call small :readNumber retained) -0)) (js-call small :release retained))
          (js-call small :leaveFrame caller) (js-call padding :forEach (lambda (p) (js-call small :release p)))
          (js-call small :release input) (js-call small :collect) (js-call assert :strictEqual (js-call small :live) 0)))))
  (test "independent random float64 bit patterns preserve exact arithmetic results and strict relations"
    (lambda ()
      (let* ((state 102997105) (view (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
             (next (lambda () (setq state (bit-xor state (bit-shift-left state 13)))
               (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
               (setq state (bit-xor state (bit-shift-left state 5))) (uint32 state)))
             (random (lambda () (js-call view :setUint32 0 (funcall next) t) (js-call view :setUint32 4 (funcall next) t) (js-call view :getFloat64 0 t)))
             (a (instantiateManagedRuntime bytes)) (index 0))
        (js-call a :auto 1)
        (while (< index 512)
          (let ((pair (js-array (funcall random) (funcall random))))
            (js-call (js-array "add" "subtract" "multiply" "divide" "equal" "distinct" "less" "less-equal" "greater" "greater-equal") :forEach
              (lambda (name) (check a name pair)))) (setq index (1+ index))))))
  (test "ordinary object conversion agrees with JS while raw Number APIs and foreign or stale operands preserve caller roots"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)) (b (instantiateManagedRuntime bytes)))
        (check a "add" (js-array "1" 1)) (check a "negate" (js-array nil))
        (check a "less" (js-array "1" 1)) (check a "greater" (js-array t 1))
        (let* ((n (js-call a :number 1)) (s (js-call a :string "1")) (opaque (js-call a :sourceObject (js-object))) (foreign (js-call b :number 1)))
          (js-call assert :throws (lambda () (js-call a :binary s n 0)) (lambda (e) (error-code e "ELI-RT0001")))
          (js-call (js-array (js-array "add" (js-array opaque n) (js-array (js-object) 1))
            (js-array "negate" (js-array opaque) (js-array (js-object)))
            (js-array "less" (js-array opaque n) (js-array (js-object) 1))
            (js-array "greater" (js-array t opaque) (js-array t (js-object)))) :forEach (lambda (entry)
              (let* ((name (aref entry 0)) (out (js-call a :invoke name (aref entry 1))))
                (try (assert (Object/is (read a out) (Reflect/apply (get js name) undefined (aref entry 2))) name)
                  (finally (js-call a :release out))))
              (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0)))
          (js-call assert :throws (lambda () (js-call a :invoke "equal" (js-array foreign n))) (lambda (e) (error-code e "ELI-RT0001")))
          (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0) (js-call assert :strictEqual (js-call a :readNumber n) 1)
          (let ((stale (js-call a :number 3))) (js-call a :release stale) (js-call a :collect)
            (js-call assert :throws (lambda () (js-call a :invoke "equal" (js-array stale n))) (lambda (e) (error-code e "ELI-RT0001"))))
          (js-call b :release foreign) (js-call b :collect)
          (js-call a :release n) (js-call a :release s) (js-call a :release opaque) (js-call a :collect)
          (js-call assert :strictEqual (js-call a :live) 0)))))
  (test "Node independently executes the ordinary numeric artifact with exact signed zeros and strict NaN equality"
    (async ()
      (let ((path (resolve directory "arithmetic.wasm")))
        (await (writeFile path bytes))
        (let ((result (spawnSync "node" (js-array (resolve root "tests/helpers/managed-numeric-node.mjs") "arithmetic" path)
                        (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :strictEqual (get result :status) 0 (get result :stderr))))))
  (test "unsupported numeric operations remain rejected in dead branches and input IR stays immutable"
    (lambda ()
      (let ((before (JSON/stringify program)))
        (js-call (get backend :managed) :emit_managed_wasm program runtimeProgram)
        (js-call assert :strictEqual (JSON/stringify program) before))
      (js-call (js-array "(string-to-number x)" "(string-to-bigint x)") :forEach (lambda (expression)
        (let* ((supported (js-call (get backend :compiler) :compile_ir_string
                  (+ "(defun f (x) (if false " expression " x)) (export f)") "supported-number.eli"))
               (saved (JSON/stringify supported))
               (a (instantiateManagedRuntime (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm supported runtimeProgram))))
               (x (js-call a :string "unconverted")) (out (js-call a :invoke "f" (js-array x))))
          (assert (js-call a :keyEqual x out)) (js-call a :release out) (js-call a :release x) (js-call a :collect)
          (js-call assert :strictEqual (js-call a :live) 0) (js-call assert :strictEqual (JSON/stringify supported) saved))))
      (js-call (js-array
        (js-array "(int32 x 1)" "int32 expects 1 argument, got 2")
        (js-array "(bit-and x 1 2)" "bit-and expects 2 arguments, got 3")) :forEach (lambda (entry)
        (let ((ir (js-call (get backend :compiler) :compile_ir_string
                    (+ "(defun f (x) (if false " (aref entry 0) " x)) (export f)") "unsupported-number.eli")))
          (js-call assert :throws (lambda () (js-call (get backend :managed) :emit_managed_wasm ir runtimeProgram))
            (lambda (e)
              (let ((diagnostic (get e :eliscriptDiagnostic)))
                (js-call assert :ok diagnostic e)
                (js-call assert :strictEqual (get diagnostic :code) "ELI-B0001" e)
                (js-call assert :strictEqual (get diagnostic :message) (aref entry 1) e)
                (let* ((location (get diagnostic :location)) (start (get location :start)) (end (get location :end)))
                  (js-call assert :strictEqual (get location :file) "unsupported-number.eli" e)
                  (js-call assert :ok (>= (get start :offset) 0) e)
                  (js-call assert :ok (> (get end :offset) (get start :offset)) e)) t))))))))
)
