(module tests.compiler-matrix-archive-debug
  (import "node:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile readdir rm)
  (import "node:path" resolve join)
  (import "node:os" tmpdir)
  (import "node:buffer" Buffer)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/backends/compiler-matrix.mjs" archiveProduct)
  (import "../tools/backends/compiler-bootstrap.mjs" compilerDigest saveCompilerMetadata openCompilerArtifact)
  (import "../tools/backends/stage3-targets.mjs" authenticateStage3Targets)
  (import "../tools/backends/compiler-build.mjs" decodeCompilerBinary)
  (import "../tools/backends/compiler-debug.mjs" createCompilerDebugMap)
  (import "../tools/backends/compiler-metadata.mjs" readCompilerMetadata)
  (import "../tools/backends/compiler-session.mjs" encodeCompilerMetadata)

  (defasync workspace (operation)
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-archive-debug-")))))
      (try (await (funcall operation directory))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defun metadata-hash (value) (compilerDigest (encodeCompilerMetadata value)))

  (defun original-span-key (span)
    (JSON/stringify (js-array (get span :filename) (get span :start) (get span :end)
      (get span :line) (get span :column) (get span :endLine) (get span :endColumn))))

  (defun collect-original-spans (program spans)
    (let ((pending (js-array program)))
      (while (> (js-length pending) 0)
        (let ((value (js-call pending :pop)))
          (when (and value (= (value-type value) "object"))
            (when (get value :span nil)
              (js-call spans :set (original-span-key (get value :span)) (get value :span)))
            (js-call (Object/values value) :forEach (lambda (child)
              (when (and child (= (value-type child) "object")) (js-call pending :push child))))))))
    spans)

  (defun assert-managed-user-ranges (response modules spans)
    (let* ((debug (get response :debug)) (mapping (createCompilerDebugMap debug))
           (bytes (decodeCompilerBinary (get response :bytes))) (before (compilerDigest bytes)))
      (js-call assert :ok (> (js-length bytes) 0))
      (when (= (get response :target) "wasm")
        (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array)))
      (js-call modules :forEach (lambda (module)
        (let* ((filename (get module :filename))
               (ranges (js-call (get debug :ranges) :filter (lambda (range)
                 (let ((span (get range :span nil)))
                   (and span (= (get span :filename) filename) (> (get range :end) (get range :start)))))))
               (source (js-call (get debug :sources) :find (lambda (item) (= (get item :filename) filename)))))
          (js-call assert :ok source)
          (js-call assert :strictEqual (get source :id) (get module :id))
          (js-call assert :strictEqual (Array/isArray (get source :macroOrigins)) t)
          (js-call assert :ok (> (js-length ranges) 0) (+ "actual user instruction spans: " filename))
          (js-call ranges :forEach (lambda (range)
            (let* ((span (get range :span)) (key (original-span-key span))
                   (mapped (js-call mapping :lookup (get range :start) (js-object :functionIndex (get range :functionIndex)))))
              (js-call assert :ok (js-call spans :has key))
              (js-call assert :deepStrictEqual span (js-call spans :get key))
              (js-call assert :ok mapped)
              (js-call assert :strictEqual (get (get mapped :span) :filename) filename)
              (js-call assert :strictEqual (get mapped :source) (get module :id))
              (js-call assert :ok (js-call spans :has (original-span-key (get mapped :span))))
              (js-call assert :strictEqual (get mapped :generated) false)))))))
      (js-call assert :strictEqual (compilerDigest bytes) before)))

  (test "authenticated stage3 managed projects retain exact user IR spans in actual WASM and native instruction ranges"
    (async ()
      (let* ((environment (get globalThis.process :env))
             (manifest (get environment :ELISCRIPT_BOOTSTRAP_MANIFEST (resolve root "dist/bootstrap-release/bootstrap.json")))
             (authentication (await (authenticateStage3Targets (js-object :bootstrapManifestPath manifest
                               :stage3MetadataPath (get environment :ELISCRIPT_TEST_COMPILER_ARTIFACT)))))
             (artifact (await (readCompilerMetadata (get authentication :stage3MetadataPath))))
             (session (progn
               (put artifact :metadataPath (get authentication :stage3MetadataPath))
               (await (openCompilerArtifact artifact))))
             (modules (js-array
               (js-object :id "dep.mjs" :filename "源/依赖😀.eli"
                 :source "(module debug.dep\n  (defun adjust (x) (+ x 7))\n  (export adjust))")
               (js-object :id "entry.mjs" :filename "源/入口😀.eli"
                 :source "(module debug.entry\n  (import \"./依赖😀.eli\" adjust)\n  (defun choose (x)\n    (let ((value (funcall adjust x)))\n      (if (> value 9) (* value 2) (- value 3))))\n  (defun second (x) (if x (+ 10 20) (+ 30 40)))\n  (export choose second))")))
             (spans (new globalThis.Map)) (failed false))
        (try
          (progn
            (await (js-call session :request (js-object :operation "runtime")))
            (let ((index 0))
              (while (< index (js-length modules))
                (let* ((module (aref modules index))
                       (response (await (js-call session :request (js-object :operation "compile-ir"
                         :source (get module :source) :filename (get module :filename))))))
                  (collect-original-spans (JSON/parse (get response :ir)) spans))
                (setq index (1+ index))))
            (let ((targets (js-array "wasm" "native")) (index 0))
              (while (< index 2)
                (let* ((target (aref targets index))
                       (request (js-object :operation "project" :target target :entry "entry.mjs"
                         :resolveImports t :phased t :modules modules :debug t :binaryEncoding "u16le-chunks"
                         :nativeTarget (if (= (get globalThis.process :platform) "darwin") "arm64-macos" "arm64-linux")
                         :nativeFormat "library"))
                       (response (await (js-call session :request request (js-object :responseMode "graph-events-v1")))))
                  (assert-managed-user-ranges response modules spans))
                (setq index (1+ index)))))
          (catch error (setq failed t) (throw error))
          (finally (try (await (js-call session :close)) (catch error (unless failed (throw error)))))))))

  (test "matrix archive keeps the complete independent debug file and snapshot identity while omitting its duplicate metadata graph"
    (async ()
      (await (workspace (async (directory)
        (let* ((shared (js-object :filename "源😀.eli" :start -0 :end 17
                        :nested (js-array globalThis.NaN globalThis.Infinity (- globalThis.Infinity))))
               (debug (js-object :format "archive-debug-fixture" :version 1
                        :source (js-call "\ufeff中😀\ud800x\udfff\u0000\n" :repeat 257)
                        :zero -0 :small Number/MIN_VALUE :large Number/MAX_VALUE
                        :first shared :second shared :values (js-array -0 globalThis.NaN globalThis.Infinity)))
               (typed (js-object :abi "memory-u32" :zero -0 :functions (js-array)))
               (descriptor (js-object :format "archive-descriptor-fixture" :offsets (js-array -0 17)))
               ;; The empty WASM header is actual byte data for archival. This
               ;; test does not claim to compile or execute a compiler product.
               (input (js-object :target "wasm" :entry "entry.mjs" :abi "memory-u32"
                        :bytes (globalThis.Uint8Array.of 0 97 115 109 1 0 0 0)
                        :typed typed :descriptor descriptor :debug debug))
               (snapshot (globalThis.structuredClone input))
               (path (join directory "product"))
               (pending (archiveProduct input "wasm" path)))
          ;; archiveProduct owns its full snapshot before the first await.
          (put debug :source "caller changed the source") (put debug :zero 0)
          (put shared :end 99) (put typed :zero 0) (put (get descriptor :offsets) 0 0)
          (js-call (get input :bytes) :fill 255)
          (let* ((product (await pending)) (actual-debug (get product :debug))
                 (debug-path (get product :debugPath))
                 (disk-debug (await (readCompilerMetadata debug-path)))
                 (metadata (await (readCompilerMetadata (join path "product.json"))))
                 (canonical-debug (encodeCompilerMetadata (get snapshot :debug)))
                 (normalized-debug (JSON/parse canonical-debug))
                 (debug-bytes (await (readFile debug-path))))
            (js-call assert :deepStrictEqual (await (readFile (get product :path)))
              (js-call Buffer :from (get snapshot :bytes)))
            (js-call assert :strictEqual debug-path (join path "debug.json"))
            (js-call assert :notStrictEqual actual-debug debug)
            (js-call assert :deepStrictEqual actual-debug (get snapshot :debug))
            (js-call assert :strictEqual (get actual-debug :first) (get actual-debug :second))
            (js-call assert :notStrictEqual (get actual-debug :first) shared)
            (js-call assert :ok (Object/is (get actual-debug :zero) -0))
            (js-call assert :ok (Object/is (get (get actual-debug :first) :start) -0))
            (js-call assert :ok (Number/isNaN (aref (get actual-debug :values) 1)))
            (js-call assert :strictEqual (aref (get actual-debug :values) 2) globalThis.Infinity)
            (js-call assert :deepStrictEqual disk-debug normalized-debug)
            (js-call assert :strictEqual (get disk-debug :source) (get (get snapshot :debug) :source))
            (js-call assert :ok (Object/is (get disk-debug :zero) -0))
            (js-call assert :deepStrictEqual (get (get disk-debug :first) :nested) (js-array nil nil nil))
            (js-call assert :deepStrictEqual debug-bytes (js-call Buffer :from (+ canonical-debug "\n")))
            (js-call assert :strictEqual (Object/hasOwn metadata "debug") false)
            (js-call assert :strictEqual (Object/hasOwn metadata "typed") false)
            (js-call assert :strictEqual (get metadata :debugPath) debug-path)
            (js-call assert :strictEqual (get product :debugSha256) (metadata-hash (get snapshot :debug)))
            (js-call assert :strictEqual (get metadata :debugSha256) (get product :debugSha256))
            (js-call assert :strictEqual (get product :typedSha256) (metadata-hash (get snapshot :typed)))
            (js-call assert :strictEqual (get metadata :typedSha256) (get product :typedSha256))
            (js-call assert :strictEqual (get product :descriptorSha256) (metadata-hash (get snapshot :descriptor)))
            (js-call assert :deepStrictEqual (get metadata :descriptor) (get snapshot :descriptor))
            (js-call assert :deepStrictEqual (get product :typed) (get snapshot :typed))
            (let ((identity (js-object :target "wasm" :abi "memory-u32"
                    :sha256 (compilerDigest (get snapshot :bytes))
                    :descriptorSha256 (metadata-hash (get snapshot :descriptor))
                    :typedSha256 (metadata-hash (get snapshot :typed))
                    :debugSha256 (metadata-hash (get snapshot :debug))
                    :nativeTarget undefined :nativeFormat undefined)))
              (js-call assert :strictEqual (get product :identitySha256) (compilerDigest (JSON/stringify identity)))
              (js-call assert :strictEqual (get metadata :identitySha256) (get product :identitySha256)))
            (let ((independent-path (join directory "independent-debug.json")))
              (await (saveCompilerMetadata independent-path (get snapshot :debug)))
              (js-call assert :deepStrictEqual (await (readFile independent-path)) debug-bytes)
              (js-call assert :deepStrictEqual (await (readCompilerMetadata independent-path)) normalized-debug))
            (let ((second (await (archiveProduct snapshot "wasm" (join directory "second")))))
              (js-call assert :strictEqual (get second :identitySha256) (get product :identitySha256))
              (js-call assert :notStrictEqual (get second :debug) actual-debug)
              (js-call assert :strictEqual (get (get second :debug) :first) (get (get second :debug) :second))
              (put (get actual-debug :first) :end 123)
              (js-call assert :strictEqual (get (get (get second :debug) :first) :end) 17)
              (js-call assert :deepStrictEqual (await (readCompilerMetadata debug-path)) normalized-debug)
              (js-call assert :deepStrictEqual (await (readFile (get second :debugPath))) debug-bytes)))))))))

  (test "matrix archive without a debug document keeps its previous absence and typed omission contract"
    (async ()
      (await (workspace (async (directory)
        (let* ((input (js-object :target "wasm" :entry "entry.mjs" :abi "memory-u32"
                        :bytes (js-array 0 97 115 109 1 0 0 0)
                        :typed (js-object :abi "memory-u32" :zero -0)))
               (product (await (archiveProduct input "wasm" directory)))
               (metadata (await (readCompilerMetadata (join directory "product.json")))))
          (js-call assert :strictEqual (Object/hasOwn product "debug") false)
          (js-call assert :strictEqual (Object/hasOwn product "debugPath") false)
          (js-call assert :strictEqual (Object/hasOwn metadata "debug") false)
          (js-call assert :strictEqual (Object/hasOwn metadata "debugPath") false)
          (js-call assert :strictEqual (Object/hasOwn metadata "debugSha256") false)
          (js-call assert :strictEqual (Object/hasOwn metadata "typed") false)
          (js-call assert :deepStrictEqual (await (readCompilerMetadata (join directory "typed.json"))) (get input :typed))
          (js-call assert :strictEqual (get metadata :typedSha256) (metadata-hash (get input :typed)))
          (js-call assert :strictEqual (get metadata :identitySha256) (get product :identitySha256))
          (js-call assert :strictEqual (js-call (await (readdir directory)) :includes "debug.json") false)))))))
  )
