(module tests.managed-source-view-decode
  (import "node:test" before after test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../tools/backends/managed-source-view.mjs" createManagedSourceView createManagedDecodedSourceView
    withManagedSourceDecode withManagedSourceBoundary registerManagedSourceDecodeRuntime
    isManagedSourceView isManagedSourceViewForRuntime)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntimeWithHostModules)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/backends/managed-module-graph.mjs" createManagedModuleGraph)

  (defun decoded-test-invoke (state name arguments)
    (js-call (get state :trace) :push name)
    (when (= name (get state :failOperation)) (throw (get state :failure)))
    (let ((source (get state :source)) (key (aref arguments 0)))
      (cond
        ((= name "keys") (Reflect/ownKeys source))
        ((= name "descriptor") (Reflect/getOwnPropertyDescriptor source key))
        ((= name "get")
          (put state :receiver (aref arguments 1)) (Reflect/get source key (aref arguments 1)))
        ((= name "set")
          (put state :receiver (aref arguments 2))
          (Reflect/set source key (aref arguments 1) (aref arguments 2)))
        ((= name "has") (Reflect/has source key))
        ((= name "define") (Reflect/defineProperty source key (aref arguments 1)))
        ((= name "delete") (Reflect/deleteProperty source key))
        ((= name "prototype") (Reflect/getPrototypeOf source))
        ((= name "setPrototype") (Reflect/setPrototypeOf source key))
        ((= name "extensible") (Reflect/isExtensible source))
        ((= name "preventExtensions") (Reflect/preventExtensions source))
        ((= name "apply") (Reflect/apply source key (aref arguments 1)))
        ((= name "construct") (Reflect/construct source key (aref arguments 1)))
        (t (throw (new globalThis.Error (str "unexpected source operation: " name)))))))

  (defun decoded-test-operations (state)
    (let ((operations (js-object)))
      (js-call (js-array "descriptor" "keys" "get" "set" "has" "define" "delete"
                        "prototype" "setPrototype" "extensible" "preventExtensions" "apply")
        :forEach (lambda (name)
          (put operations name (lambda (&rest arguments) (decoded-test-invoke state name arguments)))))
      (when (get state :constructible)
        (put operations :construct (lambda (&rest arguments) (decoded-test-invoke state "construct" arguments))))
      operations))

  (defun decoded-test-view (state target shared)
    (withManagedSourceDecode (lambda ()
      (if shared (createManagedDecodedSourceView (js-object :target target :state state :invoke decoded-test-invoke))
        (createManagedSourceView (js-object :target target :operations (decoded-test-operations state)))))))

  (test "private direct Get avoids descriptor decoding while public reflection and frozen invariants remain exact"
    (lambda ()
      (let* ((trace (js-array)) (child (js-object :value 17))
             (source (js-object :value -0.0)) (target (js-object))
             (state (js-object :source source :trace trace)) (receiver (js-object :marker 31))
             (_fixed (Object/defineProperty source "fixed"
               (js-object :value child :configurable false :writable false :enumerable t)))
             (_getter (Object/defineProperty source "accessor"
               (js-object :get (lambda () 23) :configurable t :enumerable t)))
             (view (withManagedSourceDecode (lambda ()
               (createManagedDecodedSourceView (js-object :target target :state state
                 :invoke decoded-test-invoke :directGet t)))))
             (proxy (get view :value)))
        (js-call assert :ok (Object/is (get proxy :value) -0.0))
        (js-call assert :strictEqual (Reflect/get proxy "accessor" receiver) 23)
        (js-call assert :strictEqual (get state :receiver) receiver)
        (js-call assert :strictEqual (get proxy :fixed) child)
        (js-call assert :deepStrictEqual trace (js-array "get" "get" "get"))
        (js-call assert :strictEqual (Object/hasOwn target "fixed") false)
        (let ((descriptor (Reflect/getOwnPropertyDescriptor proxy "fixed")))
          (js-call assert :strictEqual (get descriptor :value) child)
          (js-call assert :strictEqual (get descriptor :writable) false)
          (js-call assert :strictEqual (get descriptor :configurable) false)
          (js-call assert :strictEqual (get (Reflect/getOwnPropertyDescriptor target "fixed") :value) child))
        (Object/freeze proxy)
        (js-call assert :strictEqual (Object/isFrozen proxy) t)
        (js-call assert :strictEqual (Object/isFrozen source) t)
        (put trace :length 0)
        (js-call assert :strictEqual (get proxy :fixed) child)
        (js-call assert :ok (Object/is (get proxy :value) -0.0))
        (js-call assert :strictEqual (get proxy :accessor) 23)
        (js-call assert :deepStrictEqual trace (js-array "get" "get" "get"))
        (js-call assert :deepStrictEqual (Reflect/ownKeys proxy) (Reflect/ownKeys source)))))

  (test "private direct Get retains original false undefined throws over boundary failures and leaves the default contract intact"
    (lambda ()
      (js-call (js-array false undefined) :forEach (lambda (failure)
        (let* ((trace (js-array)) (source (js-object))
               (_getter (Object/defineProperty source "bad" (js-object
                 :get (lambda () (throw failure)) :configurable t)))
               (state (js-object :source source :trace trace))
               (observer-failed false)
               (observer (lambda () (when observer-failed (throw (new globalThis.Error "later observer")))))
               (view (withManagedSourceBoundary observer (lambda ()
                 (withManagedSourceDecode (lambda ()
                   (createManagedDecodedSourceView (js-object :target (js-object) :state state
                     :invoke decoded-test-invoke :directGet t)))))))
               (caught false) (actual nil))
          (setq observer-failed t)
          (try (get (get view :value) :bad) (catch error (setq caught t actual error)))
          (js-call assert :strictEqual caught t) (js-call assert :strictEqual actual failure)
          (js-call assert :deepStrictEqual trace (js-array "get")))))
      ;; Default private and public factories retain their existing descriptor
      ;; callback and first-throw order; the direct path is explicit and private.
      (let* ((trace (js-array)) (state (js-object :source (js-object :value 9) :trace trace))
             (view (decoded-test-view state (js-object) t)))
        (js-call assert :strictEqual (get (get view :value) :value) 9)
        (js-call assert :deepStrictEqual trace (js-array "descriptor" "get")))))

  (test "shared decoded handlers retain legacy receiver descriptor ownKeys and integrity operation order"
    (lambda ()
      (let ((reports (js-array)))
        (js-call (js-array false t) :forEach (lambda (shared)
          (let* ((trace (js-array)) (getter-reads 0) (symbol (funcall globalThis.Symbol "private"))
                 (source (js-object :first 1)) (target (js-object :stale 99))
                 (state (js-object :source source :trace trace))
                 (_accessor (Object/defineProperty source "accessor" (js-object
                   :get (lambda () (setq getter-reads (1+ getter-reads)) 23) :enumerable t :configurable t)))
                 (_symbol (Object/defineProperty source symbol
                   (js-object :value -0.0 :writable t :enumerable false :configurable t)))
                 (view (decoded-test-view state target shared)) (proxy (get view :value))
                 (receiver (js-object :receiver t)))
            (js-call assert :strictEqual (js-call view :refresh) proxy)
            (js-call assert :deepStrictEqual trace (js-array))
            (js-call assert :strictEqual (Reflect/get proxy "accessor" receiver) 23)
            (js-call assert :strictEqual (get state :receiver) receiver)
            (js-call assert :strictEqual getter-reads 1)
            (js-call assert :deepStrictEqual trace (js-array "descriptor" "get"))
            (put trace :length 0)
            (js-call assert :deepStrictEqual (Reflect/ownKeys proxy) (js-array "first" "accessor" symbol))
            (js-call assert :deepStrictEqual trace
              (js-array "keys" "extensible" "descriptor" "descriptor" "descriptor"))
            (js-call assert :strictEqual (Object/hasOwn target "stale") false)
            (js-call assert :strictEqual getter-reads 1)
            (put trace :length 0)
            (let ((descriptor (Reflect/getOwnPropertyDescriptor proxy "accessor")))
              (js-call assert :strictEqual (value-type (get descriptor :get)) "function")
              (js-call assert :strictEqual getter-reads 1))
            (js-call assert :strictEqual (Reflect/set proxy "first" 8 receiver) t)
            (js-call assert :strictEqual (get state :receiver) receiver)
            (js-call assert :strictEqual (get receiver :first) 8)
            (js-call assert :strictEqual (Reflect/defineProperty proxy "fixed"
              (js-object :value -0.0 :writable false :enumerable t :configurable false)) t)
            (js-call assert :ok (Object/is (get proxy :fixed) -0.0))
            (js-call assert :strictEqual (Reflect/deleteProperty proxy "fixed") false)
            (js-call assert :strictEqual (Reflect/deleteProperty proxy "first") t)
            (let ((prototype (js-object :inherited 17)))
              (js-call assert :strictEqual (Reflect/setPrototypeOf proxy prototype) t)
              (js-call assert :strictEqual (Reflect/getPrototypeOf proxy) prototype)
              (js-call assert :strictEqual (Reflect/has proxy "inherited") t))
            (put trace :length 0)
            (js-call assert :strictEqual (Reflect/preventExtensions proxy) t)
            (js-call assert :deepStrictEqual trace
              (js-array "preventExtensions" "keys" "extensible" "descriptor" "descriptor" "descriptor" "prototype"))
            (js-call assert :strictEqual (Reflect/isExtensible target) false)
            (js-call assert :strictEqual (Reflect/isExtensible proxy) false)
            (js-call assert :strictEqual (Reflect/defineProperty proxy "new" (js-object :value 1)) false)
            (Object/freeze proxy)
            (js-call assert :strictEqual (Object/isFrozen proxy) t)
            (js-call assert :strictEqual (Object/isFrozen source) t)
            (js-call reports :push (js-array getter-reads (Object/keys proxy)
              (get (Reflect/getOwnPropertyDescriptor proxy "accessor") :configurable)
              (Object/is (get proxy symbol) -0.0))))))
        (js-call assert :deepStrictEqual reports
          (js-array (js-array 1 (js-array "accessor" "fixed") false t)
                    (js-array 1 (js-array "accessor" "fixed") false t))))))

  (test "decoded shared operation boundaries retain owner registry realm and false undefined first throws"
    (lambda ()
      (js-call (js-array false undefined) :forEach (lambda (failure)
        (let* ((owner (js-object)) (alias (js-object)) (other (js-object)) (events (js-array))
               (_owner (registerManagedSourceDecodeRuntime owner owner (lambda (value) 0)))
               (_alias (registerManagedSourceDecodeRuntime alias owner))
               (_other (registerManagedSourceDecodeRuntime other other (lambda (value) 0)))
               (observer-failure false)
               (observer (lambda () (js-call events :push "observe")
                 (when observer-failure (throw (new globalThis.Error "later observer failure")))))
               (state (js-object :source (js-object :value 9) :trace events))
               (target (js-object))
               (view (withManagedSourceBoundary observer (lambda ()
                 (withManagedSourceDecode (lambda ()
                   (createManagedDecodedSourceView (js-object :target target :state state :invoke decoded-test-invoke))) owner))))
               (proxy (get view :value)))
          (js-call assert :strictEqual (isManagedSourceView proxy) t)
          (js-call assert :strictEqual (isManagedSourceView target) false)
          (js-call assert :strictEqual (isManagedSourceViewForRuntime proxy owner) t)
          (js-call assert :strictEqual (isManagedSourceViewForRuntime proxy alias) t)
          (js-call assert :strictEqual (isManagedSourceViewForRuntime proxy other) false)
          (js-call assert :strictEqual (get (js-call view :refresh) :value) 9)
          (put events :length 0)
          (put state :failOperation "descriptor") (put state :failure failure)
          (setq observer-failure t)
          (let ((caught false) (actual nil))
            (try (get proxy :value) (catch error (setq caught t actual error)))
            (js-call assert :strictEqual caught t) (js-call assert :strictEqual actual failure))
          (js-call assert :deepStrictEqual events (js-array "descriptor" "observe"))
          (put state :failOperation undefined) (setq observer-failure false)
          (put events :length 0)
          (js-call assert :strictEqual (get proxy :value) 9)
          (js-call assert :deepStrictEqual events (js-array "descriptor" "observe" "get" "observe"))
          ;; The failed private operation cannot leave the public factory in
          ;; deferred mode: its explicit refresh must still visit every key.
          (let* ((trace (js-array)) (public-state (js-object :source (js-object :a 1) :trace trace))
                 (public (createManagedDecodedSourceView (js-object :target (js-object)
                   :state public-state :invoke decoded-test-invoke))))
            (js-call public :refresh)
            (js-call assert :deepStrictEqual trace (js-array "keys" "extensible" "descriptor"))))))))

  (test "shared decoded callable handlers preserve apply construct and nonconstructible target rejection"
    (lambda ()
      (js-call (js-array false t "fallback") :forEach (lambda (shared)
        (let* ((state (js-object :source globalThis.Object :trace (js-array) :constructible t))
               (target (js-call globalThis.Object :bind nil))
               (view (if (= shared "fallback")
                 (createManagedDecodedSourceView (js-object :target target :state state :invoke decoded-test-invoke))
                 (decoded-test-view state target shared))) (proxy (get view :value))
               (receiver (js-object)) (argument (js-object :answer 42)))
          (js-call assert :strictEqual (Reflect/apply proxy receiver (js-array argument)) argument)
          (js-call assert :strictEqual (Reflect/construct proxy (js-array argument) globalThis.Object) argument)
          (js-call assert :deepStrictEqual (get state :trace) (js-array "apply" "construct")))
        (let* ((source (lambda () 31)) (state (js-object :source source :trace (js-array) :constructible false))
               (view (if (= shared "fallback")
                 (createManagedDecodedSourceView (js-object :target (lambda () nil) :state state :invoke decoded-test-invoke))
                 (decoded-test-view state (lambda () nil) shared))) (proxy (get view :value)))
          (js-call assert :strictEqual (Reflect/apply proxy nil (js-array)) 31)
          (js-call assert :throws (lambda () (Reflect/construct proxy (js-array))) globalThis.TypeError)
          (js-call assert :deepStrictEqual (get state :trace) (js-array "apply")))))))

  (defun deferred-chain-invoke (state name arguments)
    (let ((index (get state :index)) (key (aref arguments 0)) (reads (get state :reads)))
      (cond
        ((= name "keys") (js-call reads :push (str "keys:" index)) (js-array "next"))
        ((or (= name "descriptor") (= name "get"))
          (when (= name "descriptor") (js-call reads :push (str "descriptor:" index ":" key)))
          (when (= key "next")
            (let ((next (if (< (1+ index) (get state :count))
                          (funcall (get state :lookup) (1+ index)) nil)))
              (if (= name "get") next
                (js-object :value next :writable t :enumerable t :configurable t)))))
        ((= name "has") (= key "next"))
        ((= name "prototype") (get globalThis.Object :prototype))
        ((= name "extensible") t)
        (t false))))

  (defun deferred-chain (count)
    (let ((views (new globalThis.Map)) (reads (js-array)) (lookup undefined))
      (setq lookup (lambda (index)
        (let ((view (js-call views :get index)))
          (unless view
            (let* ((target (js-object))
                   (state (js-object :index index :count count :lookup lookup :reads reads)))
              (setq view (withManagedSourceDecode (lambda ()
                (createManagedDecodedSourceView (js-object :target target :state state :invoke deferred-chain-invoke)))))
              (js-call views :set index view)))
          ;; This is the same private call made by the actual host decoder.
          (js-call view :refresh)
          (get view :value))))
      (js-object :lookup lookup :views views :reads reads)))

  (test "private decoder publication does not visit an unobserved child graph and public reflection still reads the actual source"
    (lambda ()
      (let* ((state (deferred-chain 20000)) (first (funcall (get state :lookup) 0)))
        (js-call assert :strictEqual (get (get state :views) :size) 1)
        (js-call assert :deepStrictEqual (get state :reads) (js-array))
        (let ((next (get first :next)))
          (js-call assert :strictEqual next (funcall (get state :lookup) 1))
          (js-call assert :strictEqual (get (get state :views) :size) 2)
          (js-call assert :deepStrictEqual (Object/keys first) (js-array "next"))
          (let ((descriptor (Object/getOwnPropertyDescriptor first "next")))
            (js-call assert :strictEqual (get descriptor :value) next)
            (js-call assert :strictEqual (get descriptor :writable) t)
            (js-call assert :strictEqual (get descriptor :enumerable) t)
            (js-call assert :strictEqual (get descriptor :configurable) t))
          (js-call assert :strictEqual (get (get state :views) :size) 2)))))

  (test "private decode context restores on false and undefined throws without weakening the original public full refresh contract"
    (lambda ()
      (let ((failures (js-array false undefined)) (index 0))
        (while (< index (js-length failures))
          (let ((failure (aref failures index)) (caught false) (actual nil) (reads 0))
            (try (withManagedSourceDecode (lambda () (throw failure)))
              (catch error (setq caught t actual error)))
            (js-call assert :strictEqual caught t) (js-call assert :strictEqual actual failure)
            (let* ((value (js-object))
                   (view (createManagedSourceView (js-object :target value :operations (js-object
                     :keys (lambda () (setq reads (1+ reads)) (js-array))
                     :extensible (lambda () t))))))
              (js-call view :refresh)
              (js-call assert :strictEqual reads 1)))
          (setq index (1+ index))))))

  (defconst source (js-call (js-array
    "(defvar shared (js-object :deep (js-object :value 1)))"
    "(defun node (previous) (js-object :shared shared :previous previous))"
    "(defun mutate (value) (put (get shared :deep) :value value) shared)"
    "(defun freezeChild () (Object/freeze (get shared :deep)))"
    "(defun sealChild () (Object/seal (get shared :deep)))"
    "(defun bad (value) (Object/defineProperty shared \"bad\""
    "  (js-object :configurable t :get (lambda () (throw value)))) shared)"
    "(defun recover () (Reflect/deleteProperty shared \"bad\") shared)"
    "(defvar array (js-array -0.0 globalThis/undefined 7))"
    "(defun arrayValue () array)"
    "(defun arrayRead (key receiver) (Reflect/get array key receiver))"
    "(defun arrayLength (length) (put array \"length\" length) array)"
    "(export shared node mutate freezeChild sealChild bad recover arrayValue arrayRead arrayLength)") :join "\n"))
  (defvar directory undefined) (defvar bytes undefined) (defvar lowered undefined)
  (defvar library undefined)
  (defconst native-target (when (= (get globalThis.process :arch) "arm64")
    (cond ((= (get globalThis.process :platform) "darwin") "arm64-macos")
          ((= (get globalThis.process :platform) "linux") "arm64-linux"))))
  (before (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-lazy-source-decoder-"))))
    (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
           (compiler (get backend :compiler))
           (program (js-call compiler :compile_ir_string source "decoder-project.eli"))
           (runtime (js-call compiler :compile_ir_string
             (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli")))
      (setq lowered (js-call (get backend :managed) :lower_managed_project
        (js-array (js-object :id "entry.mjs" :program program)) "entry.mjs" runtime (js-object :phased t)))
      (setq bytes (globalThis.Uint8Array.from (js-call (get backend :wasm) :append_metadata_section
        (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed))
        "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (when native-target
        (setq library (resolve directory (if (= native-target "arm64-macos") "decode.dylib" "decode.so")))
        (await (writeFile library (globalThis.Uint8Array.from
          (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target)))))))
    (js-object :timeout 120000))
  (after (async () (when directory (await (rm directory (js-object :recursive t :force t))))))

  (defun exercise (runtime graph)
    (let ((project (get runtime :project)) (roots (js-array)) (failed false))
      (try
        (progn
          (js-call runtime :auto 65536)
          (js-call graph :prepare)
          (js-call (get (get (get lowered :descriptor) :project) :modules) :forEach (lambda (module)
            (js-call (get module :steps) :forEach (lambda (step) (js-call graph :step (get step :run))))))
          (js-call assert :strictEqual (get runtime :project) project)
          (let* ((raw (js-call runtime :invoke "arrayValue" (js-array)))
                 (_raw (js-call roots :push raw))
                 (array (js-call runtime :toHostValue raw))
                 (array-get (lambda (key)
                   (let ((key-value (js-call runtime :fromHostValue key)))
                     (try
                       (let ((result (js-call runtime :invoke "arrayRead" (js-array key-value raw))))
                         (try (js-call runtime :toHostValue result)
                           (finally (js-call runtime :release result))))
                       (finally (js-call runtime :release key-value)))))))
            (js-call assert :ok (Object/is (aref array 0) -0.0))
            (js-call assert :ok (Object/is (funcall array-get "0") -0.0))
            (js-call assert :strictEqual (aref array 1) undefined)
            (js-call assert :strictEqual (funcall array-get "1") undefined)
            (js-call assert :strictEqual (funcall array-get "length") 3)
            (js-call assert :strictEqual (Reflect/deleteProperty array "2") t)
            (js-call assert :strictEqual (Object/hasOwn array "2") false)
            (js-call assert :strictEqual (funcall array-get "2") undefined)
            (let ((length (js-call runtime :number 5)))
              (try
                (let ((result (js-call runtime :invoke "arrayLength" (js-array length))))
                  (try (js-call assert :strictEqual (js-call runtime :toHostValue result) array)
                    (finally (js-call runtime :release result))))
                (finally (js-call runtime :release length))))
            (js-call assert :strictEqual (get array :length) 5)
            (js-call assert :strictEqual (funcall array-get "length") 5)
            (Object/freeze array)
            (js-call assert :strictEqual (Object/isFrozen array) t)
            (js-call assert :ok (Object/is (funcall array-get "0") -0.0))
            (js-call assert :strictEqual (funcall array-get "1") undefined)
            (let ((entry (Reflect/getOwnPropertyDescriptor array "0")))
              (js-call assert :ok (Object/is (get entry :value) -0.0))
              (js-call assert :strictEqual (get entry :writable) false)
              (js-call assert :strictEqual (get entry :configurable) false)))
          (let* ((first (js-call runtime :invoke "node" (js-array nil)))
                 (_first (js-call roots :push first))
                 (host (js-call runtime :toHostValue first))
                 (shared (get host :shared)) (deep (get shared :deep))
                 (value (js-call runtime :number -0.0)))
            (js-call roots :push value)
            (let ((changed (js-call runtime :invoke "mutate" (js-array value))))
              (try (js-call assert :strictEqual (js-call runtime :toHostValue changed) shared)
                (finally (js-call runtime :release changed))))
            (js-call runtime :collect)
            (js-call assert :strictEqual (get host :shared) shared)
            (js-call assert :strictEqual (get shared :deep) deep)
            (js-call assert :ok (Object/is (get deep :value) -0.0))
            (let ((descriptor (Object/getOwnPropertyDescriptor deep "value")))
              (js-call assert :ok (Object/is (get descriptor :value) -0.0))
              (js-call assert :strictEqual (get descriptor :writable) t))
            (let ((descriptor (Object/getOwnPropertyDescriptor shared "deep")))
              (js-call assert :strictEqual (get descriptor :value) deep)
              (js-call assert :strictEqual (get descriptor :enumerable) t)
              (js-call assert :strictEqual (Object/hasOwn shared "deep") t)
              (js-call assert :strictEqual (Object/hasOwn shared "eliscript.zipper/branch") false))
            (let ((second (js-call runtime :invoke "node" (js-array first))))
              (try
                (let ((next (js-call runtime :toHostValue second)))
                  (js-call assert :strictEqual (get next :previous) host)
                  (js-call assert :strictEqual (get next :shared) shared))
                (finally (js-call runtime :release second))))
            (js-call (js-array false undefined) :forEach (lambda (failure)
              (let ((result (js-call runtime :invoke "bad" (js-array failure))) (caught false) (actual nil))
                (try
                  (js-call assert :strictEqual (js-call runtime :toHostValue result) shared)
                  ;; Presence and descriptor reflection must not perform Get,
                  ;; including when Get would throw false or undefined.
                  (js-call assert :strictEqual (Object/hasOwn shared "bad") t)
                  (let ((descriptor (Object/getOwnPropertyDescriptor shared "bad")))
                    (js-call assert :strictEqual (value-type (get descriptor :get)) "function")
                    (js-call assert :strictEqual (Object/hasOwn descriptor "value") false))
                  (try (get shared :bad) (catch error (setq caught t actual error)))
                  (js-call assert :strictEqual caught t) (js-call assert :strictEqual actual failure)
                  (finally (js-call runtime :release result))))
              (let ((result (js-call runtime :invoke "recover" (js-array))))
                (try (js-call assert :strictEqual (js-call runtime :toHostValue result) shared)
                  (finally (js-call runtime :release result))))))
            (let ((sealed (js-call runtime :invoke "sealChild" (js-array))))
              (try (js-call assert :strictEqual (js-call runtime :toHostValue sealed) deep)
                (finally (js-call runtime :release sealed))))
            (js-call assert :strictEqual (Object/isSealed deep) t)
            (let ((frozen (js-call runtime :invoke "freezeChild" (js-array))))
              (try (js-call assert :strictEqual (js-call runtime :toHostValue frozen) deep)
                (finally (js-call runtime :release frozen))))
            (js-call assert :strictEqual (Object/isFrozen deep) t)
            (js-call assert :strictEqual (get (Object/getOwnPropertyDescriptor deep "value") :writable) false)
            (js-call assert :ok (Object/is (get deep :value) -0.0))
            (js-call runtime :collect)
            (js-call assert :strictEqual (get host :shared) shared)))
        (catch error (setq failed t) (throw error))
        (finally
          (try
            (js-call roots :forEach (lambda (value) (js-call runtime :release value)))
            (js-call runtime :closeModule) (js-call runtime :collect)
            (js-call assert :strictEqual (js-call runtime :live) 0)
            (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
            (when (get runtime :close) (js-call runtime :close))
            (catch cleanup (unless failed (throw cleanup))))))))
  (test "actual WASM factory preserves private lazy shared views nested mutation reflection errors and original project transport identity"
    (async ()
      (let* ((graph (createManagedModuleGraph (get lowered :descriptor)))
             (runtime (await (instantiateManagedRuntimeWithHostModules bytes
               (js-object :moduleGraph graph :initializeModule false
                 :maxSlots 4096 :initialBytes 1048576 :maxBytes 16777216)))))
        (exercise runtime graph))))
  (test "actual native factory preserves the same live nested view identities reflection and GC roots without replacing its attached project"
    (js-object :skip (not native-target))
    (async ()
      (let* ((graph (createManagedModuleGraph (get lowered :descriptor)))
             (runtime (await (instantiateNativeManagedRuntime library lowered
               (js-object :moduleGraph graph :initializeModule false :nativeTarget native-target
                 :maxSlots 4096 :initialBytes 1048576 :maxBytes 16777216)))))
        (exercise runtime graph)))))
