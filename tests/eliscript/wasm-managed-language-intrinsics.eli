(module tests.wasm-managed-language-intrinsics
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs"
    instantiateManagedRuntime instantiateManagedRuntimeWithHostModules createManagedModuleGraph)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "./helpers/managed-numeric-selfhosted.mjs" loadReference)
  (defvar directory undefined) (defvar backend undefined) (defvar runtime-ir undefined)
  (defvar program undefined) (defvar bytes undefined) (defvar reference undefined)
  (defvar exception-image undefined) (defvar exception-descriptor undefined)
  (defconst native-supported (and (= (get globalThis.process :arch) "arm64")
    (js-call (js-array "darwin" "linux") :includes (get globalThis.process :platform))))
  (defconst native-target (if (= (get globalThis.process :platform) "linux") "arm64-linux" "arm64-macos"))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-language-intrinsics-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime-ir (js-call (get backend :compiler) :compile_ir_string
      (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
    (setq program (js-call (get backend :compiler) :compile_ir_string
      (await (readFile (resolve root "tests/fixtures/wasm-managed-language-intrinsics.eli") "utf8")) "language-intrinsics.eli"))
    (setq bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime-ir)))
    (js-call assert :strictEqual (globalThis.WebAssembly.validate bytes) t)
    (setq reference (await (loadReference (resolve directory "reference.mjs")
      (js-call (get backend :compiler) :emit_ir_string program))))
    (await (writeFile (resolve directory "program.wasm") bytes))
    (let* ((source (await (readFile (resolve root "tests/fixtures/exceptions.eli") "utf8")))
           (ir (js-call (get backend :compiler) :compile_ir_string source "tests/fixtures/exceptions.eli"))
           (modules (js-array (js-object :id "exceptions.mjs" :program ir)))
           (options (js-object :phased t))
           (lowered (js-call (get backend :managed) :lower_managed_project modules "exceptions.mjs" runtime-ir options)))
      (setq exception-descriptor (get lowered :descriptor))
      (setq exception-image (globalThis.Uint8Array.from
        (js-call (get backend :managed) :emit_managed_project_wasm modules "exceptions.mjs" runtime-ir options))))) 120000)
  (afterAll (async ()
    (setq backend undefined runtime-ir undefined program undefined bytes undefined reference undefined)
    (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defun finish (runtime)
    (js-call runtime :closeModule) (js-call runtime :collect)
    (js-call assert :strictEqual (js-call runtime :live) 0)
    (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
  (defun assert-source-imports (imports required)
    (js-call assert :deepStrictEqual
      (js-call imports :map (lambda (entry)
        (js-object :module (get entry :module) :name (get entry :name) :kind (get entry :kind))))
      (if required
        (js-array (js-object :module "eliscript.host" :name "source-operation" :kind "function"))
        (js-array)))
    (js-call imports :forEach (lambda (entry)
      (when (Object/hasOwn entry "type")
        (js-call assert :deepStrictEqual (get entry :type)
          (js-object :parameters (js-array "i32" "i32") :results (js-array "i32")))))))
  (defun box (runtime input)
    (cond ((= (value-type input) "string") (js-call runtime :string input))
          ((= (value-type input) "number") (js-call runtime :number input))
          ((= (value-type input) "bigint") (js-call runtime :bigint input)) (t input)))
  (defun read-error-field (runtime error name)
    (let ((key (js-call runtime :string name)) (value undefined))
      (try
        (setq value (js-call runtime :objectGet error key))
        (js-call runtime :readString value)
        (finally (js-call runtime :release value) (js-call runtime :release key)))))
  (defun primitive-result (runtime value)
    (cond ((or (eq value nil) (eq value false) (eq value t) (undefined? value)) value)
      ((= (get value :kind) 4) (js-call runtime :readNumber value))
      ((= (get value :kind) 14)
        (let ((out (js-array)) (index 0))
          (while (< index (js-call runtime :length value))
            (let ((child (js-call runtime :get value index)))
              (try (js-call out :push (primitive-result runtime child))
                (finally (js-call runtime :release child))))
            (setq index (1+ index))) out))
      (t (js-call assert :fail "unexpected qualified primitive result"))))
  (defun qualified-export-name (descriptor name)
    (if (undefined? descriptor) name
      (let* ((public-name (js-call name :replaceAll "-" "_"))
             (entry (js-call (get descriptor :functions) :find
                      (lambda (item) (= (get item :name) public-name)))))
        (js-call assert :ok entry (str "missing qualified project export " public-name))
        (get entry :name))))
  (defun primitive-invoke (runtime name args descriptor)
    (let ((value undefined))
      (try (setq value (js-call runtime :invoke (qualified-export-name descriptor name) args)) (primitive-result runtime value)
        (finally (js-call runtime :release value)))))
  (defun check-qualified-primitives (runtime descriptor)
    (js-call runtime :auto 1)
    (js-call (js-array "qualified-undefined" "qualified-numbers" "qualified-getters" "qualified-number-shadow")
      :forEach (lambda (name)
        (js-call assert :deepStrictEqual (primitive-invoke runtime name (js-array) descriptor)
          (funcall (get reference (js-call name :replaceAll "-" "_"))))))
    (js-call assert :deepStrictEqual (primitive-invoke runtime "qualified-undefined" (js-array) descriptor)
      (js-array undefined undefined))
    (js-call assert :deepStrictEqual (primitive-invoke runtime "qualified-numbers" (js-array) descriptor)
      (js-array globalThis.NaN globalThis.NaN globalThis.Infinity globalThis.Infinity))
    (let ((inputs (js-array nil undefined false t -0 globalThis.NaN globalThis.Infinity "")) (index 0))
      (while (< index (js-length inputs))
        (let* ((input (aref inputs index)) (value (box runtime input)))
          (try (js-call assert :strictEqual (primitive-invoke runtime "qualified-nullish" (js-array value) descriptor)
                 (js-call reference :qualified_nullish input))
            (finally (js-call runtime :release value))))
        (setq index (1+ index))))
    (let* ((zero (js-call runtime :number -0)) (nan (js-call runtime :number 17))
           (infinity (js-call runtime :number 23)) (owner undefined) (trace undefined))
      (try
        (setq owner (js-call runtime :sourceObject (js-object :undefined zero :NaN nan :Infinity infinity)))
        (js-call assert :deepStrictEqual (primitive-invoke runtime "qualified-shadow" (js-array owner) descriptor)
          (js-call reference :qualified_shadow (js-object :undefined -0 :NaN 17 :Infinity 23)))
        (js-call assert :ok (Object/is (primitive-invoke runtime "qualified-capture" (js-array owner) descriptor) -0))
        (js-call assert :throws (lambda () (js-call reference :qualified_null_root)) globalThis.TypeError)
        (js-call assert :throws (lambda () (js-call runtime :invoke (qualified-export-name descriptor "qualified-null-root")))
          (lambda (error) (and (js-call (get globalThis.TypeError :prototype) :isPrototypeOf error)
            (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0001"))))
        (setq trace (js-call runtime :sourceArray (js-array zero)))
        (let ((expected (js-array -0)))
          (js-call assert :throws (lambda () (js-call reference :qualified_callee expected)) globalThis.TypeError)
          (js-call assert :throws (lambda () (js-call runtime :invoke (qualified-export-name descriptor "qualified-callee") (js-array trace)))
            (lambda (error) (and (js-call (get globalThis.TypeError :prototype) :isPrototypeOf error)
              (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0003"))))
          (js-call assert :deepStrictEqual (primitive-result runtime trace) expected))
        (js-call assert :deepStrictEqual (primitive-invoke runtime "qualified-undefined" (js-array) descriptor)
          (js-array undefined undefined))
        (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
        (finally (js-call runtime :release trace) (js-call runtime :release owner)
          (js-call runtime :release infinity) (js-call runtime :release nan) (js-call runtime :release zero)))))
  (defun exception-phase (label)
    (try (js-call (get globalThis.process :stderr) :write (str "[exceptions-phase] " label "\n"))
      (catch ignored nil)))
  (test "qualified global primitive constants preserve nullish IEEE shadowing and abrupt recovery in standalone WASM"
    (lambda ()
      (let ((runtime (instantiateManagedRuntime bytes)))
        (try (check-qualified-primitives runtime undefined) (finally (finish runtime))))))
  (test "linked WASM and native keep global primitives distinct from real module globalThis bindings and unknown references"
    (async ()
      (let* ((shadow-source (str "(defvar globalThis (js-object :undefined -0 :NaN 17 :Infinity 23)) "
                             "(defun global-shadow () (+ globalThis/undefined globalThis.NaN globalThis/Infinity)) "
                             "(defun global-shadow-update (value) (put globalThis :undefined value)) "
                             "(export global-shadow global-shadow-update)"))
             (shadow (js-call (get backend :compiler) :compile_ir_string shadow-source "qualified-shadow.eli"))
             (shadow-reference (await (loadReference (resolve directory "qualified-shadow-reference.mjs")
               (js-call (get backend :compiler) :emit_ir_string shadow))))
             (modules (js-array (js-object :id "entry.mjs" :program program)
                         (js-object :id "shadow.mjs" :program shadow)))
             (saved (JSON/stringify modules))
             (lowered (js-call (get backend :managed) :lower_managed_project
               modules "entry.mjs" runtime-ir (js-object :phased t)))
             (descriptor (get lowered :descriptor))
             (targets (if native-supported (js-array "wasm" "native") (js-array "wasm"))) (index 0))
        (js-call assert :strictEqual (JSON/stringify modules) saved)
        (while (< index (js-length targets))
          (let* ((target (aref targets index))
                 (options (js-object :initializeModule false :nativeTarget native-target)) (runtime undefined))
            (try
              (progn
                (if (= target "wasm")
                  (setq runtime (instantiateManagedRuntime (globalThis.Uint8Array.from
                    (js-call (get backend :wasm) :append_metadata_section
                      (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed))
                      "eliscript-managed-control" (JSON/stringify descriptor))) options))
                  (let ((path (resolve directory (if (= native-target "arm64-linux") "qualified.so" "qualified.dylib"))))
                    (await (writeFile path (globalThis.Uint8Array.from
                      (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target))))
                    (setq runtime (await (instantiateNativeManagedRuntime path lowered options)))))
                (js-call runtime :auto 1)
                (js-call (get runtime :project) :prepare)
                (js-call (get (get descriptor :project) :modules) :forEach (lambda (module)
                  (js-call (get module :steps) :forEach (lambda (step)
                    (js-call (get runtime :project) :run (get step :run))))))
                (check-qualified-primitives runtime descriptor)
                (let* ((module (js-call (get (get descriptor :project) :modules) :find
                                 (lambda (item) (= (get item :id) "shadow.mjs"))))
                       (exports (get module :exports))
                       (read (js-call exports :find (lambda (item) (= (get item :name) "global_shadow"))))
                       (write (js-call exports :find (lambda (item) (= (get item :name) "global_shadow_update"))))
                       (read-value (js-call (get runtime :project) :get (get read :kind) (get read :index)))
                       (write-value (js-call (get runtime :project) :get (get write :kind) (get write :index))))
                  (js-call shadow-reference :global_shadow_update -0)
                  (js-call assert :strictEqual (funcall read-value) (js-call shadow-reference :global_shadow))
                  (funcall write-value 9) (js-call shadow-reference :global_shadow_update 9)
                  (js-call assert :strictEqual (funcall read-value) (js-call shadow-reference :global_shadow))))
              (finally (when runtime (finish runtime) (when (get runtime :close) (js-call runtime :close))))))
          (setq index (1+ index)))
        (let* ((unknown (js-call (get backend :compiler) :compile_ir_string
                          "(defun f () globalThis/notAnIntrinsic) (export f)" "qualified-unknown.eli"))
               (before (JSON/stringify unknown)))
          (js-call assert :throws (lambda () (js-call (get backend :managed) :lower_managed_program unknown runtime-ir t))
            (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-B0001")))
          (js-call assert :strictEqual (JSON/stringify unknown) before)))) 120000)
  (test "string-to-bigint keeps exact BigInt conversion null fallback operand first error and GC reentry"
    (lambda ()
      (let ((runtime (instantiateManagedRuntime bytes))
            (inputs (js-array "0" "-0" " 42 " "0xFF" "0o17" "0b101" "9007199254740993123456789"
              "" "bad" "1.2" "1e3" "1N" "0x" nil undefined false t 42 -42 -0 1.5 globalThis.NaN globalThis.Infinity
              (globalThis.BigInt "9223372036854775808"))) (index 0))
        (js-call runtime :auto 1)
        (try
          (while (< index (js-length inputs))
            (let* ((input (aref inputs index)) (handle (box runtime input)) (value undefined))
              (try
                (setq value (js-call runtime :invoke "parse-bigint" (js-array handle)))
                (js-call assert :strictEqual (if (eq value nil) nil (js-call runtime :readBigInt value))
                  (js-call reference :parse_bigint input))
                (finally (js-call runtime :release value) (js-call runtime :release handle))))
            (js-call runtime :collect) (setq index (1+ index)))
          (js-call assert :strictEqual (js-call runtime :invoke "conversion-throw") nil)
          (let ((value (js-call runtime :invoke "conversion-reentry")))
            (try (js-call assert :strictEqual (js-call runtime :readBigInt value) (globalThis.BigInt 42))
              (finally (js-call runtime :release value))))
          (let ((failed false) (failure undefined))
            (try (js-call runtime :invoke "operand-first") (catch error (setq failed t failure error)))
            (js-call assert :strictEqual failed t) (js-call assert :strictEqual failure false))
          (let ((value (js-call runtime :invoke "choose")))
            (try (js-call assert :strictEqual (js-call runtime :readString value) "none")
              (finally (js-call runtime :release value))))
          (finally (finish runtime))))))
  (test "multi-arity retains zero and one dispatch and exact TypeError after evaluating every operand once"
    (lambda ()
      (let ((runtime (instantiateManagedRuntime bytes)))
        (js-call runtime :auto 1)
        (try
          (let* ((input (js-call runtime :number -0)) (out (js-call runtime :invoke "choose" (js-array input))))
            (try (js-call assert :strictEqual (Object/is (js-call runtime :readNumber out) -0) t)
              (finally (js-call runtime :release out) (js-call runtime :release input))))
          (let ((failed false) (failure undefined) (expected undefined))
            (try (js-call reference :choose 1 2) (catch error (setq expected error)))
            (let ((one (js-call runtime :number 1)) (two (js-call runtime :number 2)))
              (try (js-call runtime :invoke "choose" (js-array one two))
                (catch error (setq failed t failure error))
                (finally (js-call runtime :release one) (js-call runtime :release two))))
            (js-call assert :strictEqual failed t)
            ;; Raw invoke transfers an owned managed thrown value. pin checks
            ;; the actual runtime owner and generation, beyond its public kind.
            (let ((borrowed false))
              (try
                (js-call runtime :pin failure) (setq borrowed t)
                ;; Error field access is supported; full native Error own-key
                ;; reflection is a distinct, explicitly refused capability.
                (js-call assert :strictEqual (read-error-field runtime failure "name") "TypeError")
                (js-call assert :strictEqual (read-error-field runtime failure "message") (get expected :message))
                ;; Field reads do not transfer the caller's owned root.
                (js-call runtime :pin failure)
                (js-call runtime :release failure)
                (finally
                  (when borrowed
                    (js-call runtime :release failure)
                    (js-call runtime :release failure))))))
          (let ((out (js-call runtime :invoke "arity-order")))
            (try
              (let ((actual (js-array)) (index 0))
                (while (< index (js-call runtime :length out))
                  (let ((item (js-call runtime :get out index)))
                    (try (js-call actual :push (js-call runtime :readString item))
                      (finally (js-call runtime :release item)))) (setq index (1+ index)))
                (js-call assert :deepStrictEqual actual (js-call reference :arity_order)))
              (finally (js-call runtime :release out))))
          (finally (finish runtime))))))
  (test "module wrapped and bare portable projects publish real manifest bindings as their final initialization step"
    (lambda ()
      (let ((sources (js-array
              "(defportable f (x) x) (export f)"
              "(module portable.module (defportable f (x) x) (export f))")) (index 0))
        (while (< index (js-length sources))
          (let* ((ir (js-call (get backend :compiler) :compile_ir_string (aref sources index) "portable.eli"))
                 (saved (JSON/stringify ir))
                 (modules (js-array (js-object :id "portable.mjs" :program ir)))
                 (lowered (js-call (get backend :managed) :lower_managed_project modules "portable.mjs" runtime-ir (js-object :phased t)))
                 (descriptor (get lowered :descriptor)) (records (get (get descriptor :project) :modules))
                 (graph (createManagedModuleGraph descriptor))
                 (image (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_project_wasm
                          modules "portable.mjs" runtime-ir (js-object :phased t))))
                 (runtime (instantiateManagedRuntime image (js-object :initializeModule false))))
            (js-call runtime :auto 1)
            (js-call assert :strictEqual (JSON/stringify ir) saved)
            (js-call graph :close)
            (try
              (js-call (get runtime :project) :prepare)
              (js-call records :forEach (lambda (record)
                (let* ((binding (get record :portableBinding)) (steps (get record :steps))
                       (last (aref steps (1- (js-length steps)))))
                  (js-call assert :strictEqual (get binding :kind) 0)
                  (js-call assert :ok (js-call (get last :initializes) :some (lambda (item)
                    (and (= (get item :kind) 0) (= (get item :index) (get binding :index))))))
                  (js-call steps :forEach (lambda (step) (js-call (get runtime :project) :run (get step :run))))
                  (let ((manifest (js-call (get runtime :project) :get 0 (get binding :index))))
                    (js-call assert :deepStrictEqual (Object/keys manifest) (js-array "f"))
                    (js-call assert :strictEqual (Object/isFrozen manifest) t)
                    (js-call assert :strictEqual (funcall (get manifest :f) 42) 42)))))
              (finally (finish runtime))))
          (setq index (1+ index))))))
  (test "source and forged private portable metadata never authorize reserved user bindings"
    (lambda ()
      (let* ((ir (js-call (get backend :compiler) :compile_ir_string "(defconst fake 1) (export fake)" "forged.eli"))
             (saved (JSON/stringify ir))
             (declaration (aref (get ir :body) 0)) (export (aref (get (aref (get ir :body) 1) :children) 0)))
        (put declaration :value "__eliscript_portable__") (put export :value "__eliscript_portable__")
        (let ((before (JSON/stringify ir)))
          (js-call assert :throws (lambda () (js-call (get backend :managed) :lower_managed_project
            (js-array (js-object :id "forged.mjs" :program ir)) "forged.mjs" runtime-ir (js-object :phased t)))
            (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-B0001")))
          (js-call assert :strictEqual (JSON/stringify ir) before))
        (put ir :managedPortableManifest t) (put ir :managedPortableDeclaration declaration)
        (put ir :managedPortableReference export)
        (let ((before (JSON/stringify ir)))
          (js-call assert :throws (lambda () (js-call (get backend :managed) :lower_managed_project
            (js-array (js-object :id "forged.mjs" :program ir)) "forged.mjs" runtime-ir (js-object :phased t)))
            (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-I0001")))
          (js-call assert :strictEqual (JSON/stringify ir) before))
        (js-call assert :notStrictEqual (JSON/stringify ir) saved))))
  (test "independent Node executes the same ordinary BigInt artifact without host replacement"
    (lambda ()
      (let ((child (spawnSync "node" (js-array (resolve root "tests/managed-language-intrinsics-node.mjs")
                      (resolve directory "program.wasm") (resolve directory "reference.mjs"))
                    (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :strictEqual (get child :error) undefined)
        (js-call assert :strictEqual (get child :signal) nil)
        (js-call assert :strictEqual (get child :status) 0 (get child :stderr)))))
  (test "owned awaits retain zero imports while opaque values declare only their actual host operation"
    (lambda ()
      (let ((cases (js-array
              (js-array "(defasync f () (await 7)) (export f)" false)
              (js-array "(defasync f () (await (Promise/resolve 7))) (export f)" false)
              (js-array "(defasync f () (await (Promise/reject false))) (export f)" false)
              (js-array "(defasync f () (await (js-call globalThis.Promise :resolve 7))) (export f)" false)
              (js-array "(defasync f (value) (await value)) (export f)" t)
              (js-array "(defasync f (value) (await (Promise/resolve value))) (export f)" t)
              (js-array "(defasync f (Promise) (await (Promise/resolve 7))) (export f)" t)
              (js-array "(defasync f (value) (let ((globalThis value)) (await (js-call globalThis.Promise :resolve 7)))) (export f)" t)))
            (index 0))
        (while (< index (js-length cases))
          (let* ((item (aref cases index))
                 (ir (js-call (get backend :compiler) :compile_ir_string (aref item 0) "await-boundary.eli"))
                 (before (JSON/stringify ir))
                 (lowered (js-call (get backend :managed) :lower_managed_project
                   (js-array (js-object :id "entry.mjs" :program ir)) "entry.mjs" runtime-ir (js-object :phased t)))
                 (typed (get lowered :typed)) (descriptor (get lowered :descriptor))
                 (image (globalThis.Uint8Array.from (js-call (get backend :wasm) :emit_typed_memory_wasm typed)))
                 (imports (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module image))))
            (js-call assert :strictEqual (JSON/stringify ir) before)
            (assert-source-imports imports (aref item 1))
            (js-call assert :deepStrictEqual (get descriptor :hostCapabilities (js-array))
              (get typed :hostCapabilities (js-array))))
          (setq index (1+ index))))))
  (test "the original complete exceptions program preserves async catch finally and the unchanged shell golden"
    (async ()
      (exception-phase "imports-start")
      (assert-source-imports
        (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module exception-image)) t)
      (exception-phase "runtime-start")
      (let* ((graph (createManagedModuleGraph exception-descriptor))
             (runtime (await (instantiateManagedRuntimeWithHostModules exception-image
               (js-object :initializeModule false :moduleGraph graph))))
             (records (get (get exception-descriptor :project) :modules))
             (record (aref records 0)) (namespace (js-object)))
        (exception-phase "runtime-complete")
        (js-call assert :strictEqual (js-length records) 1)
        (js-call assert :strictEqual (get record :id) "exceptions.mjs")
        (js-call assert :strictEqual (get (get exception-descriptor :project) :entry) (get record :id))
        (js-call runtime :auto 1)
        (try
          (exception-phase "prepare-start")
          (js-call graph :prepare)
          (exception-phase "prepare-complete")
          (exception-phase "steps-start")
          (js-call (get record :steps) :forEach (lambda (step)
            (js-call graph :step (get step :run))))
          (exception-phase "steps-complete")
          (exception-phase "exports-start")
          (js-call (get record :exports) :forEach (lambda (binding)
            (Object/defineProperty namespace (get binding :name)
              (js-object :enumerable t :get (lambda ()
                (js-call (get runtime :project) :get (get binding :kind) (get binding :index)))))))
          (exception-phase "exports-complete")
          (let ((rethrown nil))
            (exception-phase "rethrow-start")
            (try (js-call namespace :rethrow) (catch error (setq rethrown error)))
            (exception-phase "rethrow-complete")
            (exception-phase "recover-three-start")
            (let ((recovered (js-call namespace :recover 3)))
              (exception-phase "recover-three-complete")
              (exception-phase "recover-zero-start")
              (let ((caught (js-call namespace :recover 0)))
                (exception-phase "recover-zero-complete")
                (exception-phase "finally-start")
                (let ((finalized (js-call namespace :finally_only 9)))
                  (exception-phase "finally-complete")
                  (exception-phase "fulfilled-start")
                  (let ((fulfilled (await (js-call namespace :settle (Promise/resolve 7)))))
                    (exception-phase "fulfilled-complete")
                    (exception-phase "rejected-start")
                    (let ((rejected (await (js-call namespace :settle (Promise/reject (new globalThis.Error "bad"))))))
                      (exception-phase "rejected-complete")
                      (exception-phase "cleanup-count-start")
                      (let ((count (get namespace :cleanup_count)))
                        (exception-phase "cleanup-count-complete")
                        (exception-phase "golden-start")
                        (js-call assert :deepStrictEqual
                          (js-array recovered caught finalized fulfilled rejected rethrown count)
                          (js-array 4 "caught:zero" 9 7 "async:bad" "inner:outer" 3))
                        (exception-phase "golden-complete"))))))))
          (finally
            (exception-phase "close-start")
            (finish runtime)
            (exception-phase "close-complete")))))))
