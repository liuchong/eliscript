  (defun managedContainerCases (kind)
    (cond
      ((= kind "objects") (js-object
      "object failures and real traps preserve original codes, caller frames, input properties and private-root cleanup" object-failures
      "unimplemented capabilities are source-bound refusals, supported IR is immutable, and foreign or retired handles cannot cross instances" object-capabilities
      "nullish object operators retain empty-own fallback semantics and validate keys without suppressing unsupported conversions" object-nullish
      "malformed named property IR is refused with its source location before child lowering" malformed-object-ir
      "a real trap inside a direct reader preserves the caller frame and does not strand argument or result roots" object-reader-trap
      "repeated literal access reuses existing sealed keys and collects only for the invocation frame" object-literal-performance))
      ((= kind "arrays") (js-object
        "array operations refuse invalid lengths, missing capabilities and stale/foreign handles without weakening input identity" array-capabilities
        "exact index boundaries, absent numeric keys and primitive length semantics agree without truncating or wrapping" array-boundaries
        "indexed source-array reads and existing string-key presence queries allocate no frames, text or collections" array-read-performance))
      ((= kind "builtins") (js-object
        "shadowed static methods capture lookup before argument effects and preserve nullish failure order" builtin-shadow
        "unsupported object conversion and actual builtin traps preserve effects, caller roots and original failures" builtin-trap
        "capacity failures during builtin conversion leave the module and caller frame usable" builtin-capacity
        "unimplemented constructors, mutable builtin properties and malformed raw IR stay explicitly refused" builtin-supported))
      ((= kind "identity") (js-object
        "shadowed globals and ordinary predicate methods retain captured lookup, all arguments and nullish failure order" identity-shadow
        "unimplemented reflection, mutable globals and raw executable JavaScript remain refused" identity-supported))
      (t (throw (new globalThis.TypeError "unknown maintained container suite")))))
  (export managedContainerCases prepareManagedContainer closeManagedContainer))
