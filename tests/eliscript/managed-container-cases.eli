  (defun code (expected)
    (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) expected)))
  (defun catches (operation)
    (let ((failed false) (actual undefined))
      (try (funcall operation) (catch error (setq failed t actual error)))
      (js-call assert :strictEqual failed t) actual))
  (defun check-refusal (input filename)
    (let ((before (JSON/stringify input)) (schemaFailed false) (schemaError undefined))
      (try (validate-serializable-program input) (catch error (setq schemaFailed t schemaError error)))
      (let ((actual (catches (lambda () (emit input runtime)))))
