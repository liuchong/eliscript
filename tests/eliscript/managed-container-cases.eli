(module tests.managed-container-cases
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../../tools/backends/build.mjs" buildBackends root)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime readManagedModuleMetadata)
  (import "../../tools/backends/compiler-build.mjs" independentCompilerResources)
  (import "../../dist/bootstrap/ir.mjs" validate-serializable-program)
  (import "./managed-numeric-selfhosted.mjs" loadReference)
  (defvar directory undefined)
  (defvar backend undefined)
  (defvar runtime undefined)
  (defvar runtime-source undefined)
  (defvar program undefined)
  (defvar bytes undefined)
  (defvar reference undefined)
  (defasync prepareManagedContainer (kind)
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-container-maintained-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime-source (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
    (setq runtime (js-call (get backend :compiler) :compile_ir_string runtime-source "runtime.eli"))
    (setq program (js-call (get backend :compiler) :compile_ir_string
      (if (= kind "identity") "(defconst identity-marker 1) (defun marker () 1) (export marker)"
        (await (readFile (resolve root (+ "tests/fixtures/wasm-managed-" kind ".eli")) "utf8"))) (+ kind ".eli")))
    (setq bytes (emit program runtime))
    (setq reference (await (loadReference (resolve directory "reference.mjs") (js-call (get backend :compiler) :emit_ir_string program)))))
  (defasync closeManagedContainer ()
    (when directory (await (rm directory (js-object :recursive t :force t))) (setq directory undefined)))
  (defun emit (input rt &optional options)
    (let ((output (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm input rt options))))
