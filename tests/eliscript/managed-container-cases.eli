          (progn (js-call assert :strictEqual (get (get actual :eliscriptDiagnostic) :code) "ELI-B0001")
            (js-call assert :strictEqual (get (get (get actual :eliscriptDiagnostic) :location) :file) filename))))
      (js-call assert :strictEqual (JSON/stringify input) before)))
  (defun replace-runtime-function (signature replacement filename)
    (let* ((start (js-call runtime-source :indexOf signature)) (end (js-call runtime-source :indexOf "  (defun " (+ start 10))))
      (js-call assert :ok (and (>= start 0) (> end start)))
      (js-call assert :strictEqual (js-call runtime-source :indexOf signature (1+ start)) -1)
      (js-call (get backend :compiler) :compile_ir_string
        (+ (js-call runtime-source :slice 0 start) replacement "\n" (js-call runtime-source :slice end)) filename)))
  (defun performance-check (label actual expected)
