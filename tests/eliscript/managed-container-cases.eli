    (let* ((a (make (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 4096)))
           (original (js-call a :invoke "empty" (js-array))) (keys (js-array)) (failed false) (index 0) (fillers (js-array)))
      (js-call a :auto 1)
      (while (and (< index 128) (not failed))
        (let ((key (js-call a :string (+ "k" index))))
