        (let ((key (js-call a :string name)))
          (try (js-call assert :strictEqual (js-call a :objectGet original key) t) (finally (js-call a :release key))))))
      (finish a (js-array original))))
  (defasync object-capabilities ()
    (let ((before (JSON/stringify program))) (emit program runtime) (js-call assert :strictEqual (JSON/stringify program) before))
    (let* ((text "(defun report () (let ((o (new globalThis.Object))) (put o :x 7) (js-array (js-call o :hasOwnProperty \"x\") (Object/is (Object/getPrototypeOf o) globalThis.Object.prototype)))) (export report)")
