(module tests.managed-function-properties-install
  (import "bun:test" :as framework)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "../../tools/backends/build.mjs" :as actual-build)
  (import "../../tools/testing/managed-function-properties-repairs.mjs" functionInitializationPressureTitle functionMissingDisposalTitle
    runFunctionInitializationSemantics runFunctionMissingDisposal)
  (import "./performance-acceptance.mjs" currentPerformanceTest)
  (defconst suite "tests/wasm-managed-function-properties.test.mjs")
  (defconst sha256 "dc63fc65ca9a84ff6faac3f7666774e162bef2d4375140e40a17480673c90ce7")
  (defconst original (Object/assign (js-object) framework))
  (defconst build (Object/assign (js-object) actual-build))
  (defconst root (get build :root))
  (js-call assert :ok (js-call (get globalThis.process :argv) :some (lambda (argument) (= (resolve root argument) (resolve root suite)))))
  (js-call assert :strictEqual (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root suite))) :digest "hex") sha256)
  (defvar backend undefined)
  (defvar runtime undefined)
  (defvar program undefined)
  (defvar pressure-count 0)
  (defvar disposal-count 0)
  (defvar normal-registered false)
  (defasync buildBackends (&rest arguments)
    (let* ((actual (await (Reflect/apply (get build :buildBackends) build arguments)))
           (compiler (get actual :compiler)) (descriptors (Object/getOwnPropertyDescriptors compiler))
           (entry (get descriptors :compile_ir_string)) (compile (get entry :value))
           (facade (Object/create (Object/getPrototypeOf compiler))))
      (put entry :value (lambda (&rest inputs)
        (let ((result (Reflect/apply compile compiler inputs)))
          (when (= (aref inputs 1) "runtime.eli") (setq runtime result))
          (when (= (aref inputs 1) "function-builtin.eli") (setq program result)) result)))
      (Object/defineProperties facade descriptors)
      (setq backend (Object/assign (js-object) actual (js-object :compiler facade))) backend))
  (js-call (get original :mock) :module (resolve root "tools/backends/build.mjs")
    (lambda () (Object/assign (js-object) build (js-object :buildBackends buildBackends))))
  (defconst replacement (new globalThis.Proxy (get original :test) (js-object
    :get (lambda (target key receiver)
      (let ((value (Reflect/get target key target)))
        (if (= (value-type value) "function") (js-call value :bind target) value)))
    :apply (lambda (target receiver arguments)
      (unless normal-registered
        (setq normal-registered t)
        (js-call original :test "normal function initialization preserves original unpressured and collecting cached identities and complete cleanup"
          (async () (await (runFunctionInitializationSemantics backend runtime program))) 120000))
      (let ((title (aref arguments 0)))
        (cond
          ((= title functionInitializationPressureTitle)
            (setq pressure-count (1+ pressure-count))
            (js-call assert :strictEqual pressure-count 1)
            ;; Strict execution keeps the complete original pressure callback.
            ;; Functional execution marks this original gate NOT ACCEPTED.
            (Reflect/apply (currentPerformanceTest target) receiver arguments))
          ((= title functionMissingDisposalTitle)
            (setq disposal-count (1+ disposal-count))
            (js-call assert :strictEqual disposal-count 1)
            (let ((forwarded (js-call arguments :slice)))
              (put forwarded 1 (async () (await (runFunctionMissingDisposal backend runtime program))))
              (Reflect/apply target receiver forwarded)))
          (t (Reflect/apply target receiver arguments))))))))
  (js-call (get original :mock) :module "bun:test" (lambda () (Object/assign (js-object) original (js-object :test replacement))))
  (js-call original :beforeAll (lambda ()
    (js-call assert :strictEqual normal-registered t)
    (js-call assert :strictEqual pressure-count 1) (js-call assert :strictEqual disposal-count 1)))
  (js-call original :afterAll (lambda ()
    (js-call (get original :mock) :module "bun:test" (lambda () original))
    (js-call (get original :mock) :module (resolve root "tools/backends/build.mjs") (lambda () build)))))
