(module tests.wasm-static-snapshot-install
  (import "bun:test" :as tests)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "../../tools/backends/build.mjs" :as framework)
  (import "../../tools/testing/wasm-static-snapshot.mjs" adaptStaticSnapshotCompiler)
  (import "../../tools/testing/wasm-static-repairs.mjs" staticSourceRefusalTitle staticFreshMemoTitle assertStaticSourceRefusals assertStaticFreshMemo)
  (defconst original (Object/assign (js-object) framework))
  (defconst original-tests (Object/assign (js-object) tests))
  (defconst mock (get original-tests :mock))
  (defconst root (get original :root))
  (defvar backend undefined)
  (defvar directory undefined)
  (defvar source-registrations 0)
  (defvar memo-registrations 0)
  (js-call assert :strictEqual (js-call (js-call (createHash "sha256") :update
    (readFileSync (resolve root "tests/wasm-memory-static-data-test-legacy.mjs"))) :digest "hex")
    "8265218c316f48bd22ef4eefaff5303ec5fa1208387ca9fb22afadcd85c2ef5a")
  (defasync buildBackends (&rest arguments)
    (let ((actual (await (Reflect/apply (get original :buildBackends) original arguments))))
      (setq directory (get (aref arguments 0) :outputRoot))
      (js-call assert :strictEqual (value-type directory) "string")
      (setq backend (Object/assign (js-object) actual (js-object :compiler
        (adaptStaticSnapshotCompiler (get actual :compiler) directory)))) backend))
  (defconst selected (Object/assign (js-object) original (js-object :buildBackends buildBackends)))
  (defconst replacement (new globalThis.Proxy (get original-tests :test) (js-object
    :get (lambda (target key receiver) (Reflect/get target key target))
    :apply (lambda (target receiver arguments)
      (let ((title (aref arguments 0)) (forwarded (js-call arguments :slice)))
        (cond
          ((= title staticSourceRefusalTitle)
            (setq source-registrations (1+ source-registrations))
            (js-call assert :strictEqual source-registrations 1)
            (put forwarded 1 (lambda () (assertStaticSourceRefusals backend))))
          ((= title staticFreshMemoTitle)
            (setq memo-registrations (1+ memo-registrations))
            (js-call assert :strictEqual memo-registrations 1)
            (put forwarded 1 (async () (await (assertStaticFreshMemo backend directory))))))
        (Reflect/apply target receiver forwarded))))))
  (js-call original-tests :beforeAll (lambda ()
    (js-call assert :strictEqual source-registrations 1)
    (js-call assert :strictEqual memo-registrations 1)))
  (js-call original-tests :afterAll (lambda ()
    (js-call mock :module (resolve root "tools/backends/build.mjs") (lambda () original))
    (js-call mock :module "bun:test" (lambda () original-tests))))
  (js-call mock :module (resolve root "tools/backends/build.mjs") (lambda () selected))
  (js-call mock :module "bun:test" (lambda () (Object/assign (js-object) original-tests (js-object :test replacement)))))
