(module tests.managed-type-construction
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root buildBackends loadLiteralSources)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (defvar directory undefined) (defvar bytes undefined)
  (defconst options (js-object :maxSlots 131072 :initialBytes 8388608 :maxBytes 67108864))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve root "_worktree/type-construction-"))))
    (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
           (compiler (get backend :compiler))
           (sources (await (loadLiteralSources)))
           (entry "tests/type-construction.mjs")
           (literal-modules (js-call sources :map (lambda (record)
             (let ((source (get record :source)))
               (when (= (get record :filename) "stdlib/managed-runtime-type.eli")
                 (js-call assert :strictEqual (js-length (js-call source :split "  (export defineType")) 2)
                 (setq source (js-call source :replace "  (export defineType"
                   "  (export normalize-name normalize-fields protocol-shape normalize-methods normalize-plans method install-protocol-methods defineType")))
               (js-object :id (get record :id) :program
                 (js-call compiler :compile_ir_string source (get record :filename)))))))
           (program (js-call compiler :compile_ir_string
             (await (readFile (resolve root "tests/fixtures/wasm-managed-type-construction.eli") "utf8"))
             "tests/fixtures/wasm-managed-type-construction.eli"))
           (modules (js-array (js-object :id entry :program program)))
           (saved (JSON/stringify modules)) (saved-literals (JSON/stringify literal-modules))
           (runtime (js-call compiler :compile_ir_string
             (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
           (memory (js-object :initialPages 4 :maximumPages 1024))
           (lowered (js-call (get backend :managed) :lower_managed_project modules entry runtime
             (Object/assign (js-object) memory (js-object :literalModules literal-modules)))))
      (setq bytes (globalThis.Uint8Array.from (js-call (get backend :wasm) :append_metadata_section
        (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) memory)
        "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
      (js-call assert :strictEqual (JSON/stringify modules) saved)
      (js-call assert :strictEqual (JSON/stringify literal-modules) saved-literals)
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array)))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defun read-value (runtime value)
    (cond ((and value (= (get value :kind) 4)) (js-call runtime :readNumber value))
      ((and value (= (get value :kind) 5)) (js-call runtime :readString value))
      ((and value (= (get value :kind) 14))
        (Array/from (js-object :length (js-call runtime :length value)) (lambda (ignored index)
          (let ((child (js-call runtime :get value index)))
            (try (read-value runtime child) (finally (js-call runtime :release child)))))))
      (t value)))
  (defun check (stage expected)
    (let ((runtime (instantiateManagedRuntime bytes options)))
      (js-call runtime :auto 65536)
      (try
        (let ((input (js-call runtime :number stage)))
          (try
            (let ((output (js-call runtime :invoke "typeconstruction" (js-array input))))
              (try (js-call assert :deepStrictEqual (read-value runtime output) expected)
                (finally (js-call runtime :release output))))
            (finally (js-call runtime :release input))))
        (finally (js-call runtime :closeModule) (js-call runtime :collect)
          (js-call assert :strictEqual (js-call runtime :live) 0)
          (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)))))
  (defun check-wrapper-across-gc ()
    ;; This source never reads global Function or Function.prototype. The first
    ;; ordinary wrapper must reuse its already authenticated realm prototype.
    (let ((runtime (instantiateManagedRuntime bytes options)))
      (js-call runtime :auto 1)
      (try
        (let ((method (js-call runtime :invoke "protocolwrapper")))
          (try
            (js-call (js-array 0 1 2) :forEach (lambda (round)
              (js-call runtime :collect)
              (let ((result (js-call runtime :invoke "inspectwrapper" (js-array method))))
                (try (js-call assert :deepStrictEqual (read-value runtime result) (js-array "called" t t))
                  (finally (js-call runtime :release result))))))
            (finally (js-call runtime :release method))))
        (finally (js-call runtime :closeModule) (js-call runtime :collect)
          (js-call assert :strictEqual (js-call runtime :live) 0)
          (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)))))
  (test "type construction keeps the original valid name" (lambda () (check 0 "Box")))
  (test "type construction keeps the original dense fields" (lambda () (check 1 (js-array "value"))))
  (test "type construction validates complete frozen protocol metadata" (lambda () (check 2 (js-array "Construction" 2))))
  (test "type construction retains exact implementation identities" (lambda () (check 3 (js-array "Construction" 2 t))))
  (test "type construction freezes complete normalized plans" (lambda () (check 4 (js-array 1 t))))
  (test "type construction creates a class and real fields without plans" (lambda () (check 5 (js-array "NoPlans" t t))))
  (test "type construction installs complete protocol plans" (lambda () (check 6 (js-array "Box" t t))))
  (test "type reification keeps the null prototype and frozen descriptors" (lambda () (check 7 (js-array t t))))
  (test "type field getter methods retain their existing nonconstructible metadata" (lambda () (check 8 (js-array "get" 0 false))))
  (test "type protocol slot wrappers retain real construction receiver prototype and immutable descriptors"
    (lambda () (check 9 (js-array "called" t t false false false)) (check-wrapper-across-gc))))
