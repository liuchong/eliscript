(module
  tests.dogfood-site.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" cp mkdtemp readFile readdir rm stat writeFile)
  (import "node:path" basename join posix resolve)
  (defconst
    ROOT
    (resolve (get (js* "import.meta") :dir) ".."))
  (defconst
    COMPILER
    (resolve ROOT "bin/eliscript-build"))
  (defconst
    PROJECT
    (resolve ROOT "examples/dogfood"))
  (defconst
    state
    (js-object :staging nil :program nil :workspace nil :browserBundle nil))
  (defasync
    run
    (command &rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (let*
      ((opts (js-call globalThis.Object :assign (js-object :cwd ROOT :stdout "pipe" :stderr "pipe") (or options (js-object)))) (child (js-call globalThis.Bun :spawn command opts)) (results (await (js-call globalThis.Promise :all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref results 0) :stdout (aref results 1) :stderr (aref results 2)))))
  (defasync
    buildSite
    (directory output)
    (let*
      ((res (await (run (js-array (get globalThis.process :execPath) (get state :program) "--root" directory "--output" output "--browser-bundle" (get state :browserBundle))))))
      (when
        (not= (get res :exitCode) 0)
        (throw (new globalThis.Error (or (js-call (get res :stderr) :trim) (js-call (get res :stdout) :trim)))))
      (get res :stdout)))
  (defasync
    tree
    (root &rest __host_forwarded_arguments_2)
    (let* ((prefix (aref __host_forwarded_arguments_2 0)))
    (let*
      ((pref (or prefix "")) (entries (await (readdir (join root pref) (js-object :withFileTypes t)))) (files (js-array)) (idx (js-object :i 0)))
      (while
        (< (get idx :i) (get entries :length))
        (let*
          ((entry (aref entries (get idx :i))) (name (get entry :name)) (relative (if
                (= pref "")
                name
                (join pref name))))
          (if
            (js-call entry :isDirectory)
            (let*
              ((children (await (tree root relative))) (cidx (js-object :j 0)))
              (while
                (< (get cidx :j) (get children :length))
                (js-call files :push (aref children (get cidx :j)))
                (put cidx :j (+ (get cidx :j) 1))))
            (js-call files :push (js-call (js-call relative :split "\\") :join "/"))))
        (put idx :i (+ (get idx :i) 1)))
      (js-call files :sort))))
  (defasync
    readText
    (root relative)
    (readFile (join root relative) "utf8"))
  (defasync
    brokenLinks
    (root)
    (let*
      ((file-list (await (tree root))) (files (new globalThis.Set file-list)) (broken (js-array)) (idx (js-object :i 0)))
      (while
        (< (get idx :i) (get file-list :length))
        (let*
          ((relative (aref file-list (get idx :i))))
          (when
            (js-call relative :endsWith ".html")
            (let*
              ((text (await (readText root relative))) (matches (js-call globalThis.Array :from (js-call text :matchAll (new globalThis.RegExp "(?:href|src)=\"([^\"]+)\"" "gu")))) (midx (js-object :j 0)))
              (while
                (< (get midx :j) (get matches :length))
                (let*
                  ((match (aref matches (get midx :j))) (target (aref match 1)))
                  (when
                    (not (js-call (new globalThis.RegExp "^(?:https?:|mailto:|#|data:)" "u") :test target))
                    (let*
                      ((base (js-call posix :dirname relative)) (resolved (if
                            (js-call target :endsWith "/")
                            (js-call posix :normalize (js-call posix :join base target "index.html"))
                            (js-call posix :normalize (js-call posix :join base target)))))
                      (when
                        (not (js-call files :has resolved))
                        (js-call broken :push (str relative " -> " target))))))
                (put midx :j (+ (get midx :j) 1))))))
        (put idx :i (+ (get idx :i) 1)))
      broken))
  (beforeAll (async () (let*
        ((staging (await (mkdtemp (resolve ROOT ".eliscript-dogfood-site-")))) (__ign_9 (put state :staging staging)) (build (await (run (js-array COMPILER "--no-cache" "--root" "examples/dogfood" "--out-dir" staging "examples/dogfood/src/builder/main.eli")))))
        (when
          (not= (get build :exitCode) 0)
          (throw (new globalThis.Error (or (js-call (get build :stderr) :trim) (js-call (get build :stdout) :trim)))))
        (let*
          ((browserSource (resolve staging "browser-source")) (compile (await (run (js-array COMPILER "--no-cache" "--root" "examples/dogfood" "--out-dir" browserSource "examples/dogfood/src/renderer/browser.eli")))))
          (when
            (not= (get compile :exitCode) 0)
            (throw (new globalThis.Error (or (js-call (get compile :stderr) :trim) (js-call (get compile :stdout) :trim)))))
          (let*
            ((browserBundle (resolve staging "browser.js")) (__ign_10 (put state :browserBundle browserBundle)) (bundle (await (run (js-array "bun" "build" (resolve browserSource "src/renderer/browser.mjs") "--target=browser" "--format=iife" "--outfile" browserBundle)))))
            (when
              (not= (get bundle :exitCode) 0)
              (throw (new globalThis.Error (or (js-call (get bundle :stderr) :trim) (js-call (get bundle :stdout) :trim)))))
            (put state :program (resolve staging "src/builder/main.mjs"))
            (let*
              ((parent (await (mkdtemp (resolve staging "project-")))) (workspace (join parent "dogfood")))
              (put state :workspace workspace)
              (await (cp PROJECT workspace (js-object :recursive t :filter (lambda (entry) (let*
                        ((name (basename entry)))
                        (and (not= name "dist") (not= name "_site")))))))))))))
  (afterAll (async () (when
        (get state :staging)
        (await (rm (get state :staging) (js-object :recursive t :force t))))))
  (test "the Markdown slice publishes the documented route set" (async () (let*
        ((workspace (get state :workspace)) (output (await (buildSite workspace "_site"))) (files (await (tree (join workspace "_site")))) (expected-list (js-array "index.html" "404.html" "archive/index.html" "tags/index.html" "feed.xml" "sitemap.xml" "robots.txt" "search.json" "search/index.html" "assets/site.css" "assets/browser.js" "_dogfood/build.json" "_dogfood/posts.json" "posts/hello-dogfood/index.html" "posts/persistent-values/index.html" "posts/comment-channels/index.html" "tags/design/index.html")) (idx (js-object :i 0)))
        (js-call (expect output) :toContain "routes")
        (while
          (< (get idx :i) (get expected-list :length))
          (js-call (expect files) :toContain (aref expected-list (get idx :i)))
          (put idx :i (+ (get idx :i) 1))))))
  (test "a draft is absent from production output" (async () (let*
        ((root (join (get state :workspace) "_site")) (files (await (tree root))) (search (await (readText root "search.json"))) (feed (await (readText root "feed.xml"))))
        (js-call (get (expect files) :not) :toContain "posts/publication-policy/index.html")
        (js-call (get (expect search) :not) :toContain "Drafts are invisible")
        (js-call (get (expect feed) :not) :toContain "Drafts are invisible"))))
  (test "a former slug redirects without JavaScript" (async () (let*
        ((root (join (get state :workspace) "_site")) (redirect (await (readText root "posts/one-lossy-list/index.html"))))
        (js-call (expect redirect) :toContain "http-equiv=\"refresh\"")
        (js-call (expect redirect) :toContain "../comment-channels/")
        (js-call (expect redirect) :toContain "rel=\"canonical\""))))
  (test "article bodies are sanitized and self-contained" (async () (let*
        ((body (await (readText (join (get state :workspace) "_site") "posts/hello-dogfood/index.html"))))
        (js-call (expect body) :toContain "<strong>executable slice</strong>")
        (js-call (expect body) :toContain "<pre><code class=\"language-elisp\">")
        (js-call (expect body) :toContain "<code>content/posts/</code>")
        (js-call (expect body) :toContain "<script src=\"../../assets/browser.js\"></script>")
        (js-call (get (expect body) :not) :toMatch (new globalThis.RegExp "<script(?![^>]*\\ssrc=)" "u")))))
  (test "every relative link resolves" (async () (js-call (expect (await (brokenLinks (join (get state :workspace) "_site")))) :toEqual (js-array))))
  (test "the published manifests follow the documented shape" (async () (let*
        ((root (join (get state :workspace) "_site")) (manifest (js-call globalThis.JSON :parse (await (readText root "_dogfood/build.json")))) (posts (js-call globalThis.JSON :parse (await (readText root "_dogfood/posts.json")))) (search (js-call globalThis.JSON :parse (await (readText root "search.json")))))
        (js-call (expect (get manifest :format)) :toBe "dogfood-build")
        (js-call (expect (get manifest :version)) :toBe 1)
        (js-call (expect (get manifest :postCount)) :toBe 3)
        (js-call (expect (get manifest :routeCount)) :toBe 19)
        (js-call (expect (get manifest :contentFingerprint)) :toMatch (new globalThis.RegExp "^[0-9a-f]{64}$" "u"))
        (js-call (expect (get posts :posts)) :toHaveLength 3)
        (js-call (expect (js-call (get posts :posts) :map (lambda (post) (get post :id)))) :toEqual (js-array "notes/hello-dogfood" "notes/comment-channels" "notes/persistent-values"))
        (js-call (expect (get search :entries)) :toHaveLength 3)
        (js-call (expect (get (aref (get search :entries) 0) :authors)) :toEqual (js-array "dogfood"))
        (js-call (expect (get (aref (get search :entries) 0) :text)) :toContain "executable slice"))))
  (test "two clean builds are byte-identical" (async () (let*
        ((workspace (get state :workspace)) (__ign_11 (await (buildSite workspace "_site-a"))) (__ign_12 (await (buildSite workspace "_site-b"))) (first (await (tree (join workspace "_site-a")))) (second (await (tree (join workspace "_site-b")))) (idx (js-object :i 0)))
        (js-call (expect first) :toEqual second)
        (while
          (< (get idx :i) (get first :length))
          (let*
            ((relative (aref first (get idx :i))) (left (await (readText (join workspace "_site-a") relative))) (right (await (readText (join workspace "_site-b") relative))))
            (js-call (expect left) :toBe right))
          (put idx :i (+ (get idx :i) 1))))))
  (test "a failed build leaves the previous output in place" (async () (let*
        ((workspace (get state :workspace)) (source (join workspace "content/posts/0001-hello-dogfood.md")) (original (await (readFile source "utf8"))) (before (await (readText (join workspace "_site") "_dogfood/build.json"))))
        (await (writeFile source (js-call original :replace "id: notes/hello-dogfood\n" "")))
        (try
          (let*
            ((result (await (run (js-array (get globalThis.process :execPath) (get state :program) "--root" workspace "--output" "_site")))) (after (await (readText (join workspace "_site") "_dogfood/build.json"))))
            (js-call (expect (get result :exitCode)) :toBe 1)
            (js-call (expect (get result :stdout)) :toContain "DOGFOOD-CONTENT-001")
            (js-call (get (expect (get result :stdout)) :not) :toContain "routes")
            (js-call (expect after) :toBe before)
            (js-call (expect (js-call (await (stat (join workspace "_site" "index.html"))) :isFile)) :toBe t))
          (finally
            (await (writeFile source original))))))))
