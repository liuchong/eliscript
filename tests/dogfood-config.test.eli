(module
  tests.dogfood-config.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" mkdtemp rm writeFile)
  (import "node:path" join resolve)
  (defconst
    ROOT
    (resolve (get (js* "import.meta") :dir) ".."))
  (defconst
    COMPILER
    (resolve ROOT "bin/eliscript-build"))
  (defconst
    state
    (js-object :staging nil :config nil :caseNumber 0))
  (defasync
    run
    (command)
    (let*
      ((child (js-call globalThis.Bun :spawn command (js-object :cwd ROOT :stdout "pipe" :stderr "pipe"))) (results (await (js-call globalThis.Promise :all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref results 0) :stdout (aref results 1) :stderr (aref results 2))))
  (defun
    BASE
    (sources &rest __host_forwarded_arguments_1)
    (let* ((publishing (aref __host_forwarded_arguments_1 0)) (extra (aref __host_forwarded_arguments_1 1)))
    (let*
      ((pub (or publishing "{:owner {:login \"owner\" :id \"U_owner\"} :coauthors []}")) (ext (or extra "")))
      (str "(module dogfood.config\n  (defconst config\n    {:schema-version 1\n     :site {:title \"T\" :base-url \"https://example.github.io/t/\" :language \"en\"}\n     :sources\n     " sources "\n     :publishing\n     " pub "\n     :identity {:conflict :fail :projections []}\n     :comments\n     {:presentation :tabs\n      :channels\n      [{:id :issue-native :kind :issue :enabled t :mode :live}]}\n     :refresh {:articles :push :comments :runtime :no-change :skip}\n     " ext "\n     :output {:directory \"_site\"}})\n  (export config))\n"))))
  (defconst
    MARKDOWN
    "{:id :posts :kind :markdown :enabled t :directory \"content/posts\"}")
  (defconst
    ISSUES
    "{:id :issues :kind :issues :enabled t :repository \"owner/repository\" :label \"published\"}")
  (defconst
    PRIVATE_ISSUES
    "{:id :notes :kind :issues :enabled t :repository \"owner/repository\" :label \"published\" :visibility :private}")
  (defasync
    load
    (text)
    (let*
      ((next-num (+ (get state :caseNumber) 1)) (__ign_14 (put state :caseNumber next-num)) (path (join (get state :staging) (str "config-" next-num ".eli"))) (__ign_15 (await (writeFile path text "utf8"))))
      (try
        (js-object :value (js-call (get state :config) :load_config path))
        (catch
          error
          (js-object :failure error)))))
  (beforeAll (async () (let*
        ((staging (await (mkdtemp (resolve ROOT ".eliscript-dogfood-config-")))) (__ign_16 (put state :staging staging)) (built (await (run (js-array COMPILER "--no-cache" "--root" "examples/dogfood" "--out-dir" (resolve staging "build") "examples/dogfood/src/builder/main.eli")))))
        (when
          (not= (get built :exitCode) 0)
          (throw (new globalThis.Error (or (js-call (get built :stderr) :trim) (js-call (get built :stdout) :trim)))))
        (put state :config (await (funcall (js* "(u) => import(u)") (resolve staging "build/src/support/config.mjs")))))))
  (afterAll (async () (when
        (get state :staging)
        (await (rm (get state :staging) (js-object :recursive t :force t))))))
  (test "a valid Markdown configuration loads" (async () (let*
        ((res (await (load (BASE (str "[" MARKDOWN "]"))))))
        (js-call (expect (get res :failure)) :toBeUndefined)
        (js-call (expect (get res :value)) :toBeDefined))))
  (test "an Issues-only configuration loads" (async () (let*
        ((res (await (load (BASE (str "[" ISSUES "]"))))))
        (js-call (expect (get res :failure)) :toBeUndefined))))
  (test "a Discussions-only configuration loads" (async () (let*
        ((res (await (load (BASE "[{:id :talks :kind :discussions :enabled t :repository \"owner/repository\" :category \"Blog\"}]")))))
        (js-call (expect (get res :failure)) :toBeUndefined))))
  (test "all three kinds load together" (async () (let*
        ((res (await (load (BASE (str "[" MARKDOWN " " ISSUES " {:id :talks :kind :discussions :enabled t :repository \"owner/repository\" :category \"Blog\"}]"))))))
        (js-call (expect (get res :failure)) :toBeUndefined))))
  (test "a Markdown source without a directory fails" (async () (let*
        ((res (await (load (BASE "[{:id :posts :kind :markdown :enabled t}]")))) (failure (get res :failure)))
        (js-call (expect (get failure :code)) :toBe "DOGFOOD-CONFIG-003")
        (js-call (expect (get failure :message)) :toContain "markdown"))))
  (test "an unknown source kind fails" (async () (let*
        ((res (await (load (BASE "[{:id :x :kind :telepathy :enabled t :repository \"owner/repository\"}]")))))
        (js-call (expect (get (get res :failure) :code)) :toBe "DOGFOOD-CONFIG-009"))))
  (test "a repository that is not owner/name fails" (async () (let*
        ((res (await (load (BASE "[{:id :issues :kind :issues :enabled t :repository \"repository\"}]")))))
        (js-call (expect (get (get res :failure) :code)) :toBe "DOGFOOD-CONFIG-010"))))
  (test "a Discussions source needs a category" (async () (let*
        ((res (await (load (BASE "[{:id :talks :kind :discussions :enabled t :repository \"owner/repository\"}]")))))
        (js-call (expect (get (get res :failure) :code)) :toBe "DOGFOOD-CONFIG-003"))))
  (test "two providers cannot share an id" (async () (let*
        ((res (await (load (BASE (str "[" MARKDOWN " " (js-call ISSUES :replace ":id :issues" ":id :posts") "]"))))) (failure (get res :failure)))
        (js-call (expect (get failure :code)) :toBe "DOGFOOD-CONFIG-011")
        (js-call (expect (get failure :message)) :toContain "provider id"))))
  (test "two channels cannot share an id" (async () (let*
        ((res (await (load (js-call (BASE (str "[" MARKDOWN "]")) :replace "[{:id :issue-native :kind :issue :enabled t :mode :live}]" "[{:id :issue-native :kind :issue :enabled t :mode :live} {:id :issue-native :kind :issue :enabled t :mode :snapshot}]")))) (failure (get res :failure)))
        (js-call (expect (get failure :code)) :toBe "DOGFOOD-CONFIG-011")
        (js-call (expect (get failure :message)) :toContain "channel id"))))
  (test "publisher logins compare case-insensitively" (async () (let*
        ((res (await (load (BASE (str "[" MARKDOWN "]") "{:owner {:login \"owner\" :id \"U_owner\"} :coauthors [{:login \"Owner\"}]}")))) (failure (get res :failure)))
        (js-call (expect (get failure :code)) :toBe "DOGFOOD-CONFIG-011")
        (js-call (expect (get failure :message)) :toContain "publisher login"))))
  (test "distinct publisher logins are accepted" (async () (let*
        ((res (await (load (BASE (str "[" MARKDOWN "]") "{:owner {:login \"owner\" :id \"U_owner\"} :coauthors [{:login \"writer\"}]}")))))
        (js-call (expect (get res :failure)) :toBeUndefined))))
  (test "a source that is not enabled anywhere fails" (async () (let*
        ((res (await (load (BASE (str "[" (js-call MARKDOWN :replace ":enabled t" ":enabled false") "]"))))) (failure (get res :failure)))
        (js-call (expect (get failure :code)) :toBe "DOGFOOD-CONFIG-003")
        (js-call (expect (get failure :message)) :toContain "enabled"))))
  (test "an absolute output directory fails" (async () (let*
        ((res (await (load (js-call (BASE (str "[" MARKDOWN "]")) :replace ":directory \"_site\"" ":directory \"/tmp/site\"")))))
        (js-call (expect (get (get res :failure) :code)) :toBe "DOGFOOD-CONFIG-004"))))
  (test "a non-https base URL fails" (async () (let*
        ((res (await (load (js-call (BASE (str "[" MARKDOWN "]")) :replace "\"https://example.github.io/t/\"" "\"http://example.github.io/t/\"")))))
        (js-call (expect (get (get res :failure) :code)) :toBe "DOGFOOD-CONFIG-008"))))
  (test "an unknown configuration key fails" (async () (let*
        ((res (await (load (js-call (BASE (str "[" MARKDOWN "]")) :replace ":schema-version 1" ":schema-version 1 :mystery t")))))
        (js-call (expect (get (get res :failure) :code)) :toBe "DOGFOOD-CONFIG-006"))))
  (test "a configuration that is not data fails" (async () (let*
        ((res (await (load (js-call (BASE (str "[" MARKDOWN "]")) :replace ":title \"T\"" ":title (str \"T\")")))))
        (js-call (expect (get (get res :failure) :code)) :toBe "DOGFOOD-CONFIG-005"))))
  (test "an adapter with an unknown carrier kind fails" (async () (let*
        ((res (await (load (BASE (str "[" MARKDOWN "]") nil ":adapters [{:id :x :carrier-kind :telepathy}]")))))
        (js-call (expect (get (get res :failure) :code)) :toBe "DOGFOOD-CONFIG-012"))))
  (test "a native carrier adapter must say how it is identified" (async () (let*
        ((res (await (load (BASE (str "[" MARKDOWN "]") nil ":adapters [{:id :utterances :carrier-kind :issue}]")))) (failure (get res :failure)))
        (js-call (expect (get failure :code)) :toBe "DOGFOOD-CONFIG-003")
        (js-call (expect (get failure :message)) :toContain "native carrier"))))
  (test "an external adapter needs only an id and a carrier kind" (async () (let*
        ((res (await (load (BASE (str "[" MARKDOWN "]") nil ":adapters [{:id :giscus :carrier-kind :external} {:id :plain :carrier-kind :none}]")))))
        (js-call (expect (get res :failure)) :toBeUndefined))))
  (test "two adapters cannot share an id" (async () (let*
        ((res (await (load (BASE (str "[" MARKDOWN "]") nil ":adapters [{:id :giscus :carrier-kind :external} {:id :giscus :carrier-kind :none}]")))) (failure (get res :failure)))
        (js-call (expect (get failure :code)) :toBe "DOGFOOD-CONFIG-011")
        (js-call (expect (get failure :message)) :toContain "adapter id"))))
  (test "a comment mode outside the specification fails" (async () (let*
        ((res (await (load (js-call (BASE (str "[" MARKDOWN "]")) :replace ":mode :live" ":mode :sometimes")))))
        (js-call (expect (get (get res :failure) :code)) :toBe "DOGFOOD-CONFIG-014"))))
  (test "a hybrid channel is accepted" (async () (let*
        ((res (await (load (js-call (BASE (str "[" MARKDOWN "]")) :replace ":mode :live" ":mode :hybrid")))))
        (js-call (expect (get res :failure)) :toBeUndefined))))
  (test "a private source needs explicit acknowledgement" (async () (let*
        ((res (await (load (BASE (str "[" PRIVATE_ISSUES "]"))))) (failure (get res :failure)))
        (js-call (expect (get failure :code)) :toBe "DOGFOOD-CONFIG-017")
        (js-call (expect (get failure :message)) :toContain "private-input"))))
  (test "an acknowledged private source is accepted with static snapshots" (async () (let*
        ((res (await (load (js-call (BASE (str "[" PRIVATE_ISSUES "]") "{:owner {:login \"owner\" :id \"U_owner\"} :coauthors [] :private-input :acknowledged}") :replace ":mode :live" ":mode :snapshot")))))
        (js-call (expect (get res :failure)) :toBeUndefined))))
  (test "a private source cannot serve live comments" (async () (let*
        ((base (BASE (str "[" PRIVATE_ISSUES "]") "{:owner {:login \"owner\" :id \"U_owner\"} :coauthors [] :private-input :acknowledged}")) (live (await (load base))) (hybrid (await (load (js-call base :replace ":mode :live" ":mode :hybrid")))) (snapshot (await (load (js-call base :replace ":mode :live" ":mode :snapshot")))))
        (js-call (expect (get (get live :failure) :code)) :toBe "DOGFOOD-CONFIG-018")
        (js-call (expect (get (get hybrid :failure) :code)) :toBe "DOGFOOD-CONFIG-018")
        (js-call (expect (get snapshot :failure)) :toBeUndefined))))
  (test "a visibility that is neither public nor private fails" (async () (let*
        ((res (await (load (BASE "[{:id :notes :kind :issues :enabled t :repository \"owner/repository\" :label \"published\" :visibility :sometimes}]")))))
        (js-call (expect (get (get res :failure) :code)) :toBe "DOGFOOD-CONFIG-016"))))
  (test "a public source needs no acknowledgement" (async () (let*
        ((res (await (load (BASE "[{:id :notes :kind :issues :enabled t :repository \"owner/repository\" :label \"published\" :visibility :public}]")))))
        (js-call (expect (get res :failure)) :toBeUndefined))))
  (test "an article refresh policy outside the specification fails" (async () (let*
        ((res (await (load (js-call (BASE (str "[" MARKDOWN "]")) :replace ":articles :push" ":articles :sometimes")))) (failure (get res :failure)))
        (js-call (expect (get failure :code)) :toBe "DOGFOOD-CONFIG-015")
        (js-call (expect (get failure :message)) :toContain "refresh.articles"))))
  (test "a comment refresh policy outside the specification fails" (async () (let*
        ((res (await (load (js-call (BASE (str "[" MARKDOWN "]")) :replace ":comments :runtime" ":comments :whenever")))) (failure (get res :failure)))
        (js-call (expect (get failure :code)) :toBe "DOGFOOD-CONFIG-015")
        (js-call (expect (get failure :message)) :toContain "refresh.comments"))))
  (test "every documented refresh policy is accepted" (async () (let*
        ((article-policies (js-array "push" "event" "scheduled" "manual" "hybrid")) (aidx (js-object :i 0)))
        (while
          (< (get aidx :i) (get article-policies :length))
          (let*
            ((policy (aref article-policies (get aidx :i))) (res (await (load (js-call (BASE (str "[" MARKDOWN "]")) :replace ":articles :push" (str ":articles :" policy))))))
            (js-call (expect (get res :failure)) :toBeUndefined))
          (put aidx :i (+ (get aidx :i) 1)))) (let*
        ((comment-policies (js-array "runtime" "external" "scheduled" "manual" "hybrid" "event")) (cidx (js-object :j 0)))
        (while
          (< (get cidx :j) (get comment-policies :length))
          (let*
            ((policy (aref comment-policies (get cidx :j))) (res (await (load (js-call (BASE (str "[" MARKDOWN "]")) :replace ":comments :runtime" (str ":comments :" policy))))))
            (js-call (expect (get res :failure)) :toBeUndefined))
          (put cidx :j (+ (get cidx :j) 1))))))
  (test "an unsupported schema version fails" (async () (let*
        ((res (await (load (js-call (BASE (str "[" MARKDOWN "]")) :replace ":schema-version 1" ":schema-version 2")))))
        (js-call (expect (get (get res :failure) :code)) :toBe "DOGFOOD-CONFIG-007")))))
