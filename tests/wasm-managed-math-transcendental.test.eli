(module tests.wasm-managed-math-transcendental.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm realpath)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "node:process" :default process)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "./helpers/wasm-managed-math-transcendental-node.mjs"
    names options golden bits exact fixed-cases box invoke-rt number-rt finish-rt
    check-numbers check-routes sequence check-scratch-lifetime)

  (defconst dyn-import (js* "(specifier) => import(specifier)"))
  (defconst js-pow (js* "(a, b) => a ** b"))
  (defconst node-helper (resolve "tests/helpers/wasm-managed-math-transcendental-node.mjs"))
  (defconst fixture "tests/fixtures/wasm-managed-math-transcendental.eli")

  (defconst target
    (if (= (get process :arch) "arm64")
        (cond
          ((= (get process :platform) "darwin") "arm64-macos")
          ((= (get process :platform) "linux") "arm64-linux")
          (t undefined))
        undefined))

  (defvar directory nil)
  (defvar backend nil)
  (defvar lowered undefined)
  (defvar bytes nil)
  (defvar wasm-file nil)
  (defvar native-file nil)
  (defvar reference-file nil)
  (defvar reference nil)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-math-transcendental-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (let* ((compiler (get backend :compiler))
             (program (js-call compiler :compile_ir_string (await (readFile fixture "utf8")) fixture))
             (saved (JSON/stringify program))
             (runtime (js-call compiler :compile_ir_string
                        (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                        "runtime.eli")))
        (setq lowered (js-call (get backend :managed) :lower_managed_program program runtime t))
        (let ((raw (js-call (get backend :wasm) :emit_typed_memory_wasm
                     (get lowered :typed)
                     (js-object :initialPages 1 :maximumPages 256))))
          (setq bytes
            (Uint8Array/from
              (js-call (get backend :wasm) :append_metadata_section
                raw "eliscript-managed-control" (JSON/stringify (get lowered :descriptor))))))
        (js-call assert :deepEqual
          (WebAssembly.Module/imports (new WebAssembly.Module bytes))
          (js-array))
        (setq wasm-file (resolve directory "math.wasm"))
        (await (writeFile wasm-file bytes))
        (when target
          (setq native-file (resolve directory (if (= target "arm64-linux") "math.so" "math.dylib")))
          (await (writeFile native-file
                   (Uint8Array/from
                     (js-call (get backend :native) :emit_typed_native_memory_library
                       (get lowered :typed) target)))))
        (let ((javascript (js-call compiler :emit_ir_string program)))
          (setq reference-file (resolve directory "math.mjs"))
          (await (writeFile reference-file javascript)))
        ;; Validate the real emitted file before changing how Bun loads that same
        ;; text. The independently executing Node case below also keeps this file
        ;; as its complete oracle; a malformed emission cannot be hidden by a URL.
        (let* ((env-node (get (get process :env) :NODE))
               (node-bin (if (nullish? env-node) "node" env-node))
               (validation (spawnSync node-bin
                             (js-array node-helper "--validate-emitted" (get (pathToFileURL reference-file) :href))
                             (js-object :encoding "utf8" :timeout 30000 :maxBuffer 65536))))
          (js-call assert :equal (get validation :error) undefined)
          (js-call assert :equal (get validation :signal) nil)
          (js-call assert :equal (get validation :status) 0 (get validation :stderr))
          (js-call assert :equal (get validation :stdout) "emitted Math module parsed and executed"))
        (setq reference (await (funcall dyn-import (get (pathToFileURL (await (realpath reference-file))) :href))))
        (js-call assert :equal (JSON/stringify program) saved)))
    120000)

  (afterAll
    (async ()
      (setq lowered undefined)
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defasync open-instance (kind &rest __host_default_arguments_1)
    (let* ((extra (aref __host_default_arguments_1 0)))
    (let* ((ext (if (undefined? extra) (js-object) extra))
           (cfg (Object/assign (js-object) options ext)))
      (if (= kind "wasm")
          (instantiateManagedRuntime bytes cfg)
          (await (instantiateNativeManagedRuntime native-file lowered
                   (Object/assign (js-object) cfg (js-object :nativeTarget target))))))))

  (defasync each-target (run)
    (let ((kinds (if target (js-array "wasm" "native") (js-array "wasm")))
          (idx 0))
      (while (< idx (get kinds :length))
        (let* ((kind (aref kinds idx))
               (a (await (open-instance kind))))
          (js-call a :auto 1)
          (try
            (await (funcall run a kind))
            (finally
              (finish-rt a))))
        (setq idx (+ idx 1)))))

  (defun cross-backend-bits (a)
    (let* ((state 1981592745)
           (next (lambda ()
                   (setq state (bit-xor state (bit-shift-left state 13)))
                   (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                   (setq state (bit-xor state (bit-shift-left state 5)))
                   (unsigned-bit-shift-right state 0)))
           (view (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
           (inputs (js-array
                     Number.MAX_VALUE
                     (- Number.MAX_VALUE)
                     (funcall js-pow 2 -1022)
                     (- (funcall js-pow 2 -1022))
                     Number.MIN_VALUE
                     (- Number.MIN_VALUE)
                     -0.0
                     0))
           (index 0))
      (while (< index 32)
        (js-call view :setUint32 0 (funcall next))
        (js-call view :setUint32 4 (funcall next))
        (js-call inputs :push (js-call view :getFloat64 0))
        (setq index (+ index 1)))
      (let ((output (js-array))
            (non-random (js-call names :filter (lambda (n) (/= n "random")))))
        (js-call non-random :forEach
          (lambda (name)
            (let ((i 0))
              (while (< i (get inputs :length))
                (let* ((args (if (js-call (js-array "atan2" "pow" "hypot") :includes name)
                                 (js-array (aref inputs i) (aref inputs (% (+ i 7) (get inputs :length))))
                                 (js-array (aref inputs i))))
                       (values (box a args)))
                  (try
                    (js-call output :push (bits (number-rt a "route" (js-array name 2 values))))
                    (finally
                      (js-call a :release values))))
                (setq i (+ i 1))))))
        output)))

  (test "Given all transcendental Math families When IEEE domains powers subnormals and fixed mature range-reduction vectors execute Then exact binary64 results survive GC"
    (async ()
      (let ((reference-bits undefined))
        (await (each-target
                 (lambda (a _kind)
                   (check-numbers a (fixed-cases) golden)
                   (let ((actual (cross-backend-bits a)))
                     (if (undefined? reference-bits)
                         (setq reference-bits actual)
                         (js-call assert :deepEqual actual reference-bits
                           "all implementation-approximated kernels remain bit-identical across real WASM and native"))))))))
    30000)

  (test "Given cold held borrowed bound callback and Reflect Math routes When coerced overridden reflected or constructed Then every original call boundary is preserved"
    (async ()
      (await (each-target (lambda (a _kind) (check-routes a reference)))))
    30000)

  (test "Given falsy source conversion errors and a full default heap When calls fail Then caller roots first errors and later exact calls recover"
    (async ()
      (await (each-target
               (lambda (a _kind)
                 (check-scratch-lifetime a reference)
                 (let ((zero (js-call a :number -0.0))
                       (frame (js-call a :frame 1))
                       (fillers (js-array)))
                   (js-call a :frameSet frame 0 zero)
                   (try
                     (js-call (js-call names :filter (lambda (n) (/= n "random"))) :forEach
                       (lambda (name)
                         (js-call (js-array false undefined) :forEach
                           (lambda (thrown)
                             (let ((caught false))
                               (try
                                 (invoke-rt a "abrupt" (js-array name thrown))
                                 (catch err
                                   (setq caught t)
                                   (js-call assert :strictEqual err thrown)))
                               (funcall assert caught)
                               (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                               (exact (js-call a :readNumber zero) -0.0 "original caller value"))))))
                     (let ((failed false)
                           (index 0))
                       (try
                         (while (< index 2048)
                           (js-call fillers :push (js-call a :string (str "temporary " index)))
                           (setq index (+ index 1)))
                         (catch err
                           (setq failed t)
                           (let ((diag (get err :eliscriptDiagnostic)))
                             (js-call assert :equal (if diag (get diag :code) undefined) "ELI-RT0002"))))
                       (funcall assert failed "the unchanged default 1024-slot hard limit must reject retained allocations"))
                     (js-call fillers :forEach (lambda (handle) (js-call a :release handle)))
                     (put fillers :length 0)
                     (js-call a :collect)
                     (let ((values (box a (js-array 0))))
                       (try
                         (exact (number-rt a "route" (js-array "exp" 2 values)) 1 "after capacity recovery")
                         (finally
                           (js-call a :release values))))
                     (exact (js-call a :readNumber zero) -0.0 "after capacity recovery")
                     (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                     (finally
                       (js-call fillers :forEach (lambda (handle) (js-call a :release handle)))
                       (js-call a :leaveFrame frame)
                       (js-call a :release zero))))))))
    30000)

  (test "Given reproducible random seeds When independent WASM and native heaps generate sequences Then exact replay coexists with ordinary fresh-instance randomness"
    (async ()
      (let ((seed (js-array 305419896 2596069104 270544960 1432778632))
            (sequences (js-array))
            (kinds (if target (js-array "wasm" "native") (js-array "wasm")))
            (k 0))
        (while (< k (get kinds :length))
          (let* ((kind (aref kinds k))
                 (first (await (open-instance kind (js-object :randomSeed (js-call seed :slice)))))
                 (second (await (open-instance kind (js-object :randomSeed (js-call seed :slice))))))
            (js-call first :auto 1)
            (js-call second :auto 1)
            (try
              (let ((seq-a (js-call (sequence first) :map bits))
                    (seq-b (js-call (sequence second) :map bits)))
                (js-call assert :deepEqual seq-a seq-b)
                (js-call sequences :push seq-a))
              (finally
                (finish-rt first)
                (finish-rt second)))
            (let* ((source (js-call seed :slice))
                   (pending (open-instance kind (js-object :randomSeed source))))
              (js-call source :fill 0)
              (let ((snapshot (await pending)))
                (js-call snapshot :auto 1)
                (try
                  (js-call assert :deepEqual (js-call (sequence snapshot) :map bits) (js-call sequences :at -1))
                  (finally
                    (finish-rt snapshot)))))
            (let* ((typed-seed (new globalThis.Uint32Array seed))
                   (typed-pending (open-instance kind (js-object :randomSeed typed-seed))))
              (js-call typed-seed :fill 0)
              (let ((typed-snapshot (await typed-pending)))
                (js-call typed-snapshot :auto 1)
                (try
                  (js-call assert :deepEqual (js-call (sequence typed-snapshot) :map bits) (js-call sequences :at -1))
                  (finally
                    (finish-rt typed-snapshot))))))
          (setq k (+ k 1)))
        (js-call (js-call sequences :slice 1) :forEach
          (lambda (value) (js-call assert :deepEqual value (aref sequences 0))))
        (let ((first (await (open-instance "wasm")))
              (second (await (open-instance "wasm"))))
          (js-call first :auto 1)
          (js-call second :auto 1)
          (try
            (js-call assert :notDeepEqual (js-call (sequence first) :map bits) (js-call (sequence second) :map bits))
            (finally
              (finish-rt first)
              (finish-rt second))))
        (js-call (js-array
                   nil
                   (js-array)
                   (js-array 1)
                   (js-array 1 2 3 4 5)
                   (js-array 0 0 0 0)
                   (js-array 1 2 3 -1)
                   (js-array 1 2 3 4294967296)
                   (js-array 1 2 3 0.5)
                   (js-array 1 2 3 globalThis.NaN)
                   (js-array 1 2 3 globalThis.Infinity)
                   (new globalThis.Uint32Array 3)
                   (new globalThis.Uint32Array 4))
          :forEach
          (lambda (bad-seed)
            (js-call assert :throws
              (lambda ()
                (instantiateManagedRuntime bytes
                  (Object/assign (js-object) options (js-object :randomSeed bad-seed))))
              (lambda (err)
                (let ((diag (get err :eliscriptDiagnostic)))
                  (= (if diag (get diag :code) undefined) "ELI-RT0003"))))))))
    30000)

  (test "Given the same permanent Math fixture When independent Node executes real JS and WASM Then exact stable native oracles callbacks and fixed kernel vectors agree"
    (lambda ()
      (let* ((env-node (get (get process :env) :NODE))
             (node-bin (if (nullish? env-node) "node" env-node))
             (managed-url (get (new globalThis.URL "../tools/backends/managed-runtime.mjs" (get (js* "import.meta") :url)) :href))
             (child (spawnSync node-bin
                      (js-array node-helper "--run-node-check"
                        (get (pathToFileURL reference-file) :href)
                        managed-url
                        wasm-file)
                      (js-object
                        :encoding "utf8"
                        :input (JSON/stringify (js-object :options options :names names :golden golden))
                        :timeout 30000
                        :maxBuffer 65536))))
        (js-call assert :equal (get child :error) undefined)
        (js-call assert :equal (get child :signal) nil)
        (js-call assert :equal (get child :status) 0 (get child :stderr))
        (js-call assert :equal (get child :stdout) "complete Math source and fixed binary64 vectors preserved")))
    30000))
