  (test "native initialization root-range release preserves returned values caller roots and exact refusal before any partial clearing"
    (lambda ()
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (heap (funcall (get e "heap-new") 64 4096 65536))
             (outer (funcall (get e "frame-new") heap 1))
             (inner (funcall (get e "frame-new") heap 4)))
        (funcall assert (and (/= heap 0) (/= outer 0) (/= inner 0)))
        (let ((caller (funcall (get e "value-number") heap 0 2147483648))
              (values (js-call (js-array 1 2 3 4) :map (lambda (v) (funcall (get e "value-number") heap v 0)))))
          (js-call assert :equal (funcall (get e "frame-set") heap outer 0 caller) 1)
          (js-call values :forEach
            (lambda (value index) (js-call assert :equal (funcall (get e "frame-set") heap inner index value) 1)))
          (js-call (js-array (js-array 3 2 2) (js-array 0 5 2) (js-array 1 4 0) (js-array 1 4 4)) :forEach
            (lambda (triple)
              (js-call assert :equal
                (funcall (get e "frame-clear-range") heap inner (aref triple 0) (aref triple 1) (aref triple 2))
                0)
              (js-call assert :equal (funcall (get e "last-error")) 3)
              (js-call values :forEach
                (lambda (value index) (js-call assert :equal (funcall (get e "frame-get") heap inner index) value)))))
          (js-call assert :equal (funcall (get e "frame-clear-range") heap inner 1 4 2) 1)
          (js-call assert :equal (funcall (get e "last-error")) 0)
          (js-call assert :deepEqual
            (js-call values :map (lambda (unused index) (funcall (get e "frame-get") heap inner index)))
            (js-array (aref values 0) 0 (aref values 2) 0))
          (funcall (get e "heap-collect") heap)
          (js-call assert :equal (funcall (get e "last-error")) 0)
          (js-call assert :equal (funcall (get e "frame-depth") heap) 2)
          (js-call (js-array caller (aref values 0) (aref values 2)) :forEach
            (lambda (value) (js-call assert :equal (funcall (get e "value-kind") heap value) 4)))
          (js-call (js-array (aref values 1) (aref values 3)) :forEach
            (lambda (value)
              (js-call assert :equal (funcall (get e "value-kind") heap value) 0)
              (js-call assert :equal (funcall (get e "last-error")) 1)))
          (js-call assert :equal (funcall (get e "frame-get") heap outer 0) caller)
          (funcall assert
            (Object/is
              (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getFloat64
                (funcall (get e "value-data") heap caller 4) t)
              -0.0))
          (js-call assert :equal (funcall (get e "frame-pop") heap inner) 1)
          (js-call assert :equal (funcall (get e "frame-pop") heap outer) 1)
          (funcall (get e "heap-collect") heap)
          (js-call assert :equal (funcall (get e "last-error")) 0)
          (js-call assert :equal (funcall (get e "heap-live") heap) 0)))))

  (test "immediate temporary roots preserve manual collection metadata binding cells and caller roots across capacity refusal"
    (lambda ()
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (heap (funcall (get e "heap-new") 256 8192 65536))
             (call-fn (lambda (name &rest args)
                        (let ((value (funcall to-uint32 (Reflect/apply (get e name) e (js-call (js-array heap) :concat args)))))
                          (js-call assert :equal (funcall (get e "last-error")) 0 name)
                          value))))
        (funcall assert (/= heap 0))
        (let* ((held (funcall call-fn "value-number" 0 2147483648))
               (_ (funcall call-fn "heap-pin" held))
               (binding (funcall call-fn "value-binding-cell-new"))
               (_2 (progn (funcall call-fn "heap-pin" binding) (funcall call-fn "value-binding-init" binding held)))
               (outer (funcall call-fn "frame-new" 1))
               (_3 (funcall call-fn "frame-set" outer 0 held))
               (args (funcall call-fn "value-refs" 7 4))
               (_4 (funcall call-fn "heap-pin" args))
               (idx 0))
          (while (< idx 4)
            (funcall call-fn "value-set" args idx idx)
            (setq idx (1+ idx)))
          (let* ((metadata
                   (lambda ()
                     (let* ((view (new globalThis.DataView (get (get e :memory) :buffer)))
                            (control (js-call view :getUint32 (+ heap 16) t))
                            (pool (js-call view :getUint32 (+ control 4) t))
                            (base (js-call view :getUint32 (+ pool 16) t)))
                       (Array/from (js-object :length 6)
                         (lambda (unused i) (js-call view :getUint32 (+ base (* i 4)) t))))))
                 (immediate-slots
                   (lambda ()
                     (let* ((view (new globalThis.DataView (get (get e :memory) :buffer)))
                            (control (js-call view :getUint32 (+ heap 16) t))
                            (pool (js-call view :getUint32 (+ control 4) t))
                            (base (js-call view :getUint32 (+ pool 16) t)))
                       (Array/from (js-object :length 24)
                         (lambda (unused i) (js-call view :getUint32 (+ base (* i 4)) t))))))
                 (before (funcall metadata))
                 (before-slots (funcall immediate-slots))
                 (assert-roots
                   (lambda ()
                     (js-call assert :equal (funcall call-fn "value-binding-get" binding) held)
                     (js-call assert :deepEqual
                       (js-call (js-array 0 1 2 3) :map (lambda (i) (funcall call-fn "value-get" args i)))
                       (js-array 0 1 2 3))
                     (js-call assert :equal (funcall call-fn "frame-depth") 1)
                     (js-call assert :equal (funcall call-fn "frame-get" outer 0) held)
                     (funcall assert
                       (Object/is
                         (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getFloat64
                           (funcall call-fn "value-data" held 4) t)
                         -0.0))
                     (js-call assert :equal (aref (funcall metadata) 1) 0))))
            (js-call assert :equal (aref before 1) 0)
            (js-call assert :equal (aref before 3) 0)
            (js-call (js-array 0 1 2 3) :forEach
              (lambda (value)
                (js-call assert :equal (funcall call-fn "heap-borrow-root" value) 0)
                (js-call assert :deepEqual (funcall immediate-slots) before-slots)
                (js-call assert :equal (funcall call-fn "heap-return-root" value) 0)
                (js-call assert :deepEqual (funcall immediate-slots) before-slots)))
            (js-call assert :deepEqual (funcall metadata) before)
            (funcall call-fn "heap-collect")
            (funcall assert-roots)
            (let ((exhausted false)
                  (alloc-idx 0))
              (while (and (<= alloc-idx 256) (not exhausted))
                (let ((value (funcall to-uint32 (funcall (get e "value-number") heap alloc-idx 0))))
                  (if (= value 0)
                    (progn
                      (js-call assert :equal (funcall (get e "last-error")) 2)
                      (setq exhausted t))
                    (js-call assert :equal (funcall (get e "last-error")) 0)))
                (setq alloc-idx (1+ alloc-idx)))
              (funcall assert exhausted "manual allocation must refuse the fixed slot capacity"))
            (funcall assert-roots)
            (funcall assert (> (funcall call-fn "heap-collect") 0))
            (funcall assert-roots)
            (funcall assert (> (funcall call-fn "value-number" 7 0) 3))
            (funcall call-fn "heap-release" args)
            (funcall call-fn "frame-pop" outer)
            (funcall call-fn "heap-release" held)
            (funcall call-fn "heap-release" binding)
            (funcall call-fn "heap-collect")
            (js-call assert :equal (funcall call-fn "heap-live") 0)
            (js-call assert :equal (funcall call-fn "frame-depth") 0))))))

  (test "deterministic random UTF16 methods and full f64 position words agree with independent JS during automatic collection"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (_ (js-call a :auto 1))
             (seed 139443610)
             (next-u32 (lambda () (setq seed (funcall xorshift32 seed)) seed))
             (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
             (i 0))
        (while (< i 1024)
          (let* ((units (Array/from (js-object :length (% (funcall next-u32) 64))
                          (lambda () (% (funcall next-u32) 65536))))
                 (text (Reflect/apply String/fromCharCode globalThis.String units))
                 (tlen (js-length text))
                 (needle (if (/= (% i 3) 0)
                           (js-call text :slice (% (funcall next-u32) (1+ tlen)) (% (funcall next-u32) (1+ tlen)))
                           (String/fromCharCode (% (funcall next-u32) 65536)))))
            (js-call bits :setUint32 0 (funcall next-u32) t)
            (js-call bits :setUint32 4 (funcall next-u32) t)
            (let ((position (js-call bits :getFloat64 0 t)))
              (js-call (js-array "at" "char-at" "char-code" "code-point") :forEach
                (lambda (name) (check a name (js-array text position))))
              (js-call (js-array "find" "last" "includes" "starts" "ends") :forEach
                (lambda (name) (check a name (js-array text needle position))))
              (let ((second-arg (- (% (funcall next-u32) 65) 32)))
                (js-call (js-array "slice" "substring" "substr") :forEach
                  (lambda (name) (check a name (js-array text position second-arg)))))
              (js-call (js-array "well-formed" "repair") :forEach
                (lambda (name) (check a name (js-array text))))))
          (setq i (1+ i)))
        (js-call a :closeModule)
        (js-call a :collect))))

