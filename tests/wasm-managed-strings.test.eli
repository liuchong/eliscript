                              (setq c-idx (1+ c-idx))))
                          (setq round (1+ round)))))
                    (lambda (cleanup)
                      (funcall cleanup "dirty realm held string" (lambda () (js-call assert :equal (js-call dead :readString held) "unchanged")))
                      (funcall cleanup "dirty realm method string" (lambda () (js-call assert :equal (js-call dead :readString method) "missing")))
                      (unless (undefined? dirty-frame)
                        (funcall cleanup "dirty realm caller frame depth"
                          (lambda () (js-call assert :equal (get (js-call dead :stats) :frameDepth) 1)))
                        (funcall cleanup "dirty realm caller negative zero"
                          (lambda ()
                            (let ((retained (js-call dead :frameGet dirty-frame 0)))
                              (funcall with-cleanup
                                (lambda () (funcall assert (Object/is (js-call dead :readNumber retained) -0.0)))
                                (lambda (rel) (funcall rel "dirty retained caller value" (lambda () (js-call dead :release retained))))))))
