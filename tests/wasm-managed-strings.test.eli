            (lambda () (js-call a :invoke "fault" (js-array s good)))
            (lambda (e) (funcall js-instanceof e globalThis.WebAssembly.RuntimeError)))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (js-call assert :equal (js-call a :readString s) "xxx")
          (let ((retained (js-call a :frameGet frame 0)))
            (funcall assert (js-call a :keyEqual retained s))
            (js-call a :release retained))
          (js-call a :leaveFrame frame)
          (js-call (js-array s bad good) :forEach (lambda (x) (js-call a :release x)))
          (js-call a :closeModule)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)))
      (let* ((bounded (instantiateManagedRuntime bytes (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 4096)))
             (_ (js-call bounded :auto 1))
             (lone-str (str "中😀" (String/fromCharCode 55296)))
             (original (js-call bounded :string lone-str))
             (n (js-call bounded :number 10000))
             (outer (js-call bounded :frame 1)))
        (js-call bounded :frameSet outer 0 original)
        (js-call assert :throws
          (lambda () (js-call bounded :invoke "repeat" (js-array original n)))
          (lambda (e) (= (and (get e :eliscriptDiagnostic) (get (get e :eliscriptDiagnostic) :code)) "ELI-RT0002")))
        (js-call assert :equal (js-call bounded :readString original) lone-str)
        (js-call assert :equal (get (js-call bounded :stats) :frameDepth) 1)
        (js-call bounded :leaveFrame outer)
        (js-call bounded :release n)
        (js-call bounded :release original)
        (js-call bounded :closeModule)
        (js-call bounded :collect)
        (js-call assert :equal (js-call bounded :live) 0))))

  (test "text literal emission refuses malformed method IR before lowering absent children and preserves the original source schema"
    (async ()
      (await (assertMalformedTextMethods backend runtime-program))))

  (test "Node executes identical zero-import source text bytes with code-point, reverse-search, trim and repair semantics and complete root cleanup"
    (async ()
      (let ((path (resolve directory "text.wasm")))
        (await (writeFile path bytes))
        (let ((result (spawnSync "node"
                        (js-array (resolve "tests/helpers/wasm-managed-strings-node.mjs") "--check-wasm" path)
                        (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get result :status) 0 (get result :stderr))))))

  (test "omitted method arguments, zero-argument concat and ignored identity arguments preserve source defaults and borrowed value lifetime"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (js-call texts :forEach
          (lambda (text)
            (js-call (js-array "concat-empty" "char-empty" "at-empty" "slice-empty"
                               "substring-empty" "substr-empty" "find-empty" "repeat-empty")
                     :forEach
                     (lambda (name) (check a name (js-array text))))))
        (js-call (js-array 0.5 (get globalThis.Number :MIN_VALUE) (get globalThis.Number :NaN) undefined t "x") :forEach
          (lambda (extra) (check a "ignored-identity" (js-array "中😀" extra))))
        (let* ((s (js-call a :string "held"))
               (object (js-call a :sourceObject (js-object)))
               (alias (js-call a :invoke "ignored-identity" (js-array s object))))
          (funcall assert (js-call a :keyEqual alias s))
          (js-call a :release s)
          (js-call a :collect)
          (js-call assert :equal (js-call a :readString alias) "held")
          (js-call a :release alias)
          (js-call a :release object)
          (js-call a :closeModule)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))

  (defconst static-literal-text
    (let ((codes (Array/from (js-object :length 8192)
                   (lambda (unused index)
                     (let ((rem (% index 7)))
                       (cond
                         ((= rem 0) 0)
                         ((= rem 1) 55296)
                         ((= rem 2) 57343)
                         ((= rem 3) 65279)
                         (t (funcall bit-and-u16 (* index 4051)))))))))
      (Reflect/apply String/fromCharCode globalThis.String codes)))

  (defun static-literal-source (text)
    (str "(defun literal () " (JSON/stringify text) ") (defun source-text () (js-call literal :toString)) (export literal source-text)"))

  (defun static-literal-shape (typed)
    (let ((pending (js-call (get typed :functions) :map (lambda (fn) (get fn :body))))
          (seen (new globalThis.Set))
          (copies (js-array))
          (count 0))
      (while (> (js-length pending) 0)
        (let ((node (js-call pending :pop)))
          (when (and (not (nullish? node)) (= (value-type node) "object") (not (js-call seen :has node)))
            (js-call seen :add node)
            (setq count (1+ count))
            (when (= (get node :kind) "memory-data-copy")
              (js-call copies :push node))
            (when (Array/isArray (get node :children))
              (js-call (get node :children) :forEach (lambda (child) (js-call pending :push child)))))))
      (js-object :count count :copies copies)))

  (defun close-static-literal (a &rest __host_default_arguments_2)
    (let* ((roots (aref __host_default_arguments_2 0)))
    (let ((r (if (undefined? roots) (js-array) roots)))
      (try
        (progn
          (js-call r :forEach (lambda (root) (js-call a :release root)))
          (js-call a :closeModule)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
        (finally
          (when (= (value-type (get a :close)) "function")
            (js-call a :close)))))))

  (defvar static-literal-product undefined)

  (defasync static-literal-artifact ()
    (if (not (undefined? static-literal-product))
      static-literal-product
      (let* ((text static-literal-text)
             (source (static-literal-source text))
             (p (js-call (get backend :compiler) :compile_ir_string source "static-literal-中.eli"))
             (saved (JSON/stringify p))
             (lowered (js-call (get backend :managed) :lower_managed_program p runtime-program))
             (art-bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm p runtime-program)))
             (js-code (js-call (get backend :compiler) :emit_ir_string p)))
        (js-call assert :equal (JSON/stringify p) saved)
        (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module art-bytes)) (js-array))
        (let ((reference (await (funcall dynamic-import
                                  (str "data:text/javascript;base64," (js-call (Buffer/from js-code) :toString "base64"))))))
          (js-call assert :equal (js-call reference :literal) text))
        ;; Bun rewrites Unicode and escape spellings in Function.toString. The source
        ;; contract uses the actual Node function created from these exact JS bytes.
        (let ((oracle (spawnSync "node"
                        (js-array (resolve "tests/helpers/wasm-managed-strings-node.mjs") "--literal-source")
                        (js-object :input js-code :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get oracle :error) undefined)
          (js-call assert :equal (get oracle :status) 0 (get oracle :stderr))
          (let ((node-reference (JSON/parse (get oracle :stdout))))
            (js-call assert :equal (get node-reference :text) text)
            (setq static-literal-product
              (js-object :text text :source source :p p :lowered lowered :bytes art-bytes
                         :sourceText (get node-reference :sourceText)))
            static-literal-product)))))

  (defun assert-static-literal (a product)
    (js-call a :auto 1)
    (let ((held (js-call a :number -0.0))
          (frame (js-call a :frame 1))
          (literal undefined)
          (source-text undefined))
      (js-call a :frameSet frame 0 held)
      (try
        (progn
          (setq literal (js-call a :invoke "literal"))
          (js-call assert :equal (js-call a :readString literal) (get product :text))
          (js-call assert :equal (js-call a :length literal) (js-length (get product :text)))
          (try (setq source-text (js-call a :invoke "source-text"))
            (catch error
              (throw (new globalThis.Error
                       (str "static literal source-text invocation after literal length " (js-length (get product :text)) "; auto GC enabled")
                       (js-object :cause error)))))
          (js-call assert :equal (js-call a :readString source-text) (get product :sourceText))
          (let ((filler (js-call a :string (js-call "growth" :repeat 8192))))
            (js-call a :release filler)
            (js-call a :collect))
          (js-call assert :equal (js-call a :readString literal) (get product :text))
          (js-call assert :equal (js-call a :readString source-text) (get product :sourceText))
          (let ((again (js-call a :invoke "source-text")))
            (try
              (js-call assert :equal (js-call a :readString again) (get product :sourceText))
              (finally (js-call a :release again))))
          (let ((caller (js-call a :frameGet frame 0)))
            (try
              (funcall assert (Object/is (js-call a :readNumber caller) -0.0))
              (finally (js-call a :release caller))))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1))
        (finally
          (js-call a :leaveFrame frame)
          (let ((roots (js-array held)))
            (unless (undefined? literal) (js-call roots :push literal))
            (unless (undefined? source-text) (js-call roots :push source-text))
            (close-static-literal a roots))))))

  (test "Given exact UTF16 literal data when emitted and collected then owned copies preserve NUL BOM surrogate pairs lone surrogates and complete Function source text"
    (async ()
      (let ((product (await (static-literal-artifact))))
        (assert-static-literal
          (instantiateManagedRuntime (get product :bytes) (js-object :maxSlots 2048 :initialBytes 65536 :maxBytes 2097152))
          product)
        (let ((small-texts (js-array "" "a" (str "中😀" (String/fromCharCode 55296 0 57343))))
              (idx 0))
          (while (< idx (js-length small-texts))
            (let* ((text (aref small-texts idx))
                   (p (js-call (get backend :compiler) :compile_ir_string (static-literal-source text) "static-small.eli"))
                   (artifact (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm p runtime-program)))
                   (a (instantiateManagedRuntime artifact (js-object :maxSlots 2048 :initialBytes 65536 :maxBytes 2097152)))
                   (output undefined))
              (try
                (progn
                  (setq output (js-call a :invoke "literal"))
                  (js-call assert :equal (js-call a :readString output) text))
                (finally
                  (close-static-literal a (if (undefined? output) (js-array) (js-array output))))))
            (setq idx (1+ idx))))))
    120000)

  (test "Given larger source literals when managed IR is lowered then string bytes remain static data instead of a per-code-unit control tree"
    (async ()
      (let* ((product (await (static-literal-artifact)))
             (large (static-literal-shape (get (get product :lowered) :typed)))
             (small (js-call (get backend :managed) :lower_managed_program
                      (js-call (get backend :compiler) :compile_ir_string (static-literal-source "x") "static-small.eli")
                      runtime-program))
             (small-shape (static-literal-shape (get small :typed))))
        (funcall assert
          (js-call (get large :copies) :some (lambda (copy) (= (get copy :value) (get product :text))))
          "the literal retains its exact UTF16 static payload")
        (funcall assert
          (js-call (get large :copies) :some (lambda (copy) (= (get copy :value) (get product :sourceText))))
          "Function.toString retains its complete original generated source")
        (funcall assert
          (<= (get large :count) (+ (get small-shape :count) 128))
          "growing literal text must not grow the executable control tree per code unit")))
    120000)

  (funcall (js-call test :skipIf (or (/= (get globalThis.process :arch) "arm64")
                                     (not (js-call (js-array "darwin" "linux") :includes (get globalThis.process :platform)))))
    "Given native literal static blocks when their bytes are copied then the same UTF16 source and collecting-root contract executes without imports"
    (async ()
      (let* ((product (await (static-literal-artifact)))
             (is-linux (= (get globalThis.process :platform) "linux"))
             (target (if is-linux "arm64-linux" "arm64-macos"))
             (path (resolve directory (str "static-literal" (if is-linux ".so" ".dylib")))))
        (await (writeFile path (globalThis.Uint8Array.from
                                 (js-call (get backend :native) :emit_typed_native_memory_library
                                   (get (get product :lowered) :typed) target))))
        (assert-static-literal
          (await (instantiateNativeManagedRuntime path (get product :lowered)
                   (js-object :maxSlots 2048 :initialBytes 65536 :maxBytes 2097152)))
          product)))
    120000))
