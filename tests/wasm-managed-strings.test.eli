                  (funcall with-cleanup
                    (lambda ()
                      (js-call assert :equal (js-call dead :readString held) "unchanged" "held string before dirty manual pressure")
                      (js-call assert :equal (js-call dead :readString method) "missing" "method string before dirty manual pressure")
                      (setq dirty-zero (js-call dead :number -0.0))
                      (setq dirty-frame (js-call dead :frame 1))
                      (js-call dead :frameSet dirty-frame 0 dirty-zero)
                      (js-call dead :auto 0)
                      (js-call dead :collect)
                      (js-call assert :equal (js-call dead :readString held) "unchanged" "held string after first dirty manual collection")
                      (js-call assert :equal (js-call dead :readString method) "missing" "method string after first dirty manual collection")
                      (let ((round 0))
                        (while (and (< round 16) (undefined? dirty-capacity))
                          (let ((c-idx 0))
                            (while (and (< c-idx (js-length active-cases)) (undefined? dirty-capacity))
                              (let* ((pair (aref active-cases c-idx))
                                     (name (aref pair 0))
                                     (inputs (aref pair 1)))
                                (when (js-call matched-re :test name)
                                  (let ((args (js-array)))
                                    (funcall with-cleanup
                                      (lambda ()
                                        (js-call inputs :forEach (lambda (input) (js-call args :push (box dead input))))
                                        (try
                                          (js-call assert :deepEqual
