(module tests.wasm-managed-strings.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:util" inspect)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "node:buffer" Buffer)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/testing/initializer-array-fixture.mjs" verifyTextPropertyReads)
  (import "../tools/testing/managed-fixture-repairs.mjs" assertMalformedTextMethods)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defconst to-uint32 (js* "(x) => x >>> 0"))
  (defconst xorshift32 (js* "(s) => { s ^= s << 13; s ^= s >>> 17; s ^= s << 5; return s >>> 0; }"))
  (defconst bit-and-u16 (js* "(x) => x & 65535"))
  (defconst js-instanceof (js* "(a, b) => a instanceof b"))

  (defvar directory undefined)
  (defvar backend undefined)
  (defvar runtime-program undefined)
  (defvar program undefined)
  (defvar bytes undefined)
  (defvar js undefined)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-strings-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
             (module-end (js-call source :lastIndexOf ")")))
        (funcall assert (>= module-end 0))
        ;; Only this test's compiled copy exposes the two private borrow helpers. Keep
        ;; the production export surface unchanged and avoid unrelated realm bootstrap.
        (let ((test-source (str (js-call source :slice 0 module-end)
                                "\n  (export heap-borrow-root heap-return-root)\n"
                                (js-call source :slice module-end))))
          (setq runtime-program (js-call (get backend :compiler) :compile_ir_string test-source "runtime.eli"))
          (setq program (js-call (get backend :compiler) :compile_ir_string
                          (await (readFile "tests/fixtures/wasm-managed-strings.eli" "utf8"))
                          "strings.eli"))
          (setq bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime-program)))
          (funcall assert (js-call globalThis.WebAssembly :validate bytes))
          (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
          (setq js (await (funcall dynamic-import
                            (str "data:text/javascript;base64,"
                                 (js-call (Buffer/from (js-call (get backend :compiler) :emit_ir_string program)) :toString "base64"))))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun box (a x)
    (cond
      ((= (value-type x) "number") (js-call a :number x))
      ((= (value-type x) "string") (js-call a :string x))
      (t x)))

  (defun read-val (a x)
    (if (and (not (nullish? x)) (= (value-type x) "object"))
      (cond
        ((= (get x :kind) 4) (js-call a :readNumber x))
        ((= (get x :kind) 5) (js-call a :readString x))
        (t x))
      x))

  (defun invoke-val (a name args)
    (let ((v (js-call a :invoke name args)))
      (try
        (read-val a v)
        (finally (js-call a :release v)))))

  (defun check (a name inputs)
    (let ((args (js-call inputs :map (lambda (x) (box a x)))))
      (try
        (js-call assert :deepEqual
          (invoke-val a name args)
          (Reflect/apply (get js (js-call name :replaceAll "-" "_")) js inputs)
          name)
        (catch error
          (put error :message (str (get error :message) "\n" name " " (inspect inputs)))
          (throw error))
        (finally
          (js-call args :forEach (lambda (x) (js-call a :release x)))))
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))

  (defconst positions
    (js-array nil false t undefined
              (get globalThis.Number :NaN)
              (get globalThis.Number :POSITIVE_INFINITY)
              (get globalThis.Number :NEGATIVE_INFINITY)
              0 -0.0 0.5 -0.5 1 -1 3.5 -3.5
              (get globalThis.Number :MIN_VALUE)
              (- (get globalThis.Number :MIN_VALUE))
              (get globalThis.Number :MAX_VALUE)
              (- (get globalThis.Number :MAX_VALUE))
              4294967295 4294967296))

  (defconst texts
    (js-array ""
              "x"
              (str "a" (String/fromCharCode 0) "b")
              (str "中😀" (String/fromCharCode 55296) "x" (String/fromCharCode 57343))
              "ababa"
              (String/fromCharCode 55357 56832)
              (str (String/fromCharCode 55357) "x" (String/fromCharCode 56832))))

  (test "ordinary UTF16 property and character access keeps code units, code points, signed positions and exact missing results under GC"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (js-call texts :forEach
          (lambda (text)
            (check a "size" (js-array text))
            (js-call (js-array 0 -0.0 1 2 99 -1 0.5
                               (get globalThis.Number :NaN)
                               (get globalThis.Number :POSITIVE_INFINITY)
                               "0" "1" "01" "" "length")
                     :forEach
                     (lambda (key)
                       (js-call (js-array "read-value" "default-value") :forEach
                         (lambda (name)
                           (check a name
                             (if (= name "default-value")
                               (js-array text key "fallback")
                               (js-array text key)))))))
            (js-call positions :forEach
              (lambda (position)
                (js-call (js-array "at" "char-at" "char-code" "code-point") :forEach
                  (lambda (name) (check a name (js-array text position))))))
            (js-call (js-array "0" "1" "length") :forEach
              (lambda (key) (check a "nth-value" (js-array key text))))
            (check a "scan" (js-array text))))
        (js-call a :closeModule)
        (js-call a :collect))))

  (test "source slice, substring and substr preserve each conversion rule and endpoints without code-point normalization"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (js-call texts :forEach
          (lambda (text)
            (js-call positions :forEach
              (lambda (lo)
                (js-call positions :forEach
                  (lambda (hi)
                    (js-call (js-array "slice" "substring" "substr") :forEach
                      (lambda (name) (check a name (js-array text lo hi))))))))))
        (js-call a :closeModule)
        (js-call a :collect))))

  (test "forward and reverse source searches preserve empty needles, overlapping matches, NaN defaults and primitive string conversions"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes))
            (needles (js-array "" "x" "a" "aba" (String/fromCharCode 0) "😀" (String/fromCharCode 55296)
                               nil false t undefined 0 -0.0 -1
                               (get globalThis.Number :NaN)
                               (get globalThis.Number :POSITIVE_INFINITY)
                               (get globalThis.Number :NEGATIVE_INFINITY))))
        (js-call a :auto 1)
        (js-call texts :forEach
          (lambda (text)
            (js-call needles :forEach
              (lambda (needle)
                (js-call positions :forEach
                  (lambda (p)
                    (js-call (js-array "find" "last" "includes" "starts" "ends") :forEach
                      (lambda (name) (check a name (js-array text needle p))))))))))
        (js-call a :closeModule)
        (js-call a :collect))))

  (test "String repeat, trim, well-formed repair, identities and variadic concat retain exact primitive text and lone surrogates"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (js-call texts :forEach
          (lambda (text)
            (js-call (js-array "identity" "value" "well-formed" "repair" "trim" "trim-start" "trim-end") :forEach
              (lambda (name) (check a name (js-array text))))
            (js-call (js-array nil false t undefined (get globalThis.Number :NaN) -0.0 -0.5 0 0.5 1 3.5) :forEach
              (lambda (count) (check a "repeat" (js-array text count))))
            (js-call (js-array nil false t undefined 0 -0.0 4294967295 -1
                               (get globalThis.Number :NaN)
                               (get globalThis.Number :POSITIVE_INFINITY)
                               (get globalThis.Number :NEGATIVE_INFINITY)
                               "中😀")
                     :forEach
                     (lambda (value) (check a "concat" (js-array text value "!" value))))))
        (let ((whitespace (String/fromCharCode 9 10 11 12 13 32 160 5760 8192 8193 8194 8195 8196 8197 8198 8199 8200 8201 8202 8232 8233 8239 8287 12288 65279)))
          (js-call (js-array whitespace
                             (str whitespace "x" whitespace)
                             (str (String/fromCharCode 133) "x" (String/fromCharCode 133))
                             (str (String/fromCharCode 6158) "x" (String/fromCharCode 6158))
                             "😀")
                   :forEach
                   (lambda (text)
                     (js-call (js-array "trim" "trim-start" "trim-end") :forEach
                       (lambda (name) (check a name (js-array text)))))))
        (js-call (js-array -1 -1.5 (get globalThis.Number :NEGATIVE_INFINITY) (get globalThis.Number :POSITIVE_INFINITY)) :forEach
          (lambda (count)
            (let ((s (js-call a :string "x"))
                  (n (js-call a :number count)))
              (js-call assert :throws
                (lambda () (js-call a :invoke "repeat" (js-array s n)))
                (lambda (e) (= (and (get e :eliscriptDiagnostic) (get (get e :eliscriptDiagnostic) :code)) "ELI-RT0003")))
              (js-call a :release s)
              (js-call a :release n))))
        (check a "repeat" (js-array "" (get globalThis.Number :MAX_VALUE)))
        (js-call a :closeModule)
        (js-call a :collect))))

  (test "raw text queries reject unfinished string keys and protect borrowed receiver, positions and results across allocating GC"
    (lambda ()
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (heap (funcall (get e "heap-new") 64 4096 65536))
             (call-fn (lambda (name &rest args)
                        (let ((out (funcall to-uint32 (Reflect/apply (get e name) e (js-call (js-array heap) :concat args)))))
                          (js-call assert :equal (funcall (get e "last-error")) 0 name)
                          out)))
             (make-string (lambda (text &rest __host_default_arguments_1)
    (let* ((sealed (aref __host_default_arguments_1 0)))
                            (let* ((seal-flag (if (undefined? sealed) t sealed))
                                   (h (funcall call-fn "value-string" (js-length text)))
                                   (view (new globalThis.DataView (get (get e :memory) :buffer)))
                                   (p (funcall call-fn "value-data" h 5))
                                   (i 0))
                              (while (< i (js-length text))
                                (js-call view :setUint16 (+ p (* i 2)) (js-call text :charCodeAt i) t)
                                (setq i (1+ i)))
                              (when seal-flag (funcall call-fn "value-seal" h))
                              h))))
             (s (funcall make-string "中😀"))
             (key (funcall make-string "0" false)))
        (funcall (get e "value-text-get") heap s key 0)
        (js-call assert :equal (funcall (get e "last-error")) 6)
        (funcall call-fn "value-seal" key)
        (funcall call-fn "heap-auto" 1)
        (let ((first (funcall call-fn "value-text-get" s key 0)))
          (funcall call-fn "heap-pin" s)
          (funcall call-fn "heap-pin" key)
          (funcall call-fn "heap-pin" first)
          (js-call assert :equal
            (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getUint16 (funcall call-fn "value-data" first 5) t)
            (js-call "中" :charCodeAt 0))
          (let* ((p (funcall call-fn "value-number" 0 1072693248))
                 (out (funcall call-fn "value-source-text-method" s p 3 3)))
            (funcall call-fn "heap-pin" out)
            (js-call assert :equal
              (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getFloat64 (funcall call-fn "value-data" out 4) t)
              128512)
            (js-call (js-array s key first out) :forEach (lambda (h) (funcall call-fn "heap-release" h)))
            (funcall call-fn "heap-collect")
            (js-call assert :equal (funcall call-fn "heap-live") 0)
            (js-call assert :equal (funcall call-fn "frame-depth") 0))))))

  (test "text calls capture receiver and earlier arguments, evaluate ignored extras and preserve lazy defaults before method conversions"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (check a "capture" (js-array "abcdef" 1 "xy"))
        (check a "concat-capture" (js-array "base" "old" "new"))
        (let ((s (js-call a :string "中😀"))
              (trace (js-call a :sourceObject (js-object))))
          (js-call assert :equal (invoke-val a "ignored" (js-array s trace)) "中")
          (js-call (js-array (js-array "first" 1) (js-array "second" 2)) :forEach
            (lambda (pair)
              (let* ((key (js-call a :string (aref pair 0)))
                     (value (js-call a :objectGet trace key)))
                (js-call assert :equal (js-call a :readNumber value) (aref pair 1))
                (js-call a :release value)
                (js-call a :release key))))
          (js-call a :release trace)
          (js-call a :release s)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0))
        (js-call texts :forEach
          (lambda (text)
            (js-call (js-array 0 1 99 "0" "length") :forEach
              (lambda (key) (check a "default-order" (js-array text key))))))
        (js-call a :closeModule)
        (js-call a :collect))))

  (test "source text boundaries are immutable, source-bound unsupported calls and malformed arity are refused, and invalid handles stay branded"
    (async ()
      (let ((before (JSON/stringify program)))
        (js-call (get backend :managed) :emit_managed_wasm program runtime-program)
        (js-call assert :equal (JSON/stringify program) before))
      (js-call (js-array "(js-call s :toLowerCase)" "(js-call s :split \"x\")") :forEach
        (lambda (expression)
          (let* ((ir (js-call (get backend :compiler) :compile_ir_string (str "(defun f (s) " expression ") (export f)") "supported-text.eli"))
                 (saved (JSON/stringify ir))
                 (emitted (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm ir runtime-program))))
            (funcall assert (js-call globalThis.WebAssembly :validate emitted))
            (js-call assert :equal (JSON/stringify ir) saved))))
      ;; General member invocation now preserves dead branches instead of rejecting
      ;; a property spelling everywhere, including methods on user-defined objects.
      (let* ((formerly-rejected (js-array "(js-call s method)"
                                          "(js-call s :toLocaleLowerCase)"
                                          "(js-call s :normalize)"
                                          "(js-call s :matchAll \"x\")"
                                          "(js-call s :match \"x\")"))
             (dead-source
               (str (js-call (js-call formerly-rejected :map
                               (lambda (expression index)
                                 (str "(defun dead" index " (s method) (if false " expression " s))")))
                             :join "\n")
                    "\n (defun dynamic (s method argument) (js-call s method argument))\n"
                    " (defun matched (s) (let ((found (js-call s :match \"x\"))) (if found (get found 0) nil)))\n"
                    " (defun matched-all (s) (let* ((iterator (js-call s :matchAll \"x\")) (step (js-call iterator :next)))\n"
                    "  (if (get step :done) nil (get (get step :value) 0))))\n"
                    " (defun dynamic-matched (s) (let* ((method \"match\") (found (js-call s method \"x\"))) (if found (get found 0) nil)))\n"
                    " (defun dynamic-matched-all (s) (let* ((method \"matchAll\") (iterator (js-call s method \"x\")) (step (js-call iterator :next)))\n"
                    "  (if (get step :done) nil (get (get step :value) 0))))\n"
                    " (defun custom-matched (s) (let ((pattern (js-object)))\n"
                    "  (put pattern (js* \"Symbol.match\") (lambda (input) (js-array input)))\n"
                    "  (get (js-call s :match pattern) 0)))\n"
                    " (defun custom-matched-all (s) (let ((pattern (js-object)))\n"
                    "  (put pattern (js* \"Symbol.matchAll\") (lambda (input)\n"
                    "   (js-object :next (lambda () (js-object :done false :value (js-array input))))))\n"
                    "  (get (get (js-call (js-call s :matchAll pattern) :next) :value) 0)))\n"
                    " (defun protocol-fault () (let ((trace (js-array)) (marker (js-object)) (pattern (js-object)))\n"
                    "  (put pattern (js* \"Symbol.match\") (lambda (input) (js-call trace :push \"method\") (throw marker)))\n"
                    "  (try (js-call \"text\" :match (progn (js-call trace :push \"argument\") pattern))\n"
                    "   (catch error (JSON/stringify (js-array (= error marker) trace))))))\n"
                    " (defun invalid-all () (let ((pattern (new (js* \"RegExp\") \"x\")))\n"
                    "  (try (js-call \"abxx\" :matchAll pattern) (catch error (get error :name)))))\n"
                    " (defun normalized (s) (js-call s :normalize))\n"
                    " (defun localized (s) (js-call s :toLocaleLowerCase))\n"
                    " (defun custom () (let ((value (js-object :normalize (lambda () \"custom-normalize\") :toLocaleLowerCase (lambda () \"custom-locale\"))))\n"
                    "  (js-call (js-call value :normalize) :concat \"/\" (js-call value :toLocaleLowerCase))))\n"
                    " (defun dynamic-order ()\n"
                    "  (let* ((trace (js-array)) (text \"abcd\")\n"
                    "         (key (js-object :toString (lambda () (js-call trace :push \"key\") \"slice\")))\n"
                    "         (result (js-call (progn (js-call trace :push \"receiver\") text)\n"
                    "           (progn (js-call trace :push \"key-expression\") key)\n"
                    "           (progn (js-call trace :push \"first\") (setq text \"changed\") 1)\n"
                    "           (progn (js-call trace :push \"second\") 3)\n"
                    "           (progn (js-call trace :push \"extra\") 99))))\n"
                    "   (JSON/stringify (js-array result trace))))\n"
                    " (defun null-order ()\n"
                    "  (let* ((trace (js-array)) (key (js-object :toString (lambda () (js-call trace :push \"coercion\") \"slice\"))))\n"
                    "   (try (js-call nil (progn (js-call trace :push \"key-expression\") key) (js-call trace :push \"argument\"))\n"
                    "    (catch error (JSON/stringify (js-array (get error :name) trace))))))\n"
                    " (defun prototype-order (throwing)\n"
                    "  (let* ((trace (js-array)) (prototype (get (js* \"String\") :prototype))\n"
                    "         (saved (Object/getOwnPropertyDescriptor prototype \"slice\")) (marker (js-object)) (method \"slice\"))\n"
                    "   (try\n"
                    "    (Object/defineProperty prototype \"slice\" (js-object :configurable t :get (lambda ()\n"
                    "     (js-call trace :push \"get\")\n"
                    "     (if throwing (throw marker) (lambda (argument) (js-call trace :push \"old-call\") (js-call \"old:\" :concat argument))))))\n"
                    "    (let ((result (try\n"
                    "      (js-call \"abcd\" method (progn (js-call trace :push \"argument\")\n"
                    "       (Object/defineProperty prototype \"slice\" (js-object :configurable t :value (lambda (argument) \"new\"))) \"ARG\"))\n"
                    "      (catch error (= error marker)))))\n"
                    "     (JSON/stringify (js-array result trace)))\n"
                    "    (finally (if saved (Object/defineProperty prototype \"slice\" saved) (Reflect/deleteProperty prototype \"slice\"))))))\n"
                    " (defun native-capture-order ()\n"
                    "  (let* ((trace (js-array)) (prototype (get (js* \"String\") :prototype))\n"
                    "         (saved (Object/getOwnPropertyDescriptor prototype \"slice\")) (method \"slice\"))\n"
                    "   (try\n"
                    "    (let ((result (js-call \"abcd\" method (progn (js-call trace :push \"argument\")\n"
                    "      (Object/defineProperty prototype \"slice\" (js-object :configurable t :value (lambda (argument) \"new\"))) 1))))\n"
                    "     (JSON/stringify (js-array result trace)))\n"
                    "    (finally (if saved (Object/defineProperty prototype \"slice\" saved) (Reflect/deleteProperty prototype \"slice\"))))))\n"
                    " (export dead0 dead1 dead2 dead3 dead4 dynamic matched matched-all dynamic-matched dynamic-matched-all\n"
                    "  custom-matched custom-matched-all normalized localized custom\n"
                    "  dynamic-order null-order prototype-order native-capture-order protocol-fault invalid-all)"))
             (dead-ir (js-call (get backend :compiler) :compile_ir_string dead-source "dead-text.eli"))
             (dead-js-code (js-call (get backend :compiler) :emit_ir_string dead-ir))
             (dead-js (await (funcall dynamic-import
                               (str "data:text/javascript;base64," (js-call (Buffer/from dead-js-code) :toString "base64")))))
             (dead-bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm dead-ir runtime-program)))
             (dead (instantiateManagedRuntime dead-bytes))
             (_ (js-call dead :auto 1))
             (held (js-call dead :string "unchanged"))
             (method (js-call dead :string "missing"))
             (with-cleanup
               (lambda (body steps)
                 (let ((failed false)
                       (failure undefined)
                       (result undefined)
                       (cleanup-errors (js-array)))
                   (try (setq result (funcall body))
                     (catch error (setq failed t failure error)))
                   (funcall steps
                     (lambda (label operation)
                       (try (funcall operation)
                         (catch error
                           (let ((cleanup-error (new globalThis.Error (str "string fixture cleanup: " label) (js-object :cause error))))
                             (cond
                               ((not failed) (setq failed t failure cleanup-error))
                               ((< (js-length cleanup-errors) 12) (js-call cleanup-errors :push cleanup-error))))))))
                   (when failed
                     (when (> (js-length cleanup-errors) 0)
                       (let ((err (new globalThis.Error
                                    (str (if (funcall js-instanceof failure globalThis.Error)
                                           (get failure :message)
                                           "string fixture failed")
                                         "; subsequent cleanup also failed")
                                    (js-object :cause failure))))
                         (put err :cleanupErrors cleanup-errors)
                         (throw err)))
                     (throw failure))
                   result)))
             (invoke-with-cleanup
               (lambda (rt name args)
                 (let ((value undefined)
                       (returned false))
                   (funcall with-cleanup
                     (lambda ()
                       (setq value (js-call rt :invoke name args))
                       (setq returned t)
                       (read-val rt value))
                     (lambda (cleanup)
                       (when returned
                         (funcall cleanup (str "result " name) (lambda () (js-call rt :release value))))))))))
        (funcall with-cleanup
          (lambda ()
            (let ((index 0))
              (while (< index (js-length formerly-rejected))
                (js-call assert :equal
                  (invoke-val dead (str "dead" index) (js-array held method))
                  (funcall (get dead-js (str "dead" index)) "unchanged" "missing"))
                (setq index (1+ index))))
            (let* ((lone-surrogate-str (str "中😀" (String/fromCharCode 55296)))
                   (active-cases
                     (js-array
                       (js-array "dynamic" (js-array "abcd" "slice" 1))
                       (js-array "dynamic" (js-array "中x" "toUpperCase" 0))
                       (js-array "matched" (js-array "abxx"))
                       (js-array "matched" (js-array "none"))
                       (js-array "matched-all" (js-array "abxx"))
                       (js-array "matched-all" (js-array "none"))
                       (js-array "custom" (js-array))
                       (js-array "dynamic-order" (js-array))
                       (js-array "null-order" (js-array))
                       (js-array "prototype-order" (js-array false))
                       (js-array "prototype-order" (js-array t))
                       (js-array "native-capture-order" (js-array))
                       (js-array "dynamic-matched" (js-array "abxx"))
                       (js-array "dynamic-matched" (js-array "none"))
                       (js-array "dynamic-matched-all" (js-array "abxx"))
                       (js-array "dynamic-matched-all" (js-array "none"))
                       (js-array "custom-matched" (js-array lone-surrogate-str))
                       (js-array "custom-matched-all" (js-array lone-surrogate-str))
                       (js-array "protocol-fault" (js-array))
                       (js-array "invalid-all" (js-array))))
                   (oracle (spawnSync "node"
                             (js-array (resolve "tests/helpers/wasm-managed-strings-node.mjs") "--eval-cases")
                             (js-object :input (JSON/stringify (js-object :javascript dead-js-code :cases active-cases))
                                        :encoding "utf8" :timeout 30000)))
                   (_2 (progn
                         (js-call assert :equal (get oracle :error) undefined)
                         (js-call assert :equal (get oracle :status) 0 (get oracle :stderr))))
                   (expected (JSON/parse (get oracle :stdout)))
                   (matched-re (new globalThis.RegExp "^(?:dynamic-|custom-)?matched(?:-all)?$")))
              (js-call active-cases :forEach
                (lambda (pair index)
                  (let ((name (aref pair 0))
                        (inputs (aref pair 1))
                        (args (js-array)))
                    (funcall with-cleanup
                      (lambda ()
                        (try
                          (progn
                            (js-call inputs :forEach (lambda (input) (js-call args :push (box dead input))))
                            (js-call assert :deepEqual (funcall invoke-with-cleanup dead name args) (aref expected index) name))
