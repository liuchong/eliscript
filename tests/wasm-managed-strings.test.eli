  (test "text capacity failures preserve input bits and caller frames; real search traps unwind only private roots and retain earlier errors"
    (async ()
      (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
             (start (js-call source :indexOf "  (defun heap-text-search-unit "))
             (end (js-call source :indexOf "  (defun heap-text-find-direction " start)))
