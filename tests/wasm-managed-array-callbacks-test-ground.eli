(module tests.wasm-managed-array-callbacks-test-ground
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defvar directory undefined)
  (defvar backend undefined)
  (defvar runtime undefined)
  (defvar program undefined)
  (defvar reference undefined)
  (defvar bytes undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-array-callbacks-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get backend :compiler) :compile_ir_string
                    (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (setq program (js-call (get backend :compiler) :compile_ir_string
                    (await (readFile "tests/fixtures/wasm-managed-array-callbacks.eli" "utf8")) "callbacks.eli"))
    (setq reference (await (funcall dynamic-import
                             (str "data:text/javascript;base64,"
                                  (js-call (Buffer/from (js-call (get backend :compiler) :emit_ir_string program)) :toString "base64"))))))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun instance (&rest opts)
    (let ((options (if (or (= (js-length opts) 0) (undefined? (aref opts 0))) (js-object) (aref opts 0))))
      (when (undefined? bytes)
        (setq bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program runtime))))
      (js-call assert :deepEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let ((a (instantiateManagedRuntime bytes options)))
        (js-call a :auto 1)
        a)))

  (defun box (a x)
    (cond
      ((= (value-type x) "number") (js-call a :number x))
      ((= (value-type x) "string") (js-call a :string x))
      (t x)))

  (defun read (a x)
    (if (or (= x nil) (= (value-type x) "boolean") (undefined? x))
      x
      (cond
        ((= (get x :kind) 4) (js-call a :readNumber x))
        ((= (get x :kind) 5) (js-call a :readString x))
        (t
         (js-call assert :equal (get x :kind) 14)
         (let ((len (js-call a :length x))
               (out (js-array))
               (i 0))
           (while (< i len)
             (let ((key (js-call a :number i))
                   (own nil))
               (try (setq own (js-call a :invoke "has-index" (js-array x key)))
                 (finally (js-call a :release key)))
               (when own
                 (let ((v (js-call a :get x i)))
                   (try (put out i (read a v))
                     (finally (js-call a :release v))))))
             (setq i (1+ i)))
           (put out :length len)
           out)))))

  (defun invoke (a name &rest supplied)
    (let* ((args (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-array) (aref supplied 0)))
           (x (js-call a :invoke name args)))
      (try (read a x)
        (finally (js-call a :release x)))))

  (defun finish (a &rest supplied)
    (let ((values (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-array) (aref supplied 0))))
      (js-call values :forEach (lambda (v) (js-call a :release v))))
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))

  (defun array (a xs)
    (let* ((values (Array/from xs (lambda (x i) (if (Object/hasOwn xs i) (box a x) undefined))))
           (sparse (new globalThis.Array (js-length xs)))
           (i 0))
      (while (< i (js-length xs))
        (when (Object/hasOwn xs i)
          (put sparse i (aref values i)))
        (setq i (1+ i)))
      (let ((out (js-call a :sourceArray sparse)))
        (js-call values :forEach (lambda (v) (js-call a :release v)))
        out)))

  (defconst methods
    (js-array
      (js-array "map" "map")
      (js-array "filter" "filter")
      (js-array "for-each" "forEach")
      (js-array "some" "some")
      (js-array "every" "every")
      (js-array "find" "find")
      (js-array "find-index" "findIndex")
      (js-array "find-last" "findLast")
      (js-array "find-last-index" "findLastIndex")))

  (defun rt-diag-p (code)
    (lambda (e) (and e (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) code))))

  (test "array callbacks execute dynamic WASM functions and use JavaScript predicate truth" (lambda ()
    (let* ((a (instance))
           (f (js-call a :invoke "identity"))
           (values (js-array 0 -0.0 globalThis.NaN "" nil undefined false globalThis.Number.MIN_VALUE "中😀" t globalThis.Infinity))
           (items (array a values)))
      (js-call methods :forEach
        (lambda (pair)
          (let ((name (aref pair 0)) (method (aref pair 1)))
            (js-call assert :deepEqual
              (invoke a (str name "-with") (js-array items f))
              (js-call values method (lambda (x) x))
              name))))
      (finish a (js-array f items)))))

  (test "callback map preserves holes while filter is dense and find visits holes in both directions" (lambda ()
    (let* ((a (instance))
           (f (js-call a :invoke "identity"))
           (values (new globalThis.Array 6)))
      (put values 1 false)
      (put values 3 3)
      (put values 5 undefined)
      (let ((items (array a values)))
        (js-call methods :forEach
          (lambda (pair)
            (let ((name (aref pair 0)) (method (aref pair 1)))
              (js-call assert :deepEqual
                (invoke a (str name "-with") (js-array items f))
                (js-call values method (lambda (x) x))
                name))))
        (js-call assert :deepEqual (invoke a "map-indices" (js-array items)) (js-call reference :map_indices values))
        (finish a (js-array f items))))))

  (test "all callbacks receive element index and original receiver with exact early-exit order" (lambda ()
    (let ((a (instance)))
      (js-call methods :forEach
        (lambda (pair)
          (let* ((name (aref pair 0))
                 (method (aref pair 1))
                 (values (js-array false t false))
                 (items (array a values))
                 (log (js-call a :sourceArray (js-array)))
                 (f (js-call a :invoke "collect-arguments" (js-array log)))
                 (ref-log (js-array)))
            (js-call values method (lambda (&rest args) (js-call ref-log :push args) (aref args 0)))
            (let ((returned (js-call a :invoke (str name "-with") (js-array items f))))
              (js-call a :release returned))
            (js-call assert :equal (js-call a :length log) (js-length ref-log) name)
            (let ((i 0))
              (while (< i (js-length ref-log))
                (let* ((args (js-call a :get log i))
                       (v (js-call a :get args 0))
                       (n (js-call a :get args 1))
                       (receiver (js-call a :get args 2)))
                  (js-call assert :equal (js-call a :length args) 3)
                  (js-call assert :deepEqual (read a v) (aref (aref ref-log i) 0))
                  (js-call assert :equal (js-call a :readNumber n) (aref (aref ref-log i) 1))
                  (funcall assert (js-call a :keyEqual receiver items))
                  (js-call (js-array args v n receiver) :forEach (lambda (x) (js-call a :release x))))
                (setq i (1+ i))))
            (js-call (js-array items log f) :forEach (lambda (x) (js-call a :release x)))
            (js-call a :collect))))
      (finish a))))

  (test "reduce and reduceRight select the first present value and preserve exact accumulation order" (lambda ()
    (let* ((a (instance))
           (sum (js-call a :invoke "sum-callback"))
          (cases (js-array (js-array) (js-array undefined) (js-array 1) (js-array 1 2 3)
                           (js-array -0.0) (js-array -0.0 globalThis.Number.MIN_VALUE globalThis.Infinity)
                           (new globalThis.Array 5))))
      (js-call cases :forEach
        (lambda (values)
          (let ((items (array a values)))
            (js-call (js-array (js-array "reduce" "reduce") (js-array "reduce-right" "reduceRight")) :forEach
              (lambda (pair)
                (let ((name (aref pair 0))
                      (method (aref pair 1))
                      (expected undefined)
                      (errored false))
                  (try (setq expected (js-call values method (lambda (acc x) (+ acc x))))
                    (catch _err (setq errored t)))
                  (if errored
                    (js-call assert :throws
                      (lambda () (js-call a :invoke (str name "-with") (js-array items sum)))
                      (rt-diag-p "ELI-RT0003"))
                    (js-call assert :deepEqual (invoke a (str name "-with") (js-array items sum)) expected))
                  (let ((initial (js-call a :number -0.0)))
                    (js-call assert :deepEqual
                      (invoke a (if (= name "reduce") "reduce-initial" "reduce-right-initial") (js-array items sum initial))
                      (js-call values method (lambda (acc x) (+ acc x)) -0.0))
                    (js-call a :release initial)))))
            (js-call a :release items)
            (js-call a :collect))))
      (finish a (js-array sum)))))

  (test "reduce callbacks receive accumulator element index and receiver and run in the correct direction" (lambda ()
    (let* ((a (instance))
           (values (js-array 1 2 3))
           (items (array a values))
           (initial (js-call a :number 0)))
      (js-call (js-array (js-array "reduce-initial" "reduce") (js-array "reduce-right-initial" "reduceRight")) :forEach
        (lambda (pair)
          (let* ((name (aref pair 0))
                 (method (aref pair 1))
                 (log (js-call a :sourceArray (js-array)))
                 (f (js-call a :invoke "ordered-callback" (js-array log)))
                 (ref-log (js-array))
                 (expected (js-call values method
                             (lambda (acc x i arr)
                               (js-call ref-log :push (js-array x i arr))
                               (+ (* acc 10) x))
                             0)))
            (js-call assert :equal (invoke a name (js-array items f initial)) expected)
            (js-call assert :equal (js-call a :length log) 3)
            (let ((i 0))
              (while (< i 3)
                (let* ((row (js-call a :get log i))
                       (value (js-call a :get row 0))
                       (idx (js-call a :get row 1))
                       (receiver (js-call a :get row 2)))
                  (js-call assert :equal (js-call a :readNumber value) (aref (aref ref-log i) 0))
                  (js-call assert :equal (js-call a :readNumber idx) (aref (aref ref-log i) 1))
                  (funcall assert (js-call a :keyEqual receiver items))
                  (js-call (js-array row value idx receiver) :forEach (lambda (x) (js-call a :release x))))
                (setq i (1+ i))))
            (js-call a :release log)
            (js-call a :release f)
            (js-call a :collect))))
      (finish a (js-array items initial)))))

  (test "callbacks snapshot length but observe deleted added and overwritten entries during iteration" (lambda ()
    (let ((a (instance)))
      (js-call methods :forEach
        (lambda (pair)
          (let* ((name (aref pair 0))
                 (method (aref pair 1))
                 (values (js-array 1 2 3 4))
                 (items (array a values))
                 (f (js-call a :invoke "mutation-callback" (js-array items)))
                 (control (js-call values :slice))
                 (expected (js-call control method
                             (lambda (x i arr)
                               (when (= i 0)
                                 (put arr :length 1)
                                 (put arr :length 4)
                                 (put arr 2 99)
                                 (js-call arr :push 123))
                               (js-array x i (= arr control))))))
            (js-call assert :deepEqual (invoke a (str name "-with") (js-array items f)) expected name)
            (js-call assert :deepEqual (read a items) control)
            (js-call a :release items)
            (js-call a :release f)
            (js-call a :collect))))
      (finish a))))

  (test "receiver and method are captured before all arguments and a nullish lookup suppresses them" (lambda ()
    (let* ((a (instance))
           (items (array a (js-array 1 2)))
           (other (array a (js-array 8)))
           (marker (array a (js-array false))))
      (js-call assert :deepEqual (invoke a "evaluation-order" (js-array items other marker)) (js-array 1 2))
      (let ((mark (js-call a :get marker 0)))
        (js-call assert :equal (js-call a :readNumber mark) 3)
        (js-call a :release mark))
      (js-call (js-array nil undefined) :forEach
        (lambda (receiver)
          (js-call a :set marker 0 false)
          (js-call assert :throws (lambda () (js-call a :invoke "nullish-order" (js-array receiver marker))))
          (js-call assert :equal (js-call a :get marker 0) false)))
      (let ((callback (js-call a :invoke "identity")))
        (js-call assert :deepEqual (invoke a "map-replaced" (js-array items callback)) (js-array 1 2))
        (js-call assert :throws
          (lambda () (js-call a :invoke "map-with" (js-array items callback)))
          (rt-diag-p "ELI-RT0003"))
        (finish a (js-array items other marker callback))))))

  (test "own callable methods execute the captured function rather than the inherited builtin" (lambda ()
    (let* ((a (instance))
           (items (array a (js-array 1 2)))
           (f (js-call a :invoke "shadow-value")))
      (js-call assert :equal (invoke a "map-shadow" (js-array items f)) 15)
      (finish a (js-array items f)))))

  (test "nested callback calls and exact operand bits survive automatic collection" (lambda ()
    (let* ((a (instance))
           (values (js-array 0 1 2 -0.0 globalThis.Number.MIN_VALUE))
           (items (array a values)))
      (js-call assert :deepEqual (invoke a "map-recursive" (js-array items)) (js-call reference :map_recursive values))
      (funcall assert (> (get (js-call a :stats) :collections) 10))
      (finish a (js-array items)))))

  (test "invalid callbacks are checked for empty arrays and failures preserve caller roots and the first error" (lambda ()
    (let* ((a (instance))
           (empty (js-call a :sourceArray (js-array)))
           (items (array a (js-array 1 2)))
           (marker (array a (js-array false)))
           (frame (js-call a :frame 1))
           (all-methods (js-call methods :concat (js-array (js-array "reduce") (js-array "reduce-right")))))
      (js-call a :frameSet frame 0 marker)
      (js-call all-methods :forEach
        (lambda (pair)
          (let ((name (aref pair 0)))
            (js-call (js-array nil undefined false t) :forEach
              (lambda (bad)
                (js-call assert :throws
                  (lambda () (js-call a :invoke (str name "-with") (js-array empty bad)))
                  (rt-diag-p "ELI-RT0003")))))))
      (js-call assert :throws
        (lambda () (js-call a :invoke "first-error" (js-array items marker)))
        (rt-diag-p "ELI-RT0003"))
      (js-call assert :equal (js-call a :get marker 0) false)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
      (js-call a :leaveFrame frame)
      (finish a (js-array empty items marker)))))

  (test "find methods still visit vanished indices after a callback shrinks its receiver" (lambda ()
    (let ((a (instance)))
      (js-call methods :forEach
        (lambda (pair)
          (let* ((name (aref pair 0))
                 (method (aref pair 1))
                 (values (js-array 1 2 3 4))
                 (items (array a values))
                 (log (js-call a :sourceArray (js-array)))
                 (f (js-call a :invoke "shrink-callback" (js-array log)))
                 (first t)
                 (expected-log (js-array))
                 (expected (js-call values method
                             (lambda (x i arr)
                               (when first
                                 (setq first false)
                                 (put arr :length 0))
                               (js-call expected-log :push (js-array x i))
                               false))))
            (js-call assert :deepEqual (invoke a (str name "-with") (js-array items f)) expected name)
            (js-call assert :deepEqual (read a log) expected-log name)
            (js-call (js-array items log f) :forEach (lambda (x) (js-call a :release x)))
            (js-call a :collect))))
      (finish a))))

  (test "missing methods on primitive receivers evaluate every argument before noncallable failure" (lambda ()
    (let* ((a (instance))
           (marker (array a (js-array false))))
      (js-call (js-array false t 0 globalThis.NaN "text") :forEach
        (lambda (v)
          (let ((receiver (box a v)))
            (js-call a :set marker 0 false)
            (js-call assert :throws (lambda () (js-call a :invoke "nullish-order" (js-array receiver marker))))
            (let ((changed (js-call a :get marker 0)))
              (js-call assert :equal (js-call a :readNumber changed) 1)
              (js-call a :release changed)
              (js-call a :release receiver)))))
      (let ((items (array a (js-array))))
        (js-call assert :throws (lambda () (js-call a :invoke "map-shadow" (js-array items false))))
        (js-call a :set marker 0 false)
        (js-call assert :throws (lambda () (js-call a :invoke "nullish-order" (js-array items marker))))
        (let ((changed (js-call a :get marker 0)))
          (js-call assert :equal (js-call a :readNumber changed) 1)
          (js-call a :release changed)
          (finish a (js-array marker items)))))))

  (test "deterministic sparse argument models match independent Array controls for every callback method" (lambda ()
    (let* ((a (instance))
           (f (js-call a :invoke "identity"))
           (sum (js-call a :invoke "sum-callback"))
           (seed 121810457)
           (next (lambda ()
                   (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223)))
                   seed))
           (pool (js-array undefined nil false t -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity) globalThis.Number.MIN_VALUE "" "中😀"))
           (run 0))
      (while (< run 96)
        (let ((values (new globalThis.Array (% (funcall next) 13)))
              (i 0))
          (while (< i (js-length values))
            (when (/= (% (funcall next) 3) 0)
              (put values i (aref pool (% (funcall next) (js-length pool)))))
            (setq i (1+ i)))
          (let ((items (array a values)))
            (js-call methods :forEach
              (lambda (pair)
                (let ((name (aref pair 0)) (method (aref pair 1)))
                  (js-call assert :deepEqual
                    (invoke a (str name "-with") (js-array items f))
                    (js-call values method (lambda (x) x))
                    (str name " model " run)))))
            (let ((initial (js-call a :number -0.0)))
              (js-call assert :deepEqual
                (invoke a "reduce-initial" (js-array items sum initial))
                (js-call values :reduce (lambda (acc x) (+ acc x)) -0.0))
              (js-call assert :deepEqual
                (invoke a "reduce-right-initial" (js-array items sum initial))
                (js-call values :reduceRight (lambda (acc x) (+ acc x)) -0.0))
              (js-call a :release items)
              (js-call a :release initial)
              (js-call a :collect))))
        (setq run (1+ run)))
      (finish a (js-array f sum)))))

  (test "source method lookup also captures callable properties on ordinary objects" (lambda ()
    (let* ((a (instance))
           (object (js-call a :sourceObject (js-object)))
           (f (js-call a :invoke "shadow-value")))
      (js-call assert :equal (invoke a "map-shadow" (js-array object f)) 15)
      (finish a (js-array object f)))))

  (test "actual callback capacity failure preserves earlier effects and unwinds only the entered frames" (lambda ()
    (let* ((a (instance (js-object :maxSlots 64 :initialBytes 8192 :maxBytes 32768)))
           (items (array a (js-call (new globalThis.Array 128) :fill t)))
           (log (js-call a :sourceArray (js-array)))
           (f (js-call a :invoke "collect-arguments" (js-array log)))
           (keep (js-call a :number 7))
           (frame (js-call a :frame 1)))
      (js-call a :frameSet frame 0 keep)
      (js-call assert :throws
        (lambda () (js-call a :invoke "map-with" (js-array items f)))
        (rt-diag-p "ELI-RT0002"))
      (funcall assert (and (> (js-call a :length log) 0) (< (js-call a :length log) 128)))
      (js-call assert :equal (js-call a :length items) 128)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
      (let ((saved (js-call a :frameGet frame 0)))
        (js-call assert :equal (js-call a :readNumber saved) 7)
        (js-call a :release saved)
        (js-call a :leaveFrame frame)
        (finish a (js-array items log f keep))))))

  (test "actual callback predicate traps restore the caller frame and original failures suppress later traps" (async ()
    (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (start (js-call source :indexOf "  (defun value-js-truth (heap value)"))
           (end (js-call source :indexOf "  (defun " (+ start 10))))
      (funcall assert (and (>= start 0) (> end start)))
      (let* ((faulty (str (js-call source :slice 0 start)
                          "  (defun value-js-truth (heap value) (load-u32 4294967295))\n"
                          (js-call source :slice end)))
             (rt (js-call (get backend :compiler) :compile_ir_string faulty "callback-trap.eli"))
             (a (instantiateManagedRuntime (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program rt))))
             (_ (js-call a :auto 1))
             (items (array a (js-array t)))
             (f (js-call a :invoke "identity"))
             (marker (array a (js-array false)))
             (frame (js-call a :frame 1)))
        (js-call a :frameSet frame 0 marker)
        (js-call assert :throws (lambda () (js-call a :invoke "some-with" (js-array items f))) globalThis.WebAssembly.RuntimeError)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (js-call assert :throws (lambda () (js-call a :invoke "first-error" (js-array items marker))) (rt-diag-p "ELI-RT0003"))
        (js-call assert :equal (js-call a :get marker 0) false)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (js-call a :leaveFrame frame)
        (finish a (js-array items f marker))))))

  (test "raw WASM JavaScript truth handles payload NaNs signed zero subnormals strings and opaque identity" (lambda ()
    (let ((ir (globalThis.structuredClone runtime)))
      (js-call (get ir :body) :push
        (js-object :kind "export-declaration" :value nil
          :children (js-array (js-object :kind "reference" :value "value-js-truth" :children (js-array)))))
      (let* ((raw-bytes (Uint8Array/from (js-call (get backend :wasm) :emit_memory_wasm ir)))
             (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module raw-bytes)) :exports))
             (heap (js-call e "heap-new" 64 4096 32768))
             (cases (js-array
                      (js-array 0 0 false)
                      (js-array 0 2147483648 false)
                      (js-array 305419896 2146959360 false)
                      (js-array 1 2146435072 false)
                      (js-array 0 4294443008 false)
                      (js-array 1 0 t)
                      (js-array 0 2146435072 t)
                      (js-array 0 4293918720 t)
                      (js-array 4294967295 2146435071 t))))
        (js-call cases :forEach
          (lambda (row)
            (let* ((low (aref row 0))
                   (high (aref row 1))
                   (expected (aref row 2))
                   (value (js-call e "value-number" heap low high)))
              (js-call assert :equal (js-call e "last-error") 0)
              (js-call assert :equal (js-call e "value-js-truth" heap value) (if expected 1 0))
              (js-call assert :equal (js-call e "last-error") 0)
              (js-call assert :equal (js-call e "value-truth" heap value) 1)
              (js-call e "heap-collect" heap))))
        (js-call (js-array (js-array 0 0) (js-array 1 0) (js-array 2 1) (js-array 3 0)) :forEach
          (lambda (pair)
            (js-call assert :equal (js-call e "value-js-truth" heap (aref pair 0)) (aref pair 1))))
        (let ((empty (js-call e "value-string" heap 0)))
          (js-call e "value-seal" heap empty)
          (js-call assert :equal (js-call e "value-js-truth" heap empty) 0)
          (js-call assert :equal (js-call e "value-truth" heap empty) 1)
          (js-call e "heap-collect" heap))
        (let ((arr (js-call e "value-array-new" heap 0)))
          (js-call assert :equal (js-call e "value-js-truth" heap arr) 1)
          (js-call e "heap-collect" heap)
          (js-call assert :equal (js-call e "heap-live" heap) 0)
          (js-call assert :equal (js-call e "frame-depth" heap) 0))))))

  (test "Node executes the identical callback artifact with sparse arrays exact truth and owned root cleanup" (async ()
    (let ((artifact (resolve directory "callbacks.wasm"))
          (runner (resolve "tests/helpers/wasm-managed-array-callbacks-node.mjs")))
      (await (writeFile artifact (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program runtime))))
      (let ((result (spawnSync "node" (js-array runner artifact) (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get result :status) 0 (get result :stderr))
        (js-call assert :match (get result :stdout) (new globalThis.RegExp "independent Node callback semantics passed"))))))

  (test "map and filter retain the existing source-array constructor species refusal semantics" (lambda ()
    (let* ((a (instance))
           (items (array a (js-array t false)))
           (f (js-call a :invoke "identity"))
           (object (js-call a :sourceObject (js-object))))
      (js-call (js-array "map-constructor" "filter-constructor") :forEach
        (lambda (name)
          (js-call (js-array nil false t 0 globalThis.NaN "") :forEach
            (lambda (value)
              (let ((ctor (box a value)))
                (js-call assert :throws
                  (lambda () (js-call reference (js-call name :replaceAll "-" "_") (js-array t false) (lambda (x) x) value))
                  globalThis.TypeError)
                (js-call assert :throws
                  (lambda () (js-call a :invoke name (js-array items f ctor)))
                  (rt-diag-p "ELI-RT0003"))
                (js-call a :release ctor))))
          (js-call (js-array undefined object f) :forEach
            (lambda (ctor)
              (js-call assert :deepEqual
                (invoke a name (js-array items f ctor))
                (if (= name "map-constructor") (js-array t false) (js-array t)))))))
      (finish a (js-array items f object))))))
