(module tests.ci-contract-test-ground
  (import "bun:test" beforeAll describe expect spyOn test)
  (import "node:fs/promises" readFile mkdtemp mkdir writeFile chmod rm access)
  (import "node:os" tmpdir)
  (import "node:process" :default process)
  (import "node:crypto" createHash)
  (import "node:child_process" spawnSync)
  (import "node:path" :default path)
  (import "node:url" fileURLToPath)
  (import "../tools/ci/render-workflow.mjs" checkCompatibilityWorkflow CompatibilityMatrixError renderWorkflow validateCompatibilityMatrix)
  (import "../tools/ci/render-browser-workflow.mjs" checkBrowserCompatibilityWorkflow renderBrowserWorkflow validateBrowserCompatibility)
  (import "../tools/testing/file-workers.mjs" scheduleTestFiles FILE_WORKERS parseTestFileArgs partitionTestFiles)
  (import "./helpers/ci-contract-affected.mjs" runWorkflowCommandsCase runWorkflowDriftCase runBrowserWorkflowCase runCompatibilityWorkflowCase runEightShardInventoryCase)
  (defconst root (js-call path :resolve (js-call path :dirname (fileURLToPath (js* "import.meta.url"))) ".."))
  (defvar baseline undefined) (defvar browserContract undefined) (defvar workerFixture undefined)
  (defconst importModule (js* "(specifier) => import(specifier)"))
  (beforeAll (async ()
    (setq baseline (JSON/parse (await (readFile (js-call path :join root "contracts/compatibility-matrix.json") "utf8")))
      browserContract (JSON/parse (await (readFile (js-call path :join root "contracts/browser-compatibility.json") "utf8")))
      workerFixture (await (readFile (fileURLToPath (new globalThis.URL "./fixtures/ci-worker-test-host.mjs" (js* "import.meta.url"))))))))
  (defun copyBaseline () (globalThis.structuredClone baseline))
  (defun be (a b) (js-call (expect a) :toBe b))
  (defun same (a b) (js-call (expect a) :toEqual b))
  (defun contains (a b) (js-call (expect a) :toContain b))
  (defun countIs (a n) (js-call (expect a) :toHaveLength n))
  (defun rx (pattern &rest __host_forwarded_arguments_1)
    (let* ((flags (aref __host_forwarded_arguments_1 0))) (new globalThis.RegExp pattern flags)))
  (defun hasMatch (text pattern) (js-call (expect text) :toMatch (rx pattern)))
  (defun raises (action &rest __host_default_arguments_1)
    (let* ((pattern (aref __host_default_arguments_1 0))) (js-call (expect action) :toThrow (if (= pattern undefined) undefined (rx pattern)))))
  (defasync rejects (promise &rest __host_default_arguments_2)
    (let* ((pattern (aref __host_default_arguments_2 0))) (js-call (get (expect promise) :rejects) :toThrow (if (= pattern undefined) undefined (rx pattern)))))
  (defun expectMatrixFailure (matrix pattern)
    (try (validateCompatibilityMatrix matrix) (throw (new globalThis.Error "expected compatibility matrix validation to fail"))
      (catch error (js-call (expect error) :toBeInstanceOf CompatibilityMatrixError) (js-call (expect (get error :message)) :toMatch (rx pattern)))))
  (defasync withDirectory (prefix action)
    (let ((directory (await (mkdtemp (js-call path :join (tmpdir) prefix)))))
      (try (await (action directory)) (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defun schedulingTestTransport ()
    (let ((children (new globalThis.Set)))
      (js-object :failure nil :run (lambda (request)
        (let ((child (Bun/spawn (js-call (js-array (get request :command)) :concat (get request :args)) (js-object :stdin "ignore" :stdout "inherit" :stderr "inherit"))))
          (js-call children :add child)
          (js-call (js-call (get child :exited) :then (lambda (exitCode) (js-object :exitCode exitCode))) :finally (lambda () (js-call children :delete child)))))
        :cancel (lambda (signal) (js-call children :forEach (lambda (child) (js-call child :kill signal)))))))
  (defun runTestFiles (files) (scheduleTestFiles files (schedulingTestTransport)))
  (defun spawnFiles (directory files env &rest __host_default_arguments_3)
    (let* ((flags (aref __host_default_arguments_3 0)))
    (spawnSync (get process :execPath) (js-call (js-array (js-call path :join root "tools/testing/file-workers.mjs")) :concat (if (= flags undefined) (js-array) flags) files)
      (js-object :cwd directory :env env :encoding "utf8" :timeout 30000))))
  (defasync writeWorker (file recipe)
    (await (writeFile file workerFixture)) (await (writeFile (str file ".json") (JSON/stringify recipe))))
  (defasync writeWorkers (directory size mode &rest __host_forwarded_arguments_2)
    (let* ((shard (aref __host_forwarded_arguments_2 0)))
    (let ((files (Array/from (js-object :length size) (lambda (unused i) (js-call path :join directory (str i ".test.mjs"))))) (i 0))
      (while (< i size)
        (await (writeWorker (aref files i) (js-object :mode mode :index i :shard shard :title (str (if (= mode "fresh") "pair " (if (= mode "shard") "case " "held ")) i))))
        (setq i (1+ i))) files)))
  (defun tick () (new globalThis.Promise (lambda (accept) (globalThis.setImmediate accept))))
  (defun pause () (new globalThis.Promise (lambda (accept) (globalThis.setTimeout accept 10))))
  (defasync cancelFiles (signal status &rest __host_default_arguments_4)
    (let* ((shard (aref __host_default_arguments_4 0)))
    (await (withDirectory (if (= shard undefined) "eliscript-cancel-file-workers-" "eliscript-shard-cancel-") (async (directory)
      (let* ((files (await (writeWorkers directory (if (= shard undefined) 4 6) "cancel" (not (= shard undefined)))))
             (selected (js-call (Array/from (js-object :length (get files :length)) (lambda (unused i) i)) :filter (lambda (i) (or (= shard undefined) (= (mod i 2) (1- shard))))))
             (env (Object/assign (js-object) (get process :env))) (child undefined))
        (put env (if (= shard undefined) "ELISCRIPT_CANCEL_WORKERS" "ELISCRIPT_SHARD_CANCEL") directory)
        (try
          (setq child (Bun/spawn (js-call (js-array (get process :execPath) (js-call path :join root "tools/testing/file-workers.mjs"))
            :concat (if (= shard undefined) (js-array) (js-array "--shard-index" (funcall globalThis.String shard) "--shard-count" "2")) files)
            (js-object :cwd directory :env env :stdout "ignore" :stderr "ignore")))
          (let ((deadline (+ (Date/now) 3000)) (pids undefined))
            (while (and (= pids undefined) (< (Date/now) deadline))
              (try (setq pids (await (Promise/all (js-call (js-call selected :slice 0 2) :map (lambda (i) (readFile (js-call path :join directory (str "pid-" i)) "utf8"))))))
                (catch error (await (pause)))))
            (be (if (nullish? pids) undefined (get pids :length)) 2)
            (js-call child :kill signal) (be (await (get child :exited)) status)
            (js-call pids :forEach (lambda (pid) (raises (lambda () (js-call process :kill (funcall globalThis.Number pid) 0)))))
            (let ((i 0)) (while (< i (get files :length))
              (unless (js-call (js-call selected :slice 0 2) :includes i) (await (rejects (access (js-call path :join directory (str "pid-" i)))))) (setq i (1+ i)))))
          (finally (when child (js-call child :kill) (await (get child :exited)))))))))))
  (defasync exclusiveSequence ()
    (let* ((exclusive (js-call (js-array "wasm-compiler-ir-lower" "wasm-managed-array-sort" "native-compiler-modules" "bootstrap-compiler") :map
              (lambda (name i) (if (= (mod i 2) 0) (str "tests/" name ".test.mjs") (js-call path :join root "tests" (str name ".test.mjs"))))))
           (ordinary (js-call (js-call "abcdefghi" :split "") :map (lambda (name) (str name ".test.mjs"))))
           (files (js-array (aref ordinary 0) (aref ordinary 1) (aref ordinary 2) (aref exclusive 0) (aref ordinary 3) (aref ordinary 4) (aref exclusive 1) (aref exclusive 2)
              (aref ordinary 5) (aref ordinary 6) (aref exclusive 3) (aref ordinary 7) (aref ordinary 8)))
           (active (new globalThis.Map)) (started (js-array)) (exits (new globalThis.Map)))
      (letfn ((complete (file &rest __opt_code)
          (let* ((rawCode (aref __opt_code 0))
                 (code (if (= rawCode undefined) 0 rawCode))
                 (entry (js-call active :get file)))
            (js-call (expect entry) :toBeDefined) (js-call active :delete file) (js-call exits :set file code) (funcall (get entry :done) code)))
        (keys () (Array/from (js-call active :keys))))
        (let* ((spawn (js-call (spyOn globalThis.Bun "spawn") :mockImplementation (lambda (arguments options)
                   (let ((file (aref arguments 3)) (done undefined))
                     (same (js-call arguments :slice 0 3) (js-array (get process :execPath) "--smol" "test"))
                     (same options (js-object :stdin "ignore" :stdout "inherit" :stderr "inherit"))
                     (let* ((exited (new globalThis.Promise (lambda (accept) (setq done accept))))
                            (child (js-object :exited exited :kill (lambda (signal) (complete file (if (= signal "SIGINT") 130 143))))))
                       (js-call started :push file) (js-call active :set file (js-object :done done :child child)) child)))))
               (running (runTestFiles files)))
          (try
            (same (keys) (js-call ordinary :slice 0 2))
            (complete (aref ordinary 1)) (await (tick)) (same (keys) (js-array (aref ordinary 0) (aref ordinary 2)))
            (complete (aref ordinary 2) 9) (await (tick)) (same (keys) (js-array (aref ordinary 0)))
            (complete (aref ordinary 0)) (await (tick)) (same (keys) (js-array (aref exclusive 0)))
            (complete (aref exclusive 0) 2) (await (tick)) (same (keys) (js-call ordinary :slice 3 5))
            (complete (aref ordinary 3)) (await (tick)) (same (keys) (js-array (aref ordinary 4)))
            (complete (aref ordinary 4)) (await (tick)) (same (keys) (js-array (aref exclusive 1)))
            (complete (aref exclusive 1)) (await (tick)) (same (keys) (js-array (aref exclusive 2)))
            (complete (aref exclusive 2) 3) (await (tick)) (same (keys) (js-call ordinary :slice 5 7))
            (complete (aref ordinary 6)) (complete (aref ordinary 5)) (await (tick)) (same (keys) (js-array (aref exclusive 3)))
            (complete (aref exclusive 3)) (await (tick)) (same (keys) (js-call ordinary :slice 7))
            (complete (aref ordinary 8)) (complete (aref ordinary 7))
            (let ((result (await running))) (be (get result :exitCode) 1) (same started files) (same (get result :results) (js-call files :map (lambda (file) (js-object :file file :exitCode (js-call exits :get file))))))
            (finally (js-call process :emit "SIGTERM") (await running) (js-call spawn :mockRestore)))))))
  (defasync exclusiveSpawnFailure ()
    (let* ((files (js-array "before.test.mjs" "tests/wasm-managed-array-sort.test.mjs" "after-a.test.mjs" "after-b.test.mjs"))
           (active (new globalThis.Map)) (attempts (js-array))
           (spawn (js-call (spyOn globalThis.Bun "spawn") :mockImplementation (lambda (arguments)
             (let ((file (aref arguments 3)) (done undefined))
               (js-call attempts :push file) (when (= file (aref files 1)) (throw (new globalThis.Error "injected exclusive spawn failure")))
               (let ((exited (new globalThis.Promise (lambda (accept) (setq done accept)))))
                 (js-call active :set file done)
                 (js-object :exited exited :kill (lambda () (let ((finish (js-call active :get file))) (when finish (finish 143))) (js-call active :delete file))))))))
           (errors (js-call (spyOn globalThis.console "error") :mockImplementation (lambda () undefined))) (running (runTestFiles files)))
      (try
        (same attempts (js-array (aref files 0))) (funcall (js-call active :get (aref files 0)) 0) (js-call active :delete (aref files 0))
        (await (tick)) (same (Array/from (js-call active :keys)) (js-call files :slice 2))
        (funcall (js-call active :get (aref files 3)) 0) (funcall (js-call active :get (aref files 2)) 0) (js-call active :clear)
        (same (await running) (js-object :results (js-call files :map (lambda (file i) (js-object :file file :exitCode (if (= i 1) 1 0)))) :exitCode 1))
        (same attempts files) (js-call (expect errors) :toHaveBeenCalledTimes 1)
        (finally (js-call process :emit "SIGTERM") (await running) (js-call spawn :mockRestore) (js-call errors :mockRestore)))))
  (defasync exclusiveCancel (signal status firstExclusive)
    (let* ((exclusive "tests/bootstrap-compiler.test.mjs")
           (files (if firstExclusive (js-array exclusive "after-a.test.mjs" "after-b.test.mjs") (js-array "before-a.test.mjs" "before-b.test.mjs" exclusive "after.test.mjs")))
           (started (js-array)) (killed (js-array)) (listeners (js-call (js-array "SIGINT" "SIGTERM") :map (lambda (name) (js-call process :listenerCount name))))
           (spawn (js-call (spyOn globalThis.Bun "spawn") :mockImplementation (lambda (arguments)
             (let* ((file (aref arguments 3)) (done undefined) (exited (new globalThis.Promise (lambda (accept) (setq done accept)))))
               (js-call started :push file) (js-object :exited exited :kill (lambda (received) (js-call killed :push (js-array file received)) (done status)))))))
           (running (runTestFiles files)))
      (try
        (same started (js-call files :slice 0 (if firstExclusive 1 2))) (js-call process :emit signal)
        (let ((result (await running)))
          (be (get result :exitCode) status) (same (get result :results) (js-call started :map (lambda (file) (js-object :file file :exitCode status))))
          (same killed (js-call started :map (lambda (file) (js-array file signal)))) (same started (js-call files :slice 0 (if firstExclusive 1 2)))
          (same (js-call (js-array "SIGINT" "SIGTERM") :map (lambda (name) (js-call process :listenerCount name))) listeners))
        (finally (js-call process :emit "SIGTERM") (await running) (js-call spawn :mockRestore)))))
  (defconst curlInstallerFixture "#!${shell}\ncase \" $* \" in *\" --connect-timeout 10 \"*) ;; *) echo 'unbounded connection' >&2; exit 42;; esac\ncase \" $* \" in *\" --max-time 60 \"*) ;; *) echo 'unbounded transfer' >&2; exit 42;; esac\ncase \" $* \" in *\" --retry 2 \"*) ;; *) echo 'missing retry policy' >&2; exit 42;; esac\ncase \" $* \" in *\" --retry-max-time 60 \"*) ;; *) echo 'unbounded retries' >&2; exit 42;; esac\nwhile [ \"$#\" -gt 0 ]; do case \"$1\" in --output) shift; output=$1;; https://*) url=$1;; esac; shift; done\ncase \"$url\" in */SHASUMS256.txt)\n  case \"$ELISCRIPT_TEST_CHECKSUM\" in missing) printf 'unused row\\n' > \"$output\";; bad) printf '%064d  %s.tar.gz\\n' 0 \"$ELISCRIPT_TEST_NODE_NAME\" > \"$output\";; *) printf '%s  %s.tar.gz\\n' \"$ELISCRIPT_TEST_CHECKSUM\" \"$ELISCRIPT_TEST_NODE_NAME\" > \"$output\";; esac;;\n  *) cp \"$ELISCRIPT_TEST_ARCHIVE\" \"$output\";; esac\n")
  (describe "compatibility matrix contract" (lambda ()
    (test "performance deferral is explicit while full functional commands and strict defaults remain available" (lambda ()
      (let ((strict (copyBaseline)))
      (Reflect/deleteProperty strict "performanceAcceptance")
      (js-call (get (expect (renderWorkflow strict)) :not) :toContain "ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE")
      (let ((deferred (Object/assign (js-object) strict (js-object :performanceAcceptance "deferred"))))
        (contains (renderWorkflow deferred) "ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE: \"1\"") (contains (renderWorkflow deferred) "performance reacceptance deferred")
        (contains (renderWorkflow deferred) "run: bun run test") (contains (renderWorkflow deferred) "run: make byte-compile"))
      (expectMatrixFailure (Object/assign (js-object) strict (js-object :performanceAcceptance "passed")) "performanceAcceptance"))))
    (test "CI retains complete commands and original timeouts while isolating two test-file workers" (async ()
      (await (runWorkflowCommandsCase))))
    (test "parallel Bun files isolate process state, execute every case and propagate an actual failure" (async ()
      (await (withDirectory "eliscript-test-file-workers-" (async (directory)
      (let* ((a (js-call path :join directory "a.test.mjs")) (b (js-call path :join directory "b.test.mjs"))
             (env (Object/assign (js-object) (get process :env) (js-object :ELISCRIPT_FILE_WORKER_OUTPUT directory))))
        (await (writeWorker a (js-object :mode "isolation" :name "a" :title "a")))
        (await (writeWorker b (js-object :mode "isolation" :name "b" :title "b")))
        (Reflect/deleteProperty env "ELISCRIPT_FILE_WORKER_STATE")
        (let ((success (spawnFiles directory (js-array a b) env)))
          (be (get success :status) 0) (be (await (readFile (js-call path :join directory "a") "utf8")) "executed") (be (await (readFile (js-call path :join directory "b") "utf8")) "executed"))
        (await (writeWorker b (js-object :mode "isolation" :name "b" :title "b" :fail t)))
        (await (rm (js-call path :join directory "a"))) (await (rm (js-call path :join directory "b")))
        (let ((failure (spawnFiles directory (js-array a b) env)))
          (be (get failure :status) 1) (contains (get failure :stderr) "intentional isolated failure")
          (be (await (readFile (js-call path :join directory "a") "utf8")) "executed") (be (await (readFile (js-call path :join directory "b") "utf8")) "executed"))))))))
    (test "fresh file workers reject invalid inventories and retain spawn failures without skipping other files" (async ()
      (let ((runner (await (funcall importModule "../tools/testing/file-workers.mjs"))))
      (be (get runner :FILE_WORKERS) 2)
      (let ((invalid (js-array nil (js-array) (js-array "a.mjs") (js-array nil) (js-array "a.test.mjs" "a.test.mjs"))) (i 0))
        (while (< i (get invalid :length)) (await (rejects (runTestFiles (aref invalid i)) "unique test files")) (setq i (1+ i))))
      (let ((spawn (js-call (spyOn globalThis.Bun "spawn") :mockImplementation (lambda () (throw (new globalThis.Error "injected spawn failure"))))))
        (try
          (let ((result (await (runTestFiles (js-array "a.test.mjs" "b.test.mjs" "c.test.mjs")))))
            (be (get result :exitCode) 1) (same (get result :results) (js-call (js-array "a" "b" "c") :map (lambda (name) (js-object :file (str name ".test.mjs") :exitCode 1))))
            (js-call (expect spawn) :toHaveBeenCalledTimes 3))
          (finally (js-call spawn :mockRestore)))))))
    (test "each file starts a new process and two workers complete every synchronized pair" (async ()
      (await (withDirectory "eliscript-fresh-file-workers-" (async (directory)
      (let* ((files (await (writeWorkers directory 4 "fresh")))
             (child (spawnFiles directory files (Object/assign (js-object) (get process :env) (js-object :ELISCRIPT_FRESH_WORKERS directory)))))
        (be (get child :status) 0) (contains (get child :stdout) "4/4 completed; 0 failed")
        (let ((intervals (await (Promise/all (js-call files :map (async (unused i)
          (Object/assign (js-object) (JSON/parse (await (readFile (js-call path :join directory (str "start-" i)) "utf8")))
            (js-object :end (funcall globalThis.Number (await (readFile (js-call path :join directory (str "end-" i)) "utf8")))))))))) (i 0))
          (be (get (new globalThis.Set (js-call intervals :map (lambda (item) (get item :pid)))) :size) 4)
          (while (< i 4)
            (js-call (expect (get (aref intervals i) :start)) :toBeLessThanOrEqual (get (aref intervals (1+ i)) :end))
            (js-call (expect (get (aref intervals (1+ i)) :start)) :toBeLessThanOrEqual (get (aref intervals i) :end)) (setq i (+ i 2)))
          (js-call (expect (Math/max (get (aref intervals 0) :end) (get (aref intervals 1) :end))) :toBeLessThanOrEqual
            (Math/max (get (aref intervals 2) :start) (get (aref intervals 3) :start))))))))))
    (test "interrupting fresh file workers reaps only their owned children and does not start queued files" (async ()
      (await (cancelFiles "SIGINT" 130)) (await (cancelFiles "SIGTERM" 143))))
    (test "exclusive file barriers retain two ordinary workers and ordered complete results after failures" (async ()
      (await (exclusiveSequence))))
    (test "exclusive file barriers retain an exclusive spawn failure and continue every later ordinary task" (async ()
      (await (exclusiveSpawnFailure))))
    (test "exclusive file barriers cancel ordinary or exclusive phases without dispatching queued files" (async ()
      (await (exclusiveCancel "SIGINT" 130 false)) (await (exclusiveCancel "SIGINT" 130 t))
    (await (exclusiveCancel "SIGTERM" 143 false)) (await (exclusiveCancel "SIGTERM" 143 t))))
    (test "repository compatibility matrix renders the committed CI workflow" (async ()
      (await (runCompatibilityWorkflowCase))))
    (test "Pages and release workflows pin the same Emacs 32.0.50 source commit" (async ()
      (let* ((pages (await (readFile (js-call path :join root ".github/workflows/pages.yml") "utf8")))
             (release (await (readFile (js-call path :join root ".github/workflows/release.yml") "utf8")))
             (commit "fd7afced4036fc1a221567d70705d20a2bd64713"))
        (js-call (js-array pages release) :forEach (lambda (workflow)
          (contains workflow (str "EMACS_COMMIT: " commit))
          (contains workflow "test \"$(emacs --version | head -n 1)\" = \"GNU Emacs 32.0.50\"")
          (contains workflow "--without-native-compilation")
          (be (js-call workflow :includes "purcell/setup-emacs") false)
          (be (js-call workflow :includes "version: \"30.2\"") false))))))
    (test "matrix rejects a missing supported operating system" (lambda ()
      (let ((matrix (copyBaseline))) (put matrix :operatingSystems (js-call (get matrix :operatingSystems) :slice 0 1)) (expectMatrixFailure matrix "must include linux and macos"))))
    (test "matrix rejects a non-policy Emacs version" (lambda ()
      (let ((matrix (copyBaseline))) (put matrix :emacsVersions (js-array "30.2")) (expectMatrixFailure matrix "contain exactly 32.0.50"))
      (let ((matrix (copyBaseline))) (put matrix :emacsVersions (js-array "32.0.50" "33.1")) (expectMatrixFailure matrix "contain exactly 32.0.50"))
      (let ((matrix (copyBaseline))) (put matrix :emacsVersions (js-array "32.0.50.1")) (expectMatrixFailure matrix "valid major.minor or major.minor.patch"))))
    (test "matrix requires an exact pinned Emacs source commit and snapshot-free install path" (lambda ()
      (let ((matrix (copyBaseline))) (Reflect/deleteProperty matrix "emacsInstall") (expectMatrixFailure matrix "emacsInstall must pin"))
      (let ((matrix (copyBaseline))) (put (get matrix :emacsInstall) "32.0.50" "snapshot") (expectMatrixFailure matrix "emacsInstall must pin"))
      (let ((matrix (copyBaseline))) (put (get (get matrix :emacsInstall) "32.0.50") :commit "fd7afced") (expectMatrixFailure matrix "emacsInstall must pin"))
      (let ((matrix (copyBaseline))) (put (get (get matrix :emacsInstall) "32.0.50") :source "https://github.com/other/emacs") (expectMatrixFailure matrix "emacsInstall must pin"))))
    (test "matrix distinguishes runner ids from actual platforms and rejects duplicate machine coverage" (lambda ()
      (js-call (js-array "" "darwin" "linux-arm64" nil 1) :forEach (lambda (operatingSystem)
      (let ((matrix (copyBaseline))) (put (aref (get matrix :operatingSystems) 1) :operatingSystem operatingSystem) (expectMatrixFailure matrix "operatingSystem must identify linux or macos"))))
    (let ((duplicate (copyBaseline))) (put (aref (get duplicate :operatingSystems) 1) :architecture "x64") (expectMatrixFailure duplicate "duplicates an actual operatingSystem and architecture"))
    (let ((wrongCanonical (copyBaseline))) (put (aref (get wrongCanonical :operatingSystems) 0) :operatingSystem "macos") (expectMatrixFailure wrongCanonical "operatingSystem must match its canonical system id"))
    (let ((missingFamily (copyBaseline))) (Reflect/deleteProperty (aref (get missingFamily :operatingSystems) 1) "operatingSystem") (expectMatrixFailure missingFamily "operatingSystem must identify linux or macos"))))
    (test "matrix rejects an empty or unknown acceptance operating system" (lambda ()
      (let ((empty (copyBaseline))) (put empty :acceptanceOperatingSystems (js-array)) (expectMatrixFailure empty "must be a non-empty string array"))
    (let ((unknown (copyBaseline))) (put unknown :acceptanceOperatingSystems (js-array "windows")) (expectMatrixFailure unknown "must exist in operatingSystems"))))
    (test "matrix rejects mutable action references" (lambda ()
      (let ((matrix (copyBaseline))) (put (aref (get matrix :actions) 0) :revision "v6") (expectMatrixFailure matrix "full lowercase commit SHA"))))
    (test "matrix rejects a weakened command sequence" (lambda ()
      (let ((matrix (copyBaseline))) (put matrix :commands (js-call (get matrix :commands) :filter (lambda (command) (not (= command "make byte-compile"))))) (expectMatrixFailure matrix "commands must be"))))
    (test "matrix rejects incomplete local evidence settings" (lambda ()
      (let ((matrix (copyBaseline))) (put (get (get matrix :localEvidence) :nodeHost) :version "current")
      (Reflect/deleteProperty (get (get matrix :localEvidence) :timeoutsMs) "make byte-compile")
      (expectMatrixFailure matrix "exact Node version") (expectMatrixFailure matrix "timeoutsMs must cover every command"))))
    (test "CI installs and verifies the contracted Node host before testing" (lambda ()
      (let ((workflow (renderWorkflow baseline)) (version (get (get (get baseline :localEvidence) :nodeHost) :version)))
      (contains workflow (str "node_version=" version)) (contains workflow "https://nodejs.org/dist/v$node_version/$node_archive") (contains workflow "shasum -a 256 -c node.sha256")
      (contains workflow (str "test \"$(node --version)\" = \"v" version "\""))
      (contains workflow "test \"$(bun -p 'process.arch')\" = \"${{ matrix.architecture }}\"") (contains workflow "test \"$(node -p 'process.arch')\" = \"${{ matrix.architecture }}\"")
      (js-call (expect (js-call workflow :indexOf "name: Install Node")) :toBeLessThan (js-call workflow :indexOf "name: Run test file shard"))
      (let ((unsupported (copyBaseline))) (put (get (get unsupported :localEvidence) :nodeHost) :version "22.23.2") (expectMatrixFailure unsupported "exact Node version >=24")))))
    (test "Node installer bounds network waits and rejects bad or missing checksums before extraction" (async ()
      (await (withDirectory "eliscript-node-installer-" (async (directory)
      (let* ((stub (js-call path :join directory "bin")) (payload (js-call path :join directory "payload"))
             (version (get (get (get baseline :localEvidence) :nodeHost) :version)) (platform (if (= (get process :platform) "darwin") "darwin" "linux"))
             (shellResult (spawnSync "sh" (js-array "-c" "command -v sh") (js-object :encoding "utf8"))) (shell (js-call (get shellResult :stdout) :trim))
             (name (str "node-v" version "-" platform "-" (get process :arch))) (archive (js-call path :join directory "node.tar.gz")))
        (be (get shellResult :status) 0) (be (js-call path :isAbsolute shell) t)
        (await (mkdir stub)) (await (mkdir (js-call path :join payload name "bin") (js-object :recursive t)))
        (let ((executable (js-call path :join payload name "bin/node")))
          (await (writeFile executable (str "#!" shell "\nprintf 'v" version "\\n'\n"))) (await (chmod executable 493)))
        (let ((packed (spawnSync "tar" (js-array "-czf" archive "-C" payload name) (js-object :encoding "utf8")))) (be (get packed :status) 0))
        (let* ((checksum (js-call (js-call (createHash "sha256") :update (await (readFile archive))) :digest "hex")) (curl (js-call path :join stub "curl"))
               (script (js-call (js-call (js-call (aref (js-call (aref (js-call (renderWorkflow baseline) :split "      - name: Install Node\n        run: |\n") 1)
                  :split "      - name: Record toolchain\n") 0) :split "\n") :map (lambda (line) (js-call line :slice 10))) :join "\n"))
               (variants (js-array (js-array "valid" checksum) (js-array "bad" "bad") (js-array "missing" "missing"))) (i 0))
          (await (writeFile curl (js-call curlInstallerFixture :replace "${shell}" shell))) (await (chmod curl 493))
          (setq script (js-call script :replaceAll "${{ matrix.architecture }}" (get process :arch)))
          (while (< i (get variants :length))
            (let* ((pair (aref variants i)) (kind (aref pair 0)) (sha (aref pair 1)) (temporary (js-call path :join directory kind)) (githubPath (js-call path :join temporary "path")))
              (await (mkdir temporary))
              (let ((result (spawnSync "bash" (js-array "-e" "-c" script) (js-object :encoding "utf8" :env
                (Object/assign (js-object) (get process :env) (js-object :PATH (str stub (get path :delimiter) (get (get process :env) :PATH))
                  :RUNNER_TEMP temporary :GITHUB_PATH githubPath :ELISCRIPT_TEST_ARCHIVE archive :ELISCRIPT_TEST_CHECKSUM sha :ELISCRIPT_TEST_NODE_NAME name))))))
                (if (= kind "valid")
                  (progn (js-call (expect (get result :status) (get result :stderr)) :toBe 0)
                    (be (await (readFile githubPath "utf8")) (str (js-call path :join temporary "eliscript-node" name "bin") "\n"))
                    (let ((node (spawnSync (js-call path :join temporary "eliscript-node" name "bin/node") (js-array) (js-object :encoding "utf8")))) (be (js-call (get node :stdout) :trim) (str "v" version))))
                  (progn (js-call (get (expect (get result :status)) :not) :toBe 0)
                    (await (rejects (access (js-call path :join temporary "eliscript-node" name)))) (await (rejects (access githubPath)))))))
            (setq i (1+ i))))))))))
    (test "checker rejects manual workflow drift" (async ()
      (await (runWorkflowDriftCase))))
    (test "CI provisions the locked Chromium browser before the mandatory browser test" (lambda ()
      (let* ((workflow (renderWorkflow baseline)) (dependencies (js-call workflow :indexOf "name: Install locked dependencies"))
           (browser (js-call workflow :indexOf "name: Install Chromium")) (tests (js-call workflow :indexOf "name: Run test file shard")))
      (js-call (expect browser) :toBeGreaterThan dependencies) (js-call (expect browser) :toBeLessThan tests)
      (contains workflow "bun node_modules/playwright-core/cli.js install --with-deps chromium"))))
  ))
  (describe "browser compatibility matrix" (lambda ()
    (test "all three real engines run on every supported machine combination" (async ()
      (await (runBrowserWorkflowCase))))
    (test "browser coverage cannot omit, duplicate or silently rename an engine" (lambda ()
      (js-call (js-array (js-array) (js-array "chromium") (js-array "chromium" "chromium" "webkit") (js-array "chromium" "safari" "webkit") (js-array "webkit" "firefox" "chromium")) :forEach
      (lambda (browserEngines) (raises (lambda () (validateBrowserCompatibility (Object/assign (js-object) browserContract (js-object :browserEngines browserEngines)) baseline)) "browserEngines")))))
    (test "browser gate rejects filtering, skipped execution and mutable artifact actions" (lambda ()
      (let* ((testCommand (get browserContract :testCommand))
           (commands (js-array "true" (str testCommand " || true") (str testCommand " --test-name-pattern browser") "bun test tests/direct-wasm-backend.test.mjs"
             (js-call testCommand :replace " tests/wasm-managed-array-search.test.mjs" "") (js-call testCommand :replace " tests/wasm-managed-array-construction.test.mjs" "")
             (js-call testCommand :replace " tests/wasm-managed-object-properties.test.mjs" "") (js-call testCommand :replace " tests/wasm-managed-exceptions-browser.test.mjs" "")
             (js-call testCommand :replace " tests/wasm-managed-symbols.test.mjs" ""))))
      (js-call commands :forEach (lambda (command)
        (raises (lambda () (validateBrowserCompatibility (Object/assign (js-object) browserContract (js-object :testCommand command)) baseline)) "complete direct WASM")))
      (raises (lambda () (validateBrowserCompatibility (Object/assign (js-object) browserContract (js-object :artifactAction (Object/assign (js-object) (get browserContract :artifactAction) (js-object :revision "v4")))) baseline)) "full commit SHA"))))
    (test "browser checker rejects a swallowed failure or removed evidence step" (async ()
      (let* ((workflow (renderBrowserWorkflow browserContract baseline)) (drifts (js-array (js-call workflow :replace "set -o pipefail" "true") (js-call workflow :replace "if: always()" "if: success()"))) (i 0))
      (while (< i (get drifts :length))
        (await (rejects (checkBrowserCompatibilityWorkflow (js-object :contract browserContract :matrix baseline :workflowText (aref drifts i))) "differs")) (setq i (1+ i))))))
  ))
  (describe "CI file shards" (lambda ()
    (test "strict CLI partitions preserve order, cover each file once and reject incomplete or invalid options" (async ()
      (let ((files (js-call (js-array "a" "b" "c" "d" "e") :map (lambda (name) (str name ".test.mjs")))))
      (same (parseTestFileArgs files) (js-object :files files :shard nil))
      (js-call (js-array 1 2 3 8) :forEach (lambda (count)
        (let* ((parts (Array/from (js-object :length count) (lambda (unused i) (partitionTestFiles files (1+ i) count)))) (i 0))
          (same (js-call (js-call parts :flat) :sort) (js-call (js-call files :slice) :sort)) (be (get (new globalThis.Set (js-call parts :flat)) :size) (get files :length))
          (while (< i count) (same (aref parts i) (js-call files :filter (lambda (unused position) (= (mod position count) i)))) (setq i (1+ i))))))
      (same (parseTestFileArgs (js-call (js-array "--shard-index" "2" "--shard-count" "2") :concat files)) (js-object :files files :shard (js-object :index 2 :count 2)))
      (same (parseTestFileArgs (js-call files :concat (js-array "--shard-count" "2" "--shard-index" "1"))) (js-object :files files :shard (js-object :index 1 :count 2)))
      (let ((variants (js-array (js-array) (js-call (js-array "--unknown") :concat files) (js-call (js-array "--shard-index" "1") :concat files)
        (js-call (js-array "--shard-count" "2") :concat files) (js-array "--shard-index") (js-array "--shard-count")
        (js-call (js-array "--shard-index" "1" "--shard-index" "1" "--shard-count" "2") :concat files)
        (js-call (js-array "--shard-index" "1" "--shard-count" "2" "--shard-count" "2") :concat files) (js-call (js-array "--") :concat files)
        (js-array "other.mjs") (js-array (aref files 0) (aref files 0)))))
        (js-call variants :forEach (lambda (args) (raises (lambda () (parseTestFileArgs args))))))
      (js-call (js-array "0" "-1" "1.5" "01" "1e0" "Infinity" "NaN" "9007199254740992" "") :forEach (lambda (value)
        (raises (lambda () (parseTestFileArgs (js-call (js-array "--shard-index" value "--shard-count" "2") :concat files))))
        (raises (lambda () (parseTestFileArgs (js-call (js-array "--shard-index" "1" "--shard-count" value) :concat files))))))
      (js-call (js-array (js-array 0 2) (js-array 3 2) (js-array 1 0) (js-array 1.5 2) (js-array 1 globalThis.Infinity) (js-array 1 "2")) :forEach
        (lambda (pair) (raises (lambda () (partitionTestFiles files (aref pair 0) (aref pair 1))))))
      (raises (lambda () (parseTestFileArgs (js-call (js-array "--shard-index" "3" "--shard-count" "2") :concat files)))))))
    (test "actual CLI shard processes execute the full union exactly once, retain failures and default to all files" (async ()
      (await (withDirectory "eliscript-file-shards-" (async (directory)
      (let* ((log (js-call path :join directory "executed.jsonl")) (files (await (writeWorkers directory 5 "shard"))))
        (letfn ((run (label flags)
          (spawnFiles directory files (Object/assign (js-object) (get process :env)
            (js-object :BUN_TEST_RUNNER "tools/testing/file-workers.mjs --shard-index 2 --shard-count 2" :ELISCRIPT_SHARD_OUTPUT log :ELISCRIPT_SHARD_RUN label)) flags)))
          (js-call (js-array 1 2) :forEach (lambda (index)
            (let ((result (run "shards" (js-array "--shard-index" (funcall globalThis.String index) "--shard-count" "2"))) (n (if (= index 1) 3 2)))
              (js-call (expect (get result :status) (get result :stderr)) :toBe (if (= index 1) 1 0))
              (contains (get result :stdout) (str "Test file shard " index "/2: " n "/5 selected")) (contains (get result :stdout) (str n "/" n " completed")))))
          (let ((full (run "full" (js-array))))
            (be (get full :status) 1) (contains (get full :stdout) "5/5 completed") (js-call (get (expect (get full :stdout)) :not) :toContain "Test file shard"))
          (let ((empty (run "empty" (js-array "--shard-index" "8" "--shard-count" "8")))) (be (get empty :status) 0) (contains (get empty :stdout) "0/5 selected") (contains (get empty :stdout) "0/0 completed"))
          (let ((before (await (readFile log "utf8"))))
            (js-call (js-array (js-array "--shard-index" "1") (js-array "--shard-index" "0" "--shard-count" "2") (js-array "--shrad-index" "1" "--shard-count" "2")) :forEach (lambda (flags)
              (let ((invalid (run "invalid" flags))) (be (get invalid :status) 1) (contains (get invalid :stderr) "test-file arguments"))))
            (be (await (readFile log "utf8")) before)
            (let ((records (js-call (js-call (js-call before :trim) :split "\n") :map (lambda (line) (JSON/parse line)))))
              (js-call (js-array "shards" "full") :forEach (lambda (label)
                (same (js-call (js-call (js-call records :filter (lambda (item) (= (get item :run) label))) :map (lambda (item) (get item :index))) :sort) (js-array 0 1 2 3 4))))
              (countIs records 10))))))))))
    (test "sharded CLI cancellation reaps selected children and never starts queued or unselected files" (async ()
      (await (cancelFiles "SIGINT" 130 1)) (await (cancelFiles "SIGINT" 130 2)) (await (cancelFiles "SIGTERM" 143 1)) (await (cancelFiles "SIGTERM" 143 2))))
    (test "three matrix jobs cover every core and application inventory once per supported machine without weakening other gates" (async ()
      (await (runEightShardInventoryCase))))
    (test "confirmed expensive functional files are exclusive while normal files still overlap" (async ()
      (let* ((expensive (js-call (js-array "wasm-compiler-analyzer" "wasm-compiler-emitter" "independent-compiler-producers" "compiler-producer-stages" "wasm-managed-str" "native-backend" "native-memory-long-branches")
                      :map (lambda (name) (str "tests/" name ".test.mjs"))))
           (files (js-call (js-array "normal-a.test.mjs" "normal-b.test.mjs") :concat expensive (js-array "after-a.test.mjs" "after-b.test.mjs")))
           (active (new globalThis.Set)) (seen (js-array))
           (spawn (js-call (spyOn globalThis.Bun "spawn") :mockImplementation (lambda (arguments)
             (let ((file (aref arguments 3)))
               (if (js-call expensive :includes file) (be (get active :size) 0)
                 (be (js-call (Array/from active) :some (lambda (item) (js-call expensive :includes item))) false))
               (js-call active :add file) (js-call seen :push file)
               (js-object :exited (new globalThis.Promise (lambda (accept) (globalThis.setImmediate (lambda () (js-call active :delete file) (accept 0))))) :kill (lambda () undefined)))))))
      (try (let ((running (runTestFiles files))) (be (get active :size) 2)
        (let ((result (await running))) (same seen files) (be (get result :exitCode) 0) (countIs (get result :results) (get files :length))))
        (finally (js-call spawn :mockRestore))))))
  ))
)
