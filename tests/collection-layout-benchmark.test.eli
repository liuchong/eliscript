(module tests.collection-layout-benchmark.test
  (import "node:process" :default process)
  (import "node:child_process" spawnSync)
  (import "./helpers/performance-acceptance.mjs" currentPerformanceTest)
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:url" fileURLToPath)
  (import "../tools/collections/layout-benchmark.mjs" runLayoutHostBenchmark validateLayoutHostReport)
  (import "../tools/collections/benchmark.mjs" analyzeLayoutSuite benchmarkSourceDigest validateLayoutSuiteReport BROWSER_MODULE_FILES validateBrowserModuleFiles)
  (defun moduleURL (relative) (new globalThis.URL relative (js* "import.meta.url")))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defasync runHost (command arguments_)
    (let* ((source (fileURLToPath (moduleURL "../tools/collections/layout-host.mjs")))
           (argv (js-call (js-array command) :concat arguments_ (js-array source)))
           (child (Bun/spawn argv (js-object :stdout "pipe" :stderr "pipe" :env (Object/assign (js-object) (get process :env)
             (js-object :ELISCRIPT_LAYOUT_OCCUPANCIES "8,16" :ELISCRIPT_LAYOUT_ITERATIONS "5000" :ELISCRIPT_LAYOUT_MUTATION_ITERATIONS "1000"
               :ELISCRIPT_LAYOUT_TIMING_SAMPLES "2" :ELISCRIPT_LAYOUT_MEMORY_NODES "1000" :ELISCRIPT_LAYOUT_MEMORY_SAMPLES "2")))))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (when (not (= (aref result 0) 0))
        (let ((error (js-call (aref result 2) :trim))) (throw (new globalThis.Error (if (= error "") (str command " exited with " (aref result 0)) error)))))
      (validateLayoutHostReport (JSON/parse (aref result 1)))))
  (test "HAMT layout core validates equivalent real node operations" (async ()
    (let ((report (await (runLayoutHostBenchmark (js-object :host (js-object :id "test" :runtime "test") :occupancies (js-array 4 8)
      :lookupIterations 2000 :mutationIterations 500 :timingSamples 2 :memoryNodeCount 100 :memorySamples 2)))))
      (be (validateLayoutHostReport report) report)
      (js-call (expect (get report :validation)) :toMatchObject (js-object :passed t :lookupPath "runtime/core/map-internals.mjs#mapFind"))
      (js-call (expect (get report :measurements)) :toHaveLength 2)
      (js-call (get report :measurements) :forEach (lambda (measurement)
        (be (get (get (get measurement :bitmap) :lookup) :checksum) (get (get (get measurement :array) :lookup) :checksum))
        (be (get (get (get measurement :bitmap) :assoc) :checksum) (get (get (get measurement :array) :assoc) :checksum))
        (be (get (get (get measurement :bitmap) :dissoc) :checksum) (get (get (get measurement :array) :dissoc) :checksum))
        (js-call (expect (get (get (get measurement :bitmap) :bytesPerNode) :median)) :toBeNull)
        (js-call (expect (get (get (get measurement :array) :bytesPerNode) :median)) :toBeNull))))
    (await (js-call (get (expect (runLayoutHostBenchmark (js-object :host (js-object :id "test") :occupancies (js-array 8 8)))) :rejects) :toThrow "strictly increasing"))))
  (test "HAMT layout host adapters agree under Bun and Node" (async ()
    (let* ((node (get (get process :env) :NODE))
           (reports (await (Promise/all (js-array (runHost (get process :execPath) (js-array)) (runHost (if (nullish? node) "node" node) (js-array "--expose-gc"))))))
           (bunReport (aref reports 0)) (nodeReport (aref reports 1)))
      (be (get (get bunReport :host) :id) "bun") (be (get (get nodeReport :host) :id) "node")
      (same (get bunReport :parameters) (get nodeReport :parameters))
      (same (js-call (get bunReport :measurements) :map (lambda (entry) (get entry :checksum))) (js-call (get nodeReport :measurements) :map (lambda (entry) (get entry :checksum))))
      (be (js-call (get bunReport :measurements) :every (lambda (entry)
        (and (= (get (get (get entry :bitmap) :bytesPerNode) :median) nil) (= (get (get (get entry :array) :bytesPerNode) :median) nil)))) t)
      (be (js-call (get nodeReport :measurements) :every (lambda (entry)
        (and (> (get (get (get entry :bitmap) :bytesPerNode) :median) 0) (> (get (get (get entry :array) :bytesPerNode) :median) 0)))) t))))
  (test "HAMT browser benchmark uses copied native ESM without a bundler" (async ()
    ;; Inspect executable Eli source rather than relying on handwritten JS spellings.
    (let ((source (await (readFile (fileURLToPath (moduleURL "../tools/collections/benchmark.eli")) "utf8"))))
      (js-call (get (expect source) :not) :toContain "(import \"vite\"")
      (js-call (expect source) :toContain "((= ext \".mjs\") \"text/javascript; charset=utf-8\")")
      (js-call (expect source) :toContain "\"tools/collections/browser/main.mjs\"")
      (js-call (expect source) :toContain "(await (copyFile (js-call path :join project-directory relative) destination))")
      (js-call (expect source) :toContain "/tools/collections/browser/index.html?"))))
  (test "HAMT browser assets close native and package imports before browser startup" (async ()
    (be (await (validateBrowserModuleFiles)) t)
    (await (Promise/all
      (js-call (js-array "stdlib/bit.mjs" "runtime/primitives.mjs") :map (lambda (missing)
        (js-call (get (expect (validateBrowserModuleFiles
          (js-call BROWSER_MODULE_FILES :filter (lambda (file) (/= file missing))))) :rejects)
          :toThrow "undeclared HAMT browser import")))))
    (await (js-call (get (expect (validateBrowserModuleFiles (js-array))) :rejects)
      :toThrow "requires its HTML and ESM entries"))
    (let* ((html (await (readFile (moduleURL "../tools/collections/browser/index.html") "utf8")))
           (matched (js-call html :match
             (new globalThis.RegExp "<script type=\"importmap\">([\\s\\S]*?)</script>"))))
      (same (JSON/parse (aref matched 1)) (js-object :imports (js-object "eliscript/" "/"))))))
  (test "Node checks the same HAMT browser import closure through the Bun host parser" (lambda ()
    (let* ((selected (get (get process :env) :NODE))
           (node (if (nullish? selected) "node" selected))
           (script (fileURLToPath (moduleURL "../tools/collections/benchmark.mjs")))
           (options (js-object :encoding "utf8" :timeout 10000 :killSignal "SIGKILL"))
           (valid (spawnSync node (js-array script "--validate-browser-files"
                     (JSON/stringify BROWSER_MODULE_FILES)) options))
           (invalid (spawnSync node (js-array script "--validate-browser-files"
                     (JSON/stringify (js-call BROWSER_MODULE_FILES :filter
                       (lambda (file) (/= file "stdlib/bit.mjs"))))) options)))
      (be (get valid :status) 0)
      (be (get valid :stdout) "")
      (be (get invalid :status) 1)
      (js-call (expect (get invalid :stderr)) :toContain "undeclared HAMT browser import"))))
  (test "committed HAMT layout baseline proves the 32/24 threshold decision" (async ()
    (let* ((baselineFile (fileURLToPath (moduleURL "../benchmarks/hamt-layout-macos-arm64.json"))) (baseline (JSON/parse (await (readFile baselineFile "utf8")))))
      (be (validateLayoutSuiteReport baseline) baseline)
      (same (get baseline :runtimeThresholds) (js-object :promotion 32 :demotion 24))
      (same (get baseline :analysis) (analyzeLayoutSuite (get baseline :hosts)))
      (js-call (expect (get baseline :analysis)) :toMatchObject (js-object :promotionCandidate 32 :demotionCandidate 24))
      (let ((mismatched (funcall globalThis.structuredClone baseline)))
        (put mismatched :runtimeThresholds (js-object :promotion 28 :demotion 20))
        (js-call (expect (lambda () (validateLayoutSuiteReport mismatched))) :toThrow "HAMT runtime thresholds 28/20 do not match measured candidates 32/24"))
      (same (js-call (get baseline :hosts) :map (lambda (host) (get (get host :host) :id))) (js-array "bun" "node" "chrome"))
      (be (js-call (get baseline :hosts) :every (lambda (host)
        (js-call (get host :measurements) :every (lambda (measurement)
          (and (= (get (get (get (get measurement :bitmap) :lookup) :samplesMs) :length) 7)
               (= (get (get (get (get measurement :array) :lookup) :samplesMs) :length) 7)))))) t)
      (be (js-call (get (aref (get baseline :hosts) 0) :measurements) :every (lambda (measurement) (= (get (get measurement :ratios) :arrayToBitmapBytes) nil))) t)
      (js-call (js-call (get baseline :hosts) :slice 1) :forEach (lambda (host)
        (be (js-call (get host :measurements) :every (lambda (measurement) (> (get (get measurement :ratios) :arrayToBitmapBytes) 0))) t))))))
  (funcall (currentPerformanceTest test) "current-source performance acceptance: HAMT layout" (async ()
    (let ((report (JSON/parse (await (readFile (moduleURL "../benchmarks/hamt-layout-macos-arm64.json") "utf8")))))
      (same (get report :sourceDigest) (await (benchmarkSourceDigest))))))
)
