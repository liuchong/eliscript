(module tests.wasm-managed-concat.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defvar directory undefined)
  (defvar b undefined)
  (defvar runtime undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-concat-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli")))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defasync compiled (source &rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (let* ((ir (js-call (get b :compiler) :compile_ir_string (str "(defconst marker 1) " source) "concat.eli"))
           (before (JSON/stringify ir))
           (js (await (dynamic-import (str "data:text/javascript;base64,"
                                           (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string ir)) :toString "base64")))))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm ir runtime))))
      (js-call assert :equal (JSON/stringify ir) before)
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let ((a (instantiateManagedRuntime bytes options)))
        (js-call a :auto 1)
        (js-object :a a :js js :bytes bytes)))))

  (defun box (a v)
    (cond
      ((= (value-type v) "number") (js-call a :number v))
      ((= (value-type v) "string") (js-call a :string v))
      (t v)))

  (defun array (a values)
    (let ((xs (new globalThis.Array (js-length values)))
          (i 0))
      (while (< i (js-length values))
        (when (Object/hasOwn values i)
          (let ((v (aref values i)))
            (put xs i (if (Array/isArray v) (array a v) (box a v)))))
        (setq i (1+ i)))
      (try
        (js-call a :sourceArray xs)
        (finally
          (let ((j 0))
            (while (< j (js-length xs))
              (when (Object/hasOwn xs j)
                (js-call a :release (aref xs j)))
              (setq j (1+ j))))))))

  (defun read (a v)
    (cond
      ((or (= v nil) (/= (value-type v) "object")) v)
      ((= (get v :kind) 4) (js-call a :readNumber v))
      ((= (get v :kind) 5) (js-call a :readString v))
      (t
       (js-call assert :equal (get v :kind) 14)
       (let ((out (new globalThis.Array (js-call a :length v)))
             (i 0))
         (while (< i (js-length out))
           (let* ((n (js-call a :number i))
                  (has-own (js-call a :invoke "own" (js-array v n))))
             (js-call a :release n)
             (when has-own
               (let ((x (js-call a :get v i)))
                 (try
                   (put out i (read a x))
                   (finally (js-call a :release x))))))
           (setq i (1+ i)))
         out))))

  (defun finish (a)
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))

  (defconst own " (defun own (items key) (object-has? items key)) ")

  (test "Given arrays and scalar arguments, when concat copies them, then order, sparse ownership, nested identity and source values match JS" (async ()
    (let* ((c (await (compiled (str "(defun f (items other tail) (js-call items :concat other tail))" own "(export f own)"))))
           (a (get c :a))
           (js (get c :js))
           (sparse (new globalThis.Array 5)))
      (put sparse 1 undefined)
      (put sparse 3 -0.0)
      (js-call
        (js-array
          (js-array (js-array) (js-array))
          (js-array (js-array 1 2) (js-array 3 4))
          (js-array sparse (js-array false nil globalThis.NaN))
          (js-array (js-array (js-array 1 2)) (js-array (js-array "x"))))
        :forEach
        (lambda (pair)
          (let* ((values (aref pair 0))
                 (others (aref pair 1))
                 (input (array a values))
                 (other (array a others))
                 (tail (js-call a :string "中😀"))
                 (out (js-call a :invoke "f" (js-array input other tail))))
            (js-call assert :equal (js-call a :keyEqual out input) false)
            (js-call assert :deepEqual (read a out) (js-call js :f values others "中😀"))
            (js-call assert :deepEqual (read a input) values)
            (js-call assert :deepEqual (read a other) others)
            (js-call (js-array out input other tail) :forEach (lambda (x) (js-call a :release x))))))
      (finish a))))

  (test "Given a receiver included in its own concat arguments, when one level is copied, then references stay shallow and the new result has independent storage" (async ()
    (let* ((c (await (compiled (str "(defun f () (let* ((inner (js-array 1)) (items (js-array inner)) (out (js-call items :concat items))) (put inner 0 7) (js-array out (= (js-nth 0 out) (js-nth 1 out)) (= out items))))" own "(export f own)"))))
           (a (get c :a))
           (js (get c :js))
           (out (js-call a :invoke "f")))
      (js-call assert :deepEqual (read a out) (js-call js :f))
      (js-call a :release out)
      (finish a))))

  (test "Given a captured own concat function, when argument effects replace it, then the captured function receives every argument exactly once" (async ()
    (let* ((c (await (compiled (str "(defun f () (let ((items (js-array)) (trace (js-object :calls 0))) (put items :concat (lambda (&rest args) (js-array \"captured\" (js-length args)))) (js-array (js-call items :concat (progn (put items :concat (lambda () \"wrong\")) 1) (progn (put trace :calls (1+ (get trace :calls))) 2)) (get trace :calls))))" own "(export f own)"))))
           (a (get c :a))
           (js (get c :js))
           (out (js-call a :invoke "f")))
      (js-call assert :deepEqual (read a out) (js-call js :f))
      (js-call a :release out)
      (finish a))))

  (test "Given unsupported receivers and noncallable own concat data, when invocation fails, then argument effects and original frame ownership match JS" (async ()
    (let* ((c (await (compiled (str "(defun f (items trace) (js-call items :concat (progn (put trace :calls 1) 4)))" own "(export f own)"))))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array nil undefined false 0) :forEach
        (lambda (value)
          (let ((input (box a value))
                (trace (js-call a :sourceObject (js-object)))
                (ref (js-object)))
            (js-call assert :throws (lambda () (js-call js :f value ref)) globalThis.TypeError)
            (js-call assert :throws
              (lambda () (js-call a :invoke "f" (js-array input trace)))
              (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003"))))
            (let* ((key (js-call a :string "calls"))
                   (calls (js-call a :objectGet trace key)))
              (js-call assert :equal (if (undefined? calls) undefined (js-call a :readNumber calls)) (get ref :calls))
              (js-call (js-array input trace key calls) :forEach (lambda (x) (js-call a :release x)))
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))
      (finish a))))

  (test "Given a bad array constructor, when concat creates its result, then arguments run before species rejection and copying leaves the input intact" (async ()
    (let* ((c (await (compiled (str "(defun f (items trace) (put items :constructor 7) (js-call items :concat (progn (put trace :calls 1) \"x\")))" own "(export f own)"))))
           (a (get c :a))
           (js (get c :js))
           (input (array a (js-array 1 2)))
           (trace (js-call a :sourceObject (js-object)))
           (values (js-array 1 2))
           (ref (js-object)))
      (js-call assert :throws (lambda () (js-call js :f values ref)) globalThis.TypeError)
      (js-call assert :throws
        (lambda () (js-call a :invoke "f" (js-array input trace)))
        (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003"))))
      (js-call assert :deepEqual (read a input) (js-array 1 2))
      (let* ((key (js-call a :string "calls"))
             (count (js-call a :objectGet trace key)))
        (js-call assert :equal (js-call a :readNumber count) (get ref :calls))
        (js-call (js-array input trace key count) :forEach (lambda (x) (js-call a :release x)))
        (finish a)))))

  (test "Given primitive strings, when concat has zero, many and converting operands, then UTF16 and source conversion order match JS" (async ()
    (let* ((c (await (compiled (str "(defun empty (text) (js-call text :concat)) (defun f (text value) (js-call text :concat value \"😀\" \"\\ud800\")) (defun hooks () (let ((trace (js-object :calls 0))) (js-array (js-call \"a\" :concat (js-object :toString (lambda () (put trace :calls 1) \"x\")) (js-object :toString (lambda () (put trace :calls (+ (get trace :calls) 10)) \"y\"))) (get trace :calls))))" own "(export empty f hooks own)"))))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array "" "中😀" "\ud800") :forEach
        (lambda (text)
          (let* ((input (js-call a :string text))
                 (empty (js-call a :invoke "empty" (js-array input))))
            (js-call assert :equal (js-call a :readString empty) (js-call js :empty text))
            (js-call a :release empty)
            (js-call (js-array undefined nil false -0.0 globalThis.NaN "x") :forEach
              (lambda (value)
                (let* ((arg (box a value))
                       (out (js-call a :invoke "f" (js-array input arg))))
                  (js-call assert :equal (js-call a :readString out) (js-call js :f text value))
                  (js-call a :release out)
                  (js-call a :release arg))))
            (js-call a :release input))))
      (let ((hooks (js-call a :invoke "hooks")))
        (js-call assert :deepEqual (read a hooks) (js-call js :hooks))
        (js-call a :release hooks)
        (finish a)))))

  (test "Given deferred text conversion hooks, when all arguments have effects, then evaluation completes before left-to-right string conversion" (async ()
    (let* ((c (await (compiled (str "(defun f () (let* ((log (js-array)) (first (js-object :toString (lambda () (js-call log :push \"first\") \"1\"))) (second (js-object :toString (lambda () (js-call log :push \"second\") \"2\")))) (js-array (js-call \"a\" :concat first (progn (js-call log :push \"argument\") second)) log)))" own "(export f own)"))))
           (a (get c :a))
           (js (get c :js))
           (out (js-call a :invoke "f")))
      (js-call assert :deepEqual (read a out) (js-call js :f))
      (js-call assert :deepEqual (read a out) (js-array "a12" (js-array "argument" "first" "second")))
      (js-call a :release out)
      (finish a))))

  (test "Given deterministic sparse inputs, when arrays concatenate scalars and nested arrays, then every value and hole matches independent JS" (async ()
    (let* ((c (await (compiled (str "(defun f (items other tail) (js-call items :concat other tail))" own "(export f own)"))))
           (a (get c :a))
           (js (get c :js))
           (seed 1221528171)
           (next (lambda () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223)))))
           (generate (lambda ()
                       (let ((values (new globalThis.Array (% (funcall next) 24)))
                             (i 0))
                         (while (< i (js-length values))
                           (when (/= (% (funcall next) 4) 0)
                             (put values i
                               (aref (js-array undefined nil false -0.0 globalThis.NaN globalThis.Number.MIN_VALUE "中😀" (js-array 1 2))
                                     (% (funcall next) 8))))
                           (setq i (1+ i)))
                         values))))
      (let ((i 0))
        (while (< i 128)
          (let* ((values (funcall generate))
                 (others (funcall generate))
                 (input (array a values))
                 (other (array a others))
                 (tail-val (if (/= (% i 2) 0) undefined "x"))
                 (tail (box a tail-val))
                 (out (js-call a :invoke "f" (js-array input other tail))))
            (js-call assert :deepEqual (read a out) (js-call js :f values others tail-val))
            (js-call assert :deepEqual (read a input) values)
            (js-call assert :deepEqual (read a other) others)
            (js-call (js-array input other tail out) :forEach (lambda (x) (js-call a :release x)))
            (js-call a :collect)
            (assert (> (js-call a :live) 0))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
          (setq i (1+ i))))
      (finish a))))

  (test "Given a bounded heap, when copying exceeds capacity, then argument effects stay observed and inputs and caller frames remain intact" (async ()
    (let* ((c (await (compiled (str "(defun f (items trace) (js-call items :concat items items (progn (put trace :calls 1) items)))" own "(export f own)")
                               (js-object :maxSlots 64 :initialBytes 8192 :maxBytes 8192))))
           (a (get c :a))
           (items (array a (js-call (new globalThis.Array 512) :fill t)))
           (trace (js-call a :sourceObject (js-object)))
           (caller (js-call a :frame 1)))
      (js-call a :frameSet caller 0 items)
      (js-call assert :throws
        (lambda () (js-call a :invoke "f" (js-array items trace)))
        (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0002"))))
      (js-call assert :equal (js-call a :length items) 512)
      (let ((i 0))
        (while (< i 512)
          (js-call assert :equal (js-call a :get items i) t)
          (setq i (1+ i))))
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
      (let* ((key (js-call a :string "calls"))
             (value (js-call a :objectGet trace key)))
        (js-call assert :equal (js-call a :readNumber value) 1)
        (js-call a :release key)
        (js-call a :release value)
        (js-call a :leaveFrame caller)
        (js-call a :release items)
        (js-call a :release trace)
        (finish a)))))

  (test "Given own concat data and ordinary objects, when lookup captures a noncallable or callable value, then argument effects and method results match JS" (async ()
    (let* ((c (await (compiled (str "(defun bad (items trace) (put items :concat false) (js-call items :concat (put trace 0 9))) (defun ordinary () (let ((item (js-object :concat (lambda (x) (js-array \"object\" x))))) (js-call item :concat 7)))" own "(export bad ordinary own)"))))
           (a (get c :a))
           (js (get c :js))
           (items (array a (js-array 1)))
           (trace (js-call a :sourceArray (js-array false)))
           (ref (js-array)))
      (js-call assert :throws (lambda () (js-call js :bad (js-array 1) ref)) globalThis.TypeError)
      (js-call assert :throws
        (lambda () (js-call a :invoke "bad" (js-array items trace)))
        (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003"))))
      (js-call assert :deepEqual (read a trace) ref)
      (let ((result (js-call a :invoke "ordinary")))
        (js-call assert :deepEqual (read a result) (js-call js :ordinary))
        (js-call (js-array items trace result) :forEach (lambda (x) (js-call a :release x)))
        (finish a)))))

  (test "Given malformed raw arguments and an invalid copied slot, when concat validates references, then original handle errors and caller frames survive" (async ()
    (let* ((c (await (compiled (str "(defun f (items other) (js-call items :concat other))" own "(export f own)"))))
           (a (get c :a))
           (bytes (get c :bytes)))
      (finish a)
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (heap (js-call e "heap-new" 32 4096 65536))
             (items (js-call e "value-array-new" heap 1))
             (args (js-call e "value-refs" heap 7 1))
             (caller (js-call e "frame-new" heap 2)))
        (js-call e "frame-set" heap caller 0 items)
        (js-call e "frame-set" heap caller 1 args)
        (js-call e "value-set" heap items 0 2)
        (js-call e "value-set" heap args 0 1)
        (js-call assert :equal (js-call e "value-sequence-concat-kind" heap items 4294967295) 0)
        (js-call assert :equal (js-call e "last-error") 1)
        (js-call assert :equal (js-call e "value-sequence-concat" heap items 4294967295) 0)
        (js-call assert :equal (js-call e "last-error") 1)
        (let ((ptr (js-call e "value-data" heap items 14)))
          (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :setUint32 ptr 4294967295 t)
          (js-call assert :equal (js-call e "value-sequence-concat" heap items args) 0)
          (js-call assert :equal (js-call e "last-error") 1)
          (js-call assert :equal (js-call e "frame-depth" heap) 1)
          (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :setUint32 ptr 2 t)
          (js-call e "frame-pop" heap caller)
          (js-call e "heap-collect" heap)
          (js-call assert :equal (js-call e "heap-live" heap) 0))))))

  (test "Given a real array-copy trap, when concat enters its private frame, then inputs and the caller frame remain owned after unwinding" (async ()
    (let* ((source (str "(defun f (items other) (js-call items :concat other)) (defun fail-first (items) (js-call items :concat (js-call nil :charAt)))" own "(export f fail-first own)"))
           (c (await (compiled source))))
      (finish (get c :a))
      (let* ((text (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
             (needle "(setq result (value-array-new heap total))")
             (point (js-call text :indexOf needle (js-call text :indexOf "  (defun value-sequence-concat "))))
        (assert (>= point 0))
        (let* ((rt (js-call (get b :compiler) :compile_ir_string
                     (str (js-call text :slice 0 point)
                          "(setq result (load-u32 4294967295))"
                          (js-call text :slice (+ point (js-length needle))))
                     "array-concat-trap.eli"))
               (prog (js-call (get b :compiler) :compile_ir_string (str "(defconst marker 1) " source) "concat.eli"))
               (broken (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm prog rt)))))
          (js-call broken :auto 1)
          (let* ((items (js-call broken :sourceArray (js-array t false)))
                 (other (js-call broken :sourceArray (js-array undefined)))
                 (caller (js-call broken :frame 1)))
            (js-call broken :frameSet caller 0 items)
            (js-call assert :throws
              (lambda () (js-call broken :invoke "f" (js-array items other)))
              globalThis.WebAssembly.RuntimeError)
            (js-call assert :equal (get (js-call broken :stats) :frameDepth) 1)
            (js-call assert :deepEqual (read broken items) (js-array t false))
            (js-call assert :throws
              (lambda () (js-call broken :invoke "fail-first" (js-array items)))
              (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003"))))
            (js-call assert :equal (get (js-call broken :stats) :frameDepth) 1)
            (js-call broken :leaveFrame caller)
            (js-call broken :release items)
            (js-call broken :release other)
            (finish broken)))))))

  (test "Given a real string-copy trap, when concat aborts, then outer roots survive and prior argument errors suppress the later trap" (async ()
    (let* ((c (await (compiled (str "(defun f (text other) (js-call text :concat other)) (defun fail-first (text) (js-call text :concat (js-call nil :charAt)))" own "(export f fail-first own)")))))
      (finish (get c :a))
      (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
             (start (js-call source :indexOf "  (defun value-string-concat (heap "))
             (end (js-call source :indexOf "  (defun " (+ start 10))))
        (assert (and (>= start 0) (> end start)))
        (let* ((injected (js-call (get b :compiler) :compile_ir_string
                           (str (js-call source :slice 0 start)
                                "  (defun value-string-concat (heap left right) (load-u32 4294967295))\n"
                                (js-call source :slice end))
                           "concat-trap.eli"))
               (prog (js-call (get b :compiler) :compile_ir_string
                       (str "(defconst marker 1) (defun f (text other) (js-call text :concat other)) (defun fail-first (text) (js-call text :concat (js-call nil :charAt)))" own "(export f fail-first own)")
                       "concat.eli"))
               (broken (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm prog injected)))))
          (js-call broken :auto 1)
          (let* ((input (js-call broken :string "中😀"))
                 (other (js-call broken :string "x"))
                 (caller (js-call broken :frame 1)))
            (js-call broken :frameSet caller 0 input)
            (js-call assert :throws
              (lambda () (js-call broken :invoke "f" (js-array input other)))
              globalThis.WebAssembly.RuntimeError)
            (js-call assert :equal (get (js-call broken :stats) :frameDepth) 1)
            (js-call assert :equal (js-call broken :readString input) "中😀")
            (js-call assert :throws
              (lambda () (js-call broken :invoke "fail-first" (js-array input)))
              (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003"))))
            (js-call assert :equal (get (js-call broken :stats) :frameDepth) 1)
            (js-call broken :leaveFrame caller)
            (js-call broken :release input)
            (js-call broken :release other)
            (finish broken)))))))

  (test "Given Node and identical concat bytes, when strings and sparse arrays concatenate, then UTF16 text, missing slots and independent result identity agree" (async ()
    (let* ((c (await (compiled (str "(defun f (items other) (js-call items :concat other))" own "(export f own)"))))
           (a (get c :a))
           (bytes (get c :bytes)))
      (finish a)
      (let ((result (spawnSync "node"
                      (js-array (resolve "tests/helpers/wasm-managed-concat-node.mjs"))
                      (js-object :input (Buffer/from bytes) :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get result :status) 0 (get result :stderr)))))))
