(module tests.wasm-managed-float64-words.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defvar directory undefined)
  (defvar b undefined)
  (defvar runtime undefined)

  (defconst source
    "(defconst marker 1)\n (defun words (value) (number-float64-words value))\n (defun missing () (words))\n (defun extra (trace) (words (progn (js-call trace :push \"value\") 1) (js-call trace :push \"extra\")))\n (defun converted (trace mode)\n   (number-float64-words (js-object :valueOf (lambda () (js-call trace :push \"valueOf\")\n     (if (= mode 0) -0 (js-object))) :toString (lambda () (js-call trace :push \"toString\") \"-0\"))))\n (defun primitive (trace)\n   (let ((value (js-object)))\n     (put value (js* \"Symbol.toPrimitive\") (lambda (hint) (js-call trace :push hint) -0))\n     (number-float64-words value)))\n (defun throwing (trace)\n   (let ((value (js-object)))\n     (put value (js* \"Symbol.toPrimitive\") (lambda (hint) (js-call trace :push hint) (throw trace)))\n     (try (number-float64-words value) (catch error (Object/is error trace)))))\n (defun invalid (trace)\n   (number-float64-words (js-object :valueOf (lambda () (js-call trace :push \"valueOf\") (js-object))\n     :toString (lambda () (js-call trace :push \"toString\") (js-object)))))\n (export words missing extra converted primitive throwing invalid)")

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-f64words-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli")))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defasync compiled (&rest __host_default_arguments_1)
    (let* ((rt-arg (aref __host_default_arguments_1 0)) (options (aref __host_default_arguments_1 1)))
    (let* ((rt (if (undefined? rt-arg) runtime rt-arg))
           (p (js-call (get b :compiler) :compile_ir_string source "float64-words.eli"))
           (saved (JSON/stringify p))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p rt))))
      (js-call assert :equal (JSON/stringify p) saved)
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let* ((a (instantiateManagedRuntime bytes options))
             (_ (js-call a :auto 1))
             (js (await (dynamic-import (str "data:text/javascript;base64,"
                                             (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p)) :toString "base64"))))))
        (js-object :a a :bytes bytes :p p :js js)))))

  (defun box (a value)
    (cond
      ((= (value-type value) "number") (js-call a :number value))
      ((= (value-type value) "string") (js-call a :string value))
      (t value)))

  (defun read (a v)
    (cond
      ((and v (= (get v :kind) 4)) (js-call a :readNumber v))
      ((and v (= (get v :kind) 5)) (js-call a :readString v))
      ((and v (= (get v :kind) 14))
       (let ((out (js-array))
             (i 0))
         (while (< i (js-call a :length v))
           (let ((child (js-call a :get v i)))
             (try (js-call out :push (read a child)) (finally (js-call a :release child))))
           (setq i (1+ i)))
         out))
      (t v)))

  (defun run (a name &rest __host_default_arguments_2)
    (let* ((args-list (aref __host_default_arguments_2 0)))
    (let* ((args (if (undefined? args-list) (js-array) args-list))
           (out (js-call a :invoke name args)))
      (try (read a out) (finally (js-call a :release out))))))

  (defun finish (a &rest __host_default_arguments_3)
    (let* ((roots-list (aref __host_default_arguments_3 0)))
    (let ((roots (if (undefined? roots-list) (js-array) roots-list)))
      (js-call roots :forEach (lambda (v) (js-call a :release v)))
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  ;; Independent oracle preserves the original pre-ToNumber zero test.
  (defun oracle (value)
    (let ((bytes (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
      (js-call bytes :setFloat64 0 (if (= value 0) 0 value) t)
      (js-array (js-call bytes :getUint32 0 t) (js-call bytes :getUint32 4 t))))

  (test "float64 word intrinsic executes zero-import WASM with exact low/high IEEE words and primitive zero canonicalization" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (js (get c :js)))
      (js-call
        (js-array undefined nil false t 0 -0.0 1 -1 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                  globalThis.Number.MIN_VALUE (- globalThis.Number.MIN_VALUE) globalThis.Number.MAX_VALUE
                  4503599627370496 9007199254740992 1.5 "" "-0" "1.5" "NaN" "Infinity" "0xFFFFFFFF")
        :forEach
        (lambda (value)
          (let ((input (box a value)))
            (js-call assert :deepEqual (run a "words" (js-array input)) (oracle value))
            (js-call assert :deepEqual (js-call js :words value) (oracle value))
            (js-call a :release input))))
      (let ((zero (js-call a :number -0.0)))
        (js-call assert :deepEqual (run a "words" (js-array zero)) (js-array 0 0))
        (finish a (js-array zero))))))

  (test "ToNumber uses number-hint conversion once and preserves converted negative zero while missing and extra call arguments retain their effects" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (js (get c :js)))
      (js-call assert :deepEqual (run a "missing") (oracle undefined))
      (js-call (js-array 0 1) :forEach
        (lambda (mode)
          (let ((trace (js-call a :sourceArray (js-array)))
                (expected (js-array))
                (value (js-call a :number mode)))
            (js-call assert :deepEqual (run a "converted" (js-array trace value)) (js-call js :converted expected mode))
            (js-call assert :deepEqual (read a trace) expected)
            (js-call a :release trace)
            (js-call a :release value))))
      (js-call (js-array "primitive" "extra" "throwing") :forEach
        (lambda (name)
          (let ((trace (js-call a :sourceArray (js-array)))
                (expected (js-array)))
            (js-call assert :deepEqual (run a name (js-array trace)) (js-call js name expected))
            (js-call assert :deepEqual (read a trace) expected)
            (js-call a :release trace))))
      (let ((trace (js-call a :sourceArray (js-array)))
            (expected (js-array)))
        (js-call assert :throws
          (lambda () (js-call a :invoke "invalid" (js-array trace)))
          (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003"))))
        (js-call assert :throws (lambda () (js-call js :invalid expected)) globalThis.TypeError)
        (js-call assert :deepEqual (read a trace) expected)
        (js-call assert :deepEqual (run a "words" (js-array t)) (oracle t))
        (finish a (js-array trace))))))

  (test "random complete binary64 payloads including NaN payload sign and subnormals retain exactly the original DataView words" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (view (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
           (seed 675917111)
           (next (lambda () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223)))))
           (samples (js-array (js-array 1 0) (js-array 1 2147483648) (js-array 1 2146435072)
                              (js-array 1 4293918720) (js-array 42 2146959360) (js-array 42 4294443008))))
      (let ((i 0))
        (while (< i 256)
          (js-call samples :push (js-array (funcall next) (funcall next)))
          (setq i (1+ i))))
      (js-call samples :forEach
        (lambda (pair)
          (js-call view :setUint32 0 (aref pair 0) t)
          (js-call view :setUint32 4 (aref pair 1) t)
          (let* ((value (js-call view :getFloat64 0 t))
                 (input (js-call a :number value)))
            (js-call assert :deepEqual (run a "words" (js-array input)) (oracle value))
            (js-call a :release input))))
      (assert (> (get (js-call a :stats) :collections) 256))
      (finish a))))

  (test "intrinsic arity remains strict in source and in malformed IR and no argument effect is silently discarded" (async ()
    (js-call (js-array "(number-float64-words)" "(number-float64-words 1 2)") :forEach
      (lambda (input)
        (js-call assert :throws (lambda () (js-call (get b :compiler) :compile_string input "float64-arity.eli")))))
    (let* ((c (await (compiled)))
           (a (get c :a))
           (p (get c :p)))
      (finish a)
      (letfn ((find-node (nodes)
                (let ((found undefined)
                      (idx 0))
                  (while (and (< idx (js-length nodes)) (undefined? found))
                    (let ((n (aref nodes idx)))
                      (if (and (= (get n :kind) "intrinsic") (= (get n :value) "number-float64-words"))
                        (setq found n)
                        (let ((child (find-node (or (get n :children) (js-array)))))
                          (when child (setq found child)))))
                    (setq idx (1+ idx)))
                  found)))
        (js-call (js-array 0 2) :forEach
          (lambda (count)
            (let* ((copy (JSON/parse (JSON/stringify p)))
                   (node (find-node (get copy :body))))
              (assert node)
              (put node :children
                (if (= count 0)
                  (js-array)
                  (js-array (aref (get node :children) 0) (aref (get node :children) 0))))
              (js-call assert :throws
                (lambda () (js-call (get b :managed) :emit_managed_wasm copy runtime))
                (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-B0001")))))))))))

  (test "raw IEEE word reads preserve malformed handle refusals private caller roots and recover at every partial allocation failure" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (bytes (get c :bytes)))
      (finish a)
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (h (js-call e "heap-new" 64 16384 131072))
             (call (lambda (name &rest args)
                     (let ((out (uint32 (Reflect/apply (get e name) e (js-call (js-array h) :concat args)))))
                       (js-call assert :equal (js-call e "last-error") 0 name)
                       out)))
             (input (funcall call "value-number" 0 2147483648))
             (unsealed (funcall call "value-string" 1))
             (symbol (funcall call "value-symbol-well-known" 0))
             (privateRefs (funcall call "value-refs" 7 0))
             (caller (funcall call "frame-new" 4)))
        (funcall call "frame-set" caller 0 input)
        (funcall call "frame-set" caller 1 unsealed)
        (funcall call "frame-set" caller 2 symbol)
        (funcall call "frame-set" caller 3 privateRefs)
        (funcall call "heap-auto" 1)
        (js-call
          (js-array (js-array 4294967295 1) (js-array caller 3) (js-array unsealed 6)
                    (js-array symbol 3) (js-array privateRefs 3))
          :forEach
          (lambda (pair)
            (js-call assert :equal (js-call e "value-number-float64-words" h (aref pair 0)) 0)
            (js-call assert :equal (js-call e "last-error") (aref pair 1))
            (js-call assert :equal (funcall call "frame-depth") 1)
            (js-call assert :equal (funcall call "frame-get" caller 0) input)))
        (let ((fillers (js-array)))
          (while (< (funcall call "heap-live") 64)
            (let ((value (funcall call "value-number" 0 0)))
              (funcall call "heap-pin" value)
              (js-call fillers :push value)))
          (let ((available 0))
            (while (< available 4)
              (js-call assert :equal (js-call e "value-number-float64-words" h input) 0)
              (js-call assert :equal (js-call e "last-error") 2)
              (js-call assert :equal (funcall call "frame-depth") 1)
              (js-call assert :equal (funcall call "frame-get" caller 0) input)
              (funcall call "heap-collect")
              (funcall call "heap-release" (js-call fillers :pop))
              (funcall call "heap-collect")
              (setq available (1+ available))))
          (let ((result (funcall call "value-number-float64-words" input)))
            (funcall call "heap-pin" result)
            (js-call assert :equal (funcall call "value-length" result) 2)
            (let ((i 0))
              (while (< i 2)
                (let* ((word (funcall call "value-get" result i))
                       (ptr (funcall call "value-data" word 4)))
                  (js-call assert :equal (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getFloat64 ptr t) 0))
                (setq i (1+ i))))
            (let ((ptr (funcall call "value-data" input 4)))
              (assert (Object/is (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getFloat64 ptr t) -0.0)))
            (funcall call "heap-release" result)
            (js-call fillers :forEach (lambda (v) (funcall call "heap-release" v)))
            (funcall call "frame-pop" caller)
            (funcall call "heap-collect")
            (js-call assert :equal (funcall call "heap-live") 0)))))))

  (test "a real IEEE word result allocation trap retains completed ToNumber effects and only unwinds private frames" (async ()
    (let* ((raw (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (start (js-call raw :indexOf "  (defun value-number-float64-words "))
           (needle "(setq result (value-array-new heap 2))")
           (point (js-call raw :indexOf needle start)))
      (assert (and (>= start 0) (> point start)))
      (let* ((injected (js-call (get b :compiler) :compile_ir_string
                         (str (js-call raw :slice 0 point)
                              "(setq result (load-u32 4294967295))"
                              (js-call raw :slice (+ point (js-length needle))))
                         "float64-trap.eli"))
             (c (await (compiled injected)))
             (a (get c :a))
             (trace (js-call a :sourceArray (js-array)))
             (held (js-call a :number -0.0))
             (caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 held)
        (js-call assert :throws
          (lambda () (js-call a :invoke "primitive" (js-array trace)))
          globalThis.WebAssembly.RuntimeError)
        (js-call assert :deepEqual (read a trace) (js-array "number"))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (assert (Object/is (js-call a :readNumber held) -0.0))
        (js-call a :leaveFrame caller)
        (finish a (js-array trace held))))))

  (test "Node independently executes identical IEEE word WASM bytes including payloads converted zero and argument effects" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (bytes (get c :bytes)))
      (finish a)
      (let ((file (resolve directory "float64-words.wasm")))
        (await (writeFile file bytes))
        (let ((child (spawnSync "node"
                       (js-array (resolve "tests/helpers/wasm-managed-float64-words-node.mjs")
                                 (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                                 file)
                       (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr)))))))

  (test "public Seed emits the same intrinsic JavaScript contract while its result remains ordinary unsigned Number words" (async ()
    (let ((file (resolve directory "words.eli"))
          (output (resolve directory "words.mjs")))
      (await (writeFile file "(defun words (value) (number-float64-words value)) (export words)"))
      (let ((seed (spawnSync (resolve "bin/eliscript-seed") (js-array "--output" output file) (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get seed :status) 0 (get seed :stderr))
        (let* ((actual (await (readFile output "utf8")))
               (_ (js-call assert :equal actual (js-call (get b :compiler) :compile_string (await (readFile file "utf8")) file)))
               (js (await (dynamic-import (str "data:text/javascript;base64," (js-call (Buffer/from actual) :toString "base64"))))))
          (js-call
            (js-array -0.0 "-0" (js-object :valueOf (lambda () -0.0)) globalThis.NaN globalThis.Infinity
                      (- globalThis.Infinity) globalThis.Number.MIN_VALUE 9007199254740992)
            :forEach
            (lambda (value)
              (js-call assert :deepEqual (js-call js :words value) (oracle value))))
          (js-call (js-array (globalThis.Symbol "word") (js* "1n")) :forEach
            (lambda (value)
              (js-call assert :throws (lambda () (js-call js :words value)) globalThis.TypeError)))))))))
