(module tests.portable-persistent-set
  (import "bun:test" expect test)
  (import "./helpers/portable-stdlib.mjs" withPortableLibraries assertSourceMap sourceMap generatedModuleLoader be same)
  (import "./helpers/portable-structure.mjs" nextRandom integerHash countItems sharedItems lookupPathLength)
  (defconst importGeneratedModule (generatedModuleLoader "persistent-set" t))
  (defconst host-type (js* "(value) => typeof value"))
  (defun objectHash (value) (integerHash (get value :id)))
  (defconst sameObjectKey (lambda (left right) (= (get left :id) (get right :id))))
  (test "Eliscript-authored persistent Set compiles and agrees across hosts"
    (async () (await (withPortableLibraries
      (js-object :module "persistent-set" :sources (js-array "persistent-map" "persistent-set") :fixture "tests/fixtures/portable-set-host.mjs" :loader t)
      (async (context)
        (same (get context :report) (js-object :persistent t :count 100000 :rootKind "array" :probes (js-array t false t t)
          :originalCount 100000 :originalRetained t :sum 4999950000 :noopConj t :noopDisj t
          :collision (js-object :count 99 :kind "collision" :removed false :retained t)
          :algebra (js-object :union 1500 :intersection 500 :difference 500 :subset t :superset t :disjoint t :equal t) :sample (js-array 1 2 3)))
        (await (assertSourceMap (get context :seedDirectory) "persistent-set" (js-array "(defportable persistent-set-union")))
        (js-call (expect (js-length (get (await (sourceMap (get context :seedDirectory) "persistent-set")) :mappings))) :toBeGreaterThan 0))))) 60000)
  (test "Eliscript-authored persistent Set preserves generated value-key histories"
    (async ()
      (let* ((module (await (funcall importGeneratedModule "history"))) (emptyPersistentSet (get module :empty_persistent_set))
             (persistentSetCount (get module :persistent_set_count)) (persistentSetHas (get module :persistent_set_has_QMARK_))
             (persistentSetConj (get module :persistent_set_conj)) (persistentSetDisj (get module :persistent_set_disj))
             (persistentSetReduce (get module :persistent_set_reduce)) (persistentSetToArray (get module :persistent_set_to_array))
             (random (js-object :value 1397052465)) (set (emptyPersistentSet objectHash sameObjectKey)) (model (new globalThis.Set)) (step 0))
        (while (< step 20000)
          (let* ((previousSet set) (previousModel model) (id (% (nextRandom random) 5000)) (choice (% (nextRandom random) 10)))
            (cond ((< choice 6) (let ((existed (js-call model :has id)))
                                 (setq set (persistentSetConj set (js-object :id id))) (when existed (be set previousSet))
                                 (setq model (new globalThis.Set model)) (js-call model :add id)))
                  ((< choice 8) (let ((existed (js-call model :has id)))
                                 (setq set (persistentSetDisj set (js-object :id id))) (unless existed (be set previousSet))
                                 (setq model (new globalThis.Set model)) (js-call model :delete id)))
                  (t (be (persistentSetHas set (js-object :id id)) (js-call model :has id))))
            (be (persistentSetCount set) (get model :size)) (be (persistentSetCount previousSet) (get previousModel :size))
            (when (> (get previousModel :size) 0)
              (let ((previousId (get (js-call (js-call previousModel :values) :next) :value))) (be (persistentSetHas previousSet (js-object :id previousId)) t)))
            (when (= (% step 500) 0) (be (persistentSetReduce (lambda (count) (+ count 1)) 0 set) (get model :size))))
          (setq step (1+ step)))
        (let ((values (js-call (js-call (persistentSetToArray set) :map (lambda (value) (get value :id))) :sort (lambda (left right) (- left right)))))
          (same values (js-call (Array/from model) :sort (lambda (left right) (- left right))))))) 60000)
  (test "Eliscript-authored persistent Set preserves algebra and HAMT layouts"
    (async ()
      (let* ((module (await (funcall importGeneratedModule "algebra"))) (hash (lambda (value) value)) (equal (lambda (left right) (= left right)))
             (from (get module :persistent_set_from_array)) (empty (get module :empty_persistent_set)) (conj (get module :persistent_set_conj))
             (disj (get module :persistent_set_disj)) (union (get module :persistent_set_union)) (intersection (get module :persistent_set_intersection))
             (difference (get module :persistent_set_difference)) (subset-p (get module :persistent_set_subset_QMARK_)) (superset-p (get module :persistent_set_superset_QMARK_))
             (disjoint-p (get module :persistent_set_disjoint_QMARK_)) (equal-p (get module :persistent_set_equal_QMARK_))
             (left (funcall from hash equal (js-array 1 2 3 4))) (subset (funcall from hash equal (js-array 2 4))) (disjoint (funcall from hash equal (js-array 8 9))))
        (be (funcall union left subset) left) (be (funcall intersection subset left) subset) (be (funcall difference left disjoint) left)
        (be (funcall subset-p subset left) t) (be (funcall superset-p left subset) t) (be (funcall disjoint-p left disjoint) t)
        (be (funcall equal-p left (funcall from hash equal (js-array 4 3 2 1))) t)
        (same (js-call (funcall (get module :persistent_set_to_array) (funcall union subset disjoint)) :sort) (js-array 2 4 8 9))
        (let ((incompatible (funcall empty (lambda (value) value) equal)))
          (be (funcall union left incompatible) nil) (be (funcall intersection left incompatible) nil) (be (funcall difference left incompatible) nil)
          (be (funcall subset-p left incompatible) false) (be (funcall disjoint-p left incompatible) false))
        (let ((layout (funcall empty hash equal)) (value 0))
          (while (< value 31) (setq layout (funcall conj layout value) value (1+ value)))
          (js-call (expect (get (get layout :map) :root)) :toMatchObject (js-object :kind "bitmap"))
          (setq layout (funcall conj layout 31)) (js-call (expect (get (get layout :map) :root)) :toMatchObject (js-object :kind "array" :count 32))
          (setq value 0) (while (< value 8) (setq layout (funcall disj layout value) value (1+ value)))
          (js-call (expect (get (get layout :map) :root)) :toMatchObject (js-object :kind "bitmap"))
          (js-call (expect (get (get (get layout :map) :root) :items)) :toHaveLength 24))
        (let ((collision (funcall empty (lambda () 17) equal)) (value 0))
          (while (< value 100) (setq collision (funcall conj collision (str "collision-" value)) value (1+ value)))
          (js-call (expect (get (get collision :map) :root)) :toMatchObject (js-object :kind "collision"))
          (setq collision (funcall disj collision "collision-50"))
          (be (funcall (get module :persistent_set_count) collision) 99) (be (funcall (get module :persistent_set_has_QMARK_) collision "collision-50") false)
          (be (funcall (get module :persistent_set_has_QMARK_) collision "collision-99") t)))) 30000)
  (test "Eliscript-authored persistent Set shares the million-member update path"
    (async ()
      (let* ((module (await (funcall importGeneratedModule "million")))
             (hash (lambda (value) (if (= (funcall host-type value) "number") value (get value :id))))
             (equal (lambda (left right) (and (= (funcall host-type left) (funcall host-type right))
                                      (if (= (funcall host-type left) "number") (= left right) (= (get left :id) (get right :id))))))
             (set (funcall (get module :empty_persistent_set) hash equal)) (value 0))
        (while (< value 1000000) (setq set (funcall (get module :persistent_set_conj) set value) value (1+ value)))
        (be (funcall (get module :persistent_set_conj) set 500000) set)
        (let* ((colliding (js-object :id 500000)) (added (funcall (get module :persistent_set_conj) set colliding))
               (itemCount (countItems (get (get set :map) :root))) (changedPath (lookupPathLength (get (get set :map) :root) 500000)))
          (be (funcall (get module :persistent_set_count) set) 1000000) (be (funcall (get module :persistent_set_count) added) 1000001)
          (be (funcall (get module :persistent_set_has_QMARK_) set colliding) false) (be (funcall (get module :persistent_set_has_QMARK_) added colliding) t)
          (be (sharedItems (get (get set :map) :root) (get (get added :map) :root)) (- itemCount changedPath))
          (let ((removed (funcall (get module :persistent_set_disj) added colliding)))
            (be (funcall (get module :persistent_set_count) removed) 1000000) (be (funcall (get module :persistent_set_has_QMARK_) removed colliding) false)
            (be (funcall (get module :persistent_set_has_QMARK_) set 500000) t))))) 60000))
