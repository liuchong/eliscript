(module tests.unicode-property-generation.test
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:process" :default process)
  (import "node:fs/promises" readFile writeFile mkdtemp mkdir readdir rm)
  (import "node:path" resolve dirname)
  (import "node:os" tmpdir)
  (import "node:crypto" createHash)
  (import "node:child_process" spawnSync)
  (import "../tools/runtime/unicode-property-ranges.mjs" extractRangeRows packRangeRow)
  (import "../tools/runtime/unicode-property-aliases.mjs" extractGroundPropertyAliases compileGroundPropertyAliasDecisions packPropertyAliases generatePropertyAliasSources)
  (defconst rangeDataPath "tools/runtime/unicode-property-ranges.json")
  (defconst rangeToolPath "tools/runtime/unicode-property-ranges.mjs")
  (defconst aliasDataPath "tools/runtime/unicode-property-aliases.json")
  (defconst aliasToolPath "tools/runtime/unicode-property-aliases.mjs")
  (defconst runtimePath "bootstrap/runtime/memory.eli")
  (defconst regexpPath "bootstrap/backends/regexp.eli")
  (defun digest (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))
  (defun eqv (a b &rest __host_forwarded_arguments_1)
    (let* ((label (aref __host_forwarded_arguments_1 0))) (js-call assert :equal a b label)))
  (defun same (a b &rest __host_forwarded_arguments_2)
    (let* ((label (aref __host_forwarded_arguments_2 0))) (js-call assert :deepEqual a b label)))
  (defun rx (text &rest __host_forwarded_arguments_3)
    (let* ((flags (aref __host_forwarded_arguments_3 0))) (new globalThis.RegExp text flags)))
  (defun each (values action) (js-call values :forEach action))
  (defun regexMatch (text pattern &rest __host_forwarded_arguments_4)
    (let* ((message (aref __host_forwarded_arguments_4 0))) (js-call assert :match text (rx pattern) message)))
  (defun noMatch (text pattern &rest __host_forwarded_arguments_5)
    (let* ((message (aref __host_forwarded_arguments_5 0))) (js-call assert :doesNotMatch text (rx pattern) message)))
  (defasync withTree (run)
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-unicode-property-generation-")))))
      (try (await (run directory)) (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defasync treeFiles (directory &rest __host_default_arguments_1)
    (let* ((prefix (aref __host_default_arguments_1 0)))
    (when (= prefix undefined) (setq prefix ""))
    (let ((files (new globalThis.Map)) (entries (await (readdir (resolve directory prefix) (js-object :withFileTypes t)))) (i 0))
      (while (< i (get entries :length))
        (let* ((entry (aref entries i)) (name (if (= prefix "") (get entry :name) (str prefix "/" (get entry :name)))))
          (if (js-call entry :isDirectory)
            (js-call (await (treeFiles directory name)) :forEach (lambda (bytes file) (js-call files :set file bytes)))
            (progn (assert (js-call entry :isFile) "the maintenance fixture contains only owned regular files")
              (js-call files :set name (await (readFile (resolve directory name)))))))
        (setq i (1+ i)))
      (new globalThis.Map (js-call (Array/from files) :sort (lambda (a b) (js-call (aref a 0) :localeCompare (aref b 0))))))))
  (defun sameTree (actual expected label)
    (same (Array/from (js-call actual :keys)) (Array/from (js-call expected :keys)) (str label " file inventory"))
    (js-call actual :forEach (lambda (bytes file) (assert (js-call bytes :equals (js-call expected :get file)) (str label ": exact complete bytes of " file)))))
  (defasync seedTree (directory)
    (let ((files (js-array rangeDataPath aliasDataPath runtimePath regexpPath)) (i 0))
      (while (< i (get files :length))
        (let* ((file (aref files i)) (bytes (await (readFile file))))
          (await (mkdir (dirname (resolve directory file)) (js-object :recursive t)))
          (await (writeFile (resolve directory file) (if (or (= file runtimePath) (= file regexpPath))
            (str ";; owned maintenance prefix\n" (js-call bytes :toString "utf8") "\n;; owned maintenance suffix\n") bytes))))
        (setq i (1+ i)))))
  (defun node () (if (nullish? (get (get process :env) :NODE)) "node" (get (get process :env) :NODE)))
  (defun generate (tool directory &rest __host_default_arguments_2)
    (let* ((mode (aref __host_default_arguments_2 0)))
    (when (= mode undefined) (setq mode "--write"))
    (spawnSync (node) (js-array "--max-old-space-size=128" (resolve tool) "--root" directory mode)
      (js-object :encoding "utf8" :timeout 30000 :maxBuffer 65536))))
  (defun successful (child) (eqv (get child :error) undefined) (eqv (get child :signal) nil) (eqv (get child :status) 0 (get child :stderr)))
  (defasync invalidDeclarations (directory dataPath toolPath variants label)
    (await (seedTree directory))
    (let ((original (JSON/parse (await (readFile dataPath "utf8")))) (i 0))
      (while (< i (get variants :length))
        (let ((input (globalThis.structuredClone original)))
          (funcall (aref variants i) input)
          (await (writeFile (resolve directory dataPath) (str (JSON/stringify input) "\n")))
          (let* ((before (await (treeFiles directory))) (child (generate toolPath directory)))
            (eqv (get child :error) undefined) (eqv (get child :signal) nil)
            (js-call assert :notEqual (get child :status) 0 (str "invalid " label " variant " i))
            (sameTree (await (treeFiles directory)) before (str "no " (if (= label "range") "output changes" "partial static/dynamic write") " for invalid " label " variant " i))))
        (setq i (1+ i)))
      (await (writeFile (resolve directory dataPath) (str (JSON/stringify original) "\n")))
      (successful (generate toolPath directory)) (successful (generate toolPath directory "--check"))))
  (defun rangeMutations ()
    (js-array (lambda (v) (Reflect/deleteProperty v "rows")) (lambda (v) (js-call (get v :rows) :pop))
      (lambda (v) (put (aref (get v :rows) 1) :id (get (aref (get v :rows) 0) :id)))
      (lambda (v) (put (aref (get v :rows) 0) :id -1))
      (lambda (v) (put (aref (get v :rows) 0) :ranges (js-array (js-array 9 8))))
      (lambda (v) (put (aref (get v :rows) 0) :ranges (js-array (js-array 1 4) (js-array 4 5))))
      (lambda (v) (put (aref (get v :rows) 0) :ranges (js-array (js-array 10 12) (js-array 0 2))))
      (lambda (v) (put (aref (get v :rows) 0) :ranges (js-array (js-array -1 0))))
      (lambda (v) (put (aref (get v :rows) 0) :ranges (js-array (js-array 0 1114112))))
      (lambda (v) (put (aref (get v :rows) 0) :ranges (js-array (js-array 1.5 2))))
      (lambda (v) (put (aref (get v :rows) 0) :ranges (js-array (js-array nil 1))))
      (lambda (v) (put (aref (get v :rows) 0) :ranges (js-array (js-array 0))))
      (lambda (v) (put (aref (get v :rows) 0) :sourceSha256 "not-a-sha256"))
      (lambda (v) (put v :version 2)) (lambda (v) (put v :format "unrelated"))
      (lambda (v) (put v :license "unknown")) (lambda (v) (Reflect/deleteProperty v "licenseUrl"))))
  (defun aliasMutations ()
    (js-array
      (lambda (v) (Reflect/deleteProperty v "records")) (lambda (v) (put v :records (js-array)))
      (lambda (v) (put (get v :records) 1 (js-call (aref (get v :records) 0) :slice)))
      (lambda (v) (js-call (get v :records) :reverse))
      (lambda (v) (put (aref (get v :records) 0) 0 "bad-name"))
      (lambda (v) (put (aref (get v :records) 0) 0 "\ud800"))
      (lambda (v) (put (aref (get v :records) 0) 1 0))
      (lambda (v) (put (aref (get v :records) 0) 1 65536))
      (lambda (v) (put (aref (get v :records) 0) 2 2))
      (lambda (v) (js-call (aref (get v :records) 0) :push "extra"))
      (lambda (v) (put v :sourceSHA256 "bad"))
      (lambda (v) (Reflect/deleteProperty v "runtimeSourceSHA256"))
      (lambda (v) (put v :license "unknown")) (lambda (v) (put v :unicodeVersions (js-array)))
      (lambda (v) (put v :version 2)) (lambda (v) (put v :format "other"))
      (lambda (v) (Reflect/deleteProperty v "groundDecisions"))
      (lambda (v) (put (get v :groundDecisions) :sourceSHA256 (js-call "0" :repeat 64)))
      (lambda (v) (put (get (get v :groundDecisions) :nodes) 0 (js-array 5 0 0 0)))
      (lambda (v) (put (get (get v :groundDecisions) :nodes) 0 (js-array 1 0 (get (get (get v :groundDecisions) :nodes) :length) 0)))
      (lambda (v) (put (get (get v :groundDecisions) :nodes) (get (get v :groundDecisions) :root) (js-array 4 0 (get (get v :groundDecisions) :root) 0)))))
  (defun lookup (tiny text)
    (let ((point (get tiny :root)) (unit 0) (visits 0) (trace (js-array)) (finished false) (result undefined))
      (while (not finished)
        (setq visits (1+ visits)) (assert (<= visits (get (get tiny :nodes) :length)) "the accepted compact decision graph terminates")
        (let* ((row (aref (get tiny :nodes) point)) (kind (aref row 0)) (number (aref row 1)) (yes (aref row 2)) (no (aref row 3)))
          (if (= kind 0) (setq result (js-object :value number :trace trace) finished t)
            (if (= kind 4) (progn (js-call trace :push number) (setq unit (js-call text :charCodeAt number) point yes))
              (setq point (if (if (= kind 1) (< unit number) (if (= kind 2) (= unit number) (= (get text :length) number))) yes no))))))
      result))
  (test "complete declaration-driven property regeneration is deterministic offline and leaves every unrelated byte unchanged" (async ()
    (await (withTree (async (directory)
      (await (seedTree directory))
      (let ((before (await (treeFiles directory))))
        (successful (generate rangeToolPath directory)) (successful (generate aliasToolPath directory))
        (let ((first (await (treeFiles directory))))
          (successful (generate rangeToolPath directory)) (successful (generate aliasToolPath directory))
          (sameTree (await (treeFiles directory)) first "second generation")
          (successful (generate rangeToolPath directory "--check")) (successful (generate aliasToolPath directory "--check"))
          (sameTree (await (treeFiles directory)) first "check mode must not write its inputs or outputs")
          (each (js-array rangeDataPath aliasDataPath) (lambda (file) (assert (js-call (js-call first :get file) :equals (js-call before :get file)) (str "exact declaration bytes of " file))))
          (each (js-array runtimePath regexpPath) (lambda (file)
            (let ((source (js-call (js-call first :get file) :toString "utf8")))
              (regexMatch source "Unicode-3\\.0") (assert (js-call source :includes "https://www.unicode.org/license.txt"))
              (assert (js-call source :startsWith ";; owned maintenance prefix\n")) (assert (js-call source :endsWith "\n;; owned maintenance suffix\n")))))))
      (let ((tools (await (Promise/all (js-call (js-array rangeToolPath aliasToolPath) :map (lambda (file) (readFile file "utf8")))))))
        (each tools (lambda (source) (noMatch source "\\bfetch\\s*\\(|\\b(?:eval|Function)\\s*\\(|\\b(?:execFile|spawn)(?:Sync)?\\s*\\("
          "normal maintenance generation uses declaration data without a network, compiler, or expression evaluator")))))))) 30000)
  (test "invalid complete range declarations fail before any output write rather than dropping or repairing rows" (async ()
    (await (withTree (async (directory)
      (await (invalidDeclarations directory rangeDataPath rangeToolPath (rangeMutations) "range"))
      (let* ((before (await (treeFiles directory))) (child (spawnSync (node) (js-array "--max-old-space-size=128" (resolve rangeToolPath) "--root" directory "--extract" "--write")
        (js-object :encoding "utf8" :timeout 30000 :maxBuffer 65536))))
        (eqv (get child :error) undefined) (eqv (get child :signal) nil) (js-call assert :notEqual (get child :status) 0)
        (sameTree (await (treeFiles directory)) before "first migration cannot overwrite an existing declaration provenance")))))) 30000)
  (test "complete checked-in Unicode property intervals retain all 519 exact row identities and original source provenance" (async ()
    (let* ((text (await (readFile rangeDataPath "utf8"))) (declaration (JSON/parse text)))
      (eqv (get declaration :format) "eliscript-unicode-property-ranges") (eqv (get declaration :version) 1)
      (eqv (get declaration :license) "Unicode-3.0") (eqv (get declaration :licenseUrl) "https://www.unicode.org/license.txt")
      (eqv (get (get declaration :rows) :length) 519)
      (same (js-call (get declaration :rows) :map (lambda (row) (get row :id))) (Array/from (js-object :length 519) (lambda (unused index) index)))
      (each (get declaration :rows) (lambda (row)
        (regexMatch (get row :sourceSha256) "^[a-f0-9]{64}$") (assert (Array/isArray (get row :ranges)))
        (let ((previous -1))
          (each (get row :ranges) (lambda (interval)
            (eqv (get interval :length) 2)
            (let ((low (aref interval 0)) (high (aref interval 1)))
              (assert (and (Number/isInteger low) (Number/isInteger high))) (assert (and (>= low 0) (<= high 1114111) (<= low high)))
              (assert (> low previous)) (setq previous high)))))
        (let* ((words (packRangeRow row)) (decoded (js-array)) (bytes (Buffer/alloc (* (get words :length) 4))) (i 0))
          (eqv (get words :length) (+ 1 (* (get (get row :ranges) :length) 2))) (eqv (aref words 0) (get (get row :ranges) :length))
          (while (< i (aref words 0)) (js-call decoded :push (js-array (aref words (+ 1 (* i 2))) (aref words (+ 2 (* i 2))))) (setq i (1+ i)))
          (same decoded (get row :ranges) (str "all packed intervals preserve row " (get row :id)))
          (each words (lambda (word index) (js-call bytes :writeUInt32LE word (* index 4))))
          (setq i 0) (while (< i (get (get row :ranges) :length))
            (same (js-array (js-call bytes :readUInt32LE (+ 4 (* i 8))) (js-call bytes :readUInt32LE (+ 8 (* i 8)))) (aref (get row :ranges) i)) (setq i (1+ i))))))
      (eqv (await (readFile rangeDataPath "utf8")) text "reading declaration data never repairs or regenerates its provenance"))))
  (test "ground range migration derives exact mathematical intervals and normalized source hashes without enumerating or executing point predicates" (lambda ()
    (let* ((rows (js-array (js-array "(defun heap-regexp-property-ranges-7 (point) (if (< point 10) (if (<= point 4) 0 1) (if (<= point 20) (if (< point 15) 0 1) 0)))" (js-array (js-array 5 9) (js-array 15 20))) (js-array "(defun heap-regexp-property-ranges-44 (point) (if (<= point 1114111) (if (< point 1114111) 0 1) 0))" (js-array (js-array 1114111 1114111))) (js-array "(defun heap-regexp-property-ranges-101 (point) 1)" (js-array (js-array 0 1114111))) (js-array "(defun heap-regexp-property-ranges-102 (point) 0)" (js-array ))))
           (source (str "(module source\n  " (js-call (js-call rows :map (lambda (row) (aref row 0))) :join "\n\t") "\n)"))
           (actual (extractRangeRows source)))
      (eqv (get actual :length) (get rows :length))
      (each rows (lambda (row index)
        (same (get (aref actual index) :ranges) (aref row 1))
        (eqv (get (aref actual index) :sourceSha256) (digest (js-call (aref row 0) :replace (rx "\\s+" "g") "")))))
      (same (extractRangeRows (js-call (js-call source :replaceAll "(< point" "(< \n\tpoint") :replaceAll "(<= point" "(<= \n\tpoint")) actual)
      (each (js-array "(if (> point 1) 0 1)" "(if (< other 4) 0 1)" "(if (< point 4) 2 0)" "(if (< point 4) (foreign-call point) 0)" "(progn 1)" "(if (< point 4) 1)" "(if (< point 1.5) 0 1)")
        (lambda (body) (js-call assert :throws (lambda () (extractRangeRows (str "(defun heap-regexp-property-ranges-7 (point) " body ")"))))))
      (js-call assert :throws (lambda () (extractRangeRows (str (aref (aref rows 0) 0) "\n" (aref (aref rows 0) 0)))) "duplicate original function identity is not merged")
      (js-call assert :throws (lambda () (extractRangeRows (js-call (aref (aref rows 0) 0) :slice 0 -1))) "an incomplete original expression is not repaired"))))
  (test "all declared property aliases retain their exact IDs terminal contracts packed directory and static dynamic source provenance" (async ()
    (let* ((data (JSON/parse (await (readFile aliasDataPath "utf8")))) (packed (packPropertyAliases data)) (cursor (* (get packed :count) 4)) (i 0))
      (eqv (get data :format) "eliscript-unicode-property-aliases") (eqv (get data :version) 1)
      (eqv (get data :license) "Unicode-3.0") (same (get data :unicodeVersions) (js-array "15.1.0" "16.0.0" "17.0.0"))
      (regexMatch (get data :sourceSHA256) "^[a-f0-9]{64}$") (regexMatch (get data :runtimeSourceSHA256) "^[a-f0-9]{64}$")
      (eqv (get (get data :records) :length) 1715) (eqv (get packed :count) (get (get data :records) :length))
      (eqv (get packed :byteLength) (* (get (get packed :units) :length) 2))
      (while (< i (get packed :count))
        (let* ((at (* i 4)) (units (get packed :units)) (offset (+ (aref units at) (* (aref units (1+ at)) 65536)))
               (length (aref units offset)) (text (Reflect/apply (get globalThis.String :fromCharCode) globalThis.String (js-call units :slice (1+ offset) (+ offset 1 length)))))
          (eqv offset cursor "every declared record owns its exact contiguous UTF16 payload")
          (same (js-array text (aref units (+ at 2)) (aref units (+ at 3))) (aref (get data :records) i))
          (setq cursor (+ cursor 1 length)))
        (setq i (1+ i)))
      (eqv cursor (get (get packed :units) :length))
      (let ((literal (JSON/parse (get packed :literal)))) (eqv (get literal :length) (get (get packed :units) :length))
        (setq i 0) (while (< i (get literal :length)) (eqv (js-call literal :charCodeAt i) (aref (get packed :units) i)) (setq i (1+ i))))
      (let* ((generated (generatePropertyAliasSources data)) (pairs (js-array (js-array regexpPath (get generated :staticSource)) (js-array runtimePath (get generated :runtimeSource)))) (n 0))
        (same (generatePropertyAliasSources (globalThis.structuredClone data)) generated)
        (while (< n (get pairs :length))
          (let* ((row (aref pairs n)) (file (aref row 0)) (source (aref row 1)) (actual (await (readFile file "utf8"))))
            (assert (js-call actual :includes source)) (assert (js-call source :includes (get packed :literal)))
            (assert (js-call source :includes (get data :sourceSHA256))) (assert (js-call source :includes (get data :runtimeSourceSHA256)))
            (assert (js-call source :includes "Unicode-3.0")) (assert (js-call source :includes "https://www.unicode.org/license.txt"))
            (noMatch source "\\(if \\(< unit [0-9]+|\\(let \\(\\(unit \\((?:heap-regexp-unit|string-code-unit-at)"))
          (setq n (1+ n)))
        (regexMatch (get generated :runtimeSource) "\\(copy-static-u16 destination ")))))
  (test "ground alias extraction preserves exact versus prefix terminals private partitions and both original source hashes with a restricted grammar" (lambda ()
    (let* ((branch "(if (= unit 65) 7 (if (= unit 66) (if (= length 1) 8 0) 0))")
           (source (str "(defun regexp-property-id-base (source start length) (if (= length 0) 0 (let ((unit (string-code-unit-at source (+ start 0)))) " branch ")))"))
           (expected (js-array (js-array "A" 7 0) (js-array "B" 8 1))) (parsed (extractGroundPropertyAliases source)))
      (same (get parsed :records) expected) (eqv (get parsed :sourceSHA256) (digest source))
      (let ((split (str (js-call source :replace branch "(regexp-property-id-base-part-0001 source start length unit)")
        "\n(defun regexp-property-id-base-part-0001 (source start length unit) " branch ")")))
        (same (extractGroundPropertyAliases split) parsed))
      (let* ((runtime (js-call (js-call (js-call source :replaceAll "regexp-property-id-base" "heap-regexp-property-id-base")
                       :replace "(source start length)" "(heap source start length)") :replace "string-code-unit-at source" "heap-regexp-unit heap source"))
             (runtimeResult (extractGroundPropertyAliases runtime "heap-regexp-property-id-base" t)))
        (same (get runtimeResult :records) expected) (eqv (get runtimeResult :sourceSHA256) (digest runtime)))
      (each (js-array (js-call source :replace branch "(host-call source)") (js-call source :replace "(+ start 0)" "(+ start -1)")
        (js-call source :replace "string-code-unit-at" "foreign-reader") (js-call source :replace "(= unit 65)" "(= unit 128)")
        (js-call source :replace ") 7 " ") 65536 ") (str source "\n" source) (js-call source :slice 0 -1))
        (lambda (invalid) (js-call assert :throws (lambda () (extractGroundPropertyAliases invalid))))))))
  (test "every generated property row contains its exact little-endian static data once and retains the declaration provenance without a decision tree" (async ()
    (let* ((data (JSON/parse (await (readFile rangeDataPath "utf8")))) (source (await (readFile runtimePath "utf8")))
           (begin "  ;; BEGIN GENERATED UNICODE PROPERTY RANGES") (end "  ;; END GENERATED UNICODE PROPERTY RANGES")
           (first (js-call source :indexOf begin)) (last (js-call source :indexOf end first)))
      (assert (and (>= first 0) (> last first))) (eqv (js-call source :indexOf begin (+ first (get begin :length))) -1) (eqv (js-call source :indexOf end (+ last (get end :length))) -1)
      (let* ((region (js-call source :slice first (+ last (get end :length))))
             (rows (Array/from (js-call region :matchAll (rx ";; Original range ([0-9]+) normalized-source SHA-256 ([a-f0-9]{64})\\n  \\(defun heap-regexp-property-ranges-\\1 \\(point\\)([\\s\\S]*?)(?=\\n  ;; Original range |\\n  ;; END GENERATED UNICODE PROPERTY RANGES)" "g")))))
        (eqv (get rows :length) 519)
        (each rows (lambda (emitted index)
          (let* ((row (aref (get data :rows) index)) (copies (Array/from (js-call (aref emitted 3) :matchAll (rx "\\(copy-static-u16 table (\"(?:\\\\u[0-9a-f]{4})*\")\\)" "g")))))
            (eqv (funcall globalThis.Number (aref emitted 1)) (get row :id)) (eqv (aref emitted 2) (get row :sourceSha256))
            (eqv (get copies :length) 1 (str "one static copy node per complete row " (get row :id)))
            (let ((text (JSON/parse (aref (aref copies 0) 1))) (words (packRangeRow row)) (word 0))
              (eqv (get text :length) (* (get words :length) 2))
              (while (< word (get words :length)) (eqv (+ (js-call text :charCodeAt (* word 2)) (* (js-call text :charCodeAt (1+ (* word 2))) 65536)) (aref words word)) (setq word (1+ word))))
            (noMatch (aref emitted 3) "\\((?:<|<=) point [0-9]" "point intervals remain data rather than repeated branch code")
            (assert (js-call (aref emitted 3) :includes "(heap-regexp-property-range-find table point)")))))
        (eqv (get (Array/from (js-call source :matchAll (rx "\\(defun heap-regexp-property-ranges-[0-9]+ \\(point\\)" "g"))) :length) 519)
        (assert (js-call region :includes "Unicode-3.0")) (assert (js-call region :includes (get data :licenseUrl)))))))
  (test "invalid complete alias declarations are rejected before either static or dynamic generated file changes" (async ()
    (await (withTree (async (directory) (await (invalidDeclarations directory aliasDataPath aliasToolPath (aliasMutations) "alias")))))) 30000)
  (test "compact ground alias decisions preserve the complete original declaration source and every packed decision without executable trie expansion" (async ()
    (let* ((data (JSON/parse (await (readFile aliasDataPath "utf8")))) (original (await (readFile "tests/fixtures/regexp-property-original-trie.eli" "utf8")))
           (generated (generatePropertyAliasSources data))
           (literal (js-call (rx "\\(defun regexp-property-ground-table \\(\\) (\"(?:\\\\u[0-9a-f]{4})*\")\\)") :exec (get generated :staticSource))))
      (same (compileGroundPropertyAliasDecisions original) (get data :groundDecisions))
      (assert literal)
      (let ((units (JSON/parse (aref literal 1))) (nodes (get (get data :groundDecisions) :nodes)) (index 0))
        (eqv (get units :length) (* (get nodes :length) 8))
        (while (< index (get nodes :length))
          (let ((field 0)) (while (< field 4)
            (let ((at (+ (* index 8) (* field 2)))) (eqv (+ (js-call units :charCodeAt at) (* (js-call units :charCodeAt (1+ at)) 65536)) (aref (aref nodes index) field)))
            (setq field (1+ field)))) (setq index (1+ index))))
      (let* ((source "(defun regexp-property-id-base (source start length) (if (= length 0) 0 (let ((unit (string-code-unit-at source (+ start 0)))) (if (= unit 65) 7 (if (= unit 66) (if (= length 1) 8 0) 0)))))")
             (tiny (compileGroundPropertyAliasDecisions source)))
        (eqv (get tiny :sourceSHA256) (digest source))
        (same (lookup tiny "") (js-object :value 0 :trace (js-array)))
        (each (js-array "A" "Asuffix") (lambda (value) (same (lookup tiny value) (js-object :value 7 :trace (js-array 0)))))
        (same (lookup tiny "B") (js-object :value 8 :trace (js-array 0)))
        (each (js-array "Bsuffix" "C" "\ud800") (lambda (value) (same (lookup tiny value) (js-object :value 0 :trace (js-array 0)))))))))
)
