(module tests.emacs-analysis-evidence.test
  (import "bun:test" expect test)
  (import "node:crypto" createHash)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve join)
  (defconst root (resolve (js* "import.meta.dir") ".."))
  (defasync readJson (relativePath) (JSON/parse (await (readFile (join root relativePath) "utf8"))))
  (defun digest (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defasync verifySourceContract (source)
    (let ((aggregate (js-array)) (files (get source :files)) (index 0))
      (while (< index (get files :length))
        (let* ((entry (aref files index)) (hash (digest (await (readFile (join root (get entry :file)))))))
          (js-call (expect (get entry :sha256)) :toBe hash)
          (js-call aggregate :push (str (get entry :file) ":" hash "\n")))
        (setq index (1+ index)))
      (js-call (expect (get source :digest)) :toBe (digest (js-call aggregate :join "")))))
  (defun each (items operation) (let ((index 0)) (while (< index (get items :length)) (funcall operation (aref items index)) (setq index (1+ index)))))
  (defun verifyRetainedPreparedIdentity (identity)
    ;; Retained measurements may predate the prepared-stage3 certificate.
    ;; When one is present, only its portable shape is checked here; a fresh
    ;; gate must not retroactively certify a historical measurement.
    (when identity
      (js-call (expect (get identity :format)) :toBe "eliscript-prepared-stage3")
      (js-call (expect (js-call (Object/keys identity) :sort))
        :toEqual (js-array "fixedPointFileCount" "format" "productSha256" "sourceSha256" "version"))
      (js-call (expect (Number/isInteger (get identity :version))) :toBe t)
      (js-call (expect (Number/isInteger (get identity :fixedPointFileCount))) :toBe t)
      (js-call (expect (get identity :sourceSha256)) :toHaveLength 64)
      (js-call (expect (get identity :productSha256)) :toHaveLength 64)))
  (test "committed Emacs analysis benchmark preserves qualified evidence" (async ()
    (let* ((report (await (readJson "benchmarks/emacs-analysis-macos-arm64.json")))
           (selected (new globalThis.Set (get (get report :selection) :selected))))
      (js-call (expect report) :toMatchObject (js-object "schemaVersion" 1 "format" "eliscript-emacs-analysis-benchmark" "version" 2 "verified" t "selection" (js-object "selected" (js-array "search-documents" "document-statistics") "requiredWarmSpeedup" 2 "thresholdCharacters" 16000 "primaryQualified" t)))
      (js-call (expect (get (get report :primary) :corpus)) :toMatchObject (js-object "totalTerms" 200000 "iterations" 30 "warmups" 3))
      (js-call (expect (get report :crossover)) :toHaveLength 6)
      (each (get (get report :primary) :candidates) (lambda (candidate)
        (js-call (expect (get candidate :correct)) :toBe t)
        (js-call (expect (get (get candidate :samples) :reference)) :toHaveLength 30)
        (js-call (expect (get (get candidate :samples) :accelerated)) :toHaveLength 30)
        (let ((expected (js-object)))
          (each (js-array "referenceEndToEnd" "acceleratedEndToEnd" "worker" "execution" "serialization" "transportDecodeAndApplication")
            (lambda (key) (put expected key (js-call expect :any globalThis.Number))))
          (js-call (expect (get candidate :mediansMs)) :toEqual (js-call expect :objectContaining expected)))
        (when (js-call selected :has (get candidate :name)) (js-call (expect (get candidate :warmEndToEndSpeedup)) :toBeGreaterThanOrEqual 2))
        (each (get (get candidate :samples) :accelerated) (lambda (sample)
          (js-call (expect (get sample :applicationDigest)) :toBe (get (aref (get (get candidate :samples) :reference) 0) :applicationDigest))))))
      (let* ((crossover (get report :crossover))
             (belowThreshold (js-call crossover :filter (lambda (entry) (< (get (get entry :corpus) :totalCharacters) (get (get report :selection) :thresholdCharacters)))))
             (qualifyingCrossover (js-call crossover :find (lambda (entry) (= (get (get entry :corpus) :totalCharacters) 15754))))
             (aboveThreshold (js-call crossover :find (lambda (entry) (> (get (get entry :corpus) :totalCharacters) 16000)))))
        (js-call (expect (js-call belowThreshold :some (lambda (entry)
          (js-call (js-call (get entry :candidates) :filter (lambda (candidate) (js-call selected :has (get candidate :name)))) :some
            (lambda (candidate) (< (get candidate :warmEndToEndSpeedup) 2)))))) :toBe t)
        (each (js-array qualifyingCrossover aboveThreshold) (lambda (entry)
          (each (js-call (get entry :candidates) :filter (lambda (candidate) (js-call selected :has (get candidate :name))))
            (lambda (candidate) (js-call (expect (get candidate :warmEndToEndSpeedup)) :toBeGreaterThanOrEqual 2)))))
        (js-call (expect (get (get report :selection) :thresholdCharacters)) :toBeGreaterThan (get (get qualifyingCrossover :corpus) :totalCharacters))
        (js-call (expect (get (get report :selection) :thresholdCharacters)) :toBeLessThan (get (get aboveThreshold :corpus) :totalCharacters)))
      ;; Casing is on the measured token-normalization path. Bind its actual
      ;; runtime bytes, maintained source and generated-table inputs as well.
      (let ((files (js-call (get (get report :source) :files) :map
                     (lambda (entry) (get entry :file)))))
        (each (js-array "runtime/unicode-case.eli" "runtime/unicode-case.mjs"
                       "runtime/unicode-case-data.eli" "runtime/unicode-case-data.mjs"
                       "bootstrap/runtime/memory.eli" "tools/runtime/unicode-case-runtime.el")
          (lambda (file) (js-call (expect files) :toContain file))))
      (verifyRetainedPreparedIdentity (get (get report :source) :preparedCompiler))
      (await (verifySourceContract (get report :source))))))
  (test "committed Emacs analysis soak proves buffer lifecycle safety" (async ()
    (let ((report (await (readJson "benchmarks/emacs-analysis-soak-macos-arm64.json"))))
      (js-call (expect report) :toMatchObject (js-object "schemaVersion" 1 "format" "eliscript-emacs-analysis-soak" "version" 1 "verified" t "iterations" 200 "stableApplications" 100 "staleDiscards" 100 "applicationCount" 100 "workerGenerationStable" t))
      (js-call (expect (get (get report :workerMs) :samples)) :toHaveLength 200)
      (js-call (expect (get (get report :workerMs) :median)) :toBeGreaterThan 0)
      (verifyRetainedPreparedIdentity (get (get report :source) :preparedCompiler))
      (await (verifySourceContract (get report :source))))))
)
