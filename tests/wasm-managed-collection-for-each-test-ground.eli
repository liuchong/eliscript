(module tests.wasm-managed-collection-for-each-test-ground
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:fs" readFileSync)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defvar directory undefined)
  (defvar b undefined)
  (defvar runtime undefined)
  (defvar program undefined)
  (defvar bytes undefined)
  (defvar js undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-collection-foreach-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (setq program (js-call (get b :compiler) :compile_ir_string (await (readFile "tests/fixtures/wasm-managed-source-collections.eli" "utf8")) "source-collections.eli"))
    (let ((before (JSON/stringify program)))
      (setq bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm program runtime)))
      (js-call assert :equal (JSON/stringify program) before))
    (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
    (setq js (await (dynamic-import (str "data:text/javascript;base64,"
                                         (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string program)) :toString "base64"))))))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun instance (&rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (let ((a (instantiateManagedRuntime bytes options)))
      (js-call a :auto 1)
      a)))

  (defun read (a value)
    (cond
      ((or (nil? value) (not (= (value-type value) "object"))) value)
      ((= (get value :kind) 4) (js-call a :readNumber value))
      ((= (get value :kind) 5) (js-call a :readString value))
      (t
       (js-call assert :equal (get value :kind) 14)
       (Array/from (js-object :length (js-call a :length value))
         (lambda (_ i)
           (let ((x (js-call a :get value i)))
             (try (read a x) (finally (js-call a :release x)))))))))

  (defun call (a name &rest __host_default_arguments_1)
    (let* ((args-arg (aref __host_default_arguments_1 0)))
    (let* ((args (if (undefined? args-arg) (js-array) args-arg))
           (out (js-call a :invoke name args)))
      (try (read a out) (finally (js-call a :release out))))))

  (defun finish (a &rest __host_default_arguments_2)
    (let* ((values-arg (aref __host_default_arguments_2 0)))
    (let ((values (if (undefined? values-arg) (js-array) values-arg)))
      (js-call values :forEach (lambda (x) (js-call a :release x)))
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (defun populate (a set-mode values)
    (let ((items (js-call a :invoke (if set-mode "empty-set" "empty-map"))))
      (js-call values :forEach
        (lambda (v i)
          (let* ((value (cond
                          ((= (value-type v) "number") (js-call a :number v))
                          ((= (value-type v) "string") (js-call a :string v))
                          (t v)))
                 (key (js-call a :number i))
                 (out (js-call a :invoke
                        (if set-mode "add-value" "set-value")
                        (if set-mode (js-array items value) (js-array items key value)))))
            (js-call (js-array value key out) :forEach (lambda (x) (js-call a :release x))))))
      items))

  (test "Given Map and Set values, when forEach executes, then exactly value key receiver are supplied and return values are ignored" (lambda ()
    (js-call (js-array false t) :forEach
      (lambda (set-mode)
        (let* ((a (instance))
               (values (js-array undefined nil false t -0.0 globalThis.NaN globalThis.Number.MIN_VALUE "中😀"))
               (items (populate a set-mode values))
               (log (js-call a :sourceArray (js-array)))
               (control (if set-mode
                          (new globalThis.Set values)
                          (new globalThis.Map (js-call values :map (lambda (v i) (js-array i v))))))
               (expected (js-array)))
          (js-call assert :equal
            (js-call control :forEach
              (lambda (v k receiver)
                (js-call expected :push (js-array v k (= receiver control)))
                123))
            undefined)
          (js-call assert :equal (call a "visit" (js-array items log)) undefined)
          (js-call assert :deepEqual (read a log) expected)
          (funcall assert (> (get (js-call a :stats) :collections) 0))
          (finish a (js-array items log)))))))

  (test "Given deletion reinsert clear append and value replacement, when collection forEach iterates, then each live mutation matches JS" (lambda ()
    (let ((a (instance)))
      (js-call (js-array false t) :forEach
        (lambda (set-mode)
          (js-call (js-array 0 1 2 3) :forEach
            (lambda (mode)
              (let ((n (js-call a :number mode)))
                (js-call assert :deepEqual
                  (call a "for-each-mutate" (js-array set-mode n))
                  (js-call js :for_each_mutate set-mode mode))
                (js-call a :release n))))))
      (finish a))))

  (test "Given empty Map and Set receivers, when callbacks are missing or noncallable, then validation fails before iteration and later calls recover" (lambda ()
    (let ((a (instance)))
      (js-call (js-array false t) :forEach
        (lambda (set-mode)
          (let* ((items (populate a set-mode (js-array)))
                 (log (js-call a :sourceArray (js-array)))
                 (callback (js-call a :invoke "record-callback" (js-array log))))
            (js-call (js-array undefined nil false t (js-call a :number 0) (js-call a :string "bad")) :forEach
              (lambda (value)
                (js-call assert :throws
                  (lambda () (js-call a :invoke "for-each-with" (js-array items value)))
                  (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-RT0003")))))
                (js-call a :release value)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))
            (js-call assert :equal (call a "for-each-with" (js-array items callback)) undefined)
            (js-call assert :deepEqual (read a log) (js-array))
            (js-call (js-array items log callback) :forEach (lambda (x) (js-call a :release x))))))
      (finish a))))

  (test "Given own and inherited forEach methods, when arguments replace them, then captured methods run after every argument effect" (lambda ()
    (let ((a (instance)))
      (js-call (js-array false t) :forEach
        (lambda (set-mode)
          (let ((items (populate a set-mode (js-array t false)))
                (trace (js-call a :sourceArray (js-array false)))
                (log (js-call a :sourceArray (js-array))))
            (js-call assert :equal (call a "for-each-builtin-capture" (js-array items log trace)) undefined)
            (js-call assert :deepEqual (read a log)
              (js-array
                (js-array t (if set-mode t 0) t)
                (js-array false (if set-mode false 1) t)))
            (js-call assert :deepEqual (read a trace) (js-array 9))
            (js-call assert :throws
              (lambda () (js-call a :invoke "visit" (js-array items log)))
              (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-RT0003")))))
            (js-call assert :deepEqual (call a "for-each-own-capture" (js-array items trace)) (js-array "captured" 1))
            (js-call (js-array items trace log) :forEach (lambda (x) (js-call a :release x))))))
      (finish a))))

  (test "Given reentrant iteration on one collection, when a callback enters forEach again, then independent cursors retain outer order" (lambda ()
    (let ((a (instance)))
      (js-call (js-array false t) :forEach
        (lambda (set-mode)
          (let* ((values (js-array 3 1 2))
                 (items (populate a set-mode values))
                 (control (if set-mode
                            (new globalThis.Set values)
                            (new globalThis.Map (js-call values :map (lambda (v i) (js-array i v)))))))
            (js-call assert :deepEqual (call a "for-each-reentrant" (js-array items)) (js-call js :for_each_reentrant control))
            (js-call a :release items))))
      (finish a))))

  (test "Given a failing callback, when a collection iteration aborts, then preceding effects and caller frames survive and later callbacks recover" (lambda ()
    (let ((a (instance)))
      (js-call (js-array false t) :forEach
        (lambda (set-mode)
          (let* ((items (populate a set-mode (js-array 7 8)))
                 (marker (js-call a :sourceArray (js-array false)))
                 (frame (js-call a :frame 1)))
            (js-call a :frameSet frame 0 items)
            (js-call assert :throws
              (lambda () (js-call a :invoke "for-each-fail" (js-array items marker)))
              (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-RT0003")))))
            (js-call assert :deepEqual (read a marker) (js-array 7))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (let ((kept (js-call a :frameGet frame 0)))
              (funcall assert (js-call a :keyEqual kept items))
              (js-call a :release kept))
            (js-call a :leaveFrame frame)
            (let ((log (js-call a :sourceArray (js-array))))
              (js-call assert :equal (call a "visit" (js-array items log)) undefined)
              (js-call assert :equal (js-call a :length log) 2)
              (js-call (js-array items marker log) :forEach (lambda (x) (js-call a :release x)))))))
      (finish a))))

  (test "Given callback allocation pressure, when live iteration exhausts capacity, then prior effects remain and only private roots unwind" (lambda ()
    (js-call (js-array false t) :forEach
      (lambda (set-mode)
        (let* ((a (instance (js-object :maxSlots 192 :initialBytes 65536 :maxBytes 262144)))
               (values (if set-mode
                         (Array/from (js-object :length 128) (lambda (_ i) i))
                         (js-call (globalThis.Array 128) :fill t)))
               (items (populate a set-mode values))
               (log (js-call a :sourceArray (js-array)))
               (callback (js-call a :invoke "record-callback" (js-array log)))
               (caller (js-call a :frame 1)))
          (js-call a :frameSet caller 0 items)
          (js-call assert :throws
            (lambda () (js-call a :invoke "for-each-with" (js-array items callback)))
            (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-RT0002")))))
          (funcall assert (and (> (js-call a :length log) 0) (< (js-call a :length log) 128)))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (let ((held (js-call a :frameGet caller 0)))
            (funcall assert (js-call a :keyEqual held items))
            (js-call a :release held))
          (js-call a :leaveFrame caller)
          (finish a (js-array items log callback)))))))

  (test "Given a real iterator trap, when collection forEach aborts, then outer roots remain valid and the original failure is preserved" (lambda ()
    (let* ((source (readFileSync "bootstrap/runtime/memory.eli" "utf8"))
           (start (js-call source :indexOf "  (defun value-iterator-value (heap iterator)"))
           (end (js-call source :indexOf "  (defun " (+ start 10))))
      (funcall assert (and (>= start 0) (> end start)))
      (let* ((injected (js-call (get b :compiler) :compile_ir_string
                         (str (js-call source :slice 0 start)
                              "  (defun value-iterator-value (heap iterator) (load-u32 4294967295))\n"
                              (js-call source :slice end))
                         "collection-foreach-trap.eli"))
             (a (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm program injected))))
             (_ (js-call a :auto 1))
             (items (populate a false (js-array t)))
             (log (js-call a :sourceArray (js-array)))
             (callback (js-call a :invoke "record-callback" (js-array log)))
             (caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 items)
        (js-call assert :throws
          (lambda () (js-call a :invoke "for-each-with" (js-array items callback)))
          globalThis.WebAssembly.RuntimeError)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (let ((held (js-call a :frameGet caller 0)))
          (funcall assert (js-call a :keyEqual held items))
          (js-call a :release held))
        (js-call assert :deepEqual (read a log) (js-array))
        (js-call assert :throws
          (lambda () (js-call a :invoke "for-each-with" (js-array items false)))
          (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-RT0003")))))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (js-call a :leaveFrame caller)
        (finish a (js-array items log callback))))))

  (test "Given malformed raw references, when collection forEach validates them, then invalid-handle errors do not become WASM traps" (lambda ()
    (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
           (heap (js-call e "heap-new" 32 4096 65536))
           (items (js-call e "value-source-collection-new" heap 15 3))
           (caller (js-call e "frame-new" heap 1)))
      (funcall assert items)
      (js-call e "frame-set" heap caller 0 items)
      (js-call assert :equal (js-call e "value-source-collection-for-each" heap items 4294967295) 0)
      (js-call assert :equal (js-call e "last-error") 1)
      (js-call assert :equal (js-call e "frame-depth" heap) 1)
      (js-call assert :equal (js-call e "value-source-collection-for-each" heap 4294967295 3) 0)
      (js-call assert :equal (js-call e "last-error") 1)
      (js-call assert :equal (js-call e "frame-depth" heap) 1)
      (js-call e "frame-pop" heap caller)
      (js-call e "heap-collect" heap)
      (js-call assert :equal (js-call e "heap-live" heap) 0))))

  (test "Given fixed random mutation scripts, when Map and Set callbacks mutate their live tables, then independent JS and WASM traces agree exactly" (lambda ()
    (let* ((a (instance))
           (state 763248529)
           (next (lambda () (setq state (uint32 (+ (Math/imul state 1664525) 1013904223)))))
           (trial 0))
      (letfn ((box-tree (value)
                (if (Array/isArray value)
                  (let* ((children (js-call value :map (lambda (v) (box-tree v))))
                         (result (js-call a :sourceArray children)))
                    (js-call children :forEach (lambda (x) (js-call a :release x)))
                    result)
                  (js-call a :number value))))
        (while (< trial 64)
          (let* ((actions (Array/from (js-object :length 8)
                            (lambda ()
                              (Array/from (js-object :length (% (funcall next) 4))
                                (lambda ()
                                  (js-array (% (funcall next) 4) (% (funcall next) 7) (- (% (funcall next) 129) 64)))))))
                 (input (box-tree actions)))
            (js-call (js-array false t) :forEach
              (lambda (set-mode)
                (js-call assert :deepEqual
                  (call a "for-each-actions" (js-array set-mode input))
                  (js-call js :for_each_actions set-mode actions))))
            (js-call a :release input)
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
          (setq trial (1+ trial))))
      (finish a))))

  (test "Given Node and the identical zero-import artifact, when both collection callback families run, then argument identity and live mutations match that engine" (lambda ()
    (let ((result (spawnSync "node"
                    (js-array (resolve "tests/helpers/wasm-managed-collection-for-each-node.mjs")
                              (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href))
                    (js-object :input (Buffer/from bytes) :encoding "utf8" :timeout 30000))))
      (js-call assert :equal (get result :status) 0 (get result :stderr))))))
