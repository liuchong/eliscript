(module runtime.math
  ;; Production implementations for hosts whose Math does not yet supply
  ;; these exact operations. Initialization augments the actual Math object
  ;; once; later user getters, assignments and deletions are ordinary Get/Set.
  (defconst namespace (Reflect/get globalThis.globalThis "Math"))
  (defconst apply-native Reflect/apply)
  (defconst define-native Object/defineProperty)
  (defconst same-native Object/is)
  (defconst object-native globalThis.Object)
  (defconst boolean-native globalThis.Boolean)
  (defconst finite-native Number/isFinite)
  (defconst nan-native Number/isNaN)
  (defconst floor-native (get namespace :floor))
  (defconst power-native (get namespace :pow))
  (defconst type-error-native globalThis.TypeError)
  (defconst range-error-native globalThis.RangeError)
  (defconst iterator-key globalThis.Symbol.iterator)
  (defconst words-constructor globalThis.Uint32Array)
  (defconst view (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
  (defconst get-word (get globalThis.DataView.prototype :getUint32))
  (defconst set-word (get globalThis.DataView.prototype :setUint32))
  (defconst get-number (get globalThis.DataView.prototype :getFloat64))
  (defconst set-number (get globalThis.DataView.prototype :setFloat64))

  (defun word-at (offset) (funcall apply-native get-word view (js-array offset t)))
  (defun number-from-words (low high)
    (funcall apply-native set-word view (js-array 0 low t))
    (funcall apply-native set-word view (js-array 4 high t))
    (funcall apply-native get-number view (js-array 0 t)))
  (defun round-significand (significand shift)
    (let* ((divisor (funcall power-native 2 shift))
           (quotient (funcall floor-native (/ significand divisor)))
           (remainder (- significand (* quotient divisor))) (half (/ divisor 2)))
      (+ quotient (if (or (> remainder half) (and (= remainder half) (= (% quotient 2) 1))) 1 0))))
  (defconst f16round (lambda (input)
    ;; DataView's captured setter performs precisely ToNumber once, including
    ;; BigInt/Symbol rejection and number-hint ToPrimitive with original throws.
    ;; A recursive conversion completes before this outer write, so the private
    ;; shared view is not observed in an intermediate state by another call.
    (funcall apply-native set-number view (js-array 0 input t))
    (let* ((number (funcall apply-native get-number view (js-array 0 t)))
           (low (word-at 0)) (high (word-at 4))
           (negative (/= (bit-and high 2147483648) 0))
           (exponent (bit-and (unsigned-bit-shift-right high 20) 2047))
           (fraction (bit-and high 1048575)))
      (if (or (= exponent 2047) (= number 0)) number
        (let ((half-exponent 0) (half-fraction 0)
              (significand (+ (* (+ fraction 1048576) 4294967296) low)))
          (cond
            ((>= exponent 1039) (setq half-exponent 31))
            ((>= exponent 1009)
              (let ((rounded (round-significand significand 42)))
                (setq half-exponent (- exponent 1008))
                (when (= rounded 2048) (setq rounded 1024 half-exponent (1+ half-exponent)))
                (setq half-fraction (% rounded 1024))))
            ((>= exponent 998)
              (setq half-fraction (round-significand significand (- 1051 exponent)))
              (when (= half-fraction 1024) (setq half-exponent 1 half-fraction 0))))
          (let ((magnitude
                  (cond ((= half-exponent 31) globalThis.Infinity)
                    ((= half-exponent 0) (* half-fraction (funcall power-native 2 -24)))
                    (t (* (+ 1024 half-fraction) (funcall power-native 2 (- half-exponent 25)))))))
            (if negative (- magnitude) magnitude)))))))

  ;; Each finite input is an integer multiple of 2^-1074. Separate positive
  ;; and negative base-2^16 accumulators retain exact sums before subtraction.
  ;; The largest finite term uses 2098 bits; fewer than 2^53 terms use at most
  ;; 2151 bits. 135 limbs (2160 bits) therefore cover the entire specified
  ;; count domain. Every individual addition/carry stays below 2^32, exactly
  ;; representable by Number; this does not use the test oracle's BigInt model.
  (defun add-word (accumulator index value)
    (while (> value 0)
      (let ((total (+ (aref accumulator index) (% value 65536))))
        (put accumulator index (% total 65536))
        (setq value (+ (funcall floor-native (/ value 65536)) (funcall floor-native (/ total 65536)))))
      (setq index (1+ index))))
  (defun add-number (accumulator low high exponent)
    (let* ((shift (if (= exponent 0) 0 (1- exponent)))
           (index (funcall floor-native (/ shift 16)))
           (scale (funcall power-native 2 (% shift 16)))
           (upper (bit-or (bit-and high 1048575) (if (= exponent 0) 0 1048576))))
      (add-word accumulator index (* (bit-and low 65535) scale))
      (add-word accumulator (1+ index) (* (unsigned-bit-shift-right low 16) scale))
      (add-word accumulator (+ index 2) (* (bit-and upper 65535) scale))
      (add-word accumulator (+ index 3) (* (unsigned-bit-shift-right upper 16) scale))))
  (defun accumulator-bit (accumulator position)
    (bit-and (unsigned-bit-shift-right (aref accumulator (funcall floor-native (/ position 16))) (% position 16)) 1))
  (defun finish-sum (positive negative all-minus-zero)
    (let ((index 134) (comparison 0))
      (while (and (>= index 0) (= comparison 0))
        (let ((left (aref positive index)) (right (aref negative index)))
          (when (/= left right) (setq comparison (if (> left right) 1 -1))))
        (setq index (1- index)))
      (if (= comparison 0) (if all-minus-zero -0.0 0)
        (let ((large (if (> comparison 0) positive negative))
              (small (if (> comparison 0) negative positive))
              (sign (if (< comparison 0) 2147483648 0)) (borrow 0))
          (setq index 0)
          (while (< index 135)
            (let ((difference (- (- (aref large index) (aref small index)) borrow)))
              (setq borrow (if (< difference 0) 1 0))
              (put large index (if (< difference 0) (+ difference 65536) difference)))
            (setq index (1+ index)))
          (setq index 134)
          (while (= (aref large index) 0) (setq index (1- index)))
          (let ((length (* index 16)) (top (aref large index)))
            (while (> top 0) (setq length (1+ length) top (unsigned-bit-shift-right top 1)))
            (cond
              ((<= length 52)
                (number-from-words (+ (aref large 0) (* (aref large 1) 65536))
                  (+ sign (aref large 2) (* (aref large 3) 65536))))
              ((> length 2098) (number-from-words 0 (+ sign 2146435072)))
              (t
                (let ((shift (- length 53)) (significand 0) (position (1- length)) (sticky false))
                  (while (>= position shift)
                    (setq significand (+ (* significand 2) (accumulator-bit large position)) position (1- position)))
                  (when (> shift 0)
                    (setq position (- shift 2))
                    (while (and (>= position 0) (not sticky))
                      (when (= (accumulator-bit large position) 1) (setq sticky t))
                      (setq position (1- position)))
                    (when (and (= (accumulator-bit large (1- shift)) 1) (or sticky (= (% significand 2) 1)))
                      (setq significand (1+ significand))))
                  (when (= significand 9007199254740992)
                    (setq significand 4503599627370496 shift (1+ shift)))
                  (if (>= shift 2046) (number-from-words 0 (+ sign 2146435072))
                    (number-from-words (% significand 4294967296)
                      (+ sign (* (1+ shift) 1048576)
                        (- (funcall floor-native (/ significand 4294967296)) 1048576))))))))))))
  (defun object-p (value)
    (and (not (nullish? value)) (funcall same-native (funcall object-native value) value)))
  (defun number-p (value)
    ;; Native Number predicates perform Type checks without touching object
    ;; properties or coercion hooks, including Proxy and boxed Number values.
    (or (funcall finite-native value) (funcall nan-native value)
        (funcall same-native value globalThis.Infinity) (funcall same-native value (- globalThis.Infinity))))
  (defun close-abrupt (iterator error)
    (try
      (let ((method (get iterator :return)))
        (unless (nullish? method)
          (let ((result (funcall apply-native method iterator (js-array))))
            (unless (object-p result) (throw (new type-error-native "iterator return must be an object"))))))
      (catch ignored nil))
    (throw error))
  (defconst sumPrecise (lambda (items)
    (let* ((method (get items iterator-key))
           (iterator (funcall apply-native method items (js-array))))
      (unless (object-p iterator) (throw (new type-error-native "iterator must be an object")))
      (let ((next (get iterator :next)) (positive (new words-constructor 135))
            (negative (new words-constructor 135)) (all-minus-zero t)
            (nan false) (positive-infinity false) (negative-infinity false) (count 0) (done false))
        (while (not done)
          ;; IteratorStepValue failures are deliberately outside close-abrupt.
          (let ((step (funcall apply-native next iterator (js-array))))
            (unless (object-p step) (throw (new type-error-native "iterator result must be an object")))
            (if (funcall boolean-native (get step :done)) (setq done t)
              (let ((item (get step :value)))
                (when (>= count 9007199254740991)
                  (close-abrupt iterator (new range-error-native "too many sumPrecise elements")))
                (unless (number-p item)
                  (close-abrupt iterator (new type-error-native "sumPrecise requires Number elements")))
                (setq count (1+ count))
                (setq all-minus-zero (and all-minus-zero (funcall same-native item -0.0)))
                (cond
                  ((funcall nan-native item) (setq nan t))
                  ((funcall same-native item globalThis.Infinity) (setq positive-infinity t))
                  ((funcall same-native item (- globalThis.Infinity)) (setq negative-infinity t))
                  ((not (or nan positive-infinity negative-infinity))
                    (funcall apply-native set-number view (js-array 0 item t))
                    (let* ((low (word-at 0)) (high (word-at 4))
                           (exponent (bit-and (unsigned-bit-shift-right high 20) 2047)))
                      (add-number (if (/= (bit-and high 2147483648) 0) negative positive) low high exponent))))))))
        (cond ((or nan (and positive-infinity negative-infinity)) globalThis.NaN)
          (positive-infinity globalThis.Infinity) (negative-infinity (- globalThis.Infinity))
          (t (finish-sum positive negative all-minus-zero)))))))

  (funcall define-native f16round "name" (js-object :value "f16round" :writable false :enumerable false :configurable t))
  (funcall define-native f16round "length" (js-object :value 1 :writable false :enumerable false :configurable t))
  (funcall define-native sumPrecise "name" (js-object :value "sumPrecise" :writable false :enumerable false :configurable t))
  (funcall define-native sumPrecise "length" (js-object :value 1 :writable false :enumerable false :configurable t))
  (funcall define-native namespace "f16round" (js-object :value f16round :writable t :enumerable false :configurable t))
  (funcall define-native namespace "sumPrecise" (js-object :value sumPrecise :writable t :enumerable false :configurable t))
  (export f16round sumPrecise))
