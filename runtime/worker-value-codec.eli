(module eliscript.runtime.worker-value-codec
  (import "./core/identifier.mjs"
    eliscriptSymbol isEliscriptSymbol isKeyword keyword)
  (import "./core/list.mjs"
    isPersistentList persistentList)
  (import "./core/map.mjs"
    isPersistentHashMap persistentHashMap)
  (import "./core/metadata.mjs" meta withMeta)
  (import "./core/set.mjs"
    isPersistentHashSet persistentHashSet)
  (import "./core/vector.mjs"
    isPersistentVector persistentVector)

  (defconst workerValueEncoding "eliscript-value-v1")

  (defconst workerValueLimits
    (Object/freeze
      (js-object :maxDepth 64
                 :maxNodes 100000
                 :maxCollectionLength 100000)))

  (defconst SPECIAL_NUMBERS
    (new globalThis.Map
      (js-array
        (js-array "nan" globalThis.Number.NaN)
        (js-array "positive-infinity" globalThis.Number.POSITIVE_INFINITY)
        (js-array "negative-infinity" globalThis.Number.NEGATIVE_INFINITY)
        (js-array "negative-zero" -0.0))))

  (defconst wireEncoder (new globalThis.TextEncoder))
  (defconst iterator-symbol globalThis.Symbol.iterator)

  (defun typeof-value (value)
    (js* "typeof value"))

  (defun WorkerValueCodecError (code message &rest __opt)
    (let* ((path (aref __opt 0))
           (resolved-path (if (undefined? path) "$" path))
           (err (new globalThis.TypeError (str message " at " resolved-path))))
      (Object/setPrototypeOf err (get WorkerValueCodecError :prototype))
      (put err :name "WorkerValueCodecError")
      (put err :code code)
      (put err :path resolved-path)
      err))
  (Object/setPrototypeOf WorkerValueCodecError globalThis.TypeError)
  (put WorkerValueCodecError :prototype (Object/create (get globalThis.TypeError :prototype)))
  (Object/defineProperty (get WorkerValueCodecError :prototype) "constructor"
    (js-object :value WorkerValueCodecError :writable t :configurable t))
  (Object/defineProperty WorkerValueCodecError "name"
    (js-object :value "WorkerValueCodecError" :configurable t))
  (Object/defineProperty WorkerValueCodecError "length"
    (js-object :value 2 :configurable t))

  (defun normalizedLimits (&rest __opt)
    (let* ((options (aref __opt 0))
           (opts (if (undefined? options) (js-object) options))
           (limits (Object/assign (js-object) workerValueLimits opts))
           (names (Object/keys workerValueLimits))
           (i 0))
      (while (< i (js-length names))
        (let* ((name (aref names i))
               (val (aref limits name)))
          (unless (and (Number/isInteger val) (>= val 1))
            (throw (new globalThis.TypeError (str name " must be a positive integer")))))
        (setq i (1+ i)))
      limits))

  (defun createState (mode options)
    (js-object
      :active (new globalThis.WeakSet)
      :limits (normalizedLimits options)
      :mode mode
      :nodes 0))

  (defun visit (state depth path)
    (put state :nodes (1+ (get state :nodes)))
    (let ((limits (get state :limits))
          (mode (get state :mode)))
      (when (> (get state :nodes) (get limits :maxNodes))
        (throw (new WorkerValueCodecError
                 (str "value-" mode "-limit")
                 (str "value exceeds " (get limits :maxNodes) " nodes")
                 path)))
      (when (> depth (get limits :maxDepth))
        (throw (new WorkerValueCodecError
                 (str "value-" mode "-limit")
                 (str "value exceeds depth " (get limits :maxDepth))
                 path)))))

  (defun collectionLength (state length path)
    (let ((limits (get state :limits))
          (mode (get state :mode)))
      (when (> length (get limits :maxCollectionLength))
        (throw (new WorkerValueCodecError
                 (str "value-" mode "-limit")
                 (str "collection exceeds " (get limits :maxCollectionLength) " values")
                 path)))))

  (defun withActive (state value path operation)
    (let ((active (get state :active)))
      (when (js-call active :has value)
        (throw (new WorkerValueCodecError
                 "value-encoding-cycle"
                 "cyclic values are not transportable"
                 path)))
      (js-call active :add value)
      (try
        (funcall operation)
        (finally
          (js-call active :delete value)))))

  (defun wireKey (value)
    (js-call wireEncoder :encode (JSON/stringify value)))

  (defun compareWireKeys (left right)
    (let ((length (Math/min (js-length left) (js-length right)))
          (index 0)
          (diff 0))
      (while (and (< index length) (eq diff 0))
        (when (not (eq (aref left index) (aref right index)))
          (setq diff (- (aref left index) (aref right index))))
        (setq index (1+ index)))
      (if (not (eq diff 0))
          diff
        (- (js-length left) (js-length right)))))

  (defun compareWireValues (left right)
    (compareWireKeys (wireKey left) (wireKey right)))

  (defun compareText (left right)
    (compareWireKeys (js-call wireEncoder :encode left)
                     (js-call wireEncoder :encode right)))

  (defun encodedMetadata (value state depth path)
    (let ((metadata (meta value)))
      (if (nil? metadata)
          nil
        (encodeValue metadata state (1+ depth) (str path ".metadata")))))

  (defun encodeSequence (tag value state depth path)
    (withActive state value path
      (lambda ()
        (collectionLength state (get value :count) path)
        (let ((values (js-array))
              (index 0)
              (iterator (js-call (aref value iterator-symbol) :call value))
              (done false))
          (while (not done)
            (let ((step (js-call iterator :next)))
              (if (funcall globalThis.Boolean (get step :done))
                  (setq done t)
                (progn
                  (js-call values :push
                    (encodeValue (get step :value) state (1+ depth) (str path "[" index "]")))
                  (setq index (1+ index))))))
          (js-array tag values (encodedMetadata value state depth path))))))

  (defun encodeMap (value state depth path)
    (withActive state value path
      (lambda ()
        (collectionLength state (get value :count) path)
        (let ((entries (js-array))
              (index 0)
              (iterator (js-call (aref value iterator-symbol) :call value))
              (done false))
          (while (not done)
            (let ((step (js-call iterator :next)))
              (if (funcall globalThis.Boolean (get step :done))
                  (setq done t)
                (let* ((pair (get step :value))
                       (key (aref pair 0))
                       (item (aref pair 1)))
                  (js-call entries :push
                    (js-array
                      (encodeValue key state (1+ depth) (str path ".keys[" index "]"))
                      (encodeValue item state (1+ depth) (str path ".values[" index "]"))))
                  (setq index (1+ index))))))
          (js-call entries :sort compareWireValues)
          (js-array "map" entries (encodedMetadata value state depth path))))))

  (defun encodeSet (value state depth path)
    (withActive state value path
      (lambda ()
        (collectionLength state (get value :count) path)
        (let ((values (js-array))
              (index 0)
              (iterator (js-call (aref value iterator-symbol) :call value))
              (done false))
          (while (not done)
            (let ((step (js-call iterator :next)))
              (if (funcall globalThis.Boolean (get step :done))
                  (setq done t)
                (progn
                  (js-call values :push
                    (encodeValue (get step :value) state (1+ depth) (str path "[" index "]")))
                  (setq index (1+ index))))))
          (js-call values :sort compareWireValues)
          (js-array "set" values (encodedMetadata value state depth path))))))

  (defun encodeArray (value state depth path)
    (withActive state value path
      (lambda ()
        (collectionLength state (js-length value) path)
        (let ((values (js-array))
              (index 0))
          (while (< index (js-length value))
            (js-call values :push
              (encodeValue (aref value index) state (1+ depth) (str path "[" index "]")))
            (setq index (1+ index)))
          (js-array "array" values)))))

  (defun encodeObject (value state depth path)
    (withActive state value path
      (lambda ()
        (let ((prototype (Object/getPrototypeOf value)))
          (when (and (not (eq prototype (get globalThis.Object :prototype)))
                     (not (nil? prototype)))
            (throw (new WorkerValueCodecError
                     "value-encoding-unsupported"
                     (str "unsupported object "
                          (js-call (get (get globalThis.Object :prototype) :toString) :call value))
                     path)))
          (let ((symbolKeys
                  (js-call (Object/getOwnPropertySymbols value) :filter
                    (lambda (key)
                      (js-call (get (get globalThis.Object :prototype) :propertyIsEnumerable)
                               :call value key)))))
            (when (> (js-length symbolKeys) 0)
              (throw (new WorkerValueCodecError
                       "value-encoding-unsupported"
                       "host objects with enumerable Symbol keys are not transportable"
                       path)))
            (let* ((descriptors (Object/getOwnPropertyDescriptors value))
                   (keys (js-call (js-call (Object/keys descriptors) :filter
                                    (lambda (key) (get (aref descriptors key) :enumerable)))
                                  :sort compareText)))
              (collectionLength state (js-length keys) path)
              (let ((entries
                      (js-call keys :map
                        (lambda (key)
                          (let ((descriptor (aref descriptors key)))
                            (unless (Reflect/has descriptor "value")
                              (throw (new WorkerValueCodecError
                                       "value-encoding-unsupported"
                                       "host object accessors are not transportable"
                                       (str path "." key))))
                            (js-array key
                              (encodeValue (get descriptor :value) state (1+ depth) (str path "." key))))))))
                (js-array "object" entries))))))))

  (defun encodeValue (value state depth path)
    (visit state depth path)
    (let ((type (typeof-value value)))
      (cond
        ((or (nil? value) (eq type "string") (eq type "boolean"))
         value)
        ((undefined? value)
         (js-array "undefined"))
        ((eq type "number")
         (cond
           ((Number/isNaN value) (js-array "number" "nan"))
           ((eq value globalThis.Number.POSITIVE_INFINITY) (js-array "number" "positive-infinity"))
           ((eq value globalThis.Number.NEGATIVE_INFINITY) (js-array "number" "negative-infinity"))
           ((Object/is value -0.0) (js-array "number" "negative-zero"))
           (t value)))
        ((isKeyword value)
         (js-array "keyword" (get value :namespace) (get value :name)))
        ((isEliscriptSymbol value)
         (withActive state value path
           (lambda ()
             (js-array "symbol"
                       (get value :namespace)
                       (get value :name)
                       (encodedMetadata value state depth path)))))
        ((isPersistentList value)
         (encodeSequence "list" value state depth path))
        ((isPersistentVector value)
         (encodeSequence "vector" value state depth path))
        ((isPersistentHashMap value)
         (encodeMap value state depth path))
        ((isPersistentHashSet value)
         (encodeSet value state depth path))
        ((Array/isArray value)
         (encodeArray value state depth path))
        ((eq type "object")
         (encodeObject value state depth path))
        (t
         (throw (new WorkerValueCodecError
                  "value-encoding-unsupported"
                  (str "unsupported " type " value")
                  path))))))

  (defun requireArray (value message path)
    (unless (Array/isArray value)
      (throw (new WorkerValueCodecError "value-decoding-invalid" message path)))
    value)

  (defun requireTuple (node length tag path)
    (unless (eq (js-length node) length)
      (throw (new WorkerValueCodecError
               "value-decoding-invalid"
               (str tag " node must contain " length " fields")
               path))))

  (defun requireName (value label path &rest __opt)
    (let* ((allowNull (aref __opt 0))
           (nullable (if (undefined? allowNull) false allowNull)))
      (if (and nullable (nil? value))
          nil
        (progn
          (when (or (not (eq (typeof-value value) "string"))
                    (eq (js-length value) 0))
            (throw (new WorkerValueCodecError
                     "value-decoding-invalid"
                     (str label " must be a non-empty string" (if nullable " or null" ""))
                     path)))
          value))))

  (defun decodedMetadata (node state depth path)
    (if (nil? node)
        nil
      (let ((metadata (decodeValue node state (1+ depth) path)))
        (unless (isPersistentHashMap metadata)
          (throw (new WorkerValueCodecError
                   "value-decoding-invalid"
                   "metadata must decode to a persistent Map"
                   path)))
        metadata)))

  (defun decodeSequence (node state depth path constructor)
    (requireTuple node 3 (aref node 0) path)
    (let ((values (requireArray (aref node 1) (str (aref node 0) " values must be an array") path)))
      (collectionLength state (js-length values) path)
      (let* ((decoded (js-call values :map
                        (lambda (value index)
                          (decodeValue value state (1+ depth) (str path "[" index "]")))))
             (result (apply constructor decoded))
             (metadata (decodedMetadata (aref node 2) state depth (str path ".metadata"))))
        (if (nil? metadata) result (withMeta result metadata)))))

  (defun decodeMap (node state depth path)
    (requireTuple node 3 "map" path)
    (let ((entries (requireArray (aref node 1) "map entries must be an array" path)))
      (collectionLength state (js-length entries) path)
      (let ((result (persistentHashMap))
            (index 0))
        (while (< index (js-length entries))
          (let ((entry (requireArray (aref entries index)
                                     "map entry must be a two-field array"
                                     (str path "[" index "]"))))
            (requireTuple entry 2 "map entry" (str path "[" index "]"))
            (let ((key (decodeValue (aref entry 0) state (1+ depth) (str path ".keys[" index "]"))))
              (when (js-call result :has key)
                (throw (new WorkerValueCodecError
                         "value-decoding-invalid"
                         "map contains an equivalent duplicate key"
                         (str path ".keys[" index "]"))))
              (let ((value (decodeValue (aref entry 1) state (1+ depth) (str path ".values[" index "]"))))
                (setq result (js-call result :assoc key value)))))
          (setq index (1+ index)))
        (let ((metadata (decodedMetadata (aref node 2) state depth (str path ".metadata"))))
          (if (nil? metadata) result (withMeta result metadata))))))

  (defun decodeSet (node state depth path)
    (requireTuple node 3 "set" path)
    (let ((values (requireArray (aref node 1) "set values must be an array" path)))
      (collectionLength state (js-length values) path)
      (let ((result (persistentHashSet))
            (index 0))
        (while (< index (js-length values))
          (let ((value (decodeValue (aref values index) state (1+ depth) (str path "[" index "]"))))
            (when (js-call result :has value)
              (throw (new WorkerValueCodecError
                       "value-decoding-invalid"
                       "set contains an equivalent duplicate value"
                       (str path "[" index "]"))))
            (setq result (js-call result :conj value)))
          (setq index (1+ index)))
        (let ((metadata (decodedMetadata (aref node 2) state depth (str path ".metadata"))))
          (if (nil? metadata) result (withMeta result metadata))))))

  (defun decodeArray (node state depth path)
    (requireTuple node 2 "array" path)
    (let ((values (requireArray (aref node 1) "array values must be an array" path)))
      (collectionLength state (js-length values) path)
      (js-call values :map
        (lambda (value index)
          (decodeValue value state (1+ depth) (str path "[" index "]"))))))

  (defun decodeObject (node state depth path)
    (requireTuple node 2 "object" path)
    (let ((entries (requireArray (aref node 1) "object entries must be an array" path)))
      (collectionLength state (js-length entries) path)
      (let ((result (js-object))
            (keys (new globalThis.Set))
            (index 0))
        (while (< index (js-length entries))
          (let ((entry (requireArray (aref entries index)
                                     "object entry must be a two-field array"
                                     (str path "[" index "]"))))
            (requireTuple entry 2 "object entry" (str path "[" index "]"))
            (let ((key (requireName (aref entry 0) "object key" (str path ".keys[" index "]"))))
              (when (js-call keys :has key)
                (throw (new WorkerValueCodecError
                         "value-decoding-invalid"
                         (str "object contains duplicate key " key)
                         (str path ".keys[" index "]"))))
              (js-call keys :add key)
              (Object/defineProperty result key
                (js-object :configurable t
                           :enumerable t
                           :value (decodeValue (aref entry 1) state (1+ depth) (str path "." key))
                           :writable t))))
          (setq index (1+ index)))
        result)))

  (defun decodeValue (node state depth path)
    (visit state depth path)
    (let ((type (typeof-value node)))
      (cond
        ((or (nil? node) (eq type "string") (eq type "boolean") (eq type "number"))
         node)
        (t
         (requireArray node "encoded value must be a scalar or tagged array" path)
         (when (or (eq (js-length node) 0)
                   (not (eq (typeof-value (aref node 0)) "string")))
           (throw (new WorkerValueCodecError
                    "value-decoding-invalid"
                    "encoded value tag must be a non-empty string"
                    path)))
         (let ((tag (aref node 0)))
           (cond
             ((eq tag "undefined")
              (requireTuple node 1 "undefined" path)
              undefined)
             ((eq tag "number")
              (requireTuple node 2 "number" path)
              (unless (js-call SPECIAL_NUMBERS :has (aref node 1))
                (throw (new WorkerValueCodecError
                         "value-decoding-invalid"
                         (str "unknown special number " (funcall globalThis.String (aref node 1)))
                         path)))
              (js-call SPECIAL_NUMBERS :get (aref node 1)))
             ((eq tag "keyword")
              (requireTuple node 3 "keyword" path)
              (let ((namespace (requireName (aref node 1) "keyword namespace" path t))
                    (name (requireName (aref node 2) "keyword name" path)))
                (if (nil? namespace)
                    (keyword name)
                  (keyword namespace name))))
             ((eq tag "symbol")
              (requireTuple node 4 "symbol" path)
              (let* ((namespace (requireName (aref node 1) "symbol namespace" path t))
                     (name (requireName (aref node 2) "symbol name" path))
                     (result (if (nil? namespace)
                                 (eliscriptSymbol name)
                               (eliscriptSymbol namespace name)))
                     (metadata (decodedMetadata (aref node 3) state depth (str path ".metadata"))))
                (if (nil? metadata) result (withMeta result metadata))))
             ((eq tag "list")
              (decodeSequence node state depth path persistentList))
             ((eq tag "vector")
              (decodeSequence node state depth path persistentVector))
             ((eq tag "map")
              (decodeMap node state depth path))
             ((eq tag "set")
              (decodeSet node state depth path))
             ((eq tag "array")
              (decodeArray node state depth path))
             ((eq tag "object")
              (decodeObject node state depth path))
             (t
              (throw (new WorkerValueCodecError
                       "value-decoding-invalid"
                       (str "unknown value tag " tag)
                       path)))))))))

  (defun encodeWorkerValue (value &rest __opt)
    (encodeValue value (createState "encoding" (aref __opt 0)) 0 "$"))
  (Object/defineProperty encodeWorkerValue "length" (js-object :value 2 :configurable t))

  (defun encodeWorkerValues (values &rest __opt)
    (unless (Array/isArray values)
      (throw (new globalThis.TypeError "values must be an array")))
    (let ((state (createState "encoding" (aref __opt 0))))
      (collectionLength state (js-length values) "$arguments")
      (js-call values :map
        (lambda (value index)
          (encodeValue value state 0 (str "$arguments[" index "]"))))))
  (Object/defineProperty encodeWorkerValues "length" (js-object :value 2 :configurable t))

  (defun decodeWorkerValue (value &rest __opt)
    (decodeValue value (createState "decoding" (aref __opt 0)) 0 "$"))
  (Object/defineProperty decodeWorkerValue "length" (js-object :value 2 :configurable t))

  (defun decodeWorkerValues (values &rest __opt)
    (unless (Array/isArray values)
      (throw (new WorkerValueCodecError
               "value-decoding-invalid"
               "encoded values must be an array"
               "$arguments")))
    (let ((state (createState "decoding" (aref __opt 0))))
      (collectionLength state (js-length values) "$arguments")
      (js-call values :map
        (lambda (value index)
          (decodeValue value state 0 (str "$arguments[" index "]"))))))
  (Object/defineProperty decodeWorkerValues "length" (js-object :value 2 :configurable t))

  (export workerValueEncoding
          workerValueLimits
          WorkerValueCodecError
          encodeWorkerValue
          encodeWorkerValues
          decodeWorkerValue
          decodeWorkerValues))
