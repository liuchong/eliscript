(module eliscript.runtime.testing.list
  (import "../core/list-internals.mjs"
    LIST_STATE
    readListMetrics
    resetListMetrics)

  (defun state-of (list)
    (let ((state (if (nil? list) undefined (aref list LIST_STATE))))
      (when (undefined? state)
        (throw (new globalThis/TypeError "expected an Eliscript persistent list")))
      state))

  (defun collect-nodes (list)
    (let ((nodes (new globalThis/Set))
          (node list))
      (while (not (get (state-of node) :empty))
        (js-call nodes :add node)
        (setq node (get (state-of node) :rest)))
      nodes))

  (defun resetPersistentListMetrics ()
    (resetListMetrics))

  (defun persistentListMetrics ()
    (readListMetrics))

  (defun inspectPersistentList (list)
    (let ((state (state-of list)))
      (Object/freeze
        (js-object
          :count (get state :count)
          :empty (get state :empty)
          :nodeCount (get (collect-nodes list) :size)))))

  (defun sharedPersistentListNodes (left right)
    (let ((left-nodes (collect-nodes left))
          (right-nodes (collect-nodes right))
          (shared 0))
      (js-call left-nodes :forEach
        (lambda (node)
          (when (js-call right-nodes :has node)
            (setq shared (+ shared 1)))))
      shared))

  (export
    resetPersistentListMetrics
    persistentListMetrics
    inspectPersistentList
    sharedPersistentListNodes))
