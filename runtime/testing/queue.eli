(module eliscript.runtime.testing.queue
  (import "../core/queue-internals.mjs"
    QUEUE_STATE
    readQueueMetrics
    resetQueueMetrics)
  (import "./vector.mjs"
    sharedPersistentVectorNodes)

  (defun state-of (queue)
    (let ((state (if (nil? queue) undefined (aref queue QUEUE_STATE))))
      (when (undefined? state)
        (throw (new globalThis/TypeError "expected an Eliscript persistent queue")))
      state))

  (defun resetPersistentQueueMetrics ()
    (resetQueueMetrics))

  (defun persistentQueueMetrics ()
    (readQueueMetrics))

  (defun inspectPersistentQueue (queue)
    (let ((state (state-of queue)))
      (Object/freeze
        (js-object
          :count (get state :count)
          :frontCount (get (get state :front) :count)
          :rearCount (get (get state :rear) :count)))))

  (defun sharedPersistentQueueParts (left right)
    (let ((left-state (state-of left))
          (right-state (state-of right)))
      (Object/freeze
        (js-object
          :frontIdentity (eq (get left-state :front) (get right-state :front))
          :rearIdentity (eq (get left-state :rear) (get right-state :rear))
          :rearPromotedToFront (eq (get left-state :rear) (get right-state :front))
          :sharedFrontNodes (sharedPersistentVectorNodes
                              (get left-state :front)
                              (get right-state :front))
          :sharedRearNodes (sharedPersistentVectorNodes
                             (get left-state :rear)
                             (get right-state :rear))))))

  (export
    resetPersistentQueueMetrics
    persistentQueueMetrics
    inspectPersistentQueue
    sharedPersistentQueueParts))
