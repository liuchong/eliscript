(module eliscript.runtime.testing.vector
  (import "../core/vector-internals.mjs" :as vector-internals)
  (import "../core/vector-internals.mjs"
    VECTOR_STATE
    TRANSIENT_VECTOR_STATE
    VectorNode
    readTransientVectorMetrics
    readVectorMetrics
    resetVectorMetrics)

  (defconst instance-of? (js* "(value, Constructor) => value instanceof Constructor"))

  (defun state-of (vector)
    (let ((state (if (nil? vector) undefined (aref vector VECTOR_STATE))))
      (when (undefined? state)
        (throw (new globalThis/TypeError "expected an Eliscript persistent vector")))
      state))

  (defun transient-state-of (vector)
    (let ((state (if (nil? vector) undefined (aref vector TRANSIENT_VECTOR_STATE))))
      (when (undefined? state)
        (throw (new globalThis/TypeError "expected an Eliscript transient vector")))
      state))

  (defun collect-nodes (node nodes)
    (unless (js-call nodes :has node)
      (js-call nodes :add node)
      (let ((slots (get node :slots))
            (index 0))
        (while (< index (js-length slots))
          (let ((child (get slots index)))
            (when (funcall instance-of? child VectorNode)
              (collect-nodes child nodes)))
          (setq index (+ index 1))))))

  (defun resetPersistentVectorMetrics ()
    (resetVectorMetrics))

  (defun persistentVectorMetrics ()
    (readVectorMetrics))

  (defun resetTransientVectorMetrics ()
    (vector-internals/resetTransientVectorMetrics))

  (defun transientVectorMetrics ()
    (readTransientVectorMetrics))

  (defun inspectTransientVector (vector)
    (let ((state (transient-state-of vector))
          (nodes (new globalThis/Set))
          (owned-node-count 0))
      (collect-nodes (get state :root) nodes)
      (js-call nodes :forEach
        (lambda (node)
          (when (eq (get node :owner) (get state :owner))
            (setq owned-node-count (+ owned-node-count 1)))))
      (let* ((source (get state :source))
             (source-state (if (nil? source) undefined (aref source VECTOR_STATE))))
        (Object/freeze
          (js-object
            :active (get state :active)
            :count (get state :count)
            :shift (get state :shift)
            :tailOwned (get state :tailOwned)
            :nodeCount (get nodes :size)
            :ownedNodeCount owned-node-count
            :sharesSourceRoot (and (not (undefined? source-state))
                                   (eq (get state :root) (get source-state :root)))
            :sharesSourceTail (and (not (undefined? source-state))
                                   (eq (get state :tail) (get source-state :tail))))))))

  (defun inspectPersistentVector (vector)
    (let ((state (state-of vector))
          (nodes (new globalThis/Set)))
      (collect-nodes (get state :root) nodes)
      (Object/freeze
        (js-object
          :count (get state :count)
          :shift (get state :shift)
          :depth (+ (/ (get state :shift) 5) 1)
          :tailLength (js-length (get state :tail))
          :nodeCount (get nodes :size)))))

  (defun sharedPersistentVectorNodes (left right)
    (let ((left-nodes (new globalThis/Set))
          (right-nodes (new globalThis/Set))
          (shared 0))
      (collect-nodes (get (state-of left) :root) left-nodes)
      (collect-nodes (get (state-of right) :root) right-nodes)
      (js-call left-nodes :forEach
        (lambda (node)
          (when (js-call right-nodes :has node)
            (setq shared (+ shared 1)))))
      shared))

  (export
    resetPersistentVectorMetrics
    persistentVectorMetrics
    resetTransientVectorMetrics
    transientVectorMetrics
    inspectTransientVector
    inspectPersistentVector
    sharedPersistentVectorNodes))
