(module eliscript.runtime.testing.sorted
  (import "../core/sorted-internals.mjs" :as sorted-internals)
  (import "../core/sorted-internals.mjs"
    SORTED_MAP_STATE
    SORTED_SET_STATE
    SortedNode
    readSortedMetrics)

  (defconst instance-of? (js* "(value, Constructor) => value instanceof Constructor"))

  (defun map-state (value)
    (cond
      ((and (not (nil? value)) (not (undefined? (aref value SORTED_MAP_STATE))))
       (aref value SORTED_MAP_STATE))
      ((and (not (nil? value)) (not (undefined? (aref value SORTED_SET_STATE))))
       (aref (get (aref value SORTED_SET_STATE) :map) SORTED_MAP_STATE))
      (t
       (throw (new globalThis/TypeError "expected an Eliscript persistent sorted collection")))))

  (defun inspect-node (node comparison minimum maximum nodes result)
    (if (eq node nil)
        (js-object :height 0 :size 0)
        (progn
          (when (or (not (funcall instance-of? node SortedNode))
                    (js-call nodes :has node))
            (throw (new globalThis/TypeError "persistent sorted collection contains an invalid tree")))
          (js-call nodes :add node)
          (when (and (not (eq minimum nil))
                     (<= (funcall comparison (get node :key) minimum) 0))
            (throw (new globalThis/TypeError "persistent sorted collection violates lower ordering")))
          (when (and (not (eq maximum nil))
                     (>= (funcall comparison (get node :key) maximum) 0))
            (throw (new globalThis/TypeError "persistent sorted collection violates upper ordering")))
          (let* ((left (inspect-node (get node :left) comparison minimum (get node :key) nodes result))
                 (right (inspect-node (get node :right) comparison (get node :key) maximum nodes result))
                 (height (+ (Math/max (get left :height) (get right :height)) 1))
                 (size (+ (get left :size) (get right :size) 1))
                 (balance (Math/abs (- (get left :height) (get right :height)))))
            (when (or (not (= (get node :height) height))
                      (not (= (get node :size) size))
                      (> balance 1))
              (throw (new globalThis/TypeError "persistent sorted collection violates AVL balance")))
            (put result "maxBalance" (Math/max (get result :maxBalance) balance))
            (js-object :height height :size size)))))

  (defun collect-nodes (node result)
    (unless (or (eq node nil) (js-call result :has node))
      (js-call result :add node)
      (collect-nodes (get node :left) result)
      (collect-nodes (get node :right) result)))

  (defun inspectPersistentSortedCollection (value)
    (let* ((state (map-state value))
           (nodes (new globalThis/Set))
           (result (js-object :maxBalance 0))
           (tree (inspect-node (get state :root) (get state :comparison) nil nil nodes result)))
      (Object/freeze
        (js-object
          :count (get tree :size)
          :height (get tree :height)
          :nodes (get nodes :size)
          :maxBalance (get result :maxBalance)))))

  (defun sharedPersistentSortedNodes (left right)
    (let ((left-nodes (new globalThis/Set))
          (right-nodes (new globalThis/Set))
          (shared 0))
      (collect-nodes (get (map-state left) :root) left-nodes)
      (collect-nodes (get (map-state right) :root) right-nodes)
      (js-call left-nodes :forEach
        (lambda (node)
          (when (js-call right-nodes :has node)
            (setq shared (+ shared 1)))))
      shared))

  (defun resetSortedMetrics ()
    (sorted-internals/resetSortedMetrics))

  (defun sortedMetrics ()
    (readSortedMetrics))

  (export
    inspectPersistentSortedCollection
    sharedPersistentSortedNodes
    resetSortedMetrics
    sortedMetrics))
