(module eliscript.runtime.testing.set
  (import "../core/set-internals.mjs" :as set-internals)
  (import "../core/set-internals.mjs"
    SET_STATE
    TRANSIENT_SET_STATE
    readTransientSetMetrics)
  (import "./map.mjs" :as map-testing)
  (import "./map.mjs"
    inspectPersistentMap
    inspectTransientMap
    persistentMapMetrics
    resetPersistentMapMetrics
    sharedPersistentMapNodes
    transientMapMetrics)

  (defun map-of (set)
    (let ((state (if (nil? set) undefined (aref set SET_STATE))))
      (when (undefined? state)
        (throw (new globalThis/TypeError "expected an Eliscript persistent hash set")))
      (get state :map)))

  (defun resetPersistentSetMetrics ()
    (resetPersistentMapMetrics))

  (defun persistentSetMetrics ()
    (persistentMapMetrics))

  (defun resetTransientSetMetrics ()
    (set-internals/resetTransientSetMetrics)
    (map-testing/resetTransientMapMetrics))

  (defun transientSetMetrics ()
    (let ((set-metrics (readTransientSetMetrics))
          (result (Object/assign (js-object) (transientMapMetrics))))
      (put result "setPersistentCalls" (get set-metrics :persistentCalls))
      (put result "setInvalidCalls" (get set-metrics :invalidCalls))
      (Object/freeze result)))

  (defun inspectTransientSet (set)
    (let ((state (if (nil? set) undefined (aref set TRANSIENT_SET_STATE))))
      (when (undefined? state)
        (throw (new globalThis/TypeError "expected an Eliscript transient hash set")))
      (inspectTransientMap (get state :map))))

  (defun inspectPersistentSet (set)
    (inspectPersistentMap (map-of set)))

  (defun sharedPersistentSetNodes (left right)
    (sharedPersistentMapNodes (map-of left) (map-of right)))

  (export
    resetPersistentSetMetrics
    persistentSetMetrics
    resetTransientSetMetrics
    transientSetMetrics
    inspectTransientSet
    inspectPersistentSet
    sharedPersistentSetNodes))
