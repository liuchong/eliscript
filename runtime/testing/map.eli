(module eliscript.runtime.testing.map
  (import "../core/map-internals.mjs" :as map-internals)
  (import "../core/map-internals.mjs"
    MAP_STATE
    TRANSIENT_MAP_STATE
    ArrayNode
    BitmapIndexedNode
    HashCollisionNode
    MapEntry
    readMapMetrics
    readTransientMapMetrics
    resetMapMetrics)

  (defconst instance-of? (js* "(value, Constructor) => value instanceof Constructor"))

  (defun state-of (map)
    (let ((state (if (nil? map) undefined (aref map MAP_STATE))))
      (when (undefined? state)
        (throw (new globalThis/TypeError "expected an Eliscript persistent hash map")))
      state))

  (defun transient-state-of (map)
    (let ((state (if (nil? map) undefined (aref map TRANSIENT_MAP_STATE))))
      (when (undefined? state)
        (throw (new globalThis/TypeError "expected an Eliscript transient hash map")))
      state))

  (defun inspect-item (item depth result nodes)
    (cond
      ((funcall instance-of? item MapEntry)
       (put result "entries" (+ (get result :entries) 1))
       (put result "maxDepth" (Math/max (get result :maxDepth) depth)))
      ((not (js-call nodes :has item))
       (js-call nodes :add item)
       (put result "maxDepth" (Math/max (get result :maxDepth) depth))
       (cond
         ((funcall instance-of? item BitmapIndexedNode)
          (put result "bitmapNodes" (+ (get result :bitmapNodes) 1))
          (let ((items (get item :items))
                (index 0))
            (while (< index (js-length items))
              (inspect-item (get items index) (+ depth 1) result nodes)
              (setq index (+ index 1)))))
         ((funcall instance-of? item ArrayNode)
          (put result "arrayNodes" (+ (get result :arrayNodes) 1))
          (let ((children (get item :children))
                (index 0))
            (while (< index (js-length children))
              (let ((child (get children index)))
                (unless (undefined? child)
                  (inspect-item child (+ depth 1) result nodes)))
              (setq index (+ index 1)))))
         ((funcall instance-of? item HashCollisionNode)
          (put result "collisionNodes" (+ (get result :collisionNodes) 1))
          (let ((entries (get item :entries))
                (index 0))
            (while (< index (js-length entries))
              (inspect-item (get entries index) (+ depth 1) result nodes)
              (setq index (+ index 1)))))))))

  (defun collect-nodes (item nodes)
    (unless (or (funcall instance-of? item MapEntry)
                (js-call nodes :has item))
      (js-call nodes :add item)
      (let ((children (cond
                        ((funcall instance-of? item BitmapIndexedNode) (get item :items))
                        ((funcall instance-of? item ArrayNode) (get item :children))
                        (t (get item :entries))))
            (index 0))
        (while (< index (js-length children))
          (let ((child (get children index)))
            (unless (undefined? child)
              (collect-nodes child nodes)))
          (setq index (+ index 1))))))

  (defun resetPersistentMapMetrics ()
    (resetMapMetrics))

  (defun persistentMapMetrics ()
    (readMapMetrics))

  (defun resetTransientMapMetrics ()
    (map-internals/resetTransientMapMetrics))

  (defun transientMapMetrics ()
    (readTransientMapMetrics))

  (defun inspectTransientMap (map)
    (let ((state (transient-state-of map))
          (nodes (new globalThis/Set))
          (owned-node-count 0))
      (collect-nodes (get state :root) nodes)
      (js-call nodes :forEach
        (lambda (node)
          (when (eq (get node :owner) (get state :owner))
            (setq owned-node-count (+ owned-node-count 1)))))
      (let* ((source (get state :source))
             (source-state (if (nil? source) undefined (aref source MAP_STATE))))
        (Object/freeze
          (js-object
            :active (get state :active)
            :count (get state :count)
            :nodeCount (get nodes :size)
            :ownedNodeCount owned-node-count
            :sharesSourceRoot (and (not (undefined? source-state))
                                   (eq (get state :root) (get source-state :root))))))))

  (defun inspectPersistentMap (map)
    (let* ((state (state-of map))
           (result (js-object
                     :count (get state :count)
                     :bitmapNodes 0
                     :arrayNodes 0
                     :collisionNodes 0
                     :entries 0
                     :nodeCount 0
                     :maxDepth 0))
           (nodes (new globalThis/Set)))
      (inspect-item (get state :root) 1 result nodes)
      (put result "nodeCount" (get nodes :size))
      (Object/freeze result)))

  (defun sharedPersistentMapNodes (left right)
    (let ((left-nodes (new globalThis/Set))
          (right-nodes (new globalThis/Set))
          (shared 0))
      (collect-nodes (get (state-of left) :root) left-nodes)
      (collect-nodes (get (state-of right) :root) right-nodes)
      (js-call left-nodes :forEach
        (lambda (node)
          (when (js-call right-nodes :has node)
            (setq shared (+ shared 1)))))
      shared))

  (export
    resetPersistentMapMetrics
    persistentMapMetrics
    resetTransientMapMetrics
    transientMapMetrics
    inspectTransientMap
    inspectPersistentMap
    sharedPersistentMapNodes))
