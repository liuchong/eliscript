(module eliscript.runtime.worker
  (import "node:crypto" createHash)
  (import "node:events" once)
  (import "node:fs/promises" readFile realpath stat)
  (import "node:path" dirname isAbsolute relative resolve sep)
  (import "node:readline" createInterface)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "../platform/worker.mjs" workerCapabilities)
  (import "./worker-value-codec.mjs"
    decodeWorkerValues encodeWorkerValue workerValueEncoding)
  (import "./worker-value-stream.mjs"
    WorkerValueStreamDecoder encodeWorkerValueChunks
    workerValueFraming workerValueStreamLimits)
  (import "./source-mapping.mjs"
    decodeSourceMappings mapSourceFrames parseJavaScriptStack)

  (defconst protocolVersion 1)
  (defconst runtimeDirectory (dirname (fileURLToPath (js* "import.meta.url"))))
  (defconst packageDirectories
    (new globalThis.Map
      (js-array
        (js-array "eliscript/platform/" (resolve runtimeDirectory "../platform"))
        (js-array "eliscript/runtime/" runtimeDirectory))))
  (defconst package-filter (new globalThis.RegExp "^eliscript\\/(?:platform|runtime)\\/"))
  (defconst hex-digest-pattern (new globalThis.RegExp "^[0-9a-f]{64}$"))
  (defconst path-split-pattern (new globalThis.RegExp "[\\\\/]"))
  (defconst source-map-url-pattern (new globalThis.RegExp "\\/\\/# sourceMappingURL=([^\\s]+)\\s*$"))
  (defconst async-iterator-symbol globalThis.Symbol.asyncIterator)

  (defun dynamic-import (specifier)
    (js* "import(specifier)"))

  (defun installPackageResolver ()
    (when (and (not (undefined? globalThis.Bun))
               (eq (value-type (get globalThis.Bun :plugin)) "function"))
      (js-call globalThis.Bun :plugin
        (js-object
          :name "eliscript-worker-package"
          :setup (lambda (build)
                   (js-call build :onResolve
                     (js-object :filter package-filter)
                     (lambda (arg)
                       (let* ((specifier (get arg :path))
                              (entries (Array/from packageDirectories))
                              (matched (js-call entries :find
                                         (lambda (entry)
                                           (js-call specifier :startsWith (aref entry 0)))))
                              (prefix (aref matched 0))
                              (directory (aref matched 1))
                              (suffix (js-call specifier :slice (js-length prefix)))
                              (target (resolve directory suffix))
                              (local (relative directory target)))
                         (when (or (eq (js-length suffix) 0)
                                   (isAbsolute local)
                                   (eq local "..")
                                   (js-call local :startsWith (str ".." sep)))
                           (let ((area (aref (js-call prefix :split "/") 1)))
                             (throw (new globalThis.Error
                                      (str "worker " area " import escapes package " area ": " specifier)))))
                         (js-object :namespace "file" :path target)))))))))

  (installPackageResolver)

  (defconst capabilities
    (Object/freeze
      (js-array
        "request"
        "progress"
        "cancel"
        "timeout"
        "shutdown"
        "module-cache"
        "module-version"
        "operation-capabilities-v1"
        "project-manifest"
        "portable-manifest"
        "runtime-resolution"
        "value-codec-v1"
        "value-chunks-v1")))

  (defconst maximumLineBytes (* 16 1024 1024))
  (defconst maximumValueChunkLineBytes (+ (get workerValueStreamLimits :maxChunkBytes) 4096))
  (defconst maximumValueStreamBytes (* 768 1024 1024))
  (defconst moduleCache (new globalThis.Map))
  (defconst pending (new globalThis.Map))
  (defconst protocolOutput (get globalThis.process :stdout))
  (defconst worker-state (js-object :shuttingDown false))

  (js-call (js-array "log" "info" "debug") :forEach
    (lambda (method)
      (put globalThis.console method
           (lambda (&rest values)
             (apply (get globalThis.console :error) values)))))

  (defun normalizeWorkerStackFile (file)
    (if (not (js-call file :startsWith "file:"))
        file
      (try
        (fileURLToPath file)
        (catch _error
          file))))

  (defun errorPayload (code message &optional error sourceMaps)
    (let ((payload (js-object :code code :message message)))
      (when (and (not (nullish? error)) (get error :name))
        (put payload :name (get error :name)))
      (when (and (not (nullish? error)) (get error :path))
        (put payload :path (get error :path)))
      (when (and (not (nullish? error)) (get error :stack))
        (put payload :stack (get error :stack))
        (let ((frames (mapSourceFrames
                        (parseJavaScriptStack (get error :stack)
                                              (js-object :normalizeFile normalizeWorkerStackFile))
                        (or sourceMaps (js-array)))))
          (when (> (js-length frames) 0)
            (put payload :frames frames)
            (put payload :location
                 (or (js-call frames :find (lambda (frame) (js-call (get frame :file) :endsWith ".eli")))
                     (aref frames 0))))))
      payload))

  (defun encodeMessage (message)
    (let ((encoded undefined))
      (try
        (setq encoded (JSON/stringify message))
        (catch error
          (setq encoded
                (JSON/stringify
                  (js-object
                    :version protocolVersion
                    :type "protocol-error"
                    :error (errorPayload
                             "serialization"
                             (str "worker could not serialize a protocol message: " (get error :message))
                             error))))))
      (str encoded "\n")))

  (defun writeMessage (message)
    (js-call protocolOutput :write (encodeMessage message)))

  (defasync writeMessageAsync (message)
    (unless (js-call protocolOutput :write (encodeMessage message))
      (await (once protocolOutput "drain"))))

  (defun jsonValue (value label)
    (let ((encoded undefined))
      (try
        (setq encoded (JSON/stringify value))
        (catch error
          (let ((wrapped (new globalThis.Error (str label " is not JSON-serializable: " (get error :message)))))
            (put wrapped :code "serialization")
            (throw wrapped))))
      (when (undefined? encoded)
        (let ((error (new globalThis.Error (str label " is not JSON-serializable"))))
          (put error :code "serialization")
          (throw error)))
      (JSON/parse encoded)))

  (defun requestError (id code message &optional error timing sourceMaps)
    (let ((response (js-object
                      :version protocolVersion
                      :type "response"
                      :id id
                      :ok false
                      :error (errorPayload code message error sourceMaps))))
      (when timing
        (put response :timing timing))
      (writeMessage response)))

  (defun protocolError (code message &rest __opt)
    (let* ((id (aref __opt 0))
           (response (js-object
                       :version protocolVersion
                       :type "protocol-error"
                       :error (errorPayload code message))))
      (when (not (undefined? id))
        (put response :id id))
      (writeMessage response)))

  (defun moduleUrl (identity)
    (let ((url undefined))
      (try
        (setq url (new globalThis.URL identity))
        (catch _error
          (setq url (pathToFileURL (resolve identity)))))
      (unless (eq (get url :protocol) "file:")
        (throw (new globalThis.Error (str "worker modules must use local file URLs: " identity))))
      (get url :href)))

  (defasync loadSourceMap (moduleUrl_)
    (try
      (let ((cleanUrl (new globalThis.URL moduleUrl_)))
        (put cleanUrl :search "")
        (put cleanUrl :hash "")
        (let* ((javascript (await (readFile (fileURLToPath cleanUrl) "utf8")))
               (match (js-call javascript :match source-map-url-pattern)))
          (if (or (not match) (js-call (aref match 1) :startsWith "data:"))
              undefined
            (let* ((mapUrl (new globalThis.URL (aref match 1) cleanUrl))
                   (map (JSON/parse (await (readFile (fileURLToPath mapUrl) "utf8")))))
              (if (or (not (eq (get map :version) 3))
                      (not (eq (value-type (get map :mappings)) "string"))
                      (not (Array/isArray (get map :sources))))
                  undefined
                (js-object
                  :generatedFile (resolve (await (realpath (fileURLToPath cleanUrl))))
                  :sources (js-call (get map :sources) :map
                             (lambda (source)
                               (let ((sourceUrl (new globalThis.URL source mapUrl)))
                                 (if (eq (get sourceUrl :protocol) "file:")
                                     (resolve (fileURLToPath sourceUrl))
                                   (get sourceUrl :href)))))
                  :lines (decodeSourceMappings (get map :mappings))))))))
      (catch error
        (js-call globalThis.console :error
          (str "could not load source map for " moduleUrl_ ": " (get error :message)))
        undefined)))

  (defasync moduleFingerprint (url)
    (let ((fileUrl (new globalThis.URL url)))
      (put fileUrl :search "")
      (put fileUrl :hash "")
      (let ((metadata (await (stat (fileURLToPath fileUrl) (js-object :bigint t)))))
        (str (get metadata :dev) ":" (get metadata :ino) ":"
             (get metadata :size) ":" (get metadata :mtimeNs)))))

  (defun projectManifestError (message)
    (let ((error (new globalThis.Error message)))
      (put error :code "invalid-project-manifest")
      error))

  (defun projectFile (root value label)
    (when (or (not (eq (value-type value) "string"))
              (eq (js-length value) 0)
              (isAbsolute value))
      (throw (projectManifestError (str label " must be a non-empty relative path"))))
    (let* ((path (resolve root value))
           (fromRoot (relative root path))
           (sep-str (if (eq (get globalThis.process :platform) "win32") "\\" "/")))
      (when (or (eq fromRoot "..")
                (js-call fromRoot :startsWith (str ".." sep-str))
                (isAbsolute fromRoot))
        (throw (projectManifestError (str label " escapes the project output directory"))))
      path))

  (defasync fileDigest (path)
    (js-call (js-call (createHash "sha256") :update (await (readFile path))) :digest "hex"))

  (defun textDigest (value)
    (js-call (js-call (createHash "sha256") :update value "utf8") :digest "hex"))

  (defasync readProjectManifest (identity entryUrl)
    (let ((url (moduleUrl identity))
          (path undefined))
      (try
        (setq path (await (realpath (fileURLToPath url))))
        (catch error
          (throw (projectManifestError (str "could not resolve project manifest: " (get error :message))))))
      (let ((root (dirname path))
            (manifest undefined))
        (try
          (setq manifest (JSON/parse (await (readFile path "utf8"))))
          (catch error
            (throw (projectManifestError (str "could not read project manifest: " (get error :message))))))
        (when (or (not (eq (get manifest :format) "eliscript-project"))
                  (and (not (eq (get manifest :version) 1))
                       (not (eq (get manifest :version) 2)))
                  (not (eq (value-type (get manifest :digest)) "string"))
                  (not (js-call hex-digest-pattern :test (get manifest :digest)))
                  (not (Array/isArray (get manifest :modules))))
          (throw (projectManifestError "project manifest has an unsupported shape")))
        (let ((manifestEntries (if (eq (get manifest :version) 1)
                                   (js-array (get manifest :entry))
                                 (get manifest :entries))))
          (when (or (not (Array/isArray manifestEntries))
                    (eq (js-length manifestEntries) 0)
                    (not (eq (get (new globalThis.Set manifestEntries) :size)
                             (js-length manifestEntries)))
                    (js-call (js-call (Array/from manifestEntries) :sort) :some
                      (lambda (entry index)
                        (not (eq entry (aref manifestEntries index))))))
            (throw (projectManifestError "project manifest entries have an unsupported shape")))
          (let ((entries (js-call manifestEntries :map
                           (lambda (entry index)
                             (projectFile root entry (str "manifest entry " index)))))
                (canonicalEntries undefined)
                (canonicalModule undefined))
            (try
              (let ((pair (await (Promise/all
                                   (js-array
                                     (Promise/all (js-call entries :map (lambda (entry) (realpath entry))))
                                     (realpath (fileURLToPath entryUrl)))))))
                (setq canonicalEntries (aref pair 0)
                      canonicalModule (aref pair 1)))
              (catch error
                (throw (projectManifestError (str "could not resolve project entry: " (get error :message))))))
            (unless (js-call canonicalEntries :includes canonicalModule)
              (throw (projectManifestError "project manifest entry does not match request module")))
            (let* ((identityModules (js-array))
                   (modules (js-call (get manifest :modules) :map
                              (lambda (mod index)
                                (when (or (nullish? mod)
                                          (not (eq (value-type mod) "object"))
                                          (not (eq (value-type (get mod :source)) "string"))
                                          (eq (js-length (get mod :source)) 0)
                                          (isAbsolute (get mod :source))
                                          (js-call (js-call (get mod :source) :split path-split-pattern) :includes "..")
                                          (not (js-call hex-digest-pattern :test (or (get mod :sourceDigest) "")))
                                          (not (js-call hex-digest-pattern :test (or (get mod :outputDigest) "")))
                                          (not (js-call hex-digest-pattern :test (or (get mod :sourceMapDigest) ""))))
                                  (throw (projectManifestError (str "manifest module " index " has an unsupported shape"))))
                                (js-call identityModules :push
                                  (js-object
                                    :source (get mod :source)
                                    :output (get mod :output)
                                    :sourceMap (get mod :sourceMap)
                                    :sourceDigest (get mod :sourceDigest)
                                    :outputDigest (get mod :outputDigest)
                                    :sourceMapDigest (get mod :sourceMapDigest)))
                                (js-object
                                  :output (projectFile root (get mod :output) (str "manifest module " index " output"))
                                  :sourceMap (projectFile root (get mod :sourceMap) (str "manifest module " index " source map"))
                                  :outputDigest (get mod :outputDigest)
                                  :sourceMapDigest (get mod :sourceMapDigest)))))
                   (declaredOutputs (new globalThis.Set
                                      (js-call identityModules :map (lambda (mod) (get mod :output))))))
              (when (js-call manifestEntries :some (lambda (entry) (not (js-call declaredOutputs :has entry))))
                (throw (projectManifestError "project manifest does not describe every entry artifact")))
              (let ((graphIdentity (if (eq (get manifest :version) 1)
                                       (js-object
                                         :format (get manifest :format)
                                         :version (get manifest :version)
                                         :entry (get manifest :entry)
                                         :modules identityModules)
                                     (js-object
                                       :format (get manifest :format)
                                       :version (get manifest :version)
                                       :entries (get manifest :entries)
                                       :modules identityModules))))
                (unless (eq (textDigest (JSON/stringify graphIdentity)) (get manifest :digest))
                  (throw (projectManifestError "project manifest graph digest does not match its records")))
                (js-object :digest (get manifest :digest) :modules modules))))))))

  (defasync loadProjectArtifacts (project)
    (let ((sourceMaps
            (await (Promise/all
                     (js-call (get project :modules) :map
                       (async (mod)
                         (let ((outputDigest undefined)
                               (sourceMapDigest undefined))
                           (try
                             (let ((pair (await (Promise/all
                                                  (js-array (fileDigest (get mod :output))
                                                            (fileDigest (get mod :sourceMap)))))))
                               (setq outputDigest (aref pair 0)
                                     sourceMapDigest (aref pair 1)))
                             (catch error
                               (throw (projectManifestError
                                        (str "could not verify generated module " (get mod :output) ": " (get error :message))))))
                           (when (or (not (eq outputDigest (get mod :outputDigest)))
                                     (not (eq sourceMapDigest (get mod :sourceMapDigest))))
                             (throw (projectManifestError
                                      (str "generated module does not match project manifest: " (get mod :output)))))
                           (await (loadSourceMap (get (pathToFileURL (get mod :output)) :href))))))))))
      (js-call sourceMaps :filter (lambda (item) (funcall globalThis.Boolean item)))))

  (defasync loadModule (identity requestedVersion projectManifest)
    (let* ((url (moduleUrl identity))
           (projectPromise (if (undefined? projectManifest)
                               (Promise/resolve undefined)
                             (readProjectManifest projectManifest url)))
           (discoveredProject (if (and (not (undefined? projectManifest))
                                       (undefined? requestedVersion))
                                  (await projectPromise)
                                undefined))
           (version (or (if discoveredProject (get discoveredProject :digest) undefined)
                        requestedVersion
                        (await (moduleFingerprint url))))
           (cacheKey (str url "\n" (if (undefined? projectManifest) "" (moduleUrl projectManifest))))
           (cached (js-call moduleCache :get cacheKey)))
      (if (and cached (eq (get cached :version) version))
          (let ((loaded (await (get cached :promise))))
            (Object/assign (js-object) loaded (js-object :cacheHit t :version version)))
        (progn
          (when cached
            (let ((error (new globalThis.Error
                           (str "module version changed from " (get cached :version)
                                " to " version "; restart the worker before loading it"))))
              (put error :code "module-version-changed")
              (throw error)))
          (let ((importUrl (new globalThis.URL url)))
            (js-call (get importUrl :searchParams) :set "__eliscript_worker_version" version)
            (let ((entry (js-object
                           :version version
                           :promise (funcall
                                      (async ()
                                        (let ((project (or discoveredProject (await projectPromise))))
                                          (when (and project (not (eq version (get project :digest))))
                                            (let ((error (new globalThis.Error
                                                           (str "requested module version " version
                                                                " does not match project manifest " (get project :digest)))))
                                              (put error :code "module-version-mismatch")
                                              (throw error)))
                                          (let ((pair (await (Promise/all
                                                               (js-array
                                                                 (dynamic-import (get importUrl :href))
                                                                 (if project
                                                                     (loadProjectArtifacts project)
                                                                   (js-call (loadSourceMap url) :then
                                                                     (lambda (sm) (if sm (js-array sm) (js-array))))))))))
                                            (js-object :module (aref pair 0) :sourceMaps (aref pair 1)))))))))
              (js-call moduleCache :set cacheKey entry)
              (try
                (let ((loaded (await (get entry :promise))))
                  (Object/assign (js-object) loaded (js-object :cacheHit false :version version)))
                (catch error
                  (when (eq (js-call moduleCache :get cacheKey) entry)
                    (js-call moduleCache :delete cacheKey))
                  (throw error)))))))))

  (defun validateRequest (message)
    (when (or (not (eq (value-type (get message :id)) "string"))
              (eq (js-length (get message :id)) 0))
      (throw (new globalThis.Error "request id must be a non-empty string")))
    (when (or (not (eq (value-type (get message :module)) "string"))
              (eq (js-length (get message :module)) 0))
      (throw (new globalThis.Error "request module must be a non-empty string")))
    (let ((hasExport (and (eq (value-type (get message :export)) "string")
                          (> (js-length (get message :export)) 0)))
          (hasOperation (and (eq (value-type (get message :operation)) "string")
                             (> (js-length (get message :operation)) 0))))
      (when (eq hasExport hasOperation)
        (throw (new globalThis.Error
                 "request must contain exactly one non-empty export or operation"))))
    (let ((usesValueChunks (eq (get message :valueFraming) workerValueFraming)))
      (when (and (not (undefined? (get message :valueFraming))) (not usesValueChunks))
        (throw (new globalThis.Error (str "request valueFraming must be " workerValueFraming))))
      (if usesValueChunks
          (progn
            (unless (eq (get message :valueEncoding) workerValueEncoding)
              (throw (new globalThis.Error
                       (str "chunked requests require valueEncoding " workerValueEncoding))))
            (unless (undefined? (get message :arguments))
              (throw (new globalThis.Error
                       "chunked requests must stream arguments after the request header"))))
        (unless (Array/isArray (get message :arguments))
          (throw (new globalThis.Error "request arguments must be an array")))))
    (when (and (not (undefined? (get message :valueEncoding)))
               (not (eq (get message :valueEncoding) workerValueEncoding)))
      (throw (new globalThis.Error (str "request valueEncoding must be " workerValueEncoding))))
    (when (and (not (undefined? (get message :moduleVersion)))
               (or (not (eq (value-type (get message :moduleVersion)) "string"))
                   (eq (js-length (get message :moduleVersion)) 0)
                   (> (js-length (get message :moduleVersion)) 512)))
      (throw (new globalThis.Error
               "request moduleVersion must be a non-empty string up to 512 characters")))
    (when (and (not (undefined? (get message :projectManifest)))
               (or (not (eq (value-type (get message :projectManifest)) "string"))
                   (eq (js-length (get message :projectManifest)) 0)))
      (throw (new globalThis.Error "request projectManifest must be a non-empty string")))
    (when (and (not (undefined? (get message :timeoutMs)))
               (or (not (Number/isInteger (get message :timeoutMs)))
                   (<= (get message :timeoutMs) 0)
                   (> (get message :timeoutMs) 2147483647)))
      (throw (new globalThis.Error "request timeoutMs must be a positive 32-bit integer"))))

  (defun closeEntry (id entry)
    (when (not (undefined? (get entry :timer)))
      (globalThis.clearTimeout (get entry :timer)))
    (when (eq (js-call pending :get id) entry)
      (js-call pending :delete id)))

  (defun receivingError (entry code message &optional error)
    (requestError (get (get entry :message) :id) code message error)
    (closeEntry (get (get entry :message) :id) entry))

  (defun createEntry (message phase)
    (let ((entry (js-object
                   :controller (new globalThis.AbortController)
                   :abortCode "cancelled"
                   :timer undefined
                   :phase phase
                   :message message
                   :startedAt (js-call globalThis.performance :now)
                   :progressIndex 0
                   :progressQueue (Promise/resolve)
                   :progressError undefined)))
      (js-call pending :set (get message :id) entry)
      (when (not (undefined? (get message :timeoutMs)))
        (put entry :timer
             (globalThis.setTimeout
               (lambda ()
                 (put entry :abortCode "timeout")
                 (js-call (get entry :controller) :abort)
                 (when (eq (get entry :phase) "receiving")
                   (let ((error (new globalThis.Error "request timed out while receiving value chunks")))
                     (put error :code "timeout")
                     (receivingError entry "timeout" (get error :message) error))))
               (get message :timeoutMs))))
      entry))

  (defun abortPromise (entry)
    (new globalThis.Promise
      (lambda (_resolve reject)
        (js-call (get (get entry :controller) :signal) :addEventListener "abort"
          (lambda ()
            (let ((error (new globalThis.Error
                           (if (eq (get entry :abortCode) "timeout")
                               "request timed out"
                             "request cancelled"))))
              (put error :code (get entry :abortCode))
              (funcall reject error)))
          (js-object :once t)))))

  (defasync writeValueStream (options)
    (let* ((id (get options :id))
           (channel (get options :channel))
           (stream (get options :stream))
           (value (get options :value))
           (signal (get options :signal))
           (finalFields (get options :finalFields))
           (chunks (encodeWorkerValueChunks value (js-object :signal signal)))
           (iterator (js-call (aref chunks async-iterator-symbol) :call chunks))
           (sequence 0)
           (current (await (js-call iterator :next))))
      (when (funcall globalThis.Boolean (get current :done))
        (throw (new globalThis.Error "value stream encoder produced no events")))
      (while (not (funcall globalThis.Boolean (get current :done)))
        (let* ((next (await (js-call iterator :next)))
               (final (funcall globalThis.Boolean (get next :done)))
               (message (js-object
                          :version protocolVersion
                          :type "value-chunk"
                          :id id
                          :channel channel
                          :sequence sequence
                          :final final
                          :valueEncoding workerValueEncoding
                          :valueFraming workerValueFraming
                          :events (get current :value))))
          (when (not (undefined? stream))
            (put message :stream stream))
          (when (and final finalFields)
            (Object/assign message
              (funcall finalFields (js-object :sequence sequence :chunkCount (1+ sequence)))))
          (await (writeMessageAsync message))
          (setq current next
                sequence (1+ sequence))))))

  (defun queueProgress (entry value)
    (let* ((next-index (1+ (get entry :progressIndex)))
           (stream (funcall globalThis.String next-index)))
      (put entry :progressIndex next-index)
      (let ((task (js-call (get entry :progressQueue) :then
                    (lambda ()
                      (writeValueStream
                        (js-object
                          :id (get (get entry :message) :id)
                          :channel "progress"
                          :stream stream
                          :value value
                          :signal (get (get entry :controller) :signal)))))))
        (put entry :progressQueue
             (js-call task :catch
               (lambda (error)
                 (when (undefined? (get entry :progressError))
                   (put entry :progressError error)))))
        task)))

  (defasync executeRequest (message entry &rest __opt)
    (let ((streamedArguments (aref __opt 0))
          (startedAt (get entry :startedAt))
          (moduleLoadMs 0)
          (executionMs 0)
          (serializationMs 0)
          (moduleCacheHit false)
          (moduleVersion undefined)
          (sourceMaps (js-array))
          (executionStartedAt undefined))
      (put entry :phase "executing")
      (try
        (let* ((moduleLoadStartedAt (js-call globalThis.performance :now))
               (loaded (await (loadModule (get message :module)
                                          (get message :moduleVersion)
                                          (get message :projectManifest))))
               (mod (get loaded :module)))
          (setq sourceMaps (get loaded :sourceMaps)
                moduleCacheHit (get loaded :cacheHit)
                moduleVersion (get loaded :version)
                moduleLoadMs (- (js-call globalThis.performance :now) moduleLoadStartedAt))
          (let* ((manifest (get mod :__eliscript_portable__))
                 (operation (if (undefined? (get message :operation))
                                (aref mod (get message :export))
                              (if (and manifest (Object/hasOwn manifest (get message :operation)))
                                  (aref manifest (get message :operation))
                                undefined))))
            (unless (eq (value-type operation) "function")
              (let* ((operationName (or (get message :operation) (get message :export)))
                     (error (new globalThis.Error
                              (if (undefined? (get message :operation))
                                  (str "module does not export a function named " operationName)
                                (str "module does not declare a portable function named " operationName)))))
                (put error :code (if (undefined? (get message :operation)) "missing-export" "missing-portable"))
                (throw error)))
            (let* ((usesValueCodec (eq (get message :valueEncoding) workerValueEncoding))
                   (usesValueChunks (eq (get message :valueFraming) workerValueFraming))
                   (arguments_ (if (not (undefined? streamedArguments))
                                   streamedArguments
                                 (if usesValueCodec
                                     (decodeWorkerValues (get message :arguments))
                                   (get message :arguments))))
                   (progress (lambda (value)
                               (if (get (get (get entry :controller) :signal) :aborted)
                                   undefined
                                 (if usesValueChunks
                                     (queueProgress entry value)
                                   (let ((response (js-object
                                                     :version protocolVersion
                                                     :type "progress"
                                                     :id (get message :id)
                                                     :value (if usesValueCodec
                                                                (encodeWorkerValue value)
                                                              (jsonValue value "progress value")))))
                                     (when usesValueCodec
                                       (put response :valueEncoding workerValueEncoding))
                                     (writeMessage response))))))
                   (context (Object/freeze
                              (js-object
                                :signal (get (get entry :controller) :signal)
                                :progress progress
                                :capabilities (workerCapabilities
                                                (js-object :signal (get (get entry :controller) :signal)
                                                           :progress progress)
                                                (js-array "cancellation" "progress"))))))
              (setq executionStartedAt (js-call globalThis.performance :now))
              (let* ((call-args (js-call (Array/from arguments_) :concat (js-array context)))
                     (operationPromise (Promise/resolve (apply operation call-args)))
                     (value (await (Promise/race (js-array operationPromise (abortPromise entry))))))
                (setq executionMs (- (js-call globalThis.performance :now) executionStartedAt))
                (await (get entry :progressQueue))
                (when (not (undefined? (get entry :progressError)))
                  (throw (get entry :progressError)))
                (let ((serializationStartedAt (js-call globalThis.performance :now)))
                  (if usesValueChunks
                      (await (writeValueStream
                               (js-object
                                 :id (get message :id)
                                 :channel "response"
                                 :value value
                                 :signal (get (get entry :controller) :signal)
                                 :finalFields
                                 (lambda (info)
                                   (setq serializationMs (- (js-call globalThis.performance :now) serializationStartedAt))
                                   (js-object
                                     :timing
                                     (js-object
                                       :moduleLoadMs moduleLoadMs
                                       :moduleCacheHit moduleCacheHit
                                       :moduleVersion moduleVersion
                                       :sourceMapLoaded (> (js-length sourceMaps) 0)
                                       :sourceMapCount (js-length sourceMaps)
                                       :executionMs executionMs
                                       :serializationMs serializationMs
                                       :workerMs (- (js-call globalThis.performance :now) startedAt)
                                       :valueStream
                                       (js-object
                                         :framing workerValueFraming
                                         :argumentChunks (get entry :sequence)
                                         :responseChunks (get info :chunkCount)
                                         :maxChunkBytes (get workerValueStreamLimits :maxChunkBytes)
                                         :maxEventsPerChunk (get workerValueStreamLimits :maxEventsPerChunk)
                                         :maxTextPartUnits (get workerValueStreamLimits :maxTextPartUnits))))))))
                    (let ((serializedValue (if usesValueCodec
                                               (encodeWorkerValue value)
                                             (jsonValue value "response value"))))
                      (setq serializationMs (- (js-call globalThis.performance :now) serializationStartedAt))
                      (let ((response (js-object
                                        :version protocolVersion
                                        :type "response"
                                        :id (get message :id)
                                        :ok t
                                        :value serializedValue
                                        :timing (js-object
                                                  :moduleLoadMs moduleLoadMs
                                                  :moduleCacheHit moduleCacheHit
                                                  :moduleVersion moduleVersion
                                                  :sourceMapLoaded (> (js-length sourceMaps) 0)
                                                  :sourceMapCount (js-length sourceMaps)
                                                  :executionMs executionMs
                                                  :serializationMs serializationMs
                                                  :workerMs (- (js-call globalThis.performance :now) startedAt)))))
                        (when usesValueCodec
                          (put response :valueEncoding workerValueEncoding))
                        (writeMessage response)))))))))
        (catch error
          (when (and (not (undefined? executionStartedAt)) (eq executionMs 0))
            (setq executionMs (- (js-call globalThis.performance :now) executionStartedAt)))
          (let ((code (if (get (get (get entry :controller) :signal) :aborted)
                          (get entry :abortCode)
                        (or (get error :code) "runtime"))))
            (requestError
              (get message :id)
              code
              (get error :message)
              error
              (js-object
                :moduleLoadMs moduleLoadMs
                :moduleCacheHit moduleCacheHit
                :moduleVersion moduleVersion
                :sourceMapLoaded (> (js-length sourceMaps) 0)
                :sourceMapCount (js-length sourceMaps)
                :executionMs executionMs
                :serializationMs serializationMs
                :workerMs (- (js-call globalThis.performance :now) startedAt))
              sourceMaps)))
        (finally
          (closeEntry (get message :id) entry)))))

  (defun valueAck (id sequence &rest __opt)
    (let ((final (aref __opt 0)))
      (writeMessage
        (js-object
          :version protocolVersion
          :type "value-ack"
          :id id
          :channel "arguments"
          :sequence sequence
          :final (if (undefined? final) false final)
          :valueEncoding workerValueEncoding
          :valueFraming workerValueFraming))))

  (defun startRequest (message)
    (validateRequest message)
    (when (js-call pending :has (get message :id))
      (throw (new globalThis.Error (str "request id is already pending: " (get message :id)))))
    (if (eq (get message :valueFraming) workerValueFraming)
        (let ((entry (createEntry message "receiving")))
          (put entry :decoder
               (new WorkerValueStreamDecoder
                 (js-object :signal (get (get entry :controller) :signal))))
          (put entry :sequence 0)
          (put entry :framedBytes 0)
          (valueAck (get message :id) -1))
      (let ((entry (createEntry message "executing")))
        (executeRequest message entry))))

  (defun receiveValueChunk (message lineBytes)
    (if (or (not (eq (value-type (get message :id)) "string"))
            (eq (js-length (get message :id)) 0))
        (protocolError "invalid-message" "value chunk id must be a non-empty string")
      (let ((entry (js-call pending :get (get message :id))))
        (if (or (not entry) (not (eq (get entry :phase) "receiving")))
            (protocolError
              "invalid-message"
              (str "no request is receiving value chunks for id " (get message :id))
              (get message :id))
          (try
            (when (> lineBytes maximumValueChunkLineBytes)
              (throw (new globalThis.Error
                       (str "value chunk exceeds " maximumValueChunkLineBytes " framed bytes"))))
            (unless (eq (get message :channel) "arguments")
              (throw (new globalThis.Error "incoming value chunk channel must be arguments")))
            (unless (and (eq (get message :valueEncoding) workerValueEncoding)
                         (eq (get message :valueFraming) workerValueFraming))
              (throw (new globalThis.Error "incoming value chunk encoding or framing mismatch")))
            (unless (and (Number/isSafeInteger (get message :sequence))
                         (>= (get message :sequence) 0)
                         (eq (get message :sequence) (get entry :sequence)))
              (throw (new globalThis.Error
                       (str "value chunk sequence " (funcall globalThis.String (get message :sequence))
                            " does not match " (get entry :sequence)))))
            (unless (eq (value-type (get message :final)) "boolean")
              (throw (new globalThis.Error "value chunk final must be a boolean")))
            (unless (Array/isArray (get message :events))
              (throw (new globalThis.Error "value chunk events must be an array")))
            (put entry :framedBytes (+ (get entry :framedBytes) lineBytes))
            (when (> (get entry :framedBytes) maximumValueStreamBytes)
              (throw (new globalThis.Error
                       (str "value stream exceeds " maximumValueStreamBytes " framed bytes"))))
            (js-call (get entry :decoder) :write (get message :events))
            (let ((sequence (get entry :sequence)))
              (put entry :sequence (1+ sequence))
              (if (not (get message :final))
                  (valueAck (get message :id) sequence)
                (let ((arguments_ (js-call (get entry :decoder) :finish)))
                  (unless (Array/isArray arguments_)
                    (throw (new globalThis.Error "chunked request root must decode to an argument array")))
                  (put entry :decoder undefined)
                  (put entry :phase "executing")
                  (valueAck (get message :id) sequence t)
                  (executeRequest (get entry :message) entry arguments_))))
            (catch error
              (js-call (get entry :controller) :abort)
              (receivingError entry
                (or (get error :code) "invalid-value-chunk")
                (get error :message)
                error)))))))

  (defun cancelRequest (message)
    (if (or (not (eq (value-type (get message :id)) "string"))
            (eq (js-length (get message :id)) 0))
        (protocolError "invalid-message" "cancel id must be a non-empty string")
      (let* ((entry (js-call pending :get (get message :id)))
             (accepted (funcall globalThis.Boolean entry)))
        (when entry
          (put entry :abortCode "cancelled")
          (js-call (get entry :controller) :abort))
        (writeMessage
          (js-object
            :version protocolVersion
            :type "cancel"
            :id (get message :id)
            :accepted accepted))
        (when (and entry (eq (get entry :phase) "receiving"))
          (let ((error (new globalThis.Error "request cancelled while receiving value chunks")))
            (put error :code "cancelled")
            (receivingError entry "cancelled" (get error :message) error))))))

  (defun shutdown (lines)
    (put worker-state :shuttingDown t)
    (js-call (Array/from (js-call pending :values)) :forEach
      (lambda (entry)
        (put entry :abortCode "shutdown")
        (js-call (get entry :controller) :abort)))
    (writeMessage
      (js-object
        :version protocolVersion
        :type "shutdown"
        :ok t))
    (js-call lines :close)
    (globalThis.setTimeout (lambda () (js-call globalThis.process :exit 0)) 0))

  (defun handleMessage (message lines lineBytes)
    (if (or (nullish? message)
            (not (eq (value-type message) "object"))
            (Array/isArray message))
        (protocolError "invalid-message" "protocol message must be an object")
      (if (not (eq (get message :version) protocolVersion))
          (protocolError
            "version-mismatch"
            (str "worker protocol version " protocolVersion " required")
            (get message :id))
        (let ((type (get message :type)))
          (cond
            ((eq type "request")
             (try
               (startRequest message)
               (catch error
                 (requestError (get message :id) "invalid-request" (get error :message) error))))
            ((eq type "value-chunk")
             (receiveValueChunk message lineBytes))
            ((eq type "cancel")
             (cancelRequest message))
            ((eq type "shutdown")
             (shutdown lines))
            (t
             (protocolError
               "invalid-message"
               (str "unknown protocol message type: " type)
               (get message :id))))))))

  (defasync runWorker ()
    (let ((lines (createInterface
                   (js-object :input (get globalThis.process :stdin)
                              :crlfDelay globalThis.Infinity))))
      (writeMessage
        (js-object
          :version protocolVersion
          :type "ready"
          :capabilities capabilities
          :pid (get globalThis.process :pid)))
      (js-call lines :on "close"
        (lambda ()
          (unless (get worker-state :shuttingDown)
            (js-call (Array/from (js-call pending :values)) :forEach
              (lambda (entry)
                (put entry :abortCode "shutdown")
                (js-call (get entry :controller) :abort))))))
      (let ((iterator (js-call (aref lines async-iterator-symbol) :call lines))
            (done false))
        (while (not done)
          (let ((step (await (js-call iterator :next))))
            (if (funcall globalThis.Boolean (get step :done))
                (setq done t)
              (let* ((line (get step :value))
                     (lineBytes (js-call globalThis.Buffer :byteLength line "utf8")))
                (if (> lineBytes maximumLineBytes)
                    (protocolError "line-too-large" "protocol line exceeds 16 MiB")
                  (when (> (js-length (js-call line :trim)) 0)
                    (try
                      (handleMessage (JSON/parse line) lines lineBytes)
                      (catch error
                        (protocolError "invalid-json" (str "invalid JSON: " (get error :message))))))))))))))

  (when (js* "import.meta.main")
    (js-call (runWorker) :catch
      (lambda (error)
        (js-call globalThis.console :error (or (get error :stack) (get error :message)))
        (put globalThis.process :exitCode 1))))

  (export protocolVersion capabilities loadSourceMap runWorker))
