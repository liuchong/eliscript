(module eliscript.runtime.number-radix
  ;; Internal JS target support. Match the managed runtime's exact radix
  ;; intervals instead of depending on an engine's nondecimal Number spelling.
  (defconst apply-fn Reflect/apply)
  (defconst valueOf (get (get globalThis.Number :prototype) :valueOf))
  (defconst numberStringBuiltin (get (get globalThis.Number :prototype) :toString))
  (defconst NumberClass globalThis.Number)
  (defconst create Object/create)
  (defconst integer globalThis.BigInt)
  (defconst View globalThis.DataView)
  (defconst Storage globalThis.ArrayBuffer)
  (defconst setFloat (get (get globalThis.DataView :prototype) :setFloat64))
  (defconst getWord (get (get globalThis.DataView :prototype) :getUint32))
  (defconst RangeErrorClass globalThis.RangeError)
  (defconst alphabet "0123456789abcdefghijklmnopqrstuvwxyz")
  (defconst big-zero (js* "0n"))
  (defconst big-one (js* "1n"))
  (defconst big-two (js* "2n"))
  (defconst big-four (js* "4n"))
  (defconst big-32 (js* "32n"))
  (defconst big-52 (js* "52n"))

  (defun to-number-unary (argument)
    (js* "+argument"))

  (defun integerText (value radix)
    (let ((base (funcall integer radix))
          (number (funcall integer value))
          (text "")
          (first t))
      (when (< number big-zero)
        (setq number (- number)))
      (while (or first (not (eq number big-zero)))
        (setq first false)
        (let ((digit (% number base)))
          (setq text (+ (aref alphabet (funcall NumberClass digit)) text)
                number (/ number base))))
      (if (< value 0) (+ "-" text) text)))

  (defun positionalText (value radix)
    (let ((view (new View (new Storage 8))))
      (funcall apply-fn setFloat view (js-array 0 value false))
      (let* ((high (funcall apply-fn getWord view (js-array 0 false)))
             (low (funcall apply-fn getWord view (js-array 4 false)))
             (exponent (bit-and (unsigned-bit-shift-right high 20) 2047))
             (fraction (bit-and high 1048575))
             (negative (unsigned-bit-shift-right high 31))
             (a (bit-or (bit-shift-left (funcall integer fraction) big-32)
                        (funcall integer low)))
             (b big-four)
             (below (if (and (> exponent 1) (eq fraction 0) (eq low 0)) big-one big-two))
             (above big-two))
        (when (not (eq exponent 0))
          (setq a (- a (- (bit-shift-left big-one big-52)))))
        (setq a (bit-shift-left a big-two))
        (if (>= exponent 1075)
            (let ((shift (funcall integer (- exponent 1075))))
              (setq a (bit-shift-left a shift)
                    below (bit-shift-left below shift)
                    above (bit-shift-left above shift)))
          (setq b (bit-shift-left b (funcall integer (if (eq exponent 0) 1074 (- 1075 exponent))))))
        (let ((base (funcall integer radix))
              (digits (funcall create nil))
              (length 0)
              (decimal 0)
              (parity 0)
              (norm-done false)
              (loop-done false))
          (if (< a b)
              (while (and (< a b) (not norm-done))
                (if (and (> (* a big-two) b) (> (- a (- above)) b))
                    (setq norm-done t)
                  (setq a (* a base)
                        below (* below base)
                        above (* above base)
                        decimal (1- decimal))))
            (while (>= a (* b base))
              (setq b (* b base)
                    decimal (1+ decimal))))
          (while (not loop-done)
            (let ((digit (funcall NumberClass (/ a b))))
              (setq a (% a b))
              (let ((lower (< a below))
                    (upper (> (- a (- above)) b)))
                (put digits length digit)
                (setq length (1+ length)
                      parity (bit-and (+ (* parity (bit-and radix 1)) digit) 1))
                (let* ((twice (* a big-two))
                       (nearest (or (> twice b) (and (eq twice b) (eq parity 1)))))
                  (if (or (and nearest upper) (and (not nearest) lower))
                      (progn
                        (when nearest
                          (let ((index length)
                                (carry t))
                            (while (and (> index 0) carry)
                              (setq index (1- index))
                              (let ((next (1+ (aref digits index))))
                                (if (eq next radix)
                                    (put digits index 0)
                                  (progn
                                    (put digits index next)
                                    (setq carry false)))))
                            (when carry
                              (put digits 0 1)
                              (setq decimal (1+ decimal)))))
                        (setq loop-done t))
                    (progn
                      (when (>= length 64)
                        (throw (new RangeErrorClass "number radix formatting did not converge")))
                      (setq a (* a base)
                            below (* below base)
                            above (* above base))))))))
          (while (and (> length 1) (eq (aref digits (1- length)) 0))
            (setq length (1- length)))
          (let ((text ""))
            (if (< decimal 0)
                (let ((index 0))
                  (setq text "0.")
                  (while (< index (- -1 decimal))
                    (setq text (+ text "0")
                          index (1+ index)))
                  (setq index 0)
                  (while (< index length)
                    (setq text (+ text (aref alphabet (aref digits index)))
                          index (1+ index))))
              (let* ((places (1+ decimal))
                     (count (if (> places length) places length))
                     (index 0))
                (while (< index count)
                  (when (and (eq index places) (< places length))
                    (setq text (+ text ".")))
                  (setq text (+ text (if (< index length)
                                         (aref alphabet (aref digits index))
                                       "0"))
                        index (1+ index)))))
            (if (not (eq negative 0)) (+ "-" text) text))))))

  (defun numberRadixText (receiver argument)
    (let ((value undefined)
          (failed false))
      (try
        (setq value (funcall apply-fn valueOf receiver (js-array)))
        (catch _error
          (setq failed t)))
      (if failed
          (funcall apply-fn numberStringBuiltin receiver (js-array argument))
        (let ((radix 10)
              (invalid-radix false))
          (when (not (undefined? argument))
            (let ((converted (to-number-unary argument)))
              (setq radix (if (not (eq converted converted))
                              0
                            (- converted (% converted 1))))
              (when (or (< radix 2) (> radix 36) (not (eq radix radix)))
                (setq invalid-radix t))))
          (if invalid-radix
              (funcall apply-fn numberStringBuiltin value (js-array radix))
            (if (or (eq radix 10)
                    (eq value 0)
                    (not (eq value value))
                    (eq value globalThis.Infinity)
                    (eq value (- globalThis.Infinity)))
                (funcall apply-fn numberStringBuiltin value (js-array 10))
              (if (eq (% value 1) 0)
                  (integerText value radix)
                (positionalText value radix))))))))

  (export numberStringBuiltin numberRadixText))
