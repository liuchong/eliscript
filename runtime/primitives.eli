(module eliscript.runtime.primitives
  ;; Host instructions remain small explicit interoperability boundaries.
  ;; Conversion order, validation, loops and identity allocation are Eli.
  (defun host-typeof (value) (js* "typeof value"))
  (defun host-truthy (value) (js* "!!value"))
  (defun host-add (left right) (js* "left + right"))
  (defun host-sub (left right) (js* "left - right"))
  (defun host-mul (left right) (js* "left * right"))
  (defun host-div (left right) (js* "left / right"))
  (defun host-rem (left right) (js* "left % right"))
  (defun host-and (left right) (js* "left & right"))
  (defun host-or (left right) (js* "left | right"))
  (defun host-xor (left right) (js* "left ^ right"))
  (defun host-shl (left right) (js* "left << right"))
  (defun host-shr (left right) (js* "left >> right"))
  (defun host-ushr (left right) (js* "left >>> right"))
  (defun host-neg (value) (js* "-value"))
  (defun host-not (value) (js* "~value"))
  (defun host-plus (value) (js* "+value"))
  (defun host-less (left right) (js* "left < right"))
  (defun host-less-equal (left right) (js* "left <= right"))
  (defun host-greater (left right) (js* "left > right"))
  (defun host-greater-equal (left right) (js* "left >= right"))
  (defconst number-intrinsic (js* "globalThis.Number"))
  (defconst bigint-intrinsic (js* "globalThis.BigInt"))
  (defconst numeric-apply (js* "globalThis.Reflect.apply"))
  (defconst numeric-symbol (js* "globalThis.Symbol.toPrimitive"))
  (defconst numeric-error (js* "globalThis.TypeError"))
  (defconst numeric-trim (js* "globalThis.String.prototype.trim"))
  (defconst numeric-slice (js* "globalThis.String.prototype.slice"))
  (defconst numeric-exec (js* "globalThis.RegExp.prototype.exec"))
  (defconst imul-intrinsic (get (get (js* "globalThis") :Math) :imul))
  (defconst numeric-radix (js* "/^(?:0[xX][0-9a-fA-F]+|0[oO][0-7]+|0[bB][01]+)$/"))
  (defconst host-map-get (js* "(map, key) => map.get(key)"))
  (defconst host-map-set (js* "(map, key, value) => map.set(key, value)"))
  (defconst host-descriptor (js* "(value, key) => Object.getOwnPropertyDescriptor(value, key)"))
  (defconst host-own (js* "(value, key) => Object.prototype.hasOwnProperty.call(value, key)"))
  (defconst host-symbol-for (js* "(key) => Symbol.for(key)"))

  (defun numericObject (value)
    (let ((type (funcall host-typeof value)))
      (and (not (eq value nil))
        (or (= type "object") (= type "function")
          (and (= type "undefined") (not (eq value undefined)))))))

  (defun numericPrimitive (value)
    (if (not (numericObject value)) value
      (let ((exotic (aref value numeric-symbol)))
        (if (and (not (eq exotic undefined)) (not (eq exotic nil)))
          (let ((result (funcall numeric-apply exotic value (js-array "number"))))
            (if (not (numericObject result)) result
              (throw (new numeric-error "Cannot convert object to primitive value"))))
          (let ((index 0) (done false) (result undefined))
            (while (and (funcall host-less index 2) (not done))
              (let* ((method (aref value (if (= index 0) "valueOf" "toString")))
                     (type (funcall host-typeof method)))
                (when (or (= type "function") (and (= type "undefined") (not (eq method undefined))))
                  (setq result (funcall numeric-apply method value (js-array)))
                  (unless (numericObject result) (setq done t))))
              (setq index (funcall host-add index 1)))
            (unless done (throw (new numeric-error "Cannot convert object to primitive value")))
            result)))))

  (defun toNumber (value)
    (let ((primitive (numericPrimitive value)))
      (if (not (= (funcall host-typeof primitive) "string")) (funcall number-intrinsic primitive)
        (let ((text (funcall numeric-apply numeric-trim primitive (js-array))))
          (if (eq (funcall numeric-apply numeric-exec numeric-radix (js-array text)) nil)
            (funcall number-intrinsic primitive)
            (let ((first 2) (text-length (get text :length)))
              (while (and (funcall host-less first text-length) (= (aref text first) "0"))
                (setq first (funcall host-add first 1)))
              (if (= first text-length) 0
                (let* ((prefix (aref text 1))
                       (limit (if (or (= prefix "x") (= prefix "X")) 256
                                (if (or (= prefix "b") (= prefix "B")) 1024 342))))
                  (if (funcall host-greater (funcall host-sub text-length first) limit)
                    (funcall host-div 1 0)
                    (let ((token (funcall host-add
                            (funcall numeric-apply numeric-slice text (js-array 0 2))
                            (funcall numeric-apply numeric-slice text (js-array first)))))
                      (funcall number-intrinsic (funcall bigint-intrinsic token))))))))))))

  (defun numeric (value)
    (let ((type (funcall host-typeof value)))
      (if (or (= type "number") (= type "bigint")) value
        (let* ((primitive (numericPrimitive value)) (kind (funcall host-typeof primitive)))
          (if (or (= kind "number") (= kind "bigint")) primitive
            (if (= kind "string") (toNumber primitive) (funcall host-plus primitive)))))))

  (defun implicitNumber (value)
    (if (= (funcall host-typeof value) "number") value
      (let ((primitive (numericPrimitive value)))
        (when (= (funcall host-typeof primitive) "bigint")
          (throw (new numeric-error "Cannot convert a BigInt value to a number")))
        (if (= (funcall host-typeof primitive) "string") (toNumber primitive) (funcall host-plus primitive)))))

  (defun numericDecrement (value) (funcall host-sub (implicitNumber value) 1))
  (defun numericSub (a b)
    (if (and (= (funcall host-typeof a) "number") (= (funcall host-typeof b) "number"))
      (funcall host-sub a b) (funcall host-sub (numeric a) (numeric b))))
  (defun numericMul (a b)
    (if (and (= (funcall host-typeof a) "number") (= (funcall host-typeof b) "number"))
      (funcall host-mul a b) (funcall host-mul (numeric a) (numeric b))))
  (defun numericDiv (a b)
    (if (and (= (funcall host-typeof a) "number") (= (funcall host-typeof b) "number"))
      (funcall host-div a b) (funcall host-div (numeric a) (numeric b))))
  (defun numericRem (a b)
    (if (and (= (funcall host-typeof a) "number") (= (funcall host-typeof b) "number"))
      (funcall host-rem a b) (funcall host-rem (numeric a) (numeric b))))
  (defun numericAnd (a b)
    (if (and (= (funcall host-typeof a) "number") (= (funcall host-typeof b) "number"))
      (funcall host-and a b) (funcall host-and (numeric a) (numeric b))))
  (defun numericOr (a b)
    (if (and (= (funcall host-typeof a) "number") (= (funcall host-typeof b) "number"))
      (funcall host-or a b) (funcall host-or (numeric a) (numeric b))))
  (defun numericXor (a b)
    (if (and (= (funcall host-typeof a) "number") (= (funcall host-typeof b) "number"))
      (funcall host-xor a b) (funcall host-xor (numeric a) (numeric b))))
  (defun numericShl (a b)
    (if (and (= (funcall host-typeof a) "number") (= (funcall host-typeof b) "number"))
      (funcall host-shl a b) (funcall host-shl (numeric a) (numeric b))))
  (defun numericShr (a b)
    (if (and (= (funcall host-typeof a) "number") (= (funcall host-typeof b) "number"))
      (funcall host-shr a b) (funcall host-shr (numeric a) (numeric b))))
  (defun numericUshr (a b)
    (if (and (= (funcall host-typeof a) "number") (= (funcall host-typeof b) "number"))
      (funcall host-ushr a b) (funcall host-ushr (numeric a) (numeric b))))
  (defun numericNeg (a) (funcall host-neg (numeric a)))
  (defun numericInt32 (a) (funcall host-or (numeric a) 0))
  (defun numericUint32 (a) (funcall host-ushr (numeric a) 0))
  (defun numericNot (a) (funcall host-not (numeric a)))
  (defun numericImul (a b) (funcall imul-intrinsic (implicitNumber a) (implicitNumber b)))

  (defun numericCompare (operator a b)
    (cond ((= operator "<") (funcall host-less a b))
          ((= operator "<=") (funcall host-less-equal a b))
          ((= operator ">") (funcall host-greater a b))
          (t (funcall host-greater-equal a b))))
  (defun numericRelation (operator left right)
    (if (and (= (funcall host-typeof left) "number") (= (funcall host-typeof right) "number"))
      (numericCompare operator left right)
      (let* ((a (numericPrimitive left)) (b (numericPrimitive right))
           (x (funcall host-typeof a)) (y (funcall host-typeof b)))
      (unless (or (and (= x "string") (= y "string"))
                  (and (= x "bigint") (= y "string"))
                  (and (= x "string") (= y "bigint")))
        (setq a (numeric a)) (setq b (numeric b)))
        (numericCompare operator a b))))

  (defun valueType (value)
    (let ((type (funcall host-typeof value)))
      (if (eq value nil) "null"
        (if (and (not (= type "object")) (not (= type "function"))) type
          (try
            (let ((brand (funcall host-descriptor value (funcall host-symbol-for "eliscript.value.type"))))
              (if (and (funcall host-truthy brand) (funcall host-own brand "value")
                       (or (= (get brand :value) "keyword") (= (get brand :value) "symbol")))
                (get brand :value)
                (let ((kind (funcall host-descriptor value "kind")))
                  (if (and (funcall host-truthy kind) (funcall host-own kind "value"))
                    (cond ((= (get kind :value) "eliscript/keyword") "keyword")
                          ((= (get kind :value) "eliscript/symbol") "symbol") (t type))
                    type))))
            (catch ignored type))))))

  (defun stringToBigint (text)
    (try (funcall globalThis.BigInt text) (catch ignored nil)))

  (defun float64Words (number)
    (let ((bytes (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
      (js-call bytes :setFloat64 0 (if (= number 0) 0 number) t)
      (js-array (js-call bytes :getUint32 0 t) (js-call bytes :getUint32 4 t))))

  (defun buildArray (count build)
    (when (or (not (Number/isInteger count)) (funcall host-less count 0)
              (funcall host-greater count 67108854) (not (= (funcall host-typeof build) "function")))
      (throw (new globalThis.TypeError "invalid private array builder")))
    (Array/from (js-object :length count) (lambda (ignored index) (funcall build index))))

  (defun unsupportedArity (label arity)
    (throw (new globalThis.TypeError
      (funcall host-add (funcall host-add label " received unsupported arity: ") arity))))

  (defun createHostIdentityToken ()
    (let ((objects (new globalThis.WeakMap)) (symbols (new globalThis.Map)) (next 1))
      (lambda (value)
        (let ((type (funcall host-typeof value)))
          (when (and (or (not (= type "object")) (eq value nil))
                     (not (= type "function")) (not (= type "symbol")))
            (throw (new globalThis.TypeError "host-identity-token expects an object, function, or symbol")))
          (let* ((identities (if (= type "symbol") symbols objects))
                 (cached (funcall host-map-get identities value)))
            (if (not (eq cached undefined)) cached
              (progn
                (when (funcall host-greater next (get globalThis.Number :MAX_SAFE_INTEGER))
                  (throw (new globalThis.RangeError "host identity token space exhausted")))
                (let ((token next))
                  (setq next (funcall host-add next 1))
                  (funcall host-map-set identities value token) token))))))))
  (export numericObject numericPrimitive toNumber numeric implicitNumber numericDecrement numericRelation
    numericSub numericMul numericDiv numericRem numericAnd numericOr numericXor numericShl numericShr numericUshr
    numericNeg numericInt32 numericUint32 numericNot numericImul valueType createHostIdentityToken stringToBigint float64Words buildArray unsupportedArity))
