(module eliscript.runtime.array-text
  (import "./number-radix.mjs" numberStringBuiltin numberRadixText)

  ;; Internal JS target support. Generated modules import identical data URLs so
  ;; recursive conversions share one guard without modifying global prototypes.
  (defconst apply-fn Reflect/apply)
  (defconst functionCall (get (get globalThis.Function :prototype) :call))
  (defconst functionApply (get (get globalThis.Function :prototype) :apply))
  (defconst functionBind (get (get globalThis.Function :prototype) :bind))
  (defconst define Object/defineProperty)
  (defconst descriptor Object/getOwnPropertyDescriptor)
  (defconst prototype Object/getPrototypeOf)
  (defconst setPrototype Object/setPrototypeOf)
  (defconst ownKeys Reflect/ownKeys)
  (defconst hasInstance globalThis.Symbol.hasInstance)
  (defconst array Array/isArray)
  (defconst intrinsicJoin (get (get globalThis.Array :prototype) :join))
  (defconst intrinsicArrayString (get (get globalThis.Array :prototype) :toString))
  (defconst objectString (get (get globalThis.Object :prototype) :toString))
  (defconst string globalThis.String)
  (defconst native-object globalThis.Object)
  (defconst TypeErrorClass globalThis.TypeError)
  (defconst primitiveKey globalThis.Symbol.toPrimitive)
  (defconst weakHas (get (get globalThis.WeakSet :prototype) :has))
  (defconst weakAdd (get (get globalThis.WeakSet :prototype) :add))
  (defconst weakDelete (get (get globalThis.WeakSet :prototype) :delete))
  (defconst active (new globalThis.WeakSet))
  (defconst active-state (js-object :root nil))

  (defun typeof-value (value)
    (js* "typeof value"))

  (defun to-number-unary (value)
    (js* "+value"))

  (defun instance-of-p (value target)
    (js* "value instanceof target"))

  (defun object-p (value)
    (eq (funcall native-object value) value))

  (defun callable-p (value)
    (let ((type (typeof-value value)))
      (or (eq type "function")
          (and (eq type "undefined") (not (undefined? value))))))

  (defun cycle ()
    (let* ((message "cyclic array text conversion")
           (error (new TypeErrorClass message)))
      (put error :eliscriptDiagnostic
           (js-object :format "eliscript-diagnostic"
                      :version 1
                      :code "ELI-RT0009"
                      :severity "error"
                      :phase "runtime"
                      :message message))
      (throw error)))

  (defun primitive (value)
    (if (not (object-p value))
        value
      (let ((exotic (aref value primitiveKey)))
        (if (and (not (undefined? exotic)) (not (nil? exotic)))
            (let ((result (funcall apply-fn exotic value (js-array "string"))))
              (if (not (object-p result))
                  result
                (throw (new TypeErrorClass "Cannot convert object to primitive value"))))
          (let ((index 0)
                (found false)
                (output undefined))
            (while (and (< index 2) (not found))
              (let ((method (aref value (if (eq index 0) "toString" "valueOf"))))
                (when (callable-p method)
                  (let ((result (if (and (eq method intrinsicArrayString) (funcall array value))
                                    (arrayString value)
                                  (funcall apply-fn method value (js-array)))))
                    (when (not (object-p result))
                      (setq output result
                            found t)))))
              (setq index (1+ index)))
            (if found
                output
              (throw (new TypeErrorClass "Cannot convert object to primitive value"))))))))

  (defun text (value)
    (let ((result (primitive value)))
      (when (eq (typeof-value result) "symbol")
        (throw (new TypeErrorClass "Cannot convert a Symbol value to a string")))
      (funcall string result)))

  (defun join (value separator)
    ;; Length is observed before separator conversion; indexed values stay live.
    (let* ((size (to-number-unary (get value :length)))
           (length (cond
                     ((or (not (eq size size)) (<= size 0)) 0)
                     ((>= size 9007199254740991) 9007199254740991)
                     (t (- size (% size 1)))))
           (sep (if (undefined? separator) "," (text separator)))
           (root (nil? (get active-state :root))))
      (if root
          (put active-state :root value)
        (progn
          (when (or (eq value (get active-state :root))
                    (funcall apply-fn weakHas active (js-array value)))
            (cycle))
          (funcall apply-fn weakAdd active (js-array value))))
      (try
        (let ((result "")
              (index 0))
          (while (< index length)
            (when (> index 0)
              (setq result (+ result sep)))
            (let ((child (aref value index)))
              (when (and (not (nil? child)) (not (undefined? child)))
                (setq result (+ result (text child)))))
            (setq index (1+ index)))
          result)
        (finally
          (if root
              (put active-state :root nil)
            (funcall apply-fn weakDelete active (js-array value)))))))

  (defun arrayString (value)
    (let ((method (get value :join)))
      (if (callable-p method)
          (if (eq method intrinsicJoin)
              (join value undefined)
            (funcall apply-fn method value (js-array)))
        (funcall apply-fn objectString value (js-array)))))

  (defun argument (args index)
    (if (< index (get args :length))
        (aref args index)
      undefined))

  (defun argumentTail (args start)
    (let ((result (js-array))
          (index start))
      (while (< index (get args :length))
        (funcall define result (get result :length)
                 (js-object :value (aref args index)
                            :writable t
                            :enumerable t
                            :configurable t))
        (setq index (1+ index)))
      result))

  (defun joinArguments (first second)
    (let ((result (js-array))
          (first-len (get first :length))
          (total (+ (get first :length) (get second :length)))
          (index 0))
      (while (< index total)
        (funcall define result index
                 (js-object :value (if (< index first-len)
                                       (aref first index)
                                     (aref second (- index first-len)))
                            :writable t
                            :enumerable t
                            :configurable t))
        (setq index (1+ index)))
      result))

  (defun collectArguments (&rest args)
    args)

  (defun argumentList (value optional)
    (if optional
        (funcall apply-fn functionApply collectArguments (js-array undefined value))
      (funcall apply-fn collectArguments undefined value)))

  (defun dispatch (initial-method initial-receiver initial-args)
    (let ((method initial-method)
          (receiver initial-receiver)
          (args initial-args)
          (done false)
          (output undefined))
      (while (not done)
        (cond
          ((eq method numberStringBuiltin)
           (setq output (numberRadixText receiver (argument args 0))
                 done t))
          ((and (eq method intrinsicJoin) (funcall array receiver))
           (setq output (join receiver (argument args 0))
                 done t))
          ((and (eq method intrinsicArrayString) (funcall array receiver))
           (setq output (arrayString receiver)
                 done t))
          ((eq method functionCall)
           (if (not (callable-p receiver))
               (setq output (funcall apply-fn method receiver args)
                     done t)
             (let ((target receiver)
                   (next-receiver (argument args 0)))
               (setq args (argumentTail args 1)
                     method target
                     receiver next-receiver))))
          ((eq method functionApply)
           (if (not (callable-p receiver))
               (setq output (funcall apply-fn method receiver args)
                     done t)
             (let ((target receiver)
                   (next-receiver (argument args 0)))
               (setq args (argumentList (argument args 1) t)
                     method target
                     receiver next-receiver))))
          ((eq method apply-fn)
           (let ((target (argument args 0))
                 (next-receiver (argument args 1)))
             (if (not (callable-p target))
                 (setq output (funcall apply-fn method receiver args)
                       done t)
               (setq args (argumentList (argument args 2) false)
                     method target
                     receiver next-receiver))))
          ((eq method functionBind)
           (let ((bound (funcall apply-fn method receiver args)))
             (if (and (not (eq receiver numberStringBuiltin))
                      (not (eq receiver intrinsicJoin))
                      (not (eq receiver intrinsicArrayString))
                      (not (eq receiver functionCall))
                      (not (eq receiver functionApply))
                      (not (eq receiver apply-fn))
                      (not (eq receiver functionBind)))
                 (setq output bound
                       done t)
               (let* ((target receiver)
                      (bound-receiver (argument args 0))
                      (prefix (argumentTail args 1))
                      (invoke (lambda (&rest values)
                                (dispatch target bound-receiver (joinArguments prefix values)))))
                 (funcall define invoke hasInstance
                          (js-object :value (lambda (value) (instance-of-p value target))
                                     :configurable t))
                 (let ((result (funcall apply-fn functionBind invoke (js-array undefined)))
                       (keys (funcall ownKeys bound))
                       (index 0))
                   (funcall setPrototype result (funcall prototype bound))
                   (while (< index (get keys :length))
                     (let ((key (aref keys index)))
                       (funcall define result key (funcall descriptor bound key)))
                     (setq index (1+ index)))
                   (setq output result
                         done t))))))
          (t
           (setq output (funcall apply-fn method receiver args)
                 done t))))
      output))

  (defun c (value key)
    (let ((method (aref value key)))
      (lambda (&rest args)
        (dispatch method value args))))

  (defun d (value key &rest args)
    (let ((method (aref value key)))
      (dispatch method value args)))

  (defconst captureArrayText c)
  (defconst invokeArrayText d)

  (export c d captureArrayText invokeArrayText))
