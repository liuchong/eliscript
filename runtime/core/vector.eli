  (defun persistentVector (&rest values)
    (js-call PersistentVector :from values))

  (defun subvec (vector start &rest __opt)
    (unless (instance-of? vector PersistentVector)
      (throw (new globalThis/TypeError "subvec expects a persistent vector")))
    (let* ((end (aref __opt 0))
           (count (get vector :count))
           (limit (if (undefined? end) count end)))
      (when (or (not (Number/isSafeInteger start))
                (not (Number/isSafeInteger limit))
                (< start 0)
                (< limit start)
                (> limit count))
        (throw (new globalThis/RangeError
                 (str "subvec range [" (funcall globalThis/String start) ", " (funcall globalThis/String limit) ") is outside [0, " count "]"))))
      (if (instance-of? vector PersistentSubVector)
          (let ((state (js-call SUBVECTOR_STATE :get vector)))
            (new PersistentSubVector
              (get state :vector)
              (+ (get state :start) start)
              (+ (get state :start) limit)))
          (new PersistentSubVector vector start limit))))

  (defun isPersistentVector (value)
    (instance-of? value PersistentVector))

  (defun readPersistentVectorView (value)
    (js-call SUBVECTOR_STATE :get value))

  (defun read-vector-metadata (self)
    (get (aref self VECTOR_STATE) :metadata))

  (defun readPersistentVectorMetadataReader (method call)
    ;; Select the actual Eli body only for this exact method and native call.
    ;; Its original state-slot read is retained, including proxy/accessor effects.
    ;; Alternate methods and changed `.call` hooks take normal dispatch.
    (if (and (eq method vector-metadata-reader) (eq call native-call))
      read-vector-metadata
      undefined))

  (Object/defineProperty subvec "length" (js-object :value 2 :configurable t))

  (export
    PersistentVector
    EMPTY_VECTOR
    persistentVector
    subvec
    isPersistentVector
    readPersistentVectorView
    readPersistentVectorMetadataReader))
