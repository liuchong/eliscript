(module eliscript.runtime.core.vector
  (import "./vector-internals.mjs"
    BRANCH_BITS
    BRANCH_MASK
    BRANCH_WIDTH
    EMPTY_ROOT
    EMPTY_TAIL
    TRANSIENT_VECTOR_CONSTRUCTOR_TOKEN
    TRANSIENT_VECTOR_STATE
    VECTOR_CONSTRUCTOR_TOKEN
    VECTOR_STATE
    VectorNode
    allocateTail
    editableVectorNode
    recordInvalidTransientVectorCall
    recordRootGrowth
    recordTransientVectorNodeMutation
    recordTransientVectorPersistent
    recordTransientVectorTailCopy
    recordTransientVectorTailMutation
    visitNode)
  (import "./value-internals.mjs"
    VALUE_EQUAL
    VALUE_HASH
    orderedCollectionHash)
  (import "./collection-internals.mjs"
    COLLECTION_COUNT
    COLLECTION_EMPTY
    COLLECTION_CONJ
    COLLECTION_GET
    COLLECTION_ASSOC
    COLLECTION_CONTAINS
    COLLECTION_NTH
    COLLECTION_REDUCE
    COLLECTION_REDUCE_KV
    COLLECTION_PEEK
    COLLECTION_POP
    COLLECTION_RSEQ
    COLLECTION_SEQ
    isReducedValue
    reduceIterable
    sequenceView
    unreducedValue)
  (import "./transient-internals.mjs"
    EDITABLE_TRANSIENT
    TRANSIENT_ASSOC
    TRANSIENT_CONJ
    TRANSIENT_PERSISTENT)
  (import "./metadata-internals.mjs"
    METADATA_READ
    METADATA_WITH)

  (defun typeof-value (value) (js* "typeof value"))
  ;; Keep copy-array allocation at a distinct host allocation site.
  ;; Read the live Array binding even when the globalThis property is rebound.
  ;; Reflect.construct also preserves Proxy construction after host JIT warmup.
  (defun allocate-copy-array (length)
    (Reflect/construct (js* "Array") (js-array length)))
  (defmacro instance-of? (value Constructor)
    `(funcall (js* "(a, b) => a instanceof b") ,value ,Constructor))
  (defconst host-generator (js* "(create) => function* () { yield* create(this); }"))
  (defun bit-ushr (a b) (js* "a >>> b"))
  (defun bit-shl (a b) (js* "a << b"))
  (defun bit-and (a b) (js* "a & b"))
  (defun bit-or-zero (a) (js* "a | 0"))
  ;; Internal trie indices and levels have already passed integer validation.
  ;; Keep their host-number arithmetic separate from polymorphic Lisp numbers.
  (defmacro index-less? (a b)
    `(funcall (js* "(a, b) => a < b") ,a ,b))
  (defmacro index-greater? (a b)
    `(funcall (js* "(a, b) => a > b") ,a ,b))
  (defmacro index-at-least? (a b)
    `(funcall (js* "(a, b) => a >= b") ,a ,b))
  (defmacro index-subtract (a b)
    `(funcall (js* "(a, b) => a - b") ,a ,b))
  (defmacro index-add (a b)
    `(funcall (js* "(a, b) => a + b") ,a ,b))
  (defmacro index-ushr (a b)
    `(funcall (js* "(a, b) => a >>> b") ,a ,b))
  (defmacro index-shl (a b)
    `(funcall (js* "(a, b) => a << b") ,a ,b))
  (defmacro index-mask (a b)
    `(funcall (js* "(a, b) => a & b") ,a ,b))
  (defconst MAX_COUNT 2147483647)
  (defconst TWO_CHUNK_WIDTH (index-shl BRANCH_WIDTH 1))
  (defconst MISSING (funcall globalThis/Symbol "eliscript.vector.missing"))
  (defconst VECTOR_HASH_TAG 1327180861)
  (defconst SUBVECTOR_STATE (new globalThis/WeakMap))
  (defconst native-call (get (get globalThis.Function :prototype) :call))
  (defvar vector-metadata-reader undefined)

  (defun callable? (value)
    (= (funcall typeof-value value) "function"))

  (defun define-method-value (target key value)
    (Object/defineProperty
      target
      key
      (js-object
        :value value
        :writable t
        :configurable t)))

  ;; Exact host signatures avoid collecting and expanding the same arguments
  ;; twice. Bodies below remain Eli; these stubs only supply dynamic `this`
  ;; and retain native concise-method identity and non-constructibility.
  (defun zero-method (implementation name)
    (funcall (js* "(fn, name) => ({ [name]() { return fn(this); } })[name]") implementation name))

  (defun define-zero-method (target key name implementation)
    (define-method-value target key (zero-method implementation name)))

  (defun define-unary-method (target key name implementation)
    (define-method-value target key
      (funcall (js* "(fn, name) => ({ [name](value) { return fn(this, value); } })[name]") implementation name)))

  (defun define-binary-method (target key name implementation)
    (define-method-value target key
      (funcall (js* "(fn, name) => ({ [name](first, second) { return fn(this, first, second); } })[name]") implementation name)))

  (defun define-unary-rest-method (target key name implementation)
    (define-method-value target key
      (funcall (js* "(fn, name) => ({ [name](first, ...args) { return fn(this, first, args); } })[name]") implementation name)))

  (defun define-optional-unary-method (target key name implementation)
    (define-method-value target key
      (funcall (js* "(fn, name) => ({ [name](value = undefined) { return fn(this, value); } })[name]") implementation name)))

  (defun define-optional-binary-method (target key name implementation)
    (define-method-value target key
      (funcall (js* "(fn, name) => ({ [name](first, second = undefined) { return fn(this, first, second); } })[name]") implementation name)))

  (defun define-unary-static-method (target key name implementation)
    (define-method-value target key
      (funcall (js* "(fn, name) => ({ [name](value) { return fn(value); } })[name]") implementation name)))

  (defun define-binary-static-method (target key name implementation)
    (define-method-value target key
      (funcall (js* "(fn, name) => ({ [name](first, second) { return fn(first, second); } })[name]") implementation name)))

  (defun define-pair-static-method (target key name implementation)
    (define-method-value target key
      (funcall (js* "(fn, name) => ({ [name](first, second, metadata = null) { return fn(first, second, metadata); } })[name]") implementation name)))

  (defun define-getter (target key name implementation)
    (Object/defineProperty
      target
      key
      (js-object
        :get (funcall
          (js* "(fn, name) => Object.getOwnPropertyDescriptor({ get [name]() { return fn(this); } }, name).get")
          implementation name)
        :configurable t)))

  (defun assert-index (index upper-bound operation)
    (when (or (not (Number/isInteger index))
              (< index 0)
              (>= index upper-bound))
      (throw (new globalThis/RangeError
               (str operation " index " (funcall globalThis/String index) " is outside [0, " upper-bound ")")))))

  (defun tail-offset (count)
    (if (index-less? count BRANCH_WIDTH)
        0
        (let* ((last-index (index-subtract count 1))
               (blocks (index-ushr last-index BRANCH_BITS)))
          (index-shl blocks BRANCH_BITS))))

  (defun array-for (state index)
    ;; Hoist the single count read and its tail offset so the tail test reduces
    ;; to one native comparison. Conversions still finish before the index is
    ;; converted, and every visited node and tail read keeps its original order.
    (let* ((count (get state :count))
           (tail-start (tail-offset count)))
      (if (index-at-least? index tail-start)
          (get state :tail)
          (let ((node (get state :root))
                (level (get state :shift)))
            (while (index-greater? level 0)
              (visitNode node)
              ;; Read slots before converting the index, as in the original
              ;; indexed property expression; do not move effects past getters.
              (let* ((slots (get node :slots))
                     (shifted (index-ushr index level))
                     (slot (index-mask shifted BRANCH_MASK)))
                (setq node (get slots slot)
                      level (index-subtract level BRANCH_BITS))))
            (visitNode node)
            (get node :slots)))))

  (defun publish-path-value (state value)
    ;; Zipper parent links are frozen only when first exposed to user code.
    ;; Keep this cold publication path out of ordinary indexed access.
    (when (and (= (get state :count) 2)
               (not (eq (get state :metadata) nil))
               (Array/isArray value)
               (= (js-length value) 6)
               (eq (get value 5) t)
               (not (Object/isFrozen value)))
      (Object/freeze value))
    value)

  (defun vector-index-value (state index)
    (if (index-greater? (get state :count) BRANCH_WIDTH)
      (let ((chunk (array-for state index)))
        (aref chunk (index-mask index BRANCH_MASK)))
      (let ((value (aref (get state :tail) index)))
        (if (= index 1) (publish-path-value state value) value))))

  (defun missing-vector-index (state index fallback)
    (if (or (undefined? fallback) (eq fallback MISSING))
      (assert-index index (get state :count) "nth")
      fallback))

  (defun reverse-vector-iterator (state)
    (let ((index (- (get state :count) 1))
          (chunk EMPTY_TAIL)
          (chunk-start (get state :count)))
      (js-object
        :next (zero-method
                (lambda (_self)
                  (if (< index 0)
                      (js-object :value undefined :done t)
                      (progn
                        (when (< index chunk-start)
                          (setq chunk (array-for state index)
                                chunk-start (- index (funcall bit-and index BRANCH_MASK))))
                        (let ((value (get chunk (- index chunk-start))))
                          (setq index (- index 1))
                          (js-object :value value :done false)))))
                "next"
                0))))

  (defun vector-range-iterator (vector start end &optional reverse)
    (let* ((rev (funcall globalThis/Boolean reverse))
           (index (if rev (- end 1) start)))
      (js-object
        :next (zero-method
                (lambda (_self)
                  (if (if rev (< index start) (>= index end))
                      (js-object :value undefined :done t)
                      (let ((value (js-call vector :nth index)))
                        (setq index (+ index (if rev -1 1)))
                        (js-object :value value :done false))))
                "next"
                0))))

  (defun new-path (level node)
    (if (= level 0)
        node
        (new VectorNode (js-array (new-path (- level BRANCH_BITS) node)))))

  (defun push-tail (level parent tail-node count)
    (visitNode parent)
    (let* ((subindex (funcall bit-and (funcall bit-ushr (- count 1) level) BRANCH_MASK))
           (slots (js-call (get parent :slots) :slice)))
      (if (= level BRANCH_BITS)
          (put slots subindex tail-node)
          (let ((child (get (get parent :slots) subindex)))
            (put slots subindex
                  (if (undefined? child)
                      (new-path (- level BRANCH_BITS) tail-node)
                      (push-tail (- level BRANCH_BITS) child tail-node count)))))
      (new VectorNode slots)))

  (defun assoc-node (level node index value)
    (visitNode node)
    (let ((slots (js-call (get node :slots) :slice)))
      (if (= level 0)
          (put slots (funcall bit-and index BRANCH_MASK) value)
          (let ((subindex (funcall bit-and (funcall bit-ushr index level) BRANCH_MASK)))
            (put slots subindex
                  (assoc-node
                    (- level BRANCH_BITS)
                    (get (get node :slots) subindex)
                    index
                    value))))
      (new VectorNode slots)))

  (defun transient-new-path (level node owner)
    (if (= level 0)
        node
        (new VectorNode
          (js-array (transient-new-path (- level BRANCH_BITS) node owner))
          owner)))

  (defun transient-push-tail (level parent tail-node count owner)
    (visitNode parent)
    (let* ((editable (editableVectorNode parent owner))
           (subindex (funcall bit-and (funcall bit-ushr (- count 1) level) BRANCH_MASK)))
      (if (= level BRANCH_BITS)
          (put (get editable :slots) subindex tail-node)
          (let ((child (get (get editable :slots) subindex)))
            (put (get editable :slots) subindex
                  (if (undefined? child)
                      (transient-new-path (- level BRANCH_BITS) tail-node owner)
                      (transient-push-tail (- level BRANCH_BITS) child tail-node count owner)))))
      (recordTransientVectorNodeMutation)
      editable))

  (defun transient-assoc-node (level node index value owner)
    (visitNode node)
    (let ((editable (editableVectorNode node owner)))
      (if (= level 0)
          (put (get editable :slots) (funcall bit-and index BRANCH_MASK) value)
          (let ((subindex (funcall bit-and (funcall bit-ushr index level) BRANCH_MASK)))
            (put (get editable :slots) subindex
                  (transient-assoc-node
                    (- level BRANCH_BITS)
                    (get (get editable :slots) subindex)
                    index
                    value
                    owner))))
      (recordTransientVectorNodeMutation)
      editable))

  (defun pop-tail (level node count)
    (visitNode node)
    (let ((subindex (funcall bit-and (funcall bit-ushr (- count 2) level) BRANCH_MASK)))
      (if (> level BRANCH_BITS)
          (let ((child (pop-tail (- level BRANCH_BITS) (get (get node :slots) subindex) count)))
            (if (and (undefined? child) (= subindex 0))
                undefined
                (let ((slots (js-call (get node :slots) :slice)))
                  (put slots subindex child)
                  (new VectorNode slots))))
          (if (= subindex 0)
              undefined
              (let ((slots (js-call (get node :slots) :slice)))
                (put slots subindex undefined)
                (new VectorNode slots))))))

  (defun initialize-persistent-vector (self token count shift root tail metadata)
    (unless (eq token VECTOR_CONSTRUCTOR_TOKEN)
      (throw (new globalThis.TypeError "PersistentVector values must be created with persistentVector or PersistentVector.from")))
    (put self VECTOR_STATE (js-object :count count :shift shift :root root :tail tail :metadata metadata))
    (Object/freeze self))

  (defconst PersistentVector
    (funcall (js* "(initialize) => class PersistentVector { constructor(token, count, shift, root, tail, metadata = null) { initialize(this, token, count, shift, root, tail, metadata); } }") initialize-persistent-vector))

  (defun make-vector (count shift root tail &optional metadata)
    (new PersistentVector
      VECTOR_CONSTRUCTOR_TOKEN
      count
      shift
      root
      tail
      (if (undefined? metadata) nil metadata)))

  (defconst EMPTY_VECTOR
    (make-vector 0 BRANCH_BITS EMPTY_ROOT EMPTY_TAIL))

  (defun empty-vector-with-metadata (metadata)
    (if (eq metadata nil)
        EMPTY_VECTOR
        (make-vector 0 BRANCH_BITS EMPTY_ROOT EMPTY_TAIL metadata)))

  (defun initialize-transient-vector (self token vector)
    (unless (and (eq token TRANSIENT_VECTOR_CONSTRUCTOR_TOKEN) (instance-of? vector PersistentVector))
      (throw (new globalThis.TypeError "transient vectors must be created from a persistent vector")))
    (let ((source (get vector VECTOR_STATE)))
      (put self TRANSIENT_VECTOR_STATE
        (js-object :active t :changed false :owner (Object/freeze (js-object)) :source vector
          :count (get source :count) :shift (get source :shift) :root (get source :root)
          :tail (get source :tail) :tailOwned false :metadata (get source :metadata))))
    (Object/defineProperty self "__eliscript_transient__"
      (js-object :enumerable t :get (funcall (js* "(reject) => ({ get() { return reject(); } }).get") (lambda ()
        (throw (new globalThis.TypeError "transient vectors cannot be serialized"))))))
    (Object/freeze self))

  (defconst TransientVector
    (funcall (js* "(initialize) => class TransientVector { constructor(token, vector) { initialize(this, token, vector); } }") initialize-transient-vector))

  (defun make-transient-vector (vector)
    (new TransientVector TRANSIENT_VECTOR_CONSTRUCTOR_TOKEN vector))

  (defun active-transient-vector-state (vector)
    (let ((state (aref vector TRANSIENT_VECTOR_STATE)))
      (unless (get state :active)
        (recordInvalidTransientVectorCall)
        (throw (new globalThis/TypeError "transient vector is no longer editable")))
      state))

  (defun editable-transient-tail (state)
    (unless (get state :tailOwned)
      (put state "tail" (js-call (get state :tail) :slice))
      (put state "tailOwned" t)
      (recordTransientVectorTailCopy))
    (get state :tail))

  (let ((tproto (get TransientVector :prototype)))
    (define-unary-method tproto TRANSIENT_CONJ "[eliscript.transient.conj]"
      (lambda (self value)
        (let ((state (active-transient-vector-state self)))
          (when (= (get state :count) MAX_COUNT)
            (throw (new globalThis/RangeError
                     (str "persistent vector cannot exceed " MAX_COUNT " values"))))
          (if (< (js-length (get state :tail)) BRANCH_WIDTH)
              (progn
                (js-call (editable-transient-tail state) :push value)
                (recordTransientVectorTailMutation))
              (progn
                (unless (get state :tailOwned)
                  (put state "tail" (js-call (get state :tail) :slice))
                  (recordTransientVectorTailCopy))
                (let ((tail-node (new VectorNode (get state :tail) (get state :owner))))
                  (if (> (funcall bit-ushr (get state :count) BRANCH_BITS)
                         (funcall bit-shl 1 (get state :shift)))
                      (progn
                        (put state "root"
                              (new VectorNode
                                (js-array
                                  (get state :root)
                                  (transient-new-path (get state :shift) tail-node (get state :owner)))
                                (get state :owner)))
                        (put state "shift" (+ (get state :shift) BRANCH_BITS))
                        (recordRootGrowth))
                      (put state "root"
                            (transient-push-tail
                              (get state :shift)
                              (get state :root)
                              tail-node
                              (get state :count)
                              (get state :owner))))
                  (put state "tail" (js-array value))
                  (put state "tailOwned" t)
                  (recordTransientVectorTailMutation))))
          (put state "count" (+ (get state :count) 1))
          (put state "changed" t)
          self)))
    (define-binary-method tproto TRANSIENT_ASSOC "[eliscript.transient.assoc]"
      (lambda (self index value)
        (let ((state (active-transient-vector-state self)))
          (if (= index (get state :count))
              (js-call (aref self TRANSIENT_CONJ) :call self value)
              (progn
                (assert-index index (get state :count) "assocBang")
                (if (>= index (tail-offset (get state :count)))
                    (progn
                      (put (editable-transient-tail state) (funcall bit-and index BRANCH_MASK) value)
                      (recordTransientVectorTailMutation))
                    (put state "root"
                          (transient-assoc-node
                            (get state :shift)
                            (get state :root)
                            index
                            value
                            (get state :owner))))
                (put state "changed" t)
                self)))))
    (define-zero-method tproto TRANSIENT_PERSISTENT "[eliscript.transient.persistent]"
      (lambda (self)
        (let* ((state (active-transient-vector-state self))
               (result (if (get state :changed)
                           (make-vector
                             (get state :count)
                             (get state :shift)
                             (get state :root)
                             (get state :tail)
                             (get state :metadata))
                           (get state :source))))
          (put state "active" false)
          (put state "owner" nil)
          (recordTransientVectorPersistent)
          result)))
    (define-zero-method tproto "toJSON" "toJSON"
      (lambda (_self)
        (throw (new globalThis/TypeError "transient vectors cannot be serialized"))))
    (define-getter tproto (get globalThis/Symbol :toStringTag) "[Symbol.toStringTag]"
      (lambda (_self) "EliscriptTransientVector")))

  (defun for-each-iterable (iterable callback)
    (let ((iterator-method (if (nil? iterable)
                               undefined
                               (aref iterable (get globalThis/Symbol :iterator)))))
      (unless (callable? iterator-method)
        (throw (new globalThis/TypeError "value is not iterable")))
      (let ((iterator (js-call iterator-method :call iterable))
            (done false))
        (try
          (while (not done)
            (let ((step (js-call iterator :next)))
              (if (funcall globalThis/Boolean (get step :done))
                  (setq done t)
                  (funcall callback (get step :value)))))
          (finally
            (when (and (not done) (callable? (get iterator :return)))
              (js-call iterator :return)))))))

  (defun vector-step-iterator (vector)
    (let ((state (aref vector VECTOR_STATE))
          (index 0)
          (chunk nil)
          (offset 0)
          (chunk-length 0))
      (let ((iterator
              (js-object
                :next (zero-method
                        (lambda (_self)
                          (if (>= index (get state :count))
                              (js-object :value undefined :done t)
                              (progn
                                (when (or (nil? chunk) (>= offset chunk-length))
                                  (setq chunk (array-for state index)
                                        offset (funcall bit-and index BRANCH_MASK)
                                        chunk-length (Math/min (get chunk :length)
                                                               (- (get state :count) (- index offset)))))
                                (let ((value (get chunk offset)))
                                  (setq offset (+ offset 1)
                                        index (+ index 1))
                                  (js-object :value value :done false)))))
                        "next"))))
        (put iterator (get globalThis/Symbol :iterator)
              (zero-method (lambda (self) self) "[Symbol.iterator]"))
        iterator)))

  (defun finish-vector-array (iterable length root shift count tail)
    (while (< count length)
      (let* ((next-end (Math/min (+ count BRANCH_WIDTH) length))
             (tail-node (new VectorNode tail))
             (blocks (index-ushr count BRANCH_BITS))
             (capacity (index-shl 1 shift)))
        (if (index-greater? blocks capacity)
          (progn
            (setq root (new VectorNode (js-array root (new-path shift tail-node)))
                  shift (+ shift BRANCH_BITS))
            (recordRootGrowth))
          (setq root (push-tail shift root tail-node count)))
        (setq tail (allocateTail (js-call iterable :slice count next-end))
              count next-end)))
    (make-vector length shift root tail))

  (defun vector-from-array (iterable)
    (let ((length (js-length iterable)))
      (cond
        ((= length 0) EMPTY_VECTOR)
        ((if (= (js* "typeof length") "number")
             (index-at-least? BRANCH_WIDTH length)
             (<= length BRANCH_WIDTH))
         (make-vector length BRANCH_BITS EMPTY_ROOT (allocateTail (js-call iterable :slice))))
        ((and (= (js* "typeof length") "number")
              (index-at-least? TWO_CHUNK_WIDTH length))
         ;; Build the first root directly, retaining the live minimum call
         ;; before node allocation. An overridden endpoint continues through
         ;; the ordinary loop with precisely the already consumed first step.
         (let* ((first (allocateTail (js-call iterable :slice 0 BRANCH_WIDTH)))
                (next-end (Math/min TWO_CHUNK_WIDTH length))
                (root (new VectorNode (js-array (new VectorNode first))))
                (tail (allocateTail (js-call iterable :slice BRANCH_WIDTH next-end))))
           (if (= next-end length)
             (make-vector length BRANCH_BITS root tail)
             (finish-vector-array iterable length root BRANCH_BITS next-end tail))))
        (t
         (finish-vector-array iterable length EMPTY_ROOT BRANCH_BITS BRANCH_WIDTH
           (allocateTail (js-call iterable :slice 0 BRANCH_WIDTH)))))))

  (defun vector-from-iterable (iterable)
    (let ((result EMPTY_VECTOR))
             (for-each-iterable iterable (lambda (value) (setq result (js-call result :conj value))))
             result))

  (let ((proto (get PersistentVector :prototype)))
    (define-zero-method PersistentVector "empty" "empty"
      (lambda (_self) EMPTY_VECTOR))
    (define-unary-static-method PersistentVector "single" "single"
      (lambda (value)
        (make-vector 1 BRANCH_BITS EMPTY_ROOT (allocateTail (js-array value)) nil)))
    (define-pair-static-method PersistentVector "pairWithMeta" "pairWithMeta"
      (lambda (first second metadata)
        (make-vector 2 BRANCH_BITS EMPTY_ROOT (allocateTail (js-array first second)) metadata)))
    (define-binary-static-method PersistentVector "rawSlot" "rawSlot"
      (lambda (vector index)
        (get (get (aref vector VECTOR_STATE) :tail) index)))
    ;; Give hot callbacks distinct host call sites instead of sharing the
    ;; polymorphic bridge used by unrelated methods. Algorithms remain Eli.
    (define-method-value PersistentVector "from"
      (funcall (js* "(fn) => ({ from(value) { return fn(value); } }).from")
        (lambda (iterable)
          (cond
            ((instance-of? iterable PersistentVector)
             iterable)
            ((and (Array/isArray iterable)
                  (eq (Object/getPrototypeOf iterable) Array/prototype)
                  (not (Object/hasOwn iterable (get globalThis/Symbol :iterator)))
                  (eq (aref iterable (get globalThis/Symbol :iterator))
                      (aref Array/prototype (get globalThis/Symbol :iterator))))
             (vector-from-array iterable))
            (t
             (vector-from-iterable iterable))))))
    (Object/defineProperty proto "count"
      (js-object :configurable t
        :get (funcall
          (js* "(fn) => Object.getOwnPropertyDescriptor({ get count() { return fn(this); } }, 'count').get")
          (lambda (self) (get (aref self VECTOR_STATE) :count)))))
    (define-getter proto "size" "size"
      (lambda (self) (get (aref self VECTOR_STATE) :count)))
    (define-method-value proto "nth"
