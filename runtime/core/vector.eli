            (throw (new globalThis/RangeError
                     (str "subvec assoc index " (funcall globalThis/String index) " is outside [0, " count "]"))))
          (let* ((absolute-index (+ (get state :start) index))
                 (vector (if (= absolute-index (get (get state :vector) :count))
                             (js-call (get state :vector) :conj value)
                             (js-call (get state :vector) :assoc absolute-index value))))
            (new PersistentSubVector
              vector
              (get state :start)
              (Math/max (get state :end) (+ absolute-index 1))
              (get state :metadata))))))
    (define-unary-method subproto "conj" "conj"
      (lambda (self value)
        (js-call self :assoc (get self :count) value)))
    (define-optional-unary-method subproto "peek" "peek"
      (lambda (self fallback)
        (let ((not-found (if (undefined? fallback) nil fallback))
              (state (js-call SUBVECTOR_STATE :get self)))
          (if (= (get state :start) (get state :end))
              not-found
              (js-call (get state :vector) :nth (- (get state :end) 1))))))
    (define-zero-method subproto "pop" "pop"
      (lambda (self)
        (let ((state (js-call SUBVECTOR_STATE :get self)))
          (when (= (get state :start) (get state :end))
            (throw (new globalThis/RangeError "cannot pop an empty persistent subvector")))
          (if (= (- (get state :end) (get state :start)) 1)
              (empty-vector-with-metadata (get state :metadata))
              (new PersistentSubVector
                (get state :vector)
                (get state :start)
                (- (get state :end) 1)
                (get state :metadata))))))
    (define-unary-rest-method subproto "reduce" "reduce"
      (lambda (self reducer initial)
        (unless (callable? reducer)
          (throw (new globalThis/TypeError "persistent subvector reducer must be a function")))
        (let ((state (js-call SUBVECTOR_STATE :get self))
              (index 0)
              (result undefined))
          (if (= (js-length initial) 0)
              (progn
                (when (= (get state :start) (get state :end))
                  (throw (new globalThis/TypeError
                           "cannot reduce an empty persistent subvector without an initial value")))
                (setq result (js-call (get state :vector) :nth (get state :start))
                      index 1))
              (setq result (get initial 0)))
          (while (< index (- (get state :end) (get state :start)))
            (setq result (funcall reducer result (js-call (get state :vector) :nth (+ (get state :start) index)) index)
                  index (+ index 1)))
          result)))
    (define-zero-method subproto COLLECTION_COUNT "[eliscript.collection.count]"
      (lambda (self) (get self :count)))
    (define-zero-method subproto COLLECTION_EMPTY "[eliscript.collection.empty]"
      (lambda (self) (empty-vector-with-metadata (get (js-call SUBVECTOR_STATE :get self) :metadata))))
    (define-unary-method subproto COLLECTION_CONJ "[eliscript.collection.conj]"
      (lambda (self value) (js-call self :conj value)))
    (define-zero-method subproto COLLECTION_PEEK "[eliscript.collection.peek]"
      (lambda (self) (js-call self :peek)))
    (define-zero-method subproto COLLECTION_POP "[eliscript.collection.pop]"
      (lambda (self) (js-call self :pop)))
    (define-zero-method subproto COLLECTION_RSEQ "[eliscript.collection.rseq]"
      (lambda (self)
        (let ((state (js-call SUBVECTOR_STATE :get self)))
          (if (= (get state :start) (get state :end))
              nil
              (sequenceView
                (lambda ()
                  (vector-range-iterator (get state :vector) (get state :start) (get state :end) t))
                (- (get state :end) (get state :start)))))))
    (define-optional-binary-method subproto COLLECTION_GET "[eliscript.collection.get]"
      (lambda (self index fallback)
        (let ((not-found (if (undefined? fallback) nil fallback)))
          (js-call self :nth index not-found))))
    (define-binary-method subproto COLLECTION_ASSOC "[eliscript.collection.assoc]"
      (lambda (self index value) (js-call self :assoc index value)))
    (define-unary-method subproto COLLECTION_CONTAINS "[eliscript.collection.contains]"
      (lambda (self index)
        (and (Number/isInteger index) (>= index 0) (< index (get self :count)))))
    (define-unary-rest-method subproto COLLECTION_NTH "[eliscript.collection.nth]"
      (lambda (self index not-found)
        (if (= (js-length not-found) 0)
            (js-call self :nth index)
            (js-call self :nth index (get not-found 0)))))
    (define-zero-method subproto COLLECTION_SEQ "[eliscript.collection.seq]"
      (lambda (self)
        (if (= (get self :count) 0)
            nil
            (sequenceView
              (lambda () (js-call (aref self (get globalThis/Symbol :iterator)) :call self))
              (get self :count)))))
    (define-unary-rest-method subproto COLLECTION_REDUCE "[eliscript.collection.reduce]"
      (lambda (self reducer initial)
        (apply reduceIterable self reducer initial)))
    (define-binary-method subproto COLLECTION_REDUCE_KV "[eliscript.collection.reduceKv]"
      (lambda (self reducer initial)
        (let ((state (js-call SUBVECTOR_STATE :get self))
              (result initial)
              (index 0)
              (halted false))
          (while (and (< (+ (get state :start) index) (get state :end)) (not halted))
            (setq result (funcall reducer result index (js-call (get state :vector) :nth (+ (get state :start) index)))
                  index (+ index 1))
            (when (isReducedValue result)
              (setq result (unreducedValue result)
                    halted t)))
          result)))
    (define-zero-method subproto EDITABLE_TRANSIENT "[eliscript.transient.editable]"
      (lambda (self)
        (let* ((state (js-call SUBVECTOR_STATE :get self))
               (builder (make-transient-vector (empty-vector-with-metadata (get state :metadata)))))
          (for-each-iterable self (lambda (value) (js-call (aref builder TRANSIENT_CONJ) :call builder value)))
          builder)))
    (define-zero-method subproto METADATA_READ "[eliscript.metadata.read]"
      (lambda (self) (get (js-call SUBVECTOR_STATE :get self) :metadata)))
    (define-unary-method subproto METADATA_WITH "[eliscript.metadata.with]"
      (lambda (self metadata)
        (let ((state (js-call SUBVECTOR_STATE :get self)))
          (if (eq metadata (get state :metadata))
              self
              (new PersistentSubVector
                (get state :vector)
                (get state :start)
                (get state :end)
                metadata)))))
    (define-zero-method subproto (get globalThis/Symbol :iterator) "[Symbol.iterator]"
      (lambda (self)
        (let ((state (js-call SUBVECTOR_STATE :get self)))
          (vector-range-iterator (get state :vector) (get state :start) (get state :end)))))
    (define-getter subproto (get globalThis/Symbol :toStringTag) "[Symbol.toStringTag]"
      (lambda (_self) "EliscriptPersistentSubVector")))

  (defun persistentVector (&rest values)
    (js-call PersistentVector :from values))

  (defun subvec (vector start &rest __opt)
    (unless (instance-of? vector PersistentVector)
      (throw (new globalThis/TypeError "subvec expects a persistent vector")))
    (let* ((end (aref __opt 0))
           (count (get vector :count))
           (limit (if (undefined? end) count end)))
      (when (or (not (Number/isSafeInteger start))
                (not (Number/isSafeInteger limit))
                (< start 0)
                (< limit start)
                (> limit count))
        (throw (new globalThis/RangeError
                 (str "subvec range [" (funcall globalThis/String start) ", " (funcall globalThis/String limit) ") is outside [0, " count "]"))))
      (if (instance-of? vector PersistentSubVector)
          (let ((state (js-call SUBVECTOR_STATE :get vector)))
            (new PersistentSubVector
              (get state :vector)
              (+ (get state :start) start)
              (+ (get state :start) limit)))
          (new PersistentSubVector vector start limit))))

  (defun isPersistentVector (value)
    (instance-of? value PersistentVector))

  (defun readPersistentVectorView (value)
    (js-call SUBVECTOR_STATE :get value))

  (defun read-vector-metadata (self)
    (aref (aref self VECTOR_STATE) "metadata"))

  (defun readPersistentVectorMetadataReader (method call)
    ;; Select the actual Eli body only for this exact method and native call.
    ;; Its original state-slot read is retained, including proxy/accessor effects.
    ;; Alternate methods and changed `.call` hooks take normal dispatch.
    (if (and (eq method vector-metadata-reader) (eq call native-call))
      read-vector-metadata
      undefined))

  (Object/defineProperty subvec "length" (js-object :value 2 :configurable t))

  (export
    PersistentVector
    EMPTY_VECTOR
    persistentVector
    subvec
    isPersistentVector
    readPersistentVectorView
    readPersistentVectorMetadataReader))
