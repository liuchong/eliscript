                       (Number/isInteger index))
                   (>= index 0)
                   (< index (get state :count)))
              (if (<= (get state :count) BRANCH_WIDTH)
                  (let ((value (get (get state :tail) index)))
                    (when (and (= index 1)
                               (= (get state :count) 2)
                               (not (eq (get state :metadata) nil))
                               (Array/isArray value)
                               (= (js-length value) 6)
