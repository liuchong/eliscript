              self
              (make-set map (get state :metadata))))))
    (define-method sproto "disj" "disj" 1
      (lambda (self value)
        (let* ((state (aref self SORTED_SET_STATE))
               (map (js-call (get state :map) :dissoc value)))
          (if (eq map (get state :map))
              self
              (make-set map (get state :metadata))))))
    (define-method sproto "values" "values" 0
      (lambda (self &rest args)
        (let* ((ascending (if (or (= (js-length args) 0) (undefined? (get args 0))) t (get args 0)))
               (state (aref (get (aref self SORTED_SET_STATE) :map) SORTED_MAP_STATE)))
          (set-iterator (get state :root) (get state :comparison) ascending))))
    (define-method sproto "keys" "keys" 0
      (lambda (self &rest args)
        (let ((ascending (if (or (= (js-length args) 0) (undefined? (get args 0))) t (get args 0))))
          (js-call self :values ascending))))
    (define-generator-method sproto "entries" "entries" 0
      (lambda (self &rest args)
        (let ((ascending (if (or (= (js-length args) 0) (undefined? (get args 0))) t (get args 0))))
          (map-step-iterator
            (js-call self :values ascending)
            (lambda (value) (Object/freeze (js-array value value)))))))
    (define-method sproto COLLECTION_COUNT "[eliscript.collection.count]" 0
      (lambda (self) (get self :count)))
    (define-method sproto COLLECTION_EMPTY "[eliscript.collection.empty]" 0
      (lambda (self)
        (let* ((state (aref self SORTED_SET_STATE))
               (map (get state :map)))
          (make-set (js-call (aref map COLLECTION_EMPTY) :call map) (get state :metadata)))))
    (define-method sproto COLLECTION_CONJ "[eliscript.collection.conj]" 1
      (lambda (self value) (js-call self :conj value)))
    (define-method sproto COLLECTION_DISJ "[eliscript.collection.disj]" 1
      (lambda (self value) (js-call self :disj value)))
    (define-method sproto COLLECTION_GET "[eliscript.collection.get]" 1
      (lambda (self value &rest args)
        (let* ((not-found (if (= (js-length args) 0) nil (get args 0)))
               (state (aref (get (aref self SORTED_SET_STATE) :map) SORTED_MAP_STATE))
               (found (sortedFind (get state :root) value (get state :comparison))))
          (if (eq found nil) not-found (get found :key)))))
    (define-method sproto COLLECTION_CONTAINS "[eliscript.collection.contains]" 1
      (lambda (self value) (js-call self :has value)))
    (define-method sproto COLLECTION_SEQ "[eliscript.collection.seq]" 0
      (lambda (self)
        (if (= (get self :count) 0)
            nil
            (sequenceView (lambda () (js-call self :values)) (get self :count)))))
    (define-method sproto COLLECTION_RSEQ "[eliscript.collection.rseq]" 0
      (lambda (self)
        (if (= (get self :count) 0)
            nil
            (sequenceView (lambda () (js-call self :values false)) (get self :count)))))
    (define-method sproto COLLECTION_REDUCE "[eliscript.collection.reduce]" 1
      (lambda (self reducer &rest initial)
        (apply reduceIterable self reducer initial)))
    (define-method sproto PERSISTENT_SET_HAS_VALUE "[eliscript.persistent-set.has-value]" 2
      (lambda (self value equal)
        (let* ((state (aref (get (aref self SORTED_SET_STATE) :map) SORTED_MAP_STATE))
               (found (sortedFind (get state :root) value (get state :comparison))))
          (and (not (eq found nil))
               (funcall host-truth (funcall equal (get found :key) value))))))
    (define-getter sproto PERSISTENT_SET_KIND "[eliscript.persistent-set.kind]"
      (lambda (_self) t))
    (define-method sproto VALUE_EQUAL "[eliscript.value.equal]" 2
      (lambda (self other equal)
        (persistentSetValueEqual self other equal)))
    (define-method sproto VALUE_HASH "[eliscript.value.hash]" 1
      (lambda (self hash)
        (unorderedCollectionHash self hash SET_HASH_TAG)))
    (define-method sproto METADATA_READ "[eliscript.metadata.read]" 0
      (lambda (self) (get (aref self SORTED_SET_STATE) :metadata)))
    (define-method sproto METADATA_WITH "[eliscript.metadata.with]" 1
      (lambda (self metadata)
        (let ((state (aref self SORTED_SET_STATE)))
          (if (eq metadata (get state :metadata))
              self
              (make-set (get state :map) metadata)))))
    (define-method sproto (get globalThis/Symbol :iterator) "[Symbol.iterator]" 0
      (lambda (self) (js-call self :values)))
    (define-getter sproto (get globalThis/Symbol :toStringTag) "[Symbol.toStringTag]"
      (lambda (_self) "EliscriptPersistentSortedSet")))

  (defun require-even-key-values (key-values label)
    (unless (= (mod (js-length key-values) 2) 0)
      (throw (new globalThis/TypeError (str label " expects an even number of key/value forms")))))

  (defun populate-map (map key-values)
    (let ((result map)
          (index 0)
          (limit (js-length key-values)))
      (while (< index limit)
        (setq result (js-call result :assoc (get key-values index) (get key-values (+ index 1)))
              index (+ index 2)))
      result))

  (defun persistentSortedMap (&rest key-values)
    (require-even-key-values key-values "persistentSortedMap")
    (populate-map EMPTY_SORTED_MAP key-values))

  (defun persistentSortedMapBy (comparison &rest key-values)
    (require-even-key-values key-values "persistentSortedMapBy")
    (populate-map (emptySortedMapBy comparison) key-values))

  (defun persistentSortedSet (&rest values)
    (let ((result EMPTY_SORTED_SET)
          (index 0)
          (limit (js-length values)))
      (while (< index limit)
        (setq result (js-call result :conj (get values index))
              index (+ index 1)))
      result))

  (defun persistentSortedSetBy (comparison &rest values)
    (let ((result (emptySortedSetBy comparison))
          (index 0)
          (limit (js-length values)))
      (while (< index limit)
        (setq result (js-call result :conj (get values index))
              index (+ index 1)))
      result))

  (defun isPersistentSortedMap (value)
    (funcall instance-of? value PersistentSortedMap))

  (defun isPersistentSortedSet (value)
    (funcall instance-of? value PersistentSortedSet))

  (defun isPersistentSortedCollection (value)
    (or (isPersistentSortedMap value) (isPersistentSortedSet value)))

  (defun sorted-state (collection)
    (cond
      ((funcall instance-of? collection PersistentSortedMap)
       (let ((state (aref collection SORTED_MAP_STATE)))
         (js-object
           :root (get state :root)
           :comparison (get state :comparison)
           :factory (lambda (ascending start end)
                      (map-iterator (get state :root) (get state :comparison) ascending start end)))))
      ((funcall instance-of? collection PersistentSortedSet)
       (let ((state (aref (get (aref collection SORTED_SET_STATE) :map) SORTED_MAP_STATE)))
         (js-object
           :root (get state :root)
           :comparison (get state :comparison)
           :factory (lambda (ascending start end)
                      (set-iterator (get state :root) (get state :comparison) ascending start end)))))
      (t
       (throw (new globalThis/TypeError "operation requires a persistent sorted collection")))))

  (defun require-boolean (value label)
    (unless (= (funcall typeof-value value) "boolean")
      (throw (new globalThis/TypeError (str label " must be a boolean"))))
    value)

  (defun sortedComparator (collection)
    (get (sorted-state collection) :comparison))

  (defun sortedSequence (collection &rest args)
    (let ((ascending (if (or (= (js-length args) 0) (undefined? (get args 0))) t (get args 0))))
      (require-boolean ascending "sortedSequence ascending")
      (let* ((state (sorted-state collection))
             (root (get state :root)))
        (if (eq root nil)
            nil
            (sequenceView
              (lambda () (funcall (get state :factory) ascending nil nil))
              (get root :size))))))

  (defun sortedSequenceFrom (collection key &rest args)
    (let ((ascending (if (or (= (js-length args) 0) (undefined? (get args 0))) t (get args 0)))
          (inclusive (if (or (< (js-length args) 2) (undefined? (get args 1))) t (get args 1))))
      (require-boolean ascending "sortedSequenceFrom ascending")
      (require-boolean inclusive "sortedSequenceFrom inclusive")
      (let ((state (sorted-state collection))
            (start (js-object :key key :inclusive inclusive)))
        (sequence-or-null (lambda () (funcall (get state :factory) ascending start nil))))))

  (defun bound-test-name (test)
    (let ((name (if (and (isKeyword test) (eq (identifierNamespace test) nil))
                    (identifierName test)
                    test)))
      (when (or (not (= (funcall typeof-value name) "string"))
                (not (js-call BOUND_TESTS :has name)))
        (throw (new globalThis/TypeError "sorted bound test must be one of :<, :<=, :>, or :>=")))
      name))

  (defun range-bounds (bounds)
    (let ((len (js-length bounds)))
      (when (and (not (= len 2)) (not (= len 4)))
        (throw (new globalThis/TypeError "subsequence expects one or two test/key bounds")))
      (let* ((first-test (bound-test-name (get bounds 0)))
             (first (js-object :key (get bounds 1) :inclusive (js-call first-test :includes "="))))
        (if (= len 2)
            (if (js-call first-test :startsWith ">")
                (js-object :lower first :upper nil)
                (js-object :lower nil :upper first))
            (let ((second-test (bound-test-name (get bounds 2))))
              (when (or (not (js-call first-test :startsWith ">"))
                        (not (js-call second-test :startsWith "<")))
                (throw (new globalThis/TypeError
                         "two-bound subsequence requires a lower :>/:>= bound then an upper :</:<= bound")))
              (js-object
                :lower first
                :upper (js-object :key (get bounds 3) :inclusive (js-call second-test :includes "="))))))))

  (defun range-sequence (collection ascending bounds)
    (let* ((state (sorted-state collection))
           (normalized (range-bounds bounds))
           (start (if ascending (get normalized :lower) (get normalized :upper)))
           (end (if ascending (get normalized :upper) (get normalized :lower))))
      (sequence-or-null (lambda () (funcall (get state :factory) ascending start end)))))

  (defun subsequence (collection &rest bounds)
    (range-sequence collection t bounds))

  (defun reverseSubsequence (collection &rest bounds)
    (range-sequence collection false bounds))

  (Object/defineProperty materializeSortedMap "length" (js-object :value 2 :configurable t))
  (Object/defineProperty materializeSortedSet "length" (js-object :value 2 :configurable t))
  (Object/defineProperty persistentSortedMapBy "length" (js-object :value 1 :configurable t))
  (Object/defineProperty persistentSortedSetBy "length" (js-object :value 1 :configurable t))
  (Object/defineProperty sortedSequence "length" (js-object :value 1 :configurable t))
  (Object/defineProperty sortedSequenceFrom "length" (js-object :value 2 :configurable t))
  (Object/defineProperty subsequence "length" (js-object :value 1 :configurable t))
  (Object/defineProperty reverseSubsequence "length" (js-object :value 1 :configurable t))

  (export
    isDefaultSortedComparator
    defaultSortedComparator
    readSortedMapState
    readSortedSetState
    materializeSortedMap
    materializeSortedSet
    PersistentSortedMap
    PersistentSortedSet
    EMPTY_SORTED_MAP
    EMPTY_SORTED_SET
    emptySortedMapBy
    emptySortedSetBy
    persistentSortedMap
    persistentSortedMapBy
    persistentSortedSet
    persistentSortedSetBy
    isPersistentSortedMap
    isPersistentSortedSet
    isPersistentSortedCollection
    sortedComparator
    sortedSequence
    sortedSequenceFrom
    subsequence
    reverseSubsequence))
