  (defconst typeof-value (js* "(value) => typeof value"))
  (defconst host-truth (js* "(value) => !!value"))
  (defconst instance-of? (js* "(value, Constructor) => value instanceof Constructor"))
  (defconst has-key? (js* "(key, object) => key in object"))
  (defconst host-generator (js* "(create) => function* (...args) { yield* create(this, ...args); }"))
  (defconst host-generator-instance (js* "(create) => (function* () { yield* create(); })()"))
  (defconst SORTED_MAP_TOKEN (funcall globalThis/Symbol "eliscript.sorted-map.constructor-token"))
  (defconst SORTED_SET_TOKEN (funcall globalThis/Symbol "eliscript.sorted-set.constructor-token"))
  (defconst PRESENT (Object/freeze (js-object)))
  (defconst MAP_HASH_TAG 1821285621)
  (defconst MAP_ENTRY_HASH_TAG 982610667)
  (defconst SET_HASH_TAG 1374139181)
  (defconst BOUND_TESTS (new globalThis/Set (js-array "<" "<=" ">" ">=")))
  (defconst DEFAULT_COMPARATOR (comparator compareValues))

  (defun callable? (value)
    (= (funcall typeof-value value) "function"))

  (defun object? (value)
    (or (and (not (nil? value)) (= (funcall typeof-value value) "object"))
        (callable? value)))

  (defun method (implementation name arity)
    (let ((function (funcall
                      (js* "(fn, name) => ({ [name](...args) { return fn(this, ...args); } })[name]")
                      implementation
                      name)))
      (Object/defineProperty function "length" (js-object :value arity :configurable t))
      function))

  (defun define-method (target key name arity implementation)
    (Object/defineProperty
      target
      key
      (js-object
        :value (method implementation name arity)
        :writable t
        :configurable t)))

  (defun define-getter (target key name implementation)
    (Object/defineProperty
      target
      key
      (js-object
        :get (method implementation (str "get " name) 0)
        :configurable t)))

  (defun define-generator-method (target key name arity implementation)
    (let ((gen-fn (funcall host-generator implementation)))
      (Object/defineProperty gen-fn "name" (js-object :value name :configurable t))
      (Object/defineProperty gen-fn "length" (js-object :value arity :configurable t))
      (Object/defineProperty target key
        (js-object :value gen-fn :writable t :configurable t))))

  (defun isDefaultSortedComparator (value)
    (eq value DEFAULT_COMPARATOR))

  (defun defaultSortedComparator ()
    DEFAULT_COMPARATOR)

  (defun normalize-comparator (comparison)
    (if (or (eq comparison compareValues)
            (eq comparison DEFAULT_COMPARATOR))
        DEFAULT_COMPARATOR
        (comparator comparison)))

  (defun open-iterator (iterable)
    (when (nullish? iterable)
      (throw (new globalThis/TypeError "value is not iterable")))
    (let ((iterator-method (aref iterable (get globalThis/Symbol :iterator))))
      (unless (callable? iterator-method)
        (throw (new globalThis/TypeError "value is not iterable")))
      (let ((iter (js-call iterator-method :call iterable)))
        (unless (object? iter)
          (throw (new globalThis/TypeError "iterator must be an object")))
        iter)))

  (defun close-iterator (iter)
    (let ((close (get iter :return)))
      (unless (nullish? close)
        (unless (callable? close)
          (throw (new globalThis/TypeError "iterator return is not a function")))
        (let ((result (js-call close :call iter)))
          (unless (object? result)
            (throw (new globalThis/TypeError "iterator return must return an object")))))))

  (defun protocol-pair (entry)
    (let* ((iterator (open-iterator entry))
           (next-fn (get iterator :next))
           (done false)
           (key undefined)
           (value undefined))
      (let ((first (js-call next-fn :call iterator)))
        (unless (object? first)
          (throw (new globalThis/TypeError "iterator result must be an object")))
        (setq done (funcall host-truth (get first :done)))
        (unless done
          (setq key (get first :value))
          (let ((second (js-call next-fn :call iterator)))
            (unless (object? second)
              (throw (new globalThis/TypeError "iterator result must be an object")))
            (setq done (funcall host-truth (get second :done)))
            (unless done
              (setq value (get second :value))))))
      (unless done
        (close-iterator iterator))
      (js-array key value)))

  (defun map-step-iterator (source transform)
    (let* ((iter (open-iterator source))
           (next-fn (get iter :next))
           (done false)
           (iterator
             (js-object
               :next (method
                       (lambda (_self)
                         (if done
                             (js-object :value undefined :done t)
                             (let ((body-active false))
                               (try
                                 (let ((step (js-call next-fn :call iter)))
                                   (unless (object? step)
                                     (throw (new globalThis/TypeError "iterator result must be an object")))
                                   (if (funcall host-truth (get step :done))
                                       (progn
                                         (setq done t)
                                         (js-object :value undefined :done t))
                                       (let ((item (get step :value)))
                                         (setq body-active t)
                                         (js-object :value (funcall transform item) :done false))))
                                 (catch error
                                   (setq done t)
                                   (when body-active
                                     (try
                                       (close-iterator iter)
                                       (catch _ignored
                                         nil)))
                                   (throw error))))))
                       "next"
                       0)
               :return (method
                         (lambda (_self &rest supplied)
                           (let ((value (aref supplied 0)))
                             (if done
                                 (js-object :value value :done t)
                                 (progn
                                   (setq done t)
                                   (close-iterator iter)
                                   (js-object :value value :done t)))))
                         "return"
                         1)
               :throw (method
                        (lambda (_self &rest supplied)
                          (let ((error (aref supplied 0)))
                            (unless done
                              (setq done t)
                              (try
                                (close-iterator iter)
                                (catch _ignored
                                  nil)))
                            (throw error)))
                        "throw"
                        1))))
      (put iterator (get globalThis/Symbol :iterator)
            (method (lambda (self) self) "[Symbol.iterator]" 0))
      iterator))

  (defun map-iterator (root comparison ascending &optional start end)
    (let ((nodes (sortedEntries root comparison ascending
                   (if (undefined? start) nil start)
                   (if (undefined? end) nil end))))
      (funcall host-generator-instance
        (lambda ()
          (map-step-iterator nodes
            (lambda (item) (Object/freeze (js-array (get item :key) (get item :value)))))))))

  (defun set-iterator (root comparison ascending &optional start end)
    (let ((nodes (sortedEntries root comparison ascending
                   (if (undefined? start) nil start)
                   (if (undefined? end) nil end))))
      (funcall host-generator-instance
        (lambda ()
          (map-step-iterator nodes
            (lambda (item) (get item :key)))))))

  (defun sequence-or-null (factory)
    (let ((probe (funcall factory)))
      (try
        (if (funcall host-truth (get (js-call probe :next) :done))
            nil
            (sequenceView factory))
        (finally
          (when (callable? (get probe :return))
            (js-call probe :return))))))

  (defun map-pair-hash (entry hash)
    (finishHash
      (mixHash (mixHash MAP_ENTRY_HASH_TAG (funcall hash (get entry 0)))
               (funcall hash (get entry 1)))
      2))

  (defun initialize-sorted-map (self token root comparison metadata)
    (unless (and (eq token SORTED_MAP_TOKEN) (= (funcall typeof-value comparison) "function"))
      (throw (new globalThis.TypeError "PersistentSortedMap values must be created with persistentSortedMap or persistentSortedMapBy")))
    (put self SORTED_MAP_STATE (Object/freeze (js-object :root root :comparison comparison :metadata metadata)))
    (Object/freeze self))

  (defconst PersistentSortedMap
    (funcall (js* "(initialize) => class PersistentSortedMap { constructor(token, root, comparison, metadata = null) { initialize(this, token, root, comparison, metadata); } }") initialize-sorted-map))

  (defun initialize-sorted-set (self token map metadata)
    (unless (and (eq token SORTED_SET_TOKEN) (funcall instance-of? map PersistentSortedMap))
      (throw (new globalThis.TypeError "PersistentSortedSet values must be created with persistentSortedSet or persistentSortedSetBy")))
    (put self SORTED_SET_STATE (Object/freeze (js-object :map map :metadata metadata)))
    (Object/freeze self))

  (defconst PersistentSortedSet
    (funcall (js* "(initialize) => class PersistentSortedSet { constructor(token, map, metadata = null) { initialize(this, token, map, metadata); } }") initialize-sorted-set))

  (defun make-map (root comparison &optional metadata)
    (new PersistentSortedMap
      SORTED_MAP_TOKEN
      root
      comparison
      (if (undefined? metadata) nil metadata)))

  (defun make-set (map &optional metadata)
    (new PersistentSortedSet
      SORTED_SET_TOKEN
      map
      (if (undefined? metadata) nil metadata)))

  (defconst EMPTY_SORTED_MAP
    (make-map nil DEFAULT_COMPARATOR))

  (defconst EMPTY_SORTED_SET
    (make-set EMPTY_SORTED_MAP))

  (defun emptySortedMapBy (comparison)
    (let ((normalized (normalize-comparator comparison)))
      (if (eq normalized DEFAULT_COMPARATOR)
          EMPTY_SORTED_MAP
          (make-map nil normalized))))

  (defun emptySortedSetBy (comparison)
    (let ((map (emptySortedMapBy comparison)))
      (if (eq map EMPTY_SORTED_MAP)
          EMPTY_SORTED_SET
          (make-set map))))

  (defun readSortedMapState (value)
    (if (not (funcall instance-of? value PersistentSortedMap))
        undefined
        (let ((descriptor (Object/getOwnPropertyDescriptor value SORTED_MAP_STATE)))
          (if (and (not (undefined? descriptor))
                   (funcall has-key? "value" descriptor))
              (get descriptor :value)
              undefined))))

  (defun readSortedSetState (value)
    (if (not (funcall instance-of? value PersistentSortedSet))
        undefined
        (let ((descriptor (Object/getOwnPropertyDescriptor value SORTED_SET_STATE)))
          (if (and (not (undefined? descriptor))
                   (funcall has-key? "value" descriptor))
              (get descriptor :value)
              undefined))))

  (defun materialize-sorted-root (values set start end)
    (if (= start end)
        nil
        (let* ((middle (+ start (Math/floor (/ (- end start) 2))))
               (item (get values middle)))
          (when (and (not set)
                     (or (not (Array/isArray item))
                         (not (= (js-length item) 2))))
            (throw (new globalThis/TypeError "invalid sorted map transport entry")))
          (new SortedNode
            (if set item (get item 0))
            (if set PRESENT (get item 1))
            (materialize-sorted-root values set start middle)
            (materialize-sorted-root values set (+ middle 1) end)))))

  (defun materializeSortedMap (entries comparison &optional metadata)
    (when (or (not (Array/isArray entries)) (not (callable? comparison)))
      (throw (new globalThis/TypeError "invalid sorted map transport record")))
    (make-map
      (materialize-sorted-root entries false 0 (js-length entries))
      comparison
      (if (undefined? metadata) nil metadata)))

  (defun materializeSortedSet (values comparison &optional metadata)
    (when (or (not (Array/isArray values)) (not (callable? comparison)))
      (throw (new globalThis/TypeError "invalid sorted set transport record")))
    (make-set
      (make-map (materialize-sorted-root values t 0 (js-length values)) comparison)
      (if (undefined? metadata) nil metadata)))

  (defun for-each-iterable (iterable callback)
    (let* ((iterator (open-iterator iterable))
           (next-fn (get iterator :next))
           (done false)
           (body-active false))
      (try
        (while (not done)
          (setq body-active false)
          (let ((step (js-call next-fn :call iterator)))
            (unless (object? step)
              (throw (new globalThis/TypeError "iterator result must be an object")))
            (if (funcall host-truth (get step :done))
                (setq done t)
                (let ((item (get step :value)))
                  (setq body-active t)
                  (funcall callback item)))))
        (catch error
          (when (and body-active (not done))
            (try
              (close-iterator iterator)
              (catch _ignored
                nil)))
          (throw error)))))

  (let ((mproto (get PersistentSortedMap :prototype)))
    (define-method PersistentSortedMap "empty" "empty" 0
      (lambda (_self &rest args)
        (let ((comparison (if (or (= (js-length args) 0) (undefined? (get args 0)))
                              compareValues
                              (get args 0))))
          (emptySortedMapBy comparison))))
    (define-method PersistentSortedMap "from" "from" 1
      (lambda (_self &rest args)
        (let ((entries (get args 0))
              (comparison (if (or (< (js-length args) 2) (undefined? (get args 1)))
                              compareValues
                              (get args 1))))
          (if (and (funcall instance-of? entries PersistentSortedMap)
                   (= (js-length args) 1))
              entries
              (let ((result (emptySortedMapBy comparison)))
                (for-each-iterable entries
                  (lambda (entry)
                    (let ((pair (readCollectionEntry entry)))
                      (setq result (js-call result :assoc (get pair 0) (get pair 1))))))
                result)))))
    (define-getter mproto "count" "count"
      (lambda (self)
        (let ((root (get (aref self SORTED_MAP_STATE) :root)))
          (if (nil? root) 0 (get root :size)))))
    (define-getter mproto "size" "size"
      (lambda (self) (get self :count)))
    (define-getter mproto "comparator" "comparator"
      (lambda (self) (get (aref self SORTED_MAP_STATE) :comparison)))
    (define-method mproto "get" "get" 1
      (lambda (self key &rest args)
        (let* ((not-found (if (= (js-length args) 0) nil (get args 0)))
               (state (aref self SORTED_MAP_STATE))
               (found (sortedFind (get state :root) key (get state :comparison))))
          (if (eq found nil) not-found (get found :value)))))
    (define-method mproto "has" "has" 1
      (lambda (self key)
        (let ((state (aref self SORTED_MAP_STATE)))
          (not (eq (sortedFind (get state :root) key (get state :comparison)) nil)))))
    (define-method mproto "assoc" "assoc" 2
      (lambda (self key value)
        (let* ((state (aref self SORTED_MAP_STATE))
               (result (sortedAssoc (get state :root) key value (get state :comparison))))
          (if (get result :changed)
              (make-map (get result :root) (get state :comparison) (get state :metadata))
              self))))
    (define-method mproto "dissoc" "dissoc" 1
      (lambda (self key)
        (let* ((state (aref self SORTED_MAP_STATE))
               (result (sortedDissoc (get state :root) key (get state :comparison))))
          (if (get result :removed)
              (make-map (get result :root) (get state :comparison) (get state :metadata))
              self))))
    (define-method mproto "entries" "entries" 0
      (lambda (self &rest args)
        (let ((ascending (if (or (= (js-length args) 0) (undefined? (get args 0))) t (get args 0)))
              (state (aref self SORTED_MAP_STATE)))
          (map-iterator (get state :root) (get state :comparison) ascending))))
    (define-method mproto "keys" "keys" 0
      (lambda (self &rest args)
        (let* ((ascending (if (or (= (js-length args) 0) (undefined? (get args 0))) t (get args 0)))
               (entries (js-call self :entries ascending)))
          (funcall host-generator-instance
            (lambda ()
              (map-step-iterator entries (lambda (entry) (get entry 0))))))))
    (define-method mproto "values" "values" 0
      (lambda (self &rest args)
        (let* ((ascending (if (or (= (js-length args) 0) (undefined? (get args 0))) t (get args 0)))
               (entries (js-call self :entries ascending)))
          (funcall host-generator-instance
            (lambda ()
              (map-step-iterator entries (lambda (entry) (get entry 1))))))))
    (define-method mproto COLLECTION_COUNT "[eliscript.collection.count]" 0
      (lambda (self) (get self :count)))
    (define-method mproto COLLECTION_EMPTY "[eliscript.collection.empty]" 0
      (lambda (self)
        (let ((state (aref self SORTED_MAP_STATE)))
          (make-map nil (get state :comparison) (get state :metadata)))))
    (define-method mproto COLLECTION_CONJ "[eliscript.collection.conj]" 1
      (lambda (self entry)
        (let ((pair (readCollectionEntry entry)))
          (js-call self :assoc (get pair 0) (get pair 1)))))
    (define-method mproto COLLECTION_GET "[eliscript.collection.get]" 1
      (lambda (self key &rest args)
        (let ((not-found (if (= (js-length args) 0) nil (get args 0))))
          (js-call self :get key not-found))))
    (define-method mproto COLLECTION_ASSOC "[eliscript.collection.assoc]" 2
      (lambda (self key value) (js-call self :assoc key value)))
    (define-method mproto COLLECTION_CONTAINS "[eliscript.collection.contains]" 1
      (lambda (self key) (js-call self :has key)))
    (define-method mproto COLLECTION_DISSOC "[eliscript.collection.dissoc]" 1
      (lambda (self key) (js-call self :dissoc key)))
    (define-method mproto COLLECTION_SEQ "[eliscript.collection.seq]" 0
      (lambda (self)
        (if (= (get self :count) 0)
            nil
            (sequenceView (lambda () (js-call self :entries)) (get self :count)))))
    (define-method mproto COLLECTION_RSEQ "[eliscript.collection.rseq]" 0
      (lambda (self)
        (if (= (get self :count) 0)
            nil
            (sequenceView (lambda () (js-call self :entries false)) (get self :count)))))
    (define-method mproto COLLECTION_REDUCE "[eliscript.collection.reduce]" 1
      (lambda (self reducer &rest initial)
        (apply reduceIterable self reducer initial)))
    (define-method mproto COLLECTION_REDUCE_KV "[eliscript.collection.reduceKv]" 2
      (lambda (self reducer initial)
        (let* ((iter (open-iterator self))
               (next-fn (get iter :next))
               (result initial)
               (complete false)
               (early false)
               (body-active false))
          (try
            (while (and (not complete) (not early))
              (setq body-active false)
              (let ((step (js-call next-fn :call iter)))
                (unless (object? step)
                  (throw (new globalThis/TypeError "iterator result must be an object")))
                (if (funcall host-truth (get step :done))
                    (setq complete t)
                    (let ((entry (get step :value)))
                      (setq body-active t)
                      (let ((pair (protocol-pair entry)))
                        (setq result (funcall reducer result (get pair 0) (get pair 1)))
                        (when (isReducedValue result)
                          (setq result (unreducedValue result)
                                early t)))))))
            (catch error
              (when (and body-active (not complete))
                (try
                  (close-iterator iter)
                  (catch _ignored
                    nil)))
              (throw error)))
          (when early
            (close-iterator iter))
          result)))
    (define-method mproto PERSISTENT_MAP_HAS_VALUE_KEY "[eliscript.persistent-map.has-value-key]" 1
      (lambda (self key)
        (let* ((state (aref self SORTED_MAP_STATE))
               (found (sortedFind (get state :root) key (get state :comparison))))
          (and (not (eq found nil))
               (equalValues (get found :key) key)))))
    (define-getter mproto PERSISTENT_MAP_KIND "[eliscript.persistent-map.kind]"
      (lambda (_self) t))
    (define-method mproto VALUE_EQUAL "[eliscript.value.equal]" 2
      (lambda (self other equal)
        (persistentMapValueEqual self other equal)))
    (define-method mproto VALUE_HASH "[eliscript.value.hash]" 1
      (lambda (self hash)
        (unorderedCollectionHash self (lambda (entry) (map-pair-hash entry hash)) MAP_HASH_TAG)))
    (define-method mproto METADATA_READ "[eliscript.metadata.read]" 0
      (lambda (self) (get (aref self SORTED_MAP_STATE) :metadata)))
    (define-method mproto METADATA_WITH "[eliscript.metadata.with]" 1
      (lambda (self metadata)
        (let ((state (aref self SORTED_MAP_STATE)))
          (if (eq metadata (get state :metadata))
              self
              (make-map (get state :root) (get state :comparison) metadata)))))
    (define-method mproto (get globalThis/Symbol :iterator) "[Symbol.iterator]" 0
      (lambda (self) (js-call self :entries)))
    (define-getter mproto (get globalThis/Symbol :toStringTag) "[Symbol.toStringTag]"
      (lambda (_self) "EliscriptPersistentSortedMap")))

  (let ((sproto (get PersistentSortedSet :prototype)))
    (define-method PersistentSortedSet "empty" "empty" 0
      (lambda (_self &rest args)
        (let ((comparison (if (or (= (js-length args) 0) (undefined? (get args 0)))
                              compareValues
                              (get args 0))))
          (emptySortedSetBy comparison))))
    (define-method PersistentSortedSet "from" "from" 1
      (lambda (_self &rest args)
        (let ((values (get args 0))
              (comparison (if (or (< (js-length args) 2) (undefined? (get args 1)))
                              compareValues
                              (get args 1))))
          (if (and (funcall instance-of? values PersistentSortedSet)
                   (= (js-length args) 1))
              values
              (let ((result (emptySortedSetBy comparison)))
                (for-each-iterable values
                  (lambda (value) (setq result (js-call result :conj value))))
                result)))))
    (define-getter sproto "count" "count"
      (lambda (self) (get (get (aref self SORTED_SET_STATE) :map) :count)))
    (define-getter sproto "size" "size"
      (lambda (self) (get self :count)))
    (define-getter sproto "comparator" "comparator"
      (lambda (self) (get (get (aref self SORTED_SET_STATE) :map) :comparator)))
    (define-method sproto "has" "has" 1
      (lambda (self value)
        (js-call (get (aref self SORTED_SET_STATE) :map) :has value)))
    (define-method sproto "conj" "conj" 1
      (lambda (self value)
