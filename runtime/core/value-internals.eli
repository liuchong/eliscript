(module eliscript.runtime.core.value-internals
  (import "./protocol.mjs" defineProtocol protocolMethod protocolSlot)
  (import "../../stdlib/bit.mjs" rotate-left)
  (defconst I_EQUIV (defineProtocol "IEquiv" (js-array "equal")))
  (defconst I_HASH (defineProtocol "IHash" (js-array "hash")))
  (defconst VALUE_EQUAL (protocolSlot I_EQUIV "equal"))
  (defconst VALUE_HASH (protocolSlot I_HASH "hash"))
  (defconst dispatchValueEqual (protocolMethod I_EQUIV "equal"))
  (defconst dispatchValueHash (protocolMethod I_HASH "hash"))
  ;; BigInt literals are host representation primitives, not embedded logic.
  (defconst BIGINT_ZERO (js* "0n"))
  (defconst BIGINT_MASK (js* "0xffffffffn"))
  (defconst BIGINT_SHIFT (js* "32n"))
  (defconst BOOLEAN_TAG 1260232563)
  (defconst BIGINT_TAG 2017827537)
  (defconst GLOBAL_SYMBOL_TAG 2657455275)
  (defconst HOST_IDENTITY_TAG 762272397)
  (defconst NUMBER_TAG 374761393)
  (defconst STRING_TAG 1831565813)
  (defconst FALSE_HASH 423263297)
  (defconst TRUE_HASH 1911856395)
  (defconst NULL_HASH 1108378657)
  (defconst UNDEFINED_HASH 2135587861)
  (defconst NAN_HASH 1490037359)
  ;; DataView supplies the host IEEE-754 representation, not the hash algorithm.
  (defconst host-object globalThis.Object)
  (defconst host-apply Reflect/apply)
  (defconst no-arguments (Object/freeze (js-array)))
  (defconst floatBytes (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
  (defvar protocolHashes (new globalThis.WeakMap))
  (defvar hostObjectHashes (new globalThis.WeakMap))
  (defvar hostSymbolHashes (new globalThis.Map))
  (defvar nextHostIdentity 1)
  (defconst metrics (js-object :hashValueCalls 0 :protocolHashComputations 0
    :protocolHashCacheHits 0 :hostIdentityAssignments 0))
  (defun host-truth (value) (js* "!!value"))
  (defun host-type (value) (js* "typeof value"))
  ;; For iterator records use JavaScript Object identity, including functions
  ;; and browser HTMLDDA objects, without inspecting user brand descriptors.
  (defun object? (value) (eq (funcall host-object value) value))

  (defun avalancheHash (value)
    (let ((hash (uint32 value)))
      (setq hash (bit-xor hash (unsigned-bit-shift-right hash 16)))
      (setq hash (imul32 hash 2246822507))
      (setq hash (bit-xor hash (unsigned-bit-shift-right hash 13)))
      (setq hash (imul32 hash 3266489909))
      (uint32 (bit-xor hash (unsigned-bit-shift-right hash 16)))))
  (defun mixHash (hash value)
    (let ((mixed (imul32 (uint32 (bit-xor hash value)) 1540483477)))
      (uint32 (bit-xor mixed (unsigned-bit-shift-right mixed 15)))))
  (defun finishHash (hash count) (avalancheHash (mixHash hash (uint32 count))))
  (defun hashString (value tag)
    (when (undefined? tag) (setq tag STRING_TAG))
    (let ((hash (mixHash tag (get value :length))) (index 0))
      (while (< index (get value :length))
        (setq hash (mixHash hash (js-call value :charCodeAt index)) index (1+ index)))
      (finishHash hash (get value :length))))
  (Object/defineProperty hashString "length" (js-object :value 1 :configurable t))
  (defun hashNumber (value)
    (if (Number/isNaN value) NAN_HASH
      (let ((normalized (if (= value 0) 0 value)))
        (js-call floatBytes :setFloat64 0 normalized t)
        (let ((low (js-call floatBytes :getUint32 0 t)) (high (js-call floatBytes :getUint32 4 t)))
          (finishHash (mixHash (mixHash NUMBER_TAG low) high) 2)))))
  (defun hashBigInt (value)
    (let* ((zero BIGINT_ZERO) (mask BIGINT_MASK)
           (shift BIGINT_SHIFT)
           (magnitude (if (< value zero) (- value) value))
           (hash (mixHash BIGINT_TAG (if (< value zero) 1 0))) (limbs 0) (complete false))
      (while (not complete)
        (setq hash (mixHash hash (funcall globalThis.Number (bit-and magnitude mask)))
          magnitude (bit-shift-right magnitude shift) limbs (1+ limbs) complete (eq magnitude zero)))
      (finishHash hash limbs)))
  (defun hashBoolean (value) (mixHash BOOLEAN_TAG (if (host-truth value) TRUE_HASH FALSE_HASH)))
  (defun hashNull () NULL_HASH)
  (defun hashUndefined () UNDEFINED_HASH)
  (defun hashGlobalSymbol (key) (hashString key GLOBAL_SYMBOL_TAG))

  ;; Capture next exactly once as for-of does. Only failures in the loop body
  ;; close the iterator; failures in next/done/value leave that iterator alone.
  (defun walk-iterable (iterable visit)
    (let* ((iterator (funcall host-apply (get iterable (get globalThis.Symbol :iterator)) iterable no-arguments))
           (next undefined) (complete false) (active false))
      (unless (object? iterator) (throw (new globalThis.TypeError "iterator must be an object")))
      (setq next (get iterator :next))
      (try
        (while (not complete)
          (setq active false)
          (let ((step (funcall host-apply next iterator no-arguments)))
            (unless (object? step) (throw (new globalThis.TypeError "iterator result must be an object")))
            (if (host-truth (get step :done)) (setq complete t)
              (let ((value (get step :value)))
                (setq active t) (funcall visit value)))))
        (catch error
          (when (and active (not complete))
            (try
              (let ((close (get iterator :return)))
                (unless (nullish? close) (funcall host-apply close iterator no-arguments)))
              (catch close-error nil)))
          (throw error)))))
  (defun orderedCollectionHash (iterable hashValue tag)
    (let ((hash (uint32 tag)) (count 0))
      (walk-iterable iterable (lambda (value)
        (setq hash (mixHash hash (funcall hashValue value)) count (1+ count))))
      (finishHash hash count)))
  (defun unorderedCollectionHash (iterable hashElement tag)
    (let ((sum 0) (xor 0) (product 1) (count 0))
      (walk-iterable iterable (lambda (element)
        (let ((hash (uint32 (funcall hashElement element))))
          (setq sum (uint32 (+ sum hash))
            xor (uint32 (bit-xor xor (rotate-left hash (bit-and hash 31))))
            product (uint32 (imul32 product (bit-or hash 1))) count (1+ count)))))
      (finishHash (mixHash (mixHash (mixHash tag sum) xor) product) count)))
  (defun cachedProtocolHash (value compute)
    (let ((cached (js-call protocolHashes :get value)))
      (if (not (undefined? cached))
        (progn (put metrics :protocolHashCacheHits (1+ (get metrics :protocolHashCacheHits))) cached)
        (progn
          (put metrics :protocolHashComputations (1+ (get metrics :protocolHashComputations)))
          (let ((hash (uint32 (funcall compute))))
            (js-call protocolHashes :set value hash) hash)))))
  (defun recordHashValueCall () (put metrics :hashValueCalls (1+ (get metrics :hashValueCalls))) undefined)
  (defun hostIdentityHash (value)
    (let* ((hashes (if (= (host-type value) "symbol") hostSymbolHashes hostObjectHashes))
           (cached (js-call hashes :get value)))
      (if (not (undefined? cached)) cached
        (let ((hash (finishHash HOST_IDENTITY_TAG nextHostIdentity)))
          (setq nextHostIdentity (1+ nextHostIdentity))
          (put metrics :hostIdentityAssignments (1+ (get metrics :hostIdentityAssignments)))
          (js-call hashes :set value hash) hash))))
  (defun resetValueMetrics ()
    (put metrics :hashValueCalls 0) (put metrics :protocolHashComputations 0)
    (put metrics :protocolHashCacheHits 0) (put metrics :hostIdentityAssignments 0) undefined)
  (defun clearValueCaches ()
    (setq protocolHashes (new globalThis.WeakMap) hostObjectHashes (new globalThis.WeakMap)
      hostSymbolHashes (new globalThis.Map) nextHostIdentity 1)
    (resetValueMetrics))
  (defun readValueMetrics () (Object/freeze (Object/assign (js-object) metrics)))
  (export I_EQUIV I_HASH VALUE_EQUAL VALUE_HASH dispatchValueEqual dispatchValueHash
    avalancheHash mixHash finishHash hashString hashNumber hashBigInt hashBoolean hashNull hashUndefined hashGlobalSymbol
    orderedCollectionHash unorderedCollectionHash cachedProtocolHash recordHashValueCall hostIdentityHash
    resetValueMetrics clearValueCaches readValueMetrics))
