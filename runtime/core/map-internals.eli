(module eliscript.runtime.core.map-internals
  (import "./value.mjs" equalValues hashValue)
  (import "../../stdlib/bit.mjs" bit-count)

  ;; JavaScript object-model adapters only. Node layout, HAMT algorithms,
  ;; ownership, iteration state and metrics are maintained below in Eliscript.
  ;; WASM/native persistent maps use stdlib/persistent-map.eli instead of these
  ;; JavaScript class views; foreign class operations are not portable input.
  (defconst host-class
    (js* "(implementation, name) => ({ [name]: class { constructor(...args) { return implementation(this, ...args); } } })[name]"))
  (defconst host-method
    (js* "(implementation, name) => ({ [name](...args) { return implementation(this, ...args); } })[name]"))
  ;; Preserve the native GeneratorFunction brand, non-constructibility and
  ;; Iterator helpers. The delegated traversal and closing algorithm is Eli.
  (defconst host-entry-generator
    (js* "(create) => function* mapEntries(item) { yield* create(item); }"))
  (defun node-instance? (node constructor) (js* "node instanceof constructor"))
  (defconst iterator-symbol (get globalThis.Symbol :iterator))
  (defconst host-object globalThis.Object)
  (defconst host-apply Reflect/apply)
  (defconst no-arguments (Object/freeze (js-array)))

  (defconst MAP_STATE (funcall globalThis.Symbol "eliscript.map.state"))
  (defconst MAP_CONSTRUCTOR_TOKEN (funcall globalThis.Symbol "eliscript.map.constructor"))
  (defconst MAP_NOT_FOUND (funcall globalThis.Symbol "eliscript.map.not-found"))
  (defconst TRANSIENT_MAP_STATE (funcall globalThis.Symbol "eliscript.map.transient-state"))
  (defconst TRANSIENT_MAP_CONSTRUCTOR_TOKEN (funcall globalThis.Symbol "eliscript.map.transient-constructor"))
  (defconst ARRAY_NODE_THRESHOLD 32)
  (defconst BITMAP_NODE_THRESHOLD 24)
  (defconst BRANCH_MASK 31)
  (defconst metrics (js-object :nodeAllocations 0 :nodeVisits 0 :entryAllocations 0
    :keyEqualityChecks 0 :promotions 0 :demotions 0))
  (defconst transientMetrics (js-object :nodeClones 0 :nodeMutations 0 :persistentCalls 0 :invalidCalls 0))

  (defconst MapEntry (funcall host-class
    (lambda (self key value hash)
      (put metrics :entryAllocations (1+ (get metrics :entryAllocations)))
      (put self :key key) (put self :value value) (put self :hash (uint32 hash))
      (Object/freeze self)) "MapEntry"))
  (Object/defineProperty MapEntry "length" (js-object :value 3 :configurable t))
  (defconst BitmapIndexedNode (funcall host-class
    (lambda (self bitmap items owner)
      (when (undefined? bitmap) (setq bitmap 0))
      (when (undefined? items) (setq items (js-array)))
      (when (undefined? owner) (setq owner nil))
      (put metrics :nodeAllocations (1+ (get metrics :nodeAllocations)))
      (put self :bitmap (uint32 bitmap)) (put self :owner owner)
      (put self :items (if (nil? owner) (Object/freeze items) items))
      (when (nil? owner) (Object/freeze self))) "BitmapIndexedNode"))
  (defconst ArrayNode (funcall host-class
    (lambda (self count children owner)
      (when (undefined? owner) (setq owner nil))
      (put metrics :nodeAllocations (1+ (get metrics :nodeAllocations)))
      (put self :count count) (put self :owner owner)
      (put self :children (if (nil? owner) (Object/freeze children) children))
      (when (nil? owner) (Object/freeze self))) "ArrayNode"))
  (Object/defineProperty ArrayNode "length" (js-object :value 2 :configurable t))
  (defconst HashCollisionNode (funcall host-class
    (lambda (self hash entries owner)
      (when (undefined? owner) (setq owner nil))
      (put metrics :nodeAllocations (1+ (get metrics :nodeAllocations)))
      (put self :hash (uint32 hash)) (put self :owner owner)
      (put self :entries (if (nil? owner) (Object/freeze entries) entries))
      (when (nil? owner) (Object/freeze self))) "HashCollisionNode"))
  (Object/defineProperty HashCollisionNode "length" (js-object :value 2 :configurable t))

  (defun editableMapNode (node owner)
    (if (eq (get node :owner) owner) node
      (progn
        (put transientMetrics :nodeClones (1+ (get transientMetrics :nodeClones)))
        (cond
          ((node-instance? node BitmapIndexedNode)
            (new BitmapIndexedNode (get node :bitmap) (js-call (get node :items) :slice) owner))
          ((node-instance? node ArrayNode)
            (new ArrayNode (get node :count) (js-call (get node :children) :slice) owner))
          (t (new HashCollisionNode (get node :hash) (js-call (get node :entries) :slice) owner))))))
  (defun recordTransientNodeMutation ()
    (put transientMetrics :nodeMutations (1+ (get transientMetrics :nodeMutations))) undefined)
  (defun visitNode (node) (put metrics :nodeVisits (1+ (get metrics :nodeVisits))) node)
  (defun keysEqual (left right)
    (put metrics :keyEqualityChecks (1+ (get metrics :keyEqualityChecks))) (equalValues left right))
  (defun branchIndex (hash shift) (bit-and (unsigned-bit-shift-right hash shift) BRANCH_MASK))
  (defun bitPosition (hash shift) (uint32 (bit-shift-left 1 (branchIndex hash shift))))
  (defun packedIndex (bitmap bit) (bit-count (uint32 (bit-and bitmap (uint32 (1- bit))))))
  (defun sameEntry (entry hash key) (and (= (get entry :hash) hash) (keysEqual (get entry :key) key)))

  ;; Sharing the merge path keeps persistent and owner-tagged trees identical.
  ;; A null owner freezes new nodes; an edit owner permits subsequent mutation.
  (defun mergeEntries (shift left right &optional owner)
    (if (= (get left :hash) (get right :hash))
      (new HashCollisionNode (get left :hash) (js-array left right) owner)
      (let ((leftIndex (branchIndex (get left :hash) shift)) (rightIndex (branchIndex (get right :hash) shift)))
        (if (= leftIndex rightIndex)
          (new BitmapIndexedNode (uint32 (bit-shift-left 1 leftIndex))
            (js-array (mergeEntries (+ shift 5) left right owner)) owner)
          (new BitmapIndexedNode (uint32 (bit-or (bit-shift-left 1 leftIndex) (bit-shift-left 1 rightIndex)))
            (if (< leftIndex rightIndex) (js-array left right) (js-array right left)) owner)))))
  (defun mergeCollisionAndEntry (shift node entry &optional owner)
    (let ((nodeIndex (branchIndex (get node :hash) shift)) (entryIndex (branchIndex (get entry :hash) shift)))
      (if (= nodeIndex entryIndex)
        (new BitmapIndexedNode (uint32 (bit-shift-left 1 nodeIndex))
          (js-array (mergeCollisionAndEntry (+ shift 5) node entry owner)) owner)
        (new BitmapIndexedNode (uint32 (bit-or (bit-shift-left 1 nodeIndex) (bit-shift-left 1 entryIndex)))
          (if (< nodeIndex entryIndex) (js-array node entry) (js-array entry node)) owner))))
  (defun assocEntry (entry shift hash key value &optional owner)
    (if (sameEntry entry hash key)
      (if (equalValues (get entry :value) value) (js-object :item entry :added false :changed false)
        (js-object :item (new MapEntry (get entry :key) value (get entry :hash)) :added false :changed t))
      (js-object :item (mergeEntries shift entry (new MapEntry key value hash) owner) :added t :changed t)))
  (defun findEntry (entry hash key notFound)
    (if (sameEntry entry hash key) (get entry :value) notFound))
  (defun collisionIndex (node key)
    (js-call (get node :entries) :findIndex (lambda (entry) (keysEqual (get entry :key) key))))
  (defun findCollisionValue (node key notFound)
    (let* ((entries (get node :entries))
           (iterator (funcall host-apply (aref entries iterator-symbol) entries no-arguments)))
      (unless (iterator-object? iterator) (iterator-fail "iterator must return an object"))
      (let ((next (aref iterator "next")) (found false) (complete false) (value notFound))
        (while (and (not found) (not complete))
          (let ((step (funcall host-apply next iterator no-arguments)))
            (unless (iterator-object? step) (iterator-fail "iterator next must return an object"))
            (setq complete (host-truth (aref step "done")))
            (unless complete
              (let ((entry (aref step "value")))
                (try
                  (when (keysEqual (get entry :key) key)
                    (setq value (get entry :value) found t))
                  (catch error
                    (close-entry-frames (js-object :frames (js-array (js-object :iterator iterator :active t))) t error)))))))
        (when found
          (close-entry-frames (js-object :frames (js-array (js-object :iterator iterator :active t))) false undefined))
        value)))
  (defun promoteBitmapNode (node shift hash key value &optional owner)
    (let ((children (js-call (new globalThis.Array 32) :fill undefined)) (packed 0) (index 0))
      (while (< index 32)
        (when (/= (bit-and (get node :bitmap) (uint32 (bit-shift-left 1 index))) 0)
          (put children index (get (get node :items) packed)) (setq packed (1+ packed)))
        (setq index (1+ index)))
      (put children (branchIndex hash shift) (new MapEntry key value hash))
      (put metrics :promotions (1+ (get metrics :promotions)))
      (new ArrayNode (1+ (js-length (get node :items))) children owner)))
  (defun packArrayNode (children &optional owner removedIndex)
    (let ((bitmap 0) (items (js-array)) (index 0))
      (while (< index 32)
        (let ((child (get children index)))
          (unless (or (eq index removedIndex) (undefined? child))
            (setq bitmap (uint32 (bit-or bitmap (bit-shift-left 1 index)))) (js-call items :push child)))
        (setq index (1+ index)))
      (put metrics :demotions (1+ (get metrics :demotions)))
      (new BitmapIndexedNode bitmap items owner)))

  (defun findInNode (node shift hash key notFound)
    (visitNode node)
    (cond
      ((node-instance? node BitmapIndexedNode)
        (let ((bit (bitPosition hash shift)))
          (if (= (bit-and (get node :bitmap) bit) 0) notFound
            (let ((item (get (get node :items) (packedIndex (get node :bitmap) bit))))
              (if (node-instance? item MapEntry) (findEntry item hash key notFound)
                (findInNode item (+ shift 5) hash key notFound))))))
      ((node-instance? node ArrayNode)
        (let ((item (get (get node :children) (branchIndex hash shift))))
          (cond ((node-instance? item MapEntry) (findEntry item hash key notFound))
            ((undefined? item) notFound) (t (findInNode item (+ shift 5) hash key notFound)))))
      ((/= (get node :hash) hash) notFound)
      (t (findCollisionValue node key notFound))))

  (defun assocNode (node shift hash key value)
    (visitNode node)
    (cond
      ((node-instance? node BitmapIndexedNode)
        (let ((bit (bitPosition hash shift)) (items (get node :items)))
          (let ((index (packedIndex (get node :bitmap) bit)))
            (if (= (bit-and (get node :bitmap) bit) 0)
              (if (>= (1+ (js-length items)) ARRAY_NODE_THRESHOLD)
                (js-object :item (promoteBitmapNode node shift hash key value) :added t :changed t)
                (let ((copy (js-call items :slice)))
                  (js-call copy :splice index 0 (new MapEntry key value hash))
                  (js-object :item (new BitmapIndexedNode (uint32 (bit-or (get node :bitmap) bit)) copy) :added t :changed t)))
              (let* ((existing (get items index))
                     (result (if (node-instance? existing MapEntry) (assocEntry existing (+ shift 5) hash key value)
                       (assocNode existing (+ shift 5) hash key value))))
                (if (not (get result :changed)) (js-object :item node :added false :changed false)
                  (let ((copy (js-call items :slice)))
                    (put copy index (get result :item))
                    (js-object :item (new BitmapIndexedNode (get node :bitmap) copy) :added (get result :added) :changed t))))))))
      ((node-instance? node ArrayNode)
        (let* ((index (branchIndex hash shift)) (children (get node :children)) (existing (get children index)))
          (cond
            ;; Preserve the saturated-branch fast path and its allocation count.
            ((and (= (get node :count) 32) (node-instance? existing MapEntry))
              (if (sameEntry existing hash key)
                (if (equalValues (get existing :value) value) (js-object :item node :added false :changed false)
                  (let ((copy (js-call children :slice)))
                    (put copy index (new MapEntry (get existing :key) value (get existing :hash)))
                    (js-object :item (new ArrayNode (get node :count) copy) :added false :changed t)))
                (let ((replacement (mergeEntries (+ shift 5) existing (new MapEntry key value hash)))
                      (copy (js-call children :slice)))
                  (put copy index replacement)
                  (js-object :item (new ArrayNode (get node :count) copy) :added t :changed t))))
            ((undefined? existing)
              (let ((copy (js-call children :slice)))
                (put copy index (new MapEntry key value hash))
                (js-object :item (new ArrayNode (1+ (get node :count)) copy) :added t :changed t)))
            (t (let ((result (if (node-instance? existing MapEntry) (assocEntry existing (+ shift 5) hash key value)
                              (assocNode existing (+ shift 5) hash key value))))
              (if (not (get result :changed)) (js-object :item node :added false :changed false)
                (let ((copy (js-call children :slice)))
                  (put copy index (get result :item))
                  (js-object :item (new ArrayNode (get node :count) copy) :added (get result :added) :changed t))))))))
      ((/= (get node :hash) hash)
        (js-object :item (mergeCollisionAndEntry shift node (new MapEntry key value hash)) :added t :changed t))
      (t (let* ((entries (get node :entries)) (index (collisionIndex node key)))
        (if (>= index 0)
          (let ((existing (get entries index)))
            (if (equalValues (get existing :value) value) (js-object :item node :added false :changed false)
              (let ((copy (js-call entries :slice)))
                (put copy index (new MapEntry (get existing :key) value hash))
                (js-object :item (new HashCollisionNode hash copy) :added false :changed t))))
          (let ((copy (js-call entries :slice)))
            (js-call copy :push (new MapEntry key value hash))
            (js-object :item (new HashCollisionNode hash copy) :added t :changed t)))))))

  (defun removePackedItem (node bit index)
    (if (= (js-length (get node :items)) 1) undefined
      (let ((items (js-call (get node :items) :slice)))
        (js-call items :splice index 1)
        (new BitmapIndexedNode (uint32 (bit-xor (get node :bitmap) bit)) items))))
  (defun dissocNode (node shift hash key)
    (visitNode node)
    (cond
      ((node-instance? node BitmapIndexedNode)
        (let ((bit (bitPosition hash shift)))
          (if (= (bit-and (get node :bitmap) bit) 0) (js-object :item node :removed false)
            (let* ((index (packedIndex (get node :bitmap) bit)) (existing (get (get node :items) index)))
              (if (node-instance? existing MapEntry)
                (if (sameEntry existing hash key) (js-object :item (removePackedItem node bit index) :removed t)
                  (js-object :item node :removed false))
                (let ((result (dissocNode existing (+ shift 5) hash key)))
                  (cond ((not (get result :removed)) (js-object :item node :removed false))
                    ((undefined? (get result :item)) (js-object :item (removePackedItem node bit index) :removed t))
                    (t (let ((copy (js-call (get node :items) :slice)))
                      (put copy index (get result :item))
                      (js-object :item (new BitmapIndexedNode (get node :bitmap) copy) :removed t))))))))))
      ((node-instance? node ArrayNode)
        (let* ((index (branchIndex hash shift)) (existing (get (get node :children) index)))
          (if (undefined? existing) (js-object :item node :removed false)
            (let ((result (if (node-instance? existing MapEntry)
                            (if (sameEntry existing hash key) (js-object :item undefined :removed t)
                              (js-object :item existing :removed false))
                            (dissocNode existing (+ shift 5) hash key))))
              (if (not (get result :removed)) (js-object :item node :removed false)
                (let ((children (js-call (get node :children) :slice))
                      (count (if (undefined? (get result :item)) (1- (get node :count)) (get node :count))))
                  (put children index (get result :item))
                  (js-object :item (if (<= count BITMAP_NODE_THRESHOLD) (packArrayNode children)
                                    (new ArrayNode count children)) :removed t)))))))
      ((/= (get node :hash) hash) (js-object :item node :removed false))
      (t (let* ((entries (get node :entries)) (index (collisionIndex node key)))
        (cond ((< index 0) (js-object :item node :removed false))
          ((= (js-length entries) 2) (js-object :item (get entries (if (= index 0) 1 0)) :removed t))
          (t (let ((copy (js-call entries :slice)))
            (js-call copy :splice index 1)
            (js-object :item (new HashCollisionNode hash copy) :removed t))))))))

  (defun transientAssocNode (node shift hash key value owner)
    (visitNode node)
    (cond
      ((node-instance? node BitmapIndexedNode)
        (let* ((bit (bitPosition hash shift)) (index (packedIndex (get node :bitmap) bit)))
          (if (= (bit-and (get node :bitmap) bit) 0)
            (if (>= (1+ (js-length (get node :items))) ARRAY_NODE_THRESHOLD)
              (js-object :item (promoteBitmapNode node shift hash key value owner) :added t :changed t)
              (let ((editable (editableMapNode node owner)))
                (put editable :bitmap (uint32 (bit-or (get editable :bitmap) bit)))
                (js-call (get editable :items) :splice index 0 (new MapEntry key value hash))
                (recordTransientNodeMutation) (js-object :item editable :added t :changed t)))
            (let* ((existing (get (get node :items) index))
                   (result (if (node-instance? existing MapEntry) (assocEntry existing (+ shift 5) hash key value owner)
                             (transientAssocNode existing (+ shift 5) hash key value owner))))
              (if (not (get result :changed)) (js-object :item node :added false :changed false)
                (let ((editable (editableMapNode node owner)))
                  (put (get editable :items) index (get result :item))
                  (recordTransientNodeMutation) (js-object :item editable :added (get result :added) :changed t)))))))
      ((node-instance? node ArrayNode)
        (let* ((index (branchIndex hash shift)) (existing (get (get node :children) index)))
          (if (undefined? existing)
            (let ((editable (editableMapNode node owner)))
              (put (get editable :children) index (new MapEntry key value hash))
              (put editable :count (1+ (get editable :count)))
              (recordTransientNodeMutation) (js-object :item editable :added t :changed t))
            (let ((result (if (node-instance? existing MapEntry) (assocEntry existing (+ shift 5) hash key value owner)
                            (transientAssocNode existing (+ shift 5) hash key value owner))))
              (if (not (get result :changed)) (js-object :item node :added false :changed false)
                (let ((editable (editableMapNode node owner)))
                  (put (get editable :children) index (get result :item))
                  (recordTransientNodeMutation) (js-object :item editable :added (get result :added) :changed t)))))))
      ((/= (get node :hash) hash)
        (js-object :item (mergeCollisionAndEntry shift node (new MapEntry key value hash) owner) :added t :changed t))
      (t (let* ((entries (get node :entries)) (index (collisionIndex node key)))
        (if (>= index 0)
          (let ((existing (get entries index)))
            (if (equalValues (get existing :value) value) (js-object :item node :added false :changed false)
              (let ((editable (editableMapNode node owner)))
                (put (get editable :entries) index (new MapEntry (get existing :key) value hash))
                (recordTransientNodeMutation) (js-object :item editable :added false :changed t))))
          (let ((editable (editableMapNode node owner)))
            (js-call (get editable :entries) :push (new MapEntry key value hash))
            (recordTransientNodeMutation) (js-object :item editable :added t :changed t)))))))

  (defun transientRemovePackedItem (node bit index owner)
    (if (= (js-length (get node :items)) 1) undefined
      (let ((editable (editableMapNode node owner)))
        (put editable :bitmap (uint32 (bit-xor (get editable :bitmap) bit)))
        (js-call (get editable :items) :splice index 1)
        (recordTransientNodeMutation) editable)))
  (defun transientDissocNode (node shift hash key owner)
    (visitNode node)
    (cond
      ((node-instance? node BitmapIndexedNode)
        (let ((bit (bitPosition hash shift)))
          (if (= (bit-and (get node :bitmap) bit) 0) (js-object :item node :removed false)
            (let* ((index (packedIndex (get node :bitmap) bit)) (existing (get (get node :items) index)))
              (if (node-instance? existing MapEntry)
                (if (sameEntry existing hash key)
                  (js-object :item (transientRemovePackedItem node bit index owner) :removed t)
                  (js-object :item node :removed false))
                (let ((result (transientDissocNode existing (+ shift 5) hash key owner)))
                  (cond ((not (get result :removed)) (js-object :item node :removed false))
                    ((undefined? (get result :item))
                      (js-object :item (transientRemovePackedItem node bit index owner) :removed t))
                    (t (let ((editable (editableMapNode node owner)))
                      (put (get editable :items) index (get result :item))
                      (recordTransientNodeMutation) (js-object :item editable :removed t))))))))))
      ((node-instance? node ArrayNode)
        (let* ((index (branchIndex hash shift)) (existing (get (get node :children) index)))
          (if (undefined? existing) (js-object :item node :removed false)
            (let ((result (if (node-instance? existing MapEntry)
                            (if (sameEntry existing hash key) (js-object :item undefined :removed t)
                              (js-object :item existing :removed false))
                            (transientDissocNode existing (+ shift 5) hash key owner))))
              (if (not (get result :removed)) (js-object :item node :removed false)
                (let ((count (if (undefined? (get result :item)) (1- (get node :count)) (get node :count))))
                  (if (and (undefined? (get result :item)) (<= count BITMAP_NODE_THRESHOLD))
                    (js-object :item (packArrayNode (get node :children) owner index) :removed t)
                    (let ((editable (editableMapNode node owner)))
                      (put (get editable :children) index (get result :item)) (put editable :count count)
                      (recordTransientNodeMutation) (js-object :item editable :removed t)))))))))
      ((/= (get node :hash) hash) (js-object :item node :removed false))
      (t (let* ((entries (get node :entries)) (index (collisionIndex node key)))
        (cond ((< index 0) (js-object :item node :removed false))
          ((= (js-length entries) 2) (js-object :item (get entries (if (= index 0) 1 0)) :removed t))
          (t (let ((editable (editableMapNode node owner)))
            (js-call (get editable :entries) :splice index 1)
            (recordTransientNodeMutation) (js-object :item editable :removed t))))))))

  (defun mapFind (root hash key notFound) (findInNode root 0 (uint32 hash) key notFound))
  (defun mapAssoc (root hash key value) (assocNode root 0 (uint32 hash) key value))
  (defun mapDissoc (root hash key) (dissocNode root 0 (uint32 hash) key))
  (defun mapAssocTransient (root owner hash key value) (transientAssocNode root 0 (uint32 hash) key value owner))
  (defun mapDissocTransient (root owner hash key) (transientDissocNode root 0 (uint32 hash) key owner))
  (defun mapHash (key) (hashValue key))
  (defun resetCounters (counters)
    (let ((keys (Object/keys counters)) (index 0))
      (while (< index (js-length keys)) (put counters (get keys index) 0) (setq index (1+ index)))) undefined)
  (defun resetMapMetrics () (resetCounters metrics))
  (defun readMapMetrics () (Object/freeze (Object/assign (js-object) metrics)))
  (defun resetTransientMapMetrics () (resetCounters transientMetrics))
  (defun readTransientMapMetrics () (Object/freeze (Object/assign (js-object) transientMetrics)))
  (defun recordTransientMapPersistent ()
    (put transientMetrics :persistentCalls (1+ (get transientMetrics :persistentCalls))) undefined)
  (defun recordInvalidTransientMapCall ()
    (put transientMetrics :invalidCalls (1+ (get transientMetrics :invalidCalls))) undefined)

  ;; Traversal and iterator closing follow below, implemented as a lazy stack.
  (defconst entry-iterator-states (new globalThis.WeakMap))
  (defun host-truth (value) (js* "!!value"))
  (defun iterator-object? (value) (eq (funcall host-object value) value))
  (defun iterator-fail (message) (throw (new globalThis.TypeError message)))
  (defun entry-frame (node) (js-object :node node :initialized false :active false))
  (defun entry-state (self)
    (let ((state (js-call entry-iterator-states :get self)))
      (when (undefined? state) (iterator-fail "map iterator method called on incompatible receiver")) state))
  (defun close-entry-frames (state failed failure)
    (let ((frames (get state :frames)))
      (while (> (js-length frames) 0)
        (let ((frame (js-call frames :pop)))
          (when (get frame :active)
            (try
              (let* ((iterator (get frame :iterator)) (close (aref iterator "return")))
                (unless (nullish? close)
                  (let ((result (funcall host-apply close iterator no-arguments)))
                    (unless (iterator-object? result) (iterator-fail "iterator return must return an object")))))
              (catch error (unless failed (setq failed t failure error)))))))
      (when failed (throw failure))) undefined)
  (defun advance-entry-frames (state)
    (let ((frames (get state :frames)) (ready false) (value undefined))
      (while (and (not ready) (> (js-length frames) 0))
        (let* ((frame (get frames (1- (js-length frames)))) (node (get frame :node)))
          (if (not (get frame :initialized))
            (if (node-instance? node MapEntry)
              (progn (js-call frames :pop) (setq value node ready t))
              (let* ((bitmap (node-instance? node BitmapIndexedNode))
                     (array (and (not bitmap) (node-instance? node ArrayNode)))
                     (items (if bitmap (get node :items) (if array (get node :children) (get node :entries))))
                     (iterator (funcall host-apply (aref items iterator-symbol) items no-arguments)))
                (unless (iterator-object? iterator) (iterator-fail "iterator must return an object"))
                (put frame :next (aref iterator "next")) (put frame :iterator iterator)
                (put frame :array array) (put frame :collision (not (or bitmap array)))
                (put frame :initialized t)))
            (progn
              ;; A failure in next, done or value does not close that iterator;
              ;; a failure in its delegated child does close the parent frame.
              (put frame :active false)
              (let ((step (funcall host-apply (get frame :next) (get frame :iterator) no-arguments)))
                (unless (iterator-object? step) (iterator-fail "iterator next must return an object"))
                (if (host-truth (aref step "done")) (js-call frames :pop)
                  (let ((child (aref step "value")))
                    (put frame :active t)
                    (cond ((get frame :collision) (setq value child ready t))
                      ((and (get frame :array) (undefined? child)) nil)
                      (t (js-call frames :push (entry-frame child)))))))))))
      (unless ready (put state :closed t))
      (js-object :value value :done (not ready))))
  (defun entry-next (self value)
    (let ((state (entry-state self)))
      (when (get state :running) (iterator-fail "Generator is already running"))
      (if (get state :closed) (js-object :value undefined :done t)
        (progn
          (put state :running t)
          (try (advance-entry-frames state)
            (catch error (put state :closed t) (close-entry-frames state t error))
            (finally (put state :running false)))))))
  (defun entry-return (self value)
    (let ((state (entry-state self)))
      (when (get state :running) (iterator-fail "Generator is already running"))
      (put state :running t) (put state :closed t)
      (try
        (close-entry-frames state false undefined)
        (js-object :value value :done t)
        (finally (put state :running false)))))
  (defun entry-throw (self error)
    (let ((state (entry-state self)))
      (when (get state :running) (iterator-fail "Generator is already running"))
      (put state :running t) (put state :closed t)
      (try (close-entry-frames state t error) (finally (put state :running false)))))
  (defun iterator-method (implementation name arity)
    (let ((method (funcall host-method implementation name)))
      (Object/defineProperty method "length" (js-object :value arity :configurable t)) method))
  (defconst entry-iterator-prototype (Object/create (get globalThis.Object :prototype)))
  (Object/defineProperties entry-iterator-prototype
    (js-object
      :next (js-object :value (iterator-method entry-next "next" 1) :writable t :configurable t)
      :return (js-object :value (iterator-method entry-return "return" 1) :writable t :configurable t)
      :throw (js-object :value (iterator-method entry-throw "throw" 1) :writable t :configurable t)))
  (Object/defineProperty entry-iterator-prototype iterator-symbol
    (js-object :value (iterator-method (lambda (self) self) "[Symbol.iterator]" 0) :writable t :configurable t))
  (Object/defineProperty entry-iterator-prototype (get globalThis.Symbol :toStringTag)
    (js-object :value "Generator" :configurable t))
  (defun create-entry-iterator (item)
    (let ((iterator (Object/create entry-iterator-prototype)))
      (js-call entry-iterator-states :set iterator
        (js-object :frames (js-array (entry-frame item)) :running false :closed false)) iterator))
  (defconst mapEntries (funcall host-entry-generator create-entry-iterator))

  (defconst EMPTY_BITMAP_NODE (new BitmapIndexedNode))
  (export MAP_STATE MAP_CONSTRUCTOR_TOKEN MAP_NOT_FOUND TRANSIENT_MAP_STATE TRANSIENT_MAP_CONSTRUCTOR_TOKEN
    ARRAY_NODE_THRESHOLD BITMAP_NODE_THRESHOLD MapEntry BitmapIndexedNode ArrayNode HashCollisionNode
    mapFind mapAssoc mapDissoc mapAssocTransient mapDissocTransient mapEntries mapHash
    resetMapMetrics readMapMetrics resetTransientMapMetrics readTransientMapMetrics
    recordTransientMapPersistent recordInvalidTransientMapCall EMPTY_BITMAP_NODE))
