                      (recordTransientNodeMutation) (js-object :item editable :removed t)))))))))
      ((/= (get node :hash) hash) (js-object :item node :removed false))
      (t (let* ((entries (get node :entries)) (index (collisionIndex node key)))
        (cond ((< index 0) (js-object :item node :removed false))
          ((= (js-length entries) 2) (js-object :item (get entries (if (= index 0) 1 0)) :removed t))
          (t (let ((editable (editableMapNode node owner)))
            (js-call (get editable :entries) :splice index 1)
            (recordTransientNodeMutation) (js-object :item editable :removed t))))))))

  (defun mapFind (root hash key notFound) (findInNode root 0 (uint32 hash) key notFound))
  (defun mapAssoc (root hash key value) (assocNode root 0 (uint32 hash) key value))
  (defun mapDissoc (root hash key) (dissocNode root 0 (uint32 hash) key))
  (defun mapAssocTransient (root owner hash key value) (transientAssocNode root 0 (uint32 hash) key value owner))
  (defun mapDissocTransient (root owner hash key) (transientDissocNode root 0 (uint32 hash) key owner))
  (defun mapHash (key) (hashValue key))
  (defun resetCounters (counters)
    (let ((keys (Object/keys counters)) (index 0))
      (while (< index (js-length keys)) (put counters (get keys index) 0) (setq index (1+ index)))) undefined)
  (defun resetMapMetrics () (resetCounters metrics))
  (defun readMapMetrics () (Object/freeze (Object/assign (js-object) metrics)))
  (defun resetTransientMapMetrics () (resetCounters transientMetrics))
  (defun readTransientMapMetrics () (Object/freeze (Object/assign (js-object) transientMetrics)))
  (defun recordTransientMapPersistent ()
    (put transientMetrics :persistentCalls (1+ (get transientMetrics :persistentCalls))) undefined)
  (defun recordInvalidTransientMapCall ()
    (put transientMetrics :invalidCalls (1+ (get transientMetrics :invalidCalls))) undefined)

  ;; Traversal and iterator closing follow below, implemented as a lazy stack.
  (defconst entry-iterator-states (new globalThis.WeakMap))
  (defun host-truth (value) (js* "!!value"))
  (defun iterator-object? (value) (eq (funcall host-object value) value))
  (defun iterator-fail (message) (throw (new globalThis.TypeError message)))
  (defun entry-frame (node) (js-object :node node :initialized false :active false))
  (defun entry-state (self)
    (let ((state (js-call entry-iterator-states :get self)))
      (when (undefined? state) (iterator-fail "map iterator method called on incompatible receiver")) state))
  (defun close-entry-frames (state failed failure)
    (let ((frames (get state :frames)))
      (while (> (js-length frames) 0)
        (let ((frame (js-call frames :pop)))
          (when (get frame :active)
            (try
              (let* ((iterator (get frame :iterator)) (close (aref iterator "return")))
                (unless (nullish? close)
                  (let ((result (funcall host-apply close iterator no-arguments)))
                    (unless (iterator-object? result) (iterator-fail "iterator return must return an object")))))
              (catch error (unless failed (setq failed t failure error)))))))
      (when failed (throw failure))) undefined)
  (defun advance-entry-frames (state)
    (let ((frames (get state :frames)) (ready false) (value undefined))
      (while (and (not ready) (> (js-length frames) 0))
        (let* ((frame (get frames (1- (js-length frames)))) (node (get frame :node)))
          (if (not (get frame :initialized))
            (if (node-instance? node MapEntry)
              (progn (js-call frames :pop) (setq value node ready t))
              (let* ((bitmap (node-instance? node BitmapIndexedNode))
                     (array (and (not bitmap) (node-instance? node ArrayNode)))
                     (items (if bitmap (get node :items) (if array (get node :children) (get node :entries))))
                     (iterator (funcall host-apply (aref items iterator-symbol) items no-arguments)))
                (unless (iterator-object? iterator) (iterator-fail "iterator must return an object"))
                (put frame :next (aref iterator "next")) (put frame :iterator iterator)
                (put frame :array array) (put frame :collision (not (or bitmap array)))
                (put frame :initialized t)))
            (progn
              ;; A failure in next, done or value does not close that iterator;
              ;; a failure in its delegated child does close the parent frame.
              (put frame :active false)
              (let ((step (funcall host-apply (get frame :next) (get frame :iterator) no-arguments)))
                (unless (iterator-object? step) (iterator-fail "iterator next must return an object"))
                (if (host-truth (aref step "done")) (js-call frames :pop)
                  (let ((child (aref step "value")))
                    (put frame :active t)
                    (cond ((get frame :collision) (setq value child ready t))
                      ((and (get frame :array) (undefined? child)) nil)
                      (t (js-call frames :push (entry-frame child)))))))))))
      (unless ready (put state :closed t))
      (js-object :value value :done (not ready))))
  (defun entry-next (self value)
    (let ((state (entry-state self)))
      (when (get state :running) (iterator-fail "Generator is already running"))
      (if (get state :closed) (js-object :value undefined :done t)
        (progn
          (put state :running t)
          (try (advance-entry-frames state)
            (catch error (put state :closed t) (close-entry-frames state t error))
            (finally (put state :running false)))))))
  (defun entry-return (self value)
    (let ((state (entry-state self)))
      (when (get state :running) (iterator-fail "Generator is already running"))
      (put state :running t) (put state :closed t)
      (try
        (close-entry-frames state false undefined)
        (js-object :value value :done t)
        (finally (put state :running false)))))
  (defun entry-throw (self error)
    (let ((state (entry-state self)))
      (when (get state :running) (iterator-fail "Generator is already running"))
      (put state :running t) (put state :closed t)
      (try (close-entry-frames state t error) (finally (put state :running false)))))
  (defun iterator-method (implementation name arity)
    (let ((method (funcall host-method implementation name)))
      (Object/defineProperty method "length" (js-object :value arity :configurable t)) method))
  (defconst entry-iterator-prototype (Object/create (get globalThis.Object :prototype)))
  (Object/defineProperties entry-iterator-prototype
    (js-object
      :next (js-object :value (iterator-method entry-next "next" 1) :writable t :configurable t)
      :return (js-object :value (iterator-method entry-return "return" 1) :writable t :configurable t)
      :throw (js-object :value (iterator-method entry-throw "throw" 1) :writable t :configurable t)))
  (Object/defineProperty entry-iterator-prototype iterator-symbol
    (js-object :value (iterator-method (lambda (self) self) "[Symbol.iterator]" 0) :writable t :configurable t))
  (Object/defineProperty entry-iterator-prototype (get globalThis.Symbol :toStringTag)
    (js-object :value "Generator" :configurable t))
  (defun create-entry-iterator (item)
    (let ((iterator (Object/create entry-iterator-prototype)))
      (js-call entry-iterator-states :set iterator
        (js-object :frames (js-array (entry-frame item)) :running false :closed false)) iterator))
  (defconst mapEntries (funcall host-entry-generator create-entry-iterator))

  (defconst EMPTY_BITMAP_NODE (new BitmapIndexedNode))
  (defconst PERSISTENT_MAP_ENTRY_TOKEN (funcall globalThis.Symbol "eliscript.map-entry.constructor"))
  (defconst PERSISTENT_MAP_ENTRY_MISSING (funcall globalThis.Symbol "eliscript.map-entry.missing"))
  (defconst MAP_ENTRY_VECTOR_HASH_TAG 1327180861)
  (defconst persistent-map-entry-states (new globalThis.WeakMap))
  (defvar map-entry-vector-factory undefined)
  (defvar map-entry-is-vector undefined)
  (defun registerMapEntryVectorFactory (factory is-vector-fn)
    (setq map-entry-vector-factory factory
          map-entry-is-vector is-vector-fn)
    undefined)
  (defun persistent-entry-state (entry)
    (js-call persistent-map-entry-states :get entry))
  (defun persistent-entry-callable? (value)
    (= (js* "typeof value") "function"))
  (defun make-vector-from-entry (&rest items)
    (unless (persistent-entry-callable? map-entry-vector-factory)
      (throw (new globalThis.TypeError "vector factory must be registered before converting map entries to vectors")))
    (funcall host-apply map-entry-vector-factory undefined items))
  (defconst host-entry-getter
    (js* "(implementation, name) => Object.getOwnPropertyDescriptor({ get [name]() { return implementation(this); } }, name).get"))
  (defconst host-entry-value-generator
    (js* "(states) => function* () { const s = states.get(this); yield s.key; yield s.val; }"))
  (defun entry-define-method (target key name arity implementation)
    (let ((fn (funcall host-method implementation name)))
      (Object/defineProperty fn "length" (js-object :value arity :configurable t))
      (Object/defineProperty target key (js-object :value fn :writable t :configurable t))))
  (defun entry-define-getter (target key name implementation)
    (Object/defineProperty target key
      (js-object :get (funcall host-entry-getter implementation name) :configurable t)))
  (defconst PersistentMapEntry
    (funcall host-class
      (lambda (self token key val metadata)
        (unless (eq token PERSISTENT_MAP_ENTRY_TOKEN)
          (throw (new globalThis.TypeError "PersistentMapEntry values must be created with mapEntry")))
        (when (undefined? metadata) (setq metadata nil))
        (Object/defineProperty self "0" (js-object :value key :writable false :enumerable t :configurable false))
        (Object/defineProperty self "1" (js-object :value val :writable false :enumerable t :configurable false))
        (Object/defineProperty self "length" (js-object :value 2 :writable false :enumerable false :configurable false))
        (js-call persistent-map-entry-states :set self
          (Object/freeze (js-object :key key :val val :metadata metadata)))
        (Object/freeze self))
      "PersistentMapEntry"))
  (defun make-persistent-map-entry (key val &optional metadata)
    (new PersistentMapEntry PERSISTENT_MAP_ENTRY_TOKEN key val (if (undefined? metadata) nil metadata)))
  (defun mapEntry (key val)
    (make-persistent-map-entry key val nil))
  (defun isMapEntry (value)
    (node-instance? value PersistentMapEntry))
  (let ((eproto (get PersistentMapEntry :prototype)))
    (entry-define-getter eproto "key" "key"
      (lambda (self) (get (persistent-entry-state self) :key)))
    (entry-define-getter eproto "val" "val"
      (lambda (self) (get (persistent-entry-state self) :val)))
    (entry-define-getter eproto "count" "count" (lambda (_self) 2))
    (entry-define-getter eproto "size" "size" (lambda (_self) 2))
    (entry-define-method eproto "nth" "nth" 1
      (lambda (self index &rest args)
        (let ((state (persistent-entry-state self))
              (not-found (if (= (js-length args) 0) PERSISTENT_MAP_ENTRY_MISSING (aref args 0))))
          (cond
            ((eq index 0) (get state :key))
            ((eq index 1) (get state :val))
            ((not (eq not-found PERSISTENT_MAP_ENTRY_MISSING)) not-found)
            (t (throw (new globalThis.RangeError
                        (str "map entry nth index " (funcall globalThis.String index) " is outside [0, 2)"))))))))
    (entry-define-method eproto "get" "get" 1
      (lambda (self key &rest args)
        (let ((state (persistent-entry-state self))
              (not-found (if (= (js-length args) 0) nil (aref args 0))))
          (cond
            ((eq key 0) (get state :key))
            ((eq key 1) (get state :val))
            (t not-found)))))
    (entry-define-method eproto "has" "has" 1
      (lambda (_self key) (or (eq key 0) (eq key 1))))
    (entry-define-method eproto "contains" "contains" 1
      (lambda (_self key) (or (eq key 0) (eq key 1))))
    (entry-define-method eproto "peek" "peek" 0
      (lambda (self) (get (persistent-entry-state self) :val)))
    (entry-define-method eproto "pop" "pop" 0
      (lambda (self) (make-vector-from-entry (get (persistent-entry-state self) :key))))
    (entry-define-method eproto "assoc" "assoc" 2
      (lambda (self index value)
        (let ((state (persistent-entry-state self)))
          (cond
            ((eq index 0) (make-vector-from-entry value (get state :val)))
            ((eq index 1) (make-vector-from-entry (get state :key) value))
            ((eq index 2) (make-vector-from-entry (get state :key) (get state :val) value))
            (t (throw (new globalThis.RangeError
                        (str "map entry assoc index " (funcall globalThis.String index) " is outside [0, 2]"))))))))
    (entry-define-method eproto "conj" "conj" 1
      (lambda (self value)
        (let ((state (persistent-entry-state self)))
          (make-vector-from-entry (get state :key) (get state :val) value))))
    (entry-define-method eproto "empty" "empty" 0
      (lambda (self)
        (let ((empty (make-vector-from-entry))
              (meta-value (get (persistent-entry-state self) :metadata)))
          (if (nil? meta-value)
              empty
              (funcall host-apply (aref empty METADATA_WITH) empty (js-array meta-value))))))
    (entry-define-method eproto "seq" "seq" 0
      (lambda (self)
        (sequenceView (lambda () (funcall host-apply (aref self iterator-symbol) self no-arguments)) 2)))
    (entry-define-method eproto "rseq" "rseq" 0
      (lambda (self)
        (sequenceView
          (lambda ()
            (let* ((state (persistent-entry-state self))
                   (items (js-array (get state :val) (get state :key))))
              (funcall host-apply (aref items iterator-symbol) items no-arguments)))
          2)))
    (entry-define-method eproto "reduce" "reduce" 1
      (lambda (self reducer &rest args)
        (unless (persistent-entry-callable? reducer)
          (throw (new globalThis.TypeError "collection reducer must be a function")))
        (let* ((state (persistent-entry-state self))
               (acc (if (= (js-length args) 0)
                        (funcall reducer (get state :key) (get state :val))
                        (let ((first-acc (funcall reducer (aref args 0) (get state :key))))
                          (if (isReducedValue first-acc)
                              first-acc
                              (funcall reducer first-acc (get state :val)))))))
          (unreducedValue acc))))
    (entry-define-method eproto "toJSON" "toJSON" 0
      (lambda (self)
        (let ((state (persistent-entry-state self)))
          (js-array (get state :key) (get state :val)))))
    (entry-define-method eproto COLLECTION_ENTRY_KEY "[eliscript.map-entry.key]" 0
      (lambda (self) (get (persistent-entry-state self) :key)))
    (entry-define-method eproto COLLECTION_ENTRY_VAL "[eliscript.map-entry.val]" 0
      (lambda (self) (get (persistent-entry-state self) :val)))
    (entry-define-method eproto COLLECTION_COUNT "[eliscript.collection.count]" 0
      (lambda (_self) 2))
    (entry-define-method eproto COLLECTION_EMPTY "[eliscript.collection.empty]" 0
      (lambda (self) (js-call self :empty)))
    (entry-define-method eproto COLLECTION_CONJ "[eliscript.collection.conj]" 1
      (lambda (self value) (js-call self :conj value)))
    (entry-define-method eproto COLLECTION_GET "[eliscript.collection.get]" 1
      (lambda (self key &rest args)
        (funcall host-apply (get eproto :get) self (js-call (js-array key) :concat args))))
    (entry-define-method eproto COLLECTION_ASSOC "[eliscript.collection.assoc]" 2
      (lambda (self key value) (js-call self :assoc key value)))
    (entry-define-method eproto COLLECTION_CONTAINS "[eliscript.collection.contains]" 1
      (lambda (self key) (js-call self :has key)))
    (entry-define-method eproto COLLECTION_NTH "[eliscript.collection.nth]" 1
      (lambda (self index &rest args)
        (funcall host-apply (get eproto :nth) self (js-call (js-array index) :concat args))))
    (entry-define-method eproto COLLECTION_SEQ "[eliscript.collection.seq]" 0
      (lambda (self) (js-call self :seq)))
    (entry-define-method eproto COLLECTION_REDUCE "[eliscript.collection.reduce]" 1
      (lambda (self reducer &rest args)
        (funcall host-apply (get eproto :reduce) self (js-call (js-array reducer) :concat args))))
    (entry-define-method eproto COLLECTION_REDUCE_KV "[eliscript.collection.reduceKv]" 2
      (lambda (self reducer initial)
        (unless (persistent-entry-callable? reducer)
          (throw (new globalThis.TypeError "key/value reducer must be a function")))
        (let* ((state (persistent-entry-state self))
               (acc (funcall reducer initial 0 (get state :key))))
          (if (isReducedValue acc)
              (unreducedValue acc)
              (unreducedValue (funcall reducer acc 1 (get state :val)))))))
    (entry-define-method eproto COLLECTION_PEEK "[eliscript.collection.peek]" 0
      (lambda (self) (js-call self :peek)))
    (entry-define-method eproto COLLECTION_POP "[eliscript.collection.pop]" 0
      (lambda (self) (js-call self :pop)))
    (entry-define-method eproto COLLECTION_RSEQ "[eliscript.collection.rseq]" 0
      (lambda (self) (js-call self :rseq)))
    (entry-define-method eproto VALUE_EQUAL "[eliscript.value.equal]" 2
      (lambda (self other equal)
        (let ((state (persistent-entry-state self)))
          (cond
            ((eq self other) t)
            ((isMapEntry other)
             (let ((other-state (persistent-entry-state other)))
               (and (funcall globalThis.Boolean (funcall equal (get state :key) (get other-state :key)))
                    (funcall globalThis.Boolean (funcall equal (get state :val) (get other-state :val))))))
            ((and (persistent-entry-callable? map-entry-is-vector)
                  (funcall map-entry-is-vector other)
                  (= (get other :count) 2))
             (and (funcall globalThis.Boolean (funcall equal (get state :key) (js-call other :nth 0)))
                  (funcall globalThis.Boolean (funcall equal (get state :val) (js-call other :nth 1)))))
            (t false)))))
    (entry-define-method eproto VALUE_HASH "[eliscript.value.hash]" 1
      (lambda (self hash)
        (orderedCollectionHash self hash MAP_ENTRY_VECTOR_HASH_TAG)))
    (entry-define-method eproto METADATA_READ "[eliscript.metadata.read]" 0
      (lambda (self) (get (persistent-entry-state self) :metadata)))
    (entry-define-method eproto METADATA_WITH "[eliscript.metadata.with]" 1
      (lambda (self metadata)
        (let ((state (persistent-entry-state self)))
          (if (eq metadata (get state :metadata))
              self
              (make-persistent-map-entry (get state :key) (get state :val) metadata)))))
    (let ((gen-fn (funcall host-entry-value-generator persistent-map-entry-states)))
      (Object/defineProperty gen-fn "name" (js-object :value "[Symbol.iterator]" :configurable t))
      (Object/defineProperty gen-fn "length" (js-object :value 0 :configurable t))
      (Object/defineProperty eproto iterator-symbol (js-object :value gen-fn :writable t :configurable t)))
    (entry-define-getter eproto (get globalThis.Symbol :toStringTag) "[Symbol.toStringTag]"
      (lambda (_self) "EliscriptPersistentMapEntry")))
  (export MAP_STATE MAP_CONSTRUCTOR_TOKEN MAP_NOT_FOUND TRANSIENT_MAP_STATE TRANSIENT_MAP_CONSTRUCTOR_TOKEN
    ARRAY_NODE_THRESHOLD BITMAP_NODE_THRESHOLD MapEntry PersistentMapEntry BitmapIndexedNode ArrayNode HashCollisionNode
    mapEntry isMapEntry registerMapEntryVectorFactory
    mapFind mapAssoc mapDissoc mapAssocTransient mapDissocTransient mapEntries mapHash
    resetMapMetrics readMapMetrics resetTransientMapMetrics readTransientMapMetrics
    recordTransientMapPersistent recordInvalidTransientMapCall EMPTY_BITMAP_NODE))
