(module eliscript.runtime.core.transient
  (import "./transient-internals.mjs"
    EDITABLE_TRANSIENT
    I_EDITABLE
    I_TRANSIENT_COLLECTION
    TRANSIENT_ASSOC
    TRANSIENT_CONJ
    TRANSIENT_DISSOC
    TRANSIENT_PERSISTENT
    dispatchEditableTransient
    dispatchTransientAssoc
    dispatchTransientConj
    dispatchTransientDissoc
    dispatchTransientPersistent)

  (defconst typeof-value (js* "(value) => typeof value"))
  (defconst IEditable I_EDITABLE)
  (defconst ITransientCollection I_TRANSIENT_COLLECTION)

  (defun callable? (value)
    (= (funcall typeof-value value) "function"))

  (defun transient (collection)
    (if (not (nil? collection))
        (let ((direct (aref collection EDITABLE_TRANSIENT)))
          (if (callable? direct)
              (js-call direct :call collection)
              (dispatchEditableTransient collection)))
        (dispatchEditableTransient collection)))

  (defun conj-one (collection value)
    (if (not (nil? collection))
        (let ((direct (aref collection TRANSIENT_CONJ)))
          (if (callable? direct)
              (js-call direct :call collection value)
              (dispatchTransientConj collection value)))
        (dispatchTransientConj collection value)))

  (defun conjBang (&rest arguments)
    (let ((arg-count (js-length arguments)))
      (cond
        ((= arg-count 0) undefined)
        ((= arg-count 1) (get arguments 0))
        ((= arg-count 2) (conj-one (get arguments 0) (get arguments 1)))
        (t
         (let ((result (get arguments 0))
               (index 1))
           (while (< index arg-count)
             (setq result (conj-one result (get arguments index))
                   index (+ index 1)))
           result)))))

  (defun assoc-one (collection key value)
    (if (and (not (nil? collection))
             (callable? (aref collection TRANSIENT_ASSOC)))
        (js-call (aref collection TRANSIENT_ASSOC) :call collection key value)
        (dispatchTransientAssoc collection key value)))

  (defun assocBang (&rest arguments)
    (let ((arg-count (js-length arguments)))
      (when (or (< arg-count 3) (not (= (mod (- arg-count 3) 2) 0)))
        (throw (new globalThis/TypeError
                 "assocBang requires a transient collection followed by one or more key/value pairs")))
      (let ((result (assoc-one (get arguments 0) (get arguments 1) (get arguments 2)))
            (index 3))
        (while (< index arg-count)
          (setq result (assoc-one result (get arguments index) (get arguments (+ index 1)))
                index (+ index 2)))
        result)))

  (defun dissoc-one (collection key)
    (if (and (not (nil? collection))
             (callable? (aref collection TRANSIENT_DISSOC)))
        (js-call (aref collection TRANSIENT_DISSOC) :call collection key)
        (dispatchTransientDissoc collection key)))

  (defun dissocBang (collection &rest keys)
    (let ((result collection)
          (index 0)
          (limit (js-length keys)))
      (while (< index limit)
        (setq result (dissoc-one result (get keys index))
              index (+ index 1)))
      result))

  (defun persistentBang (collection)
    (if (not (nil? collection))
        (let ((direct (aref collection TRANSIENT_PERSISTENT)))
          (if (callable? direct)
              (js-call direct :call collection)
              (dispatchTransientPersistent collection)))
        (dispatchTransientPersistent collection)))

  (Object/defineProperty conjBang "length" (js-object :value 2 :configurable t))
  (Object/defineProperty assocBang "length" (js-object :value 3 :configurable t))
  (Object/defineProperty dissocBang "length" (js-object :value 1 :configurable t))

  (export
    IEditable
    ITransientCollection
    transient
    conjBang
    assocBang
    dissocBang
    persistentBang))
