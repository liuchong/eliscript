(module eliscript.runtime.core.transient
  (import "./transient-internals.mjs"
    EDITABLE_TRANSIENT
    I_EDITABLE
    I_TRANSIENT_COLLECTION
    I_TRANSIENT_SET
    TRANSIENT_ASSOC
    TRANSIENT_CONJ
    TRANSIENT_DISJ
    TRANSIENT_DISSOC
    TRANSIENT_PERSISTENT
    dispatchEditableTransient
    dispatchTransientAssoc
    dispatchTransientConj
    dispatchTransientDisj
    dispatchTransientDissoc
    dispatchTransientPersistent)

  (defconst typeof-value (js* "(value) => typeof value"))
  (defconst native-call (get (get globalThis.Function :prototype) :call))
  (defconst call-0 (js* "(fn, receiver) => fn.call(receiver)"))
  (defconst call-1 (js* "(fn, receiver, a) => fn.call(receiver, a)"))
  (defconst call-2 (js* "(fn, receiver, a, b) => fn.call(receiver, a, b)"))
  (defconst IEditable I_EDITABLE)
  (defconst ITransientCollection I_TRANSIENT_COLLECTION)
  (defconst ITransientSet I_TRANSIENT_SET)

  (defun callable? (value)
    (= (funcall typeof-value value) "function"))

  (defun transient (collection)
    (if (not (nil? collection))
        (let ((direct (aref collection EDITABLE_TRANSIENT)))
          (if (callable? direct)
              (if (eq (aref direct "call") native-call)
                  (funcall call-0 direct collection)
                  (js-call direct :call collection))
              (dispatchEditableTransient collection)))
        (dispatchEditableTransient collection)))

  (defun conj-one (collection value)
    (if (not (nil? collection))
        (let ((direct (aref collection TRANSIENT_CONJ)))
          (if (callable? direct)
              (if (eq (aref direct "call") native-call)
                  (funcall call-1 direct collection value)
                  (js-call direct :call collection value))
              (dispatchTransientConj collection value)))
        (dispatchTransientConj collection value)))

  (defun conj-many (collection arguments)
    (let ((arg-count (js-length arguments))
          (result collection)
          (index 1))
      (while (< index arg-count)
        (setq result (conj-one result (aref arguments index))
              index (+ index 1)))
      result))

  (defconst conjBang
    (funcall
      (js* "(conjOne, conjMany) => function conjBang(collection, value) { const n = arguments.length; if (n === 2) return conjOne(collection, value); if (n === 1) return collection; if (n === 0) return undefined; return conjMany(collection, arguments); }")
      conj-one
      conj-many))

  (defun assoc-one (collection key value)
    (if (not (nil? collection))
        (let ((direct (aref collection TRANSIENT_ASSOC)))
          (if (callable? direct)
              (if (eq (aref direct "call") native-call)
                  (funcall call-2 direct collection key value)
                  (js-call direct :call collection key value))
              (dispatchTransientAssoc collection key value)))
        (dispatchTransientAssoc collection key value)))

  (defun assoc-many (arguments)
    (let ((arg-count (js-length arguments)))
      (when (or (< arg-count 3) (not (= (mod (- arg-count 3) 2) 0)))
        (throw (new globalThis/TypeError
                 "assocBang requires a transient collection followed by one or more key/value pairs")))
      (let ((result (assoc-one (aref arguments 0) (aref arguments 1) (aref arguments 2)))
            (index 3))
        (while (< index arg-count)
          (setq result (assoc-one result (aref arguments index) (aref arguments (+ index 1)))
                index (+ index 2)))
        result)))

  (defconst assocBang
    (funcall
      (js* "(assocOne, assocMany) => function assocBang(collection, key, value) { const n = arguments.length; if (n === 3) return assocOne(collection, key, value); return assocMany(arguments); }")
      assoc-one
      assoc-many))

  (defun dissoc-one (collection key)
    (if (not (nil? collection))
        (let ((direct (aref collection TRANSIENT_DISSOC)))
          (if (callable? direct)
              (if (eq (aref direct "call") native-call)
                  (funcall call-1 direct collection key)
                  (js-call direct :call collection key))
              (dispatchTransientDissoc collection key)))
        (dispatchTransientDissoc collection key)))

  (defun dissoc-many (collection arguments)
    (let ((result collection)
          (index 1)
          (limit (js-length arguments)))
      (while (< index limit)
        (setq result (dissoc-one result (aref arguments index))
              index (+ index 1)))
      result))

  (defconst dissocBang
    (funcall
      (js* "(dissocOne, dissocMany) => function dissocBang(collection) { const n = arguments.length; if (n === 2) return dissocOne(collection, arguments[1]); if (n <= 1) return collection; return dissocMany(collection, arguments); }")
      dissoc-one
      dissoc-many))

  (defun disj-one (collection value)
    (if (not (nil? collection))
        (let ((direct (aref collection TRANSIENT_DISJ)))
          (if (callable? direct)
              (if (eq (aref direct "call") native-call)
                  (funcall call-1 direct collection value)
                  (js-call direct :call collection value))
              (dispatchTransientDisj collection value)))
        (dispatchTransientDisj collection value)))

  (defun disj-many (collection arguments)
    (let ((result collection)
          (index 1)
          (limit (js-length arguments)))
      (while (< index limit)
        (setq result (disj-one result (aref arguments index))
              index (+ index 1)))
      result))

  (defconst disjBang
    (funcall
      (js* "(disjOne, disjMany) => function disjBang(collection) { const n = arguments.length; if (n === 2) return disjOne(collection, arguments[1]); if (n <= 1) return collection; return disjMany(collection, arguments); }")
      disj-one
      disj-many))

  (defun persistentBang (collection)
    (if (not (nil? collection))
        (let ((direct (aref collection TRANSIENT_PERSISTENT)))
          (if (callable? direct)
              (if (eq (aref direct "call") native-call)
                  (funcall call-0 direct collection)
                  (js-call direct :call collection))
              (dispatchTransientPersistent collection)))
        (dispatchTransientPersistent collection)))

  (export
    IEditable
    ITransientCollection
    ITransientSet
    transient
    conjBang
    assocBang
    dissocBang
    disjBang
    persistentBang))
