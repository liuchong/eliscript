(module capsules.runtime.core.transient
  (js* "import {\n  EDITABLE_TRANSIENT,\n  I_EDITABLE,\n  I_TRANSIENT_COLLECTION,\n  TRANSIENT_ASSOC,\n  TRANSIENT_CONJ,\n  TRANSIENT_DISSOC,\n  TRANSIENT_PERSISTENT,\n  dispatchEditableTransient,\n  dispatchTransientAssoc,\n  dispatchTransientConj,\n  dispatchTransientDissoc,\n  dispatchTransientPersistent,\n} from \"./transient-internals.mjs\";\n\nexport const IEditable = I_EDITABLE;\nexport const ITransientCollection = I_TRANSIENT_COLLECTION;\n\nexport function transient(collection) {\n  if (collection !== null && collection !== undefined) {\n    const direct = collection[EDITABLE_TRANSIENT];\n    if (typeof direct === \"function\") {\n      return direct.call(collection);\n    }\n  }\n  return dispatchEditableTransient(collection);\n}\n\nexport function conjBang(collection, value) {\n  const argCount = arguments.length;\n  if (argCount <= 1) return collection;\n  if (argCount === 2) {\n    if (collection !== null && collection !== undefined) {\n      const direct = collection[TRANSIENT_CONJ];\n      if (typeof direct === \"function\") {\n        return direct.call(collection, value);\n      }\n    }\n    return dispatchTransientConj(collection, value);\n  }\n  let result = collection;\n  for (let index = 1; index < argCount; index += 1) {\n    const nextValue = arguments[index];\n    if (result !== null && result !== undefined) {\n      const direct = result[TRANSIENT_CONJ];\n      if (typeof direct === \"function\") {\n        result = direct.call(result, nextValue);\n        continue;\n      }\n    }\n    result = dispatchTransientConj(result, nextValue);\n  }\n  return result;\n}\n\nexport function assocBang(collection, key, value, ...keyValues) {\n  if (arguments.length < 3 || keyValues.length % 2 !== 0) {\n    throw new TypeError(\n      \"assocBang requires a transient collection followed by one or more key/value pairs\",\n    );\n  }\n  let result;\n  if (collection !== null && collection !== undefined && typeof collection[TRANSIENT_ASSOC] === \"function\