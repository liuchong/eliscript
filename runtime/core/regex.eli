(module eliscript.runtime.core.regex
  (import "./collection.mjs" memoizedSequenceView)
  (import "./vector.mjs" persistentVector)

  (defconst typeof-value (js* "(value) => typeof value"))
  (defconst pattern-states (new globalThis/WeakMap))
  (defconst allowed-flags "imsu")

  (defun fail (message)
    (throw (new globalThis/TypeError message)))

  (defun require-arity (actual expected name)
    (unless (= actual expected)
      (fail (str name " requires exactly " expected " "
                 (if (= expected 1) "argument" "arguments")))))

  (defun require-string (value label)
    (unless (= (funcall typeof-value value) "string")
      (fail (str label " must be a string")))
    value)

  (defun normalize-flags (value)
    (let ((flags (require-string value "regex flags"))
          (seen (new globalThis/Set))
          (index 0)
          (result ""))
      (while (< index (js-length flags))
        (let* ((code (js-call flags :charCodeAt index))
               (width (if (and (>= code 55296)
                               (<= code 56319)
                               (< (1+ index) (js-length flags))
                               (>= (js-call flags :charCodeAt (1+ index)) 56320)
                               (<= (js-call flags :charCodeAt (1+ index)) 57343))
                          2
                          1))
               (flag (js-call flags :slice index (+ index width))))
          (unless (js-call allowed-flags :includes flag)
            (fail (str "regex flags contain unsupported flag: " flag)))
          (when (js-call seen :has flag)
            (fail (str "regex flags contain duplicate flag: " flag)))
          (js-call seen :add flag)
          (setq index (+ index width))))
      (setq index 0)
      (while (< index (js-length allowed-flags))
        (let ((flag (aref allowed-flags index)))
          (when (js-call seen :has flag)
            (setq result (str result flag))))
        (setq index (1+ index)))
      result))

  (defun state-of (pattern)
    (let ((state (js-call pattern-states :get pattern)))
      (when (undefined? state)
        (fail "operation requires an Eliscript regex pattern"))
      state))

  (defun readRegexState (value)
    (js-call pattern-states :get value))

  (defun native-pattern (pattern &rest optional)
    (let ((global (if (or (= (js-length optional) 0) (undefined? (get optional 0)))
                      false
                      (get optional 0)))
          (state (state-of pattern)))
      (new globalThis/RegExp
        (get state :source)
        (if global (str (get state :flags) "g") (get state :flags)))))

  (defun match-value (match)
    (if (= (js-length match) 1)
        (get match 0)
        (let ((values (js-array))
              (index 0))
          (while (< index (js-length match))
            (js-call values :push (if (undefined? (get match index)) nil (get match index)))
            (setq index (1+ index)))
          (apply persistentVector values))))

  (defun require-start (value)
    (unless (and (Number/isSafeInteger value) (>= value 0))
      (fail "regex start must be a non-negative safe integer"))
    value)

  (defun advance-string-index (text index unicode)
    (if (or (not unicode) (>= (1+ index) (js-length text)))
        (1+ index)
        (let ((first-code (js-call text :charCodeAt index)))
          (if (or (< first-code 55296) (> first-code 56319))
              (1+ index)
              (let ((second-code (js-call text :charCodeAt (1+ index))))
                (if (and (>= second-code 56320) (<= second-code 57343))
                    (+ index 2)
                    (1+ index)))))))

  (defun advance-empty-match (matcher text match)
    (when (= (get match 0) "")
      (put matcher "lastIndex"
        (advance-string-index text (get matcher :lastIndex) (get matcher :unicode)))))

  (defun scan-iterator (pattern text start)
    (let ((matcher (native-pattern pattern t))
          (closed false)
          (iterator nil))
      (put matcher "lastIndex" start)
      (setq iterator
        (js-object
          :next (lambda ()
                  (if closed
                      (js-object :value undefined :done t)
                      (try
                        (let ((match (js-call matcher :exec text)))
                          (if (nil? match)
                              (progn
                                (setq closed t)
                                (js-object :value undefined :done t))
                              (progn
                                (advance-empty-match matcher text match)
                                (js-object :value (match-value match) :done false))))
                        (catch error
                          (setq closed t)
                          (throw error)))))
          :return (lambda (&rest optional)
                    (let ((value (if (= (js-length optional) 0) undefined (get optional 0))))
                      (setq closed t)
                      (js-object :value value :done t)))
          :throw (lambda (&rest optional)
                   (let ((error (if (= (js-length optional) 0) undefined (get optional 0))))
                     (setq closed t)
                     (throw error)))))
      (Object/defineProperty iterator (get globalThis/Symbol :iterator)
        (js-object :value (lambda () iterator) :writable t :configurable t))
      iterator))

  (defun compileRegex (&rest arguments)
    (unless (and (>= (js-length arguments) 1) (<= (js-length arguments) 2))
      (fail "compileRegex expects a source and optional flags"))
    (let* ((source (require-string (get arguments 0) "regex source"))
           (flags (normalize-flags (if (= (js-length arguments) 2) (get arguments 1) ""))))
      (try
        (new globalThis/RegExp source flags)
        (catch _error
          (throw (new globalThis/SyntaxError "regex source is invalid"))))
      (let ((pattern (Object/freeze (js-object))))
        (js-call pattern-states :set pattern (Object/freeze (js-object :source source :flags flags)))
        pattern)))

  (defun isRegexPattern (&rest arguments)
    (require-arity (js-length arguments) 1 "isRegexPattern")
    (js-call pattern-states :has (get arguments 0)))

  (defun regexSource (&rest arguments)
    (require-arity (js-length arguments) 1 "regexSource")
    (get (state-of (get arguments 0)) :source))

  (defun regexFlags (&rest arguments)
    (require-arity (js-length arguments) 1 "regexFlags")
    (get (state-of (get arguments 0)) :flags))

  (defun regexMatches (&rest arguments)
    (require-arity (js-length arguments) 2 "regexMatches")
    (let* ((input (require-string (get arguments 1) "regex input"))
           (match (js-call (native-pattern (get arguments 0)) :exec input)))
      (if (and (not (nil? match))
               (= (get match :index) 0)
               (= (js-length (get match 0)) (js-length input)))
          (match-value match)
          nil)))

  (defun regexFind (&rest arguments)
    (unless (and (>= (js-length arguments) 2) (<= (js-length arguments) 3))
      (fail "regexFind expects a pattern, input, and optional start"))
    (let* ((input (require-string (get arguments 1) "regex input"))
           (start (require-start (if (= (js-length arguments) 3) (get arguments 2) 0)))
           (matcher (native-pattern (get arguments 0) t)))
      (put matcher "lastIndex" start)
      (let ((match (js-call matcher :exec input)))
        (if (nil? match) nil (match-value match)))))

  (defun regexSequence (&rest arguments)
    (unless (and (>= (js-length arguments) 2) (<= (js-length arguments) 3))
      (fail "regexSequence expects a pattern, input, and optional start"))
    (let ((pattern (get arguments 0)))
      (state-of pattern)
      (let ((input (require-string (get arguments 1) "regex input"))
            (start (require-start (if (= (js-length arguments) 3) (get arguments 2) 0))))
        (memoizedSequenceView (lambda () (scan-iterator pattern input start))))))

  (defun regexReplace (&rest arguments)
    (require-arity (js-length arguments) 3 "regexReplace")
    (let ((pattern (get arguments 0))
          (replacement (get arguments 1)))
      (state-of pattern)
      (let ((input (require-string (get arguments 2) "regex input")))
        (unless (or (= (funcall typeof-value replacement) "string")
                    (= (funcall typeof-value replacement) "function"))
          (fail "regex replacement must be a string or function"))
        (let ((matcher (native-pattern pattern t))
              (cursor 0)
              (output "")
              (done false))
          (while (not done)
            (let ((match (js-call matcher :exec input)))
              (if (nil? match)
                  (setq done t)
                  (progn
                    (setq output (str output (js-call input :slice cursor (get match :index))))
                    (let ((value (if (= (funcall typeof-value replacement) "function")
                                     (funcall replacement (match-value match) (get match :index) input)
                                     replacement)))
                      (unless (= (funcall typeof-value value) "string")
                        (fail "regex replacement function must return a string"))
                      (setq output (str output value)))
                    (setq cursor (+ (get match :index) (js-length (get match 0))))
                    (advance-empty-match matcher input match)))))
          (str output (js-call input :slice cursor))))))

  (Object/defineProperty isRegexPattern "length" (js-object :value 1 :configurable t))
  (Object/defineProperty regexSource "length" (js-object :value 1 :configurable t))
  (Object/defineProperty regexFlags "length" (js-object :value 1 :configurable t))
  (Object/defineProperty regexMatches "length" (js-object :value 2 :configurable t))
  (Object/defineProperty regexReplace "length" (js-object :value 3 :configurable t))

  (export
    compileRegex
    isRegexPattern
    regexSource
    regexFlags
    regexMatches
    regexFind
    regexSequence
    regexReplace
    readRegexState))
