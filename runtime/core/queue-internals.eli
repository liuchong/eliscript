(module eliscript.runtime.core.queue-internals
  (defconst QUEUE_CONSTRUCTOR_TOKEN (funcall globalThis.Symbol "eliscript.queue.constructor"))
  (defconst QUEUE_STATE (funcall globalThis.Symbol "eliscript.queue.state"))
  (defconst metrics (js-object :queueAllocations 0 :frontPromotions 0 :promotedValues 0))
  (defun recordQueueAllocation ()
    (put metrics :queueAllocations (1+ (get metrics :queueAllocations))) undefined)
  (defun recordQueueFrontPromotion (count)
    (put metrics :frontPromotions (1+ (get metrics :frontPromotions)))
    (put metrics :promotedValues (+ (get metrics :promotedValues) count)) undefined)
  (defun resetQueueMetrics ()
    (put metrics :queueAllocations 0) (put metrics :frontPromotions 0) (put metrics :promotedValues 0) undefined)
  (defun readQueueMetrics () (Object/freeze (Object/assign (js-object) metrics)))
  (export QUEUE_CONSTRUCTOR_TOKEN QUEUE_STATE recordQueueAllocation recordQueueFrontPromotion resetQueueMetrics readQueueMetrics))
