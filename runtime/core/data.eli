(module eliscript.runtime.core.data
  (import "./collection.mjs"
    assoc
    contains
    count
    get
    IIndexed
    IKVReduce
    nth
    reduce
    reduceKV)
  (import "./protocol.mjs" implementsProtocolOperation)
  (import "./map.mjs" EMPTY_MAP)
  (import "./transient.mjs" assocBang conjBang persistentBang transient)
  (import "./transducer.mjs" into)
  (import "./vector.mjs" EMPTY_VECTOR PersistentVector)

  (defconst typeof-value (js* "(value) => typeof value"))
  (defconst MISSING (funcall globalThis/Symbol "eliscript.data.missing"))

  (defun require-function (value label)
    (unless (= (funcall typeof-value value) "function")
      (throw (new globalThis/TypeError (str label " must be a function"))))
    value)

  (defun path-vector (path)
    (into EMPTY_VECTOR path))

  (defun read-entry (entry)
    (unless (= (count entry) 2)
      (throw (new globalThis/TypeError "data entries must contain exactly one key/value pair")))
    (js-array (funcall nth entry 0) (funcall nth entry 1)))

  (defun reduce-entries (collection reducer initial)
    (if (and (implementsProtocolOperation IKVReduce "reduceKV" collection)
             (not (implementsProtocolOperation IIndexed "nth" collection)))
        (reduceKV collection reducer initial)
        (reduce collection
          (lambda (result entry)
            (let (([key value] (read-entry entry)))
              (funcall reducer result key value)))
          initial)))

  (defun collect-buckets (key-function collection create-bucket update-bucket)
    (require-function key-function "data key function")
    (let ((bucket-index (transient EMPTY_MAP))
          (keys (js-array))
          (buckets (js-array)))
      (reduce collection
        (lambda (result value)
          (let* ((key (funcall key-function value))
                 (index (js-call bucket-index :get key MISSING)))
            (if (eq index MISSING)
                (progn
                  (setq index (js-length keys))
                  (assocBang bucket-index key index)
                  (js-call keys :push key)
                  (js-call buckets :push (funcall create-bucket value)))
                (funcall update-bucket buckets index value)))
          result)
        nil)
      (js-object :keys keys :buckets buckets)))

  (defun persistent-map-from-buckets (keys buckets finish-bucket)
    (let ((result (transient EMPTY_MAP))
          (index 0))
      (while (< index (js-length keys))
        (assocBang result (funcall get keys index) (funcall finish-bucket (funcall get buckets index)))
        (setq index (1+ index)))
      (persistentBang result)))

  (defun indexBy (keyFunction collection)
    (require-function keyFunction "indexBy key function")
    (let ((result (transient EMPTY_MAP)))
      (reduce collection
        (lambda (builder value)
          (assocBang builder (funcall keyFunction value) value)
          builder)
        result)
      (persistentBang result)))

  (defun groupBy (keyFunction collection)
    (let ((collected (collect-buckets
                       keyFunction
                       collection
                       (lambda (value) (js-array value))
                       (lambda (values index value)
                         (js-call (funcall get values index) :push value)))))
      (persistent-map-from-buckets
        (get collected :keys)
        (get collected :buckets)
        (lambda (bucket) (js-call PersistentVector :from bucket)))))

  (defun countBy (keyFunction collection)
    (let ((collected (collect-buckets
                       keyFunction
                       collection
                       (lambda () 1)
                       (lambda (counts index _value)
                         (put counts index (1+ (funcall get counts index)))))))
      (persistent-map-from-buckets
        (get collected :keys)
        (get collected :buckets)
        (lambda (cnt) cnt))))

  (defun frequencies (collection)
    (countBy (lambda (value) value) collection))

  (defun getIn (collection path &rest optional)
    (let ((not-found (if (or (= (js-length optional) 0) (undefined? (funcall get optional 0)))
                         nil
                         (funcall get optional 0)))
          (keys (path-vector path))
          (current collection)
          (index 0)
          (done false)
          (result nil))
      (let ((limit (count keys)))
        (while (and (< index limit) (not done))
          (if (nullish? current)
              (setq result not-found done t)
              (progn
                (setq current (funcall get current (funcall nth keys index) MISSING))
                (when (eq current MISSING)
                  (setq result not-found done t))))
          (setq index (1+ index))))
      (if done result current)))

  (defun assocIn (collection path value)
    (let* ((keys (path-vector path))
           (size (count keys)))
      (if (= size 0)
          value
          (let ((parents (js-array))
                (current collection)
                (index 0))
            (while (< index (1- size))
              (js-call parents :push current)
              (if (nullish? current)
                  (setq current EMPTY_MAP)
                  (let ((child (funcall get current (funcall nth keys index) MISSING)))
                    (setq current (if (or (eq child MISSING) (nullish? child)) EMPTY_MAP child))))
              (setq index (1+ index)))
            (let ((result (assoc (if (nullish? current) EMPTY_MAP current)
                                 (funcall nth keys (1- size))
                                 value))
                  (parent-index (- size 2)))
              (while (>= parent-index 0)
                (let ((parent (funcall get parents parent-index)))
                  (setq result (assoc (if (nullish? parent) EMPTY_MAP parent)
                                      (funcall nth keys parent-index)
                                      result)))
                (setq parent-index (1- parent-index)))
              result)))))

  (defun update (collection key transform &rest arguments)
    (require-function transform "update transform")
    (let ((target (if (nullish? collection) EMPTY_MAP collection)))
      (assoc target key (apply transform (js-call (js-array (funcall get target key)) :concat arguments)))))

  (defun updateIn (collection path transform &rest arguments)
    (require-function transform "updateIn transform")
    (assocIn
      collection
      path
      (apply transform (js-call (js-array (getIn collection path)) :concat arguments))))

  (defun keys (collection)
    (let ((result (transient EMPTY_VECTOR)))
      (reduceKV collection
        (lambda (builder key)
          (conjBang builder key)
          builder)
        result)
      (persistentBang result)))

  (defun vals (collection)
    (let ((result (transient EMPTY_VECTOR)))
      (reduceKV collection
        (lambda (builder _key value)
          (conjBang builder value)
          builder)
        result)
      (persistentBang result)))

  (defun updateKeys (collection transform)
    (require-function transform "updateKeys transform")
    (let ((result (transient EMPTY_MAP)))
      (reduceKV collection
        (lambda (builder key value)
          (assocBang builder (funcall transform key) value)
          builder)
        result)
      (persistentBang result)))

  (defun updateVals (collection transform)
    (require-function transform "updateVals transform")
    (let ((result (transient EMPTY_MAP)))
      (reduceKV collection
        (lambda (builder key value)
          (assocBang builder key (funcall transform value))
          builder)
        result)
      (persistentBang result)))

  (defun selectKeys (collection keys-collection)
    (let ((result (transient EMPTY_MAP)))
      (reduce keys-collection
        (lambda (builder key)
          (when (and (not (nullish? collection)) (contains collection key))
            (assocBang builder key (funcall get collection key)))
          builder)
        result)
      (persistentBang result)))

  (defun merge (&rest collections)
    (let ((result (transient EMPTY_MAP))
          (index 0))
      (while (< index (js-length collections))
        (reduce-entries (funcall get collections index)
          (lambda (builder key value)
            (assocBang builder key value)
            builder)
          result)
        (setq index (1+ index)))
      (persistentBang result)))

  (defun mergeWith (combine &rest collections)
    (require-function combine "mergeWith combine function")
    (let ((result EMPTY_MAP)
          (index 0))
      (while (< index (js-length collections))
        (setq result
          (reduce-entries (funcall get collections index)
            (lambda (current key value)
              (assoc current key
                (if (contains current key)
                    (funcall combine (funcall get current key) value)
                    value)))
            result))
        (setq index (1+ index)))
      result))

  (defun zipmap (keys-collection values-collection)
    (let* ((key-vector (path-vector keys-collection))
           (value-vector (path-vector values-collection))
           (size (Math/min (count key-vector) (count value-vector)))
           (result (transient EMPTY_MAP))
           (index 0))
      (while (< index size)
        (assocBang result (funcall nth key-vector index) (funcall nth value-vector index))
        (setq index (1+ index)))
      (persistentBang result)))

  (export
    indexBy
    groupBy
    countBy
    frequencies
    getIn
    assocIn
    update
    updateIn
    keys
    vals
    updateKeys
    updateVals
    selectKeys
    merge
    mergeWith
    zipmap))
