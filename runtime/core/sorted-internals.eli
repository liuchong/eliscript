(module eliscript.runtime.core.sorted-internals
  (import "./value.mjs" equalValues)
  (defconst SORTED_MAP_STATE (funcall globalThis.Symbol "eliscript.sorted-map.state"))
  (defconst SORTED_SET_STATE (funcall globalThis.Symbol "eliscript.sorted-set.state"))
  (defconst metrics (js-object :nodeAllocations 0 :comparisons 0 :rotations 0))
  (defun height (node) (if (nil? node) 0 (get node :height)))
  (defun size (node) (if (nil? node) 0 (get node :size)))
  ;; The bridge preserves new.target, subclass construction and bare-call errors.
  ;; AVL structure, rotations, bounds and metrics are implemented below in Eli.
  (defconst SortedNode (funcall
    (js* "(implementation) => class SortedNode { constructor(key, value, ...children) { return implementation(this, key, value, ...children); } }")
    (lambda (self key value left right)
      (when (undefined? left) (setq left nil))
      (when (undefined? right) (setq right nil))
      (put self :key key) (put self :value value) (put self :left left) (put self :right right)
      (put self :height (1+ (Math/max (height left) (height right))))
      (put self :size (+ (size left) (size right) 1))
      (put metrics :nodeAllocations (1+ (get metrics :nodeAllocations))) (Object/freeze self))))
  (defun node (key value left right) (new SortedNode key value left right))
  (defun rotateLeft (root)
    (let* ((promoted (get root :right))
           (retained (node (get root :key) (get root :value) (get root :left) (get promoted :left))))
      (put metrics :rotations (1+ (get metrics :rotations)))
      (node (get promoted :key) (get promoted :value) retained (get promoted :right))))
  (defun rotateRight (root)
    (let* ((promoted (get root :left))
           (retained (node (get root :key) (get root :value) (get promoted :right) (get root :right))))
      (put metrics :rotations (1+ (get metrics :rotations)))
      (node (get promoted :key) (get promoted :value) (get promoted :left) retained)))
  (defun balance (root)
    (let ((delta (- (height (get root :left)) (height (get root :right)))))
      (cond
        ((> delta 1)
          (let* ((left (get root :left))
                 (prepared (if (< (height (get left :left)) (height (get left :right)))
                   (node (get root :key) (get root :value) (rotateLeft left) (get root :right)) root)))
            (rotateRight prepared)))
        ((< delta -1)
          (let* ((right (get root :right))
                 (prepared (if (< (height (get right :right)) (height (get right :left)))
                   (node (get root :key) (get root :value) (get root :left) (rotateRight right)) root)))
            (rotateLeft prepared)))
        (t root))))
  (defun compareSortedKeys (comparison left right)
    (put metrics :comparisons (1+ (get metrics :comparisons))) (funcall comparison left right))
  (defun sortedFind (root key comparison)
    (let ((current root) (found nil) (done false))
      (while (and (not (nil? current)) (not done))
        (let ((order (compareSortedKeys comparison key (get current :key))))
          (if (eq order 0) (setq found current done t)
            (setq current (get current (if (< order 0) "left" "right")))))) found))
  (defun sortedAssoc (root key value comparison)
    (if (nil? root) (js-object :root (node key value nil nil) :added t :changed t)
      (let ((order (compareSortedKeys comparison key (get root :key))))
        (if (eq order 0)
          (if (equalValues (get root :value) value) (js-object :root root :added false :changed false)
            (js-object :root (node (get root :key) value (get root :left) (get root :right)) :added false :changed t))
          (let* ((side (if (< order 0) "left" "right"))
                 (result (sortedAssoc (get root side) key value comparison)))
            (if (not (get result :changed)) (js-object :root root :added (get result :added) :changed false)
              (let ((updated (if (= side "left")
                      (node (get root :key) (get root :value) (get result :root) (get root :right))
                      (node (get root :key) (get root :value) (get root :left) (get result :root)))))
                (js-object :root (balance updated) :added (get result :added) :changed t))))))))
  (defun minimum (root)
    (let ((current root)) (while (not (nil? (get current :left))) (setq current (get current :left))) current))
  (defun removeMinimum (root)
    (if (nil? (get root :left)) (get root :right)
      (balance (node (get root :key) (get root :value) (removeMinimum (get root :left)) (get root :right)))))
  (defun sortedDissoc (root key comparison)
    (if (nil? root) (js-object :root root :removed false)
      (let ((order (compareSortedKeys comparison key (get root :key))))
        (if (eq order 0)
          (cond
            ((nil? (get root :left)) (js-object :root (get root :right) :removed t))
            ((nil? (get root :right)) (js-object :root (get root :left) :removed t))
            (t (let ((successor (minimum (get root :right))))
              (js-object :root (balance (node (get successor :key) (get successor :value)
                (get root :left) (removeMinimum (get root :right)))) :removed t))))
          (let* ((side (if (< order 0) "left" "right"))
                 (result (sortedDissoc (get root side) key comparison)))
            (if (not (get result :removed)) (js-object :root root :removed false)
              (let ((updated (if (= side "left")
                      (node (get root :key) (get root :value) (get result :root) (get root :right))
                      (node (get root :key) (get root :value) (get root :left) (get result :root)))))
                (js-object :root (balance updated) :removed t))))))))
  (defun host-truth (value) (js* "!!value"))
  (defun eligibleStart (order ascending inclusive)
    (if (host-truth ascending) (or (> order 0) (and (host-truth inclusive) (eq order 0)))
      (or (< order 0) (and (host-truth inclusive) (eq order 0)))))
  (defun pushStart (stack root comparison ascending start)
    (let ((current root))
      (while (not (nil? current))
        (if (or (nil? start) (eligibleStart (compareSortedKeys comparison (get current :key) (get start :key))
                               ascending (get start :inclusive)))
          (progn (js-call stack :push current)
            (setq current (get current (if (host-truth ascending) "left" "right"))))
          (setq current (get current (if (host-truth ascending) "right" "left")))))) undefined)
  (defun beyondEnd (order ascending inclusive)
    (if (host-truth ascending) (or (> order 0) (and (not (host-truth inclusive)) (eq order 0)))
      (or (< order 0) (and (not (host-truth inclusive)) (eq order 0)))))
  (defun create-sorted-iterator (root comparison ascending start end)
    (when (undefined? ascending) (setq ascending t))
    (when (undefined? start) (setq start nil))
    (when (undefined? end) (setq end nil))
    (let ((stack (js-array)) (pending nil) (iterator (js-object)))
      (pushStart stack root comparison ascending start)
      (put iterator :next (lambda ()
        ;; This branch runs only after resumption from the previous yield.
        (unless (nil? pending)
          (pushStart stack (get pending (if (host-truth ascending) "right" "left")) comparison ascending nil)
          (setq pending nil))
        (if (= (js-length stack) 0) (js-object :value undefined :done t)
          (let ((current (js-call stack :pop)))
            (if (and (not (nil? end))
                  (beyondEnd (compareSortedKeys comparison (get current :key) (get end :key)) ascending (get end :inclusive)))
              (progn (put stack :length 0) (js-object :value undefined :done t))
              (progn (setq pending current) (js-object :value current :done false)))))))
      (put iterator :return (lambda (value) (js-object :value value :done t)))
      (put iterator :throw (lambda (error) (throw error)))
      (put iterator (get globalThis.Symbol :iterator) (lambda () iterator)) iterator))
  ;; A native delegation bridge retains GeneratorFunction/Iterator branding;
  ;; no tree traversal or bounds logic is embedded in the JavaScript string.
  (defconst sortedEntries (funcall
    (js* "(create) => function* sortedEntries(root, comparison, ...options) { yield* create(root, comparison, ...options); }")
    create-sorted-iterator))
  (defun resetSortedMetrics ()
    (put metrics :nodeAllocations 0) (put metrics :comparisons 0) (put metrics :rotations 0) undefined)
  (defun readSortedMetrics () (Object/freeze (Object/assign (js-object) metrics)))
  (export SORTED_MAP_STATE SORTED_SET_STATE SortedNode compareSortedKeys sortedFind sortedAssoc sortedDissoc
    sortedEntries resetSortedMetrics readSortedMetrics))
