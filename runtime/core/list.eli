(module eliscript.runtime.core.list
  (import "./collection-internals.mjs"
    COLLECTION_CONJ
    COLLECTION_COUNT
    COLLECTION_EMPTY
    COLLECTION_PEEK
    COLLECTION_POP
    COLLECTION_REDUCE
    COLLECTION_SEQ
    reduceIterable
    sequenceView)
  (import "./list-internals.mjs"
    LIST_CONSTRUCTOR_TOKEN
    LIST_STATE
    recordListNodeAllocation)
  (import "./metadata-internals.mjs"
    METADATA_READ
    METADATA_WITH)
  (import "./value-internals.mjs"
    VALUE_EQUAL
    VALUE_HASH
    orderedCollectionHash)

  (defun instance-of? (value Constructor) (js* "value instanceof Constructor"))
  (defconst host-generator (js* "(create) => function* (...args) { yield* create(this, ...args); }"))
  (defconst MAX_COUNT 2147483647)
  (defconst MISSING (funcall globalThis/Symbol "eliscript.list.missing"))
  (defconst LIST_HASH_TAG 793406745)

  (defun method (implementation name arity)
    (let ((function (funcall
                      (js* "(fn, name) => ({ [name](...args) { return fn(this, ...args); } })[name]")
                      implementation
                      name)))
      (Object/defineProperty function "length" (js-object :value arity :configurable t))
      function))

  (defun define-method (target key name arity implementation)
    (Object/defineProperty
      target
      key
      (js-object
        :value (method implementation name arity)
        :writable t
        :configurable t)))

  (defun define-getter (target key name implementation)
    (Object/defineProperty
      target
      key
      (js-object
        :get (method implementation (str "get " name) 0)
        :configurable t)))

  (defun initialize-persistent-list (self token count empty value rest metadata)
    (unless (eq token LIST_CONSTRUCTOR_TOKEN)
      (throw (new globalThis.TypeError "PersistentList values must be created with persistentList or PersistentList.from")))
    (put self LIST_STATE (Object/freeze (js-object :count count :empty empty :value value :rest rest :metadata metadata)))
    (Object/freeze self))

  (defconst PersistentList
    (funcall (js* "(initialize) => class PersistentList { constructor(token, count, empty, value, rest, metadata = null) { initialize(this, token, count, empty, value, rest, metadata); } }") initialize-persistent-list))

  (defconst EMPTY_LIST
    (new PersistentList LIST_CONSTRUCTOR_TOKEN 0 t undefined nil))

  (defun make-list (count value rest-list &optional metadata)
    (recordListNodeAllocation)
    (new PersistentList
      LIST_CONSTRUCTOR_TOKEN
      count
      false
      value
      rest-list
      (if (undefined? metadata) nil metadata)))

  (defun empty-list-with-metadata (metadata)
    (if (eq metadata nil)
        EMPTY_LIST
        (new PersistentList
          LIST_CONSTRUCTOR_TOKEN
          0
          t
          undefined
          nil
          metadata)))

  (defun list-step-iterator (initial-node)
    (let ((node initial-node))
      (let ((iterator
              (js-object
                :next (method
                        (lambda (_self)
                          (if (get (aref node LIST_STATE) :empty)
                              (js-object :value undefined :done t)
                              (let* ((state (aref node LIST_STATE))
                                     (value (get state :value)))
                                (setq node (get state :rest))
                                (js-object :value value :done false))))
                        "next"
                        0))))
        (put iterator (get globalThis/Symbol :iterator)
              (method (lambda (self) self) "[Symbol.iterator]" 0))
        iterator)))

  (let ((proto (get PersistentList :prototype)))
    (define-method PersistentList "empty" "empty" 0
      (lambda (_self) EMPTY_LIST))
    (define-method PersistentList "from" "from" 1
      (lambda (_self iterable)
        (if (funcall instance-of? iterable PersistentList)
            iterable
            (let ((values (Array/from iterable)))
              (when (> (js-length values) MAX_COUNT)
                (throw (new globalThis/RangeError
                         (str "persistent list cannot exceed " MAX_COUNT " values"))))
              (let ((result EMPTY_LIST)
                    (index (- (js-length values) 1)))
                (while (>= index 0)
                  (setq result (make-list (+ (get result :count) 1) (get values index) result)
                        index (- index 1)))
                result)))))
    (define-getter proto "count" "count"
      (lambda (self) (get (aref self LIST_STATE) :count)))
    (define-getter proto "size" "size"
      (lambda (self) (get (aref self LIST_STATE) :count)))
    (define-getter proto "isEmpty" "isEmpty"
      (lambda (self) (get (aref self LIST_STATE) :empty)))
    (define-method proto "first" "first" 0
      (lambda (self &rest args)
        (let ((not-found (if (= (js-length args) 0) nil (get args 0)))
              (state (aref self LIST_STATE)))
          (if (get state :empty) not-found (get state :value)))))
    (define-method proto "rest" "rest" 0
      (lambda (self)
        (let ((state (aref self LIST_STATE)))
          (if (get state :empty) self (get state :rest)))))
    (define-method proto "peek" "peek" 0
      (lambda (self &rest args)
        (let ((not-found (if (= (js-length args) 0) nil (get args 0))))
          (js-call self :first not-found))))
    (define-method proto "pop" "pop" 0
      (lambda (self)
        (let ((state (aref self LIST_STATE)))
          (when (get state :empty)
            (throw (new globalThis/RangeError "cannot pop an empty persistent list")))
          (get state :rest))))
    (define-method proto "conj" "conj" 1
      (lambda (self value)
        (when (= (get self :count) MAX_COUNT)
          (throw (new globalThis/RangeError
                   (str "persistent list cannot exceed " MAX_COUNT " values"))))
        (make-list (+ (get self :count) 1) value self (get (aref self LIST_STATE) :metadata))))
    (define-method proto "cons" "cons" 1
      (lambda (self value)
        (js-call self :conj value)))
    (define-method proto "nth" "nth" 1
      (lambda (self index &rest args)
        (let ((not-found (if (= (js-length args) 0) MISSING (get args 0))))
          (if (or (not (Number/isInteger index))
                  (< index 0)
                  (>= index (get self :count)))
              (if (not (eq not-found MISSING))
                  not-found
                  (throw (new globalThis/RangeError
                           (str "nth index " (funcall globalThis/String index) " is outside [0, " (get self :count) ")"))))
              (let ((node self)
                    (remaining index))
                (while (> remaining 0)
                  (setq node (get (aref node LIST_STATE) :rest)
                        remaining (- remaining 1)))
                (get (aref node LIST_STATE) :value))))))
    (define-method proto "reduce" "reduce" 1
      (lambda (self reducer &rest initial)
        (apply reduceIterable self reducer initial)))
    (define-method proto "toArray" "toArray" 0
      (lambda (self)
        (Array/from self)))
    (define-method proto COLLECTION_COUNT "[eliscript.collection.count]" 0
      (lambda (self) (get self :count)))
    (define-method proto COLLECTION_EMPTY "[eliscript.collection.empty]" 0
      (lambda (self) (empty-list-with-metadata (get (aref self LIST_STATE) :metadata))))
    (define-method proto COLLECTION_CONJ "[eliscript.collection.conj]" 1
      (lambda (self value) (js-call self :conj value)))
    (define-method proto COLLECTION_PEEK "[eliscript.collection.peek]" 0
      (lambda (self) (js-call self :peek)))
    (define-method proto COLLECTION_POP "[eliscript.collection.pop]" 0
      (lambda (self) (js-call self :pop)))
    (define-method proto COLLECTION_SEQ "[eliscript.collection.seq]" 0
      (lambda (self)
        (if (get self :isEmpty)
            nil
            (sequenceView
              (lambda () (js-call (aref self (get globalThis/Symbol :iterator)) :call self))
              (get self :count)))))
    (define-method proto COLLECTION_REDUCE "[eliscript.collection.reduce]" 1
      (lambda (self reducer &rest initial)
        (apply reduceIterable self reducer initial)))
    (define-method proto VALUE_EQUAL "[eliscript.value.equal]" 2
      (lambda (self other equal)
        (cond
          ((eq self other) t)
          ((or (not (funcall instance-of? other PersistentList))
               (not (= (get other :count) (get self :count))))
           false)
          (t
           (let ((left-node self)
                 (right-node other)
                 (matched t))
             (while (and matched (not (get (aref left-node LIST_STATE) :empty)))
               (let ((left-state (aref left-node LIST_STATE))
                     (right-state (aref right-node LIST_STATE)))
                 (if (not (funcall globalThis/Boolean (funcall equal (get left-state :value) (get right-state :value))))
                     (setq matched false)
                     (setq left-node (get left-state :rest)
                           right-node (get right-state :rest)))))
             matched)))))
    (define-method proto VALUE_HASH "[eliscript.value.hash]" 1
      (lambda (self hash)
        (orderedCollectionHash self hash LIST_HASH_TAG)))
    (define-method proto METADATA_READ "[eliscript.metadata.read]" 0
      (lambda (self) (get (aref self LIST_STATE) :metadata)))
    (define-method proto METADATA_WITH "[eliscript.metadata.with]" 1
      (lambda (self metadata)
        (let ((state (aref self LIST_STATE)))
          (if (eq metadata (get state :metadata))
              self
              (if (get state :empty)
                  (empty-list-with-metadata metadata)
                  (make-list (get state :count) (get state :value) (get state :rest) metadata))))))
    (let ((gen-fn (funcall host-generator (lambda (self) (list-step-iterator self)))))
      (Object/defineProperty gen-fn "name" (js-object :value "[Symbol.iterator]" :configurable t))
      (Object/defineProperty gen-fn "length" (js-object :value 0 :configurable t))
      (Object/defineProperty proto (get globalThis/Symbol :iterator)
        (js-object :value gen-fn :writable t :configurable t)))
    (define-getter proto (get globalThis/Symbol :toStringTag) "[Symbol.toStringTag]"
      (lambda (_self) "EliscriptPersistentList")))

  (defun persistentList (&rest values)
    (js-call PersistentList :from values))

  (defun isPersistentList (value)
    (funcall instance-of? value PersistentList))

  (defun require-list (value operation)
    (unless (funcall instance-of? value PersistentList)
      (throw (new globalThis/TypeError (str operation " expects a persistent List or nil"))))
    value)

  (defun first (value &rest args)
    (let ((not-found (if (= (js-length args) 0) nil (get args 0))))
      (if (nil? value)
          not-found
          (js-call (require-list value "first") :first not-found))))

  (defun rest (value)
    (if (nil? value)
        EMPTY_LIST
        (js-call (require-list value "rest") :rest)))

  (defun cons (value list)
    (js-call (if (nil? list) EMPTY_LIST (require-list list "cons")) :cons value))

  (Object/defineProperty first "length" (js-object :value 1 :configurable t))

  (export
    PersistentList
    EMPTY_LIST
    persistentList
    isPersistentList
    first
    rest
    cons))
