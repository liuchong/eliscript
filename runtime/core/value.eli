(module eliscript.runtime.core.value
  (import "./value-internals.mjs"
    I_EQUIV
    I_HASH
    cachedProtocolHash
    dispatchValueEqual
    dispatchValueHash
    hashBigInt
    hashBoolean
    hashGlobalSymbol
    hashNull
    hashNumber
    hashString
    hashUndefined
    hostIdentityHash
    recordHashValueCall)
  (import "./protocol.mjs" extendProtocolType implementsProtocolOperation)

  (defun typeof-value (value) (js* "typeof value"))
  (defconst IEquiv I_EQUIV)
  (defconst IHash I_HASH)

  (defun extendValueType (ctor implementations)
    (when (or (nil? implementations)
              (not (= (funcall typeof-value implementations) "object"))
              (not (= (funcall typeof-value (get implementations :equal)) "function"))
              (not (= (funcall typeof-value (get implementations :hash)) "function")))
      (throw (new globalThis/TypeError
               "value type extension requires equal and hash functions")))
    (extendProtocolType IEquiv ctor (js-object :equal (get implementations :equal)))
    (extendProtocolType IHash ctor (js-object :hash (get implementations :hash)))
    ctor)

  (defun equal-values-distinct (left right)
    (cond
      ((and (= (funcall typeof-value left) "number")
            (= (funcall typeof-value right) "number"))
       (and (Number/isNaN left) (Number/isNaN right)))
      ((or (nil? left)
           (nil? right)
           (and (not (= (funcall typeof-value left) "object"))
                (not (= (funcall typeof-value left) "function")))
           (and (not (= (funcall typeof-value right) "object"))
                (not (= (funcall typeof-value right) "function"))))
       false)
      ((or (not (implementsProtocolOperation IEquiv "equal" left))
           (not (implementsProtocolOperation IEquiv "equal" right)))
       false)
      (t
       (eq (dispatchValueEqual left right equalValues) t))))

  (defun equalValues (left right)
    ;; The overwhelmingly common identity path stays small enough to inline;
    ;; protocol discovery and recursive comparison remain on the cold path.
    (if (eq left right) t (equal-values-distinct left right)))

  (defun hashValue (value)
    (recordHashValueCall)
    (if (nil? value)
        (hashNull)
        (let ((type (funcall typeof-value value)))
          (cond
            ((= type "undefined") (hashUndefined))
            ((= type "boolean") (hashBoolean value))
            ((= type "number") (hashNumber value))
            ((= type "bigint") (hashBigInt value))
            ((= type "string") (hashString value))
            ((= type "symbol")
             (let ((global-key (js-call globalThis/Symbol :keyFor value)))
               (if (undefined? global-key)
                   (hostIdentityHash value)
                   (hashGlobalSymbol global-key))))
            ((or (= type "function") (= type "object"))
             (if (implementsProtocolOperation IHash "hash" value)
                 (cachedProtocolHash
                   value
                   (lambda () (dispatchValueHash value hashValue)))
                 (hostIdentityHash value)))
            (t
             (throw (new globalThis/TypeError
                      (str "cannot hash JavaScript value of type " type))))))))

  (export
    IEquiv
    IHash
    extendValueType
    equalValues
    hashValue))
