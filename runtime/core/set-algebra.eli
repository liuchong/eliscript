(module eliscript.runtime.core.set-algebra
  (import "./collection.mjs"
    assoc
    conj
    contains
    count
    empty
    get
    reduce
    reduceKV
    reduced)
  (import "./data.mjs" keys merge selectKeys vals)
  (import "./map.mjs" EMPTY_MAP)
  (import "./metadata.mjs" meta withMeta)
  (import "./set.mjs" EMPTY_SET isPersistentHashSet)
  (import "./transient.mjs" assocBang conjBang dissocBang persistentBang transient)
  (import "./truth.mjs" isTruthy)

  (defconst typeof-value (js* "(value) => typeof value"))
  (defconst NOT_FOUND (Object/freeze (js-object)))

  (defun require-arity (actual expected label)
    (unless (= actual expected)
      (throw (new globalThis/TypeError
               (str label " expects " expected " collection" (if (= expected 1) "" "s"))))))

  (defun require-non-empty (actual label)
    (when (= actual 0)
      (throw (new globalThis/TypeError (str label " expects at least one collection")))))

  (defun require-function (value label)
    (unless (= (funcall typeof-value value) "function")
      (throw (new globalThis/TypeError (str label " must be a function"))))
    value)

  (defun require-join-arity (actual)
    (unless (or (= actual 2) (= actual 3))
      (throw (new globalThis/TypeError "join expects 2 or 3 relations"))))

  (defun persistent-map (collection)
    (withMeta (merge collection) (meta collection)))

  (defun first-value (collection)
    (reduce collection (lambda (_missing value) (reduced (js-object :value value))) NOT_FOUND))

  (defun set (&rest arguments)
    (require-arity (js-length arguments) 1 "set")
    (let ((collection (funcall get arguments 0)))
      (if (isPersistentHashSet collection)
          collection
          (let ((result (transient EMPTY_SET)))
            (reduce collection
              (lambda (builder value)
                (conjBang builder value)
                builder)
              result)
            (persistentBang result)))))

  (defun union (&rest collections)
    (if (= (js-length collections) 0)
        EMPTY_SET
        (let ((result (transient (set (funcall get collections 0))))
              (index 1))
          (while (< index (js-length collections))
            (reduce (funcall get collections index)
              (lambda (builder value)
                (conjBang builder value)
                builder)
              result)
            (setq index (1+ index)))
          (persistentBang result))))

  (defun intersect-pair (left right)
    (let* ((left-set (set left))
           (right-set (set right))
           (candidates (if (<= (count left-set) (count right-set)) left-set right-set))
           (membership (if (eq candidates left-set) right-set left-set))
           (builder (transient (empty left-set))))
      (reduce candidates
        (lambda (result value)
          (when (contains membership value)
            (conjBang result value))
          result)
        builder)
      (let ((retained (persistentBang builder)))
        (if (= (count retained) (count left-set)) left-set retained))))

  (defun intersection (&rest collections)
    (require-non-empty (js-length collections) "intersection")
    (let ((result (set (funcall get collections 0)))
          (index 1))
      (while (and (< index (js-length collections)) (> (count result) 0))
        (setq result (intersect-pair result (funcall get collections index)))
        (setq index (1+ index)))
      result))

  (defun difference (&rest collections)
    (require-non-empty (js-length collections) "difference")
    (let ((result (transient (set (funcall get collections 0))))
          (index 1))
      (while (< index (js-length collections))
        (reduce (funcall get collections index)
          (lambda (builder value)
            (dissocBang builder value)
            builder)
          result)
        (setq index (1+ index)))
      (persistentBang result)))

  (defun subset (&rest arguments)
    (require-arity (js-length arguments) 2 "subset")
    (let ((candidates (set (funcall get arguments 0)))
          (membership (set (funcall get arguments 1))))
      (if (> (count candidates) (count membership))
          false
          (reduce candidates
            (lambda (result value)
              (if (contains membership value) result (reduced false)))
            t))))

  (defun superset (&rest arguments)
    (require-arity (js-length arguments) 2 "superset")
    (subset (funcall get arguments 1) (funcall get arguments 0)))

  (defun disjoint (&rest arguments)
    (require-arity (js-length arguments) 2 "disjoint")
    (let* ((left-set (set (funcall get arguments 0)))
           (right-set (set (funcall get arguments 1)))
           (candidates (if (<= (count left-set) (count right-set)) left-set right-set))
           (membership (if (eq candidates left-set) right-set left-set)))
      (reduce candidates
        (lambda (result value)
          (if (contains membership value) (reduced false) result))
        t)))

  (defun select (&rest arguments)
    (require-arity (js-length arguments) 2 "select")
    (let ((predicate (require-function (funcall get arguments 0) "select predicate"))
          (source (set (funcall get arguments 1))))
      (let ((builder (transient source)))
        (reduce source
          (lambda (result value)
            (unless (isTruthy (funcall predicate value))
              (dissocBang result value))
            result)
          builder)
        (let ((selected (persistentBang builder)))
          (if (= (count selected) (count source)) source selected)))))

  (defun project (&rest arguments)
    (require-arity (js-length arguments) 2 "project")
    (let* ((source (set (funcall get arguments 0)))
           (key-set (set (funcall get arguments 1)))
           (builder (transient (empty source))))
      (reduce source
        (lambda (result row)
          (conjBang result (selectKeys row key-set))
          result)
        builder)
      (persistentBang builder)))

  (defun renameKeys (&rest arguments)
    (require-arity (js-length arguments) 2 "renameKeys")
    (let* ((source (persistent-map (funcall get arguments 0)))
           (mappings (persistent-map (funcall get arguments 1)))
           (builder (transient source)))
      (reduceKV mappings
        (lambda (result old-key)
          (dissocBang result old-key)
          result)
        builder)
      (reduceKV mappings
        (lambda (result old-key new-key)
          (when (contains source old-key)
            (assocBang result new-key (funcall get source old-key)))
          result)
        builder)
      (persistentBang builder)))

  (defun rename (&rest arguments)
    (require-arity (js-length arguments) 2 "rename")
    (let* ((source (set (funcall get arguments 0)))
           (mappings (persistent-map (funcall get arguments 1)))
           (builder (transient (empty source))))
      (reduce source
        (lambda (result row)
          (conjBang result (renameKeys row mappings))
          result)
        builder)
      (persistentBang builder)))

  (defun index (&rest arguments)
    (require-arity (js-length arguments) 2 "index")
    (let ((source (set (funcall get arguments 0)))
          (key-set (set (funcall get arguments 1))))
      (reduce source
        (lambda (result row)
          (let* ((indexed-key (selectKeys row key-set))
                 (group (funcall get result indexed-key EMPTY_SET)))
            (assoc result indexed-key (conj group row))))
        EMPTY_MAP)))

  (defun mapInvert (&rest arguments)
    (require-arity (js-length arguments) 1 "mapInvert")
    (let ((collection (funcall get arguments 0))
          (builder (transient EMPTY_MAP)))
      (reduceKV collection
        (lambda (result key value)
          (assocBang result value key)
          result)
        builder)
      (withMeta (persistentBang builder) (meta collection))))

  (defun join-indexed (probe indexed probe-keys key-map builder)
    (reduce probe
      (lambda (result row)
        (let* ((selected (selectKeys row probe-keys))
               (indexed-key (if (nil? key-map) selected (renameKeys selected key-map)))
               (matches (funcall get indexed indexed-key EMPTY_SET)))
          (reduce matches
            (lambda (output matched)
              (conjBang output (merge matched row))
              output)
            result)
          result))
      builder))

  (defun join (&rest arguments)
    (require-join-arity (js-length arguments))
    (let* ((left-set (set (funcall get arguments 0)))
           (right-set (set (funcall get arguments 1)))
           (builder (transient (empty left-set))))
      (if (or (= (count left-set) 0) (= (count right-set) 0))
          (persistentBang builder)
          (if (= (js-length arguments) 2)
              (let* ((left-row (get (first-value left-set) :value))
                     (right-row (get (first-value right-set) :value))
                     (join-keys (intersection (set (keys left-row)) (set (keys right-row))))
                     (indexed-relation (if (<= (count left-set) (count right-set)) left-set right-set))
                     (probe-relation (if (eq indexed-relation left-set) right-set left-set)))
                (persistentBang
                  (join-indexed
                    probe-relation
                    (index indexed-relation join-keys)
                    join-keys
                    nil
                    builder)))
              (let* ((mappings (persistent-map (funcall get arguments 2)))
                     (effective-map (if (<= (count left-set) (count right-set))
                                        (mapInvert mappings)
                                        mappings))
                     (indexed-relation (if (<= (count left-set) (count right-set)) left-set right-set))
                     (probe-relation (if (eq indexed-relation left-set) right-set left-set)))
                (persistentBang
                  (join-indexed
                    probe-relation
                    (index indexed-relation (vals effective-map))
                    (keys effective-map)
                    effective-map
                    builder)))))))

  (Object/defineProperty set "length" (js-object :value 1 :configurable t))
  (Object/defineProperty subset "length" (js-object :value 2 :configurable t))
  (Object/defineProperty superset "length" (js-object :value 2 :configurable t))
  (Object/defineProperty disjoint "length" (js-object :value 2 :configurable t))
  (Object/defineProperty select "length" (js-object :value 2 :configurable t))
  (Object/defineProperty project "length" (js-object :value 2 :configurable t))
  (Object/defineProperty renameKeys "length" (js-object :value 2 :configurable t))
  (Object/defineProperty rename "length" (js-object :value 2 :configurable t))
  (Object/defineProperty index "length" (js-object :value 2 :configurable t))
  (Object/defineProperty mapInvert "length" (js-object :value 1 :configurable t))
  (Object/defineProperty join "length" (js-object :value 3 :configurable t))

  (export
    set
    union
    intersection
    difference
    subset
    superset
    disjoint
    select
    project
    renameKeys
    rename
    index
    mapInvert
    join))
