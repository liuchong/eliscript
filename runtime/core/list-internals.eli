(module eliscript.runtime.core.list-internals
  (defconst LIST_CONSTRUCTOR_TOKEN (funcall globalThis.Symbol "eliscript.list.constructor"))
  (defconst LIST_STATE (funcall globalThis.Symbol "eliscript.list.state"))
  (defconst metrics (js-object :nodeAllocations 0))
  (defun recordListNodeAllocation ()
    (put metrics :nodeAllocations (1+ (get metrics :nodeAllocations))) undefined)
  (defun resetListMetrics () (put metrics :nodeAllocations 0) undefined)
  (defun readListMetrics () (Object/freeze (Object/assign (js-object) metrics)))
  (export LIST_CONSTRUCTOR_TOKEN LIST_STATE recordListNodeAllocation resetListMetrics readListMetrics))
