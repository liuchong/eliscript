(module eliscript.runtime.core.identifier
  (import "./value-internals.mjs" VALUE_EQUAL VALUE_HASH finishHash hashString mixHash)
  (import "./metadata-internals.mjs" METADATA_READ METADATA_WITH)

  (defconst typeof-value (js* "(value) => typeof value"))
  (defconst VALUE_TYPE (js-call globalThis/Symbol :for "eliscript.value.type"))
  (defconst KEYWORD_TYPE "keyword")
  (defconst SYMBOL_TYPE "symbol")

  (defconst KEYWORD_HASH_TAG 795685287)
  (defconst SYMBOL_HASH_TAG 1908952723)
  (defconst UNQUALIFIED_HASH 1251063421)

  (defconst KEYWORD_TOKEN (Object/freeze (js-object)))
  (defconst SYMBOL_TOKEN (Object/freeze (js-object)))
  (defconst keyword-state (new globalThis/WeakMap))
  (defconst symbol-state (new globalThis/WeakMap))
  (defconst keyword-interns (new globalThis/Map))

  (defun logical-type (value)
    (let ((type (funcall typeof-value value)))
      (if (and (or (not (= type "object")) (nil? value))
               (not (= type "function")))
          nil
          (try
            (let ((descriptor (Object/getOwnPropertyDescriptor value VALUE_TYPE)))
              (if (and (not (undefined? descriptor)) (Reflect/has descriptor "value"))
                  (get descriptor :value)
                  nil))
            (catch _error
              nil)))))

  (defun normalize-part (value label)
    (unless (and (= (funcall typeof-value value) "string") (> (js-length value) 0))
      (throw (new globalThis/TypeError (str label " must be a non-empty string"))))
    (when (js-call value :includes "/")
      (throw (new globalThis/TypeError (str label " cannot contain /"))))
    value)

  (defun split-qualified (value label)
    (unless (and (= (funcall typeof-value value) "string") (> (js-length value) 0))
      (throw (new globalThis/TypeError (str label " must be a non-empty string"))))
    (let ((separator (js-call value :indexOf "/")))
      (if (= separator -1)
          (js-object :namespace nil :name value)
          (progn
            (when (or (= separator 0)
                      (= separator (1- (js-length value)))
                      (not (= (js-call value :indexOf "/" (1+ separator)) -1)))
              (throw (new globalThis/TypeError (str label " must be name or namespace/name"))))
            (js-object
              :namespace (js-call value :slice 0 separator)
              :name (js-call value :slice (1+ separator)))))))

  (defun isKeyword (value)
    (= (logical-type value) KEYWORD_TYPE))

  (defun isEliscriptSymbol (value)
    (= (logical-type value) SYMBOL_TYPE))

  (defun isIdentifier (value)
    (or (isKeyword value) (isEliscriptSymbol value)))

  (defun identifierName (value)
    (unless (isIdentifier value)
      (throw (new globalThis/TypeError "expected an Eliscript keyword or symbol")))
    (let ((name (get value :name)))
      (when (or (not (= (funcall typeof-value name) "string"))
                (= (js-length name) 0)
                (js-call name :includes "/"))
        (throw (new globalThis/TypeError "expected an Eliscript keyword or symbol")))
      name))

  (defun identifierNamespace (value)
    (unless (isIdentifier value)
      (throw (new globalThis/TypeError "expected an Eliscript keyword or symbol")))
    (let ((namespace (get value :namespace)))
      (when (and (not (nil? namespace))
                 (or (not (= (funcall typeof-value namespace) "string"))
                     (= (js-length namespace) 0)
                     (js-call namespace :includes "/")))
        (throw (new globalThis/TypeError "expected an Eliscript keyword or symbol")))
      namespace))

  (defun qualifiedIdentifierName (value)
    (let ((namespace (identifierNamespace value))
          (name (identifierName value)))
      (if (nil? namespace) name (str namespace "/" name))))

  (defun normalize-arguments (arguments type predicate)
    (cond
      ((= (js-length arguments) 1)
       (let ((value (get arguments 0)))
         (if (funcall predicate value)
             (js-object
               :existing value
               :namespace (identifierNamespace value)
               :name (identifierName value))
             (let ((parts (split-qualified value (str type " name"))))
               (js-object
                 :existing nil
                 :namespace (get parts :namespace)
                 :name (get parts :name))))))
      ((= (js-length arguments) 2)
       (let ((namespace (get arguments 0))
             (name (get arguments 1)))
         (unless (nil? namespace)
           (normalize-part namespace (str type " namespace")))
         (js-object
           :existing nil
           :namespace namespace
           :name (normalize-part name (str type " name")))))
      (t
       (throw (new globalThis/TypeError
                (str type " expects one qualified name or namespace and name"))))))

  (defun qualified-name (state)
    (if (nil? (get state :namespace))
        (get state :name)
        (str (get state :namespace) "/" (get state :name))))

  (defun identifier-hash (tag state)
    (let ((namespace-hash (if (nil? (get state :namespace))
                              UNQUALIFIED_HASH
                              (hashString (get state :namespace)))))
      (finishHash
        (mixHash (mixHash tag namespace-hash) (hashString (get state :name)))
        2)))

  (defun define-identifier (instance type state table)
    (js-call table :set instance state)
    (Object/defineProperty instance VALUE_TYPE
      (js-object :value type :enumerable false))
    (Object/freeze instance))

  (defun equal-identifier (left-type left-state right)
    (if (not (= (logical-type right) left-type))
        false
        (try
          (and (= (identifierNamespace right) (get left-state :namespace))
               (= (identifierName right) (get left-state :name)))
          (catch _error
            false))))

  (defconst Keyword
    (funcall
      (js* "(init, getName, getNamespace, getQualifiedName, toStringFn, toJSONFn, equalFn, hashFn, VALUE_EQUAL, VALUE_HASH) => class Keyword { constructor(token, namespace, name) { init(this, token, namespace, name); } get name() { return getName(this); } get namespace() { return getNamespace(this); } get qualifiedName() { return getQualifiedName(this); } toString() { return toStringFn(this); } toJSON() { return toJSONFn(); } [VALUE_EQUAL](other) { return equalFn(this, other); } [VALUE_HASH]() { return hashFn(this); } get [Symbol.toStringTag]() { return \"EliscriptKeyword\"; } }")
      (lambda (self token namespace name)
        (unless (eq token KEYWORD_TOKEN)
          (throw (new globalThis/TypeError "Keyword values must be created with keyword()")))
        (define-identifier self KEYWORD_TYPE (js-object :namespace namespace :name name) keyword-state))
      (lambda (self) (get (js-call keyword-state :get self) :name))
      (lambda (self) (get (js-call keyword-state :get self) :namespace))
      (lambda (self) (qualified-name (js-call keyword-state :get self)))
      (lambda (self) (str ":" (get self :qualifiedName)))
      (lambda () (throw (new globalThis/TypeError "Keyword values require an explicit serialization codec")))
      (lambda (self other) (equal-identifier KEYWORD_TYPE (js-call keyword-state :get self) other))
      (lambda (self) (identifier-hash KEYWORD_HASH_TAG (js-call keyword-state :get self)))
      VALUE_EQUAL
      VALUE_HASH))

  (defconst EliscriptSymbol
    (funcall
      (js* "(init, getName, getNamespace, getQualifiedName, toStringFn, toJSONFn, equalFn, hashFn, metaReadFn, metaWithFn, VALUE_EQUAL, VALUE_HASH, METADATA_READ, METADATA_WITH) => class EliscriptSymbol { constructor(token, namespace, name, metadata = null) { init(this, token, namespace, name, metadata); } get name() { return getName(this); } get namespace() { return getNamespace(this); } get qualifiedName() { return getQualifiedName(this); } toString() { return toStringFn(this); } toJSON() { return toJSONFn(); } [VALUE_EQUAL](other) { return equalFn(this, other); } [VALUE_HASH]() { return hashFn(this); } [METADATA_READ]() { return metaReadFn(this); } [METADATA_WITH](metadata) { return metaWithFn(this, metadata); } get [Symbol.toStringTag]() { return \"EliscriptSymbol\"; } }")
      (lambda (self token namespace name metadata)
        (unless (eq token SYMBOL_TOKEN)
          (throw (new globalThis/TypeError
                   "EliscriptSymbol values must be created with eliscriptSymbol()")))
        (define-identifier
          self
          SYMBOL_TYPE
          (js-object :namespace namespace :name name :metadata metadata)
          symbol-state))
      (lambda (self) (get (js-call symbol-state :get self) :name))
      (lambda (self) (get (js-call symbol-state :get self) :namespace))
      (lambda (self) (qualified-name (js-call symbol-state :get self)))
      (lambda (self) (get self :qualifiedName))
      (lambda () (throw (new globalThis/TypeError "EliscriptSymbol values require an explicit serialization codec")))
      (lambda (self other) (equal-identifier SYMBOL_TYPE (js-call symbol-state :get self) other))
      (lambda (self) (identifier-hash SYMBOL_HASH_TAG (js-call symbol-state :get self)))
      (lambda (self) (get (js-call symbol-state :get self) :metadata))
      (lambda (self metadata)
        (let ((state (js-call symbol-state :get self)))
          (if (eq metadata (get state :metadata))
              self
              (new EliscriptSymbol
                SYMBOL_TOKEN
                (get state :namespace)
                (get state :name)
                metadata))))
      VALUE_EQUAL
      VALUE_HASH
      METADATA_READ
      METADATA_WITH))

  (defun keyword (&rest arguments)
    (let ((normalized (normalize-arguments arguments KEYWORD_TYPE isKeyword)))
      (if (not (nil? (get normalized :existing)))
          (get normalized :existing)
          (let* ((key (if (nil? (get normalized :namespace))
                          (get normalized :name)
                          (str (get normalized :namespace) "/" (get normalized :name))))
                 (existing (js-call keyword-interns :get key)))
            (if (not (undefined? existing))
                existing
                (let ((result (new Keyword
                                KEYWORD_TOKEN
                                (get normalized :namespace)
                                (get normalized :name))))
                  (js-call keyword-interns :set key result)
                  result))))))

  (defun eliscriptSymbol (&rest arguments)
    (let ((normalized (normalize-arguments arguments SYMBOL_TYPE isEliscriptSymbol)))
      (if (not (nil? (get normalized :existing)))
          (get normalized :existing)
          (new EliscriptSymbol
            SYMBOL_TOKEN
            (get normalized :namespace)
            (get normalized :name)))))

  (export
    Keyword
    EliscriptSymbol
    keyword
    eliscriptSymbol
    isKeyword
    isEliscriptSymbol
    isIdentifier
    identifierName
    identifierNamespace
    qualifiedIdentifierName))
