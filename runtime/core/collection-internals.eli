(module eliscript.runtime.core.collection-internals
  (import "./protocol.mjs" defineProtocol protocolMethod protocolSlot)
  ;; Only native class/method/getter identity needs host syntax. All validation,
  ;; realization, memoization, slicing, reduction and closing are Eli below.
  (defconst host-class
    (js* "(implementation, name) => ({ [name]: class { constructor(...args) { return implementation(this, ...args); } } })[name]"))
  (defconst host-method
    (js* "(implementation, name) => ({ [name](...args) { return implementation(this, ...args); } })[name]"))
  (defconst host-getter
    (js* "(implementation, name) => Object.getOwnPropertyDescriptor({ get [name]() { return implementation(this); } }, name).get"))
  (defconst host-object globalThis.Object)
  (defconst host-apply Reflect/apply)
  (defconst no-arguments (Object/freeze (js-array)))
  (defun host-type (value) (js* "typeof value"))
  (defun host-truth (value) (js* "!!value"))
  (defun instance? (value constructor) (js* "value instanceof constructor"))
  (defun callable? (value) (= (host-type value) "function"))
  ;; Abstract iterator operations accept every JavaScript Object, whereas
  ;; iteratorFromFactory below intentionally retains its stricter public check.
  (defun iterator-object? (value) (eq (funcall host-object value) value))
  (defun fail (message) (throw (new globalThis.TypeError message)))
  (defun install-method (constructor key implementation arity)
    (let ((method (funcall host-method implementation key)))
      (Object/defineProperty method "length" (js-object :value arity :configurable t))
      (Object/defineProperty (get constructor :prototype) key
        (js-object :value method :writable t :configurable t))))
  (defun install-tag (constructor tag)
    (Object/defineProperty (get constructor :prototype) (get globalThis.Symbol :toStringTag)
      (js-object :get (funcall host-getter (lambda (self) tag) (get globalThis.Symbol :toStringTag)) :configurable t)))
  (defconst I_COUNTED (defineProtocol "ICounted" (js-array "count")))
  (defconst I_EMPTYABLE (defineProtocol "IEmptyable" (js-array "empty")))
  (defconst I_CONJ (defineProtocol "IConj" (js-array "conj")))
  (defconst I_LOOKUP (defineProtocol "ILookup" (js-array "get")))
  (defconst I_ASSOCIATIVE (defineProtocol "IAssociative" (js-array "assoc" "contains")))
  (defconst I_INDEXED (defineProtocol "IIndexed" (js-array "nth")))
  (defconst I_SEQABLE (defineProtocol "ISeqable" (js-array "seq")))
  (defconst I_REDUCE (defineProtocol "IReduce" (js-array "reduce")))
  (defconst I_KV_REDUCE (defineProtocol "IKVReduce" (js-array "reduceKV")))
  (defconst I_MAP (defineProtocol "IMap" (js-array "dissoc")))
  (defconst I_SET (defineProtocol "ISet" (js-array "disj")))
  (defconst I_STACK (defineProtocol "IStack" (js-array "peek" "pop")))
  (defconst I_REVERSIBLE (defineProtocol "IReversible" (js-array "rseq")))
  (defconst COLLECTION_COUNT (protocolSlot I_COUNTED "count"))
  (defconst COLLECTION_EMPTY (protocolSlot I_EMPTYABLE "empty"))
  (defconst COLLECTION_CONJ (protocolSlot I_CONJ "conj"))
  (defconst COLLECTION_GET (protocolSlot I_LOOKUP "get"))
  (defconst COLLECTION_ASSOC (protocolSlot I_ASSOCIATIVE "assoc"))
  (defconst COLLECTION_CONTAINS (protocolSlot I_ASSOCIATIVE "contains"))
  (defconst COLLECTION_NTH (protocolSlot I_INDEXED "nth"))
  (defconst COLLECTION_SEQ (protocolSlot I_SEQABLE "seq"))
  (defconst COLLECTION_REDUCE (protocolSlot I_REDUCE "reduce"))
  (defconst COLLECTION_REDUCE_KV (protocolSlot I_KV_REDUCE "reduceKV"))
  (defconst COLLECTION_DISSOC (protocolSlot I_MAP "dissoc"))
  (defconst COLLECTION_DISJ (protocolSlot I_SET "disj"))
  (defconst COLLECTION_PEEK (protocolSlot I_STACK "peek"))
  (defconst COLLECTION_POP (protocolSlot I_STACK "pop"))
  (defconst COLLECTION_RSEQ (protocolSlot I_REVERSIBLE "rseq"))
  (defconst dispatchCollectionCount (protocolMethod I_COUNTED "count"))
  (defconst dispatchCollectionEmpty (protocolMethod I_EMPTYABLE "empty"))
  (defconst dispatchCollectionConj (protocolMethod I_CONJ "conj"))
  (defconst dispatchCollectionGet (protocolMethod I_LOOKUP "get"))
  (defconst dispatchCollectionAssoc (protocolMethod I_ASSOCIATIVE "assoc"))
  (defconst dispatchCollectionContains (protocolMethod I_ASSOCIATIVE "contains"))
  (defconst dispatchCollectionNth (protocolMethod I_INDEXED "nth"))
  (defconst dispatchCollectionSeq (protocolMethod I_SEQABLE "seq"))
  (defconst dispatchCollectionReduce (protocolMethod I_REDUCE "reduce"))
  (defconst dispatchCollectionReduceKV (protocolMethod I_KV_REDUCE "reduceKV"))
  (defconst dispatchCollectionDissoc (protocolMethod I_MAP "dissoc"))
  (defconst dispatchCollectionDisj (protocolMethod I_SET "disj"))
  (defconst dispatchCollectionPeek (protocolMethod I_STACK "peek"))
  (defconst dispatchCollectionPop (protocolMethod I_STACK "pop"))
  (defconst dispatchCollectionRseq (protocolMethod I_REVERSIBLE "rseq"))
  (defconst NO_INITIAL (funcall globalThis.Symbol "eliscript.collection.no-initial"))
  (defconst REDUCED_STATE (funcall globalThis.Symbol "eliscript.collection.reduced-state"))
  (defconst REDUCTION_STATE (funcall globalThis.Symbol "eliscript.collection.reduction-state"))
  (defconst REDUCTION_TOKEN (funcall globalThis.Symbol "eliscript.collection.reduction-token"))
  (defconst MEMOIZED_SEQUENCE_STATE (funcall globalThis.Symbol "eliscript.collection.memoized-sequence-state"))
  (defconst MEMOIZED_SEQUENCE_TOKEN (funcall globalThis.Symbol "eliscript.collection.memoized-sequence-token"))
  (defconst NO_MEMOIZED_SEQUENCE_FAILURE (funcall globalThis.Symbol "eliscript.collection.no-memoized-sequence-failure"))
  (defconst SEQUENCE_STATE (funcall globalThis.Symbol "eliscript.collection.sequence-state"))
  (defconst SEQUENCE_TOKEN (funcall globalThis.Symbol "eliscript.collection.sequence-token"))
  (defconst UNBOUNDED_SEQUENCE (funcall globalThis.Symbol "eliscript.collection.unbounded-sequence"))
  (defconst iterator-symbol (get globalThis.Symbol :iterator))
  (defun checkedCount (value)
    (unless (and (Number/isSafeInteger value) (>= value 0))
      (fail "collection count must be a non-negative safe integer")) value)
  (defun iteratorFromFactory (factory)
    (let ((iterator (funcall factory)))
      (when (or (nil? iterator) (not (= (host-type iterator) "object")) (not (callable? (get iterator :next))))
        (fail "sequence view factory must return an iterator")) iterator))

  (defconst MemoizedSequenceSource (funcall host-class
    (lambda (self factory)
      (put self :factory factory) (put self :source nil) (put self :values (js-array))
      (put self :started false) (put self :complete false) (put self :failure NO_MEMOIZED_SEQUENCE_FAILURE) self)
    "MemoizedSequenceSource"))
  (Object/defineProperty MemoizedSequenceSource "length" (js-object :value 1 :configurable t))
  (install-method MemoizedSequenceSource "read" (lambda (self index)
    (cond
      ((< index (js-length (get self :values))) (js-object :value (get (get self :values) index) :done false))
      ((not (eq (get self :failure) NO_MEMOIZED_SEQUENCE_FAILURE)) (throw (get self :failure)))
      ((get self :complete) (js-object :value undefined :done t))
      (t
        (unless (get self :started)
          (put self :started t)
          (try
            (put self :source (iteratorFromFactory (get self :factory))) (put self :factory nil)
            (catch error (put self :failure error) (throw error))))
        (try
          (let ((result (js-call (get self :source) :next)))
            (when (or (nil? result) (not (= (host-type result) "object"))
                      (not (= (host-type (get result :done)) "boolean")))
              (fail "sequence iterator must return an iterator result"))
            (if (host-truth (get result :done))
              (progn (put self :complete t) (put self :source nil) (js-object :value undefined :done t))
              (progn (js-call (get self :values) :push (get result :value))
                (js-object :value (get result :value) :done false))))
          (catch error
            (let ((source (get self :source)))
              (put self :failure error) (put self :source nil)
              (when (and (not (nil? source)) (callable? (get source :return)))
                (try (js-call source :return) (catch close-error nil)))
              (throw error))))))) 1)
  (install-method MemoizedSequenceSource "iterator" (lambda (self)
    (let ((index 0) (closed false) (iterator (js-object)))
      (put iterator :next (funcall host-method (lambda (receiver)
        (if closed (js-object :value undefined :done t)
          (let ((result (js-call self :read index)))
            (unless (host-truth (get result :done)) (setq index (1+ index))) result))) "next"))
      (put iterator :return (funcall host-method (lambda (receiver value)
        (setq closed t) (js-object :value value :done t)) "return"))
      (Object/defineProperty (get iterator :return) "length" (js-object :value 1 :configurable t))
      (put iterator iterator-symbol (funcall host-method (lambda (receiver) receiver) iterator-symbol)) iterator)) 0)

  (defun readCollectionEntry (entry)
    (when (or (nullish? entry) (not (callable? (get entry iterator-symbol))))
      (fail "persistent hash map entries must be iterable key/value pairs"))
    (let ((iterator (iteratorFromFactory (lambda () (funcall host-apply (get entry iterator-symbol) entry no-arguments)))) (complete false))
      (try
        (let ((first (js-call iterator :next)))
          (when (host-truth (get first :done)) (fail "persistent hash map entries must contain exactly two values"))
          (let ((second (js-call iterator :next)))
            (when (host-truth (get second :done)) (fail "persistent hash map entries must contain exactly two values"))
            (let ((third (js-call iterator :next)))
              (unless (host-truth (get third :done)) (fail "persistent hash map entries must contain exactly two values")))
            (setq complete t) (js-array (get first :value) (get second :value))))
        (finally (when (and (not complete) (callable? (get iterator :return))) (js-call iterator :return))))))
  (defun sequenceCount (state)
    (cond
      ((eq (get state :count) UNBOUNDED_SEQUENCE)
        (throw (new globalThis.RangeError "unbounded sequence does not have a finite count")))
      ((callable? (get state :count)) (checkedCount (js-call state :count)))
      ((not (nil? (get state :count))) (get state :count))
      (t (let ((iterator (iteratorFromFactory (get state :factory))) (count 0))
        (while (not (host-truth (get (js-call iterator :next) :done)))
          (setq count (1+ count)) (checkedCount count)) count))))
  (defun slicedSequenceCount (state offset)
    (cond
      ((eq (get state :count) UNBOUNDED_SEQUENCE) UNBOUNDED_SEQUENCE)
      ((callable? (get state :count)) (lambda () (Math/max 0 (- (sequenceCount state) offset))))
      ((nil? (get state :count)) nil)
      (t (Math/max 0 (- (get state :count) offset)))))
  (defun prependedSequenceCount (state)
    (cond
      ((eq (get state :count) UNBOUNDED_SEQUENCE) UNBOUNDED_SEQUENCE)
      ((callable? (get state :count)) (lambda () (checkedCount (1+ (sequenceCount state)))))
      ((nil? (get state :count)) nil)
      (t (checkedCount (1+ (get state :count))))))

  (defconst SequenceView (funcall host-class
    (lambda (self token factory count)
      (when (or (not (eq token SEQUENCE_TOKEN)) (not (callable? factory)))
        (fail "SequenceView values must be created by seq"))
      (put self SEQUENCE_STATE (Object/freeze (js-object :factory factory :count count))) (Object/freeze self)) "SequenceView"))
  (Object/defineProperty SequenceView "length" (js-object :value 3 :configurable t))
  (install-method SequenceView COLLECTION_COUNT (lambda (self) (sequenceCount (get self SEQUENCE_STATE))) 0)
  (install-method SequenceView COLLECTION_SEQ (lambda (self)
    (let ((state (get self SEQUENCE_STATE)))
      (cond
        ((eq (get state :count) UNBOUNDED_SEQUENCE) self)
        ((nil? (get state :count))
          (let ((iterator (iteratorFromFactory (get state :factory))))
            (try (if (host-truth (get (js-call iterator :next) :done)) nil self)
              (finally (when (callable? (get iterator :return)) (js-call iterator :return))))))
        (t (if (eq (funcall host-apply (get self COLLECTION_COUNT) self no-arguments) 0) nil self))))) 0)
  (install-method SequenceView COLLECTION_REDUCE (lambda (self reducer &rest initial)
    (funcall host-apply reduceIterable undefined (js-call (js-array self reducer) :concat initial))) 1)
  (install-method SequenceView iterator-symbol (lambda (self) (iteratorFromFactory (get (get self SEQUENCE_STATE) :factory))) 0)
  (install-tag SequenceView "EliscriptSequenceView")

  (defconst MemoizedSequenceView (funcall host-class
    (lambda (self token factory count)
      (when (or (not (eq token MEMOIZED_SEQUENCE_TOKEN)) (not (callable? factory)))
        (fail "MemoizedSequenceView values must be created by memoizedSequenceView"))
      (put self MEMOIZED_SEQUENCE_STATE (Object/freeze (js-object :source (new MemoizedSequenceSource factory) :count count)))
      (Object/freeze self)) "MemoizedSequenceView"))
  (Object/defineProperty MemoizedSequenceView "length" (js-object :value 3 :configurable t))
  (install-method MemoizedSequenceView COLLECTION_COUNT (lambda (self)
    (sequenceCount (js-object :factory (lambda () (funcall host-apply (get self iterator-symbol) self no-arguments))
      :count (get (get self MEMOIZED_SEQUENCE_STATE) :count)))) 0)
  (install-method MemoizedSequenceView COLLECTION_SEQ (lambda (self)
    (let ((iterator (funcall host-apply (get self iterator-symbol) self no-arguments)))
      (try (if (host-truth (get (js-call iterator :next) :done)) nil self)
        (finally (js-call iterator :return))))) 0)
  (install-method MemoizedSequenceView COLLECTION_REDUCE (lambda (self reducer &rest initial)
    (funcall host-apply reduceIterable undefined (js-call (js-array self reducer) :concat initial))) 1)
  (install-method MemoizedSequenceView iterator-symbol (lambda (self)
    (js-call (get (get self MEMOIZED_SEQUENCE_STATE) :source) :iterator)) 0)
  (install-tag MemoizedSequenceView "EliscriptMemoizedSequenceView")

  (defconst ReductionView (funcall host-class
    (lambda (self token reduceFunction)
      (when (or (not (eq token REDUCTION_TOKEN)) (not (callable? reduceFunction)))
        (fail "ReductionView values must be created by reductionView"))
      (put self REDUCTION_STATE reduceFunction) (Object/freeze self)) "ReductionView"))
  (Object/defineProperty ReductionView "length" (js-object :value 2 :configurable t))
  (install-method ReductionView COLLECTION_REDUCE (lambda (self reducer &rest initial)
    (funcall host-apply (get self REDUCTION_STATE) self (js-call (js-array reducer) :concat initial))) 1)
  (install-tag ReductionView "EliscriptReductionView")

  (defun sequenceView (factory count)
    (when (undefined? count) (setq count nil))
    (unless (callable? factory) (fail "sequence view factory must be a function"))
    (if (and (not (nil? count)) (not (callable? count)) (progn (checkedCount count) (eq count 0))) nil
      (new SequenceView SEQUENCE_TOKEN factory count)))
  (Object/defineProperty sequenceView "length" (js-object :value 1 :configurable t))
  (defun unboundedSequenceView (factory)
    (unless (callable? factory) (fail "unbounded sequence view factory must be a function"))
    (new SequenceView SEQUENCE_TOKEN factory UNBOUNDED_SEQUENCE))
  (defun memoizedSequenceView (factory count)
    (when (undefined? count) (setq count nil))
    (unless (callable? factory) (fail "memoized sequence view factory must be a function"))
    (if (and (not (nil? count)) (progn (checkedCount count) (eq count 0))) nil
      (new MemoizedSequenceView MEMOIZED_SEQUENCE_TOKEN factory count)))
  (Object/defineProperty memoizedSequenceView "length" (js-object :value 1 :configurable t))
  (defun memoizedSequenceStatus (value)
    (unless (instance? value MemoizedSequenceView) (fail "expected a memoized sequence view"))
    (let ((source (get (get value MEMOIZED_SEQUENCE_STATE) :source)))
      (Object/freeze (js-object :started (get source :started) :complete (get source :complete)
        :failed (not (eq (get source :failure) NO_MEMOIZED_SEQUENCE_FAILURE)) :realizedCount (js-length (get source :values))))))
  (defun sliceSequenceView (sequence offset)
    (if (nil? sequence) nil
      (progn
        (unless (or (instance? sequence SequenceView) (instance? sequence MemoizedSequenceView))
          (fail "sequence slice expects a SequenceView or nil"))
        (checkedCount offset)
        (if (eq offset 0) sequence
          (let* ((state (if (instance? sequence SequenceView) (get sequence SEQUENCE_STATE)
                    (js-object :factory (lambda () (funcall host-apply (get sequence iterator-symbol) sequence no-arguments))
                      :count (get (get sequence MEMOIZED_SEQUENCE_STATE) :count))))
                 (factory (lambda ()
                   (let ((iterator (funcall host-apply (get sequence iterator-symbol) sequence no-arguments)) (remaining offset) (complete false))
                     (while (and (> remaining 0) (not complete))
                       (if (host-truth (get (js-call iterator :next) :done)) (setq complete t)
                         (setq remaining (1- remaining)))) iterator)))
                 (count (slicedSequenceCount state offset)))
            (if (eq count UNBOUNDED_SEQUENCE) (unboundedSequenceView factory) (sequenceView factory count)))))))
  ;; Delegation preserves the native generator protocol, including throw/return.
  ;; The Eli prefix iterator below decides which values to produce and when.
  (defconst host-prefix-generator (js* "(create) => function* prependedValues(...args) { yield* create(...args); }"))
  (defun prefix-iterator (value sequence)
    (let ((started false) (inner nil) (next undefined) (iterator (js-object)))
      (put iterator :next (lambda (sent)
        (if (not started) (progn (setq started t) (js-object :value value :done false))
          (if (nil? sequence) (js-object :value undefined :done t)
            (progn
              (when (nil? inner)
                (setq inner (funcall host-apply (get sequence iterator-symbol) sequence no-arguments))
                (unless (iterator-object? inner) (fail "iterator must be an object"))
                (setq next (get inner :next) sent undefined))
              (funcall host-apply next inner (js-array sent)))))))
      (put iterator :return (lambda (result)
        (if (nil? inner) (js-object :value result :done t)
          (let ((close (get inner :return)))
            (if (nullish? close) (js-object :value result :done t) (funcall host-apply close inner (js-array result)))))))
      (put iterator :throw (lambda (error)
        (if (nil? inner) (throw error)
          (let ((method (get inner :throw)))
            (if (not (nullish? method)) (funcall host-apply method inner (js-array error))
              (progn
                (let ((close (get inner :return)))
                  (unless (nullish? close)
                    (let ((result (funcall host-apply close inner no-arguments)))
                      (unless (iterator-object? result) (fail "iterator result must be an object")))))
                (fail "The iterator does not provide a throw method")))))))
      (put iterator iterator-symbol (lambda () iterator)) iterator))
  (defun prependSequenceView (value sequence)
    (unless (or (nil? sequence) (instance? sequence SequenceView) (instance? sequence MemoizedSequenceView))
      (fail "sequence prepend expects a SequenceView or nil"))
    (let ((factory (lambda () (funcall (funcall host-prefix-generator prefix-iterator) value sequence))))
      (if (nil? sequence) (sequenceView factory 1)
        (let* ((state (if (instance? sequence SequenceView) (get sequence SEQUENCE_STATE)
                        (js-object :factory (lambda () (funcall host-apply (get sequence iterator-symbol) sequence no-arguments))
                          :count (get (get sequence MEMOIZED_SEQUENCE_STATE) :count))))
               (count (prependedSequenceCount state)))
          (if (eq count UNBOUNDED_SEQUENCE) (unboundedSequenceView factory) (sequenceView factory count))))))
  (defun reductionView (reduceFunction)
    (unless (callable? reduceFunction) (fail "reduction view function must be a function"))
    (new ReductionView REDUCTION_TOKEN reduceFunction))
  (defun reducedValue (value)
    (if (isReducedValue value) value
      (let ((result (Object/create nil)))
        (Object/defineProperty result REDUCED_STATE (js-object :value value)) (Object/freeze result))))
  (defun isReducedValue (value)
    (and (not (nil? value)) (or (= (host-type value) "object") (callable? value))
      (Object/hasOwn value REDUCED_STATE)))
  (defun unreducedValue (value) (if (isReducedValue value) (get value REDUCED_STATE) value))
  (defun close-iterator (iterator)
    (let ((method (get iterator :return)))
      (unless (nullish? method)
        (let ((result (funcall host-apply method iterator no-arguments)))
          (unless (iterator-object? result) (fail "iterator result must be an object"))))))
  (defun reduceIterable (iterable reducer &rest initial)
    (unless (callable? reducer) (fail "collection reducer must be a function"))
    (let* ((accumulator (if (= (js-length initial) 0) NO_INITIAL (aref initial 0)))
           (iterator (funcall host-apply (get iterable iterator-symbol) iterable no-arguments))
           (next undefined) (complete false) (active false) (early false))
      (unless (iterator-object? iterator) (fail "iterator must be an object"))
      (setq next (get iterator :next))
      (try
        (while (and (not complete) (not early))
          (setq active false)
          (let ((step (funcall host-apply next iterator no-arguments)))
            (unless (iterator-object? step) (fail "iterator result must be an object"))
            (if (host-truth (get step :done)) (setq complete t)
              (let ((value (get step :value)))
                (setq active t)
                (if (eq accumulator NO_INITIAL) (setq accumulator value)
                  (progn
                    (setq accumulator (funcall reducer accumulator value))
                    (when (isReducedValue accumulator)
                      (setq accumulator (unreducedValue accumulator) early t))))))))
        (catch error
          (when (and active (not complete))
            (try (close-iterator iterator) (catch close-error nil))) (throw error)))
      (when early (close-iterator iterator))
      (when (eq accumulator NO_INITIAL) (fail "cannot reduce an empty collection without an initial value")) accumulator))
  (defun validateCollectionCount (value) (checkedCount value))
  (export I_COUNTED I_EMPTYABLE I_CONJ I_LOOKUP I_ASSOCIATIVE I_INDEXED I_SEQABLE I_REDUCE I_KV_REDUCE I_MAP I_SET I_STACK I_REVERSIBLE
    COLLECTION_COUNT COLLECTION_EMPTY COLLECTION_CONJ COLLECTION_GET COLLECTION_ASSOC COLLECTION_CONTAINS COLLECTION_NTH COLLECTION_SEQ COLLECTION_REDUCE COLLECTION_REDUCE_KV COLLECTION_DISSOC COLLECTION_DISJ COLLECTION_PEEK COLLECTION_POP COLLECTION_RSEQ
    dispatchCollectionCount dispatchCollectionEmpty dispatchCollectionConj dispatchCollectionGet dispatchCollectionAssoc dispatchCollectionContains dispatchCollectionNth dispatchCollectionSeq dispatchCollectionReduce dispatchCollectionReduceKV dispatchCollectionDissoc dispatchCollectionDisj dispatchCollectionPeek dispatchCollectionPop dispatchCollectionRseq
    readCollectionEntry SequenceView MemoizedSequenceView ReductionView sequenceView unboundedSequenceView
    memoizedSequenceView memoizedSequenceStatus sliceSequenceView prependSequenceView reductionView
    reducedValue isReducedValue unreducedValue reduceIterable validateCollectionCount))
