(module eliscript.runtime.core.metadata
  (import "./map.mjs" isPersistentHashMap)
  (import "./metadata-internals.mjs"
    I_META
    I_WITH_META
    METADATA_READ
    METADATA_WITH
    dispatchMetadataRead
    dispatchMetadataWith)
  (import "./protocol.mjs" implementsProtocolOperation)
  (import "./vector.mjs" readPersistentVectorMetadataReader)
  (import "../array-text.mjs" invokeCapturedArrayText)

  (defun typeof-value (value) (js* "typeof value"))
  (defconst IMeta I_META)
  (defconst IWithMeta I_WITH_META)

  (defun validate-metadata (metadata)
    (when (and (not (nil? metadata)) (not (isPersistentHashMap metadata)))
      (throw (new globalThis/TypeError "metadata must be null or a persistent hash map")))
    metadata)

  (defun supportsMetadata (value)
    (and (implementsProtocolOperation IMeta "meta" value)
         (implementsProtocolOperation IWithMeta "withMeta" value)))

  (defun meta (value)
    (if (not (nullish? value))
        (let ((direct (aref value METADATA_READ)))
          (if (= (funcall typeof-value direct) "function")
              (let* ((call (get direct :call))
                     (reader (readPersistentVectorMetadataReader direct call)))
                (if (undefined? reader)
                  (invokeCapturedArrayText call direct (js-array value))
                  (funcall reader value)))
              (if (implementsProtocolOperation IMeta "meta" value)
                  (dispatchMetadataRead value)
                  nil)))
        (if (implementsProtocolOperation IMeta "meta" value)
            (dispatchMetadataRead value)
            nil)))

  (defun withMeta (value metadata)
    (validate-metadata metadata)
    (if (not (nullish? value))
        (let ((direct (aref value METADATA_WITH)))
          (if (= (funcall typeof-value direct) "function")
              (js-call direct :call value metadata)
              (progn
                (unless (implementsProtocolOperation IWithMeta "withMeta" value)
                  (throw (new globalThis/TypeError "value does not support metadata")))
                (dispatchMetadataWith value metadata))))
        (progn
          (unless (implementsProtocolOperation IWithMeta "withMeta" value)
            (throw (new globalThis/TypeError "value does not support metadata")))
          (dispatchMetadataWith value metadata))))

  (defun varyMeta (value transform &rest arguments)
    (unless (= (funcall typeof-value transform) "function")
      (throw (new globalThis/TypeError "metadata transform must be a function")))
    (withMeta value (apply transform (js-call (js-array (meta value)) :concat arguments))))

  (export
    IMeta
    IWithMeta
    supportsMetadata
    meta
    withMeta
    varyMeta))
