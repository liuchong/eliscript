(module eliscript.runtime.core.order
  (import "./collection.mjs" reduce)
  (import "./identifier.mjs" EliscriptSymbol Keyword qualifiedIdentifierName)
  (import "./list.mjs" PersistentList)
  (import "./protocol.mjs" defineProtocol extendProtocolCategory extendProtocolType protocolMethod)
  (import "./truth.mjs" isTruthy)
  (import "./vector.mjs" EMPTY_VECTOR PersistentVector)

  (defun typeof-value (value) (js* "typeof value"))
  (defun instance-of? (value Constructor) (js* "value instanceof Constructor"))
  (defun host-less (left right) (js* "left < right"))
  (defun host-number-difference (left right) (js* "left - right"))
  (defconst IComparable (defineProtocol "IComparable" (js-array "compare")))
  (defconst dispatch-compare (protocolMethod IComparable "compare"))

  (defun require-function (value label)
    (unless (= (funcall typeof-value value) "function")
      (throw (new globalThis/TypeError (str label " must be a function"))))
    value)

  (defun comparison-result (value label)
    (unless (and (= (funcall typeof-value value) "number") (Number/isFinite value))
      (throw (new globalThis/TypeError (str label " must return a finite number"))))
    (if (< value 0) -1 (if (> value 0) 1 0)))

  (defun type-name (value)
    (cond
      ((nil? value) "null")
      ((undefined? value) "undefined")
      ((funcall instance-of? value Keyword) "keyword")
      ((funcall instance-of? value EliscriptSymbol) "symbol")
      ((funcall instance-of? value PersistentVector) "vector")
      ((funcall instance-of? value PersistentList) "list")
      (t (funcall typeof-value value))))

  (defun require-comparable-type (right predicate left-name)
    (unless (funcall predicate right)
      (throw (new globalThis/TypeError (str "cannot compare " left-name " to " (type-name right)))))
    right)

  (defun compare-primitive (left right predicate name)
    (require-comparable-type right predicate name)
    (if (< left right) -1 (if (> left right) 1 0)))

  (defun compare-number (left right)
    (require-comparable-type right (lambda (value) (= (funcall typeof-value value) "number")) "number")
    (cond
      ((Number/isNaN left) (if (Number/isNaN right) 0 1))
      ((Number/isNaN right) -1)
      ((< left right) -1)
      ((> left right) 1)
      (t 0)))

  (defun compare-identifier (left right ctor name)
    (require-comparable-type right (lambda (value) (funcall instance-of? value ctor)) name)
    (compare-primitive
      (qualifiedIdentifierName left)
      (qualifiedIdentifierName right)
      (lambda (value) (= (funcall typeof-value value) "string"))
      "string"))

  (defun compare-sequential (left right ctor name)
    (require-comparable-type right (lambda (value) (funcall instance-of? value ctor)) name)
    (if (eq left right)
        0
        (let ((left-iterator (js-call (aref left (get globalThis/Symbol :iterator)) :call left))
              (right-iterator (js-call (aref right (get globalThis/Symbol :iterator)) :call right))
              (done false)
              (result 0))
          (while (not done)
            (let ((left-item (js-call left-iterator :next))
                  (right-item (js-call right-iterator :next)))
              (if (or (funcall globalThis/Boolean (get left-item :done))
                      (funcall globalThis/Boolean (get right-item :done)))
                  (setq result (if (= (get left-item :done) (get right-item :done))
                                   0
                                   (if (funcall globalThis/Boolean (get left-item :done)) -1 1))
                        done t)
                  (let ((order (compareValues (get left-item :value) (get right-item :value))))
                    (unless (= order 0)
                      (setq result order done t))))))
          result)))

  (extendProtocolCategory IComparable "boolean"
    (js-object :compare
      (lambda (left right)
        (compare-primitive left right (lambda (value) (= (funcall typeof-value value) "boolean")) "boolean"))))
  (extendProtocolCategory IComparable "number" (js-object :compare compare-number))
  (extendProtocolCategory IComparable "bigint"
    (js-object :compare
      (lambda (left right)
        (compare-primitive left right (lambda (value) (= (funcall typeof-value value) "bigint")) "bigint"))))
  (extendProtocolCategory IComparable "string"
    (js-object :compare
      (lambda (left right)
        (compare-primitive left right (lambda (value) (= (funcall typeof-value value) "string")) "string"))))
  (extendProtocolType IComparable Keyword
    (js-object :compare (lambda (left right) (compare-identifier left right Keyword "keyword"))))
  (extendProtocolType IComparable EliscriptSymbol
    (js-object :compare (lambda (left right) (compare-identifier left right EliscriptSymbol "symbol"))))
  (extendProtocolType IComparable PersistentVector
    (js-object :compare (lambda (left right) (compare-sequential left right PersistentVector "vector"))))
  (extendProtocolType IComparable PersistentList
    (js-object :compare (lambda (left right) (compare-sequential left right PersistentList "list"))))

  (defun compareValues (left right)
    (cond
      ((eq left right) 0)
      ((and (= (funcall typeof-value left) "number") (= (funcall typeof-value right) "number"))
       (if (Number/isNaN left) (if (Number/isNaN right) 0 1)
         (if (Number/isNaN right) -1 (if (host-less left right) -1 1))))
      ((and (= (funcall typeof-value left) "string") (= (funcall typeof-value right) "string"))
       (if (host-less left right) -1 1))
      ((nil? left) -1)
      ((nil? right) 1)
      ((undefined? left) -1)
      ((undefined? right) 1)
      (t (comparison-result (funcall dispatch-compare left right) "IComparable/compare"))))

  (defun comparator (comparison)
    (require-function comparison "comparator comparison")
    (if (eq comparison compareValues)
        compareValues
        (lambda (left right)
          (let ((result (funcall comparison left right)))
            (if (= (funcall typeof-value result) "number")
                (comparison-result result "comparator comparison")
                (if (isTruthy result)
                    -1
                    (if (isTruthy (funcall comparison right left)) 1 0)))))))

  (defun reverseComparator (&rest arguments)
    (when (> (js-length arguments) 1)
      (throw (new globalThis/TypeError "reverseComparator expects zero or one comparator")))
    (let ((normalized (comparator (if (= (js-length arguments) 0) compareValues (get arguments 0)))))
      (lambda (left right) (funcall normalized right left))))

  (defun sort-decorated (values comparison)
    (if (= (js-length values) 0)
        EMPTY_VECTOR
        (progn
          (js-call values :sort
            (lambda (left right)
              (let ((result (funcall comparison (get left :key) (get right :key))))
                (if (= result 0) (- (get left :index) (get right :index)) result))))
          (let ((result (new globalThis/Array (js-length values)))
                (index 0))
            (while (< index (js-length values))
              (put result index (get (get values index) :value))
              (setq index (1+ index)))
            (js-call PersistentVector :from result)))))

  (defun collect-decorated (collection key-function)
    (let ((values (js-array)))
      (reduce collection
        (lambda (result value)
          (js-call result :push
            (js-object :index (js-length result) :key (funcall key-function value) :value value))
          result)
        values)
      values))

  (defun collect-values (collection)
    (let ((values (js-array)) (numbers t))
      (reduce collection
        (lambda (result value)
          (when (/= (typeof-value value) "number") (setq numbers false))
          (js-call result :push value)
          result)
        values)
      (js-object :values values :numbers numbers)))

  (defun compare-numbers (left right)
    ;; The collector proved both operands primitive numbers. Preserve the
    ;; default total order (including NaN and signed zero), without repeating
    ;; dynamic type dispatch for every native sort comparison.
    (cond ((eq left right) 0)
          ((not (eq left left)) (if (not (eq right right)) 0 1))
          ((not (eq right right)) -1)
          (t (host-number-difference left right))))

  (defun sort (&rest arguments)
    (unless (or (= (js-length arguments) 1) (= (js-length arguments) 2))
      (throw (new globalThis/TypeError "sort expects a collection or comparator and collection")))
    (let* ((comparison (if (= (js-length arguments) 1) compareValues (get arguments 0)))
           (collection (get arguments (1- (js-length arguments))))
           (collected (collect-values collection))
           (values (get collected :values))
           (normalized (comparator comparison)))
      (if (= (js-length values) 0)
          EMPTY_VECTOR
          (progn
            (js-call values :sort
              (if (and (eq normalized compareValues) (get collected :numbers))
                compare-numbers normalized))
            (js-call PersistentVector :from values)))))

  (defun sortBy (keyFunction &rest arguments)
    (require-function keyFunction "sortBy key function")
    (unless (or (= (js-length arguments) 1) (= (js-length arguments) 2))
      (throw (new globalThis/TypeError
               "sortBy expects a key function, optional comparator, and collection")))
    (let ((comparison (if (= (js-length arguments) 1) compareValues (get arguments 0)))
          (collection (get arguments (1- (js-length arguments)))))
      (sort-decorated
        (collect-decorated collection keyFunction)
        (comparator comparison))))

  (defun extreme-key (label direction key-function values)
    (require-function key-function (str label " key function"))
    (when (= (js-length values) 0)
      (throw (new globalThis/TypeError (str label " expects a key function and at least one value"))))
    (let* ((selected (get values 0))
           (selected-key (funcall key-function selected))
           (index 1))
      (while (< index (js-length values))
        (let* ((candidate (get values index))
               (candidate-key (funcall key-function candidate)))
          (when (>= (* (compareValues candidate-key selected-key) direction) 0)
            (setq selected candidate
                  selected-key candidate-key)))
        (setq index (1+ index)))
      selected))

  (defun minKey (keyFunction &rest values)
    (extreme-key "minKey" -1 keyFunction values))

  (defun maxKey (keyFunction &rest values)
    (extreme-key "maxKey" 1 keyFunction values))

  (export
    IComparable
    compareValues
    comparator
    reverseComparator
    sort
    sortBy
    minKey
    maxKey))
