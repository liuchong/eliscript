(module eliscript.runtime.core.sequence
  (import "./collection.mjs"
    count
    IReversible
    isReduced
    nth
    reduce
    reduced
    rseq
    seq
    sequenceView
    unboundedSequenceView
    unreduced)
  (import "./collection-internals.mjs"
    prependSequenceView
    sliceSequenceView)
  (import "./list.mjs" EMPTY_LIST isPersistentList)
  (import "./protocol.mjs" implementsProtocolOperation)
  (import "./transducer.mjs"
    deduping
    distincting
    dropping
    droppingWhile
    filtering
    into
    interposing
    keeping
    keepingIndexed
    mapcatting
    mapping
    mappingIndexed
    partitioningAll
    partitioningBy
    removing
    taking
    takingNth
    takingWhile)
  (import "./transient.mjs" conjBang persistentBang transient)
  (import "./truth.mjs" isTruthy)
  (import "./vector.mjs" EMPTY_VECTOR isPersistentVector persistentVector)

  (defun typeof-value (value) (js* "typeof value"))
  (defconst NOT_FOUND (funcall globalThis/Symbol "eliscript.sequence.not-found"))
  (defconst NO_PARTITION_PAD (funcall globalThis/Symbol "eliscript.sequence.no-partition-pad"))

  (defun fail (message)
    (throw (new globalThis/TypeError message)))

  (defun require-function (value label)
    (unless (= (funcall typeof-value value) "function")
      (fail (str label " must be a function")))
    value)

  (defun require-nonnegative (value label)
    (unless (and (Number/isSafeInteger value) (>= value 0))
      (fail (str label " must be a non-negative safe integer")))
    value)

  (defun require-positive (value label)
    (unless (and (Number/isSafeInteger value) (> value 0))
      (fail (str label " must be a positive safe integer")))
    value)

  (defun require-finite (value label)
    (unless (Number/isFinite value)
      (fail (str label " must be a finite number")))
    value)

  (defun iterator-object (next-function close-function)
    (let ((iterator (js-object
                      :next next-function
                      :return (lambda (&rest optional)
                                (let ((value (if (= (js-length optional) 0) undefined (get optional 0))))
                                  (funcall close-function)
                                  (js-object :value value :done t)))
                      :throw (lambda (&rest optional)
                               (let ((error (if (= (js-length optional) 0) undefined (get optional 0))))
                                 (funcall close-function)
                                 (throw error))))))
      (Object/defineProperty iterator (get globalThis/Symbol :iterator)
        (js-object :value (lambda () iterator) :writable t :configurable t))
      iterator))

  (defun indexed-factory (producer total-count)
    (lambda ()
      (let ((index 0)
            (closed false))
        (iterator-object
          (lambda ()
            (if (or closed (and (not (nil? total-count)) (>= index total-count)))
                (progn
                  (setq closed t)
                  (js-object :value undefined :done t))
                (try
                  (let ((value (funcall producer index)))
                    (setq index (1+ index))
                    (js-object :value value :done false))
                  (catch error
                    (setq closed t)
                    (throw error)))))
          (lambda () (setq closed t))))))

  (defun range (&rest bounds)
    (when (> (js-length bounds) 3)
      (fail "range expects zero to three arguments"))
    (if (= (js-length bounds) 0)
        (unboundedSequenceView (indexed-factory (lambda (index) (+ 0 (* index 1))) nil))
        (let* ((start (require-finite (if (= (js-length bounds) 1) 0 (get bounds 0)) "range start"))
               (end (require-finite (if (= (js-length bounds) 1) (get bounds 0) (get bounds 1)) "range end"))
               (step (require-finite (if (= (js-length bounds) 3) (get bounds 2) 1) "range step")))
          (when (= step 0)
            (fail "range step must be non-zero"))
          (let* ((distance (/ (- end start) step))
                 (length (if (> distance 0)
                             (require-nonnegative (Math/ceil distance) "range count")
                             0)))
            (sequenceView (indexed-factory (lambda (index) (+ start (* index step))) length) length)))))

  (defun repeat (&rest arguments)
    (cond
      ((= (js-length arguments) 1)
       (let ((value (get arguments 0)))
         (unboundedSequenceView (indexed-factory (lambda (_index) value) nil))))
      ((= (js-length arguments) 2)
       (let ((length (require-nonnegative (get arguments 0) "repeat count"))
             (value (get arguments 1)))
         (sequenceView (indexed-factory (lambda (_index) value) length) length)))
      (t (fail "repeat expects a value or a count and value"))))

  (defun repeatedly (&rest arguments)
    (cond
      ((= (js-length arguments) 1)
       (let ((producer (require-function (get arguments 0) "repeatedly producer")))
         (unboundedSequenceView (indexed-factory (lambda (_index) (funcall producer)) nil))))
      ((= (js-length arguments) 2)
       (let ((length (require-nonnegative (get arguments 0) "repeatedly count"))
             (producer (require-function (get arguments 1) "repeatedly producer")))
         (sequenceView (indexed-factory (lambda (_index) (funcall producer)) length) length)))
      (t (fail "repeatedly expects a producer or a count and producer"))))

  (defun iterate (transform seed)
    (require-function transform "iterate transform")
    (unboundedSequenceView
      (lambda ()
        (let ((value seed)
              (pending t)
              (closed false))
          (iterator-object
            (lambda ()
              (if closed
                  (js-object :value undefined :done t)
                  (try
                    (unless pending
                      (setq value (funcall transform value)))
                    (setq pending false)
                    (js-object :value value :done false)
                    (catch error
                      (setq closed t)
                      (throw error)))))
            (lambda () (setq closed t)))))))

  (defun cycle (collection)
    (let* ((values (into EMPTY_VECTOR collection))
           (length (count values)))
      (if (= length 0)
          nil
          (unboundedSequenceView
            (lambda ()
              (let ((index 0)
                    (closed false))
                (iterator-object
                  (lambda ()
                    (if closed
                        (js-object :value undefined :done t)
                        (try
                          (let ((value (funcall nth values index)))
                            (setq index (% (1+ index) length))
                            (js-object :value value :done false))
                          (catch error
                            (setq closed t)
                            (throw error)))))
                  (lambda () (setq closed t)))))))))

  (defun generate (length producer)
    (require-nonnegative length "generate count")
    (require-function producer "generate producer")
    (sequenceView (indexed-factory producer length) length))

  (defun first-reduced (collection not-found)
    (let ((found false) (found-value nil))
      (reduce collection
        (lambda (missing value)
          (setq found t found-value value)
          (reduced missing))
        nil)
      (if found found-value not-found)))

  (defun first (collection &optional not-found)
    (cond
      ((isPersistentList collection)
       (if (get collection :isEmpty) not-found (js-call collection :first not-found)))
      ((isPersistentVector collection)
       (if (= (get collection :count) 0) not-found (js-call collection :nth 0)))
      (t (first-reduced collection not-found))))

  (defun nthRest (limit collection)
    (require-nonnegative limit "nthRest limit")
    (if (= limit 0)
        collection
        (let ((result (sliceSequenceView (seq collection) limit)))
          (if (nullish? result) EMPTY_LIST result))))

  (defun nthNext (limit collection)
    (require-nonnegative limit "nthNext limit")
    (let ((result (if (= limit 0) (seq collection) (sliceSequenceView (seq collection) limit))))
      (if (nil? result) nil (seq result))))

  (defun rest (collection)
    (nthRest 1 collection))

  (defun next (collection)
    (nthNext 1 collection))

  (defun prepend (value collection)
    (prependSequenceView value (seq collection)))

  (defun second (collection &rest optional)
    (let ((not-found (if (or (= (js-length optional) 0) (undefined? (get optional 0)))
                         nil
                         (get optional 0))))
      (first (next collection) not-found)))

  (defun ffirst (collection)
    (first (first collection)))

  (defun nfirst (collection)
    (next (first collection)))

  (defun fnext (collection)
    (first (next collection)))

  (defun nnext (collection)
    (next (next collection)))

  (defun sequenceNth (index collection &rest optional)
    (require-nonnegative index "sequenceNth index")
    (let ((not-found (if (or (= (js-length optional) 0) (undefined? (get optional 0)))
                         nil
                         (get optional 0)))
          (position 0)
          (found false)
          (found-value nil))
      (reduce collection
        (lambda (missing value)
          (if (= position index)
              (progn
                (setq found t found-value value)
                (reduced missing))
              (progn
                (setq position (1+ position))
                missing)))
        nil)
      (if found found-value not-found)))

  (defun last-reduced (collection not-found)
    (let ((found false) (last-value nil))
      (reduce collection
        (lambda (missing value)
          (setq found t last-value value)
          missing)
        nil)
      (if found last-value not-found)))

  (defun last (collection &optional not-found)
    (cond
      ((isPersistentVector collection) (js-call collection :peek not-found))
      ((implementsProtocolOperation IReversible "rseq" collection)
       (first (rseq collection) not-found))
      (t (last-reduced collection not-found))))

  (defun take-last-reduced (limit collection)
    (let ((ring (new globalThis/Array limit))
             (length 0)
             (start 0))
         (reduce collection
           (lambda (state value)
             (if (< length limit)
                 (progn
                   (put ring length value)
                   (setq length (1+ length)))
                 (progn
                   (put ring start value)
                   (setq start (% (1+ start) limit))))
             state)
           nil)
         (let ((builder (transient EMPTY_VECTOR))
               (index 0))
           (while (< index length)
             (conjBang builder (get ring (% (+ start index) limit)))
             (setq index (1+ index)))
           (persistentBang builder))))

  (defun takeLast (limit collection)
    (require-nonnegative limit "takeLast limit")
    (cond
      ((= limit 0) EMPTY_VECTOR)
      ((isPersistentVector collection)
       (let ((total (get collection :count)))
         (cond
           ((= total 0) EMPTY_VECTOR)
           ((>= limit total) collection)
           ((= (funcall typeof-value (get collection :sliceVector)) "function")
            (js-call collection :sliceVector (- total limit) total))
           (t
            (let ((builder (transient EMPTY_VECTOR))
                  (index (- total limit)))
              (while (< index total)
                (conjBang builder (js-call collection :nth index))
                (setq index (1+ index)))
              (persistentBang builder))))))
      (t
       (take-last-reduced limit collection))))

  (defun dropLast (limit collection)
    (require-nonnegative limit "dropLast limit")
    (cond
      ((= limit 0)
       (if (isPersistentVector collection) collection (into EMPTY_VECTOR collection)))
      ((isPersistentVector collection)
       (let ((total (get collection :count)))
         (if (>= limit total)
             EMPTY_VECTOR
             (let ((keep (- total limit)))
               (if (= (funcall typeof-value (get collection :sliceVector)) "function")
                   (js-call collection :sliceVector 0 keep)
                   (let ((builder (transient EMPTY_VECTOR))
                         (index 0))
                     (while (< index keep)
                       (conjBang builder (js-call collection :nth index))
                       (setq index (1+ index)))
                     (persistentBang builder)))))))
      (t
       (let ((ring (new globalThis/Array limit))
             (builder (transient EMPTY_VECTOR))
             (length 0)
             (start 0))
         (reduce collection
           (lambda (state value)
             (if (< length limit)
                 (progn
                   (put ring length value)
                   (setq length (1+ length)))
                 (progn
                   (conjBang builder (get ring start))
                   (put ring start value)
                   (setq start (% (1+ start) limit))))
             state)
           nil)
         (persistentBang builder)))))

  (defun butlast (collection)
    (dropLast 1 collection))

  (defun splitAt (limit collection)
    (require-nonnegative limit "splitAt limit")
    (let ((left (transient EMPTY_VECTOR))
          (right (transient EMPTY_VECTOR))
          (index 0))
      (reduce collection
        (lambda (state value)
          (conjBang (if (< index limit) left right) value)
          (setq index (1+ index))
          state)
        nil)
      (persistentVector (persistentBang left) (persistentBang right))))

  (defun splitWith (predicate collection)
    (require-function predicate "splitWith predicate")
    (let ((left (transient EMPTY_VECTOR))
          (right (transient EMPTY_VECTOR))
          (prefix t))
      (reduce collection
        (lambda (state value)
          (if (and prefix (isTruthy (funcall predicate value)))
              (conjBang left value)
              (progn
                (setq prefix false)
                (conjBang right value)))
          state)
        nil)
      (persistentVector (persistentBang left) (persistentBang right))))

  (defun reverse (collection)
    (if (implementsProtocolOperation IReversible "rseq" collection)
        (into EMPTY_VECTOR (rseq collection))
        (let ((values (reduce collection
                        (lambda (result value)
                          (js-call result :push value)
                          result)
                        (js-array))))
          (js-call values :reverse)
          (into EMPTY_VECTOR values))))

  (defun map (transform collection) (into EMPTY_VECTOR (mapping transform) collection))
  (defun mapIndexed (transform collection) (into EMPTY_VECTOR (mappingIndexed transform) collection))
  (defun keep (transform collection) (into EMPTY_VECTOR (keeping transform) collection))
  (defun keepIndexed (transform collection) (into EMPTY_VECTOR (keepingIndexed transform) collection))
  (defun filter (predicate collection) (into EMPTY_VECTOR (filtering predicate) collection))
  (defun remove (predicate collection) (into EMPTY_VECTOR (removing predicate) collection))
  (defun take (limit collection) (into EMPTY_VECTOR (taking limit) collection))
  (defun drop (limit collection) (into EMPTY_VECTOR (dropping limit) collection))
  (defun takeWhile (predicate collection) (into EMPTY_VECTOR (takingWhile predicate) collection))
  (defun dropWhile (predicate collection) (into EMPTY_VECTOR (droppingWhile predicate) collection))
  (defun takeNth (interval collection) (into EMPTY_VECTOR (takingNth interval) collection))
  (defun interpose (separator collection) (into EMPTY_VECTOR (interposing separator) collection))
  (defun dedupe (collection) (into EMPTY_VECTOR (deduping) collection))
  (defun distinct (collection) (into EMPTY_VECTOR (distincting) collection))
  (defun mapcat (transform collection) (into EMPTY_VECTOR (mapcatting transform) collection))

  (defun partition-windows (size step collection include-partial pad)
    (require-positive size "partition size")
    (require-positive step "partition step")
    (let* ((values (into EMPTY_VECTOR collection))
           (length (count values))
           (result (transient EMPTY_VECTOR))
           (start 0)
           (done false))
      (while (and (< start length) (not done))
        (let* ((group (transient EMPTY_VECTOR))
               (group-count (Math/min size (- length start)))
               (offset 0))
          (while (< offset group-count)
            (conjBang group (funcall nth values (+ start offset)))
            (setq offset (1+ offset)))
          (let ((partial (< group-count size)))
            (when (and partial (not (eq pad NO_PARTITION_PAD)))
              (reduce pad
                (lambda (builder value)
                  (conjBang builder value)
                  (setq group-count (1+ group-count))
                  (if (>= group-count size) (reduced builder) builder))
                group))
            (let ((completed (persistentBang group)))
              (when (or (not partial) include-partial (not (eq pad NO_PARTITION_PAD)))
                (conjBang result completed)))
            (when (and partial (not include-partial))
              (setq done t))))
        (setq start (+ start step)))
      (persistentBang result)))

  (defun partition (size &rest arguments)
    (cond
      ((= (js-length arguments) 1) (partition-windows size size (get arguments 0) false NO_PARTITION_PAD))
      ((= (js-length arguments) 2) (partition-windows size (get arguments 0) (get arguments 1) false NO_PARTITION_PAD))
      ((= (js-length arguments) 3) (partition-windows size (get arguments 0) (get arguments 2) false (get arguments 1)))
      (t (fail "partition expects size and collection, optional step, or step and pad"))))

  (defun partitionAll (size &rest arguments)
    (cond
      ((= (js-length arguments) 1)
       (require-positive size "partition size")
       (into EMPTY_VECTOR (partitioningAll size) (get arguments 0)))
      ((= (js-length arguments) 2)
       (partition-windows size (get arguments 0) (get arguments 1) t NO_PARTITION_PAD))
      (t (fail "partitionAll expects size and collection or size, step, and collection"))))

  (defun partitionBy (classifier collection)
    (into EMPTY_VECTOR (partitioningBy classifier) collection))

  (defun concat (&rest collections)
    (let ((result (transient EMPTY_VECTOR))
          (index 0))
      (while (< index (js-length collections))
        (reduce (get collections index) (lambda (builder value) (conjBang builder value)) result)
        (setq index (1+ index)))
      (persistentBang result)))

  (defun materialize-sources (collections)
    (let ((sources (js-array))
          (index 0))
      (while (< index (js-length collections))
        (js-call sources :push (into EMPTY_VECTOR (get collections index)))
        (setq index (1+ index)))
      sources))

  (defun interleave (&rest collections)
    (if (= (js-length collections) 0)
        EMPTY_VECTOR
        (let* ((sources (materialize-sources collections))
               (limit (count (get sources 0)))
               (index 1))
          (while (< index (js-length sources))
            (setq limit (Math/min limit (count (get sources index)))
                  index (1+ index)))
          (let ((result (transient EMPTY_VECTOR))
                (value-index 0))
            (while (< value-index limit)
              (setq index 0)
              (while (< index (js-length sources))
                (conjBang result (funcall nth (get sources index) value-index))
                (setq index (1+ index)))
              (setq value-index (1+ value-index)))
            (persistentBang result)))))

  (defun interleaveAll (&rest collections)
    (if (= (js-length collections) 0)
        EMPTY_VECTOR
        (let ((sources (materialize-sources collections))
              (limit 0)
              (index 0))
          (while (< index (js-length sources))
            (setq limit (Math/max limit (count (get sources index)))
                  index (1+ index)))
          (let ((result (transient EMPTY_VECTOR))
                (value-index 0))
            (while (< value-index limit)
              (setq index 0)
              (while (< index (js-length sources))
                (let ((source (get sources index)))
                  (when (< value-index (count source))
                    (conjBang result (funcall nth source value-index))))
                (setq index (1+ index)))
              (setq value-index (1+ value-index)))
            (persistentBang result)))))

  (defun some (predicate collection &rest optional)
    (require-function predicate "some predicate")
    (let ((not-found (if (or (= (js-length optional) 0) (undefined? (get optional 0)))
                         nil
                         (get optional 0)))
          (result (reduce collection
                    (lambda (missing value)
                      (let ((matched (funcall predicate value)))
                        (if (isTruthy matched) (reduced matched) missing)))
                    NOT_FOUND)))
      (if (eq result NOT_FOUND) not-found result)))

  (defun every (predicate collection)
    (require-function predicate "every predicate")
    (reduce collection
      (lambda (result value)
        (if (isTruthy (funcall predicate value)) result (reduced false)))
      t))

  (defun notAny (predicate collection)
    (not (isTruthy (some predicate collection))))

  (defun notEvery (predicate collection)
    (not (every predicate collection)))

  (defun find (predicate collection &rest optional)
    (require-function predicate "find predicate")
    (let ((not-found (if (or (= (js-length optional) 0) (undefined? (get optional 0)))
                         nil
                         (get optional 0)))
          (found false)
          (found-value nil))
      (reduce collection
        (lambda (missing value)
          (if (isTruthy (funcall predicate value))
              (progn
                (setq found t found-value value)
                (reduced missing))
              missing))
        nil)
      (if found found-value not-found)))

  (defun reductions (step initial collection)
    (require-function step "reductions step")
    (let ((builder (transient EMPTY_VECTOR))
          (seed (unreduced initial)))
      (conjBang builder seed)
      (unless (isReduced initial)
        (reduce collection
          (lambda (current input)
            (let* ((next-value (funcall step current input))
                   (value (unreduced next-value)))
              (conjBang builder value)
              (if (isReduced next-value) (reduced value) value)))
          seed))
      (persistentBang builder)))

  (defun treeSeq (branchPredicate childrenFunction root)
    (require-function branchPredicate "treeSeq branch predicate")
    (require-function childrenFunction "treeSeq children function")
    (let ((result (transient EMPTY_VECTOR))
          (stack (js-array root)))
      (while (> (js-length stack) 0)
        (let ((value (js-call stack :pop)))
          (conjBang result value)
          (when (isTruthy (funcall branchPredicate value))
            (let* ((children (into EMPTY_VECTOR (funcall childrenFunction value)))
                   (index (1- (count children))))
              (while (>= index 0)
                (js-call stack :push (funcall nth children index))
                (setq index (1- index)))))))
      (persistentBang result)))

  (defun flatten (root)
    (let ((result (transient EMPTY_VECTOR))
          (stack (js-array root)))
      (while (> (js-length stack) 0)
        (let ((value (js-call stack :pop)))
          (if (or (Array/isArray value) (isPersistentList value) (isPersistentVector value))
              (let* ((children (into EMPTY_VECTOR value))
                     (index (1- (count children))))
                (while (>= index 0)
                  (js-call stack :push (funcall nth children index))
                  (setq index (1- index))))
              (conjBang result value))))
      (persistentBang result)))

  (export
    range
    repeat
    repeatedly
    iterate
    cycle
    generate
    first
    nthRest
    nthNext
    rest
    next
    prepend
    second
    ffirst
    nfirst
    fnext
    nnext
    sequenceNth
    last
    takeLast
    dropLast
    butlast
    splitAt
    splitWith
    reverse
    map
    mapIndexed
    keep
    keepIndexed
    filter
    remove
    take
    drop
    takeWhile
    dropWhile
    takeNth
    interpose
    dedupe
    distinct
    mapcat
    partition
    partitionAll
    partitionBy
    concat
    interleave
    interleaveAll
    some
    every
    notAny
    notEvery
    find
    reductions
    treeSeq
    flatten))
