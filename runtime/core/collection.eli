(module eliscript.runtime.core.collection
  (import "./protocol.mjs"
    extendProtocolCategory extendProtocolType implementsProtocol)
  (import "./collection-internals.mjs"
    COLLECTION_ASSOC COLLECTION_CONJ COLLECTION_COUNT COLLECTION_EMPTY
    COLLECTION_GET COLLECTION_NTH COLLECTION_PEEK COLLECTION_POP
    COLLECTION_REDUCE COLLECTION_REDUCE_KV
    I_COUNTED I_EMPTYABLE I_CONJ I_INDEXED I_LOOKUP I_ASSOCIATIVE
    I_REDUCE I_KV_REDUCE I_MAP I_SET I_STACK I_REVERSIBLE I_SEQABLE
    ReductionView MemoizedSequenceView SequenceView
    dispatchCollectionCount dispatchCollectionEmpty dispatchCollectionConj
    dispatchCollectionGet dispatchCollectionAssoc dispatchCollectionContains
    dispatchCollectionNth dispatchCollectionReduce dispatchCollectionReduceKV
    dispatchCollectionDissoc dispatchCollectionDisj dispatchCollectionPeek
    dispatchCollectionPop dispatchCollectionRseq dispatchCollectionSeq
    isReducedValue readCollectionEntry reduceIterable reducedValue
    reductionView memoizedSequenceView sequenceView unboundedSequenceView
    unreducedValue validateCollectionCount)
  (import "./list.mjs" isPersistentList)
  (import "./queue.mjs" isPersistentQueue)
  (import "./record.mjs" isRecord)
  (import "./persistent-kind.mjs" isPersistentMapValue isPersistentSetValue)
  (import "./set.mjs" EMPTY_SET)
  (import "./vector.mjs" isPersistentVector)

  (defconst MISSING (funcall globalThis.Symbol "eliscript.collection.missing"))
  (defconst iterator-symbol globalThis.Symbol.iterator)
  (defconst host-generator
    (js* "(stepFactory) => (function* () { const next = stepFactory(); for (;;) { const item = next(); if (item.done) return; yield item.value; } })()"))

  (defun typeof-value (value)
    (js* "typeof value"))

  (defun instance-of-p (value constructor)
    (js* "value instanceof constructor"))

  (defun clone-plain-object (source)
    (let ((result (js-object))
          (keys (Reflect/ownKeys source))
          (index 0))
      (while (< index (js-length keys))
        (let* ((key (aref keys index))
               (descriptor (Object/getOwnPropertyDescriptor source key)))
          (when (and (not (undefined? descriptor))
                     (funcall globalThis.Boolean (aref descriptor "enumerable")))
            (Object/defineProperty result key
              (js-object :value (aref source key) :writable t :enumerable t :configurable t))))
        (setq index (1+ index)))
      result))

  (defun indexedValue (values index &rest __opt)
    (let* ((notFound (aref __opt 0))
           (fallback (if (undefined? notFound) MISSING notFound)))
      (if (and (Number/isInteger index) (>= index 0) (< index (js-length values)))
          (aref values index)
        (if (not (eq fallback MISSING))
            fallback
          (throw (new globalThis.RangeError
                   (str "nth index " (funcall globalThis.String index) " is outside collection bounds")))))))
  (Object/defineProperty indexedValue "length" (js-object :value 2 :configurable t))

  (defun indexedAssoc (values index value)
    (unless (and (Number/isInteger index) (>= index 0) (<= index (js-length values)))
      (throw (new globalThis.RangeError
               (str "assoc index " (funcall globalThis.String index) " is outside collection bounds"))))
    (let ((result (js-call values :slice)))
      (put result index value)
      result))

  (defun indexedContains (values index)
    (and (Number/isInteger index) (>= index 0) (< index (js-length values))))

  (defun mapConj (values entry)
    (let* ((pair (readCollectionEntry entry))
           (result (new globalThis.Map values)))
      (js-call result :set (aref pair 0) (aref pair 1))
      result))

  (defun mapAssoc (values key value)
    (let ((result (new globalThis.Map values)))
      (js-call result :set key value)
      result))

  (defun mapDissoc (values key)
    (let ((result (new globalThis.Map values)))
      (js-call result :delete key)
      result))

  (defun setConj (values value)
    (let ((result (new globalThis.Set values)))
      (js-call result :add value)
      result))

  (defun setDisj (values value)
    (let ((result (new globalThis.Set values)))
      (js-call result :delete value)
      result))

  (defun objectAssoc (values key value)
    (unless (eq (typeof-value key) "string")
      (throw (new globalThis.TypeError "plain object association keys must be strings")))
    (let ((result (clone-plain-object values)))
      (Object/defineProperty result key
        (js-object :value value :writable t :enumerable t :configurable t))
      result))

  (defun objectConj (values entry)
    (let ((pair (readCollectionEntry entry)))
      (objectAssoc values (aref pair 0) (aref pair 1))))

  (defun objectDissoc (values key)
    (unless (eq (typeof-value key) "string")
      (throw (new globalThis.TypeError "plain object dissociation keys must be strings")))
    (let ((result (clone-plain-object values)))
      (Reflect/deleteProperty result key)
      result))

  (defun arrayConj (values value)
    (let ((result (reduceIterable values
                    (lambda (acc item)
                      (Object/defineProperty acc (js-length acc)
                        (js-object :value item :writable t :enumerable t :configurable t))
                      acc)
                    (js-array))))
      (Object/defineProperty result (js-length result)
        (js-object :value value :writable t :enumerable t :configurable t))
      result))

  (defun arrayPeek (values)
    (if (eq (js-length values) 0)
        nil
      (aref values (1- (js-length values)))))

  (defun arrayPop (values)
    (when (eq (js-length values) 0)
      (throw (new globalThis.RangeError "cannot pop an empty array")))
    (js-call values :slice 0 -1))

  (defun indexedReverseSequence (values)
    (if (eq (js-length values) 0)
        nil
      (sequenceView
        (lambda ()
          (let ((index (js-length values)))
            (js-object
              :next (lambda ()
                      (if (eq index 0)
                          (js-object :value undefined :done t)
                        (progn
                          (setq index (1- index))
                          (js-object :value (aref values index) :done false)))))))
        (lambda () (js-length values)))))

  (defun arraySequence (values)
    (if (eq (js-length values) 0)
        nil
      (sequenceView
        (lambda () (js-call (aref values iterator-symbol) :call values))
        (lambda () (js-length values)))))

  (defun mapSequence (values)
    (if (eq (aref values "size") 0)
        nil
      (sequenceView
        (lambda ()
          (funcall host-generator
            (lambda ()
              (let ((iterator (js-call (aref values iterator-symbol) :call values)))
                (lambda ()
                  (let ((step (js-call iterator :next)))
                    (if (funcall globalThis.Boolean (aref step "done"))
                        (js-object :value undefined :done t)
                      (let ((entry (aref step "value")))
                        (js-object :value (Object/freeze (js-array (aref entry 0) (aref entry 1)))
                                   :done false)))))))))
        (lambda () (aref values "size")))))

  (defun setSequence (values)
    (if (eq (aref values "size") 0)
        nil
      (sequenceView
        (lambda () (js-call (aref values iterator-symbol) :call values))
        (lambda () (aref values "size")))))

  (defun stringSequence (value)
    (if (eq (js-length value) 0)
        nil
      (sequenceView
        (lambda ()
          (funcall host-generator
            (lambda ()
              (let ((index 0))
                (lambda ()
                  (if (>= index (js-length value))
                      (js-object :value undefined :done t)
                    (let ((unit (aref value index)))
                      (setq index (1+ index))
                      (js-object :value unit :done false))))))))
        (lambda () (js-length value)))))

  (defun objectSequence (value)
    (let ((initial-keys (Object/keys value)))
      (if (eq (js-length initial-keys) 0)
          nil
        (sequenceView
          (lambda ()
            (funcall host-generator
              (lambda ()
                (let ((keys (Object/keys value))
                      (index 0))
                  (lambda ()
                    (if (>= index (js-length keys))
                        (js-object :value undefined :done t)
                      (let ((key (aref keys index)))
                        (setq index (1+ index))
                        (js-object :value (Object/freeze (js-array key (aref value key)))
                                   :done false))))))))
          (lambda () (js-length (Object/keys value)))))))

  (defun reduceIndexedValues (values reducer initial)
    (let ((result initial)
          (index 0)
          (done false)
          (output initial))
      (while (and (< index (js-length values)) (not done))
        (setq result (funcall reducer result index (aref values index)))
        (if (isReducedValue result)
            (setq output (unreducedValue result) done t)
          (setq output result))
        (setq index (1+ index)))
      output))

  (defun reduceMapValues (values reducer initial)
    (let ((iterator (js-call (aref values iterator-symbol) :call values))
          (result initial)
          (output initial)
          (done false)
          (exhausted false))
      (try
        (while (and (not done) (not exhausted))
          (let ((step (js-call iterator :next)))
            (if (funcall globalThis.Boolean (aref step "done"))
                (setq exhausted t)
              (let* ((entry (aref step "value"))
                     (key (aref entry 0))
                     (val (aref entry 1)))
                (setq result (funcall reducer result key val))
                (if (isReducedValue result)
                    (setq output (unreducedValue result) done t)
                  (setq output result))))))
        (finally
          (when (and (not exhausted) (eq (typeof-value (aref iterator "return")) "function"))
            (js-call iterator :return))))
      output))

  (defun reduceObjectValues (value reducer initial)
    (let ((keys (Object/keys value))
          (index 0)
          (result initial)
          (output initial)
          (done false))
      (while (and (< index (js-length keys)) (not done))
        (let ((key (aref keys index)))
          (setq result (funcall reducer result key (aref value key)))
          (if (isReducedValue result)
              (setq output (unreducedValue result) done t)
            (setq output result)))
        (setq index (1+ index)))
      output))

  (extendProtocolCategory I_COUNTED "string"
    (js-object :count (lambda (value) (js-length value))))
  (extendProtocolCategory I_EMPTYABLE "string"
    (js-object :empty (lambda () "")))
  (extendProtocolCategory I_LOOKUP "string"
    (js-object :get (lambda (value index &optional notFound)
                      (indexedValue value index (if (undefined? notFound) nil notFound)))))
  (extendProtocolCategory I_INDEXED "string"
    (js-object :nth indexedValue))
  (extendProtocolCategory I_SEQABLE "string"
    (js-object :seq stringSequence))
  (extendProtocolCategory I_REDUCE "string"
    (js-object :reduce (lambda (value reducer &rest initial)
                         (apply reduceIterable
                                (or (stringSequence value) (js-array))
                                reducer
                                initial))))
  (extendProtocolCategory I_REVERSIBLE "string"
    (js-object :rseq indexedReverseSequence))

  (extendProtocolType I_COUNTED globalThis.Object
    (js-object :count (lambda (value) (js-length (Object/keys value)))))
  (extendProtocolType I_EMPTYABLE globalThis.Object
    (js-object :empty (lambda () (js-object))))
  (extendProtocolType I_CONJ globalThis.Object
    (js-object :conj objectConj))
  (extendProtocolType I_LOOKUP globalThis.Object
    (js-object :get (lambda (value key &optional notFound)
                      (let ((fallback (if (undefined? notFound) nil notFound)))
                        (if (and (eq (typeof-value key) "string") (Object/hasOwn value key))
                            (aref value key)
                          fallback)))))
  (extendProtocolType I_ASSOCIATIVE globalThis.Object
    (js-object :assoc objectAssoc
               :contains (lambda (value key)
                           (and (eq (typeof-value key) "string") (Object/hasOwn value key)))))
  (extendProtocolType I_SEQABLE globalThis.Object
    (js-object :seq objectSequence))
  (extendProtocolType I_REDUCE globalThis.Object
    (js-object :reduce (lambda (value reducer &rest initial)
                         (apply reduceIterable
                                (or (objectSequence value) (js-array))
                                reducer
                                initial))))
  (extendProtocolType I_KV_REDUCE globalThis.Object
    (js-object :reduceKV reduceObjectValues))
  (extendProtocolType I_MAP globalThis.Object
    (js-object :dissoc objectDissoc))

  (extendProtocolType I_COUNTED globalThis.Array
    (js-object :count (lambda (values) (js-length values))))
  (extendProtocolType I_EMPTYABLE globalThis.Array
    (js-object :empty (lambda () (js-array))))
  (extendProtocolType I_CONJ globalThis.Array
    (js-object :conj arrayConj))
  (extendProtocolType I_LOOKUP globalThis.Array
    (js-object :get (lambda (values index &optional notFound)
                      (indexedValue values index (if (undefined? notFound) nil notFound)))))
  (extendProtocolType I_ASSOCIATIVE globalThis.Array
    (js-object :assoc indexedAssoc :contains indexedContains))
  (extendProtocolType I_INDEXED globalThis.Array
    (js-object :nth indexedValue))
  (extendProtocolType I_SEQABLE globalThis.Array
    (js-object :seq arraySequence))
  (extendProtocolType I_REDUCE globalThis.Array
    (js-object :reduce reduceIterable))
  (extendProtocolType I_KV_REDUCE globalThis.Array
    (js-object :reduceKV reduceIndexedValues))
  (extendProtocolType I_STACK globalThis.Array
    (js-object :peek arrayPeek :pop arrayPop))
  (extendProtocolType I_REVERSIBLE globalThis.Array
    (js-object :rseq indexedReverseSequence))

  (extendProtocolType I_COUNTED globalThis.Map
    (js-object :count (lambda (values) (aref values "size"))))
  (extendProtocolType I_EMPTYABLE globalThis.Map
    (js-object :empty (lambda () (new globalThis.Map))))
  (extendProtocolType I_CONJ globalThis.Map
    (js-object :conj mapConj))
  (extendProtocolType I_LOOKUP globalThis.Map
    (js-object :get (lambda (values key &optional notFound)
                      (let ((fallback (if (undefined? notFound) nil notFound)))
                        (if (js-call values :has key)
                            (js-call values :get key)
                          fallback)))))
  (extendProtocolType I_ASSOCIATIVE globalThis.Map
    (js-object :assoc mapAssoc
               :contains (lambda (values key) (js-call values :has key))))
  (extendProtocolType I_SEQABLE globalThis.Map
    (js-object :seq mapSequence))
  (extendProtocolType I_REDUCE globalThis.Map
    (js-object :reduce (lambda (values reducer &rest initial)
                         (apply reduceIterable
                                (or (mapSequence values) (js-array))
                                reducer
                                initial))))
  (extendProtocolType I_KV_REDUCE globalThis.Map
    (js-object :reduceKV reduceMapValues))
  (extendProtocolType I_MAP globalThis.Map
    (js-object :dissoc mapDissoc))

  (extendProtocolType I_COUNTED globalThis.Set
    (js-object :count (lambda (values) (aref values "size"))))
  (extendProtocolType I_EMPTYABLE globalThis.Set
    (js-object :empty (lambda () (new globalThis.Set))))
  (extendProtocolType I_CONJ globalThis.Set
    (js-object :conj setConj))
  (extendProtocolType I_LOOKUP globalThis.Set
    (js-object :get (lambda (values key &optional notFound)
                      (let ((fallback (if (undefined? notFound) nil notFound)))
                        (if (js-call values :has key) key fallback)))))
  (extendProtocolType I_ASSOCIATIVE globalThis.Set
    (js-object :contains (lambda (values key) (js-call values :has key))))
  (extendProtocolType I_SEQABLE globalThis.Set
    (js-object :seq setSequence))
  (extendProtocolType I_REDUCE globalThis.Set
    (js-object :reduce reduceIterable))
  (extendProtocolType I_SET globalThis.Set
    (js-object :disj setDisj))

  (extendProtocolCategory I_COUNTED "null"
    (js-object :count (lambda () 0)))
  (extendProtocolCategory I_EMPTYABLE "null"
    (js-object :empty (lambda () nil)))
  (extendProtocolCategory I_SEQABLE "null"
    (js-object :seq (lambda () nil)))
  (extendProtocolCategory I_REDUCE "null"
    (js-object :reduce (lambda (_value reducer &rest initial)
                         (apply reduceIterable (js-array) reducer initial))))
  (extendProtocolCategory I_KV_REDUCE "null"
    (js-object :reduceKV (lambda (_value _reducer initial) initial)))
  (extendProtocolCategory I_MAP "null"
    (js-object :dissoc (lambda () nil)))
  (extendProtocolCategory I_SET "null"
    (js-object :disj (lambda () nil)))
  (extendProtocolCategory I_STACK "null"
    (js-object :peek (lambda () nil) :pop (lambda () nil)))
  (extendProtocolCategory I_REVERSIBLE "null"
    (js-object :rseq (lambda () nil)))

  (defconst ICounted I_COUNTED)
  (defconst IEmptyable I_EMPTYABLE)
  (defconst IConj I_CONJ)
  (defconst ILookup I_LOOKUP)
  (defconst IAssociative I_ASSOCIATIVE)
  (defconst IIndexed I_INDEXED)
  (defconst ISeqable I_SEQABLE)
  (defconst IReduce I_REDUCE)
  (defconst IKVReduce I_KV_REDUCE)
  (defconst IMap I_MAP)
  (defconst ISet I_SET)
  (defconst IStack I_STACK)
  (defconst IReversible I_REVERSIBLE)

  (defun count (collection)
    (if (not (nullish? collection))
        (let ((direct (aref collection COLLECTION_COUNT)))
          (if (eq (typeof-value direct) "function")
              (validateCollectionCount (js-call direct :call collection))
            (validateCollectionCount (dispatchCollectionCount collection))))
      (validateCollectionCount (dispatchCollectionCount collection))))

  (defun isCounted (collection)
    (implementsProtocol ICounted collection))

  (defun isIndexed (collection)
    (implementsProtocol IIndexed collection))

  (defun isSeqable (collection)
    (implementsProtocol ISeqable collection))

  (defun isReducible (collection)
    (implementsProtocol IReduce collection))

  (defun isReversible (collection)
    (implementsProtocol IReversible collection))

  (defun isAssociative (collection)
    (implementsProtocol IAssociative collection))

  (defun isCollection (value)
    (or (instance-of-p value SequenceView)
        (instance-of-p value MemoizedSequenceView)
        (isPersistentList value)
        (isPersistentQueue value)
        (isPersistentVector value)
        (isPersistentMapValue value)
        (isRecord value)
        (isPersistentSetValue value)))

  (defun isList (value)
    (isPersistentList value))

  (defun isVector (value)
    (isPersistentVector value))

  (defun isQueue (value)
    (isPersistentQueue value))

  (defun isMap (value)
    (or (isPersistentMapValue value) (isRecord value)))

  (defun isSet (value)
    (isPersistentSetValue value))

  (defun isSequential (value)
    (or (instance-of-p value SequenceView)
        (instance-of-p value MemoizedSequenceView)
        (isPersistentList value)
        (isPersistentQueue value)
        (isPersistentVector value)))

  (defun isSequence (value)
    (or (instance-of-p value SequenceView)
        (instance-of-p value MemoizedSequenceView)
        (isPersistentList value)))

  (defun seq (collection)
    (let ((result (dispatchCollectionSeq collection)))
      (if (nil? result)
          nil
        (progn
          (when (or (undefined? result)
                    (not (eq (typeof-value (aref result iterator-symbol)) "function")))
            (throw (new globalThis.TypeError "ISeqable/seq must return null or an iterable sequence view")))
          result))))

  (defun boundedCount (limit collection)
    (unless (and (Number/isSafeInteger limit) (>= limit 0))
      (throw (new globalThis.TypeError "boundedCount limit must be a non-negative safe integer")))
    (if (eq limit 0)
        0
      (let ((sequence (seq collection)))
        (if (nil? sequence)
            0
          (let ((iterator (js-call (aref sequence iterator-symbol) :call sequence))
                (result 0)
                (complete false))
            (try
              (while (and (< result limit)
                          (not (funcall globalThis.Boolean (aref (js-call iterator :next) "done"))))
                (setq result (1+ result)))
              (setq complete t)
              (finally
                (when (and (or (not complete) (eq result limit))
                           (eq (typeof-value (aref iterator "return")) "function"))
                  (js-call iterator :return))))
            result)))))

  (defun areDistinct (&rest values)
    (let ((seen EMPTY_SET)
          (index 0)
          (distinct t))
      (while (and distinct (< index (js-length values)))
        (let ((value (aref values index)))
          (if (js-call seen :has value)
              (setq distinct false)
            (setq seen (js-call seen :conj value))))
        (setq index (1+ index)))
      distinct))

  (defun empty (collection)
    (if (not (nullish? collection))
        (let ((direct (aref collection COLLECTION_EMPTY)))
          (if (eq (typeof-value direct) "function")
              (js-call direct :call collection)
            (dispatchCollectionEmpty collection)))
      (dispatchCollectionEmpty collection)))

  (defun conj (&rest arguments)
    (let ((arg-count (js-length arguments)))
      (cond
        ((<= arg-count 0) undefined)
        ((eq arg-count 1) (aref arguments 0))
        ((eq arg-count 2)
         (let ((collection (aref arguments 0))
               (value (aref arguments 1)))
           (if (not (nullish? collection))
               (let ((direct (aref collection COLLECTION_CONJ)))
                 (if (eq (typeof-value direct) "function")
                     (js-call direct :call collection value)
                   (dispatchCollectionConj collection value)))
             (dispatchCollectionConj collection value))))
        (t
         (let ((result (aref arguments 0))
               (index 1))
           (while (< index arg-count)
             (let ((next-value (aref arguments index)))
               (if (not (nullish? result))
                   (let ((direct (aref result COLLECTION_CONJ)))
                     (if (eq (typeof-value direct) "function")
                         (setq result (js-call direct :call result next-value))
                       (setq result (dispatchCollectionConj result next-value))))
                 (setq result (dispatchCollectionConj result next-value))))
             (setq index (1+ index)))
           result)))))
  (Object/defineProperty conj "length" (js-object :value 2 :configurable t))

  (defun get (collection key &rest __opt)
    (let* ((notFound (aref __opt 0))
           (fallback (if (undefined? notFound) nil notFound)))
      (if (not (nullish? collection))
          (let ((direct (aref collection COLLECTION_GET)))
            (if (eq (typeof-value direct) "function")
                (js-call direct :call collection key fallback)
              (dispatchCollectionGet collection key fallback)))
        (dispatchCollectionGet collection key fallback))))
  (Object/defineProperty get "length" (js-object :value 2 :configurable t))

  (defun assoc (&rest arguments)
    (unless (and (>= (js-length arguments) 3)
                 (eq (% (- (js-length arguments) 1) 2) 0))
      (throw (new globalThis.TypeError
               "assoc requires a collection followed by one or more key/value pairs")))
    (let ((result (aref arguments 0)) (index 1))
      (while (< index (js-length arguments))
        (setq result (dispatchCollectionAssoc result
                       (aref arguments index) (aref arguments (1+ index)))
              index (+ index 2)))
      result))
  (Object/defineProperty assoc "length" (js-object :value 3 :configurable t))

  (defun contains (collection key)
    (let ((result (dispatchCollectionContains collection key)))
      (unless (eq (typeof-value result) "boolean")
        (throw (new globalThis.TypeError "IAssociative/contains must return a boolean")))
      result))

  (defun nth (&rest arguments)
    (let ((collection (aref arguments 0))
          (index (aref arguments 1))
          (not-found (aref arguments 2))
          (has-not-found (>= (js-length arguments) 3)))
      (if (not (nullish? collection))
          (let ((direct (aref collection COLLECTION_NTH)))
            (if (eq (typeof-value direct) "function")
                (if has-not-found
                    (js-call direct :call collection index not-found)
                  (js-call direct :call collection index))
              (if has-not-found
                  (dispatchCollectionNth collection index not-found)
                (dispatchCollectionNth collection index))))
        (if has-not-found
            (dispatchCollectionNth collection index not-found)
          (dispatchCollectionNth collection index)))))
  (Object/defineProperty nth "length" (js-object :value 3 :configurable t))

  (defun isEmpty (collection)
    (nil? (seq collection)))

  (defun notEmpty (collection)
    (if (isEmpty collection) nil collection))

  (defun reduce (&rest arguments)
    (let ((collection (aref arguments 0))
          (reducer (aref arguments 1))
          (initial (aref arguments 2))
          (has-initial (>= (js-length arguments) 3)))
      (unless (eq (typeof-value reducer) "function")
        (throw (new globalThis.TypeError "collection reducer must be a function")))
      (if (not (nullish? collection))
          (let ((direct (aref collection COLLECTION_REDUCE)))
            (if (eq (typeof-value direct) "function")
                (unreducedValue
                  (if has-initial
                      (js-call direct :call collection reducer initial)
                    (js-call direct :call collection reducer)))
              (unreducedValue
                (if has-initial
                    (dispatchCollectionReduce collection reducer initial)
                  (dispatchCollectionReduce collection reducer)))))
        (unreducedValue
          (if has-initial
              (dispatchCollectionReduce collection reducer initial)
            (dispatchCollectionReduce collection reducer))))))
  (Object/defineProperty reduce "length" (js-object :value 3 :configurable t))

  (defun reduceKV (&rest arguments)
    (unless (eq (js-length arguments) 3)
      (throw (new globalThis.TypeError "reduceKV requires a collection, reducer, and initial value")))
    (let ((collection (aref arguments 0))
          (reducer (aref arguments 1))
          (initial (aref arguments 2)))
      (unless (eq (typeof-value reducer) "function")
        (throw (new globalThis.TypeError "key/value reducer must be a function")))
      (if (not (nullish? collection))
          (let ((direct (aref collection COLLECTION_REDUCE_KV)))
            (if (eq (typeof-value direct) "function")
                (unreducedValue (js-call direct :call collection reducer initial))
              (unreducedValue (dispatchCollectionReduceKV collection reducer initial))))
        (unreducedValue (dispatchCollectionReduceKV collection reducer initial)))))
  (Object/defineProperty reduceKV "length" (js-object :value 3 :configurable t))

  (defun dissoc (collection &rest keys)
    (let ((result collection) (index 0))
      (while (< index (js-length keys))
        (setq result (dispatchCollectionDissoc result (aref keys index))
              index (1+ index)))
      result))

  (defun disj (collection &rest values)
    (let ((result collection) (index 0))
      (while (< index (js-length values))
        (setq result (dispatchCollectionDisj result (aref values index))
              index (1+ index)))
      result))

  (defun peek (&rest arguments)
    (unless (eq (js-length arguments) 1)
      (throw (new globalThis.TypeError "peek requires exactly one collection")))
    (dispatchCollectionPeek (aref arguments 0)))
  (Object/defineProperty peek "length" (js-object :value 1 :configurable t))

  (defun pop (&rest arguments)
    (unless (eq (js-length arguments) 1)
      (throw (new globalThis.TypeError "pop requires exactly one collection")))
    (dispatchCollectionPop (aref arguments 0)))
  (Object/defineProperty pop "length" (js-object :value 1 :configurable t))

  (defun rseq (&rest arguments)
    (unless (eq (js-length arguments) 1)
      (throw (new globalThis.TypeError "rseq requires exactly one collection")))
    (let ((result (dispatchCollectionRseq (aref arguments 0))))
      (if (nil? result)
          nil
        (progn
          (when (or (undefined? result)
                    (not (eq (typeof-value (aref result iterator-symbol)) "function")))
            (throw (new globalThis.TypeError
                     "IReversible/rseq must return null or an iterable sequence view")))
          result))))
  (Object/defineProperty rseq "length" (js-object :value 1 :configurable t))

  (defun reduced (value)
    (reducedValue value))

  (defun isReduced (value)
    (isReducedValue value))

  (defun unreduced (value)
    (unreducedValue value))

  (defun isSequenceView (value)
    (or (instance-of-p value SequenceView)
        (instance-of-p value MemoizedSequenceView)))

  (defun isReductionView (value)
    (instance-of-p value ReductionView))

  (export ICounted IEmptyable IConj ILookup IAssociative IIndexed ISeqable
          IReduce IKVReduce IMap ISet IStack IReversible
          ReductionView MemoizedSequenceView SequenceView
          reductionView memoizedSequenceView sequenceView unboundedSequenceView
          count isCounted isIndexed isSeqable isReducible isReversible isAssociative
          isCollection isList isVector isQueue isMap isSet isSequential isSequence
          boundedCount areDistinct empty conj get assoc contains nth seq isEmpty notEmpty
          reduce reduceKV dissoc disj peek pop rseq reduced isReduced unreduced
          isSequenceView isReductionView))
