(module eliscript.runtime.core.queue
  (import "./collection-internals.mjs"
    COLLECTION_CONJ
    COLLECTION_COUNT
    COLLECTION_EMPTY
    COLLECTION_PEEK
    COLLECTION_POP
    COLLECTION_REDUCE
    COLLECTION_SEQ
    reduceIterable
    sequenceView)
  (import "./metadata-internals.mjs"
    METADATA_READ
    METADATA_WITH)
  (import "./queue-internals.mjs"
    QUEUE_CONSTRUCTOR_TOKEN
    QUEUE_STATE
    recordQueueAllocation
    recordQueueFrontPromotion)
  (import "./value-internals.mjs"
    VALUE_EQUAL
    VALUE_HASH
    orderedCollectionHash)
  (import "./vector.mjs"
    EMPTY_VECTOR
    PersistentVector
    persistentVector
    subvec)

  (defconst typeof-value (js* "(value) => typeof value"))
  (defconst instance-of? (js* "(value, Constructor) => value instanceof Constructor"))
  (defconst host-generator (js* "(create) => function* (...args) { yield* create(this, ...args); }"))
  (defconst MAX_COUNT 2147483647)
  (defconst QUEUE_HASH_TAG 1799167783)

  (defun callable? (value)
    (= (funcall typeof-value value) "function"))

  (defun method (implementation name arity)
    (let ((function (funcall
                      (js* "(fn, name) => ({ [name](...args) { return fn(this, ...args); } })[name]")
                      implementation
                      name)))
      (Object/defineProperty function "length" (js-object :value arity :configurable t))
      function))

  (defun define-method (target key name arity implementation)
    (Object/defineProperty
      target
      key
      (js-object
        :value (method implementation name arity)
        :writable t
        :configurable t)))

  (defun define-getter (target key name implementation)
    (Object/defineProperty
      target
      key
      (js-object
        :get (method implementation (str "get " name) 0)
        :configurable t)))

  (defun validate-queue-state (token count front rear)
    (when (not (eq token QUEUE_CONSTRUCTOR_TOKEN))
      (throw (new globalThis/TypeError
               "PersistentQueue values must be created with persistentQueue or PersistentQueue.from")))
    (when (or (not (Number/isSafeInteger count))
              (< count 0)
              (> count MAX_COUNT)
              (not (funcall instance-of? front PersistentVector))
              (not (funcall instance-of? rear PersistentVector))
              (not (= (+ (get front :count) (get rear :count)) count))
              (if (= count 0)
                  (or (not (= (get front :count) 0))
                      (not (= (get rear :count) 0)))
                  (= (get front :count) 0)))
      (throw (new globalThis/TypeError "invalid persistent queue state"))))

  (defun initialize-persistent-queue (self token count front rear metadata)
    (validate-queue-state token count front rear)
    (put self QUEUE_STATE (Object/freeze (js-object :count count :front front :rear rear :metadata metadata)))
    (Object/freeze self))

  (defconst PersistentQueue
    (funcall (js* "(initialize) => class PersistentQueue { constructor(token, count, front, rear, metadata = null) { initialize(this, token, count, front, rear, metadata); } }") initialize-persistent-queue))

  (defconst EMPTY_QUEUE
    (new PersistentQueue QUEUE_CONSTRUCTOR_TOKEN 0 EMPTY_VECTOR EMPTY_VECTOR))

  (defun make-queue (count front rear &optional metadata)
    (recordQueueAllocation)
    (new PersistentQueue
      QUEUE_CONSTRUCTOR_TOKEN
      count
      front
      rear
      (if (undefined? metadata) nil metadata)))

  (defun empty-queue-with-metadata (metadata)
    (if (eq metadata nil)
        EMPTY_QUEUE
        (make-queue 0 EMPTY_VECTOR EMPTY_VECTOR metadata)))

  (defun for-each-iterable (iterable callback)
    (let ((iterator-method (if (nil? iterable)
                               undefined
                               (aref iterable (get globalThis/Symbol :iterator)))))
      (unless (callable? iterator-method)
        (throw (new globalThis/TypeError "value is not iterable")))
      (let ((iterator (js-call iterator-method :call iterable))
            (done false))
        (try
          (while (not done)
            (let ((step (js-call iterator :next)))
              (if (funcall globalThis/Boolean (get step :done))
                  (setq done t)
                  (funcall callback (get step :value)))))
          (finally
            (when (and (not done) (callable? (get iterator :return)))
              (js-call iterator :return)))))))

  (defun queue-step-iterator (queue)
    (let* ((state (aref queue QUEUE_STATE))
           (front-iter (js-call (aref (get state :front) (get globalThis/Symbol :iterator)) :call (get state :front)))
           (rear-iter nil)
           (in-front t))
      (let ((iterator
              (js-object
                :next (method
                        (lambda (_self)
                          (if in-front
                              (let ((step (js-call front-iter :next)))
                                (if (not (funcall globalThis/Boolean (get step :done)))
                                    step
                                    (progn
                                      (setq in-front false
                                            rear-iter (js-call (aref (get state :rear) (get globalThis/Symbol :iterator)) :call (get state :rear)))
                                      (js-call rear-iter :next))))
                              (js-call rear-iter :next)))
                        "next"
                        0))))
        (put iterator (get globalThis/Symbol :iterator)
              (method (lambda (self) self) "[Symbol.iterator]" 0))
        iterator)))

  (let ((proto (get PersistentQueue :prototype)))
    (define-method PersistentQueue "empty" "empty" 0
      (lambda (_self) EMPTY_QUEUE))
    (define-method PersistentQueue "from" "from" 1
      (lambda (_self iterable)
        (if (funcall instance-of? iterable PersistentQueue)
            iterable
            (let ((result EMPTY_QUEUE))
              (for-each-iterable iterable (lambda (value) (setq result (js-call result :conj value))))
              result))))
    (define-getter proto "count" "count"
      (lambda (self) (get (aref self QUEUE_STATE) :count)))
    (define-getter proto "size" "size"
      (lambda (self) (get (aref self QUEUE_STATE) :count)))
    (define-getter proto "isEmpty" "isEmpty"
      (lambda (self) (= (get (aref self QUEUE_STATE) :count) 0)))
    (define-method proto "conj" "conj" 1
      (lambda (self value)
        (let ((state (aref self QUEUE_STATE)))
          (when (= (get state :count) MAX_COUNT)
            (throw (new globalThis/RangeError
                     (str "persistent queue cannot exceed " MAX_COUNT " values"))))
          (if (= (get state :count) 0)
              (make-queue 1 (persistentVector value) EMPTY_VECTOR (get state :metadata))
              (make-queue
                (+ (get state :count) 1)
                (get state :front)
                (js-call (get state :rear) :conj value)
                (get state :metadata))))))
    (define-method proto "peek" "peek" 0
      (lambda (self &rest args)
        (let ((not-found (if (= (js-length args) 0) nil (get args 0)))
              (state (aref self QUEUE_STATE)))
          (if (= (get state :count) 0)
              not-found
              (js-call (get state :front) :nth 0)))))
    (define-method proto "pop" "pop" 0
      (lambda (self)
        (let ((state (aref self QUEUE_STATE)))
          (when (= (get state :count) 0)
            (throw (new globalThis/RangeError "cannot pop an empty persistent queue")))
          (cond
            ((> (get (get state :front) :count) 1)
             (make-queue
               (- (get state :count) 1)
               (subvec (get state :front) 1)
               (get state :rear)
               (get state :metadata)))
            ((= (get (get state :rear) :count) 0)
             (empty-queue-with-metadata (get state :metadata)))
            (t
             (recordQueueFrontPromotion (get (get state :rear) :count))
             (make-queue
               (- (get state :count) 1)
               (get state :rear)
               EMPTY_VECTOR
               (get state :metadata)))))))
    (define-method proto "reduce" "reduce" 1
      (lambda (self reducer &rest initial)
        (apply reduceIterable self reducer initial)))
    (define-method proto "toArray" "toArray" 0
      (lambda (self)
        (Array/from self)))
    (define-method proto COLLECTION_COUNT "[eliscript.collection.count]" 0
      (lambda (self) (get self :count)))
    (define-method proto COLLECTION_EMPTY "[eliscript.collection.empty]" 0
      (lambda (self) (empty-queue-with-metadata (get (aref self QUEUE_STATE) :metadata))))
    (define-method proto COLLECTION_CONJ "[eliscript.collection.conj]" 1
      (lambda (self value) (js-call self :conj value)))
    (define-method proto COLLECTION_PEEK "[eliscript.collection.peek]" 0
      (lambda (self) (js-call self :peek)))
    (define-method proto COLLECTION_POP "[eliscript.collection.pop]" 0
      (lambda (self) (js-call self :pop)))
    (define-method proto COLLECTION_SEQ "[eliscript.collection.seq]" 0
      (lambda (self)
        (if (get self :isEmpty)
            nil
            (sequenceView
              (lambda () (js-call (aref self (get globalThis/Symbol :iterator)) :call self))
              (get self :count)))))
    (define-method proto COLLECTION_REDUCE "[eliscript.collection.reduce]" 1
      (lambda (self reducer &rest initial)
        (apply reduceIterable self reducer initial)))
    (define-method proto VALUE_EQUAL "[eliscript.value.equal]" 2
      (lambda (self other equal)
        (cond
          ((eq self other) t)
          ((or (not (funcall instance-of? other PersistentQueue))
               (not (= (get other :count) (get self :count))))
           false)
          (t
           (let ((left (js-call (aref self (get globalThis/Symbol :iterator)) :call self))
                 (right (js-call (aref other (get globalThis/Symbol :iterator)) :call other))
                 (matched t)
                 (done false))
             (while (and matched (not done))
               (let ((left-step (js-call left :next)))
                 (if (funcall globalThis/Boolean (get left-step :done))
                     (setq done t)
                     (let ((right-step (js-call right :next)))
                       (unless (funcall globalThis/Boolean (funcall equal (get left-step :value) (get right-step :value)))
                         (setq matched false))))))
             matched)))))
    (define-method proto VALUE_HASH "[eliscript.value.hash]" 1
      (lambda (self hash)
        (orderedCollectionHash self hash QUEUE_HASH_TAG)))
    (define-method proto METADATA_READ "[eliscript.metadata.read]" 0
      (lambda (self) (get (aref self QUEUE_STATE) :metadata)))
    (define-method proto METADATA_WITH "[eliscript.metadata.with]" 1
      (lambda (self metadata)
        (let ((state (aref self QUEUE_STATE)))
          (if (eq metadata (get state :metadata))
              self
              (make-queue (get state :count) (get state :front) (get state :rear) metadata)))))
    (let ((gen-fn (funcall host-generator (lambda (self) (queue-step-iterator self)))))
      (Object/defineProperty gen-fn "name" (js-object :value "[Symbol.iterator]" :configurable t))
      (Object/defineProperty gen-fn "length" (js-object :value 0 :configurable t))
      (Object/defineProperty proto (get globalThis/Symbol :iterator)
        (js-object :value gen-fn :writable t :configurable t)))
    (define-getter proto (get globalThis/Symbol :toStringTag) "[Symbol.toStringTag]"
      (lambda (_self) "EliscriptPersistentQueue")))

  (defun persistentQueue (&rest values)
    (js-call PersistentQueue :from values))

  (defun isPersistentQueue (value)
    (funcall instance-of? value PersistentQueue))

  (export
    PersistentQueue
    EMPTY_QUEUE
    persistentQueue
    isPersistentQueue))
