(module eliscript.runtime.core.record
  (import "./collection-internals.mjs"
    COLLECTION_ASSOC
    COLLECTION_CONJ
    COLLECTION_CONTAINS
    COLLECTION_COUNT
    COLLECTION_DISSOC
    COLLECTION_EMPTY
    COLLECTION_GET
    COLLECTION_REDUCE
    COLLECTION_REDUCE_KV
    COLLECTION_SEQ
    isReducedValue
    readCollectionEntry
    reduceIterable
    sequenceView
    unreducedValue)
  (import "./identifier.mjs" identifierName identifierNamespace isKeyword keyword)
  (import "./map.mjs" EMPTY_MAP PersistentHashMap)
  (import "./metadata-internals.mjs" METADATA_READ METADATA_WITH)
  (import "./value-internals.mjs" VALUE_EQUAL VALUE_HASH finishHash hashString mixHash)

  (defconst typeof-value (js* "(value) => typeof value"))
  (defconst instance-of? (js* "(value, Constructor) => value instanceof Constructor"))
  (defconst MAX_FIELDS 1024)
  (defconst RECORD_CONSTRUCTOR_TOKEN (funcall globalThis/Symbol "eliscript.record.constructor-token"))
  (defconst RECORD_STATE (funcall globalThis/Symbol "eliscript.record.state"))
  (defconst RECORD_HASH_TAG 1300474159)
  (defconst record-types (new globalThis/WeakSet))

  (defun fail (message)
    (throw (new globalThis/TypeError message)))

  (defun method (implementation name arity)
    (let ((result (funcall
                    (js* "(fn, name) => ({ [name](...args) { return fn(this, ...args); } })[name]")
                    implementation
                    name)))
      (Object/defineProperty result "length" (js-object :value arity :configurable t))
      result))

  (defun install-method (target key name arity implementation)
    (Object/defineProperty target key
      (js-object
        :value (method implementation name arity)
        :writable t
        :configurable t)))

  (defun install-getter (target key name implementation &rest optional)
    (let ((enumerable (if (or (= (js-length optional) 0) (undefined? (get optional 0)))
                          false
                          (get optional 0))))
      (Object/defineProperty target key
        (js-object
          :get (method implementation name 0)
          :configurable (not enumerable)
          :enumerable enumerable))))

  (defun normalize-type-name (name)
    (when (or (not (= (funcall typeof-value name) "string")) (= (js-length name) 0))
      (fail "record type name must be a non-empty string"))
    name)

  (defun normalize-field-names (fields)
    (unless (and (Array/isArray fields) (<= (js-length fields) MAX_FIELDS))
      (fail (str "record fields must be a dense array of at most " MAX_FIELDS " names")))
    (let ((descriptors (Object/getOwnPropertyDescriptors fields))
          (seen (new globalThis/Set))
          (result (js-array))
          (index 0))
      (unless (= (js-length (Reflect/ownKeys descriptors)) (1+ (js-length fields)))
        (fail "record fields must be a dense array with no extra properties"))
      (while (< index (js-length fields))
        (let* ((descriptor (get descriptors (funcall globalThis/String index)))
               (field (if (nullish? descriptor) undefined (get descriptor :value))))
          (when (or (nullish? descriptor)
                    (not (funcall globalThis/Boolean (get descriptor :enumerable)))
                    (not (= (funcall typeof-value field) "string"))
                    (= (js-length field) 0)
                    (js-call field :includes "/"))
            (fail "record field names must be non-empty unqualified strings"))
          (when (js-call seen :has field)
            (fail (str "record declares duplicate field " field)))
          (js-call seen :add field)
          (js-call result :push field))
        (setq index (1+ index)))
      (Object/freeze result)))

  (defun declared-field-index (type-state key)
    (if (and (isKeyword key) (nil? (identifierNamespace key)))
        (let ((index (js-call (get type-state :fieldIndexes) :get (identifierName key))))
          (if (nullish? index) -1 index))
        -1))

  (defun map-with-metadata (map metadata)
    (if (nil? metadata)
        map
        (js-call (aref map METADATA_WITH) :call map metadata)))

  (defun make-initial-map (type-state values)
    (let ((map EMPTY_MAP)
          (index 0)
          (field-keys (get type-state :fieldKeys)))
      (while (< index (js-length values))
        (setq map (js-call map :assoc (get field-keys index) (get values index))
              index (1+ index)))
      map))

  (defun normalize-source-map (type-state source)
    (let ((map (try
                 (js-call PersistentHashMap :from source)
                 (catch error
                   (throw (new globalThis/TypeError
                            (str "map->" (get type-state :name) " expects an iterable collection of entries")
                            (js-object :cause error))))))
          (index 0)
          (field-keys (get type-state :fieldKeys)))
      (while (< index (js-length field-keys))
        (let ((field-key (get field-keys index)))
          (unless (js-call map :has field-key)
            (setq map (js-call map :assoc field-key nil))))
        (setq index (1+ index)))
      map))

  (defun close-iterator (iterator)
    (let ((return-method (get iterator :return)))
      (when (not (nullish? return-method))
        (js-call return-method :call iterator))))

  (defun reduce-kv-entries (entries reducer initial)
    (let ((iterator (js-call (aref entries (get globalThis/Symbol :iterator)) :call entries))
          (result initial)
          (done false))
      (while (not done)
        (let ((step (js-call iterator :next)))
          (if (funcall globalThis/Boolean (get step :done))
              (setq done t)
              (let ((failed false)
                    (failure nil))
                (try
                  (let (([key value] (get step :value)))
                    (setq result (funcall reducer result key value)))
                  (catch error
                    (setq failed t failure error)))
                (when failed
                  (try
                    (close-iterator iterator)
                    (catch _close-error nil))
                  (throw failure))
                (when (isReducedValue result)
                  (close-iterator iterator)
                  (setq result (unreducedValue result)
                        done t))))))
      result))

  (defun make-record-type (name fields reuse-fields)
    (let* ((type-name (normalize-type-name name))
           (normalized-fields (normalize-field-names fields))
           (field-names (progn
                          (when (and reuse-fields (not (Object/isFrozen fields)))
                            (fail "materialized record fields must be a frozen array"))
                          (if reuse-fields fields normalized-fields)))
           (field-keys (Object/freeze (js-call field-names :map (lambda (field) (keyword field)))))
           (field-indexes (new globalThis/Map
                            (js-call field-names :map (lambda (field index) (js-array field index)))))
           (type-state (Object/freeze
                         (js-object
                           :name type-name
                           :fieldNames field-names
                           :fieldKeys field-keys
                           :fieldIndexes field-indexes
                           :signature (str type-name "[" (js-call field-names :join ",") "]"))))
           (RecordValue nil))
      (setq RecordValue
        (funcall
          (js* "(initInstance) => class RecordValue { constructor(token, map, metadata = null) { initInstance(this, token, map, metadata); } }")
          (lambda (self token map metadata)
            (unless (and (eq token RECORD_CONSTRUCTOR_TOKEN)
                         (funcall instance-of? map PersistentHashMap))
              (fail (str type-name " values must be created with its record constructors")))
            (put self RECORD_STATE (Object/freeze (js-object :map map :metadata metadata)))
            (Object/freeze self))))
      (install-method RecordValue "create" "create" 0
        (lambda (_self &rest values)
          (unless (= (js-length values) (js-length field-names))
            (fail (str "->" type-name " expects " (js-length field-names)
                       " values, received " (js-length values))))
          (new RecordValue RECORD_CONSTRUCTOR_TOKEN (make-initial-map type-state values))))
      (install-method RecordValue "fromMap" "fromMap" 1
        (lambda (_self source)
          (new RecordValue RECORD_CONSTRUCTOR_TOKEN (normalize-source-map type-state source))))
      (install-method RecordValue "isInstance" "isInstance" 1
        (lambda (_self value)
          (funcall instance-of? value RecordValue)))
      (let ((prototype (get RecordValue :prototype)))
        (install-getter prototype "count" "get count"
          (lambda (self) (get (get (aref self RECORD_STATE) :map) :count)))
        (install-getter prototype "size" "get size"
          (lambda (self) (get self :count)))
        (install-method prototype "get" "get" 1
          (lambda (self key &rest optional)
            (let ((not-found (if (or (= (js-length optional) 0) (undefined? (get optional 0)))
                                 nil
                                 (get optional 0))))
              (js-call (get (aref self RECORD_STATE) :map) :get key not-found))))
        (install-method prototype "has" "has" 1
          (lambda (self key)
            (js-call (get (aref self RECORD_STATE) :map) :has key)))
        (install-method prototype "assoc" "assoc" 2
          (lambda (self key value)
            (let* ((state (aref self RECORD_STATE))
                   (previous (get state :map))
                   (map (js-call previous :assoc key value)))
              (if (eq map previous)
                  self
                  (new RecordValue RECORD_CONSTRUCTOR_TOKEN map (get state :metadata))))))
        (install-method prototype "dissoc" "dissoc" 1
          (lambda (self key)
            (let* ((state (aref self RECORD_STATE))
                   (previous (get state :map)))
              (if (>= (declared-field-index type-state key) 0)
                  (map-with-metadata (js-call previous :dissoc key) (get state :metadata))
                  (let ((map (js-call previous :dissoc key)))
                    (if (eq map previous)
                        self
                        (new RecordValue RECORD_CONSTRUCTOR_TOKEN map (get state :metadata))))))))
        (install-method prototype "entries" "entries" 0
          (lambda (self) (js-call (get (aref self RECORD_STATE) :map) :entries)))
        (install-method prototype "keys" "keys" 0
          (lambda (self) (js-call (get (aref self RECORD_STATE) :map) :keys)))
        (install-method prototype "values" "values" 0
          (lambda (self) (js-call (get (aref self RECORD_STATE) :map) :values)))
        (install-method prototype "toPersistentMap" "toPersistentMap" 0
          (lambda (self)
            (let ((state (aref self RECORD_STATE)))
              (map-with-metadata (get state :map) (get state :metadata)))))
        (install-method prototype COLLECTION_COUNT "[COLLECTION_COUNT]" 0
          (lambda (self) (get self :count)))
        (install-method prototype COLLECTION_EMPTY "[COLLECTION_EMPTY]" 0
          (lambda (self)
            (map-with-metadata EMPTY_MAP (get (aref self RECORD_STATE) :metadata))))
        (install-method prototype COLLECTION_CONJ "[COLLECTION_CONJ]" 1
          (lambda (self entry)
            (let (([key value] (readCollectionEntry entry)))
              (js-call self :assoc key value))))
        (install-method prototype COLLECTION_GET "[COLLECTION_GET]" 1
          (lambda (self key &rest optional)
            (let ((not-found (if (or (= (js-length optional) 0) (undefined? (get optional 0)))
                                 nil
                                 (get optional 0))))
              (js-call self :get key not-found))))
        (install-method prototype COLLECTION_ASSOC "[COLLECTION_ASSOC]" 2
          (lambda (self key value) (js-call self :assoc key value)))
        (install-method prototype COLLECTION_CONTAINS "[COLLECTION_CONTAINS]" 1
          (lambda (self key) (js-call self :has key)))
        (install-method prototype COLLECTION_DISSOC "[COLLECTION_DISSOC]" 1
          (lambda (self key) (js-call self :dissoc key)))
        (install-method prototype COLLECTION_SEQ "[COLLECTION_SEQ]" 0
          (lambda (self)
            (if (= (get self :count) 0)
                nil
                (sequenceView (lambda () (js-call self :entries)) (get self :count)))))
        (install-method prototype COLLECTION_REDUCE "[COLLECTION_REDUCE]" 1
          (lambda (self reducer &rest initial)
            (apply reduceIterable (js-call (js-array self reducer) :concat initial))))
        (install-method prototype COLLECTION_REDUCE_KV "[COLLECTION_REDUCE_KV]" 2
          (lambda (self reducer initial)
            (reduce-kv-entries (js-call self :entries) reducer initial)))
        (install-method prototype VALUE_EQUAL "[VALUE_EQUAL]" 2
          (lambda (self other equal)
            (and (funcall instance-of? other RecordValue)
                 (funcall equal (get (aref self RECORD_STATE) :map) (get (aref other RECORD_STATE) :map)))))
        (install-method prototype VALUE_HASH "[VALUE_HASH]" 1
          (lambda (self hash)
            (finishHash
              (mixHash
                (mixHash RECORD_HASH_TAG (hashString (get type-state :signature)))
                (funcall hash (get (aref self RECORD_STATE) :map)))
              (get self :count))))
        (install-method prototype METADATA_READ "[METADATA_READ]" 0
          (lambda (self) (get (aref self RECORD_STATE) :metadata)))
        (install-method prototype METADATA_WITH "[METADATA_WITH]" 1
          (lambda (self metadata)
            (let ((state (aref self RECORD_STATE)))
              (if (eq metadata (get state :metadata))
                  self
                  (new RecordValue RECORD_CONSTRUCTOR_TOKEN (get state :map) metadata)))))
        (install-method prototype (get globalThis/Symbol :iterator) "[Symbol.iterator]" 0
          (lambda (self) (js-call self :entries)))
        (install-getter prototype (get globalThis/Symbol :toStringTag) "get [Symbol.toStringTag]"
          (lambda (_self) (str "EliscriptRecord:" type-name)))
        (Object/defineProperty RecordValue "name" (js-object :value type-name))
        (Object/defineProperties RecordValue
          (js-object
            :recordName (js-object :enumerable t :value type-name)
            :recordFields (js-object :enumerable t :value field-names)))
        (let ((index 0))
          (while (< index (js-length field-names))
            (let ((field-name (get field-names index))
                  (field-key (get field-keys index)))
              (when (Reflect/has prototype field-name)
                (fail (str "record field " field-name " conflicts with a record member")))
              (install-getter prototype field-name "get"
                (lambda (self)
                  (js-call (get (aref self RECORD_STATE) :map) :get field-key))
                t))
            (setq index (1+ index))))
        (Object/freeze prototype))
      (Object/freeze RecordValue)
      (js-call record-types :add RecordValue)
      RecordValue))

  (defun defineRecordType (name fields)
    (make-record-type name fields false))

  (defun materializeRecordType (name fields)
    (make-record-type name fields t))

  (defun isRecordType (value)
    (and (= (funcall typeof-value value) "function")
         (js-call record-types :has value)))

  (defun isRecord (value)
    (and (not (nil? value))
         (= (funcall typeof-value value) "object")
         (isRecordType (get value :constructor))))

  (defun recordType (value)
    (unless (isRecord value)
      (fail "expected an Eliscript record"))
    (get value :constructor))

  (defun recordTypeName (value)
    (let ((type (if (isRecordType value) value (recordType value))))
      (get type :recordName)))

  (defun recordFieldNames (value)
    (let ((type (if (isRecordType value) value (recordType value))))
      (get type :recordFields)))

  (defun readRecordState (value)
    (if (or (nil? value) (not (= (funcall typeof-value value) "object")))
        undefined
        (let ((descriptor (Object/getOwnPropertyDescriptor value RECORD_STATE)))
          (if (and (not (undefined? descriptor)) (Reflect/has descriptor "value"))
              (get descriptor :value)
              undefined))))

  (export
    defineRecordType
    materializeRecordType
    isRecordType
    isRecord
    recordType
    recordTypeName
    recordFieldNames
    readRecordState))
