(module eliscript.runtime.literals
  (import "./core/identifier.mjs" eliscriptSymbol keyword)
  (import "./core/list.mjs" persistentList)
  (import "./core/map.mjs" persistentHashMap)
  (import "./core/queue.mjs" persistentQueue)
  (import "./core/set.mjs" persistentHashSet)
  (import "./core/vector.mjs" persistentVector)

  (defconst symbol eliscriptSymbol)

  (defun list (&rest values)
    (apply persistentList values))

  (defun vector (&rest values)
    (apply persistentVector values))

  (defun hashMap (&rest key-values)
    (unless (= (mod (js-length key-values) 2) 0)
      (throw (new globalThis/TypeError "hash-map expects complete key/value pairs")))
    (let ((entries (js-array))
          (index 0)
          (limit (js-length key-values)))
      (while (< index limit)
        (js-call entries :push (js-array (get key-values index) (get key-values (+ index 1))))
        (setq index (+ index 2)))
      (apply persistentHashMap entries)))

  (defun hashSet (&rest values)
    (apply persistentHashSet values))

  (defun queue (&rest values)
    (apply persistentQueue values))

  (export
    symbol
    keyword
    list
    vector
    hashMap
    hashSet
    queue))
