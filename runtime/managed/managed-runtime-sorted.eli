(module eliscript.managed-runtime-sorted
  (import "./order.mjs" comparator compareValues)
  (import "./value.mjs" equalValues)
  (import "./identifier.mjs" isKeyword identifierNamespace identifierName)
  (import "../../stdlib/bit.eli" rotate-left)
  (import "../managed/managed-sorted-state.eli"
    managed-sorted-set-default-comparator managed-sorted-size managed-sorted-find managed-sorted-assoc managed-sorted-dissoc
    managed-sorted-iterator managed-sorted-transform-iterator managed-sorted-build)
  (import "../managed/managed-literals.eli"
    literal-instance? literal-register-transport-handler
    literal-entry literal-each literal-mix literal-finish
    literal-private-symbol literal-private-weak-map)
  (import "../../stdlib/protocol.eli" protocol-slot extend-protocol-type)
  (import "../managed/managed-literal-protocols.eli"
    managed-literal-reduce-iterable managed-literal-sequence-view managed-literal-reduced
    managed-literal-slot managed-literal-register-role-extension managed-literal-print-handlers managed-literal-brand-true
    PERSISTENT_MAP_KIND PERSISTENT_MAP_HAS_VALUE_KEY PERSISTENT_SET_KIND PERSISTENT_SET_HAS_VALUE)

  (defconst sorted-token (literal-private-symbol "eliscript.sorted.constructor-token"))
  (defconst sorted-states (literal-private-weak-map))
  (defconst present (Object/freeze (js-object)))
  (defconst DEFAULT_COMPARATOR compareValues)
  (managed-sorted-set-default-comparator DEFAULT_COMPARATOR)
  (defvar sorted-method-descriptor nil)
  (defvar sorted-getter-descriptor nil)
  (defvar sorted-length-descriptor nil)
  (defun ensure-sorted-method-descriptor ()
    (or sorted-method-descriptor
      (setq sorted-method-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :value undefined)
          (put descriptor :writable t)
          (put descriptor :configurable t)
          descriptor))))
  (defun ensure-sorted-getter-descriptor ()
    (or sorted-getter-descriptor
      (setq sorted-getter-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :get undefined)
          (put descriptor :configurable t)
          descriptor))))
  (defun ensure-sorted-length-descriptor ()
    (or sorted-length-descriptor
      (setq sorted-length-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :value 0)
          (put descriptor :configurable t)
          descriptor))))

  (defun fail (message) (throw (new globalThis/TypeError message)))
  (defun sorted-truth (value) (js* "!!value"))
  (defun callable? (value) (= (js* "typeof value") "function"))
  (defun object? (value)
    (or (and (not (nil? value)) (= (js* "typeof value") "object")) (callable? value)))
  (defun method (implementation name arity)
    (let ((result (funcall
      (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, this, args); } })[name]; }")
      implementation name)))
      (unless (= arity 0)
        (let ((len-desc (ensure-sorted-length-descriptor)))
          (put len-desc :value arity)
          (Reflect/defineProperty result "length" len-desc)))
      result))
  (defun receiver-method (implementation name arity)
    (let ((result (funcall
      (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, undefined, [this, ...args]); } })[name]; }")
      implementation name)))
      (unless (= arity 0)
        (let ((len-desc (ensure-sorted-length-descriptor)))
          (put len-desc :value arity)
          (Reflect/defineProperty result "length" len-desc)))
      result))
  (defun install-cached-method (target key method-fn)
    (let ((desc (ensure-sorted-method-descriptor)))
      (put desc :value method-fn)
      (Reflect/defineProperty target key desc)
      (put desc :value undefined)))
  (defun install-cached-getter (target key getter-fn)
    (let ((desc (ensure-sorted-getter-descriptor)))
      (put desc :get getter-fn)
      (Reflect/defineProperty target key desc)
      (put desc :get undefined)))
  (defun install-method (target key name arity implementation)
    (install-cached-method target key (method implementation name arity)))
  (defun install-getter (target key name implementation)
    (install-cached-getter target key (method implementation name 0)))
  (defun install-receiver-method (target key name arity implementation)
    (install-cached-method target key (receiver-method implementation name arity)))
  (defun install-receiver-getter (target key name implementation)
    (install-cached-getter target key (receiver-method implementation name 0)))
  (defun normalize-comparator (comparison)
    (if (or (eq comparison compareValues) (eq comparison DEFAULT_COMPARATOR)) DEFAULT_COMPARATOR (comparator comparison)))

  (defconst PersistentSortedMap (funcall
    (js* "(implementation, name) => { if (typeof name !== \"string\") throw new TypeError(\"class name must be a string\"); return ({ [name]: class { constructor(...args) { return implementation(this, ...args); } } })[name]; }")
    (lambda (self token root comparison &optional metadata)
      (unless (and (eq token sorted-token) (callable? comparison))
        (fail "PersistentSortedMap values must be created with persistentSortedMap or persistentSortedMapBy"))
      (when (undefined? metadata) (setq metadata nil))
      (js-call sorted-states :set self (js-array 0 root comparison metadata))
      (Object/freeze self)) "PersistentSortedMap"))
  (defconst PersistentSortedSet (funcall
    (js* "(implementation, name) => { if (typeof name !== \"string\") throw new TypeError(\"class name must be a string\"); return ({ [name]: class { constructor(...args) { return implementation(this, ...args); } } })[name]; }")
    (lambda (self token map &optional metadata)
      (unless (and (eq token sorted-token) (literal-instance? map PersistentSortedMap))
        (fail "PersistentSortedSet values must be created with persistentSortedSet or persistentSortedSetBy"))
      (when (undefined? metadata) (setq metadata nil))
      (js-call sorted-states :set self (js-array 1 map metadata))
      (Object/freeze self)) "PersistentSortedSet"))
  (Object/defineProperty PersistentSortedMap "length" (js-object :value 3 :configurable t))
  (Object/defineProperty PersistentSortedSet "length" (js-object :value 2 :configurable t))
  (defconst PersistentSortedMap-prototype (get PersistentSortedMap :prototype))
  (defconst PersistentSortedSet-prototype (get PersistentSortedSet :prototype))
  (defun make-map (root comparison &optional metadata)
    (when (undefined? metadata) (setq metadata nil))
    (let ((self (Object/create PersistentSortedMap-prototype)))
      (js-call sorted-states :set self (js-array 0 root comparison metadata))
      (Object/freeze self)))
  (defun make-set (map &optional metadata)
    (when (undefined? metadata) (setq metadata nil))
    (let ((self (Object/create PersistentSortedSet-prototype)))
      (js-call sorted-states :set self (js-array 1 map metadata))
      (Object/freeze self)))
  (defun map-record (self)
    (let ((record (js-call sorted-states :get self)))
      (if (and (not (undefined? record)) (= (aref record 0) 0)) record undefined)))
  (defun set-record (self)
    (let ((record (js-call sorted-states :get self)))
      (if (and (not (undefined? record)) (= (aref record 0) 1)) record undefined)))
  (defun set-map-record (self)
    (let ((record (set-record self)))
      (if (undefined? record) undefined (map-record (aref record 1)))))

  ;; Destructuring in the original map protocols consumes at most two values,
  ;; unlike the strict two-value entry check used by public conj/from.
  (defun protocol-pair (entry)
    (let* ((iterator (js-call (aref entry (get globalThis/Symbol :iterator)) :call entry))
           (next nil) (done false) (key undefined) (value undefined))
      (unless (object? iterator) (fail "iterator must be an object"))
      (setq next (get iterator :next))
      (let ((step (js-call next :call iterator)))
        (unless (object? step) (fail "iterator result must be an object"))
        (setq done (sorted-truth (get step :done)))
        (unless done
          (setq key (get step :value))
          (let ((second (js-call next :call iterator)))
            (unless (object? second) (fail "iterator result must be an object"))
            (setq done (sorted-truth (get second :done)))
            (unless done (setq value (get second :value))))))
      (unless done
        (let ((close (get iterator :return)))
          (unless (nullish? close)
            (let ((closed (js-call close :call iterator)))
              (unless (object? closed) (fail "iterator return must return an object"))))))
      (js-array key value)))
  (defun unordered-hash (self hash map-mode)
    (let ((sum 0) (xor 0) (product 1) (count 0))
      (literal-each self (lambda (entry)
        (let ((item (uint32 (if map-mode
                      (literal-finish (literal-mix (literal-mix 982610667 (funcall hash (get entry 0))) (funcall hash (get entry 1))) 2)
                      (funcall hash entry)))))
          (setq sum (uint32 (+ sum item)) xor (uint32 (bit-xor xor (rotate-left item (bit-and item 31))))
            product (uint32 (imul32 product (bit-or item 1))) count (1+ count)))))
      (literal-finish (literal-mix (literal-mix (literal-mix (if map-mode 1821285621 1374139181) sum) xor) product) count)))

  (install-method PersistentSortedMap "empty" "empty" 0 (lambda (&rest comparisons)
    (emptySortedMapBy (if (or (= (js-length comparisons) 0) (undefined? (aref comparisons 0))) compareValues (aref comparisons 0)))))
  (install-method PersistentSortedMap "from" "from" 1 (lambda (entries &rest options)
    (if (and (literal-instance? entries PersistentSortedMap) (= (js-length options) 0)) entries
      (let ((result (emptySortedMapBy (if (or (= (js-length options) 0) (undefined? (get options 0))) compareValues (get options 0)))))
        (literal-each entries (lambda (entry)
          (let ((pair (literal-entry entry))) (setq result (js-call result :assoc (get pair 0) (get pair 1)))))) result))))
  (install-method PersistentSortedSet "empty" "empty" 0 (lambda (&rest comparisons)
    (emptySortedSetBy (if (or (= (js-length comparisons) 0) (undefined? (aref comparisons 0))) compareValues (aref comparisons 0)))))
  (install-method PersistentSortedSet "from" "from" 1 (lambda (values &rest options)
    (if (and (literal-instance? values PersistentSortedSet) (= (js-length options) 0)) values
      (let ((result (emptySortedSetBy (if (or (= (js-length options) 0) (undefined? (get options 0))) compareValues (get options 0)))))
        (literal-each values (lambda (value) (setq result (js-call result :conj value)))) result))))
  ;; Named implementations receive the wrapper receiver dynamically.
  ;; Arrow bodies would capture the initializer receiver instead.
  (defun sorted-method-has (key)
    (let* ((self (js* "this")) (state (map-record self)))
      (if (not (undefined? state))
        (not (nil? (managed-sorted-find (aref state 1) key (aref state 2))))
        (js-call (aref (set-record self) 1) :has key))))
  (defun sorted-method-entries (&rest directions)
    (let* ((self (js* "this"))
           (ascending (if (or (= (js-length directions) 0) (undefined? (aref directions 0))) t (aref directions 0)))
           (state (map-record self)))
      (if (not (undefined? state))
        (managed-sorted-iterator (aref state 1) (aref state 2) ascending nil nil 1)
        (managed-sorted-transform-iterator (lambda () (js-call self :values ascending)) 2))))
  (defun sorted-method-keys (&rest directions)
    (let ((self (js* "this"))
          (ascending (if (or (= (js-length directions) 0) (undefined? (aref directions 0))) t (aref directions 0))))
      (if (not (undefined? (map-record self)))
        (let ((entries (js-call self :entries ascending)))
          (managed-sorted-transform-iterator (lambda () entries) 0))
        (js-call self :values ascending))))
  (defun sorted-method-values (&rest directions)
    (let ((self (js* "this"))
          (ascending (if (or (= (js-length directions) 0) (undefined? (aref directions 0))) t (aref directions 0))))
      (if (not (undefined? (map-record self)))
        (let ((entries (js-call self :entries ascending)))
          (managed-sorted-transform-iterator (lambda () entries) 1))
        (let ((state (set-map-record self)))
          (managed-sorted-iterator (aref state 1) (aref state 2) ascending nil nil 2)))))
  (defun sorted-method-iterator ()
    (let ((self (js* "this")))
      (if (not (undefined? (map-record self))) (js-call self :entries) (js-call self :values))))
  (defun sorted-method-tag ()
    (if (not (undefined? (map-record (js* "this")))) "EliscriptPersistentSortedMap" "EliscriptPersistentSortedSet"))
  (defun sorted-method-assoc (key value)
    (let* ((self (js* "this")) (state (map-record self)) (old-root (aref state 1))
           (next-root (managed-sorted-assoc old-root key value (aref state 2))))
      (if (eq next-root old-root) self (make-map next-root (aref state 2) (aref state 3)))))
  (defun sorted-method-dissoc (key)
    (let* ((self (js* "this")) (state (map-record self)) (old-root (aref state 1))
           (next-root (managed-sorted-dissoc old-root key (aref state 2))))
      (if (eq next-root old-root) self (make-map next-root (aref state 2) (aref state 3)))))
  (defun sorted-method-disj (value)
    (let* ((self (js* "this")) (state (set-record self)) (previous (aref state 1)) (map (js-call previous :dissoc value)))
      (if (eq map previous) self (make-set map (aref state 2)))))
  (defun sorted-method-get (key &optional notFound)
    (when (undefined? notFound) (setq notFound nil))
    (let* ((state (map-record (js* "this"))) (found (managed-sorted-find (aref state 1) key (aref state 2))))
      (if (nil? found) notFound (get found :value))))
  (defun sorted-method-has-value-key (key)
    (let* ((state (map-record (js* "this"))) (found (managed-sorted-find (aref state 1) key (aref state 2))))
      (and (not (nil? found)) (equalValues (get found :key) key))))
  (defun sorted-method-conj (value)
    (let* ((self (js* "this")) (state (set-record self)) (previous (aref state 1)) (map (js-call previous :assoc value present)))
      (if (eq map previous) self (make-set map (aref state 2)))))
  (defvar sorted-shared-size-getter nil)
  (defvar sorted-shared-has-method nil)
  (defvar sorted-map-assoc-method nil)
  (defvar sorted-map-dissoc-method nil)
  (defvar sorted-set-disj-method nil)
  (let ((map-prototype (get PersistentSortedMap :prototype))
        (set-prototype (get PersistentSortedSet :prototype))
        (shared-count-getter (receiver-method (lambda (self)
          (let ((state (map-record self)))
            (if (not (undefined? state))
              (managed-sorted-size (aref state 1))
              (get (aref (set-record self) 1) :count)))) "get count" 0))
        (shared-size-getter (receiver-method (lambda (self) (get self :count)) "get size" 0))
        (shared-comparator-getter (receiver-method (lambda (self)
          (let ((state (map-record self)))
            (if (not (undefined? state))
              (aref state 2)
              (get (aref (set-record self) 1) :comparator)))) "get comparator" 0))
        (shared-has-method (method sorted-method-has "has" 1))
        (shared-entries-method (method sorted-method-entries "entries" 0))
        (shared-keys-method (method sorted-method-keys "keys" 0))
        (shared-values-method (method sorted-method-values "values" 0))
        (shared-iterator-method (method sorted-method-iterator "[Symbol.iterator]" 0))
        (shared-brand-getter (method managed-literal-brand-true "get [eliscript.persistent-kind]" 0))
        (shared-tag-getter (method sorted-method-tag
          "get [Symbol.toStringTag]" 0)))
    (setq sorted-shared-size-getter shared-size-getter
          sorted-shared-has-method shared-has-method
          sorted-map-assoc-method (method sorted-method-assoc "assoc" 2)
          sorted-map-dissoc-method (method sorted-method-dissoc "dissoc" 1)
          sorted-set-disj-method (method sorted-method-disj "disj" 1))
    (install-cached-getter map-prototype "count" shared-count-getter)
    (install-cached-getter map-prototype "size" shared-size-getter)
    (install-cached-getter map-prototype "comparator" shared-comparator-getter)
    (install-method map-prototype "get" "get" 1 sorted-method-get)
    (install-cached-method map-prototype "has" shared-has-method)
    (install-cached-method map-prototype "assoc" sorted-map-assoc-method)
    (install-cached-method map-prototype "dissoc" sorted-map-dissoc-method)
    (install-cached-method map-prototype "entries" shared-entries-method)
    (install-cached-method map-prototype "keys" shared-keys-method)
    (install-cached-method map-prototype "values" shared-values-method)
    (install-method map-prototype PERSISTENT_MAP_HAS_VALUE_KEY "[eliscript.persistent-map.has-value-key]" 1 sorted-method-has-value-key)
    (install-cached-getter map-prototype PERSISTENT_MAP_KIND shared-brand-getter)
    (install-cached-method map-prototype (get globalThis/Symbol :iterator) shared-iterator-method)
    (install-cached-getter map-prototype (get globalThis/Symbol :toStringTag) shared-tag-getter)
    (install-cached-getter set-prototype "count" shared-count-getter)
    (install-cached-getter set-prototype "size" shared-size-getter)
    (install-cached-getter set-prototype "comparator" shared-comparator-getter)
    (install-cached-method set-prototype "has" shared-has-method)
    (install-method set-prototype "conj" "conj" 1 sorted-method-conj)
    (install-cached-method set-prototype "disj" sorted-set-disj-method)
    (install-cached-method set-prototype "values" shared-values-method)
    (install-cached-method set-prototype "keys" shared-keys-method)
    (install-cached-method set-prototype "entries" shared-entries-method)
    (install-receiver-method set-prototype PERSISTENT_SET_HAS_VALUE "[eliscript.persistent-set.has-value]" 2 (lambda (self value equal)
      (let* ((state (set-map-record self)) (found (managed-sorted-find (aref state 1) value (aref state 2))))
        (and (not (nil? found)) (funcall equal (get found :key) value)))))
    (install-cached-getter set-prototype PERSISTENT_SET_KIND shared-brand-getter)
    (install-cached-method set-prototype (get globalThis/Symbol :iterator) shared-iterator-method)
    (install-cached-getter set-prototype (get globalThis/Symbol :toStringTag) shared-tag-getter)
    (setq sorted-method-descriptor nil sorted-getter-descriptor nil sorted-length-descriptor nil))

  (defun install-sorted-role-protocol (role protocol)
    (let ((map-prototype (get PersistentSortedMap :prototype))
          (set-prototype (get PersistentSortedSet :prototype)))
      (cond
        ((= role "collection.ICounted")
          (let ((slot (protocol-slot protocol "count")))
            (install-cached-method map-prototype slot sorted-shared-size-getter)
            (install-cached-method set-prototype slot sorted-shared-size-getter)))
        ((= role "collection.IEmptyable")
          (let ((slot (protocol-slot protocol "empty"))
                (shared (receiver-method (lambda (self)
                  (let ((state (map-record self)))
                    (if (not (undefined? state))
                      (make-map nil (aref state 2) (aref state 3))
                      (let ((set-state (set-record self))
                            (empty-slot (managed-literal-slot "collection.IEmptyable" "empty")))
                        (make-set (js-call (aref (aref set-state 1) empty-slot) :call (aref set-state 1)) (aref set-state 2)))))) "[IEmptyable.empty]" 0)))
            (install-cached-method map-prototype slot shared)
            (install-cached-method set-prototype slot shared)))
        ((= role "collection.IConj")
          (let ((slot (protocol-slot protocol "conj"))
                (shared (receiver-method (lambda (self entry)
                  (if (not (undefined? (map-record self)))
                    (let ((pair (literal-entry entry))) (js-call self :assoc (get pair 0) (get pair 1)))
                    (js-call self :conj entry))) "[IConj.conj]" 1)))
            (install-cached-method map-prototype slot shared)
            (install-cached-method set-prototype slot shared)))
        ((= role "collection.ILookup")
          (let ((slot (protocol-slot protocol "get"))
                (shared (receiver-method (lambda (self key &optional notFound)
                  (if (not (undefined? (map-record self)))
                    (js-call self :get key notFound)
                    (progn
                      (when (undefined? notFound) (setq notFound nil))
                      (let* ((state (set-map-record self)) (found (managed-sorted-find (aref state 1) key (aref state 2))))
                        (if (nil? found) notFound (get found :key)))))) "[ILookup.get]" 1)))
            (install-cached-method map-prototype slot shared)
            (install-cached-method set-prototype slot shared)))
        ((= role "collection.IAssociative")
          (let ((assoc-slot (protocol-slot protocol "assoc"))
                (contains-slot (protocol-slot protocol "contains")))
            (install-cached-method map-prototype assoc-slot sorted-map-assoc-method)
            (install-cached-method map-prototype contains-slot sorted-shared-has-method)
            (install-cached-method set-prototype contains-slot sorted-shared-has-method)))
        ((= role "collection.IMap")
          (install-cached-method map-prototype (protocol-slot protocol "dissoc") sorted-map-dissoc-method))
        ((= role "collection.ISet")
          (install-cached-method set-prototype (protocol-slot protocol "disj") sorted-set-disj-method))
        ((= role "collection.ISeqable")
          (let ((slot (protocol-slot protocol "seq"))
                (shared (receiver-method (lambda (self)
                  (if (= (get self :count) 0) nil
                    (if (not (undefined? (map-record self)))
                      (managed-literal-sequence-view (lambda () (js-call self :entries)) (get self :count))
                      (managed-literal-sequence-view (lambda () (js-call self :values)) (get self :count))))) "[ISeqable.seq]" 0)))
            (install-cached-method map-prototype slot shared)
            (install-cached-method set-prototype slot shared)))
        ((= role "collection.IReversible")
          (let ((slot (protocol-slot protocol "rseq"))
                (shared (receiver-method (lambda (self)
                  (if (= (get self :count) 0) nil
                    (if (not (undefined? (map-record self)))
                      (managed-literal-sequence-view (lambda () (js-call self :entries false)) (get self :count))
                      (managed-literal-sequence-view (lambda () (js-call self :values false)) (get self :count))))) "[IReversible.rseq]" 0)))
            (install-cached-method map-prototype slot shared)
            (install-cached-method set-prototype slot shared)))
        ((= role "collection.IReduce")
          (let ((slot (protocol-slot protocol "reduce"))
                (shared (receiver-method (lambda (self reducer &rest initial) (managed-literal-reduce-iterable self reducer initial)) "[IReduce.reduce]" 1)))
            (install-cached-method map-prototype slot shared)
            (install-cached-method set-prototype slot shared)))
        ((= role "collection.IKVReduce")
          (install-receiver-method map-prototype (protocol-slot protocol "reduceKV") "[IKVReduce.reduceKV]" 2 (lambda (self reducer initial)
            (managed-literal-reduce-iterable self (lambda (result entry)
              (let ((pair (protocol-pair entry))) (funcall reducer result (get pair 0) (get pair 1)))) (js-array initial)))))
        ((= role "value.IEquiv")
          (let ((slot (protocol-slot protocol "equal"))
                (shared (receiver-method (lambda (self other equal)
                  (if (not (undefined? (map-record self)))
                    (if (not (and (not (nullish? other)) (eq (aref other PERSISTENT_MAP_KIND) t)
                                  (callable? (aref other PERSISTENT_MAP_HAS_VALUE_KEY)) (= (get other :count) (get self :count)))) false
                      (managed-literal-reduce-iterable self (lambda (previous entry)
                        (let ((pair (protocol-pair entry)))
                          (if (and (sorted-truth (js-call (aref other PERSISTENT_MAP_HAS_VALUE_KEY) :call other (get pair 0)))
                                   (sorted-truth (funcall equal (get pair 1) (js-call other :get (get pair 0)))))
                            t (managed-literal-reduced false)))) (js-array t)))
                    (if (not (and (not (nullish? other)) (eq (aref other PERSISTENT_SET_KIND) t)
                                  (callable? (aref other PERSISTENT_SET_HAS_VALUE)) (= (get other :count) (get self :count)))) false
                      (managed-literal-reduce-iterable self (lambda (previous value)
                        (if (sorted-truth (js-call (aref other PERSISTENT_SET_HAS_VALUE) :call other value equal))
                          t (managed-literal-reduced false))) (js-array t))))) "[IEquiv.equal]" 2)))
            (install-cached-method map-prototype slot shared)
            (install-cached-method set-prototype slot shared)))
        ((= role "value.IHash")
          (let ((slot (protocol-slot protocol "hash"))
                (shared (receiver-method (lambda (self hash)
                  (unordered-hash self hash (not (undefined? (map-record self))))) "[IHash.hash]" 1)))
            (install-cached-method map-prototype slot shared)
            (install-cached-method set-prototype slot shared)))
        ((= role "metadata.IMeta")
          (let ((slot (protocol-slot protocol "meta"))
                (shared (receiver-method (lambda (self)
                  (let ((state (map-record self)))
                    (if (not (undefined? state)) (aref state 3) (aref (set-record self) 2)))) "[IMeta.meta]" 0)))
            (install-cached-method map-prototype slot shared)
            (install-cached-method set-prototype slot shared)))
        ((= role "metadata.IWithMeta")
          (let ((slot (protocol-slot protocol "withMeta"))
                (shared (receiver-method (lambda (self metadata)
                  (let ((state (map-record self)))
                    (if (not (undefined? state))
                      (if (eq metadata (aref state 3)) self (make-map (aref state 1) (aref state 2) metadata))
                      (let ((set-state (set-record self)))
                        (if (eq metadata (aref set-state 2)) self (make-set (aref set-state 1) metadata)))))) "[IWithMeta.withMeta]" 1)))
            (install-cached-method map-prototype slot shared)
            (install-cached-method set-prototype slot shared)))
        ((= role "data-text.IPrint")
          (let ((handlers (managed-literal-print-handlers)))
            (when (not (nil? handlers))
              (extend-protocol-type protocol PersistentSortedMap (js-object :print (aref handlers 0)))
              (extend-protocol-type protocol PersistentSortedSet (js-object :print (aref handlers 1)))))))
      (setq sorted-method-descriptor nil sorted-getter-descriptor nil sorted-length-descriptor nil)))
  (managed-literal-register-role-extension install-sorted-role-protocol)

  (defconst EMPTY_SORTED_MAP (make-map nil DEFAULT_COMPARATOR))
  (defconst EMPTY_SORTED_SET (make-set EMPTY_SORTED_MAP))
  (defun emptySortedMapBy (comparison)
    (let ((normalized (normalize-comparator comparison)))
      (if (eq normalized DEFAULT_COMPARATOR) EMPTY_SORTED_MAP (make-map nil normalized))))
  (defun emptySortedSetBy (comparison)
    (let ((map (emptySortedMapBy comparison))) (if (eq map EMPTY_SORTED_MAP) EMPTY_SORTED_SET (make-set map))))
  (defun require-even (values label)
    (unless (= (% (js-length values) 2) 0)
      (fail (str label " expects an even number of key/value forms"))))
  (defun populate-map (map values)
    (let ((result map) (index 0))
      (while (< index (js-length values))
        (setq result (js-call result :assoc (get values index) (get values (1+ index))) index (+ index 2))) result))
  (defun persistentSortedMap (&rest key-values)
    (require-even key-values "persistentSortedMap") (populate-map EMPTY_SORTED_MAP key-values))
  (defun persistentSortedMapBy (comparison &rest key-values)
    (require-even key-values "persistentSortedMapBy") (populate-map (emptySortedMapBy comparison) key-values))
  (defun persistentSortedSet (&rest values)
    (let ((result EMPTY_SORTED_SET))
      (literal-each values (lambda (value) (setq result (js-call result :conj value)))) result))
  (defun persistentSortedSetBy (comparison &rest values)
    (let ((result (emptySortedSetBy comparison)))
      (literal-each values (lambda (value) (setq result (js-call result :conj value)))) result))
  (defun isPersistentSortedMap (value) (literal-instance? value PersistentSortedMap))
  (defun isPersistentSortedSet (value) (literal-instance? value PersistentSortedSet))
  (defun isPersistentSortedCollection (value) (or (isPersistentSortedMap value) (isPersistentSortedSet value)))

  (defun sorted-state (collection)
    (cond
      ((isPersistentSortedMap collection)
        (let ((state (map-record collection)))
          (js-object :root (aref state 1) :comparison (aref state 2)
            :factory (lambda (ascending start end)
              (managed-sorted-iterator (aref state 1) (aref state 2) ascending start end 1)))))
      ((isPersistentSortedSet collection)
        (let ((state (set-map-record collection)))
          (js-object :root (aref state 1) :comparison (aref state 2)
            :factory (lambda (ascending start end)
              (managed-sorted-iterator (aref state 1) (aref state 2) ascending start end 2)))))
      (t (fail "operation requires a persistent sorted collection"))))
  (defun require-boolean (value label)
    (unless (= (js* "typeof value") "boolean") (fail (str label " must be a boolean"))) value)
  (defun sortedComparator (collection)
    (cond
      ((isPersistentSortedMap collection) (aref (map-record collection) 2))
      ((isPersistentSortedSet collection) (aref (set-map-record collection) 2))
      (t (fail "operation requires a persistent sorted collection"))))
  (defun sortedSequence (collection &rest directions)
    (let* ((ascending (if (or (= (js-length directions) 0) (undefined? (aref directions 0))) t (aref directions 0)))
           (_checked (require-boolean ascending "sortedSequence ascending"))
           (state (sorted-state collection)))
      (if (nil? (get state :root)) nil
        (managed-literal-sequence-view (lambda () (funcall (get state :factory) ascending nil nil))
          (get (get state :root) :size)))))
  (defun sequence-or-null (factory)
    (let ((probe (funcall factory)) (done false))
      (try (setq done (sorted-truth (get (js-call probe :next) :done)))
        (finally (when (callable? (get probe :return)) (js-call probe :return))))
      (if done nil (managed-literal-sequence-view factory))))
  (defun sortedSequenceFrom (collection key &rest directions)
    (let* ((ascending (if (or (= (js-length directions) 0) (undefined? (aref directions 0))) t (aref directions 0)))
           (inclusive (if (or (< (js-length directions) 2) (undefined? (aref directions 1))) t (aref directions 1)))
           (_ascending (require-boolean ascending "sortedSequenceFrom ascending"))
           (_inclusive (require-boolean inclusive "sortedSequenceFrom inclusive"))
           (state (sorted-state collection)) (start (js-object :key key :inclusive inclusive)))
      (sequence-or-null (lambda () (funcall (get state :factory) ascending start nil)))))
  (defun bound-test-name (test)
    (let ((name (if (and (isKeyword test) (nil? (identifierNamespace test))) (identifierName test) test)))
      (unless (and (= (js* "typeof name") "string")
                   (or (= name "<") (= name "<=") (= name ">") (= name ">=")))
        (fail "sorted bound test must be one of :<, :<=, :>, or :>=")) name))
  (defun range-bounds (bounds)
    (unless (or (= (js-length bounds) 2) (= (js-length bounds) 4))
      (fail "subsequence expects one or two test/key bounds"))
    (let* ((first-test (bound-test-name (get bounds 0)))
           (first (js-object :key (get bounds 1) :inclusive (js-call first-test :includes "="))))
      (if (= (js-length bounds) 2)
        (if (js-call first-test :startsWith ">") (js-object :lower first :upper nil) (js-object :lower nil :upper first))
        (let ((second-test (bound-test-name (get bounds 2))))
          (unless (and (js-call first-test :startsWith ">") (js-call second-test :startsWith "<"))
            (fail "two-bound subsequence requires a lower :>/:>= bound then an upper :</:<= bound"))
          (js-object :lower first :upper (js-object :key (get bounds 3) :inclusive (js-call second-test :includes "=")))))))
  (defun range-sequence (collection ascending bounds)
    (let* ((state (sorted-state collection)) (normalized (range-bounds bounds))
           (start (get normalized (if ascending "lower" "upper")))
           (end (get normalized (if ascending "upper" "lower"))))
      (sequence-or-null (lambda () (funcall (get state :factory) ascending start end)))))
  (defun subsequence (collection &rest bounds) (range-sequence collection t bounds))
  (defun reverseSubsequence (collection &rest bounds) (range-sequence collection false bounds))

  (defun readSortedMapState (value)
    (if (and (object? value) (isPersistentSortedMap value))
      (let ((record (map-record value)))
        (if (undefined? record) undefined
          (let ((cached (aref record 4)))
            (if (not (undefined? cached)) cached
              (let ((view (Object/freeze (js-object :root (aref record 1) :comparison (aref record 2) :metadata (aref record 3)))))
                (put record 4 view) view))))) undefined))
  (defun readSortedSetState (value)
    (if (and (object? value) (isPersistentSortedSet value))
      (let ((record (set-record value)))
        (if (undefined? record) undefined
          (let ((cached (aref record 3)))
            (if (not (undefined? cached)) cached
              (let ((view (Object/freeze (js-object :map (aref record 1) :metadata (aref record 2)))))
                (put record 3 view) view))))) undefined))
  (defun materializeSortedMap (entries comparison &optional metadata)
    (unless (callable? comparison) (fail "sorted map comparison must be a function"))
    (make-map (managed-sorted-build entries 0 (js-length entries) t present) comparison metadata))
  (defun materializeSortedSet (values comparison &optional metadata)
    (unless (callable? comparison) (fail "sorted set comparison must be a function"))
    (make-set (make-map (managed-sorted-build values 0 (js-length values) false present) comparison) metadata))
  (defun isDefaultSortedComparator (value) (eq value DEFAULT_COMPARATOR))
  (defun defaultSortedComparator () DEFAULT_COMPARATOR)
    ;; One transport handler replaces the former loader plus three adapter
  ;; closures; the accepted kinds and records are unchanged.
  (literal-register-transport-handler
    (lambda (mode a b)
      (cond ((= mode 0)
          (if (isDefaultSortedComparator a) "sorted-default-comparator"
            ;; A transport brand belongs to the private state registry. Do not
            ;; observe an unrelated value through either public constructor:
            ;; its Symbol.hasInstance can run code and materialize a prototype.
            ;; Genuine registered values still pass the public instance and
            ;; frozen checks, including a replaced Symbol.hasInstance.
            (let ((record (if (object? a) (js-call sorted-states :get a) undefined)))
              (cond
                ((and (not (undefined? record)) (= (aref record 0) 0)
                      (isPersistentSortedMap a) (Object/isFrozen a)) "sorted-map")
                ((and (not (undefined? record)) (= (aref record 0) 1)
                      (isPersistentSortedSet a) (Object/isFrozen a)) "sorted-set")
                (t nil)))))
        ((= mode 1)
          (cond ((= a "sorted-default-comparator") (js-object :kind "sorted-default-comparator"))
            ((= a "sorted-map")
              (let ((state (map-record b)))
                (js-object :kind "sorted-map" :entries (Array/from b)
                  :comparison (aref state 2) :metadata (aref state 3))))
            ((= a "sorted-set")
              (let ((state (set-record b)))
                (js-object :kind "sorted-set" :values (Array/from b)
                  :comparison (get (aref state 1) :comparator) :metadata (aref state 2))))
            (t undefined)))
        (t (cond ((= a "sorted-default-comparator") DEFAULT_COMPARATOR)
            ((= a "sorted-map")
              (materializeSortedMap (get b :entries) (get b :comparison) (get b :metadata nil)))
            ((= a "sorted-set")
              (materializeSortedSet (get b :values) (get b :comparison) (get b :metadata nil)))
            (t undefined))))))
  (export PersistentSortedMap PersistentSortedSet EMPTY_SORTED_MAP EMPTY_SORTED_SET
    emptySortedMapBy emptySortedSetBy persistentSortedMap persistentSortedMapBy persistentSortedSet persistentSortedSetBy
    isPersistentSortedMap isPersistentSortedSet isPersistentSortedCollection sortedComparator sortedSequence sortedSequenceFrom
    subsequence reverseSubsequence readSortedMapState readSortedSetState materializeSortedMap materializeSortedSet
    isDefaultSortedComparator defaultSortedComparator))
