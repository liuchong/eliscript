(module eliscript.managed-literal-protocols
  (import "../../stdlib/protocol.eli"
    define-protocol protocol? protocol-slot protocol-method extend-protocol-type extend-protocol-category
    implements-protocol-operation? register-protocol-extension-loader flush-protocol-extension-loaders)
  (import-portable "../../stdlib/bit.eli" rotate-left)
  (import "./managed-value-state.eli" mixHash finishHash cachedProtocolHash recordHashValueCall hashPrimitiveValue)

  ;; Definitions and their private Symbols are shared by every adapter in this
  ;; target realm and materialized per canonical role on first actual demand.
  ;; Equal descriptions never stand in for actual slot identity.
  (defconst protocol-intrinsic-symbol globalThis/Symbol)
  (defconst protocol-intrinsic-weak-map globalThis/WeakMap)
  (defconst protocol-roles (new protocol-intrinsic-weak-map))
  (defconst role-protocols (Object/create nil))
  (defconst flushed-roles (js-array))
  (defconst role-extension-handlers (js-array))
  (defvar bound-constructor-roles nil)
  (defvar registered-constructors nil)
  (defvar role-bundles-owner nil)
  (defvar role-bundles nil)
  (defvar pending-type-extensions nil)
  (defvar armed-extension-protocols nil)
  (defvar print-handlers nil)
  (defun managed-literal-set-print-handlers (print-map print-set)
    (setq print-handlers (js-array print-map print-set)))
  (defun managed-literal-print-handlers () print-handlers)

  (defconst PERSISTENT_MAP_KIND (funcall protocol-intrinsic-symbol "eliscript.persistent-map.kind"))
  (defconst PERSISTENT_MAP_HAS_VALUE_KEY (funcall protocol-intrinsic-symbol "eliscript.persistent-map.has-value-key"))
  (defconst PERSISTENT_SET_KIND (funcall protocol-intrinsic-symbol "eliscript.persistent-set.kind"))
  (defconst PERSISTENT_SET_HAS_VALUE (funcall protocol-intrinsic-symbol "eliscript.persistent-set.has-value"))
  (defvar reduced-state nil)
  (defvar sequence-state nil)
  (defvar sequence-count nil)
  (defvar sequence-token nil)
  (defvar unbounded-sequence nil)
  (defvar no-initial nil)
  (defvar memo-state nil)
  (defvar memo-token nil)
  (defvar no-memo-failure nil)

  (defvar slot-method-descriptor nil)
  (defvar slot-length-descriptor nil)
  (defvar transient-assoc-slot nil)
  (defvar transient-assoc-method nil)
  (defvar transient-assoc-direct nil)
  (defun managed-literal-register-transient-assoc-direct (fn)
    (setq transient-assoc-direct fn) undefined)

  (defun ensure-reduced-state ()
    (or reduced-state (setq reduced-state (funcall protocol-intrinsic-symbol "eliscript.collection.reduced-state"))))
  (defun ensure-sequence-state ()
    (or sequence-state (setq sequence-state (funcall protocol-intrinsic-symbol "eliscript.collection.sequence-state"))))
  (defun ensure-sequence-count ()
    (or sequence-count (setq sequence-count (funcall protocol-intrinsic-symbol "eliscript.collection.sequence-count"))))
  (defun ensure-sequence-token ()
    (or sequence-token (setq sequence-token (funcall protocol-intrinsic-symbol "eliscript.collection.sequence-token"))))
  (defun ensure-unbounded-sequence ()
    (or unbounded-sequence (setq unbounded-sequence (funcall protocol-intrinsic-symbol "eliscript.collection.unbounded-sequence"))))
  (defun ensure-no-initial ()
    (or no-initial (setq no-initial (funcall protocol-intrinsic-symbol "eliscript.collection.no-initial"))))
  (defun ensure-memo-state ()
    (or memo-state (setq memo-state (funcall protocol-intrinsic-symbol "eliscript.collection.memoized-sequence-state"))))
  (defun ensure-memo-token ()
    (or memo-token (setq memo-token (funcall protocol-intrinsic-symbol "eliscript.collection.memoized-sequence-token"))))
  (defun ensure-no-memo-failure ()
    (or no-memo-failure (setq no-memo-failure (funcall protocol-intrinsic-symbol "eliscript.collection.no-memoized-sequence-failure"))))
  (defun ensure-slot-method-descriptor ()
    (or slot-method-descriptor
      (setq slot-method-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :value undefined)
          (put descriptor :writable t)
          (put descriptor :configurable t)
          descriptor))))
  (defun ensure-slot-length-descriptor ()
    (or slot-length-descriptor
      (setq slot-length-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :value 0)
          (put descriptor :configurable t)
          descriptor))))

  (defun managed-literal-protocol-fail (message) (throw (new globalThis/TypeError message)))
  (defun managed-literal-callable? (value) (= (js* "typeof value") "function"))
  (defun managed-literal-object? (value) (and (not (nil? value)) (= (js* "typeof value") "object")))
  (defun managed-literal-vector-type? (type) (or (= type 2) (= type 8)))
  (defun managed-literal-brand-true () t)

  (defun managed-literal-role-spec (role)
    (cond
      ((= role "collection.ICounted") (js-array "ICounted" (js-array "count") (js-array "eliscript.protocol.ICounted/count")))
      ((= role "collection.IEmptyable") (js-array "IEmptyable" (js-array "empty") (js-array "eliscript.protocol.IEmptyable/empty")))
      ((= role "collection.IConj") (js-array "IConj" (js-array "conj") (js-array "eliscript.protocol.IConj/conj")))
      ((= role "collection.ILookup") (js-array "ILookup" (js-array "get") (js-array "eliscript.protocol.ILookup/get")))
      ((= role "collection.IAssociative") (js-array "IAssociative" (js-array "assoc" "contains")
        (js-array "eliscript.protocol.IAssociative/assoc" "eliscript.protocol.IAssociative/contains")))
      ((= role "collection.IIndexed") (js-array "IIndexed" (js-array "nth") (js-array "eliscript.protocol.IIndexed/nth")))
      ((= role "collection.ISeqable") (js-array "ISeqable" (js-array "seq") (js-array "eliscript.protocol.ISeqable/seq")))
      ((= role "collection.IReduce") (js-array "IReduce" (js-array "reduce") (js-array "eliscript.protocol.IReduce/reduce")))
      ((= role "collection.IKVReduce") (js-array "IKVReduce" (js-array "reduceKV") (js-array "eliscript.protocol.IKVReduce/reduceKV")))
      ((= role "collection.IMap") (js-array "IMap" (js-array "dissoc") (js-array "eliscript.protocol.IMap/dissoc")))
      ((= role "collection.ISet") (js-array "ISet" (js-array "disj") (js-array "eliscript.protocol.ISet/disj")))
      ((= role "collection.IStack") (js-array "IStack" (js-array "peek" "pop")
        (js-array "eliscript.protocol.IStack/peek" "eliscript.protocol.IStack/pop")))
      ((= role "collection.IReversible") (js-array "IReversible" (js-array "rseq") (js-array "eliscript.protocol.IReversible/rseq")))
      ((= role "value.IEquiv") (js-array "IEquiv" (js-array "equal") (js-array "eliscript.protocol.IEquiv/equal")))
      ((= role "value.IHash") (js-array "IHash" (js-array "hash") (js-array "eliscript.protocol.IHash/hash")))
      ((= role "metadata.IMeta") (js-array "IMeta" (js-array "meta") (js-array "eliscript.protocol.IMeta/meta")))
      ((= role "metadata.IWithMeta") (js-array "IWithMeta" (js-array "withMeta") (js-array "eliscript.protocol.IWithMeta/withMeta")))
      ((= role "transient.IEditable") (js-array "IEditable" (js-array "transient") (js-array "eliscript.protocol.IEditable/transient")))
      ((= role "transient.ITransientCollection")
        (js-array "ITransientCollection" (js-array "conj!" "assoc!" "dissoc!" "persistent!")
          (js-array "eliscript.protocol.ITransientCollection/conj!" "eliscript.protocol.ITransientCollection/assoc!"
                    "eliscript.protocol.ITransientCollection/dissoc!" "eliscript.protocol.ITransientCollection/persistent!")))
      ((= role "transient.ITransientSet")
        (js-array "ITransientSet" (js-array "disj!") (js-array "eliscript.protocol.ITransientSet/disj!")))
      (t nil)))

  (defun managed-literal-known-role? (role)
    (or (not (nil? (managed-literal-role-spec role)))
        (= role "order.IComparable")
        (= role "data-text.IPrint")))

  (defun managed-literal-disarm-extension-protocol (protocol)
    (when (not (nil? armed-extension-protocols))
      (let ((pos (js-call armed-extension-protocols :indexOf protocol)))
        (when (>= pos 0)
          (js-call armed-extension-protocols :splice pos 1)
          (when (= (js-length armed-extension-protocols) 0)
            (setq armed-extension-protocols nil))))))

  (defun managed-literal-flush-pending-extensions (protocol)
    (when (not (nil? pending-type-extensions))
      (let ((index 0))
        (while (and (not (nil? pending-type-extensions)) (< index (js-length pending-type-extensions)))
          (if (eq (aref pending-type-extensions index) protocol)
            (let ((constructor (aref pending-type-extensions (1+ index)))
                  (op-name (aref pending-type-extensions (+ index 2)))
                  (fn-or-impl (aref pending-type-extensions (+ index 3))))
              (js-call pending-type-extensions :splice index 4)
              (when (= (js-length pending-type-extensions) 0)
                (setq pending-type-extensions nil))
              (if (nil? op-name)
                (extend-protocol-type protocol constructor fn-or-impl)
                (let ((impl (js-object)))
                  (put impl op-name fn-or-impl)
                  (extend-protocol-type protocol constructor impl))))
            (setq index (+ index 4)))))))

  (defun managed-literal-extension-loader (protocol)
    (let ((role (js-call protocol-roles :get protocol)))
      (when (and (not (undefined? role)) (/= role "transient.ITransientCollection") (/= role "transient.ITransientSet"))
        (managed-literal-flush-role role protocol)))
    (managed-literal-disarm-extension-protocol protocol)
    (managed-literal-flush-pending-extensions protocol)
    (when (= (js-call protocol-roles :get protocol) "collection.IReduce")
      (managed-literal-install-reduce-host-extensions protocol)))

  (defun managed-literal-protocol (role)
    (let ((existing (aref role-protocols role)))
      (if (not (undefined? existing)) existing
        (let ((spec (managed-literal-role-spec role)))
          (when (nil? spec) (managed-literal-protocol-fail "invalid canonical protocol role"))
          (let ((protocol (define-protocol (aref spec 0) (aref spec 1))))
            (js-call protocol-roles :set protocol role)
            (put role-protocols role protocol)
            (js-call (or armed-extension-protocols (setq armed-extension-protocols (js-array))) :push protocol)
            (register-protocol-extension-loader managed-literal-extension-loader protocol)
            protocol)))))

  (defun managed-literal-slot (role operation)
    (protocol-slot (managed-literal-protocol role) operation))

  (defun managed-literal-protocol-materialized? (role)
    (not (undefined? (aref role-protocols role))))

  (defun managed-literal-register-protocol-role (role protocol)
    (unless (and (managed-literal-known-role? role) (protocol? protocol))
      (managed-literal-protocol-fail "invalid canonical protocol role"))
    (when (and (not (nil? (managed-literal-role-spec role)))
               (undefined? (aref role-protocols role)))
      (managed-literal-protocol role))
    (when (and (not (undefined? (aref role-protocols role))) (not (eq (aref role-protocols role) protocol)))
      (managed-literal-protocol-fail "canonical protocol role is already registered"))
    (when (and (js-call protocol-roles :has protocol) (not (= (js-call protocol-roles :get protocol) role)))
      (managed-literal-protocol-fail "protocol already has a canonical role"))
    (js-call protocol-roles :set protocol role)
    (put role-protocols role protocol)
    protocol)

  (defun managed-literal-protocol-role (protocol) (js-call protocol-roles :get protocol))
  (defun managed-literal-protocol-for-role (role)
    (let ((existing (aref role-protocols role)))
      (if (not (undefined? existing)) existing
        (if (not (nil? (managed-literal-role-spec role)))
          (managed-literal-protocol role)
          undefined))))

  (defun managed-literal-register-role-extension (handler)
    (js-call role-extension-handlers :push handler)
    (let ((index 0))
      (while (< index (js-length flushed-roles))
        (let ((role (aref flushed-roles index)))
          (funcall handler role (aref role-protocols role)))
        (setq index (1+ index))))
    undefined)

  (defun managed-literal-bind-flushed-roles (type constructor callbacks)
    (let ((index 0))
      (while (< index (js-length flushed-roles))
        (let ((role (aref flushed-roles index)))
          (managed-literal-bind-type-role role (aref role-protocols role) type constructor callbacks))
        (setq index (1+ index))))
    ;; The two descriptor records are only needed while binding this batch.
    (setq slot-method-descriptor nil slot-length-descriptor nil)
    undefined)

  (defun managed-literal-flush-role (role protocol)
    (unless (js-call flushed-roles :includes role)
      (js-call flushed-roles :push role)
      (when (or (= role "collection.ICounted") (= role "collection.ISeqable") (= role "collection.IReduce"))
        (managed-literal-bind-sequence-view-role role protocol))
      (let ((index 0))
        (while (< index (js-length role-extension-handlers))
          (funcall (aref role-extension-handlers index) role protocol)
          (setq index (1+ index))))))

  (defun managed-literal-activate-role (role)
    (let ((protocol (managed-literal-protocol role)))
      (flush-protocol-extension-loaders protocol)
      protocol))

  (defun managed-literal-equal-values (left right)
    (cond ((eq left right) t)
      ((and (= (js* "typeof left") "number") (= (js* "typeof right") "number"))
        (or (= left right) (and (not (= left left)) (not (= right right)))))
      ((or (nil? left) (nil? right)
           (and (/= (js* "typeof left") "object") (/= (js* "typeof left") "function"))
           (and (/= (js* "typeof right") "object") (/= (js* "typeof right") "function"))) false)
      (t
        (let* ((equiv (managed-literal-protocol "value.IEquiv"))
               (value-equal (protocol-slot equiv "equal"))
               (leftSlot (aref left value-equal))
               (rightSlot (aref right value-equal)))
          (if (and (= (js* "typeof leftSlot") "function")
                   (or (= (js* "typeof rightSlot") "function")
                       (implements-protocol-operation? equiv "equal" right)))
            (eq (js-call leftSlot :call left right managed-literal-equal-values) t)
            (if (and (implements-protocol-operation? equiv "equal" left)
                     (implements-protocol-operation? equiv "equal" right))
              (eq (funcall (protocol-method equiv "equal") left right managed-literal-equal-values) t)
              false))))))

  (defun managed-literal-hash-value (value)
    (recordHashValueCall)
    (if (and (not (nil? value))
             (or (= (js* "typeof value") "object") (= (js* "typeof value") "function")))
      (let* ((hash-protocol (managed-literal-protocol "value.IHash"))
             (value-hash-slot (protocol-slot hash-protocol "hash"))
             (slot (aref value value-hash-slot)))
        (if (= (js* "typeof slot") "function")
          (cachedProtocolHash value (lambda () (js-call slot :call value managed-literal-hash-value)))
          (if (implements-protocol-operation? hash-protocol "hash" value)
            (cachedProtocolHash value (lambda () (funcall (protocol-method hash-protocol "hash") value managed-literal-hash-value)))
            (hashPrimitiveValue value))))
      (hashPrimitiveValue value)))

  (defun managed-literal-is-reduced (value)
    (and (not (nil? reduced-state))
         (not (nullish? value))
         (or (= (js* "typeof value") "object") (= (js* "typeof value") "function"))
         (Object/hasOwn value reduced-state)))
  (defun managed-literal-reduced (value)
    (if (managed-literal-is-reduced value) value
      (let ((result (Object/create nil)))
        (Object/defineProperty result (ensure-reduced-state) (js-object :value value))
        (Object/freeze result))))
  (defun managed-literal-unreduced (value)
    (if (managed-literal-is-reduced value) (aref value reduced-state) value))

  (defun managed-literal-iterator (factory)
    (let ((iterator (funcall factory)))
      (unless (and (not (nil? iterator)) (= (js* "typeof iterator") "object")
                   (managed-literal-callable? (get iterator :next)))
        (managed-literal-protocol-fail "sequence view factory must return an iterator")) iterator))
  (defun managed-literal-checked-count (value)
    (unless (and (Number/isSafeInteger value) (>= value 0))
      (managed-literal-protocol-fail "collection count must be a non-negative safe integer")) value)

  (defvar sequence-view-base-ready false)
  (defun SequenceView (token factory count)
    (unless (and (not (nil? sequence-token)) (eq token sequence-token) (= (js* "typeof factory") "function"))
      (managed-literal-protocol-fail "SequenceView values must be created by seq"))
    (managed-literal-ensure-sequence-view)
    (put (js* "this") (ensure-sequence-state) factory)
    (unless (nil? count)
      (put (js* "this") (ensure-sequence-count) count))
    (Object/freeze (js* "this")))
  (defun managed-literal-sequence-view (factory &optional count)
    (when (undefined? count) (setq count nil))
    (unless (= (js* "typeof factory") "function")
      (managed-literal-protocol-fail "sequence view factory must be a function"))
    (when (and (not (nil? count)) (/= (js* "typeof count") "function"))
      (managed-literal-checked-count count))
    (if (= count 0) nil (new SequenceView (ensure-sequence-token) factory count)))
  (defun managed-literal-truth (value) (js* "!!value"))
  (defun sequence-view-raw-count (receiver)
    (if (nil? sequence-count) nil
      (let ((c (aref receiver sequence-count)))
        (if (undefined? c) nil c))))
  (defun managed-literal-eval-count (factory count)
    (cond ((and (not (nil? unbounded-sequence)) (eq count unbounded-sequence))
            (throw (new globalThis/RangeError "unbounded sequence does not have a finite count")))
      ((= (js* "typeof count") "function") (managed-literal-checked-count (funcall count)))
      ((not (nil? count)) count)
      (t (let ((iterator (managed-literal-iterator factory)) (size 0) (done false))
           (while (not done)
             (setq done (managed-literal-truth (get (js-call iterator :next) :done)))
             (unless done (setq size (managed-literal-checked-count (1+ size))))) size))))
  (defun managed-literal-sequence-count (receiver)
    (managed-literal-eval-count (aref receiver (ensure-sequence-state)) (sequence-view-raw-count receiver)))
  (defun managed-literal-read-sequence-state (receiver) receiver)
  (defun managed-literal-shift-sequence-count (receiver offset prepend)
    (let* ((is-seq (and (not (nil? sequence-state)) (not (undefined? (aref receiver sequence-state)))))
           (count (if is-seq (sequence-view-raw-count receiver) (aref (aref receiver (ensure-memo-state)) 4))))
      (cond ((and (not (nil? unbounded-sequence)) (eq count unbounded-sequence)) unbounded-sequence)
        ((= (js* "typeof count") "function")
          (let ((factory (aref receiver sequence-state)))
            (if prepend (lambda () (managed-literal-checked-count (1+ (managed-literal-eval-count factory count))))
              (lambda ()
                (let ((remaining (- (managed-literal-eval-count factory count) offset)))
                  (if (<= remaining 0) 0 remaining))))))
        ((nil? count) nil)
        (prepend (managed-literal-checked-count (1+ count)))
        (t (let ((remaining (- count offset))) (if (<= remaining 0) 0 remaining))))))
  (defun managed-literal-sequence-from-count (factory count)
    (if (and (not (nil? unbounded-sequence)) (eq count unbounded-sequence))
      (managed-literal-unbounded-sequence-view factory)
      (managed-literal-sequence-view factory count)))
  (defun managed-literal-sequence-iterator (receiver)
    (managed-literal-iterator (aref receiver (ensure-sequence-state))))
  (defun managed-literal-sequence-self (receiver)
    (let ((count (sequence-view-raw-count receiver)))
      (if (and (not (nil? unbounded-sequence)) (eq count unbounded-sequence)) receiver
      (if (nil? count)
        (let* ((iterator (managed-literal-iterator (aref receiver (ensure-sequence-state)))) (next nil))
          (try (setq next (js-call iterator :next)) (if (managed-literal-truth (get next :done)) nil receiver)
            (finally (when (managed-literal-callable? (get iterator :return)) (js-call iterator :return)))))
        (if (= (managed-literal-sequence-count receiver) 0) nil receiver)))))
  (defun managed-literal-sequence-reduce (receiver reducer &rest initial)
    (managed-literal-reduce-iterable receiver reducer initial))
  (defun managed-literal-sequence-tag () "EliscriptSequenceView")
  (defun managed-literal-unbounded-sequence ()
    (ensure-unbounded-sequence))
  (defun managed-literal-unbounded-sequence-view (factory)
    (unless (= (js* "typeof factory") "function") (managed-literal-protocol-fail "unbounded sequence view factory must be a function"))
    (new SequenceView (ensure-sequence-token) factory (ensure-unbounded-sequence)))

  (defun memo-read (state index)
    (let ((no-failure (ensure-no-memo-failure))
          (values (aref state 1)))
      (cond
        ((and (not (nil? values)) (< index (js-length values)))
          (js-object :value (aref values index) :done false))
        ((not (eq (aref state 3) no-failure)) (throw (aref state 3)))
        ((= (aref state 2) 2) (js-object :value undefined :done t))
        (t
          (when (= (aref state 2) 0)
            (let ((factory (aref state 0)))
              (put state 2 1)
              (put state 0 nil)
              (try
                (put state 0 (managed-literal-iterator factory))
                (catch error (put state 3 error) (throw error)))))
          (try
            (let ((result (js-call (aref state 0) :next)))
              (unless (and (managed-literal-object? result) (= (value-type (aref result "done")) "boolean"))
                (managed-literal-protocol-fail "sequence iterator must return an iterator result"))
              (if (managed-literal-truth (aref result "done"))
                (progn (put state 2 2) (put state 0 nil) (js-object :value undefined :done t))
                (let ((val (aref result "value"))
                      (buf (or (aref state 1) (let ((arr (js-array))) (put state 1 arr) arr))))
                  (js-call buf :push val)
                  (js-object :value val :done false))))
            (catch error
              (let ((source (aref state 0)))
                (put state 3 error)
                (put state 0 nil)
                (when (and (not (nil? source)) (managed-literal-callable? (aref source "return")))
                  (try (js-call source :return) (catch close-error nil)))
                (throw error))))))))
  (defun memo-iterator (receiver)
    (let* ((state (aref receiver (ensure-memo-state)))
           (index 0)
           (closed false)
           (return-fn (managed-literal-receiver-method
             (lambda (_self &optional value)
               (setq closed t)
               (js-object :value value :done t))
             "return"))
           (len-desc (ensure-slot-length-descriptor))
           (iterator (js-object
             :next (managed-literal-receiver-method
               (lambda (_self)
                 (if closed
                   (js-object :value undefined :done t)
                   (let ((result (memo-read state index)))
                     (unless (managed-literal-truth (aref result "done"))
                       (setq index (1+ index)))
                     result)))
               "next")
             :return return-fn)))
      (put len-desc :value 1)
      (Reflect/defineProperty return-fn "length" len-desc)
      (setq slot-length-descriptor nil)
      (put iterator (get globalThis/Symbol :iterator)
        (or self-iterable-method
            (setq self-iterable-method (managed-literal-receiver-method (lambda (self) self) "[Symbol.iterator]"))))
      iterator))
  (defvar memoized-prototypes-ready false)
  (defun memo-count (receiver)
    (let ((count (aref (aref receiver (ensure-memo-state)) 4)))
      (if (not (nil? count)) count
        (let ((iterator (memo-iterator receiver)) (result 0) (done false))
          (while (not done)
            (setq done (managed-literal-truth (aref (js-call iterator :next) "done")))
            (unless done (setq result (managed-literal-checked-count (1+ result))))) result))))
  (defun memo-seq (receiver)
    (let ((iterator (memo-iterator receiver)))
      (try (if (managed-literal-truth (aref (js-call iterator :next) "done")) nil receiver)
        (finally (js-call iterator :return)))))
  (defun memo-sequence-tag () "EliscriptMemoizedSequenceView")
  (defun ensure-memoized-prototypes ()
    (unless memoized-prototypes-ready
      (managed-literal-install-slot (aref MemoizedSequenceView "prototype") (get globalThis/Symbol :iterator) memo-iterator 0)
      (managed-literal-install-slot (aref MemoizedSequenceView "prototype") (managed-literal-slot "collection.ICounted" "count") memo-count 0)
      (managed-literal-install-slot (aref MemoizedSequenceView "prototype") (managed-literal-slot "collection.ISeqable" "seq") memo-seq 0)
      (managed-literal-install-slot (aref MemoizedSequenceView "prototype") (managed-literal-slot "collection.IReduce" "reduce") managed-literal-sequence-reduce 1)
      (Object/defineProperty (aref MemoizedSequenceView "prototype") (get globalThis/Symbol :toStringTag)
        (js-object :get memo-sequence-tag :configurable t))
      (setq memoized-prototypes-ready t)))
  (defun MemoizedSequenceView (token factory count)
    (unless (and (not (nil? memo-token)) (eq token memo-token) (managed-literal-callable? factory))
      (managed-literal-protocol-fail "MemoizedSequenceView values must be created by memoizedSequenceView"))
    (ensure-memoized-prototypes)
    (put (js* "this") (ensure-memo-state) (js-array factory nil 0 (ensure-no-memo-failure) count))
