          (put state :isPrim false)
          (put state :primMap nil)))
      ((get state :isFlat nil)
        (let* ((fns (get state :fns))
               (default-fns (get state :defaultFns false))
               (owner (get state :owner))
               (hash-fn (aref fns 0))
               (equal-key (aref fns 1))
               (equal-value (aref fns 2))
               (flags (js-array false false))
               (hamtRoot nil)
               (root (get state :root)))
          (when (not (nil? root))
            (let ((nodeStack (js-array root)) (idxStack (js-array 0)) (sp 0))
              (while (>= sp 0)
                (let* ((node (aref nodeStack sp)) (idx (aref idxStack sp)) (d (aref node 3)))
                  (if (>= idx (js-length d))
                    (setq sp (1- sp))
                    (progn
                      (put idxStack sp (+ idx 2))
                      (let ((k (aref d idx)) (v (aref d (1+ idx))))
                        (if (eq k managed-flat-subnode)
                          (progn (setq sp (1+ sp)) (put nodeStack sp v) (put idxStack sp 0))
                          (progn
                            (put flags 0 false) (put flags 1 false)
                            (setq hamtRoot (managed-transient-map-assoc-item
                              hamtRoot 0 (managed-flat-fast-hash k default-fns hash-fn) k v owner equal-key equal-value flags)))))))))))
          (put state :root hamtRoot)
          (put state :isFlat false)))
      (t state)))

  (defun managed-transient-map-new (map)
    (let ((is-obj (and (not (nullish? map)) (= (js* "typeof map") "object"))))
      (unless (and is-obj
                   (or (persistent-map? map)
                       (= (get map :kind nil) "eliscript/managed-array-map")
                       (managed-flat-map? map)
                       (managed-prim-map? map)))
        (throw (new globalThis/TypeError "transient hash maps must be created from a persistent hash map")))
      (cond
        ((= (get map :kind nil) "eliscript/managed-array-map")
          (js-object :active t :changed false :owner (Object/freeze (js-object)) :source map
            :isArray t :isFlat false :isPrim false :pairs (js-call (get map :pairs) :slice) :primMap nil
            :count (get map :count) :root nil :metadata (get map :metadata nil)
            :fns (get map :fns) :defaultFns (get map :defaultFns false)))
        ((managed-prim-map? map)
          (let ((copy (new globalThis/Map)) (src (get map :map)))
            (when (not (nil? src))
              (js-call src :forEach (lambda (v k) (js-call copy :set k v))))
            (js-object :active t :changed false :owner (Object/freeze (js-object)) :source map
              :isArray false :isFlat false :isPrim t :pairs nil :primMap copy
              :count (get map :count) :root nil :metadata (get map :metadata nil)
              :fns (get map :fns) :defaultFns t)))
        ((managed-flat-map? map)
          (js-object :active t :changed false :owner (Object/freeze (js-object)) :source map
            :isArray false :isFlat t :isPrim false :pairs nil :primMap nil
            :count (get map :count) :root (get map :root) :metadata (get map :metadata nil)
            :fns (get map :fns) :defaultFns (get map :defaultFns false)))
        (t
          (js-object :active t :changed false :owner (Object/freeze (js-object)) :source map
            :isArray false :isFlat false :isPrim false :pairs nil :primMap nil
            :count (get map :count) :root (get map :root) :metadata (get map :metadata nil)
            :fns (get map :fns) :defaultFns (get map :defaultFns false))))))

  (defun managed-transient-map-assoc (state key value)
    (managed-transient-active state "hash map")
    (if (get state :isPrim)
      (managed-transient-prim-assoc state key value)
      (let ((fns (get state :fns)) (default-fns (get state :defaultFns false)))
        (cond
          ((get state :isFlat)
            (managed-transient-flat-assoc state key value))
          ((get state :isArray)
            (let* ((pairs (get state :pairs))
                   (count (get state :count))
                   (idx (managed-transient-array-find-index pairs count key (get fns 1) default-fns)))
              (cond
                ((>= idx 0)
                  (unless (managed-flat-fast-equal (aref pairs (1+ idx)) value default-fns (get fns 2))
                    (put pairs (1+ idx) value)
                    (put state :changed t)))
                ((< count 8)
                  (js-call pairs :push key value)
                  (put state :count (1+ count))
                  (put state :changed t))
                (t
                  (if (managed-transient-map-to-prim state)
                    (managed-transient-prim-assoc state key value)
                    (managed-transient-flat-assoc state key value))))))
          (t
            (let* ((root (get state :root)) (owner (get state :owner))
                   (hash (managed-flat-fast-hash key default-fns (get fns 0)))
                   (flags (get state :assocFlags nil)))
              (when (nil? flags)
                (setq flags (js-array false false))
                (put state :assocFlags flags))
              (put flags 0 false) (put flags 1 false)
              (let ((next (managed-transient-map-assoc-item root 0 hash key value owner (get fns 1) (get fns 2) flags)))
                (when (aref flags 0)
                  (put state :root next)
                  (when (aref flags 1) (put state :count (1+ (get state :count))))
                  (put state :changed t))))))))
    state)

  (defun managed-transient-map-dissoc (state key)
    (managed-transient-active state "hash map")
    (if (get state :isPrim)
      (let ((m (get state :primMap)))
        (when (js-call m :delete key)
          (put state :count (get m :size))
          (put state :changed t)))
      (let ((fns (get state :fns)) (default-fns (get state :defaultFns false)))
        (cond
          ((get state :isFlat)
            (let* ((root (get state :root)) (owner (get state :owner))
                   (hash (managed-flat-fast-hash key default-fns (get fns 0)))
                   (flags (get state :assocFlags nil)))
              (when (nil? flags)
                (setq flags (js-array false false))
                (put state :assocFlags flags))
              (put flags 0 false)
              (let ((next (managed-flat-node-dissoc root 0 hash key owner (get fns 1) flags default-fns)))
                (when (aref flags 0)
                  (put state :count (1- (get state :count)))
                  (put state :root (if (= (get state :count) 0) nil next))
                  (put state :changed t)))))
          ((get state :isArray)
            (let* ((pairs (get state :pairs))
                   (count (get state :count))
                   (idx (managed-transient-array-find-index pairs count key (get fns 1) default-fns)))
              (when (>= idx 0)
                (js-call pairs :splice idx 2)
                (put state :count (1- count))
                (put state :changed t))))
          (t
            (let* ((root (get state :root)) (owner (get state :owner))
                   (hash (managed-flat-fast-hash key default-fns (get fns 0)))
                   (result (managed-transient-map-dissoc-item root 0 hash key owner (get fns 1))))
              (when (get result :removed)
                (put state :count (1- (get state :count)))
                (put state :root (if (= (get state :count) 0) nil (get result :item)))
                (put state :changed t)))))))
    state)

  (defun managed-transient-map-persistent (state)
    (managed-transient-active state "hash map")
    (let* ((metadata (get state :metadata nil))
           (default-fns (get state :defaultFns false))
           (result
             (if (get state :changed)
               (cond
                 ((get state :isPrim)
                   (managed-prim-make-map (get state :count) (get state :primMap) (get state :fns) metadata))
                 ((get state :isFlat)
                   (managed-flat-make-map (get state :count) (get state :root) (get state :fns) metadata default-fns))
                 ((get state :isArray)
                   (let ((pairs (Object/freeze (js-call (get state :pairs) :slice))))
                     (if default-fns
                       (if (nil? metadata)
                         (js-object :kind "eliscript/managed-array-map" :count (get state :count) :pairs pairs
                           :fns (get state :fns) :defaultFns t)
                         (js-object :kind "eliscript/managed-array-map" :count (get state :count) :pairs pairs
                           :fns (get state :fns) :metadata metadata :defaultFns t))
                       (if (nil? metadata)
                         (js-object :kind "eliscript/managed-array-map" :count (get state :count) :pairs pairs
                           :fns (get state :fns))
                         (js-object :kind "eliscript/managed-array-map" :count (get state :count) :pairs pairs
                           :fns (get state :fns) :metadata metadata)))))
                 (t
                   (if (nil? metadata)
                     (js-object :kind "eliscript/persistent-map" :count (get state :count) :root (get state :root)
                       :fns (get state :fns))
                     (js-object :kind "eliscript/persistent-map" :count (get state :count) :root (get state :root)
                       :fns (get state :fns) :metadata metadata))))
               (get state :source))))
      (put state :active false) (put state :owner nil) (put state :primMap nil) result))

  (defun managed-transient-set-new (set)
    (unless (persistent-set? set)
      (throw (new globalThis/TypeError "transient hash sets must be created from a persistent hash set")))
    (let ((map (get set :map)))
      (js-object :active t :source set :map (managed-transient-map-new map)
        :metadata (get set :metadata nil))))
  (defun managed-transient-set-conj (state value)
    (managed-transient-active state "hash set")
    (managed-transient-map-assoc (get state :map) value t) state)
  (defun managed-transient-set-disj (state value)
    (managed-transient-active state "hash set")
    (managed-transient-map-dissoc (get state :map) value) state)
  (defun managed-transient-set-persistent (state)
    (managed-transient-active state "hash set")
    (let* ((map (managed-transient-map-persistent (get state :map)))
           (source (get state :source))
           (metadata (get state :metadata nil))
           (result
             (if (eq map (get source :map)) source
               (if (nil? metadata)
                 (js-object :kind "eliscript/persistent-set" :map map)
                 (js-object :kind "eliscript/persistent-set" :map map :metadata metadata)))))
      (put state :active false) result))

  (export managed-transient-enable-revision-tracking
    managed-prim-map? managed-prim-map-get managed-prim-map-has?
    managed-prim-map-assoc managed-prim-map-dissoc managed-prim-map-with-meta
    managed-prim-map-reduce managed-prim-map-export-flat managed-prim-map-to-hamt
    managed-flat-subnode managed-flat-map? managed-flat-map-get managed-flat-map-has?
    managed-flat-map-assoc managed-flat-map-dissoc managed-flat-map-with-meta
    managed-flat-map-reduce managed-flat-map-export-flat managed-flat-map-to-hamt managed-transient-flat-to-hamt
    managed-transient-vector-new managed-transient-vector-conj managed-transient-vector-assoc
    managed-transient-vector-persistent managed-transient-map-new managed-transient-map-get managed-transient-map-assoc
    managed-transient-map-dissoc managed-transient-map-persistent managed-transient-set-new
    managed-transient-set-conj managed-transient-set-disj managed-transient-set-persistent))
