(module eliscript.managed-runtime-metadata-internals
  (import "../managed/managed-literal-protocols.eli" managed-literal-protocol managed-literal-activate-role)
  (import "./protocol.eli" protocolMethod)
  (import "../../stdlib/protocol.eli" protocol-slot)
  (defconst I_META (managed-literal-protocol "metadata.IMeta"))
  (defconst I_WITH_META (managed-literal-protocol "metadata.IWithMeta"))
  (defconst METADATA_READ (protocol-slot I_META "meta"))
  (defconst METADATA_WITH (protocol-slot I_WITH_META "withMeta"))
  (managed-literal-activate-role "metadata.IMeta")
  (managed-literal-activate-role "metadata.IWithMeta")
  (defconst dispatchMetadataRead (protocolMethod I_META "meta"))
  (defconst dispatchMetadataWith (protocolMethod I_WITH_META "withMeta"))
  (export I_META I_WITH_META METADATA_READ METADATA_WITH dispatchMetadataRead dispatchMetadataWith))
