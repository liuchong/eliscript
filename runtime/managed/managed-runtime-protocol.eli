(module eliscript.managed-runtime-protocol
  (import "./protocol-error.eli" ProtocolDispatchError)
  (import "../../stdlib/protocol.eli"
    define-protocol define-protocol-from-definition extend-protocol-category extend-protocol-default
    extend-protocol-type implements-protocol-operation? implements-protocol? protocol-definition
    protocol-host-category protocol-method protocol-slot protocol? materialize-protocol-from-definition
    read-protocol-operations-owner read-protocol-method-owner flush-protocol-extension-loaders)

  (defun defineProtocol (name operations) (define-protocol name operations))
  (defun defineProtocolFromDefinition (definition) (define-protocol-from-definition definition))
  (defun extendProtocolCategory (protocol category implementations) (extend-protocol-category protocol category implementations))
  (defun extendProtocolDefault (protocol implementations) (extend-protocol-default protocol implementations))
  (defun extendProtocolType (protocol constructor implementations) (extend-protocol-type protocol constructor implementations))
  (defun implementsProtocolOperation (protocol operation value) (implements-protocol-operation? protocol operation value))
  (defun implementsProtocol (protocol value) (implements-protocol? protocol value))
  (defun protocolDefinition (protocol) (protocol-definition protocol))
  (defun protocolHostCategory (value) (protocol-host-category value))
  (defun protocolMethod (protocol operation) (protocol-method protocol operation))
  (defun protocolSlot (protocol operation)
    (let ((slot (protocol-slot protocol operation)))
      (flush-protocol-extension-loaders protocol)
      slot))
  (defun isProtocol (value) (protocol? value))
  (defun materializeProtocolFromDefinition (definition slots) (materialize-protocol-from-definition definition slots))
  (defun readProtocolOperationsOwner (value) (read-protocol-operations-owner value))
  (defun readProtocolMethodOwner (value) (read-protocol-method-owner value))

  (export ProtocolDispatchError defineProtocol defineProtocolFromDefinition extendProtocolCategory
    extendProtocolDefault extendProtocolType implementsProtocolOperation implementsProtocol
    protocolDefinition protocolHostCategory protocolMethod protocolSlot isProtocol materializeProtocolFromDefinition
    readProtocolOperationsOwner readProtocolMethodOwner))
