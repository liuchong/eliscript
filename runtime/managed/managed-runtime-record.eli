(module eliscript.managed-runtime-record
  (import "../managed/managed-literals.eli"
    literal-instance? literal-register-transport-handler literal-with-meta
    literal-mix literal-finish literal-string-hash literal-entry
    literal-private-symbol literal-private-weak-map)
  (import "../../stdlib/protocol.eli" extend-protocol-type)
  (import "../managed/managed-literal-protocols.eli"
    managed-literal-slot managed-literal-protocol-materialized?
    managed-literal-register-role-extension managed-literal-sequence-view managed-literal-reduce-iterable)
  (import "./identifier.eli" isKeyword identifierNamespace identifierName keyword)
  (import "./map.eli" EMPTY_MAP PersistentHashMap isPersistentHashMap)

  (defvar record-token nil)
  (defvar record-state nil)
  (defvar record-types nil)
  (defvar record-role-entries nil)
  (defvar record-method-descriptor nil)
  (defvar record-length-descriptor nil)
  (defvar record-getter-descriptor nil)
  (defvar record-shared-methods nil)
  (defun ensure-record-token ()
    (or record-token (setq record-token (literal-private-symbol "eliscript.record.constructor-token"))))
  (defun ensure-record-state ()
    (or record-state (setq record-state (literal-private-symbol "eliscript.record.state"))))
  (defun ensure-record-types ()
    (or record-types (setq record-types (literal-private-weak-map))))
  (defun ensure-record-method-descriptor ()
    (or record-method-descriptor
      (setq record-method-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :value undefined)
          (put descriptor :writable t)
          (put descriptor :configurable t)
          descriptor))))
  (defun ensure-record-length-descriptor ()
    (or record-length-descriptor
      (setq record-length-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :value 0)
          (put descriptor :configurable t)
          descriptor))))
  (defun ensure-record-getter-descriptor ()
    (or record-getter-descriptor
      (setq record-getter-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :get undefined)
          (put descriptor :configurable t)
          (put descriptor :enumerable false)
          descriptor))))
  (defun fail (message) (throw (new globalThis/TypeError message)))
  (defun method (implementation name arity)
    (let ((result (funcall
      (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, undefined, [this, ...args]); } })[name]; }")
      implementation name)))
      (unless (= arity 0)
        (let ((len-desc (ensure-record-length-descriptor)))
          (put len-desc :value arity)
          (Reflect/defineProperty result "length" len-desc)))
      result))
  (defun install-cached-method (target key method-fn)
    (let ((desc (ensure-record-method-descriptor)))
      (put desc :value method-fn)
      (Reflect/defineProperty target key desc)
      (put desc :value undefined)))
  (defun install-cached-getter (target key getter-fn)
    (let ((desc (ensure-record-getter-descriptor)))
      (put desc :get getter-fn)
      (put desc :configurable t)
      (put desc :enumerable false)
      (Reflect/defineProperty target key desc)
      (put desc :get undefined)))
  (defun install-method (target key name arity implementation)
    (install-cached-method target key (method implementation name arity)))
  (defun install-getter (target key name implementation &optional enumerable)
    (let ((desc (ensure-record-getter-descriptor))
          (enum-flag (not (not enumerable))))
      (put desc :get (method implementation name 0))
      (put desc :configurable (not enum-flag))
      (put desc :enumerable enum-flag)
      (Reflect/defineProperty target key desc)
      (put desc :get undefined)))
  (defun map-with-metadata (map metadata)
    (if (nil? metadata) map (literal-with-meta map metadata)))
  (defun record-count-getter (self) (get (get (aref self (ensure-record-state)) :map) :count))
  (defun record-size-getter (self) (get self :count))
  (defun record-get-method (self key &optional notFound)
    (js-call (get (aref self (ensure-record-state)) :map) :get key notFound))
  (defun record-has-method (self key)
    (js-call (get (aref self (ensure-record-state)) :map) :has key))
  (defun record-entries-method (self) (js-call (get (aref self (ensure-record-state)) :map) :entries))
  (defun record-keys-method (self) (js-call (get (aref self (ensure-record-state)) :map) :keys))
  (defun record-values-method (self) (js-call (get (aref self (ensure-record-state)) :map) :values))
  (defun record-to-persistent-map (self)
    (let ((state (aref self (ensure-record-state)))) (map-with-metadata (get state :map) (get state :metadata))))
  (defun record-empty-impl (self)
    (map-with-metadata EMPTY_MAP (get (aref self (ensure-record-state)) :metadata)))
  (defun record-conj-impl (self entry)
    (let ((pair (literal-entry entry))) (js-call self :assoc (get pair 0) (get pair 1))))
  (defun record-lookup-get-impl (self key &optional notFound) (js-call self :get key notFound))
  (defun record-contains-impl (self key) (js-call self :has key))
  (defun record-assoc-impl (self key value) (js-call self :assoc key value))
  (defun record-dissoc-impl (self key) (js-call self :dissoc key))
  (defun record-seq-impl (self)
    (if (= (get self :count) 0) nil
      (managed-literal-sequence-view (lambda () (js-call self :entries)) (get self :count))))
  (defun record-reduce-impl (self reducer &rest initial)
    (managed-literal-reduce-iterable self reducer initial))
  (defun record-reduce-kv-impl (self reducer initial)
    (managed-literal-reduce-iterable (js-call self :entries)
      (lambda (result entry) (funcall reducer result (get entry 0) (get entry 1))) (js-array initial)))
  (defun record-meta-impl (self) (get (aref self (ensure-record-state)) :metadata))
  (defun record-assoc-method (self key value)
    (let* ((state (aref self (ensure-record-state)))
           (entry (js-call (ensure-record-types) :get state))
           (previous (get state :map))
           (map (js-call previous :assoc key value)))
      (if (eq map previous) self (new (aref entry 0) (ensure-record-token) map (get state :metadata)))))
  (defun record-dissoc-method (self key)
    (let* ((state (aref self (ensure-record-state)))
           (entry (js-call (ensure-record-types) :get state))
           (previous (get state :map)))
      (if (>= (declared-field-index entry key) 0)
          (map-with-metadata (js-call previous :dissoc key) (get state :metadata))
        (let ((map (js-call previous :dissoc key)))
          (if (eq map previous) self (new (aref entry 0) (ensure-record-token) map (get state :metadata)))))))
  (defun record-equal-impl (self other equal)
    (let* ((state-sym (ensure-record-state))
           (state (aref self state-sym))
           (entry (js-call (ensure-record-types) :get state)))
      (and (not (undefined? entry))
        (literal-instance? other (aref entry 0))
        (funcall equal (get state :map) (get (aref other state-sym) :map)))))
  (defun record-hash-impl (self hash)
    (let* ((state (aref self (ensure-record-state)))
           (entry (js-call (ensure-record-types) :get state)))
      (literal-finish (literal-mix (literal-mix 1300474159
        (literal-string-hash (aref entry 5) 1831565813))
        (funcall hash (get state :map))) (get self :count))))
  (defun record-with-meta-impl (self metadata)
    (let* ((state (aref self (ensure-record-state)))
           (entry (js-call (ensure-record-types) :get state)))
      (if (eq metadata (get state :metadata)) self
        (new (aref entry 0) (ensure-record-token) (get state :map) metadata))))
  (defun ensure-record-shared-methods ()
    (or record-shared-methods
      (setq record-shared-methods
        (js-array
          (method record-count-getter "get count" 0)
          (method record-size-getter "get size" 0)
          (method record-get-method "get" 1)
          (method record-has-method "has" 1)
          (method record-assoc-method "assoc" 2)
          (method record-dissoc-method "dissoc" 1)
          (method record-entries-method "entries" 0)
          (method record-keys-method "keys" 0)
          (method record-values-method "values" 0)
          (method record-to-persistent-map "toPersistentMap" 0)
          (method record-entries-method "[Symbol.iterator]" 0)
          nil nil nil nil nil nil nil nil nil nil nil nil nil nil))))
  (defun record-role-bit (role)
    (cond
      ((= role "collection.ICounted") 1)
      ((= role "collection.IEmptyable") 2)
      ((= role "collection.IConj") 4)
      ((= role "collection.ILookup") 8)
      ((= role "collection.IAssociative") 16)
      ((= role "collection.IMap") 32)
      ((= role "collection.ISeqable") 64)
      ((= role "collection.IReduce") 128)
      ((= role "collection.IKVReduce") 256)
      ((= role "value.IEquiv") 512)
      ((= role "value.IHash") 1024)
      ((= role "metadata.IMeta") 2048)
      ((= role "metadata.IWithMeta") 4096)
      (t 0)))
  (defun extend-record-entry-role (entry role protocol)
    (let ((bit (record-role-bit role))
          (mask (aref entry 6))
          (RecordValue (aref entry 0)))
      (when (and (/= bit 0) (= (bit-and mask bit) 0))
        (put entry 6 (bit-or mask bit))
        (cond
          ((= role "collection.ICounted") (extend-protocol-type protocol RecordValue (js-object :count record-size-getter)))
          ((= role "collection.IEmptyable") (extend-protocol-type protocol RecordValue (js-object :empty record-empty-impl)))
          ((= role "collection.IConj") (extend-protocol-type protocol RecordValue (js-object :conj record-conj-impl)))
          ((= role "collection.ILookup") (extend-protocol-type protocol RecordValue (js-object :get record-lookup-get-impl)))
          ((= role "collection.IAssociative")
            (extend-protocol-type protocol RecordValue (js-object :assoc record-assoc-impl :contains record-contains-impl)))
          ((= role "collection.IMap") (extend-protocol-type protocol RecordValue (js-object :dissoc record-dissoc-impl)))
          ((= role "collection.ISeqable") (extend-protocol-type protocol RecordValue (js-object :seq record-seq-impl)))
          ((= role "collection.IReduce") (extend-protocol-type protocol RecordValue (js-object :reduce record-reduce-impl)))
          ((= role "collection.IKVReduce") (extend-protocol-type protocol RecordValue (js-object :reduceKV record-reduce-kv-impl)))
          ((= role "value.IEquiv") (extend-protocol-type protocol RecordValue (js-object :equal record-equal-impl)))
          ((= role "value.IHash") (extend-protocol-type protocol RecordValue (js-object :hash record-hash-impl)))
          ((= role "metadata.IMeta") (extend-protocol-type protocol RecordValue (js-object :meta record-meta-impl)))
          ((= role "metadata.IWithMeta") (extend-protocol-type protocol RecordValue (js-object :withMeta record-with-meta-impl)))))))
  (defun register-record-role-entry (entry)
    (when (nil? record-role-entries)
      (setq record-role-entries (js-array))
      (managed-literal-register-role-extension
        (lambda (role protocol)
          (let ((index 0))
            (while (< index (js-length record-role-entries))
              (extend-record-entry-role (aref record-role-entries index) role protocol)
              (setq index (1+ index)))))))
    (js-call record-role-entries :push entry))

  (defun normalize-name (name)
    (when (or (not (= (js* "typeof name") "string")) (= (js-length name) 0))
      (fail "record type name must be a non-empty string")) name)
  (defun normalize-fields (fields)
    (unless (and (Array/isArray fields) (<= (js-length fields) 1024))
      (fail "record fields must be a dense array of at most 1024 names"))
    (let ((descriptors (Object/getOwnPropertyDescriptors fields))
          (seen (Object/create nil)) (result (js-array)) (index 0))
      (unless (= (js-length (Reflect/ownKeys descriptors)) (1+ (js-length fields)))
        (fail "record fields must be a dense array with no extra properties"))
      (while (< index (js-length fields))
        (let* ((descriptor (get descriptors (str index)))
               (field (if (nullish? descriptor) undefined (get descriptor :value))))
          (when (or (nullish? descriptor) (not (get descriptor :enumerable))
                    (not (= (js* "typeof field") "string")) (= (js-length field) 0)
                    (js-call field :includes "/"))
            (fail "record field names must be non-empty unqualified strings"))
          (when (Object/hasOwn seen field) (fail (str "record declares duplicate field " field)))
          (put seen field t) (js-call result :push field))
        (setq index (1+ index)))
      (Object/freeze result)))
  (defun declared-field-index (typeState key)
    (if (and (isKeyword key) (nil? (identifierNamespace key)))
        (let ((index (aref (aref typeState 4) (identifierName key))))
          (if (undefined? index) -1 index)) -1))
  (defun normalize-map (typeState source)
    (let ((map (try (js-call PersistentHashMap :from source)
                 (catch error
                   (throw (new globalThis/TypeError
                     (str "map->" (aref typeState 1) " expects an iterable collection of entries")
                     (js-object :cause error))))))
          (index 0) (keys (aref typeState 3)))
      (while (< index (js-length keys))
        (let ((key (get keys index)))
          (unless (js-call map :has key) (setq map (js-call map :assoc key nil))))
        (setq index (1+ index))) map))

  (defun make-record-type (name fields reuseFields)
    (let* ((typeName (normalize-name name)) (normalizedFields (normalize-fields fields))
           (fieldNames (if reuseFields fields normalizedFields))
           (fieldKeys (js-array)) (indexes (Object/create nil)) (index 0)
           (installed-mask 0)
           (types-map (ensure-record-types)))
      (when (and reuseFields (not (Object/isFrozen fields)))
        (fail "materialized record fields must be a frozen array"))
      (while (< index (js-length fieldNames))
        (let ((field (get fieldNames index)))
          (js-call fieldKeys :push (keyword field)) (put indexes field index))
        (setq index (1+ index)))
      (Object/freeze fieldKeys)
      (let* ((token-sym (ensure-record-token))
             (state-sym (ensure-record-state))
             (shared (ensure-record-shared-methods))
             (typeState (js-array nil typeName fieldNames fieldKeys indexes
                          (str typeName "[" (js-call fieldNames :join ",") "]") 0))
             (RecordValue (funcall
               (js* "(implementation, name) => { if (typeof name !== \"string\") throw new TypeError(\"class name must be a string\"); return ({ [name]: class { constructor(...args) { return implementation(this, ...args); } } })[name]; }")
               (lambda (self token map &optional metadata)
                 (unless (and (eq token token-sym) (isPersistentHashMap map))
                   (fail (str typeName " values must be created with its record constructors")))
                 (let ((state (Object/freeze (js-object :map map :metadata metadata))))
                   (js-call types-map :set state typeState)
                   (Object/defineProperty self state-sym (js-object :value state
                     :writable t :enumerable t :configurable t)))
                 (Object/freeze self)) typeName)))
        (put typeState 0 RecordValue)
        (Object/defineProperty RecordValue "length" (js-object :value 2 :configurable t))
        (install-method RecordValue "create" "create" 0 (lambda (self &rest values)
          (unless (= (js-length values) (js-length fieldNames))
            (fail (str "->" typeName " expects " (js-length fieldNames) " values, received " (js-length values))))
          (let ((map EMPTY_MAP) (at 0))
            (while (< at (js-length values))
              (setq map (js-call map :assoc (get fieldKeys at) (get values at)) at (1+ at)))
            (new RecordValue token-sym map))))
        (install-method RecordValue "fromMap" "fromMap" 1 (lambda (self source)
          (new RecordValue token-sym (normalize-map typeState source))))
        (install-method RecordValue "isInstance" "isInstance" 1 (lambda (self value)
          (literal-instance? value RecordValue)))
        (let ((prototype (get RecordValue :prototype)))
          (install-cached-getter prototype "count" (aref shared 0))
          (install-cached-getter prototype "size" (aref shared 1))
          (install-cached-method prototype "get" (aref shared 2))
          (install-cached-method prototype "has" (aref shared 3))
          (install-cached-method prototype "assoc" (aref shared 4))
          (install-cached-method prototype "dissoc" (aref shared 5))
          (install-cached-method prototype "entries" (aref shared 6))
          (install-cached-method prototype "keys" (aref shared 7))
          (install-cached-method prototype "values" (aref shared 8))
          (install-cached-method prototype "toPersistentMap" (aref shared 9))
          (when (managed-literal-protocol-materialized? "collection.ICounted")
            (setq installed-mask (bit-or installed-mask 1))
            (install-cached-method prototype (managed-literal-slot "collection.ICounted" "count")
              (or (aref shared 11) (put shared 11 (method record-size-getter "[ICounted.count]" 0)))))
          (when (managed-literal-protocol-materialized? "collection.IEmptyable")
            (setq installed-mask (bit-or installed-mask 2))
            (install-cached-method prototype (managed-literal-slot "collection.IEmptyable" "empty")
              (or (aref shared 12) (put shared 12 (method record-empty-impl "[IEmptyable.empty]" 0)))))
          (when (managed-literal-protocol-materialized? "collection.IConj")
            (setq installed-mask (bit-or installed-mask 4))
            (install-cached-method prototype (managed-literal-slot "collection.IConj" "conj")
              (or (aref shared 13) (put shared 13 (method record-conj-impl "[IConj.conj]" 1)))))
          (when (managed-literal-protocol-materialized? "collection.ILookup")
            (setq installed-mask (bit-or installed-mask 8))
            (install-cached-method prototype (managed-literal-slot "collection.ILookup" "get")
              (or (aref shared 14) (put shared 14 (method record-lookup-get-impl "[ILookup.get]" 1)))))
          (when (managed-literal-protocol-materialized? "collection.IAssociative")
            (setq installed-mask (bit-or installed-mask 16))
            (install-cached-method prototype (managed-literal-slot "collection.IAssociative" "assoc")
              (or (aref shared 15) (put shared 15 (method record-assoc-impl "[IAssociative.assoc]" 2))))
            (install-cached-method prototype (managed-literal-slot "collection.IAssociative" "contains")
              (or (aref shared 16) (put shared 16 (method record-contains-impl "[IAssociative.contains]" 1)))))
          (when (managed-literal-protocol-materialized? "collection.IMap")
            (setq installed-mask (bit-or installed-mask 32))
            (install-cached-method prototype (managed-literal-slot "collection.IMap" "dissoc")
              (or (aref shared 17) (put shared 17 (method record-dissoc-impl "[IMap.dissoc]" 1)))))
          (when (managed-literal-protocol-materialized? "collection.ISeqable")
            (setq installed-mask (bit-or installed-mask 64))
            (install-cached-method prototype (managed-literal-slot "collection.ISeqable" "seq")
              (or (aref shared 18) (put shared 18 (method record-seq-impl "[ISeqable.seq]" 0)))))
          (when (managed-literal-protocol-materialized? "collection.IReduce")
            (setq installed-mask (bit-or installed-mask 128))
            (install-cached-method prototype (managed-literal-slot "collection.IReduce" "reduce")
              (or (aref shared 19) (put shared 19 (method record-reduce-impl "[IReduce.reduce]" 1)))))
          (when (managed-literal-protocol-materialized? "collection.IKVReduce")
            (setq installed-mask (bit-or installed-mask 256))
            (install-cached-method prototype (managed-literal-slot "collection.IKVReduce" "reduceKV")
              (or (aref shared 20) (put shared 20 (method record-reduce-kv-impl "[IKVReduce.reduceKV]" 2)))))
          (when (managed-literal-protocol-materialized? "value.IEquiv")
            (setq installed-mask (bit-or installed-mask 512))
            (install-cached-method prototype (managed-literal-slot "value.IEquiv" "equal")
              (or (aref shared 21) (put shared 21 (method record-equal-impl "[IEquiv.equal]" 2)))))
          (when (managed-literal-protocol-materialized? "value.IHash")
            (setq installed-mask (bit-or installed-mask 1024))
            (install-cached-method prototype (managed-literal-slot "value.IHash" "hash")
              (or (aref shared 22) (put shared 22 (method record-hash-impl "[IHash.hash]" 1)))))
          (when (managed-literal-protocol-materialized? "metadata.IMeta")
            (setq installed-mask (bit-or installed-mask 2048))
            (install-cached-method prototype (managed-literal-slot "metadata.IMeta" "meta")
              (or (aref shared 23) (put shared 23 (method record-meta-impl "[IMeta.meta]" 0)))))
          (when (managed-literal-protocol-materialized? "metadata.IWithMeta")
            (setq installed-mask (bit-or installed-mask 4096))
            (install-cached-method prototype (managed-literal-slot "metadata.IWithMeta" "withMeta")
              (or (aref shared 24) (put shared 24 (method record-with-meta-impl "[IWithMeta.withMeta]" 1)))))
          (put typeState 6 installed-mask)
          (install-cached-method prototype (get globalThis/Symbol :iterator) (aref shared 10))
          (install-getter prototype (get globalThis/Symbol :toStringTag) "get [Symbol.toStringTag]"
            (lambda (self) (str "EliscriptRecord:" typeName)))
          (Object/defineProperties RecordValue (js-object
            :recordName (js-object :enumerable t :value typeName)
            :recordFields (js-object :enumerable t :value fieldNames)))
          (setq index 0)
          (while (< index (js-length fieldNames))
            (let ((fieldName (get fieldNames index)) (fieldKey (get fieldKeys index)))
              (when (Reflect/has prototype fieldName) (fail (str "record field " fieldName " conflicts with a record member")))
              (install-getter prototype fieldName "get" (lambda (self)
                (js-call (get (aref self state-sym) :map) :get fieldKey)) t))
            (setq index (1+ index)))
          (Object/freeze prototype))
        (register-record-role-entry typeState)
        (Object/freeze RecordValue) (js-call types-map :set RecordValue typeState)
        ;; Descriptor records are only needed while installing this record type.
        (setq record-method-descriptor nil record-length-descriptor nil record-getter-descriptor nil)
        RecordValue)))

  (defun defineRecordType (name fields) (make-record-type name fields false))
  (defun materializeRecordType (name fields) (make-record-type name fields t))
  (defun isRecordType (value)
    (and (not (nil? record-types)) (= (js* "typeof value") "function") (js-call record-types :has value)))
  (defun isRecord (value)
    (and (not (nil? record-types)) (not (nil? value)) (= (js* "typeof value") "object") (isRecordType (get value :constructor))))
  (defun recordType (value)
    (unless (isRecord value) (fail "expected an Eliscript record")) (get value :constructor))
  (defun recordTypeName (value) (get (if (isRecordType value) value (recordType value)) :recordName))
  (defun recordFieldNames (value) (get (if (isRecordType value) value (recordType value)) :recordFields))
  (defun readRecordState (value)
    (if (or (nil? record-state) (nil? value) (not (= (js* "typeof value") "object"))) undefined
      (let ((descriptor (Object/getOwnPropertyDescriptor value record-state)))
        (if (and (not (undefined? descriptor)) (Object/hasOwn descriptor "value")) (get descriptor :value) undefined))))
    (literal-register-transport-handler
    (lambda (mode a b)
      (cond ((= mode 0)
          (cond ((isRecordType a) "record-type")
            ((and (isRecord a) (not (undefined? (readRecordState a))) (Object/isFrozen a)) "record")
            (t nil)))
        ((= mode 1)
          (cond ((= a "record-type")
              (js-object :kind "record-type" :name (get b :recordName) :fields (get b :recordFields)))
            ((= a "record")
              (let ((state (readRecordState b)))
                (js-object :kind "record" :type (recordType b) :map (get state :map)
                  :metadata (get state :metadata))))
            (t undefined)))
        (t (cond ((= a "record-type") (materializeRecordType (get b :name) (get b :fields)))
            ((= a "record")
              (new (get b :type) (ensure-record-token) (get b :map) (get b :metadata nil)))
            (t undefined))))))

  (export defineRecordType materializeRecordType isRecordType isRecord recordType recordTypeName recordFieldNames readRecordState))
