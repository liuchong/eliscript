(module eliscript.managed-runtime-transient
  (import "../managed/managed-literal-protocols.eli"
    managed-literal-protocol managed-literal-transient managed-literal-conj-bang
    managed-literal-assoc-bang managed-literal-dissoc-bang managed-literal-disj-bang managed-literal-persistent-bang)

  (defconst IEditable (managed-literal-protocol "transient.IEditable"))
  (defconst ITransientCollection (managed-literal-protocol "transient.ITransientCollection"))
  (defconst ITransientSet (managed-literal-protocol "transient.ITransientSet"))
  (defun transient (collection) (managed-literal-transient collection))
  (defun conjBang (collection &rest values)
    (apply managed-literal-conj-bang (js-call (js-array collection) :concat values)))
  (defconst assocBang managed-literal-assoc-bang)
  (defun dissocBang (collection &rest keys)
    (apply managed-literal-dissoc-bang (js-call (js-array collection) :concat keys)))
  (defun disjBang (collection &rest values)
    (apply managed-literal-disj-bang (js-call (js-array collection) :concat values)))
  (defun persistentBang (collection) (managed-literal-persistent-bang collection))

  (export IEditable ITransientCollection ITransientSet transient conjBang assocBang dissocBang disjBang persistentBang))
