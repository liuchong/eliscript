(module eliscript.managed-literals
  (import-portable "../../stdlib/bit.eli" rotate-left)
  (import-portable "../../stdlib/persistent-list.eli"
    empty-persistent-list persistent-list-count persistent-list-empty? persistent-list-cons
    persistent-list-first persistent-list-rest persistent-list-pop persistent-list-nth
    persistent-list-meta persistent-list-with-meta persistent-list-to-array persistent-list-from-array)
  (import-portable "../../stdlib/persistent-vector.eli"
    empty-persistent-vector persistent-vector-count persistent-vector-nth persistent-vector-assoc
    persistent-vector-conj persistent-vector-pop persistent-vector-meta persistent-vector-with-meta
    persistent-vector-reduce persistent-vector-to-array persistent-vector-from-array)
  (import-portable "../../stdlib/persistent-map.eli"
    empty-persistent-map persistent-map-count persistent-map-has? persistent-map-get
    persistent-map-assoc persistent-map-dissoc persistent-map-reduce persistent-map-to-entries
    persistent-map-meta persistent-map-with-meta persistent-map-from-entries)
  (import-portable "../../stdlib/persistent-set.eli"
    empty-persistent-set persistent-set-count persistent-set-has? persistent-set-conj
    persistent-set-disj persistent-set-reduce persistent-set-meta persistent-set-with-meta
    persistent-set-to-array persistent-set-from-array)
  (import-portable "../../stdlib/value.eli" value-hash)
  (import "./managed-literal-protocols.eli" managed-literal-register-protocols managed-literal-hash-value
    managed-literal-equal-values managed-literal-is-reduced managed-literal-unreduced managed-literal-reduced
    managed-literal-install-slot managed-literal-protocol-role managed-literal-protocol-for-role
    managed-literal-protocol managed-literal-register-role-extension managed-literal-bind-flushed-roles
    managed-literal-bind-type-role managed-literal-bind-transient-type managed-literal-brand-true
    PERSISTENT_MAP_KIND PERSISTENT_MAP_HAS_VALUE_KEY PERSISTENT_SET_KIND PERSISTENT_SET_HAS_VALUE)
  (import "./managed-value-state.eli" hashPrimitiveValue recordHashValueCall cachedProtocolHash)
  (import "../../stdlib/protocol.eli" protocol? protocol-definition materialize-protocol-from-definition
    read-protocol-operations-owner read-protocol-method-owner protocol-method)
  (import "./managed-transient-state.eli"
    managed-transient-vector-new managed-transient-vector-conj managed-transient-vector-assoc managed-transient-vector-persistent
    managed-transient-map-new managed-transient-map-assoc managed-transient-map-dissoc managed-transient-map-persistent
    managed-transient-set-new managed-transient-set-conj managed-transient-set-disj managed-transient-set-persistent)
  (import-portable "./managed-vector-view-state.eli"
    managed-vector-view-state? managed-vector-view-state-make managed-vector-view-state-vector
    managed-vector-view-state-start managed-vector-view-state-end managed-vector-view-state-count
    managed-vector-view-state-meta managed-vector-view-state-subvec managed-vector-view-state-with-meta
    managed-vector-view-state-nth managed-vector-view-state-assoc managed-vector-view-state-conj
    managed-vector-view-state-peek managed-vector-view-state-empty managed-vector-view-state-pop
    managed-vector-view-state-to-array)
  (import-portable "./managed-queue-state.eli"
    managed-queue-state-empty managed-queue-state-front managed-queue-state-rear
    managed-queue-state-count managed-queue-state-meta
    managed-queue-state-with-meta managed-queue-state-conj managed-queue-state-peek
    managed-queue-state-pop managed-queue-state-to-array managed-queue-state-from-array)

  ;; The portable tries remain private. Public values are frozen class-shaped
  ;; objects with Symbol state, rather than the portable records' public kind.
  (defconst literal-intrinsic-symbol globalThis/Symbol)
  (defconst literal-intrinsic-weak-map globalThis/WeakMap)
  (defconst literal-records (new literal-intrinsic-weak-map))
  (defconst literal-types (new literal-intrinsic-weak-map))
  (defvar literal-wrappers nil)
  (defvar literal-value-type nil)
  (defun ensure-literal-wrappers ()
    (or literal-wrappers (setq literal-wrappers (new literal-intrinsic-weak-map))))
  (defun ensure-literal-value-type ()
    (or literal-value-type
      (setq literal-value-type (js-call literal-intrinsic-symbol :for "eliscript.value.type"))))
  (defun literal-value-type-symbol () (ensure-literal-value-type))
  (defun literal-private-symbol (description) (funcall literal-intrinsic-symbol description))
  (defun literal-private-weak-map () (new literal-intrinsic-weak-map))
  (defvar literal-node-views nil)
  ;; Editable tries retain node identity. Revisit only the nodes whose owning
  ;; edit operation changed their revision, rather than rescanning the tree
  ;; after every transient update. Public class views keep their same fields.
  (defvar literal-node-view-revisions nil)
  (defvar literal-map-root-views nil)
  (defvar literal-queue-views nil)
  (defvar literal-subvector-sources nil)
  (defvar literal-instance-states nil)
  (defvar literal-view-states nil)
  (defvar literal-hashes nil)
  (defvar literal-iterators nil)
  (defvar literal-transient-records nil)
  (defvar literal-transient-views nil)
  (defvar literal-transient-json-descriptor nil)
  (defvar literal-editable-results nil)
  (defvar literal-transient-vector-state nil)
  (defvar literal-transient-map-state nil)
  (defvar literal-transient-set-state nil)
  (defvar literal-prototypes-ready-mask 0)
  (defvar literal-keywords nil)
  ;; One flat handler list. Each handler answers (mode value kind-or-record):
  ;; 0 -> transport kind string or nil, 1 -> exported record or undefined,
  ;; 2 -> imported instance or undefined.
  (defvar literal-transport-handlers nil)
  (defvar literal-data-descriptor nil)
  (defvar literal-accessor-descriptor nil)
  (defvar literal-keyword-type-descriptor nil)
  (defvar literal-symbol-type-descriptor nil)
  (defvar literal-has-transients false)
  (defun literal-node-owner (node)
    (if literal-has-transients (get node :owner nil) nil))
  (defvar literal-token nil)
  (defvar literal-missing nil)
  (defvar literal-list-state nil)
  (defvar literal-vector-state nil)
  (defvar literal-map-state nil)
  (defvar literal-set-state nil)
  (defvar literal-queue-state nil)
  (defvar literal-method-descriptor nil)
  (defvar literal-getter-descriptor nil)
  (defvar literal-length-descriptor nil)
  (defvar literal-nonwritable-descriptor nil)
  (defun ensure-literal-token ()
    (or literal-token (setq literal-token (Object/freeze (js-object)))))
  (defun ensure-literal-missing ()
    (or literal-missing (setq literal-missing (literal-private-symbol "eliscript.collection.missing"))))
  (defun ensure-literal-list-state ()
    (or literal-list-state (setq literal-list-state (literal-private-symbol "eliscript.list.state"))))
  (defun ensure-literal-vector-state ()
    (or literal-vector-state (setq literal-vector-state (literal-private-symbol "eliscript.vector.state"))))
  (defun ensure-literal-map-state ()
    (or literal-map-state (setq literal-map-state (literal-private-symbol "eliscript.map.state"))))
  (defun ensure-literal-set-state ()
    (or literal-set-state (setq literal-set-state (literal-private-symbol "eliscript.set.state"))))
  (defun ensure-literal-queue-state ()
    (or literal-queue-state (setq literal-queue-state (literal-private-symbol "eliscript.queue.state"))))
  (defun ensure-transient-vector-state ()
    (or literal-transient-vector-state
      (setq literal-transient-vector-state (literal-private-symbol "eliscript.transient-vector.state"))))
  (defun ensure-transient-map-state ()
    (or literal-transient-map-state
      (setq literal-transient-map-state (literal-private-symbol "eliscript.transient-map.state"))))
  (defun ensure-transient-set-state ()
    (or literal-transient-set-state
      (setq literal-transient-set-state (literal-private-symbol "eliscript.transient-set.state"))))
  (defun ensure-data-descriptor ()
    (or literal-data-descriptor
      (setq literal-data-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :value undefined)
          (put descriptor :writable t)
          (put descriptor :enumerable t)
          (put descriptor :configurable t)
          descriptor))))
  (defun ensure-method-descriptor ()
    (or literal-method-descriptor
      (setq literal-method-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :value undefined)
          (put descriptor :writable t)
          (put descriptor :configurable t)
          descriptor))))
  (defun ensure-getter-descriptor ()
    (or literal-getter-descriptor
      (setq literal-getter-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :get undefined)
          (put descriptor :configurable t)
          descriptor))))
  (defun ensure-length-descriptor ()
    (or literal-length-descriptor
      (setq literal-length-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :value 0)
          (put descriptor :configurable t)
          descriptor))))
  (defun ensure-nonwritable-descriptor ()
    (or literal-nonwritable-descriptor
      (setq literal-nonwritable-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :writable false)
          descriptor))))
  (defun ensure-accessor-descriptor ()
    (or literal-accessor-descriptor
      (setq literal-accessor-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :get undefined)
          (put descriptor :set undefined)
          (put descriptor :configurable t)
          descriptor))))
  (defun ensure-keyword-type-descriptor ()
    (or literal-keyword-type-descriptor
      (setq literal-keyword-type-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :value "keyword")
          descriptor))))
  (defun ensure-symbol-type-descriptor ()
    (or literal-symbol-type-descriptor
      (setq literal-symbol-type-descriptor
        (let ((descriptor (Object/create nil)))
          (put descriptor :value "symbol")
          descriptor))))
  (defun literal-make-method (function name)
    (funcall (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, this, args); } })[name]; }") function name))
  (defun literal-make-receiver-method (function name)
    (funcall (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, undefined, [this, ...args]); } })[name]; }") function name))

  (defun literal-fail (message) (throw (new globalThis/TypeError message)))
  (defun literal-range (message) (throw (new globalThis/RangeError message)))
  (defun literal-own-data (target key value)
    (let ((desc (ensure-data-descriptor)))
      (put desc :value value)
      (Reflect/defineProperty target key desc)
      (put desc :value undefined)
      target))
  (defun literal-install-cached-method (prototype key method)
    (let ((desc (ensure-method-descriptor)))
      (put desc :value method)
      (Reflect/defineProperty prototype key desc)
      (put desc :value undefined)
      method))
  (defun literal-install-cached-getter (prototype key method)
    (let ((desc (ensure-getter-descriptor)))
      (put desc :get method)
      (Reflect/defineProperty prototype key desc)
      (put desc :get undefined)
      method))
  (defun literal-install-method (prototype key name arity implementation)
    (let ((method (literal-make-method implementation name)))
      (unless (= arity 0)
        (let ((len-desc (ensure-length-descriptor)))
          (put len-desc :value arity)
          (Reflect/defineProperty method "length" len-desc)))
      (literal-install-cached-method prototype key method)))
  (defun literal-install-getter (prototype key name implementation)
    (literal-install-cached-getter prototype key (literal-make-method implementation name)))
  (defun literal-install-receiver-method (prototype key name arity implementation)
    (let ((method (literal-make-receiver-method implementation name)))
      (unless (= arity 0)
        (let ((len-desc (ensure-length-descriptor)))
          (put len-desc :value arity)
          (Reflect/defineProperty method "length" len-desc)))
      (literal-install-cached-method prototype key method)))
  (defun literal-install-receiver-getter (prototype key name implementation)
    (literal-install-cached-getter prototype key (literal-make-receiver-method implementation name)))
  (defun literal-state-key (type)
    (cond ((= type 1) (ensure-literal-list-state)) ((= type 2) (ensure-literal-vector-state))
      ((= type 3) (ensure-literal-map-state)) ((= type 4) (ensure-literal-set-state)) (t (ensure-literal-queue-state))))
  (defun literal-record (value) (js-call literal-records :get value))
  (defun literal-type (value)
    (let ((type (js-call literal-types :get value)))
      (if (undefined? type) 0 type)))
  (defun literal-storage-type (value) (literal-type value))
  (defun literal-data (receiver type)
    (let* ((actual-type (if (or (nullish? receiver)
                                (and (/= (js* "typeof receiver") "object") (/= (js* "typeof receiver") "function")))
                          0
                          (literal-type receiver)))
           (data (if (> actual-type 0) (literal-record receiver) undefined)))
      (if (and (> actual-type 0)
               (or (= actual-type type)
                   (and (= type 2) (= actual-type 8))))
        (if (= actual-type 8)
          (persistent-vector-with-meta (managed-vector-view-state-vector data)
            (managed-vector-view-state-meta data))
          data)
        (let* ((view (aref receiver (literal-state-key type)))
               (vdata (if (nil? literal-view-states) undefined (js-call literal-view-states :get view))))
          (if (undefined? vdata) (literal-fail "incompatible persistent collection receiver") vdata)))))
  (defun literal-prototype (type)
    (get (cond ((= type 1) PersistentList) ((= type 2) PersistentVector)
      ((= type 3) PersistentHashMap) ((= type 4) PersistentHashSet) ((= type 5) PersistentQueue)
      ((= type 6) Keyword) (t EliscriptSymbol)) :prototype))
  (defun literal-register (object type data)
    (js-call literal-records :set object data)
    (js-call literal-types :set object type)
    (when (or (<= type 5) (= type 8))
      (js-call (ensure-literal-wrappers) :set data object))
    object)

  (defun PersistentList (token count empty value rest &optional metadata)
    (when (not (or (and (not (nil? literal-token)) (eq token literal-token))))
      (literal-fail "PersistentList values must be created with persistentList or PersistentList.from"))
    (let ((receiver (js* "this")))
      (literal-own-data receiver (ensure-literal-list-state)
        (Object/freeze (js-object :count count :empty empty :value value :rest rest :metadata metadata)))
      (Object/freeze receiver)))
  (defun PersistentVector (token count shift root tail &optional metadata)
    (when (not (and (not (nil? literal-token)) (eq token literal-token)))
      (literal-fail "PersistentVector values must be created with persistentVector or PersistentVector.from"))
    (let ((receiver (js* "this")))
      (literal-own-data receiver (ensure-literal-vector-state)
        (Object/freeze (js-object :count count :shift shift :root root :tail tail :metadata metadata)))
      (Object/freeze receiver)))
  (defun PersistentHashMap (token count root &optional metadata)
    (when (not (and (not (nil? literal-token)) (eq token literal-token)))
      (literal-fail "PersistentHashMap values must be created with persistentHashMap or PersistentHashMap.from"))
    (let ((receiver (js* "this")))
      (literal-own-data receiver (ensure-literal-map-state)
        (Object/freeze (js-object :count count :root root :metadata metadata)))
      (Object/freeze receiver)))
  (defun PersistentHashSet (token map &optional metadata)
    (when (or (not (and (not (nil? literal-token)) (eq token literal-token))) (not (= (literal-type map) 3)))
      (literal-fail "PersistentHashSet values must be created with persistentHashSet or PersistentHashSet.from"))
    (let ((receiver (js* "this")))
      (literal-own-data receiver (ensure-literal-set-state)
        (Object/freeze (js-object :map map :metadata metadata)))
      (Object/freeze receiver)))
  (defun PersistentQueue (token count front rear &optional metadata)
    (when (not (and (not (nil? literal-token)) (eq token literal-token)))
      (literal-fail "PersistentQueue values must be created with persistentQueue or PersistentQueue.from"))
    (when (or (not (Number/isSafeInteger count)) (< count 0) (> count 2147483647)
              (not (or (= (literal-type front) 2) (= (literal-type front) 8)))
              (not (or (= (literal-type rear) 2) (= (literal-type rear) 8)))
              (not (= (+ (get front :count) (get rear :count)) count))
              (and (> count 0) (= (get front :count) 0)))
      (literal-fail "invalid persistent queue state"))
    (let ((receiver (js* "this")))
      (literal-own-data receiver (ensure-literal-queue-state)
        (Object/freeze (js-object :count count :front front :rear rear :metadata metadata)))
      (Object/freeze receiver)))
  (defun VectorNode (&optional slots owner)
    (let ((receiver (js* "this")))
      (put receiver :owner owner) (put receiver :slots (if (nil? slots) (js-array) slots))
      (when (nil? owner) (Object/freeze (get receiver :slots)) (Object/freeze receiver)) receiver))
  (defun MapEntry (key value hash)
    (let ((receiver (js* "this")))
      (put receiver :key key) (put receiver :value value) (put receiver :hash (uint32 hash)) (Object/freeze receiver)))
  (defun BitmapIndexedNode (&optional bitmap items owner)
    (let ((receiver (js* "this")))
      (put receiver :bitmap (uint32 (if (nil? bitmap) 0 bitmap))) (put receiver :owner owner)
      (put receiver :items (if (nil? items) (js-array) items))
      (when (nil? owner) (Object/freeze (get receiver :items)) (Object/freeze receiver)) receiver))
  (defun ArrayNode (count children &optional owner)
    (let ((receiver (js* "this")))
      (put receiver :count count) (put receiver :owner owner) (put receiver :children children)
      (when (nil? owner) (Object/freeze children) (Object/freeze receiver)) receiver))
  (defun HashCollisionNode (hash entries &optional owner)
    (let ((receiver (js* "this")))
      (put receiver :hash (uint32 hash)) (put receiver :owner owner) (put receiver :entries entries)
      (when (nil? owner) (Object/freeze entries) (Object/freeze receiver)) receiver))
  (defun literal-vector-node-view (node level)
    (let ((cached (if (nil? literal-node-views) undefined (js-call literal-node-views :get node))))
      (if (not (undefined? cached))
        (progn
          (unless (or (nil? (literal-node-owner node))
                      (= (if (nil? literal-node-view-revisions) undefined (js-call literal-node-view-revisions :get node))
                         (get node :revision 0)))
            (let ((source (get node :slots)) (slots (get cached :slots)) (index 0))
              (put slots :length (js-length source))
              (while (< index (js-length source))
                (let ((item (get source index)))
                  (if (Object/hasOwn source index)
                    (put slots index (if (and (> level 0) (not (nullish? item)))
                      (literal-vector-node-view item (- level 5)) item))
                    (Reflect/deleteProperty slots index)))
                (setq index (1+ index))))
            (js-call (or literal-node-view-revisions (setq literal-node-view-revisions (literal-private-weak-map)))
              :set node (get node :revision 0))) cached)
        (let* ((slots (get node :slots)) (values (new globalThis/Array (js-length slots))) (index 0))
          (while (< index (js-length slots))
            (let ((value (get slots index)))
              (unless (undefined? value)
                (put values index (if (and (> level 0) (not (nil? value)))
                  (literal-vector-node-view value (- level 5)) value))))
            (setq index (1+ index)))
          (let ((view (new VectorNode values (literal-node-owner node))))
            (js-call (or literal-node-views (setq literal-node-views (literal-private-weak-map))) :set node view)
            (js-call (or literal-node-view-revisions (setq literal-node-view-revisions (literal-private-weak-map)))
              :set node (get node :revision 0)) view)))))
  (defun literal-map-node-view (node)
    (if (nil? node) (ensure-empty-bitmap)
      (let ((cached (if (nil? literal-node-views) undefined (js-call literal-node-views :get node))))
        (if (not (undefined? cached))
          (progn
            (unless (or (= (get node :kind) "entry") (nil? (literal-node-owner node))
                        (= (if (nil? literal-node-view-revisions) undefined (js-call literal-node-view-revisions :get node))
                           (get node :revision 0)))
              (let* ((kind (get node :kind)) (field (if (= kind "bitmap") "items" (if (= kind "array") "children" "entries")))
                     (source (get node field)) (items (get cached field)) (index 0))
                (put items :length (js-length source))
                (while (< index (js-length source))
                  (let ((child (get source index)))
                    (put items index (if (nullish? child) undefined (literal-map-node-view child))))
                  (setq index (1+ index)))
                (put cached (if (= kind "bitmap") "bitmap" (if (= kind "array") "count" "hash"))
                  (get node (if (= kind "bitmap") "bitmap" (if (= kind "array") "count" "hash")))))
              (js-call (or literal-node-view-revisions (setq literal-node-view-revisions (literal-private-weak-map)))
                :set node (get node :revision 0))) cached)
          (let* ((kind (get node :kind))
                 (view (if (= kind "entry") (new MapEntry (get node :key) (get node :value) (get node :hash))
                   (let* ((source (get node (if (= kind "bitmap") "items" (if (= kind "array") "children" "entries"))))
                          (items (new globalThis/Array (js-length source))) (index 0))
                     (while (< index (js-length source))
                       (let ((child (get source index)))
                         (put items index (if (nil? child) undefined (literal-map-node-view child))))
                       (setq index (1+ index)))
                     (cond ((= kind "bitmap") (new BitmapIndexedNode (get node :bitmap) items (literal-node-owner node)))
                       ((= kind "array") (new ArrayNode (get node :count) items (literal-node-owner node)))
                       (t (new HashCollisionNode (get node :hash) items (literal-node-owner node))))))))
            (js-call (or literal-node-views (setq literal-node-views (literal-private-weak-map))) :set node view)
            (js-call (or literal-node-view-revisions (setq literal-node-view-revisions (literal-private-weak-map)))
              :set node (get node :revision 0)) view)))))
  (defun literal-map-root-view (root)
    (if (nil? root) (ensure-empty-bitmap)
      (if (or (= (get root :kind) "entry") (= (get root :kind) "collision"))
        (let ((child (literal-map-node-view root))
              (cached (if (nil? literal-map-root-views) undefined (js-call literal-map-root-views :get root))))
          (if (not (undefined? cached)) cached
            (let ((view (new BitmapIndexedNode (uint32 (bit-shift-left 1 (bit-and (get root :hash) 31)))
              (js-array child) (literal-node-owner root))))
              (js-call (or literal-map-root-views (setq literal-map-root-views (literal-private-weak-map))) :set root view) view)))
        (literal-map-node-view root))))

  (defvar literal-empty-bitmap nil)
  (defvar literal-empty-list-data nil)
  (defvar literal-empty-vector-data nil)
  (defvar literal-empty-map-data nil)
  (defvar literal-empty-set-data nil)
  (defvar literal-empty-queue-data nil)
  (defun ensure-empty-bitmap ()
    (or literal-empty-bitmap (setq literal-empty-bitmap (new BitmapIndexedNode))))
  (defun ensure-empty-list-data ()
    (or literal-empty-list-data (setq literal-empty-list-data (empty-persistent-list))))
  (defun ensure-empty-vector-data ()
    (or literal-empty-vector-data (setq literal-empty-vector-data (empty-persistent-vector))))
  (defun ensure-empty-map-data ()
    (or literal-empty-map-data
      (setq literal-empty-map-data (empty-persistent-map literal-hash literal-equal literal-equal))))
  (defun ensure-empty-set-data ()
    (or literal-empty-set-data
      (setq literal-empty-set-data (empty-persistent-set literal-hash literal-equal))))
  (defun ensure-empty-queue-data ()
    (or literal-empty-queue-data (setq literal-empty-queue-data (managed-queue-state-empty))))
  (defun literal-data-count (type data)
    (cond ((= type 4) (persistent-set-count data))
          ((= type 5) (managed-queue-state-count data))
          ((= type 8) (managed-vector-view-state-count data))
          (t (get data :count))))
  (defun literal-canonical-data (type data)
    (if (and (= (literal-data-count type data) 0)
             (nil? (if (= type 5) (managed-queue-state-meta data) (get data :metadata nil))))
      (cond ((= type 1) (ensure-empty-list-data)) ((= type 2) (ensure-empty-vector-data))
        ((= type 3) (ensure-empty-map-data)) ((= type 4) (ensure-empty-set-data)) (t (ensure-empty-queue-data))) data))
  (defun literal-materialize-state (receiver expected-type)
    (let* ((actual-type (if (or (nullish? receiver)
                                (and (/= (js* "typeof receiver") "object") (/= (js* "typeof receiver") "function")))
                          0
                          (literal-type receiver)))
           (data (if (> actual-type 0) (literal-record receiver) undefined)))
      (if (not (or (= actual-type expected-type)
                   (and (= expected-type 2) (= actual-type 8))))
        undefined
        (let ((cached (if (nil? literal-instance-states) undefined (js-call literal-instance-states :get receiver))))
          (if (not (undefined? cached)) cached
