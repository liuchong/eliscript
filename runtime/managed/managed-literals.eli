                literal-nonwritable-descriptor nil literal-accessor-descriptor nil literal-data-descriptor nil)))))

  (defun literal-initialize-prototype (type)
    (let ((bit (bit-shift-left 1 type)))
      (when (= (bit-and literal-prototypes-ready-mask bit) 0)
        (let* ((constructor (cond ((= type 1) PersistentList) ((= type 2) PersistentVector) ((= type 3) PersistentHashMap)
                 ((= type 4) PersistentHashSet) ((= type 5) PersistentQueue) ((= type 6) Keyword) (t EliscriptSymbol)))
               (prototype (literal-prototype type)))
          (Reflect/defineProperty constructor "prototype" (ensure-nonwritable-descriptor))
          (literal-install-cached-getter prototype (get globalThis/Symbol :toStringTag) (ensure-shared-to-string-tag))
          (if (<= type 5)
            (progn
              (when (nil? literal-shared-state-getter)
                (setq literal-shared-state-getter
                  (literal-make-receiver-method
                    (lambda (receiver)
                      (let ((actual (if (or (nullish? receiver)
                                            (and (/= (js* "typeof receiver") "object") (/= (js* "typeof receiver") "function")))
                                      0 (literal-type receiver))))
                        (if (or (and (>= actual 1) (<= actual 5)) (= actual 8))
                          (literal-materialize-state receiver (if (= actual 8) 2 actual))
                          undefined)))
                    "get state")
                      literal-shared-state-setter
                  (literal-make-receiver-method
                    (lambda (receiver value)
                      (let ((key (cond ((literal-raw-instance? receiver PersistentVector) (ensure-literal-vector-state))
                                       ((literal-raw-instance? receiver PersistentList) (ensure-literal-list-state))
                                       ((literal-raw-instance? receiver PersistentHashMap) (ensure-literal-map-state))
                                       ((literal-raw-instance? receiver PersistentHashSet) (ensure-literal-set-state))
                                       (t (ensure-literal-queue-state)))))
                        (literal-own-data receiver key value)))
                    "set state")))
              (let ((state-key (literal-state-key type))
                    (acc-desc (ensure-accessor-descriptor)))
                (put acc-desc :get literal-shared-state-getter)
                (put acc-desc :set literal-shared-state-setter)
                (Reflect/defineProperty prototype state-key acc-desc)
                (put acc-desc :get undefined)
                (put acc-desc :set undefined))
              (ensure-shared-count-getters)
              (literal-install-cached-getter prototype "count" literal-shared-count-getter)
              (literal-install-cached-getter prototype "size" literal-shared-size-getter)
              (when (or (= type 1) (= type 5))
                (when (nil? literal-shared-empty-getter)
                  (setq literal-shared-empty-getter (literal-make-receiver-method (lambda (receiver) (= (literal-count receiver) 0)) "get isEmpty")))
                (literal-install-cached-getter prototype "isEmpty" literal-shared-empty-getter))
              (literal-install-method constructor "empty" "empty" 0
                (cond ((= type 1) literal-list-empty)
                      ((= type 2) literal-vector-empty)
                      ((= type 3) literal-map-empty)
                      ((= type 4) literal-set-empty)
                      (t literal-queue-empty)))
              (literal-install-method constructor "from" "from" 1
                (cond ((= type 1) literal-list-from)
                      ((= type 2) literal-vector-from)
                      ((= type 3) literal-map-from)
                      ((= type 4) literal-set-from)
                      (t literal-queue-from)))
              (when (= type 2)
                (literal-install-method constructor "single" "single" 1 literal-vector-single)
                (literal-install-method constructor "pairWithMeta" "pairWithMeta" 2 literal-vector-pair-with-meta)
                (literal-install-method constructor "rawSlot" "rawSlot" 2 literal-vector-raw-slot))
              (literal-install-cached-method prototype "conj" (ensure-shared-conj))
              (if (or (= type 3) (= type 4))
                (progn
                  (ensure-shared-map-set-methods)
                  (literal-install-cached-method prototype "reduce" literal-shared-kv-set-reduce))
                (progn
                  (when (nil? literal-shared-sequence-reduce)
                    (setq literal-shared-sequence-reduce (literal-make-receiver-method
                      (lambda (receiver reducer &rest initial)
                        (unless (= (js* "typeof reducer") "function") (literal-fail "collection reducer must be a function"))
                        (let* ((missing (ensure-literal-missing))
                               (result (if (= (js-length initial) 0) missing (get initial 0))))
                          (literal-while-each receiver (lambda (item)
                            (if (eq result missing) (progn (setq result item) t)
                              (progn (setq result (funcall reducer result item))
                                (if (managed-literal-is-reduced result) (progn (setq result (managed-literal-unreduced result)) false) t)))))
                          (when (eq result missing) (literal-fail "cannot reduce an empty collection without an initial value")) result))
                      "reduce"))
                    (let ((len-desc (ensure-length-descriptor)))
                      (put len-desc :value 1)
                      (Reflect/defineProperty literal-shared-sequence-reduce "length" len-desc)))
                  (literal-install-cached-method prototype "reduce" literal-shared-sequence-reduce)))
              (literal-install-cached-method prototype (get globalThis/Symbol :iterator) (ensure-shared-iterator))
              (when (or (= type 1) (= type 2) (= type 5))
                (ensure-shared-stack-methods)
                (literal-install-cached-method prototype "peek" literal-shared-peek)
                (literal-install-cached-method prototype "pop" literal-shared-pop)
                (when (nil? literal-shared-to-array)
                  (setq literal-shared-to-array (literal-make-receiver-method
                    (lambda (receiver)
                      (let ((out (js-array)) (index 0))
                        (if (= (literal-collection-type receiver) 2)
                          (js-call receiver :reduce (lambda (_ item) (put out index item) (setq index (1+ index)) out) out)
                          (progn (literal-each receiver (lambda (item) (put out index item) (setq index (1+ index)))) out))))
                    "toArray")))
                (literal-install-cached-method prototype "toArray" literal-shared-to-array))
              (when (or (= type 1) (= type 2))
                (literal-install-cached-method prototype "nth" (ensure-shared-nth)))
              (when (= type 1)
                (literal-install-receiver-method prototype "first" "first" 0
                  (lambda (receiver &optional not-found)
                    (let ((data (literal-data receiver 1)))
                      (if (persistent-list-empty? data) not-found (persistent-list-first data nil)))))
                (literal-install-receiver-method prototype "rest" "rest" 0
                  (lambda (receiver)
                    (let ((data (literal-data receiver 1)))
                      (if (persistent-list-empty? data) receiver (literal-wrap 1 (persistent-list-rest data nil))))))
                (literal-install-receiver-method prototype "cons" "cons" 1
                  (lambda (receiver value)
                    (let ((data (literal-data receiver 1)))
                      (literal-finish-change 1 data (persistent-list-cons data value) receiver)))))
              (when (or (= type 2) (= type 3))
                (literal-install-cached-method prototype "assoc" (ensure-shared-assoc)))
              (when (or (= type 3) (= type 4))
                (ensure-shared-map-set-methods)
                (literal-install-cached-method prototype "has" literal-shared-has)
                (literal-install-cached-method prototype "entries" literal-shared-entries)
                (literal-install-cached-method prototype "keys" literal-shared-keys)
                (literal-install-cached-method prototype "values" literal-shared-values))
              (when (= type 3)
                (literal-install-receiver-method prototype "get" "get" 1
                  (lambda (receiver key &optional not-found) (persistent-map-get (literal-data receiver 3) key not-found)))
                (literal-install-receiver-method prototype "dissoc" "dissoc" 1
                  (lambda (receiver key) (literal-dissoc receiver key)))
                (literal-install-receiver-method prototype "toMap" "toMap" 0
                  (lambda (receiver)
                    (let ((out (new globalThis/Map)))
                      (literal-each receiver (lambda (entry) (js-call out :set (get entry 0) (get entry 1)))) out)))
                (when (nil? literal-shared-brand-true)
                  (setq literal-shared-brand-true (literal-make-method managed-literal-brand-true "get [eliscript.persistent-kind]")))
                (literal-install-cached-getter prototype PERSISTENT_MAP_KIND literal-shared-brand-true)
                (managed-literal-install-slot prototype PERSISTENT_MAP_HAS_VALUE_KEY
                  (lambda (receiver key)
                    (unless (= (literal-type receiver) 3) (literal-fail "incompatible persistent collection receiver"))
                    (js-call receiver :has key)) 1))
              (when (= type 4)
                (literal-install-receiver-method prototype "disj" "disj" 1
                  (lambda (receiver value) (literal-disj receiver value)))
                (literal-install-receiver-method prototype "toSet" "toSet" 0
                  (lambda (receiver)
                    (let ((out (new globalThis/Set)))
                      (literal-each receiver (lambda (value) (js-call out :add value))) out)))
                (literal-install-receiver-method prototype "union" "union" 0
                  (lambda (receiver &rest collections)
                    (let ((result receiver) (index 0))
                      (while (< index (js-length collections))
                        (literal-each (get collections index) (lambda (value) (setq result (js-call result :conj value))))
                        (setq index (1+ index))) result)))
                (literal-install-receiver-method prototype "intersection" "intersection" 0
                  (lambda (receiver &rest collections)
                    (let ((result receiver) (index 0) (finished false))
                      (while (and (not finished) (< index (js-length collections)))
                        (let ((other (literal-set-from (get collections index))))
                          (if (= (get result :count) 0) (setq finished t)
                            (let* ((candidates (if (<= (get result :count) (get other :count)) result other))
                                   (membership (if (eq candidates result) other result))
                                   (retained (literal-with-meta (literal-set-empty) (persistent-set-meta (literal-data receiver 4)))))
                              (literal-each candidates (lambda (value)
                                (when (js-call membership :has value) (setq retained (js-call retained :conj value)))))
                              (unless (= (get retained :count) (get result :count)) (setq result retained)))))
                        (setq index (1+ index))) result)))
                (literal-install-receiver-method prototype "difference" "difference" 0
                  (lambda (receiver &rest collections)
                    (let ((result receiver) (index 0) (finished false))
                      (while (and (not finished) (< index (js-length collections)))
                        (literal-each (get collections index) (lambda (value) (setq result (js-call result :disj value))))
                        (when (= (get result :count) 0) (setq finished t)) (setq index (1+ index))) result)))
                (literal-install-receiver-method prototype "isSubsetOf" "isSubsetOf" 1
                  (lambda (receiver collection)
                    (let ((other (literal-set-from collection)))
                      (if (> (get receiver :count) (get other :count)) false
                        (literal-while-each receiver (lambda (value) (js-call other :has value)))))))
                (literal-install-receiver-method prototype "isSupersetOf" "isSupersetOf" 1
                  (lambda (receiver collection) (js-call (literal-set-from collection) :isSubsetOf receiver)))
                (literal-install-receiver-method prototype "isDisjointFrom" "isDisjointFrom" 1
                  (lambda (receiver collection)
                    (let* ((other (literal-set-from collection))
                           (candidates (if (<= (get receiver :count) (get other :count)) receiver other))
                           (membership (if (eq candidates receiver) other receiver)))
                      (literal-while-each candidates (lambda (value) (not (js-call membership :has value)))))))
                (when (nil? literal-shared-brand-true)
                  (setq literal-shared-brand-true (literal-make-method managed-literal-brand-true "get [eliscript.persistent-kind]")))
                (literal-install-cached-getter prototype PERSISTENT_SET_KIND literal-shared-brand-true)
                (managed-literal-install-slot prototype PERSISTENT_SET_HAS_VALUE
                  (lambda (receiver value)
                    (unless (= (literal-type receiver) 4) (literal-fail "incompatible persistent collection receiver"))
                    (js-call receiver :has value)) 1)))
            (progn
              (when (nil? literal-shared-identifier-name)
                (setq literal-shared-identifier-name (literal-make-receiver-method (lambda (receiver) (aref (literal-record receiver) 1)) "get name")
                      literal-shared-identifier-namespace (literal-make-receiver-method (lambda (receiver) (aref (literal-record receiver) 0)) "get namespace")
                      literal-shared-identifier-qualified (literal-make-receiver-method
                        (lambda (receiver)
                          (let ((namespace (get receiver :namespace)) (name (get receiver :name)))
                            (if (nil? namespace) name (str namespace "/" name)))) "get qualifiedName")
                      literal-shared-identifier-string (literal-make-receiver-method
                        (lambda (receiver)
                          (str (if (= (literal-type receiver) 6) ":" "") (get receiver :qualifiedName))) "toString")
                      literal-shared-identifier-json (literal-make-receiver-method
                        (lambda (receiver)
                          (literal-fail (if (= (literal-type receiver) 6)
                            "Keyword values require an explicit serialization codec" "EliscriptSymbol values require an explicit serialization codec"))) "toJSON")))
              (literal-install-cached-getter prototype "name" literal-shared-identifier-name)
              (literal-install-cached-getter prototype "namespace" literal-shared-identifier-namespace)
              (literal-install-cached-getter prototype "qualifiedName" literal-shared-identifier-qualified)
              (literal-install-cached-method prototype "toString" literal-shared-identifier-string)
              (literal-install-cached-method prototype "toJSON" literal-shared-identifier-json)))
          (literal-register-initialized-type type constructor)
          (setq literal-prototypes-ready-mask (bit-or literal-prototypes-ready-mask bit))
          ;; Installation for this type is complete; release the temporary
          ;; descriptor records so they cannot stay resident.
          (setq literal-method-descriptor nil literal-getter-descriptor nil literal-length-descriptor nil
                literal-nonwritable-descriptor nil literal-accessor-descriptor nil literal-data-descriptor nil)))))
  (defun literal-ensure-type (type)
    (cond ((= type 8) (literal-initialize-subvector-prototype))
      ((and (>= type 1) (<= type 7)) (literal-initialize-prototype type))
      (t (literal-fail "unknown persistent value type")))
    (cond ((= type 8) PersistentSubVector) (t (get (literal-prototype type) :constructor))))
  (defun literal-kind (value)
    (let ((type (literal-type value)))
      (cond ((= type 1) "list") ((= type 2) "vector") ((= type 3) "map") ((= type 4) "set")
        ((= type 5) "queue") ((= type 6) "keyword") ((= type 7) "symbol") ((= type 8) "subvector")
        ((managed-literal-is-reduced value) "reduced")
        (t (literal-transport-kind value)))))
  (defun literal-register-transport-handler (handler)
    (unless (= (js* "typeof handler") "function")
      (literal-fail "persistent transport handler must be a function"))
    (when (nil? literal-transport-handlers)
      (setq literal-transport-handlers (js-array)))
    (js-call literal-transport-handlers :push handler)
    undefined)
  (defun literal-core-kind? (kind)
    (or (= kind "list") (= kind "vector") (= kind "map") (= kind "set") (= kind "queue")
      (= kind "keyword") (= kind "symbol") (= kind "subvector") (= kind "reduced")))
  ;; The three protocol transports are intrinsic and always take precedence over
  ;; registered handlers, preserving the original registration order.
  (defun literal-transport-kind (value)
    (cond ((protocol? value) "protocol")
      ((not (undefined? (read-protocol-operations-owner value))) "protocol-operations")
      ((not (undefined? (read-protocol-method-owner value))) "protocol-method")
      (t (let ((index 0) (found nil))
           (while (and (nil? found) (< index (js-length literal-transport-handlers)))
             (setq found (funcall (aref literal-transport-handlers index) 0 value nil))
             (when (nil? found) (setq index (1+ index))))
           found))))
  (defun literal-export-transport (kind value)
    (cond ((= kind "protocol")
        (let* ((definition (protocol-definition value)) (operations (get value :operations))
               (names (get definition :operations)) (slots (js-array)) (index 0))
          (while (< index (js-length names))
            (js-call slots :push (get (get operations (get names index)) :slot))
            (setq index (1+ index)))
          (js-object :kind "protocol" :definition definition :slots slots :operations operations
            :role (managed-literal-protocol-role value))))
      ((= kind "protocol-operations")
        (js-object :kind "protocol-operations" :protocol (read-protocol-operations-owner value)))
      ((= kind "protocol-method")
        (let ((owner (read-protocol-method-owner value)))
          (js-object :kind "protocol-method" :protocol (get owner :protocol) :operation (get owner :operation))))
      (t (let ((index 0) (record undefined))
           (while (and (undefined? record) (< index (js-length literal-transport-handlers)))
             (setq record (funcall (aref literal-transport-handlers index) 1 kind value))
             (setq index (1+ index)))
           (if (undefined? record) (literal-fail "unknown persistent transport kind") record)))))
  (defun literal-import-transport (kind record)
    (cond ((= kind "protocol")
        (materialize-protocol-from-definition (get record :definition) (get record :slots)))
      ((= kind "protocol-operations") (get (get record :protocol) :operations))
      ((= kind "protocol-method")
        (get (get (get record :protocol) :operations) (get record :operation)))
      (t (let ((index 0) (value undefined))
           (while (and (undefined? value) (< index (js-length literal-transport-handlers)))
             (setq value (funcall (aref literal-transport-handlers index) 2 kind record))
             (setq index (1+ index)))
           (if (undefined? value) (literal-fail "unknown persistent value kind") value)))))
  (defun literal-export-value (value)
    (let ((kind (literal-kind value)))
      (if (nil? kind) nil
        (if (not (literal-core-kind? kind)) (literal-export-transport kind value)
        (if (= kind "reduced")
          (js-object :kind kind :value (managed-literal-unreduced value))
        (if (= kind "subvector")
          (let ((data (literal-subvector-data value)))
            (js-object :kind kind :source (literal-subvector-source data)
              :start (managed-vector-view-state-start data) :end (managed-vector-view-state-end data)
              :metadata (managed-vector-view-state-meta data)))
        (if (or (= kind "keyword") (= kind "symbol"))
          (let ((data (literal-record value)))
            (js-object :kind kind :namespace (aref data 0) :name (aref data 1)
              :metadata (literal-meta value)))
          (let ((values (literal-to-array value)))
            (when (= kind "map")
              (let ((flat (js-array)) (index 0))
                (while (< index (js-length values))
                  (let ((entry (get values index))) (js-call flat :push (get entry 0) (get entry 1)))
                  (setq index (1+ index))) (setq values flat)))
            (js-object :kind kind :values values :metadata (literal-meta value))))))))))
  (defun literal-import-value (record)
    (let* ((kind (get record :kind)) (values (get record :values))
           (value (cond ((= kind "list") (literal-list-from-array-values values))
             ((= kind "vector") (literal-vector-from-array-values values))
             ((= kind "map") (literal-map-from-flat-values values))
             ((= kind "set") (literal-set-from-array-values values))
             ((= kind "queue") (literal-queue-from-array-values values))
             ((= kind "reduced") (managed-literal-reduced (get record :value)))
             ((= kind "subvector") (literal-subvec (get record :source) (get record :start) (get record :end)))
             ((= kind "keyword") (literal-keyword (get record :namespace) (get record :name)))
             ((= kind "symbol") (literal-symbol (get record :namespace) (get record :name)))
             (t (literal-import-transport kind record))))
           (metadata (get record :metadata nil)))
      (if (or (= kind "keyword") (= kind "reduced") (not (literal-core-kind? kind)) (nil? metadata))
        value (literal-with-meta value metadata))))
  (defun literal-protocol-for-role (role) (managed-literal-protocol-for-role role))
  (export literal-list literal-vector literal-vector-from-array-values literal-map literal-set literal-queue literal-keyword literal-symbol literal-binding-lookup
    literal-value-type-symbol literal-private-symbol literal-private-weak-map
    literal-count literal-nth literal-get literal-first literal-rest literal-cons literal-equal literal-hash
    literal-mix literal-finish literal-string-hash literal-entry literal-each
    literal-conj literal-assoc literal-dissoc literal-disj literal-peek literal-pop literal-meta literal-with-meta
    literal-to-array literal-type literal-kind literal-export-value literal-import-value literal-subvec literal-protocols
    literal-protocol-runtime-get literal-ensure-type literal-instance? literal-transient literal-transient-type literal-transient-conj
    literal-register-transport-handler literal-protocol-for-role
    literal-transient-assoc literal-transient-dissoc literal-transient-persistent
    PersistentList PersistentVector PersistentHashMap PersistentHashSet PersistentQueue PersistentSubVector
    TransientVector TransientHashMap TransientHashSet Keyword EliscriptSymbol))
