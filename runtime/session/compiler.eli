                    (let ((kw (get (get cursor :car) :name))
                          (val (el-car (get cursor :cdr))))
                      (cond
                        ((= kw ":tags") (setq tags (if (and (el-cons? val) (eq (get val :car) s-quote)) (el-second val) val)))
                        ((= kw ":expected-result") (setq expected (if (and (el-cons? val) (eq (get val :car) s-quote)) (el-second val) val))))
                      (setq cursor (el-cdr (get cursor :cdr)))))
                  (str "(rt-ert-deftest session " (compile-quote ctx test-name) " "
