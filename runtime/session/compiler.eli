              ((= name "defvar-local")
                (let ((sym (el-second form))
                      (rest (el-cdr (get form :cdr))))
                  (el-add-special-var csession sym)
                  (str "(rt-defvar-local session " (ctx-sym ctx (get sym :name)) " "
                       (if (nil? rest) "nil" (str "(lambda () " (compile-expr ctx cenv (el-car rest)) ")")) ")")))
              ((= name "defconst")
