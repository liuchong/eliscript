                (compile-let ctx cenv (el-second form) (el-rest-after form 1) false t))
              ((= name "let*-const")
                (compile-let ctx cenv (el-second form) (el-rest-after form 1) t t))
              ((= name "letrec")
                (compile-letrec ctx cenv (el-second form) (el-rest-after form 1)))
              ((= name "setq")
                (let ((cursor (get form :cdr))
                      (steps (js-array)))
