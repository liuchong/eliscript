                       (type-expr (if (< type-idx 0) (compile-quote ctx (el-intern "error"))
                                    (compile-expr ctx cenv (aref args (1+ type-idx))))))
                  (str "(rt-should-error session (lambda () " (compile-expr ctx cenv (el-second form)) ") "
                       type-expr " " (compile-quote ctx (el-second form)) ")")))
              ((= name "cl-destructuring-bind")
