              ((or (= name "cl-labels") (= name "cl-letf-functions"))
                (let* ((bindings (el-list-to-array (el-second form)))
                       (next-cenv (make-cenv cenv))
                       (decls (js-array))
                       (steps (js-array)))
                  (js-call bindings :forEach
                           (lambda (b)
                             (let* ((fn-sym (get b :car))
                                    (fn-name (get fn-sym :name))
                                    (fn-var (ctx-gensym ctx "lb")))
                               (js-call decls :push (str "(" fn-var " nil)"))
                               (js-call (get next-cenv :fns) :set fn-name fn-var))))
                  (js-call bindings :forEach
                           (lambda (b)
