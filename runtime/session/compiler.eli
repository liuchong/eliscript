              ((= name "with-temp-buffer")
                (str "(rt-with-temp-buffer session (lambda () " (compile-list-body ctx cenv (get form :cdr)) "))"))
              ((= name "with-temp-file")
                (str "(rt-with-temp-file session " (compile-expr ctx cenv (el-second form))
                     " (lambda () " (compile-list-body ctx cenv (el-rest-after form 1)) "))"))
