(module eliscript.runtime.session.compiler
  ;;; compiler.eli --- AOT Lisp-to-Eliscript-to-JavaScript compiler and compiled-module runtime helpers

  (import "./core.eli" JS_FALSE JS_NULL JS_UNDEFINED OPTION_NONE el-add-special-var el-append el-aref el-arith el-arith-2 el-aset-container el-assoc-with el-bool el-car el-car-safe el-cdr el-cdr-safe el-compile-error el-condition-matches el-cons el-cons? el-control-transfer? el-copy-sequence el-default-value el-eq el-eql el-equal-p el-error-from-host el-float? el-function? el-gethash el-global-value el-hash-table? el-integer? el-intern el-keyword? el-kind el-list el-list-from el-list-to-array el-make-pcoll el-make-pmap el-make-pset el-make-signal el-member-with el-nth el-nthcdr el-num el-number? el-opt el-plist-get el-plist-member el-plist-put el-prin1-string el-puthash el-record-field-name el-record? el-seq-items el-signal el-string-set el-string? el-sym-is el-symbol-name el-symbol-name-or-string el-symbol? el-symobj? el-typeof el-validate-struct-field el-value-contains el-value-equal el-value-get el-vector el-vector? s-allow-other-keys s-and s-app s-aux s-backquote s-body s-comma s-comma-at s-declare s-default s-eliscript s-function s-guard s-if s-interactive s-key s-lambda s-let s-macro s-not s-optional s-or s-otherwise s-pred s-progn s-quote s-recur s-rest s-setf s-setq s-underscore)
  (import "./reader-format.eli" el-expand-file-name el-read-all)
  (import "./regexp-buffer.eli" el-clamp-position el-current-buffer el-generate-new-buffer el-get-buffer-create el-kill-buffer el-point-max el-rx el-string-match)
  (import "./evaluator.eli" el-args el-bind-variable el-call el-callable el-catch-block el-check-struct el-cl-typep el-def el-define-function el-eq-test el-eql-test el-eval el-eval-body el-extract-declarations el-get-prop el-handler-conditions el-macroexpand el-macroexpand-1 el-new-env el-normalize-result el-parse-arglist el-put-prop el-rest-after el-restore-dynamic el-root-env el-second el-set-dynamic-variable el-set-fn el-set-macro el-simple-arglist? el-struct-instance? el-symbol-function el-test-function el-third el-throw el-validate-defun)
  (import "./macros-forms.eli" cadr-place-pattern el-boa-arglist el-loop-final el-loop-initial el-loop-keyword? el-loop-normalize)
  (import "./host-io.eli" el-fs el-locate-library el-node-builtin el-path)
  (import "./extensions.eli" el-activate-extension el-check-const-mutation el-collect-pattern-vars el-dispatch-tag el-future el-require el-verify-recur-tail)
  (import "./builtins.eli" createSession)


  ;; ------------------------------------------------------------------
  ;; Compiled-Module Runtime Helpers (rt-*)
  ;; ------------------------------------------------------------------

  (defun rt-truthy (v)
    (not (or (nil? v) (undefined? v) (eq v false))))

  (defun rt-lt (a b) (< a b))
  (defun rt-lte (a b) (<= a b))
  (defun rt-gt (a b) (> a b))
  (defun rt-gte (a b) (>= a b))
  (defun rt-sub (a b) (- a b))
  (defun rt-dec (a) (1- a))
  (defun rt-mod (a b) (% a b))

  (defun rt-get-global (session sym)
    (cond
      ((eq (get sym :kind) "keyword") sym)
      (t
        (let ((getter (js-call (get session :liveValueGetters) :get sym)))
          (if (undefined? getter) (el-global-value session sym) (funcall getter))))))

  (defun rt-set-global (session sym value)
    (when (or (nil? sym) (eq sym t) (el-keyword? sym)) (el-signal "setting-constant" sym))
    (unless (el-symobj? sym) (el-signal "wrong-type-argument" (el-intern "symbolp") sym))
    (el-set-dynamic-variable session sym value))

  (defun rt-read-var (session sym lex-val)
    (if (and (get sym :_everSpecial) (js-call (get session :specials) :has sym))
        (rt-get-global session sym)
      lex-val))

  (defun rt-write-var (session sym val)
    (when (and (get sym :_everSpecial) (js-call (get session :specials) :has sym))
      (el-set-dynamic-variable session sym val))
    val)

  (defun rt-bind-var (session sym value dynamic)
    (when (or (nil? sym) (eq sym t)) (el-signal "setting-constant" sym))
    (when (and (get sym :_everSpecial) (js-call (get session :specials) :has sym))
      (let* ((values (get session :values))
             (buf (get session :currentBuffer))
             (locals (if (and (not (nullish? buf)) (get buf :live)) (get buf :locals) nil))
             (has-local (and (not (nil? locals)) (js-call locals :has sym))))
        (js-call dynamic :push
                 (js-array sym (js-call values :has sym) (js-call values :get sym)
                           (if has-local locals nil) (if has-local (js-call locals :get sym) nil)))
        (if has-local
            (js-call locals :set sym value)
          (js-call values :set sym value))))
    value)

  (defun rt-bind-const-var (session sym value dynamic)
    (when (and (get sym :_everSpecial) (js-call (get session :specials) :has sym))
      (el-compile-error (str "ELI-C0011: let-const cannot bind special variable " (get sym :name))))
    (rt-bind-var session sym value dynamic))

  (defun rt-restore-dyn (session dynamic)
    (when (> (js-length dynamic) 0)
      (el-restore-dynamic session dynamic)))

  (defun rt-check-arity (name args nreq nmax has-rest)
    (let ((count (js-length args)))
      (when (or (< count nreq) (and (not has-rest) (> count nmax)))
        (el-signal "wrong-number-of-arguments" (el-intern name) count))))

  (defun rt-opt-arg (args idx)
    (if (< idx (js-length args)) (el-opt (aref args idx)) nil))

  (defun rt-rest-arg (args start)
    (el-list-from (js-call args :slice start)))

  (defun rt-resolve-fn (session sym)
    (if (eq (get sym :_cachedSession) session)
        (get sym :_cachedFn)
      (let ((target (el-symbol-function session sym)))
        (when (and (el-function? target) (not (js-call (get session :macros) :has sym)))
          (put sym :_cachedFn target)
          (put sym :_cachedSession session))
        target)))

  (defun rt-call0 (session sym)
    (let ((fn (if (eq (get sym :_cachedSession) session) (get sym :_cachedFn) (rt-resolve-fn session sym))))
      (if (el-function? fn)
          (let ((c0 (get fn :elispCall0)))
            (if (not (undefined? c0))
                (el-normalize-result (funcall c0))
              (let ((direct (get fn :elispCall)))
                (el-normalize-result (if (undefined? direct) (funcall fn) (funcall direct (js-array)))))))
        (el-call session sym (js-array)))))

  (defun rt-call1 (session sym a0)
    (let ((fn (if (eq (get sym :_cachedSession) session) (get sym :_cachedFn) (rt-resolve-fn session sym))))
      (if (el-function? fn)
          (let ((c1 (get fn :elispCall1)))
            (if (not (undefined? c1))
                (el-normalize-result (funcall c1 a0))
              (let ((direct (get fn :elispCall)))
                (el-normalize-result (if (undefined? direct) (funcall fn a0) (funcall direct (js-array a0)))))))
        (el-call session sym (js-array a0)))))

  (defun rt-call2 (session sym a0 a1)
    (let ((fn (if (eq (get sym :_cachedSession) session) (get sym :_cachedFn) (rt-resolve-fn session sym))))
      (if (el-function? fn)
          (let ((c2 (get fn :elispCall2)))
            (if (not (undefined? c2))
                (el-normalize-result (funcall c2 a0 a1))
              (let ((direct (get fn :elispCall)))
                (el-normalize-result (if (undefined? direct) (funcall fn a0 a1) (funcall direct (js-array a0 a1)))))))
        (el-call session sym (js-array a0 a1)))))

  (defun rt-call3 (session sym a0 a1 a2)
    (let ((fn (if (eq (get sym :_cachedSession) session) (get sym :_cachedFn) (rt-resolve-fn session sym))))
      (if (el-function? fn)
          (let ((c3 (get fn :elispCall3)))
            (if (not (undefined? c3))
                (el-normalize-result (funcall c3 a0 a1 a2))
              (let ((direct (get fn :elispCall)))
                (el-normalize-result (if (undefined? direct) (funcall fn a0 a1 a2) (funcall direct (js-array a0 a1 a2)))))))
        (el-call session sym (js-array a0 a1 a2)))))

  (defun rt-callN (session sym args)
    (let ((fn (if (eq (get sym :_cachedSession) session) (get sym :_cachedFn) (rt-resolve-fn session sym))))
      (if (el-function? fn)
          (let ((direct (get fn :elispCall)))
            (if (undefined? direct)
                (el-normalize-result (Reflect/apply fn nil args))
              (el-normalize-result (funcall direct args))))
        (el-call session sym args))))

  (defun rt-call-fn (session fn args)
    (el-call session fn args))

  (defun rt-wrap-fn (name arglist impl)
    (let ((fn (lambda (&rest args) (funcall impl args))))
      (put fn :elispName name)
      (put fn :elispArglist arglist)
      (put fn :elispCall impl)
      (put fn :elispCall0 (lambda () (funcall impl (js-array))))
      (put fn :elispCall1 (lambda (a0) (funcall impl (js-array a0))))
      (put fn :elispCall2 (lambda (a0 a1) (funcall impl (js-array a0 a1))))
      (put fn :elispCall3 (lambda (a0 a1 a2) (funcall impl (js-array a0 a1 a2))))
      fn))

  (defun rt-defun (session sym arglist impl)
    (el-define-function session sym (rt-wrap-fn (el-symbol-name sym) arglist impl)))

  (defun rt-check-contract (cond-val name kind)
    (when (nil? cond-val)
      (el-signal "eliscript-runtime-contract-error" (str kind " failed in " name))))

  (defun rt-defvar (session sym)
    (el-add-special-var session sym)
    sym)

  (defun rt-defvar-init (session sym init-thunk)
    (el-add-special-var session sym)
    (unless (js-call (get session :values) :has sym)
      (js-call (get session :values) :set sym (funcall init-thunk)))
    sym)

  (defun rt-defvar-local (session sym init-thunk)
    (el-add-special-var session sym)
    (when (and (not (nil? init-thunk)) (not (js-call (get session :values) :has sym)))
      (js-call (get session :values) :set sym (funcall init-thunk)))
    (js-call (get session :localVars) :add sym)
    sym)

  (defun rt-defconst (session sym val)
    (el-add-special-var session sym)
    (js-call (get session :values) :set sym val)
    sym)

  (defun rt-defvar-keymap (session sym)
    (when (el-symobj? sym)
      (el-add-special-var session sym)
      (unless (js-call (get session :values) :has sym)
        (js-call (get session :values) :set sym (el-list (el-intern "keymap")))))
    sym)

  (defun rt-setq-local (session sym val)
    (let ((buf (el-current-buffer session)))
      (el-add-special-var session sym)
      (js-call (get buf :locals) :set sym val)
      val))

  (defun rt-setq-default (session sym val)
    (el-add-special-var session sym)
    (js-call (get session :values) :set sym val)
    val)

  (defun rt-bound-and-true-p (session sym)
    (if (js-call (get session :values) :has sym) (js-call (get session :values) :get sym) nil))

  (defun rt-defalias (session name definition)
    (if (and (el-cons? definition) (eq (get definition :car) s-macro))
        (el-set-macro session name
                      (let ((expander (get definition :cdr)))
                        (lambda (forms call-env) (el-call session expander (el-list-to-array forms)))))
      (el-set-fn session name definition))
    name)

  (defun rt-defmacro (session sym expander-fn)
    (el-set-macro session sym (lambda (forms call-env) (funcall expander-fn forms)))
    sym)

  (defun rt-make-gensym (session)
    (lambda (&optional prefix)
      (put session :gensymCounter (1+ (get session :gensymCounter)))
      (el-intern (str "__eli_hygienic_" (if (nullish? prefix) "g" prefix) "_" (get session :gensymCounter)))))

  (defun rt-catch (tag thunk)
    (try (funcall thunk)
      (catch error
        (if (and (not (nullish? error)) (get error :eliscriptThrow) (not (get error :clBlock)) (eq (get error :tag) tag))
            (get error :value)
          (throw error)))))

  (defun rt-return-from (tag value)
    (throw (js-object :eliscriptThrow t :clBlock t :tag tag :value value)))

  (defun rt-condition-case (session body-thunk success-fn handlers)
    (try
      (let ((value (funcall body-thunk)))
        (if (nil? success-fn) value (funcall success-fn value)))
      (catch raw
        (when (el-control-transfer? raw) (throw raw))
        (let* ((signal (el-error-from-host raw))
               (condition (get signal :conditionSymbol))
               (matched (js-call handlers :find
                                 (lambda (h)
                                   (js-call (get h :conds) :some
                                            (lambda (c) (and (/= c "debug")
                                                             (el-condition-matches session condition c))))))))
          (when (undefined? matched) (throw raw))
          (funcall (get matched :fn)
                   (el-cons (el-intern condition) (el-list-from (get signal :data))))))))

  (defun rt-ignore-errors (session thunk)
    (try (funcall thunk)
      (catch raw
        (when (el-control-transfer? raw) (throw raw))
        (let ((signal (el-error-from-host raw)))
          (if (el-condition-matches session (get signal :conditionSymbol) "error") nil (throw raw))))))

  (defun rt-ignore-error (session conds thunk)
    (try (funcall thunk)
      (catch raw
        (when (el-control-transfer? raw) (throw raw))
        (let ((signal (el-error-from-host raw)))
          (if (js-call conds :some (lambda (c) (el-condition-matches session (get signal :conditionSymbol) c)))
              nil
            (throw raw))))))

  (defun rt-save-match-data (session thunk)
    (let ((saved (get session :matchData)))
      (try (funcall thunk)
        (finally (put session :matchData saved)))))

  (defun rt-save-excursion (session thunk)
    (let* ((buffer (el-current-buffer session)) (point (get buffer :point)))
      (try (funcall thunk)
        (finally
          (put session :currentBuffer buffer)
          (put buffer :point (el-clamp-position buffer point))))))

  (defun rt-save-current-buffer (session thunk)
    (let ((buffer (el-current-buffer session)))
      (try (funcall thunk)
        (finally (when (get buffer :live) (put session :currentBuffer buffer))))))

  (defun rt-with-temp-buffer (session thunk)
    (let ((previous (get session :currentBuffer))
          (buffer (el-generate-new-buffer session " *temp*")))
      (put session :currentBuffer buffer)
      (try (funcall thunk)
        (finally
          (el-kill-buffer session buffer)
          (put session :currentBuffer previous)))))

  (defun rt-with-temp-file (session file thunk)
    (let ((previous (get session :currentBuffer))
          (buffer (el-generate-new-buffer session " *temp file*")))
      (put session :currentBuffer buffer)
      (try
        (let ((res (funcall thunk)))
          (el-call session (el-intern "write-region")
                   (js-array 1 (el-point-max buffer) file nil (el-intern "silent")))
          res)
        (finally
          (el-kill-buffer session buffer)
          (put session :currentBuffer previous)))))

  (defun rt-with-timeout (session seconds timeout-thunk body-thunk)
    (let* ((sec (el-num seconds))
           (deadline (+ (/ (js-call globalThis.Date :now) 1000) sec))
           (prev-deadline (get session :timeoutDeadline)))
      (put session :timeoutDeadline
           (if (and (not (nullish? prev-deadline)) (< prev-deadline deadline))
               prev-deadline
             deadline))
      (try (funcall body-thunk)
        (catch err
          (if (and (not (nullish? err)) (get err :eliscriptTimeout) (= (get err :deadline) deadline))
              (funcall timeout-thunk)
            (throw err)))
        (finally (put session :timeoutDeadline prev-deadline)))))

  (defun rt-with-current-buffer (session designator thunk)
    (let ((previous (get session :currentBuffer))
          (buffer (if (el-string? designator) (el-get-buffer-create session designator) designator)))
      (put session :currentBuffer buffer)
      (try (funcall thunk)
        (finally (put session :currentBuffer previous)))))

  (defun rt-with-output-to-string (session thunk)
    (let ((saved (get session :output)))
      (put session :output (js-array))
      (try (progn (funcall thunk)
                  (js-call (get session :output) :join ""))
        (finally (put session :output saved)))))

  ;; Generalized place helpers
  (defun rt-place-aref (inner index)
    (let ((array (funcall (get inner :get))))
      (js-object :get (lambda () (if (el-cons? array) (el-nth index array) (el-aref array index)))
                 :set (lambda (v)
                        (cond ((el-string? array)
                                (setq array (el-string-set array index v))
                                (funcall (get inner :set) array))
                              ((el-cons? array) (put (el-nthcdr index array) :car v))
                              (t (el-aset-container array index v)))
                        v))))

  (defun rt-place-alist-get (session key inner default remove testfn)
    (let ((test (el-test-function session testfn el-eq-test)))
      (js-object :get (lambda ()
                        (let ((cell (el-assoc-with key (funcall (get inner :get)) test)))
                          (if (nil? cell) default (get cell :cdr))))
                 :set (lambda (v)
                        (let* ((alist (funcall (get inner :get)))
                               (cell (el-assoc-with key alist test)))
                          (cond
                            ((and (not (nil? remove)) (el-equal-p v default 0))
                              (funcall (get inner :set)
                                       (el-list-from (js-call (el-list-to-array alist) :filter (lambda (c) (not (eq c cell)))))))
                            ((nil? cell) (funcall (get inner :set) (el-cons (el-cons key v) alist)))
                            (t (put cell :cdr v)))
                          v)))))

  (defun rt-place-plist-get (session inner prop testfn)
    (let ((test (el-test-function session testfn el-eq-test)))
      (js-object :get (lambda () (el-plist-get (funcall (get inner :get)) prop test))
                 :set (lambda (v)
                        (funcall (get inner :set) (el-plist-put (funcall (get inner :get)) prop v test))
                        v))))

  (defun rt-place-call (session head evaled-args)
    (let ((name (el-symbol-name head)))
      (cond
        ((js-call (get session :accessors) :has head)
          (let ((info (js-call (get session :accessors) :get head))
                (record (aref evaled-args 0)))
            (el-check-struct session record (get info :type))
            (js-object :get (lambda () (aref (get record :items) (get info :index)))
                       :set (lambda (v) (put (get record :items) (get info :index) v) v))))
        ((or (= name "car") (= name "cl-first"))
          (let ((cell (aref evaled-args 0)))
            (js-object :get (lambda () (el-car cell)) :set (lambda (v) (put cell :car v) v))))
        ((or (= name "cdr") (= name "cl-rest"))
          (let ((cell (aref evaled-args 0)))
            (js-object :get (lambda () (el-cdr cell)) :set (lambda (v) (put cell :cdr v) v))))
        ((js-call cadr-place-pattern :test name)
          (let* ((path (js-call name :slice 1 (1- (js-length name))))
                 (target (aref evaled-args 0))
                 (index (1- (js-length path))))
            (while (> index 0)
              (setq target (if (= (js-call path :charAt index) "a") (el-car target) (el-cdr target)))
              (setq index (1- index)))
            (if (= (js-call path :charAt 0) "a")
                (js-object :get (lambda () (el-car target)) :set (lambda (v) (put target :car v) v))
              (js-object :get (lambda () (el-cdr target)) :set (lambda (v) (put target :cdr v) v)))))
        ((or (= name "nth") (= name "cl-second") (= name "cl-third"))
          (let* ((n (cond ((= name "cl-second") 1) ((= name "cl-third") 2) (t (aref evaled-args 0))))
                 (list (aref evaled-args (if (= name "nth") 1 0)))
                 (cell (el-nthcdr n list)))
            (js-object :get (lambda () (el-car cell)) :set (lambda (v) (put cell :car v) v))))
        ((= name "nthcdr")
          (let* ((n (aref evaled-args 0)) (list (aref evaled-args 1)) (cell (el-nthcdr (1- n) list)))
            (js-object :get (lambda () (el-cdr cell)) :set (lambda (v) (put cell :cdr v) v))))
        ((= name "gethash")
          (let ((key (aref evaled-args 0))
                (table (aref evaled-args 1))
                (default (if (> (js-length evaled-args) 2) (aref evaled-args 2) nil)))
            (js-object :get (lambda () (el-gethash key table default))
                       :set (lambda (v) (el-puthash key v table)))))
        ((= name "get")
          (let ((symbol (aref evaled-args 0)) (prop (aref evaled-args 1)))
            (js-object :get (lambda () (el-get-prop session symbol prop))
                       :set (lambda (v) (el-put-prop session symbol prop v)))))
        ((= name "symbol-value")
          (let ((symbol (aref evaled-args 0)))
            (js-object :get (lambda () (el-global-value session symbol))
                       :set (lambda (v) (el-set-dynamic-variable session symbol v) v))))
        ((= name "default-value")
          (let ((symbol (aref evaled-args 0)))
            (js-object :get (lambda () (el-default-value session symbol))
                       :set (lambda (v) (js-call (get session :values) :set symbol v) v))))
        ((= name "symbol-function")
          (let ((symbol (aref evaled-args 0)))
            (js-object :get (lambda () (el-symbol-function session symbol))
                       :set (lambda (v) (el-set-fn session symbol v) v))))
        ((= name "getenv")
          (let ((env-name (aref evaled-args 0)))
            (js-object :get (lambda () (el-call session (el-intern "getenv") (js-array env-name)))
                       :set (lambda (v) (el-call session (el-intern "setenv") (js-array env-name v)) v))))
        ((= name "buffer-string")
          (js-object :get (lambda () (get (el-current-buffer session) :text))
                     :set (lambda (v)
                            (let ((b (el-current-buffer session)))
                              (put b :text v)
                              (put b :point 1)
                              v))))
        ((= name "cl-struct-slot-value")
          (let* ((stype (el-symbol-name (aref evaled-args 0)))
                 (sname (el-symbol-name (aref evaled-args 1)))
                 (record (aref evaled-args 2))
                 (info (js-call (get session :structs) :get stype))
                 (slots (if (undefined? info) (js-array) (get info :slots)))
                 (idx (js-call slots :findIndex (lambda (s) (= (el-symbol-name (get s :name)) sname)))))
            (el-check-struct session record stype)
            (when (< idx 0) (el-signal "error" (str "Unknown slot " sname)))
            (js-object :get (lambda () (aref (get record :items) (1+ idx)))
                       :set (lambda (v) (put (get record :items) (1+ idx) v) v))))
        ((js-call (get session :gvSetters) :has head)
          (let ((info (js-call (get session :gvSetters) :get head)))
            (if (= (get info :kind) "simple")
                (js-object :get (lambda () (el-call session head evaled-args))
                           :set (lambda (v) (el-call session (get info :setter) (js-call evaled-args :concat (js-array v))) v))
              (js-object :get (lambda () (el-call session head evaled-args))
                         :set (lambda (v)
                                (let ((arg-forms (el-list-from (js-call evaled-args :map (lambda (a) (el-list s-quote a))))))
                                  (let ((expanded (funcall (get info :fn) (el-cons (el-list s-quote v) arg-forms) (el-root-env))))
                                    (el-eval session expanded (el-root-env)))))))))
        (t (el-signal "error" (str "Unknown place form: " name))))))

  (defun rt-pushnew (session item place testfn)
    (let ((test (if (nil? testfn) el-eql-test (el-test-function session testfn el-eql-test)))
          (list (funcall (get place :get))))
      (if (nil? (el-member-with item list test))
          (let ((value (el-cons item list))) (funcall (get place :set) value) value)
        list)))

  (defun rt-remf (place tag)
    (let* ((plist (funcall (get place :get)))
           (items (el-list-to-array plist))
           (out (js-array))
           (removed false)
           (i 0))
      (while (< i (js-length items))
        (if (and (not removed) (el-eq-test (aref items i) tag))
            (setq removed t)
          (progn
            (js-call out :push (aref items i))
            (when (< (1+ i) (js-length items))
              (js-call out :push (aref items (1+ i))))))
        (setq i (+ i 2)))
      (when removed (funcall (get place :set) (el-list-from out)))
      (el-bool removed)))

  (defun rt-aset-sym (array index value setter)
    (if (el-string? array)
        (funcall setter (el-string-set array index value))
      (el-aset-container array index value))
    value)

  (defun rt-aset-val (array index value)
    (if (el-string? array)
        (el-signal "error" "aset on an immutable string value")
      (el-aset-container array index value))
    value)

  (defun rt-callf (session callable place extra)
    (let ((value (el-call session callable (js-call (js-array (funcall (get place :get))) :concat extra))))
      (funcall (get place :set) value)
      value))

  ;; Destructuring runtime helper using compiled setter + compiled default thunks
  (defun rt-destructure (session pattern value setter dynamic)
    (cond
      ((nil? pattern) nil)
      ((el-symobj? pattern) (funcall setter pattern value dynamic))
      ((el-vector? pattern)
        (let ((items (get pattern :items)) (index 0))
          (while (< index (js-length items))
            (rt-destructure session (aref items index) (el-aref value index) setter dynamic)
            (setq index (1+ index)))))
      (t
        (let ((cursor pattern) (rest-value value) (mode "required"))
          (while (el-cons? cursor)
            (let ((item (get cursor :car)))
              (cond
                ((eq item s-optional) (setq mode "optional"))
                ((or (eq item s-rest) (eq item s-body)) (setq mode "rest"))
                ((eq item s-key) (setq mode "key"))
                ((eq item s-aux) (setq mode "aux"))
                ((eq item s-allow-other-keys) nil)
                ((= mode "required")
                  (rt-destructure session item (el-car-safe rest-value) setter dynamic)
                  (setq rest-value (el-cdr-safe rest-value)))
                ((= mode "optional")
                  (let* ((var (if (el-cons? item) (get item :car) item))
                         (def-thunk (if (el-cons? item) (el-nth 1 item) nil))
                         (svar (if (el-cons? item) (el-nth 2 item) nil))
                         (present (el-cons? rest-value)))
                    (rt-destructure session var
                                    (if present (get rest-value :car) (if (el-function? def-thunk) (funcall def-thunk) nil))
                                    setter dynamic)
                    (unless (nil? svar) (funcall setter svar (el-bool present) dynamic))
                    (setq rest-value (el-cdr-safe rest-value))))
                ((= mode "rest") (rt-destructure session item rest-value setter dynamic))
                ((= mode "key")
                  (let* ((spec (if (el-cons? item) (get item :car) item))
                         (var (if (el-cons? spec) (el-nth 1 spec) spec))
                         (keyword (if (el-cons? spec) (get spec :car) (el-intern (str ":" (el-symbol-name var)))))
                         (def-thunk (if (el-cons? item) (el-nth 1 item) nil))
                         (svar (if (el-cons? item) (el-nth 2 item) nil))
                         (cell (el-plist-member rest-value keyword el-eq-test)))
                    (rt-destructure session var
                                    (if (nil? cell)
                                        (if (el-function? def-thunk) (funcall def-thunk) nil)
                                      (el-car-safe (get cell :cdr)))
                                    setter dynamic)
                    (unless (nil? svar) (funcall setter svar (el-bool (not (nil? cell))) dynamic))))
                ((= mode "aux")
                  (let ((var (if (el-cons? item) (get item :car) item))
                        (init-thunk (if (el-cons? item) (el-nth 1 item) nil)))
                    (funcall setter var (if (el-function? init-thunk) (funcall init-thunk) nil) dynamic)))))
            (setq cursor (get cursor :cdr)))
          (when (and (not (nil? cursor)) (el-symobj? cursor))
            (funcall setter cursor rest-value dynamic))))))

  ;; 1+5+2 bind-pattern runtime helper using compiled setter + compiled default thunks
  (defun rt-match-binding (session pattern value setter dynamic)
    (cond
      ((eq pattern s-underscore) nil)
      ((el-sym-is pattern ":none") (unless (eq value OPTION_NONE) (el-signal "error" "Destructuring expected option-none")))
      ((el-symobj? pattern) (funcall setter pattern value dynamic))
      ((el-vector? pattern)
        (unless (or (el-vector? value) (= (el-kind value) "persistent-vector"))
          (el-signal "error" "Destructuring vector pattern requires a vector or persistent-vector"))
        (let* ((items (get pattern :items)) (values (get value :items))
               (rest-index (js-call items :findIndex (lambda (x) (eq x s-rest)))))
          (if (>= rest-index 0)
              (progn
                (when (< (js-length values) rest-index) (el-signal "error" "Destructuring vector length mismatch"))
                (let ((i 0)) (while (< i rest-index) (rt-match-binding session (aref items i) (aref values i) setter dynamic) (setq i (1+ i))))
                (rt-match-binding session (aref items (1+ rest-index))
                                  (if (= (el-kind value) "persistent-vector")
                                      (el-make-pcoll "persistent-vector" (js-call values :slice rest-index))
                                    (el-vector (js-call values :slice rest-index)))
                                  setter dynamic))
            (progn
              (unless (= (js-length values) (js-length items)) (el-signal "error" "Destructuring vector length mismatch"))
              (let ((i 0)) (while (< i (js-length items)) (rt-match-binding session (aref items i) (aref values i) setter dynamic) (setq i (1+ i))))))))
      ((el-cons? pattern)
        (let* ((items (el-list-to-array pattern)) (head (el-symbol-name (aref items 0))))
          (cond
            ((= head ":list")
              (unless (or (nil? value) (el-cons? value) (= (el-kind value) "persistent-list"))
                (el-signal "error" "Destructuring :list requires list or persistent-list"))
              (let* ((elements (if (= (el-kind value) "persistent-list") (get value :items) (el-list-to-array value)))
                     (subs (js-call items :slice 1))
                     (rest-index (js-call subs :findIndex (lambda (x) (eq x s-rest)))))
                (if (>= rest-index 0)
                    (progn
                      (when (< (js-length elements) rest-index) (el-signal "error" "Destructuring :list length mismatch"))
                      (let ((i 0)) (while (< i rest-index) (rt-match-binding session (aref subs i) (aref elements i) setter dynamic) (setq i (1+ i))))
                      (rt-match-binding session (aref subs (1+ rest-index))
                                        (if (= (el-kind value) "persistent-list")
                                            (el-make-pcoll "persistent-list" (js-call elements :slice rest-index))
                                          (el-list-from (js-call elements :slice rest-index)))
                                        setter dynamic))
                  (progn
                    (unless (= (js-length elements) (js-length subs)) (el-signal "error" "Destructuring :list length mismatch"))
                    (let ((i 0)) (while (< i (js-length subs)) (rt-match-binding session (aref subs i) (aref elements i) setter dynamic) (setq i (1+ i))))))))
            ((= head ":map")
              (js-call (js-call items :slice 1) :forEach
                       (lambda (entry)
                         (let ((key (el-car entry)) (sub (el-nth 1 entry)))
                           (if (and (el-cons? sub) (eq (get sub :car) s-default))
                               (let ((def-thunk (el-nth 2 sub)))
                                 (rt-match-binding session (el-nth 1 sub)
                                                   (if (el-value-contains value key)
                                                       (el-value-get value key nil)
                                                     (if (el-function? def-thunk) (funcall def-thunk) nil))
                                                   setter dynamic))
                             (progn
                               (unless (el-value-contains value key)
                                 (el-signal "error" (str "Destructuring :map missing required key " (el-symbol-name key))))
                               (rt-match-binding session sub (el-value-get value key nil) setter dynamic)))))))
            ((= head ":record")
              (let ((type-name (el-symbol-name (aref items 1))))
                (unless (and (= (el-kind value) "persistent-record") (= (get value :typeName) type-name))
                  (el-signal "error" (str "Destructuring :record expected " type-name)))
                (js-call (js-call items :slice 2) :forEach
                         (lambda (entry) (rt-match-binding session (el-nth 1 entry) (el-value-get value (el-car entry) nil) setter dynamic)))))
            ((= head ":ok")
              (unless (and (= (el-kind value) "result") (get value :ok)) (el-signal "error" "Destructuring :ok mismatch"))
              (rt-match-binding session (aref items 1) (get value :value) setter dynamic))
            ((= head ":error")
              (unless (and (= (el-kind value) "result") (not (get value :ok))) (el-signal "error" "Destructuring :error mismatch"))
              (rt-match-binding session (aref items 1) (get value :value) setter dynamic))
            ((= head ":some")
              (unless (and (= (el-kind value) "option") (get value :some)) (el-signal "error" "Destructuring :some mismatch"))
              (rt-match-binding session (aref items 1) (get value :value) setter dynamic))
            (t (unless (el-value-equal pattern value) (el-signal "error" "Destructuring literal mismatch"))))))
      (t (unless (el-value-equal pattern value) (el-signal "error" "Destructuring literal mismatch")))))

  ;; pcase runtime matcher using compiled thunks and setter
  (defun rt-pcase-match (session pattern value setter)
    (cond
      ((eq pattern s-underscore) t)
      ((or (nil? pattern) (eq pattern t)) (el-equal-p pattern value 0))
      ((el-keyword? pattern) (eq pattern value))
      ((el-symobj? pattern) (funcall setter pattern value) t)
      ((not (el-cons? pattern)) (el-equal-p pattern value 0))
      (t
        (let ((head (get pattern :car)))
          (if (eq head s-quote)
              (let ((qval (el-car (get pattern :cdr))))
                (if (or (el-symobj? qval) (el-keyword? qval))
                    (eq qval value)
                  (el-equal-p qval value 0)))
            (let ((args (el-args pattern)))
              (cond
                ((eq head s-backquote) (rt-pcase-qpat session (aref args 0) value setter))
                ((eq head s-pred) (not (nil? (funcall (aref args 0) value))))
                ((eq head s-guard) (not (nil? (funcall (aref args 0)))))
                ((eq head s-app) (rt-pcase-match session (aref args 1) (funcall (aref args 0) value) setter))
                ((eq head s-and) (js-call args :every (lambda (p) (rt-pcase-match session p value setter))))
                ((eq head s-or) (js-call args :some (lambda (p) (rt-pcase-match session p value setter))))
                ((eq head s-let) (rt-pcase-match session (aref args 0) (funcall (aref args 1)) setter))
                ((el-sym-is head "cl-type") (not (nil? (el-cl-typep session value (aref args 0)))))
                ((el-sym-is head "rx")
                  (not (nil? (el-string-match session (aref args 0) value 0 false))))
                (t (el-signal "error" (str "Unknown pcase pattern " (el-prin1-string pattern t)))))))))))

  (defun rt-pcase-qpat (session qpat value setter)
    (cond
      ((and (el-cons? qpat) (eq (get qpat :car) s-comma))
        (rt-pcase-match session (el-car (get qpat :cdr)) value setter))
      ((el-cons? qpat)
        (and (el-cons? value)
             (rt-pcase-qpat session (get qpat :car) (get value :car) setter)
             (rt-pcase-qpat session (get qpat :cdr) (get value :cdr) setter)))
      ((el-vector? qpat)
        (and (el-vector? value)
             (= (js-length (get qpat :items)) (js-length (get value :items)))
             (js-call (get qpat :items) :every
                      (lambda (q index) (rt-pcase-qpat session q (aref (get value :items) index) setter)))))
      (t (el-equal-p qpat value 0))))

  ;; cl-loop runtime executor over compiled thunks and variable getter/setter
  (defun rt-loop-bind (pattern value setter)
    (cond
      ((nil? pattern) nil)
      ((el-symobj? pattern) (funcall setter pattern value))
      ((el-cons? pattern)
        (rt-loop-bind (get pattern :car) (el-car-safe value) setter)
        (rt-loop-bind (get pattern :cdr) (el-cdr-safe value) setter))
      ((el-vector? pattern)
        (js-call (get pattern :items) :forEach
                 (lambda (p index) (rt-loop-bind p (if (nil? value) nil (el-aref value index)) setter))))))

  (defun rt-loop-init (session driver)
    (let ((kind (get driver :kind)))
      (cond
        ((or (= kind "in") (= kind "on") (= kind "in-ref")) (put driver :rest (funcall (get driver :expr))))
        ((= kind "across") (put driver :items (el-seq-items (funcall (get driver :expr)))) (put driver :index 0))
        ((= kind "elements") (put driver :items (el-seq-items (funcall (get driver :expr)))) (put driver :index 0))
        ((or (= kind "hash-keys") (= kind "hash-values"))
          (put driver :items (js-call globalThis.Array :from (js-call (get (funcall (get driver :expr)) :entries) :values)))
          (put driver :index 0))
        ((= kind "number")
          (put driver :current (if (nil? (get driver :fromExpr)) 0 (el-num (funcall (get driver :fromExpr)))))
          (put driver :limit (if (nil? (get driver :toExpr)) nil (el-num (funcall (get driver :toExpr)))))
          (put driver :step (if (nil? (get driver :stepExpr)) 1 (el-num (funcall (get driver :stepExpr))))))
        ((= kind "repeat") (put driver :remaining (el-num (funcall (get driver :expr)))))
        (t nil))))

  (defun rt-loop-step (session driver setter first)
    (let ((kind (get driver :kind)))
      (cond
        ((or (= kind "in") (= kind "on") (= kind "in-ref"))
          (unless first
            (put driver :rest (if (nil? (get driver :by)) (el-cdr-safe (get driver :rest))
                                (el-call session (funcall (get driver :by)) (js-array (get driver :rest))))))
          (if (not (el-cons? (get driver :rest))) false
            (progn (rt-loop-bind (get driver :var) (if (= kind "on") (get driver :rest) (get (get driver :rest) :car)) setter)
                   t)))
        ((or (= kind "across") (= kind "elements") (= kind "hash-keys") (= kind "hash-values"))
          (unless first (put driver :index (1+ (get driver :index))))
          (if (>= (get driver :index) (js-length (get driver :items))) false
            (let ((item (aref (get driver :items) (get driver :index))))
              (cond
                ((= kind "hash-keys")
                  (rt-loop-bind (get driver :var) (aref item 0) setter)
                  (unless (nil? (get driver :using)) (rt-loop-bind (get driver :using) (aref item 1) setter)))
                ((= kind "hash-values")
                  (rt-loop-bind (get driver :var) (aref item 1) setter)
                  (unless (nil? (get driver :using)) (rt-loop-bind (get driver :using) (aref item 0) setter)))
                (t (rt-loop-bind (get driver :var) item setter)))
              t)))
        ((= kind "number")
          (unless first (put driver :current (if (get driver :down) (- (get driver :current) (get driver :step))
                                               (+ (get driver :current) (get driver :step)))))
          (let ((current (get driver :current)) (limit (get driver :limit)))
            (if (and (not (nil? limit))
                     (if (get driver :down)
                         (if (get driver :inclusive) (< current limit) (<= current limit))
                       (if (get driver :inclusive) (> current limit) (>= current limit))))
                false
              (progn (rt-loop-bind (get driver :var) current setter) t))))
        ((= kind "=")
          (rt-loop-bind (get driver :var)
                        (funcall (if (or first (nil? (get driver :then))) (get driver :expr) (get driver :then)))
                        setter)
          t)
        ((= kind "repeat")
          (if (<= (get driver :remaining) 0) false
            (progn (put driver :remaining (1- (get driver :remaining))) t)))
        (t t))))

  (defun rt-loop-accumulate (clause getter setter state)
    (let* ((word (get clause :word))
           (value (funcall (get clause :expr)))
           (into (get clause :into)))
      (if (not (nil? into))
          (let ((current (funcall getter into)))
            (funcall setter into
                     (cond
                       ((= word "collect") (el-append (js-array current (el-list value))))
                       ((or (= word "append") (= word "nconc")) (el-append (js-array current value)))
                       ((= word "sum") (el-arith "+" (js-array current value)))
                       ((= word "count") (if (nil? value) current (1+ current)))
                       ((= word "maximize") (if (or (nil? current) (> (el-num value) (el-num current))) value current))
                       ((= word "minimize") (if (or (nil? current) (< (el-num value) (el-num current))) value current))
                       ((= word "concat") (str current value))
                       ((= word "vconcat") (el-vector (js-call (el-seq-items current) :concat (el-seq-items value))))
                       (t current))))
        (progn
          (unless (get state :accSet)
            (put state :accSet t)
            (put state :accKind word)
            (put state :acc (cond ((or (= word "collect") (= word "append") (= word "nconc")) (js-array))
                                  ((or (= word "sum") (= word "count")) 0)
                                  ((= word "concat") "")
                                  ((= word "vconcat") (el-vector (js-array)))
                                  (t nil))))
          (let ((acc (get state :acc)))
            (put state :acc
                 (cond
                   ((= word "collect") (js-call acc :push value) acc)
                   ((or (= word "append") (= word "nconc"))
                     (js-call (el-seq-items value) :forEach (lambda (x) (js-call acc :push x))) acc)
                   ((= word "sum") (el-arith "+" (js-array acc value)))
                   ((= word "count") (if (nil? value) acc (1+ acc)))
                   ((= word "maximize") (if (or (nil? acc) (> (el-num value) (el-num acc))) value acc))
                   ((= word "minimize") (if (or (nil? acc) (< (el-num value) (el-num acc))) value acc))
                   ((= word "concat") (str acc value))
                   ((= word "vconcat") (el-vector (js-call (get acc :items) :concat (el-seq-items value))))
                   (t acc))))))))

  (defun rt-loop-run-clauses (clauses getter setter state)
    (let ((outcome "continue") (index 0))
      (while (and (= outcome "continue") (< index (js-length clauses)))
        (let* ((clause (aref clauses index)) (type (get clause :type)))
          (cond
            ((= type "acc") (rt-loop-accumulate clause getter setter state))
            ((= type "do") (funcall (get clause :thunk)))
            ((= type "cond")
              (let ((test (funcall (get clause :test))))
                (setq outcome
                      (rt-loop-run-clauses (if (if (get clause :negate) (nil? test) (not (nil? test)))
                                               (get clause :then) (get clause :else))
                                           getter setter state))))
            ((= type "return") (put state :result (funcall (get clause :expr))) (setq outcome "return"))
            ((= type "while") (when (nil? (funcall (get clause :expr))) (setq outcome "stop")))
            ((= type "until") (unless (nil? (funcall (get clause :expr))) (setq outcome "stop")))
            ((= type "always")
              (if (nil? (funcall (get clause :expr)))
                  (progn (put state :result nil) (setq outcome "return"))
                (when (undefined? (get state :result)) (put state :alwaysT t))))
            ((= type "never")
              (if (not (nil? (funcall (get clause :expr))))
                  (progn (put state :result nil) (setq outcome "return"))
                (put state :alwaysT t)))
            ((= type "thereis")
              (let ((value (funcall (get clause :expr))))
                (unless (nil? value) (put state :result value) (setq outcome "return"))))))
        (setq index (1+ index)))
      (when (and (not (= outcome "return")) (get state :alwaysT) (undefined? (get state :result)))
        (put state :pendingT t))
      outcome))

  (defun rt-run-cl-loop (session spec getter setter)
    (let ((state (js-object :acc (get spec :initAcc) :accKind (get spec :accKind) :accSet (get spec :accSet)
                            :result undefined :name (get spec :name) :returned false :alwaysT false :pendingT false))
          (drivers (get spec :drivers))
          (body (get spec :body)))
      (el-catch-block session (get spec :name)
        (lambda ()
          (js-call (get spec :withInits) :forEach
                   (lambda (w) (rt-loop-bind (aref w 0) (if (nil? (aref w 1)) nil (funcall (aref w 1))) setter)))
          (js-call (get spec :intoInits) :forEach
                   (lambda (pair) (funcall setter (aref pair 0) (aref pair 1))))
          (funcall (get spec :initially))
          (js-call drivers :forEach (lambda (d) (rt-loop-init session d)))
          (let ((running t) (first t))
            (while running
              (let ((index 0))
                (while (and running (< index (js-length drivers)))
                  (unless (rt-loop-step session (aref drivers index) setter first) (setq running false))
                  (setq index (1+ index))))
              (setq first false)
              (when running
                (let ((outcome (rt-loop-run-clauses body getter setter state)))
                  (cond
                    ((= outcome "stop") (setq running false))
                    ((= outcome "return") (setq running false) (put state :returned t))))))
            (if (get state :returned)
                (get state :result)
              (progn
                (funcall (get spec :finally))
                (cond
                  ((not (nil? (get spec :finallyReturn))) (funcall (get spec :finallyReturn)))
                  ((not (undefined? (get state :result))) (get state :result))
                  ((get state :accSet) (el-loop-final (get state :accKind) (get state :acc)))
                  ((or (get spec :hasAlwaysNever) (get state :pendingT)) t)
                  (t nil)))))))))

  ;; Struct, ERT, Mode, GV, and Extension runtime helpers
  (defun rt-defstruct (session spec)
    (let* ((name (get spec :name))
           (parent (get spec :parent))
           (conc-name (get spec :concName))
           (copier (get spec :copier))
           (predicate (get spec :predicate))
           (kw-ctors (get spec :kwCtors))
           (boa-ctors (get spec :boaCtors))
           (own (get spec :ownSlots))
           (inherited (if (nil? parent) (js-array)
                        (let ((info (js-call (get session :structs) :get parent)))
                          (when (undefined? info) (el-signal "error" (str "Unknown struct " parent)))
                          (get info :slots))))
           (slots (js-call inherited :concat own))
           (type-symbol (el-intern name)))
      (js-call (get session :structs) :set name (js-object :parent parent :slots slots))
      (js-call kw-ctors :forEach
               (lambda (ctor)
                 (el-define-function session (el-intern ctor)
                   (lambda (&rest args)
                     (let ((items (js-array type-symbol)) (plist (el-list-from args)))
                       (js-call slots :forEach
                                (lambda (slot)
                                  (let* ((keyword (el-intern (str ":" (el-symbol-name (get slot :name)))))
                                         (cell (el-plist-member plist keyword el-eq-test))
                                         (init-fn (get slot :initFn))
                                         (value (if (nil? cell)
                                                    (if (el-function? init-fn) (funcall init-fn) nil)
                                                  (el-car-safe (get cell :cdr)))))
                                    (js-call items :push value))))
                       (js-object :kind "record" :items items))))))
      (js-call boa-ctors :forEach
               (lambda (entry)
                 (el-define-function session (aref entry 0) (aref entry 1))))
      (unless (nil? predicate)
        (el-define-function session (el-intern predicate)
          (lambda (x)
            (el-bool (or (and (not (nil? x)) (= (get x :kind) "record") (eq (aref (get x :items) 0) type-symbol))
                         (el-struct-instance? session x name))))))
      (unless (nil? copier)
        (el-define-function session (el-intern copier)
          (lambda (x) (el-check-struct session x name) (el-copy-sequence x))))
      (let ((index 1))
        (js-call slots :forEach
                 (lambda (slot)
                   (let* ((position index)
                          (accessor (el-intern (str conc-name (el-symbol-name (get slot :name))))))
                     (js-call (get session :accessors) :set accessor (js-object :type name :index position))
                     (el-define-function session accessor
                       (lambda (record)
                         (unless (or (and (not (nil? record)) (= (get record :kind) "record") (eq (aref (get record :items) 0) type-symbol))
                                     (el-struct-instance? session record name))
                           (el-signal "wrong-type-argument" type-symbol record))
                         (aref (get record :items) position)))
                     (setq index (1+ index))))))
      type-symbol))

  (defun rt-ert-deftest (session name tags expected body-fn)
    (let ((test-obj (js-object :kind "ert-test" :name name :tags tags :expectedResult expected
                               :mostRecentResult nil :bodyFn body-fn)))
      (js-call (get session :ertTests) :set name test-obj)
      (js-call (get session :ertTestOrder) :push name)
      name))

  (defun rt-should (val expr-datum)
    (when (nil? val)
      (throw (el-make-signal "ert-test-failed" (js-array (el-list (el-intern "should") expr-datum)))))
    val)

  (defun rt-should-not (val expr-datum)
    (unless (nil? val)
      (throw (el-make-signal "ert-test-failed" (js-array (el-list (el-intern "should-not") expr-datum) (el-intern ":value") val))))
    nil)

  (defun rt-should-error (session thunk expected-type expr-datum)
    (let ((caught nil))
      (try (funcall thunk)
        (catch raw
          (when (el-control-transfer? raw) (throw raw))
          (setq caught (el-error-from-host raw))))
      (when (nil? caught)
        (throw (el-make-signal "ert-test-failed" (js-array (el-list (el-intern "should-error") expr-datum)))))
      (unless (el-condition-matches session (get caught :conditionSymbol) expected-type)
        (throw (el-make-signal "ert-test-failed"
                               (js-array (el-list (el-intern "should-error") expr-datum)
                                         (el-intern ":condition")
                                         (el-cons (el-intern (get caught :conditionSymbol))
                                                  (el-list-from (get caught :data)))))))
      (el-cons (el-intern (get caught :conditionSymbol)) (el-list-from (get caught :data)))))

  (defun rt-define-derived-mode (session mode)
    (let* ((mode-name (el-symbol-name mode))
           (map-sym (el-intern (str mode-name "-map")))
           (hook-sym (el-intern (str mode-name "-hook")))
           (syntax-sym (el-intern (str mode-name "-syntax-table")))
           (abbrev-sym (el-intern (str mode-name "-abbrev-table"))))
      (el-add-special-var session map-sym)
      (unless (js-call (get session :values) :has map-sym)
        (js-call (get session :values) :set map-sym (el-list (el-intern "keymap"))))
      (el-add-special-var session hook-sym)
      (unless (js-call (get session :values) :has hook-sym)
        (js-call (get session :values) :set hook-sym nil))
      (el-add-special-var session syntax-sym)
      (unless (js-call (get session :values) :has syntax-sym)
        (js-call (get session :values) :set syntax-sym nil))
      (el-add-special-var session abbrev-sym)
      (unless (js-call (get session :values) :has abbrev-sym)
        (js-call (get session :values) :set abbrev-sym nil))
      (el-define-function session mode (lambda (&rest ignored) mode))
      mode))

  (defun rt-define-minor-mode (session mode)
    (let* ((mode-name (el-symbol-name mode))
           (map-sym (el-intern (str mode-name "-map")))
           (hook-sym (el-intern (str mode-name "-hook"))))
      (el-add-special-var session mode)
      (unless (js-call (get session :values) :has mode)
        (js-call (get session :values) :set mode nil))
      (el-add-special-var session map-sym)
      (unless (js-call (get session :values) :has map-sym)
        (js-call (get session :values) :set map-sym (el-list (el-intern "keymap"))))
      (el-add-special-var session hook-sym)
      (unless (js-call (get session :values) :has hook-sym)
        (js-call (get session :values) :set hook-sym nil))
      (el-define-function session mode
        (lambda (&optional arg)
          (let ((next (if (or (nullish? arg) (eq arg (el-intern "toggle")))
                          (el-bool (nil? (js-call (get session :values) :get mode)))
                        (el-bool (or (not (el-number? arg)) (> (el-num arg) 0))))))
            (js-call (get session :values) :set mode next)
            next)))
      mode))

  (defun rt-gv-define-simple-setter (session name setter)
    (js-call (get session :gvSetters) :set name (js-object :kind "simple" :setter setter))
    name)

  (defun rt-gv-define-setter (session name expander-fn)
    (js-call (get session :gvSetters) :set name
             (js-object :kind "expander" :fn (lambda (forms call-env) (funcall expander-fn forms))))
    name)

  (defun rt-make-case-fn (name fixed rest-clause)
    (rt-wrap-fn name nil
      (lambda (args)
        (let ((arity (js-length args)))
          (cond
            ((js-call fixed :has arity)
              (funcall (js-call fixed :get arity) args))
            ((and (not (nil? rest-clause)) (>= arity (get rest-clause :min)))
              (funcall (get rest-clause :fn) args))
            (t (el-signal "wrong-number-of-arguments" (el-intern name) arity)))))))

  (defun rt-make-async-fn (session name arglist inner-fn)
    (rt-wrap-fn name arglist
      (lambda (args)
        (let ((previous (get session :inAsyncContext)))
          (put session :inAsyncContext t)
          (try
            (let ((value (funcall inner-fn args)))
              (if (= (el-kind value) "future") value (el-future "fulfilled" (el-normalize-result value) nil)))
            (catch error
              (when (el-control-transfer? error) (throw error))
              (el-future "rejected" nil error))
            (finally (put session :inAsyncContext previous)))))))

  (defun rt-with-async-scope (session body-fn)
    (let ((scope (js-object :kind "async-scope" :handles (js-array))))
      (try (funcall body-fn scope)
        (finally
          (js-call (get scope :handles) :forEach
                   (lambda (handle)
                     (let ((revoke (el-symbol-function session (el-intern "engine-revoke!"))))
                       (unless (nil? revoke) (funcall revoke handle)))))))))

  (defun rt-with-abi-memory (session pages thunk)
    (let ((previous (get session :abiMemory)))
      (put session :abiMemory (new globalThis.ArrayBuffer (* pages 65536)))
      (try (funcall thunk)
        (finally (put session :abiMemory previous)))))

  (defun rt-with-transient (source body-fn)
    (let ((builder (js-object :kind "transient" :active t :items (js-call (or (get source :items) (js-array)) :slice))))
      (try (progn (funcall body-fn builder)
                  (put builder :active false)
                  (el-make-pcoll "persistent-vector" (get builder :items)))
        (finally (put builder :active false)))))

  (defun rt-delay (thunk)
    (js-object :kind "delay" :realized false :value nil :thunk thunk))

  (defun rt-defstruct-persistent (session sym fields)
    (let ((name (el-symbol-name sym)))
      (js-call (get session :structSchemas) :set name (js-object :name name :fields fields))
      (el-def session (str "make-" name)
              (lambda (&rest kvs)
                (let ((given (new globalThis.Map)) (i 0) (entries (js-array)))
                  (while (< i (js-length kvs))
                    (js-call given :set (el-record-field-name (aref kvs i)) (aref kvs (1+ i)))
                    (setq i (+ i 2)))
                  (js-call fields :forEach
                           (lambda (field)
                             (let ((value (if (js-call given :has (get field :name))
                                              (js-call given :get (get field :name))
                                            (if (get field :hasDefault) (funcall (get field :defaultThunk)) nil))))
                               (el-validate-struct-field name field value)
                               (js-call entries :push (js-array (get field :name) value)))))
                  (js-object :kind "persistent-record" :typeName name :entries entries :meta nil))))
      (el-def session (str name "-p")
              (lambda (x) (el-bool (and (= (el-kind x) "persistent-record") (= (get x :typeName) name)))))
      (el-def session (str name "-with")
              (lambda (instance &rest kvs)
                (let ((merged (js-array)))
                  (js-call (get instance :entries) :forEach
                           (lambda (e)
                             (js-call merged :push (el-intern (str ":" (aref e 0))))
                             (js-call merged :push (aref e 1))))
                  (el-call session (el-intern (str "make-" name)) (js-call merged :concat kvs)))))
      (js-call fields :forEach
               (lambda (field)
                 (el-def session (str name "-" (get field :name))
                         (lambda (instance) (el-value-get instance (el-intern (str ":" (get field :name))) nil)))))
      sym))

  (defun rt-defprotocol (session sym methods)
    (let ((name (el-symbol-name sym)) (table (new globalThis.Map)))
      (js-call (get session :protocols) :set name table)
      (js-call methods :forEach
               (lambda (method)
                 (el-def session method
                         (lambda (target &rest rest)
                           (let* ((tag (el-dispatch-tag target))
                                  (impls (js-call table :get tag))
                                  (impl (if (undefined? impls) undefined (js-call impls :get method))))
                             (when (undefined? impl) (el-signal "error" (str "No protocol impl " name "." method " for " tag)))
                             (Reflect/apply impl nil (js-call (js-array target) :concat rest)))))))
      sym))

  (defun rt-extend-protocol (session proto-sym type-sym impls)
    (let* ((name (el-symbol-name proto-sym))
           (type (el-symbol-name type-sym))
           (table (js-call (get session :protocols) :get name)))
      (when (undefined? table) (el-signal "error" (str "Unknown protocol " name)))
      (unless (js-call table :has type) (js-call table :set type (new globalThis.Map)))
      (js-call impls :forEach
               (lambda (pair)
                 (js-call (js-call table :get type) :set (aref pair 0) (aref pair 1))))
      proto-sym))

  (defun rt-defgeneric-value (session sym dispatcher)
    (let ((methods (new globalThis.Map)))
      (js-call (get session :multimethods) :set (el-symbol-name sym) methods)
      (el-define-function session sym
        (lambda (&rest args)
          (let* ((key (el-call session dispatcher args))
                 (method (js-call methods :get key)))
            (when (undefined? method)
              (el-signal "error" (str "No multimethod " (el-symbol-name sym) " for " (el-prin1-string key t))))
            (el-call session method args))))))

  (defun rt-defmethod-value (session sym key method-fn)
    (let ((methods (js-call (get session :multimethods) :get (el-symbol-name sym))))
      (js-call methods :set key method-fn)
      sym))

  (defun rt-register-module (session name exported-fns exported-values)
    (js-call (get session :modules) :set name (js-object :fns exported-fns :values exported-values)))

  (defun rt-import-functions (session mod-name syms)
    (let ((module (js-call (get session :modules) :get mod-name)))
      (js-call syms :forEach (lambda (s) (el-set-fn session s (js-call (get module :fns) :get s))))
      nil))

  (defun rt-import-values (session mod-name syms)
    (let ((module (js-call (get session :modules) :get mod-name)))
      (js-call syms :forEach (lambda (s) (js-call (get session :liveValueGetters) :set s (js-call (get module :values) :get s))))
      nil))


  ;; ------------------------------------------------------------------
  ;; AOT Compiler Context and Helpers
  ;; ------------------------------------------------------------------

  (defun el-eliscript-string-literal (text)
    (let ((out (js-array "\"")))
      (js-call (Array/from (str text)) :forEach
               (lambda (ch)
                 (let ((code (js-call ch :codePointAt 0)))
                   (cond ((= ch "\"") (js-call out :push "\\\""))
                         ((= ch "\\") (js-call out :push "\\\\"))
                         ((= code 10) (js-call out :push "\\n"))
                         ((= code 9) (js-call out :push "\\t"))
                         ((= code 13) (js-call out :push "\\r"))
                         ((or (< code 32) (= code 127))
                           (js-call out :push (str "\\u" (js-call (js-call code :toString 16) :padStart 4 "0"))))
                         (t (js-call out :push ch))))))
      (js-call out :push "\"")
      (js-call out :join "")))

  (defun make-compile-ctx (csession)
    (js-object :session csession
               :varCounter 0
               :symMap (new globalThis.Map)
               :symDefs (js-array)
               :quoteCounter 0
               :quoteDefs (js-array)
               :fnNames (js-array)))

  (defun make-cenv (&optional parent)
    (if (nullish? parent)
        (js-object :vars (new globalThis.Map)
                   :fns (new globalThis.Map)
                   :consts (new globalThis.Set)
                   :moduleName nil
                   :inRecur false)
      (js-object :vars (new globalThis.Map (get parent :vars))
                 :fns (new globalThis.Map (get parent :fns))
                 :consts (new globalThis.Set (get parent :consts))
                 :moduleName (get parent :moduleName)
                 :inRecur (get parent :inRecur))))

  (defun ctx-gensym (ctx prefix)
    (put ctx :varCounter (1+ (get ctx :varCounter)))
    (str "__" prefix "_" (get ctx :varCounter)))

  (defun ctx-sym (ctx name)
    (let ((smap (get ctx :symMap))
          (sname (str name)))
      (if (js-call smap :has sname)
          (js-call smap :get sname)
        (let ((id (ctx-gensym ctx "sym")))
          (js-call smap :set sname id)
          (js-call (get ctx :symDefs) :push
                   (str "  (defconst " id " (el-intern " (el-eliscript-string-literal sname) "))"))
          id))))

  (defun ctx-record-fn (ctx name)
    (let ((s (str name)))
      (unless (js-call (get ctx :fnNames) :includes s)
        (js-call (get ctx :fnNames) :push s))))

  (defun compile-number (n)
    (let ((v (el-num n))
          (raw (let ((x (el-num n)))
                 (cond
                   ((Number/isNaN x) "Number/NaN")
                   ((= x Number/POSITIVE_INFINITY) "Number/POSITIVE_INFINITY")
                   ((= x Number/NEGATIVE_INFINITY) "Number/NEGATIVE_INFINITY")
                   ((Object/is x -0.0) "-0.0")
                   ((< x 0) (str "(rt-sub 0 " (- 0 x) ")"))
                   (t (str x))))))
      (if (el-float? n)
          (str "(el-make-float " raw ")")
        raw)))

  (defun compile-datum-inline (ctx datum)
    (cond
      ((nil? datum) "nil")
      ((eq datum t) "t")
      ((or (el-integer? datum) (el-float? datum)) (compile-number datum))
      ((el-string? datum) (el-eliscript-string-literal datum))
      ((el-symobj? datum) (ctx-sym ctx (get datum :name)))
      ((el-cons? datum)
        (let ((items (js-array)) (cursor datum))
          (while (el-cons? cursor)
            (js-call items :push (compile-datum-inline ctx (get cursor :car)))
            (setq cursor (get cursor :cdr)))
          (if (nil? cursor)
              (str "(el-list"
                   (js-call (js-call items :map (lambda (x) (str " " x))) :join "")
                   ")")
            (let ((acc (compile-datum-inline ctx cursor))
                  (idx (1- (js-length items))))
              (while (>= idx 0)
                (setq acc (str "(el-cons " (aref items idx) " " acc ")"))
                (setq idx (1- idx)))
              acc))))
      ((el-vector? datum)
        (str "(el-vector (js-array"
             (js-call (js-call (get datum :items) :map (lambda (x) (str " " (compile-datum-inline ctx x)))) :join "")
             "))"))
      ((= (el-kind datum) "record")
        (str "(js-object :kind \"record\" :items (js-array"
             (js-call (js-call (get datum :items) :map (lambda (x) (str " " (compile-datum-inline ctx x)))) :join "")
             "))"))
      ((or (= (el-kind datum) "persistent-vector")
           (= (el-kind datum) "persistent-list")
           (= (el-kind datum) "persistent-queue"))
        (str "(el-make-pcoll " (el-eliscript-string-literal (el-kind datum)) " (js-array"
             (js-call (js-call (get datum :items) :map (lambda (x) (str " " (compile-datum-inline ctx x)))) :join "")
             "))"))
      ((= (el-kind datum) "persistent-set")
        (str "(el-make-pset (js-array"
             (js-call (js-call (get datum :items) :map (lambda (x) (str " " (compile-datum-inline ctx x)))) :join "")
             "))"))
      ((= (el-kind datum) "persistent-map")
        (let ((flat (js-array)))
          (js-call (get datum :entries) :forEach
                   (lambda (e)
                     (js-call flat :push (compile-datum-inline ctx (aref e 0)))
                     (js-call flat :push (compile-datum-inline ctx (aref e 1)))))
          (str "(el-make-pmap (js-array"
               (js-call (js-call flat :map (lambda (x) (str " " x))) :join "")
               "))")))
      (t "nil")))

  (defun compile-quote (ctx datum)
    (cond
      ((nil? datum) "nil")
      ((eq datum t) "t")
      ((or (el-integer? datum) (el-float? datum)) (compile-number datum))
      ((el-string? datum) (el-eliscript-string-literal datum))
      ((el-symobj? datum) (ctx-sym ctx (get datum :name)))
      (t
        (put ctx :quoteCounter (1+ (get ctx :quoteCounter)))
        (let ((qid (str "__q_" (get ctx :quoteCounter)))
              (expr (compile-datum-inline ctx datum)))
          (js-call (get ctx :quoteDefs) :push (str "  (defconst " qid " " expr ")"))
          qid))))

  (defun compile-body (ctx cenv forms)
    (let ((n (js-length forms)))
      (cond
        ((= n 0) "nil")
        ((= n 1) (compile-expr ctx cenv (aref forms 0)))
        (t (str "(progn "
                (js-call (js-call forms :map (lambda (f) (compile-expr ctx cenv f))) :join " ")
                ")")))))

  (defun compile-list-body (ctx cenv form-list)
    (compile-body ctx cenv (el-list-to-array form-list)))

  (defun compile-backquote (ctx cenv form level)
    (cond
      ((el-vector? form)
        (let ((list-expr (compile-backquote ctx cenv (el-list-from (get form :items)) level)))
          (str "(el-vector (el-list-to-array " list-expr "))")))
      ((not (el-cons? form)) (compile-quote ctx form))
      ((eq (get form :car) s-comma)
        (if (= level 1)
            (compile-expr ctx cenv (el-car (get form :cdr)))
          (str "(el-list " (ctx-sym ctx ",") " "
               (compile-backquote ctx cenv (el-car (get form :cdr)) (1- level)) ")")))
      ((eq (get form :car) s-backquote)
        (str "(el-list " (ctx-sym ctx "`") " "
             (compile-backquote ctx cenv (el-car (get form :cdr)) (1+ level)) ")"))
      (t
        (let ((segments (js-array))
              (cur-items (js-array))
              (cursor form)
              (tail-expr "nil")
              (done false))
          (letfn ((flush-items ()
                    (when (> (js-length cur-items) 0)
                      (js-call segments :push
                               (str "(el-list"
                                    (js-call (js-call cur-items :map (lambda (x) (str " " x))) :join "")
                                    ")"))
                      (setq cur-items (js-array)))))
            (while (not done)
              (cond
                ((nil? cursor) (setq done t))
                ((not (el-cons? cursor))
                  (setq tail-expr (compile-backquote ctx cenv cursor level))
                  (setq done t))
                ((eq (get cursor :car) s-comma)
                  (setq tail-expr (compile-backquote ctx cenv cursor level))
                  (setq done t))
                (t
                  (let ((item (get cursor :car)))
                    (if (and (el-cons? item) (eq (get item :car) s-comma-at) (= level 1))
                        (progn
                          (flush-items)
                          (js-call segments :push
                                   (str "(el-list-from (el-seq-items "
                                        (compile-expr ctx cenv (el-car (get item :cdr)))
                                        "))")))
                      (js-call cur-items :push (compile-backquote ctx cenv item level))))
                  (setq cursor (get cursor :cdr)))))
            (flush-items)
            (cond
              ((and (= (js-length segments) 0) (= tail-expr "nil")) "nil")
              ((= (js-length segments) 0) tail-expr)
              ((and (= (js-length segments) 1) (= tail-expr "nil")) (aref segments 0))
              (t
                (unless (= tail-expr "nil") (js-call segments :push tail-expr))
                (str "(el-append (js-array " (js-call segments :join " ") "))"))))))))

  (defun compile-var-read (ctx cenv sym)
    (let ((name (get sym :name)))
      (cond
        ((or (nil? sym) (= name "nil")) "nil")
        ((or (eq sym t) (= name "t")) "t")
        ((el-keyword? sym) (ctx-sym ctx name))
        ((js-call (get cenv :vars) :has name)
          (let ((info (js-call (get cenv :vars) :get name)))
            (str "(rt-read-var session " (get info :symExpr) " " (get info :jsVar) ")")))
        (t (str "(rt-get-global session " (ctx-sym ctx name) ")")))))

  (defun compile-var-write (ctx cenv sym val-expr)
    (when (or (nil? sym) (eq sym t) (el-keyword? sym))
      (el-signal "setting-constant" sym))
    (unless (el-symobj? sym)
      (el-signal "wrong-type-argument" (el-intern "symbolp") sym))
    (let ((name (get sym :name)))
      (when (js-call (get cenv :consts) :has name)
        (if (not (nil? (get cenv :moduleName)))
            (el-compile-error (str "ELI-M0002: cannot reassign defconst-lexical " name " in module " (get cenv :moduleName)))
          (el-compile-error (str "ELI-C0010: cannot mutate immutable binding " name))))
      (if (js-call (get cenv :vars) :has name)
          (let ((info (js-call (get cenv :vars) :get name)))
            (when (get info :isConst)
              (el-compile-error (str "ELI-C0010: cannot mutate immutable binding " name)))
            (str "(setq " (get info :jsVar) " (rt-write-var session " (get info :symExpr) " " val-expr "))"))
        (str "(rt-set-global session " (ctx-sym ctx name) " " val-expr ")"))))

  (defun compile-let (ctx cenv bindings-form body-list sequential is-const)
    (let ((raw-bindings (el-list-to-array bindings-form)))
      (if (= (js-length raw-bindings) 0)
          (compile-list-body ctx cenv body-list)
        (let ((dyn-var (ctx-gensym ctx "dyn"))
              (next-cenv (make-cenv cenv))
              (bind-fn (if is-const "rt-bind-const-var" "rt-bind-var")))
          (if sequential
              (let ((decls (js-array (str "(" dyn-var " (js-array))")))
                    (steps (js-array)))
                (js-call raw-bindings :forEach
                         (lambda (b)
                           (let* ((sym (if (el-cons? b) (get b :car) b))
                                  (val-form (if (el-cons? b) (el-car (get b :cdr)) nil))
                                  (val-expr (compile-expr ctx next-cenv val-form))
                                  (js-var (ctx-gensym ctx "v"))
                                  (sym-expr (ctx-sym ctx (get sym :name))))
                             (js-call decls :push (str "(" js-var " nil)"))
                             (js-call steps :push
                                      (str "(setq " js-var " (" bind-fn " session " sym-expr " " val-expr " " dyn-var "))"))
                             (js-call (get next-cenv :vars) :set (get sym :name)
                                      (js-object :jsVar js-var :symExpr sym-expr :isConst is-const))
                             (if is-const
                                 (js-call (get next-cenv :consts) :add (get sym :name))
                               (js-call (get next-cenv :consts) :delete (get sym :name))))))
                (js-call steps :push (compile-list-body ctx next-cenv body-list))
                (str "(let (" (js-call decls :join " ") ") "
                     "(try (progn " (js-call steps :join " ") ") "
                     "(finally (rt-restore-dyn session " dyn-var "))))"))
            (let ((init-decls (js-array))
                  (var-decls (js-array (str "(" dyn-var " (js-array))")))
                  (bind-steps (js-array))
                  (entries (js-array)))
              (js-call raw-bindings :forEach
                       (lambda (b)
                         (let* ((sym (if (el-cons? b) (get b :car) b))
                                (val-form (if (el-cons? b) (el-car (get b :cdr)) nil))
                                (init-var (ctx-gensym ctx "init"))
                                (js-var (ctx-gensym ctx "v"))
                                (sym-expr (ctx-sym ctx (get sym :name))))
                           (js-call init-decls :push (str "(" init-var " " (compile-expr ctx cenv val-form) ")"))
                           (js-call var-decls :push (str "(" js-var " nil)"))
                           (js-call bind-steps :push
                                    (str "(setq " js-var " (" bind-fn " session " sym-expr " " init-var " " dyn-var "))"))
                           (js-call entries :push (js-object :name (get sym :name) :jsVar js-var :symExpr sym-expr)))))
              (js-call entries :forEach
                       (lambda (e)
                         (js-call (get next-cenv :vars) :set (get e :name)
                                  (js-object :jsVar (get e :jsVar) :symExpr (get e :symExpr) :isConst is-const))
                         (if is-const
                             (js-call (get next-cenv :consts) :add (get e :name))
                           (js-call (get next-cenv :consts) :delete (get e :name)))))
              (js-call bind-steps :push (compile-list-body ctx next-cenv body-list))
              (str "(let (" (js-call (js-call init-decls :concat var-decls) :join " ") ") "
                   "(try (progn " (js-call bind-steps :join " ") ") "
                   "(finally (rt-restore-dyn session " dyn-var "))))")))))))

  (defun compile-letrec (ctx cenv bindings-form body-list)
    (let ((raw-bindings (el-list-to-array bindings-form)))
      (if (= (js-length raw-bindings) 0)
          (compile-list-body ctx cenv body-list)
        (let ((dyn-var (ctx-gensym ctx "dyn"))
              (next-cenv (make-cenv cenv))
              (decls (js-array))
              (init-steps (js-array))
              (assign-steps (js-array)))
          (js-call decls :push (str "(" dyn-var " (js-array))"))
          (js-call raw-bindings :forEach
                   (lambda (b)
                     (let* ((sym (if (el-cons? b) (get b :car) b))
                            (val-form (if (el-cons? b) (el-car (get b :cdr)) nil))
                            (js-var (ctx-gensym ctx "v"))
                            (sym-expr (ctx-sym ctx (get sym :name))))
                       (js-call decls :push (str "(" js-var " nil)"))
                       (js-call init-steps :push (str "(setq " js-var " (rt-bind-var session " sym-expr " nil " dyn-var "))"))
                       (js-call (get next-cenv :vars) :set (get sym :name)
                                (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                       (js-call (get next-cenv :consts) :delete (get sym :name))
                       (js-call assign-steps :push (js-array sym val-form)))))
          (let ((compiled-assigns
                  (js-call assign-steps :map
                           (lambda (pair)
                             (compile-var-write ctx next-cenv (aref pair 0) (compile-expr ctx next-cenv (aref pair 1)))))))
            (str "(let (" (js-call decls :join " ") ") "
                 "(try (progn "
                 (js-call (js-call init-steps :concat compiled-assigns) :join " ") " "
                 (compile-list-body ctx next-cenv body-list)
                 ") (finally (rt-restore-dyn session " dyn-var "))))"))))))

  (defun collect-destructure-vars (pattern out)
    (cond
      ((nil? pattern) out)
      ((el-symobj? pattern)
        (unless (or (eq pattern s-optional) (eq pattern s-rest) (eq pattern s-body)
                    (eq pattern s-key) (eq pattern s-aux) (eq pattern s-allow-other-keys)
                    (el-keyword? pattern))
          (unless (js-call out :some (lambda (s) (eq s pattern)))
            (js-call out :push pattern)))
        out)
      ((el-vector? pattern)
        (js-call (get pattern :items) :forEach (lambda (p) (collect-destructure-vars p out)))
        out)
      ((el-cons? pattern)
        (let ((cursor pattern) (mode "required"))
          (while (el-cons? cursor)
            (let ((item (get cursor :car)))
              (cond
                ((eq item s-optional) (setq mode "optional"))
                ((or (eq item s-rest) (eq item s-body)) (setq mode "rest"))
                ((eq item s-key) (setq mode "key"))
                ((eq item s-aux) (setq mode "aux"))
                ((eq item s-allow-other-keys) nil)
                ((= mode "required") (collect-destructure-vars item out))
                ((= mode "optional")
                  (if (el-cons? item)
                      (progn
                        (collect-destructure-vars (get item :car) out)
                        (unless (nil? (el-nth 2 item)) (collect-destructure-vars (el-nth 2 item) out)))
                    (collect-destructure-vars item out)))
                ((= mode "rest") (collect-destructure-vars item out))
                ((= mode "key")
                  (if (el-cons? item)
                      (let* ((spec (get item :car))
                             (var (if (el-cons? spec) (el-nth 1 spec) spec)))
                        (collect-destructure-vars var out)
                        (unless (nil? (el-nth 2 item)) (collect-destructure-vars (el-nth 2 item) out)))
                    (collect-destructure-vars item out)))
                ((= mode "aux")
                  (collect-destructure-vars (if (el-cons? item) (get item :car) item) out))))
            (setq cursor (get cursor :cdr)))
          (when (and (not (nil? cursor)) (el-symobj? cursor))
            (collect-destructure-vars cursor out))
          out))
      (t out)))

  (defun compile-destructure-pattern (ctx cenv pattern)
    ;; Compile default expressions in &optional, &key, &aux into 0-arg thunks.
    (cond
      ((or (nil? pattern) (el-symobj? pattern)) (compile-quote ctx pattern))
      ((el-vector? pattern)
        (str "(el-vector (js-array"
             (js-call (js-call (get pattern :items) :map (lambda (p) (str " " (compile-destructure-pattern ctx cenv p)))) :join "")
             "))"))
      ((el-cons? pattern)
        (let ((items (js-array)) (cursor pattern) (mode "required"))
          (while (el-cons? cursor)
            (let ((item (get cursor :car)))
              (cond
                ((eq item s-optional)
                  (setq mode "optional")
                  (js-call items :push (compile-quote ctx item)))
                ((or (eq item s-rest) (eq item s-body))
                  (setq mode "rest")
                  (js-call items :push (compile-quote ctx item)))
                ((eq item s-key)
                  (setq mode "key")
                  (js-call items :push (compile-quote ctx item)))
                ((eq item s-aux)
                  (setq mode "aux")
                  (js-call items :push (compile-quote ctx item)))
                ((eq item s-allow-other-keys)
                  (js-call items :push (compile-quote ctx item)))
                ((or (= mode "required") (= mode "rest"))
                  (js-call items :push (compile-destructure-pattern ctx cenv item)))
                ((or (= mode "optional") (= mode "key"))
                  (if (el-cons? item)
                      (let ((var-part (get item :car))
                            (def-form (el-nth 1 item))
                            (svar (el-nth 2 item)))
                        (js-call items :push
                                 (str "(el-list "
                                      (if (= mode "key")
                                          (if (el-cons? var-part)
                                              (str "(el-list " (compile-quote ctx (get var-part :car)) " "
                                                   (compile-destructure-pattern ctx cenv (el-nth 1 var-part)) ")")
                                            (compile-destructure-pattern ctx cenv var-part))
                                        (compile-destructure-pattern ctx cenv var-part))
                                      " (lambda () " (compile-expr ctx cenv def-form) ") "
                                      (compile-quote ctx svar) ")")))
                    (js-call items :push (compile-destructure-pattern ctx cenv item))))
                ((= mode "aux")
                  (if (el-cons? item)
                      (js-call items :push
                               (str "(el-list " (compile-quote ctx (get item :car))
                                    " (lambda () " (compile-expr ctx cenv (el-nth 1 item)) "))"))
                    (js-call items :push (compile-quote ctx item))))))
            (setq cursor (get cursor :cdr)))
          (if (nil? cursor)
              (str "(el-list" (js-call (js-call items :map (lambda (x) (str " " x))) :join "") ")")
            (let ((acc (compile-quote ctx cursor))
                  (idx (1- (js-length items))))
              (while (>= idx 0)
                (setq acc (str "(el-cons " (aref items idx) " " acc ")"))
                (setq idx (1- idx)))
              acc))))
      (t (compile-quote ctx pattern))))

  (defun compile-setter-branches (vars next-cenv dyn-var)
    (let ((s-param "__s") (v-param "__v") (d-param "__d")
          (clauses (js-array)))
      (js-call vars :forEach
               (lambda (sym)
                 (let ((info (js-call (get next-cenv :vars) :get (get sym :name))))
                   (js-call clauses :push
                            (str "((eq " s-param " " (get info :symExpr) ") "
                                 "(setq " (get info :jsVar) " (rt-bind-var session " (get info :symExpr) " " v-param " " d-param ")))")))))
      (js-call clauses :push "(t nil)")
      (str "(lambda (" s-param " " v-param " " d-param ") (cond " (js-call clauses :join " ") "))")))

  (defun compile-body-with-contracts (ctx cenv body props name)
    (let ((reqs (if (and (not (nil? props)) (js-call props :has ":requires"))
                    (el-list-to-array (js-call props :get ":requires"))
                  (js-array)))
          (enss (if (and (not (nil? props)) (js-call props :has ":ensures"))
                    (el-list-to-array (js-call props :get ":ensures"))
                  (js-array))))
      (if (and (= (js-length reqs) 0) (= (js-length enss) 0))
          (compile-body ctx cenv body)
        (let ((steps (js-array))
              (res-var (ctx-gensym ctx "res"))
              (dyn-var (ctx-gensym ctx "cdyn"))
              (ens-cenv (make-cenv cenv))
              (res-sym (ctx-sym ctx "result")))
          (js-call reqs :forEach
                   (lambda (r)
                     (js-call steps :push
                              (str "(rt-check-contract " (compile-expr ctx cenv r) " "
                                   (el-eliscript-string-literal name) " \"Precondition\")"))))
          (if (= (js-length enss) 0)
              (progn
                (js-call steps :push (compile-body ctx cenv body))
                (str "(progn " (js-call steps :join " ") ")"))
            (progn
              (js-call (get ens-cenv :vars) :set "result"
                       (js-object :jsVar res-var :symExpr res-sym :isConst false))
              (let ((ens-steps (js-array)))
                (js-call enss :forEach
                         (lambda (e)
                           (js-call ens-steps :push
                                    (str "(rt-check-contract " (compile-expr ctx ens-cenv e) " "
                                         (el-eliscript-string-literal name) " \"Postcondition\")"))))
                (str "(progn " (js-call steps :join " ")
                     (if (> (js-length steps) 0) " " "")
                     "(let* ((" dyn-var " (js-array)) (" res-var " (rt-bind-var session " res-sym " "
                     (compile-body ctx cenv body) " " dyn-var "))) "
                     "(try (progn " (js-call ens-steps :join " ") " " res-var ") "
                     "(finally (rt-restore-dyn session " dyn-var ")))))"))))))))

  (defun compile-lambda-impl (ctx cenv spec-and-body name is-cl block-name)
    (let* ((arglist (el-car spec-and-body))
           (extracted (el-extract-declarations (el-list-to-array (el-cdr spec-and-body))))
           (props (get extracted :props))
           (body (get extracted :body))
           (args-var (ctx-gensym ctx "args"))
           (dyn-var (ctx-gensym ctx "dyn"))
           (fn-cenv (make-cenv cenv)))
      (put fn-cenv :inRecur false)
      (if (and (not is-cl) (el-simple-arglist? arglist))
          (let* ((spec (el-parse-arglist arglist))
                 (req (get spec :required))
                 (opt (get spec :optional))
                 (rest-sym (get spec :rest))
                 (nreq (js-length req))
                 (nmax (+ nreq (js-length opt)))
                 (has-rest (not (nil? rest-sym)))
                 (decls (js-array (str "(" dyn-var " (js-array))")))
                 (bind-steps (js-array)))
            (js-call req :forEach
                     (lambda (sym idx)
                       (let ((js-var (ctx-gensym ctx "v"))
                             (sym-expr (ctx-sym ctx (get sym :name))))
                         (js-call decls :push (str "(" js-var " nil)"))
                         (js-call bind-steps :push
                                  (str "(setq " js-var " (rt-bind-var session " sym-expr
                                       " (el-opt (aref " args-var " " idx ")) " dyn-var "))"))
                         (js-call (get fn-cenv :vars) :set (get sym :name)
                                  (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                         (js-call (get fn-cenv :consts) :delete (get sym :name)))))
            (js-call opt :forEach
                     (lambda (sym idx)
                       (let ((js-var (ctx-gensym ctx "v"))
                             (sym-expr (ctx-sym ctx (get sym :name)))
                             (pos (+ nreq idx)))
                         (js-call decls :push (str "(" js-var " nil)"))
                         (js-call bind-steps :push
                                  (str "(setq " js-var " (rt-bind-var session " sym-expr
                                       " (rt-opt-arg " args-var " " pos ") " dyn-var "))"))
                         (js-call (get fn-cenv :vars) :set (get sym :name)
                                  (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                         (js-call (get fn-cenv :consts) :delete (get sym :name)))))
            (unless (nil? rest-sym)
              (let ((js-var (ctx-gensym ctx "v"))
                    (sym-expr (ctx-sym ctx (get rest-sym :name))))
                (js-call decls :push (str "(" js-var " nil)"))
                (js-call bind-steps :push
                         (str "(setq " js-var " (rt-bind-var session " sym-expr
                              " (rt-rest-arg " args-var " " nmax ") " dyn-var "))"))
                (js-call (get fn-cenv :vars) :set (get rest-sym :name)
                         (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                (js-call (get fn-cenv :consts) :delete (get rest-sym :name))))
            (let* ((body-expr (compile-body-with-contracts ctx fn-cenv body props name))
                   (wrapped-body (if (nil? block-name)
                                     body-expr
                                   (str "(el-catch-block session " (ctx-sym ctx block-name)
                                        " (lambda () " body-expr "))"))))
              (str "(rt-wrap-fn " (el-eliscript-string-literal name) " " (compile-quote ctx arglist)
                   " (lambda (" args-var ") "
                   "(rt-check-arity " (el-eliscript-string-literal name) " " args-var " "
                   nreq " " nmax " " (if has-rest "t" "false") ") "
                   (if (= (js-length bind-steps) 0)
                       wrapped-body
                     (str "(let (" (js-call decls :join " ") ") "
                          "(try (progn " (js-call bind-steps :join " ") " " wrapped-body ") "
                          "(finally (rt-restore-dyn session " dyn-var "))))"))
                   "))")))
        ;; CL / destructuring arglist
        (let* ((vars (collect-destructure-vars arglist (js-array)))
               (decls (js-array (str "(" dyn-var " (js-array))")))
               (pat-expr nil)
               (setter-expr nil))
          (js-call vars :forEach
                   (lambda (sym)
                     (let ((js-var (ctx-gensym ctx "v"))
                           (sym-expr (ctx-sym ctx (get sym :name))))
                       (js-call decls :push (str "(" js-var " nil)"))
                       (js-call (get fn-cenv :vars) :set (get sym :name)
                                (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                       (js-call (get fn-cenv :consts) :delete (get sym :name)))))
          (setq pat-expr (compile-destructure-pattern ctx fn-cenv arglist))
          (setq setter-expr (compile-setter-branches vars fn-cenv dyn-var))
          (let* ((body-expr (compile-body-with-contracts ctx fn-cenv body props name))
                 (wrapped-body (if (nil? block-name)
                                   body-expr
                                 (str "(el-catch-block session " (ctx-sym ctx block-name)
                                      " (lambda () " body-expr "))"))))
            (str "(rt-wrap-fn " (el-eliscript-string-literal name) " " (compile-quote ctx arglist)
                 " (lambda (" args-var ") "
                 "(let (" (js-call decls :join " ") ") "
                 "(try (progn "
                 "(rt-destructure session " pat-expr " (el-list-from " args-var ") " setter-expr " " dyn-var ") "
                 wrapped-body ") "
                 "(finally (rt-restore-dyn session " dyn-var "))))))"))))))

  (defun compile-macro-fn (ctx cenv arglist body-array name)
    (let* ((forms-var (ctx-gensym ctx "forms"))
           (dyn-var (ctx-gensym ctx "dyn"))
           (fn-cenv (make-cenv cenv))
           (vars (collect-destructure-vars arglist (js-array)))
           (decls (js-array (str "(" dyn-var " (js-array))"))))
      (put fn-cenv :inRecur false)
      (js-call vars :forEach
               (lambda (sym)
                 (let ((js-var (ctx-gensym ctx "v"))
                       (sym-expr (ctx-sym ctx (get sym :name))))
                   (js-call decls :push (str "(" js-var " nil)"))
                   (js-call (get fn-cenv :vars) :set (get sym :name)
                            (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                   (js-call (get fn-cenv :consts) :delete (get sym :name)))))
      (let ((pat-expr (compile-destructure-pattern ctx fn-cenv arglist))
            (setter-expr (compile-setter-branches vars fn-cenv dyn-var))
            (body-expr (compile-body ctx fn-cenv body-array)))
        (str "(lambda (" forms-var ") "
             "(let (" (js-call decls :join " ") ") "
             "(try (progn (rt-destructure session " pat-expr " " forms-var " " setter-expr " " dyn-var ") "
             body-expr ") "
             "(finally (rt-restore-dyn session " dyn-var ")))))"))))

  (defun compile-place (ctx cenv place)
    (let ((csession (get ctx :session)))
      (cond
        ((el-symobj? place)
          (let ((name (get place :name)))
            (when (js-call (get cenv :consts) :has name)
              (if (not (nil? (get cenv :moduleName)))
                  (el-compile-error (str "ELI-M0002: cannot reassign defconst-lexical " name " in module " (get cenv :moduleName)))
                (el-compile-error (str "ELI-C0010: cannot mutate immutable binding " name))))
            (if (js-call (get cenv :vars) :has name)
                (let ((info (js-call (get cenv :vars) :get name))
                      (v-param (ctx-gensym ctx "pv")))
                  (str "(js-object :get (lambda () (rt-read-var session " (get info :symExpr) " " (get info :jsVar) ")) "
                       ":set (lambda (" v-param ") (setq " (get info :jsVar)
                       " (rt-write-var session " (get info :symExpr) " " v-param "))))"))
              (let ((sym-expr (ctx-sym ctx name))
                    (v-param (ctx-gensym ctx "pv")))
                (str "(js-object :get (lambda () (rt-get-global session " sym-expr ")) "
                     ":set (lambda (" v-param ") (rt-set-global session " sym-expr " " v-param ")))")))))
        ((not (el-cons? place))
          (str "(js-object :get (lambda () nil) :set (lambda (__v) (el-signal \"error\" "
               (el-eliscript-string-literal (str "Bad place: " (el-prin1-string place t))) ")))"))
        (t
          (let* ((head (get place :car))
                 (name (el-symbol-name head))
                 (args (el-args place)))
            (cond
              ((and (js-call (get csession :macros) :has head)
                    (not (js-call (get csession :gvSetters) :has head))
                    (not (js-call (get csession :accessors) :has head)))
                (compile-place ctx cenv (el-macroexpand-1 csession place (el-root-env))))
              ((or (= name "aref") (= name "elt"))
                (str "(rt-place-aref " (compile-place ctx cenv (aref args 0)) " "
                     (compile-expr ctx cenv (aref args 1)) ")"))
              ((= name "alist-get")
                (str "(rt-place-alist-get session "
                     (compile-expr ctx cenv (aref args 0)) " "
                     (compile-place ctx cenv (aref args 1)) " "
                     (if (> (js-length args) 2) (compile-expr ctx cenv (aref args 2)) "nil") " "
                     (if (> (js-length args) 3) (compile-expr ctx cenv (aref args 3)) "nil") " "
                     (if (> (js-length args) 4) (compile-expr ctx cenv (aref args 4)) "nil") ")"))
              ((= name "plist-get")
                (str "(rt-place-plist-get session "
                     (compile-place ctx cenv (aref args 0)) " "
                     (compile-expr ctx cenv (aref args 1)) " "
                     (if (> (js-length args) 2) (compile-expr ctx cenv (aref args 2)) "nil") ")"))
              (t
                (str "(rt-place-call session " (ctx-sym ctx name)
                     " (js-array"
                     (js-call (js-call args :map (lambda (a) (str " " (compile-expr ctx cenv a)))) :join "")
                     "))"))))))))

  (defun compile-setf (ctx cenv form)
    (let ((cursor (get form :cdr))
          (steps (js-array))
          (csession (get ctx :session)))
      (while (el-cons? cursor)
        (let ((place-form (get cursor :car))
              (val-form (el-car (get cursor :cdr))))
          (cond
            ((el-symobj? place-form)
              (js-call steps :push (compile-var-write ctx cenv place-form (compile-expr ctx cenv val-form))))
            ((and (el-cons? place-form)
                  (el-symobj? (get place-form :car))
                  (js-call (get csession :gvSetters) :has (get place-form :car))
                  (= (get (js-call (get csession :gvSetters) :get (get place-form :car)) :kind) "expander"))
              (let* ((info (js-call (get csession :gvSetters) :get (get place-form :car)))
                     (expanded (funcall (get info :fn) (el-cons val-form (get place-form :cdr)) (el-root-env))))
                (js-call steps :push (compile-expr ctx cenv expanded))))
            (t
              (let ((p-var (ctx-gensym ctx "pl"))
                    (v-var (ctx-gensym ctx "sv")))
                (js-call steps :push
                         (str "(let ((" p-var " " (compile-place ctx cenv place-form) ") "
                              "(" v-var " " (compile-expr ctx cenv val-form) ")) "
                              "(funcall (get " p-var " :set) " v-var ") " v-var ")"))))))
        (setq cursor (el-cdr (get cursor :cdr))))
      (cond
        ((= (js-length steps) 0) "nil")
        ((= (js-length steps) 1) (aref steps 0))
        (t (str "(progn " (js-call steps :join " ") ")")))))

  (defun compile-cl-letf (ctx cenv form)
    (let* ((sequential (el-sym-is (get form :car) "cl-letf*"))
           (bindings (el-list-to-array (el-second form)))
           (body (el-rest-after form 1)))
      (if (= (js-length bindings) 0)
          (compile-list-body ctx cenv body)
        (let ((dyn-var (ctx-gensym ctx "dyn"))
              (restores-var (ctx-gensym ctx "rest"))
              (next-cenv (make-cenv cenv))
              (decls (js-array))
              (steps (js-array))
              (val-inits (js-array)))
          (js-call decls :push (str "(" dyn-var " (js-array))"))
          (js-call decls :push (str "(" restores-var " (js-array))"))
          (js-call bindings :forEach
                   (lambda (b)
                     (let* ((place-form (if (el-cons? b) (get b :car) b))
                            (val-form (if (and (el-cons? b) (el-cons? (get b :cdr))) (el-car (get b :cdr)) nil))
                            (eval-cenv (if sequential next-cenv cenv)))
                       (if (el-symobj? place-form)
                           (let* ((name (get place-form :name))
                                  (sym-expr (ctx-sym ctx name))
                                  (was-lex (js-call (get eval-cenv :vars) :has name))
                                  (val-expr (compile-expr ctx eval-cenv val-form))
                                  (js-var (ctx-gensym ctx "v")))
                             (js-call decls :push (str "(" js-var " nil)"))
                             (if sequential
                                 (progn
                                   (unless was-lex
                                     (js-call steps :push (str "(el-add-special-var session " sym-expr ")")))
                                   (js-call steps :push
                                            (str "(setq " js-var " (rt-bind-var session " sym-expr " " val-expr " " dyn-var "))"))
                                   (js-call (get next-cenv :vars) :set name
                                            (js-object :jsVar js-var :symExpr sym-expr :isConst false)))
                               (let ((init-v (ctx-gensym ctx "linit")))
                                 (js-call decls :push (str "(" init-v " " val-expr ")"))
                                 (js-call val-inits :push
                                          (js-object :kind "var" :wasLex was-lex :symExpr sym-expr
                                                     :jsVar js-var :initVar init-v :name name)))))
                         (let ((p-var (ctx-gensym ctx "lp"))
                               (old-var (ctx-gensym ctx "lold"))
                               (new-var (ctx-gensym ctx "lnew")))
                           (if sequential
                               (progn
                                 (js-call steps :push
                                          (str "(let* ((" p-var " " (compile-place ctx eval-cenv place-form) ") "
                                               "(" old-var " (funcall (get " p-var " :get))) "
                                               "(" new-var " " (compile-expr ctx eval-cenv val-form) ")) "
                                               "(js-call " restores-var " :push (js-array (get " p-var " :set) " old-var ")) "
                                               "(funcall (get " p-var " :set) " new-var "))")))
                             (progn
                               (js-call decls :push (str "(" p-var " " (compile-place ctx cenv place-form) ")"))
                               (js-call decls :push (str "(" old-var " (funcall (get " p-var " :get)))"))
                               (js-call decls :push (str "(" new-var " " (compile-expr ctx cenv val-form) ")"))
                               (js-call val-inits :push
                                        (js-object :kind "place" :pVar p-var :oldVar old-var :newVar new-var)))))))))
          (unless sequential
            (js-call val-inits :forEach
                     (lambda (item)
                       (if (= (get item :kind) "var")
                           (progn
                             (unless (get item :wasLex)
                               (js-call steps :push (str "(el-add-special-var session " (get item :symExpr) ")")))
                             (js-call steps :push
                                      (str "(setq " (get item :jsVar) " (rt-bind-var session "
                                           (get item :symExpr) " " (get item :initVar) " " dyn-var "))"))
                             (js-call (get next-cenv :vars) :set (get item :name)
                                      (js-object :jsVar (get item :jsVar) :symExpr (get item :symExpr) :isConst false)))
                         (js-call steps :push
                                  (str "(progn (js-call " restores-var " :push (js-array (get "
                                       (get item :pVar) " :set) " (get item :oldVar) ")) "
                                       "(funcall (get " (get item :pVar) " :set) " (get item :newVar) "))"))))))
          (js-call steps :push (compile-list-body ctx next-cenv body))
          (let ((ri (ctx-gensym ctx "ri"))
                (rr (ctx-gensym ctx "rr")))
            (str "(let* (" (js-call decls :join " ") ") "
                 "(try (progn " (js-call steps :join " ") ") "
                 "(finally "
                 "(let ((" ri " (rt-dec (js-length " restores-var ")))) "
                 "(while (rt-gte " ri " 0) "
                 "(let ((" rr " (aref " restores-var " " ri "))) "
                 "(funcall (aref " rr " 0) (aref " rr " 1))) "
                 "(setq " ri " (rt-dec " ri ")))) "
                 "(rt-restore-dyn session " dyn-var "))))"))))))

  ;; ------------------------------------------------------------------
  ;; pcase compiler
  ;; ------------------------------------------------------------------

  (defun collect-pcase-vars (pattern out)
    (cond
      ((or (nil? pattern) (eq pattern t) (eq pattern s-underscore) (el-keyword? pattern)) out)
      ((el-symobj? pattern)
        (unless (js-call out :some (lambda (s) (eq s pattern)))
          (js-call out :push pattern))
        out)
      ((not (el-cons? pattern)) out)
      (t
        (let ((head (get pattern :car))
              (args (el-args pattern)))
          (cond
            ((or (eq head s-quote) (eq head s-pred) (eq head s-guard)
                 (el-sym-is head "cl-type") (el-sym-is head "rx"))
              out)
            ((eq head s-backquote)
              (collect-pcase-qpat-vars (aref args 0) out))
            ((eq head s-app)
              (collect-pcase-vars (aref args 1) out))
            ((or (eq head s-and) (eq head s-or))
              (js-call args :forEach (lambda (p) (collect-pcase-vars p out)))
              out)
            ((eq head s-let)
              (collect-pcase-vars (aref args 0) out))
            (t out))))))

  (defun collect-pcase-qpat-vars (qpat out)
    (cond
      ((and (el-cons? qpat) (eq (get qpat :car) s-comma))
        (collect-pcase-vars (el-car (get qpat :cdr)) out))
      ((el-cons? qpat)
        (collect-pcase-qpat-vars (get qpat :car) out)
        (collect-pcase-qpat-vars (get qpat :cdr) out))
      ((el-vector? qpat)
        (js-call (get qpat :items) :forEach (lambda (q) (collect-pcase-qpat-vars q out)))
        out)
      (t out)))

  (defun compile-pcase-fun (ctx cenv fun-form)
    (let ((v-param (ctx-gensym ctx "pv")))
      (cond
        ((el-symobj? fun-form)
          (let ((name (get fun-form :name)))
            (if (js-call (get cenv :fns) :has name)
                (str "(lambda (" v-param ") (rt-call-fn session "
                     (js-call (get cenv :fns) :get name) " (js-array " v-param ")))")
              (str "(lambda (" v-param ") (rt-call1 session " (ctx-sym ctx name) " " v-param "))"))))
        ((and (el-cons? fun-form) (or (eq (get fun-form :car) s-lambda) (eq (get fun-form :car) s-function)))
          (str "(lambda (" v-param ") (rt-call-fn session " (compile-expr ctx cenv fun-form) " (js-array " v-param ")))"))
        ((el-cons? fun-form)
          (let* ((head (get fun-form :car))
                 (extra-args (el-list-to-array (get fun-form :cdr)))
                 (compiled-extra (js-call extra-args :map (lambda (a) (compile-expr ctx cenv a)))))
            (str "(lambda (" v-param ") (rt-call-fn session "
                 (if (and (el-symobj? head) (js-call (get cenv :fns) :has (get head :name)))
                     (js-call (get cenv :fns) :get (get head :name))
                   (compile-quote ctx head))
                 " (js-array "
                 (js-call (js-call compiled-extra :concat (js-array v-param)) :join " ")
                 ")))")))
        (t "(lambda (__pv) nil)"))))

  (defun compile-pcase-pattern (ctx cenv pattern)
    (cond
      ((or (nil? pattern) (eq pattern t) (eq pattern s-underscore)
           (el-keyword? pattern) (el-symobj? pattern) (not (el-cons? pattern)))
        (compile-quote ctx pattern))
      (t
        (let ((head (get pattern :car))
              (args (el-args pattern)))
          (cond
            ((eq head s-quote) (compile-quote ctx pattern))
            ((eq head s-backquote)
              (str "(el-list " (ctx-sym ctx "`") " " (compile-pcase-qpat ctx cenv (aref args 0)) ")"))
            ((eq head s-pred)
              (let ((fun (aref args 0)))
                (if (and (el-cons? fun) (eq (get fun :car) s-not))
                    (let ((inner-fn (compile-pcase-fun ctx cenv (el-car (get fun :cdr)))))
                      (str "(el-list " (ctx-sym ctx "pred") " (lambda (__x) (nil? (funcall " inner-fn " __x))))"))
                  (str "(el-list " (ctx-sym ctx "pred") " " (compile-pcase-fun ctx cenv fun) ")"))))
            ((eq head s-guard)
              (str "(el-list " (ctx-sym ctx "guard") " (lambda () " (compile-expr ctx cenv (aref args 0)) "))"))
            ((eq head s-app)
              (str "(el-list " (ctx-sym ctx "app") " "
                   (compile-pcase-fun ctx cenv (aref args 0)) " "
                   (compile-pcase-pattern ctx cenv (aref args 1)) ")"))
            ((or (eq head s-and) (eq head s-or))
              (str "(el-list " (ctx-sym ctx (get head :name))
                   (js-call (js-call args :map (lambda (p) (str " " (compile-pcase-pattern ctx cenv p)))) :join "")
                   ")"))
            ((eq head s-let)
              (str "(el-list " (ctx-sym ctx "let") " "
                   (compile-pcase-pattern ctx cenv (aref args 0))
                   " (lambda () " (compile-expr ctx cenv (aref args 1)) "))"))
            ((el-sym-is head "cl-type")
              (compile-quote ctx pattern))
            ((el-sym-is head "rx")
              (let ((rx-str (el-rx (el-cons (el-intern "seq") (get pattern :cdr)))))
                (str "(el-list " (ctx-sym ctx "rx") " " (el-eliscript-string-literal rx-str) ")")))
            (t (compile-quote ctx pattern)))))))

  (defun compile-pcase-qpat (ctx cenv qpat)
    (cond
      ((and (el-cons? qpat) (eq (get qpat :car) s-comma))
        (str "(el-list " (ctx-sym ctx ",") " "
             (compile-pcase-pattern ctx cenv (el-car (get qpat :cdr))) ")"))
      ((el-cons? qpat)
        (str "(el-cons " (compile-pcase-qpat ctx cenv (get qpat :car)) " "
             (compile-pcase-qpat ctx cenv (get qpat :cdr)) ")"))
      ((el-vector? qpat)
        (str "(el-vector (js-array"
             (js-call (js-call (get qpat :items) :map (lambda (q) (str " " (compile-pcase-qpat ctx cenv q)))) :join "")
             "))"))
      (t (compile-quote ctx qpat))))

  (defun compile-pcase (ctx cenv form)
    (let* ((exhaustive (el-sym-is (get form :car) "pcase-exhaustive"))
           (val-var (ctx-gensym ctx "pval"))
           (res-var (ctx-gensym ctx "pres"))
           (done-var (ctx-gensym ctx "pdone"))
           (clauses (el-list-to-array (el-rest-after form 1)))
           (clause-exprs (js-array)))
      (js-call clauses :forEach
               (lambda (clause)
                 (let* ((pat (el-car clause))
                        (body (el-cdr clause))
                        (vars (collect-pcase-vars pat (js-array)))
                        (clause-cenv (make-cenv cenv))
                        (dyn-var (ctx-gensym ctx "dyn"))
                        (decls (js-array (str "(" dyn-var " (js-array))"))))
                   (js-call vars :forEach
                            (lambda (sym)
                              (let ((js-var (ctx-gensym ctx "v"))
                                    (sym-expr (ctx-sym ctx (get sym :name))))
                                (js-call decls :push (str "(" js-var " nil)"))
                                (js-call (get clause-cenv :vars) :set (get sym :name)
                                         (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                                (js-call (get clause-cenv :consts) :delete (get sym :name)))))
                   (let ((pat-expr (compile-pcase-pattern ctx clause-cenv pat))
                         (setter-expr
                           (let ((s-param "__s") (v-param "__v") (s-clauses (js-array)))
                             (js-call vars :forEach
                                      (lambda (sym)
                                        (let ((info (js-call (get clause-cenv :vars) :get (get sym :name))))
                                          (js-call s-clauses :push
                                                   (str "((eq " s-param " " (get info :symExpr) ") "
                                                        "(setq " (get info :jsVar) " (rt-bind-var session "
                                                        (get info :symExpr) " " v-param " " dyn-var ")))")))))
                             (js-call s-clauses :push "(t nil)")
                             (str "(lambda (" s-param " " v-param ") (cond " (js-call s-clauses :join " ") "))")))
                         (body-expr (compile-list-body ctx clause-cenv body)))
                     (js-call clause-exprs :push
                              (str "(unless " done-var " "
                                   "(let (" (js-call decls :join " ") ") "
                                   "(try (when (rt-pcase-match session " pat-expr " " val-var " " setter-expr ") "
                                   "(setq " done-var " t) "
                                   "(setq " res-var " " body-expr ")) "
                                   "(finally (rt-restore-dyn session " dyn-var ")))))"))))))
      (str "(let ((" val-var " " (compile-expr ctx cenv (el-second form)) ") "
           "(" res-var " nil) (" done-var " false)) "
           (js-call clause-exprs :join " ")
           (if exhaustive
               (str " (when (not " done-var ") (el-signal \"error\" (str \"No clause matching `\" (el-prin1-string " val-var " t) \"'\")))")
             "")
           " " res-var ")")))

  (defun compile-pcase-let (ctx cenv form)
    (let* ((sequential (el-sym-is (get form :car) "pcase-let*"))
           (bindings (el-list-to-array (el-second form)))
           (body (el-rest-after form 1)))
      (if (= (js-length bindings) 0)
          (compile-list-body ctx cenv body)
        (let ((dyn-var (ctx-gensym ctx "dyn"))
              (next-cenv (make-cenv cenv))
              (decls (js-array))
              (steps (js-array)))
          (js-call decls :push (str "(" dyn-var " (js-array))"))
          (js-call bindings :forEach
                   (lambda (b)
                     (let* ((pat (get b :car))
                            (val-form (el-car (get b :cdr)))
                            (eval-cenv (if sequential next-cenv cenv))
                            (val-var (ctx-gensym ctx "plv"))
                            (vars (collect-pcase-vars pat (js-array))))
                       (if sequential
                           (js-call steps :push (str "(let ((" val-var " " (compile-expr ctx eval-cenv val-form) "))"))
                         (js-call decls :push (str "(" val-var " " (compile-expr ctx cenv val-form) ")")))
                       (js-call vars :forEach
                                (lambda (sym)
                                  (let ((js-var (ctx-gensym ctx "v"))
                                        (sym-expr (ctx-sym ctx (get sym :name))))
                                    (js-call decls :push (str "(" js-var " nil)"))
                                    (js-call (get next-cenv :vars) :set (get sym :name)
                                             (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                                    (js-call (get next-cenv :consts) :delete (get sym :name)))))
                       (let* ((pat-expr (compile-pcase-pattern ctx next-cenv pat))
                              (s-param "__s") (v-param "__v")
                              (s-clauses (js-array)))
                         (js-call vars :forEach
                                  (lambda (sym)
                                    (let ((info (js-call (get next-cenv :vars) :get (get sym :name))))
                                      (js-call s-clauses :push
                                               (str "((eq " s-param " " (get info :symExpr) ") "
                                                    "(setq " (get info :jsVar) " (rt-bind-var session "
                                                    (get info :symExpr) " " v-param " " dyn-var ")))")))))
                         (js-call s-clauses :push "(t nil)")
                         (let ((match-call (str "(rt-pcase-match session " pat-expr " " val-var
                                                " (lambda (" s-param " " v-param ") (cond " (js-call s-clauses :join " ") ")))")))
                           (if sequential
                               (put steps (1- (js-length steps))
                                    (str (aref steps (1- (js-length steps))) " " match-call ")"))
                             (js-call steps :push match-call)))))))
          (js-call steps :push (compile-list-body ctx next-cenv body))
          (str "(let (" (js-call decls :join " ") ") "
               "(try (progn " (js-call steps :join " ") ") "
               "(finally (rt-restore-dyn session " dyn-var "))))")))))

  (defun compile-pcase-dolist (ctx cenv form)
    (let* ((spec (el-second form))
           (pat (el-car spec))
           (seq-form (el-car (el-cdr spec)))
           (body (el-rest-after form 1))
           (items-var (ctx-gensym ctx "items"))
           (idx-var (ctx-gensym ctx "i"))
           (item-var (ctx-gensym ctx "item"))
           (dyn-var (ctx-gensym ctx "dyn"))
           (vars (collect-pcase-vars pat (js-array)))
           (iter-cenv (make-cenv cenv))
           (decls (js-array (str "(" dyn-var " (js-array))"))))
      (js-call vars :forEach
               (lambda (sym)
                 (let ((js-var (ctx-gensym ctx "v"))
                       (sym-expr (ctx-sym ctx (get sym :name))))
                   (js-call decls :push (str "(" js-var " nil)"))
                   (js-call (get iter-cenv :vars) :set (get sym :name)
                            (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                   (js-call (get iter-cenv :consts) :delete (get sym :name)))))
      (let* ((pat-expr (compile-pcase-pattern ctx iter-cenv pat))
             (s-param "__s") (v-param "__v")
             (s-clauses (js-array)))
        (js-call vars :forEach
                 (lambda (sym)
                   (let ((info (js-call (get iter-cenv :vars) :get (get sym :name))))
                     (js-call s-clauses :push
                              (str "((eq " s-param " " (get info :symExpr) ") "
                                   "(setq " (get info :jsVar) " (rt-bind-var session "
                                   (get info :symExpr) " " v-param " " dyn-var ")))")))))
        (js-call s-clauses :push "(t nil)")
        (str "(let ((" items-var " (el-seq-items " (compile-expr ctx cenv seq-form) ")) "
             "(" idx-var " 0)) "
             "(while (rt-lt " idx-var " (js-length " items-var ")) "
             "(let ((" item-var " (aref " items-var " " idx-var ")) " (js-call decls :join " ") ") "
             "(try (progn (rt-pcase-match session " pat-expr " " item-var
             " (lambda (" s-param " " v-param ") (cond " (js-call s-clauses :join " ") "))) "
             (compile-list-body ctx iter-cenv body) ") "
             "(finally (rt-restore-dyn session " dyn-var ")))) "
             "(setq " idx-var " (1+ " idx-var "))) nil)"))))

  (defun compile-pcase-setq (ctx cenv form)
    (let ((cursor (get form :cdr))
          (steps (js-array)))
      (while (el-cons? cursor)
        (let* ((pat (get cursor :car))
               (val-form (el-car (get cursor :cdr)))
               (vars (collect-pcase-vars pat (js-array)))
               (s-param "__s") (v-param "__v")
               (s-clauses (js-array)))
          (js-call vars :forEach
                   (lambda (sym)
                     (js-call s-clauses :push
                              (str "((eq " s-param " " (ctx-sym ctx (get sym :name)) ") "
                                   (compile-var-write ctx cenv sym v-param) ")"))))
          (js-call s-clauses :push "(t nil)")
          (js-call steps :push
                   (str "(rt-pcase-match session " (compile-pcase-pattern ctx cenv pat) " "
                        (compile-expr ctx cenv val-form)
                        " (lambda (" s-param " " v-param ") (cond " (js-call s-clauses :join " ") ")))")))
        (setq cursor (el-cdr (get cursor :cdr))))
      (str "(progn " (js-call steps :join " ") " nil)")))

  ;; ------------------------------------------------------------------
  ;; cl-loop compiler
  ;; ------------------------------------------------------------------

  (defun collect-loop-pat-vars (pattern out)
    (cond
      ((nil? pattern) out)
      ((el-symobj? pattern)
        (unless (js-call out :some (lambda (s) (eq s pattern)))
          (js-call out :push pattern))
        out)
      ((el-cons? pattern)
        (collect-loop-pat-vars (get pattern :car) out)
        (collect-loop-pat-vars (get pattern :cdr) out))
      ((el-vector? pattern)
        (js-call (get pattern :items) :forEach (lambda (p) (collect-loop-pat-vars p out)))
        out)
      (t out)))

  (defun compile-cl-loop (ctx cenv form)
    (let* ((tokens (el-args form))
           (position 0)
           (vars (js-array))
           (raw-drivers (js-array))
           (raw-withs (js-array))
           (raw-intos (js-array))
           (raw-body (js-array))
           (initially (js-array))
           (finally (js-array))
           (finally-return (js-object :has false :form nil))
           (state (js-object :accKind nil :accSet false :name nil :hasAlwaysNever false)))
      (letfn ((peek () (if (< position (js-length tokens)) (aref tokens position) undefined))
              (next () (let ((token (aref tokens position))) (setq position (1+ position)) token))
              (keyword-is (name) (let ((token (peek))) (and (not (undefined? token)) (el-sym-is token name))))
              (forms-until-keyword ()
                (let ((forms (js-array)))
                  (while (and (< position (js-length tokens)) (not (el-loop-keyword? (peek))))
                    (js-call forms :push (next)))
                  forms))
              (parse-clause ()
                (let* ((token (next)) (word (el-symbol-name token)))
                  (cond
                    ((or (= word "collect") (= word "collecting") (= word "append") (= word "appending")
                         (= word "nconc") (= word "nconcing") (= word "concat") (= word "vconcat")
                         (= word "sum") (= word "summing") (= word "count") (= word "counting")
                         (= word "maximize") (= word "maximizing") (= word "minimize") (= word "minimizing"))
                      (let ((expr (next)) (into nil) (norm (el-loop-normalize word)))
                        (when (keyword-is "into")
                          (next)
                          (setq into (next))
                          (collect-loop-pat-vars into vars)
                          (js-call raw-intos :push (js-array into norm)))
                        (when (nil? into)
                          (unless (get state :accSet)
                            (put state :accSet t)
                            (put state :accKind norm)))
                        (js-object :type "acc" :word norm :expr expr :into into)))
                    ((or (= word "do") (= word "doing"))
                      (js-object :type "do" :forms (forms-until-keyword)))
                    ((or (= word "when") (= word "if") (= word "unless"))
                      (let* ((test (next)) (then (js-array (parse-clause))) (else (js-array)))
                        (while (keyword-is "and") (next) (js-call then :push (parse-clause)))
                        (when (keyword-is "else")
                          (next)
                          (js-call else :push (parse-clause))
                          (while (keyword-is "and") (next) (js-call else :push (parse-clause))))
                        (when (keyword-is "end") (next))
                        (js-object :type "cond" :negate (= word "unless") :test test :then then :else else)))
                    ((= word "return") (js-object :type "return" :expr (next)))
                    ((or (= word "while") (= word "until")) (js-object :type word :expr (next)))
                    ((or (= word "always") (= word "never") (= word "thereis"))
                      (when (or (= word "always") (= word "never")) (put state :hasAlwaysNever t))
                      (js-object :type word :expr (next)))
                    (t (el-signal "error" (str "Unsupported cl-loop clause " word)))))))
        (while (< position (js-length tokens))
          (let* ((token (peek)) (word (if (el-symobj? token) (get token :name) "")))
            (cond
              ((= word "named") (next) (put state :name (next)))
              ((or (= word "for") (= word "as"))
                (next)
                (let* ((variable (next)) (kind (el-symbol-name (next)))
                       (driver (js-object :var variable :kind kind :expr nil :by nil :fromExpr nil :toExpr nil
                                          :stepExpr nil :down false :inclusive false :then nil :using nil)))
                  (collect-loop-pat-vars variable vars)
                  (cond
                    ((or (= kind "in") (= kind "on") (= kind "in-ref"))
                      (put driver :expr (next))
                      (when (keyword-is "by") (next) (put driver :by (js-object :has t :form (next)))))
                    ((= kind "across") (put driver :expr (next)))
                    ((or (= kind "from") (= kind "upfrom") (= kind "downfrom") (= kind "to") (= kind "upto")
                         (= kind "below") (= kind "downto") (= kind "above") (= kind "by"))
                      (put driver :kind "number")
                      (setq position (1- position))
                      (let ((scanning t))
                        (while scanning
                          (let ((w (if (el-symobj? (peek)) (get (peek) :name) "")))
                            (cond
                              ((or (= w "from") (= w "upfrom")) (next) (put driver :fromExpr (js-object :has t :form (next))))
                              ((= w "downfrom") (next) (put driver :fromExpr (js-object :has t :form (next))) (put driver :down t))
                              ((or (= w "to") (= w "upto")) (next) (put driver :toExpr (js-object :has t :form (next))) (put driver :inclusive t))
                              ((= w "below") (next) (put driver :toExpr (js-object :has t :form (next))) (put driver :inclusive false))
                              ((= w "downto") (next) (put driver :toExpr (js-object :has t :form (next))) (put driver :inclusive t) (put driver :down t))
                              ((= w "above") (next) (put driver :toExpr (js-object :has t :form (next))) (put driver :inclusive false) (put driver :down t))
                              ((= w "by") (next) (put driver :stepExpr (js-object :has t :form (next))))
                              (t (setq scanning false)))))))
                    ((= kind "=")
                      (put driver :expr (next))
                      (when (keyword-is "then") (next) (put driver :then (js-object :has t :form (next)))))
                    ((= kind "being")
                      (when (or (keyword-is "the") (keyword-is "each")) (next))
                      (let ((what (el-symbol-name (next))))
                        (next)
                        (put driver :expr (next))
                        (put driver :kind (if (or (= what "hash-keys") (= what "hash-key")) "hash-keys"
                                            (if (or (= what "hash-values") (= what "hash-value")) "hash-values" "elements")))
                        (when (keyword-is "using")
                          (next)
                          (let ((using (next)))
                            (put driver :using (el-nth 1 using))
                            (collect-loop-pat-vars (el-nth 1 using) vars)))))
                    (t (el-signal "error" (str "Unsupported cl-loop for clause " kind))))
                  (js-call raw-drivers :push driver)))
              ((= word "repeat") (next) (js-call raw-drivers :push (js-object :var nil :kind "repeat" :expr (next))))
              ((= word "with")
                (next)
                (let ((variable (next)) (has-val false) (val-form nil))
                  (when (keyword-is "=") (next) (setq has-val t) (setq val-form (next)))
                  (collect-loop-pat-vars variable vars)
                  (js-call raw-withs :push (js-object :var variable :hasVal has-val :form val-form))
                  (while (keyword-is "and")
                    (next)
                    (let ((v2 (next)) (has2 false) (f2 nil))
                      (when (keyword-is "=") (next) (setq has2 t) (setq f2 (next)))
                      (collect-loop-pat-vars v2 vars)
                      (js-call raw-withs :push (js-object :var v2 :hasVal has2 :form f2))))))
              ((= word "initially") (next) (setq initially (js-call initially :concat (forms-until-keyword))))
              ((= word "finally")
                (next)
                (if (keyword-is "return")
                    (progn (next) (put finally-return :has t) (put finally-return :form (next)))
                  (setq finally (js-call finally :concat (forms-until-keyword)))))
              (t (js-call raw-body :push (parse-clause))))))
        (let* ((loop-cenv (make-cenv cenv))
               (dyn-var (ctx-gensym ctx "dyn"))
               (decls (js-array (str "(" dyn-var " (js-array))"))))
          (js-call vars :forEach
                   (lambda (sym)
                     (let ((js-var (ctx-gensym ctx "v"))
                           (sym-expr (ctx-sym ctx (get sym :name))))
                       (js-call decls :push (str "(" js-var " nil)"))
                       (js-call (get loop-cenv :vars) :set (get sym :name)
                                (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                       (js-call (get loop-cenv :consts) :delete (get sym :name)))))
          (letfn ((compile-clause (c)
                    (let ((t-kind (get c :type)))
                      (cond
                        ((= t-kind "acc")
                          (str "(js-object :type \"acc\" :word " (el-eliscript-string-literal (get c :word))
                               " :expr (lambda () " (compile-expr ctx loop-cenv (get c :expr)) ")"
                               " :into " (compile-quote ctx (get c :into)) ")"))
                        ((= t-kind "do")
                          (str "(js-object :type \"do\" :thunk (lambda () "
                               (compile-body ctx loop-cenv (get c :forms)) "))"))
                        ((= t-kind "cond")
                          (str "(js-object :type \"cond\" :negate " (if (get c :negate) "t" "false")
                               " :test (lambda () " (compile-expr ctx loop-cenv (get c :test)) ")"
                               " :then (js-array"
                               (js-call (js-call (get c :then) :map (lambda (sub) (str " " (compile-clause sub)))) :join "")
                               ") :else (js-array"
                               (js-call (js-call (get c :else) :map (lambda (sub) (str " " (compile-clause sub)))) :join "")
                               "))"))
                        (t
                          (str "(js-object :type " (el-eliscript-string-literal t-kind)
                               " :expr (lambda () " (compile-expr ctx loop-cenv (get c :expr)) "))")))))
                  (compile-driver (d)
                    (let ((kind (get d :kind)))
                      (cond
                        ((= kind "repeat")
                          (str "(js-object :kind \"repeat\" :expr (lambda () " (compile-expr ctx loop-cenv (get d :expr)) "))"))
                        ((= kind "number")
                          (str "(js-object :kind \"number\" :var " (compile-quote ctx (get d :var))
                               " :down " (if (get d :down) "t" "false")
                               " :inclusive " (if (get d :inclusive) "t" "false")
                               " :fromExpr " (if (nil? (get d :fromExpr)) "nil"
                                               (str "(lambda () " (compile-expr ctx loop-cenv (get (get d :fromExpr) :form)) ")"))
                               " :toExpr " (if (nil? (get d :toExpr)) "nil"
                                             (str "(lambda () " (compile-expr ctx loop-cenv (get (get d :toExpr) :form)) ")"))
                               " :stepExpr " (if (nil? (get d :stepExpr)) "nil"
                                               (str "(lambda () " (compile-expr ctx loop-cenv (get (get d :stepExpr) :form)) ")"))
                               ")"))
                        ((= kind "=")
                          (str "(js-object :kind \"=\" :var " (compile-quote ctx (get d :var))
                               " :expr (lambda () " (compile-expr ctx loop-cenv (get d :expr)) ")"
                               " :then " (if (nil? (get d :then)) "nil"
                                           (str "(lambda () " (compile-expr ctx loop-cenv (get (get d :then) :form)) ")"))
                               ")"))
                        ((or (= kind "in") (= kind "on") (= kind "in-ref"))
                          (str "(js-object :kind " (el-eliscript-string-literal kind)
                               " :var " (compile-quote ctx (get d :var))
                               " :expr (lambda () " (compile-expr ctx loop-cenv (get d :expr)) ")"
                               " :by " (if (nil? (get d :by)) "nil"
                                         (str "(lambda () " (compile-expr ctx loop-cenv (get (get d :by) :form)) ")"))
                               ")"))
                        (t
                          (str "(js-object :kind " (el-eliscript-string-literal kind)
                               " :var " (compile-quote ctx (get d :var))
                               " :using " (compile-quote ctx (get d :using))
                               " :expr (lambda () " (compile-expr ctx loop-cenv (get d :expr)) "))"))))))
            (let* ((s-param "__s") (v-param "__v")
                   (g-clauses (js-array))
                   (s-clauses (js-array)))
              (js-call vars :forEach
                       (lambda (sym)
                         (let ((info (js-call (get loop-cenv :vars) :get (get sym :name))))
                           (js-call g-clauses :push
                                    (str "((eq " s-param " " (get info :symExpr) ") "
                                         "(rt-read-var session " (get info :symExpr) " " (get info :jsVar) "))"))
                           (js-call s-clauses :push
                                    (str "((eq " s-param " " (get info :symExpr) ") "
                                         "(setq " (get info :jsVar) " (rt-bind-var session "
                                         (get info :symExpr) " " v-param " " dyn-var ")))")))))
              (js-call g-clauses :push "(t nil)")
              (js-call s-clauses :push "(t nil)")
              (let* ((acc-kind (get state :accKind))
                     (init-acc-expr
                       (if (not (get state :accSet)) "nil"
                         (cond ((or (= acc-kind "collect") (= acc-kind "append") (= acc-kind "nconc")) "(js-array)")
                               ((or (= acc-kind "sum") (= acc-kind "count")) "0")
                               ((= acc-kind "concat") "\"\"")
                               ((= acc-kind "vconcat") "(el-vector (js-array))")
                               (t "nil"))))
                     (spec-expr
                       (str "(js-object :name " (compile-quote ctx (get state :name))
                            " :accSet " (if (get state :accSet) "t" "false")
                            " :accKind " (if (nil? acc-kind) "nil" (el-eliscript-string-literal acc-kind))
                            " :initAcc " init-acc-expr
                            " :hasAlwaysNever " (if (get state :hasAlwaysNever) "t" "false")
                            " :withInits (js-array"
                            (js-call (js-call raw-withs :map
                                              (lambda (w)
                                                (str " (js-array " (compile-quote ctx (get w :var)) " "
                                                     (if (get w :hasVal)
                                                         (str "(lambda () " (compile-expr ctx loop-cenv (get w :form)) ")")
                                                       "nil")
                                                     ")")))
                                     :join "")
                            ") :intoInits (js-array"
                            (js-call (js-call raw-intos :map
                                              (lambda (pair)
                                                (let ((norm (aref pair 1)))
                                                  (str " (js-array " (compile-quote ctx (aref pair 0)) " "
                                                       (cond ((or (= norm "sum") (= norm "count")) "0")
                                                             ((= norm "concat") "\"\"")
                                                             ((= norm "vconcat") "(el-vector (js-array))")
                                                             (t "nil"))
                                                       ")"))))
                                     :join "")
                            ") :initially (lambda () " (compile-body ctx loop-cenv initially) ")"
                            " :finally (lambda () " (compile-body ctx loop-cenv finally) ")"
                            " :finallyReturn " (if (get finally-return :has)
                                                   (str "(lambda () " (compile-expr ctx loop-cenv (get finally-return :form)) ")")
                                                 "nil")
                            " :drivers (js-array"
                            (js-call (js-call raw-drivers :map (lambda (d) (str " " (compile-driver d)))) :join "")
                            ") :body (js-array"
                            (js-call (js-call raw-body :map (lambda (c) (str " " (compile-clause c)))) :join "")
                            "))")))
                (str "(let (" (js-call decls :join " ") ") "
                     "(try (rt-run-cl-loop session " spec-expr
                     " (lambda (" s-param ") (cond " (js-call g-clauses :join " ") "))"
                     " (lambda (" s-param " " v-param ") (cond " (js-call s-clauses :join " ") "))) "
                     "(finally (rt-restore-dyn session " dyn-var "))))"))))))))

  ;; ------------------------------------------------------------------
  ;; cl-defstruct compiler
  ;; ------------------------------------------------------------------

  (defun compile-cl-defstruct (ctx cenv form)
    (let* ((csession (get ctx :session))
           (spec (el-second form))
           (name (if (el-cons? spec) (el-symbol-name (get spec :car)) (el-symbol-name spec)))
           (options (if (el-cons? spec) (el-list-to-array (get spec :cdr)) (js-array)))
           (raw-slots (el-list-to-array (el-rest-after form 1)))
           (conc-name (str name "-"))
           (keyword-constructors (js-array))
           (boa-constructors (js-array))
           (default-constructor t)
           (copier (str "copy-" name))
           (predicate (str name "-p"))
           (parent nil))
      ;; Register in compile-time session so child structs and setf accessors know slots
      (try (el-eval csession form (el-root-env)) (catch _ nil))
      (js-call options :forEach
               (lambda (option)
                 (let* ((key (el-symbol-name (if (el-cons? option) (get option :car) option)))
                        (values (if (el-cons? option) (el-list-to-array (get option :cdr)) (js-array))))
                   (cond
                     ((= key ":conc-name")
                       (setq conc-name (if (or (= (js-length values) 0) (nil? (aref values 0))) ""
                                         (el-symbol-name-or-string (aref values 0)))))
                     ((= key ":constructor")
                       (cond
                         ((= (js-length values) 0) nil)
                         ((nil? (aref values 0)) (setq default-constructor false))
                         ((= (js-length values) 1)
                           (setq default-constructor false)
                           (js-call keyword-constructors :push (el-symbol-name (aref values 0))))
                         (t (js-call boa-constructors :push (js-array (aref values 0) (aref values 1))))))
                     ((= key ":copier")
                       (setq copier (if (or (= (js-length values) 0) (nil? (aref values 0))) nil (el-symbol-name (aref values 0)))))
                     ((= key ":predicate")
                       (setq predicate (if (or (= (js-length values) 0) (nil? (aref values 0))) nil (el-symbol-name (aref values 0)))))
                     ((= key ":include") (setq parent (el-symbol-name (aref values 0))))))))
      (when default-constructor (js-call keyword-constructors :push (str "make-" name)))
      (js-call keyword-constructors :forEach (lambda (c) (ctx-record-fn ctx c)))
      (js-call boa-constructors :forEach (lambda (entry) (ctx-record-fn ctx (el-symbol-name (aref entry 0)))))
      (unless (nil? predicate) (ctx-record-fn ctx predicate))
      (unless (nil? copier) (ctx-record-fn ctx copier))
      (let* ((own (js-call (js-call raw-slots :filter (lambda (s) (not (el-string? s))))
                           :map (lambda (s)
                                  (if (el-cons? s)
                                      (js-object :name (get s :car) :init (el-car (get s :cdr)))
                                    (js-object :name s :init nil)))))
             (inherited (if (nil? parent) (js-array)
                          (let ((info (js-call (get csession :structs) :get parent)))
                            (if (undefined? info) (js-array) (get info :slots)))))
             (all-slots (js-call inherited :concat own))
             (type-sym-expr (ctx-sym ctx name))
             (compiled-ctors (js-array)))
        (js-call (get csession :structs) :set name (js-object :parent parent :slots all-slots))
        (js-call all-slots :forEach
                 (lambda (slot)
                   (ctx-record-fn ctx (str conc-name (el-symbol-name (get slot :name))))))
        ;; Compile keyword constructors with progressive slot environment
        (js-call keyword-constructors :forEach
                 (lambda (ctor-name)
                   (let* ((args-var (ctx-gensym ctx "kargs"))
                          (plist-var (ctx-gensym ctx "plist"))
                          (dyn-var (ctx-gensym ctx "dyn"))
                          (ctor-cenv (make-cenv cenv))
                          (decls (js-array (str "(" plist-var " (el-list-from " args-var "))")
                                           (str "(" dyn-var " (js-array))")))
                          (steps (js-array))
                          (slot-vars (js-array)))
                     (js-call all-slots :forEach
                              (lambda (slot)
                                (let* ((sname (el-symbol-name (get slot :name)))
                                       (sym-expr (ctx-sym ctx sname))
                                       (kw-expr (ctx-sym ctx (str ":" sname)))
                                       (cell-var (ctx-gensym ctx "cell"))
                                       (js-var (ctx-gensym ctx "sv"))
                                       (init-expr (compile-expr ctx ctor-cenv (get slot :init))))
                                  (js-call decls :push (str "(" js-var " nil)"))
                                  (js-call steps :push
                                           (str "(let ((" cell-var " (el-plist-member " plist-var " " kw-expr " el-eq-test))) "
                                                "(setq " js-var " (rt-bind-var session " sym-expr " "
                                                "(if (nil? " cell-var ") " init-expr " (el-car-safe (get " cell-var " :cdr))) "
                                                dyn-var ")))"))
                                  (js-call (get ctor-cenv :vars) :set sname
                                           (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                                  (js-call slot-vars :push (str "(rt-read-var session " sym-expr " " js-var ")")))))
                     (js-call steps :push
                              (str "(js-object :kind \"record\" :items (js-array " type-sym-expr
                                   (js-call (js-call slot-vars :map (lambda (v) (str " " v))) :join "")
                                   "))"))
                     (js-call compiled-ctors :push
                              (str "(js-array " (ctx-sym ctx ctor-name)
                                   " (rt-wrap-fn " (el-eliscript-string-literal ctor-name) " nil "
                                   "(lambda (" args-var ") (let (" (js-call decls :join " ") ") "
                                   "(try (progn " (js-call steps :join " ") ") "
                                   "(finally (rt-restore-dyn session " dyn-var ")))))))")))))
        ;; Compile BOA constructors
        (js-call boa-constructors :forEach
                 (lambda (entry)
                   (let* ((ctor-sym (aref entry 0))
                          (ctor-name (el-symbol-name ctor-sym))
                          (boa-args (el-boa-arglist (aref entry 1) all-slots))
                          (bound-vars (collect-destructure-vars boa-args (js-array)))
                          (aux-items (js-array)))
                     (js-call all-slots :forEach
                              (lambda (slot)
                                (unless (js-call bound-vars :some (lambda (s) (eq s (get slot :name))))
                                  (js-call aux-items :push (el-list (get slot :name) (get slot :init))))))
                     (let* ((full-arglist (if (= (js-length aux-items) 0)
                                              boa-args
                                            (el-append (js-array boa-args (el-cons s-aux (el-list-from aux-items))))))
                            (all-vars (collect-destructure-vars full-arglist (js-array)))
                            (args-var (ctx-gensym ctx "bargs"))
                            (dyn-var (ctx-gensym ctx "dyn"))
                            (boa-cenv (make-cenv cenv))
                            (decls (js-array (str "(" dyn-var " (js-array))"))))
                       (js-call all-vars :forEach
                                (lambda (sym)
                                  (let ((js-var (ctx-gensym ctx "v"))
                                        (sym-expr (ctx-sym ctx (get sym :name))))
                                    (js-call decls :push (str "(" js-var " nil)"))
                                    (js-call (get boa-cenv :vars) :set (get sym :name)
                                             (js-object :jsVar js-var :symExpr sym-expr :isConst false)))))
                       (let ((pat-expr (compile-destructure-pattern ctx boa-cenv full-arglist))
                             (setter-expr (compile-setter-branches all-vars boa-cenv dyn-var))
                             (item-reads
                               (js-call all-slots :map
                                        (lambda (slot)
                                          (compile-var-read ctx boa-cenv (get slot :name))))))
                         (js-call compiled-ctors :push
                                  (str "(js-array " (ctx-sym ctx ctor-name)
                                       " (rt-wrap-fn " (el-eliscript-string-literal ctor-name) " " (compile-quote ctx boa-args)
                                       " (lambda (" args-var ") (let (" (js-call decls :join " ") ") "
                                       "(try (progn (rt-destructure session " pat-expr " (el-list-from " args-var ") "
                                       setter-expr " " dyn-var ") "
                                       "(js-object :kind \"record\" :items (js-array " type-sym-expr
                                       (js-call (js-call item-reads :map (lambda (r) (str " " r))) :join "")
                                       "))) (finally (rt-restore-dyn session " dyn-var ")))))))")))))))
        (str "(rt-defstruct session (js-object :name " (el-eliscript-string-literal name)
             " :parent " (if (nil? parent) "nil" (el-eliscript-string-literal parent))
             " :concName " (el-eliscript-string-literal conc-name)
             " :copier " (if (nil? copier) "nil" (el-eliscript-string-literal copier))
             " :predicate " (if (nil? predicate) "nil" (el-eliscript-string-literal predicate))
             " :kwCtors (js-array)"
             " :boaCtors (js-array"
             (js-call (js-call compiled-ctors :map (lambda (c) (str " " c))) :join "")
             ") :ownSlots (js-array"
             (js-call (js-call own :map
                               (lambda (s)
                                 (str " (js-object :name " (compile-quote ctx (get s :name))
                                      " :initFn (lambda () " (compile-expr ctx cenv (get s :init)) "))")))
                      :join "")
             ")))"))))

  ;; ------------------------------------------------------------------
  ;; Bind, Case, Tail-Recur, Guards, Loops, Condition-Case, Modules
  ;; ------------------------------------------------------------------

  (defun compile-bind-pattern (ctx cenv pattern)
    (cond
      ((or (nil? pattern) (el-symobj? pattern)) (compile-quote ctx pattern))
      ((el-vector? pattern)
        (str "(el-vector (js-array"
             (js-call (js-call (get pattern :items) :map (lambda (p) (str " " (compile-bind-pattern ctx cenv p)))) :join "")
             "))"))
      ((el-cons? pattern)
        (let* ((items (el-list-to-array pattern))
               (head (if (el-symobj? (aref items 0)) (get (aref items 0) :name) "")))
          (if (= head ":map")
              (let ((out (js-array (compile-quote ctx (aref items 0)))))
                (js-call (js-call items :slice 1) :forEach
                         (lambda (entry)
                           (let ((key (el-car entry))
                                 (sub (el-nth 1 entry)))
                             (if (and (el-cons? sub) (eq (get sub :car) s-default))
                                 (js-call out :push
                                          (str "(el-list " (compile-quote ctx key)
                                               " (el-list " (ctx-sym ctx "default") " "
                                               (compile-bind-pattern ctx cenv (el-nth 1 sub))
                                               " (lambda () " (compile-expr ctx cenv (el-nth 2 sub)) ")))"))
                               (js-call out :push
                                        (str "(el-list " (compile-quote ctx key) " "
                                             (compile-bind-pattern ctx cenv sub) ")"))))))
                (str "(el-list " (js-call out :join " ") ")"))
            (str "(el-list"
                 (js-call (js-call items :map (lambda (p) (str " " (compile-bind-pattern ctx cenv p)))) :join "")
                 ")"))))
      (t (compile-quote ctx pattern))))

  (defun compile-let-bind (ctx cenv form)
    (let* ((bindings (el-list-to-array (el-second form)))
           (body (el-rest-after form 1)))
      (if (= (js-length bindings) 0)
          (compile-list-body ctx cenv body)
        (let ((dyn-var (ctx-gensym ctx "dyn"))
              (next-cenv (make-cenv cenv))
              (decls (js-array))
              (steps (js-array)))
          (js-call decls :push (str "(" dyn-var " (js-array))"))
          (js-call bindings :forEach
                   (lambda (b)
                     (let* ((pat (el-car b))
                            (val-form (el-nth 1 b))
                            (seen (new globalThis.Set))
                            (val-expr (compile-expr ctx next-cenv val-form))
                            (vars (js-array)))
                       (el-collect-pattern-vars pat seen)
                       (js-call seen :forEach (lambda (v) (js-call vars :push (if (el-symobj? v) v (el-intern (str v))))))
                       (js-call vars :forEach
                                (lambda (sym)
                                  (let ((js-var (ctx-gensym ctx "v"))
                                        (sym-expr (ctx-sym ctx (get sym :name))))
                                    (js-call decls :push (str "(" js-var " nil)"))
                                    (js-call (get next-cenv :vars) :set (get sym :name)
                                             (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                                    (js-call (get next-cenv :consts) :delete (get sym :name)))))
                       (let ((pat-expr (compile-bind-pattern ctx next-cenv pat))
                             (setter-expr (compile-setter-branches vars next-cenv dyn-var)))
                         (js-call steps :push
                                  (str "(rt-match-binding session " pat-expr " " val-expr " " setter-expr " " dyn-var ")"))))))
          (js-call steps :push (compile-list-body ctx next-cenv body))
          (str "(let (" (js-call decls :join " ") ") "
               "(try (progn " (js-call steps :join " ") ") "
               "(finally (rt-restore-dyn session " dyn-var "))))")))))

  (defun compile-bind-fn (ctx cenv specs body-list name)
    (let ((required (js-array))
          (optional (js-array))
          (seen (new globalThis.Set))
          (mode "required"))
      (js-call (el-list-to-array specs) :forEach
               (lambda (spec)
                 (cond
                   ((eq spec s-optional) (setq mode "optional"))
                   ((eq spec s-rest) (el-compile-error (str "ELI-B0011: &rest forbidden in " name)))
                   ((= mode "required")
                     (el-collect-pattern-vars spec seen)
                     (js-call required :push spec))
                   (t
                     (let ((pair (if (el-cons? spec) (el-list-to-array spec) (js-array spec nil))))
                       (el-collect-pattern-vars (aref pair 0) seen)
                       (js-call optional :push pair))))))
      (let* ((args-var (ctx-gensym ctx "bargs"))
             (dyn-var (ctx-gensym ctx "dyn"))
             (fn-cenv (make-cenv cenv))
             (vars (js-array))
             (decls (js-array (str "(" dyn-var " (js-array))")))
             (steps (js-array)))
        (put fn-cenv :inRecur false)
        (js-call seen :forEach (lambda (v) (js-call vars :push (if (el-symobj? v) v (el-intern (str v))))))
        (js-call vars :forEach
                 (lambda (sym)
                   (let ((js-var (ctx-gensym ctx "v"))
                         (sym-expr (ctx-sym ctx (get sym :name))))
                     (js-call decls :push (str "(" js-var " nil)"))
                     (js-call (get fn-cenv :vars) :set (get sym :name)
                              (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                     (js-call (get fn-cenv :consts) :delete (get sym :name)))))
        (let ((setter-expr (compile-setter-branches vars fn-cenv dyn-var)))
          (js-call required :forEach
                   (lambda (pat idx)
                     (js-call steps :push
                              (str "(rt-match-binding session " (compile-bind-pattern ctx fn-cenv pat)
                                   " (el-opt (aref " args-var " " idx ")) " setter-expr " " dyn-var ")"))))
          (js-call optional :forEach
                   (lambda (pair idx)
                     (let ((pos (+ (js-length required) idx))
                           (pat-expr (compile-bind-pattern ctx fn-cenv (aref pair 0)))
                           (def-expr (compile-expr ctx fn-cenv (el-opt (aref pair 1)))))
                       (js-call steps :push
                                (str "(rt-match-binding session " pat-expr
                                     " (if (rt-gt (js-length " args-var ") " pos ") (aref " args-var " " pos ") " def-expr ") "
                                     setter-expr " " dyn-var ")")))))
          (js-call steps :push (compile-list-body ctx fn-cenv body-list))
          (str "(rt-wrap-fn " (el-eliscript-string-literal name) " nil "
               "(lambda (" args-var ") (let (" (js-call decls :join " ") ") "
               "(try (progn " (js-call steps :join " ") ") "
               "(finally (rt-restore-dyn session " dyn-var "))))))")))))

  (defun compile-case-fn (ctx cenv clauses name)
    (let ((fixed (new globalThis.Map))
          (rest-clause nil)
          (fixed-entries (js-array)))
      (js-call clauses :forEach
               (lambda (clause)
                 (let* ((params (el-list-to-array (el-car clause)))
                        (body (el-cdr clause))
                        (rest-index (js-call params :findIndex (lambda (p) (eq p s-rest)))))
                   (when (js-call params :some (lambda (p) (eq p s-optional)))
                     (el-compile-error (str "ELI-A0010: &optional forbidden in " name)))
                   (if (>= rest-index 0)
                       (progn
                         (unless (nil? rest-clause) (el-compile-error "ELI-A0012: multiple &rest clauses"))
                         (setq rest-clause (js-object :min rest-index
                                                      :names (js-call params :slice 0 rest-index)
                                                      :rest (aref params (1+ rest-index))
                                                      :body body)))
                     (progn
                       (when (js-call fixed :has (js-length params))
                         (el-compile-error (str "ELI-A0011: duplicate arity " (js-length params))))
                       (js-call fixed :set (js-length params) (js-object :names params :body body)))))))
      (unless (nil? rest-clause)
        (js-call fixed :forEach
                 (lambda (v arity)
                   (when (>= arity (get rest-clause :min))
                     (el-compile-error "ELI-A0012: fixed arity overlaps &rest")))))
      (js-call fixed :forEach
               (lambda (branch arity)
                 (let* ((args-var (ctx-gensym ctx "cargs"))
                        (dyn-var (ctx-gensym ctx "dyn"))
                        (b-cenv (make-cenv cenv))
                        (decls (js-array (str "(" dyn-var " (js-array))")))
                        (steps (js-array)))
                   (put b-cenv :inRecur false)
                   (js-call (get branch :names) :forEach
                            (lambda (sym idx)
                              (let ((js-var (ctx-gensym ctx "v"))
                                    (sym-expr (ctx-sym ctx (get sym :name))))
                                (js-call decls :push (str "(" js-var " nil)"))
                                (js-call steps :push
                                         (str "(setq " js-var " (rt-bind-var session " sym-expr
                                              " (aref " args-var " " idx ") " dyn-var "))"))
                                (js-call (get b-cenv :vars) :set (get sym :name)
                                         (js-object :jsVar js-var :symExpr sym-expr :isConst false)))))
                   (js-call steps :push (compile-list-body ctx b-cenv (get branch :body)))
                   (js-call fixed-entries :push
                            (str "(js-array " arity " (lambda (" args-var ") "
                                 "(let (" (js-call decls :join " ") ") "
                                 "(try (progn " (js-call steps :join " ") ") "
                                 "(finally (rt-restore-dyn session " dyn-var "))))))")))))
      (let ((rest-expr
              (if (nil? rest-clause)
                  "nil"
                (let* ((args-var (ctx-gensym ctx "cargs"))
                       (dyn-var (ctx-gensym ctx "dyn"))
                       (r-cenv (make-cenv cenv))
                       (decls (js-array (str "(" dyn-var " (js-array))")))
                       (steps (js-array))
                       (min-a (get rest-clause :min))
                       (rest-sym (get rest-clause :rest)))
                  (put r-cenv :inRecur false)
                  (js-call (get rest-clause :names) :forEach
                           (lambda (sym idx)
                             (let ((js-var (ctx-gensym ctx "v"))
                                   (sym-expr (ctx-sym ctx (get sym :name))))
                               (js-call decls :push (str "(" js-var " nil)"))
                               (js-call steps :push
                                        (str "(setq " js-var " (rt-bind-var session " sym-expr
                                             " (aref " args-var " " idx ") " dyn-var "))"))
                               (js-call (get r-cenv :vars) :set (get sym :name)
                                        (js-object :jsVar js-var :symExpr sym-expr :isConst false)))))
                  (let ((r-var (ctx-gensym ctx "v"))
                        (r-sym-expr (ctx-sym ctx (get rest-sym :name))))
                    (js-call decls :push (str "(" r-var " nil)"))
                    (js-call steps :push
                             (str "(setq " r-var " (rt-bind-var session " r-sym-expr
                                  " (rt-rest-arg " args-var " " min-a ") " dyn-var "))"))
                    (js-call (get r-cenv :vars) :set (get rest-sym :name)
                             (js-object :jsVar r-var :symExpr r-sym-expr :isConst false)))
                  (js-call steps :push (compile-list-body ctx r-cenv (get rest-clause :body)))
                  (str "(js-object :min " min-a " :fn (lambda (" args-var ") "
                       "(let (" (js-call decls :join " ") ") "
                       "(try (progn " (js-call steps :join " ") ") "
                       "(finally (rt-restore-dyn session " dyn-var "))))))")))))
        (str "(rt-make-case-fn " (el-eliscript-string-literal name)
             " (new globalThis.Map (js-array"
             (js-call (js-call fixed-entries :map (lambda (e) (str " " e))) :join "")
             ")) " rest-expr ")"))))

  (defun compile-recur-loop (ctx cenv names init-exprs body-array)
    (el-verify-recur-tail body-array t)
    (let* ((dyn-var (ctx-gensym ctx "dyn"))
           (res-var (ctx-gensym ctx "rres"))
           (run-var (ctx-gensym ctx "rrun"))
           (sig-var (ctx-gensym ctx "rsig"))
           (loop-cenv (make-cenv cenv))
           (decls (js-array (str "(" dyn-var " (js-array))")
                            (str "(" res-var " nil)")
                            (str "(" run-var " t)")))
           (init-steps (js-array))
           (rebind-steps (js-array)))
      (put loop-cenv :inRecur t)
      (js-call names :forEach
               (lambda (sym idx)
                 (let ((js-var (ctx-gensym ctx "v"))
                       (sym-expr (ctx-sym ctx (get sym :name)))
                       (init-expr (aref init-exprs idx)))
                   (js-call decls :push (str "(" js-var " nil)"))
                   (js-call init-steps :push
                            (str "(setq " js-var " (rt-bind-var session " sym-expr " " init-expr " " dyn-var "))"))
                   (js-call rebind-steps :push
                            (str "(setq " js-var " (rt-write-var session " sym-expr
                                 " (el-opt (aref (get " sig-var " :args) " idx "))))"))
                   (js-call (get loop-cenv :vars) :set (get sym :name)
                            (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                   (js-call (get loop-cenv :consts) :delete (get sym :name)))))
      (let ((body-expr (compile-body ctx loop-cenv body-array)))
        (str "(let (" (js-call decls :join " ") ") "
             "(try (progn " (js-call init-steps :join " ")
             (if (> (js-length init-steps) 0) " " "")
             "(while " run-var " "
             "(try (progn (setq " res-var " " body-expr ") (setq " run-var " false)) "
             "(catch " sig-var " "
             "(if (and (not (nullish? " sig-var ")) (get " sig-var " :eliscriptRecur)) "
             "(progn " (js-call rebind-steps :join " ") ") "
             "(throw " sig-var "))))) "
             res-var ") "
             "(finally (rt-restore-dyn session " dyn-var "))))"))))

  (defun compile-let-guards (ctx cenv spec then-fn else-fn)
    (let* ((bindings-list (if (and (el-cons? spec) (el-symobj? (get spec :car)) (not (nil? (get spec :car))))
                              (el-list spec)
                            spec))
           (bindings (el-list-to-array bindings-list))
           (dyn-var (ctx-gensym ctx "dyn"))
           (ok-var (ctx-gensym ctx "ok"))
           (guard-cenv (make-cenv cenv))
           (decls (js-array (str "(" dyn-var " (js-array))") (str "(" ok-var " t)")))
           (steps (js-array)))
      (js-call bindings :forEach
               (lambda (binding)
                 (cond
                   ((el-symobj? binding)
                     (js-call steps :push
                              (str "(when " ok-var " (when (nil? " (compile-expr ctx guard-cenv binding) ") (setq " ok-var " false)))")))
                   ((nil? (el-cdr binding))
                     (js-call steps :push
                              (str "(when " ok-var " (when (nil? " (compile-expr ctx guard-cenv (get binding :car)) ") (setq " ok-var " false)))")))
                   (t
                     (let* ((sym (get binding :car))
                            (val-form (el-car (get binding :cdr)))
                            (val-expr (compile-expr ctx guard-cenv val-form))
                            (js-var (ctx-gensym ctx "v"))
                            (tmp-var (ctx-gensym ctx "gv"))
                            (sym-expr (ctx-sym ctx (get sym :name))))
                       (js-call decls :push (str "(" js-var " nil)"))
                       (js-call steps :push
                                (str "(when " ok-var " (let ((" tmp-var " " val-expr ")) "
                                     "(if (nil? " tmp-var ") (setq " ok-var " false) "
                                     "(setq " js-var " (rt-bind-var session " sym-expr " " tmp-var " " dyn-var ")))))"))
                       (js-call (get guard-cenv :vars) :set (get sym :name)
                                (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                       (js-call (get guard-cenv :consts) :delete (get sym :name)))))))
      (str "(let (" (js-call decls :join " ") ") "
           "(try (progn " (js-call steps :join " ")
           (if (> (js-length steps) 0) " " "")
           "(if " ok-var " " (funcall then-fn guard-cenv) " " (funcall else-fn cenv) ")) "
           "(finally (rt-restore-dyn session " dyn-var "))))")))

  (defun compile-dolist (ctx cenv form is-cl)
    (let* ((spec (el-second form))
           (var-sym (el-car spec))
           (list-form (el-car (el-cdr spec)))
           (res-form (el-car (el-cdr (el-cdr spec))))
           (body (el-rest-after form 1))
           (cur-var (ctx-gensym ctx "cur"))
           (dyn-var (ctx-gensym ctx "dyn"))
           (js-var (ctx-gensym ctx "v"))
           (sym-expr (ctx-sym ctx (get var-sym :name)))
           (iter-cenv (make-cenv cenv)))
      (js-call (get iter-cenv :vars) :set (get var-sym :name)
               (js-object :jsVar js-var :symExpr sym-expr :isConst false))
      (js-call (get iter-cenv :consts) :delete (get var-sym :name))
      (let ((core-expr
              (str "(let ((" cur-var " " (compile-expr ctx cenv list-form) ")) "
                   "(while (el-cons? " cur-var ") "
                   "(let ((" dyn-var " (js-array)) (" js-var " nil)) "
                   "(try (progn (setq " js-var " (rt-bind-var session " sym-expr " (el-opt (get " cur-var " :car)) " dyn-var ")) "
                   (compile-list-body ctx iter-cenv body) ") "
                   "(finally (rt-restore-dyn session " dyn-var ")))) "
                   "(setq " cur-var " (get " cur-var " :cdr))) "
                   (if (nil? res-form)
                       "nil"
                     (str "(let ((" dyn-var " (js-array)) (" js-var " nil)) "
                          "(try (progn (setq " js-var " (rt-bind-var session " sym-expr " nil " dyn-var ")) "
                          (compile-expr ctx iter-cenv res-form) ") "
                          "(finally (rt-restore-dyn session " dyn-var "))))"))
                   ")")))
        (if is-cl
            (str "(el-catch-block session nil (lambda () " core-expr "))")
          core-expr))))

  (defun compile-dotimes (ctx cenv form is-cl)
    (let* ((spec (el-second form))
           (var-sym (el-car spec))
           (count-form (el-car (el-cdr spec)))
           (res-form (el-car (el-cdr (el-cdr spec))))
           (body (el-rest-after form 1))
           (cnt-var (ctx-gensym ctx "cnt"))
           (idx-var (ctx-gensym ctx "idx"))
           (dyn-var (ctx-gensym ctx "dyn"))
           (js-var (ctx-gensym ctx "v"))
           (sym-expr (ctx-sym ctx (get var-sym :name)))
           (iter-cenv (make-cenv cenv)))
      (js-call (get iter-cenv :vars) :set (get var-sym :name)
               (js-object :jsVar js-var :symExpr sym-expr :isConst false))
      (js-call (get iter-cenv :consts) :delete (get var-sym :name))
      (let ((core-expr
              (str "(let ((" cnt-var " (el-num " (compile-expr ctx cenv count-form) ")) (" idx-var " 0)) "
                   "(while (rt-lt " idx-var " " cnt-var ") "
                   "(let ((" dyn-var " (js-array)) (" js-var " nil)) "
                   "(try (progn (setq " js-var " (rt-bind-var session " sym-expr " " idx-var " " dyn-var ")) "
                   (compile-list-body ctx iter-cenv body) ") "
                   "(finally (rt-restore-dyn session " dyn-var ")))) "
                   "(setq " idx-var " (1+ " idx-var "))) "
                   (if (nil? res-form)
                       "nil"
                     (str "(let ((" dyn-var " (js-array)) (" js-var " nil)) "
                          "(try (progn (setq " js-var " (rt-bind-var session " sym-expr " " cnt-var " " dyn-var ")) "
                          (compile-expr ctx iter-cenv res-form) ") "
                          "(finally (rt-restore-dyn session " dyn-var "))))"))
                   ")")))
        (if is-cl
            (str "(el-catch-block session nil (lambda () " core-expr "))")
          core-expr))))

  (defun compile-seq-doseq (ctx cenv form)
    (let* ((spec (el-second form))
           (var-sym (el-car spec))
           (seq-form (el-car (el-cdr spec)))
           (body (el-rest-after form 1))
           (items-var (ctx-gensym ctx "items"))
           (idx-var (ctx-gensym ctx "idx"))
           (dyn-var (ctx-gensym ctx "dyn"))
           (js-var (ctx-gensym ctx "v"))
           (sym-expr (ctx-sym ctx (get var-sym :name)))
           (iter-cenv (make-cenv cenv)))
      (js-call (get iter-cenv :vars) :set (get var-sym :name)
               (js-object :jsVar js-var :symExpr sym-expr :isConst false))
      (js-call (get iter-cenv :consts) :delete (get var-sym :name))
      (str "(let ((" items-var " (el-seq-items " (compile-expr ctx cenv seq-form) ")) (" idx-var " 0)) "
           "(while (rt-lt " idx-var " (js-length " items-var ")) "
           "(let ((" dyn-var " (js-array)) (" js-var " nil)) "
           "(try (progn (setq " js-var " (rt-bind-var session " sym-expr " (el-opt (aref " items-var " " idx-var ")) " dyn-var ")) "
           (compile-list-body ctx iter-cenv body) ") "
           "(finally (rt-restore-dyn session " dyn-var ")))) "
           "(setq " idx-var " (1+ " idx-var "))) nil)")))

  (defun compile-condition-case (ctx cenv form)
    (let* ((var-sym (el-second form))
           (body-form (el-third form))
           (raw-handlers (el-list-to-array (el-rest-after form 2)))
           (success-clause (js-call raw-handlers :find (lambda (h) (and (el-cons? h) (el-sym-is (get h :car) ":success")))))
           (err-clauses (js-call raw-handlers :filter (lambda (h) (not (and (el-cons? h) (el-sym-is (get h :car) ":success"))))))
           (compiled-handlers (js-array)))
      (letfn ((compile-handler-fn (clause-body)
                (let ((val-param (ctx-gensym ctx "cv")))
                  (if (or (nil? var-sym) (not (el-symobj? var-sym)))
                      (str "(lambda (" val-param ") " (compile-list-body ctx cenv clause-body) ")")
                    (let* ((dyn-var (ctx-gensym ctx "dyn"))
                           (js-var (ctx-gensym ctx "v"))
                           (sym-expr (ctx-sym ctx (get var-sym :name)))
                           (h-cenv (make-cenv cenv)))
                      (js-call (get h-cenv :vars) :set (get var-sym :name)
                               (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                      (js-call (get h-cenv :consts) :delete (get var-sym :name))
                      (str "(lambda (" val-param ") "
                           "(let ((" dyn-var " (js-array)) (" js-var " nil)) "
                           "(try (progn (setq " js-var " (rt-bind-var session " sym-expr " " val-param " " dyn-var ")) "
                           (compile-list-body ctx h-cenv clause-body) ") "
                           "(finally (rt-restore-dyn session " dyn-var ")))))"))))))
        (js-call err-clauses :forEach
                 (lambda (h)
                   (let ((conds (el-handler-conditions (el-car h))))
                     (js-call compiled-handlers :push
                              (str "(js-object :conds (js-array"
                                   (js-call (js-call conds :map (lambda (c) (str " " (el-eliscript-string-literal c)))) :join "")
                                   ") :fn " (compile-handler-fn (el-cdr h)) ")")))))
        (str "(rt-condition-case session (lambda () " (compile-expr ctx cenv body-form) ") "
             (if (undefined? success-clause) "nil" (compile-handler-fn (el-cdr success-clause)))
             " (js-array"
             (js-call (js-call compiled-handlers :map (lambda (ch) (str " " ch))) :join "")
             "))"))))

  (defun compile-defmodule (ctx cenv form)
    (let* ((mod-sym (el-second form))
           (mod-name (el-symbol-name mod-sym))
           (forms (el-list-to-array (el-rest-after form 1)))
           (consts (new globalThis.Set))
           (mod-cenv (make-cenv cenv))
           (decls (js-array))
           (steps (js-array))
           (exp-fns-var (ctx-gensym ctx "efns"))
           (exp-vals-var (ctx-gensym ctx "evals"))
           (dyn-var (ctx-gensym ctx "dyn")))
      (put mod-cenv :moduleName mod-name)
      (js-call decls :push (str "(" exp-fns-var " (new globalThis.Map))"))
      (js-call decls :push (str "(" exp-vals-var " (new globalThis.Map))"))
      (js-call decls :push (str "(" dyn-var " (js-array))"))
      (js-call forms :forEach
               (lambda (f)
                 (when (and (el-cons? f) (el-sym-is (get f :car) "defconst-lexical"))
                   (js-call consts :add (el-second f)))))
      (when (> (get consts :size) 0)
        (el-check-const-mutation forms consts mod-name))
      ;; Pre-bind lexical vars and functions in module scope
      (js-call forms :forEach
               (lambda (sub)
                 (when (el-cons? sub)
                   (let ((head (el-symbol-name (get sub :car))))
                     (cond
                       ((or (= head "defconst-lexical") (= head "defvar-lexical"))
                         (let* ((sym (el-second sub))
                                (sname (get sym :name))
                                (js-var (ctx-gensym ctx "mv"))
                                (sym-expr (ctx-sym ctx sname)))
                           (js-call decls :push (str "(" js-var " nil)"))
                           (js-call (get mod-cenv :vars) :set sname
                                    (js-object :jsVar js-var :symExpr sym-expr :isConst false))))
                       ((= head "defun-lexical")
                         (let* ((sym (el-second sub))
                                (sname (get sym :name))
                                (fn-var (ctx-gensym ctx "mf")))
                           (js-call decls :push (str "(" fn-var " nil)"))
                           (js-call (get mod-cenv :fns) :set sname fn-var))))))))
      (js-call forms :forEach
               (lambda (sub)
                 (if (not (el-cons? sub))
                     (js-call steps :push (compile-expr ctx mod-cenv sub))
                   (let ((head (el-symbol-name (get sub :car))))
                     (cond
                       ((or (= head "defconst-lexical") (= head "defvar-lexical"))
                         (let* ((sym (el-second sub))
                                (sname (get sym :name))
                                (info (js-call (get mod-cenv :vars) :get sname))
                                (val-expr (compile-expr ctx mod-cenv (el-third sub))))
                           (js-call steps :push
                                    (str "(setq " (get info :jsVar) " (rt-bind-var session "
                                         (get info :symExpr) " " val-expr " " dyn-var "))"))
                           (when (= head "defconst-lexical")
                             (js-call (get mod-cenv :consts) :add sname))))
                       ((= head "defun-lexical")
                         (let* ((sym (el-second sub))
                                (sname (get sym :name))
                                (fn-var (js-call (get mod-cenv :fns) :get sname)))
                           (js-call steps :push
                                    (str "(setq " fn-var " "
                                         (compile-lambda-impl ctx mod-cenv (el-rest-after sub 1) sname false nil)
                                         ")"))))
                       ((= head "export-functions")
                         (js-call (el-list-to-array (get sub :cdr)) :forEach
                                  (lambda (s)
                                    (let ((sname (get s :name))
                                          (sym-expr (ctx-sym ctx (get s :name))))
                                      (if (js-call (get mod-cenv :fns) :has sname)
                                          (js-call steps :push
                                                   (str "(js-call " exp-fns-var " :set " sym-expr " "
                                                        (js-call (get mod-cenv :fns) :get sname) ")"))
                                        (js-call steps :push
                                                 (str "(js-call " exp-fns-var " :set " sym-expr
                                                      " (js-call (get session :functions) :get " sym-expr "))")))))))
                       ((= head "export-values")
                         (js-call (el-list-to-array (get sub :cdr)) :forEach
                                  (lambda (s)
                                    (let ((sym-expr (ctx-sym ctx (get s :name))))
                                      (js-call steps :push
                                               (str "(js-call " exp-vals-var " :set " sym-expr
                                                    " (lambda () " (compile-var-read ctx mod-cenv s) "))"))))))
                       (t (js-call steps :push (compile-expr ctx mod-cenv sub))))))))
      (js-call steps :push
               (str "(rt-register-module session " (el-eliscript-string-literal mod-name)
                    " " exp-fns-var " " exp-vals-var ")"))
      (js-call steps :push (compile-quote ctx mod-sym))
      (str "(let (" (js-call decls :join " ") ") "
           "(try (progn " (js-call steps :join " ") ") "
           "(finally (rt-restore-dyn session " dyn-var "))))")))

  ;; ------------------------------------------------------------------
  ;; Main Expression Compiler (compile-expr)
  ;; ------------------------------------------------------------------

  (defun compile-expr (ctx cenv form)
    (let ((csession (get ctx :session)))
      (cond
        ((nil? form) "nil")
        ((eq form t) "t")
        ((or (el-integer? form) (el-float? form)) (compile-number form))
        ((el-string? form) (el-eliscript-string-literal form))
        ((el-keyword? form) (ctx-sym ctx (get form :name)))
        ((el-symobj? form) (compile-var-read ctx cenv form))
        ((not (el-cons? form)) (compile-quote ctx form))
        (t
          (let* ((head (get form :car))
                 (name (if (el-symobj? head) (get head :name) "")))
            (cond
              ((not (el-symobj? head))
                (let ((args (el-list-to-array (get form :cdr))))
                  (str "(rt-call-fn session " (compile-expr ctx cenv head) " (js-array"
                       (js-call (js-call args :map (lambda (a) (str " " (compile-expr ctx cenv a)))) :join "")
                       "))")))
              ;; Special forms & core language constructs
              ((= name "quote") (compile-quote ctx (el-second form)))
              ((= name "function")
                (let ((target (el-second form)))
                  (cond
                    ((and (el-symobj? target) (js-call (get cenv :fns) :has (get target :name)))
                      (js-call (get cenv :fns) :get (get target :name)))
                    ((and (el-cons? target) (eq (get target :car) s-lambda))
                      (compile-lambda-impl ctx cenv (get target :cdr) "lambda" false nil))
                    (t (compile-quote ctx target)))))
              ((= name "`") (compile-backquote ctx cenv (el-second form) 1))
              ((or (= name "progn") (= name "eval-and-compile") (= name "with-no-warnings")
                   (= name "save-restriction") (= name "with-demoted-errors") (= name "inline")
                   (= name "with-local-quit") (= name "with-syntax-table")
                   (= name "combine-after-change-calls") (= name "with-silent-modifications")
                   (= name "save-mark-and-excursion"))
                (when (= name "eval-and-compile")
                  (try (el-eval-body csession (el-list-to-array (get form :cdr)) (el-root-env)) (catch _ nil)))
                (compile-list-body ctx cenv (get form :cdr)))
              ((= name "eval-when-compile")
                (let ((val (try (el-eval-body csession (el-list-to-array (get form :cdr)) (el-root-env))
                             (catch _ nil))))
                  (compile-quote ctx val)))
              ((or (= name "with-suppressed-warnings") (= name "with-eval-after-load"))
                (compile-list-body ctx cenv (el-rest-after form 1)))
              ((= name "prog1")
                (let ((v1 (ctx-gensym ctx "p1"))
                      (rest (el-list-to-array (el-rest-after form 1))))
                  (if (= (js-length rest) 0)
                      (compile-expr ctx cenv (el-second form))
                    (str "(let ((" v1 " " (compile-expr ctx cenv (el-second form)) ")) "
                         (compile-body ctx cenv rest) " " v1 ")"))))
              ((= name "prog2")
                (let ((v2 (ctx-gensym ctx "p2"))
                      (rest (el-list-to-array (el-rest-after form 2))))
                  (str "(progn " (compile-expr ctx cenv (el-second form)) " "
                       "(let ((" v2 " " (compile-expr ctx cenv (el-third form)) ")) "
                       (if (= (js-length rest) 0) "" (str (compile-body ctx cenv rest) " "))
                       v2 "))")))
              ((= name "if")
                (str "(if (rt-truthy " (compile-expr ctx cenv (el-second form)) ") "
                     (compile-expr ctx cenv (el-third form)) " "
                     (compile-list-body ctx cenv (el-rest-after form 2)) ")"))
              ((= name "when")
                (str "(if (rt-truthy " (compile-expr ctx cenv (el-second form)) ") "
                     (compile-list-body ctx cenv (el-rest-after form 1)) " nil)"))
              ((= name "unless")
                (str "(if (rt-truthy " (compile-expr ctx cenv (el-second form)) ") nil "
                     (compile-list-body ctx cenv (el-rest-after form 1)) ")"))
              ((= name "and")
                (let ((args (el-list-to-array (get form :cdr))))
                  (cond
                    ((= (js-length args) 0) "t")
                    ((= (js-length args) 1) (compile-expr ctx cenv (aref args 0)))
                    (t
                      (let ((acc (compile-expr ctx cenv (aref args (1- (js-length args)))))
                            (i (- (js-length args) 2)))
                        (while (>= i 0)
                          (setq acc (str "(if (rt-truthy " (compile-expr ctx cenv (aref args i)) ") " acc " nil)"))
                          (setq i (1- i)))
                        acc)))))
              ((= name "or")
                (let ((args (el-list-to-array (get form :cdr))))
                  (cond
                    ((= (js-length args) 0) "nil")
                    ((= (js-length args) 1) (compile-expr ctx cenv (aref args 0)))
                    (t
                      (let ((acc (compile-expr ctx cenv (aref args (1- (js-length args)))))
                            (i (- (js-length args) 2)))
                        (while (>= i 0)
                          (let ((ov (ctx-gensym ctx "or")))
                            (setq acc (str "(let ((" ov " " (compile-expr ctx cenv (aref args i)) ")) "
                                           "(if (rt-truthy " ov ") " ov " " acc "))")))
                          (setq i (1- i)))
                        acc)))))
              ((= name "cond")
                (let ((clauses (el-list-to-array (get form :cdr))))
                  (if (= (js-length clauses) 0)
                      "nil"
                    (let ((acc "nil")
                          (i (1- (js-length clauses))))
                      (while (>= i 0)
                        (let* ((clause (aref clauses i))
                               (test-expr (compile-expr ctx cenv (el-car clause)))
                               (body-tail (el-cdr clause)))
                          (if (nil? body-tail)
                              (let ((cv (ctx-gensym ctx "c")))
                                (setq acc (str "(let ((" cv " " test-expr ")) (if (rt-truthy " cv ") " cv " " acc "))")))
                            (setq acc (str "(if (rt-truthy " test-expr ") "
                                           (compile-list-body ctx cenv body-tail) " " acc ")"))))
                        (setq i (1- i)))
                      acc))))
              ((= name "while")
                (str "(progn (while (rt-truthy " (compile-expr ctx cenv (el-second form)) ") "
                     (compile-list-body ctx cenv (el-rest-after form 1)) ") nil)"))
              ((or (= name "let") (= name "named-let"))
                (if (and (el-symobj? (el-second form)) (not (nil? (el-second form))))
                    ;; Named let: (let loop ((x init) ...) body...)
                    (let* ((loop-sym (el-second form))
                           (loop-name (get loop-sym :name))
                           (bindings (el-list-to-array (el-third form)))
                           (body (el-rest-after form 2))
                           (arglist (el-list-from (js-call bindings :map (lambda (b) (if (el-cons? b) (get b :car) b)))))
                           (init-args (js-call bindings :map (lambda (b) (if (el-cons? b) (compile-expr ctx cenv (el-car (get b :cdr))) "nil"))))
                           (fn-var (ctx-gensym ctx "nl"))
                           (nl-cenv (make-cenv cenv)))
                      (js-call (get nl-cenv :fns) :set loop-name fn-var)
                      (str "(let ((" fn-var " nil)) "
