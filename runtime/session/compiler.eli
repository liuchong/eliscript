              ((= name "save-match-data")
                (str "(rt-save-match-data session (lambda () " (compile-list-body ctx cenv (get form :cdr)) "))"))
              ((= name "save-excursion")
                (str "(rt-save-excursion session (lambda () " (compile-list-body ctx cenv (get form :cdr)) "))"))
