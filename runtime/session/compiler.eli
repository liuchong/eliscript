              ((or (= name "define-minor-mode") (= name "define-globalized-minor-mode"))
                (ctx-record-fn ctx (el-symbol-name (el-second form)))
                (str "(rt-define-minor-mode session " (compile-quote ctx (el-second form)) ")"))
              ((= name "gv-define-simple-setter")
                (try (el-eval csession form (el-root-env)) (catch _ nil))
                (str "(rt-gv-define-simple-setter session " (compile-quote ctx (el-second form)) " "
                     (compile-quote ctx (el-third form)) ")"))
              ((= name "gv-define-setter")
                (try (el-eval csession form (el-root-env)) (catch _ nil))
                (let ((g-name (el-symbol-name (el-second form)))
                      (arglist (el-third form))
                      (body (el-list-to-array (el-rest-after form 2))))
                  (str "(rt-gv-define-setter session " (compile-quote ctx (el-second form)) " "
                       (compile-macro-fn ctx cenv arglist body g-name) ")")))
              ((or (= name "thread-first") (= name "thread-last"))
                (let ((last (= name "thread-last"))
                      (value (el-second form))
                      (cursor (el-rest-after form 1)))
                  (while (el-cons? cursor)
                    (let ((step (get cursor :car)))
                      (setq value
                            (if (el-cons? step)
                                (if last
                                    (el-append (js-array step (el-list value)))
                                  (el-cons (get step :car) (el-cons value (get step :cdr))))
                              (el-list step value))))
                    (setq cursor (get cursor :cdr)))
                  (compile-expr ctx cenv value)))
              ((= name "setf") (compile-setf ctx cenv form))
              ((or (= name "cl-incf") (= name "cl-decf") (= name "incf") (= name "decf"))
                (let* ((place-form (el-second form))
                       (op (if (or (= name "cl-decf") (= name "decf")) "\"-\"" "\"+\""))
                       (delta-expr (if (nil? (el-rest-after form 1)) "1" (compile-expr ctx cenv (el-third form)))))
                  (if (el-symobj? place-form)
                      (compile-var-write ctx cenv place-form
                        (str "(el-arith-2 " op " " (compile-var-read ctx cenv place-form) " " delta-expr ")"))
                    (let ((p-var (ctx-gensym ctx "pl"))
                          (v-var (ctx-gensym ctx "iv")))
                      (str "(let* ((" p-var " " (compile-place ctx cenv place-form) ") "
                           "(" v-var " (el-arith-2 " op " (funcall (get " p-var " :get)) " delta-expr "))) "
                           "(funcall (get " p-var " :set) " v-var ") " v-var ")")))))
              ((= name "push")
                (let ((item-expr (compile-expr ctx cenv (el-second form)))
                      (place-form (el-third form)))
                  (if (el-symobj? place-form)
                      (let ((iv (ctx-gensym ctx "pi")))
                        (str "(let ((" iv " " item-expr ")) "
                             (compile-var-write ctx cenv place-form (str "(el-cons " iv " " (compile-var-read ctx cenv place-form) ")")) ")"))
                    (let ((iv (ctx-gensym ctx "pi"))
                          (pv (ctx-gensym ctx "pl"))
                          (nv (ctx-gensym ctx "nv")))
                      (str "(let* ((" iv " " item-expr ") (" pv " " (compile-place ctx cenv place-form) ") "
                           "(" nv " (el-cons " iv " (funcall (get " pv " :get))))) "
                           "(funcall (get " pv " :set) " nv ") " nv ")")))))
              ((= name "pop")
                (let ((place-form (el-second form)))
                  (if (el-symobj? place-form)
                      (let ((lv (ctx-gensym ctx "plst")))
                        (str "(let ((" lv " " (compile-var-read ctx cenv place-form) ")) "
                             (compile-var-write ctx cenv place-form (str "(el-cdr " lv ")"))
                             " (el-car " lv "))"))
                    (let ((pv (ctx-gensym ctx "pl"))
                          (lv (ctx-gensym ctx "plst")))
                      (str "(let* ((" pv " " (compile-place ctx cenv place-form) ") "
                           "(" lv " (funcall (get " pv " :get)))) "
                           "(funcall (get " pv " :set) (el-cdr " lv ")) (el-car " lv "))")))))
              ((= name "cl-pushnew")
                (let* ((options (el-list-to-array (el-rest-after form 2)))
                       (test-idx (js-call options :findIndex (lambda (o) (el-sym-is o ":test"))))
                       (test-expr (if (< test-idx 0) "nil" (compile-expr ctx cenv (aref options (1+ test-idx))))))
                  (str "(rt-pushnew session " (compile-expr ctx cenv (el-second form)) " "
                       (compile-place ctx cenv (el-third form)) " " test-expr ")")))
              ((or (= name "cl-remf") (= name "remf"))
                (str "(rt-remf " (compile-place ctx cenv (el-second form)) " "
                     (compile-expr ctx cenv (el-third form)) ")"))
              ((= name "aset")
                (let ((a0 (el-second form))
                      (a1 (el-third form))
                      (a2 (el-car (el-rest-after form 2))))
                  (if (el-symobj? a0)
                      (let ((sv (ctx-gensym ctx "as")))
                        (str "(rt-aset-sym " (compile-var-read ctx cenv a0) " "
                             (compile-expr ctx cenv a1) " " (compile-expr ctx cenv a2)
                             " (lambda (" sv ") " (compile-var-write ctx cenv a0 sv) "))"))
                    (str "(rt-aset-val " (compile-expr ctx cenv a0) " "
                         (compile-expr ctx cenv a1) " " (compile-expr ctx cenv a2) ")"))))
              ((= name "cl-callf")
                (let* ((fn-form (el-second form))
                       (callable-expr (if (el-symobj? fn-form) (compile-quote ctx fn-form) (compile-expr ctx cenv fn-form)))
                       (extra (el-list-to-array (el-rest-after form 2))))
                  (str "(rt-callf session " callable-expr " " (compile-place ctx cenv (el-third form))
                       " (js-array"
                       (js-call (js-call extra :map (lambda (a) (str " " (compile-expr ctx cenv a)))) :join "")
                       "))")))
              ((= name "cl-defstruct")
                (compile-cl-defstruct ctx cenv form))
              ((or (= name "pcase") (= name "pcase-exhaustive"))
                (compile-pcase ctx cenv form))
              ((or (= name "pcase-let") (= name "pcase-let*"))
                (compile-pcase-let ctx cenv form))
              ((= name "pcase-dolist")
                (compile-pcase-dolist ctx cenv form))
              ((= name "pcase-setq")
                (compile-pcase-setq ctx cenv form))
              ((= name "cl-loop")
                (compile-cl-loop ctx cenv form))
              ;; 1+5+2 Extension Special Forms
              ((or (= name "let-bind") (= name "let*-bind"))
                (compile-let-bind ctx cenv form))
              ((= name "defun-bind")
                (let ((fn-sym (el-second form))
                      (fn-name (el-symbol-name (el-second form))))
                  (ctx-record-fn ctx fn-name)
                  (js-call (get csession :userDefinedFns) :add fn-name)
                  (str "(rt-defun session " (ctx-sym ctx fn-name) " nil (get "
                       (compile-bind-fn ctx cenv (el-third form) (el-rest-after form 2) fn-name)
                       " :elispCall))")))
              ((= name "lambda-bind")
                (compile-bind-fn ctx cenv (el-second form) (el-rest-after form 1) "lambda-bind"))
              ((= name "pcase-value")
                (let* ((tv (ctx-gensym ctx "pv"))
                       (clauses (el-list-to-array (el-rest-after form 1)))
                       (acc "nil")
                       (i (1- (js-length clauses))))
                  (while (>= i 0)
                    (let* ((clause (aref clauses i))
                           (pat (el-car clause))
                           (body-expr (compile-list-body ctx cenv (el-cdr clause)))
                           (test-expr (if (eq pat s-underscore)
                                          "t"
                                        (str "(el-value-equal " tv " " (compile-expr ctx cenv pat) ")"))))
                      (setq acc (str "(if " test-expr " " body-expr " " acc ")")))
                    (setq i (1- i)))
                  (str "(let ((" tv " " (compile-expr ctx cenv (el-second form)) ")) " acc ")")))
              ((= name "cond-predicate")
                (let* ((pv (ctx-gensym ctx "cp"))
                       (vv (ctx-gensym ctx "cv"))
                       (clauses (el-list-to-array (el-rest-after form 2)))
                       (n (js-length clauses))
                       (i 0)
                       (branches (js-array)))
                  (while (< i n)
                    (cond
                      ((= i (1- n))
                        (js-call branches :push (js-object :kind "default" :expr (compile-expr ctx cenv (aref clauses i))))
                        (setq i (1+ i)))
                      ((el-sym-is (aref clauses (1+ i)) ":>>")
                        (js-call branches :push
                                 (js-object :kind "arrow"
                                            :test (compile-expr ctx cenv (aref clauses i))
                                            :fn (compile-expr ctx cenv (aref clauses (+ i 2)))))
                        (setq i (+ i 3)))
                      (t
                        (js-call branches :push
                                 (js-object :kind "pair"
                                            :test (compile-expr ctx cenv (aref clauses i))
                                            :then (compile-expr ctx cenv (aref clauses (1+ i)))))
                        (setq i (+ i 2)))))
                  (let ((acc "nil")
                        (bi (1- (js-length branches))))
                    (while (>= bi 0)
                      (let ((b (aref branches bi)))
                        (cond
                          ((= (get b :kind) "default") (setq acc (get b :expr)))
                          ((= (get b :kind) "arrow")
                            (let ((mv (ctx-gensym ctx "cm")))
                              (setq acc (str "(let ((" mv " (rt-call-fn session " pv " (js-array " (get b :test) " " vv ")))) "
                                             "(if (rt-truthy " mv ") (rt-call-fn session " (get b :fn) " (js-array " mv ")) " acc "))"))))
                          (t
                            (setq acc (str "(if (rt-truthy (rt-call-fn session " pv " (js-array " (get b :test) " " vv "))) "
                                           (get b :then) " " acc ")")))))
                      (setq bi (1- bi)))
                    (str "(let ((" pv " " (compile-expr ctx cenv (el-second form)) ") "
                         "(" vv " " (compile-expr ctx cenv (el-third form)) ")) " acc ")"))))
              ((= name "defun-case")
                (let* ((fn-sym (el-second form))
                       (fn-name (el-symbol-name fn-sym))
                       (extracted (el-extract-declarations (el-list-to-array (el-rest-after form 1)))))
                  (ctx-record-fn ctx fn-name)
                  (js-call (get csession :userDefinedFns) :add fn-name)
                  (str "(rt-defun session " (ctx-sym ctx fn-name) " nil (get "
                       (compile-case-fn ctx cenv (get extracted :body) fn-name) " :elispCall))")))
              ((= name "lambda-case")
                (compile-case-fn ctx cenv (el-list-to-array (get form :cdr)) "lambda-case"))
              ((= name "let-loop")
                (let* ((bindings (el-list-to-array (el-second form)))
                       (names (js-call bindings :map (lambda (b) (el-car b))))
                       (inits (js-call bindings :map (lambda (b) (compile-expr ctx cenv (el-nth 1 b)))))
                       (body (el-list-to-array (el-rest-after form 1))))
                  (compile-recur-loop ctx cenv names inits body)))
              ((= name "defun-tail")
                (let* ((fn-sym (el-second form))
                       (fn-name (el-symbol-name fn-sym))
                       (names (el-list-to-array (el-third form)))
                       (body (el-list-to-array (el-rest-after form 2)))
                       (args-var (ctx-gensym ctx "targs"))
                       (inits (js-call names :map (lambda (_ idx) (str "(el-opt (aref " args-var " " idx "))")))))
                  (ctx-record-fn ctx fn-name)
                  (js-call (get csession :userDefinedFns) :add fn-name)
                  (str "(rt-defun session " (ctx-sym ctx fn-name) " " (compile-quote ctx (el-third form))
                       " (lambda (" args-var ") "
                       (compile-recur-loop ctx cenv names inits body) "))")))
              ((= name "recur")
                (unless (get cenv :inRecur)
                  (el-compile-error "ELI-R0001: recur must be in tail position"))
                (let ((args (el-list-to-array (get form :cdr))))
                  (str "(throw (js-object :eliscriptRecur t :args (js-array"
                       (js-call (js-call args :map (lambda (a) (str " " (compile-expr ctx cenv a)))) :join "")
                       ")))")))
              ((= name "thread-as")
                (let* ((val-form (el-second form))
                       (var-sym (el-third form))
                       (steps (el-list-to-array (el-rest-after form 2)))
                       (dyn-var (ctx-gensym ctx "dyn"))
                       (js-var (ctx-gensym ctx "v"))
                       (sym-expr (ctx-sym ctx (get var-sym :name)))
                       (t-cenv (make-cenv cenv))
                       (step-exprs (js-array)))
                  (js-call (get t-cenv :vars) :set (get var-sym :name)
                           (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                  (js-call steps :forEach
                           (lambda (s)
                             (js-call step-exprs :push
                                      (str "(setq " js-var " (rt-write-var session " sym-expr " " (compile-expr ctx t-cenv s) "))"))))
                  (str "(let ((" dyn-var " (js-array)) (" js-var " nil)) "
                       "(try (progn (setq " js-var " (rt-bind-var session " sym-expr " " (compile-expr ctx cenv val-form) " " dyn-var ")) "
                       (js-call step-exprs :join " ")
                       (if (> (js-length step-exprs) 0) " " "")
                       "(rt-read-var session " sym-expr " " js-var ")) "
                       "(finally (rt-restore-dyn session " dyn-var "))))")))
              ((or (= name "thread-cond-first") (= name "thread-cond-last"))
                (let* ((last (= name "thread-cond-last"))
                       (vv (ctx-gensym ctx "tcv"))
                       (items (el-list-to-array (el-rest-after form 1)))
                       (steps (js-array))
                       (i 0))
                  (while (< i (js-length items))
                    (let* ((test-form (aref items i))
                           (step (aref items (1+ i)))
                           (call-expr
                             (if (el-cons? step)
                                 (let* ((shead (get step :car))
                                        (sargs (el-list-to-array (get step :cdr)))
                                        (cargs (js-call sargs :map (lambda (a) (compile-expr ctx cenv a))))
                                        (all-args (if last
                                                      (js-call cargs :concat (js-array vv))
                                                    (js-call (js-array vv) :concat cargs))))
                                   (str "(rt-callN session " (ctx-sym ctx (el-symbol-name shead))
                                        " (js-array " (js-call all-args :join " ") "))"))
                               (str "(rt-call1 session " (ctx-sym ctx (el-symbol-name step)) " " vv ")"))))
                      (js-call steps :push
                               (str "(when (rt-truthy " (compile-expr ctx cenv test-form) ") (setq " vv " " call-expr "))")))
                    (setq i (+ i 2)))
                  (str "(let ((" vv " " (compile-expr ctx cenv (el-second form)) ")) "
                       (js-call steps :join " ")
                       (if (> (js-length steps) 0) " " "")
                       vv ")")))
              ((or (= name "thread-some-first") (= name "thread-some-last"))
                (let* ((last (= name "thread-some-last"))
                       (vv (ctx-gensym ctx "tsv"))
                       (items (el-list-to-array (el-rest-after form 1)))
                       (steps (js-array)))
                  (js-call items :forEach
                           (lambda (step)
                             (let ((call-expr
                                     (if (el-cons? step)
                                         (let* ((shead (get step :car))
                                                (sargs (el-list-to-array (get step :cdr)))
                                                (cargs (js-call sargs :map (lambda (a) (compile-expr ctx cenv a))))
                                                (all-args (if last
                                                              (js-call cargs :concat (js-array vv))
                                                            (js-call (js-array vv) :concat cargs))))
                                           (str "(rt-callN session " (ctx-sym ctx (el-symbol-name shead))
                                                " (js-array " (js-call all-args :join " ") "))"))
                                       (str "(rt-call1 session " (ctx-sym ctx (el-symbol-name step)) " " vv ")"))))
                               (js-call steps :push (str "(unless (nil? " vv ") (setq " vv " " call-expr "))")))))
                  (str "(let ((" vv " " (compile-expr ctx cenv (el-second form)) ")) "
                       (js-call steps :join " ")
                       (if (> (js-length steps) 0) " " "")
                       vv ")")))
              ((= name "cl-defstruct-persistent")
                (let* ((s-sym (el-second form))
                       (s-name (el-symbol-name s-sym))
                       (raw-fields (js-call (el-list-to-array (el-rest-after form 1)) :filter (lambda (f) (not (el-string? f)))))
                       (field-exprs (js-array)))
                  (ctx-record-fn ctx (str "make-" s-name))
                  (ctx-record-fn ctx (str s-name "-p"))
                  (ctx-record-fn ctx (str s-name "-with"))
                  (js-call raw-fields :forEach
                           (lambda (f)
                             (if (el-symobj? f)
                                 (progn
                                   (ctx-record-fn ctx (str s-name "-" (get f :name)))
                                   (js-call field-exprs :push
                                            (str "(js-object :name " (el-eliscript-string-literal (get f :name))
                                                 " :type \"any\" :min nil :max nil :hasDefault false :defaultThunk nil)")))
                               (let ((items (el-list-to-array f))
                                     (fname (el-symbol-name (el-car f)))
                                     (ftype "any") (fmin "nil") (fmax "nil") (has-def "false") (def-thunk "nil")
                                     (i 1))
                                 (ctx-record-fn ctx (str s-name "-" fname))
                                 (while (< i (js-length items))
                                   (let ((k (el-symbol-name (aref items i)))
                                         (v (aref items (1+ i))))
                                     (cond
                                       ((= k ":type") (setq ftype (el-symbol-name-or-string v)))
                                       ((= k ":min") (setq fmin (compile-number (el-num v))))
                                       ((= k ":max") (setq fmax (compile-number (el-num v))))
                                       ((= k ":default")
                                         (setq has-def "t")
                                         (setq def-thunk (str "(lambda () " (compile-expr ctx cenv v) ")")))))
                                   (setq i (+ i 2)))
                                 (js-call field-exprs :push
                                          (str "(js-object :name " (el-eliscript-string-literal fname)
                                               " :type " (el-eliscript-string-literal ftype)
                                               " :min " fmin " :max " fmax
                                               " :hasDefault " has-def " :defaultThunk " def-thunk ")"))))))
                  (str "(rt-defstruct-persistent session " (compile-quote ctx s-sym)
                       " (js-array" (js-call (js-call field-exprs :map (lambda (fe) (str " " fe))) :join "") "))")))
              ((= name "defprotocol")
                (let* ((p-sym (el-second form))
                       (sigs (el-list-to-array (el-rest-after form 1)))
                       (methods (js-call sigs :map (lambda (sig) (el-symbol-name (el-car sig))))))
                  (js-call methods :forEach (lambda (m) (ctx-record-fn ctx m)))
                  (str "(rt-defprotocol session " (compile-quote ctx p-sym)
                       " (js-array" (js-call (js-call methods :map (lambda (m) (str " " (el-eliscript-string-literal m)))) :join "") "))")))
              ((= name "extend-protocol")
                (let* ((p-sym (el-second form))
                       (t-sym (el-third form))
                       (impls (el-list-to-array (el-rest-after form 2)))
                       (impl-exprs
                         (js-call impls :map
                                  (lambda (impl)
                                    (let ((mname (el-symbol-name (el-car impl))))
                                      (str "(js-array " (el-eliscript-string-literal mname) " "
                                           (compile-lambda-impl ctx cenv (get impl :cdr) mname false nil) ")"))))))
                  (str "(rt-extend-protocol session " (compile-quote ctx p-sym) " " (compile-quote ctx t-sym)
                       " (js-array" (js-call (js-call impl-exprs :map (lambda (ie) (str " " ie))) :join "") "))")))
              ((= name "cl-defgeneric-value")
                (let ((g-sym (el-second form))
                      (g-name (el-symbol-name (el-second form))))
                  (ctx-record-fn ctx g-name)
                  (str "(rt-defgeneric-value session " (compile-quote ctx g-sym) " "
                       (compile-lambda-impl ctx cenv (el-rest-after form 1) g-name false nil) ")")))
              ((= name "cl-defmethod-value")
                (let ((g-sym (el-second form))
                      (g-name (el-symbol-name (el-second form))))
                  (str "(rt-defmethod-value session " (compile-quote ctx g-sym) " "
                       (compile-expr ctx cenv (el-third form)) " "
                       (compile-lambda-impl ctx cenv (el-rest-after form 2) g-name false nil) ")")))
              ((= name "delay")
                (str "(rt-delay (lambda () " (compile-list-body ctx cenv (get form :cdr)) "))"))
              ((= name "with-transient")
                (let* ((spec (el-second form))
                       (var-sym (el-car spec))
                       (src-form (el-nth 1 spec))
                       (b-param (ctx-gensym ctx "tb"))
                       (dyn-var (ctx-gensym ctx "dyn"))
                       (js-var (ctx-gensym ctx "v"))
                       (sym-expr (ctx-sym ctx (get var-sym :name)))
                       (t-cenv (make-cenv cenv)))
                  (js-call (get t-cenv :vars) :set (get var-sym :name)
                           (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                  (str "(rt-with-transient " (compile-expr ctx cenv src-form)
                       " (lambda (" b-param ") (let ((" dyn-var " (js-array)) (" js-var " nil)) "
                       "(try (progn (setq " js-var " (rt-bind-var session " sym-expr " " b-param " " dyn-var ")) "
                       (compile-list-body ctx t-cenv (el-rest-after form 1)) ") "
                       "(finally (rt-restore-dyn session " dyn-var "))))))")))
              ((= name "defmodule")
                (compile-defmodule ctx cenv form))
              ((= name "import-functions")
                (let ((mod-name (el-symbol-name (el-second form)))
                      (syms (el-list-to-array (el-nth 3 form))))
                  (str "(rt-import-functions session " (el-eliscript-string-literal mod-name)
                       " (js-array" (js-call (js-call syms :map (lambda (s) (str " " (compile-quote ctx s)))) :join "") "))")))
              ((= name "import-values")
                (let ((mod-name (el-symbol-name (el-second form)))
                      (syms (el-list-to-array (el-nth 3 form))))
                  (str "(rt-import-values session " (el-eliscript-string-literal mod-name)
                       " (js-array" (js-call (js-call syms :map (lambda (s) (str " " (compile-quote ctx s)))) :join "") "))")))
              ((= name "defun-async")
                (let ((fn-sym (el-second form))
                      (fn-name (el-symbol-name (el-second form)))
                      (rest (el-rest-after form 1)))
                  (ctx-record-fn ctx fn-name)
                  (js-call (get csession :userDefinedFns) :add fn-name)
                  (str "(el-define-function session " (ctx-sym ctx fn-name)
                       " (rt-make-async-fn session " (el-eliscript-string-literal fn-name) " "
                       (compile-quote ctx (el-car rest)) " (get "
                       (compile-lambda-impl ctx cenv rest fn-name false nil) " :elispCall)))")))
              ((= name "lambda-async")
                (let ((rest (get form :cdr)))
                  (str "(rt-make-async-fn session \"lambda-async\" " (compile-quote ctx (el-car rest))
                       " (get " (compile-lambda-impl ctx cenv rest "lambda-async" false nil) " :elispCall))")))
              ((= name "with-async-scope")
                (let* ((spec (el-second form))
                       (var-sym (el-car spec))
                       (sc-param (ctx-gensym ctx "sc"))
                       (dyn-var (ctx-gensym ctx "dyn"))
                       (js-var (ctx-gensym ctx "v"))
                       (sym-expr (ctx-sym ctx (get var-sym :name)))
                       (s-cenv (make-cenv cenv)))
                  (js-call (get s-cenv :vars) :set (get var-sym :name)
                           (js-object :jsVar js-var :symExpr sym-expr :isConst false))
                  (str "(rt-with-async-scope session (lambda (" sc-param ") "
                       "(let ((" dyn-var " (js-array)) (" js-var " nil)) "
                       "(try (progn (setq " js-var " (rt-bind-var session " sym-expr " " sc-param " " dyn-var ")) "
                       (compile-list-body ctx s-cenv (el-rest-after form 1)) ") "
                       "(finally (rt-restore-dyn session " dyn-var "))))))")))
              ((= name "with-abi-memory")
                (let* ((options (el-list-to-array (el-second form)))
                       (index (js-call options :findIndex (lambda (o) (el-sym-is o ":initial-pages"))))
                       (pages-expr (if (< index 0) "1" (compile-expr ctx cenv (aref options (1+ index))))))
                  (str "(rt-with-abi-memory session " pages-expr
                       " (lambda () " (compile-list-body ctx cenv (el-rest-after form 1)) "))")))
              ;; Compile-time macro expansion
              ((js-call (get csession :macros) :has head)
                (let* ((expander (js-call (get csession :macros) :get head))
                       (expanded (funcall expander (get form :cdr) (el-root-env))))
                  (compile-expr ctx cenv expanded)))
              ;; Local function call (cl-flet / cl-labels / defun-lexical / macro-gensym)
              ((js-call (get cenv :fns) :has name)
                (let ((fn-var (js-call (get cenv :fns) :get name))
                      (args (el-list-to-array (get form :cdr))))
                  (str "(rt-call-fn session " fn-var " (js-array"
                       (js-call (js-call args :map (lambda (a) (str " " (compile-expr ctx cenv a)))) :join "")
                       "))")))
              ;; Standard function call
              (t
                (when (and (= name "require")
                           (el-cons? (get form :cdr))
                           (el-cons? (el-second form))
                           (eq (get (el-second form) :car) s-quote)
                           (el-symobj? (el-second (el-second form))))
                  (let ((req-name (el-symbol-name (el-second (el-second form)))))
                    (when (or (= req-name "eliscript") (js-call req-name :startsWith "eliscript-"))
                      (el-activate-extension csession req-name))))
                (let* ((args (el-list-to-array (get form :cdr)))
                       (n (js-length args))
                       (sym-expr (ctx-sym ctx name)))
                  (cond
                    ((= n 0) (str "(rt-call0 session " sym-expr ")"))
                    ((= n 1) (str "(rt-call1 session " sym-expr " " (compile-expr ctx cenv (aref args 0)) ")"))
                    ((= n 2) (str "(rt-call2 session " sym-expr " "
                                  (compile-expr ctx cenv (aref args 0)) " "
                                  (compile-expr ctx cenv (aref args 1)) ")"))
                    ((= n 3) (str "(rt-call3 session " sym-expr " "
                                  (compile-expr ctx cenv (aref args 0)) " "
                                  (compile-expr ctx cenv (aref args 1)) " "
                                  (compile-expr ctx cenv (aref args 2)) ")"))
                    (t (str "(rt-callN session " sym-expr " (js-array"
                            (js-call (js-call args :map (lambda (a) (str " " (compile-expr ctx cenv a)))) :join "")
                            "))")))))))))))

  ;; ------------------------------------------------------------------
  ;; Public Compiler Entrypoints: compileModule & compileProgram
  ;; ------------------------------------------------------------------

  (defun compileModule (source &optional options)
    (let* ((module-name (if (or (nullish? options) (nullish? (get options :moduleName)))
                            "eliscript.generated.elisp-module"
                          (get options :moduleName)))
           (runtime (if (or (nullish? options) (nullish? (get options :runtime)))
                        "eliscript/runtime/session"
                      (get options :runtime)))
           (csession (if (and (not (nullish? options)) (not (nullish? (get options :session))))
                         (get options :session)
                       (createSession)))
           (ctx (make-compile-ctx csession))
           (cenv (make-cenv nil))
           (forms (el-read-all source))
           (compiled-top (js-call forms :map (lambda (f) (str "    " (compile-expr ctx cenv f)))))
           (body-block (if (= (js-length compiled-top) 0)
                           "    nil"
                         (js-call compiled-top :join "\n"))))
      (str "(module " module-name "\n"
           "  (import " (el-eliscript-string-literal runtime)
           " OPTION_NONE createSession callSession evalSession invokeFunction registerModule"
           " el-add-special-var el-append el-aref el-arith el-arith-2 el-bool el-car el-car-safe el-cdr el-cdr-safe"
           " el-catch-block el-cl-typep el-cons el-cons? el-define-function el-eq-test el-eql-test el-equal-p el-intern"
           " el-list el-list-from el-list-to-array el-make-float el-make-pcoll el-make-pmap el-make-pset el-member-with"
           " el-num el-opt el-plist-member el-prin1-string el-seq-items el-set-fn el-signal el-string-match"
           " el-throw el-value-equal el-vector"
           " rt-aset-sym rt-aset-val rt-bind-const-var rt-bind-var rt-bound-and-true-p"
           " rt-call-fn rt-call0 rt-call1 rt-call2 rt-call3 rt-callN rt-callf rt-catch"
           " rt-check-arity rt-check-contract rt-condition-case rt-dec rt-defalias"
           " rt-defconst rt-defgeneric-value rt-define-derived-mode rt-define-minor-mode"
           " rt-defmacro rt-defmethod-value rt-defprotocol rt-defstruct rt-defstruct-persistent"
           " rt-defun rt-defvar rt-defvar-init rt-defvar-keymap rt-defvar-local rt-delay"
           " rt-destructure rt-ert-deftest rt-extend-protocol rt-get-global"
           " rt-gt rt-gte rt-gv-define-setter rt-gv-define-simple-setter"
           " rt-ignore-error rt-ignore-errors rt-import-functions rt-import-values"
           " rt-lt rt-lte rt-make-async-fn rt-make-case-fn rt-make-gensym"
           " rt-match-binding rt-mod rt-opt-arg rt-pcase-match rt-place-alist-get"
           " rt-place-aref rt-place-call rt-place-plist-get rt-pushnew rt-read-var"
           " rt-register-module rt-remf rt-rest-arg rt-restore-dyn rt-return-from"
           " rt-run-cl-loop rt-save-current-buffer rt-save-excursion rt-save-match-data"
           " rt-set-global rt-setq-default rt-setq-local rt-should rt-should-error"
           " rt-should-not rt-sub rt-truthy rt-with-abi-memory rt-with-async-scope"
           " rt-with-current-buffer rt-with-output-to-string rt-with-temp-buffer"
           " rt-with-temp-file rt-with-timeout rt-with-transient rt-wrap-fn rt-write-var)\n"
           (if (> (js-length (get ctx :symDefs)) 0)
               (str (js-call (get ctx :symDefs) :join "\n") "\n")
             "")
           (if (> (js-length (get ctx :quoteDefs)) 0)
               (str (js-call (get ctx :quoteDefs) :join "\n") "\n")
             "")
           "  (defconst exported-function-names (js-array"
           (js-call (js-call (get ctx :fnNames) :map (lambda (n) (str " " (el-eliscript-string-literal n)))) :join "")
           "))\n"
           "  (defun loadWithSession (session)\n"
           body-block ")\n"
           "  (defvar default-session nil)\n"
           "  (defvar default-loaded nil)\n"
           "  (defvar default-initialized false)\n"
           "  (defun ensureDefaultSession ()\n"
           "    (unless default-initialized\n"
           "      (setq default-initialized t)\n"
           "      (setq default-session (createSession))\n"
           "      (setq default-loaded (loadWithSession default-session)))\n"
           "    default-session)\n"
           "  (defun getDefaultSession () (ensureDefaultSession))\n"
           "  (defun getLoaded () (ensureDefaultSession) default-loaded)\n"
           (if (and (not (nullish? options)) (get options :autorun))
               "  (defconst loaded (getLoaded))\n"
             "")
           "  (defun callSessionFn (name arguments) (callSession (ensureDefaultSession) name arguments))\n"
           "  (defun evalSessionFn (program) (evalSession (ensureDefaultSession) program))\n"
           "  (defun invokeSessionFn (name &rest arguments) (invokeFunction (ensureDefaultSession) name arguments))\n"
           "  (defun exportedFunctions () (js-call exported-function-names :slice))\n"
           "  (defun callElisp (name arguments) (callSession (ensureDefaultSession) name arguments))\n"
           "  (defun evalElisp (program) (evalSession (ensureDefaultSession) program))\n"
           "  (defun invokeElisp (name &rest arguments) (invokeFunction (ensureDefaultSession) name arguments))\n"
           "  (defun elispFunctions () (js-call exported-function-names :slice))\n"
           "  (export loadWithSession ensureDefaultSession getDefaultSession getLoaded callSessionFn evalSessionFn invokeSessionFn exportedFunctions callElisp evalElisp invokeElisp elispFunctions))\n")))

  (defun compileProgram (source &optional options)
    (let ((forms (el-read-all source))
          (eli-module (compileModule source options)))
      (js-object :format "eliscript-0.1.0-compiled-module"
                 :formsCount (js-length forms)
                 :eliscriptSource eli-module)))

  (export
    compileModule compileProgram
    rt-aset-sym rt-aset-val rt-bind-const-var rt-bind-var rt-bound-and-true-p
    rt-call-fn rt-call0 rt-call1 rt-call2 rt-call3 rt-callN rt-callf rt-catch
    rt-check-arity rt-check-contract rt-condition-case rt-dec rt-defalias
    rt-defconst rt-defgeneric-value rt-define-derived-mode rt-define-minor-mode
    rt-defmacro rt-defmethod-value rt-defprotocol rt-defstruct rt-defstruct-persistent
    rt-defun rt-defvar rt-defvar-init rt-defvar-keymap rt-defvar-local rt-delay
    rt-destructure rt-ert-deftest rt-extend-protocol rt-get-global
    rt-gt rt-gte rt-gv-define-setter rt-gv-define-simple-setter
    rt-ignore-error rt-ignore-errors rt-import-functions rt-import-values
    rt-lt rt-lte rt-make-async-fn rt-make-case-fn rt-make-gensym
    rt-match-binding rt-mod rt-opt-arg rt-pcase-match rt-place-alist-get
    rt-place-aref rt-place-call rt-place-plist-get rt-pushnew rt-read-var
    rt-register-module rt-remf rt-rest-arg rt-restore-dyn rt-return-from
    rt-run-cl-loop rt-save-current-buffer rt-save-excursion rt-save-match-data
    rt-set-global rt-setq-default rt-setq-local rt-should rt-should-error
    rt-should-not rt-sub rt-truthy rt-with-abi-memory rt-with-async-scope
    rt-with-current-buffer rt-with-output-to-string rt-with-temp-buffer
    rt-with-temp-file rt-with-timeout rt-with-transient rt-wrap-fn rt-write-var))
