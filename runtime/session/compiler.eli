                                    (compile-expr ctx cenv val-form) ")")))
                    (setq cursor (el-cdr (get cursor :cdr))))
                  (if (= (js-length steps) 0) "nil" (str "(progn " (js-call steps :join " ") ")"))))
              ((or (= name "defvar") (= name "defcustom"))
