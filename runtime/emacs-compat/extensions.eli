    (el-register (js-array "bound-and-true-p") sf-bound-and-true-p)
    (el-register (js-array "cl-assert") sf-cl-assert)
    (el-register (js-array "rx") sf-rx)
    (el-register (js-array "cl-the") sf-cl-the)
    (el-register (js-array "declare" "declare-function" "cl-declaim" "cl-declare" "gv-define-expander") sf-declare)
    (el-register (js-array "defvar-keymap") sf-defvar-keymap)
