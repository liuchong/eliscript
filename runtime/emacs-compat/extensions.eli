    (el-register (js-array "pop") sf-pop)
    (el-register (js-array "cl-pushnew") sf-pushnew)
    (el-register (js-array "cl-remf" "remf") sf-cl-remf)
    (el-register (js-array "aset") sf-aset)
    (el-register (js-array "cl-callf") sf-cl-callf)
    (el-register (js-array "cl-defstruct") sf-cl-defstruct)
    (el-register (js-array "pcase" "pcase-exhaustive") sf-pcase)
    (el-register (js-array "pcase-let" "pcase-let*") sf-pcase-let)
    (el-register (js-array "pcase-dolist") sf-pcase-dolist)
    (el-register (js-array "pcase-setq") sf-pcase-setq)
    (el-register (js-array "cl-loop") sf-cl-loop)
    ;; Extension forms
    (el-register (js-array "let-bind" "let*-bind") sf-let-bind)
    (el-register (js-array "defun-bind") sf-defun-bind)
    (el-register (js-array "lambda-bind") sf-lambda-bind)
    (el-register (js-array "pcase-value") sf-pcase-value)
    (el-register (js-array "cond-predicate") sf-cond-predicate)
    (el-register (js-array "defun-case") sf-defun-case)
    (el-register (js-array "lambda-case") sf-lambda-case)
    (el-register (js-array "let-loop") sf-let-loop)
    (el-register (js-array "defun-tail") sf-defun-tail)
    (el-register (js-array "recur") sf-recur)
    (el-register (js-array "thread-as") sf-thread-as)
    (el-register (js-array "thread-cond-first" "thread-cond-last") sf-thread-cond)
    (el-register (js-array "thread-some-first" "thread-some-last") sf-thread-some)
    (el-register (js-array "cl-defstruct-persistent") sf-cl-defstruct-persistent)
    (el-register (js-array "defprotocol") sf-defprotocol)
    (el-register (js-array "extend-protocol") sf-extend-protocol)
    (el-register (js-array "cl-defgeneric-value") sf-cl-defgeneric-value)
    (el-register (js-array "cl-defmethod-value") sf-cl-defmethod-value)
    (el-register (js-array "delay") sf-delay)
    (el-register (js-array "with-transient") sf-with-transient)
    (el-register (js-array "defmodule") sf-defmodule)
    (el-register (js-array "import-functions") sf-import-functions)
    (el-register (js-array "import-values") sf-import-values)
    (el-register (js-array "defmacro-checked") sf-defmacro-checked)
    (el-register (js-array "defun-async") sf-defun-async)
    (el-register (js-array "lambda-async") sf-lambda-async)
    (el-register (js-array "with-async-scope") sf-with-async-scope)
    (el-register (js-array "with-abi-memory") sf-with-abi-memory))

  (el-install-special-forms)

  (export el-require))
