(module eliscript.runtime.emacs-compat.reader-format
  ;;; reader-format.eli --- S-expression reader, format, JSON, SHA-256, path, and time utilities

  (import "./core.eli" el-astral? el-bytes-string el-car el-char-string el-char-to-unit el-char-width el-cons el-cons? el-encode-utf8 el-equal-p el-format-g el-global-value el-hash-key el-hash-table-literal el-hash-table? el-integer-string el-integer? el-intern el-keyword? el-list el-list-from el-list-to-array el-make-float el-make-hash-table el-make-signal el-make-symbol el-mod-int el-num el-number-string el-number? el-opt el-pad-exponent el-prin1-string el-puthash el-seq-items el-signal el-string-bytes-array el-string-codes el-string-from-codes el-string-length el-string? el-substring el-sym-is el-symbol-name el-symbol? el-symobj? el-unit-to-char el-upcase el-vector el-vector? s-backquote s-comma s-comma-at s-function s-quote)
  (import "./regexp-buffer.eli" el-buffer-substring el-point-max el-regexp-quote)


  ;; ------------------------------------------------------------------
  ;; Reader (Emacs Lisp syntax)
  ;; ------------------------------------------------------------------

  (defconst delimiter-pattern (new globalThis.RegExp "[\\s()\\[\\]\";'`,]" "u"))

  (defconst integer-token (new globalThis.RegExp "^[+-]?[0-9]+\\.?$"))

  (defconst float-token
    (new globalThis.RegExp "^[+-]?(?:[0-9]+\\.[0-9]+|[0-9]*\\.[0-9]+|[0-9]+)(?:e[+-]?[0-9]+)?$"))

  (defconst special-float-token (new globalThis.RegExp "^([+-]?[0-9.]+)e\\+(INF|NaN)$"))


  (defconst whitespace-char (new globalThis.RegExp "\\s" "u"))

  (defconst hex-digit-char (new globalThis.RegExp "^[0-9a-fA-F]$"))

  (defconst octal-digit-char (new globalThis.RegExp "^[0-7]$"))


  (defun el-read-error (message) (throw (el-make-signal "invalid-read-syntax" (js-array message))))


  (defun el-reader (source)
    (js-object :source source :pos 0 :length (js-length source)))


  (defun el-reader-peek (reader)
    (if (>= (get reader :pos) (get reader :length)) nil
      (String/fromCodePoint (js-call (get reader :source) :codePointAt (get reader :pos)))))


  (defun el-reader-next (reader)
    (let ((ch (el-reader-peek reader)))
      (unless (nil? ch) (put reader :pos (+ (get reader :pos) (js-length ch))))
      ch))


  (defun el-skip-blank (reader)
    (let ((done false))
      (while (not done)
        (let ((ch (el-reader-peek reader)))
          (cond
            ((nil? ch) (setq done t))
            ((js-call whitespace-char :test ch) (el-reader-next reader))
            ((or (= ch ";")
                 (and (= ch "#") (= (js-call (get reader :source) :charAt (1+ (get reader :pos))) "!")))
              (while (and (not (nil? (el-reader-peek reader))) (/= (el-reader-peek reader) "\n"))
                (el-reader-next reader)))
            (t (setq done t)))))))


  (defun el-hex-value (text) (Number/parseInt text 16))


  (defun el-read-escape (reader in-string)
    ;; After a backslash.  Return a code point, or -1 for an ignored escape.
    (let ((ch (el-reader-next reader)))
      (cond
        ((nil? ch) (throw (el-make-signal "end-of-file" (js-array))))
        ((= ch "a") 7) ((= ch "b") 8) ((= ch "t") 9) ((= ch "n") 10) ((= ch "v") 11)
        ((= ch "f") 12) ((= ch "r") 13) ((= ch "e") 27) ((= ch "d") 127)
        ((= ch "s") (if (= (el-reader-peek reader) "-")
                        (progn (el-reader-next reader) (bit-or (el-read-char-body reader) 8388608))
                      32))
        ((and in-string (or (= ch "\n") (= ch " "))) -1)
        ((= ch "x")
          (let ((digits ""))
            (while (and (not (nil? (el-reader-peek reader)))
                        (js-call hex-digit-char :test (el-reader-peek reader)))
              (setq digits (str digits (el-reader-next reader))))
            (when (and in-string (= (el-reader-peek reader) "\\")
                       (= (js-call (get reader :source) :charAt (1+ (get reader :pos))) " "))
              (put reader :pos (+ (get reader :pos) 2)))
            (if (= digits "") 0 (el-hex-value digits))))
        ((or (= ch "u") (= ch "U"))
          (let ((count (if (= ch "u") 4 8)) (digits "") (index 0))
            (while (< index count)
              (setq digits (str digits (el-reader-next reader)))
              (setq index (1+ index)))
            (el-hex-value digits)))
        ((= ch "N")
          (el-reader-next reader)
          (let ((name ""))
            (while (and (not (nil? (el-reader-peek reader))) (/= (el-reader-peek reader) "}"))
              (setq name (str name (el-reader-next reader))))
            (el-reader-next reader)
            (if (js-call name :startsWith "U+") (el-hex-value (js-call name :slice 2)) 65533)))
        ((js-call octal-digit-char :test ch)
          (let ((digits ch))
            (while (and (< (js-length digits) 3) (not (nil? (el-reader-peek reader)))
                        (js-call octal-digit-char :test (el-reader-peek reader)))
              (setq digits (str digits (el-reader-next reader))))
            (Number/parseInt digits 8)))
        ((and (= ch "C") (= (el-reader-peek reader) "-"))
          (el-reader-next reader)
          (el-control-char (el-read-char-body reader)))
        ((= ch "^") (el-control-char (el-read-char-body reader)))
        ((and (= ch "M") (= (el-reader-peek reader) "-"))
          (el-reader-next reader)
          (bit-or (el-read-char-body reader) 134217728))
        ((and (or (= ch "S") (= ch "H") (= ch "A")) (= (el-reader-peek reader) "-"))
          (el-reader-next reader)
          (el-read-char-body reader))
        (t (js-call ch :codePointAt 0)))))


  (defun el-control-char (code)
    (cond ((= code 63) 127)
          ((and (>= code 97) (<= code 122)) (- code 96))
          ((and (>= code 64) (<= code 95)) (- code 64))
          (t (bit-or code 67108864))))


  (defun el-read-char-body (reader)
    (let ((ch (el-reader-next reader)))
      (cond ((nil? ch) (throw (el-make-signal "end-of-file" (js-array))))
            ((= ch "\\") (el-read-escape reader false))
            (t (js-call ch :codePointAt 0)))))


  (defun el-read-string (reader)
    (let ((parts (js-array)) (done false))
      (while (not done)
        (let ((ch (el-reader-next reader)))
          (cond
            ((nil? ch) (throw (el-make-signal "end-of-file" (js-array))))
            ((= ch "\"") (setq done t))
            ((= ch "\\")
              (let ((code (el-read-escape reader t)))
                (when (>= code 0)
                  (js-call parts :push (el-char-string (if (> code 4194303) (bit-and code 4194303) code))))))
            (t (js-call parts :push ch)))))
      (js-call parts :join "")))


  (defun el-read-token (reader)
    ;; Return {text, escaped}
    (let ((text "") (escaped false) (done false))
      (while (not done)
        (let ((ch (el-reader-peek reader)))
          (cond
            ((nil? ch) (setq done t))
            ((= ch "\\")
              (el-reader-next reader)
              (setq escaped t)
              (let ((next (el-reader-next reader)))
                (unless (nil? next) (setq text (str text next)))))
            ((js-call delimiter-pattern :test ch) (setq done t))
            (t (setq text (str text (el-reader-next reader)))))))
      (js-object :text text :escaped escaped)))


  (defun el-parse-atom (token)
    (let ((text (get token :text)))
      (cond
        ((get token :escaped) (el-intern text))
        ((js-call integer-token :test text)
          (Number/parseInt (js-call text :replace "." "") 10))
        ((js-call float-token :test text)
          (el-make-float (Number/parseFloat text)))
        ((js-call special-float-token :test text)
          (let ((match (js-call special-float-token :exec text)))
            (if (= (aref match 2) "NaN") globalThis.NaN
              (if (js-call (aref match 1) :startsWith "-") (- 0 globalThis.Infinity) globalThis.Infinity))))
        (t (el-intern text)))))


  (defun el-read-radix (reader radix)
    (let ((token (get (el-read-token reader) :text)))
      (let ((value (Number/parseInt token radix)))
        (when (Number/isNaN value) (el-read-error (str "integer, radix " radix)))
        value)))


  (defun el-read-sequence (reader close)
    ;; Read forms up to CLOSE; return {items, tail}
    (let ((items (js-array)) (tail nil) (done false))
      (while (not done)
        (el-skip-blank reader)
        (let ((ch (el-reader-peek reader)))
          (cond
            ((nil? ch) (throw (el-make-signal "end-of-file" (js-array))))
            ((= ch close) (el-reader-next reader) (setq done t))
            ((and (= close ")") (= ch ".")
                  (let ((after (js-call (get reader :source) :charAt (1+ (get reader :pos)))))
                    (or (= after "") (js-call delimiter-pattern :test after))))
              (el-reader-next reader)
              (setq tail (el-read-form reader))
              (el-skip-blank reader)
              (unless (= (el-reader-next reader) ")") (el-read-error ". in wrong context"))
              (setq done t))
            (t (js-call items :push (el-read-form reader))))))
      (js-object :items items :tail tail)))


  (defun el-read-form (reader)
    (el-skip-blank reader)
    (let ((ch (el-reader-next reader)))
      (cond
        ((nil? ch) (throw (el-make-signal "end-of-file" (js-array))))
        ((= ch "(")
          (let ((parts (el-read-sequence reader ")")))
            (el-list-from (get parts :items) (get parts :tail))))
        ((= ch "[") (el-vector (get (el-read-sequence reader "]") :items)))
        ((or (= ch ")") (= ch "]")) (el-read-error ch))
        ((= ch "\"") (el-read-string reader))
        ((= ch "?") (el-read-char-body reader))
        ((= ch "'") (el-list s-quote (el-read-form reader)))
        ((= ch "`") (el-list s-backquote (el-read-form reader)))
        ((= ch ",")
          (if (= (el-reader-peek reader) "@")
              (progn (el-reader-next reader) (el-list s-comma-at (el-read-form reader)))
            (el-list s-comma (el-read-form reader))))
        ((= ch "#") (el-read-dispatch reader))
        (t
          (put reader :pos (- (get reader :pos) (js-length ch)))
          (el-parse-atom (el-read-token reader))))))


  (defun el-read-dispatch (reader)
    (let ((ch (el-reader-peek reader)))
      (cond
        ((= ch "'") (el-reader-next reader) (el-list s-function (el-read-form reader)))
        ((or (= ch "x") (= ch "X")) (el-reader-next reader) (el-read-radix reader 16))
        ((or (= ch "o") (= ch "O")) (el-reader-next reader) (el-read-radix reader 8))
        ((or (= ch "b") (= ch "B")) (el-reader-next reader) (el-read-radix reader 2))
        ((= ch "#") (el-reader-next reader) (el-intern ""))
        ((= ch ":") (el-reader-next reader) (el-make-symbol (get (el-read-token reader) :text)))
        ((= ch "s")
          (el-reader-next reader)
          (unless (= (el-reader-next reader) "(") (el-read-error "#s"))
          (let ((items (get (el-read-sequence reader ")") :items)))
            (if (and (> (js-length items) 0) (el-sym-is (aref items 0) "hash-table"))
                (el-hash-table-literal items)
              (js-object :kind "record" :items items))))
        ((= ch "&")
          (el-reader-next reader)
          (el-read-token reader)
          (el-read-string reader))
        ((js-call (new globalThis.RegExp "^[0-9]$") :test ch)
          (let ((digits ""))
            (while (js-call (new globalThis.RegExp "^[0-9]$") :test (or (el-reader-peek reader) ""))
              (setq digits (str digits (el-reader-next reader))))
            (let ((marker (el-reader-next reader)))
              (cond
                ((or (= marker "r") (= marker "R")) (el-read-radix reader (Number/parseInt digits 10)))
                ((= marker "=") (el-read-form reader))
                ((= marker "#") nil)
                (t (el-read-error (str "#" digits marker)))))))
        ((= ch "@")
          (el-reader-next reader)
          (let ((count (get (el-read-token reader) :text)))
            (put reader :pos (+ (get reader :pos) 1 (Number/parseInt count 10))))
          (el-read-form reader))
        ((= ch "[") (el-read-error "#[ byte-code objects are not supported"))
        (t (el-read-error (str "#" ch))))))


  (defun el-read-all (source)
    (let ((reader (el-reader source)) (forms (js-array)) (done false))
      (while (not done)
        (el-skip-blank reader)
        (if (>= (get reader :pos) (get reader :length))
            (setq done t)
          (js-call forms :push (el-read-form reader))))
      forms))


  (defun el-read-from-string (source start)
    (let ((reader (el-reader source)))
      (put reader :pos (el-char-to-unit source (if (nullish? start) 0 start)))
      (let ((form (el-read-form reader)))
        (el-cons form (el-unit-to-char source (get reader :pos))))))


  ;; ------------------------------------------------------------------
  ;; format
  ;; ------------------------------------------------------------------

  (defconst format-directive
    (new globalThis.RegExp "%(?:([0-9]+)\\$)?([-+ #0]*)([0-9]*)(?:\\.([0-9]+))?([sSdoxXcefg%])" "g"))


  (defun el-pad (text width left zero)
    (let ((length (el-string-length text)))
      (if (or (nil? width) (>= length width)) text
        (let ((padding (js-call (if zero "0" " ") :repeat (- width length))))
          (cond
            (left (str text (js-call " " :repeat (- width length))))
            ((and zero (or (js-call text :startsWith "-") (js-call text :startsWith "+")))
              (str (js-call text :slice 0 1) padding (js-call text :slice 1)))
            (t (str padding text)))))))


  (defun el-format-exponent (x precision)
    (el-pad-exponent (js-call x :toExponential precision)))


  (defun el-format (session template args)
    (let ((index 0))
      (js-call template :replace format-directive
               (lambda (whole field flags width precision spec)
                 (if (= spec "%") "%"
                   (let* ((position (if (undefined? field) index (1- (Number/parseInt field 10))))
                          (value (if (< position (js-length args)) (aref args position)
                                   (el-signal "error" "Not enough arguments for format string")))
                          (left (>= (js-call flags :indexOf "-") 0))
                          (zero (and (>= (js-call flags :indexOf "0") 0) (not left)))
                          (plus (>= (js-call flags :indexOf "+") 0))
                          (space (>= (js-call flags :indexOf " ") 0))
                          (alternate (>= (js-call flags :indexOf "#") 0))
                          (w (if (= width "") nil (Number/parseInt width 10)))
                          (p (if (or (undefined? precision) (= precision "")) nil (Number/parseInt precision 10))))
                     (setq index (1+ position))
                     (let ((sign (lambda (text number)
                                   (cond ((and plus (>= number 0) (not (js-call text :startsWith "-"))) (str "+" text))
                                         ((and space (>= number 0) (not (js-call text :startsWith "-"))) (str " " text))
                                         (t text)))))
                       (cond
                         ((or (= spec "s") (= spec "S"))
                           (let ((text (el-prin1-string value (= spec "S"))))
                             (el-pad (if (nil? p) text (el-substring text 0 (Math/min p (el-string-length text)))) w left false)))
                         ((= spec "c") (el-pad (el-char-string (el-num value)) w left false))
                         ((= spec "d")
                           (let ((n (Math/trunc (el-num value))))
                             (el-pad (funcall sign (el-integer-string n) n) w left zero)))
                         ((or (= spec "o") (= spec "x") (= spec "X"))
                           (let* ((n (Math/trunc (el-num value)))
                                  (digits (js-call (Math/abs n) :toString (if (= spec "o") 8 16)))
                                  (text (str (if (< n 0) "-" "") (if (= spec "X") (js-call digits :toUpperCase) digits))))
                             (el-pad (if (and p (< (js-length text) p)) (js-call text :padStart p "0") text) w left zero)))
                         ((= spec "f")
                           (let ((n (el-num value)))
                             (el-pad (funcall sign (js-call n :toFixed (if (nil? p) 6 p)) n) w left zero)))
                         ((= spec "e")
                           (let ((n (el-num value)))
                             (el-pad (funcall sign (el-format-exponent n (if (nil? p) 6 p)) n) w left zero)))
                         ((= spec "g")
                           (let ((n (el-num value)))
                             (el-pad (funcall sign (el-format-g n (if (nil? p) 6 p) alternate) n) w left zero)))
                         (t whole)))))))))


  ;; ------------------------------------------------------------------
  ;; JSON (native json-parse-string/json-serialize and json.el json-encode)
  ;; ------------------------------------------------------------------

  (defun el-json-options (session args start)
    (let ((options (js-object :objectType "hash-table" :arrayType "array" :keyType nil
                              :nullObject (el-intern ":null") :falseObject (el-intern ":false")))
          (index start))
      (while (< index (js-length args))
        (let ((key (el-symbol-name (aref args index))) (value (aref args (1+ index))))
          (cond ((= key ":object-type") (put options :objectType (el-symbol-name value)))
                ((= key ":array-type") (put options :arrayType (el-symbol-name value)))
                ((= key ":null-object") (put options :nullObject value))
                ((= key ":false-object") (put options :falseObject value))))
        (setq index (+ index 2)))
      options))


  (defun el-json-read-options (session)
    (let* ((obj-type (let ((v (el-global-value session (el-intern "json-object-type"))))
                       (if (el-symobj? v) (get v :name) "alist")))
           (arr-type (let ((v (el-global-value session (el-intern "json-array-type"))))
                       (if (and (el-symobj? v) (= (get v :name) "list")) "list" "array")))
           (key-type (let ((v (el-global-value session (el-intern "json-key-type"))))
                       (if (and (el-symobj? v) (not (nil? v))) (get v :name) nil)))
           (null-obj (el-global-value session (el-intern "json-null")))
           (false-obj (el-global-value session (el-intern "json-false"))))
      (js-object :objectType obj-type :arrayType arr-type :keyType key-type
                 :nullObject null-obj :falseObject false-obj)))


  (defun el-json-error (message position)
    (throw (el-make-signal "json-parse-error" (js-array message position))))


  (defun el-json-parse (session text options)
    ;; Recursive descent parser that keeps integer/float distinction.
    (let ((state (js-object :pos 0)) (n (js-length text)))
      (letfn ((skip ()
                (while (and (< (get state :pos) n)
                            (>= (js-call " \t\n\r" :indexOf (js-call text :charAt (get state :pos))) 0))
                  (put state :pos (1+ (get state :pos)))))
              (expect-char (ch)
                (skip)
                (unless (= (js-call text :charAt (get state :pos)) ch)
                  (el-json-error (str "expected " ch) (get state :pos)))
                (put state :pos (1+ (get state :pos))))
              (parse-string ()
                (put state :pos (1+ (get state :pos)))
                (let ((parts (js-array)) (done false))
                  (while (not done)
                    (when (>= (get state :pos) n) (el-json-error "unterminated string" (get state :pos)))
                    (let ((ch (js-call text :charAt (get state :pos))))
                      (put state :pos (1+ (get state :pos)))
                      (cond
                        ((= ch "\"") (setq done t))
                        ((= ch "\\")
                          (let ((e (js-call text :charAt (get state :pos))))
                            (put state :pos (1+ (get state :pos)))
                            (cond
                              ((= e "n") (js-call parts :push "\n")) ((= e "t") (js-call parts :push "\t"))
                              ((= e "r") (js-call parts :push "\r")) ((= e "b") (js-call parts :push "\b"))
                              ((= e "f") (js-call parts :push "\f")) ((= e "/") (js-call parts :push "/"))
                              ((= e "\\") (js-call parts :push "\\")) ((= e "\"") (js-call parts :push "\""))
                              ((= e "u")
                                (js-call parts :push
                                         (String/fromCharCode (Number/parseInt (js-call text :slice (get state :pos) (+ (get state :pos) 4)) 16)))
                                (put state :pos (+ (get state :pos) 4)))
                              (t (el-json-error "bad escape" (get state :pos))))))
                        ((< (js-call ch :charCodeAt 0) 32) (el-json-error "control character in string" (get state :pos)))
                        (t (js-call parts :push ch)))))
                  (js-call parts :join "")))
              (parse-value ()
                (skip)
                (when (>= (get state :pos) n) (throw (el-make-signal "json-end-of-file" (js-array))))
                (let ((ch (js-call text :charAt (get state :pos))))
                  (cond
                    ((= ch "{")
                      (put state :pos (1+ (get state :pos)))
                      (let ((entries (js-array)))
                        (skip)
                        (if (= (js-call text :charAt (get state :pos)) "}")
                            (put state :pos (1+ (get state :pos)))
                          (let ((more t))
                            (while more
                              (skip)
                              (unless (= (js-call text :charAt (get state :pos)) "\"") (el-json-error "expected key" (get state :pos)))
                              (let ((key (parse-string)))
                                (expect-char ":")
                                (js-call entries :push (js-array key (parse-value))))
                              (skip)
                              (let ((sep (js-call text :charAt (get state :pos))))
                                (put state :pos (1+ (get state :pos)))
                                (cond ((= sep "}") (setq more false))
                                      ((not (= sep ",")) (el-json-error "expected , or }" (get state :pos))))))))
                        (el-json-object options entries)))
                    ((= ch "[")
                      (put state :pos (1+ (get state :pos)))
                      (let ((items (js-array)))
                        (skip)
                        (if (= (js-call text :charAt (get state :pos)) "]")
                            (put state :pos (1+ (get state :pos)))
                          (let ((more t))
                            (while more
                              (js-call items :push (parse-value))
                              (skip)
                              (let ((sep (js-call text :charAt (get state :pos))))
                                (put state :pos (1+ (get state :pos)))
                                (cond ((= sep "]") (setq more false))
                                      ((not (= sep ",")) (el-json-error "expected , or ]" (get state :pos))))))))
                        (if (= (get options :arrayType) "list") (el-list-from items) (el-vector items))))
                    ((= ch "\"") (parse-string))
                    ((js-call text :startsWith "true" (get state :pos)) (put state :pos (+ (get state :pos) 4)) t)
                    ((js-call text :startsWith "false" (get state :pos)) (put state :pos (+ (get state :pos) 5)) (get options :falseObject))
                    ((js-call text :startsWith "null" (get state :pos)) (put state :pos (+ (get state :pos) 4)) (get options :nullObject))
                    (t
                      (let* ((pattern (new globalThis.RegExp "-?(?:0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?" "y")))
                        (put pattern :lastIndex (get state :pos))
                        (let ((match (js-call pattern :exec text)))
                          (when (nil? match) (el-json-error "unexpected token" (get state :pos)))
                          (put state :pos (+ (get state :pos) (js-length (aref match 0))))
                          (let ((number (Number/parseFloat (aref match 0))))
                            (if (or (not (undefined? (aref match 1))) (not (undefined? (aref match 2))))
                                (el-make-float number)
                              number)))))))))
        (let ((value (parse-value)))
          (if (get options :allowTrailing)
              (put options :endPos (get state :pos))
            (progn
              (skip)
              (when (< (get state :pos) n) (throw (el-make-signal "json-trailing-content" (js-array (get state :pos)))))))
          value))))


  (defun el-json-object (options entries)
    (let ((type (get options :objectType))
          (ktype (get options :keyType)))
      (cond
        ((= type "alist")
          (el-list-from
           (js-call entries :map
                    (lambda (e)
                      (let ((k (cond ((= ktype "string") (aref e 0))
                                     ((= ktype "keyword") (el-intern (str ":" (aref e 0))))
                                     (t (el-intern (aref e 0))))))
                        (el-cons k (aref e 1)))))))
        ((= type "plist")
          (let ((items (js-array)))
            (js-call entries :forEach
