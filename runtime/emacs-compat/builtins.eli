(module eliscript.runtime.emacs-compat.builtins
  ;;; builtins.eli --- Standard Emacs Lisp builtin function table and session lifecycle

  (import "./core.eli" base-condition-messages base-condition-parents el-add-special-var el-append el-aref el-arith el-ascii? el-aset-container el-ash el-assoc-with el-bitwise el-bool el-bytes-string el-car el-car-safe el-cdr el-cdr-safe el-char-string el-char-to-unit el-char-width el-compare-chain el-cons el-cons? el-copy-sequence el-copy-tree el-decode-utf8 el-default-value el-delete-with el-divide el-downcase el-encode-utf8 el-eq el-eql el-equal el-equal-p el-float? el-function? el-gethash el-global-value el-hash-table? el-integer? el-intern el-keyword? el-kind el-last-cell el-length el-list el-list-from el-list-length el-list-to-array el-make-float el-make-hash-table el-make-signal el-make-symbol el-member-with el-mod el-mod-int el-multibyte? el-nconc el-nth el-nthcdr el-num el-number-string el-number? el-opt el-plist-get el-plist-member el-plist-put el-prin1-string el-proper-list-length el-puthash el-rassoc-with el-record? el-rem el-remhash el-reverse el-round-half-even el-rounding el-seq-items el-seq-like el-signal el-signal-message el-string-bytes-array el-string-codes el-string-from-codes el-string-length el-string-ref el-string-width el-string? el-substring el-sym-is el-symbol-name el-symbol-name-or-string el-symbol? el-symobj? el-type-of el-unit-to-char el-upcase el-vector el-vector? s-lambda symbol-table unibyte-strings)
  (import "./regexp-buffer.eli" el-buffer-delete el-buffer-insert el-buffer-size el-buffer-substring el-clamp-position el-current-buffer el-expand-replacement el-forward-line el-generate-new-buffer el-get-buffer-create el-kill-buffer el-line-beginning el-line-end el-looking-at el-match-position el-match-string el-point-max el-regexp-exec el-regexp-quote el-replace-regexp-in-string el-rx el-search-buffer el-split-string el-string-match el-string-trim)
  (import "./reader-format.eli" default-json-special-chars el-alist? el-compare-strings el-concat-pieces el-decode-time el-encode-time el-expand-file-name el-file-name-extension el-file-name-sans-extension el-file-relative-name el-format el-format-time-string el-json-encode el-json-options el-json-parse el-json-read-options el-json-serialize el-ms-to-time el-number-from-string el-parse-time-string el-plist-of-keywords? el-read-all el-read-from-string el-regexp-opt el-secure-hash el-time-to-ms el-truncate-string-to-width el-utc-zone?)
  (import "./evaluator.eli" el-call el-check-struct el-cl-find el-cl-typep el-def el-def-alias el-emit-output el-eq-test el-eql-test el-equal-test el-eval el-eval-body el-eval-call-fn el-get-prop el-key-extractor el-key-test el-macroexpand el-macroexpand-1 el-mapconcat el-normalize-result el-put-prop el-root-env el-seq-into-extension el-set-dynamic-variable el-set-fn el-sort-items el-symbol-function el-test-function el-throw el-write-stderr el-write-stdout el-write-stream special-forms)
  (import "./host-io.eli" el-accept-process-output el-call-process el-call-process-region el-drain-io-events el-ert-run-single-test el-ert-run-tests-batch el-ert-select-tests el-file-truename el-fs el-load-file el-locate-library el-make-pipe-process el-make-process el-os el-path el-sleep-for el-url-generic-parse-url el-url-retrieve el-url-retrieve-synchronously io-hub)
  (import "./extensions.eli" el-require)


  (defun el-install-kernel (session)
    (let* ((d (lambda (name fn) (el-def session name fn)))
           (d1 (lambda (name fn)
                 (el-def session name fn)
                 (put (el-intern name) :_inlineEval
                      (lambda (s cdr e)
                        (if (and (not (nil? cdr)) (nil? (get cdr :cdr)))
                            (el-normalize-result (funcall fn (el-eval s (get cdr :car) e)))
                          (el-eval-call-fn s fn cdr e))))))
           (d2 (lambda (name fn)
                 (el-def session name fn)
                 (put (el-intern name) :_inlineEval
                      (lambda (s cdr e)
                        (if (and (not (nil? cdr)) (not (nil? (get cdr :cdr))) (nil? (get (get cdr :cdr) :cdr)))
                            (let ((a0 (el-eval s (get cdr :car) e))
                                  (a1 (el-eval s (get (get cdr :cdr) :car) e)))
                              (el-normalize-result (funcall fn a0 a1)))
                          (el-eval-call-fn s fn cdr e)))))))
      ;; Arithmetic
      (funcall d "+" (lambda (&rest xs) (el-arith "+" xs)))
      (funcall d "-" (lambda (&rest xs) (el-arith "-" xs)))
      (funcall d "*" (lambda (&rest xs) (el-arith "*" xs)))
      (funcall d "/" (lambda (&rest xs) (el-divide xs)))
      (funcall d "%" (lambda (a b) (el-rem a b)))
      (funcall d "mod" (lambda (a b) (el-mod a b)))
      (funcall d1 "1+" (lambda (x) (if (= (js* "typeof x") "number") (+ x 1) (el-make-float (+ (el-num x) 1)))))
      (funcall d1 "1-" (lambda (x) (if (= (js* "typeof x") "number") (- x 1) (el-make-float (- (el-num x) 1)))))
      (funcall d "=" (lambda (&rest xs) (el-compare-chain "=" xs)))
      (funcall d "<" (lambda (&rest xs) (el-compare-chain "<" xs)))
      (funcall d ">" (lambda (&rest xs) (el-compare-chain ">" xs)))
      (funcall d "<=" (lambda (&rest xs) (el-compare-chain "<=" xs)))
      (funcall d ">=" (lambda (&rest xs) (el-compare-chain ">=" xs)))
      (funcall d "/=" (lambda (a b) (el-bool (/= (el-num a) (el-num b)))))
      (funcall d "max" (lambda (a &optional b &rest xs)
                         (if (nullish? b) a
                           (if (= (js-length xs) 0)
                               (if (and (= (js* "typeof a") "number") (= (js* "typeof b") "number")
                                        (Number/isInteger a) (Number/isInteger b))
                                   (if (> b a) b a)
                                 (let ((best (if (> (el-num b) (el-num a)) b a)))
                                   (if (or (el-float? a) (el-float? b)) (el-make-float (el-num best)) best)))
                             (let ((best (if (> (el-num b) (el-num a)) b a))
                                   (fl (or (el-float? a) (el-float? b) (js-call xs :some (lambda (x) (el-float? x))))))
                               (js-call xs :forEach (lambda (x) (when (> (el-num x) (el-num best)) (setq best x))))
                               (if fl (el-make-float (el-num best)) best))))))
      (funcall d "min" (lambda (a &optional b &rest xs)
                         (if (nullish? b) a
                           (if (= (js-length xs) 0)
                               (if (and (= (js* "typeof a") "number") (= (js* "typeof b") "number")
                                        (Number/isInteger a) (Number/isInteger b))
                                   (if (< b a) b a)
                                 (let ((best (if (< (el-num b) (el-num a)) b a)))
                                   (if (or (el-float? a) (el-float? b)) (el-make-float (el-num best)) best)))
                             (let ((best (if (< (el-num b) (el-num a)) b a))
                                   (fl (or (el-float? a) (el-float? b) (js-call xs :some (lambda (x) (el-float? x))))))
                               (js-call xs :forEach (lambda (x) (when (< (el-num x) (el-num best)) (setq best x))))
                               (if fl (el-make-float (el-num best)) best))))))
      (funcall d "abs" (lambda (x) (if (el-float? x) (el-make-float (Math/abs (el-num x))) (Math/abs x))))
      (funcall d "float" (lambda (x) (el-make-float (el-num x))))
      (funcall d "floor" (lambda (x &optional y) (el-rounding "floor" x (el-opt y))))
      (funcall d "ceiling" (lambda (x &optional y) (el-rounding "ceiling" x (el-opt y))))
      (funcall d "truncate" (lambda (x &optional y) (el-rounding "truncate" x (el-opt y))))
      (funcall d "round" (lambda (x &optional y) (el-rounding "round" x (el-opt y))))
      (funcall d "ffloor" (lambda (x) (el-make-float (Math/floor (el-num x)))))
      (funcall d "fceiling" (lambda (x) (el-make-float (Math/ceil (el-num x)))))
      (funcall d "fround" (lambda (x) (el-make-float (el-round-half-even (el-num x)))))
      (funcall d "ftruncate" (lambda (x) (el-make-float (Math/trunc (el-num x)))))
      (funcall d "sqrt" (lambda (x) (el-make-float (Math/sqrt (el-num x)))))
      (funcall d "exp" (lambda (x) (el-make-float (Math/exp (el-num x)))))
      (funcall d "log" (lambda (x &optional base)
                         (el-make-float (if (nullish? base) (Math/log (el-num x)) (/ (Math/log (el-num x)) (Math/log (el-num base)))))))
      (funcall d "expt" (lambda (a b)
                          (if (and (el-integer? a) (el-integer? b) (>= b 0)) (Math/pow a b)
                            (el-make-float (Math/pow (el-num a) (el-num b))))))
      (funcall d "isnan" (lambda (x) (el-bool (Number/isNaN (el-num x)))))
      (funcall d "random" (lambda (&optional limit)
                            (if (and (not (nullish? limit)) (el-integer? limit)) (Math/floor (* (Math/random) limit))
                              (Math/floor (* (Math/random) 2147483647)))))
      (funcall d "ash" (lambda (v c) (el-ash v c)))
      (funcall d "lsh" (lambda (v c) (el-ash v c)))
      (funcall d "logand" (lambda (&rest xs) (js-call xs :reduce (lambda (a b) (el-bitwise "and" a b)) -1)))
      (funcall d "logior" (lambda (&rest xs) (js-call xs :reduce (lambda (a b) (el-bitwise "or" a b)) 0)))
      (funcall d "logxor" (lambda (&rest xs) (js-call xs :reduce (lambda (a b) (el-bitwise "xor" a b)) 0)))
      (funcall d "lognot" (lambda (x) (- -1 x)))
      (funcall d "logcount" (lambda (x) (let ((n (Math/abs x)) (c 0)) (while (> n 0) (setq c (+ c (% n 2))) (setq n (Math/floor (/ n 2)))) c)))
      ;; Predicates
      (funcall d1 "null" (lambda (x) (el-bool (nil? x))))
      (funcall d1 "not" (lambda (x) (el-bool (nil? x))))
      (funcall d1 "atom" (lambda (x) (el-bool (not (el-cons? x)))))
      (funcall d1 "consp" (lambda (x) (el-bool (el-cons? x))))
      (funcall d1 "listp" (lambda (x) (el-bool (or (nil? x) (el-cons? x)))))
      (funcall d1 "nlistp" (lambda (x) (el-bool (not (or (nil? x) (el-cons? x))))))
      (funcall d "proper-list-p" (lambda (x) (el-proper-list-length x)))
      (funcall d "plistp" (lambda (x) (let ((len (el-proper-list-length x))) (el-bool (and (el-integer? len) (= (el-mod-int len 2) 0))))))
      (funcall d1 "symbolp" (lambda (x) (el-bool (el-symbol? x))))
      (funcall d1 "keywordp" (lambda (x) (el-bool (el-keyword? x))))
      (funcall d1 "stringp" (lambda (x) (el-bool (el-string? x))))
      (funcall d1 "numberp" (lambda (x) (el-bool (el-number? x))))
      (funcall d1 "number-or-marker-p" (lambda (x) (el-bool (el-number? x))))
      (funcall d1 "integerp" (lambda (x) (el-bool (el-integer? x))))
      (funcall d1 "fixnump" (lambda (x) (el-bool (el-integer? x))))
      (funcall d1 "bignump" (lambda (x) nil))
      (funcall d1 "natnump" (lambda (x) (el-bool (and (el-integer? x) (>= x 0)))))
      (funcall d1 "floatp" (lambda (x) (el-bool (el-float? x))))
      (funcall d1 "zerop" (lambda (x) (el-bool (= (el-num x) 0))))
      (funcall d1 "cl-plusp" (lambda (x) (el-bool (> (el-num x) 0))))
      (funcall d1 "cl-minusp" (lambda (x) (el-bool (< (el-num x) 0))))
      (funcall d1 "cl-evenp" (lambda (x) (el-bool (= (el-mod-int (el-num x) 2) 0))))
      (funcall d1 "cl-oddp" (lambda (x) (el-bool (= (el-mod-int (el-num x) 2) 1))))
      (funcall d1 "characterp" (lambda (x) (el-bool (and (el-integer? x) (>= x 0) (<= x 4194303)))))
      (funcall d1 "vectorp" (lambda (x) (el-bool (el-vector? x))))
      (funcall d1 "arrayp" (lambda (x) (el-bool (or (el-vector? x) (el-string? x)))))
      (funcall d1 "sequencep" (lambda (x) (el-bool (or (nil? x) (el-cons? x) (el-vector? x) (el-string? x)))))
      (funcall d1 "recordp" (lambda (x) (el-bool (el-record? x))))
      (funcall d "functionp" (lambda (x)
                               (el-bool (or (el-function? x)
                                            (and (el-symobj? x) (not (el-keyword? x)) (not (nil? (el-symbol-function session x)))
                                                 (not (js-call (get session :macros) :has x)))
                                            (and (el-cons? x) (eq (get x :car) s-lambda))))))
      (funcall d1 "subrp" (lambda (x) (el-bool (el-function? x))))
      (funcall d1 "hash-table-p" (lambda (x) (el-bool (el-hash-table? x))))
      (funcall d1 "bufferp" (lambda (x) (el-bool (= (el-kind x) "buffer"))))
      (funcall d1 "booleanp" (lambda (x) (el-bool (or (nil? x) (eq x t)))))
      (funcall d1 "char-or-string-p" (lambda (x) (el-bool (or (el-string? x) (el-integer? x)))))
      (funcall d1 "type-of" (lambda (x) (el-intern (el-type-of x))))
      (funcall d2 "cl-typep" (lambda (x type) (el-cl-typep session x type)))
      (funcall d2 "eq" (lambda (a b) (el-eq a b)))
      (funcall d2 "eql" (lambda (a b) (el-eql a b)))
      (funcall d2 "equal" (lambda (a b) (el-equal a b)))
      (funcall d1 "identity" (lambda (x) x))
      (funcall d "ignore" (lambda (&rest xs) nil))
      (funcall d "always" (lambda (&rest xs) t))
      ;; Conses and lists
      (funcall d2 "cons" (lambda (a b) (el-cons a b)))
      (funcall d1 "car" (lambda (x) (el-car x)))
      (funcall d1 "cdr" (lambda (x) (el-cdr x)))
      (funcall d1 "car-safe" (lambda (x) (el-car-safe x)))
      (funcall d1 "cdr-safe" (lambda (x) (el-cdr-safe x)))
      (funcall d1 "caar" (lambda (x) (el-car (el-car x))))
      (funcall d1 "cadr" (lambda (x) (el-car (el-cdr x))))
      (funcall d1 "cdar" (lambda (x) (el-cdr (el-car x))))
      (funcall d1 "cddr" (lambda (x) (el-cdr (el-cdr x))))
      (funcall d1 "caddr" (lambda (x) (el-car (el-cdr (el-cdr x)))))
      (funcall d1 "cdddr" (lambda (x) (el-cdr (el-cdr (el-cdr x)))))
      (funcall d1 "caadr" (lambda (x) (el-car (el-car (el-cdr x)))))
      (funcall d1 "cddar" (lambda (x) (el-cdr (el-cdr (el-car x)))))
      (funcall d1 "cdadr" (lambda (x) (el-cdr (el-car (el-cdr x)))))
      (funcall d1 "cadar" (lambda (x) (el-car (el-cdr (el-car x)))))
      (funcall d1 "cl-first" (lambda (x) (el-car x)))
      (funcall d1 "cl-second" (lambda (x) (el-nth 1 x)))
      (funcall d1 "cl-third" (lambda (x) (el-nth 2 x)))
      (funcall d1 "cl-rest" (lambda (x) (el-cdr x)))
      (funcall d2 "setcar" (lambda (cell v) (unless (el-cons? cell) (el-signal "wrong-type-argument" (el-intern "consp") cell)) (put cell :car v) v))
      (funcall d2 "setcdr" (lambda (cell v) (unless (el-cons? cell) (el-signal "wrong-type-argument" (el-intern "consp") cell)) (put cell :cdr v) v))
      (funcall d "list" (lambda (&rest xs) (el-list-from xs)))
      (funcall d "list*" (lambda (&rest xs) (el-list-from (js-call xs :slice 0 -1) (aref xs (1- (js-length xs))))))
      (funcall d "cl-list*" (lambda (&rest xs) (el-list-from (js-call xs :slice 0 -1) (aref xs (1- (js-length xs))))))
      (funcall d2 "make-list" (lambda (n x) (el-list-from (js-call (new globalThis.Array n) :fill x))))
      (funcall d1 "length" (lambda (x) (el-length x)))
      (funcall d1 "safe-length" (lambda (x) (el-list-length x)))
      (funcall d2 "nth" (lambda (n l) (el-nth n l)))
      (funcall d2 "nthcdr" (lambda (n l) (el-nthcdr n l)))
      (funcall d2 "elt" (lambda (seq n) (if (or (nil? seq) (el-cons? seq)) (el-nth n seq) (el-aref seq n))))
      (funcall d "last" (lambda (l &optional n) (el-last-cell l (el-opt n))))
      (funcall d "butlast" (lambda (l &optional n)
                             (let ((items (el-list-to-array l)) (count (if (nullish? n) 1 n)))
                               (el-list-from (js-call items :slice 0 (Math/max 0 (- (js-length items) count)))))))
      (funcall d "nbutlast" (lambda (l &optional n)
                              (let ((items (el-list-to-array l)) (count (if (nullish? n) 1 n)))
                                (el-list-from (js-call items :slice 0 (Math/max 0 (- (js-length items) count)))))))
      (funcall d "append" (lambda (&rest xs) (el-append xs)))
      (funcall d "nconc" (lambda (&rest xs) (el-nconc xs)))
      (funcall d1 "reverse" (lambda (x) (el-reverse x)))
      (funcall d1 "nreverse" (lambda (x) (el-reverse x)))
      (funcall d1 "copy-sequence" (lambda (x) (el-copy-sequence x)))
      (funcall d "copy-tree" (lambda (x &optional v) (el-copy-tree x (and (not (nullish? v)) (not (nil? v))))))
      (funcall d "copy-alist" (lambda (x) (el-list-from (js-call (el-list-to-array x) :map (lambda (c) (if (el-cons? c) (el-cons (get c :car) (get c :cdr)) c))))))
      (funcall d "memq" (lambda (x l)
                          (let ((cursor l) (found nil))
                            (while (and (nil? found) (el-cons? cursor))
                              (if (eq x (get cursor :car))
                                  (setq found cursor)
                                (setq cursor (get cursor :cdr))))
                            found)))
      (funcall d "memql" (lambda (x l) (el-member-with x l el-eql-test)))
      (funcall d "member" (lambda (x l) (el-member-with x l el-equal-test)))
      (funcall d "assq" (lambda (k l)
                          (let ((cursor l) (found nil))
                            (while (and (nil? found) (el-cons? cursor))
                              (let ((cell (get cursor :car)))
                                (if (and (el-cons? cell) (eq k (get cell :car)))
                                    (setq found cell)
                                  (setq cursor (get cursor :cdr)))))
                            found)))
      (funcall d "assoc" (lambda (k l &optional testfn) (el-assoc-with k l (el-test-function session (el-opt testfn) el-equal-test))))
      (funcall d "assq-delete-all"
               (lambda (key alist)
                 (el-list-from (js-call (el-list-to-array alist) :filter
                                        (lambda (c) (not (and (el-cons? c) (el-eq-test (get c :car) key))))))))
      (funcall d "assoc-delete-all"
               (lambda (key alist &optional testfn)
                 (let ((test (el-test-function session (el-opt testfn) el-equal-test)))
                   (el-list-from (js-call (el-list-to-array alist) :filter
                                          (lambda (c) (not (and (el-cons? c) (funcall test (get c :car) key)))))))))
      (funcall d "assoc-default" (lambda (k l) (let ((c (el-assoc-with k l el-equal-test))) (if (nil? c) nil (get c :cdr)))))
      (funcall d "assoc-string" (lambda (k l &optional fold)
                                  (el-assoc-with (el-symbol-name-or-string k) l
                                                 (lambda (a b) (and (or (el-string? b) (el-symobj? b))
                                                                    (if (and (not (nullish? fold)) (not (nil? fold)))
                                                                        (= (js-call a :toLowerCase) (js-call (el-symbol-name-or-string b) :toLowerCase))
                                                                      (= a (el-symbol-name-or-string b))))))))
      (funcall d "rassq" (lambda (k l)
                           (let ((cursor l) (found nil))
                             (while (and (nil? found) (el-cons? cursor))
                               (let ((cell (get cursor :car)))
                                 (if (and (el-cons? cell) (eq k (get cell :cdr)))
                                     (setq found cell)
                                   (setq cursor (get cursor :cdr)))))
                             found)))
      (funcall d "rassoc" (lambda (k l) (el-rassoc-with k l el-equal-test)))
      (funcall d "alist-get" (lambda (key alist &optional default remove testfn)
                               (if (or (nullish? testfn) (nil? testfn) (el-sym-is testfn "eq"))
                                   (let ((cursor alist) (found undefined))
                                     (while (and (undefined? found) (el-cons? cursor))
                                       (let ((cell (get cursor :car)))
                                         (if (and (el-cons? cell) (eq key (get cell :car)))
                                             (setq found (get cell :cdr))
                                           (setq cursor (get cursor :cdr)))))
                                     (if (undefined? found) (el-opt default) found))
                                 (let ((cell (el-assoc-with key alist (el-test-function session (el-opt testfn) el-eq-test))))
                                   (if (nil? cell) (el-opt default) (get cell :cdr))))))
      (funcall d "plist-get" (lambda (pl prop &optional pred)
                               (if (or (nullish? pred) (nil? pred))
                                   (let ((cursor pl) (found nil) (done false))
                                     (while (and (not done) (el-cons? cursor) (el-cons? (get cursor :cdr)))
                                       (if (eq (get cursor :car) prop)
                                           (progn (setq found (get (get cursor :cdr) :car)) (setq done t))
                                         (setq cursor (get (get cursor :cdr) :cdr))))
                                     found)
                                 (el-plist-get pl prop (el-test-function session pred el-eq-test)))))
      (funcall d "plist-put" (lambda (pl prop v &optional pred) (el-plist-put pl prop v (el-test-function session (el-opt pred) el-eq-test))))
      (funcall d "plist-member" (lambda (pl prop &optional pred) (el-plist-member pl prop (el-test-function session (el-opt pred) el-eq-test))))
      (funcall d "lax-plist-get" (lambda (pl prop) (el-plist-get pl prop el-equal-test)))
      (funcall d "delq" (lambda (x l) (el-delete-with x l el-eq-test)))
      (funcall d "remq" (lambda (x l) (el-delete-with x l el-eq-test)))
      (funcall d "delete" (lambda (x l) (el-delete-with x l el-equal-test)))
      (funcall d "remove" (lambda (x l) (el-delete-with x l el-equal-test)))
      (funcall d "delete-dups" (lambda (l)
                                 (let ((kept (js-array)))
                                   (js-call (el-list-to-array l) :forEach
                                            (lambda (x) (unless (js-call kept :some (lambda (y) (el-equal-p x y 0))) (js-call kept :push x))))
                                   (el-list-from kept))))
      (funcall d "number-sequence" (lambda (from &optional to sep)
                                     (if (or (nullish? to) (nil? to) (= (el-num from) (el-num to)))
                                         (el-list from)
                                       (let ((step (if (or (nullish? sep) (nil? sep)) 1 sep))
                                             (items (js-array)) (x from))
                                         (when (= (el-num step) 0) (el-signal "args-out-of-range" step))
                                         (while (if (> (el-num step) 0) (<= (el-num x) (el-num to)) (>= (el-num x) (el-num to)))
                                           (js-call items :push x)
                                           (setq x (el-arith "+" (js-array x step))))
