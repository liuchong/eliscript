      (funcall d "rename-file"
               (lambda (file newname &optional ok-if-already-exists)
                 (let ((fs (el-fs)))
                   (when (nullish? fs) (el-signal "file-error" "File access not available"))
                   (let* ((src (el-expand-file-name session file nil))
                          (dst-raw (el-expand-file-name session newname nil))
                          (dst (if (or (js-call newname :endsWith "/")
                                       (try (js-call (js-call fs :statSync dst-raw) :isDirectory) (catch e false)))
                                   (el-expand-file-name session (js-call src :slice (1+ (js-call src :lastIndexOf "/"))) dst-raw)
                                 dst-raw)))
