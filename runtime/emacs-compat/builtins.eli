      (funcall d "keymap-unset" (lambda (keymap key &optional remove) nil))
      (funcall d "lookup-key" (lambda (keymap key &optional accept-default) nil))
      (funcall d "keymap-lookup" (lambda (keymap key &rest ignored) nil))
      (funcall d "autoload" (lambda (fn file &rest ignored) fn))
      (funcall d "custom-autoload" (lambda (&rest ignored) nil))
      (funcall d "display-graphic-p" (lambda (&optional display) nil))
      (funcall d "called-interactively-p" (lambda (&optional kind) nil))
      (funcall d "url-generic-parse-url" (lambda (url) (el-url-generic-parse-url session url)))
      (funcall d "url-portspec" (lambda (u) (el-call session (el-intern "url-portsitory") (js-array u))))
      (funcall d "url-port"
               (lambda (u)
                 (let ((explicit (el-call session (el-intern "url-portsitory") (js-array u))))
                   (if (el-integer? explicit)
                       explicit
                     (let ((scheme (el-call session (el-intern "url-type") (js-array u))))
                       (cond ((= scheme "http") 80)
                             ((= scheme "https") 443)
                             ((= scheme "ftp") 21)
                             ((= scheme "ssh") 22)
                             (t 0)))))))
      (funcall d "url-retrieve"
               (lambda (url callback &optional cbargs silent inhibit-cookies)
                 (el-url-retrieve session url callback (el-opt cbargs) (el-opt silent) (el-opt inhibit-cookies))))
      (funcall d "url-retrieve-synchronously"
               (lambda (url &optional silent inhibit-cookies timeout)
                 (el-url-retrieve-synchronously session url (el-opt silent) (el-opt inhibit-cookies) (el-opt timeout))))
      ;; Subprocesses and pipes
      (funcall d "call-process"
               (lambda (program &optional infile destination display &rest args)
                 (Reflect/apply el-call-process nil (js-call (js-array session program (el-opt infile) (el-opt destination) (el-opt display)) :concat args))))
      (el-def-alias session "process-file" "call-process")
      (funcall d "call-process-region"
               (lambda (start end program &optional delete destination display &rest args)
                 (Reflect/apply el-call-process-region nil (js-call (js-array session start end program (el-opt delete) (el-opt destination) (el-opt display)) :concat args))))
      (funcall d "shell-command-to-string"
               (lambda (cmd)
                 (let ((buf (el-generate-new-buffer session " *shell-cmd*")))
                   (try
                     (progn
                       (el-call-process session (or (el-call session (el-intern "getenv") (js-array "SHELL")) "/bin/sh")
                                        nil buf nil "-c" cmd)
                       (get buf :text))
                     (finally (el-kill-buffer session buf))))))
      (funcall d "make-process" (lambda (&rest args) (el-make-process session args)))
      (funcall d "make-pipe-process" (lambda (&rest args) (el-make-pipe-process session args)))
      (funcall d "start-process"
               (lambda (name buffer program &rest program-args)
                 (if (nil? program)
                     (el-make-pipe-process session (js-array (el-intern ":name") name (el-intern ":buffer") buffer))
                   (el-make-process session
                                    (js-array (el-intern ":name") name
                                              (el-intern ":buffer") buffer
                                              (el-intern ":command") (el-cons program (el-list-from program-args)))))))
      (funcall d "processp" (lambda (x) (el-bool (= (el-kind x) "process"))))
      (funcall d "process-live-p"
               (lambda (p)
                 (el-drain-io-events session)
                 (el-bool (and (= (el-kind p) "process") (get p :live)))))
      (funcall d "process-status"
               (lambda (p)
                 (el-drain-io-events session)
                 (if (= (el-kind p) "process") (get p :status) nil)))
      (funcall d "process-exit-status"
               (lambda (p)
                 (el-drain-io-events session)
                 (if (= (el-kind p) "process") (or (get p :exitStatus) 0) 0)))
      (funcall d "process-id" (lambda (p) (if (= (el-kind p) "process") (get p :pid) nil)))
      (funcall d "process-name" (lambda (p) (if (= (el-kind p) "process") (get p :name) nil)))
      (funcall d "process-buffer" (lambda (p) (if (= (el-kind p) "process") (get p :buffer) nil)))
      (funcall d "set-process-buffer" (lambda (p b) (when (= (el-kind p) "process") (put p :buffer b)) b))
      (funcall d "get-buffer-process"
               (lambda (b)
                 (let* ((buf (if (el-string? b) (el-call session (el-intern "get-buffer") (js-array b)) b))
                        (procs (get session :processes))
                        (found (js-call procs :find (lambda (p) (and (get p :live) (eq (get p :buffer) buf))))))
                   (if (undefined? found) nil found))))
      (funcall d "process-filter" (lambda (p) (if (= (el-kind p) "process") (get p :filter) nil)))
      (funcall d "set-process-filter" (lambda (p f) (when (= (el-kind p) "process") (put p :filter f)) f))
      (funcall d "process-sentinel" (lambda (p) (if (= (el-kind p) "process") (get p :sentinel) nil)))
      (funcall d "set-process-sentinel" (lambda (p s) (when (= (el-kind p) "process") (put p :sentinel s)) s))
      (funcall d "process-put" (lambda (p prop val) (when (= (el-kind p) "process") (js-call (get p :plist) :set prop val)) val))
      (funcall d "process-get" (lambda (p prop) (if (and (= (el-kind p) "process") (js-call (get p :plist) :has prop)) (js-call (get p :plist) :get prop) nil)))
      (funcall d "process-plist"
               (lambda (p)
                 (let ((items (js-array)))
                   (when (= (el-kind p) "process")
                     (js-call (get p :plist) :forEach (lambda (v k) (js-call items :push k) (js-call items :push v))))
                   (el-list-from items))))
      (funcall d "set-process-plist"
               (lambda (p plist)
                 (when (= (el-kind p) "process")
                   (js-call (get p :plist) :clear)
                   (let ((arr (el-list-to-array plist)) (i 0))
                     (while (< (1+ i) (js-length arr))
                       (js-call (get p :plist) :set (aref arr i) (aref arr (1+ i)))
                       (setq i (+ i 2)))))
                 plist))
      (funcall d "process-list" (lambda () (el-drain-io-events session) (el-list-from (js-call (get session :processes) :filter (lambda (p) (get p :live))))))
      (funcall d "set-process-query-on-exit-flag" (lambda (p flag) (when (= (el-kind p) "process") (put p :noquery (nil? flag))) flag))
      (funcall d "set-process-coding-system" (lambda (&rest ignored) nil))
      (funcall d "process-send-string"
               (lambda (p str-val)
                 (when (and (= (el-kind p) "process") (get p :live) (not (nil? io-hub)))
                   (js-call (get io-hub :worker) :postMessage
                            (js-object :type "stdin" :id (get p :id) :bytes (el-string-bytes-array str-val))))
                 nil))
      (funcall d "process-send-region"
               (lambda (p start end)
                 (let ((text (el-buffer-substring (el-current-buffer session) start end)))
                   (el-call session (el-intern "process-send-string") (js-array p text)))))
      (funcall d "process-send-eof"
               (lambda (&optional p)
                 (when (and (= (el-kind p) "process") (get p :live) (not (nil? io-hub)))
                   (js-call (get io-hub :worker) :postMessage (js-object :type "eof" :id (get p :id))))
                 p))
      (funcall d "delete-process"
               (lambda (&optional p)
                 (when (= (el-kind p) "process")
                   (when (and (get p :live) (not (nil? io-hub)) (> (get p :id) 0))
                     (js-call (get io-hub :worker) :postMessage (js-object :type "kill" :id (get p :id) :sig "SIGKILL"))
                     (js-call (get io-hub :procs) :delete (get p :id))
                     (js-call (get io-hub :httpReqs) :delete (get p :id)))
                   (put p :live false)
                   (put p :status (el-intern "exit")))
                 nil))
      (funcall d "kill-process"
               (lambda (&optional p current-group)
                 (when (and (= (el-kind p) "process") (get p :live) (not (nil? io-hub)) (> (get p :id) 0))
                   (js-call (get io-hub :worker) :postMessage (js-object :type "kill" :id (get p :id) :sig "SIGKILL")))
                 p))
      (funcall d "interrupt-process"
               (lambda (&optional p current-group)
                 (when (and (= (el-kind p) "process") (get p :live) (not (nil? io-hub)) (> (get p :id) 0))
                   (js-call (get io-hub :worker) :postMessage (js-object :type "kill" :id (get p :id) :sig "SIGINT")))
                 p))
      (funcall d "accept-process-output"
               (lambda (&optional proc seconds millisec just-this-one)
                 (el-accept-process-output session (el-opt proc) (el-opt seconds) (el-opt millisec) (el-opt just-this-one))))
      (funcall d "sleep-for" (lambda (seconds &optional millisec) (el-sleep-for session seconds (el-opt millisec))))
      (funcall d "sit-for" (lambda (seconds &optional nodisp) (el-sleep-for session seconds nil) t))
      (funcall d "kill-emacs"
               (lambda (&optional exit-data do-not-run-hooks)
                 (unless (and (not (nullish? do-not-run-hooks)) (not (nil? do-not-run-hooks)))
                   (try (el-call session (el-intern "run-hooks") (js-array (el-intern "kill-emacs-hook"))) (catch e nil)))
                 (let ((code (if (el-integer? exit-data) exit-data 0)))
                   (throw (js-object :eliscriptBatchExit t :code code :conditionSymbol "error" :data (js-array "kill-emacs" code))))))
      ;; ERT functions
      (funcall d "ert-fail"
               (lambda (data)
                 (throw (el-make-signal "ert-test-failed" (if (el-string? data) (js-array data) (el-seq-items data))))))
      (funcall d "ert-skip"
               (lambda (data)
                 (throw (el-make-signal "ert-test-skipped" (if (el-string? data) (js-array data) (el-seq-items data))))))
      (funcall d "ert-get-test"
               (lambda (sym)
                 (let ((test (js-call (get session :ertTests) :get sym)))
                   (if (undefined? test) (el-signal "error" (str "No test named " (el-symbol-name sym))) test))))
      (funcall d "ert-test-boundp" (lambda (sym) (el-bool (js-call (get session :ertTests) :has sym))))
      (funcall d "ert-select-tests" (lambda (selector universe) (el-list-from (el-ert-select-tests session selector))))
      (funcall d "ert-test-name" (lambda (test) (get test :name)))
      (funcall d "ert-test-most-recent-result" (lambda (test) (get test :mostRecentResult)))
      (funcall d "ert-test-passed-p" (lambda (res) (el-bool (and (not (nil? res)) (= (get res :status) "passed")))))
      (funcall d "ert-test-failed-p" (lambda (res) (el-bool (and (not (nil? res)) (= (get res :status) "failed")))))
      (funcall d "ert-test-skipped-p" (lambda (res) (el-bool (and (not (nil? res)) (= (get res :status) "skipped")))))
      (funcall d "ert-test-result-type-p"
               (lambda (res type)
                 (let ((tname (el-symbol-name type)))
                   (el-bool (and (not (nil? res))
                                 (or (and (= tname ":passed") (= (get res :status) "passed"))
                                     (and (= tname ":failed") (= (get res :status) "failed"))
                                     (and (= tname ":skipped") (= (get res :status) "skipped"))))))))
      (funcall d "ert-run-test" (lambda (test) (el-ert-run-single-test session test)))
      (funcall d "ert-run-tests-batch" (lambda (&optional selector) (el-ert-run-tests-batch session (el-opt selector))))
      (funcall d "ert-run-tests-batch-and-exit"
               (lambda (&optional selector)
                 (let ((stats (el-ert-run-tests-batch session (el-opt selector))))
                   (el-call session (el-intern "kill-emacs") (js-array (if (> (get stats :failed) 0) 1 0))))))
      (funcall d "ert--stats-total" (lambda (s) (get s :total)))
      (funcall d "ert--stats-completed-expected" (lambda (s) (get s :passed)))
      (funcall d "ert--stats-completed-unexpected" (lambda (s) (get s :failed)))
      (funcall d "ert--stats-skipped" (lambda (s) (get s :skipped)))
      ;; seq.el / cl-lib generics
      (funcall d "seq-length" (lambda (s) (el-length s)))
      (funcall d "seq-elt" (lambda (s n) (aref (el-seq-items s) n)))
      (funcall d "seq-first" (lambda (s) (el-opt (aref (el-seq-items s) 0))))
      (funcall d "seq-rest" (lambda (s) (el-seq-like s (js-call (el-seq-items s) :slice 1))))
      (funcall d "seq-empty-p" (lambda (s) (el-bool (= (js-length (el-seq-items s)) 0))))
      (funcall d "seq-map" (lambda (fn s) (el-list-from (js-call (el-seq-items s) :map (lambda (x) (el-call session fn (js-array x)))))))
      (funcall d "seq-mapn" (lambda (fn &rest seqs) (el-call session (el-intern "cl-mapcar") (js-call (js-array fn) :concat seqs))))
      (funcall d "seq-filter" (lambda (fn s) (el-list-from (js-call (el-seq-items s) :filter (lambda (x) (not (nil? (el-call session fn (js-array x)))))))))
      (funcall d "seq-remove" (lambda (fn s) (el-list-from (js-call (el-seq-items s) :filter (lambda (x) (nil? (el-call session fn (js-array x))))))))
      (funcall d "seq-reduce" (lambda (fn s init) (js-call (el-seq-items s) :reduce (lambda (acc x) (el-call session fn (js-array acc x))) init)))
      (funcall d "seq-some" (lambda (fn s)
                              (let ((found nil))
                                (js-call (el-seq-items s) :some (lambda (x) (setq found (el-call session fn (js-array x))) (not (nil? found))))
                                found)))
      (funcall d "seq-every-p" (lambda (fn s) (el-bool (js-call (el-seq-items s) :every (lambda (x) (not (nil? (el-call session fn (js-array x)))))))))
      (funcall d "seq-find" (lambda (fn s &optional default)
                              (let ((found (js-call (el-seq-items s) :find (lambda (x) (not (nil? (el-call session fn (js-array x))))))))
                                (if (undefined? found) (el-opt default) found))))
      (funcall d "seq-count" (lambda (fn s) (js-length (js-call (el-seq-items s) :filter (lambda (x) (not (nil? (el-call session fn (js-array x)))))))))
      (funcall d "seq-uniq" (lambda (s &optional testfn)
                              (let ((kept (js-array)) (test (el-test-function session (el-opt testfn) el-equal-test)))
                                (js-call (el-seq-items s) :forEach (lambda (x) (unless (js-call kept :some (lambda (y) (funcall test x y))) (js-call kept :push x))))
                                (el-list-from kept))))
      (funcall d "seq-take" (lambda (s n) (el-seq-like s (js-call (el-seq-items s) :slice 0 (Math/max 0 n)))))
      (funcall d "seq-drop" (lambda (s n) (el-seq-like s (js-call (el-seq-items s) :slice (Math/max 0 n)))))
      (funcall d "seq-take-while" (lambda (fn s)
                                    (let ((items (el-seq-items s)) (i 0))
                                      (while (and (< i (js-length items)) (not (nil? (el-call session fn (js-array (aref items i)))))) (setq i (1+ i)))
                                      (el-seq-like s (js-call items :slice 0 i)))))
      (funcall d "seq-drop-while" (lambda (fn s)
                                    (let ((items (el-seq-items s)) (i 0))
                                      (while (and (< i (js-length items)) (not (nil? (el-call session fn (js-array (aref items i)))))) (setq i (1+ i)))
                                      (el-seq-like s (js-call items :slice i)))))
      (funcall d "seq-position" (lambda (s x &optional testfn)
                                  (let ((i (js-call (el-seq-items s) :findIndex (lambda (y) (funcall (el-test-function session (el-opt testfn) el-equal-test) x y)))))
                                    (if (< i 0) nil i))))
      (funcall d "seq-contains-p" (lambda (s x &optional testfn)
                                    (el-bool (js-call (el-seq-items s) :some (lambda (y) (funcall (el-test-function session (el-opt testfn) el-equal-test) x y))))))
      (funcall d "seq-reverse" (lambda (s) (el-reverse s)))
      (funcall d "seq-concatenate" (lambda (type &rest seqs)
                                     (let ((items (Reflect/apply (get (js-array) :concat) (js-array) (js-call seqs :map (lambda (x) (el-seq-items x))))))
                                       (cond ((el-sym-is type "vector") (el-vector items)) ((el-sym-is type "string") (el-string-from-codes items)) (t (el-list-from items))))))
      (funcall d "seq-into" (lambda (s type)
                              (let ((items (el-seq-items s)) (name (el-symbol-name type)))
                                (cond ((= name "vector") (el-vector items))
                                      ((= name "string") (el-string-from-codes items))
                                      ((= name "list") (el-list-from items))
                                      (t (el-seq-into-extension session items name))))))
      (funcall d "seq-subseq" (lambda (s start &optional end) (el-seq-like s (js-call (el-seq-items s) :slice start (el-opt end)))))
      (funcall d "cl-subseq" (lambda (s start &optional end) (el-seq-like s (js-call (el-seq-items s) :slice start (if (nullish? end) undefined end)))))
      (funcall d "cl-every" (lambda (fn &rest seqs) (el-bool (js-call (el-seq-items (aref seqs 0)) :every (lambda (x) (not (nil? (el-call session fn (js-array x)))))))))
      (funcall d "cl-some" (lambda (fn s)
                             (let ((found nil))
                               (js-call (el-seq-items s) :some (lambda (x) (setq found (el-call session fn (js-array x))) (not (nil? found))))
                               found)))
      (funcall d "cl-notany" (lambda (fn s) (el-bool (not (js-call (el-seq-items s) :some (lambda (x) (not (nil? (el-call session fn (js-array x))))))))))
      (funcall d "cl-reduce" (lambda (fn s &rest keys)
                               (let* ((items (el-seq-items s)) (i (js-call keys :findIndex (lambda (k) (el-sym-is k ":initial-value")))))
                                 (if (>= i 0)
                                     (js-call items :reduce (lambda (acc x) (el-call session fn (js-array acc x))) (aref keys (1+ i)))
                                   (if (= (js-length items) 0) (el-call session fn (js-array))
                                     (js-call items :reduce (lambda (acc x) (el-call session fn (js-array acc x)))))))))
      (funcall d "cl-remove-if" (lambda (fn s &rest ignored) (el-seq-like s (js-call (el-seq-items s) :filter (lambda (x) (nil? (el-call session fn (js-array x))))))))
      (funcall d "cl-remove-if-not" (lambda (fn s &rest ignored) (el-seq-like s (js-call (el-seq-items s) :filter (lambda (x) (not (nil? (el-call session fn (js-array x)))))))))
      (el-def-alias session "cl-delete-if" "cl-remove-if")
      (el-def-alias session "cl-delete-if-not" "cl-remove-if-not")
      (funcall d "cl-count-if" (lambda (fn s) (js-length (js-call (el-seq-items s) :filter (lambda (x) (not (nil? (el-call session fn (js-array x)))))))))
      (funcall d "cl-count" (lambda (x s &rest keys)
                              (let ((test (el-key-test session keys el-eql-test))
                                    (key-of (el-key-extractor session keys)))
                                (js-length (js-call (el-seq-items s) :filter (lambda (y) (funcall test x (funcall key-of y))))))))
      (funcall d "cl-find" (lambda (x s &rest keys) (el-cl-find session x s keys false)))
      (funcall d "cl-position" (lambda (x s &rest keys) (el-cl-find session x s keys t)))
      (funcall d "cl-find-if" (lambda (fn s &rest keys)
                                (let ((key-of (el-key-extractor session keys)))
                                  (el-opt (js-call (el-seq-items s) :find (lambda (x) (not (nil? (el-call session fn (js-array (funcall key-of x)))))))))))
      (funcall d "cl-position-if" (lambda (fn s &rest keys)
                                    (let* ((key-of (el-key-extractor session keys))
                                           (i (js-call (el-seq-items s) :findIndex (lambda (x) (not (nil? (el-call session fn (js-array (funcall key-of x)))))))))
                                      (if (< i 0) nil i))))
      (funcall d "cl-member" (lambda (x l &rest keys)
                               (let ((test (el-key-test session keys el-eql-test))
                                     (key-of (el-key-extractor session keys)))
                                 (el-member-with x l (lambda (item elt) (funcall test item (funcall key-of elt)))))))
      (funcall d "cl-remove" (lambda (x s &rest keys)
                               (let ((test (el-key-test session keys el-eql-test))
                                     (key-of (el-key-extractor session keys)))
                                 (el-seq-like s (js-call (el-seq-items s) :filter (lambda (y) (not (funcall test x (funcall key-of y)))))))))
      (el-def-alias session "cl-delete" "cl-remove")
      (funcall d "cl-remove-duplicates"
               (lambda (s &rest keys)
                 (let ((kept (js-array))
                       (test (el-key-test session keys el-eql-test))
                       (key-of (el-key-extractor session keys)))
                   (js-call (el-seq-items s) :forEach
                            (lambda (x)
                              (let ((kx (funcall key-of x)))
                                (unless (js-call kept :some (lambda (y) (funcall test kx (funcall key-of y))))
                                  (js-call kept :push x)))))
                   (el-seq-like s kept))))
      (el-def-alias session "cl-delete-duplicates" "cl-remove-duplicates")
      (funcall d "cl-adjoin"
               (lambda (x l &rest keys)
                 (let* ((test (el-key-test session keys el-eql-test))
                        (key-of (el-key-extractor session keys))
                        (kx (funcall key-of x))
                        (exists (js-call (el-list-to-array l) :some (lambda (y) (funcall test kx (funcall key-of y))))))
                   (if exists l (el-cons x l)))))
      (funcall d "cl-union"
               (lambda (l1 l2 &rest keys)
                 (let ((test (el-key-test session keys el-eql-test))
                       (key-of (el-key-extractor session keys))
                       (out (js-call (el-list-to-array l1) :slice)))
                   (js-call (el-list-to-array l2) :forEach
                            (lambda (y)
                              (let ((ky (funcall key-of y)))
                                (unless (js-call out :some (lambda (x) (funcall test (funcall key-of x) ky)))
                                  (js-call out :push y)))))
                   (el-list-from out))))
      (funcall d "cl-intersection"
               (lambda (l1 l2 &rest keys)
                 (let ((test (el-key-test session keys el-eql-test))
                       (key-of (el-key-extractor session keys))
                       (a2 (el-list-to-array l2)))
                   (el-list-from
                    (js-call (el-list-to-array l1) :filter
                             (lambda (x)
                               (let ((kx (funcall key-of x)))
                                 (js-call a2 :some (lambda (y) (funcall test kx (funcall key-of y)))))))))))
      (funcall d "cl-set-difference"
               (lambda (l1 l2 &rest keys)
                 (let ((test (el-key-test session keys el-eql-test))
                       (key-of (el-key-extractor session keys))
                       (a2 (el-list-to-array l2)))
                   (el-list-from
                    (js-call (el-list-to-array l1) :filter
                             (lambda (x)
                               (let ((kx (funcall key-of x)))
                                 (not (js-call a2 :some (lambda (y) (funcall test kx (funcall key-of y))))))))))))
      (funcall d "cl-set-exclusive-or"
               (lambda (l1 l2 &rest keys)
                 (let ((test (el-key-test session keys el-eql-test))
                       (key-of (el-key-extractor session keys))
                       (a1 (el-list-to-array l1))
                       (a2 (el-list-to-array l2)))
                   (el-list-from
                    (js-call (js-call a1 :filter
                                      (lambda (x)
                                        (let ((kx (funcall key-of x)))
                                          (not (js-call a2 :some (lambda (y) (funcall test kx (funcall key-of y))))))))
                             :concat
                             (js-call a2 :filter
                                      (lambda (y)
                                        (let ((ky (funcall key-of y)))
                                          (not (js-call a1 :some (lambda (x) (funcall test (funcall key-of x) ky))))))))))))
      (funcall d "cl-subsetp"
               (lambda (l1 l2 &rest keys)
                 (let ((test (el-key-test session keys el-eql-test))
                       (key-of (el-key-extractor session keys))
                       (a2 (el-list-to-array l2)))
                   (el-bool
                    (js-call (el-list-to-array l1) :every
                             (lambda (x)
                               (let ((kx (funcall key-of x)))
                                 (js-call a2 :some (lambda (y) (funcall test kx (funcall key-of y)))))))))))
      (funcall d "cl-sort"
               (lambda (s pred &rest keys)
                 (let* ((key-of (el-key-extractor session keys))
                        (cmp (lambda (a b) (el-call session pred (js-array (funcall key-of a) (funcall key-of b)))))
                        (sorted (el-sort-items (el-seq-items s) cmp session)))
                   (if (el-vector? s) (progn (put s :items sorted) s) (el-seq-like s sorted)))))
      (funcall d "cl-incf-noop" (lambda () nil))
      (funcall d "string-version-lessp" (lambda (a b) (el-bool (< (js-call a :localeCompare b undefined (js-object :numeric t)) 0))))
      (funcall d "max-char" (lambda (&rest ignored) 4194303))
      (funcall d "current-time-zone"
               (lambda (&optional time zone)
                 (let* ((ms (el-time-to-ms time))
                        (dt (new globalThis.Date ms))
                        (utc (el-utc-zone? zone))
                        (off (if utc 0 (* (- 0 (js-call dt :getTimezoneOffset)) 60))))
                   (el-list off (if utc "UTC" "LOCAL")))))
      (funcall d "set-time-zone-rule" (lambda (tz) nil))
      (funcall d "set-language-environment" (lambda (lang &rest ignored) nil))
      (funcall d "ert-fail" (lambda (data) (throw (el-make-signal "ert-test-failed" (js-array data)))))
      (funcall d "ert-get-test" (lambda (sym) (or (js-call (get session :ertTests) :get sym) nil)))
      (funcall d "ert-test-most-recent-result" (lambda (test) (if (= (el-kind test) "ert-test") (get test :mostRecentResult) nil)))
      (funcall d "ert-test-passed-p" (lambda (res) (el-bool (and (= (el-kind res) "ert-test-result") (= (get res :status) "passed")))))
      (funcall d "ert-stats-total" (lambda (s) (if (= (el-kind s) "ert-stats") (get s :total) 0)))
      (funcall d "ert-stats-completed-expected" (lambda (s) (if (= (el-kind s) "ert-stats") (get s :passed) 0)))
      (funcall d "ert-stats-completed-unexpected" (lambda (s) (if (= (el-kind s) "ert-stats") (get s :failed) 0)))
      (funcall d "ert-stats-skipped" (lambda (s) (if (= (el-kind s) "ert-stats") (get s :skipped) 0)))
      (funcall d "ert--stats-aborted-p" (lambda (s) nil))
      (funcall d "ert--stats-failed-expected" (lambda (s) 0))
      (funcall d "ert--stats-failed-unexpected" (lambda (s) (if (= (el-kind s) "ert-stats") (get s :failed) 0)))
      (funcall d "ert--stats-passed-unexpected" (lambda (s) 0))
      (funcall d "ert--stats-skipped" (lambda (s) (if (= (el-kind s) "ert-stats") (get s :skipped) 0)))
      (funcall d "lock-file" (lambda (file) nil))
      (funcall d "unlock-file" (lambda (file) nil))
      (funcall d "file-locked-p" (lambda (file) nil))
      (funcall d "cl-struct-slot-value"
               (lambda (struct-type slot-name inst)
                 (let* ((stype (el-symbol-name struct-type))
                        (sname (el-symbol-name slot-name))
                        (info (js-call (get session :structs) :get stype))
                        (slots (if (undefined? info) (js-array) (get info :slots)))
                        (idx (js-call slots :findIndex (lambda (s) (= (el-symbol-name (get s :name)) sname)))))
                   (el-check-struct session inst stype)
                   (when (< idx 0) (el-signal "error" (str "Unknown slot " sname)))
                   (aref (get inst :items) (1+ idx)))))
      (letfn ((eqp (a b depth)
                (cond
                  ((> depth 200) false)
                  ((eq a b) t)
                  ((and (el-number? a) (el-number? b)) (= (el-num a) (el-num b)))
                  ((and (el-string? a) (el-string? b)) (= (js-call a :toLowerCase) (js-call b :toLowerCase)))
                  ((and (el-cons? a) (el-cons? b))
                    (and (eqp (get a :car) (get b :car) (1+ depth))
                         (eqp (get a :cdr) (get b :cdr) (1+ depth))))
                  ((and (or (el-vector? a) (el-record? a)) (or (el-vector? b) (el-record? b))
                        (= (get a :kind) (get b :kind)))
                    (let ((ia (get a :items)) (ib (get b :items)))
                      (and (= (js-length ia) (js-length ib))
                           (js-call ia :every (lambda (x idx) (eqp x (aref ib idx) (1+ depth)))))))
                  ((and (el-hash-table? a) (el-hash-table? b))
                    (let ((ea (Array/from (js-call (get a :entries) :values)))
                          (eb (Array/from (js-call (get b :entries) :values))))
                      (and (= (js-length ea) (js-length eb))
                           (js-call ea :every
                                    (lambda (pa)
                                      (js-call eb :some
                                               (lambda (pb)
                                                 (and (eqp (aref pa 0) (aref pb 0) (1+ depth))
                                                      (eqp (aref pa 1) (aref pb 1) (1+ depth))))))))))
                  (t (el-equal-p a b depth)))))
        (funcall d "cl-equalp" (lambda (a b) (el-bool (eqp a b 0))))
        (el-def-alias session "equalp" "cl-equalp"))
      (funcall d "locate-dominating-file"
               (lambda (file name)
                 (let* ((fs (el-fs))
                        (path-mod (el-path))
                        (expanded (el-expand-file-name session file nil))
                        (is-dir (and (not (nullish? fs))
                                     (try (js-call (js-call fs :statSync expanded) :isDirectory) (catch e false))))
                        (cur (if is-dir
                                 (js-call expanded :replace (new globalThis.RegExp "/+$") "")
                               (if (not (nullish? path-mod))
                                   (js-call path-mod :dirname (js-call expanded :replace (new globalThis.RegExp "/+$") ""))
                                 "/")))
                        (found nil)
                        (done false))
                   (when (= cur "") (setq cur "/"))
                   (while (not done)
                     (let* ((dir-slash (if (js-call cur :endsWith "/") cur (str cur "/")))
                            (ok (if (el-string? name)
                                    (and (not (nullish? fs))
                                         (try (js-call fs :existsSync (el-expand-file-name session name dir-slash)) (catch e false)))
                                  (not (nil? (el-call session name (js-array dir-slash)))))))
                       (if ok
                           (progn (setq found dir-slash) (setq done t))
                         (let ((parent (if (not (nullish? path-mod)) (js-call path-mod :dirname cur) "/")))
                           (if (or (= parent cur) (= cur "/"))
                               (setq done t)
                             (setq cur parent))))))
                   found)))
      (funcall d "file-in-directory-p"
               (lambda (file dir)
                 (let* ((tf (let ((s (el-file-truename session file)))
                              (if (js-call s :endsWith "/") s (str s "/"))))
                        (td (let ((s (el-file-truename session dir)))
                              (if (js-call s :endsWith "/") s (str s "/")))))
                   (el-bool (js-call tf :startsWith td)))))
      nil))


  ;; ------------------------------------------------------------------
  ;; Sessions
  ;; ------------------------------------------------------------------

  (defun createCompatSession ()
    (let ((session (js-object :values (new globalThis.Map) :functions (new globalThis.Map) :macros (new globalThis.Map)
                              :specials (new globalThis.Set) :localVars (new globalThis.Set)
                              :plists (new globalThis.Map) :features (new globalThis.Set)
                              :conditionParents (new globalThis.Map) :conditionMessages (new globalThis.Map)
                              :matchData nil :buffers (new globalThis.Map) :currentBuffer nil
                              :structs (new globalThis.Map) :accessors (new globalThis.Map) :gvSetters (new globalThis.Map)
                              :moduleSources (new globalThis.Map) :loadingFeatures (new globalThis.Set)
                              :userDefinedFns (new globalThis.Set) :activeLibs (new globalThis.Set)
                              :structSchemas (new globalThis.Map) :protocols (new globalThis.Map) :multimethods (new globalThis.Map)
                              :modules (new globalThis.Map) :liveValueGetters (new globalThis.Map) :engineSlots (new globalThis.Map)
                              :adviceOrig (new globalThis.Map) :adviceStack (new globalThis.Map)
                              :processes (js-array) :timers (js-array)
                              :ertTests (new globalThis.Map) :ertTestOrder (js-array)
                              :timeoutDeadline nil :defaultFileModes 493 :batchOutput false
                              :nextSlotId 0 :gensymCounter 0 :inAsyncContext false :abiMemory nil :output nil)))
      (js-call base-condition-parents :forEach
               (lambda (pair) (js-call (get session :conditionParents) :set (aref pair 0) (js-array (aref pair 1)))))
      (js-call base-condition-messages :forEach
               (lambda (pair) (js-call (get session :conditionMessages) :set (aref pair 0) (aref pair 1))))
      (js-call (js-array (js-array "case-fold-search" t) (js-array "noninteractive" t) (js-array "json-null" nil)
                         (js-array "json-false" (el-intern ":json-false"))
                         (js-array "json-object-type" (el-intern "alist"))
                         (js-array "json-array-type" (el-intern "vector"))
                         (js-array "json-key-type" nil)
                         (js-array "json-encoding-pretty-print" nil)
                         (js-array "json-encoding-separator" ",") (js-array "json-encoding-object-sort-predicate" nil)
                         (js-array "float-output-format" nil) (js-array "inhibit-read-only" nil) (js-array "load-path" nil)
                         (js-array "most-positive-fixnum" 2305843009213693951) (js-array "most-negative-fixnum" -2305843009213693952)
                         (js-array "print-length" nil) (js-array "print-level" nil) (js-array "print-escape-newlines" nil)
                         (js-array "emacs-major-version" 31) (js-array "emacs-minor-version" 1) (js-array "system-type" (el-intern "gnu/linux"))
                         (js-array "default-directory" "/") (js-array "temporary-file-directory" "/tmp/")
                         (js-array "command-line-args-left" nil) (js-array "process-environment" nil) (js-array "exec-path" nil)
                         (js-array "invocation-name" "emacs") (js-array "invocation-directory" "/usr/bin/")
                         (js-array "kill-emacs-hook" nil) (js-array "lexical-binding" t)
                         (js-array "buffer-file-name" nil) (js-array "load-file-name" nil) (js-array "load-true-file-name" nil)
                         (js-array "standard-output" t)
                         (js-array "url-request-method" nil) (js-array "url-request-extra-headers" nil) (js-array "url-request-data" nil)
                         (js-array "url-http-end-of-headers" nil) (js-array "url-http-response-status" nil)
                         (js-array "url-proxy-services" nil) (js-array "url-user-agent" "Emacs")
                         (js-array "coding-system-for-read" nil) (js-array "coding-system-for-write" nil)
                         (js-array "inhibit-message" nil) (js-array "system-time-locale" nil)
                         (js-array "global-map" (el-list (el-intern "keymap")))
                         (js-array "special-mode-map" (el-list (el-intern "keymap")))
                         (js-array "text-mode-map" (el-list (el-intern "keymap")))
                         (js-array "prog-mode-map" (el-list (el-intern "keymap")))
                         (js-array "diff-mode-map" (el-list (el-intern "keymap")))
                         (js-array "tabulated-list-mode-map" (el-list (el-intern "keymap")))
                         (js-array "button-map" (el-list (el-intern "keymap")))
                         (js-array "widget-keymap" (el-list (el-intern "keymap")))
                         (js-array "minibuffer-local-map" (el-list (el-intern "keymap"))))
               :forEach
               (lambda (pair)
                 (el-add-special-var session (el-intern (aref pair 0)))
                 (js-call (get session :values) :set (el-intern (aref pair 0)) (aref pair 1))))
      (js-call (get session :values) :set (el-intern "json-special-chars") default-json-special-chars)
      (el-add-special-var session (el-intern "json-special-chars"))
      (js-call (js-array "cl-lib" "cl-seq" "cl-extra" "seq" "subr-x" "json" "rx" "pcase" "map" "gv" "cl-macs" "macroexp" "nadvice"
                         "url" "url-http" "url-parse" "url-util" "url-vars" "url-expand" "browse-url" "ansi-color" "ert" "ert-x"
                         "auth-source" "base64" "button" "calc" "calc-units" "calendar" "color" "diff" "diff-mode"
                         "eliscript" "eliscript-compat" "eliscript-worker" "flymake" "gnutls" "imenu" "mailcap" "message"
                         "org" "org-element" "pp" "project" "shr" "tabulated-list" "thingatpt" "wid-edit" "widget" "xref"
                         "filenotify" "comint" "compile" "dired" "eshell" "vc" "ediff" "easy-mmode") :forEach
               (lambda (feature) (js-call (get session :features) :add feature)))
      (el-install-kernel session)
      (el-eval-body session
                    (el-read-all "(cl-defstruct (url (:constructor make-url) (:constructor url-create)) type user password host portsitory filename target attributes fullness silentness (use-cookies t))")
                    (el-root-env))
      (js-call (get session :userDefinedFns) :clear)
      session))


  (defvar default-session nil)


  (defun el-default-session ()
    (when (nil? default-session) (setq default-session (createCompatSession)))
    default-session)


  (defun resetCompatState () (setq default-session (createCompatSession)) nil)


  (defun el-session-option (options)
    (if (or (nullish? options) (nullish? (get options :session))) (el-default-session) (get options :session)))

  (export createCompatSession el-default-session el-session-option resetCompatState))
