      ;; Files and directories
      (let ((insert-file-fn
             (lambda (filename &optional visit beg end replace literally)
               (let ((fs (el-fs)))
                 (when (nullish? fs) (el-signal "file-error" "File access is not available in the JS runtime"))
                 (let ((p (el-expand-file-name session filename nil))
                       (raw nil))
                   (try
                     (setq raw (js-call fs :readFileSync p))
                     (catch e
                       (el-signal "file-error" "Opening input file" (get e :message) filename)))
                   (let* ((slice (if (or (not (nil? beg)) (not (nil? end)))
                                     (js-call raw :subarray (or beg 0) (if (nil? end) (get raw :length) end))
                                   raw))
                          (b (el-current-buffer session))
                          (text (if (or literally (not (get b :multibyte)))
                                    (el-bytes-string (Array/from slice))
                                  (js-call slice :toString "utf8")))
                          (saved-pt (get b :point)))
                     (if (and (not (nullish? replace)) (not (nil? replace)))
                         (progn
                           (put b :text text)
                           (put b :point (el-clamp-position b saved-pt)))
                       (progn
                         (el-buffer-insert b text)
                         (put b :point saved-pt)))
                     (when (and (not (nullish? visit)) (not (nil? visit)))
                       (js-call (get b :locals) :set (el-intern "buffer-file-name") p))
                     (el-list p (el-string-length text))))))))
