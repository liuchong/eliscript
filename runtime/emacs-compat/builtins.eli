      (funcall d "executable-find"
               (lambda (command &optional remote)
                 (let ((fs (el-fs)))
                   (if (or (nullish? fs) (not (el-string? command))) nil
                     (if (js-call command :includes "/")
                         (let ((p (el-expand-file-name session command nil)))
                           (if (try (and (js-call (js-call fs :statSync p) :isFile)
                                         (progn (js-call fs :accessSync p (get (get fs :constants) :X_OK)) t))
                                 (catch e false))
