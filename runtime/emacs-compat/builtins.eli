                 (when (js-call (get session :adviceOrig) :has symbol)
                   (let* ((orig (js-call (get session :adviceOrig) :get symbol))
                          (stack (js-call (or (js-call (get session :adviceStack) :get symbol) (js-array))
                                          :filter (lambda (item) (not (el-equal-p (aref item 1) function 0))))))
                     (js-call (get session :adviceStack) :set symbol stack)
                     (if (= (js-length stack) 0)
                         (progn
                           (js-call (get session :adviceOrig) :delete symbol)
                           (el-set-fn session symbol orig))
                       (let ((composed orig))
                         (js-call stack :forEach
                                  (lambda (entry)
                                    (let ((w (aref entry 0)) (adv (aref entry 1)) (prev composed))
                                      (setq composed
                                            (cond
                                              ((= w ":override") (lambda (&rest args) (el-call session adv args)))
                                              ((= w ":around") (lambda (&rest args) (el-call session adv (js-call (js-array prev) :concat args))))
                                              ((= w ":before") (lambda (&rest args) (el-call session adv args) (el-call session prev args)))
                                              ((= w ":after") (lambda (&rest args) (let ((r (el-call session prev args))) (el-call session adv args) r)))
                                              ((= w ":filter-return") (lambda (&rest args) (el-call session adv (js-array (el-call session prev args)))))
                                              (t (lambda (&rest args) (el-call session adv args))))))))
                         (el-set-fn session symbol composed)))))
                 nil))
      (funcall d "provide" (lambda (feature &rest ignored) (js-call (get session :features) :add (el-symbol-name feature)) feature))
      (funcall d "featurep" (lambda (feature &rest ignored) (el-bool (js-call (get session :features) :has (el-symbol-name feature)))))
      (funcall d "require" (lambda (feature &optional filename noerror) (el-require session feature (el-opt filename) (el-opt noerror))))
      (funcall d "load" (lambda (file &optional noerror nomessage nosuffix must-suffix)
                          (el-load-file session file (el-opt noerror) (el-opt nomessage) (el-opt nosuffix) (el-opt must-suffix))))
      ;; Errors and control
      (funcall d "signal" (lambda (condition data) (throw (el-make-signal (el-symbol-name condition) (el-seq-items data)))))
      (funcall d "error" (lambda (template &rest args) (throw (el-make-signal "error" (js-array (el-format session template args))))))
      (funcall d "user-error" (lambda (template &rest args) (throw (el-make-signal "user-error" (js-array (el-format session template args))))))
      (funcall d "throw" (lambda (tag value) (el-throw tag value)))
      (funcall d "define-error" (lambda (name message &optional parent)
                                  (let ((parents (cond ((nullish? parent) (js-array "error"))
                                                       ((nil? parent) (js-array "error"))
                                                       ((el-cons? parent) (js-call (el-list-to-array parent) :map (lambda (p) (el-symbol-name p))))
                                                       (t (js-array (el-symbol-name parent))))))
                                    (js-call (get session :conditionParents) :set (el-symbol-name name) parents)
                                    (js-call (get session :conditionMessages) :set (el-symbol-name name) message)
                                    nil)))
      (funcall d "error-message-string" (lambda (err)
                                          (if (el-cons? err)
                                              (el-signal-message session (el-make-signal (el-symbol-name (get err :car)) (el-list-to-array (get err :cdr))))
                                            (el-prin1-string err false))))
      ;; Hash tables
      (funcall d "make-hash-table" (lambda (&rest args)
                                     (let ((i (js-call args :findIndex (lambda (a) (el-sym-is a ":test")))))
                                       (el-make-hash-table (if (< i 0) "eql" (el-symbol-name (aref args (1+ i))))))))
      (funcall d "gethash" (lambda (k table &optional default) (el-gethash k table (el-opt default))))
      (put (el-intern "gethash") :_inlineEval
           (lambda (s cdr e)
             (let ((c1 (if (nil? cdr) nil (get cdr :cdr))))
               (if (not (nil? c1))
                   (let ((c2 (get c1 :cdr)))
                     (if (nil? c2)
                         (el-gethash (el-eval s (get cdr :car) e) (el-eval s (get c1 :car) e) nil)
                       (if (nil? (get c2 :cdr))
                           (el-gethash (el-eval s (get cdr :car) e) (el-eval s (get c1 :car) e) (el-eval s (get c2 :car) e))
                         (el-eval-call-fn s (js-call (get s :functions) :get (el-intern "gethash")) cdr e))))
                 (el-eval-call-fn s (js-call (get s :functions) :get (el-intern "gethash")) cdr e)))))
      (funcall d "puthash" (lambda (k v table) (el-puthash k v table)))
      (put (el-intern "puthash") :_inlineEval
           (lambda (s cdr e)
             (let ((c1 (if (nil? cdr) nil (get cdr :cdr))))
               (if (and (not (nil? c1)) (not (nil? (get c1 :cdr))) (nil? (get (get c1 :cdr) :cdr)))
                   (el-puthash (el-eval s (get cdr :car) e)
                               (el-eval s (get c1 :car) e)
                               (el-eval s (get (get c1 :cdr) :car) e))
                 (el-eval-call-fn s (js-call (get s :functions) :get (el-intern "puthash")) cdr e)))))
      (funcall d2 "remhash" (lambda (k table) (el-remhash k table)))
      (funcall d "clrhash" (lambda (table) (js-call (get table :entries) :clear) table))
      (funcall d "maphash" (lambda (fn table)
                             (js-call (Array/from (js-call (get table :entries) :values)) :forEach
                                      (lambda (entry) (el-call session fn (js-array (aref entry 0) (aref entry 1)))))
                             nil))
      (funcall d "hash-table-count" (lambda (table) (get (get table :entries) :size)))
      (funcall d "hash-table-test" (lambda (table) (el-intern (get table :test))))
      (funcall d "hash-table-keys" (lambda (table) (el-list-from (js-call (Array/from (js-call (get table :entries) :values)) :map (lambda (e) (aref e 0))))))
      (funcall d "hash-table-values" (lambda (table) (el-list-from (js-call (Array/from (js-call (get table :entries) :values)) :map (lambda (e) (aref e 1))))))
      (funcall d "copy-hash-table" (lambda (table)
                                     (let ((copy (el-make-hash-table (get table :test))))
                                       (js-call (get table :entries) :forEach (lambda (e k) (js-call (get copy :entries) :set k (js-call e :slice))))
                                       copy)))
      ;; JSON, hashing, base64 and time
      (funcall d "json-parse-string" (lambda (text &rest args) (el-json-parse session text (el-json-options session args 0))))
      (funcall d "json-serialize" (lambda (value &rest args) (el-json-serialize session value (el-json-options session args 0))))
      (funcall d "json-encode" (lambda (value) (el-json-encode session value)))
      (funcall d "json-insert" (lambda (value &rest args) (el-buffer-insert (el-current-buffer session) (el-json-serialize session value (el-json-options session args 0))) nil))
      (funcall d "json--print" (lambda (value) (el-buffer-insert (el-current-buffer session) (el-json-encode session value)) nil))
      (funcall d "json-read-from-string"
               (lambda (text)
                 (el-json-parse session text (el-json-read-options session))))
      (funcall d "json-read"
               (lambda ()
                 (let* ((buf (el-current-buffer session))
                        (start (1- (get buf :point)))
                        (sub (el-substring (get buf :text) start nil))
                        (opts (el-json-read-options session)))
                   (put opts :allowTrailing t)
                   (let ((val (el-json-parse session sub opts)))
                     (when (el-integer? (get opts :endPos))
                       (put buf :point (el-clamp-position buf (+ (get buf :point) (el-unit-to-char sub (get opts :endPos))))))
                     val))))
      (funcall d "json-read-file"
               (lambda (file)
                 (let ((fs (el-fs)))
                   (when (nullish? fs) (el-signal "file-error" "File access not available"))
                   (let ((text (js-call fs :readFileSync (el-expand-file-name session file nil) "utf8")))
                     (el-json-parse session text (el-json-read-options session))))))
      (funcall d "json-alist-p" (lambda (x) (el-bool (or (nil? x) (el-alist? x)))))
      (funcall d "json-plist-p" (lambda (x) (el-bool (or (nil? x) (el-plist-of-keywords? x)))))
      (funcall d "base64-encode-string"
               (lambda (s &optional no-line-break)
                 (let* ((bytes (el-string-bytes-array s))
                        (b64 (js-call (js-call globalThis.Buffer :from bytes) :toString "base64")))
                   (if (and (not (nullish? no-line-break)) (not (nil? no-line-break)))
                       b64
                     (js-call b64 :replace (new globalThis.RegExp ".{1,76}" "g")
                              (lambda (m off str-full) (if (< (+ off (js-length m)) (js-length str-full)) (str m "\n") m)))))))
      (funcall d "base64-decode-string"
               (lambda (s &optional base64url)
                 (let ((buf (js-call globalThis.Buffer :from (str s)
                                     (if (and (not (nullish? base64url)) (not (nil? base64url))) "base64url" "base64"))))
                   (el-bytes-string (Array/from buf)))))
      (funcall d "secure-hash" (lambda (alg object &optional start end binary)
                                 (el-secure-hash alg object (el-opt start) (el-opt end) (el-opt binary))))
      (funcall d "float-time" (lambda (&optional time) (el-make-float (/ (el-time-to-ms (el-opt time)) 1000))))
      (funcall d "time-to-seconds" (lambda (&optional time) (el-make-float (/ (el-time-to-ms (el-opt time)) 1000))))
      (funcall d "seconds-to-time" (lambda (s) (el-ms-to-time (* (el-num s) 1000))))
      (funcall d "current-time" (lambda () (el-ms-to-time (js-call globalThis.Date :now))))
      (funcall d "current-time-string" (lambda (&optional time zone) (el-format-time-string "%a %b %d %H:%M:%S %Y" (el-opt time) (el-opt zone))))
      (funcall d "format-time-string" (lambda (fmt &optional time zone) (el-format-time-string fmt (el-opt time) (el-opt zone))))
      (funcall d "parse-time-string" (lambda (s) (el-parse-time-string s)))
      (funcall d "decode-time" (lambda (&optional time zone form) (el-decode-time (el-opt time) (el-opt zone) (el-opt form))))
      (funcall d "encode-time" (lambda (&rest args) (el-encode-time args)))
      (funcall d "time-less-p" (lambda (t1 t2) (el-bool (< (el-time-to-ms t1) (el-time-to-ms t2)))))
      (funcall d "time-equal-p" (lambda (t1 t2) (el-bool (= (el-time-to-ms t1) (el-time-to-ms t2)))))
      (funcall d "time-subtract" (lambda (t1 t2) (el-ms-to-time (- (el-time-to-ms t1) (el-time-to-ms t2)))))
      (funcall d "time-add" (lambda (t1 t2) (el-ms-to-time (+ (el-time-to-ms t1) (el-time-to-ms t2)))))
      (funcall d "run-at-time"
               (lambda (time repeat fn &rest args)
                 (let* ((delay (cond ((or (nullish? time) (nil? time) (eq time t)) 0)
                                     ((el-number? time) (Math/max 0 (el-num time)))
                                     (t 0)))
                        (timer (js-object :kind "timer"
                                          :nextFire (+ (/ (js-call globalThis.Date :now) 1000) delay)
                                          :repeat (if (and (not (nullish? repeat)) (not (nil? repeat))) (el-num repeat) nil)
                                          :fn fn :fnArgs args :cancelled false)))
                   (js-call (get session :timers) :push timer)
                   timer)))
      (el-def-alias session "run-with-timer" "run-at-time")
      (funcall d "run-with-idle-timer"
               (lambda (secs repeat fn &rest args)
                 (Reflect/apply (js-call (get session :functions) :get (el-intern "run-at-time"))
                                nil (js-call (js-array secs repeat fn) :concat args))))
      (funcall d "timerp" (lambda (x) (el-bool (= (el-kind x) "timer"))))
      (funcall d "cancel-timer" (lambda (timer) (when (= (el-kind timer) "timer") (put timer :cancelled t)) nil))
      ;; Output and minibuffer
      (funcall d "message" (lambda (template &rest args)
                             (if (nil? template) nil
                               (let ((text (el-format session template args)))
                                 (el-emit-output session (str text "\n") t)
                                 text))))
      (let ((ext-dbg (lambda (ch)
                       (el-write-stderr (if (el-integer? ch) (el-char-string ch) (str ch)))
                       ch)))
        (put ext-dbg :isBuiltinExtDbg t)
        (funcall d "external-debugging-output" ext-dbg))
      (funcall d "princ" (lambda (x &optional stream) (el-write-stream session (el-prin1-string x false) (el-opt stream)) x))
      (funcall d "prin1" (lambda (x &optional stream) (el-write-stream session (el-prin1-string x t) (el-opt stream)) x))
      (funcall d "print" (lambda (x &optional stream) (el-write-stream session (str "\n" (el-prin1-string x t) "\n") (el-opt stream)) x))
      (funcall d "terpri" (lambda (&optional stream ensure) (el-write-stream session "\n" (el-opt stream)) t))
      (funcall d "flush-standard-output" (lambda () nil))
      (funcall d "set-language-environment" (lambda (&rest ignored) nil))
      (funcall d "ansi-color-apply" (lambda (s) s))
      (funcall d "read" (lambda (&optional source)
                          (cond
                            ((el-string? source) (el-car (el-read-from-string source 0)))
                            ((= (el-kind source) "buffer")
                              (let* ((start (1- (get source :point)))
                                     (res (el-read-from-string (get source :text) start)))
                                (put source :point (1+ (el-cdr res)))
                                (el-car res)))
                            ((or (nullish? source) (nil? source) (eq source t))
                              (let* ((buf (el-current-buffer session))
                                     (start (1- (get buf :point)))
                                     (res (el-read-from-string (get buf :text) start)))
                                (put buf :point (1+ (el-cdr res)))
                                (el-car res)))
                            (t (el-signal "error" "read requires a string or buffer")))))
      (funcall d "read-from-string" (lambda (s &optional start end) (el-read-from-string s (el-opt start))))
      (funcall d "read-from-minibuffer"
               (lambda (prompt &optional initial keymap read-as-lisp hist default-val inherit)
                 (when (and (el-string? prompt) (> (js-length prompt) 0))
                   (el-write-stdout prompt))
                 (let ((fs (el-fs)))
                   (if (nullish? fs)
                       (el-signal "end-of-file")
                     (let ((bytes (js-array))
                           (buf (js-call globalThis.Buffer :alloc 1))
                           (eof false)
                           (done false))
                       (while (not done)
                         (let ((n (try (js-call fs :readSync 0 buf 0 1 nil) (catch e 0))))
                           (if (<= n 0)
                               (do (setq eof t) (setq done t))
                             (let ((b (aref buf 0)))
                               (if (= b 10)
                                   (setq done t)
                                 (unless (= b 13) (js-call bytes :push b)))))))
                       (when (and eof (= (js-length bytes) 0))
                         (el-signal "end-of-file"))
                       (let ((line (js-call (js-call globalThis.Buffer :from bytes) :toString "utf8")))
                         (if (and (= line "") (el-string? default-val))
                             default-val
                           line)))))))
      (el-def-alias session "read-string" "read-from-minibuffer")
      (funcall d "pp-to-string" (lambda (obj) (str (el-prin1-string obj t) "\n")))
      (funcall d "pp" (lambda (obj &optional stream) (el-write-stream session stream (str (el-prin1-string obj t) "\n")) nil))
      (funcall d "mailcap-extension-to-mime"
               (lambda (ext)
                 (let ((clean (js-call (js-call (str (or ext "")) :toLowerCase) :replace (new globalThis.RegExp "^\\.") "")))
                   (cond
                     ((or (= clean "jpg") (= clean "jpeg")) "image/jpeg")
                     ((= clean "png") "image/png")
                     ((= clean "gif") "image/gif")
                     ((= clean "webp") "image/webp")
                     ((= clean "svg") "image/svg+xml")
                     ((= clean "pdf") "application/pdf")
                     ((= clean "json") "application/json")
                     ((or (= clean "txt") (= clean "text") (= clean "md") (= clean "el") (= clean "eli")) "text/plain")
                     ((or (= clean "html") (= clean "htm")) "text/html")
                     ((= clean "css") "text/css")
                     ((or (= clean "js") (= clean "mjs")) "text/javascript")
                     ((= clean "mp3") "audio/mpeg")
                     ((= clean "wav") "audio/wav")
                     ((= clean "mp4") "video/mp4")
                     (t nil)))))
      (funcall d "mailcap-file-name-to-mime-type"
               (lambda (file-name)
                 (let ((ext (el-call session (el-intern "file-name-extension") (js-array file-name))))
                   (if (el-string? ext)
                       (or (el-call session (el-intern "mailcap-extension-to-mime") (js-array ext)) "application/octet-stream")
                     "application/octet-stream"))))
      ;; Buffers
      (funcall d "current-buffer" (lambda () (el-current-buffer session)))
      (funcall d "set-buffer" (lambda (b) (let ((buffer (if (el-string? b) (el-get-buffer-create session b) b))) (put session :currentBuffer buffer) buffer)))
      (funcall d "get-buffer-create" (lambda (name &rest ignored) (if (el-string? name) (el-get-buffer-create session name) name)))
      (funcall d "get-buffer" (lambda (name) (if (el-string? name) (let ((b (js-call (get session :buffers) :get name))) (if (undefined? b) nil b)) name)))
      (funcall d "generate-new-buffer" (lambda (name &rest ignored) (el-generate-new-buffer session name)))
      (funcall d "kill-buffer" (lambda (&optional b) (el-kill-buffer session (if (nullish? b) (el-current-buffer session) b))))
      (funcall d "buffer-live-p" (lambda (b) (el-bool (and (= (el-kind b) "buffer") (get b :live)))))
      (funcall d "buffer-name" (lambda (&optional b) (get (if (nullish? b) (el-current-buffer session) b) :name)))
      (funcall d "buffer-string" (lambda () (get (el-current-buffer session) :text)))
      (funcall d "buffer-substring" (lambda (a b) (el-buffer-substring (el-current-buffer session) a b)))
      (funcall d "buffer-substring-no-properties" (lambda (a b) (el-buffer-substring (el-current-buffer session) a b)))
      (funcall d "buffer-size" (lambda (&optional b) (el-buffer-size (if (nullish? b) (el-current-buffer session) b))))
      (funcall d "insert" (lambda (&rest xs)
                            (js-call xs :forEach (lambda (x) (el-buffer-insert (el-current-buffer session) (if (el-string? x) x (el-char-string x)))))
                            nil))
      (funcall d "insert-char" (lambda (c &optional n) (el-buffer-insert (el-current-buffer session) (js-call (el-char-string c) :repeat (if (nullish? n) 1 n)))))
      (funcall d "point" (lambda () (get (el-current-buffer session) :point)))
      (funcall d "point-min" (lambda () 1))
      (funcall d "point-max" (lambda () (el-point-max (el-current-buffer session))))
      (funcall d "goto-char" (lambda (p) (let ((b (el-current-buffer session))) (put b :point (el-clamp-position b p)) (get b :point))))
      (funcall d "forward-char" (lambda (&optional n) (let ((b (el-current-buffer session))) (put b :point (el-clamp-position b (+ (get b :point) (if (nullish? n) 1 n)))) nil)))
      (funcall d "backward-char" (lambda (&optional n) (let ((b (el-current-buffer session))) (put b :point (el-clamp-position b (- (get b :point) (if (nullish? n) 1 n)))) nil)))
      (funcall d "forward-line" (lambda (&optional n) (el-forward-line (el-current-buffer session) (el-opt n))))
      (funcall d "beginning-of-line" (lambda (&rest ignored) (let ((b (el-current-buffer session))) (put b :point (el-line-beginning b (get b :point))) nil)))
      (funcall d "end-of-line" (lambda (&rest ignored) (let ((b (el-current-buffer session))) (put b :point (el-line-end b (get b :point))) nil)))
      (funcall d "line-beginning-position" (lambda (&rest ignored) (let ((b (el-current-buffer session))) (el-line-beginning b (get b :point)))))
      (funcall d "line-end-position" (lambda (&rest ignored) (let ((b (el-current-buffer session))) (el-line-end b (get b :point)))))
      (el-def-alias session "pos-bol" "line-beginning-position")
      (el-def-alias session "pos-eol" "line-end-position")
      (funcall d "bobp" (lambda () (el-bool (= (get (el-current-buffer session) :point) 1))))
      (funcall d "eobp" (lambda () (let ((b (el-current-buffer session))) (el-bool (= (get b :point) (el-point-max b))))))
      (funcall d "bolp" (lambda () (let ((b (el-current-buffer session))) (el-bool (= (get b :point) (el-line-beginning b (get b :point)))))))
      (funcall d "eolp" (lambda () (let ((b (el-current-buffer session))) (el-bool (= (get b :point) (el-line-end b (get b :point)))))))
      (funcall d "char-after" (lambda (&optional p)
                                (let* ((b (el-current-buffer session)) (pos (if (nullish? p) (get b :point) p)))
                                  (if (or (< pos 1) (>= pos (el-point-max b))) nil (el-string-ref (get b :text) (1- pos))))))
      (funcall d "char-before" (lambda (&optional p)
                                 (let* ((b (el-current-buffer session)) (pos (if (nullish? p) (get b :point) p)))
                                   (if (or (<= pos 1) (> pos (el-point-max b))) nil (el-string-ref (get b :text) (- pos 2))))))
      (funcall d "following-char" (lambda () (let ((b (el-current-buffer session))) (if (>= (get b :point) (el-point-max b)) 0 (el-string-ref (get b :text) (1- (get b :point)))))))
      (funcall d "preceding-char" (lambda () (let ((b (el-current-buffer session))) (if (<= (get b :point) 1) 0 (el-string-ref (get b :text) (- (get b :point) 2))))))
      (funcall d "delete-region" (lambda (a b) (el-buffer-delete (el-current-buffer session) a b)))
      (funcall d "delete-char" (lambda (n &rest ignored) (let ((b (el-current-buffer session))) (el-buffer-delete b (get b :point) (+ (get b :point) n)))))
      (funcall d "erase-buffer" (lambda () (let ((b (el-current-buffer session))) (put b :text "") (put b :point 1) nil)))
      (funcall d "narrow-to-region" (lambda (&rest ignored) nil))
      (funcall d "widen" (lambda () nil))
      (funcall d "set-buffer-multibyte" (lambda (flag) (let ((b (el-current-buffer session))) (put b :multibyte (el-bool (not (nil? flag)))) flag)))
      (funcall d "buffer-modified-p" (lambda (&optional b) (el-bool (get (if (nullish? b) (el-current-buffer session) b) :modified))))
      (funcall d "set-buffer-modified-p" (lambda (flag) (put (el-current-buffer session) :modified (el-bool (not (nil? flag)))) flag))
      (funcall d "buffer-file-name" (lambda (&optional b) (el-global-value session (el-intern "buffer-file-name"))))
      (funcall d "buffer-list" (lambda () (el-list-from (Array/from (js-call (get session :buffers) :values)))))
      (funcall d "line-number-at-pos"
               (lambda (&optional pos absolute)
                 (let* ((b (el-current-buffer session))
                        (p (el-clamp-position b (if (or (nullish? pos) (nil? pos)) (get b :point) pos)))
                        (sub (el-substring (get b :text) 0 (1- p)))
                        (lines 1)
                        (i 0))
                   (while (< i (js-length sub))
                     (when (= (js-call sub :charAt i) "\n") (setq lines (1+ lines)))
                     (setq i (1+ i)))
                   lines)))
      (funcall d "count-lines"
               (lambda (start end)
                 (let* ((b (el-current-buffer session))
                        (sub (el-buffer-substring b start end))
                        (lines 0)
                        (i 0))
                   (while (< i (js-length sub))
                     (when (= (js-call sub :charAt i) "\n") (setq lines (1+ lines)))
                     (setq i (1+ i)))
                   (if (and (> (js-length sub) 0) (/= (js-call sub :charAt (1- (js-length sub))) "\n"))
                       (1+ lines)
                     lines))))
      (funcall d "re-search-forward" (lambda (re &optional bound noerror count)
                                       (el-search-buffer session (el-current-buffer session) re (el-opt bound) (el-opt noerror) (el-opt count) t false)))
      (funcall d "re-search-backward" (lambda (re &optional bound noerror count)
                                        (el-search-buffer session (el-current-buffer session) re (el-opt bound) (el-opt noerror) (el-opt count) false false)))
      (funcall d "search-forward" (lambda (s &optional bound noerror count)
                                    (el-search-buffer session (el-current-buffer session) s (el-opt bound) (el-opt noerror) (el-opt count) t t)))
      (funcall d "search-backward" (lambda (s &optional bound noerror count)
                                     (el-search-buffer session (el-current-buffer session) s (el-opt bound) (el-opt noerror) (el-opt count) false t)))
      (funcall d "looking-at" (lambda (re &optional inhibit) (el-looking-at session (el-current-buffer session) re t)))
      (funcall d "looking-at-p" (lambda (re) (el-looking-at session (el-current-buffer session) re false)))
      (funcall d "skip-chars-forward" (lambda (spec &optional limit)
                                        (let* ((b (el-current-buffer session)) (start (get b :point))
