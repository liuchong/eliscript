                 (lambda (filename &optional visit beg end replace)
                   (funcall insert-file-fn filename (el-opt visit) (el-opt beg) (el-opt end) (el-opt replace) false)))
        (funcall d "insert-file-contents-literally"
                 (lambda (filename &optional visit beg end replace)
