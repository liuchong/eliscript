                   (when (nullish? fs) (el-signal "file-error" "File access is not available in the JS runtime"))
                   (let* ((p (el-expand-file-name session filename nil))
                          (b (el-current-buffer session))
                          (text (if (el-string? start)
                                    start
                                  (el-buffer-substring b (if (or (nullish? start) (nil? start)) 1 start)
                                                       (if (or (nullish? end) (nil? end)) (el-point-max b) end))))
                          (data (if (or (not (el-multibyte? text)) (not (get b :multibyte)))
                                    (js-call globalThis.Buffer :from (el-string-bytes-array text))
                                  text)))
