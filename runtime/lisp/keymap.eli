(module eliscript.runtime.lisp.keymap
  (import "./core.eli" el-bool el-cons? el-intern el-list el-num el-signal el-string-codes el-string-from-codes el-string? el-sym-is el-symbol-name el-symobj? el-vector el-vector?)

  (defun el-keymap? (map)
    (and (el-cons? map) (el-sym-is (get map :car) "keymap")))

  (defun el-ensure-keymap (map)
    (unless (el-keymap? map) (el-signal "wrong-type-argument" (el-intern "keymapp") map))
    (when (nullish? (get map :_bindings)) (put map :_bindings (new globalThis.Map)))
    map)

  (defun el-make-keymap ()
    (let ((map (el-list (el-intern "keymap"))))
      (put map :_bindings (new globalThis.Map))
      (put map :_parent nil)
      map))

  (defun el-key-events (key)
    (cond
      ((el-string? key)
        (let ((out (js-array)))
          (js-call (el-string-codes key) :forEach (lambda (event)
            ;; A meta event is the ESC prefix followed by its base event.
            (if (not (= (bit-and event 134217728) 0))
                (js-call out :push 27 (bit-and event (bit-not 134217728)))
              (js-call out :push event))))
          out))
      ((el-vector? key)
        (let ((out (js-array)))
          (js-call (get key :items) :forEach (lambda (event)
            (if (el-symobj? event) (js-call out :push (str "symbol:" (el-symbol-name event)))
              (let ((code (el-num event)))
                (if (not (= (bit-and code 134217728) 0))
                    (js-call out :push 27 (bit-and code (bit-not 134217728)))
                  (js-call out :push code))))))
          out))
      (t (el-signal "wrong-type-argument" (el-intern "arrayp") key))))

  (defun el-key-parse (keys)
    (unless (el-string? keys) (el-signal "wrong-type-argument" (el-intern "stringp") keys))
    (let ((events (js-array))
          (modifiers (js-object :A 4194304 :s 8388608 :H 16777216 :S 33554432 :C 67108864 :M 134217728))
          (aliases (js-object :NUL 0 :RET 13 :LFD 10 :TAB 9 :ESC 27 :SPC 32 :DEL 127)))
      (js-call (js-call (js-call keys :trim) :split (new globalThis.RegExp "\\s+")) :forEach
        (lambda (token)
          (unless (= token "")
            (let ((word token) (bits 0) (repeat 1))
              (let ((match (js-call (new globalThis.RegExp "^([0-9]+)\\*(.+)$") :exec word)))
                (when (not (nil? match))
                  (setq repeat (Number/parseInt (aref match 1) 10) word (aref match 2))
                  (unless (and (Number/isSafeInteger repeat) (<= repeat 1048576))
                    (el-signal "error" "Invalid keyboard repetition count"))))
              (while (and (> (js-length word) 2) (= (aref word 1) "-")
                          (not (undefined? (get modifiers (aref word 0)))))
                (setq bits (bit-or bits (get modifiers (aref word 0))) word (js-call word :slice 2)))
              (when (and (= (js-length word) 2) (= (aref word 0) "^"))
                (setq bits (bit-or bits 67108864) word (js-call word :slice 1)))
              (let ((angle (and (js-call word :startsWith "<") (js-call word :endsWith ">"))))
                (when angle (setq word (js-call word :slice 1 -1)))
                (let ((alias (get aliases word)) (one (js-array)))
                  (cond
                    ((and angle (undefined? alias))
                      (let ((prefix ""))
                        (js-call (js-array "A" "C" "H" "M" "S" "s") :forEach (lambda (m)
                          (when (/= (bit-and bits (get modifiers m)) 0) (setq prefix (str prefix m "-")))))
                        (js-call one :push (el-intern (str prefix word)))))
                    (t
                      (let ((codes (if (undefined? alias) (el-string-codes word) (js-array alias))))
                        (when (and (/= bits 0) (/= (js-length codes) 1))
                          (el-signal "error" "Keyboard modifier must precede one event" token))
                        (js-call codes :forEach (lambda (code)
                          (when (and (/= (bit-and bits 67108864) 0)
                                     (or (and (>= code 64) (<= code 95)) (and (>= code 97) (<= code 122))))
                            (setq code (bit-and code 31))
                            (setq bits (bit-and bits (bit-not 67108864))))
                          (js-call one :push (bit-or bits code)))))))
                  (let ((i 0))
                    (while (< i repeat)
                      (js-call one :forEach (lambda (event) (js-call events :push event)))
                      (setq i (1+ i))))))))))
      (el-vector events)))

  (defun el-kbd (keys)
    (let ((events (get (el-key-parse keys) :items)))
      (if (js-call events :every (lambda (x) (and (Number/isInteger x) (>= x 0) (< x 128))))
          (el-string-from-codes events)
        (el-vector events))))

  (defun el-keymap-bindings (candidates event accept-default)
    ;; Re-read parent maps at every event. Inherited prefix candidates must not
    ;; be attached to a child when it is defined: parents and prefixes can be
    ;; added, changed, or removed after that point.
    (let ((found (js-array)) (seen (new globalThis.Set)))
      (js-call candidates :forEach (lambda (map)
        (let ((current map))
          (while (and (el-keymap? current) (not (js-call seen :has current)))
            (js-call seen :add current)
            (el-ensure-keymap current)
            (let ((value (js-call (get current :_bindings) :get event)))
              (when (and (undefined? value) accept-default)
                (setq value (js-call (get current :_bindings) :get "symbol:t")))
              (unless (undefined? value) (js-call found :push value)))
            (setq current (get current :_parent))))))
      found))

  (defun el-lookup-key (map key &optional accept-default)
    (el-ensure-keymap map)
    (let ((events (el-key-events key)) (candidates (js-array map)) (index 0) (result map))
      (while (< index (js-length events))
        (let ((bindings (el-keymap-bindings candidates (aref events index) accept-default)))
          (setq result (if (= (js-length bindings) 0) nil (aref bindings 0)))
          (cond
            ((nil? result) (setq index (js-length events)))
            ((el-keymap? result)
              (setq candidates (js-call bindings :filter el-keymap?))
              (setq index (1+ index)))
            ((< index (1- (js-length events)))
              (setq result (1+ index) index (js-length events)))
            (t (setq index (1+ index))))))
      result))

  (defun el-define-key (map key definition &optional remove)
    (el-ensure-keymap map)
    (let ((events (el-key-events key)) (current map) (candidates (js-array map)) (index 0))
      (while (< index (1- (js-length events)))
        (let* ((event (aref events index))
               (bindings (el-keymap-bindings candidates event nil))
               (effective (if (= (js-length bindings) 0) nil (aref bindings 0)))
               (own (js-call (get current :_bindings) :get event)))
          (when (and (not (nil? effective)) (not (el-keymap? effective)))
            (el-signal "error" "Key sequence starts with a non-prefix key" key))
          (when (or (undefined? own) (nil? own))
            (setq own (el-make-keymap))
            (js-call (get current :_bindings) :set event own))
          (unless (el-keymap? own) (el-signal "error" "Key sequence starts with a non-prefix key" key))
          (setq candidates (js-call (js-array own) :concat
            (js-call bindings :filter (lambda (entry) (and (el-keymap? entry) (not (eq own entry)))))))
          (setq current own))
        (setq index (1+ index)))
      (when (> (js-length events) 0)
        (if remove
            (js-call (get current :_bindings) :delete (aref events index))
          (js-call (get current :_bindings) :set (aref events index) definition)))
      definition))

  (defun el-copy-keymap (map &optional copies)
    (el-ensure-keymap map)
    (let ((memo (if (nullish? copies) (new globalThis.Map) copies)))
      (if (js-call memo :has map) (js-call memo :get map)
        (let ((copy (el-make-keymap)))
          (js-call memo :set map copy)
          (put copy :_parent (get map :_parent))
          (js-call (get map :_bindings) :forEach (lambda (value event)
            (js-call (get copy :_bindings) :set event (if (el-keymap? value) (el-copy-keymap value memo) value))))
          copy))))

  (export el-keymap? el-ensure-keymap el-make-keymap el-key-events el-key-parse el-kbd
          el-lookup-key el-define-key el-copy-keymap))
