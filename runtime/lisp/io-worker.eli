(module eliscript.runtime.lisp.io-worker
  (import "node:worker_threads" parentPort workerData)
  (import "node:child_process" spawn)
  (import "node:net" :as net)
  (import "node:tls" :as tls)
  (import "node:buffer" Buffer)
  (import "node:process" :default process)
  (import "node:timers" setTimeout)

  ;; Only native truth and typeof are host syntax. All dispatch, lifecycle,
  ;; framing and error classification below are maintained Eliscript.
  (defun host-truth (value) (js* "!!value"))
  (defun host-type (value) (js* "typeof value"))
  (defun fallback (value alternative) (if (host-truth value) value alternative))
  (defun error-detail (error)
    (funcall globalThis.String
      (if (and (host-truth error) (host-truth (get error :message)))
        (get error :message) error)))
  (defun error-code (error)
    (if (and (host-truth error) (host-truth (get error :code)))
      (funcall globalThis.String (get error :code)) ""))

  (defun send (state message)
    (js-call (get state :port) :postMessage message)
    (js-call globalThis.Atomics :add (get state :signal) 0 1)
    (js-call globalThis.Atomics :notify (get state :signal) 0))
  (defun send-error (state kind id error)
    (send state (js-object :type kind :id id :message (error-detail error))))

  (defun attach-socket (state socket id classify-errors)
    (js-call socket :on "data" (lambda (chunk)
      (send state (js-object :type "stdout" :id id :bytes (Array/from chunk)))))
    (js-call socket :on "error" (lambda (error)
      (let* ((code (error-code error)) (detail (error-detail error))
             (event (str "failed with code " (fallback code detail) "\n")))
        (when classify-errors
          (cond
            ((or (= code "ENOTFOUND") (= code "EAI_AGAIN")
                 (js-call (new globalThis.RegExp "getaddrinfo|resolve|ENOTFOUND" "i") :test detail))
              (setq event (str "failed to resolve host: " detail "\n")))
            ((or (js-call (new globalThis.RegExp "tls|ssl|cert|handshake|gnutls" "i") :test detail)
                 (js-call (new globalThis.RegExp "^ERR_TLS" "i") :test code))
              (setq event (str "failed tls negotiation: " detail "\n")))))
        (send state (js-object :type "net-error" :id id :event event :message detail)))))
    (js-call socket :on "close" (lambda (had-error)
      (js-call (get state :sockets) :delete id)
      (unless (host-truth had-error)
        (send state (js-object :type "net-close" :id id :event "connection broken by remote peer\n"))))))

  (defun spawn-process (state message)
    (let ((id (get message :id)))
      (try
        (let* ((child (spawn (get message :file) (get message :args)
                        (js-object :cwd (fallback (get message :cwd) undefined)
                          :env (fallback (get message :env) (get process :env))
                          :stdio (js-array "pipe" "pipe" "pipe") :detached false)))
               (spawned-sent false))
          (js-call (get state :children) :set id child)
          (js-call child :on "spawn" (lambda ()
            (unless spawned-sent
              (setq spawned-sent t)
              (send state (js-object :type "spawned" :id id :pid (fallback (get child :pid) 0))))))
          (when (and (host-truth (get child :pid)) (not spawned-sent))
            (setq spawned-sent t)
            (send state (js-object :type "spawned" :id id :pid (get child :pid))))
          (js-call (get child :stdout) :on "data" (lambda (chunk)
            (send state (js-object :type "stdout" :id id :bytes (Array/from chunk)))))
          (js-call (get child :stderr) :on "data" (lambda (chunk)
            (send state (js-object :type "stderr" :id id :bytes (Array/from chunk)))))
          (js-call child :on "error" (lambda (error) (send-error state "spawn-error" id error)))
          (js-call child :on "close" (lambda (code signal)
            (js-call (get state :children) :delete id)
            (send state (js-object :type "exit" :id id
              :code (if (= (host-type code) "number") code (if (host-truth signal) 128 0))
              :signal (fallback signal nil))))))
        (catch error (send-error state "spawn-error" id error)))))

  (defun start-server (state message)
    (let ((id (get message :id)))
      (try
        (let ((server (js-call net :createServer (lambda (socket)
                (let ((client-id (get state :nextServerClientId)))
                  (put state :nextServerClientId (1+ client-id))
                  (js-call (get state :sockets) :set client-id socket)
                  (send state (js-object :type "net-accept" :id id :clientId client-id
                    :remoteAddress (fallback (get socket :remoteAddress) "127.0.0.1")
                    :remotePort (fallback (get socket :remotePort) 0)))
                  (attach-socket state socket client-id false))))))
          (js-call server :on "error" (lambda (error) (send-error state "net-server-error" id error)))
          (js-call server :listen (fallback (get message :port) 0)
            (fallback (get message :host) "127.0.0.1") (lambda ()
              (let ((address (js-call server :address)))
                (js-call (get state :servers) :set id server)
                (send state (js-object :type "net-listening" :id id
                  :host (fallback (if (host-truth address) (get address :address) nil)
                          (fallback (get message :host) "127.0.0.1"))
                  :port (if (and (host-truth address) (= (host-type (get address :port)) "number"))
                          (get address :port) (fallback (get message :port) 0))))))))
        (catch error (send-error state "net-server-error" id error)))))

  (defun connect-socket (state message)
    (let ((id (get message :id)))
      (try
        (let* ((opened false)
               (on-connect (lambda ()
                 (unless opened (setq opened t) (send state (js-object :type "net-open" :id id)))))
               (socket (if (host-truth (get message :tls))
                         (js-call tls :connect (js-object :host (get message :host)
                           :port (get message :port) :servername (get message :host)) on-connect)
                         (js-call net :createConnection (js-object :host (get message :host)
                           :port (get message :port)) on-connect))))
          (js-call (get state :sockets) :set id socket)
          (attach-socket state socket id t))
        (catch error
          (let ((detail (error-detail error)))
            (send state (js-object :type "net-error" :id id :event (str "failed: " detail "\n") :message detail)))))))

  (defun write-input (state message end-input)
    (let* ((id (get message :id)) (child (js-call (get state :children) :get id)))
      (cond
        ((and (host-truth child) (host-truth (get child :stdin))
              (not (host-truth (get (get child :stdin) :destroyed))))
          (try
            (if end-input (js-call (get child :stdin) :end)
              (js-call (get child :stdin) :write (js-call Buffer :from (get message :bytes))))
            (catch ignored nil)))
        ((js-call (get state :sockets) :has id)
          (let ((socket (js-call (get state :sockets) :get id)))
            (when (and (host-truth socket) (not (host-truth (get socket :destroyed))))
              (try
                (if end-input (js-call socket :end)
                  (js-call socket :write (js-call Buffer :from (get message :bytes))))
                (catch ignored nil))))))))

  (defun stop-resource (state message)
    (let* ((id (get message :id)) (child (js-call (get state :children) :get id)))
      (cond
        ((host-truth child)
          (try (js-call child :kill (fallback (get message :sig) "SIGTERM")) (catch ignored nil)))
        ((js-call (get state :sockets) :has id)
          (let ((socket (js-call (get state :sockets) :get id)))
            (js-call (get state :sockets) :delete id)
            (when (and (host-truth socket) (not (host-truth (get socket :destroyed))))
              (try
                (js-call socket :end)
                (setTimeout (lambda ()
                  (try (unless (host-truth (get socket :destroyed)) (js-call socket :destroy))
                    (catch ignored nil))) 20)
                (catch ignored nil)))))
        ((js-call (get state :servers) :has id)
          (let ((server (js-call (get state :servers) :get id)))
            (js-call (get state :servers) :delete id)
            (when (host-truth server) (try (js-call server :close) (catch ignored nil))))))))

  (defasync request-http (state message)
    (let ((id (get message :id)))
      (try
        (let ((options (js-object :method (fallback (get message :method) "GET")
                         :headers (fallback (get message :headers) (js-object)))))
          (when (and (host-truth (get message :bodyBytes)) (> (js-length (get message :bodyBytes)) 0)
                     (/= (get options :method) "GET") (/= (get options :method) "HEAD"))
            (put options :body (js-call Buffer :from (get message :bodyBytes))))
          (let* ((response (await (globalThis.fetch (get message :url) options)))
                 (headers (js-array (str "HTTP/1.1 " (get response :status) " " (fallback (get response :statusText) "OK")))))
            (js-call (get response :headers) :forEach (lambda (value key) (js-call headers :push (str key ": " value))))
            (let ((header-text (str (js-call headers :join "\n") "\n\n")))
              (send state (js-object :type "http-headers" :id id :status (get response :status)
                :headerBytes (Array/from (js-call Buffer :from header-text "utf8")) :headerLength (js-length header-text))))
            (if (and (host-truth (get response :body)) (= (host-type (get (get response :body) :getReader)) "function"))
              (let ((reader (js-call (get response :body) :getReader)) (done false))
                (while (not done)
                  (let ((step (await (js-call reader :read))))
                    (if (host-truth (get step :done)) (setq done t)
                      (when (and (host-truth (get step :value)) (> (js-length (get step :value)) 0))
                        (send state (js-object :type "http-chunk" :id id :bytes (Array/from (get step :value)))))))))
              (let ((bytes (Array/from (new globalThis.Uint8Array (await (js-call response :arrayBuffer))))))
                (when (> (js-length bytes) 0) (send state (js-object :type "http-chunk" :id id :bytes bytes)))))
            (send state (js-object :type "http-end" :id id :status (get response :status)))))
        (catch error (send-error state "http-error" id error)))))

  (defun installLispIOWorker (parent configuration)
    (let ((state (js-object :signal (new globalThis.Int32Array (get configuration :signal))
                   :port (get configuration :port) :children (new globalThis.Map)
                   :servers (new globalThis.Map) :sockets (new globalThis.Map) :nextServerClientId 1000000)))
      (js-call parent :on "message" (async (message)
        (let ((kind (get message :type)))
          (cond
            ((= kind "spawn") (spawn-process state message))
            ((= kind "net-server") (start-server state message))
            ((= kind "net-connect") (connect-socket state message))
            ((= kind "stdin") (write-input state message false))
            ((= kind "eof") (write-input state message t))
            ((= kind "kill") (stop-resource state message))
            ((= kind "http") (await (request-http state message)))))))
      state))
  (unless (nullish? parentPort) (installLispIOWorker parentPort workerData))
  (export installLispIOWorker))
