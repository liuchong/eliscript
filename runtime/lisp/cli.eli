(module eliscript.runtime.lisp.cli
  ;;; cli.eli --- Public runtime/module/ABI APIs and CLI runner

  (import "./core.eli" el-car el-cdr el-compile-error el-cons el-cons? el-global-value el-integer? el-intern el-list-from el-list-to-array el-num el-number? el-opt el-prin1-string el-signal-message el-string? el-sym-is el-symbol-name el-symbol-name-or-string el-symobj? el-typeof)
  (import "./reader-format.eli" el-expand-file-name el-read-all el-read-from-string)
  (import "./evaluator.eli" el-call el-eval-source el-extract-declarations el-rest-after el-second el-set-dynamic-variable el-third el-validate-defun el-write-stderr)
  (import "./host-io.eli" el-fs el-load-file el-node-builtin el-os el-path)
  (import "./builtins.eli" createSession el-default-session el-session-option)
  (import "./compiler.eli" compileModule compileProgram)


  (defun registerModule (session feature source &optional filename)
    (let ((target (if (nullish? session) (el-default-session) session))
          (name (el-symbol-name-or-string feature)))
      (js-call (get target :moduleSources) :set name
               (js-object :source source :filename (el-opt filename)))
      feature))

  (defun evalProgram (source &optional options)
    (el-eval-source (el-session-option options)
                    source
                    (if (nullish? options) nil (el-opt (get options :filename)))))


  (defasync evalProgramAsync (source &optional options)
    (evalProgram source options))


  (defun el-arguments-from-host (value)
    ;; Host arrays become Elisp lists, other values pass through.
    (cond
      ((Array/isArray value) (el-list-from (js-call value :map (lambda (x) (el-arguments-from-host x)))))
      (t value)))


  (defun invokeFunction (session name args)
    (let ((target (el-intern name)))
      (el-call session target (js-call (if (nullish? args) (js-array) args) :map (lambda (x) (el-arguments-from-host x))))))


  (defun callSession (session name arguments)
    ;; ARGUMENTS is the printed Elisp list of arguments; returns the printed result.
    (let ((args (el-list-to-array (el-car (el-read-from-string arguments 0)))))
      (el-prin1-string (el-call session (el-intern name) args) t)))


  (defun evalSession (session program &optional filename)
    ;; PROGRAM is an Elisp source string; evaluates it in SESSION and returns the printed result.
    (el-prin1-string (evalProgram program (js-object :session session :filename filename)) t))


  ;; ------------------------------------------------------------------
  ;; WASM / Native ABI Kernel Compiler
  ;; ------------------------------------------------------------------

  (defun el-wasm-uleb128 (value)
    (let ((out (js-array))
          (v (unsigned-bit-shift-right value 0))
          (more t))
      (while more
        (let ((byte (bit-and v 127)))
          (setq v (unsigned-bit-shift-right v 7))
          (if (= v 0)
              (progn (js-call out :push byte) (setq more false))
            (js-call out :push (bit-or byte 128)))))
      out))

  (defun el-wasm-sleb128 (value)
    (let ((out (js-array))
          (v (bit-or value 0))
          (more t))
      (while more
        (let ((byte (bit-and v 127)))
          (setq v (bit-shift-right v 7))
          (if (or (and (= v 0) (= (bit-and byte 64) 0))
                  (and (= v -1) (/= (bit-and byte 64) 0)))
              (progn (js-call out :push byte) (setq more false))
            (js-call out :push (bit-or byte 128)))))
      out))

  (defun el-wasm-f64-bytes (num)
    (let* ((buf (new globalThis.ArrayBuffer 8))
           (view (new globalThis.DataView buf))
           (bytes (new globalThis.Uint8Array buf))
           (out (js-array))
           (i 0))
      (js-call view :setFloat64 0 num t)
      (while (< i 8)
        (js-call out :push (aref bytes i))
        (setq i (1+ i)))
      out))

  (defun el-wasm-utf8-bytes (text)
    (let ((out (js-array)) (i 0))
      (while (< i (js-length text))
        (js-call out :push (bit-and (js-call text :charCodeAt i) 255))
        (setq i (1+ i)))
      out))

  (defun el-wasm-section (id payload)
    (js-call (js-array id) :concat (el-wasm-uleb128 (js-length payload)) payload))

  (defun el-parse-abi-kernel (source export-name)
    (let ((forms (el-read-all source))
          (session (createSession))
          (want (el-symbol-name-or-string export-name))
          (matched nil))
      (when (= (js-length forms) 0)
        (el-compile-error "ELI-B0002: empty ABI kernel source"))
      (js-call forms :forEach
               (lambda (form)
                 (unless (el-cons? form)
                   (el-compile-error "ELI-B0002: invalid top-level ABI form"))
                 (let ((head (get form :car)))
                   (cond
                     ((el-sym-is head "defun")
                       (let* ((fn-sym (el-second form))
                              (fn-name (el-symbol-name fn-sym))
                              (arglist (el-third form))
                              (extracted (el-extract-declarations (el-list-to-array (el-rest-after form 2))))
                              (props (get extracted :props))
                              (body (get extracted :body))
                              (exp-prop (if (js-call props :has ":export")
                                            (el-symbol-name-or-string (js-call props :get ":export"))
                                          (js-call fn-name :replace (new globalThis.RegExp "-" "g") "_")))
                              (abi-prop (if (js-call props :has ":abi")
                                            (el-symbol-name (js-call props :get ":abi"))
                                          ":numeric-f64")))
                         (el-validate-defun session "defun" fn-sym props body arglist)
                         (when (or (= exp-prop want) (= fn-name want))
                           (setq matched
                                 (js-object :name fn-name
                                            :exportName want
                                            :params (js-call (el-list-to-array arglist) :map (lambda (p) (el-symbol-name p)))
                                            :abi abi-prop
                                            :body body)))))
                     ((or (el-sym-is head "require") (el-sym-is head "provide") (el-sym-is head "declare"))
                       nil)
                     (t
                       (el-compile-error (str "ELI-B0002: unsupported top-level form in ABI kernel: " (el-symbol-name head))))))))
      (when (nil? matched)
        (el-compile-error (str "ELI-B0002: ABI export " want " not found")))
      matched))

  (defun el-abi-void-stmt? (form)
    (and (el-cons? form) (el-sym-is (get form :car) "mem-store-u32")))

  (defun el-compile-wasm-expr (expr local-map is-u32 alloc-local)
    (cond
      ((el-symobj? expr)
        (let ((name (el-symbol-name expr)))
          (unless (js-call local-map :has name)
            (el-compile-error (str "ELI-B0003: unbound ABI variable " name)))
          (js-call (js-array 32) :concat (el-wasm-uleb128 (js-call local-map :get name)))))
      ((el-number? expr)
        (if is-u32
            (js-call (js-array 65) :concat (el-wasm-sleb128 (bit-or (el-num expr) 0)))
          (js-call (js-array 68) :concat (el-wasm-f64-bytes (el-num expr)))))
      ((el-cons? expr)
        (let* ((head (el-symbol-name (get expr :car)))
               (args (el-list-to-array (get expr :cdr)))
               (n (js-length args)))
          (cond
            ((= head "progn")
              (if (= n 0)
                  (if is-u32 (js-array 65 0) (js-call (js-array 68) :concat (el-wasm-f64-bytes 0)))
                (let ((out (js-array)) (i 0))
                  (while (< i n)
                    (let ((sub (aref args i))
                          (code (el-compile-wasm-expr (aref args i) local-map is-u32 alloc-local)))
                      (setq out (js-call out :concat code))
                      (if (< i (1- n))
                          (unless (el-abi-void-stmt? sub)
                            (js-call out :push 26))
                        (when (el-abi-void-stmt? sub)
                          (setq out (js-call out :concat (js-array 65 0))))))
                    (setq i (1+ i)))
                  out)))
            ((or (= head "let") (= head "let*"))
              (let ((bindings (el-list-to-array (aref args 0)))
                    (body (js-call args :slice 1))
                    (next-map (new globalThis.Map local-map))
                    (out (js-array)))
                (js-call bindings :forEach
                         (lambda (b)
                           (let* ((var-name (el-symbol-name (if (el-cons? b) (get b :car) b)))
                                  (init-form (if (el-cons? b) (el-second b) 0))
                                  (init-code (el-compile-wasm-expr init-form
                                                                   (if (= head "let*") next-map local-map)
                                                                   is-u32 alloc-local))
                                  (slot (funcall alloc-local)))
                             (setq out (js-call out :concat init-code (js-array 33) (el-wasm-uleb128 slot)))
                             (js-call next-map :set var-name slot))))
                (js-call out :concat
                         (el-compile-wasm-expr (el-cons (el-intern "progn") (el-list-from body))
                                               next-map is-u32 alloc-local))))
            ((= head "mem-store-u32")
              (let ((off-code (el-compile-wasm-expr (aref args 0) local-map is-u32 alloc-local))
                    (val-code (el-compile-wasm-expr (aref args 1) local-map is-u32 alloc-local)))
                (js-call off-code :concat val-code (js-array 54 2 0))))
            ((= head "mem-load-u32")
              (let ((off-code (el-compile-wasm-expr (aref args 0) local-map is-u32 alloc-local)))
                (js-call off-code :concat (js-array 40 2 0))))
            ((or (= head "+") (= head "word-add"))
              (if (= n 0)
                  (if is-u32 (js-array 65 0) (js-call (js-array 68) :concat (el-wasm-f64-bytes 0)))
                (let ((out (el-compile-wasm-expr (aref args 0) local-map is-u32 alloc-local))
                      (op (if is-u32 106 160))
                      (i 1))
                  (while (< i n)
                    (setq out (js-call out :concat
                                       (el-compile-wasm-expr (aref args i) local-map is-u32 alloc-local)
                                       (js-array op)))
                    (setq i (1+ i)))
                  out)))
            ((or (= head "-") (= head "word-sub"))
              (let ((op (if is-u32 107 161)))
                (if (= n 1)
                    (let ((zero (if is-u32 (js-array 65 0) (js-call (js-array 68) :concat (el-wasm-f64-bytes 0)))))
                      (js-call zero :concat
                               (el-compile-wasm-expr (aref args 0) local-map is-u32 alloc-local)
                               (js-array op)))
                  (let ((out (el-compile-wasm-expr (aref args 0) local-map is-u32 alloc-local))
                        (i 1))
                    (while (< i n)
                      (setq out (js-call out :concat
                                         (el-compile-wasm-expr (aref args i) local-map is-u32 alloc-local)
                                         (js-array op)))
                      (setq i (1+ i)))
                    out))))
            ((or (= head "*") (= head "word-mul"))
              (if (= n 0)
                  (if is-u32 (js-array 65 1) (js-call (js-array 68) :concat (el-wasm-f64-bytes 1)))
                (let ((out (el-compile-wasm-expr (aref args 0) local-map is-u32 alloc-local))
                      (op (if is-u32 108 162))
                      (i 1))
                  (while (< i n)
                    (setq out (js-call out :concat
                                       (el-compile-wasm-expr (aref args i) local-map is-u32 alloc-local)
                                       (js-array op)))
                    (setq i (1+ i)))
                  out)))
            ((or (= head "/") (= head "word-div"))
              (let ((out (el-compile-wasm-expr (aref args 0) local-map is-u32 alloc-local))
                    (op (if is-u32 110 163))
                    (i 1))
                (while (< i n)
                  (setq out (js-call out :concat
                                     (el-compile-wasm-expr (aref args i) local-map is-u32 alloc-local)
                                     (js-array op)))
                  (setq i (1+ i)))
                out))
            ((= head "1+")
              (let ((base (el-compile-wasm-expr (aref args 0) local-map is-u32 alloc-local)))
                (if is-u32
                    (js-call base :concat (js-array 65 1 106))
                  (js-call base :concat (js-array 68) (el-wasm-f64-bytes 1) (js-array 160)))))
            ((= head "1-")
              (let ((base (el-compile-wasm-expr (aref args 0) local-map is-u32 alloc-local)))
                (if is-u32
                    (js-call base :concat (js-array 65 1 107))
                  (js-call base :concat (js-array 68) (el-wasm-f64-bytes 1) (js-array 161)))))
            ((and is-u32 (or (= head "word-and") (= head "word-or") (= head "word-xor")
                             (= head "word-shl") (= head "word-shr")))
              (let ((op (cond ((= head "word-and") 113)
                              ((= head "word-or") 114)
                              ((= head "word-xor") 115)
                              ((= head "word-shl") 116)
                              (t 118)))
                    (out (el-compile-wasm-expr (aref args 0) local-map is-u32 alloc-local))
                    (i 1))
                (while (< i n)
                  (setq out (js-call out :concat
                                     (el-compile-wasm-expr (aref args i) local-map is-u32 alloc-local)
                                     (js-array op)))
                  (setq i (1+ i)))
                out))
            (t
              (el-compile-error (str "ELI-B0003: unsupported ABI operation " head))))))
      (t
        (el-compile-error "ELI-B0003: invalid ABI expression"))))

  (defun compileAbiWasm (source export-name)
    (let* ((kernel (el-parse-abi-kernel source export-name))
           (is-u32 (= (get kernel :abi) ":memory-u32"))
           (val-type (if is-u32 127 124))
           (params (get kernel :params))
           (nparams (js-length params))
           (local-map (new globalThis.Map))
           (extra-locals 0)
           (alloc-local (lambda ()
                          (let ((slot (+ nparams extra-locals)))
                            (setq extra-locals (1+ extra-locals))
                            slot))))
      (js-call params :forEach (lambda (p idx) (js-call local-map :set p idx)))
      (let* ((body-form (el-cons (el-intern "progn") (el-list-from (get kernel :body))))
             (instrs (js-call (el-compile-wasm-expr body-form local-map is-u32 alloc-local) :concat (js-array 11)))
             (locals-decl (if (= extra-locals 0)
                              (js-array 0)
                            (js-call (js-array 1) :concat (el-wasm-uleb128 extra-locals) (js-array val-type))))
             (func-body (js-call locals-decl :concat instrs))
             (param-types (js-call params :map (lambda (_) val-type)))
             (type-payload (js-call (js-array 1 96)
                                    :concat (el-wasm-uleb128 nparams) param-types (js-array 1 val-type)))
             (func-payload (js-array 1 0))
             (mem-section (if is-u32 (el-wasm-section 5 (js-array 1 0 1)) (js-array)))
             (exp-bytes (el-wasm-utf8-bytes (get kernel :exportName)))
             (exp-payload (js-call (js-array 1)
                                   :concat (el-wasm-uleb128 (js-length exp-bytes)) exp-bytes (js-array 0 0)))
             (code-payload (js-call (js-array 1)
                                    :concat (el-wasm-uleb128 (js-length func-body)) func-body))
             (full-bytes (js-call (js-array 0 97 115 109 1 0 0 0)
                                  :concat
                                  (el-wasm-section 1 type-payload)
                                  (el-wasm-section 3 func-payload)
                                  mem-section
                                  (el-wasm-section 7 exp-payload)
                                  (el-wasm-section 10 code-payload))))
        (new globalThis.Uint8Array full-bytes))))


  (defasync runAbiWasm (source export-name &optional args)
    (let* ((bytes (compileAbiWasm source export-name))
           (result (await (js-call globalThis.WebAssembly :instantiate bytes)))
           (exported (get (get (get result :instance) :exports) export-name))
           (raw (Reflect/apply exported nil (if (nullish? args) (js-array) args)))
           (kernel (el-parse-abi-kernel source export-name)))
      (if (= (get kernel :abi) ":memory-u32")
          (unsigned-bit-shift-right raw 0)
        raw)))


  (defun el-c-ident (name)
    (str "v_" (js-call (str name) :replace (new globalThis.RegExp "[^A-Za-z0-9_]" "g") "_")))

  (defun el-compile-c-expr (expr local-set is-u32)
    (cond
      ((el-symobj? expr)
        (let ((name (el-symbol-name expr)))
          (unless (js-call local-set :has name)
            (el-compile-error (str "ELI-B0003: unbound ABI variable " name)))
          (el-c-ident name)))
      ((el-number? expr)
        (if is-u32
            (str (unsigned-bit-shift-right (el-num expr) 0) "u")
          (let ((n (el-num expr)))
            (if (Number/isInteger n) (str n ".0") (str n)))))
      ((el-cons? expr)
        (let* ((head (el-symbol-name (get expr :car)))
               (args (el-list-to-array (get expr :cdr)))
               (n (js-length args)))
          (cond
            ((= head "progn")
              (if (= n 0)
                  (if is-u32 "0u" "0.0")
                (str "("
                     (js-call (js-call args :map
                                       (lambda (sub idx)
                                         (let ((c (el-compile-c-expr sub local-set is-u32)))
                                           (if (and (= idx (1- n)) (el-abi-void-stmt? sub))
                                               (str c ", 0u")
                                             c))))
                              :join ", ")
                     ")")))
            ((= head "mem-store-u32")
              (str "mem_store_u32("
                   (el-compile-c-expr (aref args 0) local-set is-u32) ", "
                   (el-compile-c-expr (aref args 1) local-set is-u32) ")"))
            ((= head "mem-load-u32")
              (str "mem_load_u32(" (el-compile-c-expr (aref args 0) local-set is-u32) ")"))
            ((or (= head "+") (= head "word-add"))
              (if (= n 0)
                  (if is-u32 "0u" "0.0")
                (str "(" (js-call (js-call args :map (lambda (a) (el-compile-c-expr a local-set is-u32))) :join " + ") ")")))
            ((or (= head "-") (= head "word-sub"))
              (if (= n 1)
                  (str "(-" (el-compile-c-expr (aref args 0) local-set is-u32) ")")
                (str "(" (js-call (js-call args :map (lambda (a) (el-compile-c-expr a local-set is-u32))) :join " - ") ")")))
            ((or (= head "*") (= head "word-mul"))
              (if (= n 0)
                  (if is-u32 "1u" "1.0")
                (str "(" (js-call (js-call args :map (lambda (a) (el-compile-c-expr a local-set is-u32))) :join " * ") ")")))
            ((or (= head "/") (= head "word-div"))
              (str "(" (js-call (js-call args :map (lambda (a) (el-compile-c-expr a local-set is-u32))) :join " / ") ")"))
            ((= head "1+")
              (str "(" (el-compile-c-expr (aref args 0) local-set is-u32) (if is-u32 " + 1u)" " + 1.0)")))
            ((= head "1-")
              (str "(" (el-compile-c-expr (aref args 0) local-set is-u32) (if is-u32 " - 1u)" " - 1.0)")))
            ((and is-u32 (or (= head "word-and") (= head "word-or") (= head "word-xor")))
              (let ((cop (cond ((= head "word-and") " & ")
                               ((= head "word-or") " | ")
                               (t " ^ "))))
                (str "((uint32_t)(" (js-call (js-call args :map (lambda (a) (el-compile-c-expr a local-set is-u32))) :join cop) "))")))
            ((and is-u32 (or (= head "word-shl") (= head "word-shr")))
              (let ((cop (if (= head "word-shl") " << " " >> ")))
                (str "((uint32_t)(" (el-compile-c-expr (aref args 0) local-set is-u32)
                     cop "((" (el-compile-c-expr (aref args 1) local-set is-u32) ") & 31u)))")))
            (t
              (el-compile-error (str "ELI-B0003: unsupported ABI operation " head))))))
      (t
        (el-compile-error "ELI-B0003: invalid ABI expression"))))

  (defasync runAbiNative (source export-name &optional args)
    (let* ((kernel (el-parse-abi-kernel source export-name))
           (is-u32 (= (get kernel :abi) ":memory-u32"))
           (ctype (if is-u32 "uint32_t" "double"))
           (params (get kernel :params))
           (local-set (new globalThis.Set params))
           (c-params (if (= (js-length params) 0)
                         "void"
                       (js-call (js-call params :map (lambda (p) (str ctype " " (el-c-ident p)))) :join ", ")))
           (body-expr (el-compile-c-expr (el-cons (el-intern "progn") (el-list-from (get kernel :body)))
                                         local-set is-u32))
           (call-args (js-call (if (nullish? args) (js-array) args)
                               :map (lambda (a)
                                      (if is-u32
                                          (str (unsigned-bit-shift-right (el-num a) 0) "u")
                                        (let ((n (el-num a)))
                                          (if (Number/isInteger n) (str n ".0") (str n)))))))
           (c-code (str "#include <stdint.h>\n#include <stdio.h>\n"
                        "static uint8_t abi_mem[65536];\n"
                        "static inline void mem_store_u32(uint32_t off, uint32_t v) { *(uint32_t *)(abi_mem + off) = v; }\n"
                        "static inline uint32_t mem_load_u32(uint32_t off) { return *(uint32_t *)(abi_mem + off); }\n"
                        "static " ctype " kernel_fn(" c-params ") { return " body-expr "; }\n"
                        "int main(void) {\n"
                        "  " ctype " res = kernel_fn(" (js-call call-args :join ", ") ");\n"
                        (if is-u32
                            "  printf(\"%u\\n\", res);\n"
                          "  printf(\"%.17g\\n\", res);\n")
                        "  return 0;\n}\n"))
           (cp (el-node-builtin "child_process"))
           (fs-mod (el-fs))
           (os-mod (el-os))
           (path-mod (el-path))
           (tmp-base (if (and (not (nullish? os-mod)) (not (nullish? (get os-mod :tmpdir))))
                         (js-call os-mod :tmpdir)
                       "/tmp"))
           (bin-path (js-call path-mod :join tmp-base
                              (str "eliscript-abi-" (get globalThis.process :pid) "-" (js-call globalThis.Date :now) "-"
                                   (Math/floor (* (Math/random) 1000000))))))
      (try
        (let ((cc-res (js-call cp :spawnSync "cc"
                               (js-array "-O2" "-x" "c" "-" "-lm" "-o" bin-path)
                               (js-object :input c-code :encoding "utf8"))))
          (when (/= (get cc-res :status) 0)
            (el-compile-error (str "ELI-B0004: native ABI compiler failed: " (or (get cc-res :stderr) ""))))
          (let ((run-res (js-call cp :spawnSync bin-path (js-array) (js-object :encoding "utf8"))))
            (when (/= (get run-res :status) 0)
              (el-compile-error (str "ELI-B0004: native ABI execution failed: " (or (get run-res :stderr) ""))))
            (Number/parseFloat (js-call (str (or (get run-res :stdout) "0")) :trim))))
        (finally
          (try
            (when (and (not (nullish? fs-mod)) (js-call fs-mod :existsSync bin-path))
              (js-call fs-mod :unlinkSync bin-path))
            (catch _e nil))))))


  (defun getTimingReport (&optional timings)
    (let* ((entries (if (nullish? timings) (js-array) timings))
           (total (js-call entries :reduce (lambda (acc entry) (+ acc (or (get entry :elapsedMs) 0))) 0)))
      (js-object :totalTests (js-length entries)
                 :totalElapsedMs (/ (Math/round (* total 10000)) 10000)
                 :entries (js-call entries :slice))))


  (defun el-batch-pop-arg (session)
    (let ((cur (el-global-value session (el-intern "command-line-args-left"))))
      (if (not (el-cons? cur))
          undefined
        (do
          (el-set-dynamic-variable session (el-intern "command-line-args-left") (get cur :cdr))
          (str (or (get cur :car) ""))))))


  (defun el-batch-prepend-load-path (session dir)
    (let* ((expanded (js-call (el-expand-file-name session dir nil) :replace (new globalThis.RegExp "/+$") ""))
           (cur (el-global-value session (el-intern "load-path"))))
      (el-set-dynamic-variable session (el-intern "load-path") (el-cons expanded cur))))


  (defun runBatchCli (&optional raw-args)
    (let* ((p globalThis.process)
           (os-mod (el-os))
           (path-mod (el-path))
           (args (if (not (nullish? raw-args))
                     raw-args
                   (if (and (not (nullish? p)) (Array/isArray (get p :argv)))
                       (js-call (get p :argv) :slice 2)
                     (js-array))))
           (session (createSession))
           (cwd-raw (if (and (not (nullish? p)) (not (nullish? (get p :cwd)))) (js-call p :cwd) "/"))
           (cwd (if (js-call cwd-raw :endsWith "/") cwd-raw (str cwd-raw "/")))
           (tmp-raw (if (and (not (nullish? os-mod)) (not (nullish? (get os-mod :tmpdir)))) (js-call os-mod :tmpdir) "/tmp"))
           (tmp-dir (if (js-call tmp-raw :endsWith "/") tmp-raw (str tmp-raw "/")))
           (plat (if (not (nullish? p)) (get p :platform) "linux"))
           (sys-type (cond ((= plat "darwin") "darwin")
                           ((= plat "win32") "windows-nt")
                           (t "gnu/linux")))
           (env-obj (if (and (not (nullish? p)) (not (nullish? (get p :env)))) (get p :env) (js-object)))
           (env-entries (js-call (js-call (Object/entries env-obj) :filter (lambda (kv) (= (el-typeof (aref kv 1)) "string")))
                                 :map (lambda (kv) (str (aref kv 0) "=" (aref kv 1)))))
           (delim (if (and (not (nullish? path-mod)) (el-string? (get path-mod :delimiter))) (get path-mod :delimiter) ":"))
           (path-dirs (js-call (js-call (str (or (get env-obj :PATH) "")) :split delim) :filter (lambda (s) (> (js-length s) 0))))
           (ran-action false)
           (done false))
      (put session :batchOutput t)
      (el-set-dynamic-variable session (el-intern "noninteractive") t)
      (el-set-dynamic-variable session (el-intern "default-directory") cwd)
      (el-set-dynamic-variable session (el-intern "temporary-file-directory") tmp-dir)
      (el-set-dynamic-variable session (el-intern "system-type") (el-intern sys-type))
      (el-set-dynamic-variable session (el-intern "process-environment") (el-list-from env-entries))
      (el-set-dynamic-variable session (el-intern "exec-path") (el-list-from path-dirs))
      (el-set-dynamic-variable session (el-intern "invocation-name") "eliscript")
      (let ((inv-dir (or (get env-obj :ELISCRIPT_INVOCATION_DIR)
                         (if (and (not (nullish? path-mod)) (not (nullish? p)) (Array/isArray (get p :argv)) (> (js-length (get p :argv)) 1))
                             (str (js-call path-mod :resolve (js-call path-mod :dirname (aref (get p :argv) 1)) "../../bin") "/")
                           "/usr/bin/"))))
        (el-set-dynamic-variable session (el-intern "invocation-directory")
                                 (if (js-call inv-dir :endsWith "/") inv-dir (str inv-dir "/"))))
      (el-set-dynamic-variable session (el-intern "command-line-args") (el-list-from (js-call (js-array "eliscript") :concat args)))
      (el-set-dynamic-variable session (el-intern "command-line-args-left") (el-list-from args))
      (try
        (while (not done)
          (let ((cur (el-global-value session (el-intern "command-line-args-left"))))
            (if (not (el-cons? cur))
                (setq done t)
              (let ((arg (el-batch-pop-arg session)))
                (cond
                  ((undefined? arg) (setq done t))
                  ((= arg "--")
                    (when (not ran-action)
                      (let ((script (el-batch-pop-arg session))
                            (next (el-global-value session (el-intern "command-line-args-left"))))
                        (when (and (el-cons? next) (= (str (or (get next :car) "")) "--"))
                          (el-batch-pop-arg session))
                        (unless (undefined? script)
                          (el-set-dynamic-variable session (el-intern "command-line-args")
                                                   (el-cons "eliscript" (el-global-value session (el-intern "command-line-args-left"))))
                          (setq ran-action t)
                          (el-load-file session script nil t nil nil))))
                    (setq done t))
                  ((or (= arg "--version") (= arg "-V"))
                    (when (and (not (nullish? p)) (not (nullish? (get p :stdout))))
                      (js-call (get p :stdout) :write "eliscript 0.1.0\n"))
                    (setq ran-action t)
                    (setq done t))
                  ((or (= arg "-Q") (= arg "-q") (= arg "--quick")
                       (= arg "--no-init-file") (= arg "--no-site-file") (= arg "--no-site-lisp")
                       (= arg "--batch") (= arg "-batch"))
                    nil)
                  ((or (= arg "-L") (= arg "--directory"))
                    (let ((dir (el-batch-pop-arg session)))
                      (unless (undefined? dir) (el-batch-prepend-load-path session dir))))
                  ((js-call arg :startsWith "--directory=")
                    (el-batch-prepend-load-path session (js-call arg :slice 12)))
                  ((or (= arg "-l") (= arg "--load"))
                    (let ((file (el-batch-pop-arg session)))
                      (unless (undefined? file)
                        (setq ran-action t)
                        (el-load-file session file nil t nil nil))))
                  ((js-call arg :startsWith "--load=")
                    (setq ran-action t)
                    (el-load-file session (js-call arg :slice 7) nil t nil nil))
                  ((or (= arg "--script") (= arg "-scriptload"))
                    (let ((file (el-batch-pop-arg session))
                          (next (el-global-value session (el-intern "command-line-args-left"))))
                      (when (and (el-cons? next) (= (str (or (get next :car) "")) "--"))
                        (el-batch-pop-arg session))
                      (unless (undefined? file)
                        (el-set-dynamic-variable session (el-intern "command-line-args")
                                                 (el-cons "eliscript" (el-global-value session (el-intern "command-line-args-left"))))
                        (setq ran-action t)
                        (el-load-file session file nil t nil nil))
                      (setq done t)))
                  ((js-call arg :startsWith "--script=")
                    (let ((next (el-global-value session (el-intern "command-line-args-left"))))
                      (when (and (el-cons? next) (= (str (or (get next :car) "")) "--"))
                        (el-batch-pop-arg session)))
                    (el-set-dynamic-variable session (el-intern "command-line-args")
                                             (el-cons "eliscript" (el-global-value session (el-intern "command-line-args-left"))))
                    (setq ran-action t)
                    (el-load-file session (js-call arg :slice 9) nil t nil nil)
                    (setq done t))
                  ((or (= arg "-f") (= arg "--funcall"))
                    (let ((fn-name (el-batch-pop-arg session)))
                      (unless (undefined? fn-name)
                        (setq ran-action t)
                        (el-call session (el-intern fn-name) (js-array)))))
                  ((js-call arg :startsWith "--funcall=")
                    (setq ran-action t)
                    (el-call session (el-intern (js-call arg :slice 10)) (js-array)))
                  ((or (= arg "-e") (= arg "--eval") (= arg "--execute"))
                    (let ((expr (el-batch-pop-arg session)))
                      (unless (undefined? expr)
                        (setq ran-action t)
                        (evalProgram expr (js-object :session session)))))
                  ((js-call arg :startsWith "--eval=")
                    (setq ran-action t)
                    (evalProgram (js-call arg :slice 7) (js-object :session session)))
                  ((js-call arg :startsWith "--execute=")
                    (setq ran-action t)
                    (evalProgram (js-call arg :slice 10) (js-object :session session)))
                  ((and (not ran-action) (not (js-call arg :startsWith "-")))
                    (let ((next (el-global-value session (el-intern "command-line-args-left"))))
                      (when (and (el-cons? next) (= (str (or (get next :car) "")) "--"))
                        (el-batch-pop-arg session)))
                    (el-set-dynamic-variable session (el-intern "command-line-args")
                                             (el-cons "eliscript" (el-global-value session (el-intern "command-line-args-left"))))
                    (setq ran-action t)
                    (el-load-file session arg nil t nil nil)
                    (setq done t))
                  (t
                    (el-set-dynamic-variable session (el-intern "command-line-args-left") cur)
                    (setq done t)))))))
        (catch err
          (if (and (not (nullish? err))
                   (or (get err :eliscriptBatchExit) (get err :eliscriptKillEmacs)))
              (let ((status (if (not (nullish? (get err :code))) (get err :code) (get err :status))))
                (when (and (not (nullish? p)) (not (nullish? (get p :exit))))
                  (js-call p :exit (if (el-integer? status) status 0))))
            (do
              (el-write-stderr (str "Error: "
                                    (if (and (not (nullish? err)) (not (nullish? (get err :conditionSymbol))))
                                        (el-signal-message session err)
                                      (if (and (not (nullish? err)) (not (nullish? (get err :message))))
                                          (get err :message)
                                        (str err)))))
              (when (and (not (nullish? p)) (not (nullish? (get p :exit))))
                (js-call p :exit 255))))))))

  (export callSession compileAbiWasm compileModule compileProgram evalProgram evalProgramAsync evalSession getTimingReport invokeFunction registerModule runAbiNative runAbiWasm runBatchCli))
