(module eliscript.runtime.lisp.async-lowering
  ;; Source-to-source continuation lowering, shared by evaluation and AOT.
  ;; Only suspension points are split. Atomic forms retain their normal compiler
  ;; and evaluator semantics; no function is replayed after a pending await.
  (import "./core.eli" el-car el-cdr el-compile-error el-cons el-cons? el-intern el-list el-list-from el-list-to-array el-nth el-symbol-name el-symobj? el-string?)

  (defun el-async-suspends? (form)
    (and (el-cons? form)
      (let ((name (if (el-symobj? (el-car form)) (el-symbol-name (el-car form)) "")))
        (cond
          ((or (= name "quote") (= name "function") (= name "lambda") (= name "defun")
               (= name "lambda-async") (= name "defun-async")) false)
          ((= name "await") t)
          (t (js-call (el-list-to-array (if (el-symobj? (el-car form)) (el-cdr form) form)) :some el-async-suspends?))))))

  (defun el-lower-async-body (session body expand)
    (let ((counter 0))
      (let ((fresh nil) (sequence nil) (arguments nil) (lower nil))
        (setq fresh (lambda ()
                   (setq counter (1+ counter))
                   (put session :gensymCounter (1+ (get session :gensymCounter)))
                   (el-intern (str "__eliscript_async_" (get session :gensymCounter) "_" counter)))
         sequence (lambda (forms k)
           (if (= (js-length forms) 0) (funcall k nil)
             (if (= (js-length forms) 1) (funcall lower (aref forms 0) k)
               (funcall lower (aref forms 0) (lambda (value)
                 (el-list (el-intern "progn") value (funcall sequence (js-call forms :slice 1) k)))))))
         arguments (lambda (forms done)
           (if (= (js-length forms) 0) (funcall done (js-array))
             (funcall lower (aref forms 0) (lambda (value)
               (let ((tmp (funcall fresh)))
                 (el-list (el-intern "let") (el-list (el-list tmp value))
                   (funcall arguments (js-call forms :slice 1)
                     (lambda (tail) (funcall done (js-call (js-array tmp) :concat tail))))))))))
         lower (lambda (raw k)
           (let ((form (funcall expand raw)))
             (if (not (el-async-suspends? form)) (funcall k form)
               (let* ((name (el-symbol-name (el-car form)))
                      (args (el-list-to-array (el-cdr form))))
                 (cond
                   ((= name "await")
                     (unless (= (js-length args) 1) (el-compile-error "ELI-A0001: await expects one Future"))
                     (funcall lower (aref args 0) (lambda (value)
                       (let ((tmp (funcall fresh)))
                         (el-list (el-intern "%async-bind") value tmp (funcall k tmp))))))
                   ((or (= name "when") (= name "unless"))
                     (funcall lower (el-list (el-intern "if") (aref args 0)
                       (if (= name "when") (el-cons (el-intern "progn") (el-list-from (js-call args :slice 1))) nil)
                       (if (= name "unless") (el-cons (el-intern "progn") (el-list-from (js-call args :slice 1))) nil)) k))
                   ((= name "cond")
                     (if (= (js-length args) 0) (funcall k nil)
                       (let* ((clause (el-list-to-array (aref args 0))) (tmp (funcall fresh)))
                         (funcall lower (aref clause 0) (lambda (test)
                           (el-list (el-intern "let") (el-list (el-list tmp test))
                             (el-list (el-intern "if") tmp
                               (if (= (js-length clause) 1) (funcall k tmp)
                                 (funcall sequence (js-call clause :slice 1) k))
                               (funcall lower (el-cons (el-intern "cond") (el-list-from (js-call args :slice 1))) k))))))))
                   ((or (= name "prog1") (= name "prog2"))
                     (if (= name "prog2")
                         (funcall lower (el-list (el-intern "progn") (aref args 0)
                           (el-cons (el-intern "prog1") (el-list-from (js-call args :slice 1)))) k)
                       (funcall lower (aref args 0) (lambda (first)
                         (let ((tmp (funcall fresh)))
                           (el-list (el-intern "let") (el-list (el-list tmp first))
                             (funcall sequence (js-call args :slice 1) (lambda (value) (el-list (el-intern "progn") value (funcall k tmp))))))))))
                   ((= name "progn") (funcall sequence args k))
                   ((= name "if")
                     (funcall lower (aref args 0) (lambda (test)
                       (el-list (el-intern "if") test
                         (funcall lower (aref args 1) k)
                         (funcall sequence (js-call args :slice 2) k)))))
                   ((or (= name "let") (= name "let*"))
                     (let ((bindings (el-list-to-array (aref args 0))) (rest (js-call args :slice 1))
                           (finish (lambda (scoped)
                             (let ((tmp (funcall fresh)))
                               (el-list (el-intern "%async-bind") (el-list (el-intern "%async-scope") scoped)
                                 tmp (funcall k (el-list (el-intern "%async-unbox") tmp))))))
                           (box (lambda (value) (el-list (el-intern "%async-value") value))))
                       (if (= name "let*")
                           (if (= (js-length bindings) 0) (funcall sequence rest k)
                             (let ((binding (aref bindings 0)))
                               (funcall lower (if (el-cons? binding) (el-nth 1 binding) nil)
                                 (lambda (value)
                                   (funcall finish (el-list (el-intern "let")
                                     (el-list (el-list (if (el-cons? binding) (el-car binding) binding) value))
                                     (funcall lower (el-cons (el-intern "let*")
                                       (el-cons (el-list-from (js-call bindings :slice 1)) (el-list-from rest))) box)))))))
                         (funcall arguments (js-call bindings :map (lambda (b) (if (el-cons? b) (el-nth 1 b) nil)))
                           (lambda (values)
                             (funcall finish (el-cons (el-intern "let")
                               (el-list (el-list-from (js-call bindings :map (lambda (b i)
                                 (el-list (if (el-cons? b) (el-car b) b) (aref values i)))))
                                 (funcall sequence rest box)))))))))
                   ((= name "setq")
                     (if (< (js-length args) 2) (el-compile-error "ELI-A0001: malformed async setq")
                       (funcall lower (aref args 1) (lambda (value)
                         (let ((assignment (el-list (el-intern "setq") (aref args 0) value)))
                           (if (= (js-length args) 2) (funcall k assignment)
                             (el-list (el-intern "progn") assignment
                               (funcall lower (el-cons (el-intern "setq") (el-list-from (js-call args :slice 2))) k))))))))
                   ((= name "while")
                     ;; A recursive continuation represents the loop back-edge;
                     ;; the runtime trampolines ready iterations without growing
                     ;; the host stack.
                     (let ((loop-name (funcall fresh)))
                       (el-list (el-intern "%async-loop") loop-name
                         (funcall lower (aref args 0) (lambda (test)
                           (el-list (el-intern "if") test
                             (funcall sequence (js-call args :slice 1)
                               (lambda (value) (el-list (el-intern "progn") value (el-list (el-intern "%async-next")))))
                             (funcall k nil)))))))
                   ((or (= name "and") (= name "or"))
                     (if (= (js-length args) 0) (funcall k (if (= name "and") t nil))
                       (funcall lower (aref args 0) (lambda (value)
                         (let ((tmp (funcall fresh)))
                           (el-list (el-intern "let") (el-list (el-list tmp value))
                             (if (= (js-length args) 1) (funcall k tmp)
                               (el-list (el-intern "if") tmp
                                 (if (= name "and") (funcall lower (el-cons (el-car form) (el-list-from (js-call args :slice 1))) k) (funcall k tmp))
                                 (if (= name "or") (funcall lower (el-cons (el-car form) (el-list-from (js-call args :slice 1))) k) (funcall k tmp))))))))))
                   ((= name "condition-case")
                     (let ((tmp (funcall fresh)))
                       (el-list (el-intern "%async-bind")
                         (el-list (el-intern "%async-catch")
                           (funcall lower (aref args 1) (lambda (x) (el-list (el-intern "%async-value") x))) (aref args 0)
                           (el-list-from (js-call (js-call args :slice 2) :map (lambda (h)
                             (el-cons (el-car h) (el-list (funcall sequence (el-list-to-array (el-cdr h)) (lambda (x) (el-list (el-intern "%async-value") x)))))))))
                         tmp (funcall k (el-list (el-intern "%async-unbox") tmp)))))
                   ((= name "unwind-protect")
                     (let ((tmp (funcall fresh)))
                       (el-list (el-intern "%async-bind")
                         (el-list (el-intern "%async-finally")
                           (funcall lower (aref args 0) (lambda (x) (el-list (el-intern "%async-value") x)))
                           (funcall sequence (js-call args :slice 1) (lambda (x) (el-list (el-intern "%async-value") x))))
                         tmp (funcall k (el-list (el-intern "%async-unbox") tmp)))))
                   ((or (= name "quote") (= name "function")) (funcall k form))
                   (t
                     (when (or (= name "catch") (= name "unwind-protect") (= name "condition-case")
                               (= name "cl-labels") (= name "cl-flet"))
                       (el-compile-error (str "ELI-A0001: unsupported suspension boundary " name)))
                     (funcall arguments args (lambda (values)
                       (funcall k (el-cons (el-car form) (el-list-from values))))))))))))
        (funcall sequence body (lambda (x) x)))))

  (defun el-lower-async-spec (session spec expand)
    (let ((declarations (js-array)) (body (js-array)))
      (js-call (el-list-to-array (el-cdr spec)) :forEach (lambda (form index)
        (if (or (and (= index 0) (el-string? form))
                (and (el-cons? form) (el-symobj? (el-car form)) (= (el-symbol-name (el-car form)) "declare")))
            (js-call declarations :push form)
          (js-call body :push form))))
      (el-cons (el-car spec)
        (el-list-from (js-call declarations :concat (js-array (el-lower-async-body session body expand)))))))

  (export el-async-suspends? el-lower-async-body el-lower-async-spec))
