(module eliscript.runtime.binding
  (import "./core/collection.mjs" get)
  (defconst host-nullish (js* "(value) => value == null"))
  (defconst host-truthy (js* "(value) => !!value"))
  (defconst host-typeof (js* "(value) => typeof value"))
  (defconst host-prototype (js* "(value) => Object.getPrototypeOf(value)"))
  (defconst host-descriptor (js* "(value, key) => Object.getOwnPropertyDescriptor(value, key)"))
  (defconst host-symbol-for (js* "(key) => Symbol.for(key)"))
  (defun bindingGet (value key notFound)
    (if (funcall host-nullish value) notFound
      (let ((prototype (if (= (funcall host-typeof value) "object")
                         (funcall host-prototype value) undefined)))
        (when (or (eq prototype (get globalThis.Object :prototype)) (eq prototype nil))
          (let ((type (if (funcall host-truthy key)
                        (funcall host-descriptor key (funcall host-symbol-for "eliscript.value.type")) key)))
            (when (or (= (if (funcall host-nullish type) undefined (get type :value)) "keyword")
                      (= (if (funcall host-nullish type) undefined (get type :value)) "symbol"))
              (setq key (get key :qualifiedName)))))
        (funcall get value key notFound))))
  (export bindingGet))
