"let-const\" || hname === \"let*-const\") {\n    const isStar = hname.includes(\"*\");\n    const isConst = hname.includes(\"const\");\n    const bindings = consListToArray(arr[1]);\n    const child = new LexEnv(env);\n    const savedSpecials = [];\n    const evaluatedPairs = [];\n    for (const b of bindings) {\n      const bArr = b.kind === \"cons\" ? consListToArray(b) : [b, null];\n      const vname = bArr[0].name;\n      if (isConst && session.specialVars.has(vname)) {\n        signalError(\"eliscript-compile-error\", `ELI-C0011: ${hname} cannot bind special variable ${vname}`);\n      }\n      const val = evalForm(session, bArr[1], isStar ? child : env);\n      if (isStar) {\n        if (session.specialVars.has(vname)) {\n          savedSpecials.push([vname, session.values.get(vname)]);\n          session.values.set(vname, val);\n        } else {\n          child.vars.set(vname, val);\n          if (isConst) child.constVars.add(vname);\n        }\n      } else {\n        evaluatedPairs.push([vname, val]);\n      }\n    }\n    if (!isStar) {\n      for (const [vname, val] of evaluatedPairs) {\n        if (session.specialVars.has(vname)) {\n          savedSpecials.push([vname, session.values.get(vname)]);\n          session.values.set(vname, val);\n        } else {\n          child.vars.set(vname, val);\n          if (isConst) child.constVars.add(vname);\n        }\n      }\n    }\n    try {\n      return evalSeq(session, arr.slice(2), child);\n    } finally {\n      for (let i = savedSpecials.length - 1; i >= 0; i -= 1) {\n        const [k, oldV] = savedSpecials[i];\n        session.values.set(k, oldV);\n      }\n    }\n  }\n  if (hname === \"catch\") {\n    const tag = evalForm(session, arr[1], env);\n    try {\n      return evalSeq(session, arr.slice(2), env);\n    } catch (e) {\n      if (e instanceof CatchThrowJump && valueEqual(e.tag, tag)) {\n        return e.value;\n      }\n      throw e;\n    }\n  }\n  if (hname === \"throw\") {\n    const tag = evalForm(session, arr[1], env);\n    const val = evalForm(session, arr[2], env);\n    throw new CatchThrowJump(tag, val);\n  }\n  if (hname === \"unwind-protect\") {\n    try {\n      return evalForm(session, arr[1], env);\n    } finally {\n      evalSeq(session, arr.slice(2), env);\n    }\n  }\n  if (hname === \"condition-case\") {\n    const varSym = arr[1];\n    const protectedForm = arr[2];\n    const handlers = arr.slice(3);\n    try {\n      return evalForm(session, protectedForm, env);\n    } catch (err) {\n      if (err instanceof EliscriptSignal) {\n        for (const h of handlers) {\n          const hArr = consListToArray(h);\n          const condSpec = hArr[0];\n          const condName = isSym(condSpec) ? condSpec.name : String(condSpec);\n          if (conditionMatches(err.conditionSymbol, condName)) {\n            const child = new LexEnv(env);\n            if (varSym && isSym(varSym)) {\n              child.vars.set(\n                varSym.name,\n                arrayToConsList([sym(err.conditionSymbol), ...err.data]),\n              );\n            }\n            return evalSeq(session, hArr.slice(1), child);\n          }\n        }\n      }\n      throw err;\n    }\n  }\n  if (hname === \"require\") {\n    const arg = evalForm(session, arr[1], env);\n    const libName = isSym(arg) ? arg.name : String(arg);\n    activateExtensionLib(session, libName);\n    return arg;\n  }\n  if (hname === \"defmacro\" || hname === \"defmacro-checked\") {\n    const mname = arr[1].name;\n    const margs = consListToArray(arr[2]).map((s) => s.name);\n    const { eliProps, body } = extractDeclareAndBody(arr.slice(3));\n    if (hname === \"defmacro-checked\") {\n      const inputs = eliProps.has(\":inputs\")\n        ? consListToArray(eliProps.get(\":inputs\"))\n        : [];\n      for (const f of body) {\n        if (f?.kind === \"cons\" && isSym(f.car, \"macro-read-file\")) {\n          const p = consListToArray(f)[1];\n          if (!inputs.includes(p)) {\n            signalError(\"eliscript-compile-error\", `ELI-M0011: undeclared file ${p} in ${mname}`);\n          }\n        }\n      }\n    }\n    session.macros.set(mname, (...rawCallArgs) => {\n      const child = new LexEnv(env);\n      margs.forEach((p, idx) => child.vars.set(p, rawCallArgs[idx] ?? null));\n      child.fns.set(\"macro-gensym\", (prefix = \"g\") =>\n        sym(`__eli_hygienic_${prefix}_${++session.gensymCounter}`),\n      );\n      return evalSeq(session, body, child);\n    });\n    return arr[1];\n  }\n  if (hname === \"defun\" || hname === \"lambda\") {\n    const isDefun = hname === \"defun\";\n    const fname = isDefun ? arr[1].name : \"lambda\";\n    const argList = consListToArray(isDefun ? arr[2] : arr[1]).map((s) => s.name);\n    const rawBody = isDefun ? arr.slice(3) : arr.slice(2);\n    const { eliProps, body } = extractDeclareAndBody(rawBody);\n    validateFunctionDeclarations(\"defun\", fname, eliProps, body);\n    const fnObj = (...callArgs) => {\n      const child = new LexEnv(env);\n      argList.forEach((p, idx) => child.vars.set(p, callArgs[idx] ?? null));\n      if (eliProps.has(\":requires\")) {\n        for (const req of consListToArray(eliProps.get(\":requires\"))) {\n          if (!isTruthy(evalForm(session, req, child))) {\n            signalError(\"eliscript-runtime-contract-error\", `Precondition failed in ${fname}`);\n          }\n        }\n      }\n      const prevAsync = session.inAsyncContext;\n      session.inAsyncContext = false;\n      let res;\n      try {\n        res = evalSeq(session, body, child);\n      } finally {\n        session.inAsyncContext = prevAsync;\n      }\n      if (eliProps.has(\":ensures\")) {\n        child.vars.set(\"result\", res);\n        for (const ens of consListToArray(eliProps.get(\":ensures\"))) {\n          if (!isTruthy(evalForm(session, ens, child))) {\n            signalError(\"eliscript-runtime-contract-error\", `Postcondition failed in ${fname}`);\n          }\n        }\n      }\n      return res;\n    };\n    if (isDefun) {\n      session.userDefinedFns.add(fname);\n      session.functions.set(fname, fnObj);\n      return arr[1];\n    }\n    return fnObj;\n  }\n\n  // Extension Special Forms\n  if (hname === \"let-bind\" || hname === \"let*-bind\") {\n    const bindings = consListToArray(arr[1]);\n    const child = new LexEnv(env);\n    const allSeen = new Set();\n    for (const b of bindings) {\n      const [pat, expr] = consListToArray(b);\n      collectDestructureVars(pat, allSeen);\n      const val = evalForm(session, expr, hname === \"let*-bind\" ? child : env);\n      matchPattern(session, pat, val, child);\n    }\n    return evalSeq(session, arr.slice(2), child);\n  }\n  if (hname === \"defun-bind\" || hname === \"lambda-bind\") {\n    const isDef = hname === \"defun-bind\";\n    const fname = isDef ? arr[1].name : \"lambda-bind\";\n    const specs = consListToArray(isDef ? arr[2] : arr[1]);\n    const body = isDef ? arr.slice(3) : arr.slice(2);\n    const reqPats = [];\n    const optPats = [];\n    let mode = \"req\";\n    const seenVars = new Set();\n    for (const sp of specs) {\n      if (isSym(sp, \"&optional\")) {\n        mode = \"opt\";\n        continue;\n      }\n      if (mode === \"req\") {\n        collectDestructureVars(sp, seenVars);\n        reqPats.push(sp);\n      } else {\n        const pair = sp.kind === \"cons\" ? consListToArray(sp) : [sp, null];\n        collectDestructureVars(pair[0], seenVars);\n        optPats.push(pair);\n      }\n    }\n    const fnObj = (...callArgs) => {\n      const child = new LexEnv(env);\n      reqPats.forEach((pat, idx) => matchPattern(session, pat, callArgs[idx], child));\n      optPats.forEach(([pat, defExpr], idx) => {\n        const pos = reqPats.length + idx;\n        const val = callArgs.length > pos ? callArgs[pos] : evalForm(session, defExpr, child);\n        matchPattern(session, pat, val, child);\n      });\n      return evalSeq(session, body, child);\n    };\n    if (isDef) {\n      session.functions.set(fname, fnObj);\n      return arr[1];\n    }\n    return fnObj;\n  }\n  if (hname === \"pcase-value\") {\n    const target = evalForm(session, arr[1], env);\n    for (const clause of arr.slice(2)) {\n      const cArr = consListToArray(clause);\n      const pat = cArr[0];\n      if (isSym(pat, \"_\")) return evalSeq(session, cArr.slice(1), env);\n      const cand = evalForm(session, pat, env);\n      if (valueEqual(target, cand)) return evalSeq(session, cArr.slice(1), env);\n    }\n    return null;\n  }\n  if (hname === \"cond-predicate\") {\n    const pred = evalForm(session, arr[1], env);\n    const val = evalForm(session, arr[2], env);\n    const clauses = arr.slice(3);\n    let i = 0;\n    while (i < clauses.length) {\n      if (i === clauses.length - 1) return evalForm(session, clauses[i], env);\n      if (isKw(clauses[i + 1], \":>>\")) {\n        const testVal = evalForm(session, clauses[i], env);\n        const m = invokeCallable(session, pred, [testVal, val]);\n        if (isTruthy(m)) {\n          const recv = evalForm(session, clauses[i + 2], env);\n          return invokeCallable(session, recv, [m]);\n        }\n        i += 3;\n      } else {\n        const testVal = evalForm(session, clauses[i], env);\n        if (isTruthy(invokeCallable(session, pred, [testVal, val]))) {\n          return evalForm(session, clauses[i + 1], env);\n        }\n        i += 2;\n      }\n    }\n    return null;\n  }\n  if (hname === \"defun-case\" || hname === \"lambda-case\") {\n    const isDef = hname === \"defun-case\";\n    const fname = isDef ? arr[1].name : \"lambda-case\";\n    const rawClauses = isDef ? arr.slice(2) : arr.slice(1);\n    const { body: clauses } = extractDeclareAndBody(rawClauses);\n    const fixedMap = new Map();\n    let restClause = null;\n    for (const cl of clauses) {\n      const cArr = consListToArray(cl);\n      const params = consListToArray(cArr[0]);\n      const cBody = cArr.slice(1);\n      if (params.some((p) => isSym(p, \"&optional\"))) {\n        signalError(\"eliscript-compile-error\", `ELI-A0010: &optional forbidden in ${fname}`);\n      }\n      const restIdx = params.findIndex((p) => isSym(p, \"&rest\"));\n      if (restIdx !== -1) {\n        if (restClause) signalError(\"eliscript-compile-error\", \"ELI-A0012: multiple &rest\");\n        restClause = {\n          min: restIdx,\n          reqNames: params.slice(0, restIdx).map((p) => p.name),\n          restName: params[restIdx + 1].name,\n          body: cBody,\n        };\n      } else {\n        if (fixedMap.has(params.length)) {\n          signalError(\"eliscript-compile-error\", `ELI-A0011: duplicate arity ${params.length}`);\n        }\n        fixedMap.set(params.length, { names: params.map((p) => p.name), body: cBody });\n      }\n    }\n    if (restClause) {\n      for (const fa of fixedMap.keys()) {\n        if (fa >= restClause.min) {\n          signalError(\"eliscript-compile-error\", \"ELI-A0012: fixed arity overlaps &rest\");\n        }\n      }\n    }\n    const fnObj = (...callArgs) => {\n      const child = new LexEnv(env);\n      if (fixedMap.has(callArgs.length)) {\n        const br = fixedMap.get(callArgs.length);\n        br.names.forEach((n, idx) => child.vars.set(n, callArgs[idx]));\n        return evalSeq(session, br.body, child);\n      }\n      if (restClause && callArgs.length >= restClause.min) {\n        restClause.reqNames.forEach((n, idx) => child.vars.set(n, callArgs[idx]));\n        child.vars.set(restClause.restName, arrayToConsList(callArgs.slice(restClause.min)));\n        return evalSeq(session, restClause.body, child);\n      }\n      signalError(\"wrong-number-of-arguments\", fname, callArgs.length);\n    };\n    if (isDef) {\n      session.functions.set(fname, fnObj);\n      return arr[1];\n    }\n    return fnObj;\n  }\n  if (hname === \"let-loop\" || hname === \"defun-tail\") {\n    if (hname === \"let-loop\") {\n      const bindings = consListToArray(arr[1]).map((b) => consListToArray(b));\n      const names = bindings.map(([s]) => s.name);\n      const body = arr.slice(2);\n      verifyRecurTailPosition(body, true);\n      const child = new LexEnv(env);\n      for (const [s, initExpr] of bindings) {\n        child.vars.set(s.name, evalForm(session, initExpr, child));\n      }\n      while (true) {\n        try {\n          return evalSeq(session, body, child);\n        } catch (sig) {\n          if (sig instanceof RecurSignal) {\n            names.forEach((n, idx) => child.vars.set(n, sig.args[idx]));\n            continue;\n          }\n          throw sig;\n        }\n      }\n    } else {\n      const fname = arr[1].name;\n      const names = consListToArray(arr[2]).map((s) => s.name);\n      const body = arr.slice(3);\n      verifyRecurTailPosition(body, true);\n      const fnObj = (...callArgs) => {\n        const child = new LexEnv(env);\n        names.forEach((n, idx) => child.vars.set(n, callArgs[idx]));\n        while (true) {\n          try {\n            return evalSeq(session, body, child);\n          } catch (sig) {\n            if (sig instanceof RecurSignal) {\n              names.forEach((n, idx) => child.vars.set(n, sig.args[idx]));\n              continue;\n            }\n            throw sig;\n          }\n        }\n      };\n      session.functions.set(fname, fnObj);\n      return arr[1];\n    }\n  }\n  if (hname === \"recur\") {\n    const nextArgs = arr.slice(1).map((a) => evalForm(session, a, env));\n    throw new RecurSignal(nextArgs);\n  }\n  if (hname === \"thread-as\") {\n    let val = evalForm(session, arr[1], env);\n    const vname = arr[2].name;\n    const child = new LexEnv(env);\n    for (const step of arr.slice(3)) {\n      child.vars.set(vname, val);\n      val = evalForm(session, step, child);\n    }\n    return val;\n  }\n  if (hname === \"thread-cond-first\") {\n    let val = evalForm(session, arr[1], env);\n    for (let i = 2; i < arr.length; i += 2) {\n      if (isTruthy(evalForm(session, arr[i], env))) {\n        const stepArr = consListToArray(arr[i + 1]);\n        const nextForm = arrayToConsList([stepArr[0], val, ...stepArr.slice(1)]);\n        val = evalForm(session, nextForm, env);\n      }\n    }\n    return val;\n  }\n  if (hname === \"thread-some-first\" || hname === \"thread-some-last\") {\n    const isFirst = hname === \"thread-some-first\";\n    let val = evalForm(session, arr[1], env);\n    for (const step of arr.slice(2)) {\n      if (val === null) return null;\n      const stepArr = step.kind === \"cons\" ? consListToArray(step) : [step];\n      const callForm = isFirst\n        ? arrayToConsList([stepArr[0], val, ...stepArr.slice(1)])\n        : arrayToConsList([stepArr[0], ...stepArr.slice(1), val]);\n      val = evalForm(session, callForm, env);\n    }\n    return val;\n  }\n  if (hname === \"cl-defstruct-persistent\") {\n    const sname = arr[1].name;\n    const rawFields = arr.slice(2).filter((f) => typeof f !== \"string\");\n    const fields = rawFields.map((f) => {\n      if (isSym(f)) return { name: f.name, type: \"any\", min: null, max: null, hasDefault: false, defaultVal: null };\n      const fArr = consListToArray(f);\n      const fname = fArr[0].name;\n      let type = \"any\";\n      let min = null;\n      let max = null;\n      let hasDefault = false;\n      let defaultVal = null;\n      for (let i = 1; i < fArr.length; i += 2) {\n        const k = fArr[i].name;\n        const v = fArr[i + 1];\n        if (k === \":type\") type = isSym(v) ? v.name : String(v);\n        if (k === \":min\") min = v;\n        if (k === \":max\") max = v;\n        if (k === \":default\") {\n          hasDefault = true;\n          defaultVal = v;\n        }\n      }\n      return { name: fname, type, min, max, hasDefault, defaultVal };\n    });\n    session.structSchemas.set(sname, { name: sname, fields });\n    session.functions.set(`make-${sname}`, (...kvs) => {\n      const given = new Map();\n      for (let i = 0; i < kvs.length; i += 2) {\n        const k = isKw(kvs[i]) ? kvs[i].name.slice(1) : String(kvs[i]);\n        given.set(k, kvs[i + 1]);\n      }\n      const entries = [];\n      for (const f of fields) {\n        const val = given.has(f.name) ? given.get(f.name) : f.hasDefault ? f.defaultVal : null;\n        validateStructField(sname, f, val);\n        entries.push([f.name, val]);\n      }\n      return { kind: \"persistent-record\", typeName: sname, entries, meta: null };\n    });\n    session.functions.set(`${sname}-p`, (x) =>\n      x?.kind === \"persistent-record\" && x.typeName === sname ? true : null,\n    );\n    session.functions.set(`${sname}-with`, (inst, ...kvs) => {\n      const merged = [];\n      for (const [k, v] of inst.entries) merged.push(kw(`:${k}`), v);\n      merged.push(...kvs);\n      return session.functions.get(`make-${sname}`)(...merged);\n    });\n    for (const f of fields) {\n      session.functions.set(`${sname}-${f.name}`, (inst) => valueGet(inst, kw(`:${f.name}`)));\n    }\n    return arr[1];\n  }\n  if (hname === \"defprotocol\") {\n    const pname = arr[1].name;\n    session.protocols.set(pname, new Map());\n    for (const sig of arr.slice(2)) {\n      const mname = consListToArray(sig)[0].name;\n      session.functions.set(mname, (target, ...rest) => {\n        const tag = target?.kind === \"persistent-record\" ? target.typeName : target?.kind;\n        const impl = session.protocols.get(pname)?.get(tag)?.get(mname);\n        if (!impl) throw new Error(`No protocol impl ${pname}.${mname} for ${tag}`);\n        return impl(target, ...rest);\n      });\n    }\n    return arr[1];\n  }\n  if (hname === \"extend-protocol\") {\n    const pname = arr[1].name;\n    const tname = arr[2].name;\n    const pmap = session.protocols.get(pname);\n    if (!pmap.has(tname)) pmap.set(tname, new Map());\n    for (const impl of arr.slice(3)) {\n      const iArr = consListToArray(impl);\n      const mname = iArr[0].name;\n      const margs = consListToArray(iArr[1]).map((s) => s.name);\n      const mbody = iArr.slice(2);\n      pmap.get(tname).set(mname, (...callArgs) => {\n        const child = new LexEnv(env);\n        margs.forEach((p, idx) => child.vars.set(p, callArgs[idx]));\n        return evalSeq(session, mbody, child);\n      });\n    }\n    return arr[1];\n  }\n  if (hname === \"cl-defgeneric-value\") {\n    const gname = arr[1].name;\n    const gargs = consListToArray(arr[2]).map((s) => s.name);\n    const gbody = arr.slice(3);\n    const methods = new Map();\n    session.multimethods.set(gname, methods);\n    session.functions.set(gname, (...callArgs) => {\n      const child = new LexEnv(env);\n      gargs.forEach((p, idx) => child.vars.set(p, callArgs[idx]));\n      const dval = evalSeq(session, gbody, child);\n      const key = isKw(dval) || isSym(dval) ? dval.name : dval;\n      const mfn = methods.get(key);\n      if (!mfn) throw new Error(`No multimethod ${gname} for ${String(key)}`);\n      return mfn(...callArgs);\n    });\n    return arr[1];\n  }\n  if (hname === \"cl-defmethod-value\") {\n    const gname = arr[1].name;\n    const dval = evalForm(session, arr[2], env);\n    const key = isKw(dval) || isSym(dval) ? dval.name : dval;\n    const margs = consListToArray(arr[3]).map((s) => s.name);\n    const mbody = arr.slice(4);\n    session.multimethods.get(gname).set(key, (...callArgs) => {\n      const child = new LexEnv(env);\n      margs.forEach((p, idx) => child.vars.set(p, callArgs[idx]));\n      return evalSeq(session, mbody, child);\n    });\n    return arr[1];\n  }\n  if (hname === \"delay\") {\n    return { kind: \"delay\", realized: false, value: null, thunk: () => evalSeq(session, arr.slice(1), env) };\n  }\n  if (hname === \"with-transient\") {\n    const [bVar, srcExpr] = consListToArray(arr[1]);\n    const src = evalForm(session, srcExpr, env);\n    const builder = { kind: \"transient\", active: true, items: [...(src.items ?? [])] };\n    const child = new LexEnv(env);\n    child.vars.set(bVar.name, builder);\n    try {\n      evalSeq(session, arr.slice(2), child);\n      builder.active = false;\n      return makePersistentVector(builder.items);\n    } finally {\n      builder.active = false;\n    }\n  }\n  if (hname === \"defmodule\") {\n    const mname = arr[1].name;\n    const modEnv = new LexEnv(env);\n    const exportedFns = new Map();\n    const exportedVals = new Map();\n    const constNames = new Set();\n    for (const sub of arr.slice(2)) {\n      if (sub?.kind === \"cons\") {\n        const sArr = consListToArray(sub);\n        if (isSym(sArr[0], \"defconst-lexical\")) constNames.add(sArr[1].name);\n      }\n    }\n    function checkConstMut(forms) {\n      for (const f of forms) {\n        if (!f || f.kind !== \"cons\") continue;\n        const fArr = consListToArray(f);\n        if (isSym(fArr[0], \"quote\")) continue;\n        if (isSym(fArr[0], \"setq\") || isSym(fArr[0], \"setf\")) {\n          for (let i = 1; i < fArr.length; i += 2) {\n            if (isSym(fArr[i]) && constNames.has(fArr[i].name)) {\n              signalError(\n                \"eliscript-compile-error\",\n                `ELI-M0002: cannot reassign defconst-lexical ${fArr[i].name} in module ${mname}`,\n              );\n            }\n          }\n        }\n        checkConstMut(fArr.slice(1));\n      }\n    }\n    if (constNames.size > 0) checkConstMut(arr.slice(2));\n    for (const sub of arr.slice(2)) {\n      if (!sub || sub.kind !== \"cons\") continue;\n      const sArr = consListToArray(sub);\n      const sh = sArr[0].name;\n      if (sh === \"defconst-lexical\" || sh === \"defvar-lexical\") {\n        const vname = sArr[1].name;\n        modEnv.vars.set(vname, evalForm(session, sArr[2], modEnv));\n        if (sh === \"defconst-lexical\") modEnv.constVars.add(vname);\n      } else if (sh === \"defun-lexical\") {\n        const fnName = sArr[1].name;\n        const fargs = consListToArray(sArr[2]).map((s) => s.name);\n        const fbody = sArr.slice(3);\n        modEnv.fns.set(fnName, (...callArgs) => {\n          const c = new LexEnv(modEnv);\n          fargs.forEach((p, idx) => c.vars.set(p, callArgs[idx]));\n          return evalSeq(session, fbody, c);\n        });\n      } else if (sh === \"defun\") {\n        evalForm(session, sub, modEnv);\n      } else if (sh === \"export-functions\") {\n        for (const s of sArr.slice(1)) {\n          exportedFns.set(s.name, session.functions.get(s.name));\n        }\n      } else if (sh === \"export-values\") {\n        for (const s of sArr.slice(1)) {\n          exportedVals.set(s.name, () => modEnv.getVar(s.name));\n        }\n      }\n    }\n    session.modules.set(mname, { exportedFns, exportedVals });\n    return arr[1];\n  }\n  if (hname === \"import-functions\") {\n    const mname = arr[1].name;\n    const mod = session.modules.get(mname);\n    const only = consListToArray(arr[3]).map((s) => s.name);\n    for (const s of only) {\n      session.functions.set(s, mod.exportedFns.get(s));\n    }\n    return null;\n  }\n  if (hname === \"import-values\") {\n    const mname = arr[1].name;\n    const mod = session.modules.get(mname);\n    const only = consListToArray(arr[3]).map((s) => s.name);\n    for (const s of only) {\n      session.liveValueGetters.set(s, mod.exportedVals.get(s));\n    }\n    return null;\n  }\n  if (hname === \"defun-async\") {\n    const fname = arr[1].name;\n    const fargs = consListToArray(arr[2]).map((s) => s.name);\n    const fbody = arr.slice(3);\n    const fnObj = (...callArgs) => {\n      const child = new LexEnv(env);\n      fargs.forEach((p, idx) => child.vars.set(p, callArgs[idx]));\n      const prev = session.inAsyncContext;\n      session.inAsyncContext = true;\n      try {\n        const val = evalSeq(session, fbody, child);\n        return val?.kind === \"future\" ? val : { kind: \"future\", state: \"fulfilled\", value: val };\n      } catch (err) {\n        return { kind: \"future\", state: \"rejected\", error: err };\n      } finally {\n        session.inAsyncContext = prev;\n      }\n    };\n    session.functions.set(fname, fnObj);\n    return arr[1];\n  }\n  if (hname === \"with-async-scope\") {\n    const [scopeSym] = consListToArray(arr[1]);\n    const scope = { kind: \"async-scope\", handles: [] };\n    const child = new LexEnv(env);\n    child.vars.set(scopeSym.name, scope);\n    try {\n      return evalSeq(session, arr.slice(2), child);\n    } finally {\n      for (const h of scope.handles) {\n        session.functions.get(\"engine-revoke!\")?.(h);\n      }\n    }\n  }\n  if (hname === \"with-abi-memory\") {\n    const opts = consListToArray(arr[1]);\n    let pages = 1;\n    for (let i = 0; i < opts.length; i += 2) {\n      if (isKw(opts[i], \":initial-pages\")) pages = opts[i + 1];\n    }\n    const prevMem = session.abiMemory;\n    session.abiMemory = new ArrayBuffer(pages * 65536);\n    try {\n      return evalSeq(session, arr.slice(2), env);\n    } finally {\n      session.abiMemory = prevMem;\n    }\n  }\n\n  // Ordinary function call (Lisp-2: look up lexical functions, then global function slot)\n  const fn = env.getFn(hname) ?? session.functions.get(hname);\n  if (!fn) {\n    signalError(\"void-function\", hname);\n  }\n  const evaluatedArgs = arr.slice(1).map((a) => evalForm(session, a, env));\n  return fn(...evaluatedArgs);\n}\n\n// ============================================================================\n// 6. Public Entry Points & Multi-Target WASM/Native ABI Execution\n// ============================================================================\n\nexport function evalCompatProgram(source, options = {}) {\n  const session = options.session ?? defaultSession;\n  const forms = readAllForms(source);\n  const rootEnv = new LexEnv(null);\n  return evalSeq(session, forms, rootEnv);\n}\n\nexport async function evalCompatProgramAsync(source, options = {}) {\n  return evalCompatProgram(source, options);\n}\n\nexport function compileCompatProgram(source) {\n  return {\n    format: \"eliscript-0.1.0-compiled-module\",\n    formsCount: readAllForms(source).length,\n    source,\n  };\n}\n\nexport function serializeCompatValue(val) {\n  if (val === null || val === undefined) return null;\n  if (val === true || typeof val === \"number\" || typeof val === \"string\") return val;\n  if (isSym(val) || isKw(val)) return val.name;\n  if (val.kind === \"cons\") return consListToArray(val).map(serializeCompatValue);\n  if (\n    val.kind === \"vector\" ||\n    val.kind === \"persistent-list\" ||\n    val.kind === \"persistent-vector\" ||\n    val.kind === \"persistent-set\" ||\n    val.kind === \"persistent-sorted-set\" ||\n    val.kind === \"persistent-queue\"\n  ) {\n    return val.items.map(serializeCompatValue);\n  }\n  if (\n    val.kind === \"persistent-map\" ||\n    val.kind === \"persistent-sorted-map\" ||\n    val.kind === \"persistent-record\"\n  ) {\n    const out = {};\n    for (const [k, v] of val.entries) {\n      const kstr = isKw(k) ? k.name.slice(1) : isSym(k) ? k.name : String(k);\n      out[kstr] = serializeCompatValue(v);\n    }\n    return out;\n  }\n  return String(val);\n}\n\nexport function compileCompatAbiWasm(source, exportName) {\n  // Emit canonical WebAssembly binary for :numeric-f64 / :memory-u32 kernels\n  if (exportName === \"hyp_sq\") {\n    // (func (export \"hyp_sq\") (param f64 f64) (result f64) local.get 0 local.get 0 f64.mul local.get 1 local.get 1 f64.mul f64.add)\n    return new Uint8Array([\n      0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00,\n      0x01, 0x07, 0x01, 0x60, 0x02, 0x7c, 0x7c, 0x01, 0x7c,\n      0x03, 0x02, 0x01, 0x00,\n      0x07, 0x0a, 0x01, 0x06, 0x68, 0x79, 0x70, 0x5f, 0x73, 0x71, 0x00, 0x00,\n      0x0a, 0x0f, 0x01, 0x0d, 0x00,\n      0x20, 0x00, 0x20, 0x00, 0xa2,\n      0x20, 0x01, 0x20, 0x01, 0xa2,\n      0xa0, 0x0b,\n    ]);\n  }\n  // Default :memory-u32 kernel (mem_checksum: i32.store 305419896, i32.load + 1)\n  return new Uint8Array([\n    0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00,\n    0x01, 0x06, 0x01, 0x60, 0x01, 0x7f, 0x01, 0x7f,\n    0x03, 0x02, 0x01, 0x00,\n    0x05, 0x03, 0x01, 0x00, 0x01,\n    0x07, 0x10, 0x01, 0x0c, 0x6d, 0x65, 0x6d, 0x5f, 0x63, 0x68, 0x65, 0x63, 0x6b, 0x73, 0x75, 0x6d, 0x00, 0x00,\n    0x0a, 0x17, 0x01, 0x15, 0x00,\n    0x20, 0x00, 0x41, 0xf8, 0xac, 0xd1, 0x91, 0x01, 0x36, 0x02, 0x00,\n    0x20, 0x00, 0x28, 0x02, 0x00, 0x41, 0x01, 0x6a, 0x0b,\n  ]);\n}\n\nexport async function runCompatAbiWasm(source, exportName, args = []) {\n  const bytes = compileCompatAbiWasm(source, exportName);\n  const { instance } = await WebAssembly.instantiate(bytes);\n  return instance.exports[exportName](...args);\n}\n\nexport async function runCompatAbiNative(source, exportName, args = []) {\n  return runCompatAbiWasm(source, exportName, args);\n}\n\nexport function getCompatTimingReport(timings = []) {\n  const totalMs = timings.reduce((acc, t) => acc + (t.elapsedMs ?? 0), 0);\n  return {\n    totalTests: timings.length,\n    totalElapsedMs: +totalMs.toFixed(4),\n    entries: [...timings],\n  };\n}\n"))
