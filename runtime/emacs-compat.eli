(module eliscript.runtime.emacs-compat
  ;; Emacs Lisp compatible runtime for Eliscript 0.1.0 (JavaScript host).
  ;;
  ;; Reads, evaluates and prints unmodified Emacs Lisp: the default 100% Emacs
  ;; Lisp kernel, the explicit `1 + 5 + 2' extension packs, and the industrial
  ;; subset used by real packages (cl-defstruct, setf places, pcase, cl-loop,
  ;; regexps, buffers, UTF-8 bytes, SHA-256, JSON).  `compileCompatElispModule'
  ;; turns Emacs Lisp source into an Eliscript module for Worker acceleration.
  ;;
  ;; Value representation:
  ;;   nil -> null, t -> true, integers and non-integral floats -> number,
  ;;   integral floats -> {kind "float"}, strings -> string, symbols and
  ;;   keywords -> interned {kind "symbol"|"keyword"}, cons -> {kind "cons"},
  ;;   vector -> {kind "vector" items}, record -> {kind "record" items}
  ;;   (items[0] is the type symbol), hash table -> {kind "hash-table"},
  ;;   buffer -> {kind "buffer"}; functions are host functions.
  ;; Elisp values never contain JavaScript false or undefined.

  ;; ------------------------------------------------------------------
  ;; Symbols
  ;; ------------------------------------------------------------------

  (defconst symbol-table (new globalThis.Map))

  (defun el-intern (name)
    (cond
      ((= name "nil") nil)
      ((= name "t") t)
      (t (let ((existing (js-call symbol-table :get name)))
           (if (undefined? existing)
               (let ((created (js-object :kind (if (and (js-call name :startsWith ":") (> (js-length name) 1))
                                                   "keyword" "symbol")
                                         :name name)))
                 (js-call symbol-table :set name created)
                 created)
             existing)))))

  (defun el-make-symbol (name) (js-object :kind "symbol" :name name :uninterned t))

  (defun el-typeof (x) (js* "typeof x"))
  (defun el-symbol? (x)
    (or (nil? x) (eq x t)
        (and (not (nullish? x)) (let ((k (get x :kind))) (or (= k "symbol") (= k "keyword"))))))
  (defun el-symobj? (x)
    (and (not (nullish? x)) (let ((k (get x :kind))) (or (= k "symbol") (= k "keyword")))))
  (defun el-keyword? (x) (and (not (nullish? x)) (= (get x :kind) "keyword")))
  (defun el-symbol-name (x)
    (cond ((nil? x) "nil") ((eq x t) "t") (t (get x :name))))
  (defun el-sym-is (x name) (and (el-symobj? x) (= (get x :name) name)))

  (defconst s-quote (el-intern "quote"))
  (defconst s-function (el-intern "function"))
  (defconst s-lambda (el-intern "lambda"))
  (defconst s-closure (el-intern "closure"))
  (defconst s-macro (el-intern "macro"))
  (defconst s-backquote (el-intern "`"))
  (defconst s-comma (el-intern ","))
  (defconst s-comma-at (el-intern ",@"))
  (defconst s-rest (el-intern "&rest"))
  (defconst s-body (el-intern "&body"))
  (defconst s-optional (el-intern "&optional"))
  (defconst s-key (el-intern "&key"))
  (defconst s-aux (el-intern "&aux"))
  (defconst s-allow-other-keys (el-intern "&allow-other-keys"))
  (defconst s-underscore (el-intern "_"))
  (defconst s-declare (el-intern "declare"))
  (defconst s-interactive (el-intern "interactive"))
  (defconst s-eliscript (el-intern "eliscript"))
  (defconst s-otherwise (el-intern "otherwise"))
  (defconst s-error (el-intern "error"))
  (defconst s-and (el-intern "and"))
  (defconst s-or (el-intern "or"))
  (defconst s-not (el-intern "not"))
  (defconst s-pred (el-intern "pred"))
  (defconst s-guard (el-intern "guard"))
  (defconst s-app (el-intern "app"))
  (defconst s-let (el-intern "let"))
  (defconst s-progn (el-intern "progn"))
  (defconst s-setq (el-intern "setq"))
  (defconst s-setf (el-intern "setf"))
  (defconst s-default (el-intern "default"))
  (defconst s-recur (el-intern "recur"))
  (defconst s-if (el-intern "if"))
  (defconst s-await (el-intern "await"))

  ;; ------------------------------------------------------------------
  ;; Core containers
  ;; ------------------------------------------------------------------

  (defun el-cons (a b) (js-object :kind "cons" :car a :cdr b))
  (defun el-cons? (x) (and (not (nullish? x)) (= (get x :kind) "cons")))
  (defun el-car (x)
    (cond ((nil? x) nil)
          ((el-cons? x) (get x :car))
          (t (el-signal "wrong-type-argument" (el-intern "listp") x))))
  (defun el-cdr (x)
    (cond ((nil? x) nil)
          ((el-cons? x) (get x :cdr))
          (t (el-signal "wrong-type-argument" (el-intern "listp") x))))
  (defun el-car-safe (x) (if (el-cons? x) (get x :car) nil))
  (defun el-cdr-safe (x) (if (el-cons? x) (get x :cdr) nil))

  (defun el-list-from (items &optional tail)
    (let ((out (if (nullish? tail) nil tail))
          (index (1- (js-length items))))
      (while (>= index 0)
        (setq out (el-cons (aref items index) out))
        (setq index (1- index)))
      out))
  (defun el-list (&rest items) (el-list-from items))

  (defun el-list-to-array (list)
    (let ((out (js-array)) (cursor list))
      (while (el-cons? cursor)
        (js-call out :push (get cursor :car))
        (setq cursor (get cursor :cdr)))
      out))

  (defun el-list-length (list)
    (let ((count 0) (cursor list))
      (while (el-cons? cursor)
        (setq count (1+ count))
        (setq cursor (get cursor :cdr)))
      count))

  (defun el-nth (n list)
    (let ((cursor list) (index 0))
      (while (and (< index n) (el-cons? cursor))
        (setq cursor (get cursor :cdr))
        (setq index (1+ index)))
      (el-car-safe cursor)))

  (defun el-nthcdr (n list)
    (let ((cursor list) (index 0))
      (while (and (< index n) (not (nil? cursor)))
        (setq cursor (el-cdr cursor))
        (setq index (1+ index)))
      cursor))

  (defun el-vector (items) (js-object :kind "vector" :items items))
  (defun el-vector? (x) (and (not (nullish? x)) (= (get x :kind) "vector")))
  (defun el-record? (x) (and (not (nullish? x)) (= (get x :kind) "record")))
  (defun el-string? (x) (= (js* "typeof x") "string"))
  (defun el-function? (x) (= (js* "typeof x") "function"))
  (defun el-hash-table? (x) (and (not (nullish? x)) (= (get x :kind) "hash-table")))
  (defun el-bool (x) (if x t nil))
  (defun el-kind (x)
    (cond ((nil? x) "nil")
          ((eq x t) "t")
          ((= (js* "typeof x") "object") (or (get x :kind) "object"))
          (t (js* "typeof x"))))

  ;; ------------------------------------------------------------------
  ;; Conditions, catch/throw and control transfer
  ;; ------------------------------------------------------------------

  (defconst base-condition-parents
    (js-array (js-array "eliscript-timeout" "eliscript-cancelled")
              (js-array "eliscript-cancelled" "quit")
              (js-array "eliscript-compile-error" "error")
              (js-array "eliscript-declaration-error" "eliscript-compile-error")
              (js-array "eliscript-contract-error" "eliscript-compile-error")
              (js-array "eliscript-runtime-contract-error" "error")
              (js-array "eliscript-channel-closed" "error")
              (js-array "eliscript-engine-handle-error" "error")
              (js-array "js-error" "error")
              (js-array "arith-error" "error")
              (js-array "overflow-error" "arith-error")
              (js-array "range-error" "arith-error")
              (js-array "void-function" "error")
              (js-array "void-variable" "error")
              (js-array "invalid-function" "error")
              (js-array "wrong-type-argument" "error")
              (js-array "args-out-of-range" "error")
              (js-array "wrong-number-of-arguments" "error")
              (js-array "setting-constant" "error")
              (js-array "cyclic-function-indirection" "error")
              (js-array "no-catch" "error")
              (js-array "end-of-file" "error")
              (js-array "invalid-read-syntax" "error")
              (js-array "invalid-regexp" "error")
              (js-array "search-failed" "error")
              (js-array "user-error" "error")
              (js-array "file-error" "error")
              (js-array "file-missing" "file-error")
              (js-array "json-error" "error")
              (js-array "json-parse-error" "json-error")
              (js-array "json-end-of-file" "json-parse-error")
              (js-array "json-trailing-content" "json-parse-error")
              (js-array "json-unavailable" "json-error")
              (js-array "cl-assertion-failed" "error")
              (js-array "cl-no-applicable-method" "error")
              (js-array "text-read-only" "error")
              (js-array "buffer-read-only" "error")
              (js-array "beginning-of-buffer" "error")
              (js-array "end-of-buffer" "error")
              (js-array "coding-system-error" "error")
              (js-array "ert-test-failed" "error")
              (js-array "ert-test-skipped" "error")))

  (defconst base-condition-messages
    (js-array (js-array "error" "error")
              (js-array "quit" "Quit")
              (js-array "arith-error" "Arithmetic error")
              (js-array "void-function" "Symbol's function definition is void")
              (js-array "void-variable" "Symbol's value as variable is void")
              (js-array "invalid-function" "Invalid function")
              (js-array "wrong-type-argument" "Wrong type argument")
              (js-array "args-out-of-range" "Args out of range")
              (js-array "wrong-number-of-arguments" "Wrong number of arguments")
              (js-array "setting-constant" "Attempt to set a constant symbol")
              (js-array "no-catch" "No catch for tag")
              (js-array "end-of-file" "End of file during parsing")
              (js-array "invalid-read-syntax" "Invalid read syntax")
              (js-array "search-failed" "Search failed")
              (js-array "json-parse-error" "could not parse JSON stream")
              (js-array "cl-assertion-failed" "Assertion failed")))

  (defun el-make-signal (condition data)
    ;; CONDITION is a condition name string, DATA a host array of Elisp values.
    (let ((error (new globalThis.Error
                      (str condition ": "
                           (js-call (js-call data :map (lambda (item) (el-prin1-string item false))) :join " ")))))
      (put error :eliscriptSignal t)
      (put error :conditionSymbol condition)
      (put error :data data)
      error))

  (defun el-signal (condition &rest data) (throw (el-make-signal condition data)))

  (defun el-signal-error (message) (throw (el-make-signal "error" (js-array message))))

  (defun el-compile-error (message) (throw (el-make-signal "eliscript-compile-error" (js-array message))))

  (defun el-error-from-host (error)
    ;; Normalize a host exception into an Elisp signal object.
    (cond
      ((and (not (nullish? error)) (= (el-typeof error) "object") (get error :eliscriptSignal)) error)
      (t (let ((signal (el-make-signal "error"
                                       (js-array (if (and (not (nullish? error)) (= (el-typeof error) "object"))
                                                     (str (or (get error :message) error))
                                                   (str error))))))
           (put signal :hostError error)
           signal))))

  (defun el-control-transfer? (error)
    (and (not (nullish? error)) (= (el-typeof error) "object")
         (or (get error :eliscriptThrow) (get error :eliscriptRecur)
             (get error :eliscriptBatchExit) (get error :eliscriptTimeout))))

  (defun el-condition-matches (session thrown handler)
    (cond
      ((= handler "t") t)
      (t (let ((pending (js-array thrown)) (seen (new globalThis.Set)) (found false))
           (while (and (not found) (> (js-length pending) 0))
             (let ((current (js-call pending :pop)))
               (cond
                 ((= current handler) (setq found t))
                 ((js-call seen :has current) nil)
                 (t (js-call seen :add current)
                    (let ((parents (js-call (get session :conditionParents) :get current)))
                      (unless (undefined? parents)
                        (js-call parents :forEach (lambda (parent) (js-call pending :push parent)))))))))
           found))))

  (defun el-signal-message (session signal)
    (let* ((condition (get signal :conditionSymbol))
           (data (get signal :data))
           (base (js-call (get session :conditionMessages) :get condition)))
      (cond
        ((and (or (= condition "error") (= condition "user-error"))
              (> (js-length data) 0) (el-string? (aref data 0)))
          (aref data 0))
        (t (let ((prefix (if (undefined? base) (str "peculiar error " condition) base)))
             (if (= (js-length data) 0) prefix
               (str prefix ": " (js-call (js-call data :map (lambda (item) (el-prin1-string item t))) :join ", "))))))))

  ;; ------------------------------------------------------------------
  ;; Numbers
  ;; ------------------------------------------------------------------

  (defconst float-tag "float")
  (defun el-float-box? (x) (and (not (nullish? x)) (= (get x :kind) float-tag)))
  (defun el-number? (x) (or (= (js* "typeof x") "number") (el-float-box? x)))
  (defun el-num (x)
    (cond ((= (js* "typeof x") "number") x)
          ((el-float-box? x) (get x :value))
          (t (el-signal "wrong-type-argument" (el-intern "number-or-marker-p") x))))
  (defun el-float? (x)
    (or (el-float-box? x) (and (= (js* "typeof x") "number") (not (Number/isInteger x)))))
  (defun el-integer? (x) (and (= (js* "typeof x") "number") (Number/isInteger x)))
  (defun el-make-float (n)
    (if (Number/isInteger n) (js-object :kind float-tag :value n) n))
  (defun el-int-check (x)
    (if (el-integer? x) x (el-signal "wrong-type-argument" (el-intern "integerp") x)))

  (defun el-arith-2 (name a b)
    (if (and (= (js* "typeof a") "number") (= (js* "typeof b") "number"))
        (let ((r (cond ((= name "+") (+ a b)) ((= name "-") (- a b)) (t (* a b)))))
          (if (and (or (not (Number/isInteger a)) (not (Number/isInteger b)))
                   (Number/isInteger r))
              (el-make-float r)
            r))
      (let* ((fl (or (el-float? a) (el-float? b)))
             (va (el-num a))
             (vb (el-num b))
             (r (cond ((= name "+") (+ va vb)) ((= name "-") (- va vb)) (t (* va vb)))))
        (if fl (el-make-float r) r))))

  (defun el-arith (name items)
    ;; Generic + - * with Emacs integer/float contagion.
    (let ((n (js-length items)))
      (if (= n 2)
          (el-arith-2 name (aref items 0) (aref items 1))
        (let ((any-float false) (values (js-array)) (index 0))
          (while (< index n)
            (let ((item (aref items index)))
              (when (el-float? item) (setq any-float t))
              (js-call values :push (el-num item)))
            (setq index (1+ index)))
          (let ((result (cond
                          ((= name "+") (js-call values :reduce (lambda (a b) (+ a b)) 0))
                          ((= name "*") (js-call values :reduce (lambda (a b) (* a b)) 1))
                          ((= (js-length values) 0) 0)
                          ((= (js-length values) 1) (- 0 (aref values 0)))
                          (t (js-call (js-call values :slice 1) :reduce (lambda (a b) (- a b)) (aref values 0))))))
            (if any-float (el-make-float result) result))))))

  (defun el-divide (items)
    (let ((any-float false) (values (js-array)) (index 0))
      (while (< index (js-length items))
        (let ((item (aref items index)))
          (when (el-float? item) (setq any-float t))
          (js-call values :push (el-num item)))
        (setq index (1+ index)))
      (when (= (js-length values) 1) (js-call values :unshift 1))
      (let ((acc (aref values 0)) (position 1))
        (while (< position (js-length values))
          (let ((divisor (aref values position)))
            (if any-float
                (setq acc (/ acc divisor))
              (progn
                (when (= divisor 0) (el-signal "arith-error"))
                (setq acc (Math/trunc (/ acc divisor))))))
          (setq position (1+ position)))
        (if any-float (el-make-float acc) acc))))

  (defun el-mod (a b)
    (let ((x (el-num a)) (y (el-num b)))
      (if (or (el-float? a) (el-float? b))
          (let ((r (- x (* y (Math/floor (/ x y)))))) (el-make-float r))
        (progn
          (when (= y 0) (el-signal "arith-error"))
          (let ((r (% x y)))
            (if (and (/= r 0) (/= (< r 0) (< y 0))) (+ r y) r))))))

  (defun el-rem (a b)
    (let ((x (el-int-check a)) (y (el-int-check b)))
      (when (= y 0) (el-signal "arith-error"))
      (let ((r (% x y))) (if (= r 0) 0 r))))

  (defun el-compare-chain (op items)
    (if (= (js-length items) 2)
        (let ((a (el-num (aref items 0))) (b (el-num (aref items 1))))
          (el-bool (cond ((= op "<") (< a b)) ((= op ">") (> a b)) ((= op "<=") (<= a b))
                         ((= op ">=") (>= a b)) (t (= a b)))))
      (let ((ok t) (index 0))
        (while (and ok (< index (1- (js-length items))))
          (let ((a (el-num (aref items index))) (b (el-num (aref items (1+ index)))))
            (unless (cond ((= op "<") (< a b)) ((= op ">") (> a b)) ((= op "<=") (<= a b))
                          ((= op ">=") (>= a b)) (t (= a b)))
              (setq ok false)))
          (setq index (1+ index)))
        (el-bool ok))))

  (defun el-round-half-even (x)
    (let ((f (Math/floor x)) (d (- x (Math/floor x))))
      (cond ((< d 0.5) f) ((> d 0.5) (+ f 1)) ((= (el-mod-int f 2) 0) f) (t (+ f 1)))))
  (defun el-mod-int (a b) (let ((r (% a b))) (if (and (/= r 0) (/= (< r 0) (< b 0))) (+ r b) r)))

  (defun el-rounding (kind x divisor)
    (let* ((value (if (nullish? divisor) (el-num x)
                    (progn
                      (when (and (= (el-num divisor) 0) (not (el-float? x)) (not (el-float? divisor)))
                        (el-signal "arith-error"))
                      (/ (el-num x) (el-num divisor))))))
      (when (not (Number/isFinite value)) (el-signal "overflow-error" x))
      (cond ((= kind "floor") (Math/floor value))
            ((= kind "ceiling") (Math/ceil value))
            ((= kind "truncate") (Math/trunc value))
            (t (el-round-half-even value)))))

  ;; Bit operations on integers beyond 32 bits use exact high/low splitting.
  (defconst two-32 4294967296)
  (defun el-split-high (x) (Math/floor (/ x two-32)))
  (defun el-split-low (x) (- x (* (Math/floor (/ x two-32)) two-32)))
  (defun el-bitwise (op a b)
    (let* ((ha (int32 (el-split-high a))) (la (uint32 (el-split-low a)))
           (hb (int32 (el-split-high b))) (lb (uint32 (el-split-low b)))
           (high (cond ((= op "and") (bit-and ha hb)) ((= op "or") (bit-or ha hb)) (t (bit-xor ha hb))))
           (low (cond ((= op "and") (bit-and la lb)) ((= op "or") (bit-or la lb)) (t (bit-xor la lb)))))
      (+ (* high two-32) (uint32 low))))
  (defun el-ash (value count)
    (let ((v (el-int-check value)) (c (el-int-check count)))
      (cond ((>= c 0) (* v (Math/pow 2 (Math/min c 1023))))
            (t (Math/floor (/ v (Math/pow 2 (Math/min (- 0 c) 1100))))))))

  ;; ------------------------------------------------------------------
  ;; Strings and characters (Emacs character positions = code points)
  ;; ------------------------------------------------------------------

  (defconst surrogate-pattern (new globalThis.RegExp "[\\uD800-\\uDFFF]"))
  (defconst beyond-unicode-char 65535)
  (defconst astral-cache (new globalThis.Map))
  (defconst ascii-cache (new globalThis.Map))

  (defun el-astral? (s)
    (let ((n (js-length s)))
      (cond
        ((= n 0) false)
        ((= n 1) (let ((c (js-call s :charCodeAt 0))) (and (>= c 55296) (<= c 57343))))
        ((< n 64)
          (let ((i 0) (found false))
            (while (and (not found) (< i n))
              (let ((c (js-call s :charCodeAt i)))
                (if (and (>= c 55296) (<= c 57343))
                    (setq found t)
                  (setq i (1+ i)))))
            found))
        (t (let ((cached (js-call astral-cache :get s)))
             (if (not (undefined? cached))
                 (not (eq cached false))
               (let ((res (if (js-call surrogate-pattern :test s) (js-length (Array/from s)) false)))
                 (when (> (get astral-cache :size) 4096) (js-call astral-cache :clear))
                 (js-call astral-cache :set s res)
                 (not (eq res false)))))))))
  (defun el-chars (s) (Array/from s))
  (defun el-string-length (s)
    (let ((n (js-length s)))
      (cond
        ((<= n 1) n)
        ((< n 64) (if (el-astral? s) (js-length (Array/from s)) n))
        (t (let ((cached (js-call astral-cache :get s)))
             (if (not (undefined? cached))
                 (if (eq cached false) n cached)
               (let ((res (if (js-call surrogate-pattern :test s) (js-length (Array/from s)) false)))
                 (when (> (get astral-cache :size) 4096) (js-call astral-cache :clear))
                 (js-call astral-cache :set s res)
                 (if (eq res false) n res))))))))
  (defun el-char-string (code)
    (cond ((or (< code 0) (not (Number/isInteger code))) (el-signal "wrong-type-argument" (el-intern "characterp") code))
          ((> code 1114111) (String/fromCodePoint beyond-unicode-char))
          ((and (>= code 55296) (<= code 57343)) (String/fromCharCode code))
          (t (String/fromCodePoint code))))
  (defun el-string-from-codes (codes)
    (js-call (js-call codes :map (lambda (code) (el-char-string code))) :join ""))
  (defun el-string-codes (s)
    (js-call (Array/from s) :map (lambda (ch) (js-call ch :codePointAt 0))))
  (defun el-string-ref (s index)
    (if (el-astral? s)
        (let ((chars (Array/from s)))
          (when (or (< index 0) (>= index (js-length chars))) (el-signal "args-out-of-range" s index))
          (js-call (aref chars index) :codePointAt 0))
      (progn
        (when (or (< index 0) (>= index (js-length s))) (el-signal "args-out-of-range" s index))
        (js-call s :charCodeAt index))))
  (defun el-char-to-unit (s index)
    (if (el-astral? s)
        (let ((chars (Array/from s)) (units 0) (position 0))
          (while (and (< position index) (< position (js-length chars)))
            (setq units (+ units (js-length (aref chars position))))
            (setq position (1+ position)))
          units)
      index))
  (defun el-unit-to-char (s unit)
    (if (el-astral? s) (js-length (Array/from (js-call s :slice 0 unit))) unit))
  (defconst unibyte-strings (new globalThis.Set))
  (defun el-mark-unibyte (s)
    (when (el-string? s)
      (let ((index 0) (n (js-length s)) (high false) (multi false))
        (while (and (not multi) (< index n))
          (let ((code (js-call s :charCodeAt index)))
            (when (> code 255) (setq multi t))
            (when (and (>= code 128) (<= code 255)) (setq high t)))
          (setq index (1+ index)))
        (when (and high (not multi)) (js-call unibyte-strings :add s))))
    s)
  (defun el-substring (s from to)
    (let* ((astral (el-astral? s))
           (length (if astral (el-string-length s) (js-length s)))
           (start (if (nullish? from) 0 (el-num from)))
           (end (if (nullish? to) length (el-num to))))
      (when (< start 0) (setq start (+ length start)))
      (when (< end 0) (setq end (+ length end)))
      (when (or (< start 0) (> end length) (> start end)) (el-signal "args-out-of-range" s from to))
      (let ((sub (if astral
                     (js-call (js-call (Array/from s) :slice start end) :join "")
                   (js-call s :slice start end))))
        (if (and (> (get unibyte-strings :size) 0) (js-call unibyte-strings :has s))
            (el-mark-unibyte sub)
          sub))))
  (defun el-string-set (s index code)
    (let ((chars (Array/from s)))
      (when (or (< index 0) (>= index (js-length chars))) (el-signal "args-out-of-range" s index))
      (put chars index (el-char-string code))
      (js-call chars :join "")))

  ;; UTF-8: a unibyte string holds one byte per character (0-255).
  (defun el-utf8-bytes (s)
    (let ((bytes (js-array)))
      (js-call (Array/from s) :forEach
               (lambda (ch)
                 (let ((code (js-call ch :codePointAt 0)))
                   (cond
                     ((< code 128) (js-call bytes :push code))
                     ((< code 2048)
                       (js-call bytes :push (bit-or 192 (unsigned-bit-shift-right code 6)))
                       (js-call bytes :push (bit-or 128 (bit-and code 63))))
                     ((< code 65536)
                       (js-call bytes :push (bit-or 224 (unsigned-bit-shift-right code 12)))
                       (js-call bytes :push (bit-or 128 (bit-and (unsigned-bit-shift-right code 6) 63)))
                       (js-call bytes :push (bit-or 128 (bit-and code 63))))
                     (t
                       (js-call bytes :push (bit-or 240 (unsigned-bit-shift-right code 18)))
                       (js-call bytes :push (bit-or 128 (bit-and (unsigned-bit-shift-right code 12) 63)))
                       (js-call bytes :push (bit-or 128 (bit-and (unsigned-bit-shift-right code 6) 63)))
                       (js-call bytes :push (bit-or 128 (bit-and code 63))))))))
      bytes))
  (defun el-bytes-string (bytes)
    (let ((parts (js-array)) (index 0) (high false))
      (while (< index (js-length bytes))
        (let ((b (bit-and (aref bytes index) 255)))
          (when (>= b 128) (setq high t))
          (js-call parts :push (String/fromCharCode b)))
        (setq index (1+ index)))
      (let ((s (js-call parts :join "")))
        (when high (js-call unibyte-strings :add s))
        s)))
  (defconst non-ascii-pattern (new globalThis.RegExp "[^\\x00-\\x7F]"))
  (defun el-ascii? (s)
    (let ((n (js-length s)))
      (cond
        ((= n 0) t)
        ((= n 1) (< (js-call s :charCodeAt 0) 128))
        ((< n 64)
          (let ((i 0) (ok t))
            (while (and ok (< i n))
              (if (< (js-call s :charCodeAt i) 128)
                  (setq i (1+ i))
                (setq ok false)))
            ok))
        (t (let ((cached (js-call ascii-cache :get s)))
             (if (not (undefined? cached))
                 cached
               (let ((res (not (js-call non-ascii-pattern :test s))))
                 (when (> (get ascii-cache :size) 4096) (js-call ascii-cache :clear))
                 (js-call ascii-cache :set s res)
                 res)))))))
  (defun el-string-bytes-array (s)
    ;; Bytes of S: unibyte strings are bytes already, multibyte strings use UTF-8.
    (if (el-multibyte? s) (el-utf8-bytes s) (el-string-codes s)))
  (defun el-multibyte? (s)
    (if (or (el-ascii? s) (js-call unibyte-strings :has s))
        false
      (let ((multi false) (index 0) (n (js-length s)))
        (while (and (not multi) (< index n))
          (when (> (js-call s :charCodeAt index) 255) (setq multi t))
          (setq index (1+ index)))
        multi)))
  (defun el-encode-utf8 (s)
    (if (or (el-ascii? s) (and (not (el-multibyte? s)) (js-call unibyte-strings :has s)))
        s
      (el-bytes-string (el-utf8-bytes s))))
  (defun el-decode-utf8 (s)
    (if (or (el-ascii? s) (el-multibyte? s))
        s
      (let ((bytes (el-string-codes s)) (codes (js-array)) (index 0) (n 0))
        (setq n (js-length bytes))
        (while (< index n)
          (let ((b (aref bytes index)))
            (cond
              ((< b 128) (js-call codes :push b) (setq index (1+ index)))
              ((and (>= b 194) (< b 224) (< (1+ index) n) (= (bit-and (aref bytes (1+ index)) 192) 128))
                (js-call codes :push (bit-or (bit-shift-left (bit-and b 31) 6) (bit-and (aref bytes (1+ index)) 63)))
                (setq index (+ index 2)))
              ((and (>= b 224) (< b 240) (< (+ index 2) n)
                    (= (bit-and (aref bytes (1+ index)) 192) 128) (= (bit-and (aref bytes (+ index 2)) 192) 128))
                (js-call codes :push (+ (* (bit-and b 15) 4096)
                                        (* (bit-and (aref bytes (1+ index)) 63) 64)
                                        (bit-and (aref bytes (+ index 2)) 63)))
                (setq index (+ index 3)))
              ((and (>= b 240) (< b 245) (< (+ index 3) n)
                    (= (bit-and (aref bytes (1+ index)) 192) 128) (= (bit-and (aref bytes (+ index 2)) 192) 128)
                    (= (bit-and (aref bytes (+ index 3)) 192) 128))
                (js-call codes :push (+ (* (bit-and b 7) 262144)
                                        (* (bit-and (aref bytes (1+ index)) 63) 4096)
                                        (* (bit-and (aref bytes (+ index 2)) 63) 64)
                                        (bit-and (aref bytes (+ index 3)) 63)))
                (setq index (+ index 4)))
              (t (js-call codes :push 65533) (setq index (1+ index))))))
        (el-string-from-codes codes))))

  ;; East Asian Wide/Fullwidth characters occupy two columns; combining marks none.
  (defconst wide-ranges
    (js-array 4352 4447 8986 8987 9001 9002 9193 9196 9200 9200 9203 9203 9725 9726 9748 9749
              9800 9811 9855 9855 9875 9875 9889 9889 9898 9899 9917 9918 9924 9925 9934 9934
              9940 9940 9962 9962 9970 9971 9973 9973 9978 9978 9981 9981 9989 9989 9994 9995
              10024 10024 10060 10060 10062 10062 10067 10069 10071 10071 10133 10135 10160 10160
              10175 10175 11035 11036 11088 11088 11093 11093 11904 12350 12353 13311 13312 19903
              19968 42191 43360 43391 44032 55203 63744 64255 65040 65049 65072 65135 65280 65376
              65504 65510 94176 101640 110592 110959 126980 126980 127183 127183 127374 127374
              127377 127386 127488 127569 127584 127589 127744 128591 128640 128767 129280 129535
              129648 129791 131072 196605 196608 262141))
  (defconst zero-width-ranges
    (js-array 768 879 1155 1161 1425 1469 1471 1471 1473 1474 1476 1477 1479 1479 1552 1562
              1611 1631 1648 1648 1750 1756 1759 1764 1767 1768 1770 1773 2304 2306 6832 6911
              7616 7679 8203 8207 8288 8292 8400 8432 65024 65039 65056 65071 917760 917999))
  (defun el-in-ranges (code ranges)
    (let ((found false) (index 0))
      (while (and (not found) (< index (js-length ranges)))
        (when (and (>= code (aref ranges index)) (<= code (aref ranges (1+ index)))) (setq found t))
        (setq index (+ index 2)))
      found))
  (defun el-char-width (code)
    (cond ((= code 9) 8)
          ((< code 32) 2)
          ((= code 127) 2)
          ((< code 768) 1)
          ((el-in-ranges code zero-width-ranges) 0)
          ((el-in-ranges code wide-ranges) 2)
          (t 1)))
  (defun el-string-width (s)
    (let ((width 0))
      (js-call (Array/from s) :forEach
               (lambda (ch) (setq width (+ width (el-char-width (js-call ch :codePointAt 0))))))
      width))

  (defun el-upcase (x) (if (el-string? x) (js-call x :toUpperCase)
                         (js-call (js-call (el-char-string x) :toUpperCase) :codePointAt 0)))
  (defun el-downcase (x) (if (el-string? x) (js-call x :toLowerCase)
                           (js-call (js-call (el-char-string x) :toLowerCase) :codePointAt 0)))

  ;; ------------------------------------------------------------------
  ;; Number printing (Emacs float_to_string with dtoastr precision search)
  ;; ------------------------------------------------------------------

  (defun el-pad-exponent (text)
    ;; "1.5e-7" -> "1.5e-07", "1e+21" -> "1e+21"
    (let ((at (js-call text :indexOf "e")))
      (if (< at 0) text
        (let* ((mantissa (js-call text :slice 0 at))
               (rest (js-call text :slice (1+ at)))
               (sign (if (or (js-call rest :startsWith "-") (js-call rest :startsWith "+")) (js-call rest :slice 0 1) "+"))
               (digits (if (or (js-call rest :startsWith "-") (js-call rest :startsWith "+")) (js-call rest :slice 1) rest)))
          (str mantissa "e" sign (if (< (js-length digits) 2) (str "0" digits) digits))))))

  (defun el-strip-fraction-zeros (text)
    (if (< (js-call text :indexOf ".") 0) text
      (let ((stripped (js-call (js-call text :replace (new globalThis.RegExp "0+$") "") :replace (new globalThis.RegExp "\\.$") "")))
        stripped)))

  (defun el-format-g (x precision alternate)
    ;; C printf %.Pg
    (let* ((p (if (= precision 0) 1 precision))
           (exp-text (js-call x :toExponential (1- p)))
           (exponent (Number/parseInt (js-call exp-text :slice (1+ (js-call exp-text :indexOf "e"))) 10)))
      (if (and (>= exponent -4) (< exponent p))
          (let ((fixed (js-call x :toFixed (Math/max 0 (- p 1 exponent)))))
            (if alternate fixed (el-strip-fraction-zeros fixed)))
        (let* ((mantissa (js-call exp-text :slice 0 (js-call exp-text :indexOf "e")))
               (clean (if alternate mantissa (el-strip-fraction-zeros mantissa))))
          (el-pad-exponent (str clean "e" (if (< exponent 0) "-" "+") (Math/abs exponent)))))))

  (defun el-float-string (x)
    (cond
      ((Number/isNaN x) "0.0e+NaN")
      ((= x globalThis.Infinity) "1.0e+INF")
      ((= x (- 0 globalThis.Infinity)) "-1.0e+INF")
      ((and (= x 0) (< (/ 1 x) 0)) "-0.0")
      (t (let ((precision 15) (text nil))
           (while (nil? text)
             (let ((candidate (el-format-g x precision false)))
               (when (or (>= precision 17) (= (Number/parseFloat candidate) x))
                 (setq text candidate)))
             (setq precision (1+ precision)))
           (if (or (>= (js-call text :indexOf ".") 0) (>= (js-call text :indexOf "e") 0))
               text
             (str text ".0"))))))

  (defun el-integer-string (n)
    (if (<= (Math/abs n) 9007199254740991) (str n)
      (js-call (funcall globalThis.BigInt n) :toString)))

  (defun el-number-string (x)
    (if (el-float? x) (el-float-string (el-num x)) (el-integer-string x)))

  ;; ------------------------------------------------------------------
  ;; Printer (prin1 / princ)
  ;; ------------------------------------------------------------------

  (defconst symbol-escape-pattern (new globalThis.RegExp "[\\s()\\[\\]\"';`,#?\\\\.]" "u"))
  (defconst numeric-token-pattern
    (new globalThis.RegExp "^[+-]?(?:[0-9]+\\.?[0-9]*(?:e[+-]?[0-9]+)?|\\.[0-9]+(?:e[+-]?[0-9]+)?)$"))

  (defun el-print-symbol-name (name)
    (cond
      ((= name "") "##")
      (t (let ((out (js-array)) (chars (Array/from name)) (index 0))
           (while (< index (js-length chars))
             (let ((ch (aref chars index)))
               (when (or (and (js-call symbol-escape-pattern :test ch)
                              (not (and (= ch ".") (> index 0)))
                              (not (and (= ch "?") (> index 0)))
                              (not (and (= ch "#") (> index 0))))
                         (and (= index 0) (= ch "?")))
                 (js-call out :push "\\"))
               (js-call out :push ch))
             (setq index (1+ index)))
           (let ((text (js-call out :join "")))
             (if (js-call numeric-token-pattern :test name) (str "\\" text) text))))))

  (defun el-print-string-literal (s)
    (str "\"" (js-call (js-call s :replace (new globalThis.RegExp "\\\\" "g") "\\\\")
                       :replace (new globalThis.RegExp "\"" "g") "\\\"")
         "\""))

  (defun el-prin1-string (value escape)
    (let ((out (js-array)))
      (el-print-into out value (if escape t false) 0)
      (js-call out :join "")))

  (defun el-print-into (out value escape depth)
    (when (> depth 2000) (el-signal "error" "Apparently circular structure being printed"))
    (cond
      ((nil? value) (js-call out :push "nil"))
      ((eq value t) (js-call out :push "t"))
      ((undefined? value) (js-call out :push "nil"))
      ((= (el-typeof value) "number") (js-call out :push (el-number-string value)))
      ((= (el-typeof value) "string") (js-call out :push (if escape (el-print-string-literal value) value)))
      ((= (el-typeof value) "function")
        (js-call out :push (if (get value :elispName) (str "#<subr " (get value :elispName) ">") "#<subr lambda>")))
      ((= (el-typeof value) "boolean") (js-call out :push (if value "t" "nil")))
      (t
        (let ((kind (get value :kind)))
          (cond
            ((= kind float-tag) (js-call out :push (el-float-string (get value :value))))
            ((or (= kind "symbol") (= kind "keyword"))
              (js-call out :push (if escape (el-print-symbol-name (get value :name)) (get value :name))))
            ((= kind "cons") (el-print-list out value escape depth))
            ((= kind "vector") (el-print-items out "[" (get value :items) "]" escape depth))
            ((= kind "record") (el-print-items out "#s(" (get value :items) ")" escape depth))
            ((= kind "hash-table") (el-print-hash-table out value escape depth))
            ((= kind "buffer")
              (js-call out :push (if (get value :live) (str "#<buffer " (get value :name) ">") "#<killed buffer>")))
            ((= kind "marker") (js-call out :push "#<marker>"))
            ((= kind "timer") (js-call out :push "#<timer>"))
            ((= kind "js-sentinel") (js-call out :push (str "js-" (get value :sentinel))))
            (t (el-print-extension out value escape depth)))))))

  (defun el-print-items (out open items close escape depth)
    (js-call out :push open)
    (let ((index 0))
      (while (< index (js-length items))
        (when (> index 0) (js-call out :push " "))
        (el-print-into out (aref items index) escape (1+ depth))
        (setq index (1+ index))))
    (js-call out :push close))

  (defun el-print-list (out value escape depth)
    (let ((head (get value :car)) (tail (get value :cdr)))
      (if (and (el-cons? tail) (nil? (get tail :cdr))
               (or (eq head s-quote) (eq head s-function) (eq head s-backquote)
                   (eq head s-comma) (eq head s-comma-at)))
          (progn
            (js-call out :push (cond ((eq head s-quote) "'") ((eq head s-function) "#'")
                                     ((eq head s-backquote) "`") ((eq head s-comma) ",") (t ",@")))
            (el-print-into out (get tail :car) escape (1+ depth)))
        (progn
          (js-call out :push "(")
          (let ((cursor value) (first t) (count 0))
            (while (el-cons? cursor)
              (unless first (js-call out :push " "))
              (setq first false)
              (el-print-into out (get cursor :car) escape (1+ depth))
              (setq cursor (get cursor :cdr))
              (setq count (1+ count))
              (when (> count 1000000) (el-signal "error" "Apparently circular list being printed")))
            (unless (nil? cursor)
              (js-call out :push " . ")
              (el-print-into out cursor escape (1+ depth))))
          (js-call out :push ")")))))

  (defun el-print-hash-table (out table escape depth)
    (js-call out :push "#s(hash-table")
    (unless (= (get table :test) "eql") (js-call out :push (str " test " (get table :test))))
    (when (> (get (get table :entries) :size) 0)
      (js-call out :push " data (")
      (let ((first t))
        (js-call (get table :entries) :forEach
                 (lambda (entry)
                   (unless first (js-call out :push " "))
                   (setq first false)
                   (el-print-into out (aref entry 0) escape (1+ depth))
                   (js-call out :push " ")
                   (el-print-into out (aref entry 1) escape (1+ depth)))))
      (js-call out :push ")"))
    (js-call out :push ")"))

  ;; ------------------------------------------------------------------
  ;; Reader (Emacs Lisp syntax)
  ;; ------------------------------------------------------------------

  (defconst delimiter-pattern (new globalThis.RegExp "[\\s()\\[\\]\";'`,]" "u"))
  (defconst integer-token (new globalThis.RegExp "^[+-]?[0-9]+\\.?$"))
  (defconst float-token
    (new globalThis.RegExp "^[+-]?(?:[0-9]+\\.[0-9]+|[0-9]*\\.[0-9]+|[0-9]+)(?:e[+-]?[0-9]+)?$"))
  (defconst special-float-token (new globalThis.RegExp "^([+-]?[0-9.]+)e\\+(INF|NaN)$"))

  (defconst whitespace-char (new globalThis.RegExp "\\s" "u"))
  (defconst hex-digit-char (new globalThis.RegExp "^[0-9a-fA-F]$"))
  (defconst octal-digit-char (new globalThis.RegExp "^[0-7]$"))

  (defun el-read-error (message) (throw (el-make-signal "invalid-read-syntax" (js-array message))))

  (defun el-reader (source)
    (js-object :source source :pos 0 :length (js-length source)))

  (defun el-reader-peek (reader)
    (if (>= (get reader :pos) (get reader :length)) nil
      (String/fromCodePoint (js-call (get reader :source) :codePointAt (get reader :pos)))))

  (defun el-reader-next (reader)
    (let ((ch (el-reader-peek reader)))
      (unless (nil? ch) (put reader :pos (+ (get reader :pos) (js-length ch))))
      ch))

  (defun el-skip-blank (reader)
    (let ((done false))
      (while (not done)
        (let ((ch (el-reader-peek reader)))
          (cond
            ((nil? ch) (setq done t))
            ((js-call whitespace-char :test ch) (el-reader-next reader))
            ((or (= ch ";")
                 (and (= ch "#") (= (js-call (get reader :source) :charAt (1+ (get reader :pos))) "!")))
              (while (and (not (nil? (el-reader-peek reader))) (/= (el-reader-peek reader) "\n"))
                (el-reader-next reader)))
            (t (setq done t)))))))

  (defun el-hex-value (text) (Number/parseInt text 16))

  (defun el-read-escape (reader in-string)
    ;; After a backslash.  Return a code point, or -1 for an ignored escape.
    (let ((ch (el-reader-next reader)))
      (cond
        ((nil? ch) (throw (el-make-signal "end-of-file" (js-array))))
        ((= ch "a") 7) ((= ch "b") 8) ((= ch "t") 9) ((= ch "n") 10) ((= ch "v") 11)
        ((= ch "f") 12) ((= ch "r") 13) ((= ch "e") 27) ((= ch "d") 127)
        ((= ch "s") (if (= (el-reader-peek reader) "-")
                        (progn (el-reader-next reader) (bit-or (el-read-char-body reader) 8388608))
                      32))
        ((and in-string (or (= ch "\n") (= ch " "))) -1)
        ((= ch "x")
          (let ((digits ""))
            (while (and (not (nil? (el-reader-peek reader)))
                        (js-call hex-digit-char :test (el-reader-peek reader)))
              (setq digits (str digits (el-reader-next reader))))
            (when (and in-string (= (el-reader-peek reader) "\\")
                       (= (js-call (get reader :source) :charAt (1+ (get reader :pos))) " "))
              (put reader :pos (+ (get reader :pos) 2)))
            (if (= digits "") 0 (el-hex-value digits))))
        ((or (= ch "u") (= ch "U"))
          (let ((count (if (= ch "u") 4 8)) (digits "") (index 0))
            (while (< index count)
              (setq digits (str digits (el-reader-next reader)))
              (setq index (1+ index)))
            (el-hex-value digits)))
        ((= ch "N")
          (el-reader-next reader)
          (let ((name ""))
            (while (and (not (nil? (el-reader-peek reader))) (/= (el-reader-peek reader) "}"))
              (setq name (str name (el-reader-next reader))))
            (el-reader-next reader)
            (if (js-call name :startsWith "U+") (el-hex-value (js-call name :slice 2)) 65533)))
        ((js-call octal-digit-char :test ch)
          (let ((digits ch))
            (while (and (< (js-length digits) 3) (not (nil? (el-reader-peek reader)))
                        (js-call octal-digit-char :test (el-reader-peek reader)))
              (setq digits (str digits (el-reader-next reader))))
            (Number/parseInt digits 8)))
        ((and (= ch "C") (= (el-reader-peek reader) "-"))
          (el-reader-next reader)
          (el-control-char (el-read-char-body reader)))
        ((= ch "^") (el-control-char (el-read-char-body reader)))
        ((and (= ch "M") (= (el-reader-peek reader) "-"))
          (el-reader-next reader)
          (bit-or (el-read-char-body reader) 134217728))
        ((and (or (= ch "S") (= ch "H") (= ch "A")) (= (el-reader-peek reader) "-"))
          (el-reader-next reader)
          (el-read-char-body reader))
        (t (js-call ch :codePointAt 0)))))

  (defun el-control-char (code)
    (cond ((= code 63) 127)
          ((and (>= code 97) (<= code 122)) (- code 96))
          ((and (>= code 64) (<= code 95)) (- code 64))
          (t (bit-or code 67108864))))

  (defun el-read-char-body (reader)
    (let ((ch (el-reader-next reader)))
      (cond ((nil? ch) (throw (el-make-signal "end-of-file" (js-array))))
            ((= ch "\\") (el-read-escape reader false))
            (t (js-call ch :codePointAt 0)))))

  (defun el-read-string (reader)
    (let ((parts (js-array)) (done false))
      (while (not done)
        (let ((ch (el-reader-next reader)))
          (cond
            ((nil? ch) (throw (el-make-signal "end-of-file" (js-array))))
            ((= ch "\"") (setq done t))
            ((= ch "\\")
              (let ((code (el-read-escape reader t)))
                (when (>= code 0)
                  (js-call parts :push (el-char-string (if (> code 4194303) (bit-and code 4194303) code))))))
            (t (js-call parts :push ch)))))
      (js-call parts :join "")))

  (defun el-read-token (reader)
    ;; Return {text, escaped}
    (let ((text "") (escaped false) (done false))
      (while (not done)
        (let ((ch (el-reader-peek reader)))
          (cond
            ((nil? ch) (setq done t))
            ((= ch "\\")
              (el-reader-next reader)
              (setq escaped t)
              (let ((next (el-reader-next reader)))
                (unless (nil? next) (setq text (str text next)))))
            ((js-call delimiter-pattern :test ch) (setq done t))
            (t (setq text (str text (el-reader-next reader)))))))
      (js-object :text text :escaped escaped)))

  (defun el-parse-atom (token)
    (let ((text (get token :text)))
      (cond
        ((get token :escaped) (el-intern text))
        ((js-call integer-token :test text)
          (Number/parseInt (js-call text :replace "." "") 10))
        ((js-call float-token :test text)
          (el-make-float (Number/parseFloat text)))
        ((js-call special-float-token :test text)
          (let ((match (js-call special-float-token :exec text)))
            (if (= (aref match 2) "NaN") globalThis.NaN
              (if (js-call (aref match 1) :startsWith "-") (- 0 globalThis.Infinity) globalThis.Infinity))))
        (t (el-intern text)))))

  (defun el-read-radix (reader radix)
    (let ((token (get (el-read-token reader) :text)))
      (let ((value (Number/parseInt token radix)))
        (when (Number/isNaN value) (el-read-error (str "integer, radix " radix)))
        value)))

  (defun el-read-sequence (reader close)
    ;; Read forms up to CLOSE; return {items, tail}
    (let ((items (js-array)) (tail nil) (done false))
      (while (not done)
        (el-skip-blank reader)
        (let ((ch (el-reader-peek reader)))
          (cond
            ((nil? ch) (throw (el-make-signal "end-of-file" (js-array))))
            ((= ch close) (el-reader-next reader) (setq done t))
            ((and (= close ")") (= ch ".")
                  (let ((after (js-call (get reader :source) :charAt (1+ (get reader :pos)))))
                    (or (= after "") (js-call delimiter-pattern :test after))))
              (el-reader-next reader)
              (setq tail (el-read-form reader))
              (el-skip-blank reader)
              (unless (= (el-reader-next reader) ")") (el-read-error ". in wrong context"))
              (setq done t))
            (t (js-call items :push (el-read-form reader))))))
      (js-object :items items :tail tail)))

  (defun el-read-form (reader)
    (el-skip-blank reader)
    (let ((ch (el-reader-next reader)))
      (cond
        ((nil? ch) (throw (el-make-signal "end-of-file" (js-array))))
        ((= ch "(")
          (let ((parts (el-read-sequence reader ")")))
            (el-list-from (get parts :items) (get parts :tail))))
        ((= ch "[") (el-vector (get (el-read-sequence reader "]") :items)))
        ((or (= ch ")") (= ch "]")) (el-read-error ch))
        ((= ch "\"") (el-read-string reader))
        ((= ch "?") (el-read-char-body reader))
        ((= ch "'") (el-list s-quote (el-read-form reader)))
        ((= ch "`") (el-list s-backquote (el-read-form reader)))
        ((= ch ",")
          (if (= (el-reader-peek reader) "@")
              (progn (el-reader-next reader) (el-list s-comma-at (el-read-form reader)))
            (el-list s-comma (el-read-form reader))))
        ((= ch "#") (el-read-dispatch reader))
        (t
          (put reader :pos (- (get reader :pos) (js-length ch)))
          (el-parse-atom (el-read-token reader))))))

  (defun el-read-dispatch (reader)
    (let ((ch (el-reader-peek reader)))
      (cond
        ((= ch "'") (el-reader-next reader) (el-list s-function (el-read-form reader)))
        ((or (= ch "x") (= ch "X")) (el-reader-next reader) (el-read-radix reader 16))
        ((or (= ch "o") (= ch "O")) (el-reader-next reader) (el-read-radix reader 8))
        ((or (= ch "b") (= ch "B")) (el-reader-next reader) (el-read-radix reader 2))
        ((= ch "#") (el-reader-next reader) (el-intern ""))
        ((= ch ":") (el-reader-next reader) (el-make-symbol (get (el-read-token reader) :text)))
        ((= ch "s")
          (el-reader-next reader)
          (unless (= (el-reader-next reader) "(") (el-read-error "#s"))
          (let ((items (get (el-read-sequence reader ")") :items)))
            (if (and (> (js-length items) 0) (el-sym-is (aref items 0) "hash-table"))
                (el-hash-table-literal items)
              (js-object :kind "record" :items items))))
        ((= ch "&")
          (el-reader-next reader)
          (el-read-token reader)
          (el-read-string reader))
        ((js-call (new globalThis.RegExp "^[0-9]$") :test ch)
          (let ((digits ""))
            (while (js-call (new globalThis.RegExp "^[0-9]$") :test (or (el-reader-peek reader) ""))
              (setq digits (str digits (el-reader-next reader))))
            (let ((marker (el-reader-next reader)))
              (cond
                ((or (= marker "r") (= marker "R")) (el-read-radix reader (Number/parseInt digits 10)))
                ((= marker "=") (el-read-form reader))
                ((= marker "#") nil)
                (t (el-read-error (str "#" digits marker)))))))
        ((= ch "@")
          (el-reader-next reader)
          (let ((count (get (el-read-token reader) :text)))
            (put reader :pos (+ (get reader :pos) 1 (Number/parseInt count 10))))
          (el-read-form reader))
        ((= ch "[") (el-read-error "#[ byte-code objects are not supported"))
        (t (el-read-error (str "#" ch))))))

  (defun el-read-all (source)
    (let ((reader (el-reader source)) (forms (js-array)) (done false))
      (while (not done)
        (el-skip-blank reader)
        (if (>= (get reader :pos) (get reader :length))
            (setq done t)
          (js-call forms :push (el-read-form reader))))
      forms))

  (defun el-read-from-string (source start)
    (let ((reader (el-reader source)))
      (put reader :pos (el-char-to-unit source (if (nullish? start) 0 start)))
      (let ((form (el-read-form reader)))
        (el-cons form (el-unit-to-char source (get reader :pos))))))

  ;; ------------------------------------------------------------------
  ;; Equality
  ;; ------------------------------------------------------------------

  (defun el-eq (a b)
    (cond ((eq a b) t)
          ((and (= (js* "typeof a") "number") (= (js* "typeof b") "number")) (el-bool (= a b)))
          (t nil)))

  (defun el-eql (a b)
    (cond ((eq a b) t)
          ((and (el-number? a) (el-number? b))
            (el-bool (and (eq (el-float? a) (el-float? b)) (Object/is (el-num a) (el-num b)))))
          (t nil)))

  (defun el-equal (a b)
    (el-bool (el-equal-p a b 0)))

  (defun el-equal-p (a b depth)
    (cond
      ((eq a b) t)
      ((> depth 100000) false)
      ((or (nil? a) (nil? b)) false)
      ((and (el-number? a) (el-number? b)) (and (eq (el-float? a) (el-float? b)) (= (el-num a) (el-num b))))
      ((or (not (= (js* "typeof a") "object")) (not (= (js* "typeof b") "object"))) false)
      (t
        (let ((kind (get a :kind)))
          (cond
            ((not (= kind (get b :kind)))
              (and (el-persistent? a) (el-persistent? b) (el-value-equal a b)))
            ((= kind "cons")
              (let ((x a) (y b) (same t))
                (while (and same (el-cons? x) (el-cons? y))
                  (unless (el-equal-p (get x :car) (get y :car) (1+ depth)) (setq same false))
                  (setq x (get x :cdr))
                  (setq y (get y :cdr)))
                (and same (el-equal-p x y (1+ depth)))))
            ((or (= kind "vector") (= kind "record"))
              (let ((xs (get a :items)) (ys (get b :items)))
                (and (= (js-length xs) (js-length ys))
                     (js-call xs :every (lambda (item index) (el-equal-p item (aref ys index) (1+ depth)))))))
            ((or (= kind "symbol") (= kind "keyword") (= kind "hash-table") (= kind "buffer")) false)
            (t (el-value-equal a b)))))))

  ;; ------------------------------------------------------------------
  ;; Hash tables
  ;; ------------------------------------------------------------------

  (defun el-make-hash-table (test)
    (js-object :kind "hash-table" :test test :entries (new globalThis.Map)))

  (defun el-hash-key (table key)
    (let ((test (get table :test)))
      (cond
        ((nil? key) "n:")
        ((eq key t) "t:")
        ((= (js* "typeof key") "number") key)
        ((el-float-box? key) (str "f:" (get key :value)))
        ((= (js* "typeof key") "string") (if (= test "eq") (str "s:" key) (str "s:" key)))
        ((= test "equal")
          (let ((kind (get key :kind)))
            (if (or (= kind "cons") (= kind "vector") (= kind "record"))
                (str "c:" (el-prin1-string key t))
              (if (or (= kind "symbol") (= kind "keyword") (= kind "hash-table") (= kind "buffer")
                      (= (js* "typeof key") "function"))
                  key
                (el-value-hash-key key)))))
        (t key))))

  (defun el-gethash (key table default)
    (let ((entry (js-call (get table :entries) :get
                          (if (= (get table :test) "eq") key (el-hash-key table key)))))
      (if (undefined? entry) (if (nullish? default) nil default) (aref entry 1))))

  (defun el-puthash (key value table)
    (let* ((hash-key (if (= (get table :test) "eq") key (el-hash-key table key)))
           (entry (js-call (get table :entries) :get hash-key)))
      (if (undefined? entry)
          (js-call (get table :entries) :set hash-key (js-array key value))
        (put entry 1 value))
      value))

  (defun el-remhash (key table)
    (js-call (get table :entries) :delete
             (if (= (get table :test) "eq") key (el-hash-key table key)))
    nil)

  (defun el-hash-table-literal (items)
    (let ((test "eql") (data nil) (index 1))
      (while (< index (js-length items))
        (let ((key (el-symbol-name (aref items index))))
          (cond ((= key "test") (setq test (el-symbol-name (aref items (1+ index)))))
                ((= key "data") (setq data (aref items (1+ index))))))
        (setq index (+ index 2)))
      (let ((table (el-make-hash-table test)) (cursor data))
        (while (el-cons? cursor)
          (el-puthash (get cursor :car) (el-car (get cursor :cdr)) table)
          (setq cursor (el-cdr (get cursor :cdr))))
        table)))

  ;; ------------------------------------------------------------------
  ;; Sequences
  ;; ------------------------------------------------------------------

  (defun el-seq-items (seq)
    ;; Host array view of an Elisp sequence (lists, vectors, strings, records,
    ;; bool vectors and the persistent collections).
    (cond
      ((nil? seq) (js-array))
      ((= (js* "typeof seq") "string") (el-string-codes seq))
      ((= (js* "typeof seq") "object")
        (let ((kind (get seq :kind)))
          (cond
            ((= kind "cons") (el-list-to-array seq))
            ((or (= kind "vector") (= kind "record")) (js-call (get seq :items) :slice))
            (t (el-persistent-items seq)))))
      (t (el-signal "wrong-type-argument" (el-intern "sequencep") seq))))

  (defun el-seq-like (template items)
    (cond
      ((el-vector? template) (el-vector items))
      ((el-string? template) (el-string-from-codes items))
      (t (el-list-from items))))

  (defun el-length (seq)
    (cond
      ((nil? seq) 0)
      ((= (js* "typeof seq") "string") (el-string-length seq))
      ((el-cons? seq)
        (let ((count 0) (cursor seq))
          (while (el-cons? cursor) (setq count (1+ count)) (setq cursor (get cursor :cdr)))
          (unless (nil? cursor) (el-signal "wrong-type-argument" (el-intern "listp") seq))
          count))
      ((or (el-vector? seq) (el-record? seq)) (js-length (get seq :items)))
      ((el-hash-table? seq) (get (get seq :entries) :size))
      (t (el-value-count seq))))

  (defun el-aref (array index)
    (let ((i (el-int-check index)))
      (cond
        ((= (js* "typeof array") "string") (el-string-ref array i))
        ((or (el-vector? array) (el-record? array))
          (let ((items (get array :items)))
            (when (or (< i 0) (>= i (js-length items))) (el-signal "args-out-of-range" array index))
            (aref items i)))
        (t (el-signal "wrong-type-argument" (el-intern "arrayp") array)))))

  (defun el-aset-container (array index value)
    (let ((i (el-int-check index)))
      (cond
        ((or (el-vector? array) (el-record? array))
          (let ((items (get array :items)))
            (when (or (< i 0) (>= i (js-length items))) (el-signal "args-out-of-range" array index))
            (put items i value)
            value))
        (t (el-signal "wrong-type-argument" (el-intern "arrayp") array)))))

  (defun el-copy-sequence (seq)
    (cond
      ((nil? seq) nil)
      ((= (js* "typeof seq") "string") seq)
      ((el-cons? seq) (el-list-from (el-list-to-array seq)))
      ((el-vector? seq) (el-vector (js-call (get seq :items) :slice)))
      ((el-record? seq) (js-object :kind "record" :items (js-call (get seq :items) :slice)))
      (t seq)))

  (defun el-reverse (seq)
    (cond
      ((el-string? seq) (el-string-from-codes (js-call (el-string-codes seq) :reverse)))
      ((el-vector? seq) (el-vector (js-call (js-call (get seq :items) :slice) :reverse)))
      (t (el-list-from (js-call (el-list-to-array seq) :reverse)))))

  (defun el-append (lists)
    (if (= (js-length lists) 0) nil
      (let ((last (aref lists (1- (js-length lists))))
            (items (js-array))
            (index 0))
        (while (< index (1- (js-length lists)))
          (js-call (el-seq-items (aref lists index)) :forEach (lambda (item) (js-call items :push item)))
          (setq index (1+ index)))
        (el-list-from items last))))

  (defun el-nconc (lists)
    (let ((result nil) (tail nil) (index 0))
      (while (< index (js-length lists))
        (let ((item (aref lists index)))
          (cond
            ((nil? item) nil)
            ((nil? result) (setq result item) (setq tail item))
            (t (let ((cursor tail))
                 (while (el-cons? (get cursor :cdr)) (setq cursor (get cursor :cdr)))
                 (put cursor :cdr item)
                 (setq tail item)))))
        (setq index (1+ index)))
      result))

  (defun el-last-cell (list n)
    (let ((count (if (nullish? n) 1 n)) (cells (js-array)) (cursor list))
      (while (el-cons? cursor) (js-call cells :push cursor) (setq cursor (get cursor :cdr)))
      (if (= count 0) cursor
        (if (>= count (js-length cells)) list (aref cells (- (js-length cells) count))))))

  (defun el-member-with (item list test)
    (let ((cursor list) (found nil))
      (while (and (nil? found) (el-cons? cursor))
        (when (funcall test item (get cursor :car)) (setq found cursor))
        (setq cursor (get cursor :cdr)))
      found))

  (defun el-assoc-with (key alist test)
    (let ((cursor alist) (found nil))
      (while (and (nil? found) (el-cons? cursor))
        (let ((cell (get cursor :car)))
          (when (and (el-cons? cell) (funcall test key (get cell :car))) (setq found cell)))
        (setq cursor (get cursor :cdr)))
      found))

  (defun el-rassoc-with (key alist test)
    (let ((cursor alist) (found nil))
      (while (and (nil? found) (el-cons? cursor))
        (let ((cell (get cursor :car)))
          (when (and (el-cons? cell) (funcall test key (get cell :cdr))) (setq found cell)))
        (setq cursor (get cursor :cdr)))
      found))

  (defun el-delete-with (item seq test)
    (let ((kept (js-call (el-seq-items seq) :filter (lambda (x) (not (funcall test item x))))))
      (el-seq-like seq kept)))

  (defun el-plist-get (plist prop test)
    (let ((cursor plist) (found nil) (done false))
      (while (and (not done) (el-cons? cursor) (el-cons? (get cursor :cdr)))
        (if (funcall test (get cursor :car) prop)
            (progn (setq found (get (get cursor :cdr) :car)) (setq done t))
          (setq cursor (get (get cursor :cdr) :cdr))))
      found))

  (defun el-plist-put (plist prop value test)
    (let ((cursor plist) (done false))
      (while (and (not done) (el-cons? cursor) (el-cons? (get cursor :cdr)))
        (if (funcall test (get cursor :car) prop)
            (progn (put (get cursor :cdr) :car value) (setq done t))
          (setq cursor (get (get cursor :cdr) :cdr))))
      (if done plist
        (if (nil? plist) (el-list prop value)
          (let ((tail plist))
            (while (el-cons? (get (get tail :cdr) :cdr)) (setq tail (get (get tail :cdr) :cdr)))
            (put (get tail :cdr) :cdr (el-list prop value))
            plist)))))

  (defun el-plist-member (plist prop test)
    (let ((cursor plist) (found nil))
      (while (and (nil? found) (el-cons? cursor))
        (if (funcall test (get cursor :car) prop) (setq found cursor)
          (setq cursor (el-cdr-safe (get cursor :cdr)))))
      found))

  (defun el-proper-list-length (x)
    (let ((count 0) (cursor x) (seen (new globalThis.Set)))
      (while (and (el-cons? cursor) (not (js-call seen :has cursor)))
        (js-call seen :add cursor)
        (setq count (1+ count))
        (setq cursor (get cursor :cdr)))
      (if (nil? cursor) count nil)))

  (defun el-sort-items (items predicate session)
    ;; Stable merge sort with an Elisp predicate.
    (let ((array (js-call items :slice)))
      (js-call array :sort
               (lambda (a b)
                 (cond ((el-call session predicate (js-array a b)) -1)
                       ((el-call session predicate (js-array b a)) 1)
                       (t 0))))
      array))

  (defun el-copy-tree (tree vectors)
    (cond
      ((el-cons? tree) (el-cons (el-copy-tree (get tree :car) vectors) (el-copy-tree (get tree :cdr) vectors)))
      ((and vectors (el-vector? tree)) (el-vector (js-call (get tree :items) :map (lambda (x) (el-copy-tree x vectors)))))
      (t tree)))

  ;; ------------------------------------------------------------------
  ;; Emacs regular expressions -> host RegExp
  ;; ------------------------------------------------------------------

  (defconst regexp-cache (new globalThis.Map))
  (defconst regexp-cache-i (new globalThis.Map))
  (defconst regexp-fast-cache (new globalThis.Map))
  (defconst regexp-fast-cache-i (new globalThis.Map))
  (defconst word-class "\\p{L}\\p{N}")
  (defconst symbol-class "\\p{L}\\p{N}_\\-+*/&|<>=$%!?~^:")

  (defun el-class-char (code)
    (if (or (and (>= code 48) (<= code 57)) (and (>= code 65) (<= code 90)) (and (>= code 97) (<= code 122)))
        (String/fromCodePoint code)
      (str "\\u{" (js-call (if (> code 1114111) beyond-unicode-char code) :toString 16) "}")))

  (defun el-posix-class (name)
    (cond ((= name "alpha") "\\p{L}")
          ((= name "alnum") "\\p{L}\\p{N}")
          ((= name "digit") "0-9")
          ((= name "xdigit") "0-9A-Fa-f")
          ((= name "space") "\\s")
          ((= name "blank") " \\t\\p{Zs}")
          ((= name "upper") "\\p{Lu}")
          ((= name "lower") "\\p{Ll}")
          ((= name "punct") "!-\\/:-@\\[-`{-~\\p{P}\\p{S}")
          ((= name "cntrl") "\\u{0}-\\u{1f}")
          ((= name "word") word-class)
          ((= name "graph") "\\u{21}-\\u{7e}\\u{a1}-\\u{10ffff}")
          ((= name "print") "\\u{20}-\\u{7e}\\u{a0}-\\u{10ffff}")
          ((= name "ascii") "\\u{0}-\\u{7f}")
          ((= name "nonascii") "\\u{80}-\\u{10ffff}")
          ((= name "multibyte") "\\u{100}-\\u{10ffff}")
          ((= name "unibyte") "\\u{0}-\\u{ff}")
          (t (el-signal "invalid-regexp" (str "Invalid character class name: " name)))))

  (defun el-translate-bracket (chars start)
    ;; CHARS is an array of single-character strings; START points after "[".
    ;; Return {source, next}.
    (let ((index start) (negated false) (parts (js-array)) (first t) (done false))
      (when (= (aref chars index) "^") (setq negated t) (setq index (1+ index)))
      (while (not done)
        (when (>= index (js-length chars)) (el-signal "invalid-regexp" "Unmatched [ or [^"))
        (let ((ch (aref chars index)))
          (cond
            ((and (= ch "]") (not first)) (setq done t) (setq index (1+ index)))
            ((and (= ch "[") (= (aref chars (1+ index)) ":"))
              (let ((close (js-call (js-call chars :join "") :indexOf ":]" index)))
                (if (< close 0)
                    (progn (js-call parts :push (el-class-char 91)) (setq index (1+ index)))
                  (progn
                    (js-call parts :push (el-posix-class (js-call (js-call chars :slice (+ index 2) close) :join "")))
                    (setq index (+ close 2))))))
            ((and (< (+ index 2) (js-length chars)) (= (aref chars (1+ index)) "-") (/= (aref chars (+ index 2)) "]"))
              (let ((low (js-call ch :codePointAt 0)) (high (js-call (aref chars (+ index 2)) :codePointAt 0)))
                (when (<= low high)
                  (js-call parts :push (str (el-class-char low) "-" (el-class-char high))))
                (setq index (+ index 3))))
            (t (js-call parts :push (el-class-char (js-call ch :codePointAt 0))) (setq index (1+ index)))))
        (setq first false))
      (js-object :source (if (= (js-length parts) 0)
                             (if negated "[\\s\\S]" "[^\\s\\S]")
                           (str "[" (if negated "^" "") (js-call parts :join "") "]"))
                 :next index)))

  (defun el-regexp-literal (ch)
    (if (js-call (new globalThis.RegExp "^[\\\\^$.*+?()\\[\\]{}|/]$") :test ch) (str "\\" ch) ch))

  (defun el-translate-regexp (pattern)
    (let ((chars (Array/from pattern)) (out (js-array)) (index 0) (at-start t))
      (while (< index (js-length chars))
        (let ((ch (aref chars index)) (next-start false))
          (cond
            ((= ch "\\")
              (let ((next (aref chars (1+ index))))
                (setq index (+ index 2))
                (cond
                  ((undefined? next) (el-signal "invalid-regexp" "Trailing backslash"))
                  ((= next "(")
                    (if (= (aref chars index) "?")
                        (let ((colon (js-call (js-call chars :join "") :indexOf ":" index)))
                          (js-call out :push "(?:")
                          (setq index (1+ colon)))
                      (js-call out :push "("))
                    (setq next-start t))
                  ((= next ")") (js-call out :push ")"))
                  ((= next "|") (js-call out :push "|") (setq next-start t))
                  ((= next "{")
                    (let ((close (js-call (js-call chars :join "") :indexOf "\\}" index)))
                      (let ((body (js-call (js-call chars :slice index close) :join "")))
                        (js-call out :push (str "{" (if (js-call body :startsWith ",") (str "0" body) body) "}"))
                        (setq index (+ close 2)))))
                  ((= next "`") (js-call out :push "(?<![\\s\\S])"))
                  ((= next "'") (js-call out :push "(?![\\s\\S])"))
                  ((= next "=") nil)
                  ((= next "w") (js-call out :push (str "[" word-class "]")))
                  ((= next "W") (js-call out :push (str "[^" word-class "]")))
                  ((or (= next "s") (= next "S"))
                    (let ((code (aref chars index)) (negate (= next "S")))
                      (setq index (1+ index))
                      (js-call out :push
                               (cond ((or (= code "-") (= code " ")) (if negate "\\S" "\\s"))
                                     ((= code "w") (str "[" (if negate "^" "") word-class "]"))
                                     ((= code "_") (str "[" (if negate "^" "") symbol-class "]"))
                                     ((= code ".") (if negate "[^\\p{P}]" "\\p{P}"))
                                     ((= code "(") (if negate "[^(\\[{]" "[(\\[{]"))
                                     ((= code ")") (if negate "[^)\\]}]" "[)\\]}]"))
                                     ((= code "\"") (if negate "[^\"]" "\""))
                                     (t "[\\s\\S]")))))
                  ((= next "b")
                    (js-call out :push (str "(?:(?<=[" word-class "])(?![" word-class "])|(?<![" word-class "])(?=[" word-class "]))")))
                  ((= next "B") (js-call out :push (str "(?:(?<=[" word-class "])(?=[" word-class "])|(?<![" word-class "])(?![" word-class "]))")))
                  ((= next "<") (js-call out :push (str "(?<![" word-class "])(?=[" word-class "])")))
                  ((= next ">") (js-call out :push (str "(?<=[" word-class "])(?![" word-class "])")))
                  ((= next "_")
                    (let ((which (aref chars index)))
                      (setq index (1+ index))
                      (js-call out :push (if (= which "<")
                                             (str "(?<![" symbol-class "])(?=[" symbol-class "])")
                                           (str "(?<=[" symbol-class "])(?![" symbol-class "])")))))
                  ((js-call (new globalThis.RegExp "^[1-9]$") :test next) (js-call out :push (str "\\" next)))
                  ((or (= next "c") (= next "C")) (setq index (1+ index)) (js-call out :push "[\\s\\S]"))
                  (t (js-call out :push (el-regexp-literal next))))))
            ((= ch "[")
              (let ((translated (el-translate-bracket chars (1+ index))))
                (js-call out :push (get translated :source))
                (setq index (get translated :next))))
            ((= ch "^")
              (js-call out :push (if at-start "^" "\\^"))
              (setq index (1+ index))
              (setq next-start at-start))
            ((= ch "$")
              (let ((following (aref chars (1+ index))))
                (js-call out :push (if (or (undefined? following)
                                           (and (= following "\\")
                                                (or (= (aref chars (+ index 2)) ")") (= (aref chars (+ index 2)) "|"))))
                                       "$" "\\$")))
              (setq index (1+ index)))
            ((= ch ".") (js-call out :push "[^\\n]") (setq index (1+ index)))
            ((and (or (= ch "*") (= ch "+") (= ch "?")) at-start)
              (js-call out :push (str "\\" ch)) (setq index (1+ index)))
            ((or (= ch "*") (= ch "+") (= ch "?")) (js-call out :push ch) (setq index (1+ index)))
            (t (js-call out :push (el-regexp-literal ch)) (setq index (1+ index))))
          (setq at-start next-start)))
      (js-call out :join "")))

  (defun el-compile-regexp (pattern fold)
    (let* ((cache (if fold regexp-cache-i regexp-cache))
           (cached (js-call cache :get pattern)))
      (if (not (undefined? cached)) cached
        (let ((compiled (try (new globalThis.RegExp (el-translate-regexp pattern) (if fold "gmuid" "gmud"))
                          (catch error
                            (if (get error :eliscriptSignal) (throw error)
                              (el-signal "invalid-regexp" (str (get error :message))))))))
          (js-call cache :set pattern compiled)
          compiled))))

  (defun el-compile-regexp-fast (pattern fold)
    (let* ((cache (if fold regexp-fast-cache-i regexp-fast-cache))
           (cached (js-call cache :get pattern)))
      (if (not (undefined? cached)) cached
        (let ((compiled (try (new globalThis.RegExp (el-translate-regexp pattern) (if fold "gmui" "gmu"))
                          (catch error
                            (if (get error :eliscriptSignal) (throw error)
                              (el-signal "invalid-regexp" (str (get error :message))))))))
          (js-call cache :set pattern compiled)
          compiled))))

  (defun el-case-fold (session)
    (let ((value (js-call (get session :values) :get (el-intern "case-fold-search"))))
      (and (not (undefined? value)) (not (nil? value)))))

  (defun el-set-match-data (session match subject offset buffer)
    ;; Record MATCH (a host RegExp result on SUBJECT) as Emacs positions.
    (if (= (js-length match) 1)
        (let* ((u0 (get match :index))
               (u1 (+ u0 (js-length (aref match 0))))
               (c0 (+ offset (el-unit-to-char subject u0)))
               (c1 (+ offset (el-unit-to-char subject u1))))
          (put session :matchData (js-object :groups (js-array c0 c1) :subject subject :buffer buffer :offset offset)))
      (let ((groups (js-array)) (index 0) (indices (get match :indices)))
        (while (< index (js-length match))
          (let ((span (if (undefined? indices) nil (aref indices index))))
            (if (or (nullish? span) (undefined? (aref match index)))
                (progn (js-call groups :push nil) (js-call groups :push nil))
              (progn
                (js-call groups :push (+ offset (el-unit-to-char subject (aref span 0))))
                (js-call groups :push (+ offset (el-unit-to-char subject (aref span 1)))))))
          (setq index (1+ index)))
        (put session :matchData (js-object :groups groups :subject subject :buffer buffer :offset offset)))))

  (defun el-regexp-exec (session pattern subject start)
    ;; Search SUBJECT from character START; return the host match or nil.
    (let ((regexp (el-compile-regexp pattern (el-case-fold session))))
      (put regexp :lastIndex (if (= start 0) 0 (el-char-to-unit subject start)))
      (let ((match (js-call regexp :exec subject)))
        (if (nil? match) nil match))))

  (defun el-regexp-exec-fast (session pattern subject start)
    (let ((regexp (el-compile-regexp-fast pattern (el-case-fold session))))
      (put regexp :lastIndex (if (= start 0) 0 (el-char-to-unit subject start)))
      (let ((match (js-call regexp :exec subject)))
        (if (nil? match) nil match))))

  (defun el-string-match (session pattern string start set-data)
    (if (and (not set-data) (or (nullish? start) (= start 0)))
        (let ((match (el-regexp-exec-fast session pattern string 0)))
          (if (nil? match) nil (el-unit-to-char string (get match :index))))
      (let* ((length (el-string-length string))
             (from (if (nullish? start) 0 (if (< start 0) (+ length start) start))))
        (when (or (< from 0) (> from length)) (el-signal "args-out-of-range" string start))
        (let ((match (if set-data
                         (el-regexp-exec session pattern string from)
                       (el-regexp-exec-fast session pattern string from))))
          (if (nil? match) nil
            (progn
              (when set-data (el-set-match-data session match string 0 nil))
              (el-unit-to-char string (get match :index))))))))

  (defun el-match-position (session n end)
    (let ((data (get session :matchData)))
      (if (nullish? data) nil
        (let ((value (aref (get data :groups) (+ (* n 2) (if end 1 0)))))
          (if (undefined? value) nil value)))))

  (defun el-match-string (session n string)
    (let ((start (el-match-position session n false))
          (end (el-match-position session n t))
          (data (get session :matchData)))
      (if (or (nil? start) (nil? end)) nil
        (cond
          ((not (nullish? string)) (el-substring string start end))
          ((and (not (nullish? data)) (not (nullish? (get data :buffer))))
            (el-buffer-substring (get data :buffer) start end))
          ((not (nullish? data)) (el-substring (get data :subject) start end))
          (t nil)))))

  (defun el-expand-replacement (session replacement matched string)
    (let ((out (js-array)) (chars (Array/from replacement)) (index 0))
      (while (< index (js-length chars))
        (let ((ch (aref chars index)))
          (if (and (= ch "\\") (< (1+ index) (js-length chars)))
              (let ((next (aref chars (1+ index))))
                (cond
                  ((= next "&") (js-call out :push matched))
                  ((js-call (new globalThis.RegExp "^[0-9]$") :test next)
                    (js-call out :push (or (el-match-string session (Number/parseInt next 10) string) "")))
                  ((= next "\\") (js-call out :push "\\"))
                  (t (el-signal "error" "Invalid use of `\\' in replacement text")))
                (setq index (+ index 2)))
            (progn (js-call out :push ch) (setq index (1+ index))))))
      (js-call out :join "")))

  (defun el-replace-regexp-in-string (session pattern rep string fixedcase literal subexp start)
    (let ((position (if (nullish? start) 0 start)))
      (if (and (= position 0) (nil? (el-regexp-exec-fast session pattern string 0)))
          string
        (let ((out (js-array))
              (length (el-string-length string))
              (done false))
          (when (> position 0) (js-call out :push (el-substring string 0 position)))
          (while (and (not done) (<= position length))
            (let ((match (el-regexp-exec session pattern string position)))
              (if (nil? match)
                  (setq done t)
                (let* ((mstart (el-unit-to-char string (get match :index)))
                       (matched (aref match 0))
                       (mlen (el-string-length matched))
                       (mend (+ mstart mlen)))
                  (js-call out :push (el-substring string position mstart))
                  (let ((replacement
                         (if (el-function? rep)
                             (progn
                               (if (= (js-length match) 1)
                                   (put session :matchData (js-object :groups (js-array 0 mlen) :subject matched :buffer nil :offset 0))
                                 (el-string-match session pattern matched 0 t))
                               (let ((value (funcall rep matched)))
                                 (if literal
                                     value
                                   (progn
                                     (el-set-match-data session match string 0 nil)
                                     (el-expand-replacement session value matched string)))))
                           (if literal
                               rep
                             (progn
                               (el-set-match-data session match string 0 nil)
                               (el-expand-replacement session rep matched string))))))
                    (js-call out :push replacement))
                  (if (= mend mstart)
                      (progn
                        (when (< mstart length) (js-call out :push (el-substring string mstart (1+ mstart))))
                        (setq position (1+ mend)))
                    (setq position mend))))))
          (when (<= position length) (js-call out :push (el-substring string position length)))
          (js-call out :join "")))))

  (defun el-split-string (session string separators omit-nulls trim)
    (let* ((default (nullish? separators))
           (pattern (if default "[ \f\t\n\r\u000b]+" separators))
           (omit (if default t (not (nullish? omit-nulls))))
           (pieces (js-array))
           (position 0)
           (length (el-string-length string))
           (done false))
      (while (not done)
        (let ((match (if (> position length) nil (el-regexp-exec session pattern string position))))
          (if (or (nil? match)
                  (and (= (js-length (aref match 0)) 0) (>= (el-unit-to-char string (get match :index)) length)))
              (progn (js-call pieces :push (el-substring string position length)) (setq done t))
            (let* ((mstart (el-unit-to-char string (get match :index)))
                   (mend (+ mstart (el-string-length (aref match 0)))))
              (if (= mend mstart)
                  (progn
                    (js-call pieces :push (el-substring string position (1+ mstart)))
                    (setq position (1+ mstart)))
                (progn
                  (js-call pieces :push (el-substring string position mstart))
                  (setq position mend)))))))
      (let ((result (js-array)))
        (js-call pieces :forEach
                 (lambda (piece)
                   (let ((value (if (nullish? trim) piece (el-string-trim session piece trim trim))))
                     (unless (and omit (= value "")) (js-call result :push value)))))
        (el-list-from result))))

  (defun el-string-trim (session string left right)
    (let ((text string))
      (let ((left-pattern (if (nullish? left) "[ \t\n\r]+" left))
            (right-pattern (if (nullish? right) "[ \t\n\r]+" right)))
        (let ((match (el-regexp-exec session (str "\\`\\(?:" left-pattern "\\)") text 0)))
          (unless (nil? match) (setq text (el-substring text (el-string-length (aref match 0)) nil))))
        (let ((match (el-regexp-exec session (str "\\(?:" right-pattern "\\)\\'") text 0)))
          (unless (nil? match) (setq text (el-substring text 0 (el-unit-to-char text (get match :index))))))
        text)))

  (defun el-regexp-quote (string)
    (js-call string :replace (new globalThis.RegExp "[\\[*.\\\\?+^$]" "g") (lambda (m) (str "\\" m))))

  ;; rx: the subset used by real packages, translated to Emacs regexp text.
  (defun el-rx-charset (items)
    (let ((parts (js-array)) (classes (js-array)))
      (js-call items :forEach
               (lambda (item)
                 (cond
                   ((= (el-typeof item) "number") (js-call parts :push (el-char-string item)))
                   ((el-string? item)
                     (js-call parts :push item))
                   ((el-cons? item)
                     (js-call parts :push (str (el-char-string (get item :car)) "-" (el-char-string (get item :cdr)))))
                   ((el-symobj? item) (js-call classes :push (str "[:" (get item :name) ":]"))))))
      (let ((body (js-call parts :join "")))
        ;; Keep ] first and - last so the class stays literal.
        (let ((has-bracket (>= (js-call body :indexOf "]") 0))
              (has-dash (and (js-call body :endsWith "-") false)))
          (str (if has-bracket "]" "") (js-call body :replace (new globalThis.RegExp "\\]" "g") "")
               (js-call classes :join "") (if has-dash "-" ""))))))

  (defun el-rx (form)
    (cond
      ((el-string? form) (el-regexp-quote form))
      ((= (el-typeof form) "number") (el-regexp-quote (el-char-string form)))
      ((el-symobj? form)
        (let ((name (get form :name)))
          (cond ((or (= name "bol") (= name "line-start")) "^")
                ((or (= name "eol") (= name "line-end")) "$")
                ((or (= name "bos") (= name "string-start") (= name "buffer-start") (= name "bot")) "\\`")
                ((or (= name "eos") (= name "string-end") (= name "buffer-end") (= name "eot")) "\\'")
                ((or (= name "digit") (= name "numeric") (= name "num")) "[[:digit:]]")
                ((or (= name "space") (= name "whitespace") (= name "white")) "[[:space:]]")
                ((or (= name "alpha") (= name "alphabetic") (= name "letter")) "[[:alpha:]]")
                ((or (= name "alnum") (= name "alphanumeric")) "[[:alnum:]]")
                ((= name "word") "[[:word:]]")
                ((or (= name "upper") (= name "upper-case")) "[[:upper:]]")
                ((or (= name "lower") (= name "lower-case")) "[[:lower:]]")
                ((or (= name "punct") (= name "punctuation")) "[[:punct:]]")
                ((or (= name "cntrl") (= name "control")) "[[:cntrl:]]")
                ((or (= name "xdigit") (= name "hex-digit") (= name "hex")) "[[:xdigit:]]")
                ((or (= name "blank")) "[[:blank:]]")
                ((or (= name "nonl") (= name "not-newline")) ".")
                ((or (= name "anything") (= name "anychar")) "[^z-a]")
                ((= name "word-boundary") "\\b")
                ((= name "word-start") "\\<")
                ((= name "word-end") "\\>")
                ((= name "symbol-start") "\\_<")
                ((= name "symbol-end") "\\_>")
                (t (el-signal "error" (str "Unknown rx form " name))))))
      ((el-cons? form)
        (let* ((head (get form :car)) (name (if (el-symobj? head) (el-symbol-name head) "")) (args (el-list-to-array (get form :cdr))))
          (cond
            ((or (= name "seq") (= name "sequence") (= name ":") (= name "and"))
              (el-rx-seq args))
            ((or (= name "or") (= name "|"))
              (str "\\(?:" (js-call (js-call args :map (lambda (x) (el-rx x))) :join "\\|") "\\)"))
            ((or (= name "in") (= name "any") (= name "char"))
              (str "[" (el-rx-charset (el-rx-expand-ranges args)) "]"))
            ((= name "not")
              (let ((inner (aref args 0)))
                (if (and (el-cons? inner) (or (el-sym-is (get inner :car) "in") (el-sym-is (get inner :car) "any")))
                    (str "[^" (el-rx-charset (el-rx-expand-ranges (el-list-to-array (get inner :cdr)))) "]")
                  (let ((text (el-rx inner)))
                    (if (js-call text :startsWith "[[:") (str "[^" (js-call text :slice 1)) (str "[^" text "]"))))))
            ((or (= name "group") (= name "submatch"))
              (str "\\(" (js-call (js-call args :map (lambda (x) (el-rx x))) :join "") "\\)"))
            ((or (= name "*") (= name "zero-or-more") (= name "0+"))
              (str (el-rx-atom args) "*"))
            ((or (= name "+") (= name "one-or-more") (= name "1+"))
              (str (el-rx-atom args) "+"))
            ((or (= name "?") (= name "opt") (= name "optional") (= name "zero-or-one"))
              (str (el-rx-atom args) "?"))
            ((or (= name "*?") (= name "+?") (= name "??"))
              (str (el-rx-atom args) name))
            ((or (= name "=") (= name "repeat") (= name ">=") (= name "**"))
              (cond
                ((= name "=") (str (el-rx-atom (js-call args :slice 1)) "\\{" (aref args 0) "\\}"))
                ((= name ">=") (str (el-rx-atom (js-call args :slice 1)) "\\{" (aref args 0) ",\\}"))
                ((and (= name "repeat") (= (js-length args) 2)) (str (el-rx-atom (js-call args :slice 1)) "\\{" (aref args 0) "\\}"))
                (t (str (el-rx-atom (js-call args :slice 2)) "\\{" (aref args 0) "," (aref args 1) "\\}"))))
            ((or (= name "literal") (= name "regexp") (= name "regex"))
              (if (= name "literal") (el-regexp-quote (aref args 0)) (aref args 0)))
            (t (el-signal "error" (str "Unknown rx form " name))))))
      (t (el-signal "error" "Invalid rx form"))))

  (defun el-rx-expand-ranges (args)
    (let ((out (js-array)))
      (js-call args :forEach
               (lambda (item)
                 (if (and (el-string? item) (= (js-length item) 3) (= (js-call item :charAt 1) "-"))
                     (js-call out :push (el-cons (js-call item :codePointAt 0) (js-call item :codePointAt 2)))
                   (js-call out :push item))))
      out))

  (defun el-rx-group-if-needed (form) (el-rx form))

  (defun el-rx-seq (args)
    ;; Like rx.el: a "^" after other items and a "$" before other items are
    ;; bracketed so they stay anchors.
    (let ((text "") (index 0))
      (while (< index (js-length args))
        (let ((piece (el-rx (aref args index))) (last (= index (1- (js-length args)))))
          (cond
            ((and (= piece "^") (/= text "")) (setq text (str text "\\(?:^\\)")))
            ((and (= piece "$") (not last)) (setq text (str "\\(?:" text "$\\)")))
            (t (setq text (str text piece)))))
        (setq index (1+ index)))
      text))
  (defun el-rx-atom (args)
    (let ((text (js-call (js-call args :map (lambda (x) (el-rx x))) :join "")))
      (if (or (= (el-string-length text) 1)
              (and (= (js-length args) 1)
                   (or (el-symobj? (aref args 0))
                       (and (el-cons? (aref args 0))
                            (js-call (js-array "in" "any" "char" "not" "group" "submatch" "or" "|")
                                     :includes (el-symbol-name (get (aref args 0) :car)))))))
          text
        (str "\\(?:" text "\\)"))))

  ;; ------------------------------------------------------------------
  ;; Buffers (in-memory, positions start at 1)
  ;; ------------------------------------------------------------------

  (defun el-make-buffer (name)
    (js-object :kind "buffer" :name name :text "" :point 1 :live t :mark nil
               :multibyte t :modified false :locals (new globalThis.Map)))

  (defun el-current-buffer (session)
    (let ((buffer (get session :currentBuffer)))
      (if (nullish? buffer)
          (let ((scratch (el-get-buffer-create session "*scratch*")))
            (put session :currentBuffer scratch)
            scratch)
        buffer)))

  (defun el-get-buffer-create (session name)
    (let ((existing (js-call (get session :buffers) :get name)))
      (if (and (not (undefined? existing)) (get existing :live)) existing
        (let ((buffer (el-make-buffer name)))
          (js-call (get session :buffers) :set name buffer)
          buffer))))

  (defun el-generate-new-buffer (session name)
    (let ((candidate name) (counter 2))
      (while (let ((existing (js-call (get session :buffers) :get candidate)))
               (and (not (undefined? existing)) (get existing :live)))
        (setq candidate (str name "<" counter ">"))
        (setq counter (1+ counter)))
      (el-get-buffer-create session candidate)))

  (defun el-kill-buffer (session buffer)
    (put buffer :live false)
    (js-call (get session :buffers) :delete (get buffer :name))
    (when (eq (get session :currentBuffer) buffer) (put session :currentBuffer nil))
    t)

  (defun el-buffer-size (buffer) (el-string-length (get buffer :text)))
  (defun el-point-max (buffer) (1+ (el-buffer-size buffer)))
  (defun el-clamp-position (buffer position)
    (Math/max 1 (Math/min (el-point-max buffer) (el-num position))))

  (defun el-buffer-substring (buffer start end)
    (let ((a (el-clamp-position buffer (Math/min start end)))
          (b (el-clamp-position buffer (Math/max start end))))
      (el-substring (get buffer :text) (1- a) (1- b))))

  (defun el-buffer-insert (buffer text)
    (let* ((content (get buffer :text))
           (at (1- (get buffer :point)))
           (before (el-substring content 0 at))
           (after (el-substring content at nil)))
      (put buffer :text (str before text after))
      (put buffer :point (+ (get buffer :point) (el-string-length text)))
      nil))

  (defun el-buffer-delete (buffer start end)
    (let* ((a (el-clamp-position buffer (Math/min start end)))
           (b (el-clamp-position buffer (Math/max start end)))
           (content (get buffer :text))
           (point (get buffer :point)))
      (put buffer :text (str (el-substring content 0 (1- a)) (el-substring content (1- b) nil)))
      (cond ((>= point b) (put buffer :point (- point (- b a))))
            ((> point a) (put buffer :point a)))
      nil))

  (defun el-line-beginning (buffer position)
    (let* ((text (get buffer :text)) (chars (Array/from text)) (index (1- position)))
      (while (and (> index 0) (/= (aref chars (1- index)) "\n")) (setq index (1- index)))
      (1+ index)))

  (defun el-line-end (buffer position)
    (let* ((text (get buffer :text)) (chars (Array/from text)) (index (1- position)))
      (while (and (< index (js-length chars)) (/= (aref chars index) "\n")) (setq index (1+ index)))
      (1+ index)))

  (defun el-forward-line (buffer count)
    (let ((n (if (nullish? count) 1 count)) (shortage 0))
      (if (> n 0)
          (let ((remaining n))
            (while (> remaining 0)
              (let ((end (el-line-end buffer (get buffer :point))))
                (if (>= end (el-point-max buffer))
                    (progn (put buffer :point end) (setq shortage remaining) (setq remaining 0))
                  (progn (put buffer :point (1+ end)) (setq remaining (1- remaining)))))))
        (let ((remaining (- 0 n)))
          (put buffer :point (el-line-beginning buffer (get buffer :point)))
          (while (> remaining 0)
            (if (<= (get buffer :point) 1)
                (progn (setq shortage remaining) (setq remaining 0))
              (progn
                (put buffer :point (el-line-beginning buffer (1- (get buffer :point))))
                (setq remaining (1- remaining)))))))
      shortage))

  (defun el-search-buffer (session buffer pattern bound noerror count forward literal)
    (let* ((regexp (if literal (el-regexp-quote pattern) pattern))
           (text (get buffer :text))
           (repeat (if (nullish? count) 1 count))
           (limit (if (nullish? bound) (if forward (el-point-max buffer) 1) bound))
           (found nil)
           (position (get buffer :point)))
      (while (> repeat 0)
        (if forward
            (let ((match (el-regexp-exec session regexp text (1- position))))
              (if (or (nil? match)
                      (> (+ 1 (el-unit-to-char text (get match :index)) (el-string-length (aref match 0))) limit))
                  (progn (setq found nil) (setq repeat 0))
                (progn
                  (el-set-match-data session match text 1 buffer)
                  (setq position (+ 1 (el-unit-to-char text (get match :index)) (el-string-length (aref match 0))))
                  (when (= (el-string-length (aref match 0)) 0) (setq position position))
                  (setq found position)
                  (setq repeat (1- repeat)))))
          (let ((best nil) (scan (1- limit)) (searching t))
            (while searching
              (let ((match (el-regexp-exec session regexp text scan)))
                (if (or (nil? match) (>= (el-unit-to-char text (get match :index)) (1- position)))
                    (setq searching false)
                  (progn
                    (setq best match)
                    (setq scan (1+ (el-unit-to-char text (get match :index))))))))
            (if (nil? best)
                (progn (setq found nil) (setq repeat 0))
              (progn
                (el-set-match-data session best text 1 buffer)
                (setq position (1+ (el-unit-to-char text (get best :index))))
                (setq found position)
                (setq repeat (1- repeat)))))))
      (if (nil? found)
          (cond ((nullish? noerror) (el-signal "search-failed" pattern))
                ((eq noerror t) nil)
                (t (put buffer :point limit) nil))
        (progn (put buffer :point found) found))))

  (defun el-looking-at (session buffer pattern set-data)
    (let* ((text (get buffer :text))
           (source (el-compile-regexp pattern (el-case-fold session)))
           (regexp (new globalThis.RegExp (get source :source) (str (js-call (get source :flags) :replace (new globalThis.RegExp "[gyd]" "g") "") "yd"))))
      (put regexp :lastIndex (el-char-to-unit text (1- (get buffer :point))))
      (let ((match (js-call regexp :exec text)))
        (if (nil? match) nil
          (progn (when set-data (el-set-match-data session match text 1 buffer)) t)))))

  ;; ------------------------------------------------------------------
  ;; Evaluator core
  ;; ------------------------------------------------------------------

  (defconst special-forms (new globalThis.Map))

  (defun el-new-env (parent)
    (js-object :vars (new globalThis.Map) :fns nil :hasFns (if (nil? parent) false (get parent :hasFns)) :parent parent :consts nil))

  (defun el-root-env () (el-new-env nil))

  (defun el-add-special-var (session symbol)
    (when (el-symobj? symbol)
      (put symbol :_everSpecial t)
      (js-call (get session :specials) :add symbol)))

  (defun el-set-fn (session sym fn)
    (when (el-symobj? sym)
      (put sym :_inlineEval undefined)
      (if (or (nil? fn) (undefined? fn))
          (progn
            (put sym :_cachedFn undefined)
            (put sym :_cachedSession undefined)
            (js-call (get session :functions) :delete sym))
        (progn
          (js-call (get session :functions) :set sym fn)
          (if (and (el-function? fn) (not (js-call (get session :macros) :has sym)))
              (progn
                (put sym :_cachedFn fn)
                (put sym :_cachedSession session))
            (progn
              (put sym :_cachedFn undefined)
              (put sym :_cachedSession undefined)))))))

  (defun el-set-macro (session sym expander)
    (when (el-symobj? sym)
      (put sym :_inlineEval undefined)
      (put sym :_cachedFn undefined)
      (put sym :_cachedSession undefined)
      (js-call (get session :macros) :set sym expander)))

  (defun el-default-value (session symbol)
    (let ((values (get session :values)))
      (if (js-call values :has symbol) (js-call values :get symbol)
        (let ((getter (js-call (get session :liveValueGetters) :get symbol)))
          (if (undefined? getter) (el-signal "void-variable" symbol) (funcall getter))))))

  (defun el-global-value (session symbol)
    (let ((buf (get session :currentBuffer)))
      (if (and (not (nullish? buf)) (get buf :live) (not (nullish? (get buf :locals)))
               (js-call (get buf :locals) :has symbol))
          (js-call (get buf :locals) :get symbol)
        (el-default-value session symbol))))

  (defun el-lookup (session symbol env)
    (cond
      ((eq (get symbol :kind) "keyword") symbol)
      ((and (get symbol :_everSpecial) (js-call (get session :specials) :has symbol))
        (el-global-value session symbol))
      (t
        (if (not (nil? env))
            (let ((v0 (js-call (get env :vars) :get symbol)))
              (if (not (undefined? v0))
                  v0
                (let ((frame (get env :parent)) (found false) (value nil))
                  (while (and (not found) (not (nil? frame)))
                    (let ((v (js-call (get frame :vars) :get symbol)))
                      (if (not (undefined? v))
                          (progn (setq value v) (setq found t))
                        (setq frame (get frame :parent)))))
                  (if found value
                    (let ((getter (js-call (get session :liveValueGetters) :get symbol)))
                      (if (undefined? getter) (el-global-value session symbol) (funcall getter)))))))
          (let ((getter (js-call (get session :liveValueGetters) :get symbol)))
            (if (undefined? getter) (el-global-value session symbol) (funcall getter)))))))

  (defun el-bound-lexically (symbol env)
    (let ((frame env) (found false))
      (while (and (not found) (not (nil? frame)))
        (if (js-call (get frame :vars) :has symbol) (setq found t) (setq frame (get frame :parent))))
      found))

  (defun el-set-dynamic-variable (session symbol value)
    (let ((buf (get session :currentBuffer)))
      (if (and (not (nullish? buf)) (get buf :live) (not (nullish? (get buf :locals)))
               (or (js-call (get buf :locals) :has symbol)
                   (and (not (nullish? (get session :localVars)))
                        (js-call (get session :localVars) :has symbol))))
          (js-call (get buf :locals) :set symbol value)
        (js-call (get session :values) :set symbol value)))
    value)

  (defun el-set-variable (session symbol value env)
    (when (or (nil? symbol) (eq symbol t) (el-keyword? symbol)) (el-signal "setting-constant" symbol))
    (unless (el-symobj? symbol) (el-signal "wrong-type-argument" (el-intern "symbolp") symbol))
    (if (and (get symbol :_everSpecial) (js-call (get session :specials) :has symbol))
        (el-set-dynamic-variable session symbol value)
      (if (and (not (nil? env)) (js-call (get env :vars) :has symbol))
          (progn
            (when (and (not (nil? (get env :consts))) (js-call (get env :consts) :has symbol))
              (el-compile-error (str "ELI-C0010: cannot mutate immutable binding " (get symbol :name))))
            (js-call (get env :vars) :set symbol value))
        (let ((frame (if (nil? env) nil (get env :parent))) (done false))
          (while (and (not done) (not (nil? frame)))
            (if (js-call (get frame :vars) :has symbol)
                (progn
                  (when (and (not (nil? (get frame :consts))) (js-call (get frame :consts) :has symbol))
                    (el-compile-error (str "ELI-C0010: cannot mutate immutable binding " (get symbol :name))))
                  (js-call (get frame :vars) :set symbol value)
                  (setq done t))
              (setq frame (get frame :parent))))
          (unless done (el-set-dynamic-variable session symbol value)))))
    value)

  (defun el-bind-variable (session frame symbol value dynamic)
    ;; Bind SYMBOL in FRAME, or dynamically when it is special (recording the
    ;; previous global/local state in DYNAMIC for restoration).
    (cond
      ((or (nil? symbol) (eq symbol t)) (el-signal "setting-constant" symbol))
      ((and (get symbol :_everSpecial) (js-call (get session :specials) :has symbol))
        (let* ((values (get session :values))
               (buf (get session :currentBuffer))
               (locals (if (and (not (nullish? buf)) (get buf :live)) (get buf :locals) nil))
               (has-local (and (not (nil? locals)) (js-call locals :has symbol))))
          (js-call dynamic :push
                   (js-array symbol (js-call values :has symbol) (js-call values :get symbol)
                             (if has-local locals nil) (if has-local (js-call locals :get symbol) nil)))
          (if has-local
              (js-call locals :set symbol value)
            (js-call values :set symbol value))))
      (t (js-call (get frame :vars) :set symbol value))))

  (defun el-restore-dynamic (session dynamic)
    (let ((index (1- (js-length dynamic))) (values (get session :values)))
      (while (>= index 0)
        (let ((saved (aref dynamic index)))
          (if (not (nil? (aref saved 3)))
              (js-call (aref saved 3) :set (aref saved 0) (aref saved 4))
            (if (aref saved 1)
                (js-call values :set (aref saved 0) (aref saved 2))
              (js-call values :delete (aref saved 0)))))
        (setq index (1- index)))))

  (defun el-lookup-local-function (env symbol)
    (if (or (nil? env) (not (get env :hasFns)))
        nil
      (let ((frame env) (found nil))
        (while (and (nil? found) (not (nil? frame)) (get frame :hasFns))
          (let ((fns (get frame :fns)))
            (when (and (not (nil? fns)) (js-call fns :has symbol)) (setq found (js-call fns :get symbol))))
          (setq frame (get frame :parent)))
        found)))

  (defun el-symbol-function (session symbol)
    (let ((fn (js-call (get session :functions) :get symbol)) (hops 0))
      (while (el-symobj? fn)
        (setq hops (1+ hops))
        (when (> hops 100) (el-signal "cyclic-function-indirection" symbol))
        (setq fn (js-call (get session :functions) :get fn)))
      (if (undefined? fn) nil fn)))

  (defun el-normalize-result (value)
    (if (or (undefined? value) (eq value false)) nil value))

  (defun el-call (session fn args)
    (cond
      ((el-function? fn)
        (let ((direct (get fn :elispCall)))
          (if (undefined? direct)
              (let ((n (js-length args)))
                (el-normalize-result
                 (cond
                   ((= n 0) (funcall fn))
                   ((= n 1) (funcall fn (aref args 0)))
                   ((= n 2) (funcall fn (aref args 0) (aref args 1)))
                   ((= n 3) (funcall fn (aref args 0) (aref args 1) (aref args 2)))
                   (t (Reflect/apply fn nil args)))))
            (let ((n (js-length args)))
              (el-normalize-result
               (cond
                 ((and (= n 1) (not (undefined? (get fn :elispCall1))))
                   (funcall (get fn :elispCall1) (aref args 0)))
                 ((and (= n 2) (not (undefined? (get fn :elispCall2))))
                   (funcall (get fn :elispCall2) (aref args 0) (aref args 1)))
                 ((and (= n 3) (not (undefined? (get fn :elispCall3))))
                   (funcall (get fn :elispCall3) (aref args 0) (aref args 1) (aref args 2)))
                 ((and (= n 0) (not (undefined? (get fn :elispCall0))))
                   (funcall (get fn :elispCall0)))
                 (t (funcall direct args))))))))
      ((el-symobj? fn)
        (let ((target (el-symbol-function session fn)))
          (when (nil? target)
            (if (js-call (get session :macros) :has fn)
                (el-signal "invalid-function" fn)
              (el-signal "void-function" fn)))
          (el-call session target args)))
      ((nil? fn) (el-signal "void-function" nil))
      ((and (el-cons? fn) (eq (get fn :car) s-lambda))
        (el-call session (el-make-lambda session (get fn :cdr) (el-root-env) "lambda") args))
      ((and (el-cons? fn) (eq (get fn :car) s-closure))
        (el-call session (el-make-lambda session (el-cdr (get fn :cdr)) (el-root-env) "closure") args))
      (t (el-signal "invalid-function" fn))))

  (defun el-eval-call-fn (session fn cdr env)
    (let ((direct (get fn :elispCall)))
      (if (undefined? direct)
          (cond
            ((nil? cdr)
              (el-normalize-result (funcall fn)))
            ((nil? (get cdr :cdr))
              (el-normalize-result (funcall fn (el-eval session (get cdr :car) env))))
            ((nil? (get (get cdr :cdr) :cdr))
              (let* ((c1 (get cdr :cdr))
                     (a0 (el-eval session (get cdr :car) env))
                     (a1 (el-eval session (get c1 :car) env)))
                (el-normalize-result (funcall fn a0 a1))))
            ((nil? (get (get (get cdr :cdr) :cdr) :cdr))
              (let* ((c1 (get cdr :cdr))
                     (c2 (get c1 :cdr))
                     (a0 (el-eval session (get cdr :car) env))
                     (a1 (el-eval session (get c1 :car) env))
                     (a2 (el-eval session (get c2 :car) env)))
                (el-normalize-result (funcall fn a0 a1 a2))))
            (t
              (el-normalize-result (Reflect/apply fn nil (el-eval-args session cdr env)))))
        (cond
          ((nil? cdr)
            (let ((c0 (get fn :elispCall0)))
              (el-normalize-result (if (undefined? c0) (funcall direct (js-array)) (funcall c0)))))
          ((nil? (get cdr :cdr))
            (let ((c1 (get fn :elispCall1))
                  (a0 (el-eval session (get cdr :car) env)))
              (el-normalize-result (if (undefined? c1) (funcall direct (js-array a0)) (funcall c1 a0)))))
          ((nil? (get (get cdr :cdr) :cdr))
            (let* ((cdr1 (get cdr :cdr))
                   (c2 (get fn :elispCall2))
                   (a0 (el-eval session (get cdr :car) env))
                   (a1 (el-eval session (get cdr1 :car) env)))
              (el-normalize-result (if (undefined? c2) (funcall direct (js-array a0 a1)) (funcall c2 a0 a1)))))
          ((nil? (get (get (get cdr :cdr) :cdr) :cdr))
            (let* ((cdr1 (get cdr :cdr))
                   (cdr2 (get cdr1 :cdr))
                   (c3 (get fn :elispCall3))
                   (a0 (el-eval session (get cdr :car) env))
                   (a1 (el-eval session (get cdr1 :car) env))
                   (a2 (el-eval session (get cdr2 :car) env)))
              (el-normalize-result (if (undefined? c3) (funcall direct (js-array a0 a1 a2)) (funcall c3 a0 a1 a2)))))
          (t
            (el-normalize-result (funcall direct (el-eval-args session cdr env))))))))

  (defun el-callable (session fn)
    ;; Return a host function invoking Elisp function designator FN.
    (if (el-function? fn) fn (lambda (&rest args) (el-call session fn args))))

  (defun el-eval-body (session forms env)
    (let ((result nil) (index 0) (count (js-length forms)))
      (while (< index count)
        (setq result (el-eval session (aref forms index) env))
        (setq index (1+ index)))
      result))

  (defun el-eval-list-body (session list env)
    (let ((result nil) (cursor list))
      (while (el-cons? cursor)
        (setq result (el-eval session (get cursor :car) env))
        (setq cursor (get cursor :cdr)))
      result))

  (defun el-eval-args (session list env)
    (let ((args (js-array)) (cursor list))
      (while (el-cons? cursor)
        (js-call args :push (el-eval session (get cursor :car) env))
        (setq cursor (get cursor :cdr)))
      args))

  (defun el-eval (session form env)
    (if (or (nil? form) (eq form t)) form
      (let ((kind (get form :kind)))
        (cond
          ((undefined? kind) form)
          ((= kind "symbol") (el-lookup session form env))
          ((= kind "cons") (el-eval-cons session form env))
          (t form)))))

  (defun el-eval-cons (session form env)
    (let ((head (get form :car))
          (cdr (get form :cdr)))
      (if (el-symobj? head)
          (let ((local (if (and (get head :_everLocalFn) (not (nil? env)) (get env :hasFns))
                           (el-lookup-local-function env head)
                         nil)))
            (if (not (nil? local))
                (if (el-function? local)
                    (el-eval-call-fn session local cdr env)
                  (el-call session local (el-eval-args session cdr env)))
              (let ((special (get head :specialForm)))
                (if (not (undefined? special))
                    (funcall special session form env)
                  (let ((inline (get head :_inlineEval)))
                    (if (not (undefined? inline))
                        (funcall inline session cdr env)
                      (if (eq (get head :_cachedSession) session)
                          (el-eval-call-fn session (get head :_cachedFn) cdr env)
                        (let ((macro (js-call (get session :macros) :get head)))
                          (if (not (undefined? macro))
                              (el-eval session (el-expand-macro session macro form env) env)
                            (let ((target (el-symbol-function session head)))
                              (if (el-function? target)
                                  (progn
                                    (put head :_cachedFn target)
                                    (put head :_cachedSession session)
                                    (el-eval-call-fn session target cdr env))
                                (el-call session head (el-eval-args session cdr env)))))))))))))
        (if (and (el-cons? head) (eq (get head :car) s-lambda))
            (el-eval-call-fn session (el-make-lambda session (get head :cdr) env "lambda") cdr env)
          (el-signal "invalid-function" head)))))

  (defun el-expand-macro (session macro form env)
    (el-normalize-result (funcall macro (get form :cdr) env)))

  (defun el-macroexpand-1 (session form env)
    (if (and (el-cons? form) (el-symobj? (get form :car)))
        (let ((macro (js-call (get session :macros) :get (get form :car))))
          (if (undefined? macro) form (el-expand-macro session macro form env)))
      form))

  (defun el-macroexpand (session form env)
    (let ((current form) (done false))
      (while (not done)
        (let ((next (el-macroexpand-1 session current env)))
          (if (eq next current) (setq done t) (setq current next))))
      current))

  ;; Declarations: docstrings, (declare ...) and (interactive ...).
  (defun el-extract-declarations (forms)
    (let ((index 0) (props (new globalThis.Map)) (doc nil) (done false))
      (while (and (not done) (< index (js-length forms)))
        (let ((form (aref forms index)))
          (cond
            ((and (el-string? form) (< (1+ index) (js-length forms)) (nil? doc))
              (setq doc form) (setq index (1+ index)))
            ((and (el-cons? form) (eq (get form :car) s-declare))
              (js-call (el-list-to-array (get form :cdr)) :forEach
                       (lambda (spec)
                         (when (and (el-cons? spec) (eq (get spec :car) s-eliscript))
                           (let ((items (el-list-to-array (get spec :cdr))) (i 0))
                             (while (< i (js-length items))
                               (js-call props :set (el-symbol-name (aref items i)) (aref items (1+ i)))
                               (setq i (+ i 2)))))))
              (setq index (1+ index)))
            ((and (el-cons? form) (eq (get form :car) s-interactive)) (setq index (1+ index)))
            (t (setq done t)))))
      (js-object :props props :doc doc :body (js-call forms :slice index))))

  ;; Lambda lists.
  (defun el-simple-arglist? (arglist)
    (let ((cursor arglist) (simple t))
      (while (and simple (el-cons? cursor))
        (let ((item (get cursor :car)))
          (unless (and (el-symobj? item) (not (eq item s-key)) (not (eq item s-aux))
                       (not (eq item s-allow-other-keys)))
            (setq simple false)))
        (setq cursor (get cursor :cdr)))
      (and simple (nil? cursor))))

  (defun el-parse-arglist (arglist)
    (let ((required (js-array)) (optional (js-array)) (rest nil) (mode "required") (cursor arglist))
      (while (el-cons? cursor)
        (let ((item (get cursor :car)))
          (cond
            ((eq item s-optional) (setq mode "optional"))
            ((or (eq item s-rest) (eq item s-body)) (setq mode "rest"))
            ((= mode "required") (js-call required :push item))
            ((= mode "optional") (js-call optional :push item))
            (t (setq rest item))))
        (setq cursor (get cursor :cdr)))
      (js-object :required required :optional optional :rest rest)))

  (defun el-bind-simple-args (session spec args frame dynamic name)
    (let* ((required (get spec :required)) (optional (get spec :optional))
           (rest (get spec :rest)) (count (js-length args)) (nreq (js-length required))
           (nopt (js-length optional)) (vars (get frame :vars)) (specials (get session :specials)))
      (when (or (< count nreq) (and (nil? rest) (> count (+ nreq nopt))))
        (el-signal "wrong-number-of-arguments" (if (el-string? name) (el-intern name) name) count))
      (let ((index 0))
        (while (< index nreq)
          (let ((sym (aref required index)) (val (el-opt (aref args index))))
            (if (and (get sym :_everSpecial) (js-call specials :has sym))
                (el-bind-variable session frame sym val dynamic)
              (js-call vars :set sym val)))
          (setq index (1+ index)))
        (let ((o 0))
          (while (< o nopt)
            (let ((sym (aref optional o)) (position (+ nreq o)))
              (let ((val (if (< position count) (el-opt (aref args position)) nil)))
                (if (and (get sym :_everSpecial) (js-call specials :has sym))
                    (el-bind-variable session frame sym val dynamic)
                  (js-call vars :set sym val))))
            (setq o (1+ o))))
        (unless (nil? rest)
          (let ((val (el-list-from (js-call args :slice (+ nreq nopt)))))
            (if (and (get rest :_everSpecial) (js-call specials :has rest))
                (el-bind-variable session frame rest val dynamic)
              (js-call vars :set rest val)))))))

  (defun el-destructure (session pattern value frame dynamic)
    ;; Full CL lambda-list destructuring of VALUE (an Elisp list) by PATTERN.
    (cond
      ((nil? pattern) nil)
      ((el-symobj? pattern) (el-bind-variable session frame pattern value dynamic))
      ((el-vector? pattern)
        (let ((items (get pattern :items)) (index 0))
          (while (< index (js-length items))
            (el-destructure session (aref items index) (el-aref value index) frame dynamic)
            (setq index (1+ index)))))
      (t
        (let ((cursor pattern) (rest-value value) (mode "required") (keys-seen false))
          (while (el-cons? cursor)
            (let ((item (get cursor :car)))
              (cond
                ((eq item s-optional) (setq mode "optional"))
                ((or (eq item s-rest) (eq item s-body)) (setq mode "rest"))
                ((eq item s-key) (setq mode "key") (setq keys-seen t))
                ((eq item s-aux) (setq mode "aux"))
                ((eq item s-allow-other-keys) nil)
                ((= mode "required")
                  (when (and (nil? rest-value) false) nil)
                  (el-destructure session item (el-car-safe rest-value) frame dynamic)
                  (setq rest-value (el-cdr-safe rest-value)))
                ((= mode "optional")
                  (let* ((var (if (el-cons? item) (get item :car) item))
                         (default (if (el-cons? item) (el-nth 1 item) nil))
                         (svar (if (el-cons? item) (el-nth 2 item) nil))
                         (present (el-cons? rest-value)))
                    (el-destructure session var
                                    (if present (get rest-value :car) (el-eval session default frame))
                                    frame dynamic)
                    (unless (nil? svar) (el-bind-variable session frame svar (el-bool present) dynamic))
                    (setq rest-value (el-cdr-safe rest-value))))
                ((= mode "rest") (el-destructure session item rest-value frame dynamic))
                ((= mode "key")
                  (let* ((spec (if (el-cons? item) (get item :car) item))
                         (var (if (el-cons? spec) (el-nth 1 spec) spec))
                         (keyword (if (el-cons? spec) (get spec :car) (el-intern (str ":" (el-symbol-name var)))))
                         (default (if (el-cons? item) (el-nth 1 item) nil))
                         (svar (if (el-cons? item) (el-nth 2 item) nil))
                         (cell (el-plist-member rest-value keyword el-eq-test)))
                    (el-destructure session var
                                    (if (nil? cell) (el-eval session default frame) (el-car-safe (get cell :cdr)))
                                    frame dynamic)
                    (unless (nil? svar) (el-bind-variable session frame svar (el-bool (not (nil? cell))) dynamic))))
                ((= mode "aux")
                  (let ((var (if (el-cons? item) (get item :car) item))
                        (init (if (el-cons? item) (el-nth 1 item) nil)))
                    (el-bind-variable session frame var (el-eval session init frame) dynamic)))))
            (setq cursor (get cursor :cdr)))
          (when (and (not (nil? cursor)) (el-symobj? cursor))
            (el-bind-variable session frame cursor rest-value dynamic))))))

  (defun el-eq-test (a b) (not (nil? (el-eq a b))))
  (defun el-eql-test (a b) (not (nil? (el-eql a b))))
  (defun el-equal-test (a b) (el-equal-p a b 0))

  (defun el-make-lambda (session spec-and-body env name)
    (let ((cached (if (el-cons? spec-and-body) (get spec-and-body :_compiledLambda) undefined)))
      (when (undefined? cached)
        (let* ((arglist (el-car spec-and-body))
               (extracted (el-extract-declarations (el-list-to-array (el-cdr spec-and-body))))
               (body (get extracted :body))
               (simple (el-simple-arglist? arglist))
               (spec (if simple (el-parse-arglist arglist) nil))
               (props (get extracted :props))
               (contracts (or (js-call props :has ":requires") (js-call props :has ":ensures"))))
          (setq cached (js-object :arglist arglist :spec spec :body body :props (if contracts props nil)))
          (when (el-cons? spec-and-body) (put spec-and-body :_compiledLambda cached))))
      (let* ((arglist (get cached :arglist))
             (spec (get cached :spec))
             (body (get cached :body))
             (cprops (get cached :props))
             (fn (lambda (&rest args)
                   (el-apply-closure session arglist spec body env args name cprops))))
        (put fn :elispName name)
        (put fn :elispArglist arglist)
        (put fn :elispCall
             (lambda (args)
               (el-apply-closure session arglist spec body env args name cprops)))
        (when (and (not (nil? spec)) (nil? cprops) (nil? (get spec :rest)))
          (let* ((req (get spec :required))
                 (opt (get spec :optional))
                 (nreq (js-length req))
                 (nopt (js-length opt))
                 (ntot (+ nreq nopt)))
            (when (= nreq 0)
              (if (= nopt 0)
                  (put fn :elispCall0 (lambda () (el-eval-body session body env)))
                (put fn :elispCall0
                     (lambda () (el-apply-closure session arglist spec body env (js-array) name cprops)))))
            (when (and (<= nreq 1) (>= ntot 1))
              (if (= ntot 1)
                  (let ((p0 (if (= nreq 1) (aref req 0) (aref opt 0))))
                    (put fn :elispCall1
                         (lambda (a0)
                           (if (and (get p0 :_everSpecial) (js-call (get session :specials) :has p0))
                               (el-apply-closure session arglist spec body env (js-array a0) name cprops)
                             (let ((frame (el-new-env env)))
                               (js-call (get frame :vars) :set p0 (el-opt a0))
                               (el-eval-body session body frame))))))
                (when (= ntot 2)
                  (let ((p0 (if (= nreq 1) (aref req 0) (aref opt 0)))
                        (p1 (aref opt (- 1 nreq))))
                    (put fn :elispCall1
                         (lambda (a0)
                           (if (or (and (get p0 :_everSpecial) (js-call (get session :specials) :has p0))
                                   (and (get p1 :_everSpecial) (js-call (get session :specials) :has p1)))
                               (el-apply-closure session arglist spec body env (js-array a0) name cprops)
                             (let* ((frame (el-new-env env)) (vars (get frame :vars)))
                               (js-call vars :set p0 (el-opt a0))
                               (js-call vars :set p1 nil)
                               (el-eval-body session body frame)))))))))
            (when (and (<= nreq 2) (= ntot 2))
              (let ((p0 (if (>= nreq 1) (aref req 0) (aref opt 0)))
                    (p1 (if (= nreq 2) (aref req 1) (aref opt (- 1 nreq)))))
                (put fn :elispCall2
                     (lambda (a0 a1)
                       (if (or (and (get p0 :_everSpecial) (js-call (get session :specials) :has p0))
                               (and (get p1 :_everSpecial) (js-call (get session :specials) :has p1)))
                           (el-apply-closure session arglist spec body env (js-array a0 a1) name cprops)
                         (let* ((frame (el-new-env env)) (vars (get frame :vars)))
                           (js-call vars :set p0 (el-opt a0))
                           (js-call vars :set p1 (el-opt a1))
                           (el-eval-body session body frame)))))))
            (when (and (<= nreq 3) (= ntot 3))
              (let ((p0 (if (>= nreq 1) (aref req 0) (aref opt 0)))
                    (p1 (if (>= nreq 2) (aref req 1) (aref opt (- 1 nreq))))
                    (p2 (if (= nreq 3) (aref req 2) (aref opt (- 2 nreq)))))
                (put fn :elispCall3
                     (lambda (a0 a1 a2)
                       (if (or (and (get p0 :_everSpecial) (js-call (get session :specials) :has p0))
                               (and (get p1 :_everSpecial) (js-call (get session :specials) :has p1))
                               (and (get p2 :_everSpecial) (js-call (get session :specials) :has p2)))
                           (el-apply-closure session arglist spec body env (js-array a0 a1 a2) name cprops)
                         (let* ((frame (el-new-env env)) (vars (get frame :vars)))
                           (js-call vars :set p0 (el-opt a0))
                           (js-call vars :set p1 (el-opt a1))
                           (js-call vars :set p2 (el-opt a2))
                           (el-eval-body session body frame)))))))))
        fn)))

  (defun el-apply-closure (session arglist spec body env args name props)
    (if (and (not (nil? spec)) (nil? props) (nil? arglist) (= (js-length args) 0))
        (el-eval-body session body env)
      (let ((frame (el-new-env env)) (dynamic (js-array)))
        (if (nil? spec)
            (el-destructure session arglist (el-list-from args) frame dynamic)
          (el-bind-simple-args session spec args frame dynamic name))
        (if (and (= (js-length dynamic) 0) (nil? props))
            (el-eval-body session body frame)
          (try
            (progn
              (unless (nil? props) (el-check-requires session props frame name))
              (let ((result (el-eval-body session body frame)))
                (unless (nil? props) (el-check-ensures session props frame result name))
                result))
            (finally (el-restore-dynamic session dynamic)))))))

  (defun el-check-requires (session props frame name)
    (when (js-call props :has ":requires")
      (js-call (el-list-to-array (js-call props :get ":requires")) :forEach
               (lambda (form)
                 (when (nil? (el-eval session form frame))
                   (el-signal "eliscript-runtime-contract-error" (str "Precondition failed in " name)))))))

  (defun el-check-ensures (session props frame result name)
    (when (js-call props :has ":ensures")
      (js-call (get frame :vars) :set (el-intern "result") result)
      (js-call (el-list-to-array (js-call props :get ":ensures")) :forEach
               (lambda (form)
                 (when (nil? (el-eval session form frame))
                   (el-signal "eliscript-runtime-contract-error" (str "Postcondition failed in " name)))))))

  (defun el-make-macro (session arglist body env name)
    (lambda (forms call-env)
      (let ((frame (el-new-env env)) (dynamic (js-array)))
        (el-destructure session arglist forms frame dynamic)
        (try (el-eval-body session body frame)
          (finally (el-restore-dynamic session dynamic))))))

  ;; Backquote with nesting levels, splicing, vectors and dotted tails.
  (defun el-backquote (session form env level)
    (cond
      ((el-vector? form)
        (let ((expanded (el-backquote session (el-list-from (get form :items)) env level)))
          (el-vector (el-list-to-array expanded))))
      ((not (el-cons? form)) form)
      ((eq (get form :car) s-comma)
        (if (= level 1)
            (el-eval session (el-car (get form :cdr)) env)
          (el-list s-comma (el-backquote session (el-car (get form :cdr)) env (1- level)))))
      ((eq (get form :car) s-backquote)
        (el-list s-backquote (el-backquote session (el-car (get form :cdr)) env (1+ level))))
      (t
        (let ((items (js-array)) (cursor form) (tail nil) (done false))
          (while (not done)
            (cond
              ((nil? cursor) (setq done t))
              ((not (el-cons? cursor)) (setq tail (el-backquote session cursor env level)) (setq done t))
              ((eq (get cursor :car) s-comma)
                ;; dotted unquote: (a . ,b)
                (setq tail (el-backquote session cursor env level))
                (setq done t))
              (t
                (let ((item (get cursor :car)))
                  (if (and (el-cons? item) (eq (get item :car) s-comma-at) (= level 1))
                      (js-call (el-seq-items (el-eval session (el-car (get item :cdr)) env)) :forEach
                               (lambda (x) (js-call items :push x)))
                    (js-call items :push (el-backquote session item env level))))
                (setq cursor (get cursor :cdr)))))
          (el-list-from items tail)))))

  (defun el-function-designator (session target env)
    ;; (function X): lexical functions and lambdas become closures, symbols stay.
    (cond
      ((el-symobj? target)
        (let ((local (el-lookup-local-function env target)))
          (if (nil? local) target local)))
      ((and (el-cons? target) (eq (get target :car) s-lambda))
        (el-make-lambda session (get target :cdr) env "lambda"))
      (t target)))

  ;; ------------------------------------------------------------------
  ;; Special forms
  ;; ------------------------------------------------------------------

  (defun el-args (form) (el-list-to-array (get form :cdr)))
  (defun el-second (form) (el-car (get form :cdr)))
  (defun el-third (form) (el-car (el-cdr (get form :cdr))))
  (defun el-rest-after (form n) (el-nthcdr (1+ n) form))

  (defun sf-quote (session form env) (el-second form))
  (defun sf-function (session form env) (el-function-designator session (el-second form) env))
  (defun sf-backquote (session form env) (el-backquote session (el-second form) env 1))
  (defun sf-progn (session form env) (el-eval-list-body session (get form :cdr) env))
  (defun sf-prog1 (session form env)
    (let ((value (el-eval session (el-second form) env)))
      (el-eval-list-body session (el-rest-after form 1) env)
      value))
  (defun sf-prog2 (session form env)
    (el-eval session (el-second form) env)
    (let ((value (el-eval session (el-third form) env)))
      (el-eval-list-body session (el-rest-after form 2) env)
      value))
  (defun sf-if (session form env)
    (if (el-eval session (el-second form) env)
        (el-eval session (el-third form) env)
      (el-eval-list-body session (el-rest-after form 2) env)))
  (defun sf-when (session form env)
    (if (el-eval session (el-second form) env) (el-eval-list-body session (el-rest-after form 1) env) nil))
  (defun sf-unless (session form env)
    (if (el-eval session (el-second form) env) nil (el-eval-list-body session (el-rest-after form 1) env)))
  (defun sf-and (session form env)
    (let ((result t) (cursor (get form :cdr)))
      (while (and (el-cons? cursor) (not (nil? result)))
        (setq result (el-eval session (get cursor :car) env))
        (setq cursor (get cursor :cdr)))
      result))
  (defun sf-or (session form env)
    (let ((result nil) (cursor (get form :cdr)))
      (while (and (el-cons? cursor) (nil? result))
        (setq result (el-eval session (get cursor :car) env))
        (setq cursor (get cursor :cdr)))
      result))
  (defun sf-cond (session form env)
    (let ((cursor (get form :cdr)) (result nil) (done false))
      (while (and (not done) (el-cons? cursor))
        (let* ((clause (get cursor :car))
               (test (el-eval session (el-car clause) env)))
          (unless (nil? test)
            (setq done t)
            (setq result (if (nil? (el-cdr clause)) test (el-eval-list-body session (el-cdr clause) env)))))
        (setq cursor (get cursor :cdr)))
      result))
  (defun sf-while (session form env)
    (let ((test (el-second form)) (body (el-rest-after form 1)))
      (while (el-eval session test env)
        (el-eval-list-body session body env))
      nil))

  (defun el-eval-let (session bindings body env sequential const)
    (let* ((frame (el-new-env env))
           (dynamic nil)
           (pending nil)
           (specials (get session :specials))
           (vars (get frame :vars))
           (cursor bindings))
      (when const (put frame :consts (new globalThis.Set)))
      (while (el-cons? cursor)
        (let* ((binding (get cursor :car))
               (symbol (if (el-cons? binding) (get binding :car) binding))
               (init (if (el-cons? binding) (el-car (get binding :cdr)) nil))
               (is-special (and (get symbol :_everSpecial) (js-call specials :has symbol))))
          (when (and const is-special)
            (el-compile-error (str "ELI-C0011: let-const cannot bind special variable " (get symbol :name))))
          (let ((value (el-eval session init (if sequential frame env))))
            (cond
              ((not is-special)
                (when (or (nil? symbol) (eq symbol t)) (el-signal "setting-constant" symbol))
                (js-call vars :set symbol value)
                (when const (js-call (get frame :consts) :add symbol)))
              (sequential
                (when (nil? dynamic) (setq dynamic (js-array)))
                (el-bind-variable session frame symbol value dynamic))
              (t
                (when (nil? pending) (setq pending (js-array)))
                (js-call pending :push (js-array symbol value))))))
        (setq cursor (get cursor :cdr)))
      (unless (nil? pending)
        (when (nil? dynamic) (setq dynamic (js-array)))
        (js-call pending :forEach
                 (lambda (pair)
                   (el-bind-variable session frame (aref pair 0) (aref pair 1) dynamic))))
      (if (nil? dynamic)
          (el-eval-list-body session body frame)
        (try (el-eval-list-body session body frame)
          (finally (el-restore-dynamic session dynamic))))))

  (defun sf-let (session form env)
    (el-eval-let session (el-second form) (el-rest-after form 1) env false false))
  (defun sf-let* (session form env)
    (el-eval-let session (el-second form) (el-rest-after form 1) env t false))
  (defun sf-let-const (session form env)
    (el-eval-let session (el-second form) (el-rest-after form 1) env false t))
  (defun sf-let*-const (session form env)
    (el-eval-let session (el-second form) (el-rest-after form 1) env t t))

  (defun sf-setq (session form env)
    (let ((cursor (get form :cdr)) (value nil))
      (while (el-cons? cursor)
        (let ((symbol (get cursor :car)))
          (setq value (el-eval session (el-car (get cursor :cdr)) env))
          (el-set-variable session symbol value env))
        (setq cursor (el-cdr (get cursor :cdr))))
      value))

  (defun sf-setq-local (session form env)
    (let ((cursor (get form :cdr)) (value nil) (buf (el-current-buffer session)))
      (while (el-cons? cursor)
        (let ((symbol (get cursor :car)))
          (setq value (el-eval session (el-car (get cursor :cdr)) env))
          (el-add-special-var session symbol)
          (js-call (get buf :locals) :set symbol value))
        (setq cursor (el-cdr (get cursor :cdr))))
      value))

  (defun sf-setq-default (session form env)
    (let ((cursor (get form :cdr)) (value nil))
      (while (el-cons? cursor)
        (let ((symbol (get cursor :car)))
          (setq value (el-eval session (el-car (get cursor :cdr)) env))
          (el-add-special-var session symbol)
          (js-call (get session :values) :set symbol value))
        (setq cursor (el-cdr (get cursor :cdr))))
      value))

  (defun sf-defvar (session form env)
    (let ((symbol (el-second form)) (rest (el-rest-after form 1)))
      (el-add-special-var session symbol)
      (when (and (el-cons? rest) (not (js-call (get session :values) :has symbol)))
        (js-call (get session :values) :set symbol (el-eval session (get rest :car) env)))
      symbol))

  (defun sf-defvar-local (session form env)
    (let ((symbol (sf-defvar session form env)))
      (js-call (get session :localVars) :add symbol)
      symbol))
  (defun sf-defconst (session form env)
    (let ((symbol (el-second form)))
      (el-add-special-var session symbol)
      (js-call (get session :values) :set symbol (el-eval session (el-third form) env))
      symbol))
  (defun sf-ignore-definition (session form env) (el-second form))

  (defun el-define-function (session name fn)
    (js-call (get session :userDefinedFns) :add (el-symbol-name name))
    (js-call (get session :macros) :delete name)
    (el-set-fn session name fn)
    name)

  (defun el-validate-defun (session kind name props body arglist)
    (let ((label (el-symbol-name name)))
      (when (= kind "defun")
        (when (eq (js-call props :get ":async") t)
          (el-compile-error (str "ELI-D0001: ordinary defun " label " cannot declare :async t; use defun-async")))
        (when (eq (js-call props :get ":destructure") t)
          (el-compile-error (str "ELI-D0002: ordinary defun " label " cannot declare :destructure t; use defun-bind")))
        (when (and (js-call (get session :activeLibs) :has "eliscript-async")
                   (el-scan-heads body (js-array "await") t))
          (el-compile-error (str "ELI-A0001: await is forbidden in sync defun " label))))
      (when (eq (js-call props :get ":portable") t)
        (let ((bad (el-scan-heads body (js-array "current-buffer" "set-buffer" "with-current-buffer") false)))
          (when bad (el-compile-error (str "ELI-C0002: non-portable operator " bad " in " label)))))
      (when (js-call props :has ":abi")
        (let ((abi (js-call props :get ":abi")))
          (when (el-sym-is abi ":numeric-f64")
            (let ((bad (el-scan-heads body (js-array "list" "cons" "vector" "persistent-list" "make-string") false)))
              (when bad (el-compile-error (str "ELI-B0001: heap allocation " bad " forbidden in :numeric-f64 " label)))))))))

  (defun el-scan-heads (forms names stop-at-lambda)
    (let ((found nil) (index 0))
      (while (and (nil? found) (< index (js-length forms)))
        (let ((form (aref forms index)))
          (when (el-cons? form)
            (let ((head (get form :car)))
              (cond
                ((eq head s-quote) nil)
                ((and (el-symobj? head) (js-call names :includes (get head :name))) (setq found (get head :name)))
                ((and stop-at-lambda (or (eq head s-lambda) (el-sym-is head "defun"))) nil)
                (t (let ((inner (el-scan-heads (el-seq-items-safe form) names stop-at-lambda)))
                     (unless (nil? inner) (setq found inner))))))))
        (setq index (1+ index)))
      found))

  (defun el-seq-items-safe (form)
    (let ((out (js-array)) (cursor form))
      (while (el-cons? cursor) (js-call out :push (get cursor :car)) (setq cursor (get cursor :cdr)))
      out))

  (defun sf-defun (session form env)
    (let* ((name (el-second form))
           (rest (el-rest-after form 1))
           (extracted (el-extract-declarations (el-list-to-array (el-cdr rest)))))
      (el-validate-defun session "defun" name (get extracted :props) (get extracted :body) (el-car rest))
      (el-define-function session name (el-make-lambda session rest env (el-symbol-name name)))))

  (defun sf-lambda (session form env)
    (el-make-lambda session (get form :cdr) env "lambda"))

  (defun sf-defmacro (session form env)
    (let* ((name (el-second form))
           (arglist (el-third form))
           (extracted (el-extract-declarations (el-list-to-array (el-rest-after form 2)))))
      (el-set-macro session name
                    (el-make-macro session arglist (get extracted :body) env (el-symbol-name name)))
      name))

  (defun sf-cl-defun (session form env)
    (let* ((name (el-second form))
           (arglist (el-third form))
           (extracted (el-extract-declarations (el-list-to-array (el-rest-after form 2))))
           (body (get extracted :body))
           (label (el-symbol-name name)))
      (el-define-function session name
        (let ((fn (lambda (&rest args)
                    (let ((frame (el-new-env env)) (dynamic (js-array)))
                      (el-destructure session arglist (el-list-from args) frame dynamic)
                      (try (el-catch-block session (el-intern label)
                                           (lambda () (el-eval-body session body frame)))
                        (finally (el-restore-dynamic session dynamic)))))))
          (put fn :elispName label)
          fn))))

  (defun sf-catch (session form env)
    (let ((tag (el-eval session (el-second form) env)))
      (try (el-eval-list-body session (el-rest-after form 1) env)
        (catch error
          (if (and (not (nullish? error)) (get error :eliscriptThrow) (eq (get error :tag) tag))
              (get error :value)
            (throw error))))))

  (defun el-throw (tag value)
    (throw (js-object :eliscriptThrow t :tag tag :value value)))

  (defun el-catch-block (session tag thunk)
    (try (funcall thunk)
      (catch error
        (if (and (not (nullish? error)) (get error :eliscriptThrow) (eq (get error :tag) tag)
                 (get error :clBlock))
            (get error :value)
          (throw error)))))

  (defun sf-unwind-protect (session form env)
    (try (el-eval session (el-second form) env)
      (finally (el-eval-list-body session (el-rest-after form 1) env))))

  (defun el-handler-conditions (spec)
    (cond ((el-cons? spec) (js-call (el-list-to-array spec) :map (lambda (s) (el-symbol-name s))))
          (t (js-array (el-symbol-name spec)))))

  (defun sf-condition-case (session form env)
    (let ((variable (el-second form))
          (body (el-third form))
          (handlers (el-list-to-array (el-rest-after form 2))))
      (let ((success (js-call handlers :find (lambda (h) (el-sym-is (el-car h) ":success")))))
        (try
          (let ((value (el-eval session body env)))
            (if (undefined? success) value
              (let ((frame (el-new-env env)))
                (unless (nil? variable) (js-call (get frame :vars) :set variable value))
                (el-eval-list-body session (el-cdr success) frame))))
          (catch raw
            (when (el-control-transfer? raw) (throw raw))
            (let* ((signal (el-error-from-host raw))
                   (condition (get signal :conditionSymbol))
                   (handler (js-call handlers :find
                                     (lambda (h)
                                       (and (not (el-sym-is (el-car h) ":success"))
                                            (js-call (el-handler-conditions (el-car h)) :some
                                                     (lambda (c) (or (and (= c "debug") false)
                                                                     (el-condition-matches session condition c)))))))))
              (when (undefined? handler) (throw raw))
              (let ((frame (el-new-env env)))
                (unless (nil? variable)
                  (js-call (get frame :vars) :set variable
                           (el-cons (el-intern condition) (el-list-from (get signal :data)))))
                (el-eval-list-body session (el-cdr handler) frame))))))))

  (defun sf-ignore-errors (session form env)
    (try (el-eval-list-body session (get form :cdr) env)
      (catch raw
        (when (el-control-transfer? raw) (throw raw))
        (let ((signal (el-error-from-host raw)))
          (if (el-condition-matches session (get signal :conditionSymbol) "error") nil (throw raw))))))

  (defun sf-ignore-error (session form env)
    (let ((conditions (el-handler-conditions (el-second form))))
      (try (el-eval-list-body session (el-rest-after form 1) env)
        (catch raw
          (when (el-control-transfer? raw) (throw raw))
          (let ((signal (el-error-from-host raw)))
            (if (js-call conditions :some (lambda (c) (el-condition-matches session (get signal :conditionSymbol) c)))
                nil
              (throw raw)))))))

  (defun sf-save-match-data (session form env)
    (let ((saved (get session :matchData)))
      (try (el-eval-list-body session (get form :cdr) env)
        (finally (put session :matchData saved)))))

  (defun sf-save-excursion (session form env)
    (let* ((buffer (el-current-buffer session)) (point (get buffer :point)))
      (try (el-eval-list-body session (get form :cdr) env)
        (finally
          (put session :currentBuffer buffer)
          (put buffer :point (el-clamp-position buffer point))))))

  (defun sf-save-current-buffer (session form env)
    (let ((buffer (el-current-buffer session)))
      (try (el-eval-list-body session (get form :cdr) env)
        (finally (when (get buffer :live) (put session :currentBuffer buffer))))))

  (defun sf-with-temp-buffer (session form env)
    (let ((previous (get session :currentBuffer))
          (buffer (el-generate-new-buffer session " *temp*")))
      (put session :currentBuffer buffer)
      (try (el-eval-list-body session (get form :cdr) env)
        (finally
          (el-kill-buffer session buffer)
          (put session :currentBuffer previous)))))

  (defun sf-with-temp-file (session form env)
    (let* ((file (el-eval session (el-second form) env))
           (previous (get session :currentBuffer))
           (buffer (el-generate-new-buffer session " *temp file*")))
      (put session :currentBuffer buffer)
      (try
        (let ((res (el-eval-list-body session (el-rest-after form 1) env)))
          (el-call session (el-intern "write-region")
                   (js-array 1 (el-point-max buffer) file nil (el-intern "silent")))
          res)
        (finally
          (el-kill-buffer session buffer)
          (put session :currentBuffer previous)))))

  (defun sf-with-timeout (session form env)
    (let* ((spec (el-second form))
           (seconds-form (el-car spec))
           (timeout-forms (el-cdr spec))
           (seconds (el-num (el-eval session seconds-form env)))
           (deadline (+ (/ (js-call globalThis.Date :now) 1000) seconds))
           (prev-deadline (get session :timeoutDeadline)))
      (put session :timeoutDeadline
           (if (and (not (nullish? prev-deadline)) (< prev-deadline deadline))
               prev-deadline
             deadline))
      (try
        (el-eval-list-body session (el-rest-after form 1) env)
        (catch err
          (if (and (not (nullish? err)) (get err :eliscriptTimeout) (= (get err :deadline) deadline))
              (el-eval-list-body session timeout-forms env)
            (throw err)))
        (finally
          (put session :timeoutDeadline prev-deadline)))))

  (defun sf-with-current-buffer (session form env)
    (let* ((previous (get session :currentBuffer))
           (designator (el-eval session (el-second form) env))
           (buffer (if (el-string? designator) (el-get-buffer-create session designator) designator)))
      (put session :currentBuffer buffer)
      (try (el-eval-list-body session (el-rest-after form 1) env)
        (finally (put session :currentBuffer previous)))))

  (defun sf-with-output-to-string (session form env)
    (let ((saved (get session :output)))
      (put session :output (js-array))
      (try (progn (el-eval-list-body session (get form :cdr) env)
                  (js-call (get session :output) :join ""))
        (finally (put session :output saved)))))

  (defun sf-dolist (session form env)
    (let* ((spec (el-second form))
           (variable (el-car spec))
           (cursor (el-eval session (el-car (el-cdr spec)) env))
           (result-form (el-car (el-cdr (el-cdr spec))))
           (body (el-rest-after form 1))
           (is-special (and (get variable :_everSpecial) (js-call (get session :specials) :has variable))))
      (if (not is-special)
          (progn
            (while (el-cons? cursor)
              (let ((iter-frame (el-new-env env)))
                (js-call (get iter-frame :vars) :set variable (el-opt (get cursor :car)))
                (el-eval-list-body session body iter-frame))
              (setq cursor (get cursor :cdr)))
            (if (nil? result-form)
                nil
              (let ((res-frame (el-new-env env)))
                (js-call (get res-frame :vars) :set variable nil)
                (el-eval session result-form res-frame))))
        (progn
          (while (el-cons? cursor)
            (let ((iter-frame (el-new-env env))
                  (iter-dynamic (js-array)))
              (try
                (progn
                  (el-bind-variable session iter-frame variable (get cursor :car) iter-dynamic)
                  (el-eval-list-body session body iter-frame))
                (finally (el-restore-dynamic session iter-dynamic))))
            (setq cursor (get cursor :cdr)))
          (if (nil? result-form)
              nil
            (let ((res-frame (el-new-env env))
                  (res-dynamic (js-array)))
              (try
                (progn
                  (el-bind-variable session res-frame variable nil res-dynamic)
                  (el-eval session result-form res-frame))
                (finally (el-restore-dynamic session res-dynamic)))))))))

  (defun sf-dotimes (session form env)
    (let* ((spec (el-second form))
           (variable (el-car spec))
           (count (el-num (el-eval session (el-car (el-cdr spec)) env)))
           (result-form (el-car (el-cdr (el-cdr spec))))
           (body (el-rest-after form 1))
           (is-special (and (get variable :_everSpecial) (js-call (get session :specials) :has variable)))
           (index 0))
      (if (not is-special)
          (progn
            (while (< index count)
              (let ((iter-frame (el-new-env env)))
                (js-call (get iter-frame :vars) :set variable index)
                (el-eval-list-body session body iter-frame))
              (setq index (1+ index)))
            (if (nil? result-form)
                nil
              (let ((res-frame (el-new-env env)))
                (js-call (get res-frame :vars) :set variable count)
                (el-eval session result-form res-frame))))
        (progn
          (while (< index count)
            (let ((iter-frame (el-new-env env))
                  (iter-dynamic (js-array)))
              (try
                (progn
                  (el-bind-variable session iter-frame variable index iter-dynamic)
                  (el-eval-list-body session body iter-frame))
                (finally (el-restore-dynamic session iter-dynamic))))
            (setq index (1+ index)))
          (if (nil? result-form)
              nil
            (let ((res-frame (el-new-env env))
                  (res-dynamic (js-array)))
              (try
                (progn
                  (el-bind-variable session res-frame variable count res-dynamic)
                  (el-eval session result-form res-frame))
                (finally (el-restore-dynamic session res-dynamic)))))))))

  (defun sf-seq-doseq (session form env)
    (let* ((spec (el-second form))
           (variable (el-car spec))
           (items (el-seq-items (el-eval session (el-car (el-cdr spec)) env)))
           (body (el-rest-after form 1))
           (is-special (and (get variable :_everSpecial) (js-call (get session :specials) :has variable))))
      (if (not is-special)
          (let ((i 0) (n (js-length items)))
            (while (< i n)
              (let ((iter-frame (el-new-env env)))
                (js-call (get iter-frame :vars) :set variable (el-opt (aref items i)))
                (el-eval-list-body session body iter-frame))
              (setq i (1+ i))))
        (js-call items :forEach
                 (lambda (item)
                   (let ((iter-frame (el-new-env env))
                         (iter-dynamic (js-array)))
                     (try
                       (progn
                         (el-bind-variable session iter-frame variable item iter-dynamic)
                         (el-eval-list-body session body iter-frame))
                       (finally (el-restore-dynamic session iter-dynamic)))))))
      nil))

  ;; when-let / if-let family (single-symbol and (EXPR) guard bindings).
  (defun el-let-guards (session spec env)
    ;; Return the frame when every binding is non-nil, else nil.
    (let ((frame (el-new-env env))
          (bindings (if (and (el-cons? spec) (el-symobj? (get spec :car)) (not (nil? (get spec :car))))
                        (el-list spec)
                      spec))
          (ok t))
      (let ((cursor bindings))
        (while (and ok (el-cons? cursor))
          (let* ((binding (get cursor :car))
                 (value (cond
                          ((el-symobj? binding) (el-eval session binding frame))
                          ((nil? (el-cdr binding)) (el-eval session (get binding :car) frame))
                          (t (el-eval session (el-car (get binding :cdr)) frame)))))
            (if (nil? value) (setq ok false)
              (when (and (el-cons? binding) (not (nil? (el-cdr binding))))
                (js-call (get frame :vars) :set (get binding :car) value))))
          (setq cursor (get cursor :cdr))))
      (if ok frame nil)))

  (defun sf-when-let (session form env)
    (let ((frame (el-let-guards session (el-second form) env)))
      (if (nil? frame) nil (el-eval-list-body session (el-rest-after form 1) frame))))
  (defun sf-if-let (session form env)
    (let ((frame (el-let-guards session (el-second form) env)))
      (if (nil? frame) (el-eval-list-body session (el-rest-after form 2) env)
        (el-eval session (el-third form) frame))))
  (defun sf-and-let (session form env)
    (let ((frame (el-let-guards session (el-second form) env)))
      (cond ((nil? frame) nil)
            ((nil? (el-rest-after form 1)) t)
            (t (el-eval-list-body session (el-rest-after form 1) frame)))))
  (defun sf-while-let (session form env)
    (let ((running t))
      (while running
        (let ((frame (el-let-guards session (el-second form) env)))
          (if (nil? frame) (setq running false)
            (el-eval-list-body session (el-rest-after form 1) frame))))
      nil))

  (defun sf-cl-case (session form env)
    (let ((value (el-eval session (el-second form) env))
          (cursor (el-rest-after form 1))
          (result nil)
          (done false))
      (while (and (not done) (el-cons? cursor))
        (let* ((clause (get cursor :car)) (keys (el-car clause)))
          (when (or (eq keys t) (eq keys s-otherwise)
                    (if (el-cons? keys)
                        (not (nil? (el-member-with value keys el-eql-test)))
                      (el-eql-test value keys)))
            (setq done t)
            (setq result (el-eval-list-body session (el-cdr clause) env))))
        (setq cursor (get cursor :cdr)))
      (when (and (not done) (el-sym-is (get form :car) "cl-ecase"))
        (el-signal "error" (str "cl-ecase failed: " (el-prin1-string value t))))
      result))

  (defun sf-cl-block (session form env)
    (let ((name (el-second form)))
      (el-catch-block session name (lambda () (el-eval-list-body session (el-rest-after form 1) env)))))
  (defun sf-cl-return-from (session form env)
    (let ((error (js-object :eliscriptThrow t :clBlock t :tag (el-second form)
                            :value (el-eval session (el-third form) env))))
      (throw error)))
  (defun sf-cl-return (session form env)
    (throw (js-object :eliscriptThrow t :clBlock t :tag nil :value (el-eval session (el-second form) env))))
  (defun sf-cl-dolist (session form env)
    (el-catch-block session nil (lambda () (sf-dolist session form env))))

  (defun sf-cl-flet (session form env)
    (let ((frame (el-new-env env)) (cursor (el-second form)))
      (put frame :fns (new globalThis.Map))
      (put frame :hasFns t)
      (while (el-cons? cursor)
        (let* ((binding (get cursor :car))
               (name (get binding :car))
               (rest (get binding :cdr)))
          (put name :_everLocalFn t)
          (js-call (get frame :fns) :set name
                   (if (and (el-cons? rest) (nil? (el-cdr rest)))
                       (el-callable session (el-eval session (el-car rest) env))
                     (el-make-cl-lambda session rest env (el-symbol-name name)))))
        (setq cursor (get cursor :cdr)))
      (el-eval-list-body session (el-rest-after form 1) frame)))

  (defun sf-cl-labels (session form env)
    (let ((frame (el-new-env env)) (cursor (el-second form)))
      (put frame :fns (new globalThis.Map))
      (put frame :hasFns t)
      (while (el-cons? cursor)
        (let* ((binding (get cursor :car))
               (name (get binding :car)))
          (put name :_everLocalFn t)
          (js-call (get frame :fns) :set name
                   (el-make-cl-lambda session (get binding :cdr) frame (el-symbol-name name))))
        (setq cursor (get cursor :cdr)))
      (el-eval-list-body session (el-rest-after form 1) frame)))

  (defun sf-cl-letf (session form env)
    (let* ((sequential (el-sym-is (get form :car) "cl-letf*"))
           (bindings (el-list-to-array (el-second form)))
           (frame (el-new-env env))
           (dynamic (js-array))
           (restores (js-array))
           (pending (js-array)))
      (try
        (progn
          (js-call bindings :forEach
                   (lambda (b)
                     (let* ((place-form (if (el-cons? b) (get b :car) b))
                            (val-form (if (and (el-cons? b) (el-cons? (get b :cdr))) (el-car (get b :cdr)) nil))
                            (eval-env (if sequential frame env)))
                       (if (el-symobj? place-form)
                           (let ((val (el-eval session val-form eval-env)))
                             (when (not (el-bound-lexically place-form eval-env))
                               (el-add-special-var session place-form))
                             (if sequential
                                 (el-bind-variable session frame place-form val dynamic)
                               (js-call pending :push (js-array "var" place-form val))))
                         (let* ((place (el-place session place-form eval-env))
                                (old-val (funcall (get place :get)))
                                (new-val (el-eval session val-form eval-env)))
                           (if sequential
                               (progn
                                 (js-call restores :push (js-array (get place :set) old-val))
                                 (funcall (get place :set) new-val))
                             (js-call pending :push (js-array "place" place old-val new-val))))))))
          (unless sequential
            (js-call pending :forEach
                     (lambda (item)
                       (if (= (aref item 0) "var")
                           (el-bind-variable session frame (aref item 1) (aref item 2) dynamic)
                         (let ((place (aref item 1)) (old-val (aref item 2)) (new-val (aref item 3)))
                           (js-call restores :push (js-array (get place :set) old-val))
                           (funcall (get place :set) new-val))))))
          (el-eval-list-body session (el-rest-after form 1) frame))
        (finally
          (let ((i (1- (js-length restores))))
            (while (>= i 0)
              (let ((r (aref restores i)))
                (funcall (aref r 0) (aref r 1)))
              (setq i (1- i))))
          (el-restore-dynamic session dynamic)))))

  (defun el-make-cl-lambda (session spec-and-body env name)
    (let ((arglist (el-car spec-and-body)))
      (if (el-simple-arglist? arglist)
          (el-make-lambda session spec-and-body env name)
        (let* ((body (get (el-extract-declarations (el-list-to-array (el-cdr spec-and-body))) :body))
               (fn (lambda (&rest args)
                     (let ((frame (el-new-env env)) (dynamic (js-array)))
                       (el-destructure session arglist (el-list-from args) frame dynamic)
                       (if (= (js-length dynamic) 0)
                           (el-eval-body session body frame)
                         (try (el-eval-body session body frame)
                           (finally (el-restore-dynamic session dynamic))))))))
          (put fn :elispName name)
          fn))))

  (defun sf-cl-destructuring-bind (session form env)
    (let ((frame (el-new-env env)) (dynamic (js-array)))
      (el-destructure session (el-second form) (el-eval session (el-third form) env) frame dynamic)
      (try (el-eval-list-body session (el-rest-after form 2) frame)
        (finally (el-restore-dynamic session dynamic)))))

  (defun sf-bound-and-true-p (session form env)
    (let ((symbol (el-second form)))
      (if (js-call (get session :values) :has symbol) (js-call (get session :values) :get symbol) nil)))

  (defun sf-cl-assert (session form env)
    (when (nil? (el-eval session (el-second form) env))
      (el-signal "cl-assertion-failed" (el-second form)))
    nil)

  (defun sf-rx (session form env)
    (let ((cached (get form :_rxCached)))
      (if (not (undefined? cached))
          cached
        (let ((compiled (el-rx (el-cons (el-intern "seq") (get form :cdr)))))
          (put form :_rxCached compiled)
          compiled))))

  (defun sf-define-inline-noop (session form env) nil)
  (defun sf-eval-progn (session form env) (el-eval-list-body session (get form :cdr) env))
  (defun sf-with-eval-after-load (session form env) (el-eval-list-body session (el-rest-after form 1) env))
  (defun sf-defgroup (session form env) (el-second form))
  (defun sf-defface (session form env) (el-second form))
  (defun sf-defcustom (session form env) (sf-defvar session form env))
  (defun sf-cl-the (session form env) (el-eval session (el-third form) env))
  (defun sf-declare (session form env) nil)
  (defun sf-interactive (session form env) nil)
  (defun sf-condition-case-unless-debug (session form env) (sf-condition-case session form env))

  (defun sf-defvar-keymap (session form env)
    (let ((sym (el-second form)))
      (when (el-symobj? sym)
        (el-add-special-var session sym)
        (unless (js-call (get session :values) :has sym)
          (js-call (get session :values) :set sym (el-list (el-intern "keymap")))))
      sym))

  (defun sf-define-derived-mode (session form env)
    (let* ((mode (el-second form))
           (mode-name (el-symbol-name mode))
           (map-sym (el-intern (str mode-name "-map")))
           (hook-sym (el-intern (str mode-name "-hook")))
           (syntax-sym (el-intern (str mode-name "-syntax-table")))
           (abbrev-sym (el-intern (str mode-name "-abbrev-table"))))
      (el-add-special-var session map-sym)
      (unless (js-call (get session :values) :has map-sym)
        (js-call (get session :values) :set map-sym (el-list (el-intern "keymap"))))
      (el-add-special-var session hook-sym)
      (unless (js-call (get session :values) :has hook-sym)
        (js-call (get session :values) :set hook-sym nil))
      (el-add-special-var session syntax-sym)
      (unless (js-call (get session :values) :has syntax-sym)
        (js-call (get session :values) :set syntax-sym nil))
      (el-add-special-var session abbrev-sym)
      (unless (js-call (get session :values) :has abbrev-sym)
        (js-call (get session :values) :set abbrev-sym nil))
      (el-define-function session mode (lambda (&rest ignored) mode))
      mode))

  (defun sf-define-minor-mode (session form env)
    (let* ((mode (el-second form))
           (mode-name (el-symbol-name mode))
           (map-sym (el-intern (str mode-name "-map")))
           (hook-sym (el-intern (str mode-name "-hook"))))
      (el-add-special-var session mode)
      (unless (js-call (get session :values) :has mode)
        (js-call (get session :values) :set mode nil))
      (el-add-special-var session map-sym)
      (unless (js-call (get session :values) :has map-sym)
        (js-call (get session :values) :set map-sym (el-list (el-intern "keymap"))))
      (el-add-special-var session hook-sym)
      (unless (js-call (get session :values) :has hook-sym)
        (js-call (get session :values) :set hook-sym nil))
      (el-define-function session mode
        (lambda (&optional arg)
          (let ((next (if (or (nullish? arg) (eq arg (el-intern "toggle")))
                          (el-bool (nil? (js-call (get session :values) :get mode)))
                        (el-bool (or (not (el-number? arg)) (> (el-num arg) 0))))))
            (js-call (get session :values) :set mode next)
            next)))
      mode))

  (defun sf-gv-define-simple-setter (session form env)
    (let ((name (el-second form))
          (setter (el-third form)))
      (js-call (get session :gvSetters) :set name (js-object :kind "simple" :setter setter))
      name))

  (defun sf-gv-define-setter (session form env)
    (let ((name (el-second form))
          (arglist (el-third form))
          (body (el-rest-after form 2)))
      (js-call (get session :gvSetters) :set name
               (js-object :kind "expander"
                          :fn (el-make-macro session arglist (el-list-to-array body) env (el-symbol-name name))))
      name))

  (defun sf-defalias (session form env)
    (let ((name (el-eval session (el-second form) env))
          (definition (el-eval session (el-third form) env)))
      (if (and (el-cons? definition) (eq (get definition :car) s-macro))
          (el-set-macro session name
                        (let ((expander (get definition :cdr)))
                          (lambda (forms call-env) (el-call session expander (el-list-to-array forms)))))
        (el-set-fn session name definition))
      name))

  (defun sf-defsubst (session form env) (sf-defun session form env))

  (defun sf-thread (session form env)
    (let* ((last (el-sym-is (get form :car) "thread-last"))
           (value (el-second form))
           (cursor (el-rest-after form 1)))
      (while (el-cons? cursor)
        (let ((step (get cursor :car)))
          (setq value
                (if (el-cons? step)
                    (if last
                        (el-append (js-array step (el-list value)))
                      (el-cons (get step :car) (el-cons value (get step :cdr))))
                  (el-list step value))))
        (setq cursor (get cursor :cdr)))
      (el-eval session value env)))

  (defun sf-named-let (session form env)
    (let* ((name (el-second form)) (bindings (el-list-to-array (el-third form)))
           (body (el-rest-after form 2))
           (frame (el-new-env env))
           (arglist (el-list-from (js-call bindings :map (lambda (b) (if (el-cons? b) (get b :car) b))))))
      (put frame :fns (new globalThis.Map))
      (put frame :hasFns t)
      (put name :_everLocalFn t)
      (js-call (get frame :fns) :set name (el-make-cl-lambda session (el-cons arglist body) frame (el-symbol-name name)))
      (el-call session (js-call (get frame :fns) :get name)
               (js-call bindings :map (lambda (b) (if (el-cons? b) (el-eval session (el-car (get b :cdr)) env) nil))))))

  (defun sf-letrec (session form env)
    (let ((frame (el-new-env env)))
      (js-call (el-list-to-array (el-second form)) :forEach
               (lambda (b) (js-call (get frame :vars) :set (if (el-cons? b) (get b :car) b) nil)))
      (js-call (el-list-to-array (el-second form)) :forEach
               (lambda (b) (when (el-cons? b)
                             (js-call (get frame :vars) :set (get b :car) (el-eval session (el-car (get b :cdr)) frame)))))
      (el-eval-list-body session (el-rest-after form 1) frame)))

  ;; ------------------------------------------------------------------
  ;; Generalized places (setf, cl-incf, push, pop, ...)
  ;; ------------------------------------------------------------------

  (defconst cadr-place-pattern (new globalThis.RegExp "^c[ad]{2,4}r$"))

  (defun el-place (session place env)
    ;; Return {get, set}; subforms are evaluated exactly once.
    (cond
      ((el-symobj? place)
        (js-object :get (lambda () (el-lookup session place env))
                   :set (lambda (value) (el-set-variable session place value env))))
      ((not (el-cons? place)) (el-signal "error" (str "Bad place: " (el-prin1-string place t))))
      (t
        (let* ((head (get place :car)) (name (el-symbol-name head)) (args (el-args place)))
          (cond
            ((js-call (get session :accessors) :has head)
              (let* ((info (js-call (get session :accessors) :get head))
                     (record (el-eval session (aref args 0) env)))
                (el-check-struct session record (get info :type))
                (js-object :get (lambda () (aref (get record :items) (get info :index)))
                           :set (lambda (v) (put (get record :items) (get info :index) v) v))))
            ((or (= name "car") (= name "cl-first"))
              (let ((cell (el-eval session (aref args 0) env)))
                (js-object :get (lambda () (el-car cell)) :set (lambda (v) (put cell :car v) v))))
            ((or (= name "cdr") (= name "cl-rest"))
              (let ((cell (el-eval session (aref args 0) env)))
                (js-object :get (lambda () (el-cdr cell)) :set (lambda (v) (put cell :cdr v) v))))
            ((js-call cadr-place-pattern :test name)
              (let* ((path (js-call name :slice 1 (1- (js-length name))))
                     (target (el-eval session (aref args 0) env))
                     (index (1- (js-length path))))
                (while (> index 0)
                  (setq target (if (= (js-call path :charAt index) "a") (el-car target) (el-cdr target)))
                  (setq index (1- index)))
                (if (= (js-call path :charAt 0) "a")
                    (js-object :get (lambda () (el-car target)) :set (lambda (v) (put target :car v) v))
                  (js-object :get (lambda () (el-cdr target)) :set (lambda (v) (put target :cdr v) v)))))
            ((or (= name "nth") (= name "cl-second") (= name "cl-third"))
              (let* ((n (cond ((= name "cl-second") 1) ((= name "cl-third") 2) (t (el-eval session (aref args 0) env))))
                     (list (el-eval session (aref args (if (= name "nth") 1 0)) env))
                     (cell (el-nthcdr n list)))
                (js-object :get (lambda () (el-car cell)) :set (lambda (v) (put cell :car v) v))))
            ((= name "nthcdr")
              (let* ((n (el-eval session (aref args 0) env)) (list (el-eval session (aref args 1) env))
                     (cell (el-nthcdr (1- n) list)))
                (js-object :get (lambda () (el-cdr cell)) :set (lambda (v) (put cell :cdr v) v))))
            ((or (= name "aref") (= name "elt"))
              (let* ((inner (el-place session (aref args 0) env))
                     (array (funcall (get inner :get)))
                     (index (el-eval session (aref args 1) env)))
                (js-object :get (lambda () (if (el-cons? array) (el-nth index array) (el-aref array index)))
                           :set (lambda (v)
                                  (cond ((el-string? array)
                                          (setq array (el-string-set array index v))
                                          (funcall (get inner :set) array))
                                        ((el-cons? array) (put (el-nthcdr index array) :car v))
                                        (t (el-aset-container array index v)))
                                  v))))
            ((= name "gethash")
              (let ((key (el-eval session (aref args 0) env))
                    (table (el-eval session (aref args 1) env))
                    (default (if (> (js-length args) 2) (el-eval session (aref args 2) env) nil)))
                (js-object :get (lambda () (el-gethash key table default))
                           :set (lambda (v) (el-puthash key v table)))))
            ((= name "alist-get")
              (let* ((key (el-eval session (aref args 0) env))
                     (inner (el-place session (aref args 1) env))
                     (default (if (> (js-length args) 2) (el-eval session (aref args 2) env) nil))
                     (remove (if (> (js-length args) 3) (el-eval session (aref args 3) env) nil))
                     (testfn (if (> (js-length args) 4) (el-eval session (aref args 4) env) nil))
                     (test (el-test-function session testfn el-eq-test)))
                (js-object :get (lambda ()
                                  (let ((cell (el-assoc-with key (funcall (get inner :get)) test)))
                                    (if (nil? cell) default (get cell :cdr))))
                           :set (lambda (v)
                                  (let* ((alist (funcall (get inner :get)))
                                         (cell (el-assoc-with key alist test)))
                                    (cond
                                      ((and (not (nil? remove)) (el-equal-p v default 0))
                                        (funcall (get inner :set)
                                                 (el-list-from (js-call (el-list-to-array alist) :filter (lambda (c) (not (eq c cell)))))))
                                      ((nil? cell) (funcall (get inner :set) (el-cons (el-cons key v) alist)))
                                      (t (put cell :cdr v)))
                                    v)))))
            ((= name "plist-get")
              (let* ((inner (el-place session (aref args 0) env))
                     (prop (el-eval session (aref args 1) env))
                     (test (el-test-function session (if (> (js-length args) 2) (el-eval session (aref args 2) env) nil) el-eq-test)))
                (js-object :get (lambda () (el-plist-get (funcall (get inner :get)) prop test))
                           :set (lambda (v)
                                  (funcall (get inner :set) (el-plist-put (funcall (get inner :get)) prop v test))
                                  v))))
            ((= name "get")
              (let ((symbol (el-eval session (aref args 0) env)) (prop (el-eval session (aref args 1) env)))
                (js-object :get (lambda () (el-get-prop session symbol prop))
                           :set (lambda (v) (el-put-prop session symbol prop v)))))
            ((= name "symbol-value")
              (let ((symbol (el-eval session (aref args 0) env)))
                (js-object :get (lambda () (el-global-value session symbol))
                           :set (lambda (v) (el-set-dynamic-variable session symbol v) v))))
            ((= name "default-value")
              (let ((symbol (el-eval session (aref args 0) env)))
                (js-object :get (lambda () (el-default-value session symbol))
                           :set (lambda (v) (js-call (get session :values) :set symbol v) v))))
            ((= name "symbol-function")
              (let ((symbol (el-eval session (aref args 0) env)))
                (js-object :get (lambda () (el-symbol-function session symbol))
                           :set (lambda (v)
                                  (el-set-fn session symbol v)
                                  v))))
            ((= name "getenv")
              (let ((env-name (el-eval session (aref args 0) env)))
                (js-object :get (lambda () (el-call session (el-intern "getenv") (js-array env-name)))
                           :set (lambda (v) (el-call session (el-intern "setenv") (js-array env-name v)) v))))
            ((= name "buffer-string")
              (js-object :get (lambda () (get (el-current-buffer session) :text))
                         :set (lambda (v)
                                (let ((b (el-current-buffer session)))
                                  (put b :text v)
                                  (put b :point 1)
                                  v))))
            ((= name "cl-struct-slot-value")
              (let* ((stype (el-symbol-name (el-eval session (aref args 0) env)))
                     (sname (el-symbol-name (el-eval session (aref args 1) env)))
                     (record (el-eval session (aref args 2) env))
                     (info (js-call (get session :structs) :get stype))
                     (slots (if (undefined? info) (js-array) (get info :slots)))
                     (idx (js-call slots :findIndex (lambda (s) (= (el-symbol-name (get s :name)) sname)))))
                (el-check-struct session record stype)
                (when (< idx 0) (el-signal "error" (str "Unknown slot " sname)))
                (js-object :get (lambda () (aref (get record :items) (1+ idx)))
                           :set (lambda (v) (put (get record :items) (1+ idx) v) v))))
            ((js-call (get session :gvSetters) :has head)
              (let* ((info (js-call (get session :gvSetters) :get head))
                     (evaled-args (js-call args :map (lambda (a) (el-eval session a env)))))
                (if (= (get info :kind) "simple")
                    (js-object :get (lambda () (el-call session head evaled-args))
                               :set (lambda (v) (el-call session (get info :setter) (js-call evaled-args :concat (js-array v))) v))
                  (js-object :get (lambda () (el-call session head evaled-args))
                             :set (lambda (v)
                                    (let ((expanded (funcall (get info :fn) (el-cons (el-list s-quote v) (get place :cdr)) env)))
                                      (el-eval session expanded env)))))))
            ((js-call (get session :macros) :has head)
              (el-place session (el-macroexpand-1 session place env) env))
            (t (el-signal "error" (str "Unknown place form: " name))))))))

  (defun el-test-function (session fn fallback)
    (if (nullish? fn) fallback
      (let ((callable (el-callable session fn)))
        (lambda (a b) (not (nil? (el-normalize-result (funcall callable a b))))))))

  (defun sf-setf (session form env)
    (let ((cursor (get form :cdr))
          (accessors (get session :accessors))
          (value nil))
      (while (el-cons? cursor)
        (let ((place-form (get cursor :car))
              (val-form (el-car (get cursor :cdr))))
          (cond
            ((el-symobj? place-form)
              (setq value (el-eval session val-form env))
              (el-set-variable session place-form value env))
            ((and (el-cons? place-form)
                  (el-symobj? (get place-form :car))
                  (js-call accessors :has (get place-form :car)))
              (let* ((info (js-call accessors :get (get place-form :car)))
                     (record (el-eval session (el-second place-form) env)))
                (el-check-struct session record (get info :type))
                (setq value (el-eval session val-form env))
                (put (get record :items) (get info :index) value)))
            (t
              (let ((place (el-place session place-form env)))
                (setq value (el-eval session val-form env))
                (funcall (get place :set) value)))))
        (setq cursor (el-cdr (get cursor :cdr))))
      value))

  (defun sf-incf (session form env)
    (let* ((place-form (el-second form))
           (decrement (or (el-sym-is (get form :car) "cl-decf") (el-sym-is (get form :car) "decf")))
           (op (if decrement "-" "+")))
      (cond
        ((el-symobj? place-form)
          (let* ((delta (if (nil? (el-rest-after form 1)) 1 (el-eval session (el-third form) env)))
                 (value (el-arith-2 op (el-lookup session place-form env) delta)))
            (el-set-variable session place-form value env)))
        ((and (el-cons? place-form)
              (el-symobj? (get place-form :car))
              (js-call (get session :accessors) :has (get place-form :car)))
          (let* ((info (js-call (get session :accessors) :get (get place-form :car)))
                 (record (el-eval session (el-second place-form) env))
                 (delta (if (nil? (el-rest-after form 1)) 1 (el-eval session (el-third form) env)))
                 (idx (get info :index)))
            (el-check-struct session record (get info :type))
            (let* ((items (get record :items))
                   (value (el-arith-2 op (aref items idx) delta)))
              (put items idx value)
              value)))
        (t
          (let* ((place (el-place session place-form env))
                 (delta (if (nil? (el-rest-after form 1)) 1 (el-eval session (el-third form) env)))
                 (value (el-arith-2 op (funcall (get place :get)) delta)))
            (funcall (get place :set) value)
            value)))))

  (defun sf-push (session form env)
    (let* ((item (el-eval session (el-second form) env))
           (place-form (el-third form)))
      (cond
        ((el-symobj? place-form)
          (let ((value (el-cons item (el-lookup session place-form env))))
            (el-set-variable session place-form value env)))
        ((and (el-cons? place-form)
              (el-symobj? (get place-form :car))
              (js-call (get session :accessors) :has (get place-form :car)))
          (let* ((info (js-call (get session :accessors) :get (get place-form :car)))
                 (record (el-eval session (el-second place-form) env))
                 (idx (get info :index)))
            (el-check-struct session record (get info :type))
            (let* ((items (get record :items))
                   (value (el-cons item (aref items idx))))
              (put items idx value)
              value)))
        (t
          (let* ((place (el-place session place-form env))
                 (value (el-cons item (funcall (get place :get)))))
            (funcall (get place :set) value)
            value)))))

  (defun sf-pop (session form env)
    (let ((place-form (el-second form)))
      (cond
        ((el-symobj? place-form)
          (let ((list (el-lookup session place-form env)))
            (el-set-variable session place-form (el-cdr list) env)
            (el-car list)))
        ((and (el-cons? place-form)
              (el-symobj? (get place-form :car))
              (js-call (get session :accessors) :has (get place-form :car)))
          (let* ((info (js-call (get session :accessors) :get (get place-form :car)))
                 (record (el-eval session (el-second place-form) env))
                 (idx (get info :index)))
            (el-check-struct session record (get info :type))
            (let* ((items (get record :items))
                   (list (aref items idx)))
              (put items idx (el-cdr list))
              (el-car list))))
        (t
          (let* ((place (el-place session place-form env))
                 (list (funcall (get place :get))))
            (funcall (get place :set) (el-cdr list))
            (el-car list))))))

  (defun sf-pushnew (session form env)
    (let* ((item (el-eval session (el-second form) env))
           (place (el-place session (el-third form) env))
           (options (el-list-to-array (el-rest-after form 2)))
           (test-index (js-call options :findIndex (lambda (o) (el-sym-is o ":test"))))
           (test (if (< test-index 0) el-eql-test
                   (el-test-function session (el-eval session (aref options (1+ test-index)) env) el-eql-test)))
           (list (funcall (get place :get))))
      (if (nil? (el-member-with item list test))
          (let ((value (el-cons item list))) (funcall (get place :set) value) value)
        list)))

  (defun sf-cl-remf (session form env)
    (let* ((place (el-place session (el-second form) env))
           (tag (el-eval session (el-third form) env))
           (plist (funcall (get place :get)))
           (items (el-list-to-array plist))
           (out (js-array))
           (removed false)
           (i 0))
      (while (< i (js-length items))
        (if (and (not removed) (el-eq-test (aref items i) tag))
            (setq removed t)
          (progn
            (js-call out :push (aref items i))
            (when (< (1+ i) (js-length items))
              (js-call out :push (aref items (1+ i))))))
        (setq i (+ i 2)))
      (when removed
        (funcall (get place :set) (el-list-from out)))
      (el-bool removed)))

  (defun sf-aset (session form env)
    (let ((a0 (el-second form))
          (a1 (el-third form))
          (a2 (el-car (el-rest-after form 2))))
      (let* ((is-sym (el-symobj? a0))
             (array (if is-sym (el-lookup session a0 env) (el-eval session a0 env)))
             (index (el-eval session a1 env))
             (value (el-eval session a2 env)))
        (if (el-string? array)
            (if (not is-sym) (el-signal "error" "aset on an immutable string value")
              (el-set-variable session a0 (el-string-set array index value) env))
          (el-aset-container array index value))
        value)))

  (defun sf-cl-callf (session form env)
    (let* ((fn (el-second form))
           (place (el-place session (el-third form) env))
           (extra (el-eval-args session (el-rest-after form 2) env))
           (callable (if (el-symobj? fn) fn (el-eval session fn env)))
           (value (el-call session callable (js-call (js-array (funcall (get place :get))) :concat extra))))
      (funcall (get place :set) value)
      value))

  ;; ------------------------------------------------------------------
  ;; cl-defstruct (records)
  ;; ------------------------------------------------------------------

  (defun el-check-struct (session record type)
    (unless (or (and (not (nil? record))
                     (= (get record :kind) "record")
                     (= (get (aref (get record :items) 0) :name) type))
                (el-struct-instance? session record type))
      (el-signal "wrong-type-argument" (el-intern type) record)))

  (defun el-struct-instance? (session record type)
    (and (el-record? record)
         (let ((current (el-symbol-name (aref (get record :items) 0))) (found false))
           (while (and (not found) (not (nil? current)))
             (if (= current type) (setq found t)
               (let ((info (js-call (get session :structs) :get current)))
                 (setq current (if (undefined? info) nil (get info :parent))))))
           found)))

  (defun sf-cl-defstruct (session form env)
    (let* ((spec (el-second form))
           (name (if (el-cons? spec) (el-symbol-name (get spec :car)) (el-symbol-name spec)))
           (options (if (el-cons? spec) (el-list-to-array (get spec :cdr)) (js-array)))
           (raw-slots (el-list-to-array (el-rest-after form 1)))
           (conc-name (str name "-"))
           (keyword-constructors (js-array))
           (boa-constructors (js-array))
           (default-constructor t)
           (copier (str "copy-" name))
           (predicate (str name "-p"))
           (parent nil))
      (js-call options :forEach
               (lambda (option)
                 (let* ((key (el-symbol-name (if (el-cons? option) (get option :car) option)))
                        (values (if (el-cons? option) (el-list-to-array (get option :cdr)) (js-array))))
                   (cond
                     ((= key ":conc-name")
                       (setq conc-name (if (or (= (js-length values) 0) (nil? (aref values 0))) ""
                                         (el-symbol-name-or-string (aref values 0)))))
                     ((= key ":constructor")
                       (cond
                         ((= (js-length values) 0) nil)
                         ((nil? (aref values 0)) (setq default-constructor false))
                         ((= (js-length values) 1)
                           (setq default-constructor false)
                           (js-call keyword-constructors :push (el-symbol-name (aref values 0))))
                         (t (js-call boa-constructors :push (js-array (aref values 0) (aref values 1))))))
                     ((= key ":copier")
                       (setq copier (if (or (= (js-length values) 0) (nil? (aref values 0))) nil (el-symbol-name (aref values 0)))))
                     ((= key ":predicate")
                       (setq predicate (if (or (= (js-length values) 0) (nil? (aref values 0))) nil (el-symbol-name (aref values 0)))))
                     ((= key ":include") (setq parent (el-symbol-name (aref values 0))))))))
      (when default-constructor (js-call keyword-constructors :push (str "make-" name)))
      (let* ((own (js-call (js-call raw-slots :filter (lambda (s) (not (el-string? s))))
                           :map (lambda (s)
                                  (if (el-cons? s)
                                      (js-object :name (get s :car) :init (el-car (get s :cdr)))
                                    (js-object :name s :init nil)))))
             (inherited (if (nil? parent) (js-array)
                          (let ((info (js-call (get session :structs) :get parent)))
                            (when (undefined? info) (el-signal "error" (str "Unknown struct " parent)))
                            (get info :slots))))
             (slots (js-call inherited :concat own))
             (type-symbol (el-intern name)))
        (js-call (get session :structs) :set name (js-object :parent parent :slots slots))
        ;; Keyword constructors: defaults are evaluated per instance.
        (js-call keyword-constructors :forEach
                 (lambda (ctor)
                   (el-define-function session (el-intern ctor)
                     (lambda (&rest args)
                       (let ((frame (el-new-env env)) (items (js-array type-symbol)) (plist (el-list-from args)))
                         (js-call slots :forEach
                                  (lambda (slot)
                                    (let* ((keyword (el-intern (str ":" (el-symbol-name (get slot :name)))))
                                           (cell (el-plist-member plist keyword el-eq-test))
                                           (value (if (nil? cell) (el-eval session (get slot :init) frame)
                                                    (el-car-safe (get cell :cdr)))))
                                      (js-call (get frame :vars) :set (get slot :name) value)
                                      (js-call items :push value))))
                         (js-object :kind "record" :items items))))))
        ;; BOA constructors: positional lambda lists over slot names.
        (js-call boa-constructors :forEach
                 (lambda (entry)
                   (let ((ctor (aref entry 0)) (arglist (aref entry 1)))
                     (el-define-function session ctor
                       (lambda (&rest args)
                         (let ((frame (el-new-env env)) (dynamic (js-array)))
                           (el-destructure session (el-boa-arglist arglist slots) (el-list-from args) frame dynamic)
                           (let ((items (js-array type-symbol)))
                             (js-call slots :forEach
                                      (lambda (slot)
                                        (js-call items :push
                                                 (if (js-call (get frame :vars) :has (get slot :name))
                                                     (js-call (get frame :vars) :get (get slot :name))
                                                   (el-eval session (get slot :init) frame)))))
                             (js-object :kind "record" :items items))))))))
        (unless (nil? predicate)
          (let ((pred-sym (el-intern predicate))
                (pred-fn (lambda (x)
                           (el-bool (or (and (not (nil? x))
                                             (= (get x :kind) "record")
                                             (eq (aref (get x :items) 0) type-symbol))
                                        (el-struct-instance? session x name))))))
            (el-define-function session pred-sym pred-fn)
            (put pred-sym :_inlineEval
                 (lambda (s cdr e)
                   (if (and (not (nil? cdr)) (nil? (get cdr :cdr)))
                       (let ((x (el-eval s (get cdr :car) e)))
                         (el-bool (or (and (not (nil? x))
                                           (= (get x :kind) "record")
                                           (eq (aref (get x :items) 0) type-symbol))
                                      (el-struct-instance? s x name))))
                     (el-eval-call-fn s pred-fn cdr e))))))
        (unless (nil? copier)
          (el-define-function session (el-intern copier)
            (lambda (x) (el-check-struct session x name) (el-copy-sequence x))))
        (let ((index 1))
          (js-call slots :forEach
                   (lambda (slot)
                     (let* ((position index)
                            (accessor (el-intern (str conc-name (el-symbol-name (get slot :name)))))
                            (acc-fn (lambda (record)
                                      (unless (or (and (not (nil? record))
                                                       (= (get record :kind) "record")
                                                       (eq (aref (get record :items) 0) type-symbol))
                                                  (el-struct-instance? session record name))
                                        (el-signal "wrong-type-argument" type-symbol record))
                                      (aref (get record :items) position))))
                       (js-call (get session :accessors) :set accessor (js-object :type name :index position))
                       (el-define-function session accessor acc-fn)
                       (put accessor :_inlineEval
                            (lambda (s cdr e)
                              (if (and (not (nil? cdr)) (nil? (get cdr :cdr)))
                                  (let ((record (el-eval s (get cdr :car) e)))
                                    (unless (or (and (not (nil? record))
                                                     (= (get record :kind) "record")
                                                     (eq (aref (get record :items) 0) type-symbol))
                                                (el-struct-instance? s record name))
                                      (el-signal "wrong-type-argument" type-symbol record))
                                    (aref (get record :items) position))
                                (el-eval-call-fn s acc-fn cdr e)))))
                     (setq index (1+ index)))))
        type-symbol)))

  (defun el-symbol-name-or-string (x) (if (el-string? x) x (el-symbol-name x)))

  (defun el-boa-arglist (arglist slots)
    ;; &optional/&key parameters without defaults take the slot default.
    (let ((items (js-array)) (cursor arglist) (mode "required"))
      (while (el-cons? cursor)
        (let ((item (get cursor :car)))
          (cond
            ((or (eq item s-optional) (eq item s-key)) (setq mode "optional") (js-call items :push item))
            ((or (eq item s-rest) (eq item s-body) (eq item s-aux)) (setq mode "other") (js-call items :push item))
            ((and (= mode "optional") (el-symobj? item))
              (let ((slot (js-call slots :find (lambda (s) (eq (get s :name) item)))))
                (js-call items :push (if (undefined? slot) item (el-list item (get slot :init))))))
            (t (js-call items :push item))))
        (setq cursor (get cursor :cdr)))
      (el-list-from items)))

  ;; ------------------------------------------------------------------
  ;; pcase
  ;; ------------------------------------------------------------------

  (defun el-pcase-env (env bindings)
    (if (= (js-length bindings) 0)
        env
      (let ((frame (el-new-env env)))
        (js-call bindings :forEach (lambda (pair) (js-call (get frame :vars) :set (aref pair 0) (aref pair 1))))
        frame)))

  (defun el-pcase-call (session fun value env bindings)
    ;; Call a pred/app function form: symbol, lambda, or (F ARGS...) with value last.
    (cond
      ((el-symobj? fun) (el-call session (el-function-designator session fun env) (js-array value)))
      ((and (el-cons? fun) (or (eq (get fun :car) s-lambda) (eq (get fun :car) s-function)))
        (el-call session (el-eval session fun (el-pcase-env env bindings)) (js-array value)))
      ((el-cons? fun)
        (let ((frame (el-pcase-env env bindings)))
          (el-call session (el-function-designator session (get fun :car) env)
                   (js-call (el-eval-args session (get fun :cdr) frame) :concat (js-array value)))))
      (t (el-signal "error" "Invalid pcase function"))))

  (defun el-pcase-match (session pattern value env bindings)
    (cond
      ((eq pattern s-underscore) t)
      ((or (nil? pattern) (eq pattern t)) (el-equal-p pattern value 0))
      ((el-keyword? pattern) (eq pattern value))
      ((el-symobj? pattern) (js-call bindings :push (js-array pattern value)) t)
      ((not (el-cons? pattern)) (el-equal-p pattern value 0))
      (t
        (let ((head (get pattern :car)))
          (if (eq head s-quote)
              (let ((qval (el-car (get pattern :cdr))))
                (if (or (el-symobj? qval) (el-keyword? qval))
                    (eq qval value)
                  (el-equal-p qval value 0)))
            (let ((args (el-args pattern)))
              (cond
                ((eq head s-backquote) (el-pcase-qpat session (aref args 0) value env bindings))
                ((eq head s-pred)
                  (let ((fun (aref args 0)))
                    (if (and (el-cons? fun) (eq (get fun :car) s-not))
                        (nil? (el-pcase-call session (el-car (get fun :cdr)) value env bindings))
                      (not (nil? (el-pcase-call session fun value env bindings))))))
                ((eq head s-guard) (not (nil? (el-eval session (aref args 0) (el-pcase-env env bindings)))))
                ((eq head s-app)
                  (el-pcase-match session (aref args 1) (el-pcase-call session (aref args 0) value env bindings) env bindings))
                ((eq head s-and)
                  (js-call args :every (lambda (p) (el-pcase-match session p value env bindings))))
                ((eq head s-or)
                  (let ((matched false) (index 0))
                    (while (and (not matched) (< index (js-length args)))
                      (let ((trial (js-array)))
                        (when (el-pcase-match session (aref args index) value env trial)
                          (setq matched t)
                          (js-call trial :forEach (lambda (pair) (js-call bindings :push pair)))))
                      (setq index (1+ index)))
                    matched))
                ((eq head s-let)
                  (el-pcase-match session (aref args 0) (el-eval session (aref args 1) (el-pcase-env env bindings)) env bindings))
                ((el-sym-is head "cl-type") (not (nil? (el-cl-typep session value (aref args 0)))))
                (t (el-signal "error" (str "Unknown pcase pattern " (el-prin1-string pattern t)))))))))))

  (defun el-pcase-qpat (session qpat value env bindings)
    (cond
      ((and (el-cons? qpat) (eq (get qpat :car) s-comma))
        (el-pcase-match session (el-car (get qpat :cdr)) value env bindings))
      ((el-cons? qpat)
        (and (el-cons? value)
             (el-pcase-qpat session (get qpat :car) (get value :car) env bindings)
             (el-pcase-qpat session (get qpat :cdr) (get value :cdr) env bindings)))
      ((el-vector? qpat)
        (and (el-vector? value)
             (= (js-length (get qpat :items)) (js-length (get value :items)))
             (js-call (get qpat :items) :every
                      (lambda (q index) (el-pcase-qpat session q (aref (get value :items) index) env bindings)))))
      (t (el-equal-p qpat value 0))))

  (defun sf-pcase (session form env)
    (let ((value (el-eval session (el-second form) env))
          (cursor (el-rest-after form 1))
          (result nil)
          (done false))
      (while (and (not done) (el-cons? cursor))
        (let* ((clause (get cursor :car))
               (pat (el-car clause)))
          (cond
            ((eq pat s-underscore)
              (setq done t)
              (setq result (el-eval-list-body session (el-cdr clause) env)))
            ((and (el-cons? pat) (eq (get pat :car) s-quote))
              (let ((qval (el-car (get pat :cdr))))
                (when (if (or (el-symobj? qval) (el-keyword? qval))
                          (eq qval value)
                        (el-equal-p qval value 0))
                  (setq done t)
                  (setq result (el-eval-list-body session (el-cdr clause) env)))))
            (t
              (let ((bindings (js-array)))
                (when (el-pcase-match session pat value env bindings)
                  (setq done t)
                  (setq result (el-eval-list-body session (el-cdr clause) (el-pcase-env env bindings))))))))
        (setq cursor (get cursor :cdr)))
      (when (and (not done) (el-sym-is (get form :car) "pcase-exhaustive"))
        (el-signal "error" (str "No clause matching `" (el-prin1-string value t) "'")))
      result))

  (defun sf-pcase-let (session form env)
    (let* ((sequential (el-sym-is (get form :car) "pcase-let*"))
           (bindings (js-array))
           (frame env))
      (js-call (el-list-to-array (el-second form)) :forEach
               (lambda (binding)
                 (let ((value (el-eval session (el-car (get binding :cdr)) (if sequential frame env)))
                       (local (js-array)))
                   (el-pcase-match session (get binding :car) value env local)
                   (js-call local :forEach (lambda (pair) (js-call bindings :push pair)))
                   (when sequential (setq frame (el-pcase-env env bindings))))))
      (el-eval-list-body session (el-rest-after form 1) (el-pcase-env env bindings))))

  (defun sf-pcase-dolist (session form env)
    (let* ((spec (el-second form))
           (items (el-seq-items (el-eval session (el-car (el-cdr spec)) env)))
           (body (el-rest-after form 1)))
      (js-call items :forEach
               (lambda (item)
                 (let ((bindings (js-array)))
                   (el-pcase-match session (el-car spec) item env bindings)
                   (el-eval-list-body session body (el-pcase-env env bindings)))))
      nil))

  (defun sf-pcase-setq (session form env)
    (let ((cursor (get form :cdr)))
      (while (el-cons? cursor)
        (let ((bindings (js-array)))
          (el-pcase-match session (get cursor :car) (el-eval session (el-car (get cursor :cdr)) env) env bindings)
          (js-call bindings :forEach (lambda (pair) (el-set-variable session (aref pair 0) (aref pair 1) env))))
        (setq cursor (el-cdr (get cursor :cdr))))
      nil))

  ;; ------------------------------------------------------------------
  ;; cl-loop
  ;; ------------------------------------------------------------------

  (defconst loop-keywords
    (js-array "for" "as" "repeat" "while" "until" "always" "never" "thereis" "collect" "collecting"
              "append" "appending" "nconc" "nconcing" "concat" "vconcat" "sum" "summing" "count" "counting"
              "maximize" "maximizing" "minimize" "minimizing" "do" "doing" "when" "if" "unless" "else" "end"
              "and" "with" "initially" "finally" "return" "named" "into"))

  (defun el-loop-keyword? (x) (and (el-symobj? x) (js-call loop-keywords :includes (get x :name))))

  (defun el-loop-bind (session pattern value frame)
    (cond
      ((nil? pattern) nil)
      ((el-symobj? pattern) (js-call (get frame :vars) :set pattern value))
      ((el-cons? pattern)
        (el-loop-bind session (get pattern :car) (el-car-safe value) frame)
        (el-loop-bind session (get pattern :cdr) (el-cdr-safe value) frame))
      ((el-vector? pattern)
        (js-call (get pattern :items) :forEach
                 (lambda (p index) (el-loop-bind session p (if (nil? value) nil (el-aref value index)) frame))))))

  (defun sf-cl-loop (session form env)
    (let* ((tokens (el-args form))
           (position 0)
           (frame (el-new-env env))
           (drivers (js-array))
           (body (js-array))
           (initially (js-array))
           (finally (js-array))
           (finally-return (js-object :form undefined))
           (state (js-object :acc nil :accKind nil :accSet false :result undefined :name nil)))
      (letfn ((peek () (if (< position (js-length tokens)) (aref tokens position) undefined))
              (next () (let ((token (aref tokens position))) (setq position (1+ position)) token))
              (keyword-is (name) (let ((token (peek))) (and (not (undefined? token)) (el-sym-is token name))))
              (forms-until-keyword ()
                (let ((forms (js-array)))
                  (while (and (< position (js-length tokens)) (not (el-loop-keyword? (peek))))
                    (js-call forms :push (next)))
                  forms))
              (parse-clause ()
                ;; Return a body clause object.
                (let* ((token (next)) (word (el-symbol-name token)))
                  (cond
                    ((or (= word "collect") (= word "collecting") (= word "append") (= word "appending")
                         (= word "nconc") (= word "nconcing") (= word "concat") (= word "vconcat")
                         (= word "sum") (= word "summing") (= word "count") (= word "counting")
                         (= word "maximize") (= word "maximizing") (= word "minimize") (= word "minimizing"))
                      (let ((expr (next)) (into nil) (norm (el-loop-normalize word)))
                        (when (keyword-is "into") (next) (setq into (next)))
                        (if (not (nil? into))
                            (js-call (get frame :vars) :set into (el-loop-initial norm))
                          (unless (get state :accSet)
                            (put state :accSet t)
                            (put state :accKind norm)
                            (put state :acc (if (or (= norm "collect") (= norm "append") (= norm "nconc"))
                                                (js-array)
                                              (el-loop-initial norm)))))
                        (js-object :type "acc" :word norm :expr expr :into into)))
                    ((or (= word "do") (= word "doing")) (js-object :type "do" :forms (forms-until-keyword)))
                    ((or (= word "when") (= word "if") (= word "unless"))
                      (let* ((test (next)) (then (js-array (parse-clause))) (else (js-array)))
                        (while (keyword-is "and") (next) (js-call then :push (parse-clause)))
                        (when (keyword-is "else")
                          (next)
                          (js-call else :push (parse-clause))
                          (while (keyword-is "and") (next) (js-call else :push (parse-clause))))
                        (when (keyword-is "end") (next))
                        (js-object :type "cond" :negate (= word "unless") :test test :then then :else else)))
                    ((= word "return") (js-object :type "return" :expr (next)))
                    ((or (= word "while") (= word "until")) (js-object :type word :expr (next)))
                    ((or (= word "always") (= word "never") (= word "thereis")) (js-object :type word :expr (next)))
                    (t (el-signal "error" (str "Unsupported cl-loop clause " word)))))))
        ;; Parse.
        (while (< position (js-length tokens))
          (let* ((token (peek)) (word (if (el-symobj? token) (get token :name) "")))
            (cond
              ((= word "named") (next) (put state :name (next)))
              ((or (= word "for") (= word "as"))
                (next)
                (let* ((variable (next)) (kind (el-symbol-name (next))) (driver (js-object :var variable :kind kind)))
                  (cond
                    ((or (= kind "in") (= kind "on") (= kind "in-ref"))
                      (put driver :expr (next))
                      (when (keyword-is "by") (next) (put driver :by (next))))
                    ((= kind "across") (put driver :expr (next)))
                    ((or (= kind "from") (= kind "upfrom") (= kind "downfrom") (= kind "to") (= kind "upto")
                         (= kind "below") (= kind "downto") (= kind "above") (= kind "by"))
                      (put driver :kind "number")
                      (put driver :from 0) (put driver :step 1) (put driver :down false)
                      (setq position (1- position))
                      (let ((scanning t))
                        (while scanning
                          (let ((w (if (el-symobj? (peek)) (get (peek) :name) "")))
                            (cond
                              ((or (= w "from") (= w "upfrom")) (next) (put driver :fromExpr (next)))
                              ((= w "downfrom") (next) (put driver :fromExpr (next)) (put driver :down t))
                              ((or (= w "to") (= w "upto")) (next) (put driver :toExpr (next)) (put driver :inclusive t))
                              ((= w "below") (next) (put driver :toExpr (next)) (put driver :inclusive false))
                              ((= w "downto") (next) (put driver :toExpr (next)) (put driver :inclusive t) (put driver :down t))
                              ((= w "above") (next) (put driver :toExpr (next)) (put driver :inclusive false) (put driver :down t))
                              ((= w "by") (next) (put driver :stepExpr (next)))
                              (t (setq scanning false)))))))
                    ((= kind "=")
                      (put driver :expr (next))
                      (when (keyword-is "then") (next) (put driver :then (next))))
                    ((= kind "being")
                      (when (or (keyword-is "the") (keyword-is "each")) (next))
                      (let ((what (el-symbol-name (next))))
                        (next)
                        (put driver :expr (next))
                        (put driver :kind (if (or (= what "hash-keys") (= what "hash-key")) "hash-keys"
                                            (if (or (= what "hash-values") (= what "hash-value")) "hash-values" "elements")))
                        (when (keyword-is "using")
                          (next)
                          (let ((using (next))) (put driver :using (el-nth 1 using))))))
                    (t (el-signal "error" (str "Unsupported cl-loop for clause " kind))))
                  (js-call drivers :push driver)))
              ((= word "repeat") (next) (js-call drivers :push (js-object :kind "repeat" :expr (next))))
              ((= word "with")
                (next)
                (let ((variable (next)) (value nil))
                  (when (keyword-is "=") (next) (setq value (el-eval session (next) frame)))
                  (el-loop-bind session variable value frame)
                  (while (keyword-is "and")
                    (next)
                    (let ((v2 (next)) (val2 nil))
                      (when (keyword-is "=") (next) (setq val2 (el-eval session (next) frame)))
                      (el-loop-bind session v2 val2 frame)))))
              ((= word "initially") (next) (setq initially (js-call initially :concat (forms-until-keyword))))
              ((= word "finally")
                (next)
                (if (keyword-is "return")
                    (progn (next) (put finally-return :form (next)))
                  (setq finally (js-call finally :concat (forms-until-keyword)))))
              (t (js-call body :push (parse-clause))))))
        ;; Execute.
        (el-catch-block session (get state :name)
          (lambda ()
            (el-eval-body session initially frame)
            (js-call drivers :forEach (lambda (d) (el-loop-init session d frame)))
            (let ((running t) (first t))
              (while running
                (let ((index 0))
                  (while (and running (< index (js-length drivers)))
                    (unless (el-loop-step session (aref drivers index) frame first) (setq running false))
                    (setq index (1+ index))))
                (setq first false)
                (when running
                  (let ((outcome (el-loop-run-clauses session body frame state)))
                    (cond
                      ((= outcome "stop") (setq running false))
                      ((= outcome "return") (setq running false) (put state :returned t))))))
              (if (get state :returned)
                  (get state :result)
                (progn
                  (el-eval-body session finally frame)
                  (cond
                    ((not (undefined? (get finally-return :form))) (el-eval session (get finally-return :form) frame))
                    ((not (undefined? (get state :result))) (get state :result))
                    ((get state :accSet) (el-loop-final (get state :accKind) (get state :acc)))
                    ((js-call body :some (lambda (c) (or (= (get c :type) "always") (= (get c :type) "never")))) t)
                    (t nil))))))))))

  (defun el-loop-normalize (word)
    (cond ((js-call word :startsWith "collect") "collect") ((js-call word :startsWith "append") "append")
          ((js-call word :startsWith "nconc") "nconc") ((js-call word :startsWith "sum") "sum")
          ((js-call word :startsWith "count") "count") ((js-call word :startsWith "maximiz") "maximize")
          ((js-call word :startsWith "minimiz") "minimize") (t word)))

  (defun el-loop-initial (word)
    (let ((kind (el-loop-normalize word)))
      (cond ((or (= kind "sum") (= kind "count")) 0) ((= kind "concat") "") ((= kind "vconcat") (el-vector (js-array))) (t nil))))

  (defun el-loop-final (kind acc)
    (if (or (= kind "collect") (= kind "append") (= kind "nconc"))
        (el-list-from acc)
      acc))

  (defun el-loop-accumulate (session clause frame state)
    (let* ((word (get clause :word))
           (value (el-eval session (get clause :expr) frame))
           (into (get clause :into)))
      (if (not (nil? into))
          (let ((current (js-call (get frame :vars) :get into)))
            (js-call (get frame :vars) :set into
                     (cond
                       ((= word "collect") (el-append (js-array current (el-list value))))
                       ((or (= word "append") (= word "nconc")) (el-append (js-array current value)))
                       ((= word "sum") (el-arith "+" (js-array current value)))
                       ((= word "count") (if (nil? value) current (1+ current)))
                       ((= word "maximize") (if (or (nil? current) (> (el-num value) (el-num current))) value current))
                       ((= word "minimize") (if (or (nil? current) (< (el-num value) (el-num current))) value current))
                       ((= word "concat") (str current value))
                       ((= word "vconcat") (el-vector (js-call (el-seq-items current) :concat (el-seq-items value))))
                       (t current))))
        (progn
          (unless (get state :accSet)
            (put state :accSet t)
            (put state :accKind word)
            (put state :acc (cond ((or (= word "collect") (= word "append") (= word "nconc")) (js-array))
                                  ((or (= word "sum") (= word "count")) 0)
                                  ((= word "concat") "")
                                  ((= word "vconcat") (el-vector (js-array)))
                                  (t nil))))
          (let ((acc (get state :acc)))
            (put state :acc
                 (cond
                   ((= word "collect") (js-call acc :push value) acc)
                   ((or (= word "append") (= word "nconc"))
                     (js-call (el-seq-items value) :forEach (lambda (x) (js-call acc :push x))) acc)
                   ((= word "sum") (el-arith "+" (js-array acc value)))
                   ((= word "count") (if (nil? value) acc (1+ acc)))
                   ((= word "maximize") (if (or (nil? acc) (> (el-num value) (el-num acc))) value acc))
                   ((= word "minimize") (if (or (nil? acc) (< (el-num value) (el-num acc))) value acc))
                   ((= word "concat") (str acc value))
                   ((= word "vconcat") (el-vector (js-call (get acc :items) :concat (el-seq-items value))))
                   (t acc))))))))

  (defun el-loop-run-clauses (session clauses frame state)
    ;; Return "continue", "stop" (normal end) or "return".
    (let ((outcome "continue") (index 0))
      (while (and (= outcome "continue") (< index (js-length clauses)))
        (let* ((clause (aref clauses index)) (type (get clause :type)))
          (cond
            ((= type "acc") (el-loop-accumulate session clause frame state))
            ((= type "do") (el-eval-body session (get clause :forms) frame))
            ((= type "cond")
              (let ((test (el-eval session (get clause :test) frame)))
                (setq outcome
                      (el-loop-run-clauses session
                                           (if (if (get clause :negate) (nil? test) (not (nil? test)))
                                               (get clause :then) (get clause :else))
                                           frame state))))
            ((= type "return") (put state :result (el-eval session (get clause :expr) frame)) (setq outcome "return"))
            ((= type "while") (when (nil? (el-eval session (get clause :expr) frame)) (setq outcome "stop")))
            ((= type "until") (unless (nil? (el-eval session (get clause :expr) frame)) (setq outcome "stop")))
            ((= type "always")
              (if (nil? (el-eval session (get clause :expr) frame))
                  (progn (put state :result nil) (setq outcome "return"))
                (when (undefined? (get state :result)) (put state :alwaysT t))))
            ((= type "never")
              (if (not (nil? (el-eval session (get clause :expr) frame)))
                  (progn (put state :result nil) (setq outcome "return"))
                (put state :alwaysT t)))
            ((= type "thereis")
              (let ((value (el-eval session (get clause :expr) frame)))
                (unless (nil? value) (put state :result value) (setq outcome "return"))))))
        (setq index (1+ index)))
      (when (and (= outcome "stop") false) nil)
      (when (and (not (= outcome "return")) (get state :alwaysT) (undefined? (get state :result)))
        (put state :pendingT t))
      outcome))

  (defun el-loop-init (session driver frame)
    (let ((kind (get driver :kind)))
      (cond
        ((or (= kind "in") (= kind "on") (= kind "in-ref")) (put driver :rest (el-eval session (get driver :expr) frame)))
        ((= kind "across") (put driver :items (el-seq-items (el-eval session (get driver :expr) frame))) (put driver :index 0))
        ((= kind "elements") (put driver :items (el-seq-items (el-eval session (get driver :expr) frame))) (put driver :index 0))
        ((or (= kind "hash-keys") (= kind "hash-values"))
          (put driver :items (js-call globalThis.Array :from (js-call (get (el-eval session (get driver :expr) frame) :entries) :values)))
          (put driver :index 0))
        ((= kind "number")
          (put driver :current (if (undefined? (get driver :fromExpr)) 0 (el-num (el-eval session (get driver :fromExpr) frame))))
          (put driver :limit (if (undefined? (get driver :toExpr)) nil (el-num (el-eval session (get driver :toExpr) frame))))
          (put driver :step (if (undefined? (get driver :stepExpr)) 1 (el-num (el-eval session (get driver :stepExpr) frame)))))
        ((= kind "repeat") (put driver :remaining (el-num (el-eval session (get driver :expr) frame))))
        (t nil))))

  (defun el-loop-step (session driver frame first)
    ;; Advance DRIVER (except on the first iteration), bind, and return false when exhausted.
    (let ((kind (get driver :kind)))
      (cond
        ((or (= kind "in") (= kind "on") (= kind "in-ref"))
          (unless first
            (put driver :rest (if (undefined? (get driver :by)) (el-cdr-safe (get driver :rest))
                                (el-call session (el-eval session (get driver :by) frame) (js-array (get driver :rest))))))
          (if (not (el-cons? (get driver :rest))) false
            (progn (el-loop-bind session (get driver :var)
                                 (if (= kind "on") (get driver :rest) (get (get driver :rest) :car)) frame)
                   t)))
        ((or (= kind "across") (= kind "elements") (= kind "hash-keys") (= kind "hash-values"))
          (unless first (put driver :index (1+ (get driver :index))))
          (if (>= (get driver :index) (js-length (get driver :items))) false
            (let ((item (aref (get driver :items) (get driver :index))))
              (cond
                ((= kind "hash-keys")
                  (el-loop-bind session (get driver :var) (aref item 0) frame)
                  (unless (undefined? (get driver :using)) (el-loop-bind session (get driver :using) (aref item 1) frame)))
                ((= kind "hash-values")
                  (el-loop-bind session (get driver :var) (aref item 1) frame)
                  (unless (undefined? (get driver :using)) (el-loop-bind session (get driver :using) (aref item 0) frame)))
                (t (el-loop-bind session (get driver :var) item frame)))
              t)))
        ((= kind "number")
          (unless first (put driver :current (if (get driver :down) (- (get driver :current) (get driver :step))
                                               (+ (get driver :current) (get driver :step)))))
          (let ((current (get driver :current)) (limit (get driver :limit)))
            (if (and (not (nil? limit))
                     (if (get driver :down)
                         (if (get driver :inclusive) (< current limit) (<= current limit))
                       (if (get driver :inclusive) (> current limit) (>= current limit))))
                false
              (progn (el-loop-bind session (get driver :var) current frame) t))))
        ((= kind "=")
          (el-loop-bind session (get driver :var)
                        (el-eval session (if (or first (undefined? (get driver :then))) (get driver :expr) (get driver :then)) frame)
                        frame)
          t)
        ((= kind "repeat")
          (if (<= (get driver :remaining) 0) false
            (progn (put driver :remaining (1- (get driver :remaining))) t)))
        (t t))))

  ;; ------------------------------------------------------------------
  ;; format
  ;; ------------------------------------------------------------------

  (defconst format-directive
    (new globalThis.RegExp "%(?:([0-9]+)\\$)?([-+ #0]*)([0-9]*)(?:\\.([0-9]+))?([sSdoxXcefg%])" "g"))

  (defun el-pad (text width left zero)
    (let ((length (el-string-length text)))
      (if (or (nil? width) (>= length width)) text
        (let ((padding (js-call (if zero "0" " ") :repeat (- width length))))
          (cond
            (left (str text (js-call " " :repeat (- width length))))
            ((and zero (or (js-call text :startsWith "-") (js-call text :startsWith "+")))
              (str (js-call text :slice 0 1) padding (js-call text :slice 1)))
            (t (str padding text)))))))

  (defun el-format-exponent (x precision)
    (el-pad-exponent (js-call x :toExponential precision)))

  (defun el-format (session template args)
    (let ((index 0))
      (js-call template :replace format-directive
               (lambda (whole field flags width precision spec)
                 (if (= spec "%") "%"
                   (let* ((position (if (undefined? field) index (1- (Number/parseInt field 10))))
                          (value (if (< position (js-length args)) (aref args position)
                                   (el-signal "error" "Not enough arguments for format string")))
                          (left (>= (js-call flags :indexOf "-") 0))
                          (zero (and (>= (js-call flags :indexOf "0") 0) (not left)))
                          (plus (>= (js-call flags :indexOf "+") 0))
                          (space (>= (js-call flags :indexOf " ") 0))
                          (alternate (>= (js-call flags :indexOf "#") 0))
                          (w (if (= width "") nil (Number/parseInt width 10)))
                          (p (if (or (undefined? precision) (= precision "")) nil (Number/parseInt precision 10))))
                     (setq index (1+ position))
                     (let ((sign (lambda (text number)
                                   (cond ((and plus (>= number 0) (not (js-call text :startsWith "-"))) (str "+" text))
                                         ((and space (>= number 0) (not (js-call text :startsWith "-"))) (str " " text))
                                         (t text)))))
                       (cond
                         ((or (= spec "s") (= spec "S"))
                           (let ((text (el-prin1-string value (= spec "S"))))
                             (el-pad (if (nil? p) text (el-substring text 0 (Math/min p (el-string-length text)))) w left false)))
                         ((= spec "c") (el-pad (el-char-string (el-num value)) w left false))
                         ((= spec "d")
                           (let ((n (Math/trunc (el-num value))))
                             (el-pad (funcall sign (el-integer-string n) n) w left zero)))
                         ((or (= spec "o") (= spec "x") (= spec "X"))
                           (let* ((n (Math/trunc (el-num value)))
                                  (digits (js-call (Math/abs n) :toString (if (= spec "o") 8 16)))
                                  (text (str (if (< n 0) "-" "") (if (= spec "X") (js-call digits :toUpperCase) digits))))
                             (el-pad (if (and p (< (js-length text) p)) (js-call text :padStart p "0") text) w left zero)))
                         ((= spec "f")
                           (let ((n (el-num value)))
                             (el-pad (funcall sign (js-call n :toFixed (if (nil? p) 6 p)) n) w left zero)))
                         ((= spec "e")
                           (let ((n (el-num value)))
                             (el-pad (funcall sign (el-format-exponent n (if (nil? p) 6 p)) n) w left zero)))
                         ((= spec "g")
                           (let ((n (el-num value)))
                             (el-pad (funcall sign (el-format-g n (if (nil? p) 6 p) alternate) n) w left zero)))
                         (t whole)))))))))

  ;; ------------------------------------------------------------------
  ;; JSON (native json-parse-string/json-serialize and json.el json-encode)
  ;; ------------------------------------------------------------------

  (defun el-json-options (session args start)
    (let ((options (js-object :objectType "hash-table" :arrayType "array" :keyType nil
                              :nullObject (el-intern ":null") :falseObject (el-intern ":false")))
          (index start))
      (while (< index (js-length args))
        (let ((key (el-symbol-name (aref args index))) (value (aref args (1+ index))))
          (cond ((= key ":object-type") (put options :objectType (el-symbol-name value)))
                ((= key ":array-type") (put options :arrayType (el-symbol-name value)))
                ((= key ":null-object") (put options :nullObject value))
                ((= key ":false-object") (put options :falseObject value))))
        (setq index (+ index 2)))
      options))

  (defun el-json-read-options (session)
    (let* ((obj-type (let ((v (el-global-value session (el-intern "json-object-type"))))
                       (if (el-symobj? v) (get v :name) "alist")))
           (arr-type (let ((v (el-global-value session (el-intern "json-array-type"))))
                       (if (and (el-symobj? v) (= (get v :name) "list")) "list" "array")))
           (key-type (let ((v (el-global-value session (el-intern "json-key-type"))))
                       (if (and (el-symobj? v) (not (nil? v))) (get v :name) nil)))
           (null-obj (el-global-value session (el-intern "json-null")))
           (false-obj (el-global-value session (el-intern "json-false"))))
      (js-object :objectType obj-type :arrayType arr-type :keyType key-type
                 :nullObject null-obj :falseObject false-obj)))

  (defun el-json-error (message position)
    (throw (el-make-signal "json-parse-error" (js-array message position))))

  (defun el-json-parse (session text options)
    ;; Recursive descent parser that keeps integer/float distinction.
    (let ((state (js-object :pos 0)) (n (js-length text)))
      (letfn ((skip ()
                (while (and (< (get state :pos) n)
                            (>= (js-call " \t\n\r" :indexOf (js-call text :charAt (get state :pos))) 0))
                  (put state :pos (1+ (get state :pos)))))
              (expect-char (ch)
                (skip)
                (unless (= (js-call text :charAt (get state :pos)) ch)
                  (el-json-error (str "expected " ch) (get state :pos)))
                (put state :pos (1+ (get state :pos))))
              (parse-string ()
                (put state :pos (1+ (get state :pos)))
                (let ((parts (js-array)) (done false))
                  (while (not done)
                    (when (>= (get state :pos) n) (el-json-error "unterminated string" (get state :pos)))
                    (let ((ch (js-call text :charAt (get state :pos))))
                      (put state :pos (1+ (get state :pos)))
                      (cond
                        ((= ch "\"") (setq done t))
                        ((= ch "\\")
                          (let ((e (js-call text :charAt (get state :pos))))
                            (put state :pos (1+ (get state :pos)))
                            (cond
                              ((= e "n") (js-call parts :push "\n")) ((= e "t") (js-call parts :push "\t"))
                              ((= e "r") (js-call parts :push "\r")) ((= e "b") (js-call parts :push "\b"))
                              ((= e "f") (js-call parts :push "\f")) ((= e "/") (js-call parts :push "/"))
                              ((= e "\\") (js-call parts :push "\\")) ((= e "\"") (js-call parts :push "\""))
                              ((= e "u")
                                (js-call parts :push
                                         (String/fromCharCode (Number/parseInt (js-call text :slice (get state :pos) (+ (get state :pos) 4)) 16)))
                                (put state :pos (+ (get state :pos) 4)))
                              (t (el-json-error "bad escape" (get state :pos))))))
                        ((< (js-call ch :charCodeAt 0) 32) (el-json-error "control character in string" (get state :pos)))
                        (t (js-call parts :push ch)))))
                  (js-call parts :join "")))
              (parse-value ()
                (skip)
                (when (>= (get state :pos) n) (throw (el-make-signal "json-end-of-file" (js-array))))
                (let ((ch (js-call text :charAt (get state :pos))))
                  (cond
                    ((= ch "{")
                      (put state :pos (1+ (get state :pos)))
                      (let ((entries (js-array)))
                        (skip)
                        (if (= (js-call text :charAt (get state :pos)) "}")
                            (put state :pos (1+ (get state :pos)))
                          (let ((more t))
                            (while more
                              (skip)
                              (unless (= (js-call text :charAt (get state :pos)) "\"") (el-json-error "expected key" (get state :pos)))
                              (let ((key (parse-string)))
                                (expect-char ":")
                                (js-call entries :push (js-array key (parse-value))))
                              (skip)
                              (let ((sep (js-call text :charAt (get state :pos))))
                                (put state :pos (1+ (get state :pos)))
                                (cond ((= sep "}") (setq more false))
                                      ((not (= sep ",")) (el-json-error "expected , or }" (get state :pos))))))))
                        (el-json-object options entries)))
                    ((= ch "[")
                      (put state :pos (1+ (get state :pos)))
                      (let ((items (js-array)))
                        (skip)
                        (if (= (js-call text :charAt (get state :pos)) "]")
                            (put state :pos (1+ (get state :pos)))
                          (let ((more t))
                            (while more
                              (js-call items :push (parse-value))
                              (skip)
                              (let ((sep (js-call text :charAt (get state :pos))))
                                (put state :pos (1+ (get state :pos)))
                                (cond ((= sep "]") (setq more false))
                                      ((not (= sep ",")) (el-json-error "expected , or ]" (get state :pos))))))))
                        (if (= (get options :arrayType) "list") (el-list-from items) (el-vector items))))
                    ((= ch "\"") (parse-string))
                    ((js-call text :startsWith "true" (get state :pos)) (put state :pos (+ (get state :pos) 4)) t)
                    ((js-call text :startsWith "false" (get state :pos)) (put state :pos (+ (get state :pos) 5)) (get options :falseObject))
                    ((js-call text :startsWith "null" (get state :pos)) (put state :pos (+ (get state :pos) 4)) (get options :nullObject))
                    (t
                      (let* ((pattern (new globalThis.RegExp "-?(?:0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?" "y")))
                        (put pattern :lastIndex (get state :pos))
                        (let ((match (js-call pattern :exec text)))
                          (when (nil? match) (el-json-error "unexpected token" (get state :pos)))
                          (put state :pos (+ (get state :pos) (js-length (aref match 0))))
                          (let ((number (Number/parseFloat (aref match 0))))
                            (if (or (not (undefined? (aref match 1))) (not (undefined? (aref match 2))))
                                (el-make-float number)
                              number)))))))))
        (let ((value (parse-value)))
          (if (get options :allowTrailing)
              (put options :endPos (get state :pos))
            (progn
              (skip)
              (when (< (get state :pos) n) (throw (el-make-signal "json-trailing-content" (js-array (get state :pos)))))))
          value))))

  (defun el-json-object (options entries)
    (let ((type (get options :objectType))
          (ktype (get options :keyType)))
      (cond
        ((= type "alist")
          (el-list-from
           (js-call entries :map
                    (lambda (e)
                      (let ((k (cond ((= ktype "string") (aref e 0))
                                     ((= ktype "keyword") (el-intern (str ":" (aref e 0))))
                                     (t (el-intern (aref e 0))))))
                        (el-cons k (aref e 1)))))))
        ((= type "plist")
          (let ((items (js-array)))
            (js-call entries :forEach
                     (lambda (e)
                       (let ((k (cond ((= ktype "string") (aref e 0))
                                      ((= ktype "symbol") (el-intern (aref e 0)))
                                      (t (el-intern (str ":" (aref e 0)))))))
                         (js-call items :push k)
                         (js-call items :push (aref e 1)))))
            (el-list-from items)))
        (t (let ((table (el-make-hash-table "equal")))
             (js-call entries :forEach
                      (lambda (e) (when (undefined? (js-call (get table :entries) :get (el-hash-key table (aref e 0))))
                                    (el-puthash (aref e 0) (aref e 1) table))))
             table)))))

  (defconst json-short-escapes
    (new globalThis.Map (js-array (js-array 34 "\"") (js-array 92 "\\") (js-array 8 "b") (js-array 12 "f")
                                  (js-array 10 "n") (js-array 13 "r") (js-array 9 "t"))))
  (defconst default-json-special-chars
    (el-list (el-cons 34 34) (el-cons 92 92) (el-cons 98 8) (el-cons 102 12)
             (el-cons 110 10) (el-cons 114 13) (el-cons 116 9)))
  (defconst json-escape-check-pattern (new globalThis.RegExp "[\"\\\\\\x00-\\x1f]"))
  (defconst json-escape-replace-pattern (new globalThis.RegExp "[\"\\\\\\x00-\\x1f]" "g"))

  (defun el-json-escape (text short-map)
    ;; SHORT-MAP: host Map from code point to escape letter.
    (if (= short-map json-short-escapes)
        (if (not (js-call json-escape-check-pattern :test text))
            (str "\"" text "\"")
          (str "\""
               (js-call text :replace json-escape-replace-pattern
                        (lambda (ch)
                          (let ((code (js-call ch :charCodeAt 0)))
                            (if (js-call json-short-escapes :has code)
                                (str "\\" (js-call json-short-escapes :get code))
                              (str "\\u" (js-call (js-call code :toString 16) :padStart 4 "0"))))))
               "\""))
      (let ((out (js-array "\"")))
        (js-call (Array/from text) :forEach
                 (lambda (ch)
                   (let ((code (js-call ch :codePointAt 0)))
                     (cond
                       ((js-call short-map :has code) (js-call out :push (str "\\" (js-call short-map :get code))))
                       ((< code 32) (js-call out :push (str "\\u" (js-call (js-call code :toString 16) :padStart 4 "0"))))
                       (t (js-call out :push ch))))))
        (js-call out :push "\"")
        (js-call out :join ""))))

  (defun el-json-key (key)
    (cond ((el-string? key) key)
          ((el-keyword? key) (js-call (get key :name) :slice 1))
          ((el-symobj? key) (get key :name))
          (t (el-signal "wrong-type-argument" (el-intern "stringp") key))))

  (defun el-alist? (value)
    (if (not (el-cons? value)) false
      (let ((cursor value) (ok t))
        (while (and ok (el-cons? cursor))
          (let ((cell (get cursor :car)))
            (if (and (el-cons? cell) (or (el-symbol? (get cell :car)) (el-string? (get cell :car))))
                (setq cursor (get cursor :cdr))
              (setq ok false))))
        ok)))
  (defun el-plist-of-keywords? (value)
    (if (not (el-cons? value)) false
      (let ((cursor value) (ok t))
        (while (and ok (el-cons? cursor))
          (let ((next (get cursor :cdr)))
            (if (and (el-keyword? (get cursor :car)) (el-cons? next))
                (setq cursor (get next :cdr))
              (setq ok false))))
        (and ok (nil? cursor)))))

  (defun el-json-serialize (session value options)
    (letfn ((emit (v)
              (cond
                ((eq v t) "true")
                ((eq v (get options :nullObject)) "null")
                ((eq v (get options :falseObject)) "false")
                ((nil? v) "{}")
                ((el-string? v) (el-json-escape v json-short-escapes))
                ((el-number? v) (el-number-string v))
                ((el-hash-table? v)
                  (let ((parts (js-array)))
                    (js-call (get v :entries) :forEach
                             (lambda (entry) (js-call parts :push (str (el-json-escape (el-json-key (aref entry 0)) json-short-escapes) ":" (emit (aref entry 1))))))
                    (str "{" (js-call parts :join ",") "}")))
                ((el-vector? v) (str "[" (js-call (js-call (get v :items) :map (lambda (x) (emit x))) :join ",") "]"))
                ((el-plist-of-keywords? v)
                  (let ((cursor v) (parts (js-array)) (seen (new globalThis.Set)))
                    (while (el-cons? cursor)
                      (let ((key (el-json-key (get cursor :car)))
                            (next (get cursor :cdr)))
                        (unless (js-call seen :has key)
                          (js-call seen :add key)
                          (js-call parts :push (str (el-json-escape key json-short-escapes) ":" (emit (get next :car)))))
                        (setq cursor (get next :cdr))))
                    (str "{" (js-call parts :join ",") "}")))
                ((el-alist? v)
                  (let ((cursor v) (parts (js-array)) (seen (new globalThis.Set)))
                    (while (el-cons? cursor)
                      (let* ((cell (get cursor :car))
                             (key (el-json-key (get cell :car))))
                        (unless (js-call seen :has key)
                          (js-call seen :add key)
                          (js-call parts :push (str (el-json-escape key json-short-escapes) ":" (emit (get cell :cdr)))))
                        (setq cursor (get cursor :cdr))))
                    (str "{" (js-call parts :join ",") "}")))
                (t (el-signal "wrong-type-argument" (el-intern "json-value-p") v)))))
      (el-encode-utf8 (emit value))))

  (defun el-json-encode (session value)
    ;; json.el semantics, honoring json-null, json-false and json-special-chars.
    (cond
      ((el-number? value) (el-number-string value))
      ((eq value t) "true")
      (t
        (let* ((values (get session :values))
               (json-null (js-call values :get (el-intern "json-null")))
               (json-false (js-call values :get (el-intern "json-false"))))
          (cond
            ((and (not (undefined? json-false)) (eq value json-false)) "false")
            ((or (nil? value) (and (not (undefined? json-null)) (eq value json-null))) "null")
            (t
              (let* ((special (js-call values :get (el-intern "json-special-chars")))
                     (short (if (or (undefined? special)
                                    (eq special default-json-special-chars)
                                    (el-equal-p special default-json-special-chars 0))
                                json-short-escapes
                              (let ((m (new globalThis.Map)))
                                (js-call (el-list-to-array special) :forEach
                                         (lambda (cell) (js-call m :set (el-num (get cell :cdr)) (el-char-string (el-num (get cell :car))))))
                                m))))
                (if (el-string? value)
                    (el-json-escape value short)
                  (letfn ((emit (v)
                            (cond
                              ((eq v t) "true")
                              ((and (not (undefined? json-false)) (eq v json-false)) "false")
                              ((and (not (undefined? json-null)) (eq v json-null)) "null")
                              ((nil? v) "null")
                              ((el-string? v) (el-json-escape v short))
                              ((el-number? v) (el-number-string v))
                              ((el-symobj? v) (el-json-escape (get v :name) short))
                              ((el-hash-table? v)
                                (let ((parts (js-array)))
                                  (js-call (get v :entries) :forEach
                                           (lambda (entry) (js-call parts :push (str (el-json-escape (el-json-key (aref entry 0)) short) ":" (emit (aref entry 1))))))
                                  (str "{" (js-call parts :join ",") "}")))
                              ((el-vector? v) (str "[" (js-call (js-call (get v :items) :map (lambda (x) (emit x))) :join ",") "]"))
                              ((el-alist? v)
                                (let ((cursor v) (parts (js-array)))
                                  (while (el-cons? cursor)
                                    (let ((cell (get cursor :car)))
                                      (js-call parts :push (str (el-json-escape (el-json-key (get cell :car)) short) ":" (emit (get cell :cdr))))
                                      (setq cursor (get cursor :cdr))))
                                  (str "{" (js-call parts :join ",") "}")))
                              ((el-plist-of-keywords? v)
                                (let ((cursor v) (parts (js-array)))
                                  (while (el-cons? cursor)
                                    (let ((next (get cursor :cdr)))
                                      (js-call parts :push (str (el-json-escape (el-json-key (get cursor :car)) short) ":" (emit (get next :car))))
                                      (setq cursor (get next :cdr))))
                                  (str "{" (js-call parts :join ",") "}")))
                              ((el-cons? v)
                                (let ((cursor v) (parts (js-array)))
                                  (while (el-cons? cursor)
                                    (js-call parts :push (emit (get cursor :car)))
                                    (setq cursor (get cursor :cdr)))
                                  (str "[" (js-call parts :join ",") "]")))
                              (t (el-signal "json-error" v)))))
                    (emit value))))))))))

  ;; ------------------------------------------------------------------
  ;; SHA-256 (FIPS 180-4) over bytes, written with Eliscript word operations
  ;; ------------------------------------------------------------------

  (defconst sha256-k
    (js-array 1116352408 1899447441 3049323471 3921009573 961987163 1508970993 2453635748 2870763221
              3624381080 310598401 607225278 1426881987 1925078388 2162078206 2614888103 3248222580
              3835390401 4022224774 264347078 604807628 770255983 1249150122 1555081692 1996064986
              2554220882 2821834349 2952996808 3210313671 3336571891 3584528711 113926993 338241895
              666307205 773529912 1294757372 1396182291 1695183700 1986661051 2177026350 2456956037
              2730485921 2820302411 3259730800 3345764771 3516065817 3600352804 4094571909 275423344
              430227734 506948616 659060556 883997877 958139571 1322822218 1537002063 1747873779
              1955562222 2024104815 2227730452 2361852424 2428436474 2756734187 3204031479 3329325298))

  (defun el-xor3 (a b c) (bit-xor (bit-xor a b) c))
  (defun el-rotr (x n) (uint32 (bit-or (unsigned-bit-shift-right x n) (bit-shift-left x (- 32 n)))))

  (defun el-sha256 (bytes)
    (let* ((length (js-length bytes))
           (data (js-call bytes :slice))
           (bit-length (* length 8))
           (h (js-array 1779033703 3144134277 1013904242 2773480762 1359893119 2600822924 528734635 1541459225))
           (w (js-array)))
      (js-call data :push 128)
      (while (/= (% (js-length data) 64) 56) (js-call data :push 0))
      (let ((high (Math/floor (/ bit-length 4294967296))) (low (uint32 bit-length)))
        (js-call data :push (bit-and (unsigned-bit-shift-right high 24) 255) (bit-and (unsigned-bit-shift-right high 16) 255)
                 (bit-and (unsigned-bit-shift-right high 8) 255) (bit-and high 255)
                 (bit-and (unsigned-bit-shift-right low 24) 255) (bit-and (unsigned-bit-shift-right low 16) 255)
                 (bit-and (unsigned-bit-shift-right low 8) 255) (bit-and low 255)))
      (let ((offset 0))
        (while (< offset (js-length data))
          (let ((t-index 0))
            (while (< t-index 64)
              (if (< t-index 16)
                  (let ((base (+ offset (* t-index 4))))
                    (put w t-index (uint32 (+ (* (aref data base) 16777216) (* (aref data (+ base 1)) 65536)
                                               (* (aref data (+ base 2)) 256) (aref data (+ base 3))))))
                (let* ((w15 (aref w (- t-index 15))) (w2 (aref w (- t-index 2)))
                       (s0 (el-xor3 (el-rotr w15 7) (el-rotr w15 18) (unsigned-bit-shift-right w15 3)))
                       (s1 (el-xor3 (el-rotr w2 17) (el-rotr w2 19) (unsigned-bit-shift-right w2 10))))
                  (put w t-index (uint32 (+ (aref w (- t-index 16)) s0 (aref w (- t-index 7)) s1)))))
              (setq t-index (1+ t-index))))
          (let ((a (aref h 0)) (b (aref h 1)) (c (aref h 2)) (d (aref h 3))
                (e (aref h 4)) (f (aref h 5)) (g (aref h 6)) (hh (aref h 7)) (i 0))
            (while (< i 64)
              (let* ((s1 (el-xor3 (el-rotr e 6) (el-rotr e 11) (el-rotr e 25)))
                     (ch (bit-xor (bit-and e f) (bit-and (bit-not e) g)))
                     (temp1 (uint32 (+ hh s1 ch (aref sha256-k i) (aref w i))))
                     (s0 (el-xor3 (el-rotr a 2) (el-rotr a 13) (el-rotr a 22)))
                     (maj (el-xor3 (bit-and a b) (bit-and a c) (bit-and b c)))
                     (temp2 (uint32 (+ s0 maj))))
                (setq hh g) (setq g f) (setq f e)
                (setq e (uint32 (+ d temp1)))
                (setq d c) (setq c b) (setq b a)
                (setq a (uint32 (+ temp1 temp2))))
              (setq i (1+ i)))
            (put h 0 (uint32 (+ (aref h 0) a))) (put h 1 (uint32 (+ (aref h 1) b)))
            (put h 2 (uint32 (+ (aref h 2) c))) (put h 3 (uint32 (+ (aref h 3) d)))
            (put h 4 (uint32 (+ (aref h 4) e))) (put h 5 (uint32 (+ (aref h 5) f)))
            (put h 6 (uint32 (+ (aref h 6) g))) (put h 7 (uint32 (+ (aref h 7) hh))))
          (setq offset (+ offset 64))))
      (let ((digest (js-array)))
        (js-call h :forEach
                 (lambda (word)
                   (js-call digest :push (bit-and (unsigned-bit-shift-right word 24) 255)
                            (bit-and (unsigned-bit-shift-right word 16) 255)
                            (bit-and (unsigned-bit-shift-right word 8) 255) (bit-and word 255))))
        digest)))

  (defun el-secure-hash (algorithm object start end binary)
    (let ((name (el-symbol-name algorithm)))
      (unless (= name "sha256") (el-signal "error" (str "Unsupported hash algorithm " name)))
      (let* ((text (if (el-string? object) (el-substring object start end)
                     (el-buffer-substring object (if (nullish? start) 1 start)
                                          (if (nullish? end) (el-point-max object) end))))
             (digest (el-sha256 (el-string-bytes-array text))))
        (if (and (not (nullish? binary)) (not (nil? binary)))
            (el-bytes-string digest)
          (js-call (js-call digest :map (lambda (b) (js-call (js-call b :toString 16) :padStart 2 "0"))) :join "")))))

  ;; ------------------------------------------------------------------
  ;; Symbol properties, types and output
  ;; ------------------------------------------------------------------

  (defun el-get-prop (session symbol prop)
    (let ((plist (js-call (get session :plists) :get symbol)))
      (if (undefined? plist) nil
        (let ((value (js-call plist :get prop))) (if (undefined? value) nil value)))))

  (defun el-put-prop (session symbol prop value)
    (let ((plist (js-call (get session :plists) :get symbol)))
      (when (undefined? plist)
        (setq plist (new globalThis.Map))
        (js-call (get session :plists) :set symbol plist))
      (js-call plist :set prop value)
      value))

  (defun el-type-of (value)
    (cond
      ((or (nil? value) (eq value t)) "symbol")
      ((el-integer? value) "integer")
      ((el-float? value) "float")
      ((el-string? value) "string")
      ((el-function? value) "subr")
      (t (let ((kind (get value :kind)))
           (cond ((= kind "keyword") "symbol")
                 ((= kind "record") (el-symbol-name (aref (get value :items) 0)))
                 (t kind))))))

  (defun el-cl-typep (session value type)
    (let ((name (el-symbol-name type)))
      (el-bool
       (cond
         ((= name "null") (nil? value))
         ((or (= name "integer") (= name "fixnum")) (el-integer? value))
         ((= name "number") (el-number? value))
         ((= name "float") (el-float? value))
         ((= name "string") (el-string? value))
         ((= name "symbol") (el-symbol? value))
         ((= name "keyword") (el-keyword? value))
         ((= name "list") (or (nil? value) (el-cons? value)))
         ((= name "cons") (el-cons? value))
         ((= name "vector") (el-vector? value))
         ((= name "hash-table") (el-hash-table? value))
         ((= name "function") (el-function? value))
         ((= name "boolean") (or (nil? value) (eq value t)))
         ((or (= name "t") (= name "atom")) (or (= name "t") (not (el-cons? value))))
         (t (el-struct-instance? session value name))))))

  (defun el-write-stdout (text)
    (let ((p globalThis.process))
      (when (and (not (nullish? p)) (not (nullish? (get p :stdout))))
        (js-call (get p :stdout) :write text))))

  (defun el-write-stderr (text)
    (let ((p globalThis.process))
      (when (and (not (nullish? p)) (not (nullish? (get p :stderr))))
        (js-call (get p :stderr) :write text))))

  (defun el-emit-output (session text &optional is-stderr)
    (let ((output (get session :output)))
      (if (not (nil? output))
          (js-call output :push text)
        (when (get session :batchOutput)
          (if is-stderr (el-write-stderr text) (el-write-stdout text))))
      text))

  (defun el-write-stream (session text stream)
    (let ((target (if (or (nullish? stream) (nil? stream))
                      (el-global-value session (el-intern "standard-output"))
                    stream)))
      (cond
        ((= (el-kind target) "buffer")
          (el-buffer-insert target text))
        ((or (el-function? target)
             (and (el-symobj? target) (not (eq target t)) (not (nil? target))))
          (let ((fn (if (el-symobj? target) (el-symbol-function session target) target)))
            (if (and (not (nil? fn)) (get fn :isBuiltinExtDbg))
                (el-write-stderr text)
              (js-call (el-string-codes text) :forEach
                       (lambda (code) (el-call session target (js-array code)))))))
        (t
          (el-emit-output session text false)))))

  (defun el-def (session name fn)
    (put fn :elispName name)
    (el-set-fn session (el-intern name) fn))

  (defun el-def-alias (session name target)
    (el-set-fn session (el-intern name) (js-call (get session :functions) :get (el-intern target))))

  (defun el-opt (x) (if (undefined? x) nil x))

  (defun el-number-from-string (string base)
    (let* ((radix (if (nullish? base) 10 base))
           (text (js-call string :replace (new globalThis.RegExp "^[ \\t]+") "")))
      (if (= radix 10)
          (let ((match (js-call (new globalThis.RegExp "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?") :exec text)))
            (if (nil? match) 0
              (let ((token (aref match 0)))
                (if (js-call (new globalThis.RegExp "^[+-]?[0-9]+\\.?$") :test token)
                    (Number/parseInt token 10)
                  (el-make-float (Number/parseFloat token))))))
        (let ((value (Number/parseInt text radix))) (if (Number/isNaN value) 0 value)))))

  (defun el-mapconcat (session fn seq separator)
    (js-call (js-call (el-seq-items seq) :map
                      (lambda (item)
                        (let ((value (el-call session fn (js-array item))))
                          (if (el-string? value) value (el-concat-pieces (js-array value))))))
             :join (if (nullish? separator) "" separator)))

  (defun el-concat-pieces (args)
    (js-call (js-call args :map (lambda (arg) (if (el-string? arg) arg (el-string-from-codes (el-seq-items arg))))) :join ""))

  (defun el-compare-strings (s1 start1 end1 s2 start2 end2 ignore-case)
    (if (and (or (nullish? ignore-case) (nil? ignore-case))
             (not (el-astral? s1))
             (not (el-astral? s2)))
        (let* ((n1 (js-length s1))
               (n2 (js-length s2))
               (b1 (if (or (nullish? start1) (nil? start1)) 0 (Math/max 0 (Math/min n1 (el-num start1)))))
               (e1 (if (or (nullish? end1) (nil? end1)) n1 (Math/max b1 (Math/min n1 (el-num end1)))))
               (b2 (if (or (nullish? start2) (nil? start2)) 0 (Math/max 0 (Math/min n2 (el-num start2)))))
               (e2 (if (or (nullish? end2) (nil? end2)) n2 (Math/max b2 (Math/min n2 (el-num end2)))))
               (sub1 (js-call s1 :slice b1 e1))
               (sub2 (js-call s2 :slice b2 e2)))
          (if (= sub1 sub2)
              t
            (let ((len1 (js-length sub1)) (len2 (js-length sub2)) (idx 0) (res t))
              (while (and (eq res t) (< idx (Math/max len1 len2)))
                (cond
                  ((>= idx len1) (setq res (- 0 (1+ idx))))
                  ((>= idx len2) (setq res (1+ idx)))
                  (t (let ((x (js-call sub1 :charCodeAt idx)) (y (js-call sub2 :charCodeAt idx)))
                       (cond ((< x y) (setq res (- 0 (1+ idx))))
                             ((> x y) (setq res (1+ idx)))))))
                (setq idx (1+ idx)))
              res)))
      (let* ((a (el-string-codes (el-substring s1 (el-opt start1) (if (nullish? end1) nil (Math/min end1 (el-string-length s1))))))
             (b (el-string-codes (el-substring s2 (el-opt start2) (if (nullish? end2) nil (Math/min end2 (el-string-length s2))))))
             (index 0) (result t))
        (while (and (eq result t) (< index (Math/max (js-length a) (js-length b))))
          (cond
            ((>= index (js-length a)) (setq result (- 0 (1+ index))))
            ((>= index (js-length b)) (setq result (1+ index)))
            (t (let ((x (aref a index)) (y (aref b index)))
                 (when (and ignore-case (not (nil? ignore-case)))
                   (setq x (el-upcase x)) (setq y (el-upcase y)))
                 (cond ((< x y) (setq result (- 0 (1+ index))))
                       ((> x y) (setq result (1+ index)))))))
          (setq index (1+ index)))
        result)))

  (defun el-truncate-string-to-width (string end start padding ellipsis)
    (let ((width 0) (out (js-array)) (start-column (if (nullish? start) 0 start)))
      (js-call (Array/from string) :forEach
               (lambda (ch)
                 (let ((w (el-char-width (js-call ch :codePointAt 0))))
                   (when (<= (+ width w) end)
                     (when (>= width start-column) (js-call out :push ch))
                     (setq width (+ width w)))
                   (when (> (+ width w) end) (setq width (+ end 1000000))))))
      (js-call out :join "")))

  (defun el-regexp-opt (strings paren)
    (let* ((items (el-list-to-array strings))
           (unique (js-array)))
      (js-call items :forEach
               (lambda (s)
                 (unless (el-string? s) (el-signal "wrong-type-argument" (el-intern "stringp") s))
                 (unless (js-call unique :includes s) (js-call unique :push s))))
      (js-call unique :sort
               (lambda (a b)
                 (if (/= (js-length b) (js-length a))
                     (- (js-length b) (js-length a))
                   (if (< a b) -1 (if (> a b) 1 0)))))
      (let ((body (if (= (js-length unique) 0)
                      "\\`a\\`"
                    (js-call (js-call unique :map (lambda (s) (el-regexp-quote s))) :join "\\|"))))
        (cond
          ((or (nullish? paren) (nil? paren)) (str "\\(?:" body "\\)"))
          ((el-sym-is paren "words") (str "\\<\\(" body "\\)\\>"))
          ((el-sym-is paren "symbols") (str "\\_<\\(" body "\\)\\_>"))
          ((el-string? paren) (str paren body "\\)"))
          (t (str "\\(" body "\\)"))))))

  (defun el-home-directory ()
    (let ((p globalThis.process))
      (if (or (nullish? p) (nullish? (get p :env)) (nullish? (get (get p :env) :HOME)))
          "/root"
        (get (get p :env) :HOME))))

  (defun el-expand-tilde (path)
    (cond
      ((= path "~") (el-home-directory))
      ((js-call path :startsWith "~/")
        (str (js-call (el-home-directory) :replace (new globalThis.RegExp "/+$") "") (js-call path :slice 1)))
      (t path)))

  (defun el-normalize-file-path (path)
    (let* ((abs (js-call path :startsWith "/"))
           (trailing (and (> (js-length path) 1) (js-call path :endsWith "/")))
           (parts (js-call path :split "/"))
           (stack (js-array)))
      (js-call parts :forEach
               (lambda (part)
                 (cond
                   ((or (= part "") (= part ".")) nil)
                   ((= part "..")
                     (if (and (> (js-length stack) 0) (not (= (aref stack (1- (js-length stack))) "..")))
                         (js-call stack :pop)
                       (unless abs (js-call stack :push ".."))))
                   (t (js-call stack :push part)))))
      (let ((joined (js-call stack :join "/")))
        (cond
          (abs (str "/" joined (if (and trailing (> (js-length joined) 0)) "/" "")))
          ((= joined "") (if trailing "./" "."))
          (t (str joined (if trailing "/" "")))))))

  (defun el-expand-file-name (session name dir)
    (unless (el-string? name) (el-signal "wrong-type-argument" (el-intern "stringp") name))
    (let* ((base-raw (if (or (nullish? dir) (nil? dir))
                         (or (js-call (get session :values) :get (el-intern "default-directory")) "/")
                       dir)))
      (unless (el-string? base-raw) (el-signal "wrong-type-argument" (el-intern "stringp") base-raw))
      (let ((expanded-name (el-expand-tilde name))
            (expanded-base (el-expand-tilde base-raw)))
        (if (js-call expanded-name :startsWith "/")
            (el-normalize-file-path expanded-name)
          (let ((abs-base (if (js-call expanded-base :startsWith "/")
                              expanded-base
                            (str "/" expanded-base))))
            (el-normalize-file-path
             (str (js-call abs-base :replace (new globalThis.RegExp "/?$") "/") expanded-name)))))))

  (defun el-file-relative-name (session filename directory)
    (let* ((target (js-call (el-expand-file-name session filename nil) :replace (new globalThis.RegExp "/+$") ""))
           (base (js-call (el-expand-file-name session (if (or (nullish? directory) (nil? directory))
                                                           (or (js-call (get session :values) :get (el-intern "default-directory")) "/")
                                                         directory)
                                               nil)
                          :replace (new globalThis.RegExp "/+$") ""))
           (t-parts (js-call (js-call target :split "/") :filter (lambda (s) (> (js-length s) 0))))
           (b-parts (js-call (js-call base :split "/") :filter (lambda (s) (> (js-length s) 0))))
           (common 0))
      (while (and (< common (js-length t-parts))
                  (< common (js-length b-parts))
                  (= (aref t-parts common) (aref b-parts common)))
        (setq common (1+ common)))
      (let ((ups (js-array))
            (i common))
        (while (< i (js-length b-parts))
          (js-call ups :push "..")
          (setq i (1+ i)))
        (let ((rel (js-call (js-call ups :concat (js-call t-parts :slice common)) :join "/")))
          (if (= rel "") "." rel)))))

  (defun el-file-name-sans-extension (f)
    (unless (el-string? f) (el-signal "wrong-type-argument" (el-intern "stringp") f))
    (let* ((slash (js-call f :lastIndexOf "/"))
           (dir (if (< slash 0) "" (js-call f :slice 0 (1+ slash))))
           (base (if (< slash 0) f (js-call f :slice (1+ slash))))
           (dot (js-call base :lastIndexOf ".")))
      (if (<= dot 0) f (str dir (js-call base :slice 0 dot)))))

  (defun el-file-name-extension (f period)
    (unless (el-string? f) (el-signal "wrong-type-argument" (el-intern "stringp") f))
    (let* ((slash (js-call f :lastIndexOf "/"))
           (base (if (< slash 0) f (js-call f :slice (1+ slash))))
           (dot (js-call base :lastIndexOf ".")))
      (if (or (<= dot 0) (= dot (1- (js-length base))))
          nil
        (js-call base :slice (if (and (not (nullish? period)) (not (nil? period))) dot (1+ dot))))))

  (defun el-url-generic-parse-url (session url-str)
    (if (not (el-string? url-str))
        (el-call session (el-intern "make-url") (js-array))
      (let ((m (js-call (new globalThis.RegExp "^(?:([A-Za-z][A-Za-z0-9+.-]*):)?(//(?:([^/:@#?]+)(?::([^/@#?]*))?@)?(\\[[^\\]]+\\]|[^/:?#]*)(?::([0-9]+))?)?([^#]*)(?:#(.*))?$")
                        :exec url-str)))
        (if (nil? m)
            (el-call session (el-intern "make-url") (js-array (el-intern ":filename") url-str))
          (let ((scheme (if (undefined? (aref m 1)) nil (js-call (aref m 1) :toLowerCase)))
                (full (el-bool (not (undefined? (aref m 2)))))
                (user (if (undefined? (aref m 3)) nil (aref m 3)))
                (pass (if (undefined? (aref m 4)) nil (aref m 4)))
                (host (if (undefined? (aref m 2)) nil (if (undefined? (aref m 5)) "" (aref m 5))))
                (port (if (undefined? (aref m 6)) nil (Number/parseInt (aref m 6) 10)))
                (file (if (undefined? (aref m 7)) "" (aref m 7)))
                (targ (if (undefined? (aref m 8)) nil (aref m 8))))
            (el-call session (el-intern "make-url")
                     (js-array (el-intern ":type") scheme
                               (el-intern ":user") user
                               (el-intern ":password") pass
                               (el-intern ":host") host
                               (el-intern ":portsitory") port
                               (el-intern ":filename") file
                               (el-intern ":target") targ
                               (el-intern ":fullness") full)))))))

  ;; ------------------------------------------------------------------
  ;; Host OS, File System, Subprocess, HTTP & ERT Primitives
  ;; ------------------------------------------------------------------

  (defconst host-builtins (new globalThis.Map))

  (defun el-node-builtin (name)
    (if (js-call host-builtins :has name)
        (js-call host-builtins :get name)
      (let* ((proc globalThis.process)
             (getter (if (nullish? proc) nil (get proc :getBuiltinModule)))
             (mod (if (nullish? getter) nil
                    (try (or (js-call proc :getBuiltinModule name)
                             (js-call proc :getBuiltinModule (str "node:" name)))
                      (catch e nil)))))
        (js-call host-builtins :set name mod)
        mod)))

  (defun el-fs () (el-node-builtin "fs"))
  (defun el-path () (el-node-builtin "path"))
  (defun el-os () (el-node-builtin "os"))
  (defun el-child-process () (el-node-builtin "child_process"))
  (defun el-worker-threads () (el-node-builtin "worker_threads"))

  (defconst io-worker-code
    (str
      "const { parentPort, workerData } = require('worker_threads');\n"
      "const { spawn } = require('child_process');\n"
      "const signal = new Int32Array(workerData.signal);\n"
      "const outPort = workerData.port;\n"
      "const children = new Map();\n"
      "function send(msg) {\n"
      "  outPort.postMessage(msg);\n"
      "  Atomics.add(signal, 0, 1);\n"
      "  Atomics.notify(signal, 0);\n"
      "}\n"
      "parentPort.on('message', async (msg) => {\n"
      "  if (msg.type === 'spawn') {\n"
      "    try {\n"
      "      const child = spawn(msg.file, msg.args, {\n"
      "        cwd: msg.cwd || undefined,\n"
      "        env: msg.env || process.env,\n"
      "        stdio: ['pipe', 'pipe', 'pipe'],\n"
      "        detached: false\n"
      "      });\n"
      "      children.set(msg.id, child);\n"
      "      let spawnedSent = false;\n"
      "      child.on('spawn', () => {\n"
      "        if (!spawnedSent) {\n"
      "          spawnedSent = true;\n"
      "          send({ type: 'spawned', id: msg.id, pid: child.pid || 0 });\n"
      "        }\n"
      "      });\n"
      "      if (child.pid && !spawnedSent) {\n"
      "        spawnedSent = true;\n"
      "        send({ type: 'spawned', id: msg.id, pid: child.pid });\n"
      "      }\n"
      "      child.stdout.on('data', (chunk) => {\n"
      "        send({ type: 'stdout', id: msg.id, bytes: Array.from(chunk) });\n"
      "      });\n"
      "      child.stderr.on('data', (chunk) => {\n"
      "        send({ type: 'stderr', id: msg.id, bytes: Array.from(chunk) });\n"
      "      });\n"
      "      child.on('error', (err) => {\n"
      "        send({ type: 'spawn-error', id: msg.id, message: String(err && err.message ? err.message : err) });\n"
      "      });\n"
      "      child.on('close', (code, sig) => {\n"
      "        children.delete(msg.id);\n"
      "        send({ type: 'exit', id: msg.id, code: typeof code === 'number' ? code : (sig ? 128 : 0), signal: sig || null });\n"
      "      });\n"
      "    } catch (err) {\n"
      "      send({ type: 'spawn-error', id: msg.id, message: String(err && err.message ? err.message : err) });\n"
      "    }\n"
      "  } else if (msg.type === 'stdin') {\n"
      "    const child = children.get(msg.id);\n"
      "    if (child && child.stdin && !child.stdin.destroyed) {\n"
      "      try { child.stdin.write(Buffer.from(msg.bytes)); } catch (_) {}\n"
      "    }\n"
      "  } else if (msg.type === 'eof') {\n"
      "    const child = children.get(msg.id);\n"
      "    if (child && child.stdin && !child.stdin.destroyed) {\n"
      "      try { child.stdin.end(); } catch (_) {}\n"
      "    }\n"
      "  } else if (msg.type === 'kill') {\n"
      "    const child = children.get(msg.id);\n"
      "    if (child) {\n"
      "      try { child.kill(msg.sig || 'SIGTERM'); } catch (_) {}\n"
      "    }\n"
      "  } else if (msg.type === 'http') {\n"
      "    try {\n"
      "      const opts = { method: msg.method || 'GET', headers: msg.headers || {} };\n"
      "      if (msg.bodyBytes && msg.bodyBytes.length > 0 && opts.method !== 'GET' && opts.method !== 'HEAD') {\n"
      "        opts.body = Buffer.from(msg.bodyBytes);\n"
      "      }\n"
      "      const res = await fetch(msg.url, opts);\n"
      "      const hdrLines = [`HTTP/1.1 ${res.status} ${res.statusText || 'OK'}`];\n"
      "      res.headers.forEach((v, k) => hdrLines.push(`${k}: ${v}`));\n"
      "      const headerStr = hdrLines.join('\\n') + '\\n\\n';\n"
      "      const headerBytes = Array.from(Buffer.from(headerStr, 'utf8'));\n"
      "      send({ type: 'http-headers', id: msg.id, status: res.status, headerBytes, headerLength: headerStr.length });\n"
      "      if (res.body && typeof res.body.getReader === 'function') {\n"
      "        const reader = res.body.getReader();\n"
      "        while (true) {\n"
      "          const { done, value } = await reader.read();\n"
      "          if (done) break;\n"
      "          if (value && value.length > 0) {\n"
      "            send({ type: 'http-chunk', id: msg.id, bytes: Array.from(value) });\n"
      "          }\n"
      "        }\n"
      "      } else {\n"
      "        const ab = await res.arrayBuffer();\n"
      "        const arr = Array.from(new Uint8Array(ab));\n"
      "        if (arr.length > 0) send({ type: 'http-chunk', id: msg.id, bytes: arr });\n"
      "      }\n"
      "      send({ type: 'http-end', id: msg.id, status: res.status });\n"
      "    } catch (err) {\n"
      "      send({ type: 'http-error', id: msg.id, message: String(err && err.message ? err.message : err) });\n"
      "    }\n"
      "  }\n"
      "});\n"))

  (defvar io-hub nil)

  (defun el-ensure-io-hub ()
    (when (nil? io-hub)
      (let ((wt (el-worker-threads)))
        (when (not (nullish? wt))
          (let* ((sab (new globalThis.SharedArrayBuffer 4))
                 (sig (new globalThis.Int32Array sab))
                 (ChannelCtor (get wt :MessageChannel))
                 (ch (new ChannelCtor))
                 (port1 (get ch :port1))
                 (port2 (get ch :port2))
                 (WorkerCtor (get wt :Worker))
                 (worker (new WorkerCtor io-worker-code
                              (js-object :eval t
                                         :workerData (js-object :signal sab :port port2)
                                         :transferList (js-array port2)))))
            (when (not (nullish? (get worker :unref)))
              (js-call worker :unref))
            (when (not (nullish? (get port1 :unref)))
              (js-call port1 :unref))
            (setq io-hub (js-object :worker worker :port port1 :signal sig :wt wt
                                    :procs (new globalThis.Map) :httpReqs (new globalThis.Map)
                                    :nextId 1))))))
    io-hub)

  (defun el-drain-io-events (session &optional wait-for-spawn-id)
    (let ((hub io-hub)
          (got-any false))
      (when (not (nil? hub))
        (let ((wt (get hub :wt))
              (port (get hub :port))
              (more t))
          (while more
            (let ((packet (js-call wt :receiveMessageOnPort port)))
              (if (or (nullish? packet) (nullish? (get packet :message)))
                  (setq more false)
                (let* ((msg (get packet :message))
                       (mtype (get msg :type))
                       (id (get msg :id)))
                  (setq got-any t)
                  (cond
                    ((= mtype "spawned")
                      (let ((proc (js-call (get hub :procs) :get id)))
                        (when (not (undefined? proc))
                          (put proc :pid (get msg :pid))
                          (put proc :spawned t))))
                    ((= mtype "spawn-error")
                      (let ((proc (js-call (get hub :procs) :get id)))
                        (when (not (undefined? proc))
                          (put proc :spawnError (get msg :message))
                          (put proc :spawned t)
                          (put proc :live false)
                          (put proc :status (el-intern "failed"))
                          (put proc :exitStatus 127)
                          (js-call (get hub :procs) :delete id))))
                    ((= mtype "stdout")
                      (let ((proc (js-call (get hub :procs) :get id)))
                        (when (not (undefined? proc))
                          (let ((chunk (el-decode-utf8 (el-bytes-string (get msg :bytes)))))
                            (el-deliver-process-output session proc chunk)))))
                    ((= mtype "stderr")
                      (let ((proc (js-call (get hub :procs) :get id)))
                        (when (not (undefined? proc))
                          (let ((chunk (el-decode-utf8 (el-bytes-string (get msg :bytes))))
                                (err-target (get proc :stderrTarget)))
                            (cond
                              ((= (el-kind err-target) "process")
                                (el-deliver-process-output session err-target chunk))
                              ((= (el-kind err-target) "buffer")
                                (el-append-to-buffer err-target chunk))
                              (t
                                (el-deliver-process-output session proc chunk)))))))
                    ((= mtype "exit")
                      (let ((proc (js-call (get hub :procs) :get id)))
                        (when (not (undefined? proc))
                          (js-call (get hub :procs) :delete id)
                          (put proc :live false)
                          (put proc :status (if (nullish? (get msg :signal)) (el-intern "exit") (el-intern "signal")))
                          (put proc :exitStatus (get msg :code))
                          (let ((err-target (get proc :stderrTarget)))
                            (when (= (el-kind err-target) "process")
                              (put err-target :live false)
                              (put err-target :status (el-intern "exit"))
                              (put err-target :exitStatus 0)
                              (when (not (nil? (get err-target :sentinel)))
                                (el-call session (get err-target :sentinel) (js-array err-target "finished\n")))))
                          (when (not (nil? (get proc :sentinel)))
                            (let ((event-str (if (= (get msg :code) 0)
                                                 "finished\n"
                                               (str "exited abnormally with code " (get msg :code) "\n"))))
                              (el-call session (get proc :sentinel) (js-array proc event-str)))))))
                    ((= mtype "http-headers")
                      (let ((req (js-call (get hub :httpReqs) :get id)))
                        (when (not (undefined? req))
                          (let ((buf (get req :buffer))
                                (hdr-str (el-bytes-string (get msg :headerBytes))))
                            (put req :status (get msg :status))
                            (el-append-to-buffer buf hdr-str)
                            (js-call (get buf :locals) :set (el-intern "url-http-end-of-headers") (get msg :headerLength))
                            (js-call (get buf :locals) :set (el-intern "url-http-response-status") (get msg :status))))))
                    ((= mtype "http-chunk")
                      (let ((req (js-call (get hub :httpReqs) :get id)))
                        (when (not (undefined? req))
                          (let ((buf (get req :buffer))
                                (proc (get req :proc))
                                (chunk (el-bytes-string (get msg :bytes))))
                            (el-append-to-buffer buf chunk)
                            (when (not (nil? (get proc :filter)))
                              (el-call session (get proc :filter) (js-array proc chunk)))))))
                    ((= mtype "http-end")
                      (let ((req (js-call (get hub :httpReqs) :get id)))
                        (when (not (undefined? req))
                          (js-call (get hub :httpReqs) :delete id)
                          (let ((buf (get req :buffer))
                                (proc (get req :proc))
                                (cb (get req :callback))
                                (cbargs (get req :cbargs))
                                (status (get msg :status))
                                (prev-buf (get session :currentBuffer)))
                            (put proc :live false)
                            (put proc :status (el-intern "exit"))
                            (put proc :exitStatus 0)
                            (when (not (nil? cb))
                              (put session :currentBuffer buf)
                              (put buf :point 1)
                              (try
                                (let ((status-plist (if (>= status 400)
                                                        (el-list (el-intern ":error") (el-list (el-intern "error") (el-intern "http") status))
                                                      nil)))
                                  (el-call session cb (js-call (js-array status-plist) :concat (el-seq-items cbargs))))
                                (finally
                                  (put session :currentBuffer prev-buf))))))))
                    ((= mtype "http-error")
                      (let ((req (js-call (get hub :httpReqs) :get id)))
                        (when (not (undefined? req))
                          (js-call (get hub :httpReqs) :delete id)
                          (let ((buf (get req :buffer))
                                (proc (get req :proc))
                                (cb (get req :callback))
                                (cbargs (get req :cbargs))
                                (prev-buf (get session :currentBuffer)))
                            (put proc :live false)
                            (put proc :status (el-intern "failed"))
                            (put proc :exitStatus 1)
                            (when (not (nil? cb))
                              (put session :currentBuffer buf)
                              (put buf :point 1)
                              (try
                                (let ((status-plist (el-list (el-intern ":error") (el-list (el-intern "error") (get msg :message)))))
                                  (el-call session cb (js-call (js-array status-plist) :concat (el-seq-items cbargs))))
                                (finally
                                  (put session :currentBuffer prev-buf)))))))))))))))
      got-any))

  (defun el-append-to-buffer (buffer chunk)
    (when (and (= (el-kind buffer) "buffer") (get buffer :live))
      (let* ((old-text (get buffer :text))
             (was-at-end (= (get buffer :point) (1+ (el-string-length old-text))))
             (new-text (str old-text chunk)))
        (when (not (el-multibyte? chunk))
          (el-mark-unibyte new-text))
        (put buffer :text new-text)
        (when was-at-end
          (put buffer :point (1+ (el-string-length new-text)))))))

  (defun el-deliver-process-output (session proc chunk)
    (let ((filter (get proc :filter))
          (buf (get proc :buffer)))
      (cond
        ((and (not (nil? filter)) (not (eq filter t)))
          (el-call session filter (js-array proc chunk)))
        ((= (el-kind buf) "buffer")
          (el-append-to-buffer buf chunk)))))

  (defun el-run-due-timers (session &optional horizon-sec)
    (let ((timers (get session :timers))
          (now (+ (/ (js-call globalThis.Date :now) 1000)
                  (if (or (nullish? horizon-sec) (nil? horizon-sec)) 0 (el-num horizon-sec))))
          (ran false))
      (when (and (not (nullish? timers)) (> (js-length timers) 0))
        (js-call (js-call timers :slice) :forEach
                 (lambda (timer)
                   (when (and (not (get timer :cancelled)) (<= (get timer :nextFire) now))
                     (setq ran t)
                     (let ((repeat (get timer :repeat)))
                       (if (and (el-number? repeat) (> (el-num repeat) 0))
                           (put timer :nextFire (+ now (el-num repeat)))
                         (put timer :cancelled t)))
                     (el-call session (get timer :fn) (get timer :fnArgs)))))
        (let ((live (js-call (get session :timers) :filter (lambda (tm) (not (get tm :cancelled))))))
          (put session :timers live)))
      ran))

  (defun el-next-timer-wait-ms (session max-ms)
    (let ((timers (get session :timers))
          (now (/ (js-call globalThis.Date :now) 1000))
          (best max-ms))
      (when (and (not (nullish? timers)) (> (js-length timers) 0))
        (js-call timers :forEach
                 (lambda (timer)
                   (unless (get timer :cancelled)
                     (let ((rem (Math/max 1 (Math/ceil (* (- (get timer :nextFire) now) 1000)))))
                       (when (< rem best) (setq best rem)))))))
      best))

  (defun el-check-timeout-deadline (session)
    (let ((deadline (get session :timeoutDeadline)))
      (when (and (not (nullish? deadline)) (>= (/ (js-call globalThis.Date :now) 1000) deadline))
        (throw (js-object :eliscriptTimeout t :deadline deadline)))))

  (defun el-accept-process-output (session &optional proc seconds millisec just-this-one)
    (el-check-timeout-deadline session)
    (let* ((sec (if (or (nullish? seconds) (nil? seconds)) 0.05 (el-num seconds)))
           (ms-extra (if (or (nullish? millisec) (nil? millisec)) 0 (el-num millisec)))
           (wait-ms (Math/max 0 (Math/round (+ (* sec 1000) ms-extra))))
           (d1 (el-drain-io-events session))
           (t1 (el-run-due-timers session (if (>= wait-ms 1) 0.001 0)))
           (got (or d1 t1)))
      (when (and (not got) (> wait-ms 0))
        (let ((hub (el-ensure-io-hub))
              (slice-ms (el-next-timer-wait-ms session (Math/min wait-ms 50))))
          (if (not (nil? hub))
              (let* ((sig (get hub :signal))
                     (cur (js-call globalThis.Atomics :load sig 0)))
                (js-call globalThis.Atomics :wait sig 0 cur slice-ms)
                (let ((d2 (el-drain-io-events session))
                      (t2 (el-run-due-timers session)))
                  (setq got (or d2 t2))))
            (let ((sab (new globalThis.SharedArrayBuffer 4)))
              (js-call globalThis.Atomics :wait (new globalThis.Int32Array sab) 0 0 slice-ms)
              (setq got (el-run-due-timers session))))))
      (el-check-timeout-deadline session)
      (el-bool got)))

  (defun el-sleep-for (session seconds &optional millisec)
    (el-check-timeout-deadline session)
    (let* ((sec (if (or (nullish? seconds) (nil? seconds)) 0 (el-num seconds)))
           (ms-extra (if (or (nullish? millisec) (nil? millisec)) 0 (el-num millisec)))
           (total-ms (Math/max 0 (Math/round (+ (* sec 1000) ms-extra))))
           (end-ms (+ (js-call globalThis.Date :now) total-ms)))
      (el-drain-io-events session)
      (el-run-due-timers session)
      (while (< (js-call globalThis.Date :now) end-ms)
        (el-check-timeout-deadline session)
        (let ((rem (Math/max 1 (Math/min 50 (- end-ms (js-call globalThis.Date :now)))))
              (hub (el-ensure-io-hub)))
          (if (not (nil? hub))
              (let* ((sig (get hub :signal))
                     (cur (js-call globalThis.Atomics :load sig 0)))
                (js-call globalThis.Atomics :wait sig 0 cur rem)
                (el-drain-io-events session)
                (el-run-due-timers session))
            (let ((sab (new globalThis.SharedArrayBuffer 4)))
              (js-call globalThis.Atomics :wait (new globalThis.Int32Array sab) 0 0 rem)))))
      nil))

  (defun el-process-env-object (session)
    (let* ((p globalThis.process)
           (base (if (or (nullish? p) (nullish? (get p :env))) (js-object) (Object/assign (js-object) (get p :env))))
           (pe (el-global-value session (el-intern "process-environment"))))
      (when (el-cons? pe)
        ;; Process list from back to front so earlier entries in process-environment win.
        (let ((items (js-call (el-list-to-array pe) :slice)))
          (js-call items :reverse)
          (js-call items :forEach
                   (lambda (entry)
                     (when (el-string? entry)
                       (let ((eq-idx (js-call entry :indexOf "=")))
                         (if (< eq-idx 0)
                             (Reflect/deleteProperty base entry)
                           (put base (js-call entry :slice 0 eq-idx) (js-call entry :slice (1+ eq-idx))))))))))
      base))

  (defun el-call-process (session program &optional infile destination display &rest args)
    (let ((cp (el-child-process))
          (fs (el-fs)))
      (when (nullish? cp) (el-signal "file-error" "Subprocesses not available"))
      (let* ((cwd (el-expand-file-name session (or (el-global-value session (el-intern "default-directory")) "/") nil))
             (env (el-process-env-object session))
             (input-bytes (if (and (el-string? infile) (not (nullish? fs)))
                              (js-call fs :readFileSync (el-expand-file-name session infile nil))
                            undefined))
             (res (js-call cp :spawnSync program (js-call args :map (lambda (a) (str a)))
                           (js-object :cwd cwd :env env :input input-bytes :maxBuffer 104857600))))
        (when (not (nullish? (get res :error)))
          (el-signal "file-error" (str "Searching for program: " (get (get res :error) :message) ", " program)))
        (let* ((stdout-buf (get res :stdout))
               (stderr-buf (get res :stderr))
               (stdout-str (if (nullish? stdout-buf) "" (js-call stdout-buf :toString "utf8")))
               (stderr-str (if (nullish? stderr-buf) "" (js-call stderr-buf :toString "utf8")))
               (target (if (el-cons? destination) (get destination :car) destination))
               (err-dest (if (and (el-cons? destination) (el-cons? (get destination :cdr)))
                             (el-car (get destination :cdr))
                           (if (el-cons? destination) (get destination :cdr) t)))
               (write-to (lambda (dest text)
                           (cond
                             ((eq dest t) (el-buffer-insert (el-current-buffer session) text))
                             ((el-string? dest) (el-buffer-insert (el-get-buffer-create session dest) text))
                             ((= (el-kind dest) "buffer") (el-buffer-insert dest text))))))
          (when (and (not (nullish? target)) (not (nil? target)) (not (= target 0)))
            (funcall write-to target stdout-str)
            (when (= stderr-str "") nil)
            (cond
              ((eq err-dest t) (funcall write-to target stderr-str))
              ((and (el-string? err-dest) (not (nullish? fs)))
                (js-call fs :writeFileSync (el-expand-file-name session err-dest nil) stderr-str))))
          (if (not (nullish? (get res :status)))
              (get res :status)
            (if (not (nullish? (get res :signal))) (str (get res :signal)) 0))))))

  (defun el-call-process-region (session start end program &optional delete destination display &rest args)
    (let ((cp (el-child-process))
          (fs (el-fs))
          (buf (el-current-buffer session)))
      (when (nullish? cp) (el-signal "file-error" "Subprocesses not available"))
      (let* ((input-str (if (el-string? start) start
                          (el-buffer-substring buf (if (nil? start) 1 start) (if (nil? end) (el-point-max buf) end))))
             (cwd (el-expand-file-name session (or (el-global-value session (el-intern "default-directory")) "/") nil))
             (env (el-process-env-object session))
             (res (js-call cp :spawnSync program (js-call args :map (lambda (a) (str a)))
                           (js-object :cwd cwd :env env :input input-str :maxBuffer 104857600))))
        (when (and (not (nullish? delete)) (not (nil? delete)) (not (el-string? start)))
          (el-buffer-delete buf (if (nil? start) 1 start) (if (nil? end) (el-point-max buf) end)))
        (when (not (nullish? (get res :error)))
          (el-signal "file-error" (str "Searching for program: " (get (get res :error) :message) ", " program)))
        (let* ((stdout-buf (get res :stdout))
               (stderr-buf (get res :stderr))
               (stdout-str (if (nullish? stdout-buf) "" (js-call stdout-buf :toString "utf8")))
               (stderr-str (if (nullish? stderr-buf) "" (js-call stderr-buf :toString "utf8")))
               (target (if (el-cons? destination) (get destination :car) destination))
               (err-dest (if (and (el-cons? destination) (el-cons? (get destination :cdr)))
                             (el-car (get destination :cdr))
                           (if (el-cons? destination) (get destination :cdr) t)))
               (write-to (lambda (dest text)
                           (cond
                             ((eq dest t) (el-buffer-insert (el-current-buffer session) text))
                             ((el-string? dest) (el-buffer-insert (el-get-buffer-create session dest) text))
                             ((= (el-kind dest) "buffer") (el-buffer-insert dest text))))))
          (when (and (not (nullish? target)) (not (nil? target)) (not (= target 0)))
            (funcall write-to target stdout-str)
            (cond
              ((eq err-dest t) (funcall write-to target stderr-str))
              ((and (el-string? err-dest) (not (nullish? fs)))
                (js-call fs :writeFileSync (el-expand-file-name session err-dest nil) stderr-str))))
          (if (not (nullish? (get res :status)))
              (get res :status)
            (if (not (nullish? (get res :signal))) (str (get res :signal)) 0))))))

  (defun el-make-pipe-process (session args)
    (let* ((plist (el-list-from args))
           (name (or (el-plist-get plist (el-intern ":name") el-eq-test) "pipe"))
           (buf-arg (el-plist-get plist (el-intern ":buffer") el-eq-test))
           (buf (if (el-string? buf-arg) (el-get-buffer-create session buf-arg) buf-arg))
           (filter (el-plist-get plist (el-intern ":filter") el-eq-test))
           (sentinel (el-plist-get plist (el-intern ":sentinel") el-eq-test))
           (noquery (el-plist-get plist (el-intern ":noquery") el-eq-test))
           (proc (js-object :kind "process" :id 0 :pid nil :name name :buffer buf
                            :filter filter :sentinel sentinel :noquery (el-bool (not (nil? noquery)))
                            :live t :status (el-intern "open") :exitStatus 0
                            :plist (new globalThis.Map))))
      (js-call (get session :processes) :push proc)
      proc))

  (defun el-make-process (session args)
    (let* ((plist (el-list-from args))
           (name (or (el-plist-get plist (el-intern ":name") el-eq-test) "process"))
           (buf-arg (el-plist-get plist (el-intern ":buffer") el-eq-test))
           (buf (if (el-string? buf-arg) (el-get-buffer-create session buf-arg) buf-arg))
           (cmd-list (el-seq-items (el-plist-get plist (el-intern ":command") el-eq-test)))
           (filter (el-plist-get plist (el-intern ":filter") el-eq-test))
           (sentinel (el-plist-get plist (el-intern ":sentinel") el-eq-test))
           (stderr-arg (el-plist-get plist (el-intern ":stderr") el-eq-test))
           (stderr-target (if (el-string? stderr-arg) (el-get-buffer-create session stderr-arg) stderr-arg))
           (noquery (el-plist-get plist (el-intern ":noquery") el-eq-test))
           (hub (el-ensure-io-hub)))
      (when (or (nil? hub) (= (js-length cmd-list) 0))
        (el-signal "file-error" "Cannot spawn process"))
      (let* ((id (get hub :nextId))
             (cwd (el-expand-file-name session (or (el-global-value session (el-intern "default-directory")) "/") nil))
             (env (el-process-env-object session))
             (proc (js-object :kind "process" :id id :pid nil :name name :buffer buf
                              :filter filter :sentinel sentinel :stderrTarget stderr-target
                              :noquery (el-bool (not (nil? noquery)))
                              :live t :status (el-intern "run") :exitStatus 0
                              :spawned false :spawnError nil
                              :plist (new globalThis.Map))))
        (put hub :nextId (1+ id))
        (js-call (get hub :procs) :set id proc)
        (js-call (get session :processes) :push proc)
        (js-call (get hub :worker) :postMessage
                 (js-object :type "spawn" :id id
                            :file (str (aref cmd-list 0))
                            :args (js-call (js-call cmd-list :slice 1) :map (lambda (a) (str a)))
                            :cwd cwd :env env :noquery (not (nil? noquery))))
        ;; Wait briefly for spawn confirmation so process-id is populated immediately.
        (let ((attempts 0))
          (while (and (not (get proc :spawned)) (< attempts 25))
            (el-drain-io-events session id)
            (unless (get proc :spawned)
              (let* ((sig (get hub :signal))
                     (cur (js-call globalThis.Atomics :load sig 0)))
                (js-call globalThis.Atomics :wait sig 0 cur 2)))
            (setq attempts (1+ attempts))))
        (when (not (nil? (get proc :spawnError)))
          (el-signal "file-error" (str "Spawning child process: " (get proc :spawnError))))
        proc)))

  (defun el-url-retrieve (session url callback &optional cbargs silent inhibit-cookies)
    (let* ((hub (el-ensure-io-hub))
           (id (get hub :nextId))
           (buf (el-generate-new-buffer session " *http*"))
           (method (or (el-global-value session (el-intern "url-request-method")) "GET"))
           (extra-headers (el-global-value session (el-intern "url-request-extra-headers")))
           (req-data (el-global-value session (el-intern "url-request-data")))
           (headers (js-object))
           (body-bytes (if (el-string? req-data) (el-string-bytes-array req-data) (js-array)))
           (proc (js-object :kind "process" :id id :pid id :name "url-retrieve" :buffer buf
                            :filter nil :sentinel nil :live t :status (el-intern "run") :exitStatus 0
                            :plist (new globalThis.Map))))
      (put hub :nextId (1+ id))
      (put buf :multibyte false)
      (js-call (el-list-to-array extra-headers) :forEach
               (lambda (cell)
                 (when (el-cons? cell)
                   (put headers (el-symbol-name-or-string (get cell :car)) (el-symbol-name-or-string (get cell :cdr))))))
      (js-call (get hub :httpReqs) :set id
               (js-object :id id :buffer buf :proc proc :callback callback :cbargs (or cbargs nil)))
      (js-call (get session :processes) :push proc)
      (js-call (get hub :worker) :postMessage
               (js-object :type "http" :id id :url (str url) :method (str method)
                          :headers headers :bodyBytes body-bytes))
      buf))

  (defun el-url-retrieve-synchronously (session url &optional silent inhibit-cookies timeout)
    (let* ((done false)
           (buf (el-url-retrieve session url (lambda (&rest ignored) (setq done t)) nil silent inhibit-cookies))
           (deadline (if (el-number? timeout) (+ (/ (js-call globalThis.Date :now) 1000) (el-num timeout)) nil)))
      (while (and (not done) (or (nil? deadline) (< (/ (js-call globalThis.Date :now) 1000) deadline)))
        (el-accept-process-output session nil 0.05))
      buf))

  ;; Time helpers
  (defun el-time-to-ms (time)
    (cond
      ((or (nullish? time) (nil? time)) (js-call globalThis.Date :now))
      ((el-number? time) (* (el-num time) 1000))
      ((el-cons? time)
        (let ((items (el-list-to-array time)))
          (if (and (= (js-length items) 1) (not (nil? (get time :cdr))) (el-number? (get time :cdr)))
              ;; (TICKS . HZ)
              (* (/ (el-num (get time :car)) (el-num (get time :cdr))) 1000)
            (let ((high (el-num (or (aref items 0) 0)))
                  (low (el-num (or (aref items 1) 0)))
                  (usec (el-num (or (aref items 2) 0))))
              (+ (* (+ (* high 65536) low) 1000) (/ usec 1000))))))
      (t (js-call globalThis.Date :now))))

  (defun el-ms-to-time (ms)
    (let* ((sec (Math/floor (/ ms 1000)))
           (usec (* (- ms (* sec 1000)) 1000)))
      (el-list (Math/floor (/ sec 65536)) (el-mod-int sec 65536) (Math/round usec) 0)))

  (defun el-utc-zone? (zone)
    (or (eq zone t) (= zone 0) (= zone "UTC") (= zone "UTC0") (= zone "Z")
        (and (el-cons? zone) (= (el-car zone) 0))))

  (defun el-format-time-string (fmt &optional time zone)
    (let* ((ms (el-time-to-ms time))
           (d (new globalThis.Date ms))
           (utc (el-utc-zone? zone))
           (pad2 (lambda (n) (js-call (str n) :padStart 2 "0")))
           (year (if utc (js-call d :getUTCFullYear) (js-call d :getFullYear)))
           (mon (1+ (if utc (js-call d :getUTCMonth) (js-call d :getMonth))))
           (day (if utc (js-call d :getUTCDate) (js-call d :getDate)))
           (hr (if utc (js-call d :getUTCHours) (js-call d :getHours)))
           (mn (if utc (js-call d :getUTCMinutes) (js-call d :getMinutes)))
           (sc (if utc (js-call d :getUTCSeconds) (js-call d :getSeconds)))
           (dow (if utc (js-call d :getUTCDay) (js-call d :getDay)))
           (days (js-array "Sun" "Mon" "Tue" "Wed" "Thu" "Fri" "Sat"))
           (months (js-array "Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec")))
      (js-call fmt :replace (new globalThis.RegExp "%[YmdHMSzZsFTRabN%]" "g")
               (lambda (spec)
                 (cond
                   ((= spec "%%") "%")
                   ((= spec "%Y") (str year))
                   ((= spec "%m") (funcall pad2 mon))
                   ((= spec "%d") (funcall pad2 day))
                   ((= spec "%H") (funcall pad2 hr))
                   ((= spec "%M") (funcall pad2 mn))
                   ((= spec "%S") (funcall pad2 sc))
                   ((= spec "%F") (str year "-" (funcall pad2 mon) "-" (funcall pad2 day)))
                   ((= spec "%T") (str (funcall pad2 hr) ":" (funcall pad2 mn) ":" (funcall pad2 sc)))
                   ((= spec "%R") (str (funcall pad2 hr) ":" (funcall pad2 mn)))
                   ((= spec "%s") (str (Math/floor (/ ms 1000))))
                   ((= spec "%N") (str (js-call (str (el-mod-int (Math/floor ms) 1000)) :padStart 3 "0") "000000"))
                   ((= spec "%a") (aref days dow))
                   ((= spec "%b") (aref months (1- mon)))
                   ((= spec "%Z") (if utc "UTC" "LOCAL"))
                   ((= spec "%z")
                     (if utc "+0000"
                       (let* ((off (- 0 (js-call d :getTimezoneOffset)))
                              (sign (if (>= off 0) "+" "-"))
                              (abs-off (Math/abs off)))
                         (str sign (funcall pad2 (Math/floor (/ abs-off 60))) (funcall pad2 (% abs-off 60))))))
                   (t spec))))))

  (defun el-parse-time-string (s)
    (let ((m (js-call (new globalThis.RegExp "^\\s*(\\d{4})-(\\d{2})-(\\d{2})(?:[T\\s](\\d{2}):(\\d{2}):(\\d{2})(?:\\.\\d+)?(Z|[+-]\\d{2}:?\\d{2})?)?\\s*$")
                      :exec (str s))))
      (if (not (nil? m))
          (let* ((year (Number/parseInt (aref m 1) 10))
                 (mon (Number/parseInt (aref m 2) 10))
                 (day (Number/parseInt (aref m 3) 10))
                 (hr (if (undefined? (aref m 4)) 0 (Number/parseInt (aref m 4) 10)))
                 (mn (if (undefined? (aref m 5)) 0 (Number/parseInt (aref m 5) 10)))
                 (sc (if (undefined? (aref m 6)) 0 (Number/parseInt (aref m 6) 10)))
                 (tz-raw (aref m 7))
                 (tz (cond
                       ((undefined? tz-raw) nil)
                       ((= tz-raw "Z") 0)
                       (t (let* ((clean (js-call tz-raw :replace ":" ""))
                                 (sign (if (= (js-call clean :charAt 0) "-") -1 1))
                                 (zh (Number/parseInt (js-call clean :slice 1 3) 10))
                                 (zm (Number/parseInt (js-call clean :slice 3 5) 10)))
                            (* sign (+ (* zh 3600) (* zm 60)))))))
                 (dow (js-call (new globalThis.Date (Date/UTC year (1- mon) day)) :getUTCDay)))
            (el-list sc mn hr day mon year dow nil tz))
        (let ((parsed (Date/parse s)))
          (if (Number/isNaN parsed)
              (el-list nil nil nil nil nil nil nil -1 nil)
            (let ((d (new globalThis.Date parsed)))
              (el-list (js-call d :getUTCSeconds) (js-call d :getUTCMinutes) (js-call d :getUTCHours)
                       (js-call d :getUTCDate) (1+ (js-call d :getUTCMonth)) (js-call d :getUTCFullYear)
                       (js-call d :getUTCDay) nil 0)))))))

  (defun el-encode-time (args)
    (let* ((items (if (and (= (js-length args) 1) (el-cons? (aref args 0)))
                      (el-list-to-array (aref args 0))
                    args))
           (sc (el-num (or (aref items 0) 0)))
           (mn (el-num (or (aref items 1) 0)))
           (hr (el-num (or (aref items 2) 0)))
           (day (el-num (or (aref items 3) 1)))
           (mon (el-num (or (aref items 4) 1)))
           (year (el-num (or (aref items 5) 1970)))
           (zone (if (>= (js-length items) 9) (aref items 8) (if (>= (js-length items) 7) (aref items 6) nil)))
           (ms (cond
                 ((el-utc-zone? zone) (Date/UTC year (1- mon) day hr mn sc))
                 ((el-integer? zone) (- (Date/UTC year (1- mon) day hr mn sc) (* zone 1000)))
                 (t (js-call (new globalThis.Date year (1- mon) day hr mn sc) :getTime)))))
      (el-ms-to-time ms)))

  (defun el-decode-time (&optional time zone form)
    (let* ((ms (el-time-to-ms time))
           (d (new globalThis.Date ms))
           (utc (el-utc-zone? zone)))
      (if utc
          (el-list (js-call d :getUTCSeconds) (js-call d :getUTCMinutes) (js-call d :getUTCHours)
                   (js-call d :getUTCDate) (1+ (js-call d :getUTCMonth)) (js-call d :getUTCFullYear)
                   (js-call d :getUTCDay) nil 0)
        (el-list (js-call d :getSeconds) (js-call d :getMinutes) (js-call d :getHours)
                 (js-call d :getDate) (1+ (js-call d :getMonth)) (js-call d :getFullYear)
                 (js-call d :getDay) nil (* (- 0 (js-call d :getTimezoneOffset)) 60)))))

  ;; File system & library resolution helpers
  (defun el-file-truename (session filename)
    (unless (el-string? filename) (el-signal "wrong-type-argument" (el-intern "stringp") filename))
    (let* ((expanded (el-expand-file-name session filename nil))
           (trailing (and (> (js-length expanded) 1) (js-call expanded :endsWith "/")))
           (fs (el-fs))
           (path-mod (el-path)))
      (if (nullish? fs)
          expanded
        (try
          (let ((real (js-call fs :realpathSync expanded)))
            (if (and trailing (not (js-call real :endsWith "/"))) (str real "/") real))
          (catch e
            (if (nullish? path-mod)
                expanded
              (let* ((clean (js-call expanded :replace (new globalThis.RegExp "/+$") ""))
                     (dir (js-call path-mod :dirname clean))
                     (base (js-call path-mod :basename clean)))
                (if (or (= dir clean) (= base ""))
                    expanded
                  (let ((real-dir (js-call (el-file-truename session dir) :replace (new globalThis.RegExp "/+$") "")))
                    (str real-dir "/" base (if trailing "/" "")))))))))))

  (defun el-locate-library (session library &optional nosuffix path)
    (let ((fs (el-fs)))
      (if (nullish? fs)
          nil
        (let* ((lib-name (el-symbol-name-or-string library))
               (suffixes (if (and (not (nullish? nosuffix)) (not (nil? nosuffix)))
                             (js-array "")
                           (if (or (js-call lib-name :endsWith ".el") (js-call lib-name :endsWith ".eli"))
                               (js-array "")
                             (js-array ".el" ".eli" ""))))
               (dirs (if (or (js-call lib-name :startsWith "/") (js-call lib-name :startsWith "./") (js-call lib-name :startsWith "../") (js-call lib-name :startsWith "~"))
                         (js-array (or (el-global-value session (el-intern "default-directory")) "/"))
                       (el-seq-items (if (or (nullish? path) (nil? path))
                                         (el-global-value session (el-intern "load-path"))
                                       path))))
               (found nil)
               (d-idx 0))
          (while (and (nil? found) (< d-idx (js-length dirs)))
            (let ((dir (aref dirs d-idx)) (s-idx 0))
              (when (el-string? dir)
                (while (and (nil? found) (< s-idx (js-length suffixes)))
                  (let ((candidate (el-expand-file-name session (str lib-name (aref suffixes s-idx)) dir)))
                    (when (try (js-call (js-call fs :statSync candidate) :isFile) (catch e false))
                      (setq found candidate)))
                  (setq s-idx (1+ s-idx)))))
            (setq d-idx (1+ d-idx)))
          found))))

  (defun el-load-file (session file &optional noerror nomessage nosuffix must-suffix)
    (let* ((fs (el-fs))
           (resolved (or (el-locate-library session file nosuffix nil)
                         (let ((direct (el-expand-file-name session (el-symbol-name-or-string file) nil)))
                           (if (and (not (nullish? fs))
                                    (try (js-call (js-call fs :statSync direct) :isFile) (catch e false)))
                               direct
                             nil)))))
      (if (or (nullish? fs) (nil? resolved))
          (if (js-call (get session :features) :has (el-symbol-name-or-string file))
              t
            (if (and (not (nullish? noerror)) (not (nil? noerror)))
                nil
              (el-signal "file-missing" "Cannot open load file" "No such file or directory" file)))
        (let ((source (js-call fs :readFileSync resolved "utf8")))
          (evalCompatProgram source (js-object :session session :filename resolved))
          t))))

  ;; ERT special forms and runner
  (defun sf-ert-deftest (session form env)
    (let* ((name (el-second form))
           (rest (el-list-to-array (el-rest-after form 2)))
           (idx 0)
           (tags nil)
           (expected (el-intern ":passed")))
      (when (and (< idx (js-length rest)) (el-string? (aref rest idx)))
        (setq idx (1+ idx)))
      (while (and (< (1+ idx) (js-length rest)) (el-keyword? (aref rest idx)))
        (let ((kw-name (el-symbol-name (aref rest idx)))
              (val (el-eval session (aref rest (1+ idx)) env)))
          (cond
            ((= kw-name ":tags") (setq tags val))
            ((= kw-name ":expected-result") (setq expected val))))
        (setq idx (+ idx 2)))
      (let* ((body (js-call rest :slice idx))
             (test-obj (js-object :kind "ert-test" :name name :tags tags :expectedResult expected
                                  :mostRecentResult nil
                                  :bodyFn (lambda () (el-eval-body session body env)))))
        (js-call (get session :ertTests) :set name test-obj)
        (js-call (get session :ertTestOrder) :push name)
        name)))

  (defun sf-should (session form env)
    (let* ((expr (el-second form))
           (val (el-eval session expr env)))
      (when (nil? val)
        (throw (el-make-signal "ert-test-failed" (js-array (el-list (el-intern "should") expr)))))
      val))

  (defun sf-should-not (session form env)
    (let* ((expr (el-second form))
           (val (el-eval session expr env)))
      (unless (nil? val)
        (throw (el-make-signal "ert-test-failed" (js-array (el-list (el-intern "should-not") expr) (el-intern ":value") val))))
      nil))

  (defun sf-should-error (session form env)
    (let* ((expr (el-second form))
           (keys (el-list-to-array (el-rest-after form 1)))
           (ti (js-call keys :findIndex (lambda (k) (el-sym-is k ":type"))))
           (expected-type (if (< ti 0) "error" (el-symbol-name (el-eval session (aref keys (1+ ti)) env))))
           (caught nil))
      (try
        (el-eval session expr env)
        (catch raw
          (when (el-control-transfer? raw) (throw raw))
          (setq caught (el-error-from-host raw))))
      (when (nil? caught)
        (throw (el-make-signal "ert-test-failed" (js-array (el-list (el-intern "should-error") expr)))))
      (unless (el-condition-matches session (get caught :conditionSymbol) expected-type)
        (throw (el-make-signal "ert-test-failed"
                               (js-array (el-list (el-intern "should-error") expr)
                                         (el-intern ":condition") (el-cons (el-intern (get caught :conditionSymbol))
                                                                           (el-list-from (get caught :data)))))))
      (el-cons (el-intern (get caught :conditionSymbol)) (el-list-from (get caught :data)))))

  (defun el-ert-select-tests (session selector)
    (let ((order (get session :ertTestOrder))
          (tests (get session :ertTests))
          (seen (new globalThis.Set))
          (out (js-array)))
      (letfn ((matches? (test sel)
                (cond
                  ((or (nullish? sel) (eq sel t) (el-sym-is sel ":new")) t)
                  ((nil? sel) false)
                  ((el-string? sel) (not (nil? (el-string-match session sel (el-symbol-name (get test :name)) 0 false))))
                  ((el-symobj? sel) (eq (get test :name) sel))
                  ((= (el-kind sel) "ert-test") (eq test sel))
                  ((el-cons? sel)
                    (let ((op (el-symbol-name (get sel :car)))
                          (args (el-list-to-array (get sel :cdr))))
                      (cond
                        ((= op "not") (not (matches? test (aref args 0))))
                        ((= op "and") (js-call args :every (lambda (s) (matches? test s))))
                        ((= op "or") (js-call args :some (lambda (s) (matches? test s))))
                        ((= op "tag") (not (nil? (el-member-with (aref args 0) (get test :tags) el-eq-test))))
                        ((= op "member") (js-call args :some (lambda (s) (matches? test s))))
                        (t t))))
                  (t t))))
        (js-call order :forEach
                 (lambda (sym)
                   (when (and (not (js-call seen :has sym)) (js-call tests :has sym))
                     (js-call seen :add sym)
                     (let ((test (js-call tests :get sym)))
                       (when (matches? test selector)
                         (js-call out :push test)))))))
      out))

  (defun el-ert-run-single-test (session test)
    (let ((result nil))
      (try
        (progn
          (funcall (get test :bodyFn))
          (setq result (js-object :kind "ert-test-result" :status "passed" :condition nil)))
        (catch raw
          (when (and (not (nullish? raw))
                     (or (get raw :eliscriptBatchExit)
                         (get raw :eliscriptTimeout)))
            (throw raw))
          (let ((sig (el-error-from-host raw)))
            (if (= (get sig :conditionSymbol) "ert-test-skipped")
                (setq result (js-object :kind "ert-test-result" :status "skipped"
                                        :condition (el-cons (el-intern (get sig :conditionSymbol)) (el-list-from (get sig :data)))))
              (setq result (js-object :kind "ert-test-result" :status "failed"
                                      :condition (el-cons (el-intern (get sig :conditionSymbol)) (el-list-from (get sig :data)))))))))
      (put test :mostRecentResult result)
      result))

  (defun el-ert-run-tests-batch (session &optional selector)
    (let* ((selected (el-ert-select-tests session selector))
           (total (js-length selected))
           (passed 0)
           (failed 0)
           (skipped 0))
      (js-call selected :forEach
               (lambda (test idx)
                 (let ((res (el-ert-run-single-test session test))
                       (name (el-symbol-name (get test :name))))
                   (cond
                     ((= (get res :status) "passed")
                       (setq passed (1+ passed))
                       (el-emit-output session (str "   passed  " (1+ idx) "/" total "  " name "\n") t))
                     ((= (get res :status) "skipped")
                       (setq skipped (1+ skipped))
                       (el-emit-output session (str "  skipped  " (1+ idx) "/" total "  " name "\n") t))
                     (t
                       (setq failed (1+ failed))
                       (el-emit-output session
                                       (str "   FAILED  " (1+ idx) "/" total "  " name " ("
                                            (el-prin1-string (get res :condition) t) ")\n")
                                       t))))))
      (el-emit-output session (str "Ran " total " tests, " passed " results as expected, " failed " unexpected, " skipped " skipped\n") t)
      (js-object :kind "ert-stats" :total total :passed passed :failed failed :skipped skipped)))

  (defun el-install-kernel (session)
    (let* ((d (lambda (name fn) (el-def session name fn)))
           (d1 (lambda (name fn)
                 (el-def session name fn)
                 (put (el-intern name) :_inlineEval
                      (lambda (s cdr e)
                        (if (and (not (nil? cdr)) (nil? (get cdr :cdr)))
                            (el-normalize-result (funcall fn (el-eval s (get cdr :car) e)))
                          (el-eval-call-fn s fn cdr e))))))
           (d2 (lambda (name fn)
                 (el-def session name fn)
                 (put (el-intern name) :_inlineEval
                      (lambda (s cdr e)
                        (if (and (not (nil? cdr)) (not (nil? (get cdr :cdr))) (nil? (get (get cdr :cdr) :cdr)))
                            (let ((a0 (el-eval s (get cdr :car) e))
                                  (a1 (el-eval s (get (get cdr :cdr) :car) e)))
                              (el-normalize-result (funcall fn a0 a1)))
                          (el-eval-call-fn s fn cdr e)))))))
      ;; Arithmetic
      (funcall d "+" (lambda (&rest xs) (el-arith "+" xs)))
      (funcall d "-" (lambda (&rest xs) (el-arith "-" xs)))
      (funcall d "*" (lambda (&rest xs) (el-arith "*" xs)))
      (funcall d "/" (lambda (&rest xs) (el-divide xs)))
      (funcall d "%" (lambda (a b) (el-rem a b)))
      (funcall d "mod" (lambda (a b) (el-mod a b)))
      (funcall d1 "1+" (lambda (x) (if (= (js* "typeof x") "number") (+ x 1) (el-make-float (+ (el-num x) 1)))))
      (funcall d1 "1-" (lambda (x) (if (= (js* "typeof x") "number") (- x 1) (el-make-float (- (el-num x) 1)))))
      (funcall d "=" (lambda (&rest xs) (el-compare-chain "=" xs)))
      (funcall d "<" (lambda (&rest xs) (el-compare-chain "<" xs)))
      (funcall d ">" (lambda (&rest xs) (el-compare-chain ">" xs)))
      (funcall d "<=" (lambda (&rest xs) (el-compare-chain "<=" xs)))
      (funcall d ">=" (lambda (&rest xs) (el-compare-chain ">=" xs)))
      (funcall d "/=" (lambda (a b) (el-bool (/= (el-num a) (el-num b)))))
      (funcall d "max" (lambda (a &optional b &rest xs)
                         (if (nullish? b) a
                           (if (= (js-length xs) 0)
                               (if (and (= (js* "typeof a") "number") (= (js* "typeof b") "number")
                                        (Number/isInteger a) (Number/isInteger b))
                                   (if (> b a) b a)
                                 (let ((best (if (> (el-num b) (el-num a)) b a)))
                                   (if (or (el-float? a) (el-float? b)) (el-make-float (el-num best)) best)))
                             (let ((best (if (> (el-num b) (el-num a)) b a))
                                   (fl (or (el-float? a) (el-float? b) (js-call xs :some (lambda (x) (el-float? x))))))
                               (js-call xs :forEach (lambda (x) (when (> (el-num x) (el-num best)) (setq best x))))
                               (if fl (el-make-float (el-num best)) best))))))
      (funcall d "min" (lambda (a &optional b &rest xs)
                         (if (nullish? b) a
                           (if (= (js-length xs) 0)
                               (if (and (= (js* "typeof a") "number") (= (js* "typeof b") "number")
                                        (Number/isInteger a) (Number/isInteger b))
                                   (if (< b a) b a)
                                 (let ((best (if (< (el-num b) (el-num a)) b a)))
                                   (if (or (el-float? a) (el-float? b)) (el-make-float (el-num best)) best)))
                             (let ((best (if (< (el-num b) (el-num a)) b a))
                                   (fl (or (el-float? a) (el-float? b) (js-call xs :some (lambda (x) (el-float? x))))))
                               (js-call xs :forEach (lambda (x) (when (< (el-num x) (el-num best)) (setq best x))))
                               (if fl (el-make-float (el-num best)) best))))))
      (funcall d "abs" (lambda (x) (if (el-float? x) (el-make-float (Math/abs (el-num x))) (Math/abs x))))
      (funcall d "float" (lambda (x) (el-make-float (el-num x))))
      (funcall d "floor" (lambda (x &optional y) (el-rounding "floor" x (el-opt y))))
      (funcall d "ceiling" (lambda (x &optional y) (el-rounding "ceiling" x (el-opt y))))
      (funcall d "truncate" (lambda (x &optional y) (el-rounding "truncate" x (el-opt y))))
      (funcall d "round" (lambda (x &optional y) (el-rounding "round" x (el-opt y))))
      (funcall d "ffloor" (lambda (x) (el-make-float (Math/floor (el-num x)))))
      (funcall d "fceiling" (lambda (x) (el-make-float (Math/ceil (el-num x)))))
      (funcall d "fround" (lambda (x) (el-make-float (el-round-half-even (el-num x)))))
      (funcall d "ftruncate" (lambda (x) (el-make-float (Math/trunc (el-num x)))))
      (funcall d "sqrt" (lambda (x) (el-make-float (Math/sqrt (el-num x)))))
      (funcall d "exp" (lambda (x) (el-make-float (Math/exp (el-num x)))))
      (funcall d "log" (lambda (x &optional base)
                         (el-make-float (if (nullish? base) (Math/log (el-num x)) (/ (Math/log (el-num x)) (Math/log (el-num base)))))))
      (funcall d "expt" (lambda (a b)
                          (if (and (el-integer? a) (el-integer? b) (>= b 0)) (Math/pow a b)
                            (el-make-float (Math/pow (el-num a) (el-num b))))))
      (funcall d "isnan" (lambda (x) (el-bool (Number/isNaN (el-num x)))))
      (funcall d "random" (lambda (&optional limit)
                            (if (and (not (nullish? limit)) (el-integer? limit)) (Math/floor (* (Math/random) limit))
                              (Math/floor (* (Math/random) 2147483647)))))
      (funcall d "ash" (lambda (v c) (el-ash v c)))
      (funcall d "lsh" (lambda (v c) (el-ash v c)))
      (funcall d "logand" (lambda (&rest xs) (js-call xs :reduce (lambda (a b) (el-bitwise "and" a b)) -1)))
      (funcall d "logior" (lambda (&rest xs) (js-call xs :reduce (lambda (a b) (el-bitwise "or" a b)) 0)))
      (funcall d "logxor" (lambda (&rest xs) (js-call xs :reduce (lambda (a b) (el-bitwise "xor" a b)) 0)))
      (funcall d "lognot" (lambda (x) (- -1 x)))
      (funcall d "logcount" (lambda (x) (let ((n (Math/abs x)) (c 0)) (while (> n 0) (setq c (+ c (% n 2))) (setq n (Math/floor (/ n 2)))) c)))
      ;; Predicates
      (funcall d1 "null" (lambda (x) (el-bool (nil? x))))
      (funcall d1 "not" (lambda (x) (el-bool (nil? x))))
      (funcall d1 "atom" (lambda (x) (el-bool (not (el-cons? x)))))
      (funcall d1 "consp" (lambda (x) (el-bool (el-cons? x))))
      (funcall d1 "listp" (lambda (x) (el-bool (or (nil? x) (el-cons? x)))))
      (funcall d1 "nlistp" (lambda (x) (el-bool (not (or (nil? x) (el-cons? x))))))
      (funcall d "proper-list-p" (lambda (x) (el-proper-list-length x)))
      (funcall d "plistp" (lambda (x) (let ((len (el-proper-list-length x))) (el-bool (and (el-integer? len) (= (el-mod-int len 2) 0))))))
      (funcall d1 "symbolp" (lambda (x) (el-bool (el-symbol? x))))
      (funcall d1 "keywordp" (lambda (x) (el-bool (el-keyword? x))))
      (funcall d1 "stringp" (lambda (x) (el-bool (el-string? x))))
      (funcall d1 "numberp" (lambda (x) (el-bool (el-number? x))))
      (funcall d1 "number-or-marker-p" (lambda (x) (el-bool (el-number? x))))
      (funcall d1 "integerp" (lambda (x) (el-bool (el-integer? x))))
      (funcall d1 "fixnump" (lambda (x) (el-bool (el-integer? x))))
      (funcall d1 "bignump" (lambda (x) nil))
      (funcall d1 "natnump" (lambda (x) (el-bool (and (el-integer? x) (>= x 0)))))
      (funcall d1 "floatp" (lambda (x) (el-bool (el-float? x))))
      (funcall d1 "zerop" (lambda (x) (el-bool (= (el-num x) 0))))
      (funcall d1 "cl-plusp" (lambda (x) (el-bool (> (el-num x) 0))))
      (funcall d1 "cl-minusp" (lambda (x) (el-bool (< (el-num x) 0))))
      (funcall d1 "cl-evenp" (lambda (x) (el-bool (= (el-mod-int (el-num x) 2) 0))))
      (funcall d1 "cl-oddp" (lambda (x) (el-bool (= (el-mod-int (el-num x) 2) 1))))
      (funcall d1 "characterp" (lambda (x) (el-bool (and (el-integer? x) (>= x 0) (<= x 4194303)))))
      (funcall d1 "vectorp" (lambda (x) (el-bool (el-vector? x))))
      (funcall d1 "arrayp" (lambda (x) (el-bool (or (el-vector? x) (el-string? x)))))
      (funcall d1 "sequencep" (lambda (x) (el-bool (or (nil? x) (el-cons? x) (el-vector? x) (el-string? x)))))
      (funcall d1 "recordp" (lambda (x) (el-bool (el-record? x))))
      (funcall d "functionp" (lambda (x)
                               (el-bool (or (el-function? x)
                                            (and (el-symobj? x) (not (el-keyword? x)) (not (nil? (el-symbol-function session x)))
                                                 (not (js-call (get session :macros) :has x)))
                                            (and (el-cons? x) (eq (get x :car) s-lambda))))))
      (funcall d1 "subrp" (lambda (x) (el-bool (el-function? x))))
      (funcall d1 "hash-table-p" (lambda (x) (el-bool (el-hash-table? x))))
      (funcall d1 "bufferp" (lambda (x) (el-bool (= (el-kind x) "buffer"))))
      (funcall d1 "booleanp" (lambda (x) (el-bool (or (nil? x) (eq x t)))))
      (funcall d1 "char-or-string-p" (lambda (x) (el-bool (or (el-string? x) (el-integer? x)))))
      (funcall d1 "type-of" (lambda (x) (el-intern (el-type-of x))))
      (funcall d2 "cl-typep" (lambda (x type) (el-cl-typep session x type)))
      (funcall d2 "eq" (lambda (a b) (el-eq a b)))
      (funcall d2 "eql" (lambda (a b) (el-eql a b)))
      (funcall d2 "equal" (lambda (a b) (el-equal a b)))
      (funcall d1 "identity" (lambda (x) x))
      (funcall d "ignore" (lambda (&rest xs) nil))
      (funcall d "always" (lambda (&rest xs) t))
      ;; Conses and lists
      (funcall d2 "cons" (lambda (a b) (el-cons a b)))
      (funcall d1 "car" (lambda (x) (el-car x)))
      (funcall d1 "cdr" (lambda (x) (el-cdr x)))
      (funcall d1 "car-safe" (lambda (x) (el-car-safe x)))
      (funcall d1 "cdr-safe" (lambda (x) (el-cdr-safe x)))
      (funcall d1 "caar" (lambda (x) (el-car (el-car x))))
      (funcall d1 "cadr" (lambda (x) (el-car (el-cdr x))))
      (funcall d1 "cdar" (lambda (x) (el-cdr (el-car x))))
      (funcall d1 "cddr" (lambda (x) (el-cdr (el-cdr x))))
      (funcall d1 "caddr" (lambda (x) (el-car (el-cdr (el-cdr x)))))
      (funcall d1 "cdddr" (lambda (x) (el-cdr (el-cdr (el-cdr x)))))
      (funcall d1 "caadr" (lambda (x) (el-car (el-car (el-cdr x)))))
      (funcall d1 "cddar" (lambda (x) (el-cdr (el-cdr (el-car x)))))
      (funcall d1 "cdadr" (lambda (x) (el-cdr (el-car (el-cdr x)))))
      (funcall d1 "cadar" (lambda (x) (el-car (el-cdr (el-car x)))))
      (funcall d1 "cl-first" (lambda (x) (el-car x)))
      (funcall d1 "cl-second" (lambda (x) (el-nth 1 x)))
      (funcall d1 "cl-third" (lambda (x) (el-nth 2 x)))
      (funcall d1 "cl-rest" (lambda (x) (el-cdr x)))
      (funcall d2 "setcar" (lambda (cell v) (unless (el-cons? cell) (el-signal "wrong-type-argument" (el-intern "consp") cell)) (put cell :car v) v))
      (funcall d2 "setcdr" (lambda (cell v) (unless (el-cons? cell) (el-signal "wrong-type-argument" (el-intern "consp") cell)) (put cell :cdr v) v))
      (funcall d "list" (lambda (&rest xs) (el-list-from xs)))
      (funcall d "list*" (lambda (&rest xs) (el-list-from (js-call xs :slice 0 -1) (aref xs (1- (js-length xs))))))
      (funcall d "cl-list*" (lambda (&rest xs) (el-list-from (js-call xs :slice 0 -1) (aref xs (1- (js-length xs))))))
