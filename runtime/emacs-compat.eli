      (funcall d "file-attribute-modification-time" (lambda (a) (el-nth 5 a)))
      (funcall d "file-attribute-status-change-time" (lambda (a) (el-nth 6 a)))
      (funcall d "file-attribute-size" (lambda (a) (el-nth 7 a)))
      (funcall d "file-attribute-modes" (lambda (a) (el-nth 8 a)))
      (funcall d "file-attribute-inode-number" (lambda (a) (el-nth 10 a)))
      (funcall d "file-attribute-device-number" (lambda (a) (el-nth 11 a)))
      (funcall d "file-modes"
               (lambda (f &optional flag)
