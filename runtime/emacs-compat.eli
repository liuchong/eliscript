(module capsules.runtime.emacs-compat
  (js* "import { spawnSync } from \"node:child_process\";\nimport { readFileSync } from \"node:fs\";\nimport path from \"node:path\";\n\n// ============================================================================\n// 1. Core Value Representations & Condition Hierarchy\n// ============================================================================\n\nexport class EliscriptSignal extends Error {\n  constructor(conditionSymbol, data = []) {\n    const msg = `${conditionSymbol}: ${data.map((d) => String(d)).join(\" \")}`;\n    super(msg);\n    this.name = \"EliscriptSignal\";\n    this.conditionSymbol = conditionSymbol;\n    this.data = Array.isArray(data) ? data : [data];\n  }\n}\n\nclass CatchThrowJump {\n  constructor(tag, value) {\n    this.tag = tag;\n    this.value = value;\n  }\n}\n\nclass RecurSignal {\n  constructor(args) {\n    this.args = args;\n  }\n}\n\nconst CONDITION_PARENTS = new Map([\n  [\"eliscript-timeout\", \"eliscript-cancelled\"],\n  [\"eliscript-cancelled\", \"quit\"],\n  [\"eliscript-compile-error\", \"error\"],\n  [\"eliscript-declaration-error\", \"eliscript-compile-error\"],\n  [\"eliscript-contract-error\", \"eliscript-compile-error\"],\n  [\"eliscript-runtime-contract-error\", \"error\"],\n  [\"eliscript-channel-closed\", \"error\"],\n  [\"eliscript-engine-handle-error\", \"error\"],\n  [\"js-error\", \"error\"],\n  [\"arith-error\", \"error\"],\n  [\"void-function\", \"error\"],\n  [\"void-variable\", \"error\"],\n  [\"wrong-type-argument\", \"error\"],\n  [\"wrong-number-of-arguments\", \"error\"],\n]);\n\nfunction conditionMatches(thrownSym, handlerSym) {\n  if (handlerSym === \"t\") return true;\n  let cur = thrownSym;\n  while (cur) {\n    if (cur === handlerSym) return true;\n    cur = CONDITION_PARENTS.get(cur) ?? null;\n  }\n  return false;\n}\n\nfunction signalError(sym, ...data) {\n  throw new EliscriptSignal(sym, data);\n}\n\nexport function sym(name) {\n  return { kind: \"symbol\", name: String(name) };\n}\n\nexport function kw(name) {\n  const s = String(name);\n  return { kind: \"keyword\", name: s.startsWith(\":\") ? s : `:${s}` };\n}\n\nfunction isSym(v, name) {\n  if (!v || v.kind !== \"symbol\") return false;\n  return name === undefined ? true : v.name === name;\n}\n\nfunction isKw(v, name) {\n  if (!v || v.kind !== \"keyword\") return false;\n  return name === undefined ? true : v.name === name;\n}\n\nfunction isTruthy(v) {\n  return v !== null;\n}\n\nfunction makeCons(car, cdr) {\n  return { kind: \"cons\", car, cdr };\n}\n\nfunction arrayToConsList(arr) {\n  let out = null;\n  for (let i = arr.length - 1; i >= 0; i -= 1) {\n    out = makeCons(arr[i], out);\n  }\n  return out;\n}\n\nfunction consListToArray(list) {\n  if (list === null) return [];\n  if (Array.isArray(list)) return list;\n  const out = [];\n  let cur = list;\n  while (cur && cur.kind === \"cons\") {\n    out.push(cur.car);\n    cur = cur.cdr;\n  }\n  return out;\n}\n\nfunction makeNativeVector(items) {\n  return { kind: \"vector\", items: [...items] };\n}\n\n// Sentinels for eliscript-js\nexport const JS_FALSE = Object.freeze({ kind: \"js-sentinel\", sentinel: \"false\" });\nexport const JS_NULL = Object.freeze({ kind: \"js-sentinel\", sentinel: \"null\" });\nexport const JS_UNDEFINED = Object.freeze({ kind: \"js-sentinel\", sentinel: \"undefined\" });\nexport const OPTION_NONE = Object.freeze({ kind: \"option\", some: false, value: null });\n\n// ============================================================================\n// 2. S-Expression Reader (100% Standard Emacs Lisp Reader)\n// ============================================================================\n\nfunction tokenizeSexp(source) {\n  const tokens = [];\n  let i = 0;\n  const n = source.length;\n  while (i < n) {\n    const ch = source[i];\n    if (/\\s/u.test(ch)) {\n      i += 1;\n      continue;\n    }\n    if (ch === \";\") {\n      while (i < n && source[i] !== \"\\n\") i += 1;\n      continue;\n    }\n    if (ch === \"(\" || ch === \")\" || ch === \"[\" || ch === \"]\" || ch === \"'\" || ch === \"`\") {\n      tokens.push({ type: ch, value: ch });\n      i += 1;\n      continue;\n    }\n    if (ch === \",\") {\n      if (source[i + 1] === \"@\") {\n        tokens.push({ type: \",@\", value: \",@\" });\n        i += 2;\n      } else {\n        tokens.push({ type: \",\", value: \",\" });\n        i += 1;\n      }\n      continue;\n    }\n    if (ch === \"#\" && source[i + 1] === \"'\") {\n      tokens.push({ type: \"#'\", value: \"#'\" });\n      i += 2;\n      continue;\n    }\n    if (ch === \"#\" && (source[i + 1] === \"x\" || source[i + 1] === \"X\")) {\n      let j = i + 2;\n      while (j < n && /[0-9a-fA-F]/u.test(source[j])) j += 1;\n      const hex = source.slice(i + 2, j);\n      tokens.push({ type: \"number\", value: Number.parseInt(hex, 16), isFloat: false });\n      i = j;\n      continue;\n    }\n    if (ch === '\"') {\n      let j = i + 1;\n      let str = \"\";\n      while (j < n && source[j] !== '\"') {\n        if (source[j] === \"\\\\\") {\n          const next = source[j + 1];\n          if (next === \"n\") str += \"\\n\";\n          else if (next === \"t\") str += \"\\t\";\n          else if (next === \"r\") str += \"\\r\";\n          else if (next === '\"') str += '\"';\n          else if (next === \"\\\\\") str += \"\\\\\";\n          else str += \"\\\\\" + next;\n          j += 2;\n        } else {\n          str += source[j];\n          j += 1;\n        }\n      }\n      tokens.push({ type: \"string\", value: str });\n      i = j + 1;\n      continue;\n    }\n    let j = i;\n    while (j < n && !/[\\s()\\[\\]\"';`,]/u.test(source[j])) {\n      j += 1;\n    }\n    const raw = source.slice(i, j);\n    if (/^[+-]?(?:\\d+\\.\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?$/u.test(raw)) {\n      tokens.push({ type: \"number\", value: Number(raw), isFloat: true });\n    } else if (/^[+-]?\\d+$/u.test(raw)) {\n      tokens.push({ type: \"number\", value: Number.parseInt(raw, 10), isFloat: false });\n    } else {\n      tokens.push({ type: \"atom\", value: raw });\n    }\n    i = j;\n  }\n  return tokens;\n}\n\nexport function readAllForms(source) {\n  const tokens = tokenizeSexp(source);\n  let pos = 0;\n\n  function readForm() {\n    if (pos >= tokens.length) return undefined;\n    const tok = tokens[pos++];\n    if (tok.type === \"'\") {\n      return arrayToConsList([sym(\"quote\"), readForm()]);\n    }\n    if (tok.type === \"#'\") {\n      return arrayToConsList([sym(\"function\"), readForm()]);\n    }\n    if (tok.type === \"`\") {\n      return arrayToConsList([sym(\"backquote\"), readForm()]);\n    }\n    if (tok.type === \",\") {\n      return arrayToConsList([sym(\"unquote\"), readForm()]);\n    }\n    if (tok.type === \",@\") {\n      return arrayToConsList([sym(\"unquote-splicing\"), readForm()]);\n    }\n    if (tok.type === \"(\") {\n      const items = [];\n      let cdrVal = null;\n      while (pos < tokens.length && tokens[pos].type !== \")\") {\n        if (tokens[pos].type === \"atom\" && tokens[pos].value === \".\") {\n          pos += 1;\n          cdrVal = readForm();\n          break;\n        }\n        items.push(readForm());\n      }\n      if (tokens[pos]?.type === \")\") pos += 1;\n      if (items.length === 0 && cdrVal === null) return null;\n      let list = cdrVal;\n      for (let idx = items.length - 1; idx >= 0; idx -= 1) {\n        list = makeCons(items[idx], list);\n      }\n      return list;\n    }\n    if (tok.type === \"[\") {\n      const items = [];\n      while (pos < tokens.length && tokens[pos].type !== \"]\") {\n        items.push(readForm());\n      }\n      if (tokens[pos]?.type === \"]\") pos += 1;\n      return makeNativeVector(items);\n    }\n    if (tok.type === \"string\") return tok.value;\n    if (tok.type === \"number\") {\n      if (tok.isFloat && Number.isInteger(tok.value)) {\n        return { kind: \"float-lit\", value: tok.value };\n      }\n      return tok.value;\n    }\n    if (tok.type === \"atom\") {\n      if (tok.value === \"nil\") return null;\n      if (tok.value === \"t\") return true;\n      if (tok.value.startsWith(\":\")) return kw(tok.value);\n      return sym(tok.value);\n    }\n    return null;\n  }\n\n  const forms = [];\n  while (pos < tokens.length) {\n    const f = readForm();\n    if (f !== undefined) forms.push(f);\n  }\n  return forms;\n}\n\n// ============================================================================\n// 3. Value Equality, Comparison, Persistent Collections & Structs\n// ============================================================================\n\nexport function valueEqual(a, b) {\n  if (a === b) return true;\n  if (a === null || b === null || a === undefined || b === undefined) return false;\n  if (typeof a === \"number\" && typeof b === \"number\") return a === b;\n  if (typeof a === \"string\" && typeof b === \"string\") return a === b;\n  if (typeof a === \"boolean\" && typeof b === \"boolean\") return a === b;\n  if (isSym(a) && isSym(b)) return a.name === b.name;\n  if (isKw(a) && isKw(b)) return a.name === b.name;\n  const seqKinds = new Set([\"persistent-list\", \"persistent-vector\", \"persistent-queue\"]);\n  if (seqKinds.has(a.kind) && seqKinds.has(b.kind)) {\n    if (a.items.length !== b.items.length) return false;\n    return a.items.every((x, idx) => valueEqual(x, b.items[idx]));\n  }\n  const mapKinds = new Set([\"persistent-map\", \"persistent-sorted-map\"]);\n  if (mapKinds.has(a.kind) && mapKinds.has(b.kind)) {\n    if (a.entries.length !== b.entries.length) return false;\n    return a.entries.every(([ka, va]) => {\n      const found = b.entries.find(([kb]) => valueEqual(ka, kb));\n      return Boolean(found && valueEqual(va, found[1]));\n    });\n  }\n  const setKinds = new Set([\"persistent-set\", \"persistent-sorted-set\"]);\n  if (setKinds.has(a.kind) && setKinds.has(b.kind)) {\n    if (a.items.length !== b.items.length) return false;\n    return a.items.every((x) => b.items.some((y) => valueEqual(x, y)));\n  }\n  if (a.kind === \"persistent-record\" && b.kind === \"persistent-record\") {\n    if (a.typeName !== b.typeName || a.entries.length !== b.entries.length) return false;\n    return a.entries.every(([k, va]) => {\n      const found = b.entries.find(([kb]) => kb === k);\n      return Boolean(found && valueEqual(va, found[1]));\n    });\n  }\n  if (a.kind === \"vector\" && b.kind === \"vector\") {\n    if (a.items.length !== b.items.length) return false;\n    return a.items.every((x, idx) => valueEqual(x, b.items[idx]));\n  }\n  if (a.kind === \"cons\" && b.kind === \"cons\") {\n    return valueEqual(a.car, b.car) && valueEqual(a.cdr, b.cdr);\n  }\n  return false;\n}\n\nexport function valueCompare(a, b) {\n  if (valueEqual(a, b)) return 0;\n  if (a === null) return -1;\n  if (b === null) return 1;\n  if (typeof a === \"number\" && typeof b === \"number\") return a < b ? -1 : 1;\n  if (typeof a === \"string\" && typeof b === \"string\") return a < b ? -1 : 1;\n  const sa = isSym(a) || isKw(a) ? a.name : JSON.stringify(a);\n  const sb = isSym(b) || isKw(b) ? b.name : JSON.stringify(b);\n  return sa < sb ? -1 : 1;\n}\n\nfunction assocEntries(entries, key, val) {\n  let found = false;\n  const next = entries.map(([k, v]) => {\n    if (!found && valueEqual(k, key)) {\n      found = true;\n      return [key, val];\n    }\n    return [k, v];\n  });\n  if (!found) next.push([key, val]);\n  return next;\n}\n\nfunction dissocEntries(entries, key) {\n  return entries.filter(([k]) => !valueEqual(k, key));\n}\n\nfunction makePersistentList(items = [], meta = null) {\n  return { kind: \"persistent-list\", items: [...items], meta };\n}\n\nfunction makePersistentVector(items = [], meta = null) {\n  return { kind: \"persistent-vector\", items: [...items], meta };\n}\n\nfunction makePersistentMap(kvs = [], meta = null) {\n  let entries = [];\n  for (let i = 0; i < kvs.length; i += 2) {\n    entries = assocEntries(entries, kvs[i], kvs[i + 1]);\n  }\n  return { kind: \"persistent-map\", entries, meta };\n}\n\nfunction makePersistentSet(items = [], meta = null) {\n  const unique = [];\n  for (const it of items) {\n    if (!unique.some((x) => valueEqual(x, it))) unique.push(it);\n  }\n  return { kind: \"persistent-set\", items: unique, meta };\n}\n\nfunction makePersistentQueue(items = [], meta = null) {\n  return { kind: \"persistent-queue\", items: [...items], meta };\n}\n\nfunction normalizeCmpFn(cmpFn) {\n  const fn = typeof cmpFn === \"function\" ? cmpFn : valueCompare;\n  return (a, b) => {\n    const r = fn(a, b);\n    if (typeof r === \"number\") return r;\n    if (r === true) return -1;\n    return valueEqual(a, b) ? 0 : 1;\n  };\n}\n\nfunction makePersistentSortedMap(args) {\n  const hasCmp = typeof args[0] === \"function\" && (args.length - 1) % 2 === 0;\n  const cmp = hasCmp ? args[0] : valueCompare;\n  const kvs = hasCmp ? args.slice(1) : args;\n  const norm = normalizeCmpFn(cmp);\n  let entries = [];\n  for (let i = 0; i < kvs.length; i += 2) {\n    entries = assocEntries(entries, kvs[i], kvs[i + 1]);\n  }\n  entries.sort((a, b) => norm(a[0], b[0]));\n  return { kind: \"persistent-sorted-map\", comparator: cmp, entries, meta: null };\n}\n\nfunction makePersistentSortedSet(args) {\n  const hasCmp = typeof args[0] === \"function\";\n  const cmp = hasCmp ? args[0] : valueCompare;\n  const items = hasCmp ? args.slice(1) : args;\n  const norm = normalizeCmpFn(cmp);\n  const unique = [];\n  for (const it of items) {\n    if (!unique.some((x) => norm(x, it) === 0)) unique.push(it);\n  }\n  unique.sort(norm);\n  return { kind: \"persistent-sorted-set\", comparator: cmp, items: unique, meta: null };\n}\n\nfunction extractSeqElements(coll) {\n  if (coll === null) return [];\n  if (Array.isArray(coll)) return coll;\n  if (coll.kind === \"cons\") return consListToArray(coll);\n  if (\n    coll.kind === \"vector\" ||\n    coll.kind === \"persistent-list\" ||\n    coll.kind === \"persistent-vector\" ||\n    coll.kind === \"persistent-set\" ||\n    coll.kind === \"persistent-sorted-set\" ||\n    coll.kind === \"persistent-queue\"\n  ) {\n    return [...coll.items];\n  }\n  if (\n    coll.kind === \"persistent-map\" ||\n    coll.kind === \"persistent-sorted-map\" ||\n    coll.kind === \"persistent-record\"\n  ) {\n    return coll.entries.map(([k, v]) => arrayToConsList([k, v]));\n  }\n  if (coll.kind === \"lazy-seq\") {\n    const out = [];\n    let cur = coll;\n    while (cur) {\n      if (cur.kind === \"lazy-seq\") cur = cur.step();\n      else if (cur.kind === \"cons\") {\n        out.push(cur.car);\n        cur = cur.cdr;\n      } else break;\n    }\n    return out;\n  }\n  throw new Error(`Not a sequential collection: ${String(coll)}`);\n}\n\nfunction valueContains(coll, key) {\n  if (!coll) return false;\n  if (coll.kind === \"persistent-map\" || coll.kind === \"persistent-sorted-map\") {\n    return coll.entries.some(([k]) => valueEqual(k, key));\n  }\n  if (coll.kind === \"persistent-record\") {\n    const fname = isKw(key) ? key.name.slice(1) : isSym(key) ? key.name : String(key);\n    return coll.entries.some(([k]) => k === fname);\n  }\n  if (coll.kind === \"hash-table\") {\n    const kstr = isKw(key) || isSym(key) ? key.name : key;\n    return coll.map.has(kstr);\n  }\n  return false;\n}\n\nfunction valueGet(coll, key, notFound = null) {\n  if (coll === null || coll === undefined) return notFound;\n  if (coll.kind === \"persistent-map\" || coll.kind === \"persistent-sorted-map\") {\n    const cell = coll.entries.find(([k]) => valueEqual(k, key));\n    return cell ? cell[1] : notFound;\n  }\n  if (coll.kind === \"persistent-record\") {\n    const fname = isKw(key) ? key.name.slice(1) : isSym(key) ? key.name : String(key);\n    const cell = coll.entries.find(([k]) => k === fname);\n    return cell ? cell[1] : notFound;\n  }\n  if (coll.kind === \"hash-table\") {\n    const kstr = isKw(key) || isSym(key) ? key.name : key;\n    return coll.map.has(kstr) ? coll.map.get(kstr) : notFound;\n  }\n  if (coll.kind === \"persistent-vector\" || coll.kind === \"vector\") {\n    return key >= 0 && key < coll.items.length ? coll.items[key] : notFound;\n  }\n  return notFound;\n}\n\nfunction valueCount(coll) {\n  if (coll === null) return 0;\n  if (typeof coll === \"string\") return Array.from(coll).length;\n  if (coll.kind === \"hash-table\") return coll.map.size;\n  if (\n    coll.kind === \"persistent-map\" ||\n    coll.kind === \"persistent-sorted-map\" ||\n    coll.kind === \"persistent-record\"\n  ) {\n    return coll.entries.length;\n  }\n  return extractSeqElements(coll).length;\n}\n\n// ============================================================================\n// 4. Lisp-2 Session State, Static Contracts & Evaluator\n// ============================================================================\n\nconst EXTENSION_EXPORTS = {\n  \"eliscript-data\": [\n    \"persistent-list\", \"persistent-list-p\", \"persistent-vector\", \"persistent-vector-p\",\n    \"persistent-map\", \"persistent-map-p\", \"persistent-set\", \"persistent-set-p\",\n    \"persistent-queue\", \"persistent-queue-p\", \"persistent-sorted-map\", \"persistent-sorted-map-p\",\n    \"persistent-sorted-set\", \"persistent-sorted-set-p\",\n    \"value-get\", \"value-nth\", \"value-put\", \"value-assoc\", \"value-remove\", \"value-dissoc\",\n    \"value-conj\", \"value-count\", \"value-empty-p\", \"value-into\", \"value-equal-p\", \"value-hash\",\n    \"value-compare\", \"value-meta\", \"value-with-meta\",\n    \"cl-defstruct-persistent\", \"struct-validate\", \"struct-json-schema\", \"struct-to-json\", \"struct-from-json\",\n    \"defprotocol\", \"extend-protocol\", \"defclass-protocol\", \"reify-protocol\",\n    \"cl-defgeneric-value\", \"cl-defmethod-value\",\n    \"state-cell\", \"state-cell-p\", \"cell-value\", \"cell-update!\", \"cell-reset!\", \"cell-watch\",\n    \"delay\", \"force\", \"realized-p\", \"memoize\", \"lazy-seq\", \"lazy-map\", \"lazy-filter\", \"lazy-take\", \"lazy-range\",\n    \"map-transducer\", \"filter-transducer\", \"take-transducer\", \"seq-transduce\",\n    \"with-transient\", \"conj!\", \"assoc!\", \"dissoc!\",\n    \"result-ok\", \"result-error\", \"result-ok-p\", \"result-error-p\", \"result-value\", \"result-error-value\", \"result-bind\",\n    \"option-some\", \"option-none\", \"option-some-p\", \"option-none-p\", \"option-value\",\n    \"data-symbol\", \"data-symbol-p\", \"data-symbol-name\", \"data-symbol-namespace\",\n  ],\n  \"eliscript-bind\": [\n    \"let-bind\", \"let*-bind\", \"defun-bind\", \"lambda-bind\", \"pcase-value\", \"cond-predicate\",\n    \"defun-case\", \"lambda-case\", \"let-const\", \"let*-const\",\n    \"let-loop\", \"defun-tail\", \"lambda-tail\", \"recur\", \"trampoline\",\n    \"thread-first\", \"thread-last\", \"thread-as\", \"thread-cond-first\", \"thread-cond-last\",\n    \"thread-some-first\", \"thread-some-last\",\n    \"fn-compose\", \"fn-partial\", \"fn-juxt\", \"fn-complement\",\n  ],\n  \"eliscript-async\": [\n    \"defun-async\", \"lambda-async\", \"await\", \"future-p\", \"future-then\", \"future-cancel\",\n    \"with-async-scope\", \"with-async-timeout\", \"with-async-bindings\", \"bind-async\",\n    \"make-async-channel\", \"async-channel-p\", \"channel-put!\", \"channel-take!\", \"channel-close!\",\n    \"engine-bind\", \"engine-revoke!\", \"engine-handle-p\", \"engine-call\", \"eliscript-async-wait\",\n  ],\n  \"eliscript-module\": [\n    \"defmodule\", \"defun-lexical\", \"defvar-lexical\", \"defconst-lexical\",\n    \"export-functions\", \"export-values\", \"import-functions\", \"import-values\",\n    \"defmacro-checked\", \"macro-gensym\", \"macro-read-file\",\n  ],\n  \"eliscript-contract\": [\"eliscript-contract-check-value\"],\n  \"eliscript-js\": [\n    \"js-false\", \"js-null\", \"js-undefined\", \"js-false-p\", \"js-null-p\", \"js-undefined-p\", \"js-nullish-p\",\n    \"js-import\", \"js-array\", \"js-object\", \"js-get\", \"js-get-raw\", \"js-put\", \"js-call\", \"js-call-raw\",\n    \"js-new\", \"js-expr\", \"js-divide\", \"js-remainder\", \"js-length\", \"js-substring\",\n    \"js-regexp\", \"js-regexp-p\", \"js-regexp-find\", \"js-regexp-matches\", \"js-regexp-seq\", \"js-regexp-replace\",\n  ],\n  \"eliscript-abi\": [\n    \"with-abi-memory\", \"mem-size\", \"mem-grow\",\n    \"mem-load-u8\", \"mem-load-u16\", \"mem-load-u32\", \"mem-load-f64\",\n    \"mem-store-u8\", \"mem-store-u16\", \"mem-store-u32\", \"mem-store-f64\",\n    \"word-add\", \"word-sub\", \"word-mul\", \"word-div\", \"word-and\", \"word-or\", \"word-xor\", \"word-shl\", \"word-shr\",\n  ],\n};\n\nclass LexEnv {\n  constructor(parent = null) {\n    this.parent = parent;\n    this.vars = new Map();\n    this.constVars = new Set();\n    this.fns = new Map();\n  }\n  hasVar(name) {\n    if (this.vars.has(name)) return true;\n    return this.parent ? this.parent.hasVar(name) : false;\n  }\n  getVar(name) {\n    if (this.vars.has(name)) return this.vars.get(name);\n    if (this.parent) return this.parent.getVar(name);\n    return undefined;\n  }\n  setVar(name, val) {\n    let cur = this;\n    while (cur) {\n      if (cur.vars.has(name)) {\n        if (cur.constVars.has(name)) {\n          signalError(\"eliscript-compile-error\", `ELI-C0010: cannot mutate immutable binding ${name}`);\n        }\n        cur.vars.set(name, val);\n        return true;\n      }\n      cur = cur.parent;\n    }\n    return false;\n  }\n  getFn(name) {\n    if (this.fns.has(name)) return this.fns.get(name);\n    if (this.parent) return this.parent.getFn(name);\n    return undefined;\n  }\n}\n\nexport function createCompatSession() {\n  const session = {\n    values: new Map([[\"nil\", null], [\"t\", true]]),\n    functions: new Map(),\n    macros: new Map(),\n    plists: new Map(),\n    specialVars: new Set(),\n    userDefinedFns: new Set(),\n    activeLibs: new Set(),\n    structSchemas: new Map(),\n    protocols: new Map(),\n    multimethods: new Map(),\n    modules: new Map(),\n    liveValueGetters: new Map(),\n    engineSlots: new Map(),\n    nextSlotId: 0,\n    gensymCounter: 0,\n    inAsyncContext: false,\n    inTailContext: false,\n    abiMemory: null,\n    abiMaxPages: 256,\n  };\n  installKernelBuiltins(session);\n  return session;\n}\n\nlet defaultSession = createCompatSession();\n\nexport function resetCompatState() {\n  defaultSession = createCompatSession();\n}\n\nfunction activateExtensionLib(session, libName) {\n  if (libName === \"eliscript\") {\n    for (const sub of [\n      \"eliscript-data\",\n      \"eliscript-bind\",\n      \"eliscript-async\",\n      \"eliscript-module\",\n      \"eliscript-contract\",\n    ]) {\n      activateExtensionLib(session, sub);\n    }\n    return;\n  }\n  const exports = EXTENSION_EXPORTS[libName];\n  if (!exports) return;\n  for (const s of exports) {\n    if (session.userDefinedFns.has(s)) {\n      signalError(\n        \"eliscript-compile-error\",\n        `ELI-M0001: extension ${libName} symbol ${s} conflicts with existing user definition`,\n      );\n    }\n  }\n  session.activeLibs.add(libName);\n  installExtensionBuiltins(session, libName);\n}\n\nfunction formatElisp(fmt, args) {\n  let idx = 0;\n  return String(fmt).replace(/%[sdS]/gu, (m) => {\n    const v = args[idx++];\n    if (m === \"%d\") return String(Math.trunc(Number(v)));\n    if (v === null) return \"nil\";\n    if (v === true) return \"t\";\n    if (isSym(v) || isKw(v)) return v.name;\n    return String(v);\n  });\n}\n\nfunction installKernelBuiltins(session) {\n  const fns = session.functions;\n  fns.set(\"+\", (...ns) => ns.reduce((a, b) => a + b, 0));\n  fns.set(\"-\", (a, ...rest) => (rest.length === 0 ? -a : rest.reduce((x, y) => x - y, a)));\n  fns.set(\"*\", (...ns) => ns.reduce((a, b) => a * b, 1));\n  fns.set(\"/\", (first, ...rest) => {\n    if (rest.length === 0) {\n      if (first === 0) signalError(\"arith-error\", \"Division by zero\");\n      return 1 / first;\n    }\n    let acc = first;\n    let allInt = Number.isInteger(first);\n    for (const d of rest) {\n      if (d === 0) signalError(\"arith-error\", \"Division by zero\");\n      allInt = allInt && Number.isInteger(d);\n      acc = allInt ? Math.trunc(acc / d) : acc / d;\n    }\n    return acc;\n  });\n  fns.set(\"mod\", (a, b) => {\n    if (b === 0) signalError(\"arith-error\", \"Division by zero\");\n    return ((a % b) + b) % b;\n  });\n  fns.set(\"%\", (a, b) => {\n    if (b === 0) signalError(\"arith-error\", \"Division by zero\");\n    return Math.trunc(a % b);\n  });\n  fns.set(\"1+\", (x) => x + 1);\n  fns.set(\"1-\", (x) => x - 1);\n  fns.set(\"=\", (a, b) => (a === b ? true : null));\n  fns.set(\"<\", (a, b) => (a < b ? true : null));\n  fns.set(\">\", (a, b) => (a > b ? true : null));\n  fns.set(\"<=\", (a, b) => (a <= b ? true : null));\n  fns.set(\">=\", (a, b) => (a >= b ? true : null));\n  fns.set(\"min\", (...ns) => Math.min(...ns));\n  fns.set(\"max\", (...ns) => Math.max(...ns));\n  fns.set(\"cl-evenp\", (x) => (x % 2 === 0 ? true : null));\n  fns.set(\"cl-oddp\", (x) => (Math.abs(x % 2) === 1 ? true : null));\n  fns.set(\"numberp\", (x) => (typeof x === \"number\" ? true : null));\n  fns.set(\"integerp\", (x) => (Number.isInteger(x) ? true : null));\n  fns.set(\"stringp\", (x) => (typeof x === \"string\" ? true : null));\n  fns.set(\"symbolp\", (x) => (x === null || x === true || isSym(x) || isKw(x) ? true : null));\n  fns.set(\"keywordp\", (x) => (isKw(x) ? true : null));\n  fns.set(\"null\", (x) => (x === null ? true : null));\n  fns.set(\"not\", (x) => (x === null ? true : null));\n  fns.set(\"atom\", (x) => (x && x.kind === \"cons\" ? null : true));\n  fns.set(\"eq\", (a, b) => {\n    if (a === b) return true;\n    if (isSym(a) && isSym(b)) return a.name === b.name ? true : null;\n    if (isKw(a) && isKw(b)) return a.name === b.name ? true : null;\n    return null;\n  });\n  fns.set(\"equal\", (a, b) => (valueEqual(a, b) ? true : null));\n  fns.set(\"cons\", (a, b) => makeCons(a, b));\n  fns.set(\"car\", (x) => (x && x.kind === \"cons\" ? x.car : null));\n  fns.set(\"cdr\", (x) => (x && x.kind === \"cons\" ? x.cdr : null));\n  fns.set(\"setcar\", (cell, v) => {\n    cell.car = v;\n    return v;\n  });\n  fns.set(\"setcdr\", (cell, v) => {\n    cell.cdr = v;\n    return v;\n  });\n  fns.set(\"list\", (...items) => arrayToConsList(items));\n  fns.set(\"nreverse\", (lst) => arrayToConsList(consListToArray(lst).reverse()));\n  fns.set(\"vector\", (...items) => makeNativeVector(items));\n  fns.set(\"vectorp\", (x) => (x && x.kind === \"vector\" ? true : null));\n  fns.set(\"aref\", (v, idx) => {\n    if (typeof v === \"string\") return Array.from(v)[idx].codePointAt(0);\n    return v.items[idx];\n  });\n  fns.set(\"aset\", (v, idx, val) => {\n    v.items[idx] = val;\n    return val;\n  });\n  fns.set(\"make-hash-table\", () => ({ kind: \"hash-table\", map: new Map() }));\n  fns.set(\"hash-table-p\", (x) => (x && x.kind === \"hash-table\" ? true : null));\n  fns.set(\"puthash\", (k, v, ht) => {\n    const key = isKw(k) || isSym(k) ? k.name : k;\n    ht.map.set(key, v);\n    return v;\n  });\n  fns.set(\"gethash\", (k, ht, def = null) => {\n    const key = isKw(k) || isSym(k) ? k.name : k;\n    return ht.map.has(key) ? ht.map.get(key) : def;\n  });\n  fns.set(\"hash-table-count\", (ht) => ht.map.size);\n  fns.set(\"length\", (x) => {\n    if (x === null) return 0;\n    if (typeof x === \"string\") return Array.from(x).length;\n    if (x.kind === \"vector\") return x.items.length;\n    if (x.kind === \"cons\") return consListToArray(x).length;\n    return valueCount(x);\n  });\n  fns.set(\"substring\", (s, start, end) => {\n    const chars = Array.from(s);\n    return chars.slice(start, end ?? chars.length).join(\"\");\n  });\n  fns.set(\"format\", (fmt, ...args) => formatElisp(fmt, args));\n  fns.set(\"funcall\", (fn, ...args) => invokeCallable(session, fn, args));\n  fns.set(\"apply\", (fn, ...args) => {\n    const last = consListToArray(args[args.length - 1]);\n    const full = [...args.slice(0, -1), ...last];\n    return invokeCallable(session, fn, full);\n  });\n  fns.set(\"mapcar\", (fn, seq) => {\n    const items = extractSeqElements(seq);\n    return arrayToConsList(items.map((x) => invokeCallable(session, fn, [x])));\n  });\n  fns.set(\"symbol-value\", (s) => {\n    const name = isSym(s) ? s.name : String(s);\n    if (session.liveValueGetters.has(name)) return session.liveValueGetters.get(name)();\n    return session.values.get(name) ?? null;\n  });\n  fns.set(\"symbol-function\", (s) => {\n    const name = isSym(s) ? s.name : String(s);\n    return session.functions.get(name) ?? null;\n  });\n  fns.set(\"set\", (s, val) => {\n    const name = isSym(s) ? s.name : String(s);\n    session.values.set(name, val);\n    return val;\n  });\n  fns.set(\"fset\", (s, fn) => {\n    const name = isSym(s) ? s.name : String(s);\n    session.functions.set(name, fn);\n    return fn;\n  });\n  fns.set(\"put\", (s, prop, val) => {\n    const name = isSym(s) ? s.name : String(s);\n    if (!session.plists.has(name)) session.plists.set(name, new Map());\n    const k = isKw(prop) || isSym(prop) ? prop.name : String(prop);\n    session.plists.get(name).set(k, val);\n    return val;\n  });\n  fns.set(\"get\", (s, prop) => {\n    const name = isSym(s) ? s.name : String(s);\n    const k = isKw(prop) || isSym(prop) ? prop.name : String(prop);\n    return session.plists.get(name)?.get(k) ?? null;\n  });\n  fns.set(\"string-match\", (pat, str) => {\n    const jsPat = String(pat).replace(/\\\\([()|])/gu, \"$1\");\n    const m = new RegExp(jsPat, \"u\").exec(str);\n    session.lastMatchData = m;\n    return m ? m.index : null;\n  });\n  fns.set(\"match-string\", (num) => {\n    return session.lastMatchData?.[num] ?? null;\n  });\n}\n\nfunction installExtensionBuiltins(session, libName) {\n  const fns = session.functions;\n  if (libName === \"eliscript-data\") {\n    session.values.set(\"option-none\", OPTION_NONE);\n    fns.set(\"persistent-list