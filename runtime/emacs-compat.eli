                       (catch e nil))))))
      (funcall d "set-file-modes"
               (lambda (f mode &optional flag)
                 (let ((fs (el-fs)))
                   (unless (nullish? fs)
                     (try (js-call fs :chmodSync (el-expand-file-name session f nil) (el-num mode)) (catch e nil)))
                   nil)))
      (funcall d "default-file-modes" (lambda () (or (get session :defaultFileModes) 493)))
      (funcall d "set-default-file-modes" (lambda (mode) (put session :defaultFileModes (el-num mode)) nil))
