                               p nil))
                       (let* ((ep (el-seq-items (el-global-value session (el-intern "exec-path"))))
                              (path-env (let ((v (el-call session (el-intern "getenv") (js-array "PATH"))))
                                          (if (el-string? v) (js-call v :split ":") (js-array))))
                              (dirs (js-call ep :concat path-env))
                              (found nil)
                              (i 0))
                         (while (and (nil? found) (< i (js-length dirs)))
                           (let ((dir (aref dirs i)))
                             (when (and (el-string? dir) (> (js-length dir) 0))
                               (let ((cand (el-expand-file-name session command dir)))
                                 (when (try (and (js-call (js-call fs :statSync cand) :isFile)
                                                 (progn (js-call fs :accessSync cand (get (get fs :constants) :X_OK)) t))
                                         (catch e false))
                                   (setq found cand)))))
                           (setq i (1+ i)))
                         found))))))
      (funcall d "expand-file-name" (lambda (name &optional dir) (el-expand-file-name session name (el-opt dir))))
      (funcall d "directory-file-name"
               (lambda (dir)
                 (unless (el-string? dir) (el-signal "wrong-type-argument" (el-intern "stringp") dir))
                 (if (and (> (js-length dir) 1) (js-call dir :endsWith "/"))
                     (js-call dir :replace (new globalThis.RegExp "/+$") "")
                   dir)))
      (funcall d "file-name-as-directory"
               (lambda (dir)
                 (unless (el-string? dir) (el-signal "wrong-type-argument" (el-intern "stringp") dir))
                 (if (= dir "") "./" (if (js-call dir :endsWith "/") dir (str dir "/")))))
      (funcall d "file-name-nondirectory"
               (lambda (f)
                 (unless (el-string? f) (el-signal "wrong-type-argument" (el-intern "stringp") f))
                 (js-call f :slice (1+ (js-call f :lastIndexOf "/")))))
      (funcall d "file-name-directory"
               (lambda (f)
                 (unless (el-string? f) (el-signal "wrong-type-argument" (el-intern "stringp") f))
                 (let ((i (js-call f :lastIndexOf "/"))) (if (< i 0) nil (js-call f :slice 0 (1+ i))))))
      (funcall d "file-name-sans-extension" (lambda (f) (el-file-name-sans-extension f)))
      (funcall d "file-name-extension" (lambda (f &optional period) (el-file-name-extension f (el-opt period))))
      (funcall d "file-name-base"
               (lambda (f)
                 (unless (el-string? f) (el-signal "wrong-type-argument" (el-intern "stringp") f))
                 (el-file-name-sans-extension (js-call f :slice (1+ (js-call f :lastIndexOf "/"))))))
      (funcall d "file-name-absolute-p"
               (lambda (f)
                 (unless (el-string? f) (el-signal "wrong-type-argument" (el-intern "stringp") f))
                 (el-bool (or (js-call f :startsWith "/") (js-call f :startsWith "~")))))
      (funcall d "file-relative-name" (lambda (filename &optional directory) (el-file-relative-name session filename (el-opt directory))))
      (funcall d "file-truename" (lambda (filename &rest ignored) (el-file-truename session filename)))
      (funcall d "temporary-file-directory"
               (lambda ()
                 (or (js-call (get session :values) :get (el-intern "temporary-file-directory")) "/tmp/")))
      (funcall d "getenv"
               (lambda (name &rest ignored)
                 (let* ((pe (el-global-value session (el-intern "process-environment")))
                        (prefix (str name "="))
                        (found undefined))
                   (when (el-cons? pe)
                     (let ((entry (js-call (el-list-to-array pe) :find
                                           (lambda (s) (and (el-string? s) (or (= s name) (js-call s :startsWith prefix)))))))
                       (unless (undefined? entry)
                         (setq found (if (= entry name) nil (js-call entry :slice (js-length prefix)))))))
                   (if (not (undefined? found))
                       found
                     (let ((process globalThis.process))
                       (if (nullish? process) nil (let ((v (get (get process :env) name))) (if (nullish? v) nil v))))))))
      (funcall d "setenv"
               (lambda (variable &optional value substitute-env-vars)
                 (let ((p globalThis.process)
                       (pe (el-seq-items (el-global-value session (el-intern "process-environment"))))
                       (prefix (str variable "=")))
                   (when (and (not (nullish? p)) (not (nullish? (get p :env))))
                     (if (or (nullish? value) (nil? value))
                         (Reflect/deleteProperty (get p :env) variable)
                       (put (get p :env) variable (str value))))
                   (let ((filtered (js-call pe :filter (lambda (s) (not (and (el-string? s) (or (= s variable) (js-call s :startsWith prefix))))))))
                     (js-call filtered :unshift (if (or (nullish? value) (nil? value)) variable (str variable "=" value)))
                     (el-set-dynamic-variable session (el-intern "process-environment") (el-list-from filtered)))
                   (el-opt value))))
      (funcall d "emacs-pid" (lambda () (let ((p globalThis.process)) (if (and (not (nullish? p)) (el-integer? (get p :pid))) (get p :pid) 1))))
      (funcall d "process-attributes"
               (lambda (pid)
                 (if (or (not (el-integer? pid)) (<= pid 0))
                     nil
                   (let ((p globalThis.process))
                     (if (nullish? p)
                         (el-list (el-cons (el-intern "pid") pid) (el-cons (el-intern "rss") 0))
                       (if (= pid (get p :pid))
                           (let ((rss-kb (Math/round (/ (get (js-call p :memoryUsage) :rss) 1024))))
                             (el-list (el-cons (el-intern "pid") pid)
                                      (el-cons (el-intern "rss") rss-kb)
                                      (el-cons (el-intern "comm") "eliscript")))
                         (let ((alive (try (progn (js-call p :kill pid 0) t)
                                        (catch e (= (get e :code) "EPERM")))))
                           (if alive
                               (el-list (el-cons (el-intern "pid") pid) (el-cons (el-intern "rss") 0))
                             nil))))))))
      (funcall d "system-name" (lambda () (let ((os-mod (el-os))) (if (nullish? os-mod) "localhost" (try (js-call os-mod :hostname) (catch e "localhost"))))))
      (funcall d "user-uid" (lambda () (let ((p globalThis.process)) (if (or (nullish? p) (nullish? (get p :getuid))) 1000 (js-call p :getuid)))))
      (funcall d "user-real-uid" (lambda () (let ((p globalThis.process)) (if (or (nullish? p) (nullish? (get p :getuid))) 1000 (js-call p :getuid)))))
      (funcall d "user-login-name" (lambda (&optional uid) (let ((os-mod (el-os))) (if (nullish? os-mod) "user" (try (get (js-call os-mod :userInfo) :username) (catch e "user"))))))
      (funcall d "user-full-name" (lambda (&optional uid) (el-call session (el-intern "user-login-name") (js-array))))
      (funcall d "kbd" (lambda (keys) keys))
      (funcall d "make-sparse-keymap" (lambda (&optional prompt) (el-list (el-intern "keymap"))))
      (funcall d "make-keymap" (lambda (&optional prompt) (el-list (el-intern "keymap"))))
      (funcall d "copy-keymap" (lambda (km) (el-copy-tree km t)))
      (funcall d "keymapp" (lambda (x) (el-bool (and (el-cons? x) (el-sym-is (get x :car) "keymap")))))
      (funcall d "set-keymap-parent" (lambda (km parent) parent))
      (funcall d "keymap-parent" (lambda (km) nil))
      (funcall d "define-key" (lambda (keymap key def &optional remove) def))
      (funcall d "keymap-set" (lambda (keymap key definition) definition))
      (funcall d "keymap-unset" (lambda (keymap key &optional remove) nil))
      (funcall d "lookup-key" (lambda (keymap key &optional accept-default) nil))
      (funcall d "keymap-lookup" (lambda (keymap key &rest ignored) nil))
      (funcall d "autoload" (lambda (fn file &rest ignored) fn))
      (funcall d "custom-autoload" (lambda (&rest ignored) nil))
      (funcall d "display-graphic-p" (lambda (&optional display) nil))
      (funcall d "called-interactively-p" (lambda (&optional kind) nil))
      (funcall d "url-generic-parse-url" (lambda (url) (el-url-generic-parse-url session url)))
      (funcall d "url-portspec" (lambda (u) (el-call session (el-intern "url-portsitory") (js-array u))))
      (funcall d "url-port"
               (lambda (u)
                 (let ((explicit (el-call session (el-intern "url-portsitory") (js-array u))))
                   (if (el-integer? explicit)
                       explicit
                     (let ((scheme (el-call session (el-intern "url-type") (js-array u))))
                       (cond ((= scheme "http") 80)
                             ((= scheme "https") 443)
                             ((= scheme "ftp") 21)
                             ((= scheme "ssh") 22)
                             (t 0)))))))
      (funcall d "url-retrieve"
               (lambda (url callback &optional cbargs silent inhibit-cookies)
                 (el-url-retrieve session url callback (el-opt cbargs) (el-opt silent) (el-opt inhibit-cookies))))
      (funcall d "url-retrieve-synchronously"
               (lambda (url &optional silent inhibit-cookies timeout)
                 (el-url-retrieve-synchronously session url (el-opt silent) (el-opt inhibit-cookies) (el-opt timeout))))
      ;; Subprocesses and pipes
      (funcall d "call-process"
               (lambda (program &optional infile destination display &rest args)
                 (Reflect/apply el-call-process nil (js-call (js-array session program (el-opt infile) (el-opt destination) (el-opt display)) :concat args))))
      (el-def-alias session "process-file" "call-process")
      (funcall d "call-process-region"
               (lambda (start end program &optional delete destination display &rest args)
                 (Reflect/apply el-call-process-region nil (js-call (js-array session start end program (el-opt delete) (el-opt destination) (el-opt display)) :concat args))))
      (funcall d "shell-command-to-string"
               (lambda (cmd)
                 (let ((buf (el-generate-new-buffer session " *shell-cmd*")))
                   (try
                     (progn
                       (el-call-process session (or (el-call session (el-intern "getenv") (js-array "SHELL")) "/bin/sh")
                                        nil buf nil "-c" cmd)
                       (get buf :text))
                     (finally (el-kill-buffer session buf))))))
      (funcall d "make-process" (lambda (&rest args) (el-make-process session args)))
      (funcall d "make-pipe-process" (lambda (&rest args) (el-make-pipe-process session args)))
      (funcall d "start-process"
               (lambda (name buffer program &rest program-args)
                 (if (nil? program)
                     (el-make-pipe-process session (js-array (el-intern ":name") name (el-intern ":buffer") buffer))
                   (el-make-process session
                                    (js-array (el-intern ":name") name
                                              (el-intern ":buffer") buffer
                                              (el-intern ":command") (el-cons program (el-list-from program-args)))))))
      (funcall d "processp" (lambda (x) (el-bool (= (el-kind x) "process"))))
      (funcall d "process-live-p"
               (lambda (p)
                 (el-drain-io-events session)
                 (el-bool (and (= (el-kind p) "process") (get p :live)))))
      (funcall d "process-status"
               (lambda (p)
                 (el-drain-io-events session)
                 (if (= (el-kind p) "process") (get p :status) nil)))
      (funcall d "process-exit-status"
               (lambda (p)
                 (el-drain-io-events session)
                 (if (= (el-kind p) "process") (or (get p :exitStatus) 0) 0)))
      (funcall d "process-id" (lambda (p) (if (= (el-kind p) "process") (get p :pid) nil)))
      (funcall d "process-name" (lambda (p) (if (= (el-kind p) "process") (get p :name) nil)))
      (funcall d "process-buffer" (lambda (p) (if (= (el-kind p) "process") (get p :buffer) nil)))
      (funcall d "set-process-buffer" (lambda (p b) (when (= (el-kind p) "process") (put p :buffer b)) b))
      (funcall d "get-buffer-process"
               (lambda (b)
                 (let* ((buf (if (el-string? b) (el-call session (el-intern "get-buffer") (js-array b)) b))
                        (procs (get session :processes))
                        (found (js-call procs :find (lambda (p) (and (get p :live) (eq (get p :buffer) buf))))))
                   (if (undefined? found) nil found))))
      (funcall d "process-filter" (lambda (p) (if (= (el-kind p) "process") (get p :filter) nil)))
      (funcall d "set-process-filter" (lambda (p f) (when (= (el-kind p) "process") (put p :filter f)) f))
      (funcall d "process-sentinel" (lambda (p) (if (= (el-kind p) "process") (get p :sentinel) nil)))
      (funcall d "set-process-sentinel" (lambda (p s) (when (= (el-kind p) "process") (put p :sentinel s)) s))
      (funcall d "process-put" (lambda (p prop val) (when (= (el-kind p) "process") (js-call (get p :plist) :set prop val)) val))
      (funcall d "process-get" (lambda (p prop) (if (and (= (el-kind p) "process") (js-call (get p :plist) :has prop)) (js-call (get p :plist) :get prop) nil)))
      (funcall d "process-plist"
               (lambda (p)
                 (let ((items (js-array)))
                   (when (= (el-kind p) "process")
                     (js-call (get p :plist) :forEach (lambda (v k) (js-call items :push k) (js-call items :push v))))
                   (el-list-from items))))
      (funcall d "set-process-plist"
               (lambda (p plist)
                 (when (= (el-kind p) "process")
                   (js-call (get p :plist) :clear)
                   (let ((arr (el-list-to-array plist)) (i 0))
                     (while (< (1+ i) (js-length arr))
                       (js-call (get p :plist) :set (aref arr i) (aref arr (1+ i)))
                       (setq i (+ i 2)))))
                 plist))
      (funcall d "process-list" (lambda () (el-drain-io-events session) (el-list-from (js-call (get session :processes) :filter (lambda (p) (get p :live))))))
      (funcall d "set-process-query-on-exit-flag" (lambda (p flag) (when (= (el-kind p) "process") (put p :noquery (nil? flag))) flag))
      (funcall d "set-process-coding-system" (lambda (&rest ignored) nil))
      (funcall d "process-send-string"
               (lambda (p str-val)
                 (when (and (= (el-kind p) "process") (get p :live) (not (nil? io-hub)))
                   (js-call (get io-hub :worker) :postMessage
                            (js-object :type "stdin" :id (get p :id) :bytes (el-string-bytes-array str-val))))
                 nil))
      (funcall d "process-send-region"
               (lambda (p start end)
                 (let ((text (el-buffer-substring (el-current-buffer session) start end)))
                   (el-call session (el-intern "process-send-string") (js-array p text)))))
      (funcall d "process-send-eof"
               (lambda (&optional p)
                 (when (and (= (el-kind p) "process") (get p :live) (not (nil? io-hub)))
                   (js-call (get io-hub :worker) :postMessage (js-object :type "eof" :id (get p :id))))
                 p))
      (funcall d "delete-process"
               (lambda (&optional p)
                 (when (= (el-kind p) "process")
                   (when (and (get p :live) (not (nil? io-hub)) (> (get p :id) 0))
                     (js-call (get io-hub :worker) :postMessage (js-object :type "kill" :id (get p :id) :sig "SIGKILL"))
                     (js-call (get io-hub :procs) :delete (get p :id))
                     (js-call (get io-hub :httpReqs) :delete (get p :id)))
                   (put p :live false)
                   (put p :status (el-intern "exit")))
                 nil))
      (funcall d "kill-process"
               (lambda (&optional p current-group)
                 (when (and (= (el-kind p) "process") (get p :live) (not (nil? io-hub)) (> (get p :id) 0))
                   (js-call (get io-hub :worker) :postMessage (js-object :type "kill" :id (get p :id) :sig "SIGKILL")))
                 p))
      (funcall d "interrupt-process"
               (lambda (&optional p current-group)
                 (when (and (= (el-kind p) "process") (get p :live) (not (nil? io-hub)) (> (get p :id) 0))
                   (js-call (get io-hub :worker) :postMessage (js-object :type "kill" :id (get p :id) :sig "SIGINT")))
                 p))
      (funcall d "accept-process-output"
               (lambda (&optional proc seconds millisec just-this-one)
                 (el-accept-process-output session (el-opt proc) (el-opt seconds) (el-opt millisec) (el-opt just-this-one))))
      (funcall d "sleep-for" (lambda (seconds &optional millisec) (el-sleep-for session seconds (el-opt millisec))))
      (funcall d "sit-for" (lambda (seconds &optional nodisp) (el-sleep-for session seconds nil) t))
      (funcall d "kill-emacs"
               (lambda (&optional exit-data do-not-run-hooks)
                 (unless (and (not (nullish? do-not-run-hooks)) (not (nil? do-not-run-hooks)))
                   (try (el-call session (el-intern "run-hooks") (js-array (el-intern "kill-emacs-hook"))) (catch e nil)))
                 (let ((code (if (el-integer? exit-data) exit-data 0)))
                   (throw (js-object :eliscriptBatchExit t :code code :conditionSymbol "error" :data (js-array "kill-emacs" code))))))
      ;; ERT functions
      (funcall d "ert-fail"
               (lambda (data)
                 (throw (el-make-signal "ert-test-failed" (if (el-string? data) (js-array data) (el-seq-items data))))))
      (funcall d "ert-skip"
               (lambda (data)
                 (throw (el-make-signal "ert-test-skipped" (if (el-string? data) (js-array data) (el-seq-items data))))))
      (funcall d "ert-get-test"
               (lambda (sym)
                 (let ((test (js-call (get session :ertTests) :get sym)))
                   (if (undefined? test) (el-signal "error" (str "No test named " (el-symbol-name sym))) test))))
      (funcall d "ert-test-boundp" (lambda (sym) (el-bool (js-call (get session :ertTests) :has sym))))
      (funcall d "ert-select-tests" (lambda (selector universe) (el-list-from (el-ert-select-tests session selector))))
      (funcall d "ert-test-name" (lambda (test) (get test :name)))
      (funcall d "ert-test-most-recent-result" (lambda (test) (get test :mostRecentResult)))
      (funcall d "ert-test-passed-p" (lambda (res) (el-bool (and (not (nil? res)) (= (get res :status) "passed")))))
      (funcall d "ert-test-failed-p" (lambda (res) (el-bool (and (not (nil? res)) (= (get res :status) "failed")))))
      (funcall d "ert-test-skipped-p" (lambda (res) (el-bool (and (not (nil? res)) (= (get res :status) "skipped")))))
      (funcall d "ert-test-result-type-p"
               (lambda (res type)
                 (let ((tname (el-symbol-name type)))
                   (el-bool (and (not (nil? res))
                                 (or (and (= tname ":passed") (= (get res :status) "passed"))
                                     (and (= tname ":failed") (= (get res :status) "failed"))
                                     (and (= tname ":skipped") (= (get res :status) "skipped"))))))))
      (funcall d "ert-run-test" (lambda (test) (el-ert-run-single-test session test)))
      (funcall d "ert-run-tests-batch" (lambda (&optional selector) (el-ert-run-tests-batch session (el-opt selector))))
      (funcall d "ert-run-tests-batch-and-exit"
               (lambda (&optional selector)
                 (let ((stats (el-ert-run-tests-batch session (el-opt selector))))
                   (el-call session (el-intern "kill-emacs") (js-array (if (> (get stats :failed) 0) 1 0))))))
      (funcall d "ert--stats-total" (lambda (s) (get s :total)))
      (funcall d "ert--stats-completed-expected" (lambda (s) (get s :passed)))
      (funcall d "ert--stats-completed-unexpected" (lambda (s) (get s :failed)))
      (funcall d "ert--stats-skipped" (lambda (s) (get s :skipped)))
      ;; seq.el / cl-lib generics
      (funcall d "seq-length" (lambda (s) (el-length s)))
      (funcall d "seq-elt" (lambda (s n) (aref (el-seq-items s) n)))
      (funcall d "seq-first" (lambda (s) (el-opt (aref (el-seq-items s) 0))))
      (funcall d "seq-rest" (lambda (s) (el-seq-like s (js-call (el-seq-items s) :slice 1))))
      (funcall d "seq-empty-p" (lambda (s) (el-bool (= (js-length (el-seq-items s)) 0))))
      (funcall d "seq-map" (lambda (fn s) (el-list-from (js-call (el-seq-items s) :map (lambda (x) (el-call session fn (js-array x)))))))
      (funcall d "seq-mapn" (lambda (fn &rest seqs) (el-call session (el-intern "cl-mapcar") (js-call (js-array fn) :concat seqs))))
      (funcall d "seq-filter" (lambda (fn s) (el-list-from (js-call (el-seq-items s) :filter (lambda (x) (not (nil? (el-call session fn (js-array x)))))))))
      (funcall d "seq-remove" (lambda (fn s) (el-list-from (js-call (el-seq-items s) :filter (lambda (x) (nil? (el-call session fn (js-array x))))))))
      (funcall d "seq-reduce" (lambda (fn s init) (js-call (el-seq-items s) :reduce (lambda (acc x) (el-call session fn (js-array acc x))) init)))
      (funcall d "seq-some" (lambda (fn s)
                              (let ((found nil))
                                (js-call (el-seq-items s) :some (lambda (x) (setq found (el-call session fn (js-array x))) (not (nil? found))))
                                found)))
      (funcall d "seq-every-p" (lambda (fn s) (el-bool (js-call (el-seq-items s) :every (lambda (x) (not (nil? (el-call session fn (js-array x)))))))))
      (funcall d "seq-find" (lambda (fn s &optional default)
                              (let ((found (js-call (el-seq-items s) :find (lambda (x) (not (nil? (el-call session fn (js-array x))))))))
                                (if (undefined? found) (el-opt default) found))))
      (funcall d "seq-count" (lambda (fn s) (js-length (js-call (el-seq-items s) :filter (lambda (x) (not (nil? (el-call session fn (js-array x)))))))))
      (funcall d "seq-uniq" (lambda (s &optional testfn)
                              (let ((kept (js-array)) (test (el-test-function session (el-opt testfn) el-equal-test)))
                                (js-call (el-seq-items s) :forEach (lambda (x) (unless (js-call kept :some (lambda (y) (funcall test x y))) (js-call kept :push x))))
                                (el-list-from kept))))
      (funcall d "seq-take" (lambda (s n) (el-seq-like s (js-call (el-seq-items s) :slice 0 (Math/max 0 n)))))
      (funcall d "seq-drop" (lambda (s n) (el-seq-like s (js-call (el-seq-items s) :slice (Math/max 0 n)))))
      (funcall d "seq-take-while" (lambda (fn s)
                                    (let ((items (el-seq-items s)) (i 0))
                                      (while (and (< i (js-length items)) (not (nil? (el-call session fn (js-array (aref items i)))))) (setq i (1+ i)))
                                      (el-seq-like s (js-call items :slice 0 i)))))
      (funcall d "seq-drop-while" (lambda (fn s)
                                    (let ((items (el-seq-items s)) (i 0))
                                      (while (and (< i (js-length items)) (not (nil? (el-call session fn (js-array (aref items i)))))) (setq i (1+ i)))
                                      (el-seq-like s (js-call items :slice i)))))
      (funcall d "seq-position" (lambda (s x &optional testfn)
                                  (let ((i (js-call (el-seq-items s) :findIndex (lambda (y) (funcall (el-test-function session (el-opt testfn) el-equal-test) x y)))))
                                    (if (< i 0) nil i))))
      (funcall d "seq-contains-p" (lambda (s x &optional testfn)
                                    (el-bool (js-call (el-seq-items s) :some (lambda (y) (funcall (el-test-function session (el-opt testfn) el-equal-test) x y))))))
      (funcall d "seq-reverse" (lambda (s) (el-reverse s)))
      (funcall d "seq-concatenate" (lambda (type &rest seqs)
                                     (let ((items (Reflect/apply (get (js-array) :concat) (js-array) (js-call seqs :map (lambda (x) (el-seq-items x))))))
                                       (cond ((el-sym-is type "vector") (el-vector items)) ((el-sym-is type "string") (el-string-from-codes items)) (t (el-list-from items))))))
      (funcall d "seq-into" (lambda (s type)
                              (let ((items (el-seq-items s)) (name (el-symbol-name type)))
                                (cond ((= name "vector") (el-vector items))
                                      ((= name "string") (el-string-from-codes items))
                                      ((= name "list") (el-list-from items))
                                      (t (el-seq-into-extension session items name))))))
      (funcall d "seq-subseq" (lambda (s start &optional end) (el-seq-like s (js-call (el-seq-items s) :slice start (el-opt end)))))
      (funcall d "cl-subseq" (lambda (s start &optional end) (el-seq-like s (js-call (el-seq-items s) :slice start (if (nullish? end) undefined end)))))
      (funcall d "cl-every" (lambda (fn &rest seqs) (el-bool (js-call (el-seq-items (aref seqs 0)) :every (lambda (x) (not (nil? (el-call session fn (js-array x)))))))))
      (funcall d "cl-some" (lambda (fn s)
                             (let ((found nil))
                               (js-call (el-seq-items s) :some (lambda (x) (setq found (el-call session fn (js-array x))) (not (nil? found))))
                               found)))
      (funcall d "cl-notany" (lambda (fn s) (el-bool (not (js-call (el-seq-items s) :some (lambda (x) (not (nil? (el-call session fn (js-array x))))))))))
      (funcall d "cl-reduce" (lambda (fn s &rest keys)
                               (let* ((items (el-seq-items s)) (i (js-call keys :findIndex (lambda (k) (el-sym-is k ":initial-value")))))
                                 (if (>= i 0)
                                     (js-call items :reduce (lambda (acc x) (el-call session fn (js-array acc x))) (aref keys (1+ i)))
                                   (if (= (js-length items) 0) (el-call session fn (js-array))
                                     (js-call items :reduce (lambda (acc x) (el-call session fn (js-array acc x)))))))))
      (funcall d "cl-remove-if" (lambda (fn s &rest ignored) (el-seq-like s (js-call (el-seq-items s) :filter (lambda (x) (nil? (el-call session fn (js-array x))))))))
      (funcall d "cl-remove-if-not" (lambda (fn s &rest ignored) (el-seq-like s (js-call (el-seq-items s) :filter (lambda (x) (not (nil? (el-call session fn (js-array x)))))))))
      (el-def-alias session "cl-delete-if" "cl-remove-if")
      (el-def-alias session "cl-delete-if-not" "cl-remove-if-not")
      (funcall d "cl-count-if" (lambda (fn s) (js-length (js-call (el-seq-items s) :filter (lambda (x) (not (nil? (el-call session fn (js-array x)))))))))
      (funcall d "cl-count" (lambda (x s &rest keys)
                              (let ((test (el-key-test session keys el-eql-test))
                                    (key-of (el-key-extractor session keys)))
                                (js-length (js-call (el-seq-items s) :filter (lambda (y) (funcall test x (funcall key-of y))))))))
      (funcall d "cl-find" (lambda (x s &rest keys) (el-cl-find session x s keys false)))
      (funcall d "cl-position" (lambda (x s &rest keys) (el-cl-find session x s keys t)))
      (funcall d "cl-find-if" (lambda (fn s &rest keys)
                                (let ((key-of (el-key-extractor session keys)))
                                  (el-opt (js-call (el-seq-items s) :find (lambda (x) (not (nil? (el-call session fn (js-array (funcall key-of x)))))))))))
      (funcall d "cl-position-if" (lambda (fn s &rest keys)
                                    (let* ((key-of (el-key-extractor session keys))
                                           (i (js-call (el-seq-items s) :findIndex (lambda (x) (not (nil? (el-call session fn (js-array (funcall key-of x)))))))))
                                      (if (< i 0) nil i))))
      (funcall d "cl-member" (lambda (x l &rest keys)
                               (let ((test (el-key-test session keys el-eql-test))
                                     (key-of (el-key-extractor session keys)))
                                 (el-member-with x l (lambda (item elt) (funcall test item (funcall key-of elt)))))))
      (funcall d "cl-remove" (lambda (x s &rest keys)
                               (let ((test (el-key-test session keys el-eql-test))
                                     (key-of (el-key-extractor session keys)))
                                 (el-seq-like s (js-call (el-seq-items s) :filter (lambda (y) (not (funcall test x (funcall key-of y)))))))))
      (el-def-alias session "cl-delete" "cl-remove")
      (funcall d "cl-remove-duplicates"
               (lambda (s &rest keys)
                 (let ((kept (js-array))
                       (test (el-key-test session keys el-eql-test))
                       (key-of (el-key-extractor session keys)))
                   (js-call (el-seq-items s) :forEach
                            (lambda (x)
                              (let ((kx (funcall key-of x)))
                                (unless (js-call kept :some (lambda (y) (funcall test kx (funcall key-of y))))
                                  (js-call kept :push x)))))
                   (el-seq-like s kept))))
      (el-def-alias session "cl-delete-duplicates" "cl-remove-duplicates")
      (funcall d "cl-adjoin"
               (lambda (x l &rest keys)
                 (let* ((test (el-key-test session keys el-eql-test))
                        (key-of (el-key-extractor session keys))
                        (kx (funcall key-of x))
                        (exists (js-call (el-list-to-array l) :some (lambda (y) (funcall test kx (funcall key-of y))))))
                   (if exists l (el-cons x l)))))
      (funcall d "cl-union"
               (lambda (l1 l2 &rest keys)
                 (let ((test (el-key-test session keys el-eql-test))
                       (key-of (el-key-extractor session keys))
                       (out (js-call (el-list-to-array l1) :slice)))
                   (js-call (el-list-to-array l2) :forEach
                            (lambda (y)
                              (let ((ky (funcall key-of y)))
                                (unless (js-call out :some (lambda (x) (funcall test (funcall key-of x) ky)))
                                  (js-call out :push y)))))
                   (el-list-from out))))
      (funcall d "cl-intersection"
               (lambda (l1 l2 &rest keys)
                 (let ((test (el-key-test session keys el-eql-test))
                       (key-of (el-key-extractor session keys))
                       (a2 (el-list-to-array l2)))
                   (el-list-from
                    (js-call (el-list-to-array l1) :filter
                             (lambda (x)
                               (let ((kx (funcall key-of x)))
                                 (js-call a2 :some (lambda (y) (funcall test kx (funcall key-of y)))))))))))
      (funcall d "cl-set-difference"
               (lambda (l1 l2 &rest keys)
                 (let ((test (el-key-test session keys el-eql-test))
                       (key-of (el-key-extractor session keys))
                       (a2 (el-list-to-array l2)))
                   (el-list-from
                    (js-call (el-list-to-array l1) :filter
                             (lambda (x)
                               (let ((kx (funcall key-of x)))
                                 (not (js-call a2 :some (lambda (y) (funcall test kx (funcall key-of y))))))))))))
      (funcall d "cl-set-exclusive-or"
               (lambda (l1 l2 &rest keys)
                 (let ((test (el-key-test session keys el-eql-test))
                       (key-of (el-key-extractor session keys))
                       (a1 (el-list-to-array l1))
                       (a2 (el-list-to-array l2)))
                   (el-list-from
                    (js-call (js-call a1 :filter
                                      (lambda (x)
                                        (let ((kx (funcall key-of x)))
                                          (not (js-call a2 :some (lambda (y) (funcall test kx (funcall key-of y))))))))
                             :concat
                             (js-call a2 :filter
                                      (lambda (y)
                                        (let ((ky (funcall key-of y)))
                                          (not (js-call a1 :some (lambda (x) (funcall test (funcall key-of x) ky))))))))))))
      (funcall d "cl-subsetp"
               (lambda (l1 l2 &rest keys)
                 (let ((test (el-key-test session keys el-eql-test))
                       (key-of (el-key-extractor session keys))
                       (a2 (el-list-to-array l2)))
                   (el-bool
                    (js-call (el-list-to-array l1) :every
                             (lambda (x)
                               (let ((kx (funcall key-of x)))
                                 (js-call a2 :some (lambda (y) (funcall test kx (funcall key-of y)))))))))))
      (funcall d "cl-sort"
               (lambda (s pred &rest keys)
                 (let* ((key-of (el-key-extractor session keys))
                        (cmp (lambda (a b) (el-call session pred (js-array (funcall key-of a) (funcall key-of b)))))
                        (sorted (el-sort-items (el-seq-items s) cmp session)))
                   (if (el-vector? s) (progn (put s :items sorted) s) (el-seq-like s sorted)))))
      (funcall d "cl-incf-noop" (lambda () nil))
      (funcall d "string-version-lessp" (lambda (a b) (el-bool (< (js-call a :localeCompare b undefined (js-object :numeric t)) 0))))
      (funcall d "max-char" (lambda (&rest ignored) 4194303))
      (funcall d "current-time-zone"
               (lambda (&optional time zone)
                 (let* ((ms (el-time-to-ms time))
                        (dt (new globalThis.Date ms))
                        (utc (el-utc-zone? zone))
                        (off (if utc 0 (* (- 0 (js-call dt :getTimezoneOffset)) 60))))
                   (el-list off (if utc "UTC" "LOCAL")))))
      (funcall d "set-time-zone-rule" (lambda (tz) nil))
      (funcall d "set-language-environment" (lambda (lang &rest ignored) nil))
      (funcall d "ert-fail" (lambda (data) (throw (el-make-signal "ert-test-failed" (js-array data)))))
      (funcall d "ert-get-test" (lambda (sym) (or (js-call (get session :ertTests) :get sym) nil)))
      (funcall d "ert-test-most-recent-result" (lambda (test) (if (= (el-kind test) "ert-test") (get test :mostRecentResult) nil)))
      (funcall d "ert-test-passed-p" (lambda (res) (el-bool (and (= (el-kind res) "ert-test-result") (= (get res :status) "passed")))))
      (funcall d "ert-stats-total" (lambda (s) (if (= (el-kind s) "ert-stats") (get s :total) 0)))
      (funcall d "ert-stats-completed-expected" (lambda (s) (if (= (el-kind s) "ert-stats") (get s :passed) 0)))
      (funcall d "ert-stats-completed-unexpected" (lambda (s) (if (= (el-kind s) "ert-stats") (get s :failed) 0)))
      (funcall d "ert-stats-skipped" (lambda (s) (if (= (el-kind s) "ert-stats") (get s :skipped) 0)))
      (funcall d "ert--stats-aborted-p" (lambda (s) nil))
      (funcall d "ert--stats-failed-expected" (lambda (s) 0))
      (funcall d "ert--stats-failed-unexpected" (lambda (s) (if (= (el-kind s) "ert-stats") (get s :failed) 0)))
      (funcall d "ert--stats-passed-unexpected" (lambda (s) 0))
      (funcall d "ert--stats-skipped" (lambda (s) (if (= (el-kind s) "ert-stats") (get s :skipped) 0)))
      (funcall d "lock-file" (lambda (file) nil))
      (funcall d "unlock-file" (lambda (file) nil))
      (funcall d "file-locked-p" (lambda (file) nil))
      (funcall d "cl-struct-slot-value"
               (lambda (struct-type slot-name inst)
                 (let* ((stype (el-symbol-name struct-type))
                        (sname (el-symbol-name slot-name))
                        (info (js-call (get session :structs) :get stype))
                        (slots (if (undefined? info) (js-array) (get info :slots)))
                        (idx (js-call slots :findIndex (lambda (s) (= (el-symbol-name (get s :name)) sname)))))
                   (el-check-struct session inst stype)
                   (when (< idx 0) (el-signal "error" (str "Unknown slot " sname)))
                   (aref (get inst :items) (1+ idx)))))
      (letfn ((eqp (a b depth)
                (cond
                  ((> depth 200) false)
                  ((eq a b) t)
                  ((and (el-number? a) (el-number? b)) (= (el-num a) (el-num b)))
                  ((and (el-string? a) (el-string? b)) (= (js-call a :toLowerCase) (js-call b :toLowerCase)))
                  ((and (el-cons? a) (el-cons? b))
                    (and (eqp (get a :car) (get b :car) (1+ depth))
                         (eqp (get a :cdr) (get b :cdr) (1+ depth))))
                  ((and (or (el-vector? a) (el-record? a)) (or (el-vector? b) (el-record? b))
                        (= (get a :kind) (get b :kind)))
                    (let ((ia (get a :items)) (ib (get b :items)))
                      (and (= (js-length ia) (js-length ib))
                           (js-call ia :every (lambda (x idx) (eqp x (aref ib idx) (1+ depth)))))))
                  ((and (el-hash-table? a) (el-hash-table? b))
                    (let ((ea (Array/from (js-call (get a :entries) :values)))
                          (eb (Array/from (js-call (get b :entries) :values))))
                      (and (= (js-length ea) (js-length eb))
                           (js-call ea :every
                                    (lambda (pa)
                                      (js-call eb :some
                                               (lambda (pb)
                                                 (and (eqp (aref pa 0) (aref pb 0) (1+ depth))
                                                      (eqp (aref pa 1) (aref pb 1) (1+ depth))))))))))
                  (t (el-equal-p a b depth)))))
        (funcall d "cl-equalp" (lambda (a b) (el-bool (eqp a b 0))))
        (el-def-alias session "equalp" "cl-equalp"))
      (funcall d "locate-dominating-file"
               (lambda (file name)
                 (let* ((fs (el-fs))
                        (path-mod (el-path))
                        (expanded (el-expand-file-name session file nil))
                        (is-dir (and (not (nullish? fs))
                                     (try (js-call (js-call fs :statSync expanded) :isDirectory) (catch e false))))
                        (cur (if is-dir
                                 (js-call expanded :replace (new globalThis.RegExp "/+$") "")
                               (if (not (nullish? path-mod))
                                   (js-call path-mod :dirname (js-call expanded :replace (new globalThis.RegExp "/+$") ""))
                                 "/")))
                        (found nil)
                        (done false))
                   (when (= cur "") (setq cur "/"))
                   (while (not done)
                     (let* ((dir-slash (if (js-call cur :endsWith "/") cur (str cur "/")))
                            (ok (if (el-string? name)
                                    (and (not (nullish? fs))
                                         (try (js-call fs :existsSync (el-expand-file-name session name dir-slash)) (catch e false)))
                                  (not (nil? (el-call session name (js-array dir-slash)))))))
                       (if ok
                           (progn (setq found dir-slash) (setq done t))
                         (let ((parent (if (not (nullish? path-mod)) (js-call path-mod :dirname cur) "/")))
                           (if (or (= parent cur) (= cur "/"))
                               (setq done t)
                             (setq cur parent))))))
                   found)))
      (funcall d "file-in-directory-p"
               (lambda (file dir)
                 (let* ((tf (let ((s (el-file-truename session file)))
                              (if (js-call s :endsWith "/") s (str s "/"))))
                        (td (let ((s (el-file-truename session dir)))
                              (if (js-call s :endsWith "/") s (str s "/")))))
                   (el-bool (js-call tf :startsWith td)))))
      nil))

  (defun el-key-test (session keys fallback)
    (let ((i (js-call keys :findIndex (lambda (k) (el-sym-is k ":test")))))
      (if (< i 0) fallback (el-test-function session (aref keys (1+ i)) fallback))))

  (defun el-key-extractor (session keys)
    (let* ((ki (js-call keys :findIndex (lambda (k) (el-sym-is k ":key"))))
           (key-fn (if (< ki 0) nil (aref keys (1+ ki)))))
      (if (nil? key-fn)
          (lambda (item) item)
        (lambda (item) (el-call session key-fn (js-array item))))))

  (defun el-cl-find (session x s keys want-position)
    (let* ((test (el-key-test session keys el-eql-test))
           (ki (js-call keys :findIndex (lambda (k) (el-sym-is k ":key"))))
           (key-fn (if (< ki 0) nil (aref keys (1+ ki))))
           (items (el-seq-items s))
           (index (js-call items :findIndex
                           (lambda (item) (funcall test x (if (nil? key-fn) item (el-call session key-fn (js-array item))))))))
      (cond ((< index 0) nil) (want-position index) (t (aref items index)))))

  ;; ------------------------------------------------------------------
  ;; eliscript-data: persistent collections and value protocol
  ;; ------------------------------------------------------------------

  (defconst JS_FALSE (Object/freeze (js-object :kind "js-sentinel" :sentinel "false")))
  (defconst JS_NULL (Object/freeze (js-object :kind "js-sentinel" :sentinel "null")))
  (defconst JS_UNDEFINED (Object/freeze (js-object :kind "js-sentinel" :sentinel "undefined")))
  (defconst OPTION_NONE (Object/freeze (js-object :kind "option" :some false :value nil)))

  (defconst sequence-kinds (js-array "persistent-list" "persistent-vector" "persistent-queue" "persistent-set" "persistent-sorted-set"))
  (defconst map-kinds (js-array "persistent-map" "persistent-sorted-map" "persistent-record"))

  (defun el-persistent? (x)
    (and (not (nullish? x)) (= (js* "typeof x") "object")
         (or (js-call sequence-kinds :includes (get x :kind)) (js-call map-kinds :includes (get x :kind))
             (= (get x :kind) "lazy-seq"))))

  (defun el-value-equal (a b)
    (cond
      ((eq a b) t)
      ((or (nil? a) (nil? b)) false)
      ((and (el-number? a) (el-number? b)) (= (el-num a) (el-num b)))
      ((or (not (= (js* "typeof a") "object")) (not (= (js* "typeof b") "object"))) (and (= a b) t))
      (t
        (let ((ka (get a :kind)) (kb (get b :kind)))
          (cond
            ((and (js-call (js-array "persistent-list" "persistent-vector" "persistent-queue") :includes ka)
                  (js-call (js-array "persistent-list" "persistent-vector" "persistent-queue") :includes kb))
              (and (= (js-length (get a :items)) (js-length (get b :items)))
                   (js-call (get a :items) :every (lambda (x i) (el-value-equal x (aref (get b :items) i))))))
            ((and (js-call (js-array "persistent-map" "persistent-sorted-map") :includes ka)
                  (js-call (js-array "persistent-map" "persistent-sorted-map") :includes kb))
              (and (= (js-length (get a :entries)) (js-length (get b :entries)))
                   (js-call (get a :entries) :every
                            (lambda (entry)
                              (let ((found (js-call (get b :entries) :find (lambda (other) (el-value-equal (aref entry 0) (aref other 0))))))
                                (and (not (undefined? found)) (el-value-equal (aref entry 1) (aref found 1))))))))
            ((and (js-call (js-array "persistent-set" "persistent-sorted-set") :includes ka)
                  (js-call (js-array "persistent-set" "persistent-sorted-set") :includes kb))
              (and (= (js-length (get a :items)) (js-length (get b :items)))
                   (js-call (get a :items) :every (lambda (x) (js-call (get b :items) :some (lambda (y) (el-value-equal x y)))))))
            ((and (= ka "persistent-record") (= kb "persistent-record"))
              (and (= (get a :typeName) (get b :typeName)) (= (js-length (get a :entries)) (js-length (get b :entries)))
                   (js-call (get a :entries) :every
                            (lambda (entry)
                              (let ((found (js-call (get b :entries) :find (lambda (other) (= (aref other 0) (aref entry 0))))))
                                (and (not (undefined? found)) (el-value-equal (aref entry 1) (aref found 1))))))))
            ((and (= ka kb) (or (= ka "option") (= ka "result")))
              (and (= (get a :some) (get b :some)) (= (get a :ok) (get b :ok)) (el-value-equal (get a :value) (get b :value))))
            (t (el-equal-p a b 0)))))))

  (defun el-value-hash-key (x) (str "v:" (el-prin1-string x t)))

  (defun el-value-compare (a b)
    (cond
      ((el-value-equal a b) 0)
      ((nil? a) -1)
      ((nil? b) 1)
      ((and (el-number? a) (el-number? b)) (if (< (el-num a) (el-num b)) -1 1))
      ((and (el-string? a) (el-string? b)) (if (< a b) -1 1))
      (t (let ((sa (if (el-symobj? a) (get a :name) (el-prin1-string a t)))
               (sb (if (el-symobj? b) (get b :name) (el-prin1-string b t))))
           (if (< sa sb) -1 1)))))

  (defun el-assoc-entries (entries key value)
    (let* ((found false)
           (next (js-call entries :map (lambda (entry)
                                        (if (and (not found) (el-value-equal (aref entry 0) key))
                                            (progn (setq found t) (js-array key value))
                                          entry)))))
      (unless found (js-call next :push (js-array key value)))
      next))

  (defun el-make-pcoll (kind items) (js-object :kind kind :items (js-call items :slice) :meta nil))
  (defun el-make-pmap (kvs)
    (let ((entries (js-array)) (i 0))
      (while (< i (js-length kvs))
        (setq entries (el-assoc-entries entries (aref kvs i) (el-opt (aref kvs (1+ i)))))
        (setq i (+ i 2)))
      (js-object :kind "persistent-map" :entries entries :meta nil)))
  (defun el-make-pset (items)
    (let ((unique (js-array)))
      (js-call items :forEach (lambda (x) (unless (js-call unique :some (lambda (y) (el-value-equal x y))) (js-call unique :push x))))
      (js-object :kind "persistent-set" :items unique :meta nil)))

  (defun el-comparator (session fn)
    (lambda (a b)
      (let ((r (if (nullish? fn) (el-value-compare a b) (el-call session fn (js-array a b)))))
        (cond ((= (el-typeof r) "number") r)
              ((eq r t) -1)
              ((el-value-equal a b) 0)
              (t 1)))))

  (defun el-make-sorted-map (session args)
    (let* ((has-cmp (and (> (js-length args) 0) (= (% (1- (js-length args)) 2) 0)
                         (or (el-function? (aref args 0)) (el-symobj? (aref args 0)))
                         (not (el-keyword? (aref args 0)))))
           (cmp (if has-cmp (aref args 0) nil))
           (kvs (if has-cmp (js-call args :slice 1) args))
           (entries (get (el-make-pmap kvs) :entries))
           (order (el-comparator session cmp)))
      (js-call entries :sort (lambda (x y) (funcall order (aref x 0) (aref y 0))))
      (js-object :kind "persistent-sorted-map" :comparator cmp :entries entries :meta nil)))

  (defun el-make-sorted-set (session args)
    (let* ((has-cmp (and (> (js-length args) 0) (or (el-function? (aref args 0))
                                                     (and (el-symobj? (aref args 0)) (not (el-keyword? (aref args 0)))))))
           (cmp (if has-cmp (aref args 0) nil))
           (items (get (el-make-pset (if has-cmp (js-call args :slice 1) args)) :items))
           (order (el-comparator session cmp)))
      (js-call items :sort (lambda (x y) (funcall order x y)))
      (js-object :kind "persistent-sorted-set" :comparator cmp :items items :meta nil)))

  (defun el-lazy-items (seq)
    (let ((out (js-array)) (cursor seq) (guard 0))
      (while (and (not (nil? cursor)) (< guard 10000000))
        (setq guard (1+ guard))
        (cond
          ((= (el-kind cursor) "lazy-seq") (setq cursor (funcall (get cursor :step))))
          ((el-cons? cursor) (js-call out :push (get cursor :car)) (setq cursor (get cursor :cdr)))
          (t (setq cursor nil))))
      out))

  (defun el-persistent-items (coll)
    (let ((kind (get coll :kind)))
      (cond
        ((js-call sequence-kinds :includes kind) (js-call (get coll :items) :slice))
        ((js-call map-kinds :includes kind) (js-call (get coll :entries) :map (lambda (e) (el-list (aref e 0) (aref e 1)))))
        ((= kind "lazy-seq") (el-lazy-items coll))
        (t (el-signal "wrong-type-argument" (el-intern "sequencep") coll)))))

  (defun el-value-count (coll)
    (cond
      ((nil? coll) 0)
      ((el-string? coll) (el-string-length coll))
      ((el-hash-table? coll) (get (get coll :entries) :size))
      ((js-call map-kinds :includes (get coll :kind)) (js-length (get coll :entries)))
      (t (js-length (el-seq-items coll)))))

  (defun el-record-field-name (key) (if (el-symobj? key) (let ((n (get key :name))) (if (js-call n :startsWith ":") (js-call n :slice 1) n)) (str key)))

  (defun el-value-contains (coll key)
    (cond
      ((nil? coll) false)
      ((js-call (js-array "persistent-map" "persistent-sorted-map") :includes (get coll :kind))
        (js-call (get coll :entries) :some (lambda (e) (el-value-equal (aref e 0) key))))
      ((= (get coll :kind) "persistent-record")
        (js-call (get coll :entries) :some (lambda (e) (= (aref e 0) (el-record-field-name key)))))
      ((el-hash-table? coll) (js-call (get coll :entries) :has (el-hash-key coll key)))
      (t false)))

  (defun el-value-get (coll key not-found)
    (cond
      ((nil? coll) not-found)
      ((js-call (js-array "persistent-map" "persistent-sorted-map") :includes (get coll :kind))
        (let ((cell (js-call (get coll :entries) :find (lambda (e) (el-value-equal (aref e 0) key)))))
          (if (undefined? cell) not-found (aref cell 1))))
      ((= (get coll :kind) "persistent-record")
        (let ((cell (js-call (get coll :entries) :find (lambda (e) (= (aref e 0) (el-record-field-name key))))))
          (if (undefined? cell) not-found (aref cell 1))))
      ((el-hash-table? coll) (el-gethash key coll not-found))
      ((or (= (get coll :kind) "persistent-vector") (el-vector? coll))
        (if (and (el-integer? key) (>= key 0) (< key (js-length (get coll :items)))) (aref (get coll :items) key) not-found))
      (t not-found)))

  (defun el-seq-into-extension (session items name)
    (cond
      ((= name "persistent-vector") (el-make-pcoll "persistent-vector" items))
      ((= name "persistent-list") (el-make-pcoll "persistent-list" items))
      (t (el-list-from items))))

  (defun el-print-extension (out value escape depth)
    (let ((kind (get value :kind)))
      (cond
        ((js-call sequence-kinds :includes kind)
          (el-print-items out (str "#<" kind " ") (get value :items) ">" escape depth))
        ((js-call map-kinds :includes kind)
          (js-call out :push (str "#<" kind))
          (js-call (get value :entries) :forEach
                   (lambda (e)
                     (js-call out :push " ")
                     (el-print-into out (aref e 0) escape (1+ depth))
                     (js-call out :push " ")
                     (el-print-into out (aref e 1) escape (1+ depth))))
          (js-call out :push ">"))
        (t (js-call out :push (str "#<" (or kind "object") ">"))))))

  (defun el-json-to-persistent (value)
    (cond
      ((Array/isArray value) (el-make-pcoll "persistent-vector" (js-call value :map (lambda (x) (el-json-to-persistent x)))))
      ((nil? value) nil)
      ((= (el-typeof value) "object")
        (let ((kvs (js-array)))
          (js-call (Object/entries value) :forEach
                   (lambda (pair) (js-call kvs :push (el-intern (str ":" (aref pair 0)))) (js-call kvs :push (el-json-to-persistent (aref pair 1)))))
          (el-make-pmap kvs)))
      ((eq value t) t)
      ((eq value false) nil)
      (t value)))

  (defun el-validate-struct-field (struct-name field value)
    (let ((type (get field :type)) (label (str struct-name "." (get field :name))))
      (when (and (= type "string") (not (el-string? value)))
        (el-signal "error" (str "Schema type mismatch on " label ": expected string")))
      (when (and (= type "integer") (not (el-integer? value)))
        (el-signal "error" (str "Schema type mismatch on " label ": expected integer")))
      (when (and (not (nil? (get field :min))) (el-number? value) (< (el-num value) (get field :min)))
        (el-signal "error" (str "Schema min violation on " label ": " (el-num value) " < " (get field :min))))
      (when (and (not (nil? (get field :max))) (el-number? value) (> (el-num value) (get field :max)))
        (el-signal "error" (str "Schema max violation on " label ": " (el-num value) " > " (get field :max))))))

  (defconst extension-exports
    (new globalThis.Map
     (js-array
     (js-array "eliscript-data" (js-array "persistent-list" "persistent-list-p" "persistent-vector" "persistent-vector-p"
                               "persistent-map" "persistent-map-p" "persistent-set" "persistent-set-p"
                               "persistent-queue" "persistent-queue-p" "persistent-sorted-map" "persistent-sorted-map-p"
                               "persistent-sorted-set" "persistent-sorted-set-p"
                               "value-get" "value-nth" "value-put" "value-assoc" "value-remove" "value-dissoc"
                               "value-conj" "value-count" "value-empty-p" "value-into" "value-equal-p" "value-hash"
                               "value-compare" "value-meta" "value-with-meta"
                               "cl-defstruct-persistent" "struct-validate" "struct-json-schema" "struct-to-json" "struct-from-json"
                               "defprotocol" "extend-protocol" "cl-defgeneric-value" "cl-defmethod-value"
                               "state-cell" "state-cell-p" "cell-value" "cell-update!" "cell-reset!" "cell-watch"
                               "delay" "force" "realized-p" "lazy-map" "lazy-filter" "lazy-take" "lazy-range"
                               "map-transducer" "filter-transducer" "take-transducer" "seq-transduce"
                               "with-transient" "conj!"
                               "result-ok" "result-error" "result-ok-p" "result-error-p" "result-value" "result-error-value"
                               "option-some" "option-none" "option-some-p" "option-none-p" "option-value"))
     (js-array "eliscript-bind" (js-array "let-bind" "let*-bind" "defun-bind" "lambda-bind" "pcase-value" "cond-predicate"
                               "defun-case" "lambda-case" "let-const" "let*-const" "let-loop" "defun-tail" "recur"
                               "thread-as" "thread-cond-first" "thread-some-first" "thread-some-last"
                               "fn-compose" "fn-partial" "fn-juxt" "fn-complement"))
     (js-array "eliscript-async" (js-array "defun-async" "await" "future-p" "with-async-scope"
                                "make-async-channel" "channel-put!" "channel-take!" "channel-close!"
                                "engine-bind" "engine-revoke!" "engine-handle-p" "engine-call" "eliscript-async-wait"))
     (js-array "eliscript-module" (js-array "defmodule" "defun-lexical" "defvar-lexical" "defconst-lexical"
                                 "export-functions" "export-values" "import-functions" "import-values"
                                 "defmacro-checked" "macro-gensym" "macro-read-file"))
     (js-array "eliscript-contract" (js-array "eliscript-contract-check-value"))
     (js-array "eliscript-js" (js-array "js-false" "js-null" "js-undefined" "js-false-p" "js-null-p" "js-undefined-p" "js-nullish-p"
                             "js-object" "js-get" "js-get-raw" "js-divide" "js-remainder" "js-length" "js-substring"
                             "js-regexp" "js-regexp-find"))
     (js-array "eliscript-abi" (js-array "with-abi-memory" "mem-load-u32" "mem-store-u32" "word-add" "word-sub" "word-mul" "word-div")))))

  (defun el-require (session feature &optional filename noerror)
    (let ((name (el-symbol-name feature)))
      (el-activate-extension session name)
      (when (and (not (js-call (get session :features) :has name))
                 (not (js-call (get session :loadingFeatures) :has name)))
        (cond
          ((js-call (get session :moduleSources) :has name)
            (let ((entry (js-call (get session :moduleSources) :get name)))
              (js-call (get session :loadingFeatures) :add name)
              (try
                (evalCompatProgram (get entry :source)
                                   (js-object :session session :filename (get entry :filename)))
                (finally
                  (js-call (get session :loadingFeatures) :delete name)))))
          ((not (nullish? (el-fs)))
            (let ((resolved (el-locate-library session (if (el-string? filename) filename name) nil nil)))
              (if (not (nil? resolved))
                  (progn
                    (js-call (get session :loadingFeatures) :add name)
                    (try
                      (el-load-file session resolved noerror t t nil)
                      (finally
                        (js-call (get session :loadingFeatures) :delete name))))
                (when (and (not (js-call extension-exports :has name))
                           (/= name "eliscript")
                           (el-cons? (el-global-value session (el-intern "load-path"))))
                  (if (and (not (nullish? noerror)) (not (nil? noerror)))
                      (setq feature nil)
                    (el-signal "file-missing" "Cannot open load file" "No such file or directory" (or filename name)))))))))
      (unless (nil? feature)
        (js-call (get session :features) :add name))
      feature))

  (defun el-activate-extension (session name)
    (if (= name "eliscript")
        (js-call (js-array "eliscript-data" "eliscript-bind" "eliscript-async" "eliscript-module" "eliscript-contract") :forEach
                 (lambda (lib) (el-activate-extension session lib)))
      (let ((exports (js-call extension-exports :get name)))
        (unless (or (undefined? exports) (js-call (get session :activeLibs) :has name))
          (js-call exports :forEach
                   (lambda (symbol)
                     (when (js-call (get session :userDefinedFns) :has symbol)
                       (el-compile-error (str "ELI-M0001: extension " name " symbol " symbol
                                              " conflicts with existing user definition")))))
          (js-call (get session :activeLibs) :add name)
          (el-install-extension session name)))))

  (defun el-future (state value error) (js-object :kind "future" :state state :value value :error error))

  (defun el-install-extension (session lib)
    (let ((d (lambda (name fn) (el-def session name fn)))
          (values (get session :values)))
      (cond
        ((= lib "eliscript-data")
          (js-call values :set (el-intern "option-none") OPTION_NONE)
          (funcall d "persistent-list" (lambda (&rest xs) (el-make-pcoll "persistent-list" xs)))
          (funcall d "persistent-vector" (lambda (&rest xs) (el-make-pcoll "persistent-vector" xs)))
          (funcall d "persistent-queue" (lambda (&rest xs) (el-make-pcoll "persistent-queue" xs)))
          (funcall d "persistent-map" (lambda (&rest xs) (el-make-pmap xs)))
          (funcall d "persistent-set" (lambda (&rest xs) (el-make-pset xs)))
          (funcall d "persistent-sorted-map" (lambda (&rest xs) (el-make-sorted-map session xs)))
          (funcall d "persistent-sorted-set" (lambda (&rest xs) (el-make-sorted-set session xs)))
          (js-call (js-array "persistent-list" "persistent-vector" "persistent-queue" "persistent-map" "persistent-set"
                             "persistent-sorted-map" "persistent-sorted-set")
                   :forEach (lambda (kind) (funcall d (str kind "-p") (lambda (x) (el-bool (= (el-kind x) kind))))))
          (funcall d "value-get" (lambda (c k &optional nf) (el-value-get c k (el-opt nf))))
          (funcall d "value-nth" (lambda (c i &optional nf) (let ((items (el-seq-items c))) (if (and (>= i 0) (< i (js-length items))) (aref items i) (el-opt nf)))))
          (funcall d "value-put" (lambda (c k v)
                                   (cond
                                     ((= (el-kind c) "persistent-map") (js-object :kind "persistent-map" :entries (el-assoc-entries (get c :entries) k v) :meta (get c :meta)))
                                     ((= (el-kind c) "persistent-sorted-map")
                                       (let ((entries (el-assoc-entries (get c :entries) k v)) (order (el-comparator session (get c :comparator))))
                                         (js-call entries :sort (lambda (x y) (funcall order (aref x 0) (aref y 0))))
                                         (js-object :kind "persistent-sorted-map" :comparator (get c :comparator) :entries entries :meta (get c :meta))))
                                     (t (el-signal "error" "value-put unsupported collection")))))
          (el-def-alias session "value-assoc" "value-put")
          (funcall d "value-remove" (lambda (c k)
                                      (js-object :kind (get c :kind) :comparator (get c :comparator) :meta (get c :meta)
                                                 :entries (js-call (get c :entries) :filter (lambda (e) (not (el-value-equal (aref e 0) k)))))))
          (el-def-alias session "value-dissoc" "value-remove")
          (funcall d "value-conj" (lambda (c &rest items)
                                    (let ((current c))
                                      (js-call items :forEach
                                               (lambda (item)
                                                 (let ((kind (get current :kind)))
                                                   (setq current
                                                         (cond
                                                           ((= kind "persistent-list") (js-object :kind kind :items (js-call (js-array item) :concat (get current :items)) :meta (get current :meta)))
                                                           ((or (= kind "persistent-vector") (= kind "persistent-queue"))
                                                             (js-object :kind kind :items (js-call (get current :items) :concat (js-array item)) :meta (get current :meta)))
                                                           ((= kind "persistent-set")
                                                             (if (js-call (get current :items) :some (lambda (x) (el-value-equal x item))) current
                                                               (js-object :kind kind :items (js-call (get current :items) :concat (js-array item)) :meta (get current :meta))))
                                                           (t current))))))
                                      current)))
          (funcall d "value-count" (lambda (c) (el-value-count c)))
          (funcall d "value-empty-p" (lambda (c) (el-bool (= (el-value-count c) 0))))
          (funcall d "value-equal-p" (lambda (a b) (el-bool (el-value-equal a b))))
          (funcall d "value-compare" (lambda (a b) (el-value-compare a b)))
          (funcall d "value-meta" (lambda (x) (let ((m (get x :meta))) (if (nullish? m) nil m))))
          (funcall d "value-with-meta" (lambda (x m) (Object/assign (js-object) x (js-object :meta m))))
          (funcall d "seq-length" (lambda (s) (el-value-count s)))
          (funcall d "map-elt" (lambda (m k &optional default) (el-value-get m k (el-opt default))))
          (funcall d "map-contains-key" (lambda (m k) (el-bool (el-value-contains m k))))
          (funcall d "map-keys" (lambda (m) (el-list-from (js-call (get m :entries) :map (lambda (e) (aref e 0))))))
          (funcall d "map-values" (lambda (m) (el-list-from (js-call (get m :entries) :map (lambda (e) (aref e 1))))))
          (funcall d "result-ok" (lambda (v) (js-object :kind "result" :ok t :value v)))
          (funcall d "result-error" (lambda (e) (js-object :kind "result" :ok false :value e)))
          (funcall d "result-ok-p" (lambda (x) (el-bool (and (= (el-kind x) "result") (get x :ok)))))
          (funcall d "result-error-p" (lambda (x) (el-bool (and (= (el-kind x) "result") (not (get x :ok))))))
          (funcall d "result-value" (lambda (x) (get x :value)))
          (funcall d "result-error-value" (lambda (x) (get x :value)))
          (funcall d "option-some" (lambda (v) (js-object :kind "option" :some t :value v)))
          (funcall d "option-some-p" (lambda (x) (el-bool (and (= (el-kind x) "option") (get x :some)))))
          (funcall d "option-none-p" (lambda (x) (el-bool (and (= (el-kind x) "option") (not (get x :some))))))
          (funcall d "option-value" (lambda (x)
                                      (unless (and (= (el-kind x) "option") (get x :some)) (el-signal "error" "option-value on option-none"))
                                      (get x :value)))
          (funcall d "state-cell" (lambda (init &rest opts)
                                    (let ((i (js-call opts :findIndex (lambda (o) (el-sym-is o ":validator")))))
                                      (let ((validator (if (< i 0) nil (aref opts (1+ i)))))
                                        (when (and (not (nil? validator)) (nil? (el-call session validator (js-array init))))
                                          (el-signal "error" "state-cell validator rejected initial value"))
                                        (js-object :kind "state-cell" :val init :validator validator :watches (js-array))))))
          (funcall d "state-cell-p" (lambda (x) (el-bool (= (el-kind x) "state-cell"))))
          (funcall d "cell-value" (lambda (c) (get c :val)))
          (funcall d "cell-reset!" (lambda (c value)
                                     (when (and (not (nil? (get c :validator))) (nil? (el-call session (get c :validator) (js-array value))))
                                       (el-signal "error" "state-cell validator rejected new value"))
                                     (let ((old (get c :val)))
                                       (put c :val value)
                                       (js-call (get c :watches) :forEach (lambda (w) (el-call session (aref w 1) (js-array (aref w 0) c old value))))
                                       value)))
          (funcall d "cell-update!" (lambda (c fn &rest args)
                                      (el-call session (el-intern "cell-reset!")
                                               (js-array c (el-call session fn (js-call (js-array (get c :val)) :concat args))))))
          (funcall d "cell-watch" (lambda (c k cb) (js-call (get c :watches) :push (js-array k cb)) c))
          (funcall d "realized-p" (lambda (x) (el-bool (and (= (el-kind x) "delay") (get x :realized)))))
          (funcall d "force" (lambda (x)
                               (if (= (el-kind x) "delay")
                                   (progn (unless (get x :realized) (put x :value (funcall (get x :thunk))) (put x :realized t))
                                          (get x :value))
                                 x)))
          (funcall d "lazy-range" (lambda (&optional start end step)
                                    (let ((from (if (nullish? start) 0 start)) (to (el-opt end)) (by (if (nullish? step) 1 step)))
                                      (letfn ((make (current)
                                                (js-object :kind "lazy-seq"
                                                           :step (lambda ()
                                                                   (if (and (not (nil? to)) (if (> by 0) (>= current to) (<= current to))) nil
                                                                     (el-cons current (make (+ current by))))))))
                                        (make from)))))
          (funcall d "lazy-map" (lambda (fn seq)
                                  (letfn ((make (s)
                                            (js-object :kind "lazy-seq"
                                                       :step (lambda ()
                                                               (let ((cell (el-lazy-force s)))
                                                                 (if (nil? cell) nil
                                                                   (el-cons (el-call session fn (js-array (get cell :car))) (make (get cell :cdr)))))))))
                                    (make seq))))
          (funcall d "lazy-filter" (lambda (pred seq)
                                     (letfn ((make (s)
                                               (js-object :kind "lazy-seq"
                                                          :step (lambda ()
                                                                  (let ((cursor s) (result nil) (done false))
                                                                    (while (not done)
                                                                      (let ((cell (el-lazy-force cursor)))
                                                                        (cond
                                                                          ((nil? cell) (setq done t))
                                                                          ((not (nil? (el-call session pred (js-array (get cell :car)))))
                                                                            (setq result (el-cons (get cell :car) (make (get cell :cdr))))
                                                                            (setq done t))
                                                                          (t (setq cursor (get cell :cdr))))))
                                                                    result)))))
                                       (make seq))))
          (funcall d "lazy-take" (lambda (n seq)
                                   (letfn ((make (remaining s)
                                             (js-object :kind "lazy-seq"
                                                        :step (lambda ()
                                                                (if (<= remaining 0) nil
                                                                  (let ((cell (el-lazy-force s)))
                                                                    (if (nil? cell) nil
                                                                      (el-cons (get cell :car) (make (1- remaining) (get cell :cdr))))))))))
                                     (make n seq))))
          (funcall d "map-transducer" (lambda (fn) (lambda (rf) (lambda (acc input) (el-call session rf (js-array acc (el-call session fn (js-array input))))))))
          (funcall d "filter-transducer" (lambda (pred) (lambda (rf) (lambda (acc input)
                                                                       (if (nil? (el-call session pred (js-array input))) acc
                                                                         (el-call session rf (js-array acc input)))))))
          (funcall d "seq-transduce" (lambda (xform f init coll)
                                       (let ((rf (el-call session xform (js-array f))) (acc init))
                                         (js-call (el-seq-items coll) :forEach (lambda (item) (setq acc (el-call session rf (js-array acc item)))))
                                         acc)))
          (funcall d "conj!" (lambda (builder &rest items)
                               (unless (and (= (el-kind builder) "transient") (get builder :active))
                                 (el-signal "error" "conj! called on expired or sealed transient builder"))
                               (js-call items :forEach (lambda (x) (js-call (get builder :items) :push x)))
                               builder))
          (funcall d "struct-validate" (lambda (name instance)
                                         (let ((schema (js-call (get session :structSchemas) :get (el-symbol-name name))))
                                           (when (undefined? schema) (el-signal "error" (str "Unknown struct " (el-symbol-name name))))
                                           (js-call (get schema :fields) :forEach
                                                    (lambda (field) (el-validate-struct-field (el-symbol-name name) field
                                                                                               (el-value-get instance (el-intern (str ":" (get field :name))) nil))))
                                           t)))
          (funcall d "struct-json-schema" (lambda (name)
                                            (el-make-pmap (js-array (el-intern ":type") "object" (el-intern ":title") (el-symbol-name name)))))
          (funcall d "struct-to-json" (lambda (name instance)
                                        (el-call session (el-intern "struct-validate") (js-array name instance))
                                        (JSON/stringify (serializeCompatValue instance))))
          (funcall d "struct-from-json" (lambda (name text)
                                          (let ((raw (JSON/parse text)) (kvs (js-array)))
                                            (js-call (Object/entries raw) :forEach
                                                     (lambda (pair) (js-call kvs :push (el-intern (str ":" (aref pair 0))))
                                                       (js-call kvs :push (el-json-to-persistent (aref pair 1)))))
                                            (el-call session (el-intern (str "make-" (el-symbol-name name))) kvs)))))
        ((= lib "eliscript-bind")
          (funcall d "fn-compose" (lambda (&rest fns)
                                    (lambda (&rest args)
                                      (let* ((reversed (js-call (js-call fns :slice) :reverse))
                                             (result (el-call session (aref reversed 0) args)))
                                        (js-call (js-call reversed :slice 1) :forEach (lambda (f) (setq result (el-call session f (js-array result)))))
                                        result))))
          (funcall d "fn-partial" (lambda (fn &rest bound) (lambda (&rest more) (el-call session fn (js-call bound :concat more)))))
          (funcall d "fn-juxt" (lambda (&rest fns) (lambda (&rest args) (el-list-from (js-call fns :map (lambda (f) (el-call session f args)))))))
          (funcall d "fn-complement" (lambda (pred) (lambda (&rest args) (if (nil? (el-call session pred args)) t nil)))))
        ((= lib "eliscript-async")
          (funcall d "future-p" (lambda (x) (el-bool (= (el-kind x) "future"))))
          (funcall d "eliscript-async-wait" (lambda (future)
                                              (unless (= (el-kind future) "future") (el-signal "wrong-type-argument" (el-intern "future-p") future))
                                              (when (= (get future :state) "rejected") (throw (get future :error)))
                                              (get future :value)))
          (funcall d "await" (lambda (future)
                               (unless (get session :inAsyncContext) (el-compile-error "ELI-A0001: await outside async function"))
                               (el-call session (el-intern "eliscript-async-wait") (js-array future))))
          (funcall d "make-async-channel" (lambda (&optional capacity)
                                            (js-object :kind "async-channel" :capacity (Math/max 1 (if (nullish? capacity) 0 capacity))
                                                       :buffer (js-array) :closed false)))
          (funcall d "channel-put!" (lambda (channel value)
                                      (if (get channel :closed)
                                          (el-future "rejected" nil (el-make-signal "eliscript-channel-closed" (js-array "Channel closed")))
                                        (progn (js-call (get channel :buffer) :push value) (el-future "fulfilled" t nil)))))
          (funcall d "channel-take!" (lambda (channel)
                                       (if (> (js-length (get channel :buffer)) 0)
                                           (el-future "fulfilled" (js-object :kind "option" :some t :value (js-call (get channel :buffer) :shift)) nil)
                                         (el-future "fulfilled" OPTION_NONE nil))))
          (funcall d "channel-close!" (lambda (channel) (put channel :closed t) nil))
          (funcall d "engine-handle-p" (lambda (x) (el-bool (= (el-kind x) "engine-handle"))))
          (funcall d "engine-bind" (lambda (fn &optional scope owner)
                                     (put session :nextSlotId (1+ (get session :nextSlotId)))
                                     (let* ((slot (get session :nextSlotId))
                                            (owner-name (if (nullish? owner) "local" (el-symbol-name owner)))
                                            (handle (js-object :kind "engine-handle" :owner owner-name :generation 1 :slot slot)))
                                       (js-call (get session :engineSlots) :set slot (js-object :owner owner-name :generation 1 :active t :fn fn))
                                       (when (and (not (nullish? scope)) (= (el-kind scope) "async-scope")) (js-call (get scope :handles) :push handle))
                                       handle)))
          (funcall d "engine-revoke!" (lambda (handle)
                                        (let ((entry (js-call (get session :engineSlots) :get (get handle :slot))))
                                          (unless (undefined? entry) (put entry :active false) (put entry :generation (1+ (get entry :generation))))
                                          t)))
          (funcall d "engine-call" (lambda (engine target &rest args)
                                     (let ((entry (if (= (el-kind target) "engine-handle") (js-call (get session :engineSlots) :get (get target :slot)) undefined)))
                                       (if (or (undefined? entry) (not (get entry :active)) (/= (get entry :owner) (get target :owner))
                                               (/= (get target :owner) (el-symbol-name engine)) (/= (get entry :generation) (get target :generation)))
                                           (el-future "rejected" nil (el-make-signal "eliscript-engine-handle-error" (js-array "Revoked or invalid engine handle")))
                                         (try (el-future "fulfilled" (el-call session (get entry :fn) args) nil)
                                           (catch error (el-future "rejected" nil error))))))))
        ((= lib "eliscript-js")
          (js-call values :set (el-intern "js-false") JS_FALSE)
          (js-call values :set (el-intern "js-null") JS_NULL)
          (js-call values :set (el-intern "js-undefined") JS_UNDEFINED)
          (funcall d "js-false-p" (lambda (x) (el-bool (eq x JS_FALSE))))
          (funcall d "js-null-p" (lambda (x) (el-bool (eq x JS_NULL))))
          (funcall d "js-undefined-p" (lambda (x) (el-bool (eq x JS_UNDEFINED))))
          (funcall d "js-nullish-p" (lambda (x) (el-bool (or (eq x JS_NULL) (eq x JS_UNDEFINED)))))
          (funcall d "js-object" (lambda (&rest kvs)
                                   (let ((props (new globalThis.Map)) (i 0))
                                     (while (< i (js-length kvs))
                                       (js-call props :set (el-record-field-name (aref kvs i)) (aref kvs (1+ i)))
                                       (setq i (+ i 2)))
                                     (js-object :kind "js-object" :props props))))
          (funcall d "js-get-raw" (lambda (obj key)
                                    (let ((name (el-record-field-name key)))
                                      (if (and (= (el-kind obj) "js-object") (js-call (get obj :props) :has name))
                                          (js-call (get obj :props) :get name)
                                        JS_UNDEFINED))))
          (funcall d "js-get" (lambda (obj key)
                                (let ((raw (el-call session (el-intern "js-get-raw") (js-array obj key))))
                                  (if (or (eq raw JS_FALSE) (eq raw JS_NULL) (eq raw JS_UNDEFINED)) nil raw))))
          (funcall d "js-divide" (lambda (a b) (el-make-float-if-fractional (/ (el-num a) (el-num b)))))
          (funcall d "js-remainder" (lambda (a b) (% (el-num a) (el-num b))))
          (funcall d "js-length" (lambda (s) (js-length s)))
          (funcall d "js-substring" (lambda (s start &optional end) (js-call s :slice start (el-opt end))))
          (funcall d "js-regexp" (lambda (pattern &optional flags) (js-object :kind "js-regexp" :regexp (new globalThis.RegExp pattern (if (nullish? flags) "" flags)))))
          (funcall d "js-regexp-p" (lambda (x) (el-bool (= (el-kind x) "js-regexp"))))
          (funcall d "js-regexp-find" (lambda (rx string)
                                        (let ((match (js-call (get rx :regexp) :exec string)))
                                          (if (nil? match) nil
                                            (el-make-pmap (js-array (el-intern ":match") (aref match 0) (el-intern ":start") (get match :index)
                                                                    (el-intern ":end") (+ (get match :index) (js-length (aref match 0))))))))))
        ((= lib "eliscript-abi")
          (funcall d "mem-store-u32" (lambda (offset value)
                                       (el-abi-check session offset)
                                       (js-call (new globalThis.DataView (get session :abiMemory)) :setUint32 offset (unsigned-bit-shift-right (el-num value) 0) t)
                                       nil))
          (funcall d "mem-load-u32" (lambda (offset)
                                      (el-abi-check session offset)
                                      (js-call (new globalThis.DataView (get session :abiMemory)) :getUint32 offset t)))
          (funcall d "word-add" (lambda (a b) (uint32 (+ (uint32 (el-num a)) (uint32 (el-num b))))))
          (funcall d "word-sub" (lambda (a b) (uint32 (- (uint32 (el-num a)) (uint32 (el-num b))))))
          (funcall d "word-mul" (lambda (a b) (uint32 (imul32 (uint32 (el-num a)) (uint32 (el-num b))))))
          (funcall d "word-div" (lambda (a b)
                                  (when (= (uint32 (el-num b)) 0) (el-signal "arith-error" "word-div by zero"))
                                  (uint32 (Math/trunc (/ (uint32 (el-num a)) (uint32 (el-num b))))))))
        (t nil))))

  (defun el-make-float-if-fractional (n) (el-make-float n))

  (defun el-abi-check (session offset)
    (let ((memory (get session :abiMemory)))
      (when (or (nil? memory) (< offset 0) (> (+ offset 4) (get memory :byteLength)))
        (el-signal "error" "ABI linear memory out of bounds"))))

  (defun el-lazy-force (s)
    (let ((cursor s))
      (while (= (el-kind cursor) "lazy-seq") (setq cursor (funcall (get cursor :step))))
      (if (el-cons? cursor) cursor nil)))

  ;; ------------------------------------------------------------------
  ;; eliscript-bind: unified destructuring, multi-arity, recur, threading
  ;; ------------------------------------------------------------------

  (defun el-collect-pattern-vars (pattern seen)
    (cond
      ((or (nil? pattern) (eq pattern s-underscore) (el-keyword? pattern)) seen)
      ((el-symobj? pattern)
        (when (js-call seen :has pattern)
          (el-compile-error (str "ELI-B0010: duplicate variable " (get pattern :name) " in pattern")))
        (js-call seen :add pattern)
        seen)
      ((el-vector? pattern)
        (let ((items (get pattern :items)) (i 0) (done false))
          (while (and (not done) (< i (js-length items)))
            (if (eq (aref items i) s-rest)
                (progn (el-collect-pattern-vars (aref items (1+ i)) seen) (setq done t))
              (el-collect-pattern-vars (aref items i) seen))
            (setq i (1+ i))))
        seen)
      ((el-cons? pattern)
        (let* ((items (el-list-to-array pattern)) (head (el-symbol-name (aref items 0))))
          (cond
            ((= head ":list")
              (let ((i 1) (done false))
                (while (and (not done) (< i (js-length items)))
                  (if (eq (aref items i) s-rest)
                      (progn (el-collect-pattern-vars (aref items (1+ i)) seen) (setq done t))
                    (el-collect-pattern-vars (aref items i) seen))
                  (setq i (1+ i)))))
            ((= head ":map")
              (js-call (js-call items :slice 1) :forEach
                       (lambda (entry)
                         (let ((sub (el-nth 1 entry)))
                           (el-collect-pattern-vars (if (and (el-cons? sub) (eq (get sub :car) s-default)) (el-nth 1 sub) sub) seen)))))
            ((= head ":record")
              (js-call (js-call items :slice 2) :forEach (lambda (entry) (el-collect-pattern-vars (el-nth 1 entry) seen))))
            ((or (= head ":ok") (= head ":error") (= head ":some")) (el-collect-pattern-vars (aref items 1) seen))))
        seen)
      (t seen)))

  (defun el-match-binding (session pattern value frame)
    (cond
      ((eq pattern s-underscore) nil)
      ((el-sym-is pattern ":none") (unless (eq value OPTION_NONE) (el-signal "error" "Destructuring expected option-none")))
      ((el-symobj? pattern) (js-call (get frame :vars) :set pattern value))
      ((el-vector? pattern)
        (unless (or (el-vector? value) (= (el-kind value) "persistent-vector"))
          (el-signal "error" "Destructuring vector pattern requires a vector or persistent-vector"))
        (let* ((items (get pattern :items)) (values (get value :items))
               (rest-index (js-call items :findIndex (lambda (x) (eq x s-rest)))))
          (if (>= rest-index 0)
              (progn
                (when (< (js-length values) rest-index) (el-signal "error" "Destructuring vector length mismatch"))
                (let ((i 0)) (while (< i rest-index) (el-match-binding session (aref items i) (aref values i) frame) (setq i (1+ i))))
                (el-match-binding session (aref items (1+ rest-index))
                                  (if (= (el-kind value) "persistent-vector")
                                      (el-make-pcoll "persistent-vector" (js-call values :slice rest-index))
                                    (el-vector (js-call values :slice rest-index)))
                                  frame))
            (progn
              (unless (= (js-length values) (js-length items)) (el-signal "error" "Destructuring vector length mismatch"))
              (let ((i 0)) (while (< i (js-length items)) (el-match-binding session (aref items i) (aref values i) frame) (setq i (1+ i))))))))
      ((el-cons? pattern)
        (let* ((items (el-list-to-array pattern)) (head (el-symbol-name (aref items 0))))
          (cond
            ((= head ":list")
              (unless (or (nil? value) (el-cons? value) (= (el-kind value) "persistent-list"))
                (el-signal "error" "Destructuring :list requires list or persistent-list"))
              (let* ((elements (if (= (el-kind value) "persistent-list") (get value :items) (el-list-to-array value)))
                     (subs (js-call items :slice 1))
                     (rest-index (js-call subs :findIndex (lambda (x) (eq x s-rest)))))
                (if (>= rest-index 0)
                    (progn
                      (when (< (js-length elements) rest-index) (el-signal "error" "Destructuring :list length mismatch"))
                      (let ((i 0)) (while (< i rest-index) (el-match-binding session (aref subs i) (aref elements i) frame) (setq i (1+ i))))
                      (el-match-binding session (aref subs (1+ rest-index))
                                        (if (= (el-kind value) "persistent-list")
                                            (el-make-pcoll "persistent-list" (js-call elements :slice rest-index))
                                          (el-list-from (js-call elements :slice rest-index)))
                                        frame))
                  (progn
                    (unless (= (js-length elements) (js-length subs)) (el-signal "error" "Destructuring :list length mismatch"))
                    (let ((i 0)) (while (< i (js-length subs)) (el-match-binding session (aref subs i) (aref elements i) frame) (setq i (1+ i))))))))
            ((= head ":map")
              (js-call (js-call items :slice 1) :forEach
                       (lambda (entry)
                         (let ((key (el-car entry)) (sub (el-nth 1 entry)))
                           (if (and (el-cons? sub) (eq (get sub :car) s-default))
                               (el-match-binding session (el-nth 1 sub)
                                                 (if (el-value-contains value key) (el-value-get value key nil)
                                                   (el-eval session (el-nth 2 sub) frame))
                                                 frame)
                             (progn
                               (unless (el-value-contains value key)
                                 (el-signal "error" (str "Destructuring :map missing required key " (el-symbol-name key))))
                               (el-match-binding session sub (el-value-get value key nil) frame)))))))
            ((= head ":record")
              (let ((type-name (el-symbol-name (aref items 1))))
                (unless (and (= (el-kind value) "persistent-record") (= (get value :typeName) type-name))
                  (el-signal "error" (str "Destructuring :record expected " type-name)))
                (js-call (js-call items :slice 2) :forEach
                         (lambda (entry) (el-match-binding session (el-nth 1 entry) (el-value-get value (el-car entry) nil) frame)))))
            ((= head ":ok")
              (unless (and (= (el-kind value) "result") (get value :ok)) (el-signal "error" "Destructuring :ok mismatch"))
              (el-match-binding session (aref items 1) (get value :value) frame))
            ((= head ":error")
              (unless (and (= (el-kind value) "result") (not (get value :ok))) (el-signal "error" "Destructuring :error mismatch"))
              (el-match-binding session (aref items 1) (get value :value) frame))
            ((= head ":some")
              (unless (and (= (el-kind value) "option") (get value :some)) (el-signal "error" "Destructuring :some mismatch"))
              (el-match-binding session (aref items 1) (get value :value) frame))
            (t (unless (el-value-equal pattern value) (el-signal "error" "Destructuring literal mismatch"))))))
      (t (unless (el-value-equal pattern value) (el-signal "error" "Destructuring literal mismatch")))))

  (defun sf-let-bind (session form env)
    (let ((frame (el-new-env env)) (seen (new globalThis.Set)) (sequential (el-sym-is (get form :car) "let*-bind")))
      (js-call (el-list-to-array (el-second form)) :forEach
               (lambda (binding)
                 (el-collect-pattern-vars (el-car binding) seen)
                 (el-match-binding session (el-car binding) (el-eval session (el-nth 1 binding) (if sequential frame env)) frame)))
      (el-eval-list-body session (el-rest-after form 1) frame)))

  (defun el-make-bind-function (session specs body env name)
    (let ((required (js-array)) (optional (js-array)) (mode "required") (seen (new globalThis.Set)))
      (js-call (el-list-to-array specs) :forEach
               (lambda (spec)
                 (cond
                   ((eq spec s-optional) (setq mode "optional"))
                   ((= mode "required") (el-collect-pattern-vars spec seen) (js-call required :push spec))
                   (t (let ((pair (if (el-cons? spec) (el-list-to-array spec) (js-array spec nil))))
                        (el-collect-pattern-vars (aref pair 0) seen)
                        (js-call optional :push pair))))))
      (lambda (&rest args)
        (let ((frame (el-new-env env)))
          (js-call required :forEach (lambda (pattern index) (el-match-binding session pattern (el-opt (aref args index)) frame)))
          (js-call optional :forEach
                   (lambda (pair index)
                     (let ((position (+ (js-length required) index)))
                       (el-match-binding session (aref pair 0)
                                         (if (> (js-length args) position) (aref args position) (el-eval session (el-opt (aref pair 1)) frame))
                                         frame))))
          (el-eval-list-body session body frame)))))

  (defun sf-defun-bind (session form env)
    (let ((name (el-second form)))
      (el-define-function session name (el-make-bind-function session (el-third form) (el-rest-after form 2) env (el-symbol-name name)))))
  (defun sf-lambda-bind (session form env)
    (el-make-bind-function session (el-second form) (el-rest-after form 1) env "lambda-bind"))

  (defun sf-pcase-value (session form env)
    (let ((target (el-eval session (el-second form) env)) (cursor (el-rest-after form 1)) (result nil) (done false))
      (while (and (not done) (el-cons? cursor))
        (let ((clause (get cursor :car)))
          (when (or (eq (el-car clause) s-underscore) (el-value-equal target (el-eval session (el-car clause) env)))
            (setq done t)
            (setq result (el-eval-list-body session (el-cdr clause) env))))
        (setq cursor (get cursor :cdr)))
      result))

  (defun sf-cond-predicate (session form env)
    (let* ((pred (el-eval session (el-second form) env))
           (value (el-eval session (el-third form) env))
           (clauses (el-list-to-array (el-rest-after form 2)))
           (i 0) (result nil) (done false))
      (while (and (not done) (< i (js-length clauses)))
        (cond
          ((= i (1- (js-length clauses))) (setq result (el-eval session (aref clauses i) env)) (setq done t))
          ((el-sym-is (aref clauses (1+ i)) ":>>")
            (let ((matched (el-call session pred (js-array (el-eval session (aref clauses i) env) value))))
              (if (not (nil? matched))
                  (progn (setq result (el-call session (el-eval session (aref clauses (+ i 2)) env) (js-array matched))) (setq done t))
                (setq i (+ i 3)))))
          (t (if (not (nil? (el-call session pred (js-array (el-eval session (aref clauses i) env) value))))
                 (progn (setq result (el-eval session (aref clauses (1+ i)) env)) (setq done t))
               (setq i (+ i 2))))))
      result))

  (defun el-make-case-function (session clauses env name)
    (let ((fixed (new globalThis.Map)) (rest-clause nil))
      (js-call clauses :forEach
               (lambda (clause)
                 (let* ((params (el-list-to-array (el-car clause))) (body (el-cdr clause))
                        (rest-index (js-call params :findIndex (lambda (p) (eq p s-rest)))))
                   (when (js-call params :some (lambda (p) (eq p s-optional)))
                     (el-compile-error (str "ELI-A0010: &optional forbidden in " name)))
                   (if (>= rest-index 0)
                       (progn
                         (unless (nil? rest-clause) (el-compile-error "ELI-A0012: multiple &rest clauses"))
                         (setq rest-clause (js-object :min rest-index :names (js-call params :slice 0 rest-index)
                                                      :rest (aref params (1+ rest-index)) :body body)))
                     (progn
                       (when (js-call fixed :has (js-length params))
                         (el-compile-error (str "ELI-A0011: duplicate arity " (js-length params))))
                       (js-call fixed :set (js-length params) (js-object :names params :body body)))))))
      (unless (nil? rest-clause)
        (js-call fixed :forEach (lambda (v arity) (when (>= arity (get rest-clause :min))
                                                    (el-compile-error "ELI-A0012: fixed arity overlaps &rest")))))
      (lambda (&rest args)
        (let ((frame (el-new-env env)))
          (cond
            ((js-call fixed :has (js-length args))
              (let ((branch (js-call fixed :get (js-length args))))
                (js-call (get branch :names) :forEach (lambda (n i) (js-call (get frame :vars) :set n (aref args i))))
                (el-eval-list-body session (get branch :body) frame)))
            ((and (not (nil? rest-clause)) (>= (js-length args) (get rest-clause :min)))
              (js-call (get rest-clause :names) :forEach (lambda (n i) (js-call (get frame :vars) :set n (aref args i))))
              (js-call (get frame :vars) :set (get rest-clause :rest) (el-list-from (js-call args :slice (get rest-clause :min))))
              (el-eval-list-body session (get rest-clause :body) frame))
            (t (el-signal "wrong-number-of-arguments" (el-intern name) (js-length args))))))))

  (defun sf-defun-case (session form env)
    (let ((name (el-second form)))
      (el-define-function session name
        (el-make-case-function session (get (el-extract-declarations (el-list-to-array (el-rest-after form 1))) :body) env (el-symbol-name name)))))
  (defun sf-lambda-case (session form env)
    (el-make-case-function session (el-list-to-array (get form :cdr)) env "lambda-case"))

  (defun el-verify-recur-tail (forms tail)
    (js-call forms :forEach
             (lambda (form index)
               (let ((last (and tail (= index (1- (js-length forms))))))
                 (when (el-cons? form)
                   (let ((head (get form :car)) (args (el-list-to-array (get form :cdr))))
                     (cond
                       ((eq head s-quote) nil)
                       ((eq head s-recur)
                         (unless last (el-compile-error "ELI-R0001: recur must be in tail position"))
                         (el-verify-recur-tail args false))
                       ((eq head s-if)
                         (el-verify-recur-tail (js-array (aref args 0)) false)
                         (el-verify-recur-tail (js-array (el-opt (aref args 1))) last)
                         (el-verify-recur-tail (js-call args :slice 2) last))
                       ((eq head s-progn) (el-verify-recur-tail args last))
                       ((or (eq head s-let) (el-sym-is head "let*") (el-sym-is head "let-const"))
                         (el-verify-recur-tail (js-call args :slice 1) last))
                       ((or (el-sym-is head "let-loop") (el-sym-is head "defun-tail")) nil)
                       (t (el-verify-recur-tail args false)))))))))

  (defun el-run-recur-loop (session names body frame)
    (let ((result nil) (running t))
      (while running
        (try
          (progn (setq result (el-eval-list-body session body frame)) (setq running false))
          (catch signal
            (if (and (not (nullish? signal)) (get signal :eliscriptRecur))
                (js-call names :forEach (lambda (n i) (js-call (get frame :vars) :set n (el-opt (aref (get signal :args) i)))))
              (throw signal)))))
      result))

  (defun sf-let-loop (session form env)
    (let* ((bindings (el-list-to-array (el-second form)))
           (names (js-call bindings :map (lambda (b) (el-car b))))
           (body (el-rest-after form 1))
           (frame (el-new-env env)))
      (el-verify-recur-tail (el-list-to-array body) t)
      (js-call bindings :forEach (lambda (b) (js-call (get frame :vars) :set (el-car b) (el-eval session (el-nth 1 b) frame))))
      (el-run-recur-loop session names body frame)))

  (defun sf-defun-tail (session form env)
    (let* ((name (el-second form))
           (names (el-list-to-array (el-third form)))
           (body (el-rest-after form 2)))
      (el-verify-recur-tail (el-list-to-array body) t)
      (el-define-function session name
        (lambda (&rest args)
          (let ((frame (el-new-env env)))
            (js-call names :forEach (lambda (n i) (js-call (get frame :vars) :set n (el-opt (aref args i)))))
            (el-run-recur-loop session names body frame))))))

  (defun sf-recur (session form env)
    (throw (js-object :eliscriptRecur t :args (el-eval-args session (get form :cdr) env))))

  (defun sf-thread-as (session form env)
    (let ((value (el-eval session (el-second form) env)) (name (el-third form)) (frame (el-new-env env)))
      (js-call (el-list-to-array (el-rest-after form 2)) :forEach
               (lambda (step) (js-call (get frame :vars) :set name value) (setq value (el-eval session step frame))))
      value))

  (defun sf-thread-cond (session form env)
    (let ((value (el-eval session (el-second form) env)) (items (el-list-to-array (el-rest-after form 1))) (i 0)
          (last (el-sym-is (get form :car) "thread-cond-last")))
      (while (< i (js-length items))
        (unless (nil? (el-eval session (aref items i) env))
          (let ((step (aref items (1+ i))))
            (setq value (el-eval session (el-thread-step step (el-list s-quote value) last) env))))
        (setq i (+ i 2)))
      value))

  (defun el-thread-step (step value last)
    (if (el-cons? step)
        (if last (el-append (js-array step (el-list value))) (el-cons (get step :car) (el-cons value (get step :cdr))))
      (el-list step value)))

  (defun sf-thread-some (session form env)
    (let ((value (el-eval session (el-second form) env)) (cursor (el-rest-after form 1))
          (last (el-sym-is (get form :car) "thread-some-last")))
      (while (and (el-cons? cursor) (not (nil? value)))
        (setq value (el-eval session (el-thread-step (get cursor :car) (el-list s-quote value) last) env))
        (setq cursor (get cursor :cdr)))
      value))

  ;; ------------------------------------------------------------------
  ;; eliscript-data forms
  ;; ------------------------------------------------------------------

  (defun sf-cl-defstruct-persistent (session form env)
    (let* ((name (el-symbol-name (el-second form)))
           (fields (js-call (js-call (el-list-to-array (el-rest-after form 1)) :filter (lambda (f) (not (el-string? f))))
                            :map (lambda (f)
                                   (if (el-symobj? f)
                                       (js-object :name (get f :name) :type "any" :min nil :max nil :hasDefault false :default nil)
                                     (let ((items (el-list-to-array f))
                                           (field (js-object :name (el-symbol-name (el-car f)) :type "any" :min nil :max nil :hasDefault false :default nil))
                                           (i 1))
                                       (while (< i (js-length items))
                                         (let ((key (el-symbol-name (aref items i))) (value (aref items (1+ i))))
                                           (cond ((= key ":type") (put field :type (el-symbol-name-or-string value)))
                                                 ((= key ":min") (put field :min (el-num value)))
                                                 ((= key ":max") (put field :max (el-num value)))
                                                 ((= key ":default") (put field :hasDefault t) (put field :default value))))
                                         (setq i (+ i 2)))
                                       field))))))
      (js-call (get session :structSchemas) :set name (js-object :name name :fields fields))
      (el-def session (str "make-" name)
              (lambda (&rest kvs)
                (let ((given (new globalThis.Map)) (i 0) (entries (js-array)))
                  (while (< i (js-length kvs))
                    (js-call given :set (el-record-field-name (aref kvs i)) (aref kvs (1+ i)))
                    (setq i (+ i 2)))
                  (js-call fields :forEach
                           (lambda (field)
                             (let ((value (if (js-call given :has (get field :name)) (js-call given :get (get field :name))
                                            (if (get field :hasDefault) (el-eval session (get field :default) env) nil))))
                               (el-validate-struct-field name field value)
                               (js-call entries :push (js-array (get field :name) value)))))
                  (js-object :kind "persistent-record" :typeName name :entries entries :meta nil))))
      (el-def session (str name "-p") (lambda (x) (el-bool (and (= (el-kind x) "persistent-record") (= (get x :typeName) name)))))
      (el-def session (str name "-with")
              (lambda (instance &rest kvs)
                (let ((merged (js-array)))
                  (js-call (get instance :entries) :forEach (lambda (e) (js-call merged :push (el-intern (str ":" (aref e 0)))) (js-call merged :push (aref e 1))))
                  (el-call session (el-intern (str "make-" name)) (js-call merged :concat kvs)))))
      (js-call fields :forEach
               (lambda (field)
                 (el-def session (str name "-" (get field :name))
                         (lambda (instance) (el-value-get instance (el-intern (str ":" (get field :name))) nil)))))
      (el-second form)))

  (defun el-dispatch-tag (value)
    (cond ((= (el-kind value) "persistent-record") (get value :typeName))
          ((el-record? value) (el-symbol-name (aref (get value :items) 0)))
          (t (el-kind value))))

  (defun sf-defprotocol (session form env)
    (let ((name (el-symbol-name (el-second form))) (table (new globalThis.Map)))
      (js-call (get session :protocols) :set name table)
      (js-call (el-list-to-array (el-rest-after form 1)) :forEach
               (lambda (signature)
                 (let ((method (el-symbol-name (el-car signature))))
                   (el-def session method
                           (lambda (target &rest rest)
                             (let* ((tag (el-dispatch-tag target))
                                    (impls (js-call table :get tag))
                                    (impl (if (undefined? impls) undefined (js-call impls :get method))))
                               (when (undefined? impl) (el-signal "error" (str "No protocol impl " name "." method " for " tag)))
                               (Reflect/apply impl nil (js-call (js-array target) :concat rest))))))))
      (el-second form)))

  (defun sf-extend-protocol (session form env)
    (let* ((name (el-symbol-name (el-second form)))
           (type (el-symbol-name (el-third form)))
           (table (js-call (get session :protocols) :get name)))
      (when (undefined? table) (el-signal "error" (str "Unknown protocol " name)))
      (unless (js-call table :has type) (js-call table :set type (new globalThis.Map)))
      (js-call (el-list-to-array (el-rest-after form 2)) :forEach
               (lambda (impl)
                 (js-call (js-call table :get type) :set (el-symbol-name (el-car impl))
                          (el-make-lambda session (get impl :cdr) env (el-symbol-name (el-car impl))))))
      (el-second form)))

  (defun sf-cl-defgeneric-value (session form env)
    (let* ((name (el-second form))
           (dispatcher (el-make-lambda session (el-rest-after form 1) env (el-symbol-name name)))
           (methods (new globalThis.Map)))
      (js-call (get session :multimethods) :set (el-symbol-name name) methods)
      (el-define-function session name
        (lambda (&rest args)
          (let* ((key (el-call session dispatcher args))
                 (method (js-call methods :get key)))
            (when (undefined? method) (el-signal "error" (str "No multimethod " (el-symbol-name name) " for " (el-prin1-string key t))))
            (el-call session method args))))))

  (defun sf-cl-defmethod-value (session form env)
    (let* ((name (el-symbol-name (el-second form)))
           (key (el-eval session (el-third form) env))
           (methods (js-call (get session :multimethods) :get name)))
      (js-call methods :set key (el-make-lambda session (el-rest-after form 2) env name))
      (el-second form)))

  (defun sf-delay (session form env)
    (js-object :kind "delay" :realized false :value nil
               :thunk (lambda () (el-eval-list-body session (get form :cdr) env))))

  (defun sf-with-transient (session form env)
    (let* ((spec (el-second form))
           (source (el-eval session (el-nth 1 spec) env))
           (builder (js-object :kind "transient" :active t :items (js-call (or (get source :items) (js-array)) :slice)))
           (frame (el-new-env env)))
      (js-call (get frame :vars) :set (el-car spec) builder)
      (try (progn (el-eval-list-body session (el-rest-after form 1) frame)
                  (put builder :active false)
                  (el-make-pcoll "persistent-vector" (get builder :items)))
        (finally (put builder :active false)))))

  ;; ------------------------------------------------------------------
  ;; eliscript-module
  ;; ------------------------------------------------------------------

  (defun el-check-const-mutation (forms consts module-name)
    (js-call forms :forEach
             (lambda (form)
               (when (el-cons? form)
                 (let ((items (el-list-to-array form)))
                   (unless (eq (aref items 0) s-quote)
                     (when (or (eq (aref items 0) s-setq) (eq (aref items 0) s-setf))
                       (let ((i 1))
                         (while (< i (js-length items))
                           (when (and (el-symobj? (aref items i)) (js-call consts :has (aref items i)))
                             (el-compile-error (str "ELI-M0002: cannot reassign defconst-lexical " (get (aref items i) :name)
                                                    " in module " module-name)))
                           (setq i (+ i 2)))))
                     (el-check-const-mutation (js-call items :slice 1) consts module-name)))))))

  (defun sf-defmodule (session form env)
    (let* ((name (el-symbol-name (el-second form)))
           (forms (el-list-to-array (el-rest-after form 1)))
           (module-env (el-new-env env))
           (exported-fns (new globalThis.Map))
           (exported-values (new globalThis.Map))
           (consts (new globalThis.Set)))
      (put module-env :fns (new globalThis.Map))
      (put module-env :consts (new globalThis.Set))
      (js-call forms :forEach (lambda (f) (when (and (el-cons? f) (el-sym-is (get f :car) "defconst-lexical")) (js-call consts :add (el-second f)))))
      (when (> (get consts :size) 0) (el-check-const-mutation forms consts name))
      (js-call forms :forEach
               (lambda (sub)
                 (when (el-cons? sub)
                   (let ((head (el-symbol-name (get sub :car))))
                     (cond
                       ((or (= head "defconst-lexical") (= head "defvar-lexical"))
                         (js-call (get module-env :vars) :set (el-second sub) (el-eval session (el-third sub) module-env))
                         (when (= head "defconst-lexical") (js-call (get module-env :consts) :add (el-second sub))))
                       ((= head "defun-lexical")
                         (put module-env :hasFns t)
                         (put (el-second sub) :_everLocalFn t)
                         (js-call (get module-env :fns) :set (el-second sub)
                                  (el-make-lambda session (el-rest-after sub 1) module-env (el-symbol-name (el-second sub)))))
                       ((= head "export-functions")
                         (js-call (el-list-to-array (get sub :cdr)) :forEach
                                  (lambda (s) (js-call exported-fns :set s (js-call (get session :functions) :get s)))))
                       ((= head "export-values")
                         (js-call (el-list-to-array (get sub :cdr)) :forEach
                                  (lambda (s) (js-call exported-values :set s (lambda () (js-call (get module-env :vars) :get s))))))
                       (t (el-eval session sub module-env)))))))
      (js-call (get session :modules) :set name (js-object :fns exported-fns :values exported-values))
      (el-second form)))

  (defun sf-import-functions (session form env)
    (let ((module (js-call (get session :modules) :get (el-symbol-name (el-second form)))))
      (js-call (el-list-to-array (el-nth 3 form)) :forEach
               (lambda (s) (el-set-fn session s (js-call (get module :fns) :get s))))
      nil))

  (defun sf-import-values (session form env)
    (let ((module (js-call (get session :modules) :get (el-symbol-name (el-second form)))))
      (js-call (el-list-to-array (el-nth 3 form)) :forEach
               (lambda (s) (js-call (get session :liveValueGetters) :set s (js-call (get module :values) :get s))))
      nil))

  (defun sf-defmacro-checked (session form env)
    (let* ((name (el-second form))
           (extracted (el-extract-declarations (el-list-to-array (el-rest-after form 2))))
           (props (get extracted :props))
           (inputs (if (js-call props :has ":inputs") (el-list-to-array (js-call props :get ":inputs")) (js-array))))
      (js-call (get extracted :body) :forEach
               (lambda (f)
                 (when (and (el-cons? f) (el-sym-is (get f :car) "macro-read-file"))
                   (let ((path (el-second f)))
                     (unless (js-call inputs :includes path)
                       (el-compile-error (str "ELI-M0011: undeclared file " path " in " (el-symbol-name name) " (:inputs)")))))))
      (let ((macro-env (el-new-env env))
            (mg-sym (el-intern "macro-gensym")))
        (put macro-env :fns (new globalThis.Map))
        (put macro-env :hasFns t)
        (put mg-sym :_everLocalFn t)
        (js-call (get macro-env :fns) :set mg-sym
                 (lambda (&optional prefix)
                   (put session :gensymCounter (1+ (get session :gensymCounter)))
                   (el-intern (str "__eli_hygienic_" (if (nullish? prefix) "g" prefix) "_" (get session :gensymCounter)))))
        (el-set-macro session name (el-make-macro session (el-third form) (get extracted :body) macro-env (el-symbol-name name))))
      name))

  ;; ------------------------------------------------------------------
  ;; eliscript-async and eliscript-abi forms
  ;; ------------------------------------------------------------------

  (defun el-make-async-function (session spec-and-body env name)
    (let ((inner (el-make-lambda session spec-and-body env name)))
      (lambda (&rest args)
        (let ((previous (get session :inAsyncContext)))
          (put session :inAsyncContext t)
          (try
            (let ((value (Reflect/apply inner nil args)))
              (if (= (el-kind value) "future") value (el-future "fulfilled" (el-normalize-result value) nil)))
            (catch error
              (when (el-control-transfer? error) (throw error))
              (el-future "rejected" nil error))
            (finally (put session :inAsyncContext previous)))))))

  (defun sf-defun-async (session form env)
    (let ((name (el-second form)))
      (el-define-function session name (el-make-async-function session (el-rest-after form 1) env (el-symbol-name name)))))
  (defun sf-lambda-async (session form env)
    (el-make-async-function session (get form :cdr) env "lambda-async"))

  (defun sf-with-async-scope (session form env)
    (let ((scope (js-object :kind "async-scope" :handles (js-array))) (frame (el-new-env env)))
      (js-call (get frame :vars) :set (el-car (el-second form)) scope)
      (try (el-eval-list-body session (el-rest-after form 1) frame)
        (finally
          (js-call (get scope :handles) :forEach
                   (lambda (handle)
                     (let ((revoke (el-symbol-function session (el-intern "engine-revoke!"))))
                       (unless (nil? revoke) (funcall revoke handle)))))))))

  (defun sf-with-abi-memory (session form env)
    (let* ((options (el-list-to-array (el-second form)))
           (index (js-call options :findIndex (lambda (o) (el-sym-is o ":initial-pages"))))
           (pages (if (< index 0) 1 (aref options (1+ index))))
           (previous (get session :abiMemory)))
      (put session :abiMemory (new globalThis.ArrayBuffer (* pages 65536)))
      (try (el-eval-list-body session (el-rest-after form 1) env)
        (finally (put session :abiMemory previous)))))

  ;; ------------------------------------------------------------------
  ;; Special-form registry
  ;; ------------------------------------------------------------------

  (defun el-register (names handler)
    (js-call names :forEach
             (lambda (name)
               (let ((sym (el-intern name)))
                 (put sym :specialForm handler)
                 (js-call special-forms :set sym handler)))))

  (defun el-install-special-forms ()
    (el-register (js-array "quote") sf-quote)
    (el-register (js-array "function") sf-function)
    (el-register (js-array "`") sf-backquote)
