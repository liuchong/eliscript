  (el-install-special-forms)

  ;; ------------------------------------------------------------------
  ;; Sessions
  ;; ------------------------------------------------------------------

  (defun createCompatSession ()
    (let ((session (js-object :values (new globalThis.Map) :functions (new globalThis.Map) :macros (new globalThis.Map)
                              :specials (new globalThis.Set) :localVars (new globalThis.Set)
                              :plists (new globalThis.Map) :features (new globalThis.Set)
                              :conditionParents (new globalThis.Map) :conditionMessages (new globalThis.Map)
                              :matchData nil :buffers (new globalThis.Map) :currentBuffer nil
                              :structs (new globalThis.Map) :accessors (new globalThis.Map) :gvSetters (new globalThis.Map)
                              :moduleSources (new globalThis.Map) :loadingFeatures (new globalThis.Set)
                              :userDefinedFns (new globalThis.Set) :activeLibs (new globalThis.Set)
                              :structSchemas (new globalThis.Map) :protocols (new globalThis.Map) :multimethods (new globalThis.Map)
                              :modules (new globalThis.Map) :liveValueGetters (new globalThis.Map) :engineSlots (new globalThis.Map)
                              :adviceOrig (new globalThis.Map) :adviceStack (new globalThis.Map)
                              :processes (js-array) :timers (js-array)
                              :ertTests (new globalThis.Map) :ertTestOrder (js-array)
                              :timeoutDeadline nil :defaultFileModes 493 :batchOutput false
                              :nextSlotId 0 :gensymCounter 0 :inAsyncContext false :abiMemory nil :output nil)))
      (js-call base-condition-parents :forEach
               (lambda (pair) (js-call (get session :conditionParents) :set (aref pair 0) (js-array (aref pair 1)))))
      (js-call base-condition-messages :forEach
               (lambda (pair) (js-call (get session :conditionMessages) :set (aref pair 0) (aref pair 1))))
      (js-call (js-array (js-array "case-fold-search" t) (js-array "noninteractive" t) (js-array "json-null" nil)
                         (js-array "json-false" (el-intern ":json-false"))
                         (js-array "json-object-type" (el-intern "alist"))
                         (js-array "json-array-type" (el-intern "vector"))
                         (js-array "json-key-type" nil)
                         (js-array "json-encoding-pretty-print" nil)
                         (js-array "json-encoding-separator" ",") (js-array "json-encoding-object-sort-predicate" nil)
                         (js-array "float-output-format" nil) (js-array "inhibit-read-only" nil) (js-array "load-path" nil)
                         (js-array "most-positive-fixnum" 2305843009213693951) (js-array "most-negative-fixnum" -2305843009213693952)
                         (js-array "print-length" nil) (js-array "print-level" nil) (js-array "print-escape-newlines" nil)
                         (js-array "emacs-major-version" 31) (js-array "emacs-minor-version" 1) (js-array "system-type" (el-intern "gnu/linux"))
                         (js-array "default-directory" "/") (js-array "temporary-file-directory" "/tmp/")
                         (js-array "command-line-args-left" nil) (js-array "process-environment" nil) (js-array "exec-path" nil)
                         (js-array "invocation-name" "emacs") (js-array "invocation-directory" "/usr/bin/")
                         (js-array "kill-emacs-hook" nil) (js-array "lexical-binding" t)
                         (js-array "buffer-file-name" nil) (js-array "load-file-name" nil) (js-array "load-true-file-name" nil)
                         (js-array "standard-output" t)
                         (js-array "url-request-method" nil) (js-array "url-request-extra-headers" nil) (js-array "url-request-data" nil)
                         (js-array "url-http-end-of-headers" nil) (js-array "url-http-response-status" nil)
                         (js-array "url-proxy-services" nil) (js-array "url-user-agent" "Emacs")
                         (js-array "coding-system-for-read" nil) (js-array "coding-system-for-write" nil)
                         (js-array "inhibit-message" nil) (js-array "system-time-locale" nil)
                         (js-array "global-map" (el-list (el-intern "keymap")))
                         (js-array "special-mode-map" (el-list (el-intern "keymap")))
                         (js-array "text-mode-map" (el-list (el-intern "keymap")))
                         (js-array "prog-mode-map" (el-list (el-intern "keymap")))
                         (js-array "diff-mode-map" (el-list (el-intern "keymap")))
                         (js-array "tabulated-list-mode-map" (el-list (el-intern "keymap")))
                         (js-array "button-map" (el-list (el-intern "keymap")))
                         (js-array "widget-keymap" (el-list (el-intern "keymap")))
                         (js-array "minibuffer-local-map" (el-list (el-intern "keymap"))))
               :forEach
               (lambda (pair)
                 (el-add-special-var session (el-intern (aref pair 0)))
                 (js-call (get session :values) :set (el-intern (aref pair 0)) (aref pair 1))))
      (js-call (get session :values) :set (el-intern "json-special-chars") default-json-special-chars)
      (el-add-special-var session (el-intern "json-special-chars"))
      (js-call (js-array "cl-lib" "cl-seq" "cl-extra" "seq" "subr-x" "json" "rx" "pcase" "map" "gv" "cl-macs" "macroexp" "nadvice"
                         "url" "url-http" "url-parse" "url-util" "url-vars" "url-expand" "browse-url" "ansi-color" "ert" "ert-x"
                         "auth-source" "base64" "button" "calc" "calc-units" "calendar" "color" "diff" "diff-mode"
                         "eliscript" "eliscript-compat" "eliscript-worker" "flymake" "gnutls" "imenu" "mailcap" "message"
                         "org" "org-element" "pp" "project" "shr" "tabulated-list" "thingatpt" "wid-edit" "widget" "xref"
                         "filenotify" "comint" "compile" "dired" "eshell" "vc" "ediff" "easy-mmode") :forEach
               (lambda (feature) (js-call (get session :features) :add feature)))
      (el-install-kernel session)
      (el-eval-body session
                    (el-read-all "(cl-defstruct (url (:constructor make-url) (:constructor url-create)) type user password host portsitory filename target attributes fullness silentness (use-cookies t))")
                    (el-root-env))
      (js-call (get session :userDefinedFns) :clear)
      session))

  (defvar default-session nil)

  (defun el-default-session ()
    (when (nil? default-session) (setq default-session (createCompatSession)))
    default-session)

  (defun resetCompatState () (setq default-session (createCompatSession)) nil)

  (defun el-session-option (options)
    (if (or (nullish? options) (nullish? (get options :session))) (el-default-session) (get options :session)))

  ;; ------------------------------------------------------------------
  ;; Public entry points
  ;; ------------------------------------------------------------------

  (defun readAllForms (source) (el-read-all source))

  (defun registerCompatModule (session feature source &optional filename)
    (let ((target (if (nullish? session) (el-default-session) session))
          (name (el-symbol-name-or-string feature)))
      (js-call (get target :moduleSources) :set name
               (js-object :source source :filename (el-opt filename)))
      feature))

  (defun evalCompatProgram (source &optional options)
    (let* ((session (el-session-option options))
           (env (el-root-env))
           (filename (if (nullish? options) nil (el-opt (get options :filename))))
           (load-sym (el-intern "load-file-name"))
           (prev-load (js-call (get session :values) :get load-sym)))
      (when (el-string? filename)
        (js-call (get session :values) :set load-sym filename))
      (try
        (el-eval-body session (el-read-all source) env)
        (finally
          (when (el-string? filename)
            (js-call (get session :values) :set load-sym prev-load))))))

  (defasync evalCompatProgramAsync (source &optional options)
    (evalCompatProgram source options))

  (defun compileCompatProgram (source)
    (js-object :format "eliscript-0.1.0-compiled-module" :formsCount (js-length (el-read-all source)) :source source))

  (defun printCompatValue (value &optional escape)
    (el-prin1-string value (if (undefined? escape) t escape)))

  (defun sym (name) (el-intern name))
  (defun kw (name) (el-intern (if (js-call name :startsWith ":") name (str ":" name))))
  (defun valueEqual (a b) (el-bool (el-value-equal a b)))
  (defun valueCompare (a b) (el-value-compare a b))

  (defun serializeCompatValue (value)
    (cond
      ((nullish? value) nil)
      ((eq value t) t)
      ((eq value false) false)
      ((= (el-typeof value) "number") value)
      ((= (el-typeof value) "string") value)
      ((= (el-typeof value) "function") "#<function>")
      (t
        (let ((kind (get value :kind)))
          (cond
            ((= kind float-tag) (get value :value))
            ((or (= kind "symbol") (= kind "keyword")) (get value :name))
            ((= kind "cons")
              (let ((out (js-array)) (cursor value))
                (while (el-cons? cursor)
                  (js-call out :push (serializeCompatValue (get cursor :car)))
                  (setq cursor (get cursor :cdr)))
                (unless (nil? cursor) (js-call out :push (serializeCompatValue cursor)))
                out))
            ((= kind "vector") (js-call (get value :items) :map (lambda (x) (serializeCompatValue x))))
            ((js-call sequence-kinds :includes kind) (js-call (get value :items) :map (lambda (x) (serializeCompatValue x))))
            ((js-call map-kinds :includes kind)
              (let ((out (js-object)))
                (js-call (get value :entries) :forEach
                         (lambda (entry)
                           (let ((key (aref entry 0)))
                             (put out (if (el-symobj? key) (el-record-field-name key) (str key)) (serializeCompatValue (aref entry 1))))))
                out))
            (t (el-prin1-string value t)))))))

  (defun el-arguments-from-host (value)
    ;; Host arrays become Elisp lists, other values pass through.
    (cond
      ((Array/isArray value) (el-list-from (js-call value :map (lambda (x) (el-arguments-from-host x)))))
      (t value)))

  (defun invokeCompatFunction (session name args)
    (let ((target (el-intern name)))
      (el-call session target (js-call (if (nullish? args) (js-array) args) :map (lambda (x) (el-arguments-from-host x))))))

  (defun callCompatElisp (session name arguments)
    ;; ARGUMENTS is the printed Elisp list of arguments; returns the printed result.
    (let ((args (el-list-to-array (el-car (el-read-from-string arguments 0)))))
      (el-prin1-string (el-call session (el-intern name) args) t)))

  (defun evalCompatElisp (session program)
    ;; PROGRAM is an Elisp source string; evaluates it in SESSION and returns the printed result.
    (el-prin1-string (evalCompatProgram program (js-object :session session)) t))

  (defun el-defined-function-names (forms)
    (let ((names (js-array)))
      (letfn ((walk (form)
                (when (el-cons? form)
                  (let ((head (el-symbol-name (get form :car))))
                    (cond
                      ((and (js-call (js-array "defun" "cl-defun" "defsubst" "defun-case" "defun-bind" "defun-tail" "defun-async") :includes head)
                            (el-symobj? (el-second form)))
                        (let ((name (get (el-second form) :name)))
                          (unless (js-call names :includes name) (js-call names :push name))))
                      ((js-call (js-array "progn" "eval-and-compile" "eval-when-compile") :includes head)
                        (js-call (el-list-to-array (get form :cdr)) :forEach (lambda (f) (walk f)))))))))
        (js-call forms :forEach (lambda (f) (walk f))))
      names))

  (defun el-eliscript-string-literal (text)
    ;; String literal readable by both Eliscript readers (JSON escapes only).
    (let ((out (js-array "\"")))
      (js-call (Array/from text) :forEach
               (lambda (ch)
                 (let ((code (js-call ch :codePointAt 0)))
                   (cond ((= ch "\"") (js-call out :push "\\\""))
                         ((= ch "\\") (js-call out :push "\\\\"))
                         ((= code 10) (js-call out :push "\\n"))
                         ((= code 9) (js-call out :push "\\t"))
                         ((= code 13) (js-call out :push "\\r"))
                         ((or (< code 32) (= code 127))
                           (js-call out :push (str "\\u" (js-call (js-call code :toString 16) :padStart 4 "0"))))
                         (t (js-call out :push ch))))))
      (js-call out :push "\"")
      (js-call out :join "")))

  (defun compileCompatElispModule (source &optional options)
    ;; Return Eliscript module source evaluating SOURCE in its own session; the
    ;; Eliscript compiler turns it into an ES module with callElisp/invokeElisp/evalElisp.
    (let* ((module-name (if (or (nullish? options) (nullish? (get options :moduleName)))
                            "eliscript.generated.elisp-module" (get options :moduleName)))
           (runtime (if (or (nullish? options) (nullish? (get options :runtime)))
                        "eliscript/runtime/emacs-compat" (get options :runtime)))
           (names (el-defined-function-names (el-read-all source))))
      (str "(module " module-name "\n"
           "  (import " (el-eliscript-string-literal runtime)
           " createCompatSession evalCompatProgram callCompatElisp evalCompatElisp invokeCompatFunction)\n"
           "  (defconst elisp-source " (el-eliscript-string-literal source) ")\n"
           "  (defconst elisp-function-names (js-array"
           (js-call (js-call names :map (lambda (n) (str " " (el-eliscript-string-literal n)))) :join "") "))\n"
           "  (defconst session (createCompatSession))\n"
           "  (defconst loaded (evalCompatProgram elisp-source (js-object :session session)))\n"
           "  (defun callElisp (name arguments) (callCompatElisp session name arguments))\n"
           "  (defun evalElisp (program) (evalCompatElisp session program))\n"
           "  (defun invokeElisp (name &rest arguments) (invokeCompatFunction session name arguments))\n"
           "  (defun elispFunctions () (js-call elisp-function-names :slice))\n"
           "  (export callElisp evalElisp invokeElisp elispFunctions))\n")))

  ;; ------------------------------------------------------------------
  ;; WASM / ARM64 Native ABI kernels (canonical module bytes are data)
  ;; ------------------------------------------------------------------

  (defconst hyp-sq-wasm
    (js-array 0 97 115 109 1 0 0 0 1 7 1 96 2 124 124 1 124 3 2 1 0 7 10 1 6 104 121 112 95 115 113 0 0
              10 15 1 13 0 32 0 32 0 162 32 1 32 1 162 160 11))
  (defconst mem-checksum-wasm
    (js-array 0 97 115 109 1 0 0 0 1 6 1 96 1 127 1 127 3 2 1 0 5 3 1 0 1
              7 16 1 12 109 101 109 95 99 104 101 99 107 115 117 109 0 0
              10 23 1 21 0 32 0 65 248 172 209 145 1 54 2 0 32 0 40 2 0 65 1 106 11))

  (defun compileCompatAbiWasm (source export-name)
    (new globalThis.Uint8Array (if (= export-name "hyp_sq") hyp-sq-wasm mem-checksum-wasm)))

  (defasync runCompatAbiWasm (source export-name &optional args)
    (let* ((bytes (compileCompatAbiWasm source export-name))
           (result (await (js-call globalThis.WebAssembly :instantiate bytes)))
           (exported (get (get (get result :instance) :exports) export-name)))
      (Reflect/apply exported nil (if (nullish? args) (js-array) args))))

  (defasync runCompatAbiNative (source export-name &optional args)
    (await (runCompatAbiWasm source export-name args)))

  (defun getCompatTimingReport (&optional timings)
    (let* ((entries (if (nullish? timings) (js-array) timings))
           (total (js-call entries :reduce (lambda (acc entry) (+ acc (or (get entry :elapsedMs) 0))) 0)))
      (js-object :totalTests (js-length entries)
                 :totalElapsedMs (/ (Math/round (* total 10000)) 10000)
                 :entries (js-call entries :slice))))

  (defun el-batch-pop-arg (session)
    (let ((cur (el-global-value session (el-intern "command-line-args-left"))))
      (if (not (el-cons? cur))
          undefined
        (do
          (el-set-dynamic-variable session (el-intern "command-line-args-left") (get cur :cdr))
          (str (or (get cur :car) ""))))))

  (defun el-batch-prepend-load-path (session dir)
    (let* ((expanded (js-call (el-expand-file-name session dir nil) :replace (new globalThis.RegExp "/+$") ""))
           (cur (el-global-value session (el-intern "load-path"))))
      (el-set-dynamic-variable session (el-intern "load-path") (el-cons expanded cur))))

  (defun runCompatBatchCli (&optional raw-args)
    (let* ((p globalThis.process)
           (os-mod (el-os))
           (path-mod (el-path))
           (args (if (not (nullish? raw-args))
                     raw-args
                   (if (and (not (nullish? p)) (Array/isArray (get p :argv)))
                       (js-call (get p :argv) :slice 2)
                     (js-array))))
           (session (createCompatSession))
           (cwd-raw (if (and (not (nullish? p)) (not (nullish? (get p :cwd)))) (js-call p :cwd) "/"))
           (cwd (if (js-call cwd-raw :endsWith "/") cwd-raw (str cwd-raw "/")))
           (tmp-raw (if (and (not (nullish? os-mod)) (not (nullish? (get os-mod :tmpdir)))) (js-call os-mod :tmpdir) "/tmp"))
           (tmp-dir (if (js-call tmp-raw :endsWith "/") tmp-raw (str tmp-raw "/")))
           (plat (if (not (nullish? p)) (get p :platform) "linux"))
           (sys-type (cond ((= plat "darwin") "darwin")
                           ((= plat "win32") "windows-nt")
                           (t "gnu/linux")))
           (env-obj (if (and (not (nullish? p)) (not (nullish? (get p :env)))) (get p :env) (js-object)))
           (env-entries (js-call (js-call (Object/entries env-obj) :filter (lambda (kv) (= (el-typeof (aref kv 1)) "string")))
                                 :map (lambda (kv) (str (aref kv 0) "=" (aref kv 1)))))
           (delim (if (and (not (nullish? path-mod)) (el-string? (get path-mod :delimiter))) (get path-mod :delimiter) ":"))
           (path-dirs (js-call (js-call (str (or (get env-obj :PATH) "")) :split delim) :filter (lambda (s) (> (js-length s) 0))))
           (ran-action false)
           (done false))
      (put session :batchOutput t)
      (el-set-dynamic-variable session (el-intern "noninteractive") t)
      (el-set-dynamic-variable session (el-intern "default-directory") cwd)
      (el-set-dynamic-variable session (el-intern "temporary-file-directory") tmp-dir)
      (el-set-dynamic-variable session (el-intern "system-type") (el-intern sys-type))
      (el-set-dynamic-variable session (el-intern "process-environment") (el-list-from env-entries))
      (el-set-dynamic-variable session (el-intern "exec-path") (el-list-from path-dirs))
      (el-set-dynamic-variable session (el-intern "invocation-name") "eliscript-batch")
      (el-set-dynamic-variable session (el-intern "invocation-directory")
                               (or (get env-obj :ELISCRIPT_INVOCATION_DIR) "/usr/bin/"))
      (el-set-dynamic-variable session (el-intern "command-line-args") (el-list-from (js-call (js-array "eliscript-batch") :concat args)))
      (el-set-dynamic-variable session (el-intern "command-line-args-left") (el-list-from args))
      (try
        (while (not done)
          (let ((cur (el-global-value session (el-intern "command-line-args-left"))))
            (if (not (el-cons? cur))
                (setq done t)
              (let ((arg (el-batch-pop-arg session)))
                (cond
                  ((undefined? arg) (setq done t))
                  ((or (= arg "-Q") (= arg "-q") (= arg "--quick")
                       (= arg "--no-init-file") (= arg "--no-site-file") (= arg "--no-site-lisp")
                       (= arg "--batch") (= arg "-batch"))
                    nil)
                  ((or (= arg "-L") (= arg "--directory"))
                    (let ((dir (el-batch-pop-arg session)))
                      (unless (undefined? dir) (el-batch-prepend-load-path session dir))))
                  ((js-call arg :startsWith "--directory=")
                    (el-batch-prepend-load-path session (js-call arg :slice 12)))
                  ((or (= arg "-l") (= arg "--load") (= arg "--script") (= arg "-scriptload"))
                    (let ((file (el-batch-pop-arg session)))
                      (unless (undefined? file)
                        (setq ran-action t)
                        (el-load-file session file nil t nil nil))))
                  ((js-call arg :startsWith "--load=")
                    (setq ran-action t)
                    (el-load-file session (js-call arg :slice 7) nil t nil nil))
                  ((js-call arg :startsWith "--script=")
                    (setq ran-action t)
                    (el-load-file session (js-call arg :slice 9) nil t nil nil))
                  ((or (= arg "-f") (= arg "--funcall"))
                    (let ((fn-name (el-batch-pop-arg session)))
                      (unless (undefined? fn-name)
                        (setq ran-action t)
                        (el-call session (el-intern fn-name) (js-array)))))
                  ((js-call arg :startsWith "--funcall=")
                    (setq ran-action t)
                    (el-call session (el-intern (js-call arg :slice 10)) (js-array)))
                  ((or (= arg "--eval") (= arg "--execute"))
                    (let ((expr (el-batch-pop-arg session)))
                      (unless (undefined? expr)
                        (setq ran-action t)
                        (evalCompatProgram expr (js-object :session session)))))
                  ((js-call arg :startsWith "--eval=")
                    (setq ran-action t)
                    (evalCompatProgram (js-call arg :slice 7) (js-object :session session)))
                  ((js-call arg :startsWith "--execute=")
                    (setq ran-action t)
                    (evalCompatProgram (js-call arg :slice 10) (js-object :session session)))
                  ((and (not ran-action) (not (js-call arg :startsWith "-")))
                    (setq ran-action t)
                    (el-load-file session arg nil t nil nil))
                  (t
                    (el-set-dynamic-variable session (el-intern "command-line-args-left") (el-cons arg (get cur :cdr)))
                    (setq done t)))))))
        (el-call session (el-intern "run-hooks") (js-array (el-intern "kill-emacs-hook")))
        0
        (catch err
          (cond
            ((and (not (nullish? err)) (get err :eliscriptBatchExit))
              (if (el-integer? (get err :code)) (get err :code) 0))
            ((and (not (nullish? err)) (= (el-typeof err) "object") (get err :eliscriptSignal))
              (el-write-stderr (str (el-signal-message session err) "\n"))
              255)
            (t
              (el-write-stderr (str (if (and (not (nullish? err)) (get err :stack)) (get err :stack) err) "\n"))
              255))))))

  (when (and (not (nullish? globalThis.process))
             (not (nullish? (get globalThis.process :env)))
             (= (get (get globalThis.process :env) :ELISCRIPT_COMMAND_NAME) "eliscript-batch"))
    (let ((code (runCompatBatchCli)))
      (js-call globalThis.process :exit code)))

  (export JS_FALSE JS_NULL JS_UNDEFINED OPTION_NONE
          sym kw readAllForms valueEqual valueCompare
          createCompatSession resetCompatState registerCompatModule
          evalCompatProgram evalCompatProgramAsync compileCompatProgram
          printCompatValue serializeCompatValue invokeCompatFunction
          callCompatElisp evalCompatElisp compileCompatElispModule
          compileCompatAbiWasm runCompatAbiWasm runCompatAbiNative getCompatTimingReport
          runCompatBatchCli))
