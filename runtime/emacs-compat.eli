(module eliscript.runtime.emacs-compat
  ;;; emacs-compat.eli --- Public entry point for the 0.1.0 Emacs Lisp + 1+5+2 runtime
  ;;
  ;; Re-exports the public session, evaluation, module compilation, ABI, and
  ;; batch CLI entry points from the modular runtime/emacs-compat/* submodules.

  (import "./emacs-compat/core.eli" JS_FALSE JS_NULL JS_UNDEFINED OPTION_NONE kw printCompatValue serializeCompatValue sym valueCompare valueEqual)
  (import "./emacs-compat/reader-format.eli" readAllForms)
  (import "./emacs-compat/builtins.eli" createCompatSession resetCompatState)
  (import "./emacs-compat/session-cli.eli" callCompatElisp compileCompatAbiWasm compileCompatElispModule compileCompatProgram evalCompatElisp evalCompatProgram evalCompatProgramAsync getCompatTimingReport invokeCompatFunction registerCompatModule runCompatAbiNative runCompatAbiWasm runCompatBatchCli)

  (when (and (not (nullish? globalThis.process))
             (not (nullish? (get globalThis.process :env)))
             (= (get (get globalThis.process :env) :ELISCRIPT_COMMAND_NAME) "eliscript-batch"))
    (let ((code (runCompatBatchCli)))
      (js-call globalThis.process :exit code)))

  (export JS_FALSE JS_NULL JS_UNDEFINED OPTION_NONE callCompatElisp compileCompatAbiWasm compileCompatElispModule compileCompatProgram createCompatSession evalCompatElisp evalCompatProgram evalCompatProgramAsync getCompatTimingReport invokeCompatFunction kw printCompatValue readAllForms registerCompatModule resetCompatState runCompatAbiNative runCompatAbiWasm runCompatBatchCli serializeCompatValue sym valueCompare valueEqual))
