                   (if (or (nullish? fs) (not (el-string? f))) nil
                     (el-bool (try (js-call (js-call fs :statSync (el-expand-file-name session f nil)) :isFile) (catch e false)))))))
      (funcall d "file-readable-p"
               (lambda (f)
