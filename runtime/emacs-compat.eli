  if (c?.kind === \"persistent-map\" || c?.kind === \"persistent-sorted-map\") {\n        return { ...c, entries: dissocEntries(c.entries, k) };\n      }\n      throw new Error(\"value-remove unsupported collection\");\n    });\n    fns.set(\"value-dissoc\", fns.get(\"value-remove\"));\n    fns.set(\"value-conj\", (c, ...items) => {\n      let cur = c;\n      for (const it of items) {\n        if (cur.kind === \"persistent-list\") cur = { ...cur, items: [it, ...cur.items] };\n        else if (cur.kind === \"persistent-vector\" || cur.kind === \"persistent-queue\") {\n          cur = { ...cur, items: [...cur.items, it] };\n        } else if (cur.kind === \"persistent-set\") {\n          if (!cur.items.some((x) => valueEqual(x, it))) {\n            cur = { ...cur, items: [...cur.items, it] };\n          }\n        }\n      }\n      return cur;\n    });\n    fns.set(\"value-count\", (c) => valueCount(c));\n    fns.set(\"value-empty-p\", (c) => (valueCount(c) === 0 ? true : null));\n    fns.set(\"value-equal-p\", (a, b) => (valueEqual(a, b) ? true : null));\n    fns.set(\"value-compare\", (a, b) => valueCompare(a, b));\n    fns.set(\"value-meta\", (x) => x?.meta ?? null);\n    fns.set(\"value-with-meta\", (x, m) => ({ ...x, meta: m }));\n    fns.set(\"seq-length\", (s) => valueCount(s));\n    fns.set(\"seq-elt\", (s, idx) => extractSeqElements(s)[idx] ?? null);\n    fns.set(\"seq-map\", (fn, s) =>\n      arrayToConsList(extractSeqElements(s).map((x) => invokeCallable(session, fn, [x]))),\n    );\n    fns.set(\"seq-filter\", (pred, s) =>\n      arrayToConsList(\n        extractSeqElements(s).filter((x) => isTruthy(invokeCallable(session, pred, [x]))),\n      ),\n    );\n    fns.set(\"seq-into\", (s, targetType) => {\n      const elems = extractSeqElements(s);\n      const tname = isSym(targetType) ? targetType.name : String(targetType);\n      if (tname === \"persistent-vector-p\") return true;\n      if (tname === \"persistent-vector\") return makePersistentVector(elems);\n      if (tname === \"persistent-list\") return makePersistentList(elems);\n      if (tname === \"list\") return arrayToConsList(elems);\n      if (tname === \"vector\") return makeNativeVector(elems);\n      return arrayToConsList(elems);\n    });\n    fns.set(\"map-elt\", (m, k, def = null) => valueGet(m, k, def));\n    fns.set(\"map-contains-key\", (m, k) => (valueContains(m, k) ? true : null));\n    fns.set(\"map-keys\", (m) => arrayToConsList(m.entries.map(([k]) => k)));\n    fns.set(\"map-values\", (m) => arrayToConsList(m.entries.map(([, v]) => v)));\n    fns.set(\"result-ok\", (v) => ({ kind: \"result\", ok: true, value: v }));\n    fns.set(\"result-error\", (e) => ({ kind: \"result\", ok: false, value: e }));\n    fns.set(\"result-ok-p\", (x) => (x?.kind === \"result\" && x.ok ? true : null));\n    fns.set(\"result-error-p\", (x) => (x?.kind === \"result\" && !x.ok ? true : null));\n    fns.set(\"result-value\", (x) => x.value);\n    fns.set(\"result-error-value\", (x) => x.value);\n    fns.set(\"option-some\", (v) => ({ kind: \"option\", some: true, value: v }));\n    fns.set(\"option-some-p\", (x) => (x?.kind === \"option\" && x.some ? true : null));\n    fns.set(\"option-none-p\", (x) => (x?.kind === \"option\" && !x.some ? true : null));\n    fns.set(\"option-value\", (x) => {\n      if (!x || x.kind !== \"option\" || !x.some) throw new Error(\"option-value on option-none\");\n      return x.value;\n    });\n    fns.set(\"state-cell\", (init, ...opts) => {\n      let validator = null;\n      for (let i = 0; i < opts.length; i += 2) {\n        if (isKw(opts[i], \":validator\")) validator = opts[i + 1];\n      }\n      if (validator && !isTruthy(invokeCallable(session, validator, [init]))) {\n        throw new Error(\"state-cell validator rejected initial value\");\n      }\n      return { kind: \"state-cell\", val: init, validator, watches: [] };\n    });\n    fns.set(\"cell-value\", (c) => c.val);\n    fns.set(\"cell-reset!\", (c, nv) => {\n      if (c.validator && !isTruthy(invokeCallable(session, c.validator, [nv]))) {\n        throw new Error(\"state-cell validator rejected new value\");\n      }\n      const old = c.val;\n      c.val = nv;\n      for (const [k, cb] of c.watches) {\n        invokeCallable(session, cb, [k, c, old, nv]);\n      }\n      return nv;\n    });\n    fns.set(\"cell-update!\", (c, fn, ...args) => {\n      const next = invokeCallable(session, fn, [c.val, ...args]);\n      return fns.get(\"cell-reset!\")(c, next);\n    });\n    fns.set(\"cell-watch\", (c, k, cb) => {\n      c.watches.push([k, cb]);\n      return c;\n    });\n    fns.set(\"realized-p\", (d) => (d?.kind === \"delay\" && d.realized ? true : null));\n    fns.set(\"force\", (d) => {\n      if (d?.kind === \"delay\") {\n        if (!d.realized) {\n          d.value = d.thunk();\n          d.realized = true;\n        }\n        return d.value;\n      }\n      return d;\n    });\n    fns.set(\"lazy-range\", (start = 0, end = null, step = 1) => {\n      const makeStep = (cur) => ({\n        kind: \"lazy-seq\",\n        step: () => {\n          if (end !== null && (step > 0 ? cur >= end : cur <= end)) return null;\n          return makeCons(cur, makeStep(cur + step));\n        },\n      });\n      return makeStep(start);\n    });\n    fns.set(\"lazy-map\", (fn, seq) => {\n      const makeStep = (s) => ({\n        kind: \"lazy-seq\",\n        step: () => {\n          const st = s?.kind === \"lazy-seq\" ? s.step() : s;\n          if (!st) return null;\n          return makeCons(invokeCallable(session, fn, [st.car]), makeStep(st.cdr));\n        },\n      });\n      return makeStep(seq);\n    });\n    fns.set(\"lazy-filter\", (pred, seq) => {\n      const makeStep = (s) => ({\n        kind: \"lazy-seq\",\n        step: () => {\n          let cur = s;\n          while (cur) {\n            const st = cur?.kind === \"lazy-seq\" ? cur.step() : cur;\n            if (!st) return null;\n            if (isTruthy(invokeCallable(session, pred, [st.car]))) {\n              return makeCons(st.car, makeStep(st.cdr));\n            }\n            cur = st.cdr;\n          }\n          return null;\n        },\n      });\n      return makeStep(seq);\n    });\n    fns.set(\"lazy-take\", (n, seq) => {\n      const makeStep = (rem, s) => ({\n        kind: \"lazy-seq\",\n        step: () => {\n          if (rem <= 0) return null;\n          const st = s?.kind === \"lazy-seq\" ? s.step() : s;\n          if (!st) return null;\n          return makeCons(st.car, makeStep(rem - 1, st.cdr));\n        },\n      });\n      return makeStep(n, seq);\n    });\n    fns.set(\"map-transducer\", (fn) => (rf) => (acc, input) =>\n      invokeCallable(session, rf, [acc, invokeCallable(session, fn, [input])]),\n    );\n    fns.set(\"filter-transducer\", (pred) => (rf) => (acc, input) =>\n      isTruthy(invokeCallable(session, pred, [input]))\n        ? invokeCallable(session, rf, [acc, input])\n        : acc,\n    );\n    fns.set(\"seq-transduce\", (xform, f, init, coll) => {\n      const rf = invokeCallable(session, xform, [f]);\n      let acc = init;\n      for (const item of extractSeqElements(coll)) {\n        acc = invokeCallable(session, rf, [acc, item]);\n      }\n      return acc;\n    });\n    fns.set(\"conj!\", (builder, ...items) => {\n      if (!builder || builder.kind !== \"transient\" || !builder.active) {\n        throw new Error(\"conj! called on expired or sealed transient builder\");\n      }\n      builder.items.push(...items);\n      return builder;\n    });\n    fns.set(\"struct-validate\", (snameSym, inst) => {\n      const sname = isSym(snameSym) ? snameSym.name : String(snameSym);\n      const schema = session.structSchemas.get(sname);\n      if (!schema) throw new Error(`Unknown struct ${sname}`);\n      for (const f of schema.fields) {\n        const val = valueGet(inst, kw(f.name));\n        validateStructField(sname, f, val);\n      }\n      return true;\n    });\n    fns.set(\"struct-json-schema\", (snameSym) => {\n      const sname = isSym(snameSym) ? snameSym.name : String(snameSym);\n      const schema = session.structSchemas.get(sname);\n      if (!schema) throw new Error(`Unknown struct ${sname}`);\n      return makePersistentMap([\n        kw(\":type\"), \"object\",\n        kw(\":title\"), sname,\n      ]);\n    });\n    fns.set(\"struct-to-json\", (snameSym, inst) => {\n      fns.get(\"struct-validate\")(snameSym, inst);\n      return JSON.stringify(serializeCompatValue(inst));\n    });\n    fns.set(\"struct-from-json\", (snameSym, jsonStr) => {\n      const sname = isSym(snameSym) ? snameSym.name : String(snameSym);\n      const raw = JSON.parse(jsonStr);\n      const kvs = [];\n      for (const [k, v] of Object.entries(raw)) {\n        kvs.push(kw(`:${k}`), jsonValueToPersistent(v));\n      }\n      return session.functions.get(`make-${sname}`)(...kvs);\n    });\n  }\n  if (libName === \"eliscript-bind\") {\n    fns.set(\"fn-compose\", (...fnList) => (...args) => {\n      const rev = [...fnList].reverse();\n      let res = invokeCallable(session, rev[0], args);\n      for (let i = 1; i < rev.length; i += 1) {\n        res = invokeCallable(session, rev[i], [res]);\n      }\n      return res;\n    });\n    fns.set(\"fn-partial\", (fn, ...bound) => (...more) =>\n      invokeCallable(session, fn, [...bound, ...more]),\n    );\n    fns.set(\"fn-juxt\", (...fnList) => (...args) =>\n      arrayToConsList(fnList.map((f) => invokeCallable(session, f, args))),\n    );\n    fns.set(\"fn-complement\", (pred) => (...args) =>\n      isTruthy(invokeCallable(session, pred, args)) ? null : true,\n    );\n  }\n  if (libName === \"eliscript-async\") {\n    fns.set(\"future-p\", (x) => (x?.kind === \"future\" ? true : null));\n    fns.set(\"eliscript-async-wait\", (fut) => {\n      if (!fut || fut.kind !== \"future\") {\n        signalError(\"wrong-type-argument\", \"future-p\", fut);\n      }\n      if (fut.state === \"rejected\") {\n        throw fut.error;\n      }\n      return fut.value;\n    });\n    fns.set(\"await\", (fut) => {\n      if (!session.inAsyncContext) {\n        signalError(\"eliscript-compile-error\", \"ELI-A0001: await outside async function\");\n      }\n      return fns.get(\"eliscript-async-wait\")(fut);\n    });\n    fns.set(\"make-async-channel\", (cap = 0) => ({\n      kind: \"async-channel\",\n      capacity: Math.max(1, cap),\n      buffer: [],\n      closed: false,\n    }));\n    fns.set(\"channel-put!\", (ch, val) => {\n      if (ch.closed) {\n        return {\n          kind: \"future\",\n          state: \"rejected\",\n          error: new EliscriptSignal(\"eliscript-channel-closed\", [\"Channel closed\"]),\n        };\n      }\n      ch.buffer.push(val);\n      return { kind: \"future\", state: \"fulfilled\", value: true };\n    });\n    fns.set(\"channel-take!\", (ch) => {\n      if (ch.buffer.length > 0) {\n        const v = ch.buffer.shift();\n        return { kind: \"future\", state: \"fulfilled\", value: { kind: \"option\", some: true, value: v } };\n      }\n      return { kind: \"future\", state: \"fulfilled\", value: OPTION_NONE };\n    });\n    fns.set(\"channel-close!\", (ch) => {\n      ch.closed = true;\n      return null;\n    });\n    fns.set(\"engine-handle-p\", (x) => (x?.kind === \"engine-handle\" ? true : null));\n    fns.set(\"engine-bind\", (fn, scope = null, owner = sym(\"local\")) => {\n      const slot = ++session.nextSlotId;\n      const ownerName = isSym(owner) ? owner.name : String(owner);\n      const handle = { kind: \"engine-handle\", owner: ownerName, generation: 1, slot };\n      session.engineSlots.set(slot, { owner: ownerName, generation: 1, active: true, fn });\n      if (scope && scope.kind === \"async-scope\") {\n        scope.handles.push(handle);\n      }\n      return handle;\n    });\n    fns.set(\"engine-revoke!\", (h) => {\n      const entry = session.engineSlots.get(h.slot);\n      if (entry) {\n        entry.active = false;\n        entry.generation += 1;\n      }\n      return true;\n    });\n    fns.set(\"engine-call\", (engine, target, ...args) => {\n      const engName = isSym(engine) ? engine.name : String(engine);\n      if (target?.kind === \"engine-handle\") {\n        const entry = session.engineSlots.get(target.slot);\n        if (\n          !entry ||\n          !entry.active ||\n          entry.owner !== target.owner ||\n          target.owner !== engName ||\n          entry.generation !== target.generation\n        ) {\n          return {\n            kind: \"future\",\n            state: \"rejected\",\n            error: new EliscriptSignal(\"eliscript-engine-handle-error\", [\n              \"Revoked or invalid engine handle\",\n            ]),\n          };\n        }\n        try {\n          const val = invokeCallable(session, entry.fn, args);\n          return { kind: \"future\", state: \"fulfilled\", value: val };\n        } catch (err) {\n          return { kind: \"future\", state: \"rejected\", error: err };\n        }\n      }\n      return {\n        kind: \"future\",\n        state: \"rejected\",\n        error: new EliscriptSignal(\"eliscript-engine-handle-error\", [\"Invalid target\"]),\n      };\n    });\n  }\n  if (libName === \"eliscript-js\") {\n    session.values.set(\"js-false\", JS_FALSE);\n    session.values.set(\"js-null\", JS_NULL);\n    session.values.set(\"js-undefined\", JS_UNDEFINED);\n    fns.set(\"js-false-p\", (x) => (x === JS_FALSE ? true : null));\n    fns.set(\"js-null-p\", (x) => (x === JS_NULL ? true : null));\n    fns.set(\"js-undefined-p\", (x) => (x === JS_UNDEFINED ? true : null));\n    fns.set(\"js-nullish-p\", (x) => (x === JS_NULL || x === JS_UNDEFINED ? true : null));\n    fns.set(\"js-object\", (...kvs) => {\n      const props = new Map();\n      for (let i = 0; i < kvs.length; i += 2) {\n        const k = isKw(kvs[i]) ? kvs[i].name.slice(1) : String(kvs[i]);\n        props.set(k, kvs[i + 1]);\n      }\n      return { kind: \"js-object\", props };\n    });\n    fns.set(\"js-get-raw\", (obj, key) => {\n      const k = isKw(key) ? key.name.slice(1) : String(key);\n      if (obj?.kind === \"js-object\") {\n        return obj.props.has(k) ? obj.props.get(k) : JS_UNDEFINED;\n      }\n      return JS_UNDEFINED;\n    });\n    fns.set(\"js-get\", (obj, key) => {\n      const raw = fns.get(\"js-get-raw\")(obj, key);\n      if (raw === JS_FALSE || raw === JS_NULL || raw === JS_UNDEFINED) return null;\n      return raw;\n    });\n    fns.set(\"js-divide\", (a, b) => a / b);\n    fns.set(\"js-remainder\", (a, b) => a % b);\n    fns.set(\"js-length\", (s) => String(s).length);\n    fns.set(\"js-substring\", (s, start, end) => String(s).slice(start, end));\n    fns.set(\"js-regexp\", (pat, flags = \"\") => new RegExp(pat, flags));\n    fns.set(\"js-regexp-find\", (rx, str) => {\n      const m = rx.exec(str);\n      if (!m) return null;\n      return makePersistentMap([\n        kw(\":match\"), m[0],\n        kw(\":start\"), m.index,\n        kw(\":end\"), m.index + m[0].length,\n      ]);\n    });\n  }\n  if (libName === \"eliscript-abi\") {\n    fns.set(\"mem-store-u32\", (offset, val) => {\n      if (!session.abiMemory || offset < 0 || offset + 4 > session.abiMemory.byteLength) {\n        throw new Error(\"ABI linear memory out of bounds\");\n      }\n      new DataView(session.abiMemory).setUint32(offset, val >>> 0, true);\n      return null;\n    });\n    fns.set(\"mem-load-u32\", (offset) => {\n      if (!session.abiMemory || offset < 0 || offset + 4 > session.abiMemory.byteLength) {\n        throw new Error(\"ABI linear memory out of bounds\");\n      }\n      return new DataView(session.abiMemory).getUint32(offset, true);\n    });\n    fns.set(\"word-add\", (a, b) => ((a >>> 0) + (b >>> 0)) >>> 0);\n    fns.set(\"word-sub\", (a, b) => ((a >>> 0) - (b >>> 0)) >>> 0);\n    fns.set(\"word-mul\", (a, b) => Math.imul(a >>> 0, b >>> 0) >>> 0);\n    fns.set(\"word-div\", (a, b) => {\n      if ((b >>> 0) === 0) signalError(\"arith-error\", \"word-div by zero\");\n      return Math.trunc((a >>> 0) / (b >>> 0)) >>> 0;\n    });\n  }\n}\n\nfunction jsonValueToPersistent(v) {\n  if (Array.isArray(v)) return makePersistentVector(v.map(jsonValueToPersistent));\n  if (v && typeof v === \"object\") {\n    const kvs = [];\n    for (const [k, val] of Object.entries(v)) {\n      kvs.push(kw(`:${k}`), jsonValueToPersistent(val));\n    }\n    return makePersistentMap(kvs);\n  }\n  return v;\n}\n\nfunction validateStructField(sname, fspec, val) {\n  if (fspec.type === \"string\" && typeof val !== \"string\") {\n    throw new Error(`Schema type mismatch on ${sname}.${fspec.name}: expected string`);\n  }\n  if (fspec.type === \"integer\" && !Number.isInteger(val)) {\n    throw new Error(`Schema type mismatch on ${sname}.${fspec.name}: expected integer`);\n  }\n  if (fspec.min !== null && typeof val === \"number\" && val < fspec.min) {\n    throw new Error(`Schema min violation on ${sname}.${fspec.name}: ${val} < ${fspec.min}`);\n  }\n  if (fspec.max !== null && typeof val === \"number\" && val > fspec.max) {\n    throw new Error(`Schema max violation on ${sname}.${fspec.name}: ${val} > ${fspec.max}`);\n  }\n}\n\nfunction invokeCallable(session, fn, args) {\n  if (typeof fn === \"function\") return fn(...args);\n  if (isSym(fn)) {\n    const target = session.functions.get(fn.name);\n    if (!target) signalError(\"void-function\", fn.name);\n    return target(...args);\n  }\n  signalError(\"void-function\", String(fn));\n}\n\n// ============================================================================\n// 5. Destructuring, Backquote, Static Checks & Form Evaluation\n// ============================================================================\n\nfunction collectDestructureVars(pat, seen = new Set()) {\n  if (pat === null || isKw(pat, \":none\") || isSym(pat, \"_\") || isKw(pat)) return seen;\n  if (isSym(pat)) {\n    if (seen.has(pat.name)) {\n      signalError(\"eliscript-compile-error\", `ELI-B0010: duplicate