                        (try
                          (if (js-call fs :existsSync p)
                              (progn (js-call fs :accessSync p (get (get fs :constants) :W_OK)) t)
                            (let ((dir (if (nullish? path-mod) "/" (js-call path-mod :dirname p))))
                              (js-call fs :accessSync dir (get (get fs :constants) :W_OK))
                              t))
                          (catch e false))))))))
      (funcall d "file-symlink-p"
               (lambda (f)
                 (let ((fs (el-fs)))
                   (if (or (nullish? fs) (not (el-string? f))) nil
                     (let ((p (el-expand-file-name session f nil)))
                       (try
                         (if (js-call (js-call fs :lstatSync p) :isSymbolicLink)
                             (js-call fs :readlinkSync p)
                           nil)
                         (catch e nil)))))))
      (funcall d "file-accessible-directory-p"
               (lambda (f)
