                               (not (nil? (el-call session (el-intern "file-readable-p") (js-array f))))))))
      (funcall d "file-remote-p" (lambda (f &optional id connected) nil))
      (funcall d "file-in-directory-p"
               (lambda (file dir)
                 (let* ((tf (js-call (el-file-truename session file) :replace (new globalThis.RegExp "/+$") ""))
                        (td (js-call (el-file-truename session dir) :replace (new globalThis.RegExp "/+$") "")))
                   (el-bool (or (= tf td) (= td "") (js-call tf :startsWith (str td "/")))))))
      (funcall d "file-newer-than-file-p"
               (lambda (f1 f2)
                 (let ((fs (el-fs)))
                   (if (nullish? fs) nil
