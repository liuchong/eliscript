const items = pat.items;\n    const restIdx = items.findIndex((x) => isSym(x, \"&rest\"));\n    if (restIdx !== -1) {\n      if (val.items.length < restIdx) {\n        throw new Error(\"Destructuring vector length mismatch\");\n      }\n      for (let i = 0; i < restIdx; i += 1) {\n        matchPattern(session, items[i], val.items[i], env);\n      }\n      const tailItems = val.items.slice(restIdx);\n      const tailVal =\n        val.kind === \"persistent-vector\"\n          ? makePersistentVector(tailItems)\n          : makeNativeVector(tailItems);\n      matchPattern(session, items[restIdx + 1], tailVal, env);\n    } else {\n      if (val.items.length !== items.length) {\n        throw new Error(\"Destructuring vector length mismatch\");\n      }\n      for (let i = 0; i < items.length; i += 1) {\n        matchPattern(session, items[i], val.items[i], env);\n      }\n    }\n    return;\n  }\n  if (pat.kind === \"cons\") {\n    const arr = consListToArray(pat);\n    const head = arr[0];\n    if (isKw(head, \":list\")) {\n      if (val !== null && val?.kind !== \"cons\" && val?.kind !== \"persistent-list\") {\n        throw new Error(\"Destructuring :list requires list or persistent-list\");\n      }\n      const elems = val === null ? [] : val.kind === \"persistent-list\" ? val.items : consListToArray(val);\n      const subPats = arr.slice(1);\n      const restIdx = subPats.findIndex((x) => isSym(x, \"&rest\"));\n      if (restIdx !== -1) {\n        if (elems.length < restIdx) throw new Error(\"Destructuring :list length mismatch\");\n        for (let i = 0; i < restIdx; i += 1) {\n          matchPattern(session, subPats[i], elems[i], env);\n        }\n        const tailElems = elems.slice(restIdx);\n        const tailVal =\n          val?.kind === \"persistent-list\"\n            ? makePersistentList(tailElems)\n            : arrayToConsList(tailElems);\n        matchPattern(session, subPats[restIdx + 1], tailVal, env);\n      } else {\n        if (elems.length !== subPats.length) throw new Error(\"Destructuring :list length mismatch\");\n        for (let i = 0; i < subPats.length; i += 1) {\n          matchPattern(session, subPats[i], elems[i], env);\n        }\n      }\n      return;\n    }\n    if (isKw(head, \":map\")) {\n      for (const entry of arr.slice(1)) {\n        const [k, sub] = consListToArray(entry);\n        if (sub?.kind === \"cons\" && isSym(sub.car, \"default\")) {\n          const [, targetPat, defExpr] = consListToArray(sub);\n          if (valueContains(val, k)) {\n            matchPattern(session, targetPat, valueGet(val, k), env);\n          } else {\n            matchPattern(session, targetPat, evalForm(session, defExpr, env), env);\n          }\n        } else {\n          if (!valueContains(val, k)) {\n            throw new Error(`Destructuring :map missing required key ${k.name ?? k}`);\n          }\n          matchPattern(session, sub, valueGet(val, k), env);\n        }\n      }\n      return;\n    }\n    if (isKw(head, \":record\")) {\n      const recName = arr[1].name;\n      if (val?.kind !== \"persistent-record\" || val.typeName !== recName) {\n        throw new Error(`Destructuring :record expected ${recName}`);\n      }\n      for (const entry of arr.slice(2)) {\n        const [k, sub] = consListToArray(entry);\n        matchPattern(session, sub, valueGet(val, k), env);\n      }\n      return;\n    }\n    if (isKw(head, \":ok\")) {\n      if (val?.kind !== \"result\" || !val.ok) throw new Error(\"Destructuring :ok mismatch\");\n      matchPattern(session, arr[1], val.value, env);\n      return;\n    }\n    if (isKw(head, \":some\")) {\n      if (val?.kind !== \"option\" || !val.some) throw new Error(\"Destructuring :some mismatch\");\n      matchPattern(session, arr[1], val.value, env);\n      return;\n    }\n  }\n  if (!valueEqual(pat, val)) throw new Error(\"Destructuring literal mismatch\");\n}\n\nfunction evalBackquote(session, form, env) {\n  if (!form || form.kind !== \"cons\") return form;\n  const arr = consListToArray(form);\n  if (isSym(arr[0], \"unquote\")) return evalForm(session, arr[1], env);\n  const out = [];\n  for (const item of arr) {\n    if (item && item.kind === \"cons\" && isSym(item.car, \"unquote-splicing\")) {\n      const spliced = consListToArray(evalForm(session, consListToArray(item)[1], env));\n      out.push(...spliced);\n    } else {\n      out.push(evalBackquote(session, item, env));\n    }\n  }\n  return arrayToConsList(out);\n}\n\nfunction extractDeclareAndBody(rawBody) {\n  let idx = 0;\n  const eliProps = new Map();\n  while (idx < rawBody.length) {\n    const f = rawBody[idx];\n    if (typeof f === \"string\" && idx + 1 < rawBody.length) {\n      idx += 1;\n      continue;\n    }\n    if (f?.kind === \"cons\" && isSym(f.car, \"declare\")) {\n      const specs = consListToArray(f).slice(1);\n      for (const sp of specs) {\n        const spArr = consListToArray(sp);\n        if (isSym(spArr[0], \"eliscript\")) {\n          for (let i = 1; i < spArr.length; i += 2) {\n            eliProps.set(spArr[i].name, spArr[i + 1]);\n          }\n        }\n      }\n      idx += 1;\n      continue;\n    }\n    break;\n  }\n  return { eliProps, body: rawBody.slice(idx) };\n}\n\nfunction scanTreeForHead(forms, forbiddenHeads, stopAtSyncLambda = false) {\n  for (const f of forms) {\n    if (!f || f.kind !== \"cons\") continue;\n    const arr = consListToArray(f);\n    const head = arr[0];\n    if (isSym(head, \"quote\")) continue;\n    if (isSym(head) && forbiddenHeads.has(head.name)) {\n      return head.name;\n    }\n    if (stopAtSyncLambda && (isSym(head, \"lambda\") || isSym(head, \"defun\"))) {\n      continue;\n    }\n    const hit = scanTreeForHead(arr.slice(1), forbiddenHeads, stopAtSyncLambda);\n    if (hit) return hit;\n  }\n  return null;\n}\n\nfunction verifyRecurTailPosition(forms, tailAllowed) {\n  for (let i = 0; i < forms.length; i += 1) {\n    const f = forms[i];\n    const isLast = tailAllowed && i === forms.length - 1;\n    if (!f || f.kind !== \"cons\") continue;\n    const arr = consListToArray(f);\n    const head = arr[0];\n    if (isSym(head, \"quote\")) continue;\n    if (isSym(head, \"recur\")) {\n      if (!isLast) {\n        signalError(\"eliscript-compile-error\", \"ELI-R0001: recur must be in tail position\");\n      }\n      verifyRecurTailPosition(arr.slice(1), false);\n    } else if (isSym(head, \"if\")) {\n      verifyRecurTailPosition([arr[1]], false);\n      verifyRecurTailPosition([arr[2]], isLast);\n      verifyRecurTailPosition(arr.slice(3), isLast);\n    } else if (isSym(head, \"progn\")) {\n      verifyRecurTailPosition(arr.slice(1), isLast);\n    } else if (isSym(head, \"let\") || isSym(head, \"let*\") || isSym(head, \"let-const\")) {\n      verifyRecurTailPosition(arr.slice(2), isLast);\n    } else if (isSym(head, \"let-loop\") || isSym(head, \"defun-tail\") || isSym(head, \"lambda-tail\")) {\n      continue;\n    } else {\n      verifyRecurTailPosition(arr.slice(1), false);\n    }\n  }\n}\n\nfunction validateFunctionDeclarations(kind, name, eliProps, body) {\n  if (kind === \"defun\") {\n    if (eliProps.get(\":async\") === true) {\n      signalError(\"eliscript-compile-error\", `ELI-D0001: ordinary defun ${name} cannot declare :async t`);\n    }\n    if (eliProps.get(\":destructure\") === true) {\n      signalError(\"eliscript-compile-error\", `ELI-D0002: ordinary defun ${name} cannot declare :destructure t`);\n    }\n    const syncAwait = scanTreeForHead(body, new Set([\"await\"]));\n    if (syncAwait) {\n      signalError(\"eliscript-compile-error\", `ELI-A0001: await is forbidden in sync defun ${name}`);\n    }\n  }\n  if (eliProps.get(\":portable\") === true) {\n    const bad = scanTreeForHead(body, new Set([\"current-buffer\", \"set-buffer\", \"with-current-buffer\"]));\n    if (bad) {\n      signalError(\"eliscript-compile-error\", `ELI-C0002: non-portable operator ${bad} in ${name}`);\n    }\n  }\n  if (eliProps.has(\":abi\")) {\n    const abi = eliProps.get(\":abi\");\n    if (isKw(abi, \":numeric-f64\")) {\n      const bad = scanTreeForHead(body, new Set([\"list\", \"cons\", \"vector\", \"persistent-list\"]));\n      if (bad) {\n        signalError(\"eliscript-compile-error\", `ELI-B0001: heap allocation ${bad} forbidden in :numeric-f64 ${name}`);\n      }\n    }\n  }\n}\n\nfunction evalSeq(session, forms, env) {\n  let last = null;\n  for (const f of forms) {\n    last = evalForm(session, f, env);\n  }\n  return last;\n}\n\nfunction evalForm(session, form, env) {\n  if (form && form.kind === \"float-lit\") return form.value;\n  if (form === null || form === true || typeof form === \"number\" || typeof form === \"string\") {\n    return form;\n  }\n  if (isKw(form) || form.kind === \"vector\") return form;\n  if (isSym(form)) {\n    if (session.specialVars.has(form.name)) {\n      return session.values.get(form.name) ?? null;\n    }\n    if (env.hasVar(form.name)) return env.getVar(form.name);\n    if (session.liveValueGetters.has(form.name)) return session.liveValueGetters.get(form.name)();\n    if (session.values.has(form.name)) return session.values.get(form.name);\n    signalError(\"void-variable\", form.name);\n  }\n  if (form.kind !== \"cons\") return form;\n\n  const arr = consListToArray(form);\n  const head = arr[0];\n  if (!isSym(head)) {\n    signalError(\"void-function\", String(head));\n  }\n  const hname = head.name;\n\n  // Macro expansion check\n  if (session.macros.has(hname)) {\n    const macroFn = session.macros.get(hname);\n    const expanded = macroFn(...arr.slice(1));\n    return evalForm(session, expanded, env);\n  }\n\n  if (hname === \"/\") {\n    const rawArgs = arr.slice(1);\n    const hasFloatLit = rawArgs.some((a) => a && a.kind === \"float-lit\");\n    const nums = rawArgs.map((a) => evalForm(session, a, env));\n    if (nums.length === 1) {\n      if (nums[0] === 0) signalError(\"arith-error\", \"Division by zero\");\n      return 1 / nums[0];\n    }\n    let acc = nums[0];\n    let allInt = !hasFloatLit && Number.isInteger(nums[0]);\n    for (const d of nums.slice(1)) {\n      if (d === 0) signalError(\"arith-error\", \"Division by zero\");\n      allInt = allInt && Number.isInteger(d);\n      acc = allInt ? Math.trunc(acc / d) : acc / d;\n    }\n    return acc;\n  }\n  if (hname === \"quote\") return arr[1] ?? null;\n  if (hname === \"backquote\") return evalBackquote(session, arr[1], env);\n  if (hname === \"function\") {\n    const target = arr[1];\n    if (isSym(target)) {\n      return (...callArgs) => {\n        const fn = env.getFn(target.name) ?? session.functions.get(target.name);\n        if (!fn) signalError(\"void-function\", target.name);\n        return fn(...callArgs);\n      };\n    }\n    return evalForm(session, target, env);\n  }\n  if (hname === \"progn\") return evalSeq(session, arr.slice(1), env);\n  if (hname === \"prog1\") {\n    const firstVal = evalForm(session, arr[1], env);\n    evalSeq(session, arr.slice(2), env);\n    return firstVal;\n  }\n  if (hname === \"if\") {\n    const cond = evalForm(session, arr[1], env);\n    if (isTruthy(cond)) return evalForm(session, arr[2], env);\n    return evalSeq(session, arr.slice(3), env);\n  }\n  if (hname === \"when\") {\n    return isTruthy(evalForm(session, arr[1], env)) ? evalSeq(session, arr.slice(2), env) : null;\n  }\n  if (hname === \"unless\") {\n    return !isTruthy(evalForm(session, arr[1], env)) ? evalSeq(session, arr.slice(2), env) : null;\n  }\n  if (hname === \"and\") {\n    let last = true;\n    for (const sub of arr.slice(1)) {\n      last = evalForm(session, sub, env);\n      if (!isTruthy(last)) return null;\n    }\n    return last;\n  }\n  if (hname === \"or\") {\n    for (const sub of arr.slice(1)) {\n      const v = evalForm(session, sub, env);\n      if (isTruthy(v)) return v;\n    }\n    return null;\n  }\n  if (hname === \"cond\") {\n    for (const clause of arr.slice(1)) {\n      const cArr = consListToArray(clause);\n      const test