(module eliscript.runtime.source-mapping
  (defconst base64Vlq "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")

  (defun SourceMappingError (code message)
    (let ((err (new globalThis.Error message)))
      (Object/setPrototypeOf err (get SourceMappingError :prototype))
      (put err :name "SourceMappingError")
      (put err :code code)
      err))
  (Object/setPrototypeOf SourceMappingError globalThis.Error)
  (put SourceMappingError :prototype (Object/create (get globalThis.Error :prototype)))
  (Object/defineProperty (get SourceMappingError :prototype) "constructor"
    (js-object :value SourceMappingError :writable t :configurable t))
  (Object/defineProperty SourceMappingError "name"
    (js-object :value "SourceMappingError" :configurable t))

  (defun fail (code message)
    (throw (new SourceMappingError code message)))

  (defun isPlainObject (value)
    (and (not (nil? value))
         (eq (value-type value) "object")
         (not (Array/isArray value))))

  (defun decodeVlq (segment)
    (let ((values (js-array))
          (index 0))
      (while (< index (js-length segment))
        (let ((value 0)
              (shift 0)
              (continuation t))
          (while continuation
            (when (>= index (js-length segment))
              (fail "invalid-vlq" "unterminated Base64 VLQ value"))
            (let ((digit (js-call base64Vlq :indexOf (aref segment index))))
              (when (eq digit -1)
                (fail "invalid-vlq" "invalid Base64 VLQ digit"))
              (setq index (1+ index)
                    value (+ value (* (bit-and digit 31) (Math/pow 2 shift)))
                    continuation (not (eq (bit-and digit 32) 0))
                    shift (+ shift 5))
              (when (> shift 50)
                (fail "invalid-vlq" "Base64 VLQ value exceeds safe bounds"))))
          (let ((negative (eq (bit-and value 1) 1))
                (magnitude (Math/floor (/ value 2))))
            (js-call values :push (if negative (- magnitude) magnitude)))))
      values))

  (defun decodeSourceMappings (mappings)
    (unless (eq (value-type mappings) "string")
      (fail "invalid-mappings" "source mappings must be a string"))
    (let ((source 0)
          (originalLine 0)
          (originalColumn 0))
      (Object/freeze
        (js-call (js-call mappings :split ";") :map
          (lambda (encodedLine)
            (let ((generatedColumn 0)
                  (line (js-array))
                  (parts (js-call encodedLine :split ","))
                  (i 0))
              (while (< i (js-length parts))
                (let ((encoded (aref parts i)))
                  (when (> (js-length encoded) 0)
                    (let ((values (decodeVlq encoded)))
                      (unless (js-call (js-array 1 4 5) :includes (js-length values))
                        (fail "invalid-segment" "source map segments must contain 1, 4, or 5 fields"))
                      (setq generatedColumn (+ generatedColumn (aref values 0)))
                      (when (< generatedColumn 0)
                        (fail "invalid-segment" "generated source map columns must not be negative"))
                      (let ((decoded (js-object :generatedColumn generatedColumn)))
                        (when (>= (js-length values) 4)
                          (setq source (+ source (aref values 1))
                                originalLine (+ originalLine (aref values 2))
                                originalColumn (+ originalColumn (aref values 3)))
                          (when (or (< source 0) (< originalLine 0) (< originalColumn 0))
                            (fail "invalid-segment" "decoded source map positions must not be negative"))
                          (put decoded :source source)
                          (put decoded :originalLine originalLine)
                          (put decoded :originalColumn originalColumn))
                        (js-call line :push (Object/freeze decoded))))))
                (setq i (1+ i)))
              (Object/freeze line)))))))

  (defun sourceMapDescriptor (value)
    (when (or (not (isPlainObject value))
              (not (eq (value-type (get value :generatedFile)) "string"))
              (eq (js-length (get value :generatedFile)) 0)
              (not (Array/isArray (get value :sources)))
              (eq (js-length (get value :sources)) 0)
              (js-call (get value :sources) :some
                (lambda (source)
                  (or (not (eq (value-type source) "string"))
                      (eq (js-length source) 0)))))
      (fail "invalid-source-map"
            "source map descriptor requires generatedFile sources and mappings"))
    (let ((lines (if (undefined? (get value :lines))
                     (decodeSourceMappings (get value :mappings))
                   (get value :lines))))
      (when (or (not (Array/isArray lines))
                (js-call lines :some (lambda (line) (not (Array/isArray line)))))
        (fail "invalid-source-map" "source map descriptor lines must be arrays"))
      (let ((i 0))
        (while (< i (js-length lines))
          (let ((line (aref lines i))
                (j 0))
            (while (< j (js-length line))
              (let ((segment (aref line j)))
                (when (or (not (isPlainObject segment))
                          (not (Number/isInteger (get segment :generatedColumn)))
                          (< (get segment :generatedColumn) 0)
                          (and (not (undefined? (get segment :source)))
                               (or (not (Number/isInteger (get segment :source)))
                                   (< (get segment :source) 0)
                                   (not (Number/isInteger (get segment :originalLine)))
                                   (< (get segment :originalLine) 0)
                                   (not (Number/isInteger (get segment :originalColumn)))
                                   (< (get segment :originalColumn) 0))))
                  (fail "invalid-source-map" "source map descriptor contains an invalid segment")))
              (setq j (1+ j))))
          (setq i (1+ i))))
      (Object/freeze
        (js-object
          :generatedFile (get value :generatedFile)
          :sources (Object/freeze (Array/from (get value :sources)))
          :lines (Object/freeze
                   (js-call lines :map
                     (lambda (line)
                       (Object/freeze
                         (js-call line :map
                           (lambda (segment)
                             (Object/freeze (Object/assign (js-object) segment))))))))))))

  (defconst v8-stack-pattern (new globalThis.RegExp "^\\s*at (?:(.*?) \\()?(.+):(\\d+):(\\d+)\\)?$" "u"))
  (defconst browser-stack-pattern (new globalThis.RegExp "^(.*?)@(.+):(\\d+):(\\d+)$" "u"))
  (defconst query-hash-pattern (new globalThis.RegExp "[?#].*$" "u"))

  (defun parseJavaScriptStack (stack &rest __opt)
    (let* ((options (aref __opt 0))
           (opts (if (undefined? options) (js-object) options)))
      (if (not (eq (value-type stack) "string"))
          (Object/freeze (js-array))
        (let ((normalizeFile (if (eq (value-type (get opts :normalizeFile)) "function")
                                 (get opts :normalizeFile)
                               (lambda (file) file)))
              (frames (js-array))
              (lines (js-call stack :split "\n"))
              (i 0))
          (while (< i (js-length lines))
            (let* ((line (aref lines i))
                   (v8 (js-call v8-stack-pattern :exec line))
                   (browser (if v8 nil (js-call browser-stack-pattern :exec (js-call line :trim))))
                   (match (or v8 browser)))
              (when match
                (js-call frames :push
                  (Object/freeze
                    (js-object
                      :function (or (aref match 1) undefined)
                      :file (funcall normalizeFile (aref match 2))
                      :line (funcall globalThis.Number (aref match 3))
                      :column (funcall globalThis.Number (aref match 4)))))))
            (setq i (1+ i)))
          (Object/freeze frames)))))
  (Object/defineProperty parseJavaScriptStack "length" (js-object :value 1 :configurable t))

  (defun cleanIdentity (value)
    (try
      (let ((url (new globalThis.URL value)))
        (put url :search "")
        (put url :hash "")
        (get url :href))
      (catch _error
        (js-call value :replace query-hash-pattern ""))))

  (defun sourceIdentities (value)
    (let* ((clean (cleanIdentity value))
           (identities (js-array clean)))
      (try
        (let ((url (new globalThis.URL clean)))
          (when (eq (get url :protocol) "file:")
            (js-call identities :push (globalThis.decodeURIComponent (get url :pathname)))))
        (catch _error nil))
      identities))

  (defun mapSourceFrames (frames sourceMaps)
    (unless (and (Array/isArray frames) (Array/isArray sourceMaps))
      (fail "invalid-frames" "frames and source maps must be arrays"))
    (let ((mapsByFile (new globalThis.Map))
          (i 0))
      (while (< i (js-length sourceMaps))
        (let* ((sourceMap (aref sourceMaps i))
               (identities (sourceIdentities (get sourceMap :generatedFile)))
               (j 0))
          (while (< j (js-length identities))
            (js-call mapsByFile :set (aref identities j) sourceMap)
            (setq j (1+ j))))
        (setq i (1+ i)))
      (Object/freeze
        (js-call frames :map
          (lambda (frame)
            (let* ((identities (sourceIdentities (get frame :file)))
                   (candidates (js-call identities :map (lambda (id) (js-call mapsByFile :get id))))
                   (sourceMap (js-call candidates :find (lambda (item) (funcall globalThis.Boolean item))))
                   (mapping (if sourceMap
                                (aref (get sourceMap :lines) (1- (get frame :line)))
                              undefined)))
              (if (not mapping)
                  frame
                (let ((generatedColumn (Math/max 0 (1- (get frame :column))))
                      (segment undefined)
                      (k 0)
                      (done false))
                  (while (and (< k (js-length mapping)) (not done))
                    (let ((candidate (aref mapping k)))
                      (if (> (get candidate :generatedColumn) generatedColumn)
                          (setq done t)
                        (setq segment candidate)))
                    (setq k (1+ k)))
                  (if (or (not segment)
                          (undefined? (get segment :source))
                          (undefined? (aref (get sourceMap :sources) (get segment :source))))
                      frame
                    (Object/freeze
                      (Object/assign
                        (js-object)
                        frame
                        (js-object
                          :generated (Object/freeze
                                       (js-object :file (get frame :file)
                                                  :line (get frame :line)
                                                  :column (get frame :column)))
                          :file (aref (get sourceMap :sources) (get segment :source))
                          :line (1+ (get segment :originalLine))
                          :column (1+ (get segment :originalColumn))))))))))))))

  (defun sourceMappedFailure (error sourceMaps &rest __opt)
    (let* ((options (aref __opt 0))
           (opts (if (undefined? options) (js-object) options))
           (stack (if (and (not (nullish? error)) (eq (value-type (get error :stack)) "string"))
                      (get error :stack)
                    undefined))
           (frames (if stack
                       (mapSourceFrames (parseJavaScriptStack stack opts) sourceMaps)
                     (Object/freeze (js-array))))
           (eli-frame (js-call frames :find (lambda (frame) (js-call (get frame :file) :endsWith ".eli"))))
           (location (or eli-frame (aref frames 0)))
           (result (js-object
                     :name (if (and (not (nullish? error)) (eq (value-type (get error :name)) "string"))
                               (get error :name)
                             "Error")
                     :message (if (and (not (nullish? error)) (eq (value-type (get error :message)) "string"))
                                  (get error :message)
                                (funcall globalThis.String error)))))
      (when stack
        (put result :stack stack))
      (put result :frames frames)
      (when location
        (put result :location location))
      (Object/freeze result)))
  (Object/defineProperty sourceMappedFailure "length" (js-object :value 2 :configurable t))

  (export SourceMappingError
          decodeSourceMappings
          sourceMapDescriptor
          parseJavaScriptStack
          mapSourceFrames
          sourceMappedFailure))
