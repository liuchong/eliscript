#!/usr/bin/env sh
set -eu

SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$DIR/$SOURCE" ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
PROJECT_DIR=$(dirname -- "$SCRIPT_DIR")
: "${EMACS:=emacs}"

exec "$EMACS" --batch -Q \
  --script "$PROJECT_DIR/compiler/eliscript-project-cli.el" \
  -- "$@"
