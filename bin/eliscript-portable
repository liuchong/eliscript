#!/usr/bin/env sh
set -eu

SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$DIR/$SOURCE" ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
PROJECT_DIR=$(dirname -- "$SCRIPT_DIR")
: "${BUN:=bun}"
: "${ELISCRIPT_BOOTSTRAP_MODULE_DIR:=$PROJECT_DIR/dist/bootstrap}"

if [ ! -f "$ELISCRIPT_BOOTSTRAP_MODULE_DIR/compiler.mjs" ]; then
  printf '%s\n' \
    'eliscript: portable compiler is missing; run bun run build:bootstrap first' \
    >&2
  exit 1
fi

HOST_DIR="$PROJECT_DIR/dist/host-cli"
if [ -f "$PROJECT_DIR/bootstrap/host/bun.mjs" ]; then
  HOST_DIR="$PROJECT_DIR/bootstrap/host"
fi

export ELISCRIPT_BOOTSTRAP_MODULE_DIR
exec "$BUN" "$HOST_DIR/bun.mjs" "$@"
