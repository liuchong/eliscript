#!/usr/bin/env sh
set -eu

SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$DIR/$SOURCE" ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
PROJECT_DIR=$(dirname -- "$SCRIPT_DIR")
: "${ELISCRIPT_BATCH_RUNTIME:=node}"

SESSION_OUT_DIR="$PROJECT_DIR/dist/session"
SESSION_MJS="$SESSION_OUT_DIR/session.mjs"
NEEDS_BUILD=0
if [ ! -f "$SESSION_MJS" ]; then
  NEEDS_BUILD=1
else
  for f in "$PROJECT_DIR/runtime/session.eli" "$PROJECT_DIR"/runtime/session/*.eli; do
    if [ -f "$f" ] && [ "$f" -nt "$SESSION_MJS" ]; then
      NEEDS_BUILD=1
      break
    fi
  done
fi

if [ "$NEEDS_BUILD" -eq 1 ]; then
  "$PROJECT_DIR/bin/eliscript-build" --root "$PROJECT_DIR/runtime" --out-dir "$SESSION_OUT_DIR" "$PROJECT_DIR/runtime/session.eli" >/dev/null
fi

export ELISCRIPT_COMMAND_NAME=eliscript-batch
export ELISCRIPT_INVOCATION_DIR="$SCRIPT_DIR/"
exec "$ELISCRIPT_BATCH_RUNTIME" "$SESSION_MJS" "$@"
