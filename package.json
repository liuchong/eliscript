{
  "name": "eliscript",
  "version": "0.0.4",
  "description": "An Emacs Lisp-flavored language that compiles to modern JavaScript.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuchong/eliscript.git"
  },
  "keywords": [
    "lisp",
    "emacs-lisp",
    "compiler",
    "esm",
    "persistent-data"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    "./runtime/math.mjs": "./runtime/math.mjs",
    "./runtime/unicode-case": "./runtime/unicode-case.mjs",
    "./runtime/unicode-case.mjs": "./runtime/unicode-case.mjs",
    "./compiler": "./dist/bootstrap/compiler.mjs",
    "./compiler.mjs": "./dist/bootstrap/compiler.mjs",
    "./compiler-session": "./tools/backends/compiler-session.mjs",
    "./compiler-worker": "./tools/backends/compiler-worker.mjs",
    "./compiler-debug": "./tools/backends/compiler-debug.mjs",
    "./browser/compiler-session": "./tools/backends/compiler-browser.mjs",
    "./browser": "./browser/host.mjs",
    "./browser/host.mjs": "./browser/host.mjs",
    "./browser/loader": "./dist/browser/loader.js",
    "./browser/worker.mjs": "./browser/worker.mjs",
    "./browser/compiler": "./dist/browser/compiler.js",
    "./runtime/literals": "./runtime/literals.mjs",
    "./runtime/literals.mjs": "./runtime/literals.mjs",
    "./runtime/source-mapping": "./runtime/source-mapping.mjs",
    "./runtime/source-mapping.mjs": "./runtime/source-mapping.mjs",
    "./runtime/worker-value-stream": "./runtime/worker-value-stream.mjs",
    "./runtime/worker-value-stream.mjs": "./runtime/worker-value-stream.mjs",
    "./platform/browser": "./platform/browser.mjs",
    "./platform/browser.mjs": "./platform/browser.mjs",
    "./platform/worker": "./platform/worker.mjs",
    "./platform/worker.mjs": "./platform/worker.mjs",
    "./platform/http": "./platform/http.mjs",
    "./platform/http.mjs": "./platform/http.mjs",
    "./runtime/core/*": "./runtime/core/*.mjs",
    "./runtime/core/*.mjs": "./runtime/core/*.mjs",
    "./runtime/wire/*": "./runtime/wire/*.mjs",
    "./runtime/wire/*.mjs": "./runtime/wire/*.mjs",
    "./runtime/testing/*": "./runtime/testing/*.mjs",
    "./runtime/testing/*.mjs": "./runtime/testing/*.mjs",
    "./dist/stdlib/*": "./dist/stdlib/*.mjs",
    "./dist/stdlib/*.mjs": "./dist/stdlib/*.mjs",
    "./*": "./*"
  },
  "scripts": {
    "prepack": "make prepare-release-package",
    "build:browser": "bun build dist/bootstrap/compiler.mjs --target=browser --format=esm --minify --outfile dist/browser/compiler.js && ./bin/eliscript --output dist/browser/loader.mjs docs/pages/loader.eli && bun build dist/browser/loader.mjs --target=browser --format=iife --minify --outfile dist/browser/loader.js && cp browser/worker.mjs dist/browser/worker.mjs && sed 's|../dist/browser/compiler.js|./compiler.js|g' browser/host.mjs > dist/browser/host.mjs",
    "test": "make test",
    "test:core": "make test-core",
    "test:applications": "make test-applications",
    "check:contracts": "make check-contracts",
    "check:diagnostics": "bun tools/diagnostics/check.mjs",
    "check:compiler-parity": "bun tools/parity/check.mjs",
    "check:compatibility-corpus": "bun tools/compatibility/corpus.mjs",
    "check:compatibility-matrix": "bun tools/compatibility/matrix.mjs --verify-all",
    "check:source-debugging": "bun tools/debugging/check.mjs",
    "check:dogfood:browsers": "bun tools/browser/matrix.mjs --site examples/dogfood/_site --out examples/dogfood/evidence/browser-matrix.json",
    "check:dogfood": "./bin/eliscript --output dist/dogfood-spec-check.mjs examples/dogfood/tools/spec-check.eli && bun dist/dogfood-spec-check.mjs --root examples/dogfood",
    "build:docs-site": "./bin/eliscript --output dist/docs-site/loader.mjs docs/pages/loader.eli && bun build dist/docs-site/loader.mjs --target=browser --format=iife --minify --outfile dist/docs-site/site.js",
    "build:dogfood-browser": "./bin/eliscript-build --root examples/dogfood --out-dir examples/dogfood/dist/dogfood-browser examples/dogfood/src/renderer/browser.eli && bun build examples/dogfood/dist/dogfood-browser/src/renderer/browser.mjs --target=browser --format=iife --outfile examples/dogfood/dist/site/browser.js",
    "build:browser-playground": "./bin/eliscript-build --root examples/browser-playground/src --out-dir dist/browser-playground examples/browser-playground/src/playground.eli && cp examples/browser-playground/index.html examples/browser-playground/site.css dist/browser-playground/",
    "preview": "python3 -m http.server 8787 --bind 127.0.0.1",
    "build:dogfood": "./bin/eliscript-build --config examples/dogfood/eliscript.json",
    "dogfood": "bun run build:dogfood-browser && ./bin/eliscript-build --config examples/dogfood/eliscript.json && bun examples/dogfood/dist/src/builder/main.mjs --root examples/dogfood",
    "package:dogfood": "./bin/eliscript --output dist/dogfood-package.mjs examples/dogfood/tools/package.eli && node dist/dogfood-package.mjs --root .",
    "dogfood:action": "node examples/dogfood/dist/action/index.js --root examples/dogfood",
    "check:docs": "bun tools/documentation/check.mjs",
    "check:onboarding": "bun tools/onboarding/check.mjs --verify-run acceptance/runs/m13-02.json --verify-markdown acceptance/runs/m13-02.md",
    "check:compatibility-rehearsal": "bun tools/compatibility/rehearse.mjs --verify-run acceptance/runs/m13-03.json --verify-markdown acceptance/runs/m13-03.md",
    "check:integrity": "bun tools/integrity/check.mjs",
    "audit:dependencies": "bun tools/integrity/check.mjs --dependencies",
    "audit:artifacts": "bun tools/integrity/check.mjs --artifacts",
    "check:acceptance": "bun tools/acceptance/check.mjs --verify-run acceptance/runs/m13-01.json --verify-markdown acceptance/runs/m13-01.md",
    "check:repeated-determinism": "bun tools/acceptance/repeat.mjs --verify --json-report acceptance/runs/m13-04.json --markdown-report acceptance/runs/m13-04.md",
    "check:final-acceptance": "bun tools/acceptance/finalize.mjs --verify",
    "progress": "bun tools/progress/check.mjs",
    "generate:api": "bun tools/surface/generate-api.mjs",
    "format": "./bin/eliscript-format --write",
    "format:check": "./bin/eliscript-format --check",
    "compile:example": "./bin/eliscript --output dist/basic.mjs examples/basic/main.eli",
    "compile:sequence": "./bin/eliscript --source-map --output dist/stdlib/sequence.mjs stdlib/sequence.eli",
    "compile:text": "./bin/eliscript --source-map --output dist/stdlib/text.mjs stdlib/text.eli",
    "compile:object": "./bin/eliscript --source-map --output dist/stdlib/object.mjs stdlib/object.eli",
    "compile:bit": "./bin/eliscript --source-map --output dist/stdlib/bit.mjs stdlib/bit.eli",
    "compile:identifier": "./bin/eliscript --source-map --output dist/stdlib/identifier.mjs stdlib/identifier.eli",
    "compile:persistent-list": "./bin/eliscript --source-map --output dist/stdlib/persistent-list.mjs stdlib/persistent-list.eli",
    "compile:persistent-map": "./bin/eliscript --source-map --output dist/stdlib/persistent-map.mjs stdlib/persistent-map.eli",
    "compile:persistent-set": "./bin/eliscript-build --root stdlib --out-dir dist/stdlib stdlib/persistent-set.eli",
    "compile:persistent-vector": "./bin/eliscript --source-map --output dist/stdlib/persistent-vector.mjs stdlib/persistent-vector.eli",
    "compile:value": "./bin/eliscript-build --root stdlib --out-dir dist/stdlib stdlib/value.eli",
    "compile:metadata": "./bin/eliscript-build --root stdlib --out-dir dist/stdlib stdlib/metadata.eli",
    "compile:numeric": "./bin/eliscript-build --root stdlib --out-dir dist/stdlib stdlib/numeric.eli",
    "compile:result": "./bin/eliscript-build --root stdlib --out-dir dist/stdlib stdlib/result.eli",
    "compile:json": "./bin/eliscript-build --root stdlib --out-dir dist/stdlib stdlib/json.eli",
    "compile:data-text": "./bin/eliscript-build --root stdlib --out-dir dist/stdlib stdlib/data-text.eli",
    "compile:function": "./bin/eliscript-build --root stdlib --out-dir dist/stdlib stdlib/function.eli",
    "compile:deferred": "./bin/eliscript-build --root stdlib --out-dir dist/stdlib stdlib/deferred.eli",
    "compile:atom": "./bin/eliscript-build --root stdlib --out-dir dist/stdlib stdlib/state/atom.eli",
    "compile:interop": "./bin/eliscript-build --root stdlib --out-dir dist/stdlib stdlib/interop/js.eli",
    "compile:data": "./bin/eliscript-build --root stdlib --out-dir dist/stdlib stdlib/data.eli",
    "compile:stdlib": "bun run compile:bit && bun run compile:identifier && bun run compile:sequence && bun run compile:text && bun run compile:persistent-list && bun run compile:persistent-map && bun run compile:persistent-set && bun run compile:persistent-vector && bun run compile:value && bun run compile:metadata && bun run compile:numeric && bun run compile:result && bun run compile:json && bun run compile:data-text && bun run compile:function && bun run compile:deferred && bun run compile:atom && bun run compile:interop && bun run compile:data",
    "generate:runtime-protocol": "./bin/eliscript --source-map --output runtime/core/protocol-impl.mjs stdlib/core/protocol.eli",
    "generate:runtime-text": "./bin/eliscript --source-map --output runtime/core/text-impl.mjs stdlib/core/text.eli",
    "generate:runtime-object": "./bin/eliscript --source-map --output runtime/core/object-impl.mjs stdlib/core/object.eli",
    "generate:runtime-core": "bun run generate:runtime-protocol && bun run generate:runtime-text && bun run generate:runtime-object",
    "build:stdlib-cli": "./bin/eliscript-build --root . --out-dir dist/project examples/stdlib-cli/main.eli",
    "example": "bun run dist/basic.mjs",
    "compile:react-counter": "./bin/eliscript --source-map --output dist/react-counter.mjs examples/react-counter/main.eli",
    "react-counter": "bun run examples/react-counter/render.mjs",
    "dev:react-counter": "vite --config examples/react-counter/vite.config.mjs",
    "build:react-counter": "vite build --config examples/react-counter/vite.config.mjs",
    "preview:react-counter": "vite preview --config examples/react-counter/vite.config.mjs",
    "org:export": "./bin/eliscript-org --output dist/org-articles.mjs examples/org-site/content",
    "dev:org-site": "vite --config examples/org-site/vite.config.mjs",
    "build:org-site": "vite build --config examples/org-site/vite.config.mjs",
    "preview:org-site": "vite preview --config examples/org-site/vite.config.mjs",
    "build:bootstrap": "./bin/eliscript-bootstrap",
    "benchmark:worker": "${EMACS:-emacs} --batch -Q --script tools/worker/benchmark.el",
    "benchmark:core": "bun tools/performance/core-benchmark.mjs",
    "benchmark:version-comparison": "bun tools/performance/version-comparison.mjs",
    "benchmark:emacs-analysis": "${EMACS:-emacs} --batch -Q --script tools/worker/analysis-benchmark.el",
    "soak:emacs-analysis": "${EMACS:-emacs} --batch -Q --script tools/worker/analysis-soak.el",
    "soak:worker-lifecycle": "${EMACS:-emacs} --batch -Q --script tools/worker/lifecycle-soak.el",
    "probe:worker-values": "${EMACS:-emacs} --batch -Q --script tools/worker/value-stream-probe.el",
    "benchmark:hamt-layout": "bun tools/collections/benchmark.mjs",
    "benchmark:transient-builders": "bun tools/collections/transient-builder-benchmark.mjs",
    "benchmark:compiler-runtime-scan": "bun tools/compiler/runtime-scan-benchmark.mjs",
    "benchmark:compiler-ir-kind": "bun tools/compiler/ir-kind-benchmark.mjs",
    "benchmark:compiler-indent": "bun tools/compiler/indent-benchmark.mjs",
    "benchmark:compiler-locate": "bun tools/compiler/locate-benchmark.mjs",
    "benchmark:compiler-binary-comparison": "bun tools/compiler/binary-comparison-benchmark.mjs",
    "benchmark:compiler-reader-character": "bun tools/compiler/reader-character-benchmark.mjs",
    "benchmark:compiler-source-map-cursor": "bun tools/compiler/source-map-cursor-benchmark.mjs",
    "fuzz:reader-program": "bun tools/fuzz/reader-program-fuzz.mjs",
    "fuzz:persistent-semantics": "bun tools/collections/persistent-semantics.mjs",
    "scale:project": "bun tools/project/scale-invalidation.mjs"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.0"
  },
  "bin": {
    "eliscript": "bootstrap/host/eliscript-cli.mjs",
    "eliscript-build": "bootstrap/host/eliscript-cli.mjs",
    "eliscript-check": "bootstrap/host/eliscript-cli.mjs",
    "eliscript-format": "bootstrap/host/eliscript-cli.mjs",
    "eliscript-eval": "bootstrap/host/eliscript-cli.mjs",
    "eliscript-watch": "bootstrap/host/eliscript-cli.mjs",
    "eliscript-compiler": "bootstrap/host/eliscript-cli.mjs"
  },
