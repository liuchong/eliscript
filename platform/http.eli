(module platform.http
  ;; Web transport capabilities are read at the point of use. The protocol and
  ;; representation algorithms remain in the calling Eliscript module.
  (defconst names-list
    (js-array "URL" "Response" "Headers" "AbortController" "AbortSignal"
      "TextDecoder" "Uint8Array" "fetch" "setTimeout" "clearTimeout"))
  (defconst names (new globalThis.Set names-list))

  (defun readHttpGlobal (name)
    (unless (js-call names :has name)
      (throw (new globalThis.TypeError "unknown HTTP host capability")))
    (aref globalThis.globalThis name))

  (defconst capabilities (Object/create nil))
  (let ((index 0))
    (while (< index (js-length names-list))
      (let ((name (aref names-list index)))
        (Object/defineProperty capabilities name
          (js-object :get (lambda () (aref globalThis.globalThis name))
            :enumerable t)))
      (setq index (1+ index))))

  (defconst globals (Object/freeze capabilities))
  (export globals readHttpGlobal))
