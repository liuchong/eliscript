(module platform.worker
  (import "../runtime/worker-value-codec.mjs"
    WorkerValueCodecError decodeWorkerValue decodeWorkerValues
    encodeWorkerValue encodeWorkerValues workerValueEncoding workerValueLimits)
  (import "../runtime/worker-value-stream.mjs"
    WorkerValueStreamDecoder WorkerValueStreamError decodeWorkerValueChunks
    encodeWorkerValueChunks encodeWorkerValueEvents workerValueFraming
    workerValueStreamLimits)

  (defconst host-error-class
    (js* "(init, name, arity, messageOf) => { const C = ({ [name]: class extends Error { constructor(...args) { super(messageOf(...args)); init(this, ...args); } } })[name]; Object.defineProperty(C, 'length', { value: arity, configurable: true }); return C; }"))
  (defun host-typeof (value) (js* "typeof value"))

  (defconst workerCapabilityKinds
    (Object/freeze (js-array "cancellation" "progress")))

  (defconst capabilityState (new globalThis.WeakMap))
  (defconst knownCapabilities (new globalThis.Set workerCapabilityKinds))

  (defconst WorkerCapabilityError
    (funcall host-error-class
      (lambda (receiver code message capability)
        (put receiver :name "WorkerCapabilityError")
        (put receiver :code code)
        (put receiver :capability capability))
      "WorkerCapabilityError"
      3
      (lambda (code message capability) message)))

  (defun fail (code message &rest __opt)
    (throw (new WorkerCapabilityError code message (aref __opt 0))))

  (defun invalid-grant-item? (grant)
    (or (not (= (host-typeof grant) "string")) (= (js-length grant) 0)))

  (defun normalizeGrants (grants)
    (when (or (not (Array/isArray grants))
              (js-call grants :some invalid-grant-item?))
      (fail "invalid-grants" "worker grants must be an array of non-empty strings"))
    (let ((normalized (js-call (Array/from (new globalThis.Set grants)) :sort)))
      (when (not (= (js-length normalized) (js-length grants)))
        (fail "duplicate-grant" "worker grants must not contain duplicates"))
      (let ((index 0))
        (while (< index (js-length normalized))
          (let ((grant (aref normalized index)))
            (unless (js-call knownCapabilities :has grant)
              (fail "unknown-grant" (str "unknown worker capability " grant) grant)))
          (setq index (1+ index))))
      normalized))

  (defun operationTable (context grants)
    (let ((operations (Object/create nil))
          (index 0))
      (while (< index (js-length grants))
        (let ((grant (aref grants index)))
          (cond
            ((= grant "progress")
              (unless (= (host-typeof (get context :progress)) "function")
                (fail "unavailable-capability" "worker context does not provide progress" grant))
              (put operations :progress
                (lambda (value)
                  (Reflect/apply (get context :progress) context (js-array value)))))
            ((= grant "cancellation")
              (let ((signal (get context :signal)))
                (when (or (nil? signal)
                          (not (= (host-typeof signal) "object"))
                          (not (= (host-typeof (get signal :aborted)) "boolean"))
                          (not (= (host-typeof (get signal :addEventListener)) "function")))
                  (fail "unavailable-capability" "worker context does not provide an AbortSignal" grant))
                (put operations :signal (lambda () signal))))))
        (setq index (1+ index)))
      (Object/freeze operations)))

  (defun workerCapabilities (context &rest __opt)
    (let* ((grants (aref __opt 0))
           (actual-grants (if (undefined? grants) (js-array) grants)))
      (when (or (nil? context) (not (= (host-typeof context) "object")))
        (fail "invalid-host" "worker context must be an object"))
      (let* ((normalized (normalizeGrants actual-grants))
             (capabilities (Object/freeze
                             (js-object :format "eliscript-worker-capabilities"
                               :version 1
                               :grants (Object/freeze normalized)))))
        (js-call capabilityState :set capabilities (operationTable context normalized))
        capabilities)))

  (defun isWorkerCapabilities (value)
    (and (not (nil? value))
         (= (host-typeof value) "object")
         (js-call capabilityState :has value)))

  (defun stateFor (capabilities)
    (let ((state (if (isWorkerCapabilities capabilities)
                   (js-call capabilityState :get capabilities)
                   undefined)))
      (when (undefined? state)
        (fail "invalid-capabilities" "expected Eliscript worker capabilities"))
      state))

  (defun workerCapabilityDescriptor (capabilities)
    (stateFor capabilities)
    (Object/freeze
      (js-object :format (get capabilities :format)
        :version (get capabilities :version)
        :grants (Object/freeze (Array/from (get capabilities :grants))))))

  (defun hasWorkerCapability (capabilities capability)
    (stateFor capabilities)
    (and (= (host-typeof capability) "string")
         (js-call (get capabilities :grants) :includes capability)))

  (defun operationFor (capabilities operation capability)
    (let ((operation_ (aref (stateFor capabilities) operation)))
      (when (undefined? operation_)
        (fail "missing-capability"
          (str "worker capability " capability " was not granted")
          capability))
      operation_))

  (defun workerProgress (capabilities value)
    (funcall (operationFor capabilities "progress" "progress") value))

  (defun workerSignal (capabilities)
    (funcall (operationFor capabilities "signal" "cancellation")))

  (defun workerCancelled (capabilities)
    (get (workerSignal capabilities) :aborted))

  (defun throwIfWorkerCancelled (capabilities)
    (when (workerCancelled capabilities)
      (fail "worker-cancelled" "worker operation has been cancelled" "cancellation")))

  (export WorkerCapabilityError WorkerValueCodecError WorkerValueStreamDecoder
    WorkerValueStreamError decodeWorkerValue decodeWorkerValueChunks
    decodeWorkerValues encodeWorkerValue encodeWorkerValueChunks
    encodeWorkerValueEvents encodeWorkerValues hasWorkerCapability
    isWorkerCapabilities throwIfWorkerCancelled workerCancelled
    workerCapabilities workerCapabilityDescriptor workerCapabilityKinds
    workerProgress workerSignal workerValueEncoding workerValueFraming
    workerValueLimits workerValueStreamLimits))
