(module platform.browser
  (import "../runtime/source-mapping.mjs" sourceMappedFailure)

  (defconst host-error-class
    (js* "(init, name, arity, messageOf) => { const C = ({ [name]: class extends Error { constructor(...args) { super(messageOf(...args)); init(this, ...args); } } })[name]; Object.defineProperty(C, 'length', { value: arity, configurable: true }); return C; }"))
  (defconst host-function
    (js* "(implementation, name) => ({ [name]: function(...args) { return implementation(this, args); } })[name]"))
  (defun host-typeof (value) (js* "typeof value"))

  (defconst browserCapabilityKinds
    (Object/freeze (js-array "clock" "document" "network" "randomness" "timers")))

  (defconst capabilityState (new globalThis.WeakMap))
  (defconst knownCapabilities (new globalThis.Set browserCapabilityKinds))

  (defconst BrowserCapabilityError
    (funcall host-error-class
      (lambda (receiver code message capability)
        (put receiver :name "BrowserCapabilityError")
        (put receiver :code code)
        (put receiver :capability capability))
      "BrowserCapabilityError"
      3
      (lambda (code message capability) message)))

  (defun fail (code message &rest __opt)
    (throw (new BrowserCapabilityError code message (aref __opt 0))))

  (defun invalid-grant-item? (grant)
    (or (not (= (host-typeof grant) "string")) (= (js-length grant) 0)))

  (defun normalizeGrants (grants)
    (when (or (not (Array/isArray grants))
              (js-call grants :some invalid-grant-item?))
      (fail "invalid-grants" "browser grants must be an array of non-empty strings"))
    (let ((normalized (js-call (Array/from (new globalThis.Set grants)) :sort)))
      (when (not (= (js-length normalized) (js-length grants)))
        (fail "duplicate-grant" "browser grants must not contain duplicates"))
      (let ((index 0))
        (while (< index (js-length normalized))
          (let ((grant (aref normalized index)))
            (unless (js-call knownCapabilities :has grant)
              (fail "unknown-grant" (str "unknown browser capability " grant) grant)))
          (setq index (1+ index))))
      normalized))

  (defun requireFunction (receiver name capability)
    (let ((operation (if (nullish? receiver) undefined (aref receiver name))))
      (unless (= (host-typeof operation) "function")
        (fail "unavailable-capability"
          (str "browser host does not provide " capability)
          capability))
      (lambda (&rest arguments_)
        (Reflect/apply operation receiver arguments_))))

  (defun operationTable (scope grants)
    (let ((operations (Object/create nil))
          (index 0))
      (while (< index (js-length grants))
        (let ((grant (aref grants index)))
          (cond
            ((= grant "clock")
              (put operations :clock (requireFunction (get scope :performance) "now" grant)))
            ((= grant "document")
              (let ((document (get scope :document)))
                (when (or (nil? document) (not (= (host-typeof document) "object")))
                  (fail "unavailable-capability" "browser host does not provide document" grant))
                (put operations :document (lambda () document))))
            ((= grant "network")
              (put operations :network (requireFunction scope "fetch" grant)))
            ((= grant "randomness")
              (put operations :randomness (requireFunction (get scope :crypto) "getRandomValues" grant)))
            ((= grant "timers")
              (put operations :setTimeout (requireFunction scope "setTimeout" grant))
              (put operations :clearTimeout (requireFunction scope "clearTimeout" grant)))))
        (setq index (1+ index)))
      (Object/freeze operations)))

  (defun browserCapabilities (scope &rest __opt)
    (let* ((grants (aref __opt 0))
           (actual-grants (if (undefined? grants) (js-array) grants)))
      (when (or (nil? scope)
                (and (not (= (host-typeof scope) "object"))
                     (not (= (host-typeof scope) "function"))))
        (fail "invalid-host" "browser host must be an object or function"))
      (let* ((normalized (normalizeGrants actual-grants))
             (capabilities (Object/freeze
                             (js-object :format "eliscript-browser-capabilities"
                               :version 1
                               :grants (Object/freeze normalized)))))
        (js-call capabilityState :set capabilities (operationTable scope normalized))
        capabilities)))

  (defun isBrowserCapabilities (value)
    (and (not (nil? value))
         (= (host-typeof value) "object")
         (js-call capabilityState :has value)))

  (defun stateFor (capabilities)
    (let ((state (if (isBrowserCapabilities capabilities)
                   (js-call capabilityState :get capabilities)
                   undefined)))
      (when (undefined? state)
        (fail "invalid-capabilities" "expected Eliscript browser capabilities"))
      state))

  (defun browserCapabilityDescriptor (capabilities)
    (stateFor capabilities)
    (Object/freeze
      (js-object :format (get capabilities :format)
        :version (get capabilities :version)
        :grants (Object/freeze (Array/from (get capabilities :grants))))))

  (defun hasBrowserCapability (capabilities capability)
    (stateFor capabilities)
    (and (= (host-typeof capability) "string")
         (js-call (get capabilities :grants) :includes capability)))

  (defun operationFor (capabilities operation &rest __opt)
    (let* ((capability (aref __opt 0))
           (actual-capability (if (undefined? capability) operation capability))
           (operation_ (aref (stateFor capabilities) operation)))
      (when (undefined? operation_)
        (fail "missing-capability"
          (str "browser capability " actual-capability " was not granted")
          actual-capability))
      operation_))

  (defun browserDocument (capabilities)
    (funcall (operationFor capabilities "document")))

  (defun browserFetch (capabilities input init)
    (funcall (operationFor capabilities "network") input init))

  (defun browserNow (capabilities)
    (funcall (operationFor capabilities "clock")))

  (defun browserRandomValues (capabilities values)
    (funcall (operationFor capabilities "randomness") values))

  (defun browserSetTimeout (capabilities callback delay &rest arguments_)
    (Reflect/apply
      (operationFor capabilities "setTimeout" "timers")
      undefined
      (js-call (js-array callback delay) :concat arguments_)))

  (defun browserClearTimeout (capabilities handle)
    (funcall (operationFor capabilities "clearTimeout" "timers") handle))

  (defun browserEventBoundary (handler report &rest __opt)
    (let* ((sourceMaps (aref __opt 0))
           (actual-maps (if (undefined? sourceMaps) (js-array) sourceMaps)))
      (unless (= (host-typeof handler) "function")
        (fail "invalid-event-handler" "browser event handler must be a function"))
      (unless (= (host-typeof report) "function")
        (fail "invalid-event-reporter" "browser event reporter must be a function"))
      (unless (Array/isArray actual-maps)
        (fail "invalid-source-maps" "browser event source maps must be an array"))
      (funcall host-function
        (lambda (receiver arguments_)
          (let ((reportFailure (lambda (error)
                                 (funcall report (sourceMappedFailure error actual-maps) (aref arguments_ 0))
                                 undefined)))
            (try
              (let ((result (Reflect/apply handler receiver arguments_)))
                (if (and (not (nil? result))
                         (or (= (host-typeof result) "object")
                             (= (host-typeof result) "function"))
                         (= (host-typeof (get result :then)) "function"))
                  (js-call (Promise/resolve result) :catch reportFailure)
                  result))
              (catch error
                (funcall reportFailure error)))))
        "boundedBrowserEvent")))

  (export BrowserCapabilityError browserCapabilities browserCapabilityDescriptor
    browserCapabilityKinds browserClearTimeout browserDocument
    browserEventBoundary browserFetch browserNow browserRandomValues
    browserSetTimeout hasBrowserCapability isBrowserCapabilities))
